-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ONX0DGOKmEQ7kNvwGlrYzc&_nc_oc=AdoDHrtbarCgX1Zdsl9MEiTgIB3yusq6EFlTP3QPzKCBWDOhWpAnC1Wxji5aa_DhCYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU6hdAAjOty8C8Bxf7W2DJbS5rcsXlrNMsRIhzdPxpSQ&oe=6ABD24F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVuf-pup1MMQ7kNvwFUFuY2&_nc_oc=AdqrUTriJv5ot9wgjTn5TJFzEpIjuR1_KIcLzl4AbXiVAlxHDjQ9XWzW7ZTjKmyphAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_6rfQJ_WE0rZzg7jbxc1-ZLTB7MjNiRT7ZpGLq_lCxA&oe=6ABD16A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezUFj5Kf_GYQ7kNvwHWEt4G&_nc_oc=Adq4NIVTG8a2WWXItKpH_J4Y7ZG9H0aAt1n3fxpK5EczaehgRWPbgL7Zx5Qqf8nLPDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKir5s5p_Du2soIL0SN49kPgLVXGhYLPDoWIwvezK9YyA&oe=6ABD0884"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK5oyC603a8Q7kNvwF39rxN&_nc_oc=AdqTkZARe59_Eo2yQk7IRCzeTplviQLWjO6ayGqWUsPHXeHrL3yNQXbPassxuv5AydE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6pNVh3H6Q2jKRk1BEaFqFyv-R3DcnvCnlTESccEbqXg&oe=6ABD1411"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms9sChOScpwQ7kNvwGhznLD&_nc_oc=AdpGKY7Ku0kwAxHXORJiqGBj_91aX9G1XETRtQyl7-t3iy4jTOJx8k0NuOeOmtM4D1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm08GjdkbQiJaSuyZ2fvqssZafDtNkiTgp2DJA3Nh5Zw&oe=6ABD09CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
0f&oh=00_AQV7ri9hq1vDxIJ4zDhCVstBuwkU5i_NQ0LFZi0VfTGcbQ&oe=6B0EFDC4"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUzNLYnxw7sQ7kNvwFscF99&_nc_oc=AdozRQyF4O-vI1gxfHiUveqFII0NiNj22uZKD02uUF2UuD3PDTm5Gn_Kh5RIYAZ7GXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWek0sYYSaeCD7DApTpI-y6AMIjTmBboLWs8OGIQptfTQ&oe=6B0F0951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4Kvt9fe0y0Q7kNvwEUTmcE&_nc_oc=Adq50dg2fWvsU65dnTRLofLz85bYAVXY-zR4ZQlXOoQo7bSvIvk_-nj_owNWGnh02dw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUeuLy8GSHTsq7hNoAgzSoC3sqbxKokhbkpmZV31EKK7A&oe=6B0EFF0B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat 
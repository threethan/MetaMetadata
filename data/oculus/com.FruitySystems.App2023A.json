-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B68f8Bj3D0Q7kNvwEGQYq3&_nc_oc=Ado6BzbIG7-ioFjvoHVjNJVvh49NdISm5JuQijqV7zByYAjyVeLYVSnwZ_gUM8DoflQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcjizRv1G8BT53FiEjKVpVIREqt9q6zj25FmQZAvQg4g&oe=69CBAA37"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30OiULZgMWoQ7kNvwFhs4ao&_nc_oc=Adohi41uMmwIYB1Vfev5Dy1QkYqUF4dsyv0mNyeCFlFh5Eccb8K-nNzKcm65nNljSaA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_lUtb_FhBsPLxHIyMpgH0dBM44FxWriU3fVpuh-LpEg&oe=69CBD425"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkNGx-x4_l0Q7kNvwF79qNy&_nc_oc=Adr0ye_7q2ZejHIY3f7xyumGLJ0l7fDiOh6MDYPOMs6JAZ17W9ExHSQuLzNAgnKrbRs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHTi8ruoGobWXmN6lrIHH7Rg5zZppYWzRnHG_g3qCBvA&oe=69CBC604"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rApRCdPERAgQ7kNvwEOi2oc&_nc_oc=AdojkNXmiS0gpgJJZ7MIjqx6J48nBEF8jtsYT8eIGbOhilWNtYo6TvBJ9o7mF_VNGAM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIaNB3afVIi5fQm7kkSr6G3TTxyKNGrFu1RyNSTVwQVg&oe=69CBD191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w_zhgpsdgkQ7kNvwGHAK3R&_nc_oc=AdpjZ94f7A_FoIRwSivON_Xg01VNMQurjp8rkA5gHee8opVen8rGrcPx10CKfkUSUGs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOah7b1Qp7w4fialEnDG-FJ2SRYF4z7ciHgoi14j2Ffg&oe=69CBC74B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
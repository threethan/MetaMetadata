-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqBZBa3OH08Q7kNvwEyMrIL&_nc_oc=AdqFpNXVeqxcq0t9IPCthAZ_Yv4pKKTx8J644lO3tooX1kaZNt8oIk8PdmzHRiY-368&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXLLdJbz4swkI4gqeoNWxHT3vcdNpOfO8AU5nlC8rutw&oe=6A95D037"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=678H7mjPzjMQ7kNvwFLsjun&_nc_oc=AdoXPc-QC3aJ8oaa-TRa6pBWQ2uUIctWUzp74WOAjKnQh4S43nneeomcNbZBcCe5lPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9eDN8X3HIxHUb8v92MJsfFSMEUJWA80ZD2z_5GOv9uA&oe=6A95C1E5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBwd1QdpbCMQ7kNvwGBX-_J&_nc_oc=Adr3-XMMPcmyq0J-X-_GcTrx6ek18QnG8is-xcrf34rJGEn-eSLP-lvWNI8VMAV1YOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEksuRS6bEAoJk6bbE-_d5o7q6rtpXaRjvtHMgYOmfCGw&oe=6A95B3C4"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuD9VUTWMycQ7kNvwHVgDCL&_nc_oc=Adpx7E7W9jjO_yIvfU_9g0GJqvRwtVwO3MfRVrkL6JyXnFk923s1kqjUIhiltINf-nU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe0PP4KQKW3q9XMFmlVSRLnGfb1WLdiT8GBn-X3s702g&oe=6A95BF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw86KVFSm74Q7kNvwEMkapj&_nc_oc=Adqj8Kc_SSEHC_OHp0zFI-8tGQnYHpnYYL7GuSDN9t_axpcy67h-HoeyxPGgzcqkCzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIrnkENDBwkvyc2M3EqzHLN--TSNGsDiyDALT-YvAgwg&oe=6A95B50B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
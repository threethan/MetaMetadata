-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0AG6K4O9xYQ7kNvwG0HYF8&_nc_oc=AdpiG_Pi0ozyKkgJnpLXKN2tNGTWkf_tBVtORGUW91DdHrwMULg8VfEZtFk1JB5nfes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfdjvz1zuQz3hp8bBjC4CJ6G8wZIwQThKPoUi9d9QyPA&oe=6A5CE777"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZswtsU07XW4Q7kNvwHQI0Kn&_nc_oc=Ado_aNEQT3Np1_4E2ZyarqQSWd_CQwapj5pO5N2fW2aBsvg2wCEXzfbNhHwC8aiqF5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsK9_N2pTWaLBlIoXsg07mXsNtpQL_Qct3hGVhellTLg&oe=6A5CD925"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPlmZ44AiPAQ7kNvwGGlxCm&_nc_oc=AdpOXyNqiV5NSS300fQLO1qXVqdIG8Owg4-qKOFXlJmC8tgCC26BFtJwKMe4ypRENkQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKXkPyGt3qfk7FjqxPJRHJVXo10GCA2nFIEJFAwpDl5w&oe=6A5CCB04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrQ4ynvMvekQ7kNvwHA_K1Q&_nc_oc=AdqgVHM6DcxMl7HHrP4cx7QHqn4PnpHaErYMk1CpzAeXO4AkKCi7hpMXOroflisjWY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRqtSQUNu5LJ3tXzMhFign4xN6OvatGEkqKVyhpv-ojA&oe=6A5CD691"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UushG1LkYSEQ7kNvwFwEhpF&_nc_oc=AdrvhPnogf84PZh62jgnL9q4jN4tP7Rrm1CsA8iLCf_7qM3wITrcLfX92uTOwxD1-1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBszx5DnZD6JAG_6u7PHmz7SbbwZMBzSn_5AUbFsaxa8w&oe=6A5CCC4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzBapaUJH-wQ7kNvwHF8dYm&_nc_oc=AdqV8xOUd_soHil_DQ-Af-vYR4eBP3j8y4_LhzUM3rQSlIU7YdT1lxOwsRrQmYVHty0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gBZjlvLTivjPm1Wgb7tglj1CPfZTeqoo9S_L6HchqHg&oe=69DB7C37"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KujzEGABAvUQ7kNvwH8yNKA&_nc_oc=Adp1HJ1IZJX7eVKa2mc8YEU0yVc2cHASWevbgJ5qgb0KB4Zaxr12YaHl71Q-7k9b1F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1x6enWRyKQim5bAOddGlmDkBOeNHVi7r9qIPYca7vTEQ&oe=69DBA625"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85yCroVjuFMQ7kNvwFjsagw&_nc_oc=AdoHhFcxNZYevV7HKnvLRCiAHY4V1QiqNiSvsr5MaSVtkskc4OFROoZJpUhKb-lmNMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QCtDLwBLe7VJlu5aARFoKUnAH-eBqA9CKis-kfMAhkQ&oe=69DB9804"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WCmhwaz12MQ7kNvwHwA1pS&_nc_oc=Adr0bBfm1jMrMhAGHHPqOK0zqA79bzBHWwk5LJRmc9yXF9Swx6mIe4yv7_SgRmWaBpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Aq2BmhUmyOHrqHxEd-Sz73bAChOYB54ZaumfcGvY6UA&oe=69DBA391"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNfoRAxUhd0Q7kNvwFHrEKR&_nc_oc=Adq4unN9uxF0n17Vme3sRWbiuo5wdTkqGgJHoSputrPbbc9xzxIPYOeRVOei0G0xy6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ygySbHGYWdSqd5GVJ3tLENjwGAFVd2XsUDLFRpwIIWQ&oe=69DB994B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
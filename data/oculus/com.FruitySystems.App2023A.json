-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKW3JZBSRKUQ7kNvwFWQuOJ&_nc_oc=AdqAVn_OUtdrrVKbu6TUV_9IHlYl9hhv9fNyzKiXBQx41WVtw9xFqyY7LX9A5OH0dr0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTIH0lYhT35HORAt5ZHjMjHnWxSnb7xIwnLRU5ZqWpXg&oe=6AA023F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2u-dOXM_FsQ7kNvwG_O87u&_nc_oc=AdrMqoJcGOKbn0J1WJXnP_06gpAHFljL1FNfNdb3zK1pGB9IM365enEt2F6JUGVYkuQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhoC4-ROSVE0Q5Qdd4s4l5G3YxSwTnr1Cjf2WCZ1JNRw&oe=6AA015A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zENpr_mNRUIQ7kNvwEYRSHl&_nc_oc=AdqhYuqDURYs8teM-6i5X3VibPU21-LsnqUYgqar59Tmgg9xCWGqkUp7jb4HaaUKdSw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC1yDXl4g4N_fldVGogad6IKmmdZZNL_OATbP1qEJflA&oe=6AA00784"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkyBzFK8G6QQ7kNvwElF2Ri&_nc_oc=Ado8spkBWVIv0hA9pEezd9d9rRc6MVHBe8NvKJQEgbVloK0-iWMOI48scgv_w7MKweo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVq8pTvNB1SNdB1nQJQeipCPBlMU4PDF7pN8LTNr8CIw&oe=6AA01311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viwnXIva4uYQ7kNvwF3n6Hf&_nc_oc=AdpTFwR6DwLKkCHk8s3hrF3cS34168Jnu-hVQQ-b9q9SxJ_9DtHQvrFZAOzeOb4eTkQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOLoJ5weHiVhNl8n6Qj38lpakUEncVCNfv2BMXx2N7MQ&oe=6AA008CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Klru1hKXpiAQ7kNvwEw3qMs&_nc_oc=Adq9K7rBLRL3QN4qYojiRId0EHcJOWnhD97i8E218xZw2Dz8H2EpF9IdBXJGVIckdrc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ9dIfNlvte8hNtiO_XRxjYjksP9yAnsyo9H6r-JpGXQ&oe=6ADCC8F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7R1Ym9-SFAQ7kNvwGbqArU&_nc_oc=Ado55Zx4QeRBCAmwLhMk-Od9ix6aop48UDmMPYrxMvu_vO4sKb_t19iRgPMi6NUoqng&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5tEP20rWtqXOBY4Rci2GmE_qZmMBL5NUKTuo9IVSxUg&oe=6ADCBAA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPZB8szOL94Q7kNvwFmSLx9&_nc_oc=Adragvs8sXyEwLEgeb4vwpZB2Vo_X_TxnoLWuWIiJM1cLeglOm4Le-VUANvhHUjO5Ls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODdMa3cq660qqJB2KeYMFxF1hNagdfEsxOq7rF5SBLkg&oe=6ADCAC84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AWIb-01T78Q7kNvwH5ibyO&_nc_oc=Adra7OHMURf9V02p1a-9xvSAkZ2jcEhUQN6XbuyiUfqQmoM3Dzby-b0Dm72svMF-XsE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJylWgtD9J3SJTQ8RMabE3mpi_N0ZK4c3sXaMtMn-H1A&oe=6ADCB811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNPr2n9uEYcQ7kNvwGozRz9&_nc_oc=Adra-6JVmTcGpMlF8h1zQR1tv8ueXyTDM2W3dEF7PwuO6VreWCm74tKVhKTFKZtg2wg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHBVbYJi9jfb0IbMp2SFKsWNrqr-3fsbPvbzA-7mQl5w&oe=6ADCADCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
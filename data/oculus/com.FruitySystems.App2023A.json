.oculuscdn.com/v/t64.5771-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1TL_zM3rrkQ7kNvwGZoR7X&_nc_oc=AdoE8_wFFzR5sCYtm0fjAOzjtUwzXrxQjBM2iCX2Q4AyN4kbO_3S-BdcU0fYwMMloLI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5QUNzbe6xdV4g5LpoNZCs7UV3SAurOnuMkvd0RBi4tg&oe=6AA41877"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OfVgv7vFp0Q7kNvwEB7e7h&_nc_oc=Adr_w0_L7_QBcasDxjmVVkLPG43rrTC02R-jkguWfs9Vvos0ALe5RTY3zZHLxG_Via0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaTgfbtC0YupNtqTIyPVhP5trNvy1nn_-1BTgsBH8_XA&oe=6AA40A25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnLefKkYm58Q7kNvwEsTKM4&_nc_oc=Adphmgb2D4D7Wlk1F5sEi_pJ8sBjDPLu8y6QUMu0B-3YX8GzGb0kk_2QEoB3Kry6ouk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI05whw5BvhaUfqdKus9oaShv9ZmslSQvMu61msfRPHeQ&oe=6AA3FC04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_PmGoAi7-EQ7kNvwFaOBZ2&_nc_oc=AdqsJAf1RKCP14HeDshdkdLK7Ma9xPO69qQCkg8-qr3FB6Xiglc3Pr9YC1sD2-D0tLI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL36WcurrKaf0SzWcEs2e3EjfC2alLYq0f9kd4j-G3c4Q&oe=6AA40791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5V4-nOB1PIQ7kNvwG4SWsu&_nc_oc=AdrGkm6cxy7q9TU6EHPeMCRWSgppb3gClb6XnrKKhtgKzYvcflhizn3ZEtFaOPOPaaY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCQx8qLltdjz9eY5s0lTXgDv66z56xgyglW8U1JNp98w&oe=6AA3FD4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269189016446
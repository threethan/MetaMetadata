-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alegoqKR-S8Q7kNvwFeBQL5&_nc_oc=Adq5yZ7miDC8QoFRo3MqybrQ5gs2bwhAhJx4H81QbrVb0xK4F4AwUPsFhgA-iYD6JsA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR_QoqXF8PmvFIrjmLmqelFGdiPCcKLcVZNiiSnsqOig&oe=6A58F2F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-P0ipxa_tsQ7kNvwHjW3Wp&_nc_oc=AdoheEM1QsLWytlCzGkyx-1SXeOCIdeJUBOGuWHWYr3uDbrgGeNoJVOMLb9iW_mKMAo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9HHbEuydhEJO6SZPRJHWtYsaPlGo164PMoaoy3oTeMw&oe=6A58E4A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4W6cR6SUToQ7kNvwHsXkF8&_nc_oc=Adr7RsEtH6JNImruYI4nDz8JiY6jzCgjFewDdgx5rVFgIRTXkhaQkfTmART0Sp0yT2A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhX4q_G6tfOaXVPaX3PTfbh5CBsNIP4IJbJwluX-4-3w&oe=6A58D684"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2NJh7aPBQEQ7kNvwE_kFcj&_nc_oc=AdqYzeKaLNcy0j2kILa5n1pLmXXqhBT2UsuwOPpqBeVDJ16xRsIQa5chdId4-7YVfyk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy4S24DeMrju-Py524cfUzEmqIVqA6IwU4w7Jm9fMA5Q&oe=6A58E211"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UushG1LkYSEQ7kNvwGMJBTl&_nc_oc=Adrx6susvyXQN9cwRdvSUxrWhvxfWKG55ZRqmsxwXena6RuxBwIyrF_WI_VUwqsMNkg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmJpy2SO2p87iTJx7kYxNHCTXjJMlmm7-inBmDtxi9mQ&oe=6A58D7CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
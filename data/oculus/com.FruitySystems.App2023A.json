-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Klru1hKXpiAQ7kNvwG42c1L&_nc_oc=AdrYYy5m_IKC_d5OpbvUpDUj1MKYr2haTk5Im7XJDArZaV-4uUAhW-ZlLKgu7kMh_P8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwSeYsxYjT-46SFPVZq6lWVdj2dz9bZkzayF9R8eo3kQ&oe=6ADF6BF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt7M_GAwVnUQ7kNvwH2oie3&_nc_oc=Ado-lh4cwFpCKdD0mRs5Aea_xmJIkqvcAkBkcq3nCZL0cqvUiFm9QNH2Jy0SqL5r5kg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAwh0JHB_REjQla1OWcZ8jIRKPnF-nHRmrNNxr-0EPJA&oe=6ADF5DA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFgwjPZPKEIQ7kNvwGuObwV&_nc_oc=Adr-qwzIONpSdDIT5DULHAYXpf7wHKxf3LWmAToou64588ZquzzKo4A4GXWCEYheEbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfHLs-vIs9m-vmBgSI4PmHY9dNCxskadiqSs2pA9_Hig&oe=6ADF4F84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AWIb-01T78Q7kNvwGzPOJ5&_nc_oc=AdrGCQSwnbhmSkTU9W8xu1UcR2X2zMp5qY8ioxiNOBzJhHtzIBE2O86XsBEhayWBpKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDmZ3LiZ_h9ppg2jer69IeNvXFNs4lWrrC1hbXwawMBA&oe=6ADF5B11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex6RVMpl48IQ7kNvwEaT_XG&_nc_oc=Adpi1tlCpp17WCdARwKGCEdGkhoPQhKuhGQiRznhmD2K-muA0aUGHP4cepuQ4gz5vOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwiNkGd23lfvPCQEQS2AKWguvCprPQTrWcaAhxgbKZ4w&oe=6ADF50CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
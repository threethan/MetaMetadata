-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzctPC5TmxcQ7kNvwFISAHo&_nc_oc=AdqbRuIKTdYhKh8WUZNDDatT1YNqj1MThaUxzDt5yh6dJOrjhXJcK_tKfMqmG7AzGOI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz5TdRv-QBx1DdHVuV1uS4iUmqEEou0VNibhoeQmEjbA&oe=6A916B37"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRJSwF5bOW0Q7kNvwHIoRqm&_nc_oc=Adpg4LuAURqGuplKpEGOkxcq7tl510PyJPwF4IdeCLfn9NqHXri7uuuDzi1Q31OUrp8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd0xztmI9CyzGSshPvO6qAyoBH5VUxxwtosusKAbl_HA&oe=6A915CE5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEHOyXZ0grYQ7kNvwH2BsNG&_nc_oc=Adp1bMX1piYZTPzORfEi51QBw4KiTgy6AB9iwg3NStnjEyR1ihYWJE_-nuUQJwL_2kk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4TQSLaDEvbPTM6n1HLNdEU-Xtez6_ODwE-8ND2OxOUg&oe=6A918704"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRx1TjTrJ9AQ7kNvwFkpAzM&_nc_oc=AdpFJPBGbECvMqCZQo9YBGGygctP3gyNMDzBzUTiKutIGssH3dOvXKpnUtFIOH8JryQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7BnjKtTo_0AcY0sUw9JKV-mTpZF0TW5k5xGQG8-3DTg&oe=6A915A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJaJV2jZqOAQ7kNvwHtzKTa&_nc_oc=AdqDQwyiNQIyW4mDQ36h0DeoDiKI7ybWE74cDWU_pX6kGSAflTjSycB1Qh-YuXJ2BGI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEf11E9sj3BPFI6EKCTWCD-N7urEc73ZcXFf0rPzfp2A&oe=6A91884B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
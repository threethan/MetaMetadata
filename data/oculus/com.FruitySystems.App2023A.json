-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mumo1yixL44Q7kNvwHZr_7R&_nc_oc=AdqYcJrFpFDXy2lVH9g5sZ7yZoyTif_iLUs_IM4Z1LpgRypMeCTk_KFxKAadSniCSEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHRJIbnTMNG4BDbB1UTAjd9-dfo71UteuR3rNpoqj2xA&oe=6ACBA577"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns964b_n7bUQ7kNvwEvS7zB&_nc_oc=AdqZ6QPY3K2C6ABQv3nRH0bTVU3_xYDSm86-rx58ZILnbEJmXLKcRYPn922BNaEqU3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM7a7xa_f4NDiz8tOIPKgOEmKQKN9FVrvKukuPdLl42Q&oe=6ACB9725"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDnIEHijYqgQ7kNvwH1YMPa&_nc_oc=Adqyqo042ZK7Rj4OMqG4r_ffu2ha5Be5X0S-LeOvsBRaCNTWLMqnWAUe6OORSlIkKoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEhBI-Y50hx5MxWVwuApPImLY5n1LUanlFl0pzXGOUPw&oe=6ACBC144"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1Fi3WKVFKoQ7kNvwErp8FS&_nc_oc=AdqUsNtMTq0ZEFS_KKI9ThqLhYnBT5lR3jd00fankQN7-UBVW2sTGxm20_pklocWf6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYfHtKXz_m33V4D_6fXASx1UC79wkSTVtEsK6Pl2TxoQ&oe=6ACB9491"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTLxhJzXKYIQ7kNvwEEoHfZ&_nc_oc=AdoUonWxWuvcEeHClEsT1qdCQlJ_Z4hRT4BaPfNJNA6C1Iiz9KqMjFSb-WoqkBPkyFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP33A5ZVDu5Y5XOEeF6KJeusilld5Hyjao9IkL5noRmGQ&oe=6ACBC28B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
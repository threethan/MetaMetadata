-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqBZBa3OH08Q7kNvwE1BnWT&_nc_oc=Adqm4Rs3164yiX8F5iyjyJVPdY5yQ2i2HywjuHTF7QmcveB6KQat8FKozY2CEMvUuuU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHunLPQMSkVtXKKcrwbBLsMr1opVv6z3kSYODVoEiHLpg&oe=6A9721B7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxZ_FDivbdMQ7kNvwHNOHu5&_nc_oc=AdotPlq0QDhiPy9cjMBK0i-03wJJKQYYL2ddZbHw602OMX4FFZxXZc5PzdjCTMSczFE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdpR-pZeHPMPMs6HDBGy3cApdCQ5FX45K-Qup-S2VWuw&oe=6A974BA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBwd1QdpbCMQ7kNvwEFuvOk&_nc_oc=AdpRUP1Fru4CkFJm0ubp-4rxQJ-riYoqHz_Rkv4Car1VdfgZxP3M2AaZVlmFMuZmmt0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkcvaxeBUEfS5r3Acex7P6YfTcy65-0jJMAUMfTZZF0Q&oe=6A973D84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuD9VUTWMycQ7kNvwGlwMpO&_nc_oc=AdpBj9c1jCOZalFjcFPgfdAn7T8B3mM4FMBFtupN2CwPQKm-YJpBxvwYZMkVPYk7CiI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH33uNfp4ToZwhnGkCLYJzqJptl2ScUPmIYiqUArfMFg&oe=6A974911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw86KVFSm74Q7kNvwFRd19M&_nc_oc=AdqkDu6wm2NftGmcStrft6_K1OZpt1OjZP1ywAthYFIkK2MBlEFALITB2bqJBaOuW4A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9V78mhox5NwQlUlYBTwzKAsUjC_wDZrrRCtR_kl3Tig&oe=6A973ECB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
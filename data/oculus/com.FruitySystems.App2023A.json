w_O89ER1OqVu5Ytu5kKSNfGbZksgGqhGUHcjLw&oe=6A11C1F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5Wq_G1kFf0Q7kNvwF6DX98&_nc_oc=Adqudh14vrQBzuYUUf3Ssy5RxGBjS5cL5JG7Wdg87QxNU7YLcN8qRdYTxUqUsO9xFKU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57MCgQWNAhN_e3ILWzJmMrWWf0_V4bjtS9b5uBpot9wA&oe=6A11B3A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmwaMKNn1yAQ7kNvwGqxIA_&_nc_oc=AdrC6XoXLcR9I682rp0aB1WoBnAzQmeIR49ylQAmUGvp_RsCbh5po62cLPZ2C7e-968&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MfdpMVRr6eNixhRsEjgrZ2rECWKpZfNIcnIwHkvldGA&oe=6A11A584"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPygCsZhyzsQ7kNvwFODNlm&_nc_oc=AdqeDi4__aGoLVed2OQD9DGWeMgk_RN_GYvyFpYqWnKrwbuHrBDxmOl9RqYFEJgnflg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qE7T4YwyR2sg2wBXM5tqoZr0bMqigOx_unD4dshoXDg&oe=6A11B111"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3snDfbSuPJMQ7kNvwGIAlLi&_nc_oc=Adquw3PfGBax_pRTxCr-cJEafoOa0DH6mnPaX1h6SeI6P32XrfNvWhAv-7q5BpyeVTA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UzGhWWS9m9oirx2xF9hqjE_GnLylHaaSLH2aqYKzueg&oe=6A11A6CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "# * * * AWARD WINNING * * * \n2024 NYX Game Awards \"Meta Quest VR Game - Indie\" Grand Winner\n\n\n# Welcome to the Space Salvage Corporation!\n\nSit down, put your feet up and get ready to dive into the vibrant world of **Space Salvage**! Immerse yourself in this **thrilling cosmic adventure** filled with stunningly colourful nebulae and ambient 80's inspired jams to groove to as you **fly your pod in search of refuse.** \n\n\n# What to expect...\n\n\n**As a trainee** at the Space Salvage Corp, you will be expected to expertly pilot your pod through numerous pockets of space, some more dangerous than others.\n\nEquipped with **30 environments, 3 distinct narrative paths and a slew of fun challenges**, Space Salvage offers a liberating take on the sci-fi genre, allowing you to **forge your own path** towards anywhere from a calm dweller among the stars to a combat pilot feared by competition. \n\nHop on for a quick 10 minute mission or sink hours into the unfolding story, the choice is yours!\n\nYou might not want to slack on the job too much! Earning credits allows you to **purchase upgrades** and **customise your ship** to fit your playstyle. \n\n# So what are you waiting for?! Join the SSC today!\n", "short_description": "Sit down, relax and get ready to dive into the world of Space Salvage!\n\nAs a trainee at Space Salvage Corp, you will explore 30 environments, 3 narrative paths and a slew of fun challenges. Forge your path anywhere from a calm dweller among the stars to a combat pilot feared by the competition. Hop on for a quick 10 minute mission or sink hours into the unfolding story.\n\nEarn credits to purchase upgrades and customise your ship to fit your style. So what are you waiting for? Join the SSC today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com
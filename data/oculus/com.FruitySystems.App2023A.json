-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfurHAfZeO8Q7kNvwEl1VH1&_nc_oc=AdqxiZTiI25wc3dywfhhaFOMIrydJaUiYvTOXdj0BSYLdK3oGsuERqIfLpLInKp9RCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSBWT0samFjMJTe-E-j6eZS-H9PQpC1fvdtJW6SdOH2Q&oe=6AAFF5F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzrWXoXB2PEQ7kNvwG6gDap&_nc_oc=AdoR_C-VtivQe6HCeRj793NdH9SzAJ9frfp6ORwW1h1Vnxz25M3_epKfQmbmYr2gZ04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrKHN3reQvQR7-JbMX_H8iM717PTceziDu-xCzdT8XMA&oe=6AAFE7A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2qnNFOxizUQ7kNvwHzXjVH&_nc_oc=AdqWKFKxBsfsNTvCfPuo4Svz46aFwhKo_OVPgJOGvjHUtsatXcCYmxaf5nQutjKtiNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoSlN5-V684IIzl8B8wqZVjZuIBy-251jxgGzLxMda4Q&oe=6AAFD984"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKnJu6NGnyIQ7kNvwH6Z4fo&_nc_oc=AdruBc-4ac11fJxO40KyFJi2H86DRFzFS9XAw1RtSiZ_fqFxmlumn8CUO27LzRqdPic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7mu_Us8tS6xL4gADQrjRA_05LWGLjwftQN0rdOT67GA&oe=6AAFE511"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA1dz5Us9MIQ7kNvwEg6pMh&_nc_oc=Adp02o9Y_HqEufGGb2EzIAj7Q7ppJE6k-NL-Q2SrVx-W_1Wlvm4vuTBap5uVWg5B2W8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIrYBHyRGWO5T_9PUBisJB9-QMHJZ2Y3YmTsROXF6KrQ&oe=6AAFDACB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
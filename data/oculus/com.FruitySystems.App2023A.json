-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxw-dkR_sD8Q7kNvwELW0Pg&_nc_oc=Adox5jCyqQ7f7w0rAkYHQJWqRVyCAyl8g3Zs9PCDsqdPQyp86sI1mayngay5sTxKtEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sat2t22cggK0qxHJdmLzwO0WHzCi2HIezmn3Mn5HdZA&oe=6A2ACE77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQsC02fYuuIQ7kNvwG8W2vY&_nc_oc=AdopE0THuvBWNT7uUja_B_Ymm9uR5FNGCUZrcVoXikfLKQ_7O0-Eau1YCWI4cchDi4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xi5Qm2Q9_2ATwvdYpA3OnZdKKjizv6DwR2LnfjFIwOg&oe=6A2AC025"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnfVNwAcMEEQ7kNvwE2asS_&_nc_oc=Adq4dNaL9DziIVVUU8fq2K53Y0QcAWLIbRok3m8q9e46Gm5N-KHxWHdgsg2QaJ_VLiA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YRkHCK0AbyEZRaRs8sBYLCGGooi8d8rHWlVhRLpuyIw&oe=6A2AB204"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A01s7WxbZqYQ7kNvwGJQYfN&_nc_oc=AdqSbZJku5K_p5xV4vXuEiz8X_ekMaBwbngpaK62fUxxDOmqUDT6A5vLKRnnQfO2DNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o1gj2s2uqHQhFadVAG-yl1bT09E7Z2fRJlCKmkcNK0g&oe=6A2ABD91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbNnV9nu2KoQ7kNvwHeyhDf&_nc_oc=Adqmxb6U_RThAj8JqKOn_PnZYgkTcMlyJX5FQhSo5reGrVtBCoeTNN5twqHaa8oORWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cjPJ9PMEfAJ2skwC06_rm-bXPj5KNyoC1hHXHIpqYmw&oe=6A2AB34B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
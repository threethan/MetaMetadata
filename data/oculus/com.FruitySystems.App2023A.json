-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xea3Gjzwum4Q7kNvwH9gdun&_nc_oc=AdrGZ-v4AcZCnCMp8mWV9GoZa-IQLoOqB1jmqhzv9tV2o8psOod_U5yiRqteXn5VoI4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhyNwPLLpQBHuKuL7mAZs3nl2oPHJaUliBhjmeCu-2nw&oe=6AB68D77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTwCKHBlCzkQ7kNvwEuZqdL&_nc_oc=Adqwfnb_nbQZLO8HOkdvi0vbMOPSJyzamlPeTK9f-_eAJPx2Lhcs7qkTaL6wyy61cHQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsk4HUaKP3iamdEgXeyaHq1gggYD_XeTt7doVVbM4ncg&oe=6AB67F25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApP1FcxNIAIQ7kNvwH1vUQ4&_nc_oc=AdqkC_4nKohXguu0elGxaB808r9TEBQTyiKeBCwUM-Qq0NTUF1caRhI51wq6uD1gaU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7pxBJG0s3M1FpfkmPq3l0vG_TMMKEjhVHa8ugDYsAcw&oe=6AB67104"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4ZG-HUyM_QQ7kNvwFxGIX2&_nc_oc=AdqIJIcMa4hLyTKvr9Ipqhsrj13P3gjPR1lFVAcSDnfSrTtJUeRdPmjrn4WNYEp6Jho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ31nbgxhcNMhl3ngOkPcr8zwVRUOifBj_FB3hggR-eCw&oe=6AB67C91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0pbuwI_3XEQ7kNvwFDJVtC&_nc_oc=AdrS87Pjf8Qt62pEAJJaxlnOhIzzdaJGVz2aosed0qLfCG4_fU0ITou8eoUtHObEsqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR9Xtphh9b8Z9jbqOFJtB8HSAWHh6l3p1lcpnYwCxbcg&oe=6AB6724B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
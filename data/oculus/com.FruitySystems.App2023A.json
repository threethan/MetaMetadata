-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYUW0QxqE34Q7kNvwHsJNJi&_nc_oc=AdpwbgJCeD-EYlGgu0r5hIoXWB-iZ9jtAB1ZpPvjSY4BK4vIMs1RCa9zWqQBIN6JGrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEls5GhREYtGtkOeSQ4R4oouG_Wrq_wbE4Oxd-C47yn0w&oe=6A843C37"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvCsEQkjKt4Q7kNvwEjdcE9&_nc_oc=AdoYZRWrB55ZEIyXWQjYDs8g19CxOKCY_0KdxRpDVgf-DEtsWhdV1bPWT5la7L1iSYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz9GRVSSxQ_gj5mvtFlO5JdoWDlZKPUEP2MXcJd8T92g&oe=6A846625"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N48YbbS5XbIQ7kNvwEiYFrg&_nc_oc=Adop_nJRm-f2nnWbwflGbvgm8b2EGEwIiJHIGKm6g-n1yTqXRdMmo1X8z7Ys0il7qOM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9W6xOVGpwD2aGfMLlEEelMVZFM_f31OMo5LoF_RF_0A&oe=6A845804"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjhLvZCmwVYQ7kNvwFEmvkp&_nc_oc=Adrzn2Ps7NtwsD6355Tr2we82vzInVF9mHjPGQB1Mm7xA1WznvsLI2Cc6FFicS_SLHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRnhjxGcfxKt0-IHnGFWiAknn7lZLr9FxZOoBoQUMA5Q&oe=6A846391"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjfaoM4JzR8Q7kNvwF9dYgp&_nc_oc=AdqA3Uji4L8T_lcuSEuvpHgsxhs151YUEjklk2kMfK0LtU1zZNwnxkLIbSNB5neVPbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNVevJYelLbI6buiqYpqUwq3Sea1YhzZBiyHsAkPdZIg&oe=6A84594B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
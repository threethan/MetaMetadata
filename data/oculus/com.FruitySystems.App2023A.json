-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYkRfZOmy0EQ7kNvwFaIUhr&_nc_oc=AdpwMQ8J3OK_W-PPEHlU5Zk0wMfQekoqCQEgV45mvMDzZQ4Nk5DCXe7-suJm1Ngq17w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgPEoqOXDVeuk_4qlEoKxVcl8rW0Xo3CQABl1eMVQevg&oe=6AE8A677"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giGFvG_9NfQQ7kNvwHY_cQ3&_nc_oc=Adqh-AD9vsXJeEJ00HTx8JdYf6GI9bXp-lUhpawHpKfi9Nurafeln7nHMPl8mBdNHGA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAI9j2W68Mo5upSzfHVidEzTh1EdqPrvlbkAevVkSiNg&oe=6AE89825"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngfkcmwhfGUQ7kNvwFUPVjN&_nc_oc=AdrjcZThBcSl0lTRyiB0t9U5i9JBLa8_tvThw_m7_ChnACgpupkH3gL4nD7TPGNpyU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJI78Wvqiw30zDM08ixajK5n521TvuOzBi7V4CblHGqQ&oe=6AE8C244"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp61kpYyokQQ7kNvwF-5wj3&_nc_oc=Ado_ViOmyXDmkw8q7kDIjaOYVaVXLXKU0iMuEdjl-559MCuiKE62wZq5jWFFkl-dLaI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxGzXdqvYqKf0z3_iedlSkl78ZZ1_eXbB7li7kqixNuw&oe=6AE89591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roAveDiLS3EQ7kNvwFt6v_4&_nc_oc=AdqzjvVf0nNDMn9ZmE7owYGrMRztBnE6VEDfVqDFGWs9It6sFE10t-2QYGYqJGB8dAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHkisHyfGeZSFjMFhu7R8XY-qe7HBpynLqGfUL74vFEg&oe=6AE88B4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
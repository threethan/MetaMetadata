-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M_7LBt8dNcQ7kNvwGzWxLD&_nc_oc=Adr6RLlLWjy34vVXC21cWDoIPvhJA2czKsXHW1BXl8SxIi5SIDT5Qpx1pOD3Q80VK1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaEebADVZODSE2tVmwiDlMcqMPkpGBqYrOQEr0RYFzgQ&oe=6A4A7277"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll2njxN-CXwQ7kNvwGlWaMj&_nc_oc=AdoBL1D112r197SEZ7GFyHkNoIHFuIgj226zwHTQqjjN1VAq6a0zjw2Lu_bOvHJEFKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwJMUyajGSeeerX9OQ2gbmDvfQA8pMMit_nh4kVKafJA&oe=6A4A6425"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pM75ZCFuJn0Q7kNvwH8R4kn&_nc_oc=AdrT-uY7FgaBLTDlM4nxs6Io_cRjTZR5lBFmfdpxymKBb-vKJO9H5xhDBRwt9d5LCPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_EziGADkeRfB7_fbunFob16sWnG1VBgyfRcA2mfSnow&oe=6A4A5604"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FA4uyW3d5YQ7kNvwGkdlBk&_nc_oc=AdrU4Vjhb-bZIhE3WyX1R3tMCOkketld2eY-vhtlulrp2R7M-csjd5-8ZbVne8_4Ynw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp7vWgoN6g_4yuwysTQ7raFWBT5GH6e0V0YzV3u0iz2A&oe=6A4A6191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHPjyZ8qLpEQ7kNvwH_5D2w&_nc_oc=AdrMLdmRURlCZmy-2c5R6FUyXl4NRPPb3ImJmovTTmGtoaHD95jy5Na7yBzOsxdkq-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFPVdFOrXET3hKLxRaEXRP-75rgVNXaeqn_gaEeZA2VQ&oe=6A4A574B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfWWur04whYQ7kNvwEz2124&_nc_oc=AdqeEL3ub3esedFV-eJ21LmgGAulhxYduAuFbqOiXYL-PGMRZtHMK0aeDhQlvPY1WEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAnNDt52GipVK_SXDvCyy0GEcGHa77vvLk2UdIrzLoLQ&oe=6A4FB877"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuwJ7WwLhW8Q7kNvwHlMYyh&_nc_oc=Adrj5wu2TiWGSglB7FK6LpxSpIGhclMXOEiGE6VjmIRdwlEx918qWlykJPKRVp5-bR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBukElGxDRhOWh3uOky6B_hUW2nHFlbwZ0njo7HpEXSJQ&oe=6A4FAA25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYw0yXpTcysQ7kNvwGkCEUO&_nc_oc=AdpOgBXxYpSxsBQjed3MGqOdE8VFcnzyN_KtstNOCv5n_FA5zu9PNvqmJHJjAGwvCa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8fE3dENkZwkMtHc5hXD20_8LkPe5ejPXa7RF8PrwnPA&oe=6A4F9C04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glGTw-5d75MQ7kNvwFr8R1z&_nc_oc=AdqDwYqpBU2bOxId4lk3zfMzDTE8xM6JTnBlL1q-u5Ksacb3_NCbnXe_gxuFIzWGRjg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYYO2NN7KCtcf31c9EkrCUExyMUOqeVe5F6cLDs5TNqg&oe=6A4FA791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyalpmDRYiMQ7kNvwFZIQ50&_nc_oc=Adq6lKqqgI4zBaglPzrOS1Hhfa-ybUE5Ta57OgmdcWG04RFHQ4E2lH1iExAatKUCG_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvhHsOnsswbSTkDfDtThtFKZ_9KNxmsaAhWW0tqs5Tzw&oe=6A4F9D4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
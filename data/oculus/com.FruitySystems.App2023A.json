0f&oh=00_AQURXh5p3zbifQV9vCOSKoYHT-VPW8lXahiJ1iWn-XRCVg&oe=6B104F44"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUzNLYnxw7sQ7kNvwG0yb4W&_nc_oc=AdpNE1vyisoecYFn_GGbo4L8XzEIp4ApvQBa6fFJlho9cwcXWWXmkvyAbI863IdjGyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsnBjK2TiA9AtHd4SclYSxCFiVnOlD9qJ7ZjRU2hr0UA&oe=6B105AD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4Kvt9fe0y0Q7kNvwFvD4sd&_nc_oc=AdqOzCa48MRl3CUqc3Tg0OLPqd5u_W0dmh1DAKvWVlgoYMS13lGLocRDCc0vcJicesQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXu14zkyk3AQM-c3hc7vJZS9G03b6tH_2e6U4vbl_IL1Q&oe=6B10508B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat 
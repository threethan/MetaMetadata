-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1TL_zM3rrkQ7kNvwFy4TPm&_nc_oc=AdrZJ9nPt9IXH5DSIisIXFYzys7YAFdq0-uB2fKfk9_9DeUeEUOM7QSCH86Ui2G4SFQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPB0-Y2QrjHmWtZlMC0WjQPgAITgkT7nNWLzEvHAgMnQ&oe=6AA17577"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2u-dOXM_FsQ7kNvwEUEzQQ&_nc_oc=Ado1W5eljGPDuDbYgSlx294QmVBRJtiM1Z1ic_Idzidr9rZvZVLQMwVo8rN7LFGlXUY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmYi12PrxDVhvyyke5CGIX4dIF8UOygD3m73VV7fTQuQ&oe=6AA16725"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zENpr_mNRUIQ7kNvwHyvfNe&_nc_oc=AdruFjdRGdRo7l8flcX9S0G8d9qbiQxR694ExD0taFdSxMz9NakcXyiwR18Qzed1KwY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOXK7DLLN-5xOhWKD7SkzCvM7_osDzuOj7ETs4YEgTow&oe=6AA15904"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_PmGoAi7-EQ7kNvwEZ9MMB&_nc_oc=AdrxX1aINGiixkuxXgufUQwtcMIrEPJIyCa5VfVV9iGOQbqrVqEDbaTYbYsxVdKNs-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJeNrxZkpNkC4Svp3EyAPbt6huefdaqafeDNzEwMeOwg&oe=6AA16491"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viwnXIva4uYQ7kNvwFFizgE&_nc_oc=AdoiY9bkV1m3UTFcJrKmIr0YjWIo4cu2fZXSi590mCUED3kHTEQGD8re05-5Y1vGSBg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU3alop9YuUmYxeEDdbzbfAjkSG1nrCwhBN0wP8l-pCA&oe=6AA15A4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J5GjYw-UxEQ7kNvwEYGzc3&_nc_oc=AdpqXSzFpB4DLsDtUHc-U2QMPrhN4-1O1jP3VpmDtgUQ_Y2hl52FV3GOLJi83uCxTCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKQzBvHWxwXYApGXWFe0w0xGj8blIieSB-GLlOznFjIw&oe=6AB3EA77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy-Zur5arzUQ7kNvwEBikjy&_nc_oc=AdoZEkeRowR6FuDBia7saotpvnBeEzFjJSn4IyKlaU6A-ueuw588zvJZDgT-LCu_5kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIevb4u-5sNufh1V7uNtjN1J1_Tt4S3BbHJlb1C__1VLQ&oe=6AB3DC25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApP1FcxNIAIQ7kNvwGKTlTD&_nc_oc=AdqJtpB-85mqSZkaDGpEZprdVyohEG_Ib0G_UaAb3BJs3wKN30f6Q-mg0gwOIMYWjQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5vkqjLu9rDlmDVm4r3-VoLv--9RzFMqaaOjUB5E6TOg&oe=6AB3CE04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cflRd4DzxcQ7kNvwENZepS&_nc_oc=AdoUs_YtswXIMS2iGs9FDrV2dFenjmJqF9y5Fw8LCmdguUMO09QM--YQjLr2nxEvO5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6LXG1AuG0Bn4I57ZKoATtQNRqEK5wOrXyqgoNX9iXrg&oe=6AB3D991"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0pbuwI_3XEQ7kNvwE5521x&_nc_oc=Ado7fq5EE-OCFDcfHxIv-RGkradw9HHx3RSZSrT7ILbCUfnaSzGPEH6Raa7nxcO74BU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg7--jxLJkdOqRYuuWbyDXLeOIK3EBJ6YqX7b8vmRXGg&oe=6AB3CF4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
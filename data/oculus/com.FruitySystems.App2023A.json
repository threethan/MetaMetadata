.oculuscdn.com/v/t64.5771-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEhOI2nez78Q7kNvwHy7pok&_nc_oc=Adr0y3wgm-AEH3C8OVSpukJKkCeMPptDbu25-t9NxWcREnAj1f3MiiZDgt6NFKubM14&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pZnV7NYwAvT47MLeYN7FX2ycSfR6WutHn39lNvJVA6w&oe=6A467DF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vB3fIkj2K8cQ7kNvwECTHSb&_nc_oc=Adr1JekyX1-xNFt2yH_rpIVj8WaDEqW_EMqdcJkZsfxNupI8ZCKievBMt_chduJhRlM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zAD8gg5tFsXXyHdMOEVj1f-TKZEeSzGZwdSjutrPtSA&oe=6A466FA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d6vpSlAqnAQ7kNvwHKP-9p&_nc_oc=AdpSatJTldBo_v7KGnOj3kpxf1occQ-w8GHq4AVCLyYZYj43DRMKkytjcPLlTYiqwrg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pp5ekPSbK5Q86hHzXNXlPORU2UAqJN_avCsQTcWhwIA&oe=6A466184"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdfvQ0h091sQ7kNvwGE2VT0&_nc_oc=AdreMZY0xcv9wxlGdqsOfWoIWm9PMF0qTm6sX02DTqSTSiNIh6kIflu-2GptfaiVEz0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87IQJnmgY7Ahy3WQi93lO_BEYJIVKEqgdOkdvSOFjHfA&oe=6A466D11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKi0He_IWPIQ7kNvwF4X84g&_nc_oc=AdrG0RKHLBvXXii87el3h52Xgf2Z38VztOqXrSI3A17K0mDBLRR-KKrJZB5SOWLZob0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rSnXnSUEXvv2nu0g3gboDmOD6a6uJUslkGuS1WsBCwQ&oe=6A4662CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269189016446
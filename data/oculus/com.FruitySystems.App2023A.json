-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgtBUIw3XDIQ7kNvwFMdDp-&_nc_oc=AdqmH90AFcwmE4ZJZOpOr4nfPNd8mzN-Bec2XDOiatIiU_zpjEGdVWNk7ZEUEGgDAW0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K_GhpSLF6NrWPkqakDI9IyTNwjOuOXhHlZfpUyv4T3Q&oe=69E8AB37"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_3o1bWIz7gQ7kNvwHXjclF&_nc_oc=Adoev_plNXE40r6yxT4PYRAousPkS0pEFOOs3sOwfzziXns3L5n4E52FzRTO1eFhyHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NaCvsQFATwH1mttbBoH9vI_BSjPV200aQR_kjA2zRGA&oe=69E8D525"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2bBCrbCS0AQ7kNvwGxCsxI&_nc_oc=AdoEdC0Wv7VB1L13xvTlVgA21J9sPHorgoSjgkvLM4Eij3jwISnXbHQ7UJVvIX5l4K0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ck5f8VfztYCtjjX58Jd7pN-FpZ3uIPzAHdCBtAAAYtg&oe=69E8C704"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnIbYAyRT3cQ7kNvwEXO2-Y&_nc_oc=Adq70D1JJe6_FxKe9sS1gOSZa4fX9zBJvj6OJtCP_Dlu_vLvuJIQMC_5HYw4ZbEzCKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j654SLZzXcRykc1C0ryQY2GAzRPzIvaLshsqHWT57UQ&oe=69E8D291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLthlbTGBaEQ7kNvwG0Qruk&_nc_oc=Adpj5CrmEfNCjSJKxNX6NFTmUYNgHCRsY7EiiRL3_NSYv-dMWXax63KeEtEYPwl-ix0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lb4U17PWUHkG-s-r6izLbjXaPYRK5B5X8H9nP2TXiBw&oe=69E8C84B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
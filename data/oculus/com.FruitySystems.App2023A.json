-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doqIBRMMRWEQ7kNvwEBX-0e&_nc_oc=AdpO7M0ni8Pl-Iy-bRN_OPQY75sOnEeLQBuDemY0f-vprjHXw2dY_Q3XOiJM2tDir6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cJDcLkFmyjIdhcxM9BbElSXFGb8HAj21FjQHFg7Xk6g&oe=6A1464F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEsdnd4mfZcQ7kNvwFWlkSG&_nc_oc=AdoH2HyaFhzExqZTeynXEsp4SGE2QDjqVP14A6zW1kcor4XW8NBE42kjsMsAK6wQ_pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l3C8Jz_2PN7g41tMuE8MLxkSDLJMAj_FzG84az2Id_w&oe=6A1456A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmwaMKNn1yAQ7kNvwG-hWUy&_nc_oc=AdqbHFmSgN5fOp6NzP9rF6Q8bQIfEz3noDn2uPpolbmbCzjzRnJFbr48LqdkkajM59I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UX-3yJXYs-eFdU9R0prSjz1Ws6K-DS4whbCh1o51Avw&oe=6A144884"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWMhnAG5v64Q7kNvwEcMpJD&_nc_oc=AdqvBFFlyzpdrOgndsKnooXyw0dVwq6oG6-MPTK7Lu6ItIEgKhLDMsevQjNf27MwaR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pGEmaG85LHOSOK5a8Xwu1Hj5qIuEvPlI5f0SFPNxFTA&oe=6A145411"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3snDfbSuPJMQ7kNvwGZ6I6D&_nc_oc=AdqTNql36Npjyb96j1tstECpzO87eZhhlSSJFiLPPlICFHMQBxeBH7gqNmBQx0-hYP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NNPg-sqo_kFaHcJlEpQGV3a5DJVIXMa-fQmRf-P7oIA&oe=6A1449CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
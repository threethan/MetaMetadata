-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW9RWRrlkjwQ7kNvwFXuhgK&_nc_oc=AdpOflj1v4eqqBAiNfYwG3St29ELlIjfsjGXtkL_Jj01d5KF7gWI7Eljvp7vkxwIoQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrRQgUchbhcJQZx6ExM-xENLJaDvCGd58pDjZIUODlvw&oe=6A7C5337"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INqpoDfovuAQ7kNvwE2Qgtq&_nc_oc=AdqL5q2pHzfxR9wJEDd3xDavgeuIAPT0_FUHhc5cq0Chzef8i-Ehk4Aj7SkZx2kl_vM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDUFaA-I6dG9zywvtdvLFlkMDp3Om8lw9oRVQXDIhdQg&oe=6A7C44E5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdYoq7rinjcQ7kNvwGUJC_U&_nc_oc=AdpVSnBWG82F1RWbtOLPGXRcu2GddZAbOTD-0QxvN94VJ9Je3EAXhoonKuLN_JyoXsA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMVt6MJI2Up1Aifg1CclAoCzAfJt0fTWk8h5hJfYn6AA&oe=6A7C6F04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rl7BMl3NZN0Q7kNvwHO2fEA&_nc_oc=AdqoGvgorGQuQN_ztxSoopIBmYmjGR6eGkbwlbNaIUn2AsCblWCkPY5nHf2LPckkSxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_IG1mvi-oDozN0DKH_UZx7qFPq4rkqPSNuQo7funHbw&oe=6A7C7A91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCvhMwR2STcQ7kNvwGJ5ZFT&_nc_oc=AdpHwMabMiHvYyEUFTDjOuIVFDAFls_0FWVAxtMJvmSx38mqOhpqey6GzoR3TTt5IQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFev_UNx1-snXd_mIPO4cbWf0zTjofpehd9mWnTtswBXg&oe=6A7C704B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
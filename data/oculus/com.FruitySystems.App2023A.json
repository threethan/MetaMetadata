-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYkRfZOmy0EQ7kNvwGHLNne&_nc_oc=Adod6ckVeCw1VFwSp1B1Vu6z_Ji4QM9ZMIMqRaM-LrpEAkRU01bsLjxVcR1zsrTNwEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkECQ6gW6pk8oO_fRl-953PaaFTMs8RGNA7jG30RUBGQ&oe=6AEB4977"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztLsWWm-G9EQ7kNvwHHPVp8&_nc_oc=AdrfZpxj7v-L1IJ_QMNngGlmwQ6dDRl6AgE06IVXZsGWIytx8yuvaiJXKtt3xugGxMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3Akk3IxncGR1ggrGLl3Loye9ZfkRle9cHHWkrQOpSlg&oe=6AEB3B25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz6W3FfnIYUQ7kNvwGFNLbF&_nc_oc=Adr3VsH80g0NRWH8CPHCTIj54N9OOBw6Au8wiIfYMpZA7FOeHZcK_UWwN3NcwBiM8y0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGFsGcJ9bBjQclI1G_hlxHWr1kMeBI5NuGgSzG4DGlZQ&oe=6AEB2D04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp61kpYyokQQ7kNvwHP_MTD&_nc_oc=AdpAUlkG0SKFlKqgeddGEE-CFgTPve1_Tu5JSf0QMlt3YCGJWkhFaFj8jgWTQWmJR0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3C3LdgohK9OgJcO1_A9iC76EKS141yAl0R0KnpQYeAg&oe=6AEB3891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4SRGUwDEXIQ7kNvwGdOzgy&_nc_oc=AdqMANMT_0TVcCGSL9kqm01caS5kZa41tvd_3r2ZZzJnLWXAaqc5FJekV9rlVlx_0aw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShfKAowAqxneX63bhCyW72hAnbCErJO_DCEnMkqKsU0Q&oe=6AEB2E4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
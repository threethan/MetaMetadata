lbAW91Z7_Au7kD8EWHnqJ1zlLw&oe=6A637EF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmIBoYRAuFcQ7kNvwEHI3-f&_nc_oc=AdpTepsAmV2oh1gQgquIjcs8Gspe7qNuGl8SmNgCPGZ2sQd_34FTC2Mhq4EjKnziWdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJAi4ZMO6jZ_WhWqywC6-g1ZZlE3gTm5QRzb36vmANKQ&oe=6A6370A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3VnLnt7m9QQ7kNvwEuoJN9&_nc_oc=AdpXKMsp0wYO0-hNnx6_wL5QknltVMZbUMZL7j8xojlrkmwK6BVsZClfNKk33l60UT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtrpWYmU0zmWoMAnAJmK6pp5-oylS-s6BdtrTw2cM6fQ&oe=6A636284"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHeGr15yYOoQ7kNvwFzJA8i&_nc_oc=AdpTet4DgzHdE81bSWnFMRnQSXko2zOuaNxam1gCVEQzM0GcVvuiWEoWGuNXbf29yII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSIwcv2lpoa06O6V1l6rmlAhdh5P7qrhEkndm_hd1erA&oe=6A636E11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3ZZCfIxLQ0Q7kNvwFRKeNI&_nc_oc=AdpVAKfwqdPsucxNwhAxRytX4bR8z6JNzNpzmd5nOKHpKoSrJIIhHCPr_rKj4DpEkl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG8Mt9X87kHlJxPerz7U7ndpONLLVuLtm7scXEDEjvJA&oe=6A6363CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "# * * * AWARD WINNING * * * \n2024 NYX Game Awards \"Meta Quest VR Game - Indie\" Grand Winner\n\n\n# Welcome to the Space Salvage Corporation!\n\nSit down, put your feet up and get ready to dive into the vibrant world of **Space Salvage**! Immerse yourself in this **thrilling cosmic adventure** filled with stunningly colourful nebulae and ambient 80's inspired jams to groove to as you **fly your pod in search of refuse.** \n\n\n# What to expect...\n\n\n**As a trainee** at the Space Salvage Corp, you will be expected to expertly pilot your pod through numerous pockets of space, some more dangerous than others.\n\nEquipped with **30 environments, 3 distinct narrative paths and a slew of fun challenges**, Space Salvage offers a liberating take on the sci-fi genre, allowing you to **forge your own path** towards anywhere from a calm dweller among the stars to a combat pilot feared by competition. \n\nHop on for a quick 10 minute mission or sink hours into the unfolding story, the choice is yours!\n\nYou might not want to slack on the job too much! Earning credits allows you to **purchase upgrades** and **customise your ship** to fit your playstyle. \n\n# So what are you waiting for?! Join the SSC today!\n", "short_description": "Sit down, relax and get ready to dive into the world of Space Salvage!\n\nAs a trainee at Space Salvage Corp, you will explore 30 environments, 3 narrative paths and a slew of fun challenges. Forge your path anywhere from a calm dweller among the stars to a combat pilot feared by the competition. Hop on for a quick 10 minute mission or sink hours into the unfolding story.\n\nEarn credits to purchase upgrades and customise your ship to fit your style. So what are you waiting for? Join the SSC today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "web
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbvqEADMzyUQ7kNvwGj0lZ6&_nc_oc=AdrnC6ioHzrZJqRNKceo-TUTSpD0QnIwrqKxAtir7xXiZ4xMdrCeDDKzxcK22X-tcn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzDmt_aXDNhexd2gTOREpw1KahXzWqhn9eXabhHoSXTA&oe=6A75F3F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSujFRCB7f8Q7kNvwHpsZ6V&_nc_oc=AdqaU1IFQdvdEdkj5NILz_yWMZPcPi2JYd3ow2oUIeRy8HLWbzBk4H7G62RIhQPk7Y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNgQlVzzCJD0UJGw72ReM8F09O0e_oO0c5SYcTsNM2SQ&oe=6A75E5A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9--VL0ns8ucQ7kNvwHJzj46&_nc_oc=Ado-FuA7eUeis3D9KKFI5NWwVCdfIc-VBCDnMwRoWiQ1m_ZYE5mwbmsvfK9LDJkFTgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpN2lo6A5qomvQYeWHBADOr_DL3HRzTqZx10DilQccZg&oe=6A75D784"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-BbG3JyhjIQ7kNvwHPVJ3M&_nc_oc=AdoAk5Txmj_H_19UHHty23q-sDqKhhtinLbTRWMWVFQ5Zi3wnDz_TBCUAaT97Nu8osU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU7X75AHX70qjy8lUPX8rCqKCxSrf_faGiMOGLAjm0Kw&oe=6A75E311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNFa5oEA5VAQ7kNvwEc-WcS&_nc_oc=AdoOyNLTS-uno9BV_CWguNbYiV6gL4cvpJ4ziXRg2xfw-qPyIw6YBIJ7BtmYHNLp9Kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy8TN2nFG5t8fXaDckMMqsHMYOfLPJxVIGjd7rvTDaEA&oe=6A75D8CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
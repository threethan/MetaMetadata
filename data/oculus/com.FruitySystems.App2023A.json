-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66_r6CWpYPsQ7kNvwFdoyB_&_nc_oc=Adp-LRMUkXGUiO4U-2BcAEGG0c0jHQP7CK3FBrRDic2EvGkBZIADDUlcBL7NGpuTPT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUQcy74nniT4AP7YnA-CFAEUH9db_UNTbgxU5jObIxmA&oe=6AA80CF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxPAP7g73xkQ7kNvwHLGyMH&_nc_oc=AdqfrVgLdRqlkukgj9M4lmP8pdH_pZi0xpMRo4q0T9Cg8BeGVnU3Q5D12n7s7qcJpbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKplwU6Vqx1fDoROiMjwD33tUOUr46wCRSBB5e21A_LHw&oe=6AA7FEA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfRjDQaYzGMQ7kNvwF8gP4J&_nc_oc=Ado9aNnq6FXvGDQq2lJchrO4lOTynmYEfh1mXlLqF6Max7oZ_p1JqD5Ci_5-iiKKKqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYgFj-DU5H1ViljHvTd4gQmAndA-L45IT0BXT9Ffki5g&oe=6AA7F084"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD1rSUtrgg4Q7kNvwGkmkLK&_nc_oc=Adp6rh4iedu7wtbqoPGbAe36YtZEJQ4kFWgHXsVSCqVwiBX7LzH-4-UNcy_BYA9Z_lg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-gV1Vkyq8GFKgcVqR7xuGuWXFQAOrd3oubneVCdCPdQ&oe=6AA7FC11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhVbiunyoucQ7kNvwHD9eSs&_nc_oc=AdoVj8kX8w9T3KTu2zwUWdeYiWxjf_AJdVwfinxlPdKhddkp4I0aN1h4WkxAlOaJJeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSlwraJPBrhceB9sb5qS5N-dvhv30CA_COXgin91p3lg&oe=6AA7F1CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
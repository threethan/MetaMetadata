-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdgV5Rst7GgQ7kNvwFuM4Vb&_nc_oc=AdqbdOxjLiXjR5tSjbTRXzGauVsYch1Z86kJAccqrtzOab2Kmj0jmmFCQ418pXg79G8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bxOg7o84JfEHR2IC_PMWaOyJN4aHXsBz1OToBrbiRkg&oe=6A3FE677"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDSh43NCNnUQ7kNvwGNr1gT&_nc_oc=AdqSNrMl2KBN-AbgrT0vHe-JZmcJgThJk5F1UpRG2tauYQVvhWkP-0aik1vCwN5ZvWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OBip7WZg74sBcw2-djqzqbkeswTyudwwJm4bsEtt9DA&oe=6A3FD825"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87LdX5NaJnAQ7kNvwFUEUxz&_nc_oc=AdoAZJbCE5_uwlbrEFfOK9Rbr3zjT1V1J16-zeFlfTNXQ00-8IR4LxsFQPgL8gKmDyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-16r9egf7YZ786hlUKD8e3YhrlM3CsRZMilV2NIj7TcA&oe=6A3FCA04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUO-Sd-pMc8Q7kNvwHS9ckx&_nc_oc=AdpuIddJJBgRU9RWR6nKuAADWi42ogUFkL9ej6t8xe81JKmec7JXzSUwMozk5BQK1b0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6U6_h0TqMmJoq3IzrRKc3vP4BQ3dhWl-8xhhqUlD86A&oe=6A3FD591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPMjsJSyhpQQ7kNvwGHRlD2&_nc_oc=AdoaPV130ak7qLATY14C4Tp6AQgX8EIvO7N4S7ONeQ7CwmptHpQrBsIDaxh3STWFBZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pMdlKW-oNQjGN0KE02ydu5eeQ8q8SNicXFr4ONQI25g&oe=6A3FCB4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
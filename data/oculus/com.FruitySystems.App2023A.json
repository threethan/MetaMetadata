-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxw-dkR_sD8Q7kNvwH3_nkm&_nc_oc=AdpOlZEnnfbGgO_tUltUFd1yOd_4Jci414xm5IOk2Io0JWl88t1ubndnxaeCtpa_GO8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DB3rVo4lCJFwGK2sjzp-r1m-AmvdRx00wJijqb_dM9g&oe=6A2C1FF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzaiUdQOJN4Q7kNvwEyDYqL&_nc_oc=AdpbkcdRfTAzN6ZazyjIW_8iE-_mHXJTbbQJF0FlJF9HgbCXxeSWnKHT5L-W5M8lsoI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NEpoG9Xjj31eC7q8VmPT6AOtlqV3dG-vaxLVFgrQMIQ&oe=6A2C11A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnfVNwAcMEEQ7kNvwGojI6s&_nc_oc=AdpoxNCBSzngIJrhpfSQGhBbDWkV3HzXbI3vofYcJGHS8dpbTHnSKawCced5m5sdYWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NzFOCI20qsbei2kk8b0BVoVNiKdNIrCYJVRvTV05gEQ&oe=6A2C0384"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A01s7WxbZqYQ7kNvwGpyD9J&_nc_oc=AdrPWWasl7MC49BsT9tYBHkjkV8IdreunBD6QCQ45B0fm3lMdgvn2x1ZUT25v5kmC10&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KekrRWU79xMrvLtWWpcg5WxaPA-eTgUCpDI-w7qVOBg&oe=6A2C0F11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbNnV9nu2KoQ7kNvwFdBnwH&_nc_oc=AdrpPEbDzEKepk-ICnXeh31RtUn_t4HWoGjIe91fZFXCmq6CRHA21LO44U7RFMApX2I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nG8rEPq4cJf3yksJRWK7pzSxQB5M4_PDBIWsv2doq8g&oe=6A2C04CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
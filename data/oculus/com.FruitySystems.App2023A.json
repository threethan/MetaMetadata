-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZrz9SXAq2gQ7kNvwFMsFe-&_nc_oc=AdqZV6dmhMKFBv1aqD6ZSy3dUkIFIjkcwQ6PoRipVPRcZQVZPLPdF01Q-7N5LNqSpzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dh3kdzDDKZbSi22DV1sdTfEojOOmJ_PE5ljip_XM-lg&oe=69D39337"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLaJcebkXAwQ7kNvwFVCjGg&_nc_oc=Adqy-KNzVP7dSM-70Ycls6hST1tksy2g7tvj51Wep9eu5MW_rWc9qXsqSJxdUyXsAEM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Vh3UdBsEESUrgmzpDtHsa3zPArMw2Jo_tfhGRBg9IAQ&oe=69D3BD25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGIAF4j8IEAQ7kNvwEkWjnN&_nc_oc=AdopjUMWEQkVFg1_9_mtEDJtd3RUvrwb-aL3uC4Q0Xqx8bvMIw1obsBJ08aoadbasqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v2oZaoDMUDQ6JsSUBoED9B4EtiS-bHzgQ4a9PUopY6Q&oe=69D3AF04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNAh74JmCj8Q7kNvwHIrYpR&_nc_oc=AdqomFKP9_YTupv_lAvK19uc84b8xjISgoywrsy9LXb_G412yn3L43p0OLox__BYc7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04XoM5_avo2sJKZJ0z0pUq9hJrTgis5N1vqFPKpEx4Xg&oe=69D3BA91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QEBJOpttAEQ7kNvwHylx45&_nc_oc=AdpyLSbygcgSpF_K3gqHzgZ3hSkfHsaX0H_J1bnqZn5NhYTOlCG-KFPY_LLS4t2bGOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IU79BarohnwC-AqQzvXjBpKsKGscLq1C3fO07DFStHQ&oe=69D3B04B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxOBVtyghygQ7kNvwFrqkgA&_nc_oc=AdpXiMqyWZxTG1cL3b4q2tM-VM038km3WFDdbuyMTFQoHEChnKMOQ6Cy_QCGeVzDc3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z1uqAhPqTQIYIfgf6DWxYPELKjq-G8nlRGgj1GB5RBQ&oe=6A3165F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPq2hP15HSsQ7kNvwFn4WhP&_nc_oc=AdrmqmX4NfcDRvbSCWYTq8KsOPytabC6wPSM0Os-Xipg1dupXh-0bGXYji9NY6cl_rM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90pSloHsyL2F57F6qxlbzTQHnSilWERAhC82aWykf4ug&oe=6A3157A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM-AyN6HHPEQ7kNvwE8u55l&_nc_oc=AdpVTXwStGTRhc6T_fUj0LVnmY6KgM33PGM9pcpvjN_xXytxoiQ3DfVJ494vawF2hdk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9biJsOSZ_HMYsF8xzzuFaxYu2GwE_unpazAWLNvzY2dg&oe=6A314984"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiYHxiYZ7dIQ7kNvwFWrjud&_nc_oc=AdqIZFPyyR-YSzoxpUMgdwe6MjNA5ViWd1Yh6m2qq7eh56xV811GwqYFc5rEaSxCyzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_83fACCNbyNuUd4Mz-c6yR-0h5AzGx4U7loq11wWJsiQ&oe=6A315511"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7KaR9gyLG0Q7kNvwGcepHA&_nc_oc=AdrHAbgHZtgBeUmwlIKurfCPVqTGwNHXu7pabsTmm5GLN_LPJKiFp4siZnCG87dGjXY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NNpHrAGzfgyroXtFwe0IImNhv4Epi55_jKPJyjJhI7A&oe=6A314ACB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
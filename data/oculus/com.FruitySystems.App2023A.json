-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66_r6CWpYPsQ7kNvwF7LgqY&_nc_oc=AdoAxsmYi7Ntx9fHZq4PJPOR00re35K1AbrP1ho5wUcyWCjVzIl6xToAjStDMDZX8yM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQsuOoRebsj3sererZEj_C3kTYcYralt1LAwEMNiiiDg&oe=6AA569F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OfVgv7vFp0Q7kNvwHVgdjS&_nc_oc=Adpk_fT5QwUy709isnXBAQ0H9V1QYjcReUWhrfp1yUsSrlZ45ejh__T_rACpgwhMe28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ04np-jHlL8a33wVwGqpChZDn32oiggu1LGhKItkuanA&oe=6AA55BA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnLefKkYm58Q7kNvwHVjb2T&_nc_oc=AdpnZ3N1n-UVjOlBV9d-FWaY9linvKPbR9c31z-gJYfMZeaDlaPBE9TZ6HVSqDw7Q8k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWCoNFQwuA7vC9qgfUI47a6z0TGOvSFPgRPqaYUWf-_g&oe=6AA54D84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD1rSUtrgg4Q7kNvwF7wE8e&_nc_oc=AdoSMdoBSocs5AKbJ8CQcOupjtVyGdafgI_Ivd7_Q7_9bAprR6rEqMR6GfNVrFoMCyc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRP3I7ipijxvrn7C8-MuDl4GSGA5DqcEmEPKWF6FmEGA&oe=6AA55911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5V4-nOB1PIQ7kNvwFzGxjj&_nc_oc=AdqnOJ7I3l90y3BmZBZDKM1JgSId9OStC9HETfMGmpjYEh-6IrMDN0nkHS6zYM0Jh-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9gU--ovpDjs0NfNwdfwYAP3u8XF5Qvt1c8oJU_UPtcw&oe=6AA54ECB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
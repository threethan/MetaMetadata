.oculuscdn.com/v/t64.5771-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFEGf8SrVvYQ7kNvwHhjI8X&_nc_oc=Ado8OPf_sL39fAGAVjLRfu2NeFDUbAZ_Y-02raSeUeMeu363p8pNdqF1o-KlHy-AO6U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGquI16jn6WQYWJHME8TY2O1CXCs32EHcH8y-T4nZWKQQ&oe=6A7DA4B7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INqpoDfovuAQ7kNvwGk2BCe&_nc_oc=Adp_m0mICJ2YXhuwZGvO2BLfZdfphJfh10Vd84N6u0ZIRRERh5fs9_Kb10rvf3v3GQI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnB5-peNwGezCZUEoTcWpFS6WR3He_jHYLXk1y8klUAQ&oe=6A7DCEA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdYoq7rinjcQ7kNvwGswG9N&_nc_oc=AdpZcIUVAZPE5ae6Fg53ko5HaD7H3LvMvzPf8LXNm_s13viULtnh2zUxMWmx4e_Swqo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwNpmzAk2w9PB20NeJtw93L1AXvcmfBePL2BIH3xSkDw&oe=6A7DC084"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6cDEkXpXecQ7kNvwHTVBoS&_nc_oc=Adr8F2ddbF-AOUst8ZbL_VUnl-2NTQeNIhBj-6tUFtZrU-e1Pgcrdu31hQhLuSfOHmk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO5F3TLU83s1BLA8A4GCBK7z5WJaW1J_0zgcU6vkoeog&oe=6A7DCC11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8yDcQODX58Q7kNvwHjYBn9&_nc_oc=AdrcUDTkpZ5Ro0BGeM0hNBmXyVv5BBGXDEg3ZYqWOQqaWm3jl3wn0Gqq14F3VBx5e9M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxUZkxfbn66kLtzQDr1S3k3RdlY7aBRjjW4vCgV6PszQ&oe=6A7DC1CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269189016446
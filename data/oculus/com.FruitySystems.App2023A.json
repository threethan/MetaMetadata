-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ-0k2tHSKcQ7kNvwEyyB9V&_nc_oc=AdrezB_PQjc5wU4Nstv2lkliIfoN-KngG_dEjNc5_0_KQCvLbXmsFvEDIL3RKQwBlpY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4urYCXCx7xaYR1wK71jhCl5c1blUkhHLun2iGEgljYA&oe=6A53ACF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDRL-FjUDH0Q7kNvwEpXMPj&_nc_oc=Adr9-PBmjTxataKi5m-EawT-q7Z-k_kZ4Lk_ePG8Pe3XHbEJNN2CPsgb0r2sePjD51c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC61qkXfSKrwS_svDjisz4X7IKpXnN2cDmf5G5PDHo8Qg&oe=6A539EA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIlLrL8l8MgQ7kNvwGC4MqK&_nc_oc=Adq6GscjUAkLNouuk9mMJCgkmDi6GN23wges6opJbyG1h3Btziq5qo_NnudV74DwiK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjZMQFsNDX34Ct4v_1kwS1siqMNa_iGzIimQ0a3kypMQ&oe=6A539084"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnodvUk96uMQ7kNvwE_ccMq&_nc_oc=AdoRQ6PxH06YNN5_cnudD34SZ9eSIWQlvol3gTJaxR_p_EamymhcPCXVj2-s82e96dI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQj_HmsNzjX2lkB5VHl3FEUh0UVJxcnzctmmwGzogSSw&oe=6A539C11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91Uu602h25cQ7kNvwGwDMXV&_nc_oc=AdpEwQIknCHT-RTLOHmaYX_SnIgKVACYOpRyPMoeYEo5Nzx1tSIKPI3ZrIagpvf76ww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLaebYFSgMfbuzg13nsx5wUZnYQRB5Ln-Bp1syl6LC3g&oe=6A5391CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
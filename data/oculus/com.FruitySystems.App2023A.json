-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdnpTkVoMAIQ7kNvwFPype9&_nc_oc=AdpWLJ9fCTqN8GdZyHyBwRWCH3YSJwzEMgGHaMidYI11Q2unQoaDZhk4IDMQU7bkKlk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RUyrXKBXJ-ZnfNTF4SBaWJXVzrooSKie8-dj9kaJzSw&oe=69FA06F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BORLa1IqlV8Q7kNvwH27CAz&_nc_oc=AdqGhxcPe07KqJYIRL9Y4riNEBXAAF7KlKQUkbagKD3JBxj1CD-DlriPtK-b_wn-eno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Nmw7UMEggVnI7rLB6YoNJ0kmxnHMo9d2J5wcLKgFI4w&oe=69F9F8A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcHxgH8CYJEQ7kNvwFmc9o1&_nc_oc=AdoBDiePR9Ssw6COt9xINgC8tdMVlTniXnpr_wvYiYdPZ-lyeGnazGLy3IDsxNi2Y9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bD-MLifks9IUcSfeSRlfzWu615m1FPvAT6mxsij5HMg&oe=69F9EA84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwtWTA8VwWoQ7kNvwGPUayH&_nc_oc=AdpHnWl--exQh8dIEWxtb7mRmJQbzaYjTINqkQt4cVRh2fmknqaSXY3JIbjAcbMEXCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q7JflrAHrpmndi_qpWt9IPkdHu_rNBFsYuyzM_2J3iA&oe=69F9F611"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZGV1BZm9ZgQ7kNvwHJhTcr&_nc_oc=Adqmi4IQ1i1HB0Gz35oPQdpiIjsPxDp01Hqgy5VVsdM7FPeAJh9vQ2VTIcuvsgrAtTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zo0CEb-kDvNydD0tGfvIztQLbpggVU9x5lFEfUuV2kg&oe=69F9EBCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
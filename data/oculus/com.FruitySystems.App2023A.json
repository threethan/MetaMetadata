-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y3gmuNpWxYQ7kNvwGKSy_p&_nc_oc=AdqxtQ9-dYYi9mqS8WIvpcbHm1ByeNaNmTdBE1FW6y_KlGRA1WwIdGYhDc3-enY9zI0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOAf8ncSLF9O1mRgSE_CG8L7hCoSNrGWGjilMxK-hplA&oe=69C66437"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tw9IOjMpW8Q7kNvwHlKj32&_nc_oc=AdouowbjKHEF1qgxw5RO7cK--aDZAT2MLogaAn9MJmnFFlfGkcNnb1KmsSspXLIb1y4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3x8ZPbq1RW4wAhgTd0x-528cMjwSwESaFWNss12BJeg&oe=69C68E25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8F-ljTn5scQ7kNvwFDKIcp&_nc_oc=AdpdJbhlSB_L0wnCefRmyj34DrblcZ7QoAVP8O79R3WulRV9hXJQOPp-RZuoKW6wIFY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwr2fytEJ1HpXZtlQepSU5_KcIzuQpk3rYLDAPhzMN3Xw&oe=69C68004"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJevsQ4dLDcQ7kNvwGQHHhR&_nc_oc=AdqlSGj1BUadZjbMIGJipPgNB3GruCB0WvJa-NN98yJwWTbil_lsG1vut88vm1vsRFQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZojQqaSRqJsbOxmDThdS1GJmH0eBLpC9Hwd2YOJmrIw&oe=69C68B91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nnb39AfDi4Q7kNvwHmx_yD&_nc_oc=Adpm8vBpd6tWmNhsovVt7tP6HpZxztbKEIjd6OfnMYSdrHjPZTuvxCoYli2LZN5Y8-w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziC2kGoeXEnqRLf88s60bUyvhHUeaffP7WDSXwk0jQWg&oe=69C6814B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
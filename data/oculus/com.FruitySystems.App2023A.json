-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGTtI49DN6wQ7kNvwF4F7Hh&_nc_oc=AdrEk5XfeVYTSeMDqP0lkqDZkliTXWmrVLZKGZlq2sMhKJUzmgOD6VR9abm4yZk7Wf0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y6IEXrxuS7X81LAZdOouZw8xEwQuAQbIEiNvHE5O3sg&oe=6A09D8F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuklmkT8liAQ7kNvwFrOZKl&_nc_oc=Adpss5AvIi_uZdr_FUi-3rdQmBSbJ5uEvIOCI18YMyyct9nparsQSNX3ImyK63lJS5o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l7pirrTJ5pPlBHgd6IdIBR7edsea9IOMK5XIMIJDzxg&oe=6A09CAA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxcoGwVo8vcQ7kNvwHXiRcR&_nc_oc=AdrMbZx0_kuXLCctUr6Y9HCFhvXjUCT2hweUhtd5Y5eGCRMJD_bh3Rybq5fC2OpvMQg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t8qTM_K29n6Cibvioqi1YDqtT97SAmrFVKMQXtukEIg&oe=6A09BC84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d5acvRLwMwQ7kNvwGJTz9d&_nc_oc=AdrJP1DK6nySUjfGk_8PJKwd_gh5nP3CtlULVyedYbmY0QfUZz-DVtZ8gPea08TqbXg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_10V6ndwEfEzAw6CS9bK04-FbLlN_YjXwM9J13Wx8EQ&oe=6A09C811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCPtAM80t6wQ7kNvwEQL79b&_nc_oc=AdrGi79yCGvS5Uwnd_0vohp1nfqbswJF9v-Vqxp-488U6tsMa0JHhJNnJL8z9cUBcN4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EdTSIKzCkmVY6-J_wVByougnfbMZjJ5hb7xRaVfmobg&oe=6A09BDCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
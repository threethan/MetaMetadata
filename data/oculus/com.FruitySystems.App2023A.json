-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsJp6KkQyTwQ7kNvwE-ABYD&_nc_oc=AdofmT12_ENJMTEqbsFRh7Nt3KlWT4Sdz69aaymUxUTLwqVVZ88_W4AXffBvGltxLpo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T5WxE4b0bVsCf5Sx6ajYPSSbdmYZLFSCxZdDke0sQHQ&oe=6A26D9F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=titgkSfynGgQ7kNvwHp_nXV&_nc_oc=Ado6BxOFNuJs9gOow6sQw_Hsao_bOBkIBDiF9D8Z866yDEgfxOIQPq_hTW2aA3fud-M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jtSpXSQH2uuxLTdPNU1T5m4NAuzY-uBIGq0OHDaP-eQ&oe=6A26CBA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUYvmavturMQ7kNvwEYyzWU&_nc_oc=Adrsi4wsbnJGFSado1lOqHlytm7L5lVnjCY4x5c17lwYpefWDriDhkOMTFYc73qx7ik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hK_KBqJciiCrN0f7Qy-oGbObzvpnR2OdQhMZ27Kd6EQ&oe=6A26BD84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrhZ0E2lpf4Q7kNvwEtSX5p&_nc_oc=AdpdScCRTgeK2iGHcQ1sMKvuZTYDLp09aQwZlg2HZvxHVou24N1F6Ct6JJbN2gzaqvw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97uToZWbPrPsT3tInAdAdN0_XA9WU9WxiLGLn8Pcji7g&oe=6A26C911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWP60ZhCfKUQ7kNvwHQLGRR&_nc_oc=AdpYGGhFW4GZok07nLQ4S5JpbbCJZ6UnHrRgkryM4mgIE3foEnMN4OsjmROrIOdY7Xk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xMCOR7VnUGOY3eKYfGPpngvGsiJmmozZvD1QMTeBmzg&oe=6A26BECB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
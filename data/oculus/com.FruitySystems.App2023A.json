-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0aQxOutGMEQ7kNvwGJzOJA&_nc_oc=AdqUFk_8Go0fdUA_chrMsn8Jt5LOCKQKDTAARQdi72SuhOu7Ih3Mlgeggwxxs4vf-Nc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf8z5yjpUa8g5bW9VBDy56mHzl9ApBYrWIQTypJf89ZA&oe=6A7350F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSujFRCB7f8Q7kNvwFVGFNr&_nc_oc=AdralZiDdV07BSjhFcW4XadTImcapBuNzV0-iOxYajIwMEmztaKvXr1KoqJ32L8ON_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPmVSp3MdD9opK5-w0z2XBg027aku70sAxpzRuzsbR5A&oe=6A7342A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v53_TW8baUAQ7kNvwEtitKy&_nc_oc=AdpnA_6TlrLgIfD7FiIY4SSI54E_6uFk0c8zA8VbI3-yB94tCdWDfbs2MzEkmbj7iuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL2SMXYRVrREOIB2lCPZbHiqZziNr8UN4iP6HZuvEXGA&oe=6A733484"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veu_f-5pPzcQ7kNvwHDMbHD&_nc_oc=Ado6CDKqVj6tuUJZ__RMmdazLWbp5U6nEgybFMNG_aR-KBdvaRZHzcWaiD-ukE0qHA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuAPhs6JDl6NgEK3zxLL04vI3LHBKmCd1nQNnQ1FmESQ&oe=6A734011"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T2bCRMwlhsQ7kNvwEyraQ8&_nc_oc=AdpkvCj-5zCSn_-SOSIY5l6GF7Wd0tIk9YHl5TE9xsoRDYLNoDMpCqCsHw1AUSlJ4rk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCmhHbFteStVKvZJW__n36gfiC4TS5m8ve07SG3KAgjw&oe=6A7335CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
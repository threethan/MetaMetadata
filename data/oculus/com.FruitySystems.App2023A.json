.oculuscdn.com/v/t64.5771-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33hyeovgN4UQ7kNvwH0IKCl&_nc_oc=Adoc6S5jqepp_99r9WH_QDpHCxgL-IbV_g1D40HFBDlrLKen4GAJX8eck3UQAjCUaf8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9aPwELQ_zqwlMiNuNtJmg__AH2M873qbuJmTHObmfcQ&oe=6AA95E77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxPAP7g73xkQ7kNvwEeazld&_nc_oc=AdoHtVd5uBlr1xdTtzKsiV3mnFCUndeucjEuGxSmRzKIGK9xdy9PViBP3MyT0uS9_Rg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaheUnm1JTwNpdLGBpADtvylKfmfav6SjyTfDChBZOyw&oe=6AA95025"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfRjDQaYzGMQ7kNvwFsW-Ct&_nc_oc=Adr1SeRgujQ0zhc81nBwUqNs3ACk0Z-5Lk4ny3HvqEx1iEty6oIsp572-ASrPlkFPcc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnHjC6nMix-kXAhrlyPvIm86g6aAuLUXqDeKdDx1dDVA&oe=6AA94204"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ_g4gefhEwQ7kNvwF0-fFx&_nc_oc=Adqj3OXcI7kpJE8InNdWyRkmduoCGn0d6twSp_wKHd-YYZWdn9xL7HIecrVuwpVRrms&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9ghBInwbbkhZ1J8dM_qGr5A149tlZjR4mU8Qg-L8ohQ&oe=6AA94D91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhVbiunyoucQ7kNvwGM6Hxn&_nc_oc=AdoU-6h11gYeBSkhy-bF9Y8_yWIvyIqte54ig0BLnOtpCBtaxFe1RfLdlgNoeh1QFUQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINgl4mxwgAbftkls_RQw3Xivj3F6WfXnyTaFPrTp8E3w&oe=6AA9434B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269189016446
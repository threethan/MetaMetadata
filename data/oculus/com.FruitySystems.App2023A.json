-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B68f8Bj3D0Q7kNvwGbap5J&_nc_oc=Adp_Hhgnq1tHvMfGm6d7_mmRVaY9Wo-vSfcQWxSBngqh-VTi-PW6SRQKq0QFPNDISzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7yK6mNoQNG695FffYZMSv5klHzb0ABGIHrHq4wpxmgg&oe=69CE4D37"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_lH0txhXLgQ7kNvwGfhz-j&_nc_oc=AdruPXA6ESVPUmIZpD6ChI9a2Z6jZ8lNQlhyMRRVTEAZayv7F-x7QIkNhsNFpONwEis&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHufF5Y9prH3vfYN1sqXTozxAUPwi-9lnvYT3SdNaejw&oe=69CE7725"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERIbRNsXKooQ7kNvwH6B5dQ&_nc_oc=AdriFoKUqBM1mtjkBRgxb8DmIid-4EOMv8ntrWMTtfBZuEeHzz7MniEjPxkxY1-saJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvC-CLWWnHO_sEjCZaYoMJH9NsWE9yNq8E6-Gq6wubwg&oe=69CE6904"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rApRCdPERAgQ7kNvwEXTZIW&_nc_oc=Adr6JuUDUfoFT3zBPtc97B4goIwpUur7c_RpCKQfjw-xFDfULvGwAi79SXu3KE9ICzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuKeXbMJ76xXWwFyZPyKWO1xexHSuZGax-yWv75GKP_A&oe=69CE7491"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w_zhgpsdgkQ7kNvwGsvl-v&_nc_oc=Adrpu_4QZ7MADTEWEePNXyeffuROEis-8L6ghIkOU6tldetYwl1wKWjku6FrDcSzfQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1Ne3XyZHWGiy-gQhY83HUgit6HMCNVeUEmr9uOdA-8Q&oe=69CE6A4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0aQxOutGMEQ7kNvwF9ELRu&_nc_oc=AdqfRYcdIETStVmsByd5Pk3Bxvx_74u7lOgKplNenJO0jJUwCApeXFf28ZRc6etcBpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUXsKShqibPD5IUq0qS4fIG20gzyUkfpLK3O-_VCEuZw&oe=6A74A277"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSujFRCB7f8Q7kNvwGHCkbl&_nc_oc=AdqLxziI1F5fErsmbxrkvgl_gRnjPrIFrLE8lFTjwZ0qe9BQDl6xpkcgYAIoYqDT8w4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyvhRIn3C8XC0ao6lOfiLTauo8fmnBKj7VfBnhNGjEZQ&oe=6A749425"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9--VL0ns8ucQ7kNvwFKiRyj&_nc_oc=AdpXbOj2mXxZ8AqqqxOpm8s4nT1TGxGEzAmIAcI6GBHt_Sy2zTFw0ekVfe9fckJalAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZOSa-0dgMkra4uA6fUL2Pc4PyJxwM2mVZQtC_vdK2Fg&oe=6A748604"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veu_f-5pPzcQ7kNvwGib7Ii&_nc_oc=Adrkvv-Ll_LiELlrFpBpqt4sAO2RW7O9NhgoZGnIR65XD1XHFh5VJdzpTfJL93c7zIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcBamcL4Zu_63mHupr3jGm0qIG_pk2riC6MNKJOB8OIw&oe=6A749191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNFa5oEA5VAQ7kNvwFvIQRV&_nc_oc=AdqXe4Ntkr97-ixM-GMmnlCmZ0qoD7DPVxo2YAwRH_iHkEuFrDJHTNxb8kgldMkJyFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYVROsXW0fPyt12WU9bujjtecDV-RMNamIP8XTIYJSGA&oe=6A74874B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
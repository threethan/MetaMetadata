-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1TL_zM3rrkQ7kNvwFQaMI0&_nc_oc=Adr7WEJHoJJwaYgOea3rsLIiBG98FaE-9b_Rf9QlNZt14OoeQecRUE_nWKOrNXMuRJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7CFQpOp6bJySAqpbiLBPV4GPFDgOaIiN2AIVFhnFd5w&oe=6AA2C6F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OfVgv7vFp0Q7kNvwEixPGk&_nc_oc=Ado42YdUG9vuGj5UwYAsr6wHa_Q5giMhO4jolGpb1d3xBDawa0ga02jpoWWdJlKm6lY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCZtRj32-Yls982lFBv7HcguiulxdkErjSfeKULgoGkg&oe=6AA2B8A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zENpr_mNRUIQ7kNvwHCaX5k&_nc_oc=Adr8uf3wyicVDt--Ed7yeVDkfVMEf6E63tm9dg4WOlMNJUic3CS5KMi1_bTPp1ttlRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImBfmLHwTEjMFSZPSmZoCSS9qGQU9PHp3c92Br2yhoaA&oe=6AA2AA84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_PmGoAi7-EQ7kNvwGNcPoY&_nc_oc=Adr2dm7kwUoZP_2C7llM2Yg1ldDCL4ytabXWTOOkHoamYZfLwnKwLyxdxl4NFGeDY6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1lV3F_XzdQyVR9rWevy2BT5oruSjRvZso-l-x8GrsDg&oe=6AA2B611"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viwnXIva4uYQ7kNvwFgPUQU&_nc_oc=Adp1UZjjDgicmbaTHaTjEekhk0SXjEA-6gW32XBrAsS-8Kf1XuORSUAK31ftUhfaPzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7Mf6TC8tdmEujAzyT2_kOe2EnuEhrRjbCRUO8wX4WzQ&oe=6AA2ABCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
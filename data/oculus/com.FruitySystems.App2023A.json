-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0aQxOutGMEQ7kNvwFcvztU&_nc_oc=AdqGuWvmyqIKwQkyeDuaus4mSqE96M8ElcvYVmYuYsa_3vlGft_OJVntNAD1eA-TA_o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtb8LWg9yHnVKgP4MuN_XIBkU1_XwifGlitvbV-9z-xg&oe=6A71FF77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJFZoP44hTIQ7kNvwG_kidh&_nc_oc=AdrikpkadfpxVVa_N6_SR59ZEgzvWj3mSCiS1u_nuIo8LgzVaQUZmbjgyJpIQPHHGAg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ7vP5AHdjjtyt6NJgsZ8sG2tkDggDphYljuATwoo8Ww&oe=6A71F125"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v53_TW8baUAQ7kNvwEZHWem&_nc_oc=Adq0Vdzfx8CWvTgSShg9i4oK0cu-gdSw5yM9XjFZBrpEprGEcgHXuck9mzE7vB5TTUo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvvIGf_kNkToa6ZoCSxHm7KtUXdQFfSyoyDadHGdo5lg&oe=6A71E304"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veu_f-5pPzcQ7kNvwEKwuaT&_nc_oc=Adp9OebaCU3nV9Vn33G1CrcHoiTHvsPVa7vbRQPWy0fHvtnBXrvfMcUPni2-eh-rNX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrGDox2jhHAObP306G_bGc36hPA7uO4CmAgiN6peREaw&oe=6A71EE91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T2bCRMwlhsQ7kNvwG3rue2&_nc_oc=AdqxvmOoythUQDNT-JrBxj7OqmM7qPG1PnpzVeF7eWpRXmQPA58TLnX4yczuU1CX3RY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzENZVo3cdQ6JcWcLuZJoP0Cmp8Zel8NjXQwurHgCH_Q&oe=6A71E44B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhjvxTgCEkIQ7kNvwHTbSem&_nc_oc=AdpcrRMRnUfR32NE2qgh9KrJHlbXO0_20xgyGIabIlWGUzFCoxsYeH1FvUxL44G5YuI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ELoZGBVGPjGs1mAuuYdLnkSIP8wwPbNbG80NbMacxXg&oe=6A3D4377"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6w_I_PeZpMQ7kNvwFPf46k&_nc_oc=AdpBmmKWMtS71-b1WvQx5W8p_RvxGP_L_O02dyARAtKEMCgSMEpeluwj3sGjDfjVPtE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Iz7pd8BCGPgyGfkJmUmXo_SLp65qxQCdyZiphzETOVQ&oe=6A3D3525"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87LdX5NaJnAQ7kNvwEUh5WN&_nc_oc=AdrNkgOqtAII0i2GC-MfK0vGZ918TU3LcnWWXy6IsgAFf-M8ek3FHTxuldQ1miTJSqQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95LOJDKn-WYKbf1vlWQQP6WASTtp06mO0l5hQ0O8ks_A&oe=6A3D2704"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vYTuU856PcQ7kNvwEmlLqj&_nc_oc=AdpHOooWSx7f76XUVGUOT7HQ5M-cbUKQ16rVjBzBuwmTPO355yzhTFQzYCT-eoK0Aow&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EqNs7y8UC-bKB6kaneiBLqwY4yZKh-pT1Gq1HXRujYw&oe=6A3D3291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPMjsJSyhpQQ7kNvwGGY5mg&_nc_oc=AdpdhTTwYlVQ5ykqPYQ26agrm6ny5kH3jFposNEAkS0yUv8YMa_zhoxeU0XOXGZ_OKE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lCLZU6aVbwVJPbbee06cmfMfUzjbUk9CsJu4mH9u9Rg&oe=6A3D284B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
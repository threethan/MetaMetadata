-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6uoNx3AJ-AQ7kNvwGcefSY&_nc_oc=Adpjy_k-ziZy2n7hNMVxNZPCwbXkL-bW_Ntv-sErkv1Wo1E8VreC8Gu324ftKQ24Z4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BdqLUUpzVO5icT8Ku54GvVHImfQOzBJR0LcmMUWoYJQ&oe=69EB8677"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_3o1bWIz7gQ7kNvwFgCje9&_nc_oc=AdrnMhRn9P9YqN02LfOJZ04ifg1UMgfugy8jDTTZGG9ohVwKWFcVo05sYmRzXItFIM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hLrcNCo_zIDMXBMG4qJrbigVf-9FDzVpgTWzJnyk2nA&oe=69EB7825"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M03Z80dDuBwQ7kNvwF5hqBg&_nc_oc=AdpsbQ3AoaR3LBuXGIGVYXAZIz64gl94r4sr3cQnPowAv19tRxFVRovmuf7Q_YFAeio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m4JbyioH4dbKBM1nfyQ5VIuhBOvQDOUFWazHGmLpn3Q&oe=69EB6A04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCIOd2NFBtwQ7kNvwFu8TD9&_nc_oc=AdqwfSYji9G-XHdcSLNP-N4OqC3gcMJfElHaJQBhCONcsx-aQNRpZg9qpbVttilotyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o4usgvu3YKgQRQDqWOBWf2KBiE-LXcSb9U4cvp9vDPQ&oe=69EB7591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-58nKg1B0UQ7kNvwH37wfj&_nc_oc=Adr-x9_PQHl7IdbhOGkW0mx2rJpeHETYZU8Oup-8V5wXt7daxKGCQgPfKL0cRGgqnh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24fpTJBGsK7E00mbWNbaed0O8KYCsz3kfR1vnyyJgMVA&oe=69EB6B4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
.oculuscdn.com/v/t64.5771-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afaW6EObOUYQ7kNvwG4uu0k&_nc_oc=Ado6XLUI6Mh0GPLHl6nccQqiyOOfY5qCAvHmPfUFzWcDkfO7ifnJmldA-p4QpKsRTFU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TLpNXK_vKdhOYHbYQhTsBnd0Eq2BxHK19CIjWWdsdew&oe=6A36ABF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoH2qSB_DUoQ7kNvwFlnBaU&_nc_oc=AdrlCh5mxLFxZiF5lMBsE_XriX-GTHVBMI2Lxc2uEIQJ0mmF75ZFZaAmZZI4jysB2zQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XnBxoh4p3-cqEGcyzrHgaNVS4p5QYZdGPAfGl-3g4vQ&oe=6A369DA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ-1Zk3UTsoQ7kNvwEpa8dH&_nc_oc=Adr3iTurvM7hkFKUc30cOt_4jNQLB22WxcNOE2yj9QdGJ-x2JA98W0pkshniNn-mWNw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jHbd-0KBj31Ndt5jmCTInz4WuwGeciyXhTPebrCvgmw&oe=6A368F84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oORrXpzD9hUQ7kNvwGvvy_R&_nc_oc=AdrU3J1tfMn_R_9H8YTCVXZk3x0JU4EG0K8zet0vKn0cGFgaITa0nLNv8NJUIuYZt48&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_8hymp0zRKNHl7gwZsMh_p-BkkcqhBQTqVamzu2WEeg&oe=6A369B11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVOP-T4uOcsQ7kNvwG8BLDo&_nc_oc=AdpC7wR9GyfDKHy4coJwxyq-zpUVgmdCL5j2FkHCp41y37G3B1UWFnUQcXYX3-BF0jY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Cio_IHZAcXayQhyvWYMbG5lDBj6wS8SBrqet6M4iyiA&oe=6A3690CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269189016446
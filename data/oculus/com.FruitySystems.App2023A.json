0f&oh=00_AQTa51Vv_NMb9OLrOwrMFd5OfDZD_oKQjvImBSlC9lrQbg&oe=6B086644"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oKoT0ZxCwQQ7kNvwF1zjqS&_nc_oc=AdrR6DRuT9mEtSQVbuF6pBaLnXmImI0OKMIzH0kN2OoasCwiwjBdnZb_OM81F2mAv2Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgUqfgcKxX4lSeKn0MxNbRtmj_IwCpM5IpgVQZJsGlRQ&oe=6B0871D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBiNG3L653gQ7kNvwHAchPx&_nc_oc=AdorR9QiKj-xPrLuZDW2Y11nZD8Ge7mLBHjd47pffj14TdZl6WzAB90DMyl4mj8guB8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI5_TY-Ev1eGUKa6o0UURinlXX6Bh8XCw1iYfO27f5QQ&oe=6B08678B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat 
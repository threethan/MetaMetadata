-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCxfToiTsyoQ7kNvwHxuBur&_nc_oc=AdqQnl-kCeGO9rraPrZ7PFhqWopqHVEeVKt3cdeaC6d8aUCtEbW3RGLm5unyedR6P_w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN637npv8YQ6ea2Lz0-Sw5AzVDCBnc_rce8qnN_fHiVqQ&oe=6AD38E77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkaIEPzL0agQ7kNvwESEaaT&_nc_oc=AdqbBPs5QGBNPDPAlVHbOUOMf0-HgV1G7eGyoA5KA8PqlNLfWVC1cA4s2fWEzxfXsQM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo6matoiJaEkYGgKDnZJyR3DI5reoswWtnZd_Rr6dUcw&oe=6AD3B865"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrRga0l5_hIQ7kNvwHQq-5E&_nc_oc=AdqzJ9HrbaqYW8RbU6-DzXskWdVa9o-Q6Vpt1icB5pdFXU41GMJwGo0SdtgV1pX53CA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6Nzmo3Fb-gD6tbGGNivBZjgDnv5EWNgALVIj0jiBT0w&oe=6AD3AA44"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAjAXltOc6kQ7kNvwF6VusK&_nc_oc=Adrb8--2bS0kDhUnOl7S5bhQGx_YwqR-mF653IJvVhkfC8hHwJPvPk-lRIWYgclexzQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn1g4hFr51btLzXcnrZm-T78naO16qcDNVZ21j4tAykQ&oe=6AD3B5D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa2h3kjSeFYQ7kNvwFlHmf4&_nc_oc=Adphc0565NS9SFXzmU7Y-FLiv1XTtiyDLzKUQLF5VKVroqxZbdg0tdKSSuu7yKRvuOc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRnZ75sELqDXCGR9KcywFG9B0fezbIE415UF5BfxwLbQ&oe=6AD3AB8B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
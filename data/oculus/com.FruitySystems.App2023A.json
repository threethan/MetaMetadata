-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzBapaUJH-wQ7kNvwH-mXQr&_nc_oc=AdoiDkWAZImcX7Akdfj0MeHmn9LDa7QSoU9pP-pAJNXgxSNLz_vXkaqAxi1kQGzf-HQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vlCWLQbPsGbglj8G7cLWxlTikpvAUSkxwAghDfUYOXQ&oe=69DE5777"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P3L_kVWG0sQ7kNvwEE1Uw0&_nc_oc=AdpB6TVqcDci2sr43h93TqivkT6J9s5B3CFvFQ809p2ebjRm4t-MEgg-cjjZGopriDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ESfEVNT3s5JjmtznSwIt0co6L3tQ_63oT5AUIFh-7oQ&oe=69DE4925"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsIKbqY8jrkQ7kNvwHb3eHy&_nc_oc=AdoisJ-KD7rYEGYMx3qHuWF6qI7PR-QxSvljcc5rKlRCzUeEPoEGLaeBZuWWbsgcgfE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lXt9maBaHr0magydwUeMY-AS1u_FKdPnzXX3ecjXTYg&oe=69DE3B04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WCmhwaz12MQ7kNvwG6R-g7&_nc_oc=Adr7wBQZa-oD1d5R8v_ZwQi7OxLvbwNMhfQmdYk6UIB0W1A6ENQlAPaDaoIkVtZ60oY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tcc_4GK5akOdTkspprfRkYE-n2Or0KezSnC2GzpyTjQ&oe=69DE4691"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNfoRAxUhd0Q7kNvwGtMmrG&_nc_oc=Adq4t0GS0Nz9EoNr5MyCmog29K2XOUXYJcaOSoGPjZ2O-DS-2Q1J7kILqrBXj-IvEyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LkB128H0oNnAdb8ncJ8A3BkgDhThJwhQA-ar7rIX6Uw&oe=69DE3C4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
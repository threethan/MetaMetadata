-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B68f8Bj3D0Q7kNvwH1efLl&_nc_oc=AdrLYosAwyVH_wcaPlEwTFn7LnrQOjucKp_iQhTRbZtPbQPAYT7YEHa-5cTxn7Mdsq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXpq1hczyDlRE-IxvCkiwoTyeQMU9D68Xt1FbIj59ulQ&oe=69CCFBB7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_lH0txhXLgQ7kNvwEpCjpo&_nc_oc=AdrCCt-O-uh1WhQcme9YnW2oi5QkSEDKPt472JDGDa18ICQBrlhIFHXIF9Ad8Rvtmvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkAwahIuOZeDyFbIYK5_om4HH90U0znR4pHx5_2jgiUQ&oe=69CD25A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkNGx-x4_l0Q7kNvwEwyX9b&_nc_oc=Adp-2qgELPV2oS3SDaIbTDCBRxbkrTwuMBR-U9WEZITCwsl7Q_xjpmK4BPkp_IW7hzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykYcc_KcI2Yl6VG2m10cwdUm_Sx-8-LFo-q5nRfNHFLg&oe=69CD1784"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rApRCdPERAgQ7kNvwG-ZEvl&_nc_oc=AdqUJsqn396HyXLU6EwSf7XHOdfQNk0ZD6HfK6INitQf_1m2TK4A2wStqso8t0JvXE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjokBVi6ggnef8pE68rCe_xKN0sJ-4v68uPJG38o6RPw&oe=69CD2311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w_zhgpsdgkQ7kNvwE7Hfdp&_nc_oc=AdpllR4Kgig5n3QL4GidrmEB3uOf4gtcwUeP_sSY118RCBfQHYSgSwNoI9-RxnsY5L8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypBhbT8umLDUHoHzTMTgXIWsCMt12kmR0I9-vENnuSYQ&oe=69CD18CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
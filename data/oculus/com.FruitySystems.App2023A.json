0f&oh=00_AQRU5Z3DKDduZj4HPWX1pcsBRwos-ykMXRhXKh9edADTkA&oe=6AFDDA44"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOSPh_mRkloQ7kNvwFmm9uq&_nc_oc=AdpGciAUpTQz5loAOMQyWzkQzX76rzFCkR9ac6ezq2alwW_jWIBG8tO87ceJUoA0veA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCbFA5Kl9E-vzYpsseaqmGOZZZD-mOP0EGPS04vywdQw&oe=6AFDAD91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PI9fOaa1wWQQ7kNvwEGqYJH&_nc_oc=AdpeNw8FrMcra5Lf0c7VFCwAKwGL8_fbcWzv_gVt0cBfF6WQCLfqiHiSQk_ZWZbwgGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7AQBwIhw8kypD0bHgAdKR0VmDbJYkAlyRTmNzYMc9lA&oe=6AFDDB8B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat 
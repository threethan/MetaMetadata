-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk5UtKILSrEQ7kNvwFZaRPw&_nc_oc=AdpaZicz1guwQcHY0SbZQCBJs4ttjkGBFIoJnCnm-3R78QeHlO1NJhYNFfIs4O3bwUs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WDQtg4Kysnk4MQE7PHpTkeYNs8YRIcthmRI9zNqObZQ&oe=69FDFB77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMHM_Zw5lvgQ7kNvwEYjkdS&_nc_oc=AdoeBGLXLMVp5T_ijlKKkDR43qQquuyfzGTuNXjbKX82XKrteivV6tdcTGccXfnjXUg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P7Y0IIdcRbXCdqrdg0uMyY40ynBo9QKxmP_NtpOkWoQ&oe=69FDED25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejri2E3XQY8Q7kNvwFUYumo&_nc_oc=AdreJocJHYMfIprVeZwHWXDocigW64T4sOGIopQtHhcqhF_P8uqQFXcJX1gExpDGAXE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wol8IdV37Lfid7oLHAL_svnp3VPN0r0kdsL20gYKvkQ&oe=69FDDF04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJRSo9izf5cQ7kNvwHOROG8&_nc_oc=AdodshfY1bMA1cSkTF5x-d7TF9a_-juHAYU74aMfIT1ZI6bnSJu6au4_Pg8Xc-VBDPY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zp68JLX-aDQVOgGgTnPNXz1-LdKMxwTOW9LlqWNIusw&oe=69FDEA91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXWwNvkNvn4Q7kNvwHC7NYE&_nc_oc=AdqHtltCBUmkvQXxPwLdcwgisp8UPMJ-xYtmc4Ye_AUC-PHK4hTwdl9nquQHitn-RpI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af427Pb1N_Qeyl8XtfrTXhr-YDNfJFaiNc3gW3ArzmZDtg&oe=69FDE04B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
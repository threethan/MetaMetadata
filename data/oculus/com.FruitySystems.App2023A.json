-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xea3Gjzwum4Q7kNvwF7YUe_&_nc_oc=Adq8muoLYua7NgMWCzTv3I9m8Nq64yTkFtCQkZjMCMlkSWaWGNHBrr_a7zHFqeqjiv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1lbNPAO6fhXmJ_NhugIhU7wEY1euPwMLKdRVw-CwENw&oe=6AB53BF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy-Zur5arzUQ7kNvwH0W381&_nc_oc=Adr_M-ByEttLcdpd8GNapKvfg4V10e4yJcqlS5N_o0t2cSN2IISYP_FXMZeaR-Pd1Lg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ9LXxb2Pzmq2tpyTMzX4hPk1hdUmsdOlhAu9Z7OLwEQ&oe=6AB52DA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApP1FcxNIAIQ7kNvwGQ8eYf&_nc_oc=AdqypiuDp6giNMg4KbnSMTzUf94CnKIA69muv8O-dnagvHTiFiV_Yre8Hmb32Y1P2n4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK33-loI7sXpKl6WUzKKtx-XOFgcpl3SkhJYirEcb1pIA&oe=6AB51F84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4ZG-HUyM_QQ7kNvwFGBck6&_nc_oc=Adp9R2CcmH0NdoeBLeuAgMHLL_JZ45Rawc_n9RpkGGJaUeqt3eTxUJWWUmNZPvBKZEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5pn4YeTwPdkseZRDzo-1VFp-MW7BBYTvUL5E6GbyJqw&oe=6AB52B11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0pbuwI_3XEQ7kNvwH5hfOq&_nc_oc=AdoR0S34aNbny63Btd5QrzRFU63NFeJiJjx-ji8WSJMv2nTqzzx7p2oohsQWSV20e_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ6ZEo2rS0PYgMNMHSL5vZ1iXtkrKPxgjzWg30fKmkUw&oe=6AB520CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
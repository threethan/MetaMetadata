-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzctPC5TmxcQ7kNvwFOHHKV&_nc_oc=AdqrgP5B1UEh_52i5UCAAxiMojAvbne52jqkhRWQaA7YV0G5cC8ZpnV4IHv_zDQegWQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSGREXHHZ5g6pt5uu8g2YXRwMxheQB_IrENcnWw2UdSg&oe=6A92BCB7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=678H7mjPzjMQ7kNvwGOcEMH&_nc_oc=AdqnRlqFOGcrY_8yV4qIetPecBBJrrMPPSnBV1iuas1XQvYydqoCEjpVcWQXVtbIqog&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFga7oUaPsmkPlXMjJigB6WwgdMpUlshnajxJX6cqAHhw&oe=6A92E6A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEHOyXZ0grYQ7kNvwENlnNV&_nc_oc=AdoO7cHl34zyw7UYBMuyOD-y-MXqMvTUQCxuDJEL7UsOQJRxkInJJLG3tP7Wz9Z3N4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1PvX0ynsD4rHcNaM3MszqqETngGZD8q_-0dri0EgNmQ&oe=6A92D884"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRx1TjTrJ9AQ7kNvwEKSngp&_nc_oc=Adrj71umFCXq-RkliHQWjrKATE9bwIIbF7BUdPM_VMaxUtL-Sul-rPmO49RfMw0HA9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiodjSXKoQfDgR6N3G3xr8F72k_xITXAuEJLHL3dJ0mw&oe=6A92E411"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJaJV2jZqOAQ7kNvwG-hzLa&_nc_oc=AdpZeVv5w87aTMrojEADUHY8pdRBraYdaoYc57JbPYmH5Eh6WsYzfZG18phMpf_mQZs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4ASyOfQuo6TXqZbbUSb-pV1UFMjisBBRoCi7v7cAxaw&oe=6A92D9CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cN3w345gO0Q7kNvwGHEAnK&_nc_oc=AdrfS2kMN7y49GKx94KfPNuepyZw6ll5IgtNODrR57oOkbUZnGWZ00FkODeEKb22igE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DFCgE4MLsh9safsglWvsdnmbdDjbVhDJ2vbJMmVzjeg&oe=6A43DAF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vB3fIkj2K8cQ7kNvwFZ2ZhW&_nc_oc=AdqoQZgsiMAUJdUXi_iXAi0MkAAHzNHUGaa-Q62xVzvekFMfRfqw-2L9q7oqRpBS3GE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vTkygAT_wOPKZVOvmHRkXZk3SOwXK_qBKUeoHzHAC2g&oe=6A43CCA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5RVYQfQbnYQ7kNvwF2QtEy&_nc_oc=Adqxk0zj_f8TA6N4joiBnOPPqvfQE4HKBLQXpoyUhkpcXyqNv_HMC4cieTIEoFcHRzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6vhYZGPqk5X8WNHPQvlgdbp_ctpla1uNO0NxQ30FUjQ&oe=6A43BE84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt6_iTR2fdoQ7kNvwEJy1fN&_nc_oc=Adq407ngH7MLAY2UnrmiuXD5awdwY27zrd6bcgN-7tVupmd5uutIl_XeDtHgbzhsfMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EoLpqNuBjtyMNA9PWAq848JPkXDOW88pxGYaqBmF0Fg&oe=6A43CA11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPDSeNleAtkQ7kNvwFCNYx-&_nc_oc=Adr0rbH7tpGRAW5sZpNVv8R7rs_RMI2-GQnphvzRqumy0P-QsT8P8g5qi2v1fjkGoBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PRzShzNZZx2SyPMd_Wo25qv8_R1hG7Ud6wz0sfSeqzw&oe=6A43BFCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6JH_YqniZsQ7kNvwHlGagH&_nc_oc=AdoBcsvK9bhJiXynyqcAbXP5n-WcV5ludVg41bTrK6tfew7m-JVGUfuKKSjrklZ4dK8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4A6-KDIRhgkOQ5iSm_gq7nsLFIyAvzo0uZYV3LCPR2A&oe=6AC7B0F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea-klmZ2Aa0Q7kNvwEkoqiK&_nc_oc=AdoXU2msPfTTtLPfKNR9WiF-ZrHpzMMG_20hxWwgLlRTQk1V0evv6iLppfph8hKVHTw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgbzhFXUzUKsqrOarQo8yhlde7D806Gh3LwkJuvtUWjA&oe=6AC7A2A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez_MoxnwtAIQ7kNvwE9kbFo&_nc_oc=AdpEA5qQbNl8mGiAKmcmHtkc5-G2DqBXUmqe4F88HCxrJr-jwZ3EdtGz5-pP70o1pOI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7U29i5FBhpYlLskB6qARmOkzQtEYH19HgNDr-BZLjlA&oe=6AC7CCC4"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ohOeC08faMQ7kNvwFJt7Bi&_nc_oc=Adp3hBR9nAVXfTAgyhEdVfYn5_EXqC-Soew1-1Vz7Tj-2hXps_mafq2WHWIeYpz0KP8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFIbTSb6y1MPcAKvvNawAvqNr0qUe8-BCj-7hktpDOIg&oe=6AC7A011"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OydgHX4VK4kQ7kNvwFKo8Mt&_nc_oc=Adp1egOU2n9jsPf-j0nloFaBsWKGJEU-bURGXsJUxhgK1_zjOvJILvzxtQGZAEINY5s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPm_c4JQpImf8krIZvF432C_SVKkATdtqJSChvEsVa8w&oe=6AC7CE0B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
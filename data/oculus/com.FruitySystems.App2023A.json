-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEx87ekXgZMQ7kNvwE7oNGz&_nc_oc=AdoAazOSSYRA7_Lj2sUDoKdeZhyeaJnlmst7UrqpkSNHmjoPz0Azr7b1bEOeOz56P0Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrDIpzYDqelfeFNfATzZbYoe7gGAdrcKL0psix0Pu1UA&oe=6AEC9AF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztLsWWm-G9EQ7kNvwEshcoh&_nc_oc=AdoavEqCJxnsI-XLobatcSXlt8JlzsvVRZBR1oB1dSAj6pusd8aH0_RHSQhPHTRhFWs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRThaRlDg8sA7ssgtAHqKmZy4ycMeKUBrebLvnGO54jew&oe=6AEC8CA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz6W3FfnIYUQ7kNvwHDxMTy&_nc_oc=AdpyVaFpUQjw9PE2KALvC-kMzw9rg_JCc38hEjJTdqESDKkUqx3NsMeAoUIFAXSTWHM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7fQXd05E9MMoDXmf39wsz8kfOyB_E5KoVN1NbnHJSHQ&oe=6AECB6C4"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkywNWvEGT8Q7kNvwH_pQ50&_nc_oc=Ado0z8UJ_oMplsmWVwL0dSr4dq79suclLwVwZ6cSmqjnSS7A2cXs41nfkHRsyVwtHp4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQL8gAM06Xx_jPIDoq-IuYiAjw-Mq0JyTr2XB0wkoOtg&oe=6AEC8A11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4SRGUwDEXIQ7kNvwFc3hC6&_nc_oc=AdoU2HLcUPgRzEH5bVzBMySAbjcIVpaX0BAc_zPjPD9If35DirAyCSmBTISHDv2oYAw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtWYkUhhhZ08ZeGnNk_JgxY8y_q46H4KMDAE1o0vjtpA&oe=6AECB80B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
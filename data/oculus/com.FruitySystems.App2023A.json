-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk5UtKILSrEQ7kNvwHSvfNY&_nc_oc=AdrdqY2Gh-fGww_WDmkRTi0SCFGu_nfrbkKzx_UYl1tGW510GRN1bykzsBT5i3H-QgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4crGhatsCK0dn1EAkaDLegk8xlAHA_XY_k-F85bVpieA&oe=69FB5877"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BORLa1IqlV8Q7kNvwHqx4mx&_nc_oc=Adq2YnVm7rJtoaBd809k3ydn5IgiaMpXk8FcnuaYBdiVXgnRHbck1xrzcYcC-Fhu5Zw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7II6JNzjsbDpgD7zhgyELK6u0Jhzz7n9ulzklgJS-PXQ&oe=69FB4A25"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcHxgH8CYJEQ7kNvwEog9m_&_nc_oc=AdrylJFpOSP_AHk4hYPBA2KbCcnSoq1qrxxt1JfxSOWNkUZFvis47wd7C6lxOxI5QAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66uzD29ibPYDe7AWiOuTk7alSBsSK4L8vrbme3TNKLmA&oe=69FB3C04"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJRSo9izf5cQ7kNvwFCZEQX&_nc_oc=Adqaq6qN1-2MxxeeNZ9CkA-pOB7o8oh-avPaCa9G0s-EqKwDzyvxYubUk-lDeeU86rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CfMswr06LP831eQKWs660gkO8r9Rcxnvrfi9wkZuGvw&oe=69FB4791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZGV1BZm9ZgQ7kNvwGinRRp&_nc_oc=AdrbiUCS89ADq-4wvMH4Of1fBQAjJIPhy3tn8wXrXxx5C-4ADd9HSWIIaRL5su4n4sk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iZTMVXhtlWPHKLJboT1xl20M_NqNhgx5oHcCGrJb-tg&oe=69FB3D4B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
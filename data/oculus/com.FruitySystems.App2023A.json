-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y3gmuNpWxYQ7kNvwFzwYxU&_nc_oc=Adpa05wL9TRLXHWC6ONA6EVgvPexo25DesAixaF9Pl78a-FYcAGhElbQaidsbLqj6VM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAfgeORs4Pw0sRdRagb-XDwB1o1HJG-jyUyXrNCNxVxg&oe=69C512B7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tw9IOjMpW8Q7kNvwEgXYOE&_nc_oc=AdrYUw46ET7WGTGFsu2YXxiwCE_otb4HIIdgTsROxlcIwv60sgnchCeHsNFh4bTfA5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyx0dygDXyMKW5EDiDJoYPSV21tLCon4bw7hnyH8iwZ1w&oe=69C53CA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCXxw0kLvUYQ7kNvwFpAOrB&_nc_oc=AdrOscQzDoXbQIWlw73C3aij2CHJLsSspvdwG_Offtcbn19uLir1oK__mx2P2aRgYCw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4vR7xcgFysN-Mak63ANYOhXr0AAenUf3z9migOuImdA&oe=69C52E84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJevsQ4dLDcQ7kNvwGCcNbj&_nc_oc=AdoOIrj0R-5aRxXciI4RrAJYKQr0cQy8R5NEWAlfklxh6pQXv2WPSrJ5gPUA8BMbsaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx72EvoM7hx0sk0WLG1BJj5KelUYFO_OtoTwqIdSaxibQ&oe=69C53A11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nnb39AfDi4Q7kNvwGWZetg&_nc_oc=AdpO0do6o_BzhpseIq4hDsQ30nFfdeB0h61U3VgiOo4Fgo3UY20jN203Iw0vw4zTd-0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg392lEDPpwaXqF4I0gxOwLSugXJWahq5HugPA-njNtw&oe=69C52FCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ8pT-PBxpYQ7kNvwEvCY0g&_nc_oc=Adofl01FPIndUNj0rg_H2Mhegnj3xq2je6zk30m63oyPwLm9kxbgITtuF_WUpfs-k00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGjzVDVXQxW0WrpPKAqaM_zn0ipmIM68gyns-lL-57cA&oe=6AF5D577"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djEl3Fi-nEsQ7kNvwGH8Ofc&_nc_oc=AdqpwXLPEVQn7AjKtAKKVpX4atKNActVNhUh2D9kkWvRgJpRNTAfL8jrN29KD1h17yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC0E0ft01ouay0kFlGmVNPK_hCKDEyjXMEhnUHtMKUQw&oe=6AF5C725"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOdt1Ym5zTkQ7kNvwG3kyhM&_nc_oc=Adpt2Cq1weRk7pbQ6Mb16Gz4mhwl431Jnq_u9gYkHmsLSd9VahIr9znYaQtLpughDss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_yAF2rLtkE122ZLwHEXxnmbpVg_N2xG0wTG_-6WwiTg&oe=6AF5F144"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzT-YabiZ0IQ7kNvwFIsc99&_nc_oc=AdrU5FxbQOQb80qavsSdxZLP5g-s6mO--0fN_Yiox9M2woS6v7BK-g8R-6rbhrp_Sxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThrVCaV0EwjtbTlUUEBS3AeIfaeoBkAeC63IqPGRN7tw&oe=6AF5C491"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22A8FOq5uf0Q7kNvwGbhe9P&_nc_oc=AdqOxgk1E5-UyGpK8Hqkn327wu-bEWFwIFzWREkYHvp3PXIRyhRq1slBR6e4tRDmL8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsjivumRa8SPQzXJ6HCQo2h1Nd46FCEhqEk3mVYiBXLw&oe=6AF5F28B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
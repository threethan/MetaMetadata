-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmhSznmHB5gQ7kNvwH4ojf_&_nc_oc=Adrv3Duw9rQ36TkQ_dIwGzW05vGG2cU24ekGJLSWNG8shW0tmz75HnnRQy7GJ6gW8Hg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bOZU9A59HSTEv4X2matREIosT-8CxvC3lu3hgIyrimg&oe=6A107077"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5Wq_G1kFf0Q7kNvwGTZNsU&_nc_oc=AdqU4qzFs-F3C2JdNFKuQxJq_-_1zxzJLBfbAIDo4U3JZKNFoWX9glYB0YsxibhPVeM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WfrmY1tf9HbAZzZU7A_wjoLywhJz2Pb17JjrLZLLMeQ&oe=6A106225"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YVKcvvHN4gQ7kNvwGRj9R7&_nc_oc=AdovTvr96SpCg52QMs68ARnhUiAz1nlbqZHTlmo9URvQN2ZSBOCqWgNFY0DxQ3kuI8Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54gfDDVf9xcoj8YzHoaZvYgdmwigFxVtSIUutV65pvhw&oe=6A105404"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPygCsZhyzsQ7kNvwEHCAhF&_nc_oc=AdqIs2XUXcT5ZB55ClopsB_YMwNt__lDxiSOSh9thbcgYAdbowBLt0Sb4dyqYL5MJc0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j8Z5FENu52bQOVwLpFzQqAYxg3P27MnxlPJcEcafp2w&oe=6A105F91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm1Ko9Q1Xq0Q7kNvwFStC2i&_nc_oc=Ado4O1noBOBDlFmAJPuLJS916fe8FbcdKmUVizcCBv6QmkvtJnRohYTnw3XPimhXGFw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RI0BD_1Odrger7724r4oeYbR9B6cfLcMuzdqmgnGSrw&oe=6A10554B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
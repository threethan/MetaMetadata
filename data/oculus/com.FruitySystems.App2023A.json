-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEhOI2nez78Q7kNvwEaw1XW&_nc_oc=AdrIbel8xGg3C2Wt3-SCkjPswk1CbTBYeKmm89GH4d0b6S8QIA23xgjvy3XsJcYyRYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HVZvH7pby8WLNk-QjK4cZvqINHw6GgE2Oy-p3zoLcPg&oe=6A47CF77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll2njxN-CXwQ7kNvwEA4dzb&_nc_oc=Adq-w7xym0p_gLngNCntGK_SeNehv-8gupmIR66XJwKMZEfwkksXGD1ev_aVKrgA6do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OsNuVkAIVsv8CpygKybfc0Z2cpC8IyLC4idObpzORmg&oe=6A47C125"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d6vpSlAqnAQ7kNvwFpbcBs&_nc_oc=AdrwlOGz5PvTEOxnH1mB3wAJuQOX2AdoNN3ff59gAsduv62WNfEa3S86rqLIP9eZkyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J_XYJ1Pn0SZSjvuMYMEGOE0s6VHEzH1zygJqUAvvJaw&oe=6A47B304"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdfvQ0h091sQ7kNvwHv5Dzr&_nc_oc=Adpv16teiX9h_0x5wJNaQ-bIzMAP17j2VvftSC7X1SGhwr7s_8YR-d03RO8ijbe38p0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DAOiN0_g8JFZZuK-PvTlPoyYQYsGY8yAU3a8eAgLhpA&oe=6A47BE91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKi0He_IWPIQ7kNvwH8TSLr&_nc_oc=AdpjtMUjCNrvOrNcq7BAqpkDPSfRz_6FS-sg9M8GPkisDbbXAyxDzyceoWimZpl85wI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8YV_OBzmDdpGtKQ8oHVLJ4u77oZMjcnuOdmvlnt-rEQ&oe=6A47B44B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
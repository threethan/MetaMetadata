-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8SycA_GBhYQ7kNvwE8mbQd&_nc_oc=AdouQ2BKjvqPz0WU7Gv8b-nvh-bQ2Wua79F59gJZIGJ7jJoE_X5gCPmB6-XAWBKq9J0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FjpowcHgi3F-aygujudurY657SanQCHc5KejzBgevYw&oe=69F4C0F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysiLzDq4uU8Q7kNvwGE0y4V&_nc_oc=Adq7oszqKiCYVnoZjwtJzbjvLCKOBEoeUDnuud9QD6ZPWMLZeTMW40t_lkDqXchwmUY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05kNKgfL6PgRB76iahJ_w-JiJy0ieNlwZtDmet2wshig&oe=69F4B2A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovrG-fgZDHYQ7kNvwEOkrYC&_nc_oc=Adpsdyx-DtsOWc19vYwvdfUeF0qVIfQl4yv3Dkfw78TSDdx_EzRR4Kdh_RcxcVi3_JQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bqvPGgUyuwTS1Q5AkW51jAGxuDABdefMM7Natx_gRmw&oe=69F4A484"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If9wVaZA5doQ7kNvwHkDShp&_nc_oc=AdrO0MzSvDmHdD8k6eKGXk-YZa3p0-gEyEzQg_BrhBx6ANtGkn3IQsa9NL3TrlXtwIU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38JMfrN0LtQ3aSp7Kw3UG8kfkTH3pyLk65L-ZR2ZMwGg&oe=69F4B011"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RZO8Ey8_qkQ7kNvwEpMtyd&_nc_oc=AdocNHATlDDNxpSkR1FHhJlfC27ZGUATv7HPRv17YGXqUxFAHDBNiScaP4zIu12Rdsg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eb7S1Fkti9TO7ODKLEmdiq1Kn_o1txg7HDyIhnUBQOA&oe=69F4A5CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
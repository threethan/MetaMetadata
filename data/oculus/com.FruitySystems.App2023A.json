-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alegoqKR-S8Q7kNvwGCxKtr&_nc_oc=Adrz516nNbcBRnMiP7gL4_owiukiSfXeQuOs3EBF_crHylfWmaCgeVCTs8ehI8JFWO8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAZfXVGO2NNbhnBv0A7VN0r8WBUi6wI4193-76-tT3Lg&oe=6A564FF7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDRL-FjUDH0Q7kNvwEkEnkC&_nc_oc=Adr8I9FuY9y4z61JZ6SrHnMi4g1bcnEegjRJDWqlMa4aDF2ab8f2hDXYwaSF8z649cM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGFmtUmAXdFD8oXz4rCaQL4WNYMazLxXTsqq1X6KKoLw&oe=6A5641A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCwLnmv0IAEQ7kNvwFEmlJ4&_nc_oc=AdpSg2-B1NFDCRZNF4yH37RdQKwA1JG42hOgKglVvRq3owQiZEjA-D2YkfwTTdBlfdM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHngB255mAdlu67Dxl36g1i6wsBFU7XMxBwNTEMcwCJg&oe=6A563384"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2NJh7aPBQEQ7kNvwHkLw9f&_nc_oc=AdqcB9AU43hYmsN24jzeOUuOy8eIJVbuRKbHpN0gdLZgWTGQn6ORGitmZlDvTLFA07c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLO7FluzAUZEHHj6K5stDaY4_FJVzz_k1l0naXJ2mAuA&oe=6A563F11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGfY1BwEw0YQ7kNvwFD6-G9&_nc_oc=AdoxK-lPh2Z_ososgJlSCyOzwUMd51S_KyAtQh_FDzYr2OVm8pGMu4sYIN7yLujOoUQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXnUshN9NwRlsd5kVdVXKdmXJmdS7AaxhKUNgsvEnmYg&oe=6A5634CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
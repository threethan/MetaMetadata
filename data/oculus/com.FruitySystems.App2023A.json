-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycZuyZptn_sQ7kNvwGeJOJ1&_nc_oc=AdohJXRpoXHV97X_hXhk-WSWdI07_LOFkaV74U84rKhNe7a5mI0e81oDRIhKyAQEqK4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcTal2Jdlb0uSIJsER-nci5Mw0DvDxdJ0G9rfe8v7hSg&oe=6A65E9B7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmIBoYRAuFcQ7kNvwGrmbiy&_nc_oc=AdqIgIUXzUMHIZg60MM7g8QCcH0zwaG6BgI9oa_Y2peW9S8XaWDuOsPvG76PqHQAzoQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA7T6T18XBI-lqELc0VQe1MqLXyk6fkHtKjp1qFYuqVQ&oe=6A6613A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StVuwbVLvrYQ7kNvwEvuDgz&_nc_oc=Ado2nWFWqnMpHEv5FkJFrRWZOWVQq6dCGYiXx-xeUJG9EXclTrEJ0cSaY_cYnKFe5dQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD91GzHa0WBMyglN_XT5tG_hH2ryxc869aG_s6Kt6Lmmw&oe=6A660584"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6a2J8HRK1AQ7kNvwEMtkSx&_nc_oc=AdqbBRM-_xtclq5VkGGpXT3WaGIMj9fJqqRetYMjSJLxKLhhLuoorTRGgRGC02dkuFY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1cNFrw7S5o7cXvBOR3dSoJ-1MPvv2ehK6HOJrPc_jYA&oe=6A661111"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgEKtttLGKsQ7kNvwF7rLZK&_nc_oc=Adqr0Rhgczop_Y2NGi0xOiDFx6Y3XzzvSJK2-TBSAfQfqPhH4EvMD5Q2Gx7TEGm1F8o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMt5neynp3uxadCioZQ2COfiBpCpOZ3FgD8y9_wAWZTg&oe=6A6606CB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
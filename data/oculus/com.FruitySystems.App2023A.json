-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6JH_YqniZsQ7kNvwH1sBsL&_nc_oc=AdpPqQ_NoG78KhPn4M3ZT_-hEnN4mmQi-ews4dFQK7tIikQdyfx7gOIH_nbPTjHhFVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH21PVVE7R2sfMrXMUJbrwSqTLdg7Yo769Nt0kp-6VRw&oe=6AC65F77"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea-klmZ2Aa0Q7kNvwFV6EsU&_nc_oc=Adr5AZ6X7Uyrm9ryA-q-UnoqtSDnl5TXiYcwJ9CJ7qxniawuttadamFmTQdBfoglFU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA19KYRRGU0XMqcXYyg2ylZ8v824ngfcvtv50u2t_UaQ&oe=6AC65125"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBSJOLLL9hUQ7kNvwHwudTu&_nc_oc=Adob7C8cGbaf2OxJSgHZs5PHMTQoF8neQwh3vhYNg1bOBTHb7T_hz5F7EoUzLUbWq-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjyGG8rBK8e6TKEY9tcmtyakFaL-4I1_wqP0GL1LZhcA&oe=6AC64304"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ohOeC08faMQ7kNvwHk0PYg&_nc_oc=AdoOeQgBRnbcAFQDZdwVq17qe3fdYMJs5om_4M08UthUkYL2HJsqkDr9CXwyrJjfO9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSJVfh0pcvAOt3yMsTnyWNlKz70jhGRnBaMW1gHJwkZg&oe=6AC64E91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOmsFzk9W0QQ7kNvwGQDjdn&_nc_oc=AdqeocF9wcFo3_R7Lbp8t6AK-L3gEDmF0Yrgon1SE8AMJjCKrlxg1uSyXov6Gkao8iM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTw8P0DjScMUbtpqaemYDtrYTTEe1g-WOyG7NgUf1kkQ&oe=6AC6444B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
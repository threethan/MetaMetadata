": "1088478336418402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393997_1088478339751735_4623845614524194578_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKrA5VWh-FQQ7kNvwGETLoi&_nc_oc=Adn4S8FaeyO9AKCRvQpdJn2j4zZS6mtD_CUYUO-JeH5skQwxosz_U4SxI7NX6VPt3cA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwfTBMIiGze2nMs1UNgaoZVNWr4A_0lbHRHbxzD2JBNgw&oe=69B41C50"}, {"file_name": "screenshot 2.png", "id": "1884758439002351", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393941_1884758442335684_4962289316967183216_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwrhkuKMN3gQ7kNvwGnj_Od&_nc_oc=Adn9bpI0DXY1swR7vDQkdVuLkoKb6I6LsJbLipEXMNNAuYDcK1mkp0AaxZv5-tx6DOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1Xt02QJY3ZuQtHjxguxAeMAn74jlnCl2uID4o2aRBWg&oe=69B3F591"}, {"file_name": "screenshot 3.png", "id": "976796427907987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393491_976796431241320_3159215373767508535_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkBN-5QpYoAQ7kNvwET5GHe&_nc_oc=Adlpbv07hvKUM4lSK3aJ06QVF32i_oQzIBl1Gs4JxYlv1BbP3i0dtf16MjJL5mY0kNI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFRO3M6zawQwrgHNNmr8hdX8DObN_rSrCE6IQlCfcTmg&oe=69B3F02D"}, {"file_name": "screenshot 4.png", "id": "1503040837690001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393450_1503040841023334_8419651287181731642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWhKpwN0mToQ7kNvwG-FSri&_nc_oc=Adks8pm7gqqhq4qfHXRYNiTGXAf5YO0L86o3IGx97eTQtYpKmiYbvKNBbey6ZpYeTTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9cMA-b1Xb4jDD74OaMwSle6VV0AcFVcNNuyIgbMH7PQ&oe=69B400DA"}, {"file_name": "screenshot 5.png", "id": "2191382094638471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473400793_2191382097971804_2905895693263080603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhCs2tTfC1cQ7kNvwG8YQzt&_nc_oc=Adk_lTZPhBHdnyGHinb_wxNQJGc8Es-7X4Z4wy1cgsgp8bWEWgSRCrm78C_e7b2wFpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxw3Q8Rmi99cWHdWpFHWitA6VWmXJAB551alc1YzJXoMQ&oe=69B3F64E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Interview Master", "keywords": ["interview", "job", "employment", "conversation", "practice"], "long_description": "This project has been co-funded by the European Union as part of the project \"Green ASC VET\", \nProject Erasmus+ No. 2023-1-HR01-KA220-VET-000157245\n\nThe main objective of the project is to promote the inclusive employment of autistic people. This app is meant to be used at the final stages of a training.\n\nThis app provides a realistic simulation of what it is like to be in a job interview context, where you can practice giving answers to common interview questions. With several virtual rooms and possible interviewers, you can build confidence and master your interview skills.\n\nThe app does not teach what are good responses to questions - instead we recommend that you consider this beforehand, together with someone you know and trust, and after this, that you use this app to practice giving your responses in realistic environments. \n", "short_description": "Practice answering common interview questions, build your confidence and master your interview skills in preparation for a real interview."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/196728b1-90cb-499b-877b-a1098fb6cdc4", "developer_terms_of_service_url": null, "publisher_name": "Virsabi", "support_website_url": null, "website_url": "https://metautism.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
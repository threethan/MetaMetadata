": "1088478336418402", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393997_1088478339751735_4623845614524194578_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-Zavml6XXkQ7kNvwEHp5hS&_nc_oc=AdmeKSwADFCuCEFd2fFtyL_389NYsKyvuws1qIXV5P5s5hUu1fb4KMvtYoSsHWYhosM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuxxAoCR4gNAojP80RBf31pj2tArhnURT42_WkG33Vgkg&oe=69A99050"}, {"file_name": "screenshot 2.png", "id": "1884758439002351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393941_1884758442335684_4962289316967183216_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D1qJXw0cu8Q7kNvwEyOMoI&_nc_oc=AdmdnokukiGrhpACBM_jEy1mq6EWeA-3rA_3flqQRcJkfEmDa75D-_bQs1jTAAaeVFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsmwGTskDhQGiJpOWQRWblsn6Ap2bBTRmqaDvzDLAfYgA&oe=69A96991"}, {"file_name": "screenshot 3.png", "id": "976796427907987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393491_976796431241320_3159215373767508535_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT1iiny-C4IQ7kNvwHKan-M&_nc_oc=AdlZwsw_WEKzf086Tb8klPSDyPRHW-A1q53R1NyGqRsTQdQtFdrkOLN1DK04xjnOaDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvwDG00no6JjLNEAcb9-nReFlLwoFhhpDYGYA1rrwgfVA&oe=69A9642D"}, {"file_name": "screenshot 4.png", "id": "1503040837690001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_1503040841023334_8419651287181731642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8HlvtQG5mUQ7kNvwHHtzzl&_nc_oc=Adl0HUp7HJM_oTPrz1GyeRS7gG0qXdfo9V2qgzmU--lnXA67uE8--Hn1vuRK9zDs7ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsqxumNiOL0NKdV_hhqI400xtCQnJ_w3Z5goVMizHjikw&oe=69A974DA"}, {"file_name": "screenshot 5.png", "id": "2191382094638471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400793_2191382097971804_2905895693263080603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7TNxeygCkwQ7kNvwEH1x6x&_nc_oc=AdmuyAtpupyH7l3Vv5AeoVr9ruFq8mQSz_D2ljpcBw5l_G_kE2yk3V-ghTuaSUlk-V0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsSsKn12ykJDI7e4xusCdgdYZxB-iknheyTmHSePpx6qg&oe=69A96A4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Interview Master", "keywords": ["interview", "job", "employment", "conversation", "practice"], "long_description": "This project has been co-funded by the European Union as part of the project \"Green ASC VET\", \nProject Erasmus+ No. 2023-1-HR01-KA220-VET-000157245\n\nThe main objective of the project is to promote the inclusive employment of autistic people. This app is meant to be used at the final stages of a training.\n\nThis app provides a realistic simulation of what it is like to be in a job interview context, where you can practice giving answers to common interview questions. With several virtual rooms and possible interviewers, you can build confidence and master your interview skills.\n\nThe app does not teach what are good responses to questions - instead we recommend that you consider this beforehand, together with someone you know and trust, and after this, that you use this app to practice giving your responses in realistic environments. \n", "short_description": "Practice answering common interview questions, build your confidence and master your interview skills in preparation for a real interview."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/196728b1-90cb-499b-877b-a1098fb6cdc4", "developer_terms_of_service_url": null, "publisher_name": "Virsabi", "support_website_url": null, "website_url": "https://metautism.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
": "1088478336418402", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393997_1088478339751735_4623845614524194578_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUl42vKdhzcQ7kNvwF1eJkr&_nc_oc=Adkh5QlMUMwl2MrDORdbivlPPkL90LVv-0zLqzfRRO8fk9z7dX657Ebhuk948bq9_E4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWTvnRqVOSQMkzqpaI9rdSo42VNqTZ_mwF9v2lsSVnLQ&oe=69BAB3D0"}, {"file_name": "screenshot 2.png", "id": "1884758439002351", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393941_1884758442335684_4962289316967183216_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKbhYkoczMkQ7kNvwHsCSRG&_nc_oc=AdnB9GQQfgp9MIJyGLQ3xitOXhxTNzcI85sVp4Ky7iRfZnW1-udzpdmAfqDxf1bHOqo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiV_wxiqMcZSawcEka9SWSthOWc6nRG21EJcXKD-daLA&oe=69BA8D11"}, {"file_name": "screenshot 3.png", "id": "976796427907987", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393491_976796431241320_3159215373767508535_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFOr09rGzy4Q7kNvwFRa-DU&_nc_oc=AdkQ6IAKIbonipYvz_vHz-KNDI3LxbabAkMMocqPOX3JncP07neez_YFv3mXld1RisM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPpU81AXgnjfqQQDKocSYQknf-4R11X2Bs3-JKN-YBnQ&oe=69BA87AD"}, {"file_name": "screenshot 4.png", "id": "1503040837690001", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393450_1503040841023334_8419651287181731642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uu2Eqh4tXwUQ7kNvwEamvtI&_nc_oc=AdnN0Orc9hGcYOcDc0UnJ209mDyCN1Dour_LVJqfJ-gkSp6IL_wBKhqxT6TeOR6R5R0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbopPlpJpiMpXX3JnOye8w8njqMZkqltMet-gCLe368A&oe=69BA985A"}, {"file_name": "screenshot 5.png", "id": "2191382094638471", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473400793_2191382097971804_2905895693263080603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BfhcVitrmYQ7kNvwETLkac&_nc_oc=AdnNi567I1uiCl2_kk7UhIYUJQ3kCyHxOxEWYtNACbDReXBMHuwDEr-LAI27Vw_p0cw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2g9c9wZpi5pX8kw78U4PZ0JNSK1dXNG5JOaqy8pue7w&oe=69BA8DCE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Interview Master", "keywords": ["interview", "job", "employment", "conversation", "practice"], "long_description": "This project has been co-funded by the European Union as part of the project \"Green ASC VET\", \nProject Erasmus+ No. 2023-1-HR01-KA220-VET-000157245\n\nThe main objective of the project is to promote the inclusive employment of autistic people. This app is meant to be used at the final stages of a training.\n\nThis app provides a realistic simulation of what it is like to be in a job interview context, where you can practice giving answers to common interview questions. With several virtual rooms and possible interviewers, you can build confidence and master your interview skills.\n\nThe app does not teach what are good responses to questions - instead we recommend that you consider this beforehand, together with someone you know and trust, and after this, that you use this app to practice giving your responses in realistic environments. \n", "short_description": "Practice answering common interview questions, build your confidence and master your interview skills in preparation for a real interview."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/196728b1-90cb-499b-877b-a1098fb6cdc4", "developer_terms_of_service_url": null, "publisher_name": "Virsabi", "support_website_url": null, "website_url": "https://metautism.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
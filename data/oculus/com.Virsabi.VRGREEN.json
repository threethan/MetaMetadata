": "1088478336418402", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393997_1088478339751735_4623845614524194578_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AxmxfuaceoQ7kNvwHIOkSj&_nc_oc=AdlFdAgq51L0rBRWyQM5eYdwF4j7zI9Zylie3zJ2t6MoYSmw1khsUSm2Tp_xnHgL8OU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYgOp7ayqjkD4GNv_Vb-BgMkHdA8w4muArZiO2J9OP-g&oe=69BFF9D0"}, {"file_name": "screenshot 2.png", "id": "1884758439002351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393941_1884758442335684_4962289316967183216_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jme-k-Hz73MQ7kNvwFdUDGt&_nc_oc=AdmVbD5N2JoQ5T_ei9rZlZIry5_KGAmMu66MO8fcGjrE9cilN0UV5h2LOHhxdddVMzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwH_BsT4IbsvdHXNs7eyJtODaZpfQsm8wAdFbgiJHn4DA&oe=69BFD311"}, {"file_name": "screenshot 3.png", "id": "976796427907987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393491_976796431241320_3159215373767508535_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCbmqdSimsAQ7kNvwGGKWQr&_nc_oc=AdmnshjOwlxdY5hBbL16fw3_9zoBdkBm9Egu4OqhlUOHnHHvLhkF3_Koza1wMAyeH8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyobPGaTEFikozFIecZpQz7JQw9whcqu9eeuS8vz5I1Cw&oe=69BFCDAD"}, {"file_name": "screenshot 4.png", "id": "1503040837690001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_1503040841023334_8419651287181731642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lK62iP0lazMQ7kNvwEeK2zV&_nc_oc=AdkWgyx-w6Mt5nn4NtfBp_yMR04Uj0hqH6ECzkb6TetOlNyPa5IsLJHtxDy8dyz8bJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfywKjn-1xRFprx0D1CFrNg0X0vcDETnDcOEg83SEikI_A&oe=69BFDE5A"}, {"file_name": "screenshot 5.png", "id": "2191382094638471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400793_2191382097971804_2905895693263080603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJFGQkvyjPgQ7kNvwEKyuZ9&_nc_oc=AdkFC3g-3JpUhwQL1Dgm5X9iF1pO2AZZd8sJhYWpTh9W8YQmmcfjEy3RGOEGPe8--qQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsEd-eKIRnreh9Y6pYAfLjXQTYx-q_0lCB9guUIoPLrw&oe=69BFD3CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Interview Master", "keywords": ["interview", "job", "employment", "conversation", "practice"], "long_description": "This project has been co-funded by the European Union as part of the project \"Green ASC VET\", \nProject Erasmus+ No. 2023-1-HR01-KA220-VET-000157245\n\nThe main objective of the project is to promote the inclusive employment of autistic people. This app is meant to be used at the final stages of a training.\n\nThis app provides a realistic simulation of what it is like to be in a job interview context, where you can practice giving answers to common interview questions. With several virtual rooms and possible interviewers, you can build confidence and master your interview skills.\n\nThe app does not teach what are good responses to questions - instead we recommend that you consider this beforehand, together with someone you know and trust, and after this, that you use this app to practice giving your responses in realistic environments. \n", "short_description": "Practice answering common interview questions, build your confidence and master your interview skills in preparation for a real interview."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/196728b1-90cb-499b-877b-a1098fb6cdc4", "developer_terms_of_service_url": null, "publisher_name": "Virsabi", "support_website_url": null, "website_url": "https://metautism.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
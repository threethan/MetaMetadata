": "1088478336418402", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393997_1088478339751735_4623845614524194578_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKrA5VWh-FQQ7kNvwGFBQLw&_nc_oc=Admg4DVVI2e9BgcdTglI-ZExrM4CHCjkxLNZOOw05PojOyQjEmkxOK_9iaMqdgWuQWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQKyypmvFcADr2Q1jCepK_ziE-Azegbdn-OOhMbN_UfA&oe=69B56DD0"}, {"file_name": "screenshot 2.png", "id": "1884758439002351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393941_1884758442335684_4962289316967183216_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEKAr8QE0mMQ7kNvwFcRpzm&_nc_oc=Adk_wD8ZQgIVxWptMuiVN7vkG1hZuMEQdu90w7uO_GFzhOLlX-XDmibMjQI5qe1cez0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3zaysGhiR_4y7YUnNAFgOKDB_QB9S0QZ7LDc4ymmBcg&oe=69B54711"}, {"file_name": "screenshot 3.png", "id": "976796427907987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393491_976796431241320_3159215373767508535_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkBN-5QpYoAQ7kNvwFWPtzY&_nc_oc=Adkf-Yl5Jk4qSBscmBNEGRhoPIznT6vUk0mprEfZXKhxfYCr77pN5uozpWz9-2L6RLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwA92rMPg5TJEc0UeqccLhhTWDNdEYrKoHXpCtmQlgDLA&oe=69B541AD"}, {"file_name": "screenshot 4.png", "id": "1503040837690001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_1503040841023334_8419651287181731642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWhKpwN0mToQ7kNvwFI7ddO&_nc_oc=AdmHriQ6EiuN4gAxufCsaDsxv7CNT92rIdEn1fMUPorxSqvh2iC9Fudrj3Y9ObuV-9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDHj33z3av3PpvWXQ7bs-RUKdMd1zx7TKEvw8D0MH2Pw&oe=69B5525A"}, {"file_name": "screenshot 5.png", "id": "2191382094638471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400793_2191382097971804_2905895693263080603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EMbRAfEr0UQ7kNvwEH02mX&_nc_oc=Adml6pSncXKxMb37VqAnB1GIrN9ajR1jp6uvZ0irGCbWVTCyIqq71t2FF0wIDfmDIu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwovKzETQJeAdSG5KxxwZoTxYA6n8SO3QLzE0Yj8F7WcA&oe=69B547CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Interview Master", "keywords": ["interview", "job", "employment", "conversation", "practice"], "long_description": "This project has been co-funded by the European Union as part of the project \"Green ASC VET\", \nProject Erasmus+ No. 2023-1-HR01-KA220-VET-000157245\n\nThe main objective of the project is to promote the inclusive employment of autistic people. This app is meant to be used at the final stages of a training.\n\nThis app provides a realistic simulation of what it is like to be in a job interview context, where you can practice giving answers to common interview questions. With several virtual rooms and possible interviewers, you can build confidence and master your interview skills.\n\nThe app does not teach what are good responses to questions - instead we recommend that you consider this beforehand, together with someone you know and trust, and after this, that you use this app to practice giving your responses in realistic environments. \n", "short_description": "Practice answering common interview questions, build your confidence and master your interview skills in preparation for a real interview."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/196728b1-90cb-499b-877b-a1098fb6cdc4", "developer_terms_of_service_url": null, "publisher_name": "Virsabi", "support_website_url": null, "website_url": "https://metautism.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
, "id": "976796427907987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393491_976796431241320_3159215373767508535_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlx13WwnnS0Q7kNvwFcUDFX&_nc_oc=AdoQjTg9Cdmx5lXeIFqVmJeuWVOwMGf3YPV-MOArYs5dId5k4mkSbnkppd5PjRyhby8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1xNaLOkwh-uhklKzXJtyDWBIN22LwzyggTTs1pYWzGg&oe=6A6A176D"}, {"file_name": "screenshot 4.png", "id": "1503040837690001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_1503040841023334_8419651287181731642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmzweGGTkvIQ7kNvwGsswKr&_nc_oc=AdrYpUJJfqHTZ325Tpt96WNbg1PBUOf2OSDhMkvt97nnnCPf_hxMxKtNYwMIuuvchXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX4CGobZ1batrarQZ-xvhYOdmEJGEEVvPCvC_U9TBNPw&oe=6A69EFDA"}, {"file_name": "screenshot 5.png", "id": "2191382094638471", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400793_2191382097971804_2905895693263080603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzQBJ2-v05wQ7kNvwGhBOa5&_nc_oc=AdpyIkSUkGaP9WbbWaMd8xNcM7SZyqxO3EW5he-0dyi6uVDUvlVqcFyhc4HGVbAtjqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYQzSjPYEm2GiJalFlowmUF7qqpt46NAg_zLWJ3b_d1A&oe=6A69E54E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Interview Master", "keywords": ["interview", "job", "employment", "conversation", "practice"], "long_description": "This app provides a realistic simulation of what it is like to be in a job interview context, where you can practice giving answers to common interview questions. With several virtual rooms and possible interviewers, you can build confidence and master your interview skills.\n\nThe app does not teach what are good responses to questions - instead we recommend that you consider this beforehand, together with someone you know and trust, and after this, that you use this app to practice giving your responses in realistic environments. \n\nThis project has been co-funded by the European Union as part of the project \"Green ASC VET\", \nProject Erasmus+ No. 2023-1-HR01-KA220-VET-000157245\n\nThe main objective of the project is to promote the inclusive employment of autistic people. This app is meant to be used at the final stages of a training.", "short_description": "Practice answering common interview questions, and build your confidence and master your interview skills in preparation for a real interview."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/196728b1-90cb-499b-877b-a1098fb6cdc4", "developer_terms_of_service_url": null, "publisher_name": "Virsabi", "support_website_url": null, "website_url": "https://virsabi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hr", "da"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29285569414375144"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "660758936890351"}]}, "baseline_offer": {"id": "660758936890351"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742823180, "status": "PUBLISHED", "id": "660758936890351"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31714985301433531", "version": "1"}, "id": "1675341219998137", "channel_name": "LIVE"}]}, "is_fo
0a&_nc_ohc=csg99-9_6ikQ7kNvwHZHQhN&_nc_oc=AdpurzFp_U4qz-4KedBxEyqJz4ZXKyLkhGXXumqjwbKJRzq0EOYhb9fUxTNiv1VZT6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVG9oXpBSWEqpAWRgHWJ1CFP4Fxz434hGwRIvMdhHS2g&oe=6AE5E702"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGikNvBzIPwQ7kNvwFNKVuY&_nc_oc=Adpo5IXSkLvugBM-Uox2tHmz8prOhvy4RAvjzbs9EnJkz2CtJ92YrcAS3-P7Yl_xTkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaKZPaxPDDM1w-hmSje_ksmJCW0d4PJZ2oo71bXMDm9Q&oe=6AE60347"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RilUI5I4xuIQ7kNvwEd00bX&_nc_oc=AdoZA4K7yt6oT337WS_xVbB34u6YVimks6OUP_WLvIPZnWYXpR2rrg8EzXah5bzYtE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg11W7FU6y6TQSyl9XzW9kX_JXwaDVu2yncE9-lRTgxA&oe=6AE60025"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTZ-MJwmWAwQ7kNvwETiQrb&_nc_oc=Ado0KhO6pXgyrmlm_8pIN1CRy5Dryrev0L-wL997OioNj8QJW7dsHLD8yqJpWvruJNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj-oHU8jOy9ULuK5mUmbLPQJPHOxt5Rebdosi8o2_j6Q&oe=6AE5E095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQfygJmrDeUQ7kNvwHFACuL&_nc_oc=AdrsPWBYyYVSRFRhPG3O5MiGM9XveACgKlvr-MkJRFQRktyBi1VEfJxXxjEjpNKyBtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO97vsSWh30FSD-mxBGRhcKHw6VgsrpU93bm_ozKfPf-w&oe=6AE5E330"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
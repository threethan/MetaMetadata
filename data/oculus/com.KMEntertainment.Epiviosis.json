0a&_nc_ohc=PUjkNqNDw6oQ7kNvwF9O17s&_nc_oc=Adrs9P_6Vov_BFu1sMZC91-AYWKcs3hAwoz__lPTwSRTzkHOv5JsJXQZlzhjlyWB15E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LTYOch8TkMKeHkurQzxuVstGJUYAECGhAzOeA9OV--A&oe=6A43BE82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMtaWmVHOSQQ7kNvwHYZJNK&_nc_oc=AdpxyYq2IhMBoig7FJD95gwb0lfWWjaMbiCnS1MY2VgrCgOUd4UyOVZhkX_fhMqZzME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3JWhRzu6K6Vvpd3tmXbBnoXSxHv9pNEB2WwnKO0kpWQ&oe=6A43DAC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i31x0S88tZgQ7kNvwFn7QlP&_nc_oc=Adp4j9tECJfCjF4RLFfx0ORCykQqxt_4YGMeHQqkX0BLYSY8rjtvaPVxBXr8fq97KPQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jdV4LcDsVP3dQ6hlxPCSQksLs7Iur4t0eiry3stHjWw&oe=6A43D7A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmRmZlO8eAgQ7kNvwEHbveT&_nc_oc=AdpcqrOQmUp-efPXtnxHRneHirIINZ7QW42QVe8tcvmzm9SKbo_3IFXgsiWBSokCArA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oiUJhsFboN227839G9KdxhJai0Oz9_5w3JdlIB0s1kA&oe=6A43B815"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O51mTsJAliYQ7kNvwG9L76Y&_nc_oc=Adq2o-axiTVdo1AIbSRltk7DtnUdUetnLhMOJQFvosKkQ4BN56QUk4B64Dw6PAPfMcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99NVMB4y_3FvgFV8mghhGP0JXxl_FnPgwBMVRMagU2TA&oe=6A43BAB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
e=69F1E587"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSR0Fef6CTAQ7kNvwHLcQD1&_nc_oc=Adob22Zj5-0pYuQ_oHW07oYVu4YSH7VgS2_VqHnHBbZS72C5FBKbPbvLy8fOXd_Dl3o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2p1CeU-10j9KXlrLeDDSw-wTEDuuRmUrn1OJCjTBxBxg&oe=69F21AA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCh95RgPdTYQ7kNvwF0WqLr&_nc_oc=AdqXrskBAHSZ_ZQnQ5Jq2dZKn7k0MFqSaFfajT9rGKM_CLvgui64epS-fOpW644EWLQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cLrSWlidFL3ppnGaBWpk_SLYnhvZZpSt9FdG-aa8Crg&oe=69F1FB15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKcnDpzoMCIQ7kNvwF16qBJ&_nc_oc=AdpkSkeqTE8krjk0CxABRlyOz67dQ9heNek_ZINNTphWssW_dXwhlCOlBUnWVIvleX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fQDgsmSG0TZwJ6mGZ3ppumwySwfMutacEp8p5aSWV8w&oe=69F1FDB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "906799163239334"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "502517577625935"}]}, "baseline_offer": {"id": "502517577625935"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1625701980, "status": "PUBLISHED", "id": "502517577625935"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4135188569879911", "version": "1"}, "id": "298751275280799", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": 
0a&_nc_ohc=RW80kj9V_u8Q7kNvwGyRAMi&_nc_oc=AdrajdhZt0psyvrbj7ihR1Y3XrEktwC-PPNf-SPoa9e_5PKmLrnl9dcxgSmNFztM9pc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK5mEwcAShgoDVANbF9Y86WNcanm6jDd4XYs8TM9B8mA&oe=6ACE6442"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leGkjmwTNdEQ7kNvwEVTR5N&_nc_oc=AdrH4eqrVZCJoY_juNqFXRQGezFf-ZylNl0DPNyQz1KTEg08yGz-EMmHsDZR6V04tSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIc_3LoqzmtR6WFnAyC4GJvBKslN3uXeeoPHtI1jW07g&oe=6ACE4847"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0kcKplO_MMQ7kNvwEUUXdO&_nc_oc=AdpP9VqkI9tM7KXVhM0ndgzIU24Z9JjsUTvCZgvkrYO_A1HXogLDGE-FIb4LWggM_vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMecE3cxXQqfcU4ZYcFWe5bOocgaZC2Dv9sE-qBdt2SbA&oe=6ACE4525"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCxc2pzODTcQ7kNvwFaeUcB&_nc_oc=Adruem-E6usJIV3JwTzWcvKO6AZ3zqUdIwVWNpK9_AsWNCzWqcFiG16Xl3Uf5gTHFwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXdhD7rleUdJ5a6jFfnaqwKmg4YxHHIUVCWOE7bIk9XA&oe=6ACE5DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ytGgYEp-SoQ7kNvwEXdUWf&_nc_oc=Adq40cJgbBqHoRkuCsBh4fQvVrusdFaMTb5yrFTHjtJBmQuQKwcQWASuP9BYApMTKps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkY6z4AI4jl7reczn0tAykNxAcIrbm_CiN-S97YZplfQ&oe=6ACE6070"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=dInUrCQt0zQQ7kNvwF47euH&_nc_oc=AdrGk4T9Qs8tcMDLv3YSjfGM0lxpnZaLtMU2awXq-C3HX9ZooW0VEOlypPfZwedC6rc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxeYevLxILgw0-_S0FBma3Zo124bVbbTfGJ7wZD8B2eg&oe=6A54E202"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vktZ0W1OahwQ7kNvwG-jobw&_nc_oc=AdqbWnlO50utU9SwZjB0Pv9Fx-4M4uTcVFzqQIuxb-rxGAvaCpUWTenLDkISQa9rr7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF1K--dCOaGrmFHWIW2HBFkLG6v2duOsBbUQwo12jVTA&oe=6A54FE47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UH1xG6ZQoMQ7kNvwGuPNYc&_nc_oc=Adpa1lsOO1NgohW4YpC5fsAFu9O13F95sjLmBsaZxkaokkqSv0NG9nOBCKVlKf1mXt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ_ArYvcrHTp5b6eDJ9_LKnXVhqzCWManlukHmu3D29w&oe=6A54FB25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39eSxj-3fBIQ7kNvwHGEhJw&_nc_oc=AdrZKSzJgY8-_7ymhaZhIbbFeu85a5mfif1y2aWOfSBePjpujjZAGftbjEOxydU3T7Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl-SXl2cqzTb8kN3PbMdX-47QhnlytIMEX39fcQp3qdQ&oe=6A54DB95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lAb2BkWX4kQ7kNvwEYzpiw&_nc_oc=AdqstjiKyijqNc9cKxKs62op5oqWqlbq92t7RWgdIevZg9gdTLIV5SmGiWP1hWJkxw4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaep7shleF0W9wmlWojfEQ0sV072JzK9_FmNG5HQjU8g&oe=6A54DE30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
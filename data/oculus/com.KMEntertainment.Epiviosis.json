0a&_nc_ohc=oqMZ3zvURZwQ7kNvwHOpyt9&_nc_oc=AdpIW0-rrzF5oNtx5zVUSyKzpNyDxVnFjUTFGHp8jmsITrgxf2tcTH-trzs3mPQ7hyA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHn4GM3X9A1dVY9xhwKdt_0km9BtDw2PZMvd7bZ8QWWQ&oe=69CE6902"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DETE1mnkwNMQ7kNvwHPl10A&_nc_oc=AdrKXOJ3QjkMDehNllnlc5vFnl-KuDXz_CbcPkrh3oNrCH47ptYexHmk1uE-DENktVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCMI7V11NwxYy4H3_YU8Zqm34JfdcPORCL0-1U1-gJxw&oe=69CE4D07"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od-e_HsiNAoQ7kNvwFzmcn1&_nc_oc=AdpflNViuoMDM_7wpBERqyUm2CgkazU_8GFjO9FynlMdIk5VGo_CcPXZtUhJDcary-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNA6hOMVwAwMVqBI0s9XRitrnBiZa6P5Qi8MCN7Yz_yQ&oe=69CE8225"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7dcSlJ0y7UQ7kNvwGfOiaF&_nc_oc=AdpUTijuZVuiTt9_RyslvNvTZ3BU76ivDr88bKCrQ_8AfvE5NYFY17DstiNbdmZOAps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKL1zri2iatDj4LBLukEhyfMXdKPZqcfCRMhlXhuLstw&oe=69CE6295"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5aFlaKpAjsQ7kNvwGhVRjY&_nc_oc=Ado0mu5-g5iAo94B2zwzcT_eDFZI1sEsxqfzn8y03g1Mk-Tp2-_DawaJS7v6t9yEUMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9aBc2v9bpowKMlJ7_LvVd9KQzPY8VS-l0Lhl8RMyqTQ&oe=69CE6530"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=6vT6-PfaaXIQ7kNvwF7edz2&_nc_oc=Adr2WTA5j1lVQc31fdjHfo-zpPbBtVpRdaQwwSjojuP01jS5L9iraTDv3RL25CZva54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d67IPVSXUeJOaogoxdMLRt1aonlK9OEXcJEkElzo-BA&oe=6A3BD582"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igj4DW7MKR4Q7kNvwGqSNvn&_nc_oc=Adrz7YYDVXXWaZP4xMbttIfusr2OU4Fn4VrcnT6iNqxsB5Sxtnt3XZNTfZIye7fEBDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YpibcvLnr_VkDyRB7nY8zNrym8GJoHRD5gpsFfcaTTA&oe=6A3BF1C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih46AIabNZQQ7kNvwHtKlIK&_nc_oc=AdqRrD7oOdu1ZfkrVkFZLKWrQmJEC4nN5ZpflSO-t31K9i-evsqr45SnViLotwoCP80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af921a2_SCymRE3tKRCBW9t1MasOkLGwfIiobbYGnO8b7Q&oe=6A3BEEA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCGnj0ycsisQ7kNvwGtpDAN&_nc_oc=AdqJGSnXYtXtaaawYje7B7w2YlQg-kXIB9YQ8eppZhzLX6GGMRQu8uVZGVoxEbQYmfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pZAuZAUR-1VZcPNCdk_buIuaXEbI8fxLGnv2HMxootg&oe=6A3BCF15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZtI7PKb9ogQ7kNvwFb6xSq&_nc_oc=AdrJb3z0whYoMi5ATza2CcKd-JfKY4ucP_G1LnnPA8tzACuf1eY3893nmxU5BZe3Nc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DeRSkDiG5whxecM6hqBpLzCj4DF-KMQuM1ewkDhR8wg&oe=6A3BD1B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
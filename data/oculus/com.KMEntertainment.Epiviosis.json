0a&_nc_ohc=q8-0z387hqQQ7kNvwHnhtVv&_nc_oc=Ado8Pb5gjKchGqUKf29IYzQREGXIErKZdi_3gRr0lj6me6M69xIcLihDUlMRBsCwiNU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yRnGsRr0IdmfQc6xATK7kJIVaVvarZBny092YPGwtJA&oe=69E22F82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bhQnm_FkQkQ7kNvwH_kJgj&_nc_oc=AdoBeOTKx6OeEjDqdLmNflF52oy4X63tCYoPtbMtAPyE-idiQmRNtUhPb3D6CtA0Zc8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28YL_TI9XgR_TAAT3TIF-C8VBF8oxZSbcHhcGIM0faRQ&oe=69E24BC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LHaIcg8fBkQ7kNvwFpIjrL&_nc_oc=Adpe0rsO0JJj3jQaoz2PiB8FGrXCN9unAbJjz6lh2Mam2IDpJBtNdBtw9uNPncjEC6Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kCVQEGJd-RfxG9DzXBKRIy65lnwkigksO9z4bpsV0Yw&oe=69E248A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=510M6R0vATMQ7kNvwEatoxa&_nc_oc=Adqrz3DJPWBeO3xhyRk8MILCNSNhZpFKfLzYKoVudARe_QOOC5ojZUG1_Li1fMjeJL0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3axig2wrXOGgIHuVof0BxrSHRx4OCR7VZjKfgGQ32Z8g&oe=69E22915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ertElj9ptxsQ7kNvwHVDylH&_nc_oc=Adr_ep0OUmxaYGvQ7r42YdjS0zcD5Tm60tAcLGSJATyKzVWCbzOUgscaRkYI3ZJonNc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FXUX3LahNJo62m_qDPIaPvgAfRH-iNoNZa4o5B7Jxhw&oe=69E22BB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=txFmgSf1-4cQ7kNvwG_naXv&_nc_oc=AdotpbpEXvoMt6fBNvfdDGtcQiBFJ1wLuHrjjPsHJyCwQmNTcDrXbbyf7UVxej9qfNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6F0A9emizQMvMDZq32eoeKX1uXRK8-QEmmBmYw0-zKw&oe=6A4BA782"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGBgYHwve64Q7kNvwFl-Ms1&_nc_oc=AdpBGgklRYJL927ZHhnZwMNqUm5FHrP-a4W1QXb-HgCx0jcmfsfMfIkzz0xzn7HoEyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW_yVwE1AeZyeandxTosDqpe8iHLpGGRj60JiOGnWPcg&oe=6A4BC3C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSwN-bqn6ZkQ7kNvwFdopxs&_nc_oc=Adpz6V8oL8tHMeQ--iSqBAycIXG7cK6YHN_IOopVz_kErQAtmqQOseG7L11yuvSqoTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_-xmmIqZ9TmZ39BBhPv308_ubCqPdbkCKh10WSYEpNA&oe=6A4BC0A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNkLzokFDwAQ7kNvwEleBbH&_nc_oc=Adpk-0ginEoRM3LZ5FQ_eJVRCbr3_e2u58nGIG7Vt4cZao7nMZg7txS8HY0-JrXc3I4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf2gthO-fHUirdEX59_WmH8DK9EEeDCt6C4BlqhWUKgQ&oe=6A4BA115"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCwMpr2eVEAQ7kNvwG-tcTL&_nc_oc=Adq-oq47YhPWr-MBAbO3hSzd5yVx5n9Zj-k-EM08frvicfngVuCtg82eumtFa4gs29o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKO1X2DmBAEKNON_mJN_fxz8QcQL1CumMnkPfedEi6SQ&oe=6A4BA3B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
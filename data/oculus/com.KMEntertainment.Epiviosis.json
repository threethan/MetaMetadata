0a&_nc_ohc=4yq-btFJ2MkQ7kNvwFJjDFf&_nc_oc=AdqGKjXeAptEXopxwaY12loC5hURAbocLZS67RHSO2fTpbN8Qs0-nE0AnWCm3K-B2V8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wMxivJOT2fypZP9sBoR1OAl8ANhlTEbDXc1sp8iLN_Q&oe=6A202602"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI1oVro76jAQ7kNvwFhcCiV&_nc_oc=AdqHOUc382SGerLVOHsBbBlLkR2PLIobVr8mdN6Obk3UKvbgSzxvxkpoWv7a3lstqbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42Uk-AFKqu0m75r7QI4zvXd4piuTO2TCHZuPmiaLE2sw&oe=6A204247"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRtqeoarfmAQ7kNvwHp-Ake&_nc_oc=AdpREWuSS_pJAMJ-SH8sQyOArT44rGZfyP0Rb0qYMSuJlUrLTzAujX2gX7DREn6CHYQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CwRV_XqKWyjvD3gCzr4ELV4p1sCXs0EN3jSYRNSLkVA&oe=6A203F25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB20qZBFavoQ7kNvwFY5nN5&_nc_oc=Adr6gtLOImA9ZxjNVtP3CRvCwtZTSVg9eKVpVPd8l5ChRhrCepd8ts_qclKQoHPiHdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61qJtCyr1lL3psVhdneEj2tcKLXar2pvn5GglsVqByQQ&oe=6A201F95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AGqNQ_ds0wQ7kNvwEpifmY&_nc_oc=AdonwvZxU1GczbhtPz2C84j7tmw4UWLI0WSHrXn-QJcp2DkTN6kEBR7Vc2KxSPyul6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iIZma2eD8VsayqGKPuMsm-WgpnHge_o-tZKa00VFYNQ&oe=6A202230"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=a2sZcFc9Xb8Q7kNvwFJ5JXu&_nc_oc=AdpE2jPkmIcZGfrq3Z5gH-PN-a8vgusYvB_OtERcrkraUqm5XzX066wYbdxnpE1Z1pI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdg9qmy0cCeWgHAlUU0O3Bi9x5kjXdv9ERHrVshBX2KQ&oe=6A5F6E02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyqp2ITI2ZAQ7kNvwHhQEQa&_nc_oc=AdpCaC-4U2QbUHDmfIkK0mJDPRT9VnoLZpBjIgBJ2ut5Jpjn72nUYYpYyOj7d98RiWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIXMhCIYcufyf1v-ZijI7E4cJG2dbco8hn-BB_3VVtPg&oe=6A5F8A47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clBHeQZPLeIQ7kNvwFSypov&_nc_oc=AdpF64IRfGNIDEy2ia1DW6HCIN4yY9L1xBLKi41iX3af3eVphlG6uNUKLLazNlKvDEs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApUx2MQsUIMwfQ4oAS9eE3pJA-YRCQ6dwonIaP2LTd7A&oe=6A5F8725"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gD-xPII8UYQ7kNvwFhuEyp&_nc_oc=Ado84_-QTHJkyy9bL-knSH_rNaHY7YjlVoPf2NUJ-LOodnCgS24kC-g1Hc3-77GZOa4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmDhme6CIkwZPID6-1jAguejyOGKAlRcGiHF2_lA93EQ&oe=6A5F6795"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQKwSwloZsAQ7kNvwFeGRna&_nc_oc=AdqxdUJR0NAvu3JDwTezw1bxNQHF3S9FUJ1lBHi77M0dBbU1SJc9ijapgwCIpEH3foI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa1w431SPkZL8-citU2EA2qcjX9RenVpKnYh3XVcLWbA&oe=6A5F6A30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
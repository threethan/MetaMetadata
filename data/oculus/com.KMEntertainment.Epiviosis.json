0a&_nc_ohc=cnw8Q1VVa08Q7kNvwH1RqYo&_nc_oc=Adpe9IK6TmijDeU0DeAO1ST6ZwHzaDIdydGg0OQMasWkf7l5Bp2pMwN1nLdLFWIO3F4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoBiej6uwXlVogLywdRllgKgqGdi5SYH5ZaC2Zll106Q&oe=6A71E302"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVt-LJM1568Q7kNvwH8D2gW&_nc_oc=Adr4aqn7_axd8r-L0Cjl5JpNAacZxm0RxafVglLvheEzyZa9BV_2mfS2tT9x5T90p3Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYKOVIIMsgpa32HllkVm7ZcCeDVHvGvdSEsZzJT55Ang&oe=6A71FF47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zycpvfvOzgQ7kNvwFr3hJ1&_nc_oc=AdrtdvPyNR0c4HYgnRESrqtTDSJ9_cwX8trqrzni8IG0FRW7Ry2U4vgPsKTEH8Is-QA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNz4ZEl4GGevg6pPvyR9jIrPMlzUTLjv6UggibFuDFtw&oe=6A71FC25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaLifMqtOMYQ7kNvwGUnD63&_nc_oc=AdpmUuMW_mhkXHruaNVQEFPATtO9JL8L5e1ueUcHUtYmdv6vtJIVKqCWr4_9qQyGey4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3PAsmb06gDshIy8RB3rru5NXpAjcaFP2IZEEmA3NWpA&oe=6A71DC95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu48UyQYhwQQ7kNvwHwp3bJ&_nc_oc=Adr2yKNNGUyP3QM-aboRCEiW9tWjTUs16JYHrRb6UtRmR0rjFU9VhhYEySfmFCe05rk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhJQKH4TCQswzJ45FKKehPxDdGr03WiNo82-nh2Re8rQ&oe=6A71DF30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=trXGtyIj_gsQ7kNvwEIsyX8&_nc_oc=AdpTtSd81qC6_st3AAOVE0L2IYxN2MrolWtTf60tdUM3e4Dy0kkbJ1TXleFRge8LLL4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS9J1k9jcg0QkhjmUvoRinMAijx7gdX0MK_7DB5DszEA&oe=6A81B502"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBoEzH1_rE4Q7kNvwGg6CXv&_nc_oc=Adrc15SPrglwWoAkYJmS6uuzCDVC1AeCEZbpxDugImNn0bX9SjdvnFFoizVldpvwl64&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAAWSx8uQMdOuNIqNBXAf5IkEtTRMIpqHk7YxUJXlDFg&oe=6A819907"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny9uY4s1nfsQ7kNvwGiUXjk&_nc_oc=AdoJxGWUFppjmEe019YK77PLiu5TO2Hb0Z71prEe0ItKzby64-lyRv0HbwIMHVvoYLo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUNPIbONHoa8BmqMC1ngisL0t231EEsxuAS493kwcabw&oe=6A8195E5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQE91ZuIkRIQ7kNvwHj3DHm&_nc_oc=Adr6H39ozKE2D-yLx0JRio8A_GQOHIX4znp5BkbKXnd2kMT75HxK0B680isQAy2gv_M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG17Zv44eqgEjy_RA_o5ndbfWJZAW1r-VncDRqUX8WWfw&oe=6A81AE95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VRWgouC3I4Q7kNvwH5RtX7&_nc_oc=AdohZhSsL5XodhLDw1pBb4Uxyl3T8B-cpspfm5VEN8b56sTwZaRYZaAgx2TAQpYvbK4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvJFmWpkdlxT6OgK9eNMFgfL-l1ZPT16KtyC5lkoiQ2g&oe=6A81B130"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
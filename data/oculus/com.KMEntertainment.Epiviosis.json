0a&_nc_ohc=QDM41g5ZTc8Q7kNvwEzWTKT&_nc_oc=AdorPh1ZB0Y8GYciFKV2NyIMq3m021nm3_valjlVTo8DOMP_zlhhx9vI367-okRcYfI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWasewM1Y1sal5NpfG0S9nXPvK0lG1-_57PpRxl56jig&oe=6A68A882"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEVA7xOLkusQ7kNvwGZlOHQ&_nc_oc=AdpCUkfEhV7RUptIvpu4a4k8Ti8kfPiygrrmVy8KcaZ4-TKaHndeAsZrbZ3gAR3LUjE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDniN3xmIFW8xgWN-dTk-LOVWVVkbeCcXkD1WUBdYi4Jg&oe=6A68C4C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph6XEeWbu84Q7kNvwE5Qa04&_nc_oc=Adq-O_xRm3ZwN3KbsIkXbyFXR9xWBa8vNOxVHBufKSlyag9qAFwFh653K2WZDUpDUOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATaHROoA75J0Kge0WQxjoKXEEroEo2igU5sk9Ba-N6_g&oe=6A68C1A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXWivvKZusYQ7kNvwEy71E-&_nc_oc=Adr0WTJjzKd--Ho6Av1g44KfngcwLOaA7DvsUTdUocqIkVi45h4kuwbdqKK4fkRU7Zw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIMW2WPi0NfQO2Qe1h-oyED7T1FL1iHajzCHTp6Ztklg&oe=6A68A215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isU9F24whRcQ7kNvwHDkkRV&_nc_oc=AdpBhDYzGJEYQC4DmP2wo-RZHoLMRXKYQocwKFQokx16xij7-t2qVO29_wuBXvvpPSE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl6E60Dgt0UymoY-Gk0iPgJTZS7Q7oiXAVq1v2QX2vIA&oe=6A68A4B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
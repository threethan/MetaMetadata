0a&_nc_ohc=ngqb_eXM8k8Q7kNvwHefTBD&_nc_oc=Adorwi4UnXWrh893hsWG5DXV1Vvll1WF8M7VF7xkHv1JUbzqfFWImP2Exd3hcCFf63s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qsmPhom-mMjzEjncJZX-h3GdsuDX98QiiVJr_1qcf7g&oe=6A217782"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVR_Cd2RlwwQ7kNvwH2tkrq&_nc_oc=Adq3St9nkcgskvDOL657O02rTK2aS2EPRXfD1EneWKieTYXSifsyXvDnd-u0b0tRQKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wk7dcBNj0zhOZCuI4un2JOcBXtg-uYwYcIyo7c-viRQ&oe=6A2193C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUXYk9ct2B0Q7kNvwEIiy0z&_nc_oc=AdrzRAKP7UgMytp0hhN6NgoN4t8ZlFEAkMNSjOwojZfFBqmoVD3BMktIWFgeqesPH9I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I87fHaup_9EJn6xDOKrjeJqL0LITX06c6fE7Lex-iJQ&oe=6A2190A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB20qZBFavoQ7kNvwG5L-fE&_nc_oc=Adq91DzpJVjb6VUCgwbqOWsAugHLsv4mrQPr3ersjK_fnEANA7ipE8yzNN1_utkmn5k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_Y6fr-XT-S0pNArAlZIqQK_U5PxPRhEqKnk1JHU0T3Q&oe=6A217115"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AGqNQ_ds0wQ7kNvwEBm2A0&_nc_oc=AdqZ72XLnRn_xWWMgz-wQgRDeARcBmRDyV6wWuhHAbQNHShx1Lh0ucEG7wd5WNzHIyg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aSEynW7BGEw6d-sO0639hifBDOlmQvbS-69hrGvs7aw&oe=6A2173B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
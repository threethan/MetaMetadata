0a&_nc_ohc=RW80kj9V_u8Q7kNvwHeIBvH&_nc_oc=AdoO-UpphyVUcLDnCzfSiYDZQCrV6Jc9V69qd2HU3bY4qQSHTj23TXCFm3EX1fmnMGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_DYR_Hrd3sEhiPbkihxsAz3D45-mwvdJK-Z6KwI6xDg&oe=6ACBC142"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leGkjmwTNdEQ7kNvwFkIly9&_nc_oc=Adri5vfChPqYYIv18ZoOeRKm9CvJESGFdr6_xkTHDJBR3e7lkcFLu7prxysKUFw9E4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdd505sByVJnrLRuYYSaCpojT31gsOdljlbDm6Ayb1pg&oe=6ACBA547"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0kcKplO_MMQ7kNvwGbs3Nf&_nc_oc=AdqqbZHChpezIvZnGvIGHpaA89VVek1h7JL0LZbazppdzwXMxFNdDIYnqNHf9QfjeWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC5_WIh6SX-wuSBXXGFC7mwKSmlInpBrLBJjl7Ymqjgg&oe=6ACBA225"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT4bzu0X4aUQ7kNvwHgscyn&_nc_oc=AdqEkvrj15r-OHvqG9DLFcWVbZ6Y9ONPp-x6mbdkZAUcjqs7waO2qPi7JqVGJgqPbyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAQ8FK-yxT8tgQUo1nKVYMjO6hd75ZgygAwj_MKMDWUQ&oe=6ACBBAD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3E0YmZbNb8Q7kNvwHUl-u5&_nc_oc=AdofxcGIu_FWuDORbaTU3Oopl-cUNWsYvXyXJ6gI4AoBdPYNBtSKwAgQdEtoKe6UdHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPvcYDR7yPJWsSPUQhjPGTuhJgeh5N82s-rFV-_B0WpA&oe=6ACBBD70"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=q2U4BD1z2ekQ7kNvwH0Z8QV&_nc_oc=Adp0mNv_E-MPSatzLZQ29qaP3BL41znTiWG6AfigNzQUHeiLwKr_VXaaAfv9_QD8qhg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSLANDGzY_vPe2kPPsai_-7VqLEIT4FU6afE2fgXpHmw&oe=6A5A2802"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlSxHi06bsoQ7kNvwEMGasv&_nc_oc=Adr5tIpqbD6FvzEj3YWnrRfFAz0FskOQD4n-fcsnb2gKKT_WrXsUb_f02-D35b9dWm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_srUzFNMQnTydn0UiuxKw8G8DTBct5vifs_6BGwm1bg&oe=6A5A4447"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhw7ldQv3p4Q7kNvwF66FA3&_nc_oc=AdoWum_inWRqXj3b5THQZOLRxDX9PseuEhvCOGO_VLnDT2vjkNbQ9LRtQ-v1uH6uyc0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSrtMMC9T46DZ9I-STYeZFKB0gcLLR2VeTodOhUV6rKQ&oe=6A5A4125"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3hlP0edh1QQ7kNvwHHJ8-I&_nc_oc=Adrfkf6iuuv0MKTwvM4Vixys7p5NIM-ejvKWk4nXV2JnHjSZMenpcjR-SSfoNBNl15I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBacRWojs4ZCxz2wa6AukcAjad97D4PGlKalgUm1o__7A&oe=6A5A2195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoUrARIYnqcQ7kNvwElXIwy&_nc_oc=AdqBD0ADa3lTYdPbOhrMXPFklfZcuJVz4fI0uqTbQp2zaBT2ccm8J3ita8qXJTYzkl0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk56Edxm0IdvMosBDy5_ZqYYB80pM17RpNLKIv9ZZ8vw&oe=6A5A2430"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=uLyDR3IZw9QQ7kNvwHtte1i&_nc_oc=Adq-id1jpUkmYHczbq8iDuxLVJMcYo1X0_4dDBitTSp_nFuj3qmUDWH3scD1jhj55h8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRP5o1hznjiFSRcSgRCZvKhd_XSiQCRDR28hXyaP6LjA&oe=69C68002"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOJmkv7vjp0Q7kNvwFn4bre&_nc_oc=AdoxbuZ9O3ydLkuoqdu3B-AYExdawfYEV2nGnfE2txITkDXg70yQx2msHugHCyCH7OU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwv7Qk0w74kVlrSY8PSn5G_dkxWkdT3Z2P_nhIBLrN1QA&oe=69C66407"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_gYIEzfmswQ7kNvwEqgTCu&_nc_oc=AdrtYTNfi-ADjfEpjSTuz8-jpht6CcG0vYj9rVDOgl2EemJl72LdW2wvMWQOqaf_4JU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzx-K2ukUa6cy0karOCNBeNOyeVzSQY1s39LLTuoEIixw&oe=69C660E5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMi-GTePKZsQ7kNvwFx7gfi&_nc_oc=AdoLGQTfFoauGXLynL6dMoksbNGS6pODMMNFdMVK_zzS0VFptZYX9PMOLBJnO9j4w64&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU7gBMN4_9V1wsq6gKPAcM2hxi99n-QrSyqqHlUZBouw&oe=69C67995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4WcVKWnvV0Q7kNvwG7MM-1&_nc_oc=AdppTl7GE7zyRLF_AizSM3741RMw7HzdFCn5rsxouIQ5iteg9o4BvlaX8dktDqrQ_Dc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDjQMMLG1YffeExjGi5EoNW7JG-xP-QXiB-MkyIMYl6w&oe=69C67C30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
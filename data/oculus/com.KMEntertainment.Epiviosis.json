0a&_nc_ohc=bDbBy6wNE_0Q7kNvwEmIkUn&_nc_oc=AdrhSrNbLywX7N03Luq-G6j_A40XqNt_RW-Lnz7ORqnacrln3xGzbqRSaUuANVVONWU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mPXGU1rarnHjNEHE_wS3Njd4cLVR-qc7Ykm3rCit4WA&oe=6A071982"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SC7pXc-OiuIQ7kNvwEQ9rTL&_nc_oc=AdrishHss5tgJUCB9lPWCsqQm51XjAYxtaGzSJwKQ1g77vjnfRYpI7sF7uPuOYmfIrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UCA3yYpwyh1W41gGrSk40ZTZdXy_KeOd4OItR2buPKQ&oe=6A0735C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqZ_Jm5osIgQ7kNvwE96qLA&_nc_oc=AdpfZJWqfVInPbkrRiS_k-LWUVv3nGpJtHsZ2297pED7wvc0m8S1jYSDDdObEXBBQic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G-xa4zJ_TkZLq-dqzZ0VA6jHvmtSqJJRHN0OPGYSU_A&oe=6A0732A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWR_1RILKaUQ7kNvwFueoLw&_nc_oc=AdqRDJoN5KS0z54R_SZ002IYFSVd52mrjk9DWvAH5UhwjxKLK0ISO3Ur_eOA_dAw1Sw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CuzrwI0uy1s9fWKeKpuJ2JkLjveJZFBc3-uP0ZAmEfw&oe=6A071315"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfFMvgUzEEQQ7kNvwGgs4DE&_nc_oc=Adr_S67Rla8kwP3GenX8bb9kot4lyctNI7b9GOKWpRf-URkzUeUR3ZVeYEL3B3C_do4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sRAd0tdP1c6EMSXSxNeDlS5r75EAWBoRBqK5g-pNPAQ&oe=6A0715B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
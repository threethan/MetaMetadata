0a&_nc_ohc=Il5HqsYfC4QQ7kNvwGY7ixv&_nc_oc=AdqKGB-eBKbt22CtHshvana8yFZkZ2xWkjRhd1mu2kC8aJV_D0W3JOKpbyIWDx2_iCk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMyg5ioIfIp1oaY4ogKCvfYTNIH3WQ-tIFHEDYwNPhiw&oe=6A6F4002"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT40WqCe6xAQ7kNvwFy3wmZ&_nc_oc=AdqTkpkeaCwDjGHlUA0zUaPFVSZRMYr1hTKo3txpao0yMzWOUa3Jq-mU1i5CG-Zprto&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQjz1CwLyS_rSbzlJRJW7YM5l0OVp-WQr7pnPJ0vM1rg&oe=6A6F5C47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9JfXG0uJCIQ7kNvwGKsaMJ&_nc_oc=AdrD0pgLj5ShqUpjCzWOLi4hjdAcvzN0OrbCx7e0kdoZGs3lqsbdUdpEOpsxDH6phSs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdU6xtJHfYJoEsvTyPaUwT23zV-gymUnEQwPXiA-m4fQ&oe=6A6F5925"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3ly_mm7XLIQ7kNvwGB-SQz&_nc_oc=AdoP4OhaUXtGP4bCJHjuH02ngY78ROBO80CpWik-zGZgAY-idYJn6RndxR8ZEhJnaRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2VoHws3Y35ODxWcqXrKQJ7CJPgS7AueuqFU8qMojuvQ&oe=6A6F3995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc58gif42OkQ7kNvwE-_lY3&_nc_oc=Adq6Gssuj1ExrehjvFmbni5HXjbDJjMunejMQW-G18tmBbb78wOlC0USvlAumHv1zo4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD51Ju03auw1zLQ5wczUSh3snZX_3_6pdSYIq16INo5Xg&oe=6A6F3C30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
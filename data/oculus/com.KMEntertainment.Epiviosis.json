0a&_nc_ohc=A56g5YItk7wQ7kNvwFj4Ayh&_nc_oc=AdoEr2DrZRjr9VffN_mVfwL-IxRHYsRtPEpn1UkeImshfA9_EVAmFS2HcuYZ9GdbppQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIOCroKk0g8YMbw5KDuyZZ4_dk2vxEfhVEb5BSPiVNrQ&oe=6A845802"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BPPVgXrUIoQ7kNvwFoENJF&_nc_oc=AdpkGFHMB912HKa73oZRJJEZLOy0mtHlWcUt4d-OdUTcC-tO72DJ_4O-zgb9lzOVqjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4zp5Ph7obvvkNFBbgO5E2_mTAZmlwpSig_936QjCmcw&oe=6A843C07"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cjKaeYjIaAQ7kNvwHN6Xzt&_nc_oc=AdpLbgTJaspBtpfxFzFpKaog6dVjN7S2NxiBNs8kCIaZ3h_C6U-yA-22ZLtL484KL-Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbBlQ5-YtpLUWTp7Ax5TNCyFve4OyejWNNeySd1otFwg&oe=6A8438E5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQE91ZuIkRIQ7kNvwG13ucT&_nc_oc=AdperDFa3cjoYyJ4bPU1dd-krrSqeH4lzFDXVdEw9pg6kzmHQWXFW_0-5XGso46Ky4I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQwJWFdGFMM1F1Sc2Idnl62szBXXbSaeeWQo1_TXMMTQ&oe=6A845195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VRWgouC3I4Q7kNvwEYLF6t&_nc_oc=AdoCLTWe47gM_xqs4JhskkfqO-ZBmcmjUPZVBpSxdP2P0o-RRfejO3juZSilg9rCrgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE46xatX4YXB4aO3WfZlrDSXNz_v5bbkqXYalUITF5CDg&oe=6A845430"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
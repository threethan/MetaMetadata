0a&_nc_ohc=UblFR6tO1QsQ7kNvwEO1GAT&_nc_oc=AdqQR44mvbTzRav_MFlWehzMXL9yFEwQU3SXYrOK2JXfdxH7W72rYNqyoJB-H2HM6Ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f1EIvpvz2PmkVa1Vamf79LYkB3udkm1G8s5y_Ov9Tfg&oe=6A25A442"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaAOKITCIFgQ7kNvwH0CWbj&_nc_oc=Adpp0dVWjdmMS6SVBtF-wic4-E-et9mOCT8zc5Uw7i8Skq1JyfQBy9BCg9G-oJFiemg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-194oaAX6HtDkUctrsU_Ax1f_vI0rR-cI3DDDaeB3s2Q&oe=6A258847"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ5rLOvWDl4Q7kNvwE1-mmg&_nc_oc=AdqjQC6RiNHwkOhf05ZhKklm6GKW2l3r3-mpU5k12Lllb4FDlkDJalMn5AveURdDLQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r5emuXOi27NUGMEN0cvNcY8enrkIuL2EXA1Nu5EXwzw&oe=6A258525"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wULvM5EyMZkQ7kNvwH6lNRj&_nc_oc=AdrCqafHRb5Ethuu6EQ0EwYNgZqhaiY8RO7k8giT5eROGuxk5BCpPOcpvSusK5805MM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r0QoQTdEP3UphHXZzv__dhGSX_RloVajbJXOJTKsohw&oe=6A259DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tHhHhA_WIUQ7kNvwEOIHJq&_nc_oc=AdpmTJd8qqJ7dbL9f6v62O4YL1MBzphZOnAPCYDO1W_58ktozHwRQlethLt8YHb84Lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dEFpveOPHMfkahr0rIGqR71BFd2gPM1Yxta1CKQ3oYg&oe=6A25A070"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
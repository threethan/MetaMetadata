0a&_nc_ohc=2kNJvn1Cx6sQ7kNvwHcjWac&_nc_oc=AdphVWi5CMkOt0R8TiuRYJnWE5EOGuTRLbLHkHuvnEBTjUTHtV4F-KxjOqUckth3-xI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P9H5do09ozMzkzjo9tIqCi_q1I2gAFQ_Ia66JL1AkHg&oe=6A032502"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBGKqcYNzo0Q7kNvwHWDP-U&_nc_oc=AdpqhWcodqWPon5gB-INCE6LSil-ujEZOBDz4vNeQM-Rgd3rxnWVEso5rooyV1adCb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6awoMIpfK3VOeV9iPHaZ0PZoI7lSy9KE665SjIX-MmAg&oe=6A034147"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlnY0BEP2L4Q7kNvwGctLnz&_nc_oc=AdpGqKFdx2NQB1ULDbLPh40V5n7gosGmA0e4ioXLaHGRla2JjdUE7CxItOojZoVA52w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ITjLFgrJD1OUY8FD8CRRctyApa2n9UdbCPWyc7sRb-w&oe=6A033E25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wtOxKS-mw0Q7kNvwHaGu3q&_nc_oc=AdpDPbhLGRUbXEsaB308Xt1IDwcbAz_3NWIfCSv9MdUxfqS4VuYoCnw4infYQi8VckA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yHpURUKsqDC_wgZaIdJak3tp7zaB1K_tLumaLb43QCQ&oe=6A031E95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igCt4we2j3gQ7kNvwE4CCH1&_nc_oc=AdoU0OCZElgu-t8fbUjN4cjTHvieoPJR0gRvcmO3sx8nXAyZ3NeabW0HiWzul3fVZqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f5lPVfRB9cNrteoZZoWRr2vygdaxF5wxX_s1Epi3o5w&oe=6A032130"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=Uhu9oeyXKCIQ7kNvwHD02kq&_nc_oc=AdogCfVDqBdL3kVpfI9gnN18g7T25lM7Egow_IMNg5aeWl1PqOZbNaXFfKHRcawPxx8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWfaqGhQDN3SYey9Hs793zSIfoWtyQ0Ap1Hc58Mzw_1A&oe=6ADCAC82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m91T-JsIPFoQ7kNvwEPBSAO&_nc_oc=Ado2xb876xrycvbZzOjDfkRafwZhbgiKZiNJNnnwZvqfJS7sZKcJ5Ev3jcArnzLt9iM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe-UPv13mbsTKIswtKJIq8GrK4uhZb9SSSew9Xk_x-_g&oe=6ADCC8C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsu_UsotnGQQ7kNvwE0h186&_nc_oc=Adq5cOp6MxA3xrWpYuXlSXAI1SxYWXVY4C3gwp5H-wt4EPDQjzoA5WXjK7ofkxrZTDg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQnpFKQAcq1h_Rfojy8jQal6EhVZ7RdMAUoKgPM40Wlw&oe=6ADCC5A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14Q9xGRsNqEQ7kNvwFsNnpG&_nc_oc=Adruy1HNkijJmwOkkHAWv8cBlkySa8nVatPTbOhF33a93vnw8vodFMrCcdsTKL3rlQw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlgTOoelm3AcGCl5oiPe85APyh5SrZpgHs6p6u6-36vg&oe=6ADCA615"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jtDd2FHqI0Q7kNvwGy9slL&_nc_oc=AdqikLvNTJGsYbNRLV-fBHcnh5Hgk4H4ve8Q924P8YF1WvxaWJsEJycSwvTYniKqeHA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDtNniPFBYMUuieh_7lK-MOy_QWsysQTXngW0mbqS9Iw&oe=6ADCA8B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
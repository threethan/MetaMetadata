0a&_nc_ohc=bywP05G6Sr4Q7kNvwFiA4rg&_nc_oc=AdphrhwUwTeRCnNEl_MDQL19kms2krfz0oWQWCb-fIsj9TLefVYD8t9A-mkbnZJFqpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmpNOTm82KQG0U3CpicxM3WusWve4u97GdQV9YgdlA4A&oe=6AA7F082"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtPfrPj9ZTgQ7kNvwHVEf8K&_nc_oc=Adqu9hjPSJkQEVoCE9FMGHZjZYXZY_kXSrjNoK2FnfsICKaBT0yv359vxsufnqoRpVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi9zGJqFeNWugl0v5WlPW7e3ZaF3j8qZt82UshBBHW5A&oe=6AA80CC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou2nR8sf_6YQ7kNvwGxiw0D&_nc_oc=Adpl07YYTGNIbE2qb6mngmNglAa6ilX8uODV6TYfO-EW0uXOY8aZpHACFfO_WVJ064c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1sIjT_uF6GQfKtcgBweTylhjOPZQWYHW3iF8ooRrXWg&oe=6AA809A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGjlabb1h40Q7kNvwGrhiu8&_nc_oc=AdryTb7yLSZrBjz7UezAlPS7xId51lyUSAUh0db2s01Ljwe4itPWV9Za32Sn3uosDBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkrL7X1KTBu5CNB3pyf1dKZ2DNdyCfCS9100dyacIJ_Q&oe=6AA7EA15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9ad6-P_-GYQ7kNvwH3015M&_nc_oc=AdpHKQu6pcLVIYM8OvnTQ3PC-68mSjvqJgRiPpYsoIaD_7TDxnhrHMHbPtZOPvhNoAY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR6h4EZtV2b9IXRRbD8b2MYYHxAwreGbQ1aD7RVq3mng&oe=6AA7ECB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
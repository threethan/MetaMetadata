0a&_nc_ohc=RBxthkyxTHoQ7kNvwEVoRHq&_nc_oc=Adp_8h8rbyyhvqKmn1RxxBx5t12yd27BniErtspPPQHbfeTaEfupWOhi2yFVRgBLAbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af272wQfalHVo_YORUA_OQ91FMBHuY1Nw2BAc7DCQyvOcw&oe=69ECBB82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZzR_FFdCEgQ7kNvwErNbA9&_nc_oc=AdpQtx87DKmbYEmFZixLq8mB9agX7AcFFw66o6xq0igv5bEtlTuvNtkDAjyV4d2fesQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PJe7ExKxUd1wJaqyUIo-6SLpPqaEni2LEtBemx4oJiQ&oe=69ECD7C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChPl1TpdMeEQ7kNvwGznN3y&_nc_oc=AdrnuW9kIJL_3jDOXWJvYnV_Yh7ULZ7LMG5CDaJaEPm1jTrP5rr8VQy8Ol9eAgOhX_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Cn0_YKZzzldAEWr1qVZR-al3xnI51i7KXTwiX9Tz83Q&oe=69ECD4A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzUZOc0dfL4Q7kNvwH8v-Qp&_nc_oc=AdqJE2ohZvbwHemRRMxa1nEtanEgpz2uMOUfP7PpuoCNXFlZ5cSD3Bhjb0uqwgPVrJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U37ox5CSpGzvk458l0lIc6IW4YGkZ2EY_J3J8gQOCkw&oe=69ECB515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IefYmewrYuMQ7kNvwFY8gei&_nc_oc=AdoNDmjYiA7PS8ADmGUxOTFYXHgOwLtd2UUWBfxOIwtSoQGb1qv1r6DI05SL6zvn9fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U8vgEC8ElfNHCiThQFrR34AG--LeGykHXPaArJUNZ6w&oe=69ECB7B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
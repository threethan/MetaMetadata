0a&_nc_ohc=rd6q52E9GfsQ7kNvwEKp3UG&_nc_oc=AdpQ6DKOTnrxTSo_8r_FAhcxvhzpKfV40ZJoFnM0esbpxJs5LYmhBr8VAL1ozp7vZX8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f-aGoH_UVptotk9fgFCTPnSQ3tcvTwkC3jDVowbpN_A&oe=69E77582"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIgZ_EFP890Q7kNvwEQ-N5Q&_nc_oc=AdprhUrTPHFKDSCtsfR6k9L47nAjO_ZpEWq-tioOKiRIPzFERu-dJQZgo5PUBjWHjo0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_idiviq8PGsuOJfuZYpG2abwG3HB1iVt7u_Nq3MAK4A&oe=69E75987"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnghoyY_-q8Q7kNvwES1qd6&_nc_oc=AdqrZcQscPH6xe6myruxTQXDJSlek5fOwuvoiqqac85BusupY5W3ObrfdRbea0CgJkw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WY2QppwYHmF6FsluLMNsgqn-qx1NuMkiHp2a5R501LA&oe=69E78EA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMZQANniH8IQ7kNvwFepeAg&_nc_oc=AdrCxm_58690Z6323cW7mQ2VKg_RyS-D0KggsWAIjaYK2AzoZi92hJs7cvmCeoC4LOI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1feCRaxfGlBbUaVp8k5Sw4rvR1VNseGDzGIOI6hFAuGw&oe=69E76F15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHwWR7BTyYEQ7kNvwFKcGIP&_nc_oc=Adp4ErRBT6u9Dj6H_hsfq9eZp67ZwkQKbdb1T9-ckrG2pQcK-Be3xcJ0rjIZr-t1XvY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mdCCFCYu5ckr_HhxT53dgUVccxl6vdXnPrNt0-mlScg&oe=69E771B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=1YoXt4jvW38Q7kNvwFfo967&_nc_oc=Adqqb_uzj4G7Pxzbvcty8h5wwIHcxbat3TeIG_popkh4s-NVF4MlJorEUROkc9mhUBo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtyaihF_R3JSB1OWw1-NHv0mEbQNwFjLZcKo8rSw8u9A&oe=6A92D882"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T9dyOHp5nYQ7kNvwFN59vD&_nc_oc=AdonBIaA6H4v9Uh6vXPEEYfpCd2GjPqhoijg-t8aWs9ykOF1AJNIH3v9B3Dk600Sm1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-hYhNJggkkA1KpmCqdBmUDKDtmUc4ZXA3Y1qqzcL2Hw&oe=6A92BC87"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxCzV1KGqAIQ7kNvwHjJsa5&_nc_oc=AdqSlRaq68M7O36ovsl-_e2gY_A3LdqXSeqAWU6OBsUysS6fvuDs_MfITsGeDE4CJG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf0oY1Uhm6_hjTRqBdnYpW6M7OuIYQwpspKlm-PZwb4g&oe=6A92B965"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARdvRt9C_SoQ7kNvwGhsWeX&_nc_oc=Adrryq6eWjUOu2ZPHTQgMtWB9ffaQz-AyROcwaZAAWJJ64V-b8peYf2p3zWaOqcUozQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6rZj9GkGx3L2E7gxA77A75BkUdxtxYwkEnPpciIHHhw&oe=6A92D215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94za5u6ax70Q7kNvwGnUqsa&_nc_oc=AdpA7HbWc_AgpFV9RQDSi87j6kXeNi9xYMHTymQymuI8uEuYFGqPj3hcRpQaFCRCTqg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmrmPpdiuxI6r3VCAo1z_UiSSJkt9p0pOZwXyxDDjNgw&oe=6A92D4B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
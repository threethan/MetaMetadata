0a&_nc_ohc=fKAzvvte3m8Q7kNvwEcuOzp&_nc_oc=AdoYXX7KYpxlsgdP_hFLALzNnk1STBRlMApr5_VrIZsrt4RcmFUmYgbEsh2frUFKFMI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bsBn7m0E03ZJ425RnN3laVVeuxLsVVFfMhau89WBqTQ&oe=6A314982"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez5NFMOSsHMQ7kNvwHiFijr&_nc_oc=AdoTwjhmse2BowAPdeDrf4-LxUmG03CUEMJxOF71xx-xUidVfWHjtuNdaYLI7mtsV3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XglMdMh7UR0Lc01gIXPbwUiZxYkkmuYYUJtRg8osHGA&oe=6A3165C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc0ZFSrvAsQQ7kNvwF0FQKc&_nc_oc=AdpR8Rjkuyj1gBZNVQWbMsMTizCZA0RkZd8SVusv9B-EtTP1USMW5TK-wiNOZlT1T6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cy5v4SzFJkzLWd935ro_ZHxiGd7JVoVwNNXFf2b-xAw&oe=6A3162A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVmyb_ZaKPcQ7kNvwGupUh0&_nc_oc=AdrAXXPgZBIGKHgPgxqcxbVN_scPSTi7nTHuv5HHjwZ3zHd6k6IpMqG72eNOcDjDX0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JgYXvamvfKPYHTXnkC39mppB_6SXSquqOdLAuuuGQkg&oe=6A314315"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKsQYhoQVPYQ7kNvwE3cSR4&_nc_oc=AdrKnm3_tzn5a1dVxy369DoYhXIkQuihWR7eHyoDPzjlFsgaFGsmMBM0fcKeChideDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hV_VFrrKvFxy2MQ_duQ9WqoYctTi9-NxUl2cgHSDh3A&oe=6A3145B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
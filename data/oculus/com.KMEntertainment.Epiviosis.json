0a&_nc_ohc=1mknW79EBiUQ7kNvwGsJCWr&_nc_oc=AdrVGHXtX62-Bk5MJPWxvLt32iTAGBuBCqbV78oW-px77vhaXEisI-WHuRruaRzqSlo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qWwZJTqR2Y8V7HZK5_frBUSe59SCwcaXgd1E1o4Ba9Q&oe=69DF8C82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_UR7sTgR8wQ7kNvwGjIPrS&_nc_oc=AdrAGDoevITRTiW2OPoanUCFtjgV5B6T6g-gUOQpvnDLn3h-gQipiruMMt4gScYhXsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kcdhEWM7jiz8O3ZNDYspcruHWKNyxUVK0yvIts6HWdg&oe=69DF7087"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2ZNMTmwHQkQ7kNvwHJXw-b&_nc_oc=Adq2xoaGj5VnDKgHDoQ4dRcvdnjrQHyG4tZkgIkdV9mxLjxTLn0ZWunSnR1HwBeLZPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24oX_m2pI1fE_Ladtzs3G2nGklF8fqxBDjdTaZUqfefw&oe=69DF6D65"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=510M6R0vATMQ7kNvwH4FWio&_nc_oc=AdrWSmRP5KoEsGf1IO4ZAbLtsLoLyIsABnhjasJFHedAXMLugx7eIkIZw495NlqwwqM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X5gd5LNJvMK9rH3YBCtk0nZBq8tlaH1WodsO7PoDaow&oe=69DF8615"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ertElj9ptxsQ7kNvwHZScuG&_nc_oc=AdqzzD6tl1fTEAyio266OM4BGWbtTx7ZAFrUaxXx5nu_x-kSW4Ut53Ex-ZUuOuS94PY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XppuuD5o63TdSqZuvjrdrNFRMopXu-wlksSq9AaDi7Q&oe=69DF88B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=uLyDR3IZw9QQ7kNvwFFm_GU&_nc_oc=AdqhJvoDoCPH_DA43TS6LSKFD3a4quLEDp1dd63LpwKz-QUXD8P84gc6P4bBGvuW5g0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgY8DjcmVD126N_OZ_Bqnjp3V2otjGDN-Jj--9XrjusQ&oe=69C7D182"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOJmkv7vjp0Q7kNvwGm1n0p&_nc_oc=Adrat7PfHxY8Q8TxP4U1G6rJPb4rq9q7Aq2X0ubvijg81zVMBKezNbSRx1J19OqpUDw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyoF1CdDt3kTQYqIisGnK1G5gqkR_lQamCMTdFplIbow&oe=69C7B587"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_gYIEzfmswQ7kNvwFUU3fH&_nc_oc=AdpNn7K7Xc5LjiDhvNEibLcRV6Vut-djiZORtG5aYNl1NosnvaA2hkWEj7nWqEFxt14&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwD4DNIB5TJ0XxjC44DJHOYsC1zxxNhYrEO0dOWOuHbmw&oe=69C7B265"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wpn7gZEfP5wQ7kNvwFEmzXb&_nc_oc=AdruBsUZaont-Ceey9CO2wF8rU3v0GR1QaVJqN7qCs4UJSOux2LIG4gT-IUcZruGPdA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxo6xC8Z3fa5ofcGtJDGpPZyT3GmzkOifA8i6T4MMCbeA&oe=69C7CB15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rzm7zGGeA3QQ7kNvwF2B71P&_nc_oc=AdpQySh8b8G1TgFuX5EuJD9bUIZVXBsdSGS8eTGiPLv5t9HJXSIRs6mYRJv3-qhu2As&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJSZn35whWJK1XfFekIDzRG56aXdgAjG-Al4vr2zcBbw&oe=69C7CDB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
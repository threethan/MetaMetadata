0a&_nc_ohc=r_dGvDlz4IcQ7kNvwEtapaK&_nc_oc=Adp78Qf1JmxUR0UkncyyxjY3mi09cohY5TA-xSFE9x1I9WKdSLpTd4039D5knLA9ozw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN9mzDE5a3_hEHjv8agdgEubSPW68GRR-znYvDPz6FMA&oe=6AB3CE02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnP1DfXES4EQ7kNvwEhenUO&_nc_oc=AdqAvHqdQtuNih1H9j7zrnxnJkVnZl__SEZmRGF4D8AFT2Y_kklkT8j7gntwCnGlpl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3hPC99RDh6gZ9VLn8n76CwwgjJAp3_gbD3CX9G8z11g&oe=6AB3EA47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxTTN7SebygQ7kNvwGZp1--&_nc_oc=Adq5csnYSKsMFRjG7O0iS3tvkk9RPQKc5HVAKdQcKl5Ot3v68v1tOKE_sK8_pCYVHEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6CxO0wRYWSQbhMsr98OG2zoEdaXeA48wp8f5K9r8MPQ&oe=6AB3E725"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71q-0yv00GYQ7kNvwGbsOaR&_nc_oc=AdrG_0kiE-Z5GvZKebyD8fSp7130uda-EYzsE8HaBl3uJyvD-z3_0ONsk1kwInnevFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqj8vrwZ7WdVWIyRwoFSUv2GluNsfEBQxsKoIXHfZTpw&oe=6AB3C795"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISRmWQMXMhYQ7kNvwEbCcm3&_nc_oc=AdqpRtyytPXhegzAVQjVRe1B-FTqz0zhmIuFYj5WmJKLF5lBuPq-Iya00SX9bJoau5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF3mBRjWKpxM9XQ0e_ca3qAQFxkyuFLjqoD4vnFX1Gmw&oe=6AB3CA30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
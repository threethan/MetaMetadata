0a&_nc_ohc=QDM41g5ZTc8Q7kNvwFr7nDs&_nc_oc=AdrPe05qRrQYpryGSkv5deSqHfk6_gwBZvkPGNyYbCdvHyABh3M8p5o65ydngTFfUr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7BI852XgX8Tn9gkyRgS4S51ohu5VpqLDf7KmNFedzLA&oe=6A6B4B82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEVA7xOLkusQ7kNvwE6B-_O&_nc_oc=AdrTFxJYxFjneNrltc-lUrIJIBqO2MR5hCqjfAREB-Zwqdq503IFICfFs3_OaM9hXMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVrLi6-XwO1lHqjHBjNpXLaY_riwTka3rTY295Gvq6fA&oe=6A6B67C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph6XEeWbu84Q7kNvwEdIwI5&_nc_oc=AdqbOpdPU0g2TAhaTDzEPdhPjvkkt4efiXTfF_jTm2k9M_JSt1KMBxrQWFjC33wxDUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBioyOWGJeYuiWZR2WxDpyWzr3NbNn4JOpzesuM9E6Rjg&oe=6A6B64A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApnyziKfpBsQ7kNvwEjx1XC&_nc_oc=Adpz_Lajcvd2vUUlJ50mqyN-myoa_6USWAewESu9pQ0eGcroUhqx2f_NpshS0Y0IY-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxPLBf-1kx3wPjHu3JoWPyNv-wA7VRdh3PgbIeONVwpg&oe=6A6B4515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS3NVtN-Ae4Q7kNvwEoCcdt&_nc_oc=AdpWXTw7M5nCGtMKkrGxU5V-9s-OSqLRD7ABnurbqmfHbNTkAy3tuAmFWvyupLpypPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK_2dXfspf42-0noy33_Pilnk749zlm1kXRPYCxK2XVA&oe=6A6B47B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
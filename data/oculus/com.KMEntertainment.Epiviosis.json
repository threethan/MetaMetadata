0a&_nc_ohc=GaxoHusIiEUQ7kNvwHYQa53&_nc_oc=AdoMu-a7Md8oI3GT5EmbwLbX1PI9wWTQ6QsJafknL3C_LTD81JclO_UwhBcO_uybDbM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wDvnMObqYsCRZSGvHk4fAWsCaZ6sAaYgV25Kof4HwMw&oe=6A16EB82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YfbjTb8UrUQ7kNvwF24MDe&_nc_oc=AdpZvby9m4O9zeEcWB_Y6TVGrwgN-0SQ8q6neLt3Zsrq_PxXHH8f8FkfbDuLRrbZawU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D5aPMxvLzpGZ-Ktt9G0A-qBLZI7B8Z82sGEYXfBhLQA&oe=6A1707C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8spVbUNCQQcQ7kNvwH04miR&_nc_oc=Ado7SYFn3X37Ip9RQuyfs43QERlfZkq5TP-9rqoE24SZh3yNo7BfKbMN-v2Q52XwEUo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WLd2khi_VtmHwaB-0qNSkIhhvvWu75nZZS6KzGh7rBg&oe=6A1704A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5eM14waC6MQ7kNvwGFqdN5&_nc_oc=Adq0KHDLHQ-6ZmtJjGYesBqct2V4v22NjgM3AqekARQHjOp_6WZGaoZt2p9TBkjRDqI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AviSr_00hfbLaQ02AtQpQQCluHjnbSyq_EXeO2uhvRw&oe=6A16E515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcEf3uG4Bd8Q7kNvwFEWHC8&_nc_oc=AdqFxmVR4ettJL_BYo54cBiqFGf39z3u1epdv4omG-NdAf6pfutnA2M171sl1ckpmWI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AWpmCClvrjbSrMolX5CvarWH8d6cOo6XrON_2S_CLiw&oe=6A16E7B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=ZhbNw6zjhtkQ7kNvwEMedfn&_nc_oc=Adory4fbT9T-NXtgSAxscQIts5XJt1_6IwoVDePOyj7t84VU74D7jHEM0oVI86ZMOBU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmDYsu6RvAJ-UY38t58KTrMj9uwai144KYz-PURxAnpw&oe=69C28B82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n-LxXfmM_YQ7kNvwHt9w9H&_nc_oc=AdrXFVNOn18Rv4oCRndwbLFnJ4jzpxHtWXFdzsv7BU31CfytSlq4Bmu6Qe5sm8O8QYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgpH2x_GDr0357LNs-8zxfFPNn7RjXrQcY-wco1XVxoQ&oe=69C26F87"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8Hai4pLMY0Q7kNvwERTGH_&_nc_oc=Adqsx76mV2zrARPBEIbIVZC7NwLOcAKwCbL2YkqHDbGP8xeyhrckoHo7sxTWd6eFstc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWu1ltMO6ssUdZ3AI45Af8mZqlZMjO6eR9T2USQ9NQVw&oe=69C26C65"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6hgcDV2TZoQ7kNvwGw6UpY&_nc_oc=AdrqKm9LT6yH9tqGGEGi0hjFV3um_8yNNVSErwrN-4j6v29VVlj9ieLFU6Wa5o6zOdk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznRaegDuzXy8K1HAWuBJt6katRypb-fJgH1DhSX8z9vQ&oe=69C28515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r01TYN8-VMUQ7kNvwEKOqP3&_nc_oc=Adr-IwdYY4FbMZGP9Ca0q6LcdEFce9NwjgRKSdya-xwuhzNbwi1JS1W_e1LueTQkGO0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSgBlKK2XNElSBqn-ISdN9cSd906oyUlTIJeoG7lFAvw&oe=69C287B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=RMQd9tJViBcQ7kNvwFoyeFc&_nc_oc=AdrGv09jGEyXL9a2BmmlDlok_Fq1OfeNOfm-UFL5FAM4a97DaWkBJ1CZP0yygommgts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af236I__sU2U32oNEIObTTwbb75UZXlyHB6gn_bC2oNItg&oe=69DA4682"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11t6ap22BaMQ7kNvwF73n2-&_nc_oc=Adrd4_8v1gdl82zPaCf7Zvuyj6EVUYes5c9icJsfi1I0DHpRvuEQZfkADQs2LUntK6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GURMbjc8mjwbvgpRPGFRh-BRk3U94x99fzcSJY1CMPg&oe=69DA2A87"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l276-09bt2gQ7kNvwFCFpK-&_nc_oc=AdqJVog6zJgBq36ilxUm4pXshM14JJAre9SCUjbE5bD2-VkzPo7rCk5vEflNYL3ujNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BWnEuTPiFVv5wgoFpDHrR98fKpCt2JIP4BMFCn0tHlw&oe=69DA5FA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NsmDkvyvDEQ7kNvwGnotoM&_nc_oc=AdqsLe_e4eUS0leDPhNBE07YOsu3y9KtHO1G38fBzUmRZsOlVwByOPLzEJaXJDeAJ24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G5LLiQX4YWHsNGs6HsOk2DwGgAeIB7rFNrWNWbNT21A&oe=69DA4015"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKmqi0mN0wsQ7kNvwG9ozdw&_nc_oc=Adpaj2q8YsAe_5hLnXXvc2vYpcbVKOumqv_pHgR5R2mRiXzgZAl8cDd6bOtw7pAJ1wc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wKOLZyZemVv0KbbterzfnSpq29P6nGac0QlqrBPTIQA&oe=69DA42B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
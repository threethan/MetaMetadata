NZ&_nc_oc=AdlEkozyQfuRbhkevExYQPRqX_IrRkxudB9NIy-YCaTPRsaJVlYiJFDoXRYUXQ55iEc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDZNJXlsiRenBbebOB_Jiz-u-7FX_hD0Yu_CBrCAyE7g&oe=69AEC502"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6G--xskeDzYQ7kNvwHyFvmX&_nc_oc=AdkJo09KXstTv0hPQzf8sdWAvWGZMwWaUlw-M73eEQUFL1vIJwKwoFDifTd8NukUG8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAriElDT2oGBmXY1HObnmMvLbbXsDH3qPY6fSRxGMAhA&oe=69AEA907"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m76tSZQod8QQ7kNvwFQynNh&_nc_oc=AdmCtAJEdn0NqVAHx_NXeIaSunEV06WxUyqdtpZPi35w1dIpWULJqe-rdTd5EKmpA0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxVFs7ZOcwteg5_HYSqWOXfbTWuSEjG-FHYjscCnJZmQ&oe=69AEA5E5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYxZtBfTadkQ7kNvwGYTE5y&_nc_oc=AdlGMJceI6rk5i_qFCFzGOaqqwZc3K4suAJNwBqnTXn-FlXKjqjadCf2jJr3UZhNHNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZGi1P_iEpHY69ReONcvEF2BBTCDvTSBGzcr5HETvF-A&oe=69AEBE95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwZGKGtiXRAQ7kNvwFkye-x&_nc_oc=AdnS25KpO9fUJbbuevfDfzXw8_YRaNwULmr0_uwjgA0eTTLIzG-noPkj7eOQEmw35JM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVxn7BscwbmT3GdRKwSZt1mA1L2VyyB8JB_02FMBi19A&oe=69AEC130"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCA
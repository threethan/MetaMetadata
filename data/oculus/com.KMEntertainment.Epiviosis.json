0a&_nc_ohc=dInUrCQt0zQQ7kNvwEi41-k&_nc_oc=AdqhFnhzKcY2_psVhFCHl4m3ZeGEwqnclG1U2htlSqTlwDgH1fNHafegJslr2CRStvs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPuVprh5lCcxNVE5ReIDgBTYXMvikdC4zsTFtpsWRtqA&oe=6A563382"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vktZ0W1OahwQ7kNvwHZbcSN&_nc_oc=AdoN7G_ShBhtFY9YgPcNBsSqytNPBTSfdGgEY8Q1LudMOw5-BD7aOKXVj2q9mtOmL4I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSModR_VK4DOJZBp0xOhrRP7oZl0uyoFq8bU0j6FSGHw&oe=6A564FC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UH1xG6ZQoMQ7kNvwElzGZr&_nc_oc=AdraQZKYGWyYia6ZFrcLbCBCfVhxhVWV0T22A5Quj79SM0npHwS1zDBR0wjW7Hnea5I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK_wH0MY_ZFqVcie4L2f7Gs2noMLkV2U6rFSs5gdjXYw&oe=6A564CA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGM9KgrPDv0Q7kNvwEbPBd-&_nc_oc=AdqmuTyh3g61S9ZaqbNCOZV-ir1NERBEJaf_SPWn-laFl942ooE7NgJcuebOF4vRwJQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiK6L3awgRljBL-13U2WZT8ab3L60pTz_-ux_BxiYRjQ&oe=6A562D15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_MWyZxRtmoQ7kNvwHves9P&_nc_oc=Adqpa8RK3om89hB-6NEHyw45SQPoTDiflw1HdyxV-VE9-lRLOrdukiyLueNHyXxOm4U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtKrbsZaJWyHTfeJs02EMRF6p2P2oU_2n_aOQMJpok_Q&oe=6A562FB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=0eAkGILSN-8Q7kNvwEkuF4T&_nc_oc=AdqD4xfHRhmrm1k8kUe94d_uBqyxc5R7PC4x4yVPIMDTWaNwy_fwCojj1gPgV1YD1TI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSw1gruxsqpwixkzh-tpJE15X3yG7VugNFzLsPJ--fAQ&oe=6AC13542"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htjkCfRwhM0Q7kNvwHRnER1&_nc_oc=Adpz3KbwXlJjm5XM4YuMpm4Br4-5XPt7Cqrd9KoC234F3bHQrX0qtI7_l-12ahz3emw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpd1FUvTPhlLEfNzRUIiVmetTggPt5AGo2-GBmFLMqXg&oe=6AC11947"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfc5dDj7CS4Q7kNvwFWUeHk&_nc_oc=Adpg51XtmTZ5y_R9pMl02jDCMrLJZxR-ioFJLacfA6_bzzWyVy84Joucm39u4FvvyMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfS2EUqgg7cjWYUVh8tuRVcIlsqjhcE8abRtLuOjiOAQ&oe=6AC11625"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHFBWi7YTOcQ7kNvwHR2_u7&_nc_oc=AdocqFVD9X4f9tJLjJtkXcx4DX_zgq_vvMf_RjrkwzDwcAJZ8gTEh_6UHwkQr1EE9Rw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR3zBX7t_wXRHs5MYqag52iIKlpn1KdDhWYh4x1W5igA&oe=6AC12ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSoxamEoiDgQ7kNvwEuiYFb&_nc_oc=AdqGaYjYcuiuY62z9JR03tatZqHSi04uevqZRUPRwW2Qmkth8coKpdZDhOzewMAK4es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNYrNJnYEIpRj79gtM-vkkX6tXr2YEio_xxHVo61dybw&oe=6AC13170"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=qBK_r9jKdxUQ7kNvwG8hMFK&_nc_oc=Adp3pvcB-CbjTQL840OmuzK1MB64STEozW_zpqyOMWSuYI8bCLtj-w7-OC1lD5nrL9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH01hollaYTXcGweFz3_bknX3-h52EruMzhK_4WKWtZPw&oe=6A75D782"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MPr68rT4EQQ7kNvwFaJ0f_&_nc_oc=AdqH7ajMamgdyeiEVnsSDxKK_x4TQg_lrKzQCFYM2b8HUXqY1BtZmaz969OnP9z78qU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqhYKRgWIfiLizoLzjTvIZPXZ3tmOx-EofUIfay1jIog&oe=6A75F3C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1GAKpJmIU4Q7kNvwGcRDnE&_nc_oc=AdrgOQf2zVpE-CBuD2VteqLJAyeu6tC4IDzc92SwAJjPfm0xiNRnu1lxlsrbnadH_AE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk554pmlhmIvC7bm5MpRl8bX5hSN5Dxehe11ToYy3SZA&oe=6A75F0A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GddPUwqKdAAQ7kNvwFL3LUO&_nc_oc=AdoWxZG_k0tjDsclJdpWnxxGYYa8vB96HB1hkaG4T4fzT6X25q1dlGMtU9pcLZrvIoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUNWNb-N9TUP62BSIuMaUI_Qg15XNACjZCDwDQP20D4w&oe=6A75D115"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYI7IghuJoQQ7kNvwFrAesa&_nc_oc=AdrPl3EuJedZgAABr7evqAuMLfYnU_iWqen5d3EAdIAhXWFl9f1kL9YX4_Z4NyyoR9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg9wL7fcRh9vcFL54XK2S4gaoFUTQ8ahgz5CrR3AZo2Q&oe=6A75D3B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
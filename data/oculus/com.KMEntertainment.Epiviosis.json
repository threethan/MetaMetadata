0a&_nc_ohc=1R5xdt-u4AAQ7kNvwGtGaWM&_nc_oc=Adrbkx1QeChSqXNeWLpDB5uEenEkH1yLKcUanOYt1UCiygAcxgU_MNgzrCOp_46JQS8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5uxjsfr6dqQoLjbK_4gq-RzU7UgFjznkyXjrVgLtNFA&oe=6A2FF802"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZAkL9jVmnkQ7kNvwFdsamu&_nc_oc=AdpFls-BSgyy-EgqLKzDG67DOLbwRO6BeeSbzvOKcXAGiBUiGPzwV3hWStV8Df8oFs0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uxnMKO4PmC2xPuWj8q8-weh8cqqKoBacIsnpDt5RbJw&oe=6A301447"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqHbgHG1-4MQ7kNvwFcSWZI&_nc_oc=AdqjccWaQdw_--9LbxqljD5gJdflzK5BBU8d5zNqD9SBm0EMt8u-7XDfkpY-MbWXuhw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Redd5zVEJLG9fmnetnj36TzRiqAYnQ1OCMIZzIMW9Ag&oe=6A301125"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVmyb_ZaKPcQ7kNvwGC2RNa&_nc_oc=AdphIElFAi_jSvcwaYjGa3vLH_kyqaFOaYmL-9mO9S4PFu-BjvzkGRj8VAeIZkT4agQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LbejHbfxu9jTq-RkE0kxpmeioTmeJrNhxrKoyJh2NwA&oe=6A3029D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKsQYhoQVPYQ7kNvwGhC636&_nc_oc=AdrLdbs2q2sasu7ysY-155ge4t7u0PmYkF-5n8n_SrRdFe7O9n9TokUEqFPDb5x5CS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rrAePZAwVV-mm0UPVRQzVcwOFPeb9hRnTR8mVPfahNQ&oe=6A2FF430"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
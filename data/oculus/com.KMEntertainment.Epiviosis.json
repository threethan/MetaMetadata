0a&_nc_ohc=exzlyQDe1OoQ7kNvwEVPU_U&_nc_oc=AdpfTgYikSLaHdxb9Bzm5BwnTc7aQ5sMmO6QDTNxarWuCLke8mxrRV2BXx4omy-UnUI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-76DHPXSlCK6NroFcbbwHqHWx3SUSQIfVRe-iZEdtkWA&oe=6A3D2702"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd_Db1QsexkQ7kNvwHiFvpP&_nc_oc=AdpDyLgSnUhasR23jbRQ-nyprMxqf7rdUHiWByShk5BY5LiMOBhv37lqWp9O2Ed9v6s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rriO8RfaVtnPj_043bzKEvj_6LN8A0kUg_GPDxo_eCg&oe=6A3D4347"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD1ZgUZVG30Q7kNvwFVG2h7&_nc_oc=AdqBm60Boyo-llHWQxCY9DZTjnA8lZhnf-D7IixPqDkFNPkwuaqqD9r69Fqlge_yysU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SJs0qTmYqMqNjw3mzHl0FStwFchza8oCaIN0iyxwhzw&oe=6A3D4025"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCGnj0ycsisQ7kNvwG29R7P&_nc_oc=AdpCEcWurvrK5K71bLtK5bJoU_4xYOo2ssX1mRjiJkJ9_jBS41Djag6qP9jFk-bksTg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qd8ba5nKabaejU7z_lATs3UMltvJxgKGxN0WX6RYchA&oe=6A3D58D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZtI7PKb9ogQ7kNvwF11SBJ&_nc_oc=AdphPfUIDfD1Wl6hCP2RxANqzHLvzjLInPGhnFItWFzp2wJRt8TKjrafAM1vLz40pXU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qFfWcju0ixlD4kmVKHAct5F8v79C8ulc4DNxCynaA8w&oe=6A3D5B70"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
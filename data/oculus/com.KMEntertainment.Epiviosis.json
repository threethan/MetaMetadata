0a&_nc_ohc=a9a0PmUU1csQ7kNvwHo7PMl&_nc_oc=Adpe6pJ1i-LoN57Lhjt4Rc7VZ3RLkCpuORSJ-UCGbSU9W3f5hMIK69PzVBQKrgLat2Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfWUsk_5f_JTJgyqhDtV2VLrgc0m3Y_EUMVksrirwkGQ&oe=6A973D82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti5_HS8XXG8Q7kNvwESdPNX&_nc_oc=Adrvwu3XOoQoFGxmG8APFQS-mZqXnrWiSCkPIQzPxUSR431ujyUmWDDIkU7Ej0qalik&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkG3Cj5E-x0ikLiAsayBOGJXMiaBMbknk20-tL_JKg-Q&oe=6A972187"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEEr0CRm9eIQ7kNvwEezYRx&_nc_oc=Adoa00LCa4Rv5ilxxxIOtG86Ry3eXZYWkABzNdjgisSrsCwvRzc4fULW5-sAZTT4kKE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqjyps3FjhOTvCF7XqYw892AC-GOoQZPVBZqrYMUhOHQ&oe=6A971E65"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-JyV376Rs0Q7kNvwGrm4aW&_nc_oc=Adq_yKBiQ8WhPcvtiUesdlvc7ILZ915QO8X5yMi4Ptxk6SMqdPoTuJUPfjgPO61F-h8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUKZfNDVvqcB66Oi1yCICWMLAw43SUEH7g_9pUSlnfZg&oe=6A973715"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_S20v2MhmsQ7kNvwHB8z5m&_nc_oc=AdoOSWhD1GHSbLr8pYM2IvgGQsd3gfyYThBLLAqbYpCA-etqSxyyl5Nz9WtsYBNDt7I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2ABTLz9OtvBZ4I7pGaZ0V_4wmOrNYAOgmQS1HoASTeQ&oe=6A9739B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
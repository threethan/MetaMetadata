0a&_nc_ohc=A56g5YItk7wQ7kNvwHCRKyD&_nc_oc=Adp4gBKfYXyTf0Xer70yFdC8UrXapoY8rQnWj4MwvOV0EtLcEzbb22OXUGQmWvvmRUA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqs92kD1EkRXkPtnX76FyaXLse6EMNS-qJD72dNEsxCw&oe=6A86FB02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BPPVgXrUIoQ7kNvwGXOZY3&_nc_oc=AdpyJIsk1Lx1vAyK9xVUtzHoxGVmyE54WDsUc2_qtaJt9U16uGSbx3IMO-sU_QTNW5A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN8m9_yQpn6jiEF8AXf_dsMwUB8Z-PCKLAQrGNJIoGqg&oe=6A86DF07"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cjKaeYjIaAQ7kNvwGlaWwt&_nc_oc=AdrZFJUeBbZKyunmDQKCE2nXzp9zSWXtAVG1bxULd3vAI15AjMAleEesDqZGM2Ebmgo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyZX5yGXrlix97nQL2Jb8L0o6vwKkP7dvXPXWxDWwTQA&oe=6A86DBE5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_oeRRrROoAQ7kNvwE3HHAS&_nc_oc=AdpThFNPmq8GdYZLGrDQznToHEyl4rfrPQyIRBIRrixWzejPVGxEDOiNw8S_a6u7mTU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERW-tmI8a7uK1kSWP-TXnX-wXkRhrFkcs6OBCKNs7-yA&oe=6A86F495"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLD7de0fGSoQ7kNvwHT6X2o&_nc_oc=Adqgd-hsTT0Ia8ML-oKL6qmYvg7rXiEApEnZVyAE44t_iYmbxS9Wv4saQGByRuC1FHc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfcJ04rWsOFfzSC4lDnPgw0XG366_4IPAfmqn5KTlmLA&oe=6A86F730"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=84mNeqHlI2EQ7kNvwF9vVwT&_nc_oc=Adrmj4e0_Kyok65yov4JiEBAS1H7qla69UyvCvpEzDw71eMfbBE54jCfN2itiOVcHk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23rmeFm2z23YnwyuASBbgOp6sW4B8cgAlF4BD4N3qgcw&oe=69D50082"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4FKBJ2omG4Q7kNvwEZTyCC&_nc_oc=Adp9-Me1aYqBJjQJiS-aqUXnW8wL814p3k62oYMNimdWgCU9mD21MbyzfmZ8j9TfHqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zfXhxUPwU_5veMbkQCEMWdB1KL49r0Fbj3Ce9tCzpFQ&oe=69D4E487"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEv8bYGHE6UQ7kNvwHl2Hj8&_nc_oc=AdqPsbzGx9415sOijPJ0wCjKOEWR7WPW63nc_Qoe8mYxhqsBtaYo6x-c65zBnKwkvXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T5pXD1mbmcoMSQV5ndHPWJJbRxZU3XBk6hy2kOkY76Q&oe=69D519A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3h9KLMFLtoQ7kNvwFVDfhc&_nc_oc=Adr9PyNHsM6f_jO2_2KAHVq1C46nL8th0QzOJU29OGjjNBynGJJ7VJssFozF7RwRAmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zlJpa9sU6iBByU_X-OI4eNtOiUTX600IfT4VY0iQMMA&oe=69D4FA15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcLWaKZVRmsQ7kNvwGfboq7&_nc_oc=Ado7JiTe7_5dzKNpEldQ82AjsAcs-aQaLsoNzsqYuFvk0pbtNJKgT8Avt0v7MUub_XI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DLdqIloIQUYMCm2zqFfqHhYvqdQ-oqLUfCUiGCmvCag&oe=69D4FCB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=ppjnBtBdnBMQ7kNvwEQaIP1&_nc_oc=AdpP31XThOgdic8GU2E0eRE5R_sC5ws7nDonou4E3Au6rSsrN8xkLh9KOPMjgf50fgU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41obNiXFmfrCccCnAhIWipNCFWLWIddpXOSw69bOReyw&oe=6A0C5F82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ugl54g76mBsQ7kNvwGUBA-t&_nc_oc=AdrJGjAyxawZDPpgMg6_75F1LFVijpYRWPkPzB8HP-wescrHz5Ml0BjSrAslx8Oiwb4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TruaklSHbkUZN2lhauQ4d-WTYtTOQkEjJH9fQJPxV3A&oe=6A0C7BC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1Pwf2IamRsQ7kNvwEKzrHJ&_nc_oc=AdpoT1EDpM8WHj75irbAsfdwRrHq59niPto3Z0odtuR9mM7Fvpa9p0g7kIM9kTCMTos&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75cxB7qZtROaysCmmg85zkPJekrMhj1RScinH6jqB8fg&oe=6A0C78A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_miWrPqT5AQ7kNvwEmGd-I&_nc_oc=AdrmAX68rIM6SArTl7xLj5UjnfRrSD9VVThkcOo8LFykkNQ5QIcL2JNribVE8GKGpdk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ELKjA-qEKsyRw1luwWLVIHGgWbtwoXGaAUnrMabmtzQ&oe=6A0C5915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aNurXWJm3QQ7kNvwE0saZS&_nc_oc=AdpsjQUcF13mjHcbc2pfGSVw0RQLOft-kupkb_EnndfZr3i8BCZ_zWAlu7vzBVHVJ2k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HUrbSs536fpNoPXYisLnS63jdmDT2x4YVFA-ZdXzSCw&oe=6A0C5BB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
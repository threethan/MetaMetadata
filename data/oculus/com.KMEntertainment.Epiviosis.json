0a&_nc_ohc=q8-0z387hqQQ7kNvwFS2ZXV&_nc_oc=AdqaDle4blyBg27kbncEe0gg46FPRc676459TmejWdpSYBxQssozlMku_LYfT9nLJ5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t9My6e8hPesUGKEIJXgF3xmh0kPoC5QEHelc7zOL_BQ&oe=69E38102"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bhQnm_FkQkQ7kNvwH8jUKl&_nc_oc=AdqwGeIezfp6uh1Qio_z3EjIvsjjCY2YHwHp6rjWJGFK0m2jRWtx00P7fb-BSRvOp4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R2xbX9g6ih5_3377kuFPTQlfafaQ-VWdRlwLLy0BxDg&oe=69E36507"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LHaIcg8fBkQ7kNvwE0oxQK&_nc_oc=Adr2sOp_-IUU3lqOGXqczZmG7-l_chpc3XBTXJqIePjq1ikcPfvCOzUapSVmIObPycY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g9RmylxLZDM3LE2qnI2JFbcKA-csL8h2ZauECjB6L2Q&oe=69E39A25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYhdogcsgEYQ7kNvwF-AUVw&_nc_oc=AdrwxwIsxbOO1VLZiRDMLkzXMUqbx0h57RP4D4cVJM4Xy7xGoTlI1K1Nx2miC0TeWfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10m392GsRd0RUSSUnjhSsUHyOLPRKFPlx70zCSss74dA&oe=69E37A95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xOHTkOd_I8Q7kNvwGN6QAy&_nc_oc=AdqHoKNVgpOL8jCa9-8K8FT6L4a3vR6KQGLw5nAG3nHubzP-BEseQYObNj-AKqa-JtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UosH-Xdflv7z9YjmXWmrRQeTLbxwIw4FbP8Z6ojf1ow&oe=69E37D30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
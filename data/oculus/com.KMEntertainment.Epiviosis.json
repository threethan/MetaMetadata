0a&_nc_ohc=a9a0PmUU1csQ7kNvwF-3LOd&_nc_oc=Adol-CYe_RfXMppIQmdyHnBKhJI85U3uhifsXSB07B9amFGjUu6X1NKnHY8zJRitcDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGuq0CznOPJaoeCjU-khykXDLGvUIDSyMAk_DmUD-N0w&oe=6A95B3C2"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti5_HS8XXG8Q7kNvwHELeNW&_nc_oc=Adq3AZvzc0ElUVNM_U16XcDZUEjHIk1uBFctWvteSKqhvrFuvI0VI9Bgi-TXVtilLl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHctpJgsNlhQ9xwfbeHQaiXFS0S1SCtmewRAp7e_6sS5g&oe=6A95D007"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEEr0CRm9eIQ7kNvwG1qvof&_nc_oc=AdpukCCg8hC2RouH8JuFA6m96yqgSSvhoCvYdYJzcLogDYmwUkhT53SkQPFGnqkwlaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbCUE_0btbNnIaSh4CR1OhJueUdrmNoYCsjZ9wBxVTxg&oe=6A95CCE5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-JyV376Rs0Q7kNvwFq_0lO&_nc_oc=Adp21JvK89-efXA4q5PaMOlCOXtgk2ynrgLnekoxip1lAIyQIpqQUOiDDj9KJmRYO9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-yMsen5ip1goWyzBkYPXifRCwJgAeBZfKKtVpcdvI3w&oe=6A95AD55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_S20v2MhmsQ7kNvwEKOO8l&_nc_oc=AdouxOlEKVMDinblNi5HsIcMDaWyKtypYMNnFHANpGqffGMyA4ziVRGt3UFRD_4zKrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH71osli4-SaBnv0zQhBCfbo5Vkf1ZSRRIajWCVL4-5g&oe=6A95AFF0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
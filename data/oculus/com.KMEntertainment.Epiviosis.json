0a&_nc_ohc=KNwYbz2B4pMQ7kNvwE40EZP&_nc_oc=AdqH0KIWuAHIEN6EZZVIlrfMELYquInA0TjlOk6fPpOZG_KFubTvW0L0IcyGiGhGPGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpPdI-OUTd1riQSnJcpCT8e1tYFI-Htv0GfB8Sgyuzog&oe=6AF34E42"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mKORFB-wiUQ7kNvwGGsPMk&_nc_oc=Ado8fWjDnq1OygI9ndZ_oCTUVnxcbPqgmFWfSGEWuF-Dk8zUkHG1n5qf11fToRObi6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlo9oAMh6lYQ09pLsnNBKZWtVYtbM74vG7B4S8Jxs_kg&oe=6AF33247"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oaz6FP5Y4JIQ7kNvwFXEnHG&_nc_oc=AdqY4G80I-AGuSslvkcIr40JeS4tjv8bScyDHzpm2U8erUaksQrRedoE9mwwrQFTDl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbeW2nEtE7JhpFh7ChpJpKSdwtN7ag3w5dCpuJIhYL-A&oe=6AF32F25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6CejixKM6wQ7kNvwFRMAN1&_nc_oc=AdrEfQI8Xam_J42dN8vrsJz3iRYiKm9jTpeiKlD8NVIwLEOtTr2T76pOtAStB5msr1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWHEKSrFnXLamDkYbhGEDroOo9swCHMZVbLQsLispcHw&oe=6AF347D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SMJIofZ33IQ7kNvwGKtDKe&_nc_oc=AdqLtGMfP1beHuI6UxtrnzWkmw5yShuA6qpkvwdrthxVhKD78BavwMwd5bdnCMJRjUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuHZLKQWa3iqYcB7AX6z7Qcd775S9Cy7UpIdUvs54FhA&oe=6AF34A70"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
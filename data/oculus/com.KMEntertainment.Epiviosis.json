0a&_nc_ohc=KNwYbz2B4pMQ7kNvwHnTS9m&_nc_oc=AdqcKRGOPAi9x2AHUXE4zI1VqzWlz6pUNtMSzuJtgzQjei-2lrD537Oi3a3iEV9Mgsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ-x6abQ6mnEFUGU1j6aPZv5vRodneFxtIEZBR2QKG_g&oe=6AF5F142"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mKORFB-wiUQ7kNvwFqnR8W&_nc_oc=Adqij6TxTW1L8IAWYau27eO_dF0hjU5g5FJ_MIsi4BE_eq_jJqaH-OvBF_tk4046rPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF3qLiaC9yLEXjem8Zm4j6I1klJl3381GoBZ3Y1YFd_w&oe=6AF5D547"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oaz6FP5Y4JIQ7kNvwFNBRnr&_nc_oc=AdrQ7Pzbyr0l-BtfwYHJec6HpV1QpP9KaRa_4GGMbvAxGLs-Or9Gp9kbPPHsbyNGAlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMJuRCSGoAvTrKOMeS3KfFZrxP5qrUyfZOevgaDNvGiQ&oe=6AF5D225"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDRU_sfrNUsQ7kNvwGuxASw&_nc_oc=Adr3WqiJsAFf8T0uaa7upQrr5yl_A6M4LxvktyRm8qRF609njmU-0GcVfGo2zYm0vqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8sqdYgGZu6cMmABt_nrpmQG6aPOW6hG9eM5fueqHvvQ&oe=6AF5EAD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i9tNMYO3d4Q7kNvwGWmoju&_nc_oc=AdqbBptJ6nqOWqWUjTEI89gSqhASdi3mxOBsbSXED7u_ncfa0o26HFvBrMI6QRYCcq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNsrDB7pFyWGQeOpKt0iqw858Yj1Z8-P9_WDWuJuPndw&oe=6AF5ED70"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
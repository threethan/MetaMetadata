0a&_nc_ohc=GaxoHusIiEUQ7kNvwGwbR8R&_nc_oc=AdohOyxHK_XHO9Y2p0YFXBCq4CqdSsm3g6_1b1_oPbHV2V2NS2GBn-LbCea8N9tdkTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GGQ934arOCuwpyO01SfmSM4bmiY8G64t20R17CkTMEA&oe=6A183D02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YfbjTb8UrUQ7kNvwEVV_fi&_nc_oc=AdovbBXV2bvmAH7TU2UWth1Ln6D24iAzwu4V7D0Mlc13Sgbql1ssuc8CgBbRjd1ma4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RMydwTk-kb7R9yeu99skUnpk07LKy67RkmTLfnP0Xnw&oe=6A185947"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8spVbUNCQQcQ7kNvwGVvpN4&_nc_oc=Adpc2GQodZlBhfzhapI1JJSQFppPMIJPZ5XywHc9PIO_0kgxR6LBKcFczUIdm30RZ94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xeFKegdaRORQJMSMYqoPAnhSEnx3pA-UdTLhyJEEXjw&oe=6A185625"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5eM14waC6MQ7kNvwFlZ5-L&_nc_oc=AdocLYNeoB_ZZDg-86puzoKUDjw9lWPYgkiSLh6lBkrqSz8ypsP4QS0JX5leHtQp0RQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wpt_IEKh0V5s5rhBf6FGjSZcYh53ZGBNNcz34qXVJ1g&oe=6A183695"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcEf3uG4Bd8Q7kNvwEEbWPU&_nc_oc=AdpKBKci5b6WvMDJdZmqIdDSKiEWl7_-kcNlU1ju7gPKnZJrsXxHo6mieaCt9FArutc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ij4qel_tSsWhGBlDh_nV-mgHCRrybAz_XQRtVOqe8PQ&oe=6A183930"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
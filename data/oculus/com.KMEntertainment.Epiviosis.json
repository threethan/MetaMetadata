0a&_nc_ohc=a2sZcFc9Xb8Q7kNvwGb9OwZ&_nc_oc=AdqH_1_ag-GvtNl-iqcBTefNmawJl5brK4L1ExBkCRALQ2TSdhQIRGKWrc-2NoYhQnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLLMSvQ3fFggmh8r6Dz1N4zMjP5u1SK4ejtu8wc7buDA&oe=6A5CCB02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyqp2ITI2ZAQ7kNvwFAXmMX&_nc_oc=Adrx9XkplUh2a8nEqtWRpLNIFVNVOlV3vG27omR-m2YBZ6TqOX6_UwVlQnsom9TFIPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5zbm5s51Kyj8Mfa11JveTuDEF_f9s2VRRIfsV7a8Kmw&oe=6A5CAF07"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clBHeQZPLeIQ7kNvwEm3Sum&_nc_oc=Adr0NLbd806DefqteKwyhgtjBuKh2Bn-vGnnQ9JjRZEqQRkFPgDTA0SMr6-l6A6ksLY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBud-3xJhC-_ykQzi8M_tWMQm4SZjgXh5MnK9AXQ2AAUA&oe=6A5CE425"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3hlP0edh1QQ7kNvwEhvXEk&_nc_oc=Ado8tnQn5m7gpSWHLlau6pgNp7ZXcvDiAC_JYua2BsYEIanvQtbPo8oG8j66oPfNLdQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCt_MwsUUTSzyXmCShadO7W8crzvUMPqUYsyqJPrl6xA&oe=6A5CC495"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoUrARIYnqcQ7kNvwFsppbm&_nc_oc=AdrX1BCMkEESVY6RF1DpcFMLx-qKVutTfkeA2FEK8OYgKKkFse0S7KBgEKv105jYW9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC359oSYH99tiSp246YVVaRjGCqfoETkHE_pyy3O2ogqA&oe=6A5CC730"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
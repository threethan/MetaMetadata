0a&_nc_ohc=csg99-9_6ikQ7kNvwEp8eT1&_nc_oc=AdpJa_hkyEY7KsRhhznuWxDxcLi6oVxX0Z5CcMsafKZG9uEPR_xJj3BtIVQKSv-X_5U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaXlPIcI6L648aGgKcmSK60rhV4IikTtA_b4XA1GiCkA&oe=6AE34402"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGikNvBzIPwQ7kNvwF_jzDy&_nc_oc=AdpfgL3S4zwA8Lfb8vAGuxDN-DMbYaPGU-UYBT6hMfZZXJi8GY4aThvFsDToUOOOF8U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVB87rhdA-JhmCTZldY2oKr05BHyo7tuIntN2ew2EyWw&oe=6AE36047"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RilUI5I4xuIQ7kNvwGZ56bS&_nc_oc=AdqTlNfbcxUqWe5g8BQXS8cW6JOODlC6Jgv29ZkfJk5dxgzb9ZXksK65QR45sjMvu0Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRdCuBPfrBHA6XGzsf230AdUH1T6ng1v66MT6K6ld9lw&oe=6AE35D25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwFnIuLK7U0Q7kNvwFkhxaW&_nc_oc=AdrmtUnlaYVPxXx-y9o4U3Kcmcx-UN058o43nfyECWmhKXYAzqRTmb0EnjCqtlrgKeQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2xyluTrIXQTDQo6bcS29lE6NCqOjgIwkNxAwl-vs4Lw&oe=6AE33D95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4FiluPet6EQ7kNvwF8snC-&_nc_oc=AdrkvFPtwfw133ngVcCARNaF4rkFMyrdoAjvwA2NEIyhIwRYdkQClJYb-kuvxuLN0So&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHZdtwFXRgBEnRNA4aeKJVGsQSnGkK0Fkl0kiO3N9cPw&oe=6AE34030"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
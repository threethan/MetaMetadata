0a&_nc_ohc=moDJbiZepPwQ7kNvwGIgqIY&_nc_oc=AdqXqpW-u8BklYfGLqEOVUPg_0syJK86SrqoT8ymW2BXu-_Syl-_8ecqhHV-rsvij6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmUuiln12rpf15iHMhifkvZWrBi8BSWV8ihM6u7PuG1w&oe=6AB91402"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yJ0yczq05cQ7kNvwGyhID1&_nc_oc=AdrckIfzrTFsBOyloNNfK_CthgpmTuSJzfZq_RPnsOdg1bTTdJBdhjR9Tx7LZgSK70g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqlAyZSxBsQRUeV_fwGxA7dyhfdHJsgFw7NF9V6ldXTg&oe=6AB93047"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eR55RcL8vMQ7kNvwGbDSi0&_nc_oc=AdrYrhGNQ7g4KV6nhVNd4oGumWjNudksM47vQpxqWSb8K3g10hfVnN0IznlBlisCrhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8gliz5OgxdQIUddNI9tam6pAVfTJZhjJwnEtrl00hdA&oe=6AB92D25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25evBW2j9m4Q7kNvwFoTn4n&_nc_oc=Adp8Q5gxjjJTx2dfoifC42f-nhY1CLL8wvy5Z3tpXxAkN9jznynEJkAeoAFKNDlnAm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7iFrkxrZsTG_FBYHNzHTgeqnsj7bOqFtAqle-yLrGzw&oe=6AB90D95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8lZYpoA1dIQ7kNvwHXp1nT&_nc_oc=AdoP4s4r48VLREo1nhwPjVW5li_KZzORkneXJHordYJhO886OM4iwG5ptJyEx0W3PSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvrKY2bE2EcIx4rA-NpfJVJCsnCsnRIucCtQSI8r6yLg&oe=6AB91030"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
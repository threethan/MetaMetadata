0a&_nc_ohc=q2U4BD1z2ekQ7kNvwGS4Ggz&_nc_oc=AdoCvwDFSP1D8WeaD61Z8UR8zf4aUD7FfW3OQ-BUcZwwkwWFYwJr7aigfASxI3x3pW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHkMlh5hmdjBG8Hk_QxUZUUR_Zt-LfLe_JCGXXe3iAkg&oe=6A5B7982"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlSxHi06bsoQ7kNvwHexytz&_nc_oc=AdopoWwDWtJeG5Z1HbuM0iVbuyHsdi08Kjva95uomDovIqTNhQDIl_ZMFYHLg8KCNA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzbjuo_7ABNiZOe5eGjKbGmCHx2xVJBuX1UMH2IAz3zQ&oe=6A5B5D87"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhw7ldQv3p4Q7kNvwF9rFts&_nc_oc=Adruqazzgrce2Js7qq88nQq6iGEfKhaIpaqEe5e5aiwgcdTmw0G1VEd9zbEUR66882Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrHbKfaq7LjIRtReBFWvG26Xy9zfB_FRMV6Sl_m6SHPw&oe=6A5B92A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3hlP0edh1QQ7kNvwGNMOL2&_nc_oc=Ado0iA2q6icjSIrDrfS7LWHvvnZ6tsY6zXwHDQFdvLCTiyQZcX5Y2ItG80n98TQ6qCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_PMDPCdEypfEsGuoI8cVrx-fddBNY22Fo0oWRQ9B63A&oe=6A5B7315"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoUrARIYnqcQ7kNvwHGda1P&_nc_oc=AdqN6xBZvz30_63RCh5RbAT8zY9CXoENoczrIa-VMkq3VMg_DLIzpyprvNJO2dzpfRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1n9gBlF_t5HhByLFDTNiAj7V4N0L5_7HkflL8FNtlQA&oe=6A5B75B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=bDbBy6wNE_0Q7kNvwFEvH2s&_nc_oc=AdonTE-wXBvxNtcOkEdzjJ_1mVJPGM8v_KpKEaupKVo_2RHSi8TUsPkIQ16XEzfI1K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MAaEcsIvPRn9QxKwCUN0xL_YIMVz3q1B9XP7q8ahDTA&oe=6A05C802"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SC7pXc-OiuIQ7kNvwEpc2m7&_nc_oc=AdoSrlRiM2sppKqaszUV5MQmWZIQu49ey0_SvYEamFVzTYb3nKdvj4Zg8e67SkjNsXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hlCDIRUrNWIm7fa6Or-ZVlgiIwLmW3z_wog9Y5xjNWw&oe=6A05E447"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqZ_Jm5osIgQ7kNvwFOOeV9&_nc_oc=AdoPKtc8Z48LBzqlQTTZjsAawZBEUCDGlk5wkcTNQhTB0U4CRswshKQouwLO_mILZoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pgaTYYvQpPKrxk4y1gkK1dNwW050aVvltThG-rhXJCA&oe=6A05E125"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wtOxKS-mw0Q7kNvwENgSnh&_nc_oc=AdqiobXbrtGzFWy79cxAbnzE9PxyNJuj7fcnNflCirro0vG_1epTIL0JfPKaXl9LIk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56rxVibUK3wr-x7RBITGG5jUuKAHMlUgoNSnUYZcG7Zw&oe=6A05C195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igCt4we2j3gQ7kNvwHESLKl&_nc_oc=AdrJBojJz7A9EEFPpRrKDmHMEE2OhH0S8qTGU4adk-48gHaEyAIrECcuBfTYnT8N6yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MA_pMrCz4_LQMe8_Q1yWFDYahXFAVZGWVl5jchlLlxg&oe=6A05C430"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
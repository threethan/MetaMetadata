0a&_nc_ohc=gMNgwSCD9UwQ7kNvwHy_OsG&_nc_oc=Adp_a7r235eA78o8mkA5JyAJI5ikMFBJ40TzfKJCic1zuceVm538BWYlBuZm51UwVZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7vU-yzHXvFTcst8roE6_yJLXjxANNUQ6SoSG8BRH-Lg&oe=69CD1782"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxZQ8YvkHmsQ7kNvwH868Ea&_nc_oc=Adqf0l7tUWdTIYBMzPRtx9CEpbq6ccRJlcKVmgeUx9zd5eT7hx2QMIlFhgKN5oPlpbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfweGjJt2K6P9Eq3ZDbyA8ocXT8UTF7IkKJWyKbYX7Fd-g&oe=69CCFB87"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYERHlLWBa8Q7kNvwFFdcbV&_nc_oc=AdpMOkQm2ObmsM3ymsFQUfBR1cFbcowMbf0Ee4DYqd20xWpbOPmQ3atJer1nFiGoQ7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzpi8sDYpUUZdMDLS9WTQW92sqGYYkj8P3q4G4dhyiprw&oe=69CD30A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7dcSlJ0y7UQ7kNvwGmHBnw&_nc_oc=AdqjcVz55bpZ7SGUM5K1l3WEraNEjHqmGpNHk35pVFiCV8NDdE8KvCmpJE9DGDTl-cY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjUhgowiG49EwTo7PYEc8ML3yHCTnJEX4v4XxmuLcWWA&oe=69CD1115"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5aFlaKpAjsQ7kNvwGGuX4j&_nc_oc=Adpe89pUmolkcJGL1qSJ4v_NmRbL9c_Im9OZlxFm7btIZdSxRJVFMAwqAZSK3UvZ_bw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxS--SjORFbWOQimqUo19JCMNdAqCOe-Tn1gd2MLpYdyw&oe=69CD13B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=HtSKUOT-dFwQ7kNvwFYzNXA&_nc_oc=Adpo3ScbHl9huErFiqNad2IVqo-51VoXJyMdivyV0Sv1Siq3sVG-krSEy4d1H5Y384s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyrVWccJYzIKEi8nhc7E8Dic0oZH5Cext0fkNxCqAiYg&oe=6AEE0842"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9fMGB-8KTcQ7kNvwEw6Gig&_nc_oc=Adp6Ziv5ycr1kIOzjX7Jh56gX7e1r2NESwwtTXnUnobHYXYsKKB_OmtNH389sC-8wq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyZv70-N-Cm3VidxUZtyFkWvIy31WB1H_1VMup7ZVNRg&oe=6AEDEC47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3frPTIassMQ7kNvwF_pnH-&_nc_oc=Adrlobi5eZtX-t0zf4hcBsKMxEqcPvhGUlQbdOrBgUtbdR_iH_cgGcD2KfKdOfvcAck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe8TspgfMMvyVR9_fw0Wkd5KejygH7_3ZaaJb8GDFgnw&oe=6AEDE925"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcB4VXsCrkkQ7kNvwGbrmfB&_nc_oc=Adp30voc0yzWe0TXrvaQ02nMqXuy17LoTgQZ5XwSmVGZ5xTpDv_SaWemgzzGVBSotSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjmDRi8mYPOcsy-b-ds06papIV1BZD2pLN2ANJaBduzg&oe=6AEE01D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feHf9VBbWB8Q7kNvwGe8-0e&_nc_oc=AdoxOon8I2booHIeVVjYT_Jh8MgED1bYgnVjLMCYjLN6J5RY6rLlrMaHMc5q8Oo9CjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbKO6Wiqm7GjPv7s5rcMVzn-3rSd9lcuObjTdIqk2EIQ&oe=6AEE0470"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
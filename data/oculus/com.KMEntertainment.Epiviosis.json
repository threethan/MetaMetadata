vm&_nc_oc=AdlZlHVcmib5Wsp-YcP_9Hmn7LCNJPObwfT2yZw8iJAy3TtC_m_7s3ZLnI3ENduRHVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxahRnvExJfqfHWM6BCWEfXfgvazjQ-7npS4erS-wALzw&oe=69B7FF82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmPbfs8tSh4Q7kNvwHzqrdv&_nc_oc=Adk8BZBOjV6LsUfGtgSLomSLgpaSEEPpzNmg9YW28RF0ZvOLpOSyu9ECv1bfY6rlH2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2GGnuzQXD5yIvbse1Heia2iF3-jYRJ2ambaa2N-BjNQ&oe=69B7E387"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0VpUqK6C5QQ7kNvwE7aAsB&_nc_oc=AdlYfc7hro4ZtpMxPaZvAMcbV27f9aXTzpRnTyfZXSpO3rTyNfF57L00_Xtd29Q7tuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyg4WsdEsDcjOhcT9n3xHYac5-ILoh5BNShxUj3lsVIfQ&oe=69B7E065"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9QnInuCFTMQ7kNvwFLX0st&_nc_oc=AdnMLNs_Td5hydmywZSKKOJlRwLpnHKYsGLFX8xOgxuZKLqFH3x9_kJxdXG7NeJNV8U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxaXSt51hfiTgjm6fIAViWpcphDSg0UpOjHJ0yAElXS8Q&oe=69B7F915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEl0VZ10dkEQ7kNvwEHV_S5&_nc_oc=Adk0HYfDTBLGSJmYhj9GoYuk_j-Ltzfr1sxr1_RYdw8nBLBN3KXzH1dEagLSyAPYrsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh3vWlXamdCq-vcJSUKHSrxkK6ItZujmkjmt9E2xGkzQ&oe=69B7FBB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCA
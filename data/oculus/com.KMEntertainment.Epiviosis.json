0a&_nc_ohc=bywP05G6Sr4Q7kNvwHD26Fe&_nc_oc=AdpfV1W4E0WBS3sUFS7c98_uWI9lLFQYli4wkk_DoOto5dIS4IMKEJHFjmFpjB5h9rM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGgiUOTlkFkJLB32i3tj-16NJLdKwOOTsm-kirGZIuzg&oe=6AAA9382"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtPfrPj9ZTgQ7kNvwHowFPa&_nc_oc=AdpsOmuuUGxw3g3ENFHEzfiMjHPwOSfHtBRPB4_-VWkGdMtU0n8Py4yfuhZrPqiUuMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK542BlEErE1ShTLG4-9x8_jkGpScYkvtdWxoq_dgbSSA&oe=6AAAAFC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou2nR8sf_6YQ7kNvwHeHW9x&_nc_oc=AdohF2RrYZIwzgOQrBfckIzRnfJ-c9VeHQYRSdKw_0uTmT1YOCX_AA-s6VwFdU1-vTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIswT7vh6W9kRQ7ciKRIMjbhZ4tXchotSRD1VF5YIlszQ&oe=6AAAACA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSzKZpMoMPsQ7kNvwHOq-4b&_nc_oc=AdpQU2yvAerFOt53Ho0pxwvqZkW5reHzDjZwZ5yQp5m_y2-7OmNtteEqLFyb7NUC5lQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHyg0oiYjuOb6ld8IkKVGGcGZXKjl18wUbg3yccoj3wg&oe=6AAA8D15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYoC2PrS3l4Q7kNvwH4ceOT&_nc_oc=AdrvxEdKbU3tX2HksoTsiUdj348A9xs6ojvye523pUjaRRI5CmspHlTemzrLXF-nx6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnbrFj-vafiYZ6GS3YIYXPKBDJb8f--9A3bZF4yjP7-w&oe=6AAA8FB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
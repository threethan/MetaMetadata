0a&_nc_ohc=moDJbiZepPwQ7kNvwG6ZKgb&_nc_oc=AdpXyILALJ2zU43sJms-vvxIbplrnd6rxZ6lzoxkRW7aFZBaZiXrHjGqpcRw9BpMctE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp3OkUXlxxMsI9WexN44v1Ms2bw7tfUqFGYDBZEQ3Zxw&oe=6ABA6582"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yJ0yczq05cQ7kNvwFoctYG&_nc_oc=AdogrpExgiKA3zYRcjAN3N1pxFFj76aNxG1PhNT2mo02PbEkHz6NqJXzzemr5CsiRyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOjoWYFH9jV89JGbKRLM3Ay1aDiA8K51nEcipimOtmHg&oe=6ABA81C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eR55RcL8vMQ7kNvwFse74o&_nc_oc=Adrny2HHCFkfliLKKyVf99yGTmgN6aL53W6qd8zgBS045dqj6Vaavp6yTHSiw9RpLSQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6TsZ-txZQsf09XsNXrXRyv12WNvaPkNsOdIJTWn8pqw&oe=6ABA7EA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25evBW2j9m4Q7kNvwGBMmfm&_nc_oc=AdoqzQF-RCNyhBRT5YMuf4evqqiiOjtzCJ52VerPzyefJ5s0PxeQHthQ8wqY5CrH-20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI05NO_IvzJJ5NX-ZajRRoAWMBinhvCL8J8zFx3pXgV9A&oe=6ABA5F15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8lZYpoA1dIQ7kNvwE0XRcW&_nc_oc=AdqNdbfquA2YGSOZI-dDed7WIMhvoMMnUbSIhDmUhcbK-4exxK2s5B0aVCaAmjPrqyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYpZ1ubS2C6mYxpY4-9QhZycnohDJaOfqO5GfeWKVMIw&oe=6ABA61B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
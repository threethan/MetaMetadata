0a&_nc_ohc=zPSuvmdAgXEQ7kNvwFAEE2l&_nc_oc=Adrl8vFsW4GMQcgOgFAd7MazvwaG-NuKbAhUPE3SrgDG3RCEdkmcR93LpetmOov6ufA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4iA0aG8utwWESyE-tlFTVXYMfPmDMyKwlIqnXgZ6gBA&oe=6A539082"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMZ_-oe3L4gQ7kNvwHIxlbO&_nc_oc=AdqNugKTwTVbfkPtVo1Cd2HcwhL83DdmxItbN7Lusg5EaS3EvDCGMNKJ1qpL3SDY_Jo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAXcqFafQYjMzUXJdgif48o8mhAyj_ZtHA3eZXGCU8Ig&oe=6A53ACC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la5lFqI_oogQ7kNvwFhCjTJ&_nc_oc=Adro3x24wm-cGloeg1_4c3yye5aRj88T9ayNbCPXaMBipr3wqhc2D5LsMV_ZYbxIHHY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTV-gYO060EupKQPNbREOKZQBLVZ-QJPCafSJxTLsCQg&oe=6A53A9A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39eSxj-3fBIQ7kNvwGjgkj4&_nc_oc=Ado414y6vzq_9EZF1wj59iJd8gCx8wqz1OYKdvFCP60IONMvUV0LmI4hTH-Fa8vu1lw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaWdsyWJqI8jKZvld8uAWca3kTC0i6z9j8HIAcloXOtw&oe=6A538A15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lAb2BkWX4kQ7kNvwEWezmr&_nc_oc=AdpXsJBXHvMLUVCIksQ7Cqo5ulyagDJeGK94LrxydxvXLApoROeLDtuajwIWJpkavfQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIXgsNQ7hT6bIO8GLKLMw602c2J4ZnlE1rQhwShqUxRg&oe=6A538CB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
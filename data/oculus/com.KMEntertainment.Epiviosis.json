0a&_nc_ohc=9Ux7a3_UISQQ7kNvwH30-q_&_nc_oc=AdppOT0tIYmUK0dKgZUUHj7lkjR6onoYx_fGxAlOzlXW0LrVPzGW9xkC2_bR5e_JDHA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1L7oTC6gC3bZ5VOwywmvXkjv1XF2wD_n_vZ_JwwXhv1Q&oe=69F35302"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_rVVxAeZMsQ7kNvwGAufBc&_nc_oc=AdrrA8gy_C7IgWniRnYeASBl5naSamHwjCAw7ocTxP1t68AoUGVHL-pelBIKCSkqC_0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19GVvAzH2xK37IUeFD7Jdka5kkndy1rr_ZhgKk5jMl0A&oe=69F36F47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSR0Fef6CTAQ7kNvwF7N6YC&_nc_oc=Adpkz0rcb0WLnKnBCtsiP0UA3F4Ky63stW3IkDGyjZfeiAFzO7yARbs3zneAoVuaLOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eogj6BPgWBgs1y2gDMw_Wx3VMgmZK5D7h47vZrV9XCg&oe=69F36C25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrCsI5U4S7AQ7kNvwF-DjIL&_nc_oc=AdpN3qMG5XdfareloOriNLtJjZZZ3pVMEtcE2HJGnsBVauWQkKw-tUrziDehTwzs6aU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dN5SxwyW0wjm6Ttq-6ljvfGwI-SCpV9f5pMGaoEbccA&oe=69F34C95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv2fImjhSsoQ7kNvwHgP0uW&_nc_oc=Adr3HFoElczf4Fbj7QWJa1IWqWbYQss2AG5FuZ7UL_oA4lIrVXYMwUKwUkCeZG9C3b4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YNYWzaxNNzd1PF6P01T0Ar5FT09XA8bRkbHuldxOAAQ&oe=69F34F30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
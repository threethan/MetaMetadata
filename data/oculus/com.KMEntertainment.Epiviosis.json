Z6&_nc_oc=AdkKTkF-2fVSx2AkkHRaoeIn7esnORJJJT0I_KaCd9-SWeKuwLuxYvYTpfFVSG0MwJg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEr2UixYblVO1VM0WnzX7PbI5u0C5zqBWtOcOTsn1Ecw&oe=69B16802"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6G--xskeDzYQ7kNvwEhP5Py&_nc_oc=AdnPzCer7waYvS52ggJe-6LxJo6xdJ1EYmH0zgBuJHxKBo1mgsIbfDQKKIO4oiJKLtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcmPCWDbFX9bZm_YOzRIrEa6CRXbyA4Py8i5gve5M1ZA&oe=69B14C07"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m76tSZQod8QQ7kNvwF5NMHU&_nc_oc=AdnDNVszqlIhOhxAp7cPTl2Dew8T668IhDcSWiEsVFOkZq0_2UPiRsqsbgU72q-Bqgk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxryU7lJtudXg8JUASSMb4CcmFIqzvDCE7Uedq0vHwzOg&oe=69B148E5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgkuRsdWa-YQ7kNvwFW6hMh&_nc_oc=Adk2IIb42inVxnZka-iNRuFTfcwQZ-b-Nb4DCf0RINrlATfHjOfcJkadAO16NeKp9no&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyB0na7oZhyoFx7yYARRGpKiVEv-TSPnUXF4D62zrt4pQ&oe=69B16195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZignrRCfn0Q7kNvwGKV1sF&_nc_oc=Adk984ZPzFFnCFnr86KmUrTzOh89mnx-66Zc8SrQy3NlehR9ZMYdi8fAkOdS2Xj1pJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyntEnL6bJtxzgraT0AmfYHmh-_zrRPTfdVO0c5eNn8Tw&oe=69B16430"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCA
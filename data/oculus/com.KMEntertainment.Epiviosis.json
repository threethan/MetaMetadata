0a&_nc_ohc=T43IMwX163wQ7kNvwElYWgJ&_nc_oc=AdqKE_ohGgVdg1xK10ZlFvmg3xU-1BnAG-o6XcF93zK2QNEQn_GVifQ5alXzgEfnaZM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lmLb5LinlLci-ESO5XHQKxX_-dV_bUUqEHQp8XIEW9A&oe=69EF5E82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpjt-TuNuCYQ7kNvwEkxU6l&_nc_oc=AdrkIkLzbGmFW3PbivKIh3ROuT1vJ2Q-aacyxMYLjj12oEejaEteFElLySsTOScxBjA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00Xndcc9aGLUHI3j5yT7zq3tG3xRiAd4SfJLuUC2FfHA&oe=69EF7AC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1Pduq6Uie8Q7kNvwFmvzdo&_nc_oc=AdpGB-_mrlFG4ghKvuR3s66ZVBwPqqUF1wxicnv2V4AbAjwQlMKouVgyg0YbQyDkN_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ykalQj1uowQPqQzUYVS5roVoExayc7I9yKD5j4jQrOg&oe=69EF77A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCh95RgPdTYQ7kNvwFeJGhD&_nc_oc=AdqHLvei14LIY838J27Xpdu5ETaKFzAZJzy08ZFV9NvXtbhv48NQq6o_MKnEkSy8FYw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pzZZJZuSAR0R9sZI6462LXutolVeNtNnOJSz-HgYJ7A&oe=69EF5815"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKcnDpzoMCIQ7kNvwHdWxhg&_nc_oc=AdoPNKdNOw3bc_XPX3Fa7Mo3tnUQuxbZiQmJp0Gnx9e544Vxae39v30EAYdInvil9Ow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Jpz9uKMJ9KMykF1gjRY4Mz2PnTClxnSFXbST61VTGtg&oe=69EF5AB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
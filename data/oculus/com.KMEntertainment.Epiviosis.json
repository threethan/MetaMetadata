0a&_nc_ohc=cyvNTGLEkhsQ7kNvwGW5dGb&_nc_oc=AdrX_G_9m9vRQcN-S4t1mtEYEuIYOniWSplcY-t7NCLNRTl5B9fftvCQmcMVeWCmCYw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ok53KRA-qzJ0hYiNzsb_VsNiJN_S3rptdToym3FEozg&oe=6A1C3182"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4l6D8DM87sQ7kNvwFfWNi0&_nc_oc=AdpS4lOmosXAHRZK2OPgceB87FQ_W5v5zCBYplcpIOvYM74jMeWYI-BQ0uDQbZ8ZxU0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YZ6zm5sEtg3PhV4Agvvkd5p3TLYZd49TAlOB8T0bb_Q&oe=6A1C4DC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q8IMbO8P9gQ7kNvwFEzoli&_nc_oc=Adp62mVejSah1eQSS6wSPx0P1SYw0qh7haO4mnovuOsz_9gXLUdes4-M-WG6e7_DKdI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LN3WqweGIAOqxdLLqadE18hy3hGT2phEGiZUAVC3hww&oe=6A1C4AA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6-dW8fbf8kQ7kNvwF_54Zi&_nc_oc=Adqh64muvMOFZqrw8O2l1o-TKhMBYdFLM_AJlNNHfVOiF_3_vjsKU9b3hlgFw2q8MNk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fe_ezf4F5_quL7Mz2Y-kl-cm1b-0BbmLkgK_kYxAraQ&oe=6A1C6355"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LLawBwDcxwQ7kNvwGOW94S&_nc_oc=AdraYurJKT9n2my6NYhOI7_sqonZrUkpxzw0jd2_9Ak8lmORigX1sHIeMWvfPMW1SzQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-_xCQeyvZSinXP_2FkNP0Q1l_bkxmsDmPGDkTd21QmA&oe=6A1C2DB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
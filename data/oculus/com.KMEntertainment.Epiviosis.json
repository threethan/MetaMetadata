0a&_nc_ohc=5PasNscTlnsQ7kNvwFGCoga&_nc_oc=AdopwBiOqXSieY9bPlQr7AJWaFDfWVF-n7Na7nezRC1bgqbBJAGjd_WARdE2pNp0Asw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOx2TI6Xt5U_vxOtgvuoK8Oz27u3LFSHhPxVEKzZVIyQ&oe=6ABD0882"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEEPmOIQ9dcQ7kNvwEeq07S&_nc_oc=AdpejRuod2gxG24aacJMB80ltfPSxgJsorycIv3gOiedC6lgMxtUD7w-vBQ7FDSC8pY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoZnVCz0vZVWExqLyZtjWrrUcELXhxX97SSRxk8Kthgw&oe=6ABD24C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvfgUkZz1UEQ7kNvwFzBms7&_nc_oc=AdrRNsVbkunTS4QqP9H3aIZHqB05DLkiVfhH0RQGpRauURT3BgCVM4fRIPmDd_17sqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd2g3DR9IQ8U1KESMY6FWGzhvmGlYuNyrQK6iGzREgDg&oe=6ABD21A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLuRGxPP97YQ7kNvwEzz433&_nc_oc=Adqq8ItbeRdllKEo3u587lsBWXdURRaMYoen_MmWR8zcAC6v5MiEblT5Mjx-YZQQ6ao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQQZPePdlhzlKbMLlWBzPMh40v2lCl8RGYUYanMESB2g&oe=6ABD0215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d7i4-_yBDkQ7kNvwGMtBG5&_nc_oc=AdpMCcnKVTRbiv4SmBohEWlunObGZ93lsoRXZGmcgpbftf3SOb98jBu13Y9y2w4BCJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUzyEKO42BSs1HLSxN7WC7zWY9C1qrpRRJ_A5ncigQJQ&oe=6ABD04B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=2HmBb4JZYE0Q7kNvwGSV6rv&_nc_oc=Adqvm2NlxF0VJ3SCPR30sGPUOPa8fmdKvTn5u2SpiW0Ao-X0qrVxMxTLo-fe8Nz_zhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMNJ3xFQrt_0rana33wZ6kcvvLdgOMvsG_WnApYo1Wtg&oe=6A60BF82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gcg4zF96-8Q7kNvwGwXj0i&_nc_oc=AdrMs3vq_PrhRU5P1i1u2xMm9wjmXAMCv6PqOtAuTkF3-m3Y6yF2IhOjZ94Y9OuFc4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1ABkrE0Q5wOkKrb6M5NeVe3XA4GhHx8bzQby1aKeqpQ&oe=6A60A387"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-8lYR7jKCgQ7kNvwGVbt6o&_nc_oc=Adrq66YWH5jPZfnvKhTCMOsOaYvfDoQt32dupP3QqWVOHDpI-7u6l3TaDrZNdLiik1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASYSVgp1TCiBNbU33QlXhUkyExdZ2JSjgHTwTxfFwgog&oe=6A60D8A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gD-xPII8UYQ7kNvwHrtvIw&_nc_oc=AdpPrbhYXz6ffuHbaCMpGx54q64lm1x6ptFdgOWHujb2spgdxs6k8xaoo0E-TOIJSeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA97pzEJtiYMDguHRuuAw87avSs_GcbfxEfCou6QqXZXw&oe=6A60B915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQKwSwloZsAQ7kNvwHq5p_y&_nc_oc=AdrM0ZvjMgEisaWMq8aiYbic2fNfvhuv9zmMeGU1kN6yTyXBTCjokckzodSZBcQUcqg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwEiKwWEXhpRbUCvtRela3MDMFWT6Rz-30bfMiii9oVA&oe=6A60BBB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
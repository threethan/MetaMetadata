0a&_nc_ohc=PUjkNqNDw6oQ7kNvwGJX2CC&_nc_oc=AdpTaMqTuU9-5WskYTjHV_E1cX5xS5r7QcmK0IAcOegIg4QALYZ32b06yRB-S2DFsPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zlfq07pRaw-B1Hs17sxtS4BmwzH5BQCjyh_EBySdoCg&oe=6A426D02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMtaWmVHOSQQ7kNvwFgUYxw&_nc_oc=AdpwT49cu28Bfb64uM7bzliCeQF_zhKLZVBX8gY51BIwM9NFcwcmE1Hs5czHMGfn1zM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LEksB2sndMX9SbS7mwfODsOezDlh0M0SySmXsGhB13w&oe=6A428947"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i31x0S88tZgQ7kNvwGqIcgu&_nc_oc=Adr4rPTHOL_SCWft0MLiIMTn74p3PslUzKqxRtpogfY9raOo-OG8_bmm_-DGqzszS0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D9aifqlP8xHu3F_IlmwcwcadUMrUTpOf28ym3Z5RuFQ&oe=6A428625"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmRmZlO8eAgQ7kNvwF1ohpL&_nc_oc=AdqBW1STlRKAvzHUym7_4j7muhYmotUG2F6AUeRLvVZH4PN8-4TP5rBiPJTI4Gs-MM0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qbnrk0QtYfqTOBegVNc3fdBmdsq35P4Un633qBOhEjg&oe=6A426695"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O51mTsJAliYQ7kNvwHst-gn&_nc_oc=Adog-1gYQYCvjyR2MfuMNySiqMybUnJOxoAZ69Rj_CiRVkIpFjG7R6BeqXhmRiU2LtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xjAw9fVUxZ3pMGFVLpXE4gqhFQA7-8FghcvYPx5rbMg&oe=6A426930"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
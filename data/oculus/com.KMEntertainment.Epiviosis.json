0a&_nc_ohc=GfN8mDkGshcQ7kNvwGajnin&_nc_oc=AdpzPWb2UarvkxuX-RtgnQvfqR-aV2OC07XCmbouOwuYn_7iLwreBofk67e8h588joc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbepsAGUHfFT4h6CrHFocpoZCqcHg52KvSbGOqIEEH6A&oe=6A9EB602"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfW5HO75-LAQ7kNvwFNW55C&_nc_oc=AdoGMLiI1LzjUlLJF2fpx9_5eaAbZoazQ8z_Ji89KCDYdoytDhzDLPApBCCH8mHppYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8zOmT4CGzL6XbyfMz1IkeHgo6VlXnBpLEMyp8LDqg-Q&oe=6A9ED247"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3COjX-w5ZIQ7kNvwFZ8OIC&_nc_oc=Adp_vlEd8BpsAIYJct8TPoo3gnzw4RvZpi4SiakmFwOVvalZrOwcR4fD3NR04wUbGvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJO9SNyTty6MC6TXQbHLbTYaXqdjCWC8Tnh7R-SXNSyw&oe=6A9ECF25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4I6qREC9qwQ7kNvwEPsCRu&_nc_oc=AdqV-fibHlytzkX8DhHH8UNrAihO-k8AS71wvkzfDGVSuHag_AjMfeh85Ro90zLkPi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0srF3QWXCf4YEZG7ANPDTlnCTWXaCw5hFOiid0gV9yg&oe=6A9EAF95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUL6iCDq_m4Q7kNvwERp_4F&_nc_oc=AdoQdvSSds4we_t-cLnLYCoyzEYR7WNYHDsyxp0xBOo56OYMxCqLPhGUSwfwXs_9Gwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI2q1RDb1elAa9W3Oh5rv8HjfHoj45-tNXjzLoXlDbRg&oe=6A9EB230"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
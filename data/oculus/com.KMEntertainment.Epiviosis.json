0a&_nc_ohc=lCeVR203Q9kQ7kNvwEDUMXB&_nc_oc=AdqZ_MLSgbQ3ekjS7eCDiheHW0tkA8w1yBL-QkFAkbqXTHKsfJaW15f-LS46WLlQNkE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkkhM6pMhj3bhXqMCl_yHT6nrNGq_sFimOTNz0PJy4WQ&oe=6A884C82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ9cx3-k0fcQ7kNvwEEgMq5&_nc_oc=AdpIYWFJAdB3MiPfnzdeQx7skPkFUcyJowv3o69efTjFa4k__pcU-iX6WN1BEaFzkeM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3TQSv1ld6pzujjvF99_me4abFRKdZz3lfVMdQI-ey0A&oe=6A883087"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2V8iL5xvdMQ7kNvwGMNS0Z&_nc_oc=AdpUXXhtiL99rWYgrl7UrsDRDsp7OaJbB1MXChesd9ggwcf9vd47D7of2pLzRjCKS-I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi3VWstXKqvPZYGQR8nIPBKiZbqrFIpWz_W3beI3hDPA&oe=6A882D65"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_oeRRrROoAQ7kNvwFXowRf&_nc_oc=Adrl4erGsqAX0GwdOhnUIlQJdXq1Gi216-wody9rn1LbObVJxAoZSjM90qd-D-ggo7k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2PAFgzuU7Ce8_Vw7VAVrQExULweLGkhKhqjPCWvCBzw&oe=6A884615"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLD7de0fGSoQ7kNvwGpJe7p&_nc_oc=AdpmmTxz2yfQT9uBS6P7jWl5qazS1lU7CEDLqVPFsZ-KdtJpbp7fu4_6s3KHGBNsrZA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Th0VHHPyUtUhaCbZvPyasbUuFTkzQ-yYo7uaJnNcmw&oe=6A8848B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
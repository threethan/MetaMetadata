0a&_nc_ohc=RBxthkyxTHoQ7kNvwEChgT6&_nc_oc=Adporr_imn0rOkgGtPQ_h-4cFUJUNn7cHtmx0_Vw2Di-N6I894ptVVOu8rh_GDPsawI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C4NQuMeP3hxzvr79JDshCdmJmqJe1B2nSz3tYkbXKiQ&oe=69EA1882"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZzR_FFdCEgQ7kNvwH-WvG3&_nc_oc=AdqO6gUL_nbmRUCkUynjM95LE75a8sWV2ytsYqKfwKcWZmt2yD32QANFLG7UjJHIZcM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kXiXHQ0329ciDTIlm0Dx09XkfRGJSptq6SNH_vX5_TA&oe=69EA34C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChPl1TpdMeEQ7kNvwFO4c1Z&_nc_oc=AdqiQnBgA9QrMcFFKdHbxPxB7r-IvCQMLsAhcZwg6sYstXSJFUSpowYsehGy2toNSiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZcuV8h8qXt5oTE2z72n5Ye82y9GaH_tVMEyfyZ5NU8A&oe=69EA31A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMZQANniH8IQ7kNvwEu_wAB&_nc_oc=Adpm2VNt9EbKobF4m7-p8eO-wAuusjcaft8ecBNJn139Z73Shnt0nPRZ1UV-4As40qg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ot9XG5ob9r0NhzbDpmIJ0kZioBgLmzbb2au7jgzKfXw&oe=69EA1215"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHwWR7BTyYEQ7kNvwFhEQ6p&_nc_oc=AdrQnKtmJdU11jbN3gOPuZxDyJAEHgJZ6jHiUidhBvBVIzH1udEsGDYX-8VR-aF8o24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IPp1W7QKphQm4djLTphXEZaJGu8VrkaC2UxmSSHbfDQ&oe=69EA14B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
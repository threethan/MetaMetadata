0a&_nc_ohc=r_dGvDlz4IcQ7kNvwGxsool&_nc_oc=AdqHq6GsS9d35IKSYPkFW1aoKoFq2AFtd1KCKEKC8hqvECQ52WWfWD7QocjQHpOuCMc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFxp0D705eBPSx8XUDIcdsLbVRhin0mOk5IOqtv5ddmw&oe=6AB67102"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnP1DfXES4EQ7kNvwGX81fD&_nc_oc=AdqYGMNMKxa22JBDXw96qxoHRoNeFIJOn-gZhAKIj1TWZj0sQFSpY62DoIE_Dr0lQUE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK5odGxbacHa8QDPHn1kx70OhM6MYXRtk3Zds6ViVsjg&oe=6AB68D47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxTTN7SebygQ7kNvwEbWioi&_nc_oc=AdpeVBrDrKQmY9vO5n8iOQt-GPrf7aKFhzpTiT5zlqw5FtBsv6N8exmVccsybBGD5wc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOnZbgWv1TfYobBKttRY8NKfMT_-QKoaI774ZmplDL2A&oe=6AB68A25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZeQ_Uae-fMQ7kNvwHSL1xW&_nc_oc=AdouF4htL1Cgzwqe-O3bRKl11sK8VDU45nu8IUuO5AV1HQx0uJX1hysQAmDj7nSUmaI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJil-5F-W25wx1tpf7vRRJfSuCAtgQVuQl2SCAc0PwYQA&oe=6AB66A95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZWfK_im6RoQ7kNvwG0-NxU&_nc_oc=AdrS4bNVUOJGRpZBhA-pIqQwGOXbzKnsFYVjUbp4GIeR2T2k0KjA7kK5H3kPEOA6uIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuY5UGyyuP3bbdZYYUGQtBpO6OXGNFtG2B5hFdI6PQPw&oe=6AB66D30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
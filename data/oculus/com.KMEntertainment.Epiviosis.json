0a&_nc_ohc=zPSuvmdAgXEQ7kNvwHbpi3N&_nc_oc=Adok_nYr2wbIycvOAcDjBs_WccCw3YHjHyg0iMCr5rwbxuEpr5ssBNKLDltegVBTvfQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWdZZl3epGORu2Oh-8-j1lxU6rZdoxy0bvjZWVTb_H0A&oe=6A523F02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMZ_-oe3L4gQ7kNvwFGDRaW&_nc_oc=Adpwp34734OoIpdmYEvlAQ4xEUfjhsLHSkV7iiPrn7QGtmVAVT2FFJE1wb1-OuDrAyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaV7r5mSRjJLUjUX2sgHMV_c95rJQmOQE0r35apHUMtA&oe=6A525B47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la5lFqI_oogQ7kNvwFDgIKU&_nc_oc=Adq-zNv-jmzkBduvHpa9gx7u0x28BPjLmlAPFiaqz2kwX1Btxne0DvGPzLznCOnhWbc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC2eaX9mviw-R6Qua-Ar_xgsFZHr3nW5LGqN5IunzsKw&oe=6A525825"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39eSxj-3fBIQ7kNvwEr0wQc&_nc_oc=AdqAmSGfBRC-tKHi3i2v8Gftl0TSkYXPPdACCDqla2KBOOS7GfF1eZRGKu7YOODQxoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMdNh2WLl_Cfp_9apK7mtNJKgSIiMKWO-m27eqwuHLqg&oe=6A523895"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lAb2BkWX4kQ7kNvwHgr-US&_nc_oc=AdpIPpmisMVQF244xOHKDLuCgCxFubVJdUx-zg_jGT4-2vyLMPhWav4O5TOX729fa1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEDfE4J18GgJ3LAELOwHy5LwCRq3LJ_mo6_XatBD4l-A&oe=6A523B30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
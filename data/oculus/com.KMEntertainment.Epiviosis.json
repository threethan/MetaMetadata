0a&_nc_ohc=q2U4BD1z2ekQ7kNvwHgHtDU&_nc_oc=AdpG3mW1sFkxh2FdUGoU0BdlW1MEHz5rhblMUZ1OgRVu6kq1le-WFJNT6wM08tnCLQE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgzMyV4djETDoyPGdST9yE7Q1rFgCnw6pOu_yOke-S6A&oe=6A58D682"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlSxHi06bsoQ7kNvwF0V6Pf&_nc_oc=AdrgCYbKG-UfReZCUduK9wDrk60N38toUWo5FY45oshqbOeJvHTc5TEgW3XVGtjGtbs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrpPMXV107GqEkefObkYQCK1ZNB8bxReZXnt5xuBQQ7A&oe=6A58F2C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhw7ldQv3p4Q7kNvwEtOJTN&_nc_oc=AdradfCMrteBumGBHW723e3oUCN0hO4oTV_i3pYR-VLIUjv5ZwfIByIhzbJJ4YdUR-A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhjOLEhAGcC0RBCvJrPDR41Qx_D1mkKjRMOvBq5RDIXw&oe=6A58EFA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGM9KgrPDv0Q7kNvwFtFNI8&_nc_oc=AdrrizBkj4z-GaymGXObdvkAsewUFhQNR_but5ufhoq9yi7eo3dqYen6_zwk1fzEzi4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZM8vdYmiiw77TLzA8tvKkt6AWgSvkrhB9MofUTehhfw&oe=6A58D015"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_MWyZxRtmoQ7kNvwGtXAK_&_nc_oc=Adr9YkUCbLrnXQxiPNCGa_Iu1gntFgjUJcF5X0cyiMniSLYSdJOvi92nqGzS8zb-1Es&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfmkKfKC7UXy_0cqIlYaMMUbvReHs14VD6MbuJtuBrjA&oe=6A58D2B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
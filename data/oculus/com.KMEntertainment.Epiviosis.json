0a&_nc_ohc=5AtVzBa4m4wQ7kNvwG-QVie&_nc_oc=AdqUIOBVsgl9egSKK7ZC-Gk2lzNaa2qW195M6yplDojkhZHWTXb6O5HF9mTHoJZXYMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuV6P7itzWJr2hCDfRwChyEu45jEXlh1CCp3z5YXBEGg&oe=6A787A82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXhJkP6rjIAQ7kNvwH6iCmp&_nc_oc=AdqgKDjoL5I0KrHzZqbY776CF2nkEAZPlLPn6vylMCbdiLYXQDFxBkp9g3JeFEDsJm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKY17jInyeoOvjSjhalEL191YiMr4JFMIqS2bI8zl84Q&oe=6A7896C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMZh8AH6l2AQ7kNvwFpHqKr&_nc_oc=Ado69zhOhixKHLcq2zEcnNKjIVrI4UI_eFFe44E3Dx6Y2n5XiQSw4FQrpYxWfaeLanY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh3C56AgHWQ4VkEldaFhGXkwu0k5sjLHNSev7Hrr9zrQ&oe=6A7893A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GddPUwqKdAAQ7kNvwHW9l_x&_nc_oc=AdoMUIq5BuaUEeV93LLq-9wDGAoATn7f-50zpQvWDvB56fDq4m4LurgKER6vH-tpDVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN6cBNYbHsZP3Q24WPIYTlLrF41SwGcpfPmJb6dOQsrQ&oe=6A787415"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYI7IghuJoQQ7kNvwFGdmbz&_nc_oc=AdoEJTQcO_10QRHBIFqhqOTiYzruln0xv1BI-0GcoX4Hk_GjgZxNSVLdZYqnmnzYPvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoPu0ofZvCvN2jYoAAKv8hqA_Ydw6Ch0DjuK_LAQKYDw&oe=6A7876B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
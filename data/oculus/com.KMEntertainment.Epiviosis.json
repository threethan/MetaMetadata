0a&_nc_ohc=PUjkNqNDw6oQ7kNvwFPcmTQ&_nc_oc=AdqPkzHU_R7izMioYk2alc9BlFOvncVimQ2p9WR9b780Vo2FtLACc7pUwbNLT--enLo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fccdS3vBaKhmEt7l-dSlETCHKZmvsga4shflZtOH4TA&oe=6A411B82"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMtaWmVHOSQQ7kNvwFD0_oD&_nc_oc=AdqNa3dOoIDbiknFjYs3peI1_TiG9wyuwDtBPcoBfhkqVt-jv9bua4Q5A8Q9G9FEKTM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l1N7xhOJo5R27UUkjkv-5X2yAmxvl5am-wsPyDHCGpw&oe=6A4137C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i31x0S88tZgQ7kNvwFbwPHl&_nc_oc=AdrAbaJRXbPVSM7CNcWtxCecRBGTx2YeQ6I1XoKDJELJ_AjCoQFAmmGTl8rgxPUh_rs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uO6crSMA1TfjdmIuKV3spGeIJJgyeezP3_STfKU8u8g&oe=6A4134A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab2451Ume2IQ7kNvwFqygWb&_nc_oc=AdrMn0ToK_CCfpEYrClEEBr7MFJ4y8Ri9VQ9tR_kNSesztsMt8-6_14L97qf5zzGxgM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-epFEjI0CN5Db_DDm3b5XI3mambqOj4HtpzjhbtLUUFA&oe=6A411515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYGKBhTUVUwQ7kNvwFeboKs&_nc_oc=AdpczP4tIA1KlRcmYky0nP62KhUg9uK2enXQnerEiTUPZct1eaOU3ldm3UmIyQYNwGI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8T1F1v3N9h83VdL8BdQwUvVHizNU3XKE1TVFe0rmxZQ&oe=6A4117B0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
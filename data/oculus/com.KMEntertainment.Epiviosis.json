0a&_nc_ohc=IYretYx9ddAQ7kNvwF7cN3q&_nc_oc=AdoXQgGdV5yS-QwpkHYn4nDHscCDIlkQo9_LHCKdeY1useCds17gDZZomRSukH15YVA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01frgXaCik8nUlDPRKkcrVsPpagI60k6w1VCG05MUe9A&oe=69F5F602"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY7VZuj2Ce8Q7kNvwGm0qnG&_nc_oc=AdrA6SxqOJv1aYEJClWSKIeiTAqpsNCLutcXJhnhYeaMAPMYqLUSE0RppCrNvWihiMk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cIge-XpPCloLA_U7WJaVGMQXKAr4P55Vyab08cyxiWw&oe=69F61247"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIfLedrroHUQ7kNvwGgyBvs&_nc_oc=AdpLnYvFLhFFBy0mj2vt1hIM75cIR8gfN4csKKxekv6kxR-ZjkG-7SjGPMIR9sIm2sg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Y7jWEuV0ZpQKatFtbtSUNCNOgcu7YJqcht1xy369dxw&oe=69F60F25"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrCsI5U4S7AQ7kNvwFUiGvy&_nc_oc=Adpp2PlwSH-7NiqqRYkIlws2jqgw4OEhJzGI3PR2XRRrkhxF8hjenklcuIXGe75aaCU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_-8MWDmv-ODoUa5WXy7mmWesdBHphMFOF-yJFxAthUA&oe=69F5EF95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv2fImjhSsoQ7kNvwHkhWtc&_nc_oc=AdrnXbMVfXOPcc5R0tbuo820Er0aqyWqAQbFCTiqDwRrSaVMeRBhvZFyUYib5B7ymNs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CZuYgZO9SwEwP2ViYuLShjUqfByanWciWk3Drfb1Uiw&oe=69F5F230"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
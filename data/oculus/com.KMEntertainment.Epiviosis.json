0a&_nc_ohc=GaxoHusIiEUQ7kNvwFkNlO0&_nc_oc=Adok43Vm5k6oAmQrDmVGP9sXQ0PNrptbpIvBl5EpvoIeVTcH8bNjRTZw1DXHjbK6xmI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UVoqO3FyUKEWbabzbteKUYK60lvsu4z1DQl8Rnz_R7A&oe=6A159A02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YfbjTb8UrUQ7kNvwFb8iqd&_nc_oc=Ado0U-UaJtaEKKNFxKlwE1WP3HtaafOvLECbu3N3UhcSIRltHtEFkIo9QIqUtzL4W1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_8hblrNJ_L_ZyNdsPPxoqJJ66szfqYF4q3hBbumsECA&oe=6A15B647"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8spVbUNCQQcQ7kNvwHekaSz&_nc_oc=Adr-o1z19MiktsK-Le-RKIbcLqYMnHxGixmfpELxJmoIw12vi68O8shXdCEPAHtUi5E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zn0ql3b1cGnSjSmf2Xay9xgl0_317DveFnQETb-LEaA&oe=6A15B325"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzMC8E3iTkIQ7kNvwH6_wke&_nc_oc=Adrwc5BfleBMR0P41BWuhFXYAe8FX3gigz2otI6nXQ1mXrHafwdFUSlmt390fhdxFpc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66zF2WswP34NAI4mJrk_xRfguUrA-b_jjQ-I-LZoF2qQ&oe=6A159395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKT_qPrBUgUQ7kNvwGdvd1N&_nc_oc=Adp6jKKNOHvoDhB1wYLNMN_WIUXII2H7WV0U1-j9VwMxh4UFe8lQEmbLMBstLqwPaA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SV1u22L0OogT3FoFtQZ-ePzRN-GizwcWh_aU5opVzRg&oe=6A159630"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
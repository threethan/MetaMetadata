0a&_nc_ohc=RXlILtM6WNwQ7kNvwExHTT3&_nc_oc=Adop0tKTmHDxAf7DX8_PwXOuTvaMfrB4SOTeCN19EKddNaokA_cQ6LWm-Goz4E0KA1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFh0QYBbAuovqxoELA5ozckUievkDTekYaz9yXX6qbtg&oe=6ACFB5C2"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miZhDVFRVr8Q7kNvwHj50v3&_nc_oc=AdpZcicEYqhcIu2FP5BVM6g375th6Q0DyIxlePkoKAR4Z2MDvYCHlvf6RwX7RfPXBwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8mLOffXMNkfJVMsXQCObcv5KCQ499BXCwGQ80wEyVoQ&oe=6ACF99C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9Zw-MJgMsEQ7kNvwEy-u5H&_nc_oc=AdpFLsOVnxZurOJDTupETm1_MhRgqXkIPgm6pj5KtnpMPH0huQmo75FIHedpuvOE6DM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMctAPsgr1hwH7_tQtvOD9eZL2vwwZm54BTHuGJnK9I8g&oe=6ACF96A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCxc2pzODTcQ7kNvwFQI7QQ&_nc_oc=AdpX82l03a99JfXbC5g7wvQuZcY6yh-Ab32eNEiWOZTL82dO2e2f3bJpCWV_0GMDr6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhFs-UhvovP051hnHQseCw4IE_jhAJ3QBffF_ZCBPWXw&oe=6ACFAF55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ytGgYEp-SoQ7kNvwEYBfw3&_nc_oc=AdojpMmWttVJ-SUVvcRGYFoDGCaT1T01sED4pFSfpwETbJGD5Z5Ls3qIRcBmDsvJJg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtDQpNCudXVdO9w_06mMJJVth_0T-asK65d8tZk6UMhQ&oe=6ACFB1F0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
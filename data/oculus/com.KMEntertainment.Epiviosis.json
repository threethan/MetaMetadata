0a&_nc_ohc=ZcSSvDmB_WYQ7kNvwGFtc1U&_nc_oc=Adpo7sHMGiewCKlBgAg0LTo0dglvh8uHJkO1ckNuKfILJJ8n-AfQJ5pqXvix8aii5yE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F-fpF7BGzi8T3zcRTwg-KVQ6Q2Tq_lQKNFQeWvSZmIg&oe=6A451002"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UKOL1eqPvMQ7kNvwFwn5eg&_nc_oc=Adry2qt1YT8plpbm4AOcC9ELEK2bXABeBozJaXaQQ9iIb9Nt69wv0SFk4lTPt2Uk8WE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96BSwkViEWWWvNshAovPzQsiIvRzG0POE-fXHAKR97gA&oe=6A452C47"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2wt0FXNm10Q7kNvwGG7iAX&_nc_oc=AdowZu-D0IChxYGIqknrcHET19pQv8KJvrLt2n9QlOA-hQkqXjK4sXEbx9QJw90ZjpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T2NZRQGXZ1uReDyFewdlHaDNqKkhCRHWJw34mJ3oUrA&oe=6A452925"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmRmZlO8eAgQ7kNvwHpVDlN&_nc_oc=AdoYuKlrGPEcPnafmd-BF69OO7qauiBCi6sWxA4IZS4ErLDMWN9ARu8UOHag9PP8dZs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7mG1HxgpEjky6yAauUhmYfnF4GqHS3DEKfr-wejT89A&oe=6A450995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O51mTsJAliYQ7kNvwFLPwV6&_nc_oc=AdqOzxtK3CsNL6mYt0kZfvHXnaoxLYq06kVHICNPQxwE1VLafVyiFqEdp5Z7LVvBL-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84Qi7XzKEhesMqWDEP5kyxENOe7k1opdvNGgSpz5dWmQ&oe=6A450C30"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
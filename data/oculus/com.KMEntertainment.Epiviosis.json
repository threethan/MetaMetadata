0a&_nc_ohc=exzlyQDe1OoQ7kNvwEyIHCL&_nc_oc=AdoJXxheQc_liXDK5kG7BVht5bJP1a47ODt0D-ck2_L6OFI6b62NSgHqZOKw2-62mbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yg5DScClfV4Vas0AMltlJCc3qf0-A-B2K0ehdZNDKWA&oe=6A3FCA02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd_Db1QsexkQ7kNvwHM950-&_nc_oc=Adpd7UgpNOqCjMONHPlXflVpQ86MHRA7FVOb7Xlr7MreoQXm1kX330_d8LRUVLjSsJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l0yUdhFvLP5hMkMNQp5AqKFcJzTuD4hHZyXuDcBsSZA&oe=6A3FE647"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD1ZgUZVG30Q7kNvwEgTWrT&_nc_oc=AdrbarPhBNyn9Km3ALl3Gao1bX85sope0MSWGp4dkfGut5DKIKv952--zY3T2lJDsgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zhu7PAhge-nAQB0PZw6dMS5E5yMrDbre7hoCTDaRfZw&oe=6A3FE325"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab2451Ume2IQ7kNvwGzu4Y3&_nc_oc=Adrjh--kRAeXfgM4pA7HNd7yeIC1ao414n0hEQXU0-Ni2mEWzo6qlnVEoywHqskWnUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VtD3mTkP0X5SVByJ9H7jO8cj6HPtM16kypqkxwcoejg&oe=6A3FC395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYGKBhTUVUwQ7kNvwGYECgX&_nc_oc=AdoURuJN-k6x9sXCliCFyxSn0bkV5VctbmOnP1Niqh9W8xFZrvxhta3R8g_V8z0jPR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af935ylGiDY_w6TC37oqsvGsdxrFav0Z8j7DYkdo82knxg&oe=6A3FC630"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
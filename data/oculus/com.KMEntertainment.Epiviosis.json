0a&_nc_ohc=OsBQqkHKIrcQ7kNvwEWSlVz&_nc_oc=AdqQrOCmZ28-T66KzQnxoz6AnfzbMyi7eDNBCOmx9UyRLYrQwK76Ddtt-VgWxPfLea0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P2UcDNEwtkTjT-qxg09MLBEGvID7xd4VlgsSDIU6q6A&oe=6A0F0282"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FobmWyA8AAQ7kNvwEH9_sx&_nc_oc=AdpmtuS7DpySXlB2174tZ85ALoqrCplViKIkaREMHnaA84omc2Pl3AFMRVDfKgQuAWY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gRwWPXcPqC9kRm3CqG_EmYzXG0MlaEUBsn_CR_CJ-NA&oe=6A0F1EC7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJywrLck9ZIQ7kNvwEdKsUh&_nc_oc=AdpotKoK-gZFqyMOHMuoIJFeBZ-jTAErVd0awCpPmTaWJyXmqW6sexeDASBMBTaSL24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p9twPoWFXI4dEceohvKD8WoZvZCDVdbPBd08vIlwP5w&oe=6A0F1BA5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqtI-C7-wfAQ7kNvwGS1r7t&_nc_oc=Ado7g2iY_vRBfLzoJAME56CnM6JZVcToONdOWIEJbUFJhyXxbYMuBm4Lq_67B7kklMk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42uULY_xp3Pl14bGPAmiLooRpB_eLUlaUDZFtCsiaxKg&oe=6A0EFC15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JrwvNptZHIQ7kNvwGGopGm&_nc_oc=AdrxWIwc3aoF5cQzQ3eJM531itepQXgTDX6tgu7eFRA8aOwcDWnKBHOgNptdqJPlBho&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5owY_CTx47ilSiBkeG3RpLonYJ9cvOTXhsUtyVkX6ZeQ&oe=6A0EFEB0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
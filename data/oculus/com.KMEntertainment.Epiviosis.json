0a&_nc_ohc=KNwYbz2B4pMQ7kNvwES7Nt_&_nc_oc=Ado9ZWJC3ZFgeWtcSYbzUDI8x70ePr4mw9XKtMODwd6dniTK-kkISEyIttPyn5ReQvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG6VnX8ELvcZJiu-eunSeREjWHlgd_SNtVOAIp71Z-Ng&oe=6AF49FC2"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mKORFB-wiUQ7kNvwHHV-re&_nc_oc=AdpT4Uij2-Y9yD7vWghQRc9cyfI6UjUNGPi7OC8SH28UkPlMeY1Xfiw8WfmG7PiyjZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7GT9huJ1cCbqtE4cKme9yE-uWtShiqUn4IWcV-9_WAw&oe=6AF483C7"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oaz6FP5Y4JIQ7kNvwHVSvtL&_nc_oc=AdpPyJfRBtDK4Y3MwgiIWA9WoGvYS-8qF6MtFMDE94clQIY1V6WJJ9zOdCKVMJCXuN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSverM3xTOTf8WibUDMdaSbcLD2uXY1oom9sbdLGyKhPg&oe=6AF480A5"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDRU_sfrNUsQ7kNvwG3faR5&_nc_oc=AdolZjdwpLEXZzpR7bm4WkJ7yhn8YfdvQl9uXsGMAVFyWwhNDI_BHh1k52XINii_a9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2bCDzrP0T_Kp3Bhm1HmieUewbUF2BYA_FJD1P7T0A2A&oe=6AF49955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i9tNMYO3d4Q7kNvwE85J3B&_nc_oc=AdoU6BDag2sGf94fsGNcdgLf06kaH5ckuWqIXGw_hpid9LtQiIK5GdoF_mBQMDC478w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGuRDIAOB8EeWcTj4GLIMGh3qi5Y3a5ImVYyIR60aLCA&oe=6AF49BF0"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
0a&_nc_ohc=QDM41g5ZTc8Q7kNvwGuwFs8&_nc_oc=AdoHQCwV8kNyLKLMRWiji_ksvNkZ7dUzzuo0ni9f-6nNl2S1tNBtNl2QhJs6EH8RdxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdGD0EyIhDKpkbrIeZYCndKAJ_JFSyGSJLiYuxV5ZxoA&oe=6A69FA02"}, {"file_name": "screen03.png", "id": "1069311896928429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_1069311900261762_331597620564826633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEVA7xOLkusQ7kNvwGmqw08&_nc_oc=AdrC4qMvW0z0iAN2Xp879B_ILRb_kx-KUB-Oo9WAT2bJYl-NOJli-naL_BqSFyELjPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeBvihrh-iiQ7ZstwwljMjTPmJBKIYK4DjcYapckOi_A&oe=6A69DE07"}, {"file_name": "screen04.png", "id": "1194826387632547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1194826390965880_6614854191027359345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph6XEeWbu84Q7kNvwHUW6TE&_nc_oc=AdrbgTpr8hrWfuzWr5SEwfD2MtecaWkCUdRyrK1wtBr43HYBi5fyS9q6Kt1nw5wF1eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNt1KoCo7kl2dT195qdwClHcsJyJLDYYnFYQgc2HY-yA&oe=6A6A1325"}, {"file_name": "screen05.png", "id": "336610621290058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_336610624623391_6519872809688220140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApnyziKfpBsQ7kNvwGIpMTf&_nc_oc=AdojN9OYK1MD58JDdI6Pxpyh_o5nxGwuNBKYioNT-WUx1myZk2JDiWHMZWZH5d7PXbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYAYODxvmYRlmG1WHRVf1EkdVP7b0Dlye3cY367h8Gqg&oe=6A69F395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "4509630855747264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974499_4509630862413930_2627979156702783130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS3NVtN-Ae4Q7kNvwEusmpK&_nc_oc=AdpJJTDT0Zrurb46590RzUi8Jk8fCv96LLj_isIkOynY5prwKeHSCGZeMQpXzuOL-jI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF9AoupwceQFZU-ekETxw5LZeooQNScHsj7B30FWtHew&oe=6A69F630"}, "display_name": "Epiviosis", "keywords": [], "long_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy. Benefit from various power-ups that fall from the sky.\n\nThere are two play modes in Epiviosis:\n\n1. Story Mode\nEarth, as we know it, is coming to an end. Try to get to the escape vehicle that leaves Earth for another habitable planet! Make your way through waves of enemies and reach your final destination.\n\n2. Epiviosis Mode\nAs you complete Story mode levels, Epiviosis mode unlocks the same levels. But, now, you have to survive against time! The longer you stay alive, the better your score!\n\n", "short_description": "Epiviosis is a VR FPS game created for the Oculus Quest 1 and 2. \"Epiviosis\" is the greek word for \"Survival\".\n\nFast action, destructible environment, various kinds of enemies and vehicles to destroy.\n\nTwo play modes: \n1. Story Mode \n2. Epiviosis Mode"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.km-entertainment.com/epiviosis/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "KM Entertainment", "support_website_url": null, "website_url": "https://www.km-entertainment.com/epiviosis/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
-Ab4IyB3WbrpO2_tzBm416KyQ&oe=6ACE6A6C"}, {"file_name": "migrated_image.png", "id": "214380952981944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139299_1284716071569477_7497616781041729536_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8HiaVnhl4wQ7kNvwE6fyqa&_nc_oc=AdqlH_RaTgO6vF0-FghL0eRrOWffCG7cybRhvpCrYgqNsylUjUoS8ltwwO0MWYiOL30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9-e6pe1s-WAOIC7kwR2zeRdHU8h24M-C7ve_GmqXY1A&oe=6ACE61A0"}, {"file_name": "migrated_image.png", "id": "2617850381837455", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602216_162586344208992_4007997278001299456_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OE0Tf9GYrSMQ7kNvwEynjOK&_nc_oc=AdpcXngkJb5q_DfN1wt6SYLFG1VocEnhXSFcejRM_P7od5o4_2Tg2Ze4Y_bCtdLCrkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5hhgo79euRxhPdMf9BRsqzZxcSSk9VhMDm_e6bVN9DQ&oe=6ACE37C5"}, {"file_name": "migrated_image.png", "id": "216945052713171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504635_638435369651602_8973145876390215680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWvF91zRF-sQ7kNvwGVGrHt&_nc_oc=AdpkNNtzOi0jc-Bd4c2z7cSpcPmMSzb_t4OnVnH0Fm8qesj4qPAZzK6ugPLLtbzPDos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFVMdOJA-FJT91aT8yJDABSkws6nWj9mCe0sReZrkjjQ&oe=6ACE4DB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stern Pinball Arcade", "keywords": ["arcade", "classic", "farsight", "pinball", "puzzle", "stern", "trek"], "long_description": "Many of the all-time greatest pinball tables are being created today by Stern Pinball Inc\u00ae, the oldest and largest producer of arcade quality pinball machines!  Play them now on your favorite video game device.  Modern classics like Star Trek\u2122, AC/DC\u00ae, and Mustang\u00ae are available at launch with more to come!\n\nDLC \u2013 New releases like Ghostbusters\u2122 and Whoa Nellie\u2122 are coming soon, with more to come!  Table Packs, LE Tables, and new features are released regularly.\n\nPhysics \u2013 Unrivaled and critically acclaimed physics allow for the most realistic pinball simulation ever made.\n\nLeaderboards \u2013 Earn bragging rights over friends or players around the world for each table.\n\nTable Goals \u2013 Accomplishments help serious players learn and master each table.\n\nTable Instructions \u2013 Detailed tutorials of each table teach you how to become a pinball wizard!\n\n", "short_description": "Many of the all-time greatest pinball tables are being created today by Stern Pinball Inc\u00ae, the oldest and largest producer of arcade quality pinball machines!  Play them now on your favorite video game device.  Modern classics like Star Trek\u2122, AC/DC\u00ae, and Mustang\u00ae are available at launch with more to come!"}, {"images": {"nodes": []}, "id": "545216863039666", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stern Pinball Arcade", "keywords": ["arcade", "classic", "farsight", "pinball", "puzzle"], "long_description": "Une collection de tables de flipper classiques et modernes recr\u00e9\u00e9es num\u00e9riquement par Stern.", "short_description": "Une collection de tables de flipper classiques et modernes recr\u00e9\u00e9es num\u00e9riquement par Stern."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pinballarcade.com/Privacy/", "developer_terms_of_service_url": "http://www.pinballarcade.com/EULA/", "publisher_name": "FarSight Studios", "support_website_url": null, "website_url": "http://www.sternpinballarcade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb
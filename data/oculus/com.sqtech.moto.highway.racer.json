b=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg5qD02X5V8Q7kNvwG2Hkry&_nc_oc=AdrCsA7x-WwncN8lHaEOIQHkLqs5gFZ7FujQarBmomxbqNT7JDb4R4dPYLMyp2PfIN0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNvxbK6LWKfBT2uJlWFI-H3ud64VoHlxaEVQjvqfkPdA&oe=6AAD45FE"}, {"file_name": "scene4.png", "id": "1386797090113080", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818860_1386797093446413_1859775275434097472_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mL543znPMUQ7kNvwFnano1&_nc_oc=AdonecD4s1UHiUqGQ2jWJ1mJwGXM2T10yOGMc-9-CiAadzL2rU_437t-3D5yK-CqGv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqvxReqvZ-WWblT2seJHK4AT8CS3iDRo8bS2SKLjRp8A&oe=6AAD38E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moto Rider: Highway Racing Game VR", "keywords": ["offline", "racing", "Bike", "speed", "highway"], "long_description": "Moto Rider Highway Racing Game is the ultimate bike racing game for all the motor Bike lovers out there. It is a realistic and exciting game that lets you ride your favorite modern bikes on different occasions and environments. You can choose from sunny, day, or night modes and enjoy the stunning graphics and realistic physics of the game. You can also explore different environments such as Highway, Forest, Desert, Beach, and Mountain and feel the adrenaline rush of speeding through them.\n\nMoto Rider Highway Racing Game offers you three different modes to play: Career, Endless, and Free Ride. In Career mode, you can complete challenging missions and earn money to upgrade your bikes and unlock new ones. You can choose from multiple high quality modern bikes, each with its own features and performance. You can also customize your bikes with different colors and stickers. In Endless mode, you can test your skills and endurance as you race as far as you can without crashing. You can compete with other players on the global leaderboard and see how you rank among the best moto riders in the world. In Free Ride mode, you can just relax and enjoy the ride without any pressure. You can explore the different environments at your own pace and discover hidden secrets and surprises.\n\nThis Game is more than just a bike racing game. It is a game that will make you feel the thrill of moto riding on the highway. It is a game that will challenge you to improve your skills and become the best m", "short_description": "Ride Your favorite modern bikes on the highway and enjoy realistic Experience. Moto Rider Highway Racing Game is the ultimate bike racing game for all the motor Bike lovers out there. It is a realistic and exciting game that lets you ride your favorite modern bikes on different occasions and environments"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/smartgamesvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Smart Games VR", "support_website_url": null, "website_url": "https://sites.google.com/view/smartgamesvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32298707366442896"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823757_1869647211096274_5869737598395823313_n.png?stp=dst-png_s360x360&_nc_cat=100&cc
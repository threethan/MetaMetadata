ent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q7WJDwVTzwBDlyyWALk_l5R1YtGCFeGFSN07jcVBDGA&oe=69E8B1C9"}, {"file_name": "Screen1-3.png", "id": "690698042590088", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031605_690698045923421_2028456058003814740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88HgH-mElM4Q7kNvwE8gwIZ&_nc_oc=AdosiR87ILnO31M0HBYEm9e8B7ywsSG7p6fcDGFzww1n6QfQ-ZRnBwbYtoPtLtm1GoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15tqx3Mm5GVX7IHKA-u1zt14kt5fOMc8yAu2P8A8w-DA&oe=69E8BC44"}, {"file_name": "Screen1-4.png", "id": "2536931596447453", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485576_2536931599780786_3289187093554919130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gynGlMj_JFsQ7kNvwF1S_Jm&_nc_oc=Adotkg33PakoNX3PV6666Qdtxg6LgAObuiXoAA3_nVMrLPyiL0UmkefyRRDgnUjTA0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X1Sg4iA0lPk5zrx0_izr_BjVPyCJADoxuToOdDIpl_Q&oe=69E8D46A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Video.png", "id": "816310500619134", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569452_816310503952467_4671162026031133464_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1cjuTK0uskQ7kNvwHR8qWE&_nc_oc=Ado49LG-zjMyyH2CzPa55PAo1wMn_TNaB4uFlyjLDQzYYAJYhZIyHqM6w5N6Hc2LhA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CYXt6aXRJw9cgGP0RHw5V76WzQkdoapQUtcznkLecnw&oe=69E8DB27"}, "display_name": "Bullet Master Run", "keywords": ["Shooting", "Precision", "Aiming", "guns", "Hostage"], "long_description": "It's time to get the guns out!\n\nDo you like action spy movies? \nThen challenge yourself in an epic Bullet Master Run game! Here you must prove that you are the best spy of all! \nYou are attacked by a crowd of enemies, \neliminate them one by one but take care to not shoot the hostages! \n\nFuture Plans:\nWe have an ambitious roadmap ahead to bring even more features and content to Bullet Master Run. Here\u2019s a sneak peek at what you can expect in future updates:\n\n*NEW GAME MODES: Additional game modes and environments to explore,\n*NEW GUNS GUNS\n*VR OPTIMIZATION: Ongoing improvements to ensure a smooth and immersive VR experience on all supported devices.\n\nHave fun!", "short_description": "It's time to get the guns out and save the hostages! \nCan you free them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=123", "developer_terms_of_service_url": null, "publisher_name": "AM APPS", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25794702193488734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221321_1457977724851868_6987950516813713841_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lKd8iFRu_MQ7kNvwGnblLO&_nc_oc=AdpknJKnOyXi_Kxo6x1HHxBFBf59GLQwxXY6zAxxZNZeDkpEnxZoCia61C1utcpw3o4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Cz_C0woODYxn9ZdOMhAxxtpeTVPaZ2iA17d1oSBbE7Q&oe=69E8D712"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bullet Master Run", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, 
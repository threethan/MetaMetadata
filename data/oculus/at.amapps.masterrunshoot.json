ent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQvAHMgwSGAndjDyw7R9CGc5J-uLpsFmyCylVXkwY9Sg&oe=6AB29F89"}, {"file_name": "Screen1-3.png", "id": "690698042590088", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031605_690698045923421_2028456058003814740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-vLdSInDG8Q7kNvwEHY5gM&_nc_oc=AdplOfji41L9zpn3rtTlnXTSjENyIoLUNg21Q12YdLLiCLSr-P3ZjRnesUilXSkliwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHRlgJ59GBXvRB1GeJcgT6MLFAAsbP4CV7EWKM_fuR5Q&oe=6AB271C4"}, {"file_name": "Screen1-4.png", "id": "2536931596447453", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485576_2536931599780786_3289187093554919130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b08056ZhUtIQ7kNvwG34Wqh&_nc_oc=Ado6i5NDjViHOkEOSK37IbCStLw11A16GDsDN9oeeyKN-4omziphgzjB2Ew65ur6UVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRneldnvois-zRjIKkLFpppM-r3v_62GAxuqyDFHDYQw&oe=6AB289EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Video.png", "id": "816310500619134", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569452_816310503952467_4671162026031133464_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E4Q4VK4gQkQ7kNvwF4RtoM&_nc_oc=AdrzvDRxACKbYWMKpbwoDsOALJLxsNzHETh9CdM2ao54hyFcsPi208udfN_GhjK-l2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx7cSaQIfw7kQkSc13k_5AXdrzUAwV1X9veNt9620RnA&oe=6AB290A7"}, "display_name": "Bullet Master Run", "keywords": ["Shooting", "Precision", "Aiming", "guns", "Hostage"], "long_description": "It's time to get the guns out!\n\nDo you like action spy movies? \nThen challenge yourself in an epic Bullet Master Run game! Here you must prove that you are the best spy of all! \nYou are attacked by a crowd of enemies, \neliminate them one by one but take care to not shoot the hostages! \n\nFuture Plans:\nWe have an ambitious roadmap ahead to bring even more features and content to Bullet Master Run. Here\u2019s a sneak peek at what you can expect in future updates:\n\n*NEW GAME MODES: Additional game modes and environments to explore,\n*NEW GUNS GUNS\n*VR OPTIMIZATION: Ongoing improvements to ensure a smooth and immersive VR experience on all supported devices.\n\nHave fun!", "short_description": "It's time to get the guns out and save the hostages! \nCan you free them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=123", "developer_terms_of_service_url": null, "publisher_name": "AM APPS", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25794702193488734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221321_1457977724851868_6987950516813713841_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdgaawhUxGMQ7kNvwE6yK-i&_nc_oc=Adpkz2p-H6Tq9n7hCcuz8ZS59AfB5OwoX_NBCdmOGfVyMhIRFWlrcIgczJRaX26PecQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt9fZFG1vPRZ1DXfpsDNawgatfDJFZwLbz0-WiS3srdQ&oe=6AB28C92"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bullet Master Run", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, 
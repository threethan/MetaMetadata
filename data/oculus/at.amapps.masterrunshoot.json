58_498385088839760_8652625783529327443_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaNpJqcHeaIQ7kNvwFFAWBf&_nc_oc=AdqrBQf1oU7KW-s-3y038YztK8tAy-Ac5wVTa251eMvxTxLulhbkd5kiJ_Y8lEnYwOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6R3ZsrCMX7RL5h1SOHjcwBlRd4QbJnqTdShPecaJ1VA&oe=6B0F20C9"}, {"file_name": "Screen1-3.png", "id": "690698042590088", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031605_690698045923421_2028456058003814740_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=068AgkBRyYgQ7kNvwEwZcFc&_nc_oc=AdoRI6UdoaHyEA3niX2-FfX_KHyyU61U4TzM3qxcCmoA3_-Xn3I7xGXEkMpu2ZiPw-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUX9tcc27SvDPorWBxkcf3Cr9m1Jetd2ZrkWjnkNZK-Gg&oe=6B0EF304"}, {"file_name": "Screen1-4.png", "id": "2536931596447453", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75485576_2536931599780786_3289187093554919130_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7w9eNDZkrgwQ7kNvwGn32RK&_nc_oc=AdqWIzAwZiWBLaX4F0iqoDdo1u0cFDWkjiI5qcHp8mSUHStiXi-m9W6DySpi-Yq28XM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSLuXCTK5_2WDJjHIghfw1JeP5N1sKMmFYirkZnFiw8g&oe=6B0F0B2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Video.png", "id": "816310500619134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569452_816310503952467_4671162026031133464_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPI5cjOXUe8Q7kNvwH7qfjT&_nc_oc=AdqxcU42Kp_vujHxHqvnFOwtPyXLlYiZgUqqIRKX-2uTRaHDsMHjBoWLt3LEBdYDPPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVaX7oQ4oUWzcX8qNEvzIySnsmn3kq-vcJ1DjtypEbFwg&oe=6B0F11E7"}, "display_name": "Bullet Master Run", "keywords": ["Shooting", "Precision", "Aiming", "guns", "Hostage"], "long_description": "It's time to get the guns out!\n\nDo you like action spy movies? \nThen challenge yourself in an epic Bullet Master Run game! Here you must prove that you are the best spy of all! \nYou are attacked by a crowd of enemies, \neliminate them one by one but take care to not shoot the hostages! \n\nFuture Plans:\nWe have an ambitious roadmap ahead to bring even more features and content to Bullet Master Run. Here\u2019s a sneak peek at what you can expect in future updates:\n\n*NEW GAME MODES: Additional game modes and environments to explore,\n*NEW GUNS GUNS\n*VR OPTIMIZATION: Ongoing improvements to ensure a smooth and immersive VR experience on all supported devices.\n\nHave fun!", "short_description": "It's time to get the guns out and save the hostages! \nCan you free them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=123", "developer_terms_of_service_url": null, "publisher_name": "AM APPS", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25794702193488734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221321_1457977724851868_6987950516813713841_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2WxV5sim0wQ7kNvwEn35fj&_nc_oc=AdpNzPW773lrsj65xbaphrsv9rFTznUIhYDHSxREPabvmO_EtQrPFSbyyyd-b2oIQS0&_
ent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4Hs2U8RVQ5dKyW8mWORowNLhl_0JqYGINJiq-MthwHg&oe=6A9D8789"}, {"file_name": "Screen1-3.png", "id": "690698042590088", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031605_690698045923421_2028456058003814740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZvNise7hzgQ7kNvwHEL4p_&_nc_oc=AdrHOlWt7Mpip91sopBJaUZM074pxzrGOrK717BZ4w4_Z5P_8U81qu2o0iS7cDwpG-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoDuqvUZxiNEDLilidUCOJBluzvh3lAU_jv_JnUYJCWg&oe=6A9D59C4"}, {"file_name": "Screen1-4.png", "id": "2536931596447453", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485576_2536931599780786_3289187093554919130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixgfUk6X6CEQ7kNvwGpPM5h&_nc_oc=AdqNq8WcrAf-ftdMoVH44arbPW6DYfGDuaXbTFCQjw3khcwhoLLLrxbIVNt_-w57O3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyhPampIREylE5e5hnLWk4PsU485vUBUv-1hfkG31VSw&oe=6A9D71EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Video.png", "id": "816310500619134", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569452_816310503952467_4671162026031133464_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAQ0Hnho__gQ7kNvwFrLvif&_nc_oc=AdqzNBCc0S_hHY9pP6ZXn4hoXL6m8tIVh3BnaI1jN5BFgAfd0Rb2d3PZCkGI4pCjEPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPPDw4AidCuxn4gos0uEEOlX7OQeh8memhS59O0Q0MeQ&oe=6A9D78A7"}, "display_name": "Bullet Master Run", "keywords": ["Shooting", "Precision", "Aiming", "guns", "Hostage"], "long_description": "It's time to get the guns out!\n\nDo you like action spy movies? \nThen challenge yourself in an epic Bullet Master Run game! Here you must prove that you are the best spy of all! \nYou are attacked by a crowd of enemies, \neliminate them one by one but take care to not shoot the hostages! \n\nFuture Plans:\nWe have an ambitious roadmap ahead to bring even more features and content to Bullet Master Run. Here\u2019s a sneak peek at what you can expect in future updates:\n\n*NEW GAME MODES: Additional game modes and environments to explore,\n*NEW GUNS GUNS\n*VR OPTIMIZATION: Ongoing improvements to ensure a smooth and immersive VR experience on all supported devices.\n\nHave fun!", "short_description": "It's time to get the guns out and save the hostages! \nCan you free them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=123", "developer_terms_of_service_url": null, "publisher_name": "AM APPS", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25794702193488734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221321_1457977724851868_6987950516813713841_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fvv5t_l3qAQ7kNvwF_WMIC&_nc_oc=AdpNXCBy7q_cY2r-kZQSqfehVk9oOB4GWOz5YXs7Iw2Ns9jQMFQYFUo74vAaUE_rzUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKNf76EdaYRiHjQ4K2FGDakM2QSLUZfszAe76GoKEQHA&oe=6A9D7492"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bullet Master Run", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, 
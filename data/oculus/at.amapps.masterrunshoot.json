58_498385088839760_8652625783529327443_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDQdKxrEic4Q7kNvwFu6j_i&_nc_oc=AdoHdRxdPqlaxDGnvRg0VKNckz0KTDnL4uMBUbJSnErjaMe1GkgwncaRA6hTbHFM7nE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYUho0iR8dHgf2Rg4fdfkdqzR-MyPlzdfgA3MnOeea7g&oe=6B006809"}, {"file_name": "Screen1-3.png", "id": "690698042590088", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031605_690698045923421_2028456058003814740_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTwTkt7I8y0Q7kNvwFNIIi5&_nc_oc=AdqibmoiFus91ZYv6WFtLyDigv-FgVRUSXrHKJnBEKtX6KeN7OJZsD47iEv31UJ_emY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrRRR1a3rKldTFpXhV6fJ5Td55tpNcTY7GDjaaSnU_mw&oe=6B007284"}, {"file_name": "Screen1-4.png", "id": "2536931596447453", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75485576_2536931599780786_3289187093554919130_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dok-DiNivMQQ7kNvwE6Kfd6&_nc_oc=AdoqohZpF2fG6tk3vXM0P3OnLluHtRi7UjDMxFGUF-JH18OLu1sEoPW-c_RmmTRZB_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIymtg1Yma4duokk5_rHRemCpugGG69d4pEoqyF_meSw&oe=6B00526A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Video.png", "id": "816310500619134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569452_816310503952467_4671162026031133464_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7JH-nECqz0Q7kNvwHQVbuf&_nc_oc=AdqynvQGDbPmL0kgJHY_SZC9COfxT4jCXKFCldts9MWUT92BIJAbIUMc7DeqODOu2Lw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsKDBKI0PgbEzzet2QRBRa6gmOD6twSc516aP_2fai6w&oe=6B005927"}, "display_name": "Bullet Master Run", "keywords": ["Shooting", "Precision", "Aiming", "guns", "Hostage"], "long_description": "It's time to get the guns out!\n\nDo you like action spy movies? \nThen challenge yourself in an epic Bullet Master Run game! Here you must prove that you are the best spy of all! \nYou are attacked by a crowd of enemies, \neliminate them one by one but take care to not shoot the hostages! \n\nFuture Plans:\nWe have an ambitious roadmap ahead to bring even more features and content to Bullet Master Run. Here\u2019s a sneak peek at what you can expect in future updates:\n\n*NEW GAME MODES: Additional game modes and environments to explore,\n*NEW GUNS GUNS\n*VR OPTIMIZATION: Ongoing improvements to ensure a smooth and immersive VR experience on all supported devices.\n\nHave fun!", "short_description": "It's time to get the guns out and save the hostages! \nCan you free them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.am-apps.at/wordpress/?page_id=123", "developer_terms_of_service_url": null, "publisher_name": "AM APPS", "support_website_url": null, "website_url": "http://www.am-apps.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25794702193488734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221321_1457977724851868_6987950516813713841_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsyvZhUU3tMQ7kNvwFGjhO5&_nc_oc=AdqJrbDEpwFrnNtWPSC_PsxQ-cE-MLHsgWbxXzSqG_FdQu8zAf4L7zQhgHbdn2jR3Ic&_
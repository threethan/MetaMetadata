-sea5-1.oculuscdn.com/v/t64.5771-25/38974452_1121477439623959_7008446885581125408_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4D9DzpuU7AQ7kNvwFHfRZr&_nc_oc=Adr0eQsvAq4dCvNmbCsK3z1eYPgNou1YOPP5RV70UYjP3f1F7ksJEa5pAZC3fHFGBlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxv85GQUEf52QfNLVbf5_hldVSd0xDZcvKJ4__Hwh71w&oe=6AFC86BA"}, "display_name": "Atlas Obscura VR", "keywords": ["travel", "atlas", "exploration", "adventure", "globe"], "long_description": "Designed for explorers at heart, Atlas Obscura VR offers a treasure trove of inspiration, uncovering the unconventional and celebrating the world's hidden wonders. The app includes breathtaking visuals and detailed accounts of 50+ destinations from the beloved Atlas Obscura book, plus three fully interactive episodes that bring these locations to life with over 45 minutes of adventure. \n\nExplore:\n1. **Winchester Mystery House** (USA): Step into the enigmatic, sprawling mansion of Sarah Winchester in San Jose, California. A place of wonder and intrigue, this spooky mega-mansion was once the home of the widow of firearms magnate William Wirt Winchester.\n2. **Salina Turda Salt Mine** (Romania): Descend into one of the world's most stunning underground formations. This awe-inspiring Romanian salt mine is a testament to human ingenuity and nature\u2019s beauty.\n3. **Temples of Damanhur** (Italy): Discover a subterranean marvel in the Italian Alps\u2014a vibrant, living laboratory for the future, created by a federation of spiritual communities.\n\nAtlas Obscura VR was originally developed and produced by Start VR (now Start Beyond) and is now part of the New Canvas immersive catalog. \n\nUPDATE - Check out the latest features:\n- Hand Tracking \u2013 Explore with just your hands; controllers still supported.\n- Better Navigation \u2013 Streamlined menus and usability updates.\n- Enhanced Visuals \u2013 Sharper models and 360\u00b0 images.\n- Optimized Performance \u2013 Bug fixes and improvements.\n", "short_description": "Atlas Obscura VR is a brilliantly captured, hi-fidelity, self-paced virtual travel experience unlike anything you have seen before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6bf4c228-12ec-404c-b6e5-afe33ab0b513", "developer_terms_of_service_url": null, "publisher_name": "New Canvas", "support_website_url": "https://discord.com/invite/U2prvwGbhA", "website_url": "https://www.newcanvas.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26049365131398737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974835_918814973548535_6573714784107970580_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8NEiwjjHuAQ7kNvwGSpyas&_nc_oc=AdpRg0zKL_moecc_zmuZQEpD4qgG9ew4ufXD55ygTLcf5VUtlES2rvINCcg_B2WFBd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNA5W5p7mZJhg_gt7CnbVcLswpC20Sc9veuc8Ono_F_w&oe=6AFC81DF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas Obscura VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "7263
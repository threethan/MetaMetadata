EJQRaXUDxKU-KkM2EWhsz6CLsmvvugTbJKjyPHGzyA&oe=69B7FF9A"}, {"file_name": "11162730_423066541422936_9036041845624274944_n.png", "id": "1110989514365393", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974512_1110989517698726_5370783512734288619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u9tu5zYObkQ7kNvwFoHMbm&_nc_oc=AdnyeRHl09QAHLM8QKJGi-PrAMsRARwQy2_kq-fIX7NwXfadV03xApDSuPMASFr9Y00&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVBK872g2mV6O2Wj58mfZz4Cv1_BT4jUncTVLknXiXoQ&oe=69B80149"}, {"file_name": "11162737_140144479911840_4121170877431676928_n.png", "id": "2345733325768449", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031363_2345733329101782_8786824416684649029_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v35aTJndc5wQ7kNvwEh6_8l&_nc_oc=AdnoZ7ADf3NQzZP_hDeAkmSkNey5M_W91EXejaOWoWkmtaB-rhrkSEamyzEMCKZfcqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYy_y9lWgihkLukOT5p-iak1vJmmYnhho0GTAZDqjVmQ&oe=69B80F37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AOVR Landscape Cover.png", "id": "1121477436290626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1121477439623959_7008446885581125408_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiBYOuQ7zpwQ7kNvwGImldH&_nc_oc=AdmFfJDS_Em77yCdNuN8iIGBB9FU3VEss4Pn-NYztWZSfv03EdWOCzX1xwoVKmkuhVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwi7K8Y7ytkAMk8v7_a4VLKrW8p8TeZJfZt5tfgSmdivQ&oe=69B7FD7A"}, "display_name": "Atlas Obscura VR", "keywords": ["travel", "atlas", "exploration", "adventure", "globe"], "long_description": "Featuring incredible imagery, fascinating stories and hidden interactive gems that will transport you to the most amazing locations in the world.\n\nIn Season One you will explore three fascinating locations, with over 45 minutes of interactive adventure including;\n* Winchester House (USA)\n* The Temples of Damanhur (Italy)\n* The salt mines of Salina Turda (Romania)\nPlus, view up to 50 fascinating virtual articles with imagery and narration from the authors of the book.\n", "short_description": "Atlas Obscura VR is a brilliantly captured, hi-fidelity, self-paced virtual travel experience unlike anything you have seen before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6bf4c228-12ec-404c-b6e5-afe33ab0b513", "developer_terms_of_service_url": null, "publisher_name": "New Canvas", "support_website_url": null, "website_url": "https://www.newcanvas.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9068409543254228"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1229049072011633"}, {"status": "PENDING", "id": "1629171734771445"}, {"status": "PUBLISHED", "id": "1477576070183562"}, {"status": "PUBLISHED", "id": "1310237130309757"}, {"status": "PUBLISHED", "id": "773468495545738"}, {"status": "PUBLISHED", "id": "2547222068944820"}, {"status": "PUBLISHED", "id": "4302003070027293"}, {"status": "PUBLISHED", "id": "1345813673519524"}, {"status": "PUBLISHED", "id": "912330657666612"}, {"status": "PUBLISHED", "id": "735931991772215"}]}, "baseline_offer": {"id": "1310237130309757"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1229049072011633"}]}, "liveChannel": {"nodes": [{"la
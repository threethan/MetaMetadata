pfCs2VDugDBLL6MJWT9YDw-5YcbyB4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCL0ZYSVhf3xyHPaeE0FgdWrVD42B3-ON5t-w-7YRGEA&oe=6AEF3137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AOVR Landscape Cover.png", "id": "1121477436290626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974452_1121477439623959_7008446885581125408_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtnmCNm_cvYQ7kNvwFPB3JC&_nc_oc=AdqyFSocnLbr2VRmpGmzsEuvTsUMbO_JL1Qw29Zfwt8eobem4OWQAmnArYQp4OjEG_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMo-G5wzJj_XIVYE8s9b4vlv3E7mXkxOGz7UndrgH2JQ&oe=6AEF57BA"}, "display_name": "Atlas Obscura VR", "keywords": ["travel", "atlas", "exploration", "adventure", "globe"], "long_description": "Featuring incredible imagery, fascinating stories and hidden interactive gems that will transport you to the most amazing locations in the world.\n\nIn Season One you will explore three fascinating locations, with over 45 minutes of interactive adventure including;\n* Winchester House (USA)\n* The Temples of Damanhur (Italy)\n* The salt mines of Salina Turda (Romania)\nPlus, view up to 50 fascinating virtual articles with imagery and narration from the authors of the book.\n", "short_description": "Atlas Obscura VR is a brilliantly captured, hi-fidelity, self-paced virtual travel experience unlike anything you have seen before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6bf4c228-12ec-404c-b6e5-afe33ab0b513", "developer_terms_of_service_url": null, "publisher_name": "New Canvas", "support_website_url": null, "website_url": "https://www.newcanvas.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
QnB0gx9xXaC7ViUgzk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3lX6sYGd_Jm0srKY-jueajXk4tiQOTsCynzbyPTIO1w&oe=6AC91080"}, {"file_name": "11162695_506846239657586_3267319881359425536_n.png", "id": "3824042967850737", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75339313_3824042971184070_5411991297699333580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryN_xCEUV_oQ7kNvwFCbDTI&_nc_oc=AdrL61qqXFsbzDjU3auarOVWMNZMzs1qk8-wwz8EC5MVnWsrh7M1rWIrIDDXlEwl6Qk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvzMD3x77CN79_9ncCszwOHbLpw-oxx1Tq0ZVWXIDniQ&oe=6AC8E61A"}, {"file_name": "11162730_423066541422936_9036041845624274944_n.png", "id": "1110989514365393", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974512_1110989517698726_5370783512734288619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqKd3842uAcQ7kNvwHGkzEp&_nc_oc=AdrtsMolv6flmPH2H1wkbFGTKkLNL2sC1prVEqkC3lm3_t8Mdz_yrh_nV0RslEWENO4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZJ_9ulDSqYt5H9wgZ0V1X4NcwXbf43A1Ci2jRFHf9RQ&oe=6AC8E7C9"}, {"file_name": "11162737_140144479911840_4121170877431676928_n.png", "id": "2345733325768449", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031363_2345733329101782_8786824416684649029_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDg7djsdaWIQ7kNvwG7nKzo&_nc_oc=AdqBhqXhhOGXUEPiDX0sJ8mwbzUIxmL4OCVmkX_9vLNGxUsKCl4uPURAjGcN_5lRueQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW_XFWHQoCQkYTxp-RtIv-xuoyiMDoORKyciKSUhFdBw&oe=6AC8F5B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AOVR Landscape Cover.png", "id": "1121477436290626", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974452_1121477439623959_7008446885581125408_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0LFeq0bClEQ7kNvwG3NwH_&_nc_oc=AdqCUfs0z4bIvM1WG1v80Melo6mZZeyPi0ABDFCYnrvTGp8YpbBuYonJlQ-J6tqIxHo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs3Vljh-ZpTOmLrKbSACAS60DEJb_zQeBCuu7dhg2LEQ&oe=6AC91C3A"}, "display_name": "Atlas Obscura VR", "keywords": ["travel", "atlas", "exploration", "adventure", "globe"], "long_description": "Designed for explorers at heart, Atlas Obscura VR offers a treasure trove of inspiration, uncovering the unconventional and celebrating the world's hidden wonders. The app includes breathtaking visuals and detailed accounts of 50+ destinations from the beloved Atlas Obscura book, plus three fully interactive episodes that bring these locations to life with over 45 minutes of adventure. \n\nExplore:\n1. **Winchester Mystery House** (USA): Step into the enigmatic, sprawling mansion of Sarah Winchester in San Jose, California. A place of wonder and intrigue, this spooky mega-mansion was once the home of the widow of firearms magnate William Wirt Winchester.\n2. **Salina Turda Salt Mine** (Romania): Descend into one of the world's most stunning underground formations. This awe-inspiring Romanian salt mine is a testament to human ingenuity and nature\u2019s beauty.\n3. **Temples of Damanhur** (Italy): Discover a subterranean marvel in the Italian Alps\u2014a vibrant, living laboratory for the future, created by a federation of spiritual communities.\n\nAtlas Obscura VR was originally developed and produced by Start VR (now Start Beyond) and is now part of the New Canvas immersive catalog. \n\nUPDATE - Check out the latest features:\n- Hand Tracking \u2013 Explore with just your hands; controllers still supported.\n- Better Navigation \u2013 Streamlined menus and usability updates.\n- Enhanced Visuals \u2013 Sharper models and 360\u00b0 images.\n- Optimized Performance \u2013 Bug fixes and improvements.\n", "short_description": "Atlas Obscura VR is a brilliantly captured, hi-fidelity, self-paced virtual travel experience unlike anything you have seen before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6bf4c228-12ec-404c-b6e5-afe33ab0b513", "developer_terms_of_service_url": null, "publisher_name": "New Canvas", "support_website_url": "https://discord.com/invite/U2prvwGbhA", "website_url": "https://www.newcanvas.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26049365131398737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974835_918814973548535_6573714784107970580_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXas5xsEDn0Q7kNvwF1GWBg&_nc_oc=Adpo13sRZVFNNbaxmu1xMg6aXVodhQknTCswy72eLgXQGQJ2cDmIEgg31L6xGgGcsO8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoDRIsm8WedMrb_zQlVgJS1BToHy7odeEqfFK3yKkbbQ&oe=6AC9175F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atlas Obscura VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1733878980, "lastRevision": {"nodes": [{"id": "7211065575655310", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "721
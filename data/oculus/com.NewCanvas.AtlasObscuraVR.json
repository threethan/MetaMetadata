 view up to 50 fascinating virtual articles with imagery and narration from the authors of the book.\n", "short_description": "Atlas Obscura VR is a brilliantly captured, hi-fidelity, self-paced virtual travel experience unlike anything you have seen before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6bf4c228-12ec-404c-b6e5-afe33ab0b513", "developer_terms_of_service_url": null, "publisher_name": "New Canvas", "support_website_url": null, "website_url": "https://www.newcanvas.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9068409543254228"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1229049072011633"}, {"status": "PENDING", "id": "1629171734771445"}, {"status": "PUBLISHED", "id": "1477576070183562"}, {"status": "PUBLISHED", "id": "1310237130309757"}, {"status": "PUBLISHED", "id": "773468495545738"}, {"status": "PUBLISHED", "id": "2547222068944820"}, {"status": "PUBLISHED", "id": "4302003070027293"}, {"status": "PUBLISHED", "id": "1345813673519524"}, {"status": "PUBLISHED", "id": "912330657666612"}, {"status": "PUBLISHED", "id": "735931991772215"}]}, "baseline_offer": {"id": "1310237130309757"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1229049072011633"}]}, "liveChannel": {"nodes": [{"la
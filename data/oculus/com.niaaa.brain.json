n - A Rollercoaster Ride Through Your Brain - NIAAA/NIH", "keywords": [], "long_description": "From the National Institute on Alcohol Abuse and Alcoholism (NIAAA), part of the National Institutes of Health (NIH), take a virtual rollercoaster ride through the brain to learn about alcohol's effects on the primary brain areas affected by alcohol. Stops include the prefrontal cortex, nucleus accumbens, amygdala, hippocampus, and cerebellum.", "short_description": "Hop on board a rollercoaster as it travels through the brain with stops at the primary areas affected by alcohol. At each stop, you will learn about each brain structure and how alcohol negatively affects it. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.niaaa.nih.gov/privacy#meta-app-lab", "developer_terms_of_service_url": null, "publisher_name": "NIAAA", "support_website_url": null, "website_url": "https://www.niaaa.nih.gov/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "259798166393710"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974880_3344249505835069_1062758806083066954_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qNyHmivcVYQ7kNvwE0VXnZ&_nc_oc=Adm0rP97hphJHgNaHyKjHJoB5uz-WSa_6Krh2GjH-L1HKPp1G1rOoIyNa8giTdNfZQ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuhXzMEu3IEJPPnFl930bCxta7FTo5bIBFUw5E
4.png", "id": "907943991055285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269159_907943994388618_8205726853101477458_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej_Ky4uvwVYQ7kNvwEbQD-i&_nc_oc=AdnINQD6E8KHk5wh17k38XcxSo5JQ5nv9vg4n3CDxALGhxxoa_yRV88xPUvmGx2l7uc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3IJ-jlvvjjuXogLeeV0480db4BJ0GaTdtAF5BoekBnA&oe=69AC1FE4"}, {"file_name": "Law Of Mass Experiment_Screenshot05.png", "id": "2058267867883825", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75355155_2058267871217158_4433956077496929118_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVe1qjhvPLAQ7kNvwGJKPWZ&_nc_oc=Adn298zgynb0-BpnJOZ0b19tlESA25y8T6CJJXh61q522xju3ZqGOsqOalr7krAf7CI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9alPK7n1VL15NLI2eCf0nNNLWBWyPqn9-CBnWwYcokA&oe=69AC30E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Law Of Mass_Landscape.png", "id": "307524965152422", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75429290_307524971819088_6560876650428011451_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA_CZsiM63MQ7kNvwHpu2kH&_nc_oc=Adk2K5KQlpDhzw70cXTPLSW9dRDmXlg8G1SOn7a14hmxVORU0bg2oyiElj20dmcs98M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmhAHI4GB4EgL-83kxe9_pWV5JnFHoWVUtVpmyUqpppg&oe=69AC3576"}, "display_name": "Law Of Mass Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "mass", "science", "contentsda"], "long_description": "1. take out the vivarium box\n2. place the vivariums on the four scales on both arms\n3. place a glass tube on the right two-armed scale\n4. shrink down and enter the portal to the right side of the left scale\n5. make a fire\n6. go outside through the portal \n7. observe the left scale from outside.\n8. enter the open portal to the right\n9. start a fire\n10. use the portal to go outside.\n11. go outside and observe the scales on both arms\n<Result \n- Burning wood, charcoal, and candles: Burning wood, charcoal, and candles produces water vapor and carbon dioxide.", "short_description": "Explore the fundamental principle of mass conservation in chemical reactions. This experiment demonstrates that the mass of reactants equals the mass of products, a cornerstone concept in chemistry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8522191397888545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031319_1351650025546529_6650435794833083198_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWq6Aw0kSMYQ7kNvwFKbmhm&_nc_oc=AdmtkbZospWaQQkTKONVQYiDEIF9-L2U7YLvRnM4IO5ZgiqdpGPVhRuau8mOpS5kBZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAB-i7PfgB1nuQju-LVSxytQ7C-fHhCIuWQzDZeOpHMg&oe=69AC1B56"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Law Of Mass Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"conte
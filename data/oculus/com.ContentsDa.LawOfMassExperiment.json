B8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpEAvQ8VGU4mYdHRB8A6XKYvpjpnuSzC_CgkX6pDYzhg&oe=69BC02E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Law Of Mass_Landscape.png", "id": "307524965152422", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75429290_307524971819088_6560876650428011451_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kq94OR3IUsQ7kNvwEMpsSQ&_nc_oc=Adkfn5wvw4S_36UmAFoAjQfxZAvYmOdMWJYvPN3pmkRB8v3fAb73020Nf_TSNhqEXJc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxI700fP5BNaI4-SelmKNkVAc8aLU48IdwFNl6XmALIrw&oe=69BC0776"}, "display_name": "Law Of Mass Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "mass", "science", "contentsda"], "long_description": "1. take out the vivarium box\n2. place the vivariums on the four scales on both arms\n3. place a glass tube on the right two-armed scale\n4. shrink down and enter the portal to the right side of the left scale\n5. make a fire\n6. go outside through the portal \n7. observe the left scale from outside.\n8. enter the open portal to the right\n9. start a fire\n10. use the portal to go outside.\n11. go outside and observe the scales on both arms\n<Result \n- Burning wood, charcoal, and candles: Burning wood, charcoal, and candles produces water vapor and carbon dioxide.", "short_description": "Explore the fundamental principle of mass conservation in chemical reactions. This experiment demonstrates that the mass of reactants equals the mass of products, a cornerstone concept in chemistry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id
3101477458_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnnzXQkTLiUQ7kNvwGH47TR&_nc_oc=AdnyOoBk23AQwVjWlu8k2ym1DA-BGbb5f4I6zrfa4qVUGYACkhiY6yTEdhXNr_DtTmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuJlYiIXUBfamhvW7KewJSdPa-rx6qQh7TeePcevIpXFA&oe=69A97CE4"}, {"file_name": "Law Of Mass Experiment_Screenshot05.png", "id": "2058267867883825", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75355155_2058267871217158_4433956077496929118_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziOT8LHbCoYQ7kNvwErlTQi&_nc_oc=Adk0fK0T_FfC9uhZ3JoM7rNDKbsPIthFjv47X9B2huVg_bE4GCIPrsYabnQ7bZ0cEbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv9OlShYDAfNrMgqYvWG-XWZAWy0pl3sPzs0hw3xzLOoA&oe=69A98DE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Law Of Mass_Landscape.png", "id": "307524965152422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429290_307524971819088_6560876650428011451_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0TJy-OYcqkQ7kNvwGXCwLj&_nc_oc=AdlOGcKwc-KUkRtfLvUql1odzlPr8QmQrP-0MjalPwhZzcBPopR7xdDkAtlx6uqoQiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsaN-UBSDrm7fn6_7naNZZrU-64aaXtQeAM1cwYbM8KSw&oe=69A99276"}, "display_name": "Law Of Mass Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "mass", "science", "contentsda"], "long_description": "1. take out the vivarium box\n2. place the vivariums on the four scales on both arms\n3. place a glass tube on the right two-armed scale\n4. shrink down and enter the portal to the right side of the left scale\n5. make a fire\n6. go outside through the portal \n7. observe the left scale from outside.\n8. enter the open portal to the right\n9. start a fire\n10. use the portal to go outside.\n11. go outside and observe the scales on both arms\n<Result \n- Burning wood, charcoal, and candles: Burning wood, charcoal, and candles produces water vapor and carbon dioxide.", "short_description": "Explore the fundamental principle of mass conservation in chemical reactions. This experiment demonstrates that the mass of reactants equals the mass of products, a cornerstone concept in chemistry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8522191397888545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031319_1351650025546529_6650435794833083198_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWq6Aw0kSMYQ7kNvwFpGT0D&_nc_oc=AdnIX7MfDvgom5qhQzcO0zY3DqNwbGcfn8HiDxfRGScp0GVDMs9A3VUuur_4niN2ajk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvg8s91N1v3RPc3_fO8BOx-1aptIxoW4zRFHs9_mAYonQ&oe=69A97856"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Law Of Mass Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}
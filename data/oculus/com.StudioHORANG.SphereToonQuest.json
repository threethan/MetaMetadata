oQ&oe=6A033A57"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sphere Toon - VR Comic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1599757200, "lastRevision": {"nodes": [{"id": "1169341549921710", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2479638112135074", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "518164731850682"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1072818253095357", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere Toon - \uc2a4\ud53c\uc5b4\ud230 VR \uc6f9\ud230", "keywords": ["\ub9cc\ud654", "\uc6f9\ud230", "\uc2a4\ud53c\uc5b4\ud230", "\ud638\ub791", "Webtoon"], "long_description": "VR\ub85c \ub9cc\ud654\ub97c \ubcf4\uba74 \uc5b4\ub5a4 \ub290\ub08c\uc77c\uae4c\uc694?\n360\ub3c4\ub85c \ub9cc\ud654 \uc18d \uc138\uc0c1\uc744 \ub458\ub7ec\ubcfc \uc218 \uc788\uace0,\n\uce90\ub9ad\ud130\ub4e4\uc740 \uc815\ub9d0 \uc785\uccb4\uc801\uc73c\ub85c \ub290\uaef4\uc9d1\ub2c8\ub2e4!\n\ucc28\uc6d0\uc774 \ub2e4\ub978 VR\uc6f9\ud230 \uc2a4\ud53c\uc5b4\ud230\uc744 \uacbd\ud5d8\ud558\uc138\uc694!\n\n[\uc7a5\ud3b8 \uc5f0\uc7ac\uc911]\n\ubaa9\uc695\uc758 \uc2e0 - \ud558\uc77c\uad8c\n2\ud638\uc120 \uc138\uc785\uc790 - \uc815\uc740\uacbd/\uc5ec\uc6d0\n\ud22c\uba85\ud55c \ub3d9\uac70 - \uc815\uc11c\n\uc778\uac04\uc758 \uc232 - \ud669\uc900\ud638\n\uc7ac\uc559\uc740 \ubbf8\ubb18\ud558\uac8c - \uc548\uc131\ud638\n* \uc77c\uc8fc\uc77c\uc5d0 5\ud3b8\uc529 \uc5c5\ub370\uc774\ud2b8 \uc911\uc785\ub2c8\ub2e4.\n\n[\uc7a5\ud3b8 \uc5f0\uc7ac \uc608\uc815]\n\ud0c0\uc778\uc740 \uc9c0\uc625\uc774\ub2e4 - \uae40\uc6a9\ud0a4\n\uc624\ubbfc\ud601 \ub2e8\ud3b8\uc120 - \uc624\ubbfc\ud601\n\ub450\uadfc\ub450\uadfc\ub450\uadfc\uac70\ub824 - \ud558\uc77c\uad8c\n\n[\ub2e8\ud3b8]\n\ucd08\ub2a5\ub825\uc790\uadf8\ub140 - \ud638\ub791\n\uc0d8\ud50c - \uc2dc\ub2c8/\ud600\ub178\n\uc6c0\ube44\ucc98\ub7fc - \uad8c\ud601\uc8fc\n\ubc99\ucee4\ub9e8 \uc0c1/\ud558 - \uc624\uc131\ub300\n\uc625\uc218\uc5ed \uadc0\uc2e0 - \ud638\ub791\n\ubd09\ucc9c\ub3d9 \uadc0\uc2e0 - \ud638\ub791\n\ub9c8\uc131\ud130\ub110 \uadc0\uc2e0 - \ud638\ub791\n\n* \ud55c\uad6d\uc5b4, \uc601\uc5b4, \uc77c\ubcf8\uc5b4\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4.", "short_description": "\ucd5c\uace0\uc758 VR \uc6f9\ud230 \uc571 \uc2a4\ud53c\uc5b4\ud230"}, {"images": {"nodes": []}, "id": "843711222816859", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere Toon - VR\u6f2b\u753b", "keywords": ["\u6f2b\u753b", "Manga"], "long_description": "VR\u3067\u6f2b\u753b\u3092\u8aad\u3081\u308b\u306e\u3063\u3066\u77e5\u3063\u3066\u3044\u307e\u3059\u304b\uff1f\n\u6f2b\u753b\u306e\u4e2d\u306e\u4e16\u754c\u3092360\u5ea6\u3067\u4f53\u9a13\u51fa\u6765\u3066 \u7acb\u4f53\u7684\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u3042\u306a\u305f\u3092\u304a\u5f85\u3061\u3057\u3066\u3044\u307e\u3059\uff01\n\u65b0\u3057\u3044VR\u6f2b\u753b\u30fb\u30b9\u30d4\u30a2TOON\u3092\u4f53\u9a13\u3057\u3066\u307f\u3066\u306f\u3044\u304b\u304b\u3067\u3057\u3087\u3046\u304b\uff1f\n\n\uff0a\u30a2\u30d7\u30ea\u5185\u8a00\u8a9e\u8a2d\u5b9a\u3067Korean\u3092\u9078\u629e\u3059\u308b\u3068,\u3055\u3089\u306b\u591a\u304f\u306e\u30b3\u30df\u30c3\u30af\u30b9\u304c\u3054\u89a7\u3044\u305f\u3060\u3051\u307e\u3059\u3002\n\n\uff0a\u4e0d\u5b9a\u671f\u306b\u65b0\u4f5c\u304c\u30ea\u30ea\u30fc\u30b9\u3055\u308c\u307e\u3059", "short_description": "\u65b0\u3057\u3044VR\u6f2b\u753b\u30fb\u30b9\u30d4\u30a2TOON"}, {"images": {"nodes": [{"file_name": "HeroArt.png", "id": "2629951017333305", "image_type": "APP_IMG_HERO", "uri": "https://s
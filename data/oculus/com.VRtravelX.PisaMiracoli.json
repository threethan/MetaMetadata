&_nc_ohc=_S8x1H5RPpEQ7kNvwH7bzsR&_nc_oc=AdrhOhFwWN9Tn-jalIbtNrS-MZMnO-H6qMW2hQ8kRFNMbxdEMVUSbG4BhHNXGFlNQkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdeYJlBBCjEV4gr4Gw-zfjwC2ApcwQGQx6w4uO3G1Jow&oe=6AFDC492"}, {"file_name": "screen4.png", "id": "927024192145209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036669_927024202145208_1251848554832362475_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX5o6I7MSmcQ7kNvwEM32kd&_nc_oc=AdqyT_q1CXc3TOwQpnWu8yHce4LFe6GkrR5U_5aj0ilmVNpMkf13-o_N1epJ7w4UFkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrNP7qN8Qq9TNT1TN3HWScAq_NxxV_tqao8p1EBDuAiA&oe=6AFDD502"}, {"file_name": "screen5.png", "id": "904397925117100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974551_904397928450433_2084818491724998200_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BWletgSjt0Q7kNvwF0hiAb&_nc_oc=AdqQ2aELDD7-S-4eol-oGnz77tUFVVLzG4xNBpbZ2sY7pM9EWdKceG4kfQc5rWA0Dx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXr1nIfMjm1WjRFiTEovkp6ljR9SI2zDZbq_nRQiVNxg&oe=6AFDBDAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa: Discover the Piazza dei Miracoli", "keywords": ["travel", "tourist", "sigtseeing", "pisa", "miracoli"], "long_description": "Immerse yourself in an impressive VR experience as you explore the Piazza dei Miracoli in Pisa from a tourist\u2019s perspective. Your journey begins on the iconic square, where you can admire the fascinating architecture of the Leaning Tower, Cathedral, and Baptistery. Each step across the square reveals new details of these landmarks, from intricate facades to historic symbols reflecting Pisa\u2019s rich history.\n\nAs you stroll through the square, enjoy a panoramic view of the city\u2019s major landmarks and the surrounding atmosphere. Your path takes you to the historic city wall encircling the site. Here, you gain an elevated perspective over the area, appreciating the grandeur of the buildings and the lively scene from above. Walking along the wall, you sense the unique scale and beauty of the Piazza.\n\nAfter exploring the square, you\u2019ll discover the charming market adjacent to the site. Passing through a large archway, you enter the bustling market area with stands offering local crafts and souvenirs. Every corner of the Piazza dei Miracoli offers a new view into Pisa\u2019s beauty and history.\n\nThis VR experience brings you closer to the Piazza dei Miracoli, allowing you to feel the site\u2019s spiritual and cultural significance \u2013 a journey that gives you the sense of truly being there, immersed in the city\u2019s vibrant past.\n\n#pisa #miracoli #italy #travel #tourist #sigtseeing", "short_description": "Experience the fascinating Piazza dei Miracoli in Pisa from a true tourist\u2019s perspective! This VR journey takes you through historic landmarks such as the Leaning Tower, Cathedral, and Baptistery. Walk around the square, admire these majestic structures, and explore the ancient city wall surrounding the site. Finish with a visit to the charming market through the large archway \u2013 an experience that brings Pisa\u2019s beauty and atmosphere to life as if you\u2019re truly there.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Discover-the-Piazza-dei-Miracoli", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memo
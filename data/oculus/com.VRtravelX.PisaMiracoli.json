_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bucaNuC9jW0Q7kNvwFLl9WU&_nc_oc=AdlmlQpXxfP4slEUxbF7kS7P4HxAPf9lc5UVxrCheYucx4L1f37gLUtD92ywmbAfRs4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykKXSwnR9OnYcQOHRrp8M5v9s9LYbkpv7o3GDNsMPMOQ&oe=69AEA86F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa: Discover the Piazza dei Miracoli", "keywords": ["travel", "tourist", "sigtseeing", "pisa", "miracoli"], "long_description": "Immerse yourself in an impressive VR experience as you explore the Piazza dei Miracoli in Pisa from a tourist\u2019s perspective. Your journey begins on the iconic square, where you can admire the fascinating architecture of the Leaning Tower, Cathedral, and Baptistery. Each step across the square reveals new details of these landmarks, from intricate facades to historic symbols reflecting Pisa\u2019s rich history.\n\nAs you stroll through the square, enjoy a panoramic view of the city\u2019s major landmarks and the surrounding atmosphere. Your path takes you to the historic city wall encircling the site. Here, you gain an elevated perspective over the area, appreciating the grandeur of the buildings and the lively scene from above. Walking along the wall, you sense the unique scale and beauty of the Piazza.\n\nAfter exploring the square, you\u2019ll discover the charming market adjacent to the site. Passing through a large archway, you enter the bustling market area with stands offering local crafts and souvenirs. Every corner of the Piazza dei Miracoli offers a new view into Pisa\u2019s beauty and history.\n\nThis VR experience brings you closer to the Piazza dei Miracoli, allowing you to feel the site\u2019s spiritual and cultural significance \u2013 a journey that gives you the sense of truly being there, immersed in the city\u2019s vibrant past.\n\n#pisa #miracoli #italy #travel #tourist #sigtseeing", "short_description": "Experience the fascinating Piazza dei Miracoli in Pisa from a true tourist\u2019s perspective! This VR journey takes you through historic landmarks such as the Leaning Tower, Cathedral, and Baptistery. Walk around the square, admire these majestic structures, and explore the ancient city wall surrounding the site. Finish with a visit to the charming market through the large archway \u2013 an experience that brings Pisa\u2019s beauty and atmosphere to life as if you\u2019re truly there.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Discover-the-Piazza-dei-Miracoli", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8066870946746947"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1244247120483861"}, {"status": "PUBLISHED", "id": "865373149637444"}, {"status": "PUBLISHED", "id": "852679410854182"}, {"status": "PUBLISHED", "id": "1380472936859342"}, {"status": "PUBLISHED", "id": "851759353855070"}, {"status": "PUBLISHED", "id": "767139845934740"}, {"status": "PUBLISHED", "id": "567916019296433"}, {"status": "PUBLISHED", "id": "1769218633978208"}, {"status": "PUBLISHED", "id": "592063270260339"}, {"status": "PUBLISHED", "id": "1802592793899994"}, {"status": "PUBLISHED", "id": "1222008359032568"}]}, "baseline_offer": {"
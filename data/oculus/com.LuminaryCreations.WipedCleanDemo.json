t_1.png", "id": "1936212547172651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822931_1936212550505984_8723022890565013515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXT8Al09Z9sQ7kNvwFal8i4&_nc_oc=AdpjkkV2E0jq8bqGkLGjltacyo6BFebBA6moSgfRe43IE9tAspBFRP8oDoWPd12FnRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDOMtQUg1gZrZGDbDODaJAQ9tn8njxW4-iY8JZynyJ_A&oe=6A4BA2AD"}, {"file_name": "Asylum_1.png", "id": "1428024844934230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622162_1428024848267563_7134856604135750792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGZGZHbjczoQ7kNvwEu5014&_nc_oc=AdoCBYa6NMlCUFxr_xx5nU6XQ6j-2fcbM74tQpKlSuNFlTaJ4foZ5ukiVsB7n0puUvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLim1Qd6VSDYUsWqWej4qE1SdY-S5sXS9XNrHK4d2u3w&oe=6A4BCF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560_Demo.png", "id": "811233928114985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822779_811233931448318_6656375589413651573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3T9VltBYUwQ7kNvwHBI74g&_nc_oc=AdrSJoB0zsaHOvDy8uXkPGbvEQNoyVScrjZ4QdjF0nLA3uFLtqM99MvusdxrWELUIKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_d-wYdRGqRNMNEyr2Iqe2_cAZEiqRAAeeCCn0c2irug&oe=6A4BB3F3"}, "display_name": "Wiped Clean Demo", "keywords": ["wipedclean", "horror", "cleaninggame", "cleaningsimulator", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{2013386939489875}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{1196365369217633}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1590290165715389}\n\nHere\u2019s the part that gets sticky: You\u2019re deep undercover.\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{634067086310658}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{1775864393046193}\n\n**Wiped Clean is OUT NOW**: https://www.meta.com/experiences/wiped-clean/7821594727952674/\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n", "short_description": "You play as an undercover agent who is cleaning crime scenes and secretly collecting evidence to capture the ruthless hitman. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24734695662825569"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.
t_1.png", "id": "1936212547172651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822931_1936212550505984_8723022890565013515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9nr11zrUDcQ7kNvwEkMgnm&_nc_oc=Adp-p2S_b6k7waI9z1v2SkB46hHvaqhmC3DHPVbx7-K54oZpzaF2YOi2pzYmLK49h2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7CLcZKhbHV7wsxx5q8ObN1bDHxUCRUSG4faAWN-Wqfg&oe=6A635DAD"}, {"file_name": "Asylum_1.png", "id": "1428024844934230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622162_1428024848267563_7134856604135750792_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gv20FcV8VmQQ7kNvwET2r_j&_nc_oc=AdpwYn71w7EDPMHvJ3C8bGIugF7E9008QfBHyjTIjnLWszRpDi7VoJQoxUQZ_bxKm1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbbUU8al0B1O1nEqJ-qIEwE21Npl5MEOwRRBQcuuT4HQ&oe=6A63521D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560_Demo.png", "id": "811233928114985", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822779_811233931448318_6656375589413651573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idErEc7WCg4Q7kNvwEVvBDe&_nc_oc=Adr7mTsEQVob0cY6bfiraH5jiSWWT6JNGQ60FkY7Gp61498cvnkkaPfIXytfjWZnke8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGXP7_37_hSxBCA1lKCxCtnshRj_s8cVFojdy3_bN4sw&oe=6A636EF3"}, "display_name": "Wiped Clean Demo", "keywords": ["wipedclean", "horror", "cleaninggame", "cleaningsimulator", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{2013386939489875}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{1196365369217633}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1590290165715389}\n\nHere\u2019s the part that gets sticky: You\u2019re deep undercover.\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{634067086310658}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{1775864393046193}\n\n**Wiped Clean is OUT NOW**: https://www.meta.com/experiences/wiped-clean/7821594727952674/\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n", "short_description": "You play as an undercover agent who is cleaning crime scenes and secretly collecting evidence to capture the ruthless hitman. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24734695662825569"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
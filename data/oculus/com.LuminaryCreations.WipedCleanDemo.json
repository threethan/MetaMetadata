YPieOOg5V4_BuPlqhrSVk7xtaj44rTo_TEQ2yUOA75iT2YjgDMGbRpmh13qc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZ8UNUkHrHPJwu2FoFEazRlzKKAj-xYspbIg2JCVSv_w&oe=6B0DA955"}, {"file_name": "Forest_1.png", "id": "1936212547172651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822931_1936212550505984_8723022890565013515_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8IKPIdm1Z0Q7kNvwGjtZju&_nc_oc=AdrhyIzkCU02Plqw3b1EWZ0OhVvyxwL0jl4G9pyYR_D4-2wn3sVMg_lorD9Z_i-kUeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1rIZsq5RV9iZ0-k5iPCBdF53cJPzBDGO_o05k_fbEhA&oe=6B0DA76D"}, {"file_name": "Asylum_1.png", "id": "1428024844934230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622162_1428024848267563_7134856604135750792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk-xzXcFhiwQ7kNvwG5eWvf&_nc_oc=AdooEaBw5YuSDnAOeC830p-bQlnjbM_0PLjyO8_hQJr5ajen1Qg31RCMNC-1EsHqgx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIfOPRmtuFkIH7HTQJk4TdXUseoVOI2rcmJ3gtITTC4A&oe=6B0D9BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560_Demo.png", "id": "811233928114985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822779_811233931448318_6656375589413651573_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7UoWoFX21IQ7kNvwHdn2BY&_nc_oc=Ado8njI7SKkjNoU6eORkVfyIdLLV4gssl0f80TCe9dSN2oLguzi-hZJO6EuB2pNQWPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPmSB80MWdb8us3G2zUKxXVb7HUzGN8hXCSWDPROuvxQ&oe=6B0DB8B3"}, "display_name": "Wiped Clean Demo", "keywords": ["wipedclean", "horror", "cleaninggame", "cleaningsimulator", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{2013386939489875}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{1196365369217633}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1590290165715389}\n\nHere\u2019s the part that gets sticky: You\u2019re deep undercover.\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{634067086310658}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{1775864393046193}\n\n**Wiped Clean is OUT NOW**: https://www.meta.com/experiences/wiped-clean/7821594727952674/\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n", "short_description": "You play as an undercover agent who is cleaning crime scenes and secretly collecting evidence to capture the ruthless hitman. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
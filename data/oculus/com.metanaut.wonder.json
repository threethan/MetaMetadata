7kNvwEUcMHC&_nc_oc=Adro0ESg9ZRufrGWXTLdlxmhg120ZZr27Rtvo_3KOJ2s6fzQV7BXo1ai163pS5xOk34&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa9Xrn_Zr_eSurcRA_cXRNWaTCWbPA7WVCGJ0-YUfrVw&oe=6A804C80"}, {"file_name": "Wonder - Temporary Store Screenshots - Parallel Worlds - Dots.png", "id": "3969089796752099", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391923_3969089806752098_1690049853259132529_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H11lQNLi058Q7kNvwFh5_pr&_nc_oc=Adq0X3JJdM5yWQxKeYijs3EVgOKO1wM5ky2zaNMadaK6A-7TuzCY4VKlwc2q6fswnXQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpo6y-_vlCV3-RV-FSapPv3XNT3nvc__R3TYv2QKQ_FQ&oe=6A8054F3"}, {"file_name": "Wonder - Temporary Store Screenshots - Parallel Worlds - Dream.png", "id": "1698380884417772", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393579_1698380887751105_6509907783143349607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t3hc4tIUvAQ7kNvwEPr2iQ&_nc_oc=AdqWFK1Swp4oqOftZXUhtffJ-Ku6YATmrOMDy1PqkGFqLKuGjYDx4Y3840k5sFenbqo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWNNMF0d20JKIo-Ah_WukTiQHKD9Mb95o7jLCvCAZESw&oe=6A803C21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wonder", "keywords": [], "long_description": "**Wonder is an anthology of beautiful experiments in delight and wonder.**\n\nDiscover three stunning experiences that bring magic to your everyday space. Perfect for newcomers and VR enthusiasts looking for a moment of calm wonder.\n\n\u26f0\ufe0f ANCIENT RUINS - Your room transforms into a mysterious cave, its cloak of darkness torn away by a sudden unveiling of brilliant sky.\n\n\ud83c\udf0a JELLYFISH BLOOM - Transform your room into a breathtaking deep-sea spectacle with a radiant ballet of bioluminescent jellyfish.\n\n\ud83d\udd73\ufe0f PARALLEL WORLDS - Step through reality-bending portals and experience what your world would look like if it turned into ice, sand, dots, and more!\n\n\n\u26a0\ufe0f Please note: This is a hand-tracked 20-minute experience. Want more? Simply scan a new environment. Each new environment creates a fresh experience as the worlds adapt to your space.\n\nCreated by the award-winning XR studio, Metanaut.", "short_description": "Wonder is an anthology of beautiful experiments in delight and wonder. Discover three stunning experiences that bring magic to your everyday space. Perfect for newcomers and VR enthusiasts looking for a moment of calm wonder.\n\nJourney through:\n\u2022 Ancient Ruins \n\u2022 Jellyfish Bloom\n\u2022 Parallel Worlds\n\nCreated by the award-winning XR studio, Metanaut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://metanautlabs.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Metanaut", "support_website_url": null, "website_url": "https://metanautlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9825970260764408"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1082030570628221"}, {"status": "PUBLISHED", "id": "4020746058211084"}, {"status": "PUBLISHED", "id": "986549946783694"}, {"status": "PUBLISHED", "id": "621975087120646"}, {"status": "PUBLISHED", "id": "584194944636166"}, {"status": "PUBLISHED", "id": "1332216817979948"}, {"status": "PUBLISHED", 
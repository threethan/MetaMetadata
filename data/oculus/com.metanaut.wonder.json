7kNvwHzd4Zx&_nc_oc=Adqhev0SI6nFTHiToCZgNeKZnWYFlS4LK9DS-M7T81TaJtpD_UtXDHLKNpgZVY4McjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi8j83aaz4K0BT1hPiNb79k9zlbOOXW0x7hqb98gBShA&oe=6A898700"}, {"file_name": "Wonder - Temporary Store Screenshots - Parallel Worlds - Dots.png", "id": "3969089796752099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391923_3969089806752098_1690049853259132529_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0HDwfEPqcMQ7kNvwEWSgUs&_nc_oc=Adoazco1voAhvW3cIP4HlGI830TEQY6MTb5FkZya8Fv2tWmyfCm1DDmGXCiXjJG_CBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0dp357lVyyZ5L9_KBCr386TV4DBA01dDwW542YLM6Zw&oe=6A898F73"}, {"file_name": "Wonder - Temporary Store Screenshots - Parallel Worlds - Dream.png", "id": "1698380884417772", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393579_1698380887751105_6509907783143349607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC3H92CgoVMQ7kNvwFDZMk0&_nc_oc=AdqPsVeufj_2-jJAdBlZGRHXAd4w4RFDNI6LCeOaQVtGcx1ymNyDyS21qq5OXsZhsDU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz-fZjuDBc-2Az6DsJ8wq4IoXtUol96fDBFF9EbqfB_Q&oe=6A8976A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wonder", "keywords": [], "long_description": "**Wonder is an anthology of beautiful experiments in delight and wonder.**\n\nDiscover three stunning experiences that bring magic to your everyday space. Perfect for newcomers and VR enthusiasts looking for a moment of calm wonder.\n\n\u26f0\ufe0f ANCIENT RUINS - Your room transforms into a mysterious cave, its cloak of darkness torn away by a sudden unveiling of brilliant sky.\n\n\ud83c\udf0a JELLYFISH BLOOM - Transform your room into a breathtaking deep-sea spectacle with a radiant ballet of bioluminescent jellyfish.\n\n\ud83d\udd73\ufe0f PARALLEL WORLDS - Step through reality-bending portals and experience what your world would look like if it turned into ice, sand, dots, and more!\n\n\n\u26a0\ufe0f Please note: This is a hand-tracked 20-minute experience. Want more? Simply scan a new environment. Each new environment creates a fresh experience as the worlds adapt to your space.\n\nCreated by the award-winning XR studio, Metanaut.", "short_description": "Wonder is an anthology of beautiful experiments in delight and wonder. Discover three stunning experiences that bring magic to your everyday space. Perfect for newcomers and VR enthusiasts looking for a moment of calm wonder.\n\nJourney through:\n\u2022 Ancient Ruins \n\u2022 Jellyfish Bloom\n\u2022 Parallel Worlds\n\nCreated by the award-winning XR studio, Metanaut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://metanautlabs.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Metanaut", "support_website_url": null, "website_url": "https://metanautlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9825970260764408"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1082030570628221"}, {"status": "PUBLISHED", "id": "4020746058211084"}, {"status": "PUBLISHED", "id": "986549946783694"}, {"status": "PUBLISHED", "id": "621975087120646"}, {"status": "PUBLISHED", "id": "584194944636166"}, {"status": "PUBLISHED", "id": "1332216817979948"}, {"status": "PUBLISHED", 
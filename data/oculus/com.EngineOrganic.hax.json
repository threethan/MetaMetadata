scdn.com&_nc_ss=7f20f&oh=00_AQTlX3i-8c4XsQBS7dhNr7g6Jwbs1cXPfkdVLL2cXcsahQ&oe=6AFB4C84"}, {"file_name": "HAX_ScreenShot_10.png", "id": "554673847488696", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75572753_554673850822029_5104881047344863277_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0DgpbpwQRkQ7kNvwFyw1fN&_nc_oc=AdqOhGFAPhNGTwlANDATixNtpSUrDIFVx97dZqr9FgnDJQJ6cxFWr8Ee8_qGtVR3Oh8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwYfWt5U5Ok_5eWywpjY2N9n49MrU_CVmvN87x_rLytQ&oe=6AFB1B4F"}, {"file_name": "HAX_ScreenShot_12.png", "id": "491938096836472", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982674_491938100169805_1914676544074423092_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP-0IE2h-RIQ7kNvwGeKugF&_nc_oc=AdqeV3g2WryJsHRNS-uqLTLVJX8pqOPtFdPBDHYTdTeAVn_uJ_2LbClsUgNlPju3sX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE2ZqnDd5iB0NZZjzxEJrdbaV2kXVzGfmRiYY1lrwGTw&oe=6AFB39C2"}, {"file_name": "HAX_ScreenShot_07.png", "id": "576899548655739", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392305_576899551989072_804058002444659977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1GwW4t_fwsQ7kNvwGT4xbz&_nc_oc=Adr9irZx5Cijn_sNzCFu5icXA_ZgdFKzh_Ve397xgpyaq4ty35mzeJR8A5pwbevjWaw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVXNz0ow-C3HZv8zd--y2BaArn7ZV4iKcXW-iO9_frDQ&oe=6AFB4716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HAX_Meta_COVER_LANDSCAPE.png", "id": "600146542767651", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392148_600146546100984_9219538178642778160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qevsIcShHAEQ7kNvwEooT0Q&_nc_oc=Adql3exHfNhcKos4rRWDhb_4nJVxbCjyrUY5CBDyFgBZZ0CIPyfqogXCdSUYWlWdWj4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHzUwXFypo_X6M6S7gJ_mQt5felS8Etjh9KLrn0TUesA&oe=6AFB1D20"}, "display_name": "HAX", "keywords": ["Multiplayer", "Shooter", "Robots", "scifi"], "long_description": "Future Earth is a dystopian battleground. Robots are at war with each other. Play as a Sentient Intelligent robot in this fast-paced, multiplayer shooter.\n\nBuilt from the ground up, specifically for Mobile VR, HAX offers highly intuitive controls, groundbreaking weapon mechanics, super-sampled graphics, and dedicated servers. Customize your weapons, attachments, characters, camos and more. Earn your rank insignia and wear it for all to see as you climb your way to the top of the leaderboards.\n\nHumans have mysteriously disappeared leaving two warring, robot factions; The UNR (United Nations Robotics), a peace keeping division who will stop at nothing, they will even use force to spread peace; and the 404, a corrupt military group spreading their infectious code.\n\nWhat is HAX? It\u2019s a radioactive, programmable gas used to power weapons and hack other robots by firing data packets. One simple HAX Mag can be loaded into a firearm, turned into a sword, thrown as a grenade, or used to hack objectives and other players. This all-in-one Mag makes HAX incredibly easy to learn and fun to play.", "short_description": "Battle robots with digital weapons in this multiplayer, arena shooter. Earn your rank, unlock new weapons and attachments, customize your character, hack the enemy, and wield an array of light-swords. With ground-breaking weapon mechanics, HAX brings something new to VR shooters, while staying true to one of the greatest game genres of all time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": "https://www.engineorganic.com/hax-eula", "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/hax", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
om&_nc_ss=8&oh=00_AfzsFEi9AY06H0OuDWvdrgA_qNiTJde1pFM83jlztlJLCA&oe=69AFFA8F"}, {"file_name": "HAX_ScreenShot_12.png", "id": "491938096836472", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_491938100169805_1914676544074423092_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqto4ue3z50Q7kNvwGIsm4d&_nc_oc=Adnjea2J91ZMR-uW57gz0Q19-ymnRhCFr1rfd0b2WB836CAkBjtco9-Md6pQEWx7QHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYq_NbnWGn-FDXyhVtv8jN-rdJ2gy5OjTSeQXSxwR9Xw&oe=69B01902"}, {"file_name": "HAX_ScreenShot_07.png", "id": "576899548655739", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_576899551989072_804058002444659977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVH_SStiyRoQ7kNvwGjdCxR&_nc_oc=AdnK64rqLo0OLLFZtoc3rb67Vhzn9zsxhKVOv3KvJyba2zXaU9SBGdRqgJkmyBO9d44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFn1PcnQnZ9lJ7iWrEpwimSJbXMAUKWd18LRtEkhxt3g&oe=69B02656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HAX_Meta_COVER_LANDSCAPE.png", "id": "600146542767651", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392148_600146546100984_9219538178642778160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRNtzK-TUIUQ7kNvwFwzjmr&_nc_oc=Adk3VASZmYChHc6MQaNhkAWsraTiEtW77ooQcdeTGPPaKxDZNRj53Z1b51dWpPmPeR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiORiLOwkzsvdNRljoVCJg5K8Ud7FyUMlk6NH888eRzQ&oe=69AFFC60"}, "display_name": "HAX", "keywords": ["Multiplayer", "Shooter", "Robots", "scifi"], "long_description": "Future Earth is a dystopian battleground. Robots are at war with each other. Play as a Sentient Intelligent robot in this fast-paced, multiplayer shooter.\n\nBuilt from the ground up, specifically for Mobile VR, HAX offers highly intuitive controls, groundbreaking weapon mechanics, super-sampled graphics, and dedicated servers. Customize your weapons, attachments, characters, camos and more. Earn your rank insignia and wear it for all to see as you climb your way to the top of the leaderboards.\n\nHumans have mysteriously disappeared leaving two warring, robot factions; The UNR (United Nations Robotics), a peace keeping division who will stop at nothing, they will even use force to spread peace; and the 404, a corrupt military group spreading their infectious code.\n\nWhat is HAX? It\u2019s a radioactive, programmable gas used to power weapons and hack other robots by firing data packets. One simple HAX Mag can be loaded into a firearm, turned into a sword, thrown as a grenade, or used to hack objectives and other players. This all-in-one Mag makes HAX incredibly easy to learn and fun to play.", "short_description": "Battle robots with digital weapons in this multiplayer, arena shooter. Earn your rank, unlock new weapons and attachments, customize your character, hack the enemy, and wield an array of light-swords. With ground-breaking weapon mechanics, HAX brings something new to VR shooters, while staying true to one of the greatest game genres of all time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": "https://www.engineorganic.com/hax-eula", "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/hax", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_m
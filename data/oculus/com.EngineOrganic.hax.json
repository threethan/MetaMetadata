scdn.com&_nc_ss=7f30f&oh=00_AQUBkrlemZvWPMyD98lkjqBFe-Clo7DClUET8lU598Ao9w&oe=6B0F1304"}, {"file_name": "HAX_ScreenShot_10.png", "id": "554673847488696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572753_554673850822029_5104881047344863277_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hMr6MA-S4sQ7kNvwGlvjuJ&_nc_oc=Adqa5RsYTh_rgFmPGpnRm-JJFChLNZumfKf-1YF5TTXRBRKpqJB9Avzly4Sfbx_paaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXs2ywJDsMDtFYd2RYsRYaVFL_4_kQxoEU4MRqKxoIP7Q&oe=6B0F1A0F"}, {"file_name": "HAX_ScreenShot_12.png", "id": "491938096836472", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982674_491938100169805_1914676544074423092_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQgNopsEa1QQ7kNvwH5VEse&_nc_oc=AdrYl0nUMoARwParpmA3YfGh0DRXCAjdI_Ga4Dv5XmhMHN_ts2_V6x3mmSrJoN1gwDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXT9cXX3PE887AcOev2C-SIanQ5o9hsJXjKfdHyXRK_0w&oe=6B0F0042"}, {"file_name": "HAX_ScreenShot_07.png", "id": "576899548655739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392305_576899551989072_804058002444659977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAo4cpzhT8sQ7kNvwEVAlBd&_nc_oc=AdrKRUU9Ve0YbSEKDGFESIdaXHWgZDXv7Y9pgI-QTV0TlXLBbw9NwArxiQNPnduovu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUa88XelRS5c6lAIldEBddqS2eyZVdM7Q5NWA41dP6ERQ&oe=6B0F0D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HAX_Meta_COVER_LANDSCAPE.png", "id": "600146542767651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392148_600146546100984_9219538178642778160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnXv0bnfIJ0Q7kNvwFRwJY6&_nc_oc=AdrW4yiKbcorIB1xWVHyEMO3rXey3GatmhSB8PW0R3n9A_SC_uRXdIrFOKfbDwNPwaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFJPk6JtZt35rVXj9lHx9hPWkmYpfy8stTBw-VXYtWlA&oe=6B0F1BE0"}, "display_name": "HAX", "keywords": ["Multiplayer", "Shooter", "Robots", "scifi"], "long_description": "Future Earth is a dystopian battleground. Robots are at war with each other. Play as a Sentient Intelligent robot in this fast-paced, multiplayer shooter.\n\nBuilt from the ground up, specifically for Mobile VR, HAX offers highly intuitive controls, groundbreaking weapon mechanics, super-sampled graphics, and dedicated servers. Customize your weapons, attachments, characters, camos and more. Earn your rank insignia and wear it for all to see as you climb your way to the top of the leaderboards.\n\nHumans have mysteriously disappeared leaving two warring, robot factions; The UNR (United Nations Robotics), a peace keeping division who will stop at nothing, they will even use force to spread peace; and the 404, a corrupt military group spreading their infectious code.\n\nWhat is HAX? It\u2019s a radioactive, programmable gas used to power weapons and hack other robots by firing data packets. One simple HAX Mag can be loaded into a firearm, turned into a sword, thrown as a grenade, or used to hack objectives and other players. This all-in-one Mag makes HAX incredibly easy to learn and fun to play.", "short_description": "Battle robots with digital weapons in this multiplayer, arena shooter. Earn your rank, unlock new weapons and attachments, customize your character, hack the enemy, and wield an array of light-swords. With ground-breaking weapon mechanics, HAX brings something new to VR shooters, while staying true to one of the greatest game genres of all time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": "https://www.engineorganic.com/hax-eula", "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/hax", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
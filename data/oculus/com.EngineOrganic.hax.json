4FCh6caqRL8oeNe2GdEk8K8w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJinXKo_tobJ0haXF7mRra__G4xEIwsBsL6Gmpfk_xf4w&oe=6AA4184F"}, {"file_name": "HAX_ScreenShot_12.png", "id": "491938096836472", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982674_491938100169805_1914676544074423092_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAEvY5-MhFoQ7kNvwHeWupc&_nc_oc=AdqIL69F5BNF5qHP_mIMorGLVo2USQ1wu9vkJ6J8GGwMJIOfrauAo9g-4pzmqIfeQUs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfhEdV4Ko_fH7BOb6NpW7m2sbC3xgPx-127h7seAXTwA&oe=6AA3FE82"}, {"file_name": "HAX_ScreenShot_07.png", "id": "576899548655739", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392305_576899551989072_804058002444659977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik4hZS018HUQ7kNvwGasENq&_nc_oc=AdrA8r5e0kVCcHKvDFAPLdJR4Cj_tP9T8GRQp2TeNSWWlpcXZNVK2Zm8XUVSPoJ8StI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCSdE2KuHBKEzYqIP_oCTU5WIkQ_kSiTMl5MAMCLYO8w&oe=6AA40BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HAX_Meta_COVER_LANDSCAPE.png", "id": "600146542767651", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392148_600146546100984_9219538178642778160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c5qxE6-X3kQ7kNvwE0BLWH&_nc_oc=AdrnKm9Te3spthQafP7RsKkmS5Ea2BGl7YOMnQubVwKEi0FiRhm5JD70Co9mR6If5ac&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVz2Vkjcox6YuR-TNBIlSf0DezsdMEDR3aV-GchlqYUg&oe=6AA41A20"}, "display_name": "HAX", "keywords": ["Multiplayer", "Shooter", "Robots", "scifi"], "long_description": "Future Earth is a dystopian battleground. Robots are at war with each other. Play as a Sentient Intelligent robot in this fast-paced, multiplayer shooter.\n\nBuilt from the ground up, specifically for Mobile VR, HAX offers highly intuitive controls, groundbreaking weapon mechanics, super-sampled graphics, and dedicated servers. Customize your weapons, attachments, characters, camos and more. Earn your rank insignia and wear it for all to see as you climb your way to the top of the leaderboards.\n\nHumans have mysteriously disappeared leaving two warring, robot factions; The UNR (United Nations Robotics), a peace keeping division who will stop at nothing, they will even use force to spread peace; and the 404, a corrupt military group spreading their infectious code.\n\nWhat is HAX? It\u2019s a radioactive, programmable gas used to power weapons and hack other robots by firing data packets. One simple HAX Mag can be loaded into a firearm, turned into a sword, thrown as a grenade, or used to hack objectives and other players. This all-in-one Mag makes HAX incredibly easy to learn and fun to play.", "short_description": "Battle robots with digital weapons in this multiplayer, arena shooter. Earn your rank, unlock new weapons and attachments, customize your character, hack the enemy, and wield an array of light-swords. With ground-breaking weapon mechanics, HAX brings something new to VR shooters, while staying true to one of the greatest game genres of all time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": "https://www.engineorganic.com/hax-eula", "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/hax", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_
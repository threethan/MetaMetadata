scdn.com&_nc_ss=7f20f&oh=00_AQS6Tc5zV_O-kQUB4fao5NsgZCsxWfrXJJjxbv3lpqSdkw&oe=6AFF08C4"}, {"file_name": "HAX_ScreenShot_10.png", "id": "554673847488696", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75572753_554673850822029_5104881047344863277_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHnpNaLapZQQ7kNvwGJ-4Md&_nc_oc=AdpjOx4mrHoL42IFewJcyj1-VWvwnplm78I8msm-gpq0bVi93ZnAbQ7ySMu7uQmRtmI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ13zn-ChZQqusiQyFkU8Y3KiwGEJ3CDBj52UaBQCX2VA&oe=6AFF0FCF"}, {"file_name": "HAX_ScreenShot_12.png", "id": "491938096836472", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982674_491938100169805_1914676544074423092_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9eRL6HQuagQ7kNvwHYeb_u&_nc_oc=AdoCpH1wCnStgenGNp81mEdB9S_jy3q_0mU0XKKFIR9_YiV8NvPT-U8qbsMyKHQK6yo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSapFPpP0WsPYIbBQg_STdMCaWJ5btLxnYCNPayx5RqLw&oe=6AFF2E42"}, {"file_name": "HAX_ScreenShot_07.png", "id": "576899548655739", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392305_576899551989072_804058002444659977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpd_jaqee2QQ7kNvwHTXgaC&_nc_oc=AdrZU_q6FcjbkbIgHTcPUBF740cV_TtmgDN3GNXxoqz8G3RoeiALqz6GFJ5I0b0a634&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmLRswRSRD9mBdSZykE1nNUpGVc1YfitjsU91P5FPsJA&oe=6AFF0356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HAX_Meta_COVER_LANDSCAPE.png", "id": "600146542767651", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392148_600146546100984_9219538178642778160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HI4FvkSKs_UQ7kNvwGIhOD9&_nc_oc=AdqXeFNp3TcJyxzcjSaa6bDsbIyKF11MnrEB_L1tOGteQPE-5B0jU8KMgVD0F2AxHow&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRatMS39sXBYN4wizE5ZTWjLl8uYGU2phvwXo2FXzrlEg&oe=6AFF11A0"}, "display_name": "HAX", "keywords": ["Multiplayer", "Shooter", "Robots", "scifi"], "long_description": "Future Earth is a dystopian battleground. Robots are at war with each other. Play as a Sentient Intelligent robot in this fast-paced, multiplayer shooter.\n\nBuilt from the ground up, specifically for Mobile VR, HAX offers highly intuitive controls, groundbreaking weapon mechanics, super-sampled graphics, and dedicated servers. Customize your weapons, attachments, characters, camos and more. Earn your rank insignia and wear it for all to see as you climb your way to the top of the leaderboards.\n\nHumans have mysteriously disappeared leaving two warring, robot factions; The UNR (United Nations Robotics), a peace keeping division who will stop at nothing, they will even use force to spread peace; and the 404, a corrupt military group spreading their infectious code.\n\nWhat is HAX? It\u2019s a radioactive, programmable gas used to power weapons and hack other robots by firing data packets. One simple HAX Mag can be loaded into a firearm, turned into a sword, thrown as a grenade, or used to hack objectives and other players. This all-in-one Mag makes HAX incredibly easy to learn and fun to play.", "short_description": "Battle robots with digital weapons in this multiplayer, arena shooter. Earn your rank, unlock new weapons and attachments, customize your character, hack the enemy, and wield an array of light-swords. With ground-breaking weapon mechanics, HAX brings something new to VR shooters, while staying true to one of the greatest game genres of all time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": "https://www.engineorganic.com/hax-eula", "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/hax", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
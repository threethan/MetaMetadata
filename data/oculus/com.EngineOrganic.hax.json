scdn.com&_nc_ss=7f20f&oh=00_AQR4BBf7cna4AD9gN8T2aN19tnAHNlXOC89wgXeHu2wndA&oe=6B033584"}, {"file_name": "HAX_ScreenShot_10.png", "id": "554673847488696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572753_554673850822029_5104881047344863277_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcklJb2XIIcQ7kNvwHQW-F0&_nc_oc=AdoRGAc1NLq4Ibi87FFnA0fqE5lvu4ohqURM_sgLvjubN74Jy8vddf0hXD9yy77qTJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGyFoaF9m3jq9bMgeW1hcvUnZtrS36j9Z1nQa0kizK7A&oe=6B03044F"}, {"file_name": "HAX_ScreenShot_12.png", "id": "491938096836472", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_491938100169805_1914676544074423092_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAicbCAhwE8Q7kNvwFFgJJy&_nc_oc=AdrPTs4t-2_YkOhM2nd1D8kuJnx-M9WjEe_6U8PrSakzUS8RsT0EIE6lpupSH_6F1W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbgBsGByeua0iVqMI51oWlKaxbPzLQd7TGgsaBPWgq0w&oe=6B0322C2"}, {"file_name": "HAX_ScreenShot_07.png", "id": "576899548655739", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392305_576899551989072_804058002444659977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvJHqxKuSPEQ7kNvwGM6FLT&_nc_oc=AdqmXbyUG7hadezyG3ZbzDixm2Z0hXSpKZlzoYfSsdYT7FJjdZHZpoFOXMyTORzwRuk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8RRPaeiGCv241A4_gGcjIpXdad7gwtXn0F-ihju1y8w&oe=6B033016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HAX_Meta_COVER_LANDSCAPE.png", "id": "600146542767651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392148_600146546100984_9219538178642778160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4XaX7x3k7YQ7kNvwGa8X8b&_nc_oc=Adrllrj3fIRBpm1TnGrmdW4iVqcgH-HRUqAUGrPhxSwdt3GDuQLreBH-JxT6ewJUfio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN6w80Eyq9VjHcCr1pNu6JtOlIm0Z89ha49-VjTKtE-A&oe=6B030620"}, "display_name": "HAX", "keywords": ["Multiplayer", "Shooter", "Robots", "scifi"], "long_description": "Future Earth is a dystopian battleground. Robots are at war with each other. Play as a Sentient Intelligent robot in this fast-paced, multiplayer shooter.\n\nBuilt from the ground up, specifically for Mobile VR, HAX offers highly intuitive controls, groundbreaking weapon mechanics, super-sampled graphics, and dedicated servers. Customize your weapons, attachments, characters, camos and more. Earn your rank insignia and wear it for all to see as you climb your way to the top of the leaderboards.\n\nHumans have mysteriously disappeared leaving two warring, robot factions; The UNR (United Nations Robotics), a peace keeping division who will stop at nothing, they will even use force to spread peace; and the 404, a corrupt military group spreading their infectious code.\n\nWhat is HAX? It\u2019s a radioactive, programmable gas used to power weapons and hack other robots by firing data packets. One simple HAX Mag can be loaded into a firearm, turned into a sword, thrown as a grenade, or used to hack objectives and other players. This all-in-one Mag makes HAX incredibly easy to learn and fun to play.", "short_description": "Battle robots with digital weapons in this multiplayer, arena shooter. Earn your rank, unlock new weapons and attachments, customize your character, hack the enemy, and wield an array of light-swords. With ground-breaking weapon mechanics, HAX brings something new to VR shooters, while staying true to one of the greatest game genres of all time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": "https://www.engineorganic.com/hax-eula", "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/hax", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
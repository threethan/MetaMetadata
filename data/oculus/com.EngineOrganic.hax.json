bUUHigrD4vnw7FpJxE9xY6b4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xKHwNlQQu4_8Ijd6ZXGD3DyWf9g0LofmvXkhp9DZskQ&oe=6A467DCF"}, {"file_name": "HAX_ScreenShot_12.png", "id": "491938096836472", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982674_491938100169805_1914676544074423092_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM2DIqHp7-IQ7kNvwFifcju&_nc_oc=Adrszhy8RceOU_X_NabUTVb8475KUGCOWHXmrdm7xDyfv3WJtWe0j2j-5xjfpNO_Aus&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g-LP6HLuTMtypmFrE0O94VYeCheBVZRoD9QaZs-XdrQ&oe=6A466402"}, {"file_name": "HAX_ScreenShot_07.png", "id": "576899548655739", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392305_576899551989072_804058002444659977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diN1tzN_eocQ7kNvwHnrtUy&_nc_oc=AdpiHegfZvH2wJ3_ctNfsWhHbtlP4F0lU6sLtyQn_2BRKYh10fUrpm_zM_N8iF_jh_k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MDwCnN_Cfzp9ASY2bZ5PnduALFOjMOP_YRKICFXx7Qw&oe=6A467156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HAX_Meta_COVER_LANDSCAPE.png", "id": "600146542767651", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392148_600146546100984_9219538178642778160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5xEz0B0lo0Q7kNvwE2Fd_K&_nc_oc=Adrx2dTAdP9TqIDbR5x3Bj4xkSeGeB5QEhBrHeqy8VJffy0OdQ64p29UyWR998YOZos&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ag8dkCZ_HajuKfWIxFk58apWp3MGChi4P1CKXQQFHQg&oe=6A467FA0"}, "display_name": "HAX", "keywords": ["Multiplayer", "Shooter", "Robots", "scifi"], "long_description": "Future Earth is a dystopian battleground. Robots are at war with each other. Play as a Sentient Intelligent robot in this fast-paced, multiplayer shooter.\n\nBuilt from the ground up, specifically for Mobile VR, HAX offers highly intuitive controls, groundbreaking weapon mechanics, super-sampled graphics, and dedicated servers. Customize your weapons, attachments, characters, camos and more. Earn your rank insignia and wear it for all to see as you climb your way to the top of the leaderboards.\n\nHumans have mysteriously disappeared leaving two warring, robot factions; The UNR (United Nations Robotics), a peace keeping division who will stop at nothing, they will even use force to spread peace; and the 404, a corrupt military group spreading their infectious code.\n\nWhat is HAX? It\u2019s a radioactive, programmable gas used to power weapons and hack other robots by firing data packets. One simple HAX Mag can be loaded into a firearm, turned into a sword, thrown as a grenade, or used to hack objectives and other players. This all-in-one Mag makes HAX incredibly easy to learn and fun to play.", "short_description": "Battle robots with digital weapons in this multiplayer, arena shooter. Earn your rank, unlock new weapons and attachments, customize your character, hack the enemy, and wield an array of light-swords. With ground-breaking weapon mechanics, HAX brings something new to VR shooters, while staying true to one of the greatest game genres of all time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": "https://www.engineorganic.com/hax-eula", "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/hax", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_
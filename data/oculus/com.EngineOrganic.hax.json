scdn.com&_nc_ss=7f20f&oh=00_AQShc90VPCxzaoagsdmxz4ndNGXUT8X98K9rPN42p4cVig&oe=6B048704"}, {"file_name": "HAX_ScreenShot_10.png", "id": "554673847488696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572753_554673850822029_5104881047344863277_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcklJb2XIIcQ7kNvwF6Z7g7&_nc_oc=AdrIUXGi2NJwdtGvbCqD1e-YDfRy2WysOv3F9zw8jBECh84sBINAie395QsSFK7JZBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_m0vsG-fzVaaHiLTabIe1oZtMC5sEL7Yc9yavdbbL0A&oe=6B0455CF"}, {"file_name": "HAX_ScreenShot_12.png", "id": "491938096836472", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982674_491938100169805_1914676544074423092_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAicbCAhwE8Q7kNvwHinobd&_nc_oc=AdrvM1G5EqIAuYS5_u7EF6kNLFykJGrqBAvwVTw9Ymg9XSe-U4MTb43813ICbPIHrO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLYkz6zQ32fYXyEGoJdX1jSRglRkl3hQ3-saFe-jmnEQ&oe=6B047442"}, {"file_name": "HAX_ScreenShot_07.png", "id": "576899548655739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392305_576899551989072_804058002444659977_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvJHqxKuSPEQ7kNvwFgz782&_nc_oc=AdooOwlKot43asoKO5YIiQZmd09xZVMLG7IUkLGVUy0HCyLIDuekB2zDem6cV4e9RVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQpxpYMI2Kpts8Tz0Ssa-4pZF2n4113Qro385v99TUIg&oe=6B048196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HAX_Meta_COVER_LANDSCAPE.png", "id": "600146542767651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392148_600146546100984_9219538178642778160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4XaX7x3k7YQ7kNvwF1pz28&_nc_oc=AdoDMXyvZCqd4JiBfSCjF5MhX0HJH_HL_vVd4O8RxjHaGOYD96PFbxwOCsvp3gR1nnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEeZFNIKi_WGoZL86OOzR5aBXPLoBGXZvWwOB0IJ1b-A&oe=6B0457A0"}, "display_name": "HAX", "keywords": ["Multiplayer", "Shooter", "Robots", "scifi"], "long_description": "Future Earth is a dystopian battleground. Robots are at war with each other. Play as a Sentient Intelligent robot in this fast-paced, multiplayer shooter.\n\nBuilt from the ground up, specifically for Mobile VR, HAX offers highly intuitive controls, groundbreaking weapon mechanics, super-sampled graphics, and dedicated servers. Customize your weapons, attachments, characters, camos and more. Earn your rank insignia and wear it for all to see as you climb your way to the top of the leaderboards.\n\nHumans have mysteriously disappeared leaving two warring, robot factions; The UNR (United Nations Robotics), a peace keeping division who will stop at nothing, they will even use force to spread peace; and the 404, a corrupt military group spreading their infectious code.\n\nWhat is HAX? It\u2019s a radioactive, programmable gas used to power weapons and hack other robots by firing data packets. One simple HAX Mag can be loaded into a firearm, turned into a sword, thrown as a grenade, or used to hack objectives and other players. This all-in-one Mag makes HAX incredibly easy to learn and fun to play.", "short_description": "Battle robots with digital weapons in this multiplayer, arena shooter. Earn your rank, unlock new weapons and attachments, customize your character, hack the enemy, and wield an array of light-swords. With ground-breaking weapon mechanics, HAX brings something new to VR shooters, while staying true to one of the greatest game genres of all time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": "https://www.engineorganic.com/hax-eula", "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/hax", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
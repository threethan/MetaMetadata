psMiw7ka9spnuo_4-EXGfo_aeYpB2_q5Xu5vxLfzHnlSku-iG4yvq7KaL_h43jmK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoyd8vhqjOsJikN2dUVtqu32nedcNga7Fh6eBHpCaLJw&oe=6AFDD864"}, {"file_name": "GateSmash-Gameplay-3-2560x1440.png", "id": "2238056407046818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_2238056410380151_6386760148157909563_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFchbD0Q3hwQ7kNvwFYRhTt&_nc_oc=Adp4ElE2K7BYLhq4N27hbJpOhYRF8jjgYBVTQElW8FJz5bPcUa1P5exKQPPVSj_oGeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3QL39e3ygH2_16G9RE6Ck7pGh220IKCfaN-zrjk9CQw&oe=6AFDE598"}, {"file_name": "GateSmash-Gameplay-4-2560x1440.png", "id": "1080518918232671", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_1080518924899337_163964759328612370_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYJ_0-CfsJYQ7kNvwFpJcJr&_nc_oc=AdpzrAndI3Ye9jjNRGc_oUCpKIokVY7t4P_onbjql_qQQ_I_ODlrSJfe-MnDSNHkPMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE_V_vDCTqTUsFxq1Icyg1mThgoaEZoBXypCMiLuHLrQ&oe=6AFDDA1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gate Smash: Cursed Castle", "keywords": ["runner", "smash", "fantasy", "castle", "reflex"], "long_description": "THE CASTLE DOESN'T WANT YOU TO ESCAPE.\nEnter a cursed fortress where every gate is a split-second decision. Race forward through dark medieval halls, choose your path and smash through the breakable gate before the wrong choice ends your run.\nGate Smash: Cursed Castle is a fast-paced VR arcade runner built around quick reactions, simple controls and addictive \u201cone more run\u201d gameplay.\nCHOOSE FAST\nMultiple gates stand in your path. Read the scene, commit to a lane and make your decision before it's too late.\nSMASH THROUGH\nHit the correct gate and burst through it with satisfying destruction, impact effects, sound and haptics.\nSURVIVE THE CURSE\nThe farther you travel, the faster and more intense the castle becomes. Stay focused as your reaction time gets shorter.\nCHASE YOUR BEST RUN\nBuild streaks, push your distance and keep coming back to beat your personal best.\nENTER A DARK FANTASY CASTLE\nGothic stone halls, cursed energy, medieval gates and an atmospheric fantasy setting turn every run into a dangerous escape.\nEasy to understand. Hard to master.\nChoose. Commit. Smash. How far can you survive?", "short_description": "Choose fast. Smash through cursed gates. Race through a dark fantasy castle in this fast-paced endless VR runner where every split-second decision matters. Find the breakable path, avoid deadly barriers, build your streak and survive as the castle gets faster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://munirbasra65-droid.github.io/gate-smash-cursed-castle-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Muhammad Munir", "support_website_url": null, "website_url": "https://munirbasra65-droid.github.io/gate-smash-cursed-castle-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1318729154665742"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1491854082809196"}, {"status": "PUBLISHED", "id": "1678543657172342"}, {"status"
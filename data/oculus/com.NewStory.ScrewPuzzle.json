01724952716043_5658286757299856696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_llLP1td638Q7kNvwEWXzvc&_nc_oc=AdpeI_-UHa1QLrYYATmUn7gIeVZ58eUGEw75hIqKCUPcGwbzv0BQaaX_OFnxL7l4BIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTraJdoZN9_QIB2MZ6AsI4I8Ve_WcwZfD-i71mDE8c_jg&oe=6AEF3ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (1).png", "id": "3829773397286894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394082_3829773400620227_4561863406222400270_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRCK2tt_NhgQ7kNvwEEV9JP&_nc_oc=AdrDpHhGQubMr6PLoQkx61nQJgfxbNm70VcgxDoTIHzkgDv9nVCZuf8o8Oq4IMRoNmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSG_vyia5t1IXlcHMim5Zx__fWIoS7wb2F94hq9bJw1g&oe=6AEF5491"}, "display_name": "Screw Puzzle:Happy Jam", "keywords": ["Relaxing", "Screw", "Happy", "Puzzle", "Jam"], "long_description": "\ud83c\udfafWelcome to Screw Puzzle: Happy Jam! Have relaxing fun as you navigate a world of screw pin, nuts and bolts puzzles!\n\nScrew Puzzle: Happy Jam is a relaxing 3D screw puzzle game set in an MR VR space! You will be challenged to solve a puzzle where you must unscrew intricately intertwined 3D structures, one screw at a time. You'll clear the stage once all the screws have been removed, and all the parts have fallen. Enjoy a peaceful puzzle experience while relaxing music plays.\n", "short_description": "Have relaxing fun as you navigate a world of screw pin, nuts and bolts puzzles!\nUnscrew the screws, and set your mind free. A relaxing puzzle experience.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
01724952716043_5658286757299856696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rBTadPg3d0Q7kNvwGeVq9R&_nc_oc=AdoBZzNWxAdcD1rBtj0R5AiqfTtvFkb5st-zoNcjjE025FhqPwfZ73lAWDGR2xVKqGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUrB_xb5WzIdPbwlZtkux0Sg6TTUgA9EAXXTnxG6HU4g&oe=6ACF9ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440 (1).png", "id": "3829773397286894", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394082_3829773400620227_4561863406222400270_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcxWgSWnFQoQ7kNvwFlu8J8&_nc_oc=AdrXEThfnbwQq-Cxm2VWCoJ6nLveig8dSD9y857uTIsBew1V7lCYs26GfVr339_Ujow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVK8eR8bN3MYXP9QZXUVtJ8Twh4OLyUFrpQCG_Bur0pA&oe=6ACFB091"}, "display_name": "Screw Puzzle:Happy Jam", "keywords": ["Relaxing", "Screw", "Happy", "Puzzle", "Jam"], "long_description": "\ud83c\udfafWelcome to Screw Puzzle: Happy Jam! Have relaxing fun as you navigate a world of screw pin, nuts and bolts puzzles!\n\nScrew Puzzle: Happy Jam is a relaxing 3D screw puzzle game set in an MR VR space! You will be challenged to solve a puzzle where you must unscrew intricately intertwined 3D structures, one screw at a time. You'll clear the stage once all the screws have been removed, and all the parts have fallen. Enjoy a peaceful puzzle experience while relaxing music plays.\n", "short_description": "Have relaxing fun as you navigate a world of screw pin, nuts and bolts puzzles!\nUnscrew the screws, and set your mind free. A relaxing puzzle experience.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
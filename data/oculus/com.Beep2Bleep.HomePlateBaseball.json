JMFMI9igLgQ&oe=6AB688A9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqpvPCljtoEQ7kNvwFK_cBN&_nc_oc=AdptiUUHAhXjvkvE4AMYCuiAGk3-9d-PAmpjtgtPOX_1ewiGsTZKiIshRceYgb_aZ70&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3IQ_SekKr-5SRsE4u3N9WOeqELqPaFNxooZl960f-Wg&oe=6AB67743"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADjjr31xelcQ7kNvwE_TKNB&_nc_oc=AdqnaIqdF8YYMGpbWPtbqhxvWbiM7CCpD756ysSVuOgxImDhDiO7TXMzJuupCOfNTyQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF4q1KA-mfnyz6jVxN9gxUF_TcJVafR0shuArQubQVcA&oe=6AB68547"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIXfHXe7ZdcQ7kNvwGCkXFz&_nc_oc=AdqRp2y6a9qCHiZVDDV4uIieYfOw4o8FLTfLI-lhsCYn40o-5LRwbKKKuJf5qgV6j0A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg_cMusOgyOsB0W-ThfHgxkG1gMxWsjyc7-Bx1bAShQA&oe=6AB66FA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d81LYfnZgSsQ7kNvwETn0w-&_nc_oc=AdoMWKGng7_tdINlOqt2Mfb0irGbmcJcm0pK-uK50fopSCEsriTXtco_CQhjbRe9Tp4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNu3m8tj52UDrCMseax7mvFKbwejkldHy29L41B9A6hw&oe=6AB69693"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "http://beep2bleep.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
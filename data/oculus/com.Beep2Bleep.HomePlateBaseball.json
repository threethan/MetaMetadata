95454124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG81KsUwA2sQ7kNvwFQoNT3&_nc_oc=AdkWpBv_kRgmoWwUE2xTnqUWURJEFFCRAgUjsqZfC7EBNldVhBDDR8JF8s6YML27oS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLUcQKViygSlL9_bsypp_rGmA2yhHm0kDw1HzICkK1Pw&oe=69AEA469"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjyOkbUlsNYQ7kNvwG8edqW&_nc_oc=AdnPHAf0H4V2Vx3vUKJQZs5iHVypGnTLWYTh0EJ5VO_REPODOpUua-bBWSmX7tjuzYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOr4Aat_MGs8b173mODPqeNEvRHGJZajbMmQaJcgE5-A&oe=69AECB43"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7BV7idYWd8Q7kNvwFRRvqd&_nc_oc=Adnzeps5ooW9XLcsUvb3re7k3oh59P2Db-ol4apfPGgXWP-jMkPqW1J_rr3OT4-_K2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxotliUdjQX9qE3V21N83u6fF4ffbkcF7t8qvbftyYkFA&oe=69AED947"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS-cG-rdBZwQ7kNvwH-U1SI&_nc_oc=AdlMA0dD43LmWZRcDLvwAG6sW7b4VTdA_vYKQJ0DEVVZxLy2MdZATMIwu9hpRtBqZYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEBfA-LWjWgLGqIHMUUHPaYw9iGhOllx8UJtfSy9iAMg&oe=69AEC3A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yvi5yL8mfwQ7kNvwFkyInl&_nc_oc=AdltP-myi25Vd2l8dDekDEHOpZvX2DvP4yVegbw0_ajev6utslv7usa0kbQIE2YTNg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZt5o-ki1YZ2s6Pwkq9P4XY9P3hDfGYgqifAjF0hE4Qg&oe=69AEB253"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "SPORTS"], "has_in_app_ads
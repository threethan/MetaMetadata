Z4SayqgCYCQ&oe=69DFA429"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olLXQXhjfcAQ7kNvwEl29vV&_nc_oc=AdoINm4coanZzg9XPoi6NbSrbFKsf3B69IpelKawIxghZO_Iz5jXiZ9grZQBYG41fKY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WjKf20ySQgF-eLTfNAAzqOBs1yDRowdTiZlJF6BakZA&oe=69DF92C3"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3vI1xiBRCoQ7kNvwE7fsoq&_nc_oc=AdotjTr3iw7KIxsbvNJeIlv-voNbshHvwwbf8cr3D_Y7CqApkfSY7XF5gWpo_GEZnbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sJQD221UBxT3MhLiRcBdhw-HjB2lH3nGExMKaKfYhyQ&oe=69DFA0C7"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3e4OiRix73gQ7kNvwFqpIoW&_nc_oc=AdqDqMJp6CK-HeVvxbsBrlo41DvGG6wBwXaRzVB5xGXDZTBwJuVdIxSsuScwTjmVEYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1m1ceCsb-cotplQGXM7eY6ncwNs9VA-NbRsrHPBZHOUA&oe=69DF8B21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d47xb3zhsh4Q7kNvwHi5JZF&_nc_oc=Adp1QkHEno2aZsO6YXsJX5Dmhgz1PvTege0u0eTFbht8j6fCZY_raNqcD8imW3YgSEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mbK-soLKNOesR0KIWxmPiTh0gXNe8NX0vKKAzaXUb2A&oe=69DF79D3"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "http://beep2bleep.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
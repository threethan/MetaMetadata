wFuV-geL7Ow&oe=69FB53A9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRBcb2pZGj8Q7kNvwFpRxAT&_nc_oc=Adq0hkm7aCxxgp-eDrx87ehCybUTBnEoND7hIQGrFE6Dd_fBoVZAz5dxUIEKyMsLUq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45PSroV2fFWMwVa1kHSyH9qph-EDwRJIrnVy9ihX04Cg&oe=69FB4243"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pngfdiAkfRMQ7kNvwHnm0Gz&_nc_oc=AdoSl7F-6wHDV9jAi5X8cRsop--lrYJ9gwj7ybCFN1MsRhOTxR_liCkX0pOlBUBYkd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mMQYCArYCP4Qv7wGowxVWXXP5jTLo_HROAfqIMefNTA&oe=69FB5047"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzcI7HKYKPcQ7kNvwE2siH3&_nc_oc=Adr0Z_cD4lG59UIhZwjK7U2TyonWD3RmpYsBFhWknQ7WuCl6s2sN5SDbINy2TRDlbrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AqZavffNuYDySPTdDMb5zb2oncJv7gn1sDtmlybiV2g&oe=69FB3AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPVbjji4R6UQ7kNvwENju8X&_nc_oc=AdoTNrr4cgBaLtsZ-_IXt3MScAI5ojGMvwdWWN7G14G5mitVW1UfbRQCNI5NBTh8rME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hF2PAmLTo9XSvRiBs9Xjc1HveHMDp-ozX6BUEchGuhg&oe=69FB2953"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "http://beep2bleep.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
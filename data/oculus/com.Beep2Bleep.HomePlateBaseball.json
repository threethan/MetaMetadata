95454124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjnn-_8GkWsQ7kNvwFW3rw8&_nc_oc=Adm2pyUmrTigtlReW8XwjA1ATy27ffAUPJTJ9JQi3LmFLt7NsA5y6Hcs1sdRO8o68Fw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTOjakPwx27fqZO_M2qumqqWX6mg2PjNtbDUZmSby3XQ&oe=69B68D69"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5QTMgwGAD0Q7kNvwEpnFBD&_nc_oc=AdnLsCoYSnNp77-BI3palB1CN_KhSVHKBNzC6_EGZW97RMrxi1EPBBj9dNqaDnuYfAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnVdTMLbfsPNsdhl_M0tCNzO4BzzjdxUsJNUCmq9shaQ&oe=69B6B443"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z01hljchHR0Q7kNvwE4hhpQ&_nc_oc=Adm2G8xcPPPHy39ZsDYuoo_l_j-HaB-e8k7tFyuMb9UEzN2dusz3Apfrnl_hr2cXMKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0bKvh18_sfbYjZsieaL7m_qbsm5W71hZL_FNy2oNAuw&oe=69B6C247"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtCEjwxG3FsQ7kNvwE6LdQA&_nc_oc=Adk4hRWzof6YeCVjLmdP67wAhAKdgOKIfjNQUhPVy4TJpwht-71fPKtkugdP2tcFY4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxZiIQiMsr2HcYu3Mm0-QIDyOz_kWoW835eXvT7QFzoA&oe=69B6ACA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us0-9XonBgkQ7kNvwHx9Eaa&_nc_oc=AdnPQnhgWB1CkC2fW4ewvaXzglOI5HMwijGZ4SFXfiujdCoGRc__6lqYLicf5qOKCdE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9bdADUsjOuPkhZLtSI2QxZ16lAdLMlbI2EVLXmMomZw&oe=69B69B53"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "SPORTS"], "has_in_app_ads
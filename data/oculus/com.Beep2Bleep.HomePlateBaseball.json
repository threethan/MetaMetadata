95454124", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhPLUxR_ppcQ7kNvwEKRTRh&_nc_oc=AdnC3rFxGg9TyQf3ZQEMO3U3YNWvDPtfcDOj1ELQy3ANGrisU_bIKJ4jYebELwXZjUs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyshLPMjlZ5fZlOrlnn59HKdTK1bZjeCxaJXEFPOX1Yvw&oe=69BD5D29"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSEn0zew3bkQ7kNvwF6s_QZ&_nc_oc=AdkwCBytjQrCLglwpMMFcmXElHV5In-LDkr_td5BfK4IUmATm6Zeb-B8GuscL6zPPXg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdGUexoNylp7wjjemG5LWoE8xyaidWtHJdlFqUQ1xYGg&oe=69BD4BC3"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkXA7q49-QcQ7kNvwGrqrUT&_nc_oc=Adlln6SiR53u_uV5x1e7uPl6uvWF_9DnVNhfBdV4i2i-WVv6RIDJqLwQHiVuljKRxlI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFJFYLR8fnpGoCClkkLwM5-j4n4gRAGSjIK81PqgD8Uw&oe=69BD59C7"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExIfRRKWMToQ7kNvwGinw8C&_nc_oc=Adn0T3Qb-lRB-O1wTSzd44zzvaQO_LAkVoTmmGx0G-td9XDNHUs7LxMHJcR6s-0GHBc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaVml0f9g-r_Ed696rQ1KjfQsaPWdj24MN9_vvKDOdIw&oe=69BD4421"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFsdm9RHf7AQ7kNvwHFSI-W&_nc_oc=AdnChx0kPfZJCEaQVhwnq_LUksXhUzs05WqZx2_vr5F-3SpugDw3B0nDUQNbR0639xg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJKcThRSQ_ujHcOfxjBIdz-tZtAAOQfLbsaFLRHtyRvw&oe=69BD32D3"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "SPORTS"], "has_in_app_ads
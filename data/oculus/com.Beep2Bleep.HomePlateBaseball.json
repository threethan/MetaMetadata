me": "catch.png", "id": "229895395454124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMSx5B0byrIQ7kNvwEAIgtt&_nc_oc=AdpQMLYyodpY54dmFGKdLb3h2_ea4n-7FI1tc16g2bK3CLFM-hkT8BGXdHYJAusTr-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T8GP8q4loPwM1RoZk7DPsR26hgDYqJi2FIO4WaasI5w&oe=69E0F5A9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uu2ja29yIgQ7kNvwGGse_7&_nc_oc=Adqvwzu_dd6oc6Na1hYiKp6IL9YLPpG6vFzCw8LNLXaTDkMzR948j1MQp5LtHyVhn4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-zvqEzyukEHWKS9ofJrhc25dzgLuOW3KTWtCWr5Ozeg&oe=69E0E443"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO7fTwu_cpoQ7kNvwGtZ2mE&_nc_oc=Adr1pFzL8JMQO7InfngZwQYtxu48-GSnCPuD58C4Gs6OU46zeygthNm8VOz9ak9XRIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15wKawL5QdlbPwhdO7_eTsx3kPduU_wTa10KcCYh2ziQ&oe=69E0F247"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls4iv4VVVDcQ7kNvwFV_LOu&_nc_oc=AdqSicbWUG2vlojjGRO8W_h3ikpOJvKW0Nu6XEehM6Ucma-M0sIM65UCdE59q7Nbwlg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NVCbJLdSuyEptFZcavZNKRyjhADYMxPPPLqhdUeP2pA&oe=69E0DCA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d47xb3zhsh4Q7kNvwE2mzNz&_nc_oc=AdrFrZoD7HCZ4s20mgCNijHfop7om2TjE1sqKcGYRtaYwJtrWKiJJqoEZRR4hwEfL5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ITc9eD1Ak2VWwsHdte7h-zJeTpWQbeC_eW_CJs-8Q3g&oe=69E0CB53"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": 
X5BqpJ2WDhXGBEllYI_N5KMewy4oONnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft9x8Y-74aee--63ZC2fWfRgC7fFHi5YhkNuEtDhwHwWQ&oe=69A43F43"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5AcAvhC-dMQ7kNvwEO6NyU&_nc_oc=AdmJk0m5DYg_-Rf_64dpAzl0LnVVVgcbcoArWDT7WXUyHdlG-IoVcUPAROJJ1Qw8aSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfujglSD654cBXhjsFadnSqxJB0fu5ZuDO_Y9Mm4PVApjQ&oe=69A44D47"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aro24u7oaVsQ7kNvwHn3zbO&_nc_oc=Adltt9xyZM3r-Pjjmblzwh0HtuAzuMqId73NTV1ARiTWRHIbm194orOjUN7wLAW-oqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvPpPPbESCAvLE8Z_WiZEYlQezxJ1HB-6h-Jg-lLeAcQQ&oe=69A437A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKCHxzP0ZSkQ7kNvwFo9I95&_nc_oc=Adlrpn9NjQYtkehbIQOMNxcDxInK9RxVG7bja_npzMK4rLVnq4X2HY3JNKHthyUdbk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfupnzF0iETMekSr9GK2aVv6JzpWeR_LD4kt9uliup5SyQ&oe=69A42653"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "http://beep2bleep.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1268497950347863"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1300303848530753"}, {"status": "PUBLISHED", "id": "1540257313948369"}, {"status": "PUBLISHED", "id": "783542677649403"}, {"status": "PUBLISHED", "id": "1269516654385916"}, {"status": "PUBLISHED", "id": "1076357327469147"}, {"status"
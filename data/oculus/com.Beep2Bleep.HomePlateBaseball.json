95454124", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhPLUxR_ppcQ7kNvwGu2-8k&_nc_oc=AdkyuNQYAkN-9ZwOKWdEX577DBgMMLQane0NnTYnFDeqtxtEzLHlPXk0ylHMYe45plM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxHUnS0hP-OCNPPJS8lK4ZuDsW2ACFn-u_qmtSSolqFQg&oe=69BA81E9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDUOdhBB-r8Q7kNvwFVeCAj&_nc_oc=Admu6GBdlaQ3rfaFGNgDR2PZDm92CzU7BUsFQjK7uE7XS6eY-QA88mZh68kSGYOst70&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHVQ-70cS9eC_NKyFWIykqNxxkV2fajGwWnrMBibwdgQ&oe=69BAA8C3"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZbdT8tsOioQ7kNvwFdY1Zd&_nc_oc=Adm-lf9davKhWbVWPO4oBTxHGbEXI-smjeR_PhLV7Un1oHZQdvupFq1WWOtvXKf2MrQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCeHQMlVRaIuyb5-Z1C8PQOC6-fIywni2tIiSmUU3kfw&oe=69BAB6C7"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-0K6Dtge3QQ7kNvwG6v08o&_nc_oc=AdkrTilF16Cw2g_hPH2GDi532HM_rCpKWaaNCuHb7AeWXnUpoBq1XkmTOZkAJwK3jTc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpD8lQl8zkMrhWmySsZ-nNccxKZU_Cz0ov7NdVTKoM_A&oe=69BAA121"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFsdm9RHf7AQ7kNvwH4RZuQ&_nc_oc=AdlWmdYDRzXBmIBd9UwwkZjTRzwd_Np3ldwNAdakunINpMlThiHGlgtUc2jLTQrjgw0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsJxnSED4nxgfwmwBT9iQBg_T6aiIKJHpYiE5jyt-qbQ&oe=69BA8FD3"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "SPORTS"], "has_in_app_ads
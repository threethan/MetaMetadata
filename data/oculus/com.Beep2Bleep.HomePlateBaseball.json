95454124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjnn-_8GkWsQ7kNvwGDw-lN&_nc_oc=AdmlS4w70VbCBEl3cWdrh254HRd3qCKSIUMBnDAn7Pm7pS5u61cZmfvZx4ulGOZms5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCMWWVd4axVnfSpbfoapUEs6iQjXQ-zEfSjVqoLLVBAw&oe=69B93069"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDUOdhBB-r8Q7kNvwHOM_5P&_nc_oc=Admo43JrDVX8yxW0_ju2O3lpixCyp0ndXgOkNDjLVz8Bt_CuAav-woLXSdWfw9JvE20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZ61MFVxTygupyCWMMVRTWv8pZrBgbauDBAPVI5zVHnw&oe=69B95743"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZbdT8tsOioQ7kNvwHaygUP&_nc_oc=AdnN2Qe6siXCMiwY4dWOSFD5RQbfXRJYhM-yu0SVkPfTSSd4j-28k1YbFoJ5VAmqRO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdIYL3DyxZ0eJPnFhfV3GGla8_E51FAO16QUWZPd2Aqw&oe=69B96547"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-0K6Dtge3QQ7kNvwFHmYxu&_nc_oc=AdmrODySXVc25TwZkyJ6L_HJC66PE_pc8m5okiOI3Cv10iDBfM5EOZh2sk5zHCTTToo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwxr5kpeGg0aku7kns891GaYnqHQkr6PpOvXkraG5e7DQ&oe=69B94FA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us0-9XonBgkQ7kNvwEYEqvG&_nc_oc=Adn_RGXMCwtlEdJdJID0eQ3wz8ivTvoABaZg--mvVM0RYvKceGy-j7KB6M2oBdR0_mw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxbc59fSBgAg5Rh0VAKgth4fcObE7a54IMlyvdqDBdmZw&oe=69B93E53"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "SPORTS"], "has_in_app_ads
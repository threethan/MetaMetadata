me": "catch.png", "id": "229895395454124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYyWsTocpr0Q7kNvwG1IOaK&_nc_oc=AdoG3g_vU7soxMKzel_bm_ssirZR_xaxdg3T5mnOcXYGbzDFq_zL9sbciMZ71NCwVOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYjo09krD0cRjLC_BM1eYOmOCMRqiCVkeexO58A7eixw&oe=6A5F85A9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAjiTVJu-q4Q7kNvwFnMqwV&_nc_oc=AdqMJzz1cg_aOb5G-V_V3W9RF1uRTxVN3dSzc9DE2nDb3pU1ygo9muy0vCQByP5HX_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu4xFXwcuSIk5wUUNCExJX5-WBrqEk8p6B94xjwcCXYg&oe=6A5F7443"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no_QrQSxLT0Q7kNvwFwVrsI&_nc_oc=AdpJ-NboZBDMrLbzR10wQz5tgkuHCLJjZ-9xQg2tveEY-SdSEBEviKsC_5YeabYxyhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxqefnjP5uIEWDzaa6qLTBEKPmoH6omzudIRJag2O62g&oe=6A5F8247"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0s76-wV3C4Q7kNvwEJ1Gn4&_nc_oc=Ado6ZS6e7XBcqUiCL9-qi_M2KeCW9InYVAxsyW7nvfMBqIC6f-oGLq7yH32OYMdDtHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoY4YFOdHBm5lK-GjK_CbOkIuwpM7in_7OBHBxORQNGg&oe=6A5F6CA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5bG2Wewc2YQ7kNvwHZpqSl&_nc_oc=AdruAK-WMEbStg8wCbXVFOhFqm5lWLp-SMTTOzhP8jdEacjhnKezh-PJLlhhEJRhE7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn5Z4eGxrBdniFLjE_6sktFMTqYfrnHBoz93NQmdyBKA&oe=6A5F5B53"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": 
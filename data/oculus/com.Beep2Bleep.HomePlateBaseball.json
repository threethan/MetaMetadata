b2r0AngHSRw&oe=6AC7AC29"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Sq_g1Bq6AQ7kNvwGZbGzG&_nc_oc=AdqqdWgX7HSJGH7nPEvm2xrdlRg_ynx6dO1QpoSlQmcf277otDW0Y3N9-3Hgk9alqeE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA0NROPpom7kqxkuwbysr9fXzkIBIUZnJbhisgY2nRXQ&oe=6AC79AC3"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtuOmQ2SZScQ7kNvwFLioY-&_nc_oc=AdpF9sjPDAg5HSB02GP809SbGcdVm3oqBGIJ7cBZQNLkjwazc5EPIAlxoItRQ77w4-Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7t5fU3jtDCnulJaJS1b4idn3qFGTfzz0BVAVdgh0Bvg&oe=6AC7A8C7"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s7i0WJ6_9cQ7kNvwF2fz1B&_nc_oc=AdqkhAwp3XFMBwkgMdldIV50kKryyE6WlTGM-fpi9hq0B9CXC6bXoqoX5kgGX3m6jdc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVfI9CZSa3Tj6BY5oDUcSbZMK5pl6Wp-7Z5k6txSPH6Q&oe=6AC7CB61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWDAYMaKbREQ7kNvwGH95ek&_nc_oc=AdoZszmPpcVV4gkWfh72vA4krYHpXj29ymVtXVVLexXlOD3bOxBhFa7bJ6xrzlf4dyc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFfhOtLYTbgkkBIWADzLrJxY0ljXQZTfoUus25b8Giww&oe=6AC7BA13"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "http://beep2bleep.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
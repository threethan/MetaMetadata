ybm0erOtfbg&oe=6A9D7C29"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ARQMc0nKX8Q7kNvwEJxoI8&_nc_oc=AdoIYDBlZlzkRijfny63Ujhx8JWK9pJ65X4f_HkxM-13Np4jSml2jLFq8zWWAcqbQqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZExRDQj5IQFodPzUqy0vHLehTk7cBqxepWASnQis0Yw&oe=6A9D6AC3"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrY88STbvwAQ7kNvwHglsoI&_nc_oc=Adq52_dWOmufM1Q5pzMD0KylelOVSWyu-FRvHdeyqBl3dgutCBiwpXNKXkePBEmwcp4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaLmrDd0H-4NZPjCEMre5F4LkB84igly5ypqCKwDEUlQ&oe=6A9D78C7"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goDsWdKH4W0Q7kNvwFbnZsI&_nc_oc=Ado3k84Y4sCc_EhKfAgyBl-alURmFUDxY-4jmnmSPluqVdumzWP4l3Xa_kbYlSlcejQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTkvghdMVOC8-n12iwFTjA6rYnNar3zRGj_LmSAkGsmg&oe=6A9D6321"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsaofrAXbHcQ7kNvwFVLFkR&_nc_oc=Adov_bxih4hfgycHbLk-XzlRG_68-dCKggguV8_dJ_0RWDbY63HOtagngymn9Suw0m0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPv8csEvuT__oZqOEnEP9YAd2BHxr2EjnIW-JqF8Y2Qw&oe=6A9D8A13"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "http://beep2bleep.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
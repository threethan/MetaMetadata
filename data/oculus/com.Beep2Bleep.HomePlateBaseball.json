95454124", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIh8ArTg9d0Q7kNvwFebAvz&_nc_oc=Adr40Y6i7AxPsVjyqkL9MmWcLgxzfHtDMhMsSIu0WAAS30XCHKfqDth4WDGrP-qc1Ug&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoUSiA37trWu4J6Jc6JpZ8OHx7J-921pvvzVnZPR5deA&oe=69C151A9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH1wOk1StXIQ7kNvwFkKoV7&_nc_oc=AdrLb9tWGjmCSP47WNSe_ztW-BJBp7qD81mQu5RWd5rCxy6fLMG6qBO6zsQ5u9KHk3I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxE3lDUz7MJNL9gVieJr87dwnaK6oWQiELBzJuAEwyLeA&oe=69C14043"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9d-eHZal6UQ7kNvwEYjmU-&_nc_oc=AdoDJw1Bkuss3dfH8D1yjgaQ_dme1QOJzzAqrGkcobfbZ2NgAE0eLhxAhsNYqxvFroo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwfgw1S_-IszvxU7IrFz9fSP8jx93eUlBrIQGBwUsqQ6w&oe=69C14E47"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvfSlnIwXUIQ7kNvwE6hF-W&_nc_oc=Ado4n9SvuVWedmwsQxmaOSbqYuyGQmYFp_GM_wdffYPgDUL67kfQw2RCHSlBj8tfZ0s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afytqmy9PT_OPTEymj0Uj7e41i9_Ag168K2RY7fJTO0CCw&oe=69C138A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQt0IHNFzicQ7kNvwH4JRPX&_nc_oc=AdortOkqXPNdp7ftfHXHBfZ2sP4DwwM2k9Hj-MgU11c6afpMTFKSypofsoq9v4v0ir8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPmXDKpWPJUIiW9y-QwIrsPdr13XTpR2VXuzHqxqf7JA&oe=69C12753"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "SPORTS"], "has_in_app_ads
oojvqAM7Uzg&oe=69F75F29"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUk8nXkcMasQ7kNvwEn7k59&_nc_oc=AdpzrG4UUeU7v3QxCdqzu6NKGSG7IpS6h1FDEajt5F394Wvec_W_0DfzZfdUHiBqdAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KS3RW-s1aQxEvus0pNL3kkwacWrZW5yxfkB0RoB4V0Q&oe=69F74DC3"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsZ1Gicyg_cQ7kNvwGppYCT&_nc_oc=Adpso6vuRCkcN12j5BTYZB9OeSxX-f1Txzo31h1cXBFwLqRDkoawNHrmiCtryxHn3Rw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YA5X-dHL6cVdE0BAuN53uRfICM0wfUx7Fz-rOIDMB0Q&oe=69F75BC7"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC9-IzQAQt4Q7kNvwEtRYzF&_nc_oc=AdoXANb3QV0gVYX_jVx9rpFyZ8tjD3Qf2qKqmml5mAh2Uyf5VlBRW3pgn6Qa-Zf91IU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ElvyUK2kdnOuNUa9jgrj5VuYY31Ux1TDrCG26C8b4Hw&oe=69F74621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzC8lV4vMdIQ7kNvwFPzXms&_nc_oc=AdpNQrI3jvMzvRSJIMQUp-Ia7pdASuprajPaCSkRmnIwt-biIrlXH-lV2EkQwQG97lw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RlnKauOMtyFwdjdpIEtxm5f7_C41wgtUyaz5_kS2P2g&oe=69F76D13"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "http://beep2bleep.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
me": "catch.png", "id": "229895395454124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luDY3EWQOIwQ7kNvwHKtPxW&_nc_oc=AdokS7IOmp0yK52QOqptImuSo5MqZ9u_MKmBJvPREUCUubA9Dp37pK5ZIjHs5lnCnIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af568PfnmdS8g_zYFRPpQDt5PUxPfkLBG66Mj_BtDwt_Tg&oe=6A033CA9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfk1Y8n-GsQQ7kNvwHhp32x&_nc_oc=AdpNoKxeXzkR3X_adsSdbMwUHIeA5Mbc88mheIYydK9FA1qRmkLRTcLTVrtFEyC7keU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U4jvFt9YOhL_x5vcEegupuiWjMPOjzBU4EyfQmG_acQ&oe=6A032B43"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=579-Sc3e4lUQ7kNvwE-KCCj&_nc_oc=AdoyUpmtrcDYCRSqAJhPWYtqCxccPDS2zHlke0wNrV9a9NxJX7F75pTC9HmOElqf66g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6exYN7-VKhxGXbYRsrr67g5bTWklbLwqFms-mQMSlpSg&oe=6A033947"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcHdFiOWKjoQ7kNvwHYcsi7&_nc_oc=Adpd6-64n-3SYbaQn2fcPs0R7sAD7AE8kDZj4n6NwJoImj-3bHWHe1ODiN1dzRSe79A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k4u2vWJp8Q5Ffb1784o23FrvGP10ne95vEpptOZZw-g&oe=6A0323A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dy5q8WUlZoQ7kNvwE8kZ2S&_nc_oc=AdoC3B-1oN-vOyb3EWF5vsmxyudAUxAzSfI0NETPhVKW_d-Nsuje1RLb3De91tzKoG4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C_Xgdo5SE-PcUWrff13ODY2uGCvaM1n_x3BskwuwyCA&oe=6A034A93"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": 
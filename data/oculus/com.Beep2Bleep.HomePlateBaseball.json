95454124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFEnVeRM10wQ7kNvwHVMSDY&_nc_oc=AdkbRXfr3XY8g0j30k5bgorAAJWRnIlqKnAB02F3cKNZRts6nNKZCt7RDTPS1FOUJBA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxj-4B1Rz8whSZ1OPvQpXGPeG_xEckg5s4NhL-rfWhvhQ&oe=69B422A9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O6_f3CoFCsQ7kNvwHmab6l&_nc_oc=AdkCnmUKx04HcMqPlgL8iUwoC8h6jbLjb8IC-LSGVoiPdSKErDteuS70udNu_LAGi24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyhVeQAMZTn2uWZhzD-Kbmso9YHJb_U70ECL4UKOpzdeA&oe=69B41143"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6OaTSMoWnUQ7kNvwG0Iugi&_nc_oc=AdlVFQStnHDUn868dG1yZD2mg7khKyBnXZWb4RecUE_hdKMjX97BfBsWNjX_PD9-uuc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxALMPwkuDEZfIeGYNZwDTtpmDsLUomefmd2iMLvwdZew&oe=69B41F47"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q6Lk2o0G8MQ7kNvwEYpEmr&_nc_oc=Adm_WpmslhM3KlfFRTek1mJbBhJMD2vEZeyLe1oH52of9slPl297gXtZPxZA6dCFNaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2lTFnjkFeMJ7bgUzUjafOO1rdj-cSCfuTU819paz_4Q&oe=69B409A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2PlNNu2fT8Q7kNvwEsjdn6&_nc_oc=Adlv8XVGVmYAOn1tSWsew2jLEbRs53nD6FUbN7YXmuIPwV6sg08eb4BZkmjgghj8wbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyturY0pDWSeOyedWTvhFx94Zm0v3MU6KM7KdV4TU_CWA&oe=69B3F853"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "SPORTS"], "has_in_app_ads
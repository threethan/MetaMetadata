95454124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kTDh1DWrZ8Q7kNvwG5vB6j&_nc_oc=AdkdhZYVA2hfkUZApmfsj5G5bfT874r4xim3uFsCB_RZK9HYo0diOTWOeVa9vjyXMws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuNJLB7k1hCQS4aTTdsZXmWBuceb50_EFbdPoXTmmjmuQ&oe=69A80CE9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAAXp6uE-F0Q7kNvwHewYMx&_nc_oc=AdkKEgoKXeNCONp2rh8h-qlYO3Jmn-nyecsW6lHxXau63jDb0jjmPCHGXfRxFMAQKz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5CVeETqHiDaaccNxuyapKQW1BohMghb0etbuv3AIPzA&oe=69A833C3"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmcRZd3XFDYQ7kNvwFzGLJR&_nc_oc=AdmWjhKBwSWM2jyjJxb_1gQYtt7nNONKdouG8WDPulaWntcrU9kws0_g2bDBnMTZW3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftF8-Oi1wJYWTIWdU_zCg4G7S2t91CJ-fHSucr_mqSvWg&oe=69A841C7"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quysjqabcO4Q7kNvwEwlWsp&_nc_oc=Adn4M4DkqgVaN7SaBMvgp4IXwCUgG1OkpdHHLoKQRJHru_PxHrT4OLZzLeE1YvwOXLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvGMM3ODhjLxt17V_ohjpSalUTit794IEhD8Vwzx8X-ow&oe=69A82C21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBE7RTyc5YMQ7kNvwHRHEj5&_nc_oc=AdlU4s6UOWHj_9LOboapyM0T6ua2pT_KL76PSuCp3rSG_fsi3N6AWcjb4GVMPQEjuek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsdIocuURvj5LLR-rjAEJWXHB3o5Wtd-I33MGRDrvNbfg&oe=69A81AD3"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "SPORTS"], "has_in_app_ads
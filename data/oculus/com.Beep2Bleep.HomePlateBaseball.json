ile_name": "catch.png", "id": "229895395454124", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974469_229895398787457_3858741643072803900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrfBsb7gjmYQ7kNvwGC80hI&_nc_oc=Adq5vypT13qCgA7CncqT9Q9MSirHdVoGOshhWso24zN2vQv6Rcz1JXzrRr5iWcygW7Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1beHVoUU4cd6m3qKMyIZxqYpDByDFj3QOdKskrUPbSw&oe=6AA413A9"}, {"file_name": "hdr.png", "id": "1030513567457045", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982699_1030513570790378_4366933671671395728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ETsofT4mfIQ7kNvwHPB5Nz&_nc_oc=Adr5jCgDhG1KKAYNXK4vQIsIz76ckCNAPEPbvj8072X3-u_jNQ_NSviZPLb3jqNQHSM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNEaNYM_z4UihYsne1qkgdKuCWt6oPPfJ-dJgPx1C2Xw&oe=6AA40243"}, {"file_name": "opponent turn.png", "id": "424972208821209", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974809_424972212154542_8062961231790322581_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szdwLBfWwNgQ7kNvwFbj-GP&_nc_oc=AdoXsaa3MhCg3qW50hjUewZnJ5bzvyYzhYwiYTr-koaNYIvFKxnwgbq5vdnZPy_-uHo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRkyGN1QMeFyc_VnXFMcX2FkP6p6QGfZv5h7UuaVHVhQ&oe=6AA41047"}, {"file_name": "umpire.png", "id": "167007048298680", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974827_167007051632013_4397356744508874476_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jx4yS5TP18Q7kNvwGeB6w0&_nc_oc=Ado_VV0x6ZcFBbC-g0KycjdAyg5MZiegDhVNQc6MDpckHS4clPxXqeb52qRVbeBj2Y4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9vnIaCW8j_uVsDLP63arizY9mOiRJBDwxT_h-A1Ct8A&oe=6AA3FAA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 landscape.png", "id": "907732260033767", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982715_907732263367100_2352859589952005289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2bGe2V4zD0Q7kNvwHDX_hG&_nc_oc=AdpcgjGadVHfJaPX9fjjOE3ahZ0t4xrdmLpVEgZ-xjjahj14kpUmkWPCOP3t-OKIpfw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsypDsjbSKOTc1c7ewLXC6JXEl3KlsZeTYOBh-9Q20-Q&oe=6AA42193"}, "display_name": "Home Plate Baseball", "keywords": [], "long_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b for VR HMD with motion controllers.\n\n\u200bBaseball Game: Normal 3 inning baseball game 3 strikes to an out, 3 outs to an inning. If you get four balls you get a walk. Make sure to choose your swings carefully. Score as many runs as you can in three innings. If the ball lands in the infield it's an out, farther from home you'll get more bases. If tied at the end of three innings you'll continue to repeat the last inning.\n\n\u200bHome Run Derby: You will use the motion controller to swing at pitches to send them to the fences. \u200bThe pitch will always come to the same location.\n\nCatching Game: Catch as many pitches as you can as they come at you.\u200b\n\nUmpire Simulator: Call balls and strikes, using the trigger and touchpad.\n\nHard mode: Pitches come in much faster, the fastest pitches are over 100 mph.", "short_description": "Home Plate Baseball is a baseball simulator and mini-game collection\u200b. 3 Inning Baseball, Catching, Umpiring, and Home Run Derby are all included. Hard mode increases pitch speed to over 100 MPH."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beep2bleep.s3-website-us-east-1.amazonaws.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Beep2Bleep", "support_website_url": null, "website_url": "https://twitter.com/beep2bleep", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "g
tt8leaXfR2DWVDY7OHOpN_Ec&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zpiDf2AiZ8EHuhDpwEQ_dqxbX6JVKkqucTr5P6V1oJA&oe=6A36A971"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0Ej1RDYbbkQ7kNvwEwTRvV&_nc_oc=Adob4y6EmiHtMJE8AWIFix_mfZSpZ-Pjbxxfm0oI2ynYAayvY0ZHS40FwYBlrgJnJao&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AU-vdsvaGPzzuRWvr_Qphzk5f1Ese_aYNwtUHUiOY9Q&oe=6A36AA6B"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGJ_iER9eMcQ7kNvwG0Zxki&_nc_oc=Adp_neo1m985BRDK2jcIeJO7qiIvafwIj_SZMpLKWCN3LGQzsZFxMcF7NOam563zmL4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89gDrmFq4b2dP_EI02Fj3GpS87dJFy1J8eeoGLeNwh2A&oe=6A36C551"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8gika5FlCUQ7kNvwEZY-9K&_nc_oc=AdoczXNdkTaxfJsb8_SW5nWg2iAF_a-kotPZ5ClN7MLgfmZilclbtYEOJI7HDs-Zu6g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jq3lgrElyQM5-kgwlbkXP35UiHQ1QmxD_0ZErGHce8w&oe=6A36A351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qse_7S4VoQUQ7kNvwFhNTA7&_nc_oc=AdrXBwieGhfajCHC_5arYC-puaJu63yMBuqzGF5wILS1cD9cKEaQOtUT4LEDaA_oKOM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0p2UMAl1LqOPdlaYLKJ366Dy5jHWzBoKbrNN1IrRfKg&oe=6A36A587"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "de
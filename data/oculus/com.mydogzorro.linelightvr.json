hu_2eK8WsXRWqimw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH77-oHARnRE5IvwHIC8dg4b5xs177p2Xt9T6tug9_7EA&oe=6A8196B1"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNoWE0PbgTkQ7kNvwE-qvSv&_nc_oc=AdpdUTEReVLCtgTmz0FRtMisp8ZJeWINAg_32_DNvdXugUr98afZFD812qjEoDbBseE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKkUQiM6T-Ebi2UFXy6VeS0R4ldiITSadUwnLdv-_E5Q&oe=6A8197AB"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaDBH76x_hkQ7kNvwHCZY8N&_nc_oc=AdoQksWJcq49zO58qfB6r5HDiWPI1f7sJDSnchIDaZx0lI0YzCjnD6opDUIMuS-TmTM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyfCfRMjKajdh1FRd-5CHeE1v79XZRGbQhKcyyVMfuaw&oe=6A81B291"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikTkrWRTtf4Q7kNvwGBMjul&_nc_oc=AdpcwVH16u8C81F_V7ZLy94_TPD3UlO_esMDuvXwC4JrE8JBZmyPewxG5d5-axEZPd4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxjD9JZcwwDOfYmkJEYGefql_8KwL7CuQ_1Kdlaqanzg&oe=6A819091"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hz3JyiXl0foQ7kNvwGrnHtw&_nc_oc=AdpO8v5n6g_gXPeKD61q8lXjUchoUTkWKFNBgNy4MqzC0zMthJsifnokloF11jgK-24&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLXZbrfYj5RYIAv4nfEoInN7QRYHupSqh3-JjgmpFYxA&oe=6A8192C7"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
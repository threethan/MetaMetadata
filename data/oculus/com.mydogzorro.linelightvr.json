Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utOYVzSuKbUQ7kNvwEQqc6v&_nc_oc=AdoXH1ql95UsKB0qRIiQLcatx2DTgy6oiNFqEj_FUhvMh8m3Gzhrv7TUstziHr3oXJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YSjo-mrfhWMlVinna34UjiYHbGWY2jSxKg4yUGL5V-Q&oe=69D50CEE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9blbCofqXQQ7kNvwHGAgUl&_nc_oc=Adow8V3SsoI5qycGWdlGz_TuNA8hLkvtAQZeEgoEDHSmz0VNEt3ZFmydUzQa-FQ2klM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aEe0C8Cy5vOq-pis9U7SuoVhl4TISSfhxbAkgxDzK4w&oe=69D4F7DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1sxIohV5AcQ7kNvwEy_sKv&_nc_oc=AdofgLhQf9JZNTjzDlOErl3217bszJTO3uYtC717UcMrYS1cYEzN5j_WcRPD9GVQpgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3U8HG2cN-euaEQCrthSoyVKW1j-tUuUqSz7gzcXsPyYQ&oe=69D518EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ncnjt3XmiKcQ7kNvwGF1xhb&_nc_oc=AdqFNpD4z2C3V5EDBWCcn6E0A_ZBNpoWEpUPm6lbStr2wMfsCi3mxAIkgQwf0ZIi8qs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bhlwvTGqt3K4sO9kUavtHSVWx2SztXD4gNsAdirNSFA&oe=69D51451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR3dOzLX1e0Q7kNvwFwjZfJ&_nc_oc=Adpn_zkFll58vJxL9M9CuGjsgWZCpaXdRBGKVO3FqT1yA7QiOtx7K8ej1kTX3GnMXhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xMEuiYFELSp0YpsyyYWdg_c-iorDkhVZSUZpcS7-ZVQ&oe=69D4E9B1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
DcZ2GySgsGUTl-dg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yNRjULgCgmj1UXrt9vXu_Qzit0gwTH-5e8eFuEXayPQ&oe=69FB55F1"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhUFe_OW-LsQ7kNvwEsQUj5&_nc_oc=Adr7ezpP8MK5CzK_vQwKm0vGR0jbr9PraLHLwh9_ZV9_6Ywbr4r8oG_T12ZpFTlmT88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f7fEf0GThqAMQKrjxmeEpgLRtohNicUf-gM8w1pvfwA&oe=69FB56EB"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkLpofr5QL4Q7kNvwFljRtW&_nc_oc=Adp98Ik6zolKs67ifxV2E-9L67j1SBxy6OYVxvSOt6Yxs5z1L1nBqmGNc4XyhFlSD-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42KSycEoJIMu1x0fDQEYaYEUKvt573ImRrd5jJjDZThg&oe=69FB3991"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIAh9QJk9GgQ7kNvwEnErAO&_nc_oc=Adp7Q_41wJwvEKqmskK_PdOOstpMJ_QoU37YZxIgXkbuymEVZHS4N4s34quD-zZDANs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m0PHAp4T_Avw1WaqAqd47p9IEVp54WTahptCm8ER5GA&oe=69FB4FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDtB83vVkngQ7kNvwHmV3E0&_nc_oc=AdoR1OI-VKWJwKGWbrSaI0hHuBY4LxLLihyu_chx3oUqdQfpUxgsrYsQAyZxfN_Xhv8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qrIuF80_AWURwBgJ99cta3x1nHLLuz0BKzjMcdINGUA&oe=69FB5207"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
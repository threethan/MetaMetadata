Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_-u7i8O7mMQ7kNvwG35dy0&_nc_oc=AdqLtYb4Es290zLzAp4dq6cL_XF6KakgpRNv81BsaegcrrKY7KK_4_FH0ebiXzwf6D4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RHhrjfFclfhvcQ0-JpNYsMbtwxkDsm7VjkO-f_LT-Yw&oe=6A16F7EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIHPPOpXnKgQ7kNvwF_bxG4&_nc_oc=AdqTHvdpe43NPjgEY4DQh_5nJ_ZZsc2hE9xyISlP2AmGFOONgIWUP4sC9_E0wUOylR4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E6nPtH2COWNv0_BW7MjmEfRcbXz-iPkk0pAcSX3dzfw&oe=6A16E2DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF3gCuoVlfsQ7kNvwFBiAz3&_nc_oc=Adpf3KAzVQy4TPfLc4-ZBm0VUecyNQwY83DgfbXFIZiPZHlcdk9MdFfjBG_ZaETrWk4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oMeNHGtrZXf_Hpvj9eSjBIWzE8lv0VS2FCesv2Y6_oQ&oe=6A1703EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIKTfSGxz1wQ7kNvwEcurQU&_nc_oc=Adr_q80dwLlrIuih_VBGSu75X-l5Nis0FGQbQG0gAF6zLkos9xuKXkdrLLHVCr7ISV0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ezgpv4w7UFjnyfmIfS2tKXFZ3WBg1Nxt3pojK-0sw6Q&oe=6A16FF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbgBXjsZKP8Q7kNvwHCAjNp&_nc_oc=Adocy1WXY1jfUFOAhOkvh0zNtoIML8XWw_XvUmaA3Y3L2Za7CfPuaqUHOPHVIUi3ZZo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YF1Y39fexQeHO4TnKw91nXGAzRH0Rua7dtfN6LS9uLg&oe=6A170CF1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
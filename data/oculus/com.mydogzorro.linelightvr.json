Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHeKHnKLW94Q7kNvwG7hrQq&_nc_oc=Ado3W2ns0lA8gUA2EV_8fc7I4lyUJXwu2B7GVc4riUTw7IMLcY9zlPCVLljsd4vXdmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VB2cHq9IRrJdQ9nmgZxsWtL-2iAHuskervu5-TRT38g&oe=69DCF5EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpuJn4hIunEQ7kNvwE2_X_l&_nc_oc=Ador0AXTM4aPMG3LxyFMmTkwYXlnC8M-m1bFVtKevOSoA3Qh4Tdo2_sd2gQZ03T66rI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SQeu4JI7zHM6blJaEIhHjBxxj3QQfTf4kIWbfrSKz2A&oe=69DCE0DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE-yZ_9r6IkQ7kNvwFzjwur&_nc_oc=Adr-UjCcyyr2kEBRUJ5h1oqzNcAEm57sBL57QbL5C5nDJUKNegSCyZx9-3hIHI9AOJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n-hP9p48dM2apZqiC4LlVRskMQm5Pf_nPg7nRcrRGOg&oe=69DD01EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pamHXDMSV0YQ7kNvwHVMr0a&_nc_oc=AdocH_nQSB-GA2cGWWHdXh0CSfkaexGvbbAbTd71j-79VmuPaIQ76IeoPJ3orDUy2Zw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PyR8CkgosO4TUbKwLNVNnxTicawtINm71wSoXJJ4ayg&oe=69DCFD51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84ahG6nuyAMQ7kNvwE21Phx&_nc_oc=AdrJPOTOu3Qo6CRt6KFz0vtfqz5NqW2fTUYJ56cFl2-gcxxGqf1tOjqCaMnQTvc0NnM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03y5QiCEYbsSWXDMeCHG0ItOFPktM5GTLxS-IPNL7IaA&oe=69DCD2B1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
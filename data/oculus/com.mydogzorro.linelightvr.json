Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QhUcVMjuCwQ7kNvwEC1R_g&_nc_oc=AdpyJDybXwogyEzk69r1bXFqOFtEBg2p6kwOwHFdvMzD7U5EK2piOs0LtxHGZYRzt0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bUVGaxnL4paNCzxVGIMkYmaFFVxC8IBRRrd7wxvfK2w&oe=6A296CEE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCjD1F5cVo0Q7kNvwGTia7E&_nc_oc=AdrFKOJ6xG_ztttV8hP9dFv7PixK8fPf4Ftsqjfqc86F-Wm2jP-oeY-RLh_A4jGJqIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98M9KKpeEliWLZtAYild7Bf6duHBuJOSZyc1I5k_50aA&oe=6A2957DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwUBrymX2DUQ7kNvwFTpLyD&_nc_oc=AdoKcJjvlc6vZpG0xkAG0vO_WIUwjMf5nTaSEbd_S_2pkhmKmXVFTRUTJDhzm_5DW8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jnOJMUt5QWlCtOEg50fKzFQckZzmVWI179nnjmzEmjg&oe=6A2978EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT1etaokrwYQ7kNvwF1HNPD&_nc_oc=AdrPY_LOR4-xJBBhd9KPMSgTFLRpzvuAgRF_mhUGtaisHMZ5LQNbUqR6uYu3Gdq5cfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NZjWmJJcMw-NpRylx2BQ8gk_gNZ5gieyVYetCBTNX-w&oe=6A297451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LsJ2tVaf6UQ7kNvwG1cWi3&_nc_oc=Adr_-uKzaAJ1KueNQz1LOMKvO7gtW5KCS0tr4LBgVLykMpFwiByivj9lFychoMCcLws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TQl2k4E2Amw2s4D8TNJUkxiYkb7R4bZQj2YVJ_SBv1Q&oe=6A2981F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
NLkFP9fm7bkCSs3M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs2Sy6UXfIzMOrXogzBwNMlIGz6tc0evg_DAsUaw5jAw&oe=6A53AA71"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE9q2Qbpgy8Q7kNvwHZ32Bu&_nc_oc=AdpesKUvXiGCMkJExgyWjh7njTIpIVGsCfMms9obmlolvton30UCTg1JSJh0pDn5C3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD999GcpYNhbOnwDiSOAGry-9AduO4Wf2Xf_UwSkYEH6w&oe=6A53AB6B"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_TeBVmXOO4Q7kNvwGbMeai&_nc_oc=AdoV5mHZlr9rlYjFI08J-2d4iuRpFwPqkQnLcyR8ySW5sVnluHYmn4A5Q6sZdZHuvhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3J_pdrTDAhm2d8p2H8nsQ-uHrbJpkjP9ItXxEPM5S2Q&oe=6A538E11"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5AoP68tjL0Q7kNvwEnHBzp&_nc_oc=AdoNUltznbIN8eIiSBGep8teSB-zG116ceavriQs8_rHg219GcFTYrpu9k4zmNSv50o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl9shlgNWEjt9xEvgPAWx0AQPK44Q83iIkZ2k-Yk0P0g&oe=6A53A451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyRe-WGFeXYQ7kNvwFwj-BQ&_nc_oc=Adp0yzZYyuXxPDeUmV1E8GLJK2aPjn8bmCgchwZH_wEMWxwJ99K6zhaE2ZE4WyZFjzo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu-9ep-yOj6LeCSNn4ZD2erJats67oiRfHWxj4b_E3XQ&oe=6A53A687"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
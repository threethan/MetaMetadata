Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9LEdxfYQsYQ7kNvwG4EZaY&_nc_oc=AdplYQfteA64aLfZlPb4bt0wuifulDc6BoVhnmQnp0_M-aMBm0IXiyU1Kbmmnb4eBsg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qsDjUKFyW_01aa0GIOF5B48DrmuzMQ-bMAYpmqBBYRA&oe=6A0F0EEE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGDt0xJ4yrIQ7kNvwHyfMoq&_nc_oc=AdpHGRAOpX0mlD9-C-EZWadkzEm8cZbZqLCjUf3ICQ2NWW2T4Q1hlW7k7KUfOSG1Ib4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7niQpj8B7EnF8s5jhWqXaGfmsp7v9Ar9zMLLZSisKfLQ&oe=6A0EF9DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiFLvtMvuCsQ7kNvwHJONzD&_nc_oc=AdqBwtOG-3nCUd57dcvhvMkR7yx2mAzaujAKZ-9bhVWYkidt94Nw5FnbJNz2ZRy9kK0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z4tUlLd5Iio3TdpjLXoUpFTYaxlNGkg_wVtudr-5COg&oe=6A0F1AEE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XubnN2dt60Q7kNvwHUco9H&_nc_oc=AdonEbIsXWQts1mjCTFNBG1rqMgU2rJu1ANCzZCg-QxJLzZYBG6mL7WQxYEGSE3r2S8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vzFDspnHBehmA6Oz_MIxaCF0WuIoYVUCmK_nLO2BWlA&oe=6A0F1651"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VQsYqzm-gYQ7kNvwGfTnM6&_nc_oc=Adrg0hq7wzUpe6vDKHX-JaYyiHB8g2h21_YbC4X0vRWvtAXgkarkhJfUCX06AwfoHtE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GZfGPvLOGubK7R8pZa9ht1GFh6SXe1d0gBmCzQRJNXA&oe=6A0F23F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
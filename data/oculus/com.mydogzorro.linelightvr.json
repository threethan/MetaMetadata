vpK7xac26-s7EPNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8j5aUlqhYJuSiC9ptxzZK7usR0THuZXjMgzMJ9dGKcw&oe=6ABFC571"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4KGtgm1vtYQ7kNvwH1xy25&_nc_oc=AdoJP9RuqPigOyTJXhO1GGLUe1wWSSaUEySZ_QroPZ0s7KQIvSHOPfbvEse2w7npDzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtBvNm93MyILTGdPxHjHwxkLIY41HmS4Grz2y4HEoI7g&oe=6ABFC66B"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWwWMkv1Z1MQ7kNvwFOwKVx&_nc_oc=AdprnC2H35MTMDbcV4WmzaphyP5CHvYfYfbTGUj0h-b-EVa6b52H676aV5XNNuhdM8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvf_FtLf_gQKMZb9nKfex_n7ZlgfrS2sXsNZT3dQv-vw&oe=6ABFA911"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUJ2iJoWS6UQ7kNvwF2es9w&_nc_oc=Adr3AEvcXaCTSdjNNer84AY_ptSySRDsF98NYPZcOnwTud9QWR6rNbt1o-rpq10x66M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIPMBRxguGf9qQdrRSzDoIDMwKIWg-lkkYRph_ONGQ8g&oe=6ABFBF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzJPEoQhGKAQ7kNvwFynDki&_nc_oc=Adqdtq3q2MzSt_iLN0ErkKOtb4bqb9fpiahgI-DqWt4TI82euGZlzf3M7tb8N0Chbhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvby7m7MO9tHOvKGtyOue3hvfTti_gb1kf4AxagPnGrA&oe=6ABFC187"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4yzNRT38HcQ7kNvwEK0jKM&_nc_oc=AdouT1Uw_sd-QynFTQeX51MRqJxU9b4z7FLNgponTJsm_HrJW7tp-lZCBm1QC5kCg_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRnJ-ecn1ST4ovEZTOhgvgdwnAWgZ9R1h-KBuubIONbA&oe=6AE0AD6E"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0UU2nnGyUUQ7kNvwH8oPMC&_nc_oc=Ado_wvH2L_BCveDKnhRY43QaBS47grMPFocL7pKa5tqLOs8brxcrni4ZoTWGrSx-G8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj7ePMA24T4mHEKHm7RlUboBVua9rnPEHWfZ4wTZwTUQ&oe=6AE0985B"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD2TAOzmc7kQ7kNvwE_a8s5&_nc_oc=AdrFJON1QBvR_J4prgnjokv7OdIQA7Pit_NkQBTaYInn-yEkUtfOAlWJwi7Lo82Nez8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_-ZROooin0QmXpDZ5cuY5mU7GMQRcdcg6dUjUoIzsnw&oe=6AE0B96E"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJyNEywdudUQ7kNvwHmuLj2&_nc_oc=AdpXaHkhHBWAEyrCds2lUrr_wq1ixjpUcJRCW8qyzzWSCogj_d3J5rXlRNwxQdNj8Vs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgvGKR-qyagg_Ymx0_9-dI2V6XL9QVlwDKDUCdlZjhfA&oe=6AE0B4D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCIE_sfDvQQQ7kNvwFV8800&_nc_oc=Adqa1iHSWU4RidfZmS5eBkMU8YZThqRtwHsV16YGK5Eo7yeM34ZEgzVJedVY5PW-Txk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRW2-XzC_ss30h17A2-WtBBb29DOjkXzRNUzN2fXGXRg&oe=6AE0C271"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
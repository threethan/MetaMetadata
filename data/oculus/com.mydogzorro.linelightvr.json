Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAmSy87mGYsQ7kNvwHrtvZ5&_nc_oc=AdoR5aMTN-8N_b4QLE-QsFY54qjba-RXS_QNXAqwn_7aryXDbndMh9veR7TJxVy3pbg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnPAjfwND0oh7_VUZ8PHJxE6G799Vw3107kkyhomjfOw&oe=6A806FEE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czSS3mX5mcEQ7kNvwGBj94I&_nc_oc=Adoqt30cowwQMBoW2RfFgqvXJiKk3_t4NyC6vWyOiIfB7M6kloEZLNqvn87Ohh2hbPQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf9s-7cXRkpGYrKx5qAt99XzRIYyklAFPn6wuROVmvMg&oe=6A805ADB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7GkBQC99ocQ7kNvwFmCh9k&_nc_oc=AdocQ1ZEPl6gb-7eaoYLXFDxY9mewUtXGg6SCHoMf2SHqVFlIc29o4s7GXvaw6k5mjs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8DlTm4OUrszAPTE-UrY2XSLtRvw1QJRh72zucm7sc5Q&oe=6A8043AE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikTkrWRTtf4Q7kNvwHveROF&_nc_oc=AdpTPOSx_7pRnVRW-j4UWnPw9ygjNLxL4BlEZEHwrka1zozn-KXe27x5zkt_aOdiYqk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl78gqC6u8QylVfSEO2krCeynG9aBHN1xGfpSkeT9_QQ&oe=6A803F11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRW6FijYuQsQ7kNvwH-Lc4i&_nc_oc=AdrUB3smv0yr4Yqsz1PxEyeFd-rgSjKBJJMbS0cE0LUTzMSf6_evrgxR4GAzp2IR2y8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2y-k6dP3BB1RFfmYC-t_bqFCSRE4mvB1U_AyhGOm5qw&oe=6A804CB1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAmSy87mGYsQ7kNvwF5Sxvq&_nc_oc=AdqnpXV34WO82c8lhn-KbuALHHBV69gsd-lZ0kFHDLCHs1lM0Ocv1hz4xuZVzrDIMZg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsuevB4RHXLsVRBXkoSjiQqfXgP6zVHSikGvD8YsdTaw&oe=6A81C16E"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czSS3mX5mcEQ7kNvwHJhD7i&_nc_oc=Adq-OaIXVGmLIS1ZWpTHenq15CBNFsru_x3Bvrfx_xl6Ro_vHy-s_QNCRWVeK6G9PKs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFETXY8P6F2A7npEzIBiBAtCDrIZ37OfXcUqeU4qyNt_g&oe=6A81AC5B"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYuB1whKNUwQ7kNvwGLDDfo&_nc_oc=AdrNngW1XHLXPNuYL5KkEehFGm0C7eG5nuTJYR50RlSuqADVvjBI0EXItqiwyLF0m6g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2wSU3ralm4WX0qJMEd1la7dhWFuzOl-f_sjJYFGPwEQ&oe=6A81952E"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikTkrWRTtf4Q7kNvwGBMjul&_nc_oc=AdpcwVH16u8C81F_V7ZLy94_TPD3UlO_esMDuvXwC4JrE8JBZmyPewxG5d5-axEZPd4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxjD9JZcwwDOfYmkJEYGefql_8KwL7CuQ_1Kdlaqanzg&oe=6A819091"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRW6FijYuQsQ7kNvwGoR2ng&_nc_oc=Adok-vS_ExmCZDkcSiBpIgmLuVLbPR3Uu3mo3xvsfkZRsc26wdUipNrBsKrlOjhM108&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZTaD17idSe4z_cyTwj8_GkBRVgbFQQEE4BU7vM6l-nw&oe=6A819E31"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNIuV888kQcQ7kNvwHQsWvC&_nc_oc=AdohfD1i4m-VplYx6c6qMGYbphR7BKwI56MR5Z08oO9dsLj7rX222yqcseDM2ysbcgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3kDc6MU-GFxoM9YLOox1eeXP2kHD1RFOcmPJuN6u9tQ&oe=6A5E28EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_H0j_lCG8gQ7kNvwGTgv7n&_nc_oc=Adp-saTNRyqH_zJtAt6kyBY-gJ5WJHywGE7hhx0ei1h5bYFpsu7ECRuEGbUf8Zl2KkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCbgFzwF7proBai62agUMAzk_noNvRrf_kDfiRYVbytA&oe=6A5E13DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPytzXeyi1IQ7kNvwER_xDM&_nc_oc=AdoTiZSGAsj6dP6XROGjxiALupaH42EIv3QeHcJd5-HRJ0Q8GzKgSV9PpTDFoRfya9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbNDYMXAg5KTM8Z4QBPMIvVremtmlRs9O2G8XavLpIDA&oe=6A5E34EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4r_2Oh8GjhwQ7kNvwHYqVYH&_nc_oc=AdoTxTBaJgz2yPxEIDHZX03BTYNwPMyG0-Ty25Kvr2fqWN0FgIkRMZc5glvmRsWBmhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhxT5sSws78HkRQWCZyy9eWfFPUDPUHCsXAN6gkgZgMw&oe=6A5E3051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0XePM_ERmoQ7kNvwF0wfRB&_nc_oc=AdpyDX750HJUmFUSGUNynQ7uOzIrW9bxd4fIehKe_IC41cjOPsgCN8RYgI0-9jF_BmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO1UPEN07ZwR07KtD2xbT1G-gzPb-2pnf4cieszzOPNQ&oe=6A5E3DF1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
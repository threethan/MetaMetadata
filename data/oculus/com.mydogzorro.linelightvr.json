Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWQbeoBkhDYQ7kNvwE-D5jN&_nc_oc=AdoTHsWM8YljzvWpvjuILxuGoULb00MovA_5EbmiFSbRulTjqRKlt_evS_HTzF03TGc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YwoF7d8TvknkE96nlSK8dNNjRni-SD4T9PsSPiFmj1w&oe=6A26C9EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07udLtD-8SgQ7kNvwHqQZbh&_nc_oc=AdpNDbuIIgY-cnLdIQSWzVbfGvaiCM-AKP4et08dQ6rnpkeV9EACMJoPkl3XeS17sJU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q84HJrGfaPNY3idrLhADMmt9G7w-Fpne5-Fw-X3NIiQ&oe=6A26ED1B"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwUBrymX2DUQ7kNvwEyl4Si&_nc_oc=AdqWeFoTYagtZTMpBZ3d_BfulpbwPSCEM9aIJRffnQ-dnWjyAEB8-8IuLpyQpBadTOc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l2Y2VccfSwHUC2B0s4xxix8AvThowb38pem5tyHrxMg&oe=6A26D5EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOAv7_lYDmMQ7kNvwFDUP8u&_nc_oc=Adp7UzGWrcDso4Nwi7PFT87pG0y8Ita5MN8-gu8X41EueJwqzBdwjVqnLyiwxbV0PoQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AnWt_zOtoGX2QYHLeVPWbqR7HR4wtfPjDYrYwn6-fFQ&oe=6A26D151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWaKfRvsk2MQ7kNvwHpMt0l&_nc_oc=Adq1j6w7FWJrHdVyrI799j63LKV8SWcMpXJM3MDawzrCEtm6g_k3Rcav6JCxmYHYWxQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88aFmjV7RPciTntPKkw3rA27j-3EzMyYkmkpviytM5nA&oe=6A26DEF1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
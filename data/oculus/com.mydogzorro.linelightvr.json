U52-dKAQ9Tm2GI5bPZHhS2kA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Uscqfmb-KWyExJuuDQsbkBg6ZU9ureQvF9lbY2pGmNw&oe=6A394C71"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUczkH4AIF0Q7kNvwHAHz-0&_nc_oc=AdqY-GKnt2VOtYayQ3VKWukKFaBmQT2MH8DYQFMr9_VJWhRboXXKZ21fPHr_3qpVaeU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_h1N_W8hx24ZA4Gg-YI6yWYorISbGNyMTAJGgzXRGGw&oe=6A394D6B"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfSOWHGf_cwQ7kNvwGImVN_&_nc_oc=Adr_N3c90p0OJlwnKGpFxf9wUsTkEagb9e4VAYToSwGDTMpxJjhNPs2tIw5xF4ubtGI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UR1sl67mq7oVqU7iKiHzGFyMrzJOu6JhyXYEJ2TsQdw&oe=6A393011"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uroTOH4ezdkQ7kNvwFLnNvE&_nc_oc=AdogendmLaXfJH0e_O2JQ7NnuMEZ98uOltCy7rR73dPLBrY-pECJ8__ZbkG0V8Ow-Gc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8Rm6urxhCSLUZW14KtuoLCAOvR3IAos7ujGaYz95XDg&oe=6A394651"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qse_7S4VoQUQ7kNvwEc4JhT&_nc_oc=AdohZEf_k6D1167raivmGsxAdkQednspJS28_s_tZO25cMAvuTunKBNB6fxscFQGlm0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eCVCRGMu8ygP3vCEy6IIxAybhAxXNPmdxAlghG5gZfg&oe=6A394887"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "de
Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2k_qARbJRsQ7kNvwH6gb9c&_nc_oc=Adp9D5YhrNYlLrdHf808Tx8kCHPogrgiMWEivJX53B7usFGc7NsoG1aRbKfFYpwXlSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r2it8ydfuGiSiNnjw-4PeAPm5gSJNiJSmScHWfhEGtQ&oe=69FF3CEE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqjIlE8EyV0Q7kNvwFml5Z0&_nc_oc=Adofwht4XfBMZM8rc5veDReMncbe-Eg1sUqFeRTMZwWxxWZ0f2QuzcRozGmY0xAEE-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jHSXR0hnfktCA5Rpkh3uOUq9jDIOET8Xado4riQefIw&oe=69FF27DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIZ_c-ZO2pAQ7kNvwGsEUCg&_nc_oc=AdrHKoGj48rff5OApOuIQIMtdkUKX9esXNIdUZ7DRsG6ImX4Prpmc0NosufYxiJjsYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pkMzD5eKTua1HVrebps7QWHgmFHRoSX-OBRZPEmRj7A&oe=69FF48EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlcMlYmfeeAQ7kNvwHHhaFl&_nc_oc=AdpMS_q0nq7DB0dz-Z_ka8eMU10txql2NtzQG50Nv636ddmGVEi97rHnAKo7KAsy7Gg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6outGjBLx7rzyhalC7Rgq2lOTIBcqp8t9ANkRbsOT0gg&oe=69FF4451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkAMW6YrqUwQ7kNvwEXZxGW&_nc_oc=AdrV-tZbitnEA-_f6SlTBZmMwLFXPBvvzjqMYssVvkLV_KTRIR5njluMU7R5951UKRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pqwX1a11PtYrtM3RHS6m8rmqNpWogWkKaIM_hSDPw1A&oe=69FF51F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9-1zS8g_b4Q7kNvwHPXdAc&_nc_oc=AdpV_Jpl-HP1lDzw6-qexOytsP8pHow4rrpIsEqyN64Mat4zV7hEC0CZXH3S6_h5tyg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyfdskd_2CL12Y17ITUtNVX3QXy3LbiFkNnMLH34LbCA&oe=6AC4FDEE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACbAYrE6dZUQ7kNvwGVWQ_d&_nc_oc=Adqu-2EBqpnEAHaQTeADl4GU-75MwWM9w77xxgYT3pJP2c11GhvwyVFpJkhNgJZ1Opw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAK5SWFvxYUdb_HUARqyo4LUNRqowwqrp2mExnqTkhYQ&oe=6AC5211B"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVpRu_CQl_wQ7kNvwHpKhoa&_nc_oc=AdpVF9D9MNOBYTwIKq4FKRrcQ_fJwgkT6efqwKIMPSomhTmwUQ0mFBah06Avfzzdwng&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4DUAG2iyX5ADAR2f5QLJ-hoEJNAcOOg0rVeVttFzlzA&oe=6AC509EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpmdACeLYFIQ7kNvwFwvT0a&_nc_oc=AdoEWRXIRYs76u-pt1rsZBQ6IkksWfwaMeCQrJ7uHRcLlBbZLWUKkIAXRH7sTFG6zIs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPDgUzWwDCeRMcJE_tkrFBhR3xncix1pViRbpkhxgzzw&oe=6AC50551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUUbZvPGTPMQ7kNvwFugGPD&_nc_oc=AdqTi37tQv7JxOiyFwWl6lY_kOdECi22c01unJny2jDur5EhtJyva744EHaESD-nfWU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpCjP8G9noKfJnQjZY22A2thtwGeOMmnh9w2NWJGraIQ&oe=6AC512F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
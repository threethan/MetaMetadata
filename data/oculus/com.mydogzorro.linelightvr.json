9I81mbP9BvBj3n2I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qvh6B9Dae8ZCKfwnTOrxwZXbF-HWFdSwyExfQ-Cl_bQ&oe=6A243471"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuMoPESujDkQ7kNvwG3ICsa&_nc_oc=AdocyjQmE-uPLnCsuLrzTx6-wKKiet3J7vcgg_77_ONrORPchrshxf3Prq7JDb7r9uM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rrZ1oEIZd-Uw7nht4oRRJsqIb-8ibsFmI65ILE5183g&oe=6A24356B"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1h_I0X3pAIQ7kNvwFVu5CD&_nc_oc=AdoRcJKEO1O80GUx_cA1mfVjpFAIJPPtYbxuDwohTnRmiFsSeAGzSKsA30aZV1zGq64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D2xNFmepmGi7oIA_LM1_DRolTg4Dq669imhDiqRWNlg&oe=6A241811"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO82feZwZKsQ7kNvwHd4RHZ&_nc_oc=AdpmQHtKE8C1gO4aKdlGOtPqChJaUX9jsuQAjHLrYYlaC52xk1l1Rg5LG-p0jdD-t24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v5eHKOhCFS2t5iR_cxULZvxdi937gW7-puigrQweFGg&oe=6A242E51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ca3O9Sd5RAQ7kNvwGenUdp&_nc_oc=AdpiFzhd8v-mn9hE2ZcyF6GhQ2_rRfZmYY8prE_wbYiYQ97zwK7DlPo2y1N6HJ4wXcY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JiD_aVfaPabQgZVm2OAnOjdQju2BShy8Ciy6EkTzCBg&oe=6A243087"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
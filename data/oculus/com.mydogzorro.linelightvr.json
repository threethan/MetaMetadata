Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOGlVMEO-98Q7kNvwF8tbAx&_nc_oc=Adp2Yc0XVJbRsGGbnUx5F8TkQr762kIcbdvtjSgX_ayGOw3Lrlu-FBU_3ER8dgAZM7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PNzZBs1-j2UL7jtVswd5opXlnnpTytYi67XMjIOoLyw&oe=6A3E84EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAzgxoFE3i8Q7kNvwGUZQjk&_nc_oc=AdoJkJakILylgcbVJ5VKHl46jn1OeObPHwSiaXoPRY75RwUDHXVqycf2keLd5_ax64Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_biiQs8p40NYgHnPMYGVMaBnBgq8ne4Vgq8fZusMWz4A&oe=6A3EA81B"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SORl2-gougQ7kNvwG_jfRw&_nc_oc=AdpC0I1LAOvMCDhBkRMVw2QD9XaSyPFhUkabfmM2h34m1G8AGWvmCCPdRcaVhH5lRLM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CRvqli8PJQubWWTenjSgGLJf11so1JPEvZ231Jojblg&oe=6A3E90EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU19j1xHYvcQ7kNvwEWy-C5&_nc_oc=AdqJJ1lS-5KiBm6UySievITzoYWfXD0nrXKMemzBSUuj-XP_dMZXyZOkv2ppt5pDwiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o8kJE7-abJ81mxk-84Nyr3AAFavBa7DJQJ7bPHbPvnw&oe=6A3E8C51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4rarHTEhBwQ7kNvwGQ-USM&_nc_oc=AdpoYCeYaqZ2b22cxIdOZEwJC_u7TW_mhoINIikfsMQfmvafcMaJ50dZ80SHathyYkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dekl8tBw1NFBAmkOp_peo3STuJOTc_8s6dRaLBR5M8g&oe=6A3E99F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
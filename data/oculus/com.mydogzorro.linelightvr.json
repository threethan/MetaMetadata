h1XndjNEDfHbY5Oo3tLrwwWc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8OK6lzyA_5gnxaJfBxm9KdW2ZXcVD4l6wS5zJszyRiQ&oe=6AA415F1"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VCttaybCdIQ7kNvwEWp5M3&_nc_oc=Adq-ZffPOw_Q43X75MtMNqSughW83tzZ14uWwAaRqty2gRjc4tOfsrVjvlfGVEElV94&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR_nYHdsNGZAfQkiVTLvEHCxx8y-iSCCXL9P_CZLBthQ&oe=6AA416EB"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Veg-2ccAGEUQ7kNvwFehkGG&_nc_oc=AdpWZ5rPuHA-Nvq3-pB1G0b68MdRvAMl-nOz5cQf78-d7y_DqkkfMeLESGKTsu8kcXk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHN_-LaF6_5zfGq9Rv-OXz6rFWHM7HFkgJ5huIWywkPg&oe=6AA3F991"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IO3MniPGiAsQ7kNvwGzpQdS&_nc_oc=AdrfKGmyfy_YsqbZgXgUkcA_GfmjhdXuyPxOj7vnf8Kg-9yGz6BIAYSGL4gNxo8okCU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp74506biPIr3fiHAfKoThaD35tuBapCvm_93lSnb6vw&oe=6AA40FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2CCt_iJm8oQ7kNvwHIbCYU&_nc_oc=AdqDaG_4UpuecqWdhql3SVOjYpTe-Kt6f2DbQBTpvJ24j-lftxH8cyWMVWEoOIkq_IU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa9Y00bR46aijPBF0JiMM8O9M0CTZjAhhd9wntwgGEDw&oe=6AA41207"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "de
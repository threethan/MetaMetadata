CEZbgIyI62Srk0JF3EG8pYELPWrY4mEYot2Ibzw5w&oe=6AFC68EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4KukLM0DWAQ7kNvwFK5IG9&_nc_oc=Ado1s4C4Yst5ykeyqAe1SgYWmOfMt6RpU07G_KnLYFxueNcA4OH3h6Ms68fR3g0E6uY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTs4caglHdOkkroDWQQU0k6UNA5iQ0iCW-Ed6FBHU-Mg&oe=6AFC6451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtFyXOPuGEMQ7kNvwHHhLk0&_nc_oc=Adpqvj0GFZPfmFEw_tl9zxU-8Ob-NH8gCsZlSKSgBVXOsuZdithjvh1wB0Q_Nk0qXzM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcF5o8jvKhQeDw0pjClv-W3Q8ZTRudMjO4VxTQEryOog&oe=6AFC71F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "it", "ja", "ru", "de", "fr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "490219139553978"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1137098505483768"}, {"status": "PUBLISHED", "id": "2173025716890132"}, {"status": "PUBLISHED", "id": "2494331751046118"}, {"status": "PUBLISHED", "id": "27476324285332764"}, {"status": "PUBLISHED", "id": "1512019007372093"}, {"status": "PUBLISHED", "id": "1003821761997719"}, {"status": "PUBLISHED", "id": "1250115637322550"}, {"status": "PUBLISHED", "id": "1355127576635039"}, {"status": "PUBLISHED", "id": "1685244969550306"}, {"status": "PUBLISHED", "id": "893872996417090"}, {"status": "PUBLISHED", "id": "1398386221931165"}, {"status": "PUBLIS
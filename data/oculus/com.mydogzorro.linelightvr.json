Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED1qNWsyEyYQ7kNvwFuoYXi&_nc_oc=AdrNGDNpjbMtC_mvrnPn237mOSmPLOuHi-tzaebhz35m7F4Cs2NegJz8QQOG4ZSMpQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J6y53Ueq05ZNepuptdi2eCyXl0C4MYEe-iASuXPBebQ&oe=69ECC7EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKWiDTfIj6sQ7kNvwGm6gvl&_nc_oc=Adp4CL8YO1DTK6IiFU9TaE14uMQ4dPZAji7DBsGdNkTGAdUoZjMjNLzQgbMfeXy4u40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ebfHdbdgfKd56CgUDbG2H1Qlo8CM59O9R7LcZN-R1Pg&oe=69ECB2DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmF3zh9rjLsQ7kNvwGHDjPf&_nc_oc=AdpJa5dA56gf1WYMzQaqwfGEapTG_LTiIgEa9_ZUJqpSk3W4gHoR8HCe-0-qOaCumdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j9q2bEq74kuUU6_jSneFWBImWYmV6cKUs_wy36DUKaw&oe=69ECD3EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uskRF-w2jjoQ7kNvwG8XE9E&_nc_oc=AdqFj_6Ddy8PL1EizROOjbYkdYTUMX6swn0pSYH5OEqlbRNdt8byUAGkQtYj16ZbEME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B-a-YSWZdV3IpWSt53lDt7_jCS8raB7AhaaH1D1DbLw&oe=69ECCF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOH0T4DDWjsQ7kNvwGBvjE-&_nc_oc=AdrBylte8xVR6q722fiXkJ9Sn9utG3TmGVPgvgdjGaZov8_yZhtisgZLQmonwob1R9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A2oQ2F9WsWWoj6_ZUEpydoSdqkggxhz76AKIE47_kIA&oe=69ECA4B1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
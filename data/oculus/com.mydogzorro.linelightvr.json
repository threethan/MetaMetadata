Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqNMqV8xAtUQ7kNvwEcnkyw&_nc_oc=AdpVmSCdaXoWLnPp2tO82GDsRS4-1QAt9CIhgvu_h0DpyeWT8RqzTrWS2pqZ3N-i_Jo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aQXn-sKgA1u-JM7ZnoEPJJD-VL3Yya77PGV-PcNmgJQ&oe=69E23BEE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0XqqVmS2BcQ7kNvwGOS-PE&_nc_oc=AdphLW2yLnnu2goR0rRnCnnUBQ3oM2N5kePJjGpfnzD2jzaT8BlNSBpxGBfcdE8pbSw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08RI0WDGOLKpjrYTTtX4TXQ7BD_aR-9TZUXAd1sM2RbA&oe=69E226DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ8tDthLSs0Q7kNvwF2_2RA&_nc_oc=AdpjdM8YUgYP9H29Q9DwmxA_sb473wkDnfG_gFc7zSjolVsRIY3KPyknFedpPU1C8hs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZOI7cvYb7TktmxGz8uDkutjSso8sUKmjcuu_6tfep6w&oe=69E247EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_Z32Mt91_wQ7kNvwGCC_w9&_nc_oc=Adq2u3SvZj7vUtDwFCXCmO0nONNLnen0FMFwhc8sz6lHz0GxcXOlE7FChUs2mMK3C1E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uvzrKSbHc3yO-SBeBZmmLJPkkeRFtQeOyc2VKGJLlyg&oe=69E24351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKNgxfg5Zq8Q7kNvwEFEX55&_nc_oc=AdoR0kybWiOXgXoL7_8i1uL-06U_m--Rl8UPpEOsHN_8EL6bFEOpRAN4niZK8EtaSmY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13tc-JQXZXB0d46XI1CZF68V4b68cLaX7Kep_KCJ0Ogw&oe=69E250F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
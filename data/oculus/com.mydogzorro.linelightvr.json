rr8QL_xv4YH5Ntnc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pcU2T8uD69-_LP3Ya_eqnJFj7Wig5w0q56ohdIq7gXQ&oe=69D633B1"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek2H5wS7aI8Q7kNvwH0jqK0&_nc_oc=AdrDJUrSvguSwoeSLq2_Z5HD3ton-Z9bZJ8DEzNWLKpFemnz1Cfu1QVbNa1BotOPeJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jtmMP583kaiq-pWZDO5p3XY6tdq9jk4fxan4J5yz6Vg&oe=69D634AB"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5VIs63Ve5kQ7kNvwHhz2CY&_nc_oc=Adoc5B8D_SY2vG907aaT1J4QPwZ_T8i-4gaYmFHWg0zTJelgLEq5_aM2zzxyAriZBoc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wZ1HR8ImLKTXmz8DCjVsIHF8GvdiZIucldxdxFlWmgw&oe=69D64F91"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rz86yKoxg4Q7kNvwHOxD-j&_nc_oc=Adqt8uTs1yc01UEIO4v9M2EgYLRLmrbDXDJr7Zvc26TLjQoqbfjSZ2285AAfzMSQdjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sdFj6_gXA8ylGUNlcKCfXct73K9ZWKRZyuVZ0i-NzvA&oe=69D665D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r6mX5EeyuQQ7kNvwHW5_wb&_nc_oc=AdpgC9wk5PQbAvmgcv-wThl-6arljG6w6d30w4WnHPaTcktLTE0P4unjphXrsXU9HqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34JqwgfCFiqcC6j_vqM07Owzgs3itJfjietSdj794YxA&oe=69D66807"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
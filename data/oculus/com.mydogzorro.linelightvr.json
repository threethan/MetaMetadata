Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQW0Ci8W3Y4Q7kNvwFavW_k&_nc_oc=Adp0WMKTx4HIQbf1LrolynuKHQj7_Ea7h9e2KWlO9WrXc00c4hezVXr45eOjNkvGhyc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCn3am2XRTLV4FXcygabO42Ma95zPzR-6zZxFUStkGSQ&oe=6AD0DB6E"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm0wt6IHpswQ7kNvwFlNPKr&_nc_oc=AdrWZE1NZIrWiWRVd3aXfUj6xpYIR-2Xe8hQ8CgRD5QUoWcerbKrsbIQmlq_Vsj8Mmc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvvN0gVFPGahDUXKKpikDruFAWzPSDHXH4vceNX3VfOQ&oe=6AD0FE9B"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LktfeWxhEesQ7kNvwHDOa2E&_nc_oc=Ado49I8Xh0m614OvHWLW0xW9v1yZh7-OJjmk45Cp3Uliby4QdHD1PFjKcUiGigykmy4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDiF88YB6zQt8FzhL4M29NS1vXQBSL6rchtCdkdw5aXg&oe=6AD0E76E"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkItho8gG2wQ7kNvwGbVfkX&_nc_oc=AdqTXq2Nh-vUKHHmPrfOSxClrNCuPF3U_u02txYchTP60fw8dojsXiAKfSha6BjiXHM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVCHbGD1ZQ97jEkNsMvyHyhX3f9ouOjwNn9nLjdWb-nw&oe=6AD0E2D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQUgEmx3-VAQ7kNvwHiq6mp&_nc_oc=AdqFJw6kocho-uG4P3OHajqtscOEF2oDDuu8l-8Z-Fdy62_xJF6cyVZFRG0L2VDznKc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM05S95sBhyv-6UziyEo2O6AP8pLKCc3sTteso1Mkgy_Q&oe=6AD0F071"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
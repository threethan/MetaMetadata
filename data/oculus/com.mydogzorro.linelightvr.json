}, {"file_name": "Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2-47qHnCbkQ7kNvwHBvDl-&_nc_oc=AdpPD5aLr1L8fIwMOFJnivKwX24YsWS-6WA2Xa2MbOxy3FH7aPCy-TPWf2Eu372z8pU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7icgx5UbwGoMBpwDF8LCiXZzje00bUiAHlCIRNmNZn1Q&oe=6A11B1EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAz7_yMVMikQ7kNvwEB5wGX&_nc_oc=Adph6y9skbZW0S-B19csnzmzdKDGBDQmK2SywDx_6kDE3f45DEElQtgl6LJBG4zLokQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54RpynrgBVEzDzAUvP7NZC2xvRZt0JpRE7r1DiP_fcEg&oe=6A119CDB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiFLvtMvuCsQ7kNvwGHdxid&_nc_oc=AdrSbodfthxd_jIz0Sx0MSQbcuufiKras-LSKyYeXbHMjZn7ffev_MdoDzmwjhba_qE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AtD7o-5kjLUhmpCtnaifFTlu7C2s1SmiWQS9GcJCcDA&oe=6A11BDEE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xo2BldDV_kQ7kNvwHQxwx-&_nc_oc=AdrLTaWLshK--tWUHaY0zB7OnralFlKv5qVT-q74wRpLlOJEMOdRrItNezG3NrfTSIo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61EzQ5i908cDkoVSCykHwDytr3OPBfrVtY3fvUJaO4Sw&oe=6A11B951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kc3TWzP6DdUQ7kNvwGZc1Yt&_nc_oc=Adqx7a8HRCdBlWlQeISo6m3dh1P3p6gIqXI040gVOTPl8ifpk1025p3okY05aX21X2A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HZJgcuzBgjWh0l6r3JJedb_EB1hD3zIlNpvxvJpOlew&oe=6A11C6F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id
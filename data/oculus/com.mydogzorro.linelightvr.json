Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfYvtP63FUQQ7kNvwFzH3wF&_nc_oc=AdpQwG_zDDYTQS5FbTKZM1T-QrMqA_P6mPd_WJtM2SLZnGasI5JlVASVTv7USS49x0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1bYT9n1QtqQpi-hc2AlE3h5KengZQnT_S3xGy-Yh65Q&oe=6AAFE5EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o78qufKpeqsQ7kNvwERYZxf&_nc_oc=Adp83hA25Oip_7d_lyzox64u8JzNgk5l9vr5rdNWD7vra2NJR76kkJW56sPC9mhrrz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7oRWer2Q7IoPAjojU2Z3ZnrX7VzgEpbkXLWJk4awLlA&oe=6AAFD0DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DhmUxY6_TEQ7kNvwHhFjaX&_nc_oc=AdpvwudW4JSq9w7sl2e7uWsE6ksfK8jvqx3YVRJb6iaDQQmOzUlxa1TG82-4bD1sZr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLokiMdjdbz_aQp9P93U5--qbaIgzeGVPOXy3zjyn7xVg&oe=6AAFF1EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfS-9pxJYqYQ7kNvwGdr9pw&_nc_oc=Adovvb_PivWKUyDuuSWKhg750YgeyQMCG3d23SwsNKh7Sm7JlC_oOuEsUw7KNGWekDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdMGkaL_lsrx6OY5XB8kJuZiq2H7h4Yx5pgmWHHGIYig&oe=6AAFED51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrzNewnZc-EQ7kNvwElEw_R&_nc_oc=Adq6kJvgo-rdrZM4Ad89gnkLPBbfO7-U__S1KE638EX6M5UFt4ZMfZ7fByV99aekysU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd6d8SijjcdXhNCGMLPhGFd9O2Y8wywaWbaKFRZMP9aw&oe=6AAFFAF1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
YOXgE528x8Mh3Lqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wv-HhUu7-wem6svysHatui0lm_372bD0Y8iufpn4TpA&oe=6A0B27F1"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9AnBj-UnDAQ7kNvwHUlEIE&_nc_oc=AdpUsWFqX3IoXp0O6gCqnkXyv9I2OFbghvigspG4_DY0PpBvpnGc55G7E_0NeoMYQr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44Oq7RhYEa5EGTcOZAu5V51ydcBVFhB34tVO-HoWIUMA&oe=6A0B28EB"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSJAXnzzb7oQ7kNvwFvMRuz&_nc_oc=AdpNfyO6UiEHGY2yywUSdHvseJWhOn5RmnD2j_i7VHM02ufzLxh5NsFfcJq8A-FaWsk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lv1rXt0fYtspimvRSCLNWr5DKnkdwU8H6oUbFL57eyQ&oe=6A0B0B91"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRDXcXHgSAYQ7kNvwEfqAdi&_nc_oc=AdopsV32oCdH3_VUh3j0eJjzVmFNvvzORvsXlAoEsBIJEypkLOQ7LMoCq2Nd0m06-bU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PH72o_kQNuzegbRT46yEiTo5lu_I3PrVxaJgHhwO-Zw&oe=6A0B21D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVZYLH-PMvsQ7kNvwHtehNH&_nc_oc=Ado9L2z5Yf_7-Spo_iCDP1TZ29ykiNp5jwSzVhDegRfNuQXZBVJw83Di2tTgRPOXhLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BYLDFVrbNMSwlQZ_EJR9x2I1u1tugw_BszVEEsXjsig&oe=6A0B2407"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
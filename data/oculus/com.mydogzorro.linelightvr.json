rSae855AuVEtJz4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1717lLj8Xoi5GjYBorwGtpuzoUZwjBy1iMe5ClpnImA&oe=6A4529F1"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt5QQ-QdNagQ7kNvwHF62YT&_nc_oc=AdpUx5bMnbJvJOvLWoYyBHgfYZsmqvc-Gh4mw5JzMnMwD3A5ZGyZgaUSk266JPVSYXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-93f8I5pKn7OUDw7i_S6YG_SpSc-jVQJK9VV8L4SL7MQ&oe=6A452AEB"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgnRG9UdtQAQ7kNvwFji0Mq&_nc_oc=Ado4FPq6Vqsh6PkhfRzoCosqDvJoSspIZ6nmFzenF5jdm7OgMJtJX7f90jMcmY4Fci8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vrWAgINHx1AoFQLlzlEoQdn2xAqCBKaxNNnLvYO1cUQ&oe=6A450D91"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E1vtbCVU1sQ7kNvwEAbVcu&_nc_oc=AdqkK3Aiw3aDlJS7kRerD78n68pYche6y5TQtxbQJOaMiI5wHzxsAkXSZwRrf02F0po&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-d3_ulWVSQLeF8qbvklR1543zLCcXmQYCHF9l5CY7xg&oe=6A4523D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWVbjtTOtQIQ7kNvwGS2MPn&_nc_oc=AdrjhYv5U2vYTEArv2W3RjrOMiE0woq-fsZQ7NwovLNmy32AQpBx-ifeo0r49T8hxGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZRj2XWTmHzpqpYZUzTRJdgKewF9zWuQJvZv2Dfurq9Q&oe=6A452607"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
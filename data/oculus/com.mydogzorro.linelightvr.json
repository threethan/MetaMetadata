Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P4YUh1B6KUQ7kNvwH5LofU&_nc_oc=AdoOk4GSsoymhJQ6ECWDCrvtZxsS2Dxq8lmQuYVGjkyuctuMitd9AimQEwpJA3kL8QI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEGjhN-JlN9Otfnno1nntZgq5uU8LJAPFIOjrNgaNpmw&oe=6A50F9EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PLTh_kKaaUQ7kNvwEPLT46&_nc_oc=AdriY5S6anx5VS6mfJJnh9eJjpjZK-PiMXbNHFojWGcoHrOdkU9Fh9GvjSlg3zUZdqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZdTrGQ-rmtpQXZcJL3cg8_IMkqgog7y07ttw2qibqtQ&oe=6A50E4DB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxqCdtOlhnMQ7kNvwF9vW7U&_nc_oc=AdrOEWwuBMnFl3akEgRPjBnoDf6CdmRCnRMKQNvFj6gsPf3MW2AxrGaKWh8H3n3hRxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYJZQWMTYSM--Sc4Mvae0T5R2Nky9LQQfCk_Mo95dVkQ&oe=6A5105EE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5AoP68tjL0Q7kNvwFoMjS1&_nc_oc=AdrnVffMcnfGHE_TS_XpvSYoXE4AuDDtwoV9kh8O4QjXRulTDdxdeuGpHg56p3_2BSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBsowCDAwiZr9pfBqzcQzeFEBSf4Nz9AGNm0paHiMosQ&oe=6A510151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdahE-uuBK4Q7kNvwH6KGhr&_nc_oc=AdrvpLI_1Nb58b9NTEy27QaLXsQPHM2zEsKUBS791__Wl7wE_fQNHu0cCrs72pOShGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl3z4JshB-zkIw_5ITHhxRiXdDrA91OT8VqcITArAZBw&oe=6A510EF1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
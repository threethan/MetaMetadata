Aa-qSvxBxkgz-2dI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjgTwAIxBnquFBGJ_gv86LBx877IQtXABYpk1wS1QdcA&oe=6A564D71"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE9q2Qbpgy8Q7kNvwEUZAVJ&_nc_oc=AdrFgFRXHkHNpio55IFxkGrkPNE4gh1kzAyzbkUKRNpy9H39RLoz_GXgf6BeNv8ie3E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRANWoFVns9YRzfc00zI8u-vShpvb6O8T9KhTgUlblNQ&oe=6A564E6B"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ8bZSku-m4Q7kNvwHJGf5L&_nc_oc=AdpvIJvWTFy4ezwyZBEhTIEdpV7rje5P5AmyjEMJU9jO-VSOzlp1gYdh36r2OYpYSeA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm4Xw8fggwlkqrf-a0h25RvMnJ2qtA4RLGQt6G1eEKbQ&oe=6A563111"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLWOpdtPh80Q7kNvwFxsMWN&_nc_oc=Ado9f8vTdqwDrdvb7bUK9BgPAnOWqxJxkZimmF2AUgwn6jIG44xzutCAXcgltnLqfSg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEqRShMJhDkewJ_IC_Nyi6BoqZ8dvXh-0THoEbrwEAJA&oe=6A564751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_qhuV-IRfkQ7kNvwEtijpv&_nc_oc=Adr8L74kiTq53nQ_y_ViTfRqC-S7D04IhtUzV6vAwy6Bc8X9_PpHcEXbxoaUlt3HgnY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXSraA54eUf9dTxR4kKhwbCJdf47EyvfipBK59oq07fQ&oe=6A564987"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
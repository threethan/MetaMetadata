Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKHD3enaPZQQ7kNvwHtQ69A&_nc_oc=AdrqYMhG7beWOqx9VIR2vduYYlhoAkac0YpT8wl5BKvELAqJ_-njJg7Wo_8gJ56xHow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ig10421OHDmm13S87WJSKkmUy5v34N4SuZtJfAaFXXA&oe=6A0482EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lOAnogjgeMQ7kNvwHnq4jU&_nc_oc=AdpHZWmCUAgfJW3dsbbxk9c7wITAE1nEgoFb2bayVnChwTJTSs3sNXI_RmMxbj7siBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nwlkrdFK726DjVQ5WQq7gFo8VDi4Pfl43MXPQ7Uu3ig&oe=6A046DDB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjT-0BTG9YAQ7kNvwHPEbsM&_nc_oc=AdqUrzkcJHMixPIc6WRSFqCGLoLILDPU00EIZBDXlHH1RWss_7NMG7f5eGtfmQrwbFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5usfJfNZtL-nCQPZ1jD5sW8QCNORTx5f8HBUjYgLBWvA&oe=6A048EEE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_Ic8TBZJxMQ7kNvwEVzykZ&_nc_oc=AdoX2NvB2kpHjqmvcffP5qaFKpgQwV72-fTFgI7q2CQCBG4fMtMaVDMcnKxd8K56KTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iVOhfo6SDXYJRizvdsz1P42n9MxuEHWaeXu03YnL0Iw&oe=6A048A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5GwVdv_ef4Q7kNvwF_EA2v&_nc_oc=AdroEmaDHJnlFT1RnOQZIMX379oS12zlhmN-nybq2AumE30vTg1p-KW2XsYkeRjVTCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VumUeV3XufRiQ522l_G4VE9L2s6pq4r1lmMTQAf8Gzw&oe=6A0497F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
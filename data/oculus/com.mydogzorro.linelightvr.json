}, {"file_name": "Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlTmu4cDAxQQ7kNvwGkG1hD&_nc_oc=AdrS8TJERbzaA5NxadwxoyG809kyA-BjiYfM45Gxo_w8a26YFLRaqtIFtTHWacOvP8c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OatuGVCZB8KT7enVjMNn1vix1bT6DuK3NyjSEjuZisA&oe=6A393EEE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fSahVxSSykQ7kNvwHrw730&_nc_oc=AdoR-M2Zp1Gg_YN2lLly6xIEC3eNFfBuvj7WAVNRfuZoTQ8ejU_3OJMnhc-qb1bauE4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G0YyuZNWGVIidYUcamYAEw1jts8XPHxVbomYKthUqmw&oe=6A39621B"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS0dySqTTIAQ7kNvwEWfQqy&_nc_oc=Adr9cPB4T-fhz3hBPztRq2alfK7KKemQMecrpy54iGgudyEGp4NrPoSvq9g3GmBMWj0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qi7iVs8qIZFn0LBXFMmOwZ2HpRRBXpV1OaV9u1Yt38Q&oe=6A394AEE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uroTOH4ezdkQ7kNvwFLnNvE&_nc_oc=AdogendmLaXfJH0e_O2JQ7NnuMEZ98uOltCy7rR73dPLBrY-pECJ8__ZbkG0V8Ow-Gc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8Rm6urxhCSLUZW14KtuoLCAOvR3IAos7ujGaYz95XDg&oe=6A394651"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfRUGpithWoQ7kNvwFH8bNR&_nc_oc=Adr4dtk4GCafaICudxGnRFWb3GVSF36PXy1FbgHpqIkVDO8aXnxYmuc3h0v0nfSNbh8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TQ8HictgrJb7xnbbdrrz_vS04lwU0xt0aWalR04XG-g&oe=6A3953F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id
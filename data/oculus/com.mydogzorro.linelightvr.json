Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfVTjzl3vVIQ7kNvwG6X4N0&_nc_oc=AdrF_1iUCrl7iXruMtO6vXOw0aF7A2m-Vab7T49lpqmJUkBU7S1b45igCDD2cK6sfyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3du3bX4gwEgv9Z-dg4ZVAlJ5nnsk0QVnjwpkrEZdSWiw&oe=69F753EE"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXSspgU2qgwQ7kNvwEGEsAE&_nc_oc=AdoaIvZQHFsmkfA6HasuzT6ATzDVvfxJN3ohgRL2Ehi8eOxcEix1nefkxLMrLvn5UKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EcoLZ09LCpbF439pQrCGaGXCJouXcL8UviwAkHQK2Yg&oe=69F73EDB"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z07GgxTTmZ0Q7kNvwEv3kBg&_nc_oc=AdpxXkxN6KfOliuUQ04ESbNzns8b6FnXEFhUwTT2l4-peibBev0sj63eSyNKl1JHPSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XFimXjMeLzZ8JNtwqXwmhk6b8hgjrNycyuND3LTO2_Q&oe=69F75FEE"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_lZpn9Q5ckQ7kNvwFt55-i&_nc_oc=AdoDwix_6gNdgwKwEnx_RxAs5PAZrnLR8pmwL6FnjcloTuk1OTkgqenA4-6XIuDlguI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dmClvJR2ac00gyHU75ykPiSfh-BwBHbKqzWZQAeRM8w&oe=69F75B51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zam3SKWA6W4Q7kNvwGM1b50&_nc_oc=AdpHugrl0XiF5x9IhsZFOTmwTI5NUtj1s1rMTDiVS_Cz-Wai5geCp5hQ93jVzYqU26Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1a_Ggim-QeFDX9pl8jAE_EkzW-2WEwJhBylTX_nCkEDQ&oe=69F768F1"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
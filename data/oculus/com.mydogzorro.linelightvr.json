cgCV78OvHVhDcwzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkL_nlULecK-zY2iL1pgEIESrkMxsdbJb16hqcD0stLQ&oe=6A82E831"}, {"file_name": "Screen2.0_2.png", "id": "860969648755151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031482_860969655421817_7250004433927392978_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xV2H4Cmq48Q7kNvwF6cHH3&_nc_oc=Ado9jpAhjo3USzL2qIBaveA1NvU6Vk5x4679n9IQtye31zmh_PBH8_xjusBDHax2KgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8EyhrklBHAfmIrDGd853BxfDfXcLYhSuveoIV5tBZ_w&oe=6A82E92B"}, {"file_name": "Screen_3.png", "id": "686488486197832", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75340711_686488489531165_3887612596197806104_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaDBH76x_hkQ7kNvwFD0cY4&_nc_oc=AdrUeVAJJMGWAFxz_LhRbq3k9k47pLUE1PiBqSkxXOm9AVDF8f4FveYxn0p8CygU7pc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfx-1uAi6ORRbdIcFtxKa2n2YoC7JJsjUtoX-1yoM_Mg&oe=6A830411"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikTkrWRTtf4Q7kNvwEb-lXi&_nc_oc=AdqSFzQW3mp4Lv5sL2fScBTzRptk3uU3L8JEGP9OFp1cftUV5_GjIvUeFGTBMVMDehQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkg2wuaOoJ_LE_Mm5hUraMHrLOza7CB3rjjlKvWY5MSg&oe=6A831A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.PNG", "id": "3639415563013296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86631737_3639415566346629_2587602204312766019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hz3JyiXl0foQ7kNvwHJiArA&_nc_oc=AdouE6yhm_C_zBTTHodDvc1r4FKs5Oi79m2Cm6FGH8Xy3mrvWqXTEVIML7VXI2BgR9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEga9pWrv-B6McZU4_RF3BsQnJ9rotQiS84eM-uzz2e0A&oe=6A831C87"}, "display_name": "Linelight", "keywords": ["light", "relax", "easy", "indie", "calm"], "long_description": "**** 2.0 UPDATE: Passthrough and Hands! ****\nPlay Linelight in the real world with Passthrough, and control the game with your Hands! You can now enjoy Linelight in MR, and without controllers. It's pretty sweet!\n\nLinelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner.\n\nPLAY LAYING DOWN\nFinally, a VR game you can play horizontally! You can optionally play laying down comfortably with the game above you. This is about as relaxing as technology gets.\n\nYA GONNA FEEL SMART\nYou are going to feel smart.\n\nYOU CAN DO EET\nThe only control is to move. So whether this is your first game or your thousandth, you can pick it up in just a few seconds.\n\nMUCH CONTENT\nThere are over 6 worlds chock-filled with ingenious puzzles and surprises, with a total of 6-8 hours of delightful content.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cBursting with design smarts\u2026 For a chilled puzzling time, they don\u2019t get much better than this.\u201d - Rock Paper Shotgun\n\u201cPure, unadulterated gameplay.\u201d - Polygon\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cA crowning achievement in the puzzle genre\u2026 An unforgettably unique gaming experience.\u201d - OPNoobs (9/10)\n\u201cIngenious\u2026 The amount of times I said to myself \u2018Ooh, that\u2019s clever!\u2019 was too numerous to count.\u201d - God is a Geek (9/10)", "short_description": "Linelight is a relaxing, wholesome puzzle game with a big heart. Picture getting a back massage while grooving to chill electronic beats, solving clever, award-winning puzzles, always ready to discover what surprises wait around the corner."}]}, "developer_name": null, "developer_pr
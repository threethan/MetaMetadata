Screen_1.png", "id": "1101389073912428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1101389077245761_464993700154760639_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9-1zS8g_b4Q7kNvwHNp9CN&_nc_oc=AdpybzrCpMOb4-1RnZdoAEG1JaIe_6zB63Ubi7dElfDIp08E4ucWiCWs7hRiuJfht3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE8pGswQTeYSkXYYXq3-KUO2zJmW-iBkOB5iPmPEl15w&oe=6AC3AC6E"}, {"file_name": "ScreenOculus_2.png", "id": "554518532765120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_554518536098453_6797660129034605934_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACbAYrE6dZUQ7kNvwFVrwNo&_nc_oc=Adp_CmmDAd3uJYVtDcGv4D_punlAUTQHNY2yynk-ObW_w-R04zowcYEkaeHu9Yak2fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML907yDMF6iIZtq0YiyvC2clkf9lJBGFyMkCg74muRMg&oe=6AC3CF9B"}, {"file_name": "ScreenOculus_4.png", "id": "297862509198177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630198_297862512531510_5316383084041809641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxC0zywEu4EQ7kNvwFlOZz0&_nc_oc=Adqh45jrOYio7aTcVaS3z11pkr9r6e4uTGGYVnnglEH3Atpg7u425bbvDlJDtNs1W7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgiJ9-j2XYaXIaMbHyuKEMBDFTTikX6YVCPF51jsAMuA&oe=6AC3B86E"}, {"file_name": "ScreenOculus_3.png", "id": "843384520419991", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476594_843384523753324_5419118301108801806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpmdACeLYFIQ7kNvwG61ESg&_nc_oc=AdqokBTnCl6w3hqS5HW46uwscvoFmjyCn0jZG3cQKGBoiPUTpeJmy9hE_8SAXtxiGyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu4ShZhLhQgEkWQZZDby_3QPcLMkj4MzlrHanGSYpNyA&oe=6AC3B3D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LinelightVRTrailer1_Thumbnail2.png", "id": "1161998474712976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210889_1161998478046309_1510618440047115921_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUUbZvPGTPMQ7kNvwH-Oc3X&_nc_oc=AdpvqyARaxpv41mAV_Mf_HCj8qDENMwz3AfKdPypsXcG9aAzt9Qqb-SW3J2Y8KUvlJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAsKIl0tlaU3j3Tn3Ke15XFxT7A-GQOzuAOjc8NeFoCg&oe=6AC3C171"}, "display_name": "Linelight VR", "keywords": [], "long_description": "ANYONE CAN PLAY\nMovement is your only interaction. Whether you\u2019ve played hundreds of games or this is your first, Linelight will provide you an intuitive and rewarding experience.\n\nSOOTHING MUSIC\nPrepare to be soothed and energized, wrapped in a blanket of calm and focus, whisked away by a soundtrack that will open your eyes and relax your entire body.\n\nRICH CONTENT\nTraverse through 6 worlds and over 200 unique puzzles, each new world loaded with variety and depth, a curious series of discoveries and surprise. A feast awaits players looking for secrets and greater challenges.\n\nUNPREDICTABLE STORY\nYou\u2019ll make unexpected friends along your journey. You\u2019ll learn how to cooperate and overcome obstacles together. You will develop a relationship with bars of light without exchanging a word.\n\nQUOTES\n\u201cFinding a game like Linelight feels like a blessing.\u201d - GameSpot\n\u201cLinelight is nothing short of a stroke of genius.\u201d - Hardcore Gamer\n\u201cBursting with design smarts.\" - Rock Paper Shotgun", "short_description": "Linelight VR is an elegant, minimalist puzzle game set in a universe of lines. Its puzzles will awaken your mind as the music flows through your body, gifting you a soft, relaxing euphoria. Linelight is for players of any age or level of experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mydogzorro.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "My Dog Zorro", "support_website_url": null, "website_url": "http://mydogzorro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
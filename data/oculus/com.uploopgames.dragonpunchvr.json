le_name": "1008_x_1440_px.png", "id": "628408389882351", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821682_628408393215684_2154322744771544174_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8ejIBIzEjAQ7kNvwF7v6Yr&_nc_oc=Adp91fuX02v7TBm1rhgtt1gv8nWrAnH2rehKG_FjsW7G2dHzTeW7UuzeRxkUtVQazuY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVybxumfLw0jP9B0FbMvJrJTAPYvUT5Wfiu0jUwjJkNg&oe=6A5B7EBE"}]}, "id": "1442446013632020", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "704275955981355", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823366_704275962648021_1479824291091200714_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--MrFtyqE2YQ7kNvwEiXFC9&_nc_oc=AdqbAIg8jEfnJZfovRAKTUi-4N4CVfhTfPC-Az9-ha_hYipGcR6LV-0kAqhs0IFsfD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIYyU0vKv1xHCBIyoEgYZ-7oIOGV-KcfW3XIgQClH1PA&oe=6A5B6CE4"}, {"file_name": "2.png", "id": "1459631605177391", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820496_1459631608510724_7466360030071581782_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Slv_juaJK0Q7kNvwGDL3xE&_nc_oc=AdrKAYB-CjtqvKpcIajlyxeh_I9k14qSuwvQuFDxafJt7_VAxC8e8XUfE7Pxum8orZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJK_Q71FfW6aa_sQrGGWdVtCCE9vyKTQwbxZFT3uckUg&oe=6A5B7BB3"}, {"file_name": "3.png", "id": "3125896194238204", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819356_3125896197571537_1058297899318450084_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSVvcVBN9aIQ7kNvwGdC0hQ&_nc_oc=AdpB3WMIZ2dni5VpTIiB8qFyL59GjDxyJsWwkQxel2kBioj3T7yMCkp8_N9guURHGhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBkCezWKI9K80B7wO4qkLTrq-QQt1W4mMHqPwgHrONUQ&oe=6A5B75FC"}, {"file_name": "4.png", "id": "2312057445913161", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_2312057452579827_3193975262162400230_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAx7stexyU8Q7kNvwFR-SCa&_nc_oc=AdpOcI0p8z4XzWrg_Du2hkNChofaTTszyIJBQLFxTZdBPpV4eLdId4ThvnAw88gHMlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfNnzUaPpI_9CZZ5rNPILtKpBGRA0EI0XANB9m7jB2UA&oe=6A5B82CE"}, {"file_name": "5.png", "id": "793477676674994", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_793477683341660_9129332577464886601_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J00bRv_SkSYQ7kNvwG4fkLL&_nc_oc=AdpNZuTwAI1_TkFdckEdIydGomoNvbcFmZe1pOeRMzmh6aSN7NyOJVU1yBnWCI6shVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtu9jEtgAftuMF835zJXGq1h8VNp0nGoa4_q_UkYfXdA&oe=6A5B7705"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_x_1440px.png", "id": "1466009524439046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821568_1466009531105712_7125777077249795726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZ4wPkI-uAUQ7kNvwEMIZMT&_nc_oc=AdqinHdVaWUV8su9zfsvYcas4ElYlf6-IzmZ8c5pepg_XCI4mGWuo2p7_suB5gb3GNo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF2ZTO0sH-aMd0iw7CHC6QK7NWRn0y8V37Q0M-Bj5uJg&oe=6A5B7E62"}, "display_name": "Dragon Punch VR", "keywords": ["Arcade", "Boxing", "Simulator", "Fitness", "Relief"], "long_description": "The neon glow of a sprawling metropolis reflects in your visor. Below, the city buzzes with life, but up here on this rooftop, it's just you and the machine: Dragon Punch.\n\nWelcome to the ultimate arcade punch simulator, designed for pure, satisfying fun. Grip your controllers, take a breath, and unleash your most powerful strike against the bag. Watch the digits fly as the machine calculates the raw force of your punch. There are no complicated rules and no opponents\u2014just you against your own limits.\n\nImmerse yourself in a breathtaking sci-fi cityscape as you focus on a single goal: beating your last score. With intuitive physics and impactful haptic feedback, every connection feels incredibly real and gratifying.\n\nDragon Punch VR is the perfect experience for a quick, high-energy session. Challenge yourself to set a new personal best, blow off some steam after a long day, or enjoy the simple, addictive thrill of landing the perfect punch.\n\nDo you have what it takes to land a legendary strike? Step into the arena. Test your might.", "short_description": "Unleash your power in Dragon Punch VR! Step up to the classic arcade punch machine, reimagined on a stunning neon sci-fi rooftop. Test your strength, perfect your technique, and chase your personal high score. This is the ultimate VR strength test and stress reliever. How hard can you punch?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bitstormsolutions.com/privacy/vr-games.html", "developer_terms_of_service_url": null, "publisher_name": "Bitstorm Solutions", "support_website_url": null, "website_url": "https://bitstormsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24322785190665101"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "934283135809569"}, {"status": "PUBLISHED", "id": "1428547018792549"}, {"status": "PUBLISHED", "id": "1538546747555930"}]}, "baseline_offer": {"id": "934283135809569"}, "is_approved": true, "firstOffer": {"nodes"
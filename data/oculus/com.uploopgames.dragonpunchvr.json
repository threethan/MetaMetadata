-25/499622315_2126940664515985_2480053245621296946_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jufcW-DfuBwQ7kNvwGJxTS2&_nc_oc=Adqi7XcIa6C9gJJOK_zwPPoQgV1TNj8sWI7VfxRNRZzDsGIcEoyCZ6ytN3ySJ07sRgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPCI4maD95t_NmpqTVJ6SUN0WFadCCR9s5bwB0AVIhcg&oe=6A5B8C6F"}, {"file_name": "5.png", "id": "1658570428660257", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821230_1658570431993590_3833475771607692129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_h5p5P3clEQ7kNvwGAJ5VF&_nc_oc=AdqXzfKr1Q-_rrD9o4sgppleDgJ2RCfJMskvha7mwv9vqpMAHoDmrvtzaQuJL0hiCbw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3I8Tz-1pBbixKJIbLLc7n_izMQNRHfBtqcozPUe0x8A&oe=6A5B8AC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "resize_dragon_punch_2560_x_1440px_.png", "id": "1443429743759455", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820428_1443429750426121_5083552439472984664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0YcjodxargQ7kNvwEEwqM8&_nc_oc=AdqbMJttGs1iSlBUcZVwfp-03YBfrAFhDnboxu6TGpFFu_m10SgJTK9UVwK_qAIm6GQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbj2dSzYNlvX3bcDUmSB_jXKAWo30rTOxoZN0pXneYFQ&oe=6A5B6AA5"}, "display_name": "Dragon Punch - Arcade Punching Simulator", "keywords": ["Boxing", "punchbag", "workout", "stress", "party"], "long_description": "**A fast, satisfying VR punch machine challenge built for score chasers, stress relief, and party sessions.**\n\nThe neon glow of a sprawling metropolis reflects in your visor. Below, the city buzzes with life \u2014 but up here on this rooftop, it's just you and the machine. No complicated rules, no opponents. Just you, your controllers, and the raw thrill of landing the perfect strike.\n\n### \ud83e\udd4a Feel Every Punch\n- **Immersive haptic feedback:** Every connection reverberates through your hands.\n- **Realistic VR physics:** Registers your speed, angle, and technique for an accurate score.\n- **Instant gratification:** Watch the machine calculate the raw force of each hit.\n- **Cinematic setting:** A stunning neon sci-fi cityscape surrounds your **workout**.\n{1461462388954241}\n### \ud83c\udfaf Play Your Way\n- **Solo play:** Chase your personal best and break your own record.\n- **Party mode:** Pass the headset and challenge friends to top your score at your next **party**.\n- **Stress relief:** Nothing beats landing a perfect **punchbag** strike after a long day to relieve **stress**.\n- **Quick sessions:** No tutorials, no loading screens \u2014 just step up and start **boxing**.\n\nBuilt for instant replayability: one more punch, one more score.\n\n**Step onto the rooftop. Lock in. Throw your hardest punch.**\n", "short_description": "Dragon Punch VR drops you on a breathtaking neon sci-fi rooftop with one mission: hit the classic arcade punch machine as hard as you possibly can. Powered by realistic VR physics and immersive haptic feedback, every strike lands with incredible satisfaction. Chase your personal best, blow off steam after a long day, or challenge friends to beat your score. Zero complexity - just pure, addictive arcade fun. The ultimate VR stress reliever. How hard can YOU punch?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bitstormsolutions.com/privacy/vr-games", "developer_terms_of_service_url": null, "publisher_name": "Bitstorm Solutions", "support_website_url": null, "website_url": "https://bitstormsolutions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
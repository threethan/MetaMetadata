atus": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775216075, "id": "26314456171497983", "version": "1.000", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24029886653288291", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26490140557262876"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1089133155943761"}]}, "change_log": "What's New in this version:\n\nNew Sci-Fi City Environment\n- Completely new sci-fi city environment with buildings, skybox, and detailed city assets\n- Sign boards, banners, and a 3D game sign\n- Traffic system with animated vehicles and spline-based pathing\n- Atmospheric fog effects with edge fading\n- Sitting areas with chairs and planters\n\nDynamic Lighting System\n- New spotlight system with multiple dancing modes (ping pong, idle, static)\n- Colored spotlights with adjustable values and new light models\n- Spotlight controller for managing light behavior\n\nLeaderboard Integration\n- Online leaderboard system with full UI\n- Custom fonts, titles, and headings for the leaderboard display\n- OVR overlay canvas integration\n\nImproved Player Controls\n- Single controller locomotion: move and rotate from one controller\n- Sprint action added\n- Height adjustment with grip control\n- Event channel system for responsive input handling\n- Adjustable min/max player height\n\nPerformance & Build Improvements\n- Reduced build size\n- Texture optimization\n- Fixed play button lag\n- Log disabler for release builds\n\nSDK & Engine Updates\n- Updated Unity version\n- Updated Meta Core SDK and XR SDK\n\nTutorial & Audio\n- Updated and optimized tutorial screen\n- Added label counter sound\n\nBug Fixes\n- Fixed zeppelin collision and rotation issues\n- Fixed traffic move area boundaries\n- Fixed dancing lights and spotlight behavior\n- Fixed auto-punch triggering on ready state\n- Fixed leaderboard viewer entry\n- Fixed rotation and null data issues", "created_date": 1774339363, "id": "26203578055919129", "version": "1.000", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24029886653288291", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26490140557262876"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774335819, "id": "26203170965959838", "version": "1.000", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
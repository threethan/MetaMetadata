.5771-25/75530713_394501890322738_2368483963747482348_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDWV_caalKEQ7kNvwE_ue1U&_nc_oc=AdqGfVoGLAqaj-eEvlyIcK_5gJGiJmJl5g6d5OxmhWoK-ccrwO_kiq3zkFjwTJ9x7vc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSAY-7F6mFbpJrkPIo4dA2igmp6p4qMtOWoEROyEScQg&oe=6A803F32"}, {"file_name": "Rollercoaster_ThorsHammer_Landscape_05.png", "id": "573010462145467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974525_573010465478800_8478445341281713260_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7FBd1ovBKYQ7kNvwEu4FRq&_nc_oc=AdqrNlAoKyhkQpmgKJUZBTy-PBG9z5zo_zewG6JHfKoXjt7aW2VSFTkt0CPWr_BKm2w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxCyzn6VSGN-MPoqaEc7cuxx5kYJB6sOQHPACv-ImZDA&oe=6A8051B6"}, {"file_name": "Rollercoaster_ThorsHammer_Landscape_02.png", "id": "1297002228387583", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982492_1297002231720916_8749103067892034751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c90zneytniQQ7kNvwFdBjEW&_nc_oc=AdodL65JruUVo2idaeUh1pfZUNuvDd3EF4ksaaqAxymxEDvAAE9cdoKPCDpmuG_1NpA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGli9HQEKyV2yrEXF7GlNOeF2rxzimuKVDiHIf3biW5zw&oe=6A8065C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rollercoaster_ThorsHammer_Cover_Landscape_01 (1).png", "id": "1101995234892872", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982577_1101995238226205_4756768802256680288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPFFHi0ul9wQ7kNvwF8Fbsm&_nc_oc=AdpSR0x4vpp7oANIRGnPrVtA9o4OMt3PYA-4BgoHsAUukKB-LO5CnL5iuOhW-LN4dKk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8qjhTv_i3aEpfiixyz3p4Y0OK8KkiG98X1gC2x52ApQ&oe=6A806725"}, "display_name": "ROLLERCOASTER II Thor's Hammer", "keywords": ["Rollercoaster", "shooter", "fantasy", "kidfriendly", "bestselling"], "long_description": "The BEST SELLING rollercoaster is here! \nROLLERCOASTER II: Thor\u2019s Hammer transports you on a trip through Norse mythology. Coaster through the mythical land of Loki and Thor. Travel to Asgard on the rainbow Bifr\u00f6st before flying through the home of the Elves in Alfheim. Descend into Helheim, home of the dead, and zip through the cold winter weather of Niflheim while on a high-speed rollercoaster ride.\nYou can choose to sit back, relax and enjoy the ride, select the interactive mode to collect artefacts as you fly by or you can shoot the elves as you pass, just cause it\u2019s fun! \n\nExperience Norse mythology in an unbelievable non-stop rollercoaster ride. Meet giants, elves, trolls and a fire-breathing dragon while riding the coaster of a lifetime. This is not for the faint-hearted. Building off the RollerCoaster legacy, Thor\u2019s Hammer is an entirely new experience you will not want to miss!\n\n\n", "short_description": "The BEST SELLING rollercoaster is here! ROLLERCOASTER II: Thor\u2019s Hammer transports you on a trip through Norse mythology. Travel to Asgard on the rainbow Bifr\u00f6st before flying through the home of the Elves in Alfheim. Descend into Helheim, home of the dead, and zip through the cold winter weather of Niflheim while on a high-speed rollercoaster ride. You can choose to sit back and enjoy the ride or collect artefacts and shoot elves as you pass through! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arcticwolvesgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Arctic Wolves", "support_website_url": null, "website_url": "http://arcticwolvesgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
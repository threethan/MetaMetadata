_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWiaclrP-V8UfFQTZ6b_wih36RF3KdXcgEQ7rte5e3WA&oe=6B046B3A"}, {"file_name": "Rollercoaster_ThorsHammer_Landscape_04.png", "id": "394501883656072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75530713_394501890322738_2368483963747482348_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USg9HOLh4TMQ7kNvwH-WzEA&_nc_oc=AdrorIa9SXCfkhr0uBuu56gP6ZfPBcYb3fiVvrTkGkYGId2xu7HdUegJOkZTP6s8qi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTejC5HR4dCC-fe84qCmHwZn17Nf0dalPvoHU3mnZT2rA&oe=6B0485B2"}, {"file_name": "Rollercoaster_ThorsHammer_Landscape_05.png", "id": "573010462145467", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974525_573010465478800_8478445341281713260_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFU6xysqTgkQ7kNvwHQ9Kzh&_nc_oc=AdqWJYZNCUmbdrwNqJYGvDjcLq_HyhDUog4HKe_48Cu-yPs9LLc_XrW6jT0dgcAZV3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8BfBe8b-Y-PkVziqMb6NBE9Kp4815RslLQYfJiYC36w&oe=6B045FF6"}, {"file_name": "Rollercoaster_ThorsHammer_Landscape_02.png", "id": "1297002228387583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982492_1297002231720916_8749103067892034751_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJIGRaXiWowQ7kNvwHiilfo&_nc_oc=AdrzILj9U4tGwOboeYF_rUZcXW-C2XEj992yvOUz9wPdjIhUngpZw3pkg21gdLIUCek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx2CVylJTE0Eev1UEpZI-WXBqTfQ-8pba8-dCp2Vnicg&oe=6B047401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rollercoaster_ThorsHammer_Cover_Landscape_01 (1).png", "id": "1101995234892872", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982577_1101995238226205_4756768802256680288_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzLG8xogJI8Q7kNvwE9K3Ld&_nc_oc=AdrpJLzaUIiXF3k0uJi1eFpuPpLZxQVDOlfY3pbpf46tMHm46e42Vt-SPuHXEfzZhRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeDPM51bpoGWV7iJH8xSoyLRJYWlJVh3aNvjvuzRucVA&oe=6B047565"}, "display_name": "ROLLERCOASTER II Thor's Hammer", "keywords": ["Rollercoaster", "shooter", "fantasy", "kidfriendly", "bestselling"], "long_description": "The BEST SELLING rollercoaster is here! \nROLLERCOASTER II: Thor\u2019s Hammer transports you on a trip through Norse mythology. Coaster through the mythical land of Loki and Thor. Travel to Asgard on the rainbow Bifr\u00f6st before flying through the home of the Elves in Alfheim. Descend into Helheim, home of the dead, and zip through the cold winter weather of Niflheim while on a high-speed rollercoaster ride.\nYou can choose to sit back, relax and enjoy the ride, select the interactive mode to collect artefacts as you fly by or you can shoot the elves as you pass, just cause it\u2019s fun! \n\nExperience Norse mythology in an unbelievable non-stop rollercoaster ride. Meet giants, elves, trolls and a fire-breathing dragon while riding the coaster of a lifetime. This is not for the faint-hearted. Building off the RollerCoaster legacy, Thor\u2019s Hammer is an entirely new experience you will not want to miss!\n\n\n", "short_description": "The BEST SELLING rollercoaster is here! ROLLERCOASTER II: Thor\u2019s Hammer transports you on a trip through Norse mythology. Travel to Asgard on the rainbow Bifr\u00f6st before flying through the home of the Elves in Alfheim. Descend into Helheim, home of the dead, and zip through the cold winter weather of Niflheim while on a high-speed rollercoaster ride. You can choose to sit back and enjoy the ride or collect artefacts and shoot elves as you pass through! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arcticwolvesgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Arctic Wolves", "support_website_url": null, "website_url": "http://arcticwolvesgames.com/", "catego
.5771-25/75530713_394501890322738_2368483963747482348_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEYbehANEecQ7kNvwHVJhjG&_nc_oc=Adre--RBqyXcsr-gj_S-zojt0P3WcbYQoFKIQfPQxWm7cyugerXIGqCN9YP48wOTFqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YROvs2YYFHBmUZbyRXcZbv1hIeM_Ist6kpEs_chnrHw&oe=69F8ACF2"}, {"file_name": "Rollercoaster_ThorsHammer_Landscape_05.png", "id": "573010462145467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974525_573010465478800_8478445341281713260_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CojXAPRPcEsQ7kNvwEmhMFD&_nc_oc=AdoOaYc-SUEv9QD6eCDIbKr4epyUhZ9ikBwgCMkeWsirw-yEm7kv5brQF4uw7asANeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IWdr7laWjRi503Rwg38qWZih9k2ASP53n6zyT3l_lQA&oe=69F8BF76"}, {"file_name": "Rollercoaster_ThorsHammer_Landscape_02.png", "id": "1297002228387583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982492_1297002231720916_8749103067892034751_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwtPD-3ZsrEQ7kNvwGhQfbD&_nc_oc=AdqfUTe7rrRQnE6Ug0dgDMIlwC4U_afzcRDLoatuS8ulK806L9Y3z7c0ABQU4soFMo4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3N_XlxkTup8egRYzSsdTZkPZhOc4a5JZaa8LyIxRcfTQ&oe=69F89B41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rollercoaster_ThorsHammer_Cover_Landscape_01 (1).png", "id": "1101995234892872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982577_1101995238226205_4756768802256680288_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQtmSdtVKOoQ7kNvwHKet7v&_nc_oc=Adq3ZS6CDS--8xbZhKF-ngTkGD4SXTV3Qk2NypoaepupA7uAHZpAdGU8BUz7Up8Mlis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1juDkIfPo0mthTAno0YKwRb5tb9ubPwm1tK8WLXZ0rHQ&oe=69F89CA5"}, "display_name": "ROLLERCOASTER II Thor's Hammer", "keywords": ["Rollercoaster", "shooter", "fantasy", "kidfriendly", "bestselling"], "long_description": "The BEST SELLING rollercoaster is here! \nROLLERCOASTER II: Thor\u2019s Hammer transports you on a trip through Norse mythology. Coaster through the mythical land of Loki and Thor. Travel to Asgard on the rainbow Bifr\u00f6st before flying through the home of the Elves in Alfheim. Descend into Helheim, home of the dead, and zip through the cold winter weather of Niflheim while on a high-speed rollercoaster ride.\nYou can choose to sit back, relax and enjoy the ride, select the interactive mode to collect artefacts as you fly by or you can shoot the elves as you pass, just cause it\u2019s fun! \n\nExperience Norse mythology in an unbelievable non-stop rollercoaster ride. Meet giants, elves, trolls and a fire-breathing dragon while riding the coaster of a lifetime. This is not for the faint-hearted. Building off the RollerCoaster legacy, Thor\u2019s Hammer is an entirely new experience you will not want to miss!\n\n\n", "short_description": "The BEST SELLING rollercoaster is here! ROLLERCOASTER II: Thor\u2019s Hammer transports you on a trip through Norse mythology. Travel to Asgard on the rainbow Bifr\u00f6st before flying through the home of the Elves in Alfheim. Descend into Helheim, home of the dead, and zip through the cold winter weather of Niflheim while on a high-speed rollercoaster ride. You can choose to sit back and enjoy the ride or collect artefacts and shoot elves as you pass through! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arcticwolvesgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Arctic Wolves", "support_website_url": null, "website_url": "http://arcticwolvesgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
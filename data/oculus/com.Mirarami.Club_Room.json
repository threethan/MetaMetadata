&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VU7-qBRyw8Q7kNvwE4w9Tt&_nc_oc=AdrlwTTYpAw4C32Fn6_01UGHyLs2i6guAgWoJ518j4P5lOm_OfgvssOBKaOzRJhiIpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zjx4QNd74X0eKDXaAPgASJlfATlP0HJz-3M5bgKQl4g&oe=69D3C38A"}, {"file_name": "Penthouse.png", "id": "1098060239096361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830003_1098060242429694_1206993180414313162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVnbLN5AmYwQ7kNvwFREmMR&_nc_oc=Adp-1DPKNcIH1TLomGICWJ4Q0oyk-Mw0_yeHlGVePAz6sFwwtalinzeSDaNX8NRmB9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j6_TKyFSlDtBrzgjMGKBoU-dOj-a3scXNk3xYV7SOqw&oe=69D3BE7B"}, {"file_name": "Lobby.png", "id": "1485220415951721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1485220419285054_2274033094608148115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KIPVABgEDEQ7kNvwFcmpED&_nc_oc=AdpuipZ24gTV1mdfQsbA_ljp4j6RGjSoY16GlzfYJP3vYsaHnH0CvVMDrcY_mNBRsRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DXEvCMkufce3ZqlUR2s67xV2YkyjKwVjcIFvwSrsKXQ&oe=69D3C4AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "654890123783533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830428_654890127116866_3040991614659778694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UO75NzqvWnkQ7kNvwGmHMsV&_nc_oc=AdrMBWK7aDAZZee30m7fDKg2spYLzMl2BW7NSiRVGbMm2QJovNbvHKbPWRCPrzW0k6Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23kD6K_-Yqh9z52qrBcClIWpqomJ5GX10l6V48x9zH4Q&oe=69D3AD47"}, "display_name": "CLUB ROOM", "keywords": [], "long_description": "CLUB ROOM is a social VR experience where players can make friends, customize their spaces, and explore a connected virtual building. Every user starts with 300 in-game coins (GC), and more GC can be earned or purchased through IAP to unlock additional content.\n\nAt the heart of CLUB ROOM is a shared building:\n\nPublic Lobby & Rooftop: Meet other players, chat, and socialize.\n\nPrivate Apartments: Every player has their own apartment with a smart tablet to control lights, doors, textures, and privacy settings.\n\nUpgradable Spaces: Unlock and purchase new environments like the Penthouse, Tranquility, and private rooftops.\n\nSocial Features:\n\nAdd and manage friends.\n\nAccept or decline friend requests.\n\nSee who\u2019s online.\n\nVisit friends directly in their spaces.\n\nSwitch to private mode or set your space as \u201cnot joinable.\u201d\n\nTake selfies inside VR.\n\nMedia & Entertainment:\n\nIntegrated YouTube player in public and private spaces powered by GeckoView.\n\nKey Features at Launch:\n\n300 starting coins (GC).\n\nIn-app purchases for more GC.\n\nInteractive smart phone and tablet for managing friends, privacy, and customization.\n\nExpandable private spaces and environments.\n\nSmooth VR social interaction with multiplayer networking.\n\nThird-Party Software Notices\n\nThis app uses Mozilla GeckoView, which is licensed under the Mozilla Public License, v. 2.0 (MPL-2.0).", "short_description": "Social VR hub with private spaces, friends, and in-game currency."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://miraramigames.wixsite.com/mirarami/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
oe=699F078A"}, {"file_name": "Penthouse.png", "id": "1098060239096361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830003_1098060242429694_1206993180414313162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kta3_AMIVDoQ7kNvwFwjHo9&_nc_oc=AdmKRKyf7nh-wK3wQwZFuPwmR6COCi_LsI0EL249sU-pHfyseyNEMUG8Yq_xIWcYkhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs0ymSY7Jo2mkhFMuSnJYPQudldXlrFMUWi9SGxnJX2VQ&oe=699F027B"}, {"file_name": "Lobby.png", "id": "1485220415951721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300910_1485220419285054_2274033094608148115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=az9ef9lVVuIQ7kNvwGeRM1M&_nc_oc=AdmzKoi7eUCBZaE8wWPDJgHiWXWcF90JFu4585G4s-occ4JOynkz79_IUA7OOeRrwlU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftVrZJPDW1kq_eao7xnAJjztQ-40Sa-GMGE-HKdC-VzCg&oe=699F08AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "654890123783533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830428_654890127116866_3040991614659778694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGb17cHT2DcQ7kNvwH1A6Fa&_nc_oc=AdkEkhGbuZwMxWW_kR0mL1A1PTdtCm0Maptd7TlPGZUapz3Ql1-oT6K7NbQm14TOpcU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftY-lz_DveoxREUD03gkuQ2En31MrDA_ICk7dljlDFUGg&oe=699EF147"}, "display_name": "CLUB ROOM", "keywords": [], "long_description": "CLUB ROOM is a social VR experience where players can make friends, customize their spaces, and explore a connected virtual building. Every user starts with 300 in-game coins (GC), and more GC can be earned or purchased through IAP to unlock additional content.\n\nAt the heart of CLUB ROOM is a shared building:\n\nPublic Lobby & Rooftop: Meet other players, chat, and socialize.\n\nPrivate Apartments: Every player has their own apartment with a smart tablet to control lights, doors, textures, and privacy settings.\n\nUpgradable Spaces: Unlock and purchase new environments like the Penthouse, Tranquility, and private rooftops.\n\nSocial Features:\n\nAdd and manage friends.\n\nAccept or decline friend requests.\n\nSee who\u2019s online.\n\nVisit friends directly in their spaces.\n\nSwitch to private mode or set your space as \u201cnot joinable.\u201d\n\nTake selfies inside VR.\n\nMedia & Entertainment:\n\nIntegrated YouTube player in public and private spaces powered by GeckoView.\n\nKey Features at Launch:\n\n300 starting coins (GC).\n\nIn-app purchases for more GC.\n\nInteractive smart phone and tablet for managing friends, privacy, and customization.\n\nExpandable private spaces and environments.\n\nSmooth VR social interaction with multiplayer networking.\n\nThird-Party Software Notices\n\nThis app uses Mozilla GeckoView, which is licensed under the Mozilla Public License, v. 2.0 (MPL-2.0).", "short_description": "Social VR hub with private spaces, friends, and in-game currency."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://miraramigames.wixsite.com/mirarami/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24581776008152803"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
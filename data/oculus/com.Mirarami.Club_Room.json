530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrMjVEkLxb8Q7kNvwFj3Ca7&_nc_oc=AdrY7MlMoR_e6OP74i6nRzCvX30EfNpD6DUhXkQvZsiZ45VPd9Puhj4MPPodnh0hTcI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgN1ZRI4wlxePqBO9Yb4WdfTbA-B5r8NJCbq7skOybew&oe=6AD0E38A"}, {"file_name": "Penthouse.png", "id": "1098060239096361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830003_1098060242429694_1206993180414313162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qQjzcwn6FQQ7kNvwHFphsH&_nc_oc=Adqcmga4LH7XuXNV6ULAm07H5r1z3KDghX0CkpBW1wNAmh1fi5ELzJkQ6KUMKlKNrUk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1lyZlAJClWh3eiUglV9nJSFFR5G5vgR7YfhhX1LF85A&oe=6AD0DE7B"}, {"file_name": "Lobby.png", "id": "1485220415951721", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499300910_1485220419285054_2274033094608148115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhXsnLUCSnsQ7kNvwHtMmI3&_nc_oc=AdrhaGZbDH9B_A22Fz58F4qT87BDKjFNcLiMvvvL8-xcyeVq7OLDbXJgAyhP09BqrU0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZmN1prMKLpJ1wD2hWtFzxCoGkqgijNsBwHCMZ3eFawA&oe=6AD0E4AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Room_squared_image_template_landscape.png", "id": "1009916478661948", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620856_1009916481995281_2517722503735719699_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdraGJtIWR8Q7kNvwE4jeD8&_nc_oc=AdqvmLY4gTYdw1Ulesepqbcd0oqW2uN0-2AixOVsXSMxFInywajfCQUnlR8YngpIBsg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR-9YBN01Wk_OnxCeWTFEKdf1-7PBDW08YTREyWPpROQ&oe=6AD0F36D"}, "display_name": "CLUB ROOM", "keywords": [], "long_description": "CLUB ROOM is a 17+ social VR experience designed for adults\n\nCLUB ROOM is a social VR experience where players meet, explore, and customize their own spaces inside a connected virtual reality.\n\nAt the center of CLUB ROOM is a shared building designed for social interaction:\n\nPublic Spaces\nJoin others in the Lobby, City, and Rooftop. Meet players and explore together in real time.\n\nPrivate Apartments\nCustomize your own apartment using an in-app tablet to control lighting, doors, textures, and privacy.\n\nExpandable Living\nUnlock new environments including upgraded apartments and themed spaces.\n\nSocial Features\nAdd friends, manage requests, see who\u2019s online, join others instantly, block users, and control access to your space.\n\nMultiplayer Experience\nReal-time multiplayer with voice chat. Interact naturally with others, move between spaces, and experience a shared world that stays active while users are present.\n\nMedia & Events\nWatch videos together and create events in the Cinema.\n\nArcade & Mini-Games\nPlay built-in mini-games with more experiences added over time.\n\nCLUB ROOM CONNECT\nStream content from your PC into VR in supported spaces, including the Cinema and Studio Cinema (purchasable).\n\nCustomization & Items\nCollect and place items to personalize your space.\n\nEconomy\nPlayers start with in-game currency and can purchase more to unlock items and spaces.\n\nThird-Party Software Notices\nThis app uses Mozilla GeckoView, licensed under the Mozilla Public License, v. 2.0 (MPL-2.0).", "short_description": "17+ VR social platform with customizable spaces, friends, events, and shared experiences.\n"}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://mirarami.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "N
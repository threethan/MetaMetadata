l3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_5GuJse26tfNxeebyV-kDYTPWJ7fZBf39YU5y56t9Sw&oe=69BAB70A"}, {"file_name": "Penthouse.png", "id": "1098060239096361", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830003_1098060242429694_1206993180414313162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VZEoARc3c8Q7kNvwEeWX2X&_nc_oc=AdkC9ibRVoSD-sPqUAtWTDWx_EokNa8baUZ6cBErYvLTrxy2KKRf8w8LQw9BVZ8H3mU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlDV9fyOBODjlTvfKPQEWA1NwSgSfqILRqhGJ07RzSzA&oe=69BAB1FB"}, {"file_name": "Lobby.png", "id": "1485220415951721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300910_1485220419285054_2274033094608148115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zQHgmoWcRoQ7kNvwEYmKaT&_nc_oc=Adn4sCD0xGYtipHcrhMPNIS_-N70FARYfcKZbvwbXKI_PBthGXvxiccduQArNvrCevY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzkibXFqJ5V4QjdejM2pQqOwAvfWgmtjjQzcUPqzEd0dA&oe=69BA7FEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "654890123783533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830428_654890127116866_3040991614659778694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UyLHCCfT-gQ7kNvwGdwl2j&_nc_oc=Adnv9odW14vXd9czs9TCIjG7dxpWauWD1O1ff_O03smCPtj7oYoJ5MR6fU6ZV0RDMAU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_CPP0i6uc9AI4hfnw1B5tEHRW--xnznHIC5hnigPKXg&oe=69BAA0C7"}, "display_name": "CLUB ROOM", "keywords": [], "long_description": "CLUB ROOM is a social VR experience where players can make friends, customize their spaces, and explore a connected virtual building. Every user starts with 300 in-game coins (GC), and more GC can be earned or purchased through IAP to unlock additional content.\n\nAt the heart of CLUB ROOM is a shared building:\n\nPublic Lobby & Rooftop: Meet other players, chat, and socialize.\n\nPrivate Apartments: Every player has their own apartment with a smart tablet to control lights, doors, textures, and privacy settings.\n\nUpgradable Spaces: Unlock and purchase new environments like the Penthouse, Tranquility, and private rooftops.\n\nSocial Features:\n\nAdd and manage friends.\n\nAccept or decline friend requests.\n\nSee who\u2019s online.\n\nVisit friends directly in their spaces.\n\nSwitch to private mode or set your space as \u201cnot joinable.\u201d\n\nTake selfies inside VR.\n\nMedia & Entertainment:\n\nIntegrated YouTube player in public and private spaces powered by GeckoView.\n\nKey Features at Launch:\n\n300 starting coins (GC).\n\nIn-app purchases for more GC.\n\nInteractive smart phone and tablet for managing friends, privacy, and customization.\n\nExpandable private spaces and environments.\n\nSmooth VR social interaction with multiplayer networking.\n\nThird-Party Software Notices\n\nThis app uses Mozilla GeckoView, which is licensed under the Mozilla Public License, v. 2.0 (MPL-2.0).", "short_description": "Social VR hub with private spaces, friends, and in-game currency."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://miraramigames.wixsite.com/mirarami/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER",
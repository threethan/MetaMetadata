oe=69A0590A"}, {"file_name": "Penthouse.png", "id": "1098060239096361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830003_1098060242429694_1206993180414313162_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kta3_AMIVDoQ7kNvwFByZGv&_nc_oc=Adl6QusvddI7JamsyaGZolqvem45g19D_3nR1lPZA0s1MkT5_K-PR1o0i-Add81CoAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftI1kscAsVOVd9nwQh6wfTKuIPQUAI-0Aj6yNIqXIcMZw&oe=69A053FB"}, {"file_name": "Lobby.png", "id": "1485220415951721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300910_1485220419285054_2274033094608148115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOoU2Qn1WRQQ7kNvwEk2FrE&_nc_oc=AdmJqE4e8ixXS7k_eGYrX_XknccZ9AHN3T9sLVNtlrGt3W_F1DfHsG2-7jJKkH1FHKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvox_mkPueb718vYFspe2whmSZEB1yw5-2vxC3XaftgnA&oe=69A05A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "654890123783533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830428_654890127116866_3040991614659778694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H17KxWxUCaAQ7kNvwGnRCYG&_nc_oc=AdldzbEl0eMoYGBvCnR_90OatKPtP4X1aARWLvLmvO1AnfFW_trHVl_-ltnMoHYegXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvGInraA4QleOBTOU9gDs7H_VjMfxkNQY7EIe_OmWawTw&oe=69A042C7"}, "display_name": "CLUB ROOM", "keywords": [], "long_description": "CLUB ROOM is a social VR experience where players can make friends, customize their spaces, and explore a connected virtual building. Every user starts with 300 in-game coins (GC), and more GC can be earned or purchased through IAP to unlock additional content.\n\nAt the heart of CLUB ROOM is a shared building:\n\nPublic Lobby & Rooftop: Meet other players, chat, and socialize.\n\nPrivate Apartments: Every player has their own apartment with a smart tablet to control lights, doors, textures, and privacy settings.\n\nUpgradable Spaces: Unlock and purchase new environments like the Penthouse, Tranquility, and private rooftops.\n\nSocial Features:\n\nAdd and manage friends.\n\nAccept or decline friend requests.\n\nSee who\u2019s online.\n\nVisit friends directly in their spaces.\n\nSwitch to private mode or set your space as \u201cnot joinable.\u201d\n\nTake selfies inside VR.\n\nMedia & Entertainment:\n\nIntegrated YouTube player in public and private spaces powered by GeckoView.\n\nKey Features at Launch:\n\n300 starting coins (GC).\n\nIn-app purchases for more GC.\n\nInteractive smart phone and tablet for managing friends, privacy, and customization.\n\nExpandable private spaces and environments.\n\nSmooth VR social interaction with multiplayer networking.\n\nThird-Party Software Notices\n\nThis app uses Mozilla GeckoView, which is licensed under the Mozilla Public License, v. 2.0 (MPL-2.0).", "short_description": "Social VR hub with private spaces, friends, and in-game currency."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://miraramigames.wixsite.com/mirarami/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24581776008152803"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
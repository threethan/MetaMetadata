content-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8jMlPMbxvs9srHP4r75-xvL1W1NpQqHB9XvXjEHWuXQ&oe=6A8EE254"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "459185788764315", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974689_459185792097648_5683856776119591155_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHYexvXdCsYQ7kNvwFAnjR1&_nc_oc=Adq0wLuCniMkE6sxNhuNJxE9F_o6Obl51Q3sGF9Z4EQ1UZMr48SYWNfwiV_We1Bci0w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWJJMwUqd4U4jG0KSstDrW9vUge-b6M7U6hZzAv8uEjQ&oe=6A8EDC9D"}, "display_name": "ZOOKEEPER : Blast Quest", "keywords": ["puzzle", "blast", "zookeeper", "zoo", "shooting"], "long_description": "Experience new \"Zookeeper: Blast Quest\" where you will meet the familiar Zoo Owner and animals from ZOOKEEPER!\nPlay a brand-new feel Puzzle; Destroy matching color blocks using Shooter, more colors means more boosters and more explosion!\nDo well in the puzzle to collect stars, clear missions in the zoo; feeding animals, help visitors find their lost child, fish for food, and many more!\n\u25a0Rebuild the Zoo back to its former glory!\nThe Player's objective is to rebuild a large zoo which was abandoned a long time ago.\nRespond to requests from visitors and animals, Clear puzzles, and 7 areas with their story-rich content!\n1\uff09Monkey area\n2\uff09Giraffe area\n3\uff09Entrance Square\n4\uff09Petting area\n5\uff09Elephant area\n6\uff09Lion area\n7\uff09Crocodile and Hippo Area\n\u25a0Take on more and more puzzle stages filled with exciting new puzzle gimmicks!\n\u25a0Many Missions to clear in the zoo! Feed animals, Search for lost children, Fish for food, and many more\n\u25a0Aim for a full 3-star when clearing puzzles and unlocking secret animals!", "short_description": "Experience new \"Zookeeper: Blast Quest\" where you will meet the familiar Zoo Owner and animals from ZOOKEEPER!\nPlay a brand-new feel Puzzle; Destroy matching color b
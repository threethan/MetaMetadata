content-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr3f-qLFw4cPThFBwcSGGqTZ-mwVmMQfp4VCdvDHgEQQ&oe=6A85A7D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "459185788764315", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974689_459185792097648_5683856776119591155_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTdTA77PunwQ7kNvwEZUd8-&_nc_oc=AdoBBAKYBQNZtOcAx4m51e7i3c_iNxMSJ19r8ZPofAa2Hq6wDiOtSdLX01pqvr4bda4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDyWSiFZ6a4Z5ms1TjtDkdXY3W4CdWI3uLcw70ZWc6AQ&oe=6A85A21D"}, "display_name": "ZOOKEEPER : Blast Quest", "keywords": ["puzzle", "blast", "zookeeper", "zoo", "shooting"], "long_description": "Experience new \"Zookeeper: Blast Quest\" where you will meet the familiar Zoo Owner and animals from ZOOKEEPER!\nPlay a brand-new feel Puzzle; Destroy matching color blocks using Shooter, more colors means more boosters and more explosion!\nDo well in the puzzle to collect stars, clear missions in the zoo; feeding animals, help visitors find their lost child, fish for food, and many more!\n\u25a0Rebuild the Zoo back to its former glory!\nThe Player's objective is to rebuild a large zoo which was abandoned a long time ago.\nRespond to requests from visitors and animals, Clear puzzles, and 7 areas with their story-rich content!\n1\uff09Monkey area\n2\uff09Giraffe area\n3\uff09Entrance Square\n4\uff09Petting area\n5\uff09Elephant area\n6\uff09Lion area\n7\uff09Crocodile and Hippo Area\n\u25a0Take on more and more puzzle stages filled with exciting new puzzle gimmicks!\n\u25a0Many Missions to clear in the zoo! Feed animals, Search for lost children, Fish for food, and many more\n\u25a0Aim for a full 3-star when clearing puzzles and unlocking secret animals!", "short_description": "Experience new \"Zookeeper: Blast Quest\" where you will meet the familiar Zoo Owner and animals from ZOOKEEPER!\nPlay a brand-new feel Puzzle; Destroy matching color b
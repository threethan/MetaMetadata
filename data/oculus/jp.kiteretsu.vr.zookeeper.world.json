 means more boosters and more explosion!\nDo well in the puzzle and collect stars, clear missions in the zoo; feeding animals, help visitors find their lost child, fish for food, and many more!\nRebuild the Zoo back to its former glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kiteretsu.jp/en/projects/games/privacy-policy.html", "developer_terms_of_service_url": "https://kiteretsu.jp/en/projects/games/terms.html", "publisher_name": "KITERETSU Inc.", "support_website_url": null, "website_url": "https://kiteretsu.jp/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "337256521455955"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "483328076312975"}]}, "baseline_offer": {"id": "483328076312975"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1638489600, "status": "PUBLISHED", "id": "483328076312975"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8186668218029905", "version": "1.3.1"}, "id": "2665204173751837", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "348856
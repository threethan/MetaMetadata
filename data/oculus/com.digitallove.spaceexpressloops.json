s://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828608_1249747513666857_5218381075122761671_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlu7ND4m-vkQ7kNvwEky0sF&_nc_oc=AdowahQMDObc16UiRilOsc53kgZsUDKK1tvRun_fJKMWMh9eFC0foSFzEL2JQKDAmKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FEN4c018uZgvsg9GEhVPsrsxA7vFQNPj-D2nHvsCeRQ&oe=6A4281BB"}, {"file_name": "Screenshot 2.png", "id": "1169430989577214", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_1169430992910547_5141297303921455277_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7gsE-c9ZZAQ7kNvwH-50KI&_nc_oc=AdqL1zgdlTw__D0iaL_2pUC91vrEnNANv1Th_nJGUNKW-i8bkNRiwFYBxwraOr4Oato&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bvwR_uHma7BPnOf0Ha__yOuOuy5Q6WkzZj1Vldq8P9w&oe=6A42808B"}, {"file_name": "Screenshot 1.png", "id": "1468798751596244", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1468798758262910_905208213499651299_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6UAQqQJjcYQ7kNvwFuzFGp&_nc_oc=AdrXxuY26qM4l-Net0F33dpjIJmaQ0qPNKF2pfVCHJ2EJ58lmr9g6omHJtvt_ql3iB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KMxPAH7Eivby83qT2ut0IMmBOemChaXWDnvmjCxyVwA&oe=6A426554"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover - Landscape.png", "id": "1416305756969397", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831393_1416305760302730_6179199775378464349_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KziO49SfQsQQ7kNvwHxdjb2&_nc_oc=Adr6spCGZNIwiRJ_dsBaYFK8QZitF_YmZV5JwfteJlIGwPwzIHrAD1wOQqK4gNYB47A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eNI3wcMUk_SwISYcA6nYbky4ZKKt7MhDehvuDKwqtmQ&oe=6A427F96"}, "display_name": "Space Express Loops", "keywords": ["mixedreality", "idle", "space", "logistics", "relaxing"], "long_description": "\"Welcome to our space. Literally.\n\n\"Your room is now the headquarters of a glowing galactic empire. Space Express Loops uses Mixed Reality to turn your furniture into a vibrant logistics network.\n\nTRANSFORM YOUR SPACEYour coffee table is a waypoint; your walls are the gateway to the stars. Anchor your dynamic Hubs to your desk and watch planets manifest around your real-world objects. Your home is now a living, breathing space sector.\n\nINTUITIVE FLIGHT PATHSSetting up a trade route is as simple as a gesture. Grab a ship and drag it through the air to any planet.\n\n*   **Creative Curves:** Bend your paths around sofas or over lamps with smooth, flowing Bezier lines.\n    \n*   **Automated Loops:** Once a route is set, your ships travel indefinitely, collecting mail and locking in revenue.\n    \n*   **Dynamic Sectors:** Manage multiple ships and multi-colored Hubs as new planets spawn right in front of you.\n    \n\nCRITICAL LOGISTICSRelax and watch your room pulse with light, or optimize under pressure to beat your high score.\n\n*   **Manage the Backlog:** Watch those letter counters! If a single planet hits its maximum limit, the supply chain chokes and it's game over.\n    \n*   **Wipe and Restructure:** Use the Route Edit button directly over the Hub to clear lines instantly and adapt to new planets.\n    \n*   **Infinite Growth:** Expand your network, manage multi-colored sectors, and survive Jim\u2019s proprietary corporate snark.\n    \n\nClock in, Manager. The mail won't move itself, and those bonuses are waiting for you.", "short_description": "Turn your room into a high-stakes spatial logistics hub!\n\nSpace Express Loops brings an interplanetary mail network onto your furniture. Draw automatic flight paths between spawning planets, optimize dynamic Hubs, and watch the cash fly. Don't let outposts overflow, or your empire collapses. Master precise Bezier navigation, manage multi-colored sectors, and survive Jim\u2019s proprietary snark.\n\nCan you build the ultimate shipping route without crashing into your coffee table?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sel-policy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://linktr.ee/digitallovedev", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27210857888519878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823296_2059111904677985_9046149015003293413_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6EHh7n5-kMQ7kNvwGmkrw-&_nc_oc=Adr7bzEin4rmxdE2jwc4jnvS5uAXST_J0QqESLJKWdyLy-jWNkocG6woAow1H5XdtIQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kW6XzTxSnMG8JNJmxbGSJYd-UXu9GSmXaHEHS_EIhrQ&oe=6A4295CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Express Loops", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1779804480, "lastRevision": {"nodes": [{"id": "27210857928519874", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27210857875186546", "is_first_party": false, "
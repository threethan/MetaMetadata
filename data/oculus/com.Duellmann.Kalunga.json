rIoHtcjVg9BATp3KaOID4JqPxY6OHgKVi43rRSKPMUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW_GZydDKwYeGvSca-Qoftvyr9AY9YOlnRwdgm_K_9EA&oe=6AD22A97"}, {"file_name": "vlcsnap-2025-11-12-00h43m42s837.png", "id": "2645496325851029", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_2645496332517695_4027386133556597492_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T-BFi79Y0oQ7kNvwF68rUK&_nc_oc=AdoF2FxATMcMvhMl_gX5fUSR-95N4PcA7gQmsVrKDV6oNgrj8U1XaB6wzUkZykx6Zag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP0t7QC1HHWot36h2UjZ2--7u8V0QGsmVfCdY1-gW0mg&oe=6AD24DF3"}, {"file_name": "vlcsnap-2025-11-12-00h44m13s688.png", "id": "2434768090311840", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_2434768093645173_8184299653306517900_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyD2e4ArfCEQ7kNvwFbuT7b&_nc_oc=Adr8bwqP517HF5FafgZGRjd-5KJvR4-ZM8SrD1i5J4q0AWysFWcyJMhBzVIuJ9zRc4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyHBCKSIFnZ1AirAatKv7fk7zzZwwg_kK_hL7oEK3_Jg&oe=6AD23DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "1901427600462703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_1901427603796036_4604858399072733269_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX_D0iNLHG8Q7kNvwE9CI7n&_nc_oc=AdrLbaCT-vrnANyRDk13ai-HGdwoaQDfJVUV2MgS_H37NRYmyohuAH2sRC7WBCCxYWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMETZe8mFUq--4xt2h56cyIuIce9xMWM5olGBj0VH8WbA&oe=6AD24D8E"}, "display_name": "Kalunga", "keywords": ["Narrative", "Storytelling", "Story", "Tale"], "long_description": "Kalunga is an interactive VR narrative that follows Ilu, a young girl living with her family in a peaceful African village shaped by ritual, community, and oral tradition. Her world is grounded, intimate, and full of small moments... until one night, everything fractures.\n\nUnder the cover of darkness, slave traders raid the village. Ilu and her family are captured and forced onto a ship bound for Brazil, torn away from their land, language, and sense of belonging. The journey across the ocean becomes a liminal space between worlds: memory and loss, fear and resilience, reality and myth.\n\nThroughout the experience, Ilu is accompanied by Kalunga, her magical puppet, a symbolic bridge between imagination and survival. Kalunga is not just a companion, but a vessel for ancestral memory, inner strength, and resistance. Through interaction, the player helps Ilu navigate moments of despair, hope, and transformation, experiencing the story not as a distant observer, but as an emotional participant.\n\nKalunga blends immersive storytelling, symbolic interaction, and spatial design to explore themes of displacement, cultural memory, and the power of imagination in the face of trauma.", "short_description": "An interactive VR narrative following Ilu, a young girl taken from her village and forced onto a slave ship bound for Brazil. Guided by her magical puppet Kalunga, players experience a symbolic journey of memory, resilience, and hope."}]}, "developer_name": "Duellmann Filmproduktion", "developer_privacy_policy_url": "https://www.duellmann-filmproduktion.com/impressum-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Duellmann Filmproduktion", "support_website_url": null, "website_url": "https://www.duellmann-filmproduktion.com/about-1/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
&_nc_oc=AdrF0KBgyhbDcBksww62AppbtCPN0-6lg_b4EBmGNKRn2ZFvK9ZbPcIN8yUGQncUlzM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ON6MJxoOuu1D9QPYUSO86h11Bqk3yNXHb__tJCGe_2Q&oe=69FDD433"}, {"file_name": "vlcsnap-2025-11-12-00h44m13s688.png", "id": "2434768090311840", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821702_2434768093645173_8184299653306517900_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00OJ8PuhOqkQ7kNvwGZUNAO&_nc_oc=AdojUefFMhXj_FFEPEUIZt5V5VNVoT2P8lnfvv7wd0TUuqmED5i6kWJDeng3WwXpS7A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EXNaD2-WkIoO7OQg2jzQOoreXPFzp6NJkE0jZK6NNLQ&oe=69FDFC5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "1901427600462703", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821782_1901427603796036_4604858399072733269_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd4XJ-oeo9YQ7kNvwGJhzDm&_nc_oc=AdrFK1nnZRRN2OyQzqhHrQW2R2Uo-q3LJB9ktADRFA1aJYJz1iLUjV9J6BUDnaTdRGI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y-zjnnC0hW5_KlXngzgyQO8r3RMoex3nGZUCC3rs1hg&oe=69FDD3CE"}, "display_name": "Kalunga", "keywords": ["Narrative", "Storytelling", "Story", "Tale"], "long_description": "Kalunga is an interactive VR narrative that follows Ilu, a young girl living with her family in a peaceful African village shaped by ritual, community, and oral tradition. Her world is grounded, intimate, and full of small moments... until one night, everything fractures.\n\nUnder the cover of darkness, slave traders raid the village. Ilu and her family are captured and forced onto a ship bound for Brazil, torn away from their land, language, and sense of belonging. The journey across the ocean becomes a liminal space between worlds: memory and loss, fear and resilience, reality and myth.\n\nThroughout the experience, Ilu is accompanied by Kalunga, her magical puppet, a symbolic bridge between imagination and survival. Kalunga is not just a companion, but a vessel for ancestral memory, inner strength, and resistance. Through interaction, the player helps Ilu navigate moments of despair, hope, and transformation, experiencing the story not as a distant observer, but as an emotional participant.\n\nKalunga blends immersive storytelling, symbolic interaction, and spatial design to explore themes of displacement, cultural memory, and the power of imagination in the face of trauma.", "short_description": "An interactive VR narrative following Ilu, a young girl taken from her village and forced onto a slave ship bound for Brazil. Guided by her magical puppet Kalunga, players experience a symbolic journey of memory, resilience, and hope."}]}, "developer_name": "Duellmann Filmproduktion", "developer_privacy_policy_url": "https://www.duellmann-filmproduktion.com/impressum-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Duellmann Filmproduktion", "support_website_url": null, "website_url": "https://www.duellmann-filmproduktion.com/about-1/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8119898298099408"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819845_905778299062099_7831335915549098046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpok
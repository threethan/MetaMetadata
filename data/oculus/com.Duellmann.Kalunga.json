cpcA924_Otnmr0vtrZKiE_rOIm0aL_N3dm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK-SfQ3eIy7yfotvIelXP4ImpvSaYm66UKIkD00sEVSQ&oe=6AD23BF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "1901427600462703", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_1901427603796036_4604858399072733269_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX_D0iNLHG8Q7kNvwE9CI7n&_nc_oc=AdrLbaCT-vrnANyRDk13ai-HGdwoaQDfJVUV2MgS_H37NRYmyohuAH2sRC7WBCCxYWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMETZe8mFUq--4xt2h56cyIuIce9xMWM5olGBj0VH8WbA&oe=6AD24D8E"}, "display_name": "Kalunga", "keywords": ["Narrative", "Storytelling", "Story", "Tale"], "long_description": "Welcome to the Kalunga story! In this interactive animation you meet your new friend Ilu, a little girl in an African village. She loves to dance and make music, but when it gets dark, things get creepy: Monsters appear and you are captured with Ilu and her family and brought to a slave ship.\n\nEnjoy to be part of this gripping immersive interactive film where your help is needed to get out of the dangerous situation and don\u2019t you worry! Ilu has her magical puppet \u201eKalunga\u201c with her\u2026.\n\nDirector and writer Maria Trindade is an Afro-Brazilian artist from Sao Paulo: \u201eMy story about Kalunga is not one of the sad stories about the history of my people, but it is a fairytale, ludic and joyful, just like the stories we tell to each other.\u201c", "short_description": "Welcome to the Kalunga story! In this interactive animation you meet your new friend Ilu, a little girl in an African village. She loves to dance and make music, but when it gets dark, things get creepy: Monsters appear and you are captured with Ilu and her family and brought to a slave ship.\n\nEnjoy to be part of this gripping immersive interactive film where your help is needed to get out of the dangerous situation and don\u2019t you worry! Ilu has her magical puppet \u201eKalunga\u201c with her\u2026."}]}, "developer_name": "Duellmann Filmproduktion", "developer_privacy_policy_url": "https://www.duellmann-filmproduktion.com/impressum-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Duellmann Filmproduktion", "support_website_url": null, "website_url": "https://www.duellmann-filmproduktion.com/about-1/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26616093104719980"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_905778299062099_7831335915549098046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znVw-Mn_8cMQ7kNvwGmJbzr&_nc_oc=Adords6cf6id4Jgg8wADtTluyw6r02NOLCc9687Q76nLL4tb1mgIi1gIyDRNYuIVKUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh5XqXFT3FPJrYfq2vs7tsiobC2LQMbWMZlcWG4Enz8A&oe=6AD23BBC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kalunga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}], "release_date": 1769715120, "lastRevision": {"nodes": [{"id": "8119898338099404", "release
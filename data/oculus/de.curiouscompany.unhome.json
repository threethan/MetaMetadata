45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL2fuV-lg4sQ7kNvwGnpyGh&_nc_oc=Adr9UIMq6XUDJCyHNjkKmvOl7DRM3m3GCYyuhJVzv1LbaH2ZEEQ77aMFmBX6FrnfBYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmIzBXBpCZ2VpmqTtOE8RUt79TEPFyYVXtzbMNmXocLg&oe=6AB3C326"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Glu7XOV4_QkQ7kNvwGofRJl&_nc_oc=AdqApbCyERNpQFVcirPTazFlcEr6Gu9GkObNVlvQX4ODjsOci61xRcgeQYul8ph1Adw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEYE2nVrRpb3eWe7yUi9Dk5hGV7GiHI6X8aIgvrEyF-w&oe=6AB3C2A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smIEdAYCLHAQ7kNvwFa4e-K&_nc_oc=Adq-7K-MRJ0DZDOpJsMn-X79x2URFmNjjE1s16nvWEeUYs5HK_ti4gHf3U02LVdHBfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITSwgBWh7a3WfiSz87zNJSEc2L7zihtKrocNOhrAJVmg&oe=6AB3D62C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D44dKJEjysQ7kNvwH_9uqk&_nc_oc=AdqJD8BorAePZDxp_Sx4tNZc_6Fkq3btdg8mTH-uRPFmvMKygrRp71wh-lYgjynkyg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWFBEyvWIxk_7e9El4hk0pC8bxa2AiF6zOChl-vxvL2A&oe=6AB3E5A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lZumWMwqC0Q7kNvwHWjAwl&_nc_oc=AdrW8WuEVrjDul5a7mv9bet8oOebzje8EqYCk3jCQhzhhFhQ9TbV8I5Ly7uTFo06IeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEmfpPNSQ0c3M-6O7JSfIyFD64ucDnqx5CNOLsc9fc-A&oe=6AB3DE9D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4KMeT8GUxMQ7kNvwGgcmqj&_nc_oc=AdrN5Tu5x6hvPx_0dHKbnudOfbSGsVw3fhetvRRcuoUeoDPSLjmbCu_wV0oy3_-iUOI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcyTnjlR7X2zZ5NAbSNyyvNFI8TNHRG3glpu3zMd2nnw&oe=6AB3E3D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
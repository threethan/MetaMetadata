45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuPBY_BTq28Q7kNvwExhqre&_nc_oc=AdprRrFFkidvD5dzuIbOnS0Ah7mcT4bWQCx7NUDqmuXQjHnAEsoNWfuHIp8_Od_q9lI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtjPHPHYhLDns8Q3lsKRBdYhamDbPz-I87Vt7C0E5mhw&oe=6ACD07E6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyHK-ZD8Wt8Q7kNvwFlYQku&_nc_oc=AdqkNSh0prp2X0bBAOv6BVddZnkgtvCOh98eAO42GlbZ__27TRli0KvRaORDZnaE-AU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVHboO2oQg9z4KUjchezqyf29EAUJ_vCRNTpH17HlGrw&oe=6ACD0760"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tw4hBglaxKAQ7kNvwEEGOsr&_nc_oc=AdoEePoUKf8rNDPS5MgGxOZUpw_BP_iUs01L-0f_IXshHAwb3q4-5BU32rd2bd2HhYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxdxXuACYHVQfyrSvzrfT_LkkDl0n6DcQ1kxDqpM9o9Q&oe=6ACCE2AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSk3Qor7YUsQ7kNvwFBHTQZ&_nc_oc=Adre-fUEilmxvoOZv90zbNMKxmGvwxeoaDA4SGBWtK2LXheIJ1BH6VqSmzI9gMhv-Lk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOruMpmJ3rrcUiKmRPiWVaN6lDqGrq6GvGHmn2Wuy-Bw&oe=6ACCF223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP1oL8VHKx4Q7kNvwHmAIHR&_nc_oc=AdruCPvRlEECjdSAyyA7OW3wcsVJKOHoJhYltebkHQVb8-KQsDQSGD_po5QHLdWpf-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzVMxFfL940k90eX5uxKI2yk7NB-D9R50ooWipK0YkDg&oe=6ACCEB1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucMf8rVYkNQQ7kNvwEkyYKH&_nc_oc=AdqlIH6J50aoBs0QEqnYxNJUbLKDB9eJEXOtSDicPljjVCyX-PUs80kOeR6Ny3AiXnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz3IOsas2DBhhpMcqcA-TIyiUlXg-6qxpPZrTvwywlEg&oe=6ACCF054"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
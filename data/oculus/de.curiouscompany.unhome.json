45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjD2v3rxLawQ7kNvwEinAPd&_nc_oc=Adq_mx-8MLSEQNoMqH2KyD5aa_QxUlvEq-XFzKdvjNrAlTo9tZuhyF73y8MgwbmsIfs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR4WlnX6cGKd0XZev_LiYoK-x_8Asd4SdvbxT_c_hIkg&oe=6AD24DE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FihFLPd-F4Q7kNvwE7tZx_&_nc_oc=AdrpQIVHa8AdrKj-czb_OXxg2aXVdcPVDYY5YYSy32fwuDHruoIR48wZ5281jz39xXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFhDcT6S6_xnJqu7eK0qfY5IsBWkI6HnrX1-hOSCOBMQ&oe=6AD24D60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysimnfAzDwUQ7kNvwGZl0NZ&_nc_oc=AdrYmF0cs8VQB-467N1mvhP76qgeecVTizuBT-9UzpAntN9rh-rynxt_BvLnSbA2NxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqsLYFpSZHnEhXAcHCn2qvlxuvRleRE9e6RaCgVCJxVQ&oe=6AD228AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WC86cUsjEMQ7kNvwHko-2y&_nc_oc=Adrpvthu4YESzG0gImgLCSJxdmpmI6OVVZneIDo-_11YZmhna-N02ZrMv3Ddr6iPI7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGeh6pw07-TUwyOF4SYfjbRyV5Yc1OlHCYVJ_fIQzCEA&oe=6AD23823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_YF27XH0Z0Q7kNvwHCrKEn&_nc_oc=AdpbgpexteXg4ti33mNqMydWIFSqGhMgmNllEypjLhP_WVMvRScD77r6bpjit5m_XhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdduBSNzD_pjDMcD4kRyggUhdMwJuWm-FSIj-HUYJbhg&oe=6AD2311D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snoegZfj0XYQ7kNvwGgqKcH&_nc_oc=Adqw4Z09FTIIBtIvTRks5lj-UXe990MgZo5RtU5Mp4-raGup_JfIXIAYeiM41GP-GuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQCszb5Z44SRdtRambcWPGCYbtzQZhIu813KJh3T4_wg&oe=6AD23654"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
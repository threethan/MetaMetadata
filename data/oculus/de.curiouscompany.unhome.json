45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8scC4v7yJUQ7kNvwGuuPAz&_nc_oc=AdovzBfdhbC22B7a6yjBpJ4YsIea24jdBgMqCHrkJjbq2zjyV7IvSOdJiUdguK71Yp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDpbAOGP-AQ2VbJwMp8dpCOLQ9kOw_feoVjBTYY3FKkw&oe=6AF0A066"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VTsL6etBQ0Q7kNvwFKcOph&_nc_oc=Adr2hKydk4q3PB0B0b4bpusT7jOovMhNZpe4o35gQ1ucn0EzTSeh4UXHjmIQfIo75p0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZa6do6D_vXx3T6DqeQTaPIQtlO0NF8ZRiaKY8cEtM9A&oe=6AF09FE0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejlaqXV6aGgQ7kNvwFqE1en&_nc_oc=Adq8e1_6bVvaYENtgSTYEGc9Wc5llMl2EbXN6ZhKofG4GeF1rW3Dt5zTNhGknjCs_U0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH7ISxyKduUChPe4gWj-0Ue8VSnjTYc2u_RxGP7lm8Sw&oe=6AF0B36C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1hfwNYHKAwQ7kNvwEb_SNT&_nc_oc=AdqtEl2FbDSqbuazHhGHgZlbHs7rPdHSMlBLuwMKt0owaYfzHKoOa8aLDz587tvgzBg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR66LH0bn4M9braRY-tFIvrdf2UL9ieW8btjbafsxmjtw&oe=6AF08AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqlycLz1tJkQ7kNvwFO9sYI&_nc_oc=Adq4mZVLqn2PaIFHCbsYPrZKmEj_G5S4c5Y4DTghyEbg-dAv6chFHO1UD_vmu5I1Kws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8zY2KpUTvNswiAX75nJfKqc6TsJ-w0fCpLgIRoRoshA&oe=6AF0839D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfTUXwevSPkQ7kNvwFDE5jT&_nc_oc=AdrFiteC2nxGHwNYJuOMZ9mDent7JRRJ90-kJrV1JN5fzmUQljd1LK_PSSD2a5E3I6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhihGhJuDJ7ZPHg9-g2wTEUuTc__oO7qXVPMW5x0SsOw&oe=6AF088D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cw8mISsQlgQ7kNvwHgOTD0&_nc_oc=Adr3XSEq0kweK9LHUPwFEYhDpxP-gCHK_X7VY1BxcfEMj9ac6JHURovUifW2rSa-RpM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7cheLsSHBx49tXHuySxn1-iVeoMyl_Quopz0laUpvfQ&oe=6A941F26"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwHhZQjzmQ4Q7kNvwEes27r&_nc_oc=AdqEZVik8sgvasH067mXEVSWg4GNlmM2gf20YJf_LCX8pSG-Iv0ZZuo0s4V-U60lTgs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQcRM4yBs7fr9ZlLE7GqoCvuEHrcWeK59jPViObXdZCA&oe=6A941EA0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRMNCziNH2gQ7kNvwGg0jUu&_nc_oc=Adq0iTpcfdhvKVznWe_-glGi7TYcHek0nmTlCREvZpSV_tulhTCigzBIcM2y8O9yfxI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG292wSuEBzSqGagePE16DWmZYxPyYye0oW3TaZ4yQ9sQ&oe=6A94322C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIQdFVBXHIEQ7kNvwGjhySb&_nc_oc=AdppWRZoAmn5TAkL-XjvVKxjZe4iizWVa--Kg96hDDPe5cZU_EW3Hpw6W26VQoknMGQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKekWhk0_AgcerXP2NKodp5eBhNoNS8Gqwklhfmdwk8A&oe=6A940963"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBE7kvPotZEQ7kNvwFvTrAu&_nc_oc=AdqDouXjMb4mJkFK7OGjqLiCxBapXKdk3BOeSeF7b8ymit0BMv5nnofnQkkZ6dP4mtQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMEr3nJkQxqCoyNno-Dxp4a9Z616MYpSpkTL_lo5j-8Q&oe=6A94025D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-JQIBV6sqcQ7kNvwG9J9mD&_nc_oc=AdqIy-dMHXnemM0MMXDjos_I0zrWuZUcxIxgwThEZDhV5TMs77uMHHnbJMkFU8vzDFY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTio80QIWx2M4AJY9QKjS1DkFXPTAgI8t1At052MzFdA&oe=6A940794"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
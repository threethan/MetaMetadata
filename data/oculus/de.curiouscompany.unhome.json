45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoI82VuV9mIQ7kNvwHXNv20&_nc_oc=AdoGLDZyHR4UK611sMZqHvOItk3h5XZFnf9dCIl_NY9GqmsPQl7ApUHWioNyX3UJaJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8mgdOHpSexrLLV2m24-yAQAqcH84I7p5ZoC0kN3f21A&oe=6AF88966"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UpUUb1mcD8Q7kNvwFMnkSW&_nc_oc=Adp8B5CmkfJwVvrDPiSB8B58QXQ5MMuaOVSwuCmuL2qoxIvZxULiBrLBW4P7w6k21UA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9psGBGsC1fWLv__Yhpc-LXM3pVeQw9P4Sor4oeis2SQ&oe=6AF888E0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOD3aQvwnuQQ7kNvwGxGYY3&_nc_oc=AdqBvTq-3hNbd-22utHUPLtbI3Kj1oROe_-dXQhXQKG-bRHFT-tDWXyq1jLqhSjy72E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCcWNCjyv1hBe1GUAAnBHCUinTdBlOrhm-PplxZTvcQg&oe=6AF89C6C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OJ16yde6aoQ7kNvwGkoFdg&_nc_oc=Adp6Hd9RjQHhEO-U99rLu33mFXP8BPUFmmj-doHO_HCDPxnqzw79XxSvuyTwxON3wvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS890TlvraaUesoKo_RzUk9nr6KxmAVkdjw0pDzFtTrEw&oe=6AF8ABE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhpxcNyLs8YQ7kNvwGmegfz&_nc_oc=Adph70NicQI86x_of_B8rFXk4lrcEjK3VfmL8PvgJKblVH-qPFicgN8FPDfnXPvQfXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2lJPcC88A17N4J2MPMdl2TA7lKj6OPDqv4Oaij74uYg&oe=6AF8A4DD"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9OuUsjNMQUQ7kNvwHQZBcq&_nc_oc=AdpV5i-On1yJOx_zd45wUzAbwcZ3nDeoeK_an_RzuT9Yua2jvOGNDxmYuUO0fgrEhbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnpT8WtmN09sIC9Bb1Gu_36p4fbvFlPzBOKrIPDyfi7g&oe=6AF8AA14"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
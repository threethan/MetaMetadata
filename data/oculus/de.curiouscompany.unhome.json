45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJq7BsJJKrcQ7kNvwF37lZj&_nc_oc=Adrf-dlG9w1FBI3vEEQ09IjkYHJ0mJA4ewNA8ihLNFryo1dbwFATAj0EPez2u8nN9Dc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElmVyE6bBWPfpz0nNeXF4qrv6RtFmemMzjfV66iCFfvQ&oe=6A771E26"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHVCtY6r1mwQ7kNvwHYtx3y&_nc_oc=Adr9-RQ7jmrSPJiP2cW6Mr4Wqyrrev4HZ4Ks7sL69_DtTJPbWeRmgTrasuSe7t42g3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXg43VZtb8terKzJGkW3ezySXnSV1OtTbJmqGePBtqUA&oe=6A771DA0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr7nIwoVqOYQ7kNvwGyPcLm&_nc_oc=AdrLxafm9Z4idPBLta4n5DGX6FpdNvCbE3GvlmVVwZUHNax8ARXg84c9OGjVjJw5fwA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPaAZAQL04xPszVNwrmzPliYhasNkNQwGJgcqJNtX6EA&oe=6A77312C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpxYRR4VGF8Q7kNvwFtOkE7&_nc_oc=AdrEpEo16yIoGbNNfxzNLLBr2Rv1BZkVktUjsxH0kmHDG5CN-9730qG81RLbpv35Dnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX5ZJrWwZIN4bkEfb6gYb5lNDzOxnpR192p7Eea8Kg-g&oe=6A7740A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8Y9_raBbIoQ7kNvwFhbcMs&_nc_oc=AdpNREL_68ehZiFLJc4FkK4aUtNhxmoHF9bKInJTqQy0zmtTmIrQMsLKgnGK0yc01ag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDfjCxjEwwx1qCbc6wQ20aGW3h-OZvo4xy0Q7rW_h1sw&oe=6A77399D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv7WDeTBjtUQ7kNvwHH9bGi&_nc_oc=AdoR3knfjAorCveVJBF9UUjf7T8DU1P_yQoQXhh-q1_bS6a1_xrJao6zOQOZYOPTHe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn4UX00_WeMKGXUFWs4n7sEiQaMzakbE3nAfPP-Tyq_w&oe=6A773ED4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
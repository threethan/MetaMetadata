45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP3sLDPK-KcQ7kNvwHBBu3d&_nc_oc=AdpBYyRVt_lVh84cQCmC-h9z_9pS7C0otnY5SnweAmQeoLFxm1Dcv0GcVZQ3xBKKgNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwgxE4zojd5Gs0xDpfjHyZCOh78UscSbwfRIoC8tiHKA&oe=6ABBE466"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wnBdni8VooQ7kNvwHKxFme&_nc_oc=Ado8f6rPf_sV0coV7OyRXO7fy_FSCirBlkFXUQrfTryRV8CbMb70p1vrGwywM0CsFMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOq0MN6NveZJPnuSrYd5V1xwWjIT_ULwELeZI7s1qb8Q&oe=6ABBE3E0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRGZu4EdyaUQ7kNvwHfCCaP&_nc_oc=AdqxCpcsFHF0UG8x8mWAVQmovKkdKcl7vpA2W7LmVqrjGduOiuvzELohbkgDK07V1ZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe5ux8Ki8deaGwO362v6hp4ECBwdzBhTpC47cCKFMw-g&oe=6ABBBF2C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROGaiKtA-j4Q7kNvwHEZeWk&_nc_oc=Adopvw0xN1FCa9stCoTlSFtNOirTwiE6sYZ_ltRHfao04jS-Kt7kUO4st2MUB6Vtbwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIi1wrK1yNbZ2krMaUFnApjtFhBinBLTOTIT4aVpqQZg&oe=6ABBCEA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xEtdTXFhcMQ7kNvwFpCrqm&_nc_oc=Ado9Qa5gEQQuEukQmSLL0-pM8IgRbZZ0-ZQkb3u1tq3OyYpDklI4A2EaANoHFkj6FZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_3piZHukgh6hqAj1tslRSX_t_R0xvpQXdkByqRv2rNA&oe=6ABBC79D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1AHOerv8VkQ7kNvwH-PU5E&_nc_oc=AdrRbnFhzK4g3Gnv5ISC_h2JNAygNEYNf3kx4vP_kq_wy48f0Ec_VyynsC3tTrtJDR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY5riFiS_6rpoMMFPakNln-OVmBUZxkBNKes5Br6TdSQ&oe=6ABBCCD4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
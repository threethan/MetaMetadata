45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL2fuV-lg4sQ7kNvwFqtoPG&_nc_oc=AdrHh9a99TKpVZXvkWoFoJ9swqFqarl-_uNARTORFNAy8DjgDQK7DS7Db5u46aGgMtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlq-05P9dOxyJeFZOpUOofUQQYAdU8i61L-0PDBY9WBA&oe=6AB54CE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Glu7XOV4_QkQ7kNvwGbBzlh&_nc_oc=AdqC2Eee6jstoAtmmrSHcYgesu43jJSEE635mDgI80D7vDYvgKaa8ulnGcYaTZN1eL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBeUnTC4FkqF4On84UnahGY6ZVZF3Ithk3Qy7iSgJ-4g&oe=6AB54C60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smIEdAYCLHAQ7kNvwEbSbXG&_nc_oc=AdqXmFQlAji7BjGubuDVs0jFu1pYOer8hr62AnFOM-5-iSsFrvF_z-syip87uwtxi6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7PquN2Or5VL5YvBadvAEQ8i--9XNqjl2Sw912qhE2og&oe=6AB527AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D44dKJEjysQ7kNvwHu_P4q&_nc_oc=AdpeZp0zON3znL_zS56jW9fXgdPmbPvE61rNNi160ZqY_XELf2l4wknj9OepFru0Qi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFPdUbJRV4sWwvYYUN-cBU3Hu60RN63VC_hr-5LBlu-Q&oe=6AB53723"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Di6l8UJcMQQ7kNvwFNBa2p&_nc_oc=AdqcSYgEQuxVJJNImsQAsDXiJ_cGls-wMAdG93byTF4nfSYGsKmyeR8jknZa_kEz96Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSuaCdpWO3ohh7cdqZ3mToLulz1eBet_NcfxbeDS_EmQ&oe=6AB5301D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4KMeT8GUxMQ7kNvwH15sWx&_nc_oc=AdpgPulFn0FCZBSBCEKO0eHJ7YoAnKA47znCuOhsZHIYWKEklzp6rmtxc1INUMjF5oY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzx2e0kKapixaFsb-uI7Ry8ek4_GWV-8wNunxCpLIMDQ&oe=6AB53554"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
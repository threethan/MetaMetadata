ritical choices \u2013 whether to talk, seek help, or defend yourself \u2013 shape the journey but cannot overcome the structural barriers. \n\nDeveloped in collaboration with the homelessness aid organization GoBanyo, UNHOME makes isolation, powerlessness, and the fight for survival tangible \u2013 and inspires empathy.", "short_description": "UNHOME lets you experience life on the street \u2013 realistic, intense, and moving. Make choices, feel isolation, and understand the barriers to returning to a stable life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.unhome.org/privacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "GoBanyo", "support_website_url": null, "website_url": "https://www.unhome.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24782240528060887"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1319795503473741"}, {"status": "PUBLISHED", "id": "1415974092996240"}]}, "baseline_offer": {"id": "1319795503473741"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785501660, "status": "PUBLISHED", "id": "1319795503473741"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24932357006382571", "version": "1655"}, "id": "656166986877550", "channel_name": "LIVE"}]}, "is_for_oculus_keys_
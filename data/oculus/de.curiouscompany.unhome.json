45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbuKidBLC-AQ7kNvwFEir25&_nc_oc=AdrSkPmWIhQzRx-23AA3Y2khee8k4ZVrX1_jWGc8GkddUTb1G-M2dz9pZZnq4WUUhEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsZKfVEnnUrH6b-Wyxo98b17bCXJCV9ho_rQv-HGdi-A&oe=6AB90926"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn_RohT5S6cQ7kNvwHFMPzf&_nc_oc=AdrdkZ2okeXaHTQ6KoYicTSPUZpdqy9hZtLJ7tSv-ZGgtKAtGcXIO0vlcUWrobzD8nI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv5daq_S1w2YdrpzNCqNfQrn6qCCamYcqeux5gCEOqAw&oe=6AB908A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFIzLglwudgQ7kNvwEkzOG-&_nc_oc=AdqZXDKNZrXzSBFOuPAfHb_fI-1rHw6WljezV6sDqEogbATcWbVmJxI2-nPGvckfsns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1_y4buuF3LVuiqF7m-50fn7F_x2SfZdpfaBJI1kOHhg&oe=6AB91C2C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxXpGAa51qgQ7kNvwGOFarh&_nc_oc=Ado0woxctwjszdiRotETMM18274OeT8bIALQGbjhrV8z_EOUGosvc_3jKm1Q67DxBRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpwsjqPlT69zdQU-NywDrJY0drbdp5AuaorigvS-Gz_A&oe=6AB92BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xEtdTXFhcMQ7kNvwFDk27s&_nc_oc=AdosE8jL5uW87Y3l4kLC34F4h5JOdhB3-Jl0nioNy-R7Ys6CjexY4hl06LPGDoFz3TQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDxpGsH7lpjN308jVkx08MZLjvmoyVd8lHI0fZDplO4Q&oe=6AB9249D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t49X1ra-rYkQ7kNvwE1v23e&_nc_oc=AdrCg5g6hAB9PijuvU1ON7NhKNNR5oGXgLhNqSPaeSVDozsIev0rP3C_KoiqAXlWE2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA8YnLyX2OBIwgDoq6H2yh_ypQQGILfaeZTVlvies7Kw&oe=6AB929D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brCkzRKrWoEQ7kNvwHZXCTY&_nc_oc=AdoRRzZ_c7WW299CcPvQ7H2akDG6VNw0rQqossQ0Neu6oHa3j8oD-Z-mafSdak_97I0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0jUNFd5BwQCRWAYKe1coXTYUCtDMSm3OHTy9qEpJ98g&oe=6ADCD9E6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKNzGF4vMmgQ7kNvwFoDN28&_nc_oc=AdqA3HtadhWPOqSFY0LF27O8nG4cVllw8zUGo-2yi1c10jYwSTZhc1ZVUpUqYXQ3BTs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEaSCvdpHlqREOvIra3ZUuYMIxmOvgocGHea5nwYQYfQ&oe=6ADCD960"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcon1rnaG48Q7kNvwEKjwB2&_nc_oc=Adr7n0jnRUaxnFnYOnyY-mbHSF0i99wz8imoE9DXxK8vEQOcbeyQY0E7MG3UaI1k5I0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlf8XlYYbeD2kboMyZtshV_oBJl-bUzsxJ2tTIvs-xzw&oe=6ADCB4AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV4EIaSOm5oQ7kNvwEFJsnd&_nc_oc=Adp0XDwH__T2QbLTbrJH3xonBXPvLediDcptI4P_hcwN2yI_I9s58M8x44C42iRtA3k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe_8JGEcrkllMu1ZxxKn3Lmva2cPOj3pOrOlxaa9id4g&oe=6ADCC423"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PStKuUOmtg8Q7kNvwE2gvlx&_nc_oc=AdpVBXNrd1jez5CWVSrUFhCVPaVHJz6WdhmBor5kyTVU-dc8PN4ltzgRlHQkFzypzLE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvdNEf9wMCnJeZQSRfEq2aZyRqKfweHQxfx1qe7AknCA&oe=6ADCBD1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOzih06MAtoQ7kNvwHawl87&_nc_oc=AdpluvrkFzbDwlu0GAyWRy_JzBVrXe6hqJxnmZyB0tmuE_QDFmvqmUMYUGY9cKJWx-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkSkQvjfig6NBxjrb7HE9M64YbSWxl5wMlR7oiQlOmxw&oe=6ADCC254"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czLrrk9i-pgQ7kNvwF180UB&_nc_oc=AdqsrytbFk1CQrv4KQRruQmZpAre9gdshc2v_4AGOOHF7QVb42yuk-xmu_up2fjInsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtmSg6adQbMjsH9SyFryE_8I0VbrfcKKBscuLbbUrI9w&oe=6AAA88A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haqDdHFeB7EQ7kNvwEZvzqS&_nc_oc=Adr8sidhoGYp1LZ-kdaON3jiw23XDvxWvkarZaM1hGy32W0I7mh4mwrINcKsgRItKIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA8sppRI2K2DDfWY6ktpoej1k_Yx0PYJEYrP_1YCkylw&oe=6AAA8820"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19iTYiJIr5QQ7kNvwFoDkii&_nc_oc=Adrm-gvwGeefTIpEm8Y4baKwvChwKHub0XD1cGbLam8P4ZJakWuOG86o6dm0YiOTPK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb_b1Co1nU4nMrXYSsotidViFNl2mVMUbu6miVwLnd6Q&oe=6AAA9BAC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phymWaeK3PwQ7kNvwG-a_Ai&_nc_oc=AdqEbnbyM8juiZ1Pkyl6fg4lQ-VlASEaaqjRyDBYKav-cPxZLcVoD1QiDldmgIzpzqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUcvXNJSdpkyS5YTFMefZAMnIdgWjnLy9_yLCwPlVNZQ&oe=6AAAAB23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHq9Ack_dQEQ7kNvwEH2nVg&_nc_oc=Adok5fQb6Pl5FRaxlCYI9-kZfT1ZrHrK-ygOTsy3d7W_xjtFYGZ04JexCFHlNSx0l2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeyW0zqtOTSry3GAlS_2c0u95oQ_oPqGJra_SgGMvSmQ&oe=6AAAA41D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYE3q0QsrnYQ7kNvwFcw71Q&_nc_oc=AdpTdwjH-IbP4-btVmgBeqjFZJacTP_z15mj3aUGcC-aPfpVYdtWh6kxNsSQiueS4uE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrJ5cCF1z0_GxiYqljGWbI1rvmXX47--mwZLntgUYi_g&oe=6AAAA954"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
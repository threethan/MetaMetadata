45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJq7BsJJKrcQ7kNvwE-ma2S&_nc_oc=Adp4mWROHUz6lv4V3dEUnrCQR6c885kpDOZWaS8kOIAKuJsZotYBHtFVJ0YTrM6260M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnHsIIKIAub_i42y2vlZ0lgdzh7JovHOkvIFn-fnXJGw&oe=6A747B26"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHVCtY6r1mwQ7kNvwESsVFc&_nc_oc=AdoCKKSW0tba9rx1nJyAeH8r7wjPSnR5lI0HUi4PF3vkUT2DlwJsZCdmcm5ZeaK_KKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOKAZmTUFTTT9ox-WlAkv-JhlhqLVZTqm0ao1QLkCluA&oe=6A747AA0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MgIQiNiUxQQ7kNvwFCGGls&_nc_oc=Adr6_Cc7rJaWMj7vNmTx9jknhDXBZZ_3Hjqi2c91wz0CMh-K_bKjqH-qwJ5UIUv6_Kk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDfJk0SiLHE7WRFGEcyGV200h2jvXltIEFtTyQQGiJwQ&oe=6A748E2C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpxYRR4VGF8Q7kNvwHPp8VG&_nc_oc=AdqhQHL4qsyc3jPPormXoXJoX1hhSJRo7IyCbuw57nGMT3y5ZzjHP6c6UUzOQKE1sHg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtxDsSeaclxDBzGu9nw2fns6XHj-8bpOqV5noUKoeVIw&oe=6A749DA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA-85PU2f2gQ7kNvwGkTw6h&_nc_oc=Ado41D89BqUEu4-ArI4qxk9xnAZFG3bPI2d9ZYFXkhY95DteFsSr-N7NicM6nP6rDf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK0-Ep9QbqH_Sbfb_kXIIHHc6-22F_fXFKDuazC2gNYA&oe=6A74969D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzyh0SikvlQQ7kNvwGoM-Kv&_nc_oc=Adq3NoaT5Lu6Ns1dR165IptKQjDEcZF00dQ8vvw-LCqx7IepIBgGsjzBZyX3uhRIsn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDp9iNdo24mBHY3yuRRb93yqjCsTAevqDfTDm4VNaumg&oe=6A749BD4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
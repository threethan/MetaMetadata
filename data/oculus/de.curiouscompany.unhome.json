45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvdv92SMBOsQ7kNvwHccZyO&_nc_oc=AdqysWAWFPcbGocptrUvaaQLMatgcyTAAiOY1BuLe50BFveBxXeocxNS2AbHVPyiJ8M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT25yqIw4GVHGKkPK84HfXBd7OSF2JYTOGRa_sw1Hh43w&oe=6AECABE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMjA8kSAKgEQ7kNvwETN2NV&_nc_oc=Ador5NXYNW1vBTSPWRREhFCQP7o18Q5Kil5BUR6QoSwNaIWbh-uVs5GEoUz9TFWObzA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1fNAG8HF3Ct6jIhcWS_Jq-uXiJkC_krv0P9eDFy7yhA&oe=6AECAB60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUeO2Uv76i4Q7kNvwH90KrY&_nc_oc=Adog99I7yyqJocdjlyRoQxcYeAJEiVV6Xy63Qm08OPoBys1ee3U5o4IoGTbeFfhkkOg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMU2sA2nmQ8A461ayKVJRnsBm3awxp-STsLVhV02NsjQ&oe=6AEC86AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Pmzeo-ZdnoQ7kNvwGq8hpk&_nc_oc=AdqSCpqQH5djLokK2uqSIrpeGbdZwnIEYOklctYNtGgVYkvnfw4w8zhcegVRo4_OHsk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKrv3oAyyn2ppvUCLsSMAudknpo6RACQrzpQuJEJ7fSw&oe=6AEC9623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLh5J5ZURPIQ7kNvwHtZHTv&_nc_oc=Adom6oFvh-Hk8IIDKxcoyJ7gzhBgwHS-kCpnmsnx3kPRv1HRMntXLlSUMw4JkY2FJ-4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI30yo-eNhYp3waSebcQ917hbnx2T9Wm60FbB00OU8Gw&oe=6AEC8F1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aItqHq5cXAkQ7kNvwGQ4l-U&_nc_oc=AdrKHiX7TR8xM5sSj7zhr4Z-Qh_juksLesspmzBFPuMDn6nNhzf8R3OTNjvsPT1T3vs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNv283uISNTqVeQ3GmU3AOHM5MnQPi_duShZ3GnlnFXA&oe=6AEC9454"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG0mvxGqyz8Q7kNvwFzifxi&_nc_oc=AdorN_3xL8FvoUf0ulDo1m1r2c3l20x3bHGL55JidjJ2YXtJ8fGxSRBLYVNN3HmWw7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuBnqZ6Ld9Qsu8QJSgHxWT68pFh7ZWYDCQx9q2wN7gcA&oe=6A7F0726"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvxZpaf4oLoQ7kNvwEIbm7S&_nc_oc=AdqYoArQP4eT3v2byTZA0CzqyoKYLqpVhCrzC5_cXk-INGIhFBKgqdfOPr6-8mBWuDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWcb4cnt5EyOr8LaMw6MgHgLPFXucI-FfgTO97cfqzxw&oe=6A7F06A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXVTFYvCQFsQ7kNvwFH044T&_nc_oc=Adoz9G_l2fEgr01w7sw_bPjmrrX-ans80RFPthe01RuPAFU9EB_CE4hAmAmowWbzqvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQuQOXwgUQpvT8BtduHKKlZD8LBsFcgDnG1_hAPj-xfw&oe=6A7F1A2C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uw7IDlJVRgQ7kNvwFbW5Jo&_nc_oc=AdqGgoQq8m-xtly34jLuSRxH_TcACbGPS8F-Ws74a95m_ofuyzootFZ4t1ziUkID41U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmHvtFiwKLpeOOPGluGa10UewMqtCeqzHK7gwmDJDtdQ&oe=6A7EF163"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjTT5ChtIiUQ7kNvwEanXV2&_nc_oc=AdpyUh21Yn9X3hB-ehzM0Fe0Qk_8-notZ78DiC8iuVnsTmvqiYbATeUnbIztoYOFQis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELq_xte4EGt9-1cS5OdnJS6gmlt1H0gcE7naUSuPop0g&oe=6A7F229D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfhXv8-LJYMQ7kNvwEgr9kc&_nc_oc=AdoxB_RGm25tatLqcCpUzy9eJZkLBiab7dt8fSDm9CQDzex-kWlO0OSTaBAI7TMpJhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8jO-cCbr5Rbp1MPi0EaD_rRb_TByjMg4IVJa8CsJdxw&oe=6A7F27D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
18386545635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1e8jLgfc94Q7kNvwFEKGoy&_nc_oc=AdrqRTYTHqxAmxIa7JAGIZ-EWSXVXRD7nbyG6bcCGrWh44cWWQzpnlDyxk-9WkRbtko&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGi2ogdYWmR9BTcaRF80v9M5G4ol1h43aLxtsoHVwKRg&oe=6AA3F126"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RzMrNF2a6gQ7kNvwG547Nk&_nc_oc=AdrPTM8vP5mtYP02c_7oKybeYDCx_CBjBUcNraRNOeEd26jqtFym5Lh30UKn9msNtio&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxlggitHb1aBYCcRidh0etlttNITwUiDRpQtJ6F4HbdA&oe=6AA3F0A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbEcgusjSGYQ7kNvwEl7z5G&_nc_oc=AdrS_HQ2KnhIDPhe89xErqKF_uiOjIQ4Nbe4xXfRxplhJIxB6gyWPqxAmopjLuGwIs8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmqLH8Ls3AgDbz-Ql6sH8DNzd3N-TuH_msNxYvB9EhSA&oe=6AA4042C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXlaDMgnxC0Q7kNvwGl1o2W&_nc_oc=AdoVB8zJIs8H_vS2j7y0MhITyQd14kiO7hY42uEMv4gnvGuNjXSD_i_f92IdU-ZglIY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNIv8Eyr02OcHtqKwUMB9fLaPju5Gfo_rRGGrUS1O75w&oe=6AA413A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAgqYj1Pi2IQ7kNvwHmoiF9&_nc_oc=AdoKVsoZ_9f0gOoLP5nQtDQ-tPKf3LldWcS0tUBE2dzSLjCTDPvvdNxRKhTURrCL7bI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpDl5kzFOvBQnr1mxJDqaAFzFiagzNqWCLp9wMUmcllQ&oe=6AA40C9D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8MADs8GKR4Q7kNvwHfVlC8&_nc_oc=Adqj7_lqcy840W0Unaafor5ViaExDhRbTXoDSoP0qVSNMQgnqkGRDEa5EONbRrRnZlo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBiwdPWh4e8xwuLjO_Edm3juQKGe7tAdzmcyg5_cD9WA&oe=6AA411D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a
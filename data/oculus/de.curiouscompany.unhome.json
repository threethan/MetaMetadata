45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brCkzRKrWoEQ7kNvwFVcxrV&_nc_oc=AdrKYNmHO7_G7Kl4PK2ntB3BsZMveLfZi5JndTVBlB2sRffdmY8C9NP6fUwEIxCcefs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS4ZJdcFNixABVTb7wblmBIfivGPpEyqhzWbOMlOAB4w&oe=6ADDF326"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKNzGF4vMmgQ7kNvwHVbK1S&_nc_oc=AdoDmRJy0e02eHQvQWOz9jvmZXCCHBjfhMlapS_DSeCENrTB1rZogFyZlblE3bcpEFU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoMXU6TrNP7NGIHxuJxuMUs7YZBEj_oi66ZF_SOZYqrg&oe=6ADDF2A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC62Lq88FwEQ7kNvwHZ11wu&_nc_oc=AdqSLiD5kH4e9aQX9I8P09o_sxkBWvfLxUa3ORyWv9y99hqI3dO_8BpSCvEblGRXy0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODtaOKMOPenZNkJZ-HZmbz0-2wgQshjeoEix4J1jdnjw&oe=6ADE062C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV4EIaSOm5oQ7kNvwFgMM9c&_nc_oc=AdpSUnY2th3lWyC3uW5BieQFyBBn6G5eYLvSmooZrq3Sh1aqL7MOyb6Gx-yOjxp7CR4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDuMhikJw0d4YoXy_SrE5JN1II6hwi0glORXC_5ENWuA&oe=6ADE15A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PStKuUOmtg8Q7kNvwHlyiB7&_nc_oc=AdphliXNSerNWU8jFvJV44QBXaDoOlZX1jpb_3CpTwwi7IJELJqPxrcdoc4cfnWtRfQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY9ad5HPK4uSeWaeVJiZ8prEW3J-CRvIHU7bVuv5Mtyg&oe=6ADE0E9D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4pWt2SMSHsQ7kNvwFldL5H&_nc_oc=AdqScrv0DvjmPfdJC2xEmZpPvMhNR8gdlCJhXromp3SNDSol8ffCRiWphGj86Hc0yFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS58ERKSOXobGHxjOuOK102oXICKvwuWCNJjl4hqDB8g&oe=6ADE13D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
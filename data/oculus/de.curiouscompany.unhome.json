45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_Oab49dvucQ7kNvwF8U3ZA&_nc_oc=AdqcOTqfyhgR_5D7MQoh9zIpSqpDNa6LzoYrPC94-vyUrS3GWPMLTi-3llOwkH9iFp4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKInExbmqmrxSiXz3PyjRMxwbZN-8CCwtKRtrBZIpx9g&oe=6A917C26"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3t4eH31rJ0Q7kNvwHvxd7I&_nc_oc=AdqKN3MEjR05PSxp-5-7X4_GxiPwSSsK9CVs5C8hQnjzpf_zui7ENx2KolXOvY23bh8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxnBgSeKfQA9Hz7virW0oP96HWWVIZrnbZgyLUFz2fDQ&oe=6A917BA0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd24Vxl9b58Q7kNvwGdzuv4&_nc_oc=AdpAsDHFUSslTgOzCTlyxWMHFwBLUAu2zwu0jz-lA5DBwxoF0yn4VL_eD__trhnKAaE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwGzt7nawaJhsSsWjdxBpiI9ujHy_h5KHaNatJResBpA&oe=6A918F2C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edmAX1-oD8sQ7kNvwEsRK3N&_nc_oc=AdqEucdNKKzPPjGkWO_y_EKDO53Pz3cbFHwr4WpsfUxO6kFKS7LrDB0IdVVfuV7EExc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLlnTH9Qo2YuYfAAcnOfdDd4dcE867FgZdVkt9b_5uXQ&oe=6A916663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBE7kvPotZEQ7kNvwGqPL3d&_nc_oc=Adrf_lu9ukcnqVOPPL-dv-TOL3nGVSvwyOh2yIJKfGnlIUx4xeR4JyNObtiOVbBYqEA&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9J7eixiAyUpub2b2jiHjVUkiSr4wP3NpoH_4ljo9Aeg&oe=6A915F5D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVun-RdC6hAQ7kNvwElSPXM&_nc_oc=AdrQgmFi_yitwb4o6UaImrApRGuKuE-3z2NY13sNJdpr-jdU3TmpaxxmtL4inhJEjEo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCYOlyv1WASQicnKT6JkVXUFi6xF2gFrxjEiqXzG7clg&oe=6A916494"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_8qwr06Ul0Q7kNvwH8mW48&_nc_oc=AdpOp6qQAVZHLcR95-mNeq9n5z8cWL1uRMi6LNvW7KdvnRtxpASCE3X1TnA2T4cYnrE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1exdbV5PrAhmCkz3k50FfFrqBhFuUiQLPK30U2aCT3A&oe=6AEA08E6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHvo4UwOxgAQ7kNvwGmSuLd&_nc_oc=AdqEmcVIHIhdZgvOXW-OBjlc9D9YqvPHBCYWPrxm0mmRkKzb2iHa4sgfV5ne1YNwsh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIChPPr6-3iIIX3_eFF5pnPZt3B0REOWu4f5OKHhFlXw&oe=6AEA0860"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUeO2Uv76i4Q7kNvwFRdl6Z&_nc_oc=AdpPukYkH9LQ92VKEvt-LTOVmSeawNz4tGO9-Bkc2DNwcRRrH8LX0VVsRvtFk0zIOxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr0i7mSBjnj9HxRc2n-8JvRGv0p9td24GYGUBzx87NzA&oe=6AE9E3AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxa1ow6grJcQ7kNvwHmWK4l&_nc_oc=Adqrx-GW2nG-Rw99ghj5Riq6Cy3a1OhwulohPTiiBCFwTDz4jeJ47VTVqoV0VW34QjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_cew83-2ppzP6bvhtZJQxGM8WAUj__pCZOK2smq3RWA&oe=6AE9F323"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABjUrUzt_awQ7kNvwHqFg67&_nc_oc=AdqPerDDOEJlx5VzHZ7vN_EsIicut0weIiOUD4jJZR_WxPS9_L-PlO3Tl_sYqoJPLzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBUEaEFMIhAJeFDhueww6xewIYiNPcSPNEhfN-yOY2BA&oe=6AE9EC1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aItqHq5cXAkQ7kNvwG9RLKg&_nc_oc=AdrdhYp5jcelOX6tkB1erpG53ZB8-3vsa3c4keS8HiFjDe8X6W1vS_ZFRGIKaCCIkrw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmGN2MBep07HS1nhDYQKEQGq3rTpBBP5mko-nbX4Nqxw&oe=6AE9F154"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
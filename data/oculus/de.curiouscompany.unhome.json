45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8scC4v7yJUQ7kNvwG9KL_a&_nc_oc=AdqSpBcDas5QzIukHRcrfM3Y--xKtMMtC-dmerO3fNZfr4VV-b-6Zbv-H_5UogFVAKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyvYBboosO2WAUXzZ9dOXP5f2t4sNNitJP7VqGuiMnAA&oe=6AEF4EE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VTsL6etBQ0Q7kNvwEeu3uy&_nc_oc=AdpwZlD46gBvJF9Mk9MobrvN_0Tu4UlssnLgS_R8yOULAlshVNpPqkiRHtjPTd4LR1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR88_rFllNJorJbRAv9ArlinnbpFGQ0ewMgAzEvEw274w&oe=6AEF4E60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejlaqXV6aGgQ7kNvwGW58oZ&_nc_oc=AdqN2ifvlCEuVp0yT9ToJFuTcIwVOC72QmkP0yWSHXstgZUuVX5R-FUU9nAlMIcgRZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMOWOS8NYRLkvQmBlJ6IjGLscq8f8-eppXzFWEhpRN2w&oe=6AEF61EC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1hfwNYHKAwQ7kNvwHdKwnr&_nc_oc=AdrhKLCG-MUkRTlO6TB1jrtoUo0au0RhFSzoFWthMnFCprnlOJldCAI7H9VSU68BRQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRZ_fi8N5hslA88K_FnULC6NC4k_YV3MxO4eno5ib2oA&oe=6AEF3923"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLh5J5ZURPIQ7kNvwGWvyp8&_nc_oc=AdrtgyduDGEDIcbvv5tg55fWcSG-2Wiy4eZxm23aNKFwmrAqmNNUovWjzmL-gcvED70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGh-AK9Lf9mDTi7aDWBL2lDxgUGJIBj2Vz3oe8_59FTw&oe=6AEF321D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfTUXwevSPkQ7kNvwH6Xdk7&_nc_oc=Adpd2N9qM5KgtlnJuwZPCFlaEtTkqJ3MWv9iLyBwAcVO7X2NalpnJ-xeL4u7H_VFmpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTRW3Bg-bFYVJp8f-5s5uvZVVbI1hpL_QNexC3-C22nQ&oe=6AEF3754"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
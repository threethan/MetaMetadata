45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZLWfGyPrDIQ7kNvwHZtB5o&_nc_oc=AdqcZ0X1pPvIgXRxz2UIsCA4nUIL6dvmJDkqKfbztu19yFp5SauDplFmu18Nxr-MIDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8NGqTQnleG0sc3rTQLT8pZ6qn0VBR3MJ0cf0iF30dYQ&oe=6AB006E6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSbGEbiBqeQQ7kNvwF_AkP8&_nc_oc=AdrlRfXzIXmLxMUF4DCEwO7PpU-iDjuXbyHFHwy8cRSvo2wsdGEmRVz0vGmepYJq-24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm_478LyVDGmlPn3p25Y6O8Da1ZI4OmVB7MWm-ppxvkg&oe=6AB00660"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-mF0PDOBAIQ7kNvwEN2nlO&_nc_oc=AdpTQmVw9OiQPlFGNm7w6ufD0ujxW2N8MHFWdIv7O9Iw1SMwbT6zbPWTa01IC4RD8sc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL77mE5Gh4PzSgRncPQKHj-IvN9aO_IV-oJqpqXKxbhyQ&oe=6AAFE1AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsBdPg_B6ksQ7kNvwHfrWeb&_nc_oc=AdrTSdjwtc_eymyeffXltYhK4_9k5Dtz_ONe8rs2JNaA9ehNUB2La-SAsr_oWffhxj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfqeJ9oXHS2obuxw1OmXYICRQs00lSAEVBfrWlj-YXcw&oe=6AAFF123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSKfjg88RfQQ7kNvwGuvDhk&_nc_oc=AdoqP3GwD3nCuNDrSLV-R78a6eEJ1qzsPr-rZa6NHfA07Euie7LtP862iMmwn2dHj3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId7jErrcQk9FebT3wCt2wjVep9g1Bb0RT4MFpfTAn48A&oe=6AAFEA1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd3PdM6zF-wQ7kNvwG9Rxan&_nc_oc=AdqwmCdevLQGg-IMmia7i5SlHVLBewMMgUbDgaiQxt6Ev_UKtkB1ciWWoJHetnhFCQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSWV42WtZXreen8UUYC80WQx16ITmrLoNQYDQIRfH5zQ&oe=6AAFEF54"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
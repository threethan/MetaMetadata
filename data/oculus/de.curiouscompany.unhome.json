45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWpNWFj9f-QQ7kNvwHPpmnq&_nc_oc=AdoX6fSyClv8HmpqcvIf9P4rCfheMWdi5MzjzgMrb3QjYNuFD9qWxFk63JQc_scw7C4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfsDVSi4TRxKLmv4mt0FjmLv8oMc5_zmUhcDT36D_ujQ&oe=6ABFD8E6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O11X5QjsQCcQ7kNvwFvRJzR&_nc_oc=Adpyicw-WD6okB__98JwwPFYLkK5-jSr-U6OCY8-q4CrJXNHkTbZtJzmCVJRm70x9Es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKwqi3uGNzk4OvlQZJPOmf8RKJ0I5EfcdwbQI0B2qDFQ&oe=6ABFD860"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XKGoDHXkFwQ7kNvwFaG3OU&_nc_oc=Ado61zBPZQ2rJ2OLoC2lH1klxPNqS5BGLBCE5FdPyidXY-ZrKQc0uGxgDOep2O7nTbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJeB7DnXyg1yFDjUsuW-L3_YcTnWSbddXP3ndsMXHiew&oe=6ABFB3AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7FVcMo98ocQ7kNvwHn-nYz&_nc_oc=AdrRsXM-odSmRzLuKNLUEMnLBmHYifH8pKEE5SocJQQ6VfKZIKBhNGWEdhpK2okPw9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjs3MnKrwpAKNumiQd1mW9YWOwdq0HNU1smN5Dd9HY_w&oe=6ABFC323"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTVp_szFyPYQ7kNvwFFRCer&_nc_oc=AdowOUXNvINnDu58Mnl4sOX6mpJYmiNujYBau_7Re8Lfa5W7JwIsKQttSJ8uoJ5cTcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtlPzn5HUrADY2xxMK-clnNFYFNMxj7j4hc2HsFd0Thg&oe=6ABFBC1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7ndwBn5L5cQ7kNvwHRP5g2&_nc_oc=AdrFnVOGG2PXxEo7OsaorBcTz4idlYywzd9TzF-zVEWnnyrr3hFye-bE3hBOMC7it9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPmv_dfT-Kkdtcg9kxRJj4dhVaeSRlVTqwG-ecivwN1Q&oe=6ABFC154"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
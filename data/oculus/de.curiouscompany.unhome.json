45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7zoejT9F6YQ7kNvwGb1B4C&_nc_oc=Adoaw3RThvrSTVKqNL5SEjvC6uDG_rVjHmkk3GziGUZYwBpNJvZ1vgKr8RJEukZCxQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Eqo5QbTZYoRJfL-6HcFT6cOfjJVY26tahsxPAuub9w&oe=6A7329A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4jF8f543SoQ7kNvwGCQUKQ&_nc_oc=AdpLtnd7S55KFXwcwuXxVMhadPPxqbsYWONy3pF02lDRrRfWF5QCDrLTm7t8GtWWXy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvHRqlwqyjdn2SGRn2_gzMf1dBPdMKkwyPm4wo3sR_0A&oe=6A732920"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MgIQiNiUxQQ7kNvwFGoeV6&_nc_oc=AdrSRYnCTrotA8z_nzDVzihAwS6NgPrYMqGCgY3q-40khK87vWM2_ukXCpRVoQouOBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL7UqaycF8Hl0U_ckeWLW_W0jOEAcCcmFhJ2Jh2hDX7Q&oe=6A733CAC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VodSTtOHtNAQ7kNvwE6fCaZ&_nc_oc=AdogpbBwD3muw9-e0KYAoljSTPXPAFa29O7GAXpuX8caecjCuZ-dTK3RZDXrIcSJZEQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKqu5nffcDYZNjGND3FJHpGGiGFPcB4fyRpU4sAFeVkA&oe=6A734C23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA-85PU2f2gQ7kNvwGMK3Yv&_nc_oc=AdoYmEkFyn8FwypyIgNE78Ayeq9Y7tf35bbsO2h2AwjBRYgl4frEzgq-9jJbivc6bvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUmPg6R7LxR2jfHK7P93G5UvQ-LONeMrhWslD3RS9AKQ&oe=6A73451D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzyh0SikvlQQ7kNvwFhDWcr&_nc_oc=AdrqN9B4yisqsHjvaeLug0RlIh_aheR7ypbN7yWnuzL57VGtn0oZtQyuG2lhfYAFITA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpmyWfZn0ZWWttujzjQRVtZVX57QAfjYnZ_Doc7RlPcg&oe=6A734A54"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9aMyFZYUV0Q7kNvwGQqi5r&_nc_oc=AdqIC-9sHxTlVLRjdlGvmkQ7fi6CNpmg8QU0v0s1urJtD7jtRwTcpFSXOP4hXQznOGg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaB_ka3AYIUDus-GK4MkG3OUkRFWP9TU9ZJdTqsC-CTA&oe=6A8841A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBXocIf92iEQ7kNvwEczEPG&_nc_oc=Adrp-DeCffcZIEdNzbRXT0evB8caLhZ3dtW6OJhJpnM5PNbIZ-CMum8dk5IFWi95Bi8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL-LWMbV-LMitLRAWAT2S49sbcUzArV-jigVIbKdFUcQ&oe=6A884120"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jNwVd3t4bsQ7kNvwHJEzwF&_nc_oc=AdpeEYiT_ziHgDyWVde3SEkUr7fFSkOEqFeHvIIWnBzLRNerstCDsm4-dFYHwyKnXnQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE07xk59uOSMuHtcSOeTt67cZMCFi4lPQBPKH_q9EjlSg&oe=6A8854AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnmRPHl5JLYQ7kNvwHdsP7Q&_nc_oc=AdolL_3ursvquOnVyCYLI2W0urJQPeZeeghwAZ8jabmhGDQVU4MyeYSX8DnwpcL0mjU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvvI8JIL2Y_AT3Q4JJ_RzQtaCEbWHarIRyvWAkjJwM_A&oe=6A882BE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c2DgIwjHLsQ7kNvwHyDLo4&_nc_oc=Adqmtl7Vd1EWrOQ4bxu_rhfBUkppXedCpwcvoMXLxFnzA5CXXk-L9bYr_0mWYsz5-wY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkM0MHhtvNpQeBNPDvG7Xn0j3tcZCc7DNVAWIfHhey1Q&oe=6A8824DD"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6NM677I6WAQ7kNvwGkpwNe&_nc_oc=AdpyAB3qox_N1SLnmUQr-8pKfbI0vPTyaPb-H2tnW7IeZab7rF_BQ4Sv_FgfnVJ4JK8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGkPQQUTXeWAbB5VTanmnlFi5BEL061JGcwgBWFH1Y1A&oe=6A882A14"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17D8NGFzzRQQ7kNvwGvbh1H&_nc_oc=Adq44FALULNSdZOJcOJOpVEn4vIIAECkbSUTJkTjjriYEDDtfxWBq6Gk65fchCosaZY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgMb4Mm5l9VT0hdnYMJzIKuEyIPp6FU-qqrimz_bROxw&oe=6A9FFCA6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re3VACMKW9AQ7kNvwEP18_N&_nc_oc=Adq2_3OfGFRLHVVKb-WwAv6LEUUVFIY4vubCmHQmEC49t4Kxfos33_uQDUlCpDN4hv4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi42M7TxqJSQCCuZJEqVF_-I0YbGHzkh0cZSxepLUwRw&oe=6A9FFC20"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpSZrUADlyQQ7kNvwFa3T48&_nc_oc=AdrFKWsbnd-4KWE_QKfSA1uqCFBwxeV6HTd07Qloy-JNDsYIarhSoKH75LjUq5MDGn4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtveoBDIiqNy3VURkWANH6-AHS4G0Ucc27uMznK1WVkQ&oe=6AA00FAC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfrg32ddn7wQ7kNvwGYwNSc&_nc_oc=AdqzMp-FCN5hvEFu_pDLMxukXme_6AMMlEWPifvb9Xy9JyARbsPsiPZHURI63rhyGTg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6GRv8OjbcRqSCbLq6jkLH8MzB_YqMQmGDy1aMgC6zUg&oe=6AA01F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Osnfk7aUg6EQ7kNvwH4cvZu&_nc_oc=AdoZw1VwxxxlfgA9bve00nlQ6iHKAv-LztO289_J3FLDfDKKw3dxA0kKg18BwYzuWIw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAHs5u4HRbeSqE1m9FqVakhnGqG0SPdTNpoZFgnceT3g&oe=6AA0181D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-SbjPd1LVMQ7kNvwGO4M27&_nc_oc=AdqKN5-dmYuVeZ4e2_BX0qB14ZKEZhnlUqVvSiQjGHtxu1cn2aKu3lG38iQodXI54yk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOsXcOjfg6zhGXRZK2mFLl6o0-J_UEOx0scfCY6NUwqA&oe=6AA01D54"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
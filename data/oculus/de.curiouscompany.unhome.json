45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9KV2Mi2nYkQ7kNvwGHPtxe&_nc_oc=AdqBrljyzq8mNUaGBO3ZhI13GOgV8t5aX24zegYG2V9HE__00kg6HGN9X1iIJJ1GnDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN-iqN0RLB113iyooZMsRganUmP7JKOWe545DhmvPRRA&oe=6AF494E6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgOinhj-L_UQ7kNvwHhEEWK&_nc_oc=Adr18HfhNRm3Et7_4m2jJ2dYbkTsdPQOS9EE1WqA_kz8WMZjKYNt8aUY_9XLAQlfFwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEM8F7kvqkj-5kJJHjKUeSm59MrCI9QX8Tu8xm0yS1pg&oe=6AF49460"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-x0zN5opkd8Q7kNvwGO20_Q&_nc_oc=Ado5DWWL7GbqiONxEQY1T-5SkfM8Cc-a-cVFnXcK1ODePG6mOs-o-g5nssJr2DxFnZc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2MKDw2nDeyVcXqCaCwgttSXSmEaGKFGcyPCGoZwbbGA&oe=6AF46FAC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmEpGKny490Q7kNvwEDELQV&_nc_oc=AdqQICsZsQnUMqC-0aDQ_yeL-DtKzalVIIlD-YK8eUFu9qgovGQ6jNz0L-iHpjTThzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxG8kOSs1-VR3fals99teGKx3XycptzY7VPeFf5NALaw&oe=6AF47F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2seqZp0FOVkQ7kNvwEbLujT&_nc_oc=AdpTalikl48Ih5deVdvHyyFButKKaqqsVLsA5OS6nsKCZOcAWjxNnlG0espZ3vHWPIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWdEMrDtf6vRsPh1TXu2zr6CwvJMeZu15DpXdm0bmr4Q&oe=6AF4781D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiqOeX1IPlEQ7kNvwG5FiEE&_nc_oc=AdpRlbJogb9NlRaRycyO6tAvByKDMe-yOMxBxO4HO3E7NQXutBaJNWIQoVpOTauhV_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_7iJpCVlA7hUABZoIlL9qwc3YtEfJWib-oKICAzJa3w&oe=6AF47D54"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
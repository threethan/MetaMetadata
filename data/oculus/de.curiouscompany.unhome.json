45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuPBY_BTq28Q7kNvwHOn4rE&_nc_oc=AdqoCBkso48qjYMboB7PGkJxGhHk0_duLLVn6rMFuFHW33Qr1tzm9fYhGfvFWiCKoLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuA0S9KcEhpFXc6CXjBxLUb62oJEcyn6jnjNEa-I83TA&oe=6ACE5966"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyHK-ZD8Wt8Q7kNvwGcZFz0&_nc_oc=AdpLbJTlzWRxDWAxWaitN7ZPBSPyn3186174P5QfCJPYrC6tPxFG7TwCWCHXeLogyy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7q0R6Zo5kxvFhIuT4zajixARiqqv_4o-kWUsFVg7Ssg&oe=6ACE58E0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QamzhqGe5nsQ7kNvwHW5fsH&_nc_oc=AdqJWWXDb4So25blvwRgV9zcONzZn2jE-QtUlEaSQZAmVJEbkCNGUN1JxkZ3HlfdMfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ4m8WQ38jKkqZQB-zECPMrtLqwLoqlg-_xsCOIcPCvg&oe=6ACE342C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSk3Qor7YUsQ7kNvwE-iH78&_nc_oc=AdpL3v1oLznfgDMekkQ9zUrocfUctQYhKiKSHnJr0_8IdZsQXiWzwP9kEIy0H9mf5V0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVTDOEWsxpf8BQmUwGE5Ce3Wvjms97DcWdY0oPiNgjfg&oe=6ACE43A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP1oL8VHKx4Q7kNvwHlFmtD&_nc_oc=Adq16hfIvPMgnPlNhDb8T3TGav-00LHVI5rJqYwRznnqAoWa2vpdaljJ6WYtkVdBrNk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwYiLmPAfPL4pdp7ajWEXdxsmbPZFImg2dmycqDdTdwA&oe=6ACE3C9D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgG9Mjgmxd8Q7kNvwGdX5m3&_nc_oc=AdovIus9pOUj99Z7LUvWeyo_ktM9-79szkj6Zb9HecKyBr4OktEzwMqNw9e58YiZS5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4fEmt8uE23Tyg7lH-V6JTIms9eRMXmmPK90RAHcpUCw&oe=6ACE41D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
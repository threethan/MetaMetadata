45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA1PgR_JaKwQ7kNvwEIQAq3&_nc_oc=AdrpwvyPUj8G-vaNPQWg2jLzVY6zCdJwA4agxVdEALfYIdAAgnUWufltch6sc9gjKxo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENg_gsX4BZXnrc32I5QxrKhHWxuSAb5rMeHj9ahxmr5Q&oe=6A86F026"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7fyLIMde-YQ7kNvwH-Uw_O&_nc_oc=AdoI8w5oq0MV3kYrJwpZ7Ilvx99QhgNllLXWOHwQ4PWQ7RUwn46s1K4GF5bSW5XZ_Tw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWZMVM3M9VwvMfKpLh5Xd-FrNa4zTcx7i9tGc9LInbrQ&oe=6A86EFA0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jNwVd3t4bsQ7kNvwHQhGMN&_nc_oc=Adqp9hVCG666kWd5jAkby7VzJm99YzMhMsZcVn9AKUPMsV32p3XtvVe6jEtLhaa-PGE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD1xqlpwz-Ckm2BK19kcOcPy8F30lwuBa-mlRBLAIL5w&oe=6A87032C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCNRlkvHeFUQ7kNvwGVwUKP&_nc_oc=AdoNog2XbAFk-ByBi3K8FUi7DLKwOijotENY1h6gKVNsXBQ5jCWtgMRFMSB71IZaco8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3YdqcRNE4pVD40KPxMbTVonaXRW_XjAozbswTkBBC7Q&oe=6A86DA63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c2DgIwjHLsQ7kNvwE8uJSY&_nc_oc=AdrKO4Ge3FILIqKYRuO6qJlyLgIgta9nVdTx_HUefxh5uEYEF2dp2MSFTmhZ92hOeSc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG__mY5X2lQLBar1eZiniYfcdLDoL35GPnE1V6sIA-36w&oe=6A86D35D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6NM677I6WAQ7kNvwEbYlI2&_nc_oc=Adqy39Z3o_kvHURLZ-guNIyWLWHRY9yBDvwnWiVwlCvhFrTPxjtkFWbKQ8292Z8IVrw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwpY1HJO_PTiid0HPYCsL53VO7FYi8pvsj2OoYb5x8_A&oe=6A86D894"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czLrrk9i-pgQ7kNvwElQLL5&_nc_oc=AdoB3q4EU2rr9Ij-97cbPejDe8c429707F7NkzYYzbNPvjitusthhfqcoB7PZNWphfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtOS18nTRbLeAUmHIk0W4yK57f01MOb_ZEKp95mkAmcA&oe=6AA7E5A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haqDdHFeB7EQ7kNvwHA_LTz&_nc_oc=Adr6gqZJu8hqYuNAhkOw5EVf1Ah2PHXfQpFx4WCs9BablPGfwNcH1-Kfe1Jmcytvp5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK63lg_3kvkkT9iCC9qixknLsU2U2axUGFvg6Q-rWxQQ&oe=6AA7E520"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv8OnM5bI4EQ7kNvwE9A9Ps&_nc_oc=Adr2hW_nXx9zX4wPJETpvrZPtbxQ4WcXlW3TnX7AroDwR7jBIhBVrjdF3_b4Y2Uckdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmriQsp2lRZZO2Vp8bTAXZW58MybcHe4rUyKywF7b5kg&oe=6AA7F8AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phymWaeK3PwQ7kNvwEcz3Ot&_nc_oc=AdpLNR62nowa9dmFALvQYaedDqe9FLM-ViWBzAGNjHKnIXv_tLVuQstzHtPV4OXT7P4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDT1gXg3NvqnxcrElFwxRvQnXgVFSNUSa1S892uYTtcw&oe=6AA80823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWN8faQnIc8Q7kNvwFYX71s&_nc_oc=Adr8bdJQI8aXmuzS1V2-ouwOtOsqQI7bpWmIDR96rNIp39ARSN3P5DIm4c8AM6OU_cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAt84RaHORkjUc-R-SuQwHYJLuz5ZETLM3P35dBJtrYg&oe=6AA8011D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hI11mSHWe8Q7kNvwEdRqrq&_nc_oc=AdqB3vO1x9-FX2ercMNOV-AriXoag09WrrpXOuFN7-lXDBqDaExSAL_nM_AAvHFXaHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_phRxAvS6pJrF4WwABPpopf6IGG63LuZNh1X9NanuKg&oe=6AA80654"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
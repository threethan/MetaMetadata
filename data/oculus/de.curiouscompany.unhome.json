45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17D8NGFzzRQQ7kNvwG5fKm7&_nc_oc=AdqVHEV450uUr4WJ45iB7_DJrrckAQOkkR38oJfbOQxIuML47S06thYGNAJtUSAbwWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqd5wsyxee7uBNlYi8O4zY3JOoLNRgjcAREZasy0js0Q&oe=6AA29FA6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re3VACMKW9AQ7kNvwGrDxc7&_nc_oc=Adrk7f65wYMV7hwyjqiZJjbkqjFYcYb7OkmjnWRve8XQJfJz4WlN9DsbYBPoRL--oLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbkWp7eMvKM3MRZ1oRRr-_3F4vUOWj-ZwsX3iZpwcNBg&oe=6AA29F20"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbEcgusjSGYQ7kNvwGYv9GG&_nc_oc=AdrtSoOl4s_9D6djwPraXUX1yVkIYdIvKz-IZpeUJxpnziUdLKbW46ULOQOGVLMkRDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3GIymCi2a5qRiBBVrPaBWnxAXld3hHM6pibjxf0Qqow&oe=6AA2B2AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfrg32ddn7wQ7kNvwG5Ss6F&_nc_oc=AdqNeu8OvJby0Ct6QMxjTww6pKbl95UcTvVVZBIx5bFugEcqEmHuq7eSP14aZKzHev0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXGYetWVhfKDlnOLqwEObg51uKLzuY6d9ZZZ6NpeOjIQ&oe=6AA2C223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAgqYj1Pi2IQ7kNvwELQGda&_nc_oc=AdrCke-Z4TLWMJaCBcRUjrOfssLYK8oeVVZxe0pJ8-DEHd5QJcD0zpuMcTotUmWfQCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ35_Bh4_SNxcte53x9rKZDLBKa81RYetQKbxtTe-5VYA&oe=6AA2BB1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8MADs8GKR4Q7kNvwHM4Quj&_nc_oc=Adp3660SvqAbn8s0m3wRllgP5qexMV4Un18Junz2RCPwYPQkn0WnABSu1odX32BKrZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-VNQvXNNMztjy1fz2D0itlXjr_GqpbXI4mIGfUUP5hg&oe=6AA2C054"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
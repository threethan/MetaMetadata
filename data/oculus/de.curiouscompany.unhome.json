45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9aMyFZYUV0Q7kNvwH135JX&_nc_oc=AdoqNOyuxtapZV7IG0EZ73bHLrt6_kvlMZOXw2kQdiJ2UYg__GFLm8Gsn54q3S9yV-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjkQsMWp1l-1lsaRtyviqv16sKql40322J0jWqw2vmpQ&oe=6A899326"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBXocIf92iEQ7kNvwEVqnKd&_nc_oc=Adr9nvmLd5yo9XYvD1zXYVsKYFEBaelHz14cGbc_HGINoL630Sb8Mncu7z2AtaEgnFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeefis1zOzv2FgXn6U4Vu3Yqkmrpjgw7EcwW4Hju5dFA&oe=6A8992A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jNwVd3t4bsQ7kNvwF9_I86&_nc_oc=Adq_4MYzQ9lFtNJI30gou883JIqZ7Q0ZRI7g2ilQb9FpJTzDHjWZg3vqgTyLucnZyEg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdPfVHw71fOjU0DWYVBc2hrxqyl3Wu3Nr-t-EjHYSV2A&oe=6A896DEC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnmRPHl5JLYQ7kNvwEE2v-w&_nc_oc=Adq7BJSccNwxsQIqFHb3iuXLxNxvKHmkjx5KRkNQ5hp9ctQZgl46bMjjum2jFDSi2lo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlwClZfvK403uBwp1jR7cEXbhC5WpP3kN64NYAGeSC8w&oe=6A897D63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZedcxPeNbsQ7kNvwGu8W55&_nc_oc=AdoWLeXVUhOKHQTg2V7VORecdpKA8tMlBhHr3u_Arx8gGuQgqP4RZx3q06nOVe9Sip8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_iMaHi0DnnKK-NjhviingEXc3gJPiU0tZFbXvjG2Urw&oe=6A89765D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6NM677I6WAQ7kNvwHHIqO6&_nc_oc=AdpQDcc-FMIwmKO4viwoa4CBC62Y1IuNPoghPOYe2MPiZmAwS2nZz7dZ2ZEYkGjt4FE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtEyMcVSotADESGUHauOUao5DPLU_l4iz5vRyzmedlbQ&oe=6A897B94"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
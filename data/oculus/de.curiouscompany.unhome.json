45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWpNWFj9f-QQ7kNvwF3jKjx&_nc_oc=Adq5bsHDrWUA__Tektv0nnlyqkXpuMe0OeeYACtxH8Tuow0rQZaeCRTavTqOaT11hr8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLAdBZ9lVqX-ifVxnuDSigOyMtQz2LzB4PFwFWayzUzQ&oe=6AC27BE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O11X5QjsQCcQ7kNvwFmPFOw&_nc_oc=AdpSp6uR7LD4ZFGMjK189hIGS2GBwZEMve0GTu7FryxWxMhXh_0983weEl57qyhdJp8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOatM3GMx659No6xLHBrmbDCdiCTrU3X8jX94qbWRJbig&oe=6AC27B60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSLra_wXmEwQ7kNvwGwdYeY&_nc_oc=Adpvg6A9tKVtIqSZoFkaKGUugeXpq3vM7lrmfePENgdzTGhyo432QAM8bpzqjPl34pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtBHmVTrDTxzyoTsQRd9Grd-S7Ow7sUBet_6moMqedMA&oe=6AC256AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7FVcMo98ocQ7kNvwFn-cnz&_nc_oc=Ado0nI--i64EhedjtF0RK1TZEv1ugcilsAyJMEuxl9O4r-zQY8Z12772XyAM9_azrXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ2HhAEb9AwZ_Hn1POx9wV0geDiEikhsvaODvMwonMBg&oe=6AC26623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itP6EueVWjEQ7kNvwGD3ZpY&_nc_oc=AdrYnTQkkLlDYvqrX-FRtM4WDgS0yrwPGc39k6YV1Jhq_AqkxWSBbU26KefL4TakHoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD8m4CjZR8EfX5R5fWmphJbCuMOWKPZ8FcjeNv_36B1A&oe=6AC25F1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dF4JPy2GrsQ7kNvwFMi4uU&_nc_oc=Adry1i5uYogqW34dZezAfAxQY_RAMsJ115mP5YWeNTLSSTjj2gwjQEPuaWZTqnpkPyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN82CKnincYLtBGoYFLJb-SUDJxwx5jmeyRD0SdyjOX5w&oe=6AC26454"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
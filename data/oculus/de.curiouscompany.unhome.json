18386545635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVsgahLMqIQQ7kNvwFIeeql&_nc_oc=AdpGl983UjEP_o__w7tD5XQ97AivEOTFZD7lmEm7fG88fZ3vkEq0yLM7AaKfNQts7gM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImMU7RBTiKnN5ccRHUj5ldFy0nxuUKncJzGx-SD35yOQ&oe=6AAE7D26"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5f2TYREXfUQ7kNvwEEy-iV&_nc_oc=AdqQNg6msQz4FEmuQZxCuWiLTlH1cx8RJHfj_UClg3tj0LKJagBc99gdi-j7bgabCg0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK23dyV61dJC_CN3mafOOEZq-qeRN7jVsFOa15Yd6Nh7A&oe=6AAEB4E0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-mF0PDOBAIQ7kNvwFc0sDq&_nc_oc=AdrT7qT6JqwoZG_FQWiZw407No7eHWYDmFecPfMqOMl0vM6MqEeicmZZNKRSk6sIFDI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX5RuTE6YYKo9bPeyBH8dkv0McqyVTav0qa3p45NZTNA&oe=6AAE902C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq7g_SIn-qEQ7kNvwGgUFRy&_nc_oc=AdpZ_CHaDliPFUv2_nnPbrjuCGugK4ZTiqh9MFo8QeMWhuectcWOSeJZBjpgZ6gBhVQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLctHrX_aG032HQnGNgxCMmnWfcILwlN1Hkm-pVOJ9xsg&oe=6AAE9FA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSKfjg88RfQQ7kNvwGvhi69&_nc_oc=AdrDY25jPyBn_JSwXUVm4L76S0jhUaModngLT6VBVoOUQ6zhjmSbsQgdzB-WIeSfjUw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn2Pj6LjMmX91b_InVStKiFq3JniAD3a2yxX6Z3Hjh9g&oe=6AAE989D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd3PdM6zF-wQ7kNvwENglWQ&_nc_oc=AdrqUJb9pKQhNrpN4p-J3px-o8VgtSTJxJlLvJdE5thw1YPm6_JJT8W5p3aUGczVyYM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRV8J9ojtS5yJ573gojWd_SdHX0DlEMiDrWwsVeQdh4g&oe=6AAE9DD4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a
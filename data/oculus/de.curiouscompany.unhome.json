45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_A4aBNoGoYQ7kNvwH2cpfI&_nc_oc=Adre2UzBQxwepPiJKJCGVgEQCPDgClVAmmBSvnrpahYNsidT9PJcSdF2KZFatWneuD0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy6zuJNr0SGsmr-zxyigwmWRqdr-_vLwZbuRaCKZBFAw&oe=6A81AA26"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqrLFtKQ8xoQ7kNvwF27dLS&_nc_oc=AdoP_xf-3jBELqz184Ey8LJascqPnC__a3mwX4VzJeTYjbacOkGEPW5b_prWorG-4qA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOG8JOLfCVzzQrQA4GDEBEjAQ7piRCYctMAS3AET1wtA&oe=6A81A9A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXVTFYvCQFsQ7kNvwEcLZXM&_nc_oc=AdrvncBNzvVkCM_ls1rrrZ44XAUYqu13Zv--7ApUjpUIvmZ8Nfx5d6GHpJemNegQRoI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2e0iyyn_hTTFT9yx6WnP29_Ws8Wtrxu46DFe_vhC24g&oe=6A81BD2C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAW57u8XOzIQ7kNvwHAaIWU&_nc_oc=Adr_sPK5C49DlUPw5FP7apfDZWTpnBlCvbhhGbaei0YrcR07EcNmqJrMa5akzl_b7hI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELCDhu8BqzEAOaRpUnR4YqUCKkqta7uGqGYCEeIrXjQg&oe=6A819463"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jWZZ-L3ZvgQ7kNvwEHT54P&_nc_oc=AdqoAqfAqP1HjOHCbaFpvmFhJV619lJYYu2JWDhwWTlEl6XZa232UZhmh2zguKez02w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0Sq6eABBolgOLsscyQAL6MHIgRCweDCEXCpcaBeg5Pw&oe=6A81C59D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfhXv8-LJYMQ7kNvwHtGBI2&_nc_oc=Adp_3zGQqEksrd0IEc405U-y69-OgvX4z3nBZpCWkGeOqsm30pfrS0SUdcoLAcGO8T0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAYECPihzL67B5ciek-SVbaENJf9O5_xYdPdY8OG7MHA&oe=6A819294"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
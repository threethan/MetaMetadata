45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuPBY_BTq28Q7kNvwEuEajH&_nc_oc=AdqTMCrxuKb8u-YHlBg5GDgfM4wSKyy7qQg2TJKInZAhFPTXWUB3bKYk8ErPF58o1zg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt40KLpmpxP3bmR-E6qnNyss3N6tFk8f5wVllyrh4G4g&oe=6ACBB666"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyHK-ZD8Wt8Q7kNvwElCsy8&_nc_oc=Adqty8Ygz8mMWV3z1-5pdoq4J-pZKcJuUya9tLs9TXOKAAaISRgazJCGavViA0rMQJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODiVmSQ-qblF2ayKx1vZ4ArQEsCd9VqzqSk3P8Bi_ghA&oe=6ACBB5E0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tw4hBglaxKAQ7kNvwGSrkDB&_nc_oc=AdrQUWntdCdlYCVgVwO8gHakg4lqROZC3uxszd1Xcnbi-kVpiOAg-QwSF6wh5SYhOvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsesjquz-ZXAR4-vWf0fD3eqA4nSgAz9E-A3FUFd9-Jg&oe=6ACB912C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSk3Qor7YUsQ7kNvwHVruy_&_nc_oc=AdqsN36IQCrqwjJt9-fBL27xaVHSiR2kV5c7kDlMedh2_yu5EgS7Mcgq4HjxvXk88Io&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOvuXeC0uaIB_6CImzaj3bk7l0PkQvUqiw1sXrJR0g2Q&oe=6ACBA0A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DSyNFtcjLQQ7kNvwGuGm8A&_nc_oc=Ado3v6m5vPZIGG5TbjUCaomzkTfa7Zm-MwjTwM_ADVWZ4AAcux4lk88K1GqPNZY-iRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOBs9moXY8FamChc-CQZ7q7gIB1ey2Eom2vBTFTc9n9g&oe=6ACB999D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucMf8rVYkNQQ7kNvwHmFoKu&_nc_oc=Adq3PMbCzs8-y4LB9Sf-9vv8P6V85nzuHwTr-lYj0NX0AD9lNHu8nR7UVM03f7hIXyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYYrun6cvIhGpea1kdome7gx_EzSUfd_4F7-S25GWZ6w&oe=6ACB9ED4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
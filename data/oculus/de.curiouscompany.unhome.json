45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1e8jLgfc94Q7kNvwEO65ge&_nc_oc=Ado9gI43zc2Ub0aax-EkCamwnRtTHEvekudE50e_y67WPW3ErXX3amqSNIUBbr7OiBc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOBeVjLdn3UvMJGT6ouhzBUF0EOg91IkQ5MWqYouxgAw&oe=6AA542A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RzMrNF2a6gQ7kNvwHgiHAn&_nc_oc=AdrUutYZZ-K0TRUy300tQb8lm7e1GadoinyIJh10thfVJ3lAHU0UP0lcUe9as9UWe-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3Bhor15NJXDnz1bEXw5XCY4qQH71DpS1GFNoas1MPXQ&oe=6AA54220"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbEcgusjSGYQ7kNvwGLJCp_&_nc_oc=AdqaRJYVJtf1rYA-RfFeRRhw9J4_ZHpz2AoR-FbWiTvmYxGL1aCLkMjBYagM0d9Bd38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyct7mARL39bzX2y6L4i7sGbO-e7zDklbG6sTKQcvU6Q&oe=6AA555AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXlaDMgnxC0Q7kNvwFn8vv_&_nc_oc=Adomwpwc91O1MVjn393PnqraQWDvMqWXE67w23LBqwCaLqajufZ-Fk7TyS4J2D6ovfM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1BMlPc42YtNuHLdp1XkSyYgxyWKaYsVm6Udr-tabmIQ&oe=6AA56523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWN8faQnIc8Q7kNvwEB8KeS&_nc_oc=AdohWObHYOgGqVM4u8w_TQowGjx9Njjkli_yHGPqK-fQJC0baIdnJpOPLjOEFANZyn8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgacIYU52Y4Gdcg58kcudj6evqR0ZqC25gTtpXo6L6sQ&oe=6AA55E1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8MADs8GKR4Q7kNvwFbOjy7&_nc_oc=Adp87eCB513OjUWrE_1KzttdLeJh6McTaNDnmYJWHbFpeA2F3xYqNOoKm-1sfheFr8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbupkkmt_iMRTwRIHhzPLAdPJ7qryKJ4VwxipFBOSw9A&oe=6AA56354"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
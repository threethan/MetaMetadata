45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLS6izmu6FUQ7kNvwEMylWX&_nc_oc=AdpINqbuGcCWhZ63Zx_cIWqkDj4QbVxRPUvb1rBMFGv0154_zQeYf_DPEEDF_d9P92k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKYjUOCORdC1c-3OGZFxQqoqN5t2XC7GfgVoLE0KIYGg&oe=6A7B12A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIJWbgtGn9kQ7kNvwGEF8F5&_nc_oc=Adp7ui0u-A1MhuRtx6YD1Knj7tobbe321jMUmBRcemCbNkxV20dus9X2L5C6Mj3w-HE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVWc7gSORqMF8b8W3nOJUuDaftxBRHMDj_8lWkAZPDHw&oe=6A7B1220"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phw18_14YAIQ7kNvwEoF0ZK&_nc_oc=AdrC082CIHAlxvrsr6YuCXZdp8xeIGmN-pTLh6QDu99q6cCph7J7YBIhrVyfkPrb-2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2tAvTFPcNDJYKcfAzt1DM-u6mTOvscI0m2RLF2kpJSA&oe=6A7B25AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMlc57TOtf8Q7kNvwFCiiUW&_nc_oc=Adp5bir3TV1XSFEcHJrLFzo7lrDrw51TLr-9p85iYrkluIb01Zm8HenGpRMqzKgB1jo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNTFPnQB4rO3m9eJYfDwlj-go3v_sGF2CbdQli2bQLrg&oe=6A7B3523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2pnzVfMYT4Q7kNvwFvqQZA&_nc_oc=AdqEKzzukfC1kd9ni2AjiCytZiX9RgZfTRcwRpGRvJxI3tpmihS_pPpCfucYf1Vc0aE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1UwzbzZ50P9lWLIGZYXbRS0ZKAWCggong6ZxLWP2JCw&oe=6A7B2E1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qREQa0vMiEQ7kNvwFFkmYe&_nc_oc=Adr8V_ZV7bAZ0cgc7m9PgkiqvqHVBuQJSs-55toOOt5fzU3qWZXUVwbeRQKw6C-umQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6viporLWVyHkUCzcMWjR9iUuTdxTTUHzMp1MFqZBUEg&oe=6A7B3354"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1e8jLgfc94Q7kNvwG5IM1q&_nc_oc=AdrnArqU1djVM0XzGX-LU-7TI9tB4IwzatG1wndm--uLc2JZIeJpS1rtyL9TgER2j7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPIkeuFXq6QiW2wPj4N4nDW9Ilofo2Cdw3aOJknT0soQ&oe=6AA69426"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RzMrNF2a6gQ7kNvwF9x5KX&_nc_oc=AdqvKCheLtKH8C5UG8_SIP8ZZkgEmGNwTraOfiOj11J_PoCkzFSmYybwWjFoyiSE5Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFF8-9v6YmzPJ5qtZG57gtNJoqtXFK-8E140sY5wR3ig&oe=6AA693A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv8OnM5bI4EQ7kNvwEQ6ho-&_nc_oc=AdrafB_cdP0Nac5--7RN98JoeY6qAWIeUawE1ZlxfCz3Uq3T5pCn3epPxN7f4n6QqMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJW_i9qgRVvd5v_2LgFz2LIKgysOOv7XHidKRnAA7t5A&oe=6AA6A72C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXlaDMgnxC0Q7kNvwHfC6mM&_nc_oc=Adqw1CDHw-rLp0sp9iT346fhs_0bIoKJvFSjGl7eT3-K9Bsuecfbh7LLxi98GgzrC1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxd6lsthnVRvVmU3b7fNdDdn7R19D4qr2utXsHE3RWIA&oe=6AA6B6A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWN8faQnIc8Q7kNvwEbcLnT&_nc_oc=AdqulRkhnh9htQnEfCLDmx4Ykw5OIAEVhVvh3ZJbe4aP-nKdD9c53mLg7EN-gvUPZc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnzS1oHDKIFuog66a8HpGkB0sS8E0Q_r2oX1LgnECICA&oe=6AA6AF9D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hI11mSHWe8Q7kNvwHNmZOc&_nc_oc=Adogd0trCxUcQHOVu9cJPC-8OUV6z8zZH0qriQ7_A0_EranrgNqArr66L6kEno-hU3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlWgAiS-tHmFY2rISNkRXztjjkHlf-0u7dCIcPA63n8Q&oe=6AA6B4D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
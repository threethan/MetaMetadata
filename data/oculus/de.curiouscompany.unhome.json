45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNsZdZiIxFIQ7kNvwHADk8J&_nc_oc=AdpL0tnjYnzkypidrWRJwyLiHwRlvMPiWhJBEhuyxcbcjneh0VkUtn4xdmETgh39C6Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRWxXku5RieR6ZicJatZ5x-T70uwni0RzD-ZJO60MFiw&oe=6AC51EE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGpTFK9NyZoQ7kNvwFiaEmX&_nc_oc=AdpdCJQOhkrDSFtDVgpnoKKiTxZLXR0H1QC8lD8EOOGMdo6vL-FFd7LJK-XqVYTSV0k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPsTQRmi8EKrWexVbw6LqYUI9v8LaD4wW7PYumpkS8Ww&oe=6AC51E60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSLra_wXmEwQ7kNvwEa1Apq&_nc_oc=AdrX4ZUzbGBoCWcJsWUXn1FejPix6QfIrwwDdHVDJBsI3y4hDZb1C0pICqCXT-Bs0jI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcdpkNK0ggBJ5nVBGKvt-EfIIhuvpF_qOc2PXNsYDBow&oe=6AC4F9AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcIj84rvxhMQ7kNvwGSEKN1&_nc_oc=AdoJuqy0G_JHpNHvO1JmYTBhvcXpWKEuz30C_Y6ENI01eyUdBaSw0mHMEYQqudxBw4E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6LEt7dUUg4wCXGl7rD9Bs6ywbK8-EfLOcjlp2dwPsJw&oe=6AC50923"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q56-fynaBI4Q7kNvwH8ADeq&_nc_oc=AdpDr6gXAy3Fr_dD7AZ-gq96CnegDhl7V2JMg06YjWSqMePv411EvJiUH6g8d9fAUb0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO93_Viz3VAg4xpgaIN7jNr-lzxTsaHXlAaLaiTOyUmAg&oe=6AC5021D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dF4JPy2GrsQ7kNvwFl2S4l&_nc_oc=Adp6BEtbYXY5VuJkhLiWwPQaew-8h4p0G12HumFkue71Gj2ZKvysKdCFHpH8QRH9ANg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFVzvYPufEyhZ_ARTJHbJtN3tIFkhTiz98J7YF3yqMAg&oe=6AC50754"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
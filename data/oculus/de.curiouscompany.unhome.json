45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWpNWFj9f-QQ7kNvwGhQRb7&_nc_oc=AdosjvFED2qj2lbOtl0MjDekxxu78rxgJ6a8WW0ZWHi4jYKox6PGOzi0y_px8TWW3og&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIpG8MljR1OKwM70ZMLG8dHbUQRlD2glA9k2t_OwJ0Pg&oe=6AC12A66"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O11X5QjsQCcQ7kNvwF8wKUC&_nc_oc=AdouIjnrq-_NadxVSuDStyPyMPO4t6YOPEMO4sSOSD7-9NMSen2BYxlOFtgSUJQLCps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVHw4gG_7LQKEfu8mMYlAAfx28YO4zKzmEOV31cBa-Dg&oe=6AC129E0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XKGoDHXkFwQ7kNvwFVPLtp&_nc_oc=AdpEnYbHqecr2is53FnIR6azXyEVhvunuXDK_ZBNXhZOmc6VqgSQ3SnAq0TUMiO7J90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBFDru9DBnV75yG_a-1CWlpxd9oPgPTjprJdwur39QJQ&oe=6AC1052C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7FVcMo98ocQ7kNvwEcYNVl&_nc_oc=AdoQ76Nmc-BZylxVEHpukx4kG7Ne9rMSsj4eGSR9qPgAOModV_8N9DSS60PPkSXlEnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt1yNp4So97fk05yGSGikO4rliVrfy_iLgJKkbC56ATw&oe=6AC114A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itP6EueVWjEQ7kNvwGBqYjv&_nc_oc=Adrb4x8MvTjX2VwJW9NeW_4AprOxZChYnC717A7E1rx1IfTkhj80Dffq8slhO4JKj5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwGxHmH68NJpZ3Rztq-54L9HKZ_Ro7qKiiQIClcIwG_Q&oe=6AC10D9D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7ndwBn5L5cQ7kNvwHrDwm5&_nc_oc=AdrSKwLLJxaOgWmMuadTuRC0DomNhlIdZeI7H5OekwrD1mDbXtjtaPkMXgCYQyWrVrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP03Py2ph2NC0G27ssV1-IUOzHfdJ5wkrVuMNxZ3oerUg&oe=6AC112D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
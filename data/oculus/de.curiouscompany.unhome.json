45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLS6izmu6FUQ7kNvwGW3v_z&_nc_oc=Adp3mGUFpVfKC50sFDUkuk566XBiCD8k6V70m1rmQyRrX_BMYtxy8L4u-vN1_2Wxyko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq-kdseBpdirqLgOZh-Ok5iMvjM90RTcyKPu1lO_a9HQ&oe=6A79C126"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIJWbgtGn9kQ7kNvwHnIrWJ&_nc_oc=AdpsTHYfvYqAJo4mOK7qezI-SJwlHdsXFIsk9XKAO4SeRqfVmeasWhDJJRnu8LzmRWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmPSJZ06zipFm_EKT5UllNpqZEjBOSlTgyqYeTnzr03w&oe=6A79C0A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr7nIwoVqOYQ7kNvwHrvAk0&_nc_oc=AdoD-MA-I5AADRSR4_r-oTQ2LDMv5P0AcFdpihYqEuwliqTv_zoC81feLDJ2BonJsNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAvffWT0TQZCXDOoRT7HiDLPFgbMUReO48o58jDHZ7ew&oe=6A79D42C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMlc57TOtf8Q7kNvwFqkj61&_nc_oc=AdrEc_6-sqJUiJwkPiq9hUNJQF0JTjzrHMUXztNg2TSboN7bjij0--YPFHf07BCoyUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4X02AIM5XQqsUjuoL7m4VvWgFs_YQrPzWefV4tDt_jw&oe=6A79E3A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2pnzVfMYT4Q7kNvwGgHrd6&_nc_oc=Adp2kl__8W4-imkfhh0ZlcMjQMKXBsa1pXsUWDzY6CnINXX_ackO0LTcp2mJMT9Ez8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHFPIlpRE7e62HTBSEegyGimYEBG5FAaraoRlBzflKmw&oe=6A79DC9D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv7WDeTBjtUQ7kNvwEommwQ&_nc_oc=Adp3lhUvHexQ6QvBhVV_d8q__pih49LDlKOel0WhaEEUqzwBM9y8Gs5NlhUnON5WQAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc0M0MWOc40bcTgCRxsYezsgtYx3HizVmAaYAoXrtKtA&oe=6A79E1D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_A4aBNoGoYQ7kNvwHtmTQy&_nc_oc=Adq1bdiMOr0HS0v1MnUINkgVsZif36f6wiAKrkvyrC95OndZRadh4cBd3UK454OEcjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXN2e99Cxy5aYqaRBzOcVZmc8n5of6u13Wiuq9k91oLQ&oe=6A82FBA6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqrLFtKQ8xoQ7kNvwGcCkR2&_nc_oc=Adp9fEZfkDv6AjIVJvB4cUKwpJp91zC6IbEnqjpzs5gc_utd9XDuQkdYZF7PhyLeByU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW38_UmOlZuEMqTZXr1-Jb7gZhwC006weWgg4bvBtp2Q&oe=6A82FB20"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cBldjxmV_4Q7kNvwEwT2wG&_nc_oc=AdrX-T4nIEUrzhzMIhWf-JXjZ5ySAPQa29qq4LlRlkzTNgEMGgBoT-yFKcpR_1r4ZD8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXyDzocKqvgYQQyNhBDaIyoVxsMwCBs1bF7IrI1gHE-Q&oe=6A830EAC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAW57u8XOzIQ7kNvwElq8K7&_nc_oc=Adoq2YUeK25WYAvf0_huPO-qnBWcQQO0VggaI4F2rMrXawEZ9nDynxlw_0A3SOnmWNQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOYodcn_T-tSWaE1hTvrRfTL5EXj_0x-ExWX9zr5xkoQ&oe=6A82E5E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jWZZ-L3ZvgQ7kNvwHjqzV-&_nc_oc=Adr6_LDWwV8if8Uo4fiRekQDKf9KUiL-uCv9F4U2xl-gO7O64GGVTswGco_P4tmH4Gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlV36f8cX_KP8r2htxcRed9eSzfxozzP_l77AjQRKPMw&oe=6A83171D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2MnTWp_SpEQ7kNvwEYUxpi&_nc_oc=AdodQ6vtjxhTMZzGPU7GYmODcUFzAj-OBYSk7OxfK591p7Ktvf_WDY6GJfNvfdOxxWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErPQotfplVpFwVrYKKn-iOykl_8EQ2qDQMczHXIgUbdg&oe=6A82E414"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
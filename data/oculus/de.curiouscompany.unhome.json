318386545635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA1PgR_JaKwQ7kNvwEhTrws&_nc_oc=Ado5ONJc1HSz4Gg4ETeiCmMfz_D56J7Hbbtg0r4jDc1YsYAl7U2OPLy6Tn8rov3rqAM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwRlfj096XUPi8TFPpBxMfsguiJqJlJrQUcxAd0xyK8g&oe=6A859EA6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7fyLIMde-YQ7kNvwF3Ts9I&_nc_oc=AdpEIxW8CegQxetA37cBpaHWXlKXF6Ht4YPpo6MaH9IWwO56sMh_2MtQFJQbSheWiLY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyoyWtAbLGbNwTrXG3RmGYdiYyUSJN3n0Dcg53o2QLqQ&oe=6A859E20"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cBldjxmV_4Q7kNvwF859Gt&_nc_oc=Adr5FEK5k8NX5n_2LIdtpBEXXD7ZgavVpzhRMguazXOyUVKqvKEdL0RoQNbo5s3PM8U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMgNH7-dmPAca9HqCh2rEMNtTliH2-2GAB_SFtoEmzgg&oe=6A85796C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCNRlkvHeFUQ7kNvwGRppdm&_nc_oc=AdpddLisIWiserlFGmqf3tnRmxiiUUqibEB3tIMv_6fidb9je2D-eW4H9QXVC0Bg8hw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJQozEdIfb1G8bT_lcFmdxm1WI2zcYaMg2ub1wZ04-nw&oe=6A8588E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c2DgIwjHLsQ7kNvwFwATph&_nc_oc=AdoX9TVrDLM6EgWK-2yJOFqeKX7ExZ93R2A4U1VlCKNUWcXXPVkB166U8_lG_el-KUY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqCEgQ-CEjkn0c1yYgNikQ7gy3U3kuegBClKFi4NOBEg&oe=6A8581DD"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2MnTWp_SpEQ7kNvwH2aKzf&_nc_oc=Ado-kK-lmPTBpW2FMPgB93dJbu439Gl-LLroB0BXMPOZ5VfOVmWuC70LLb3k8WggYeg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnDMeIG38VuTL47KntH9GU_3eP5gNkfqqn72O-dHSQMA&oe=6A858714"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc
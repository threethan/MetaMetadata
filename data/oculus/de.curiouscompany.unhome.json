45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZLWfGyPrDIQ7kNvwEoGLn2&_nc_oc=AdqfPIoFDepa294mzTSCUVJWUc60G47K74C-HaGiPz7RRCuhYk8WEJlJHSizqO7PEgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOXc_5q0_sGFsH-r5HxoiTvDuQs_eUNsH5e6f47SA8xg&oe=6AB15866"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSbGEbiBqeQQ7kNvwF-r1La&_nc_oc=Adrq6gfhnI8tDkriH-rAr6qOqNNL7qFWNa6vobxueqssJm9HRMss8SP5OjrFfDMRcTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu6ijdKctEdkN04FkMrJ7HG1PGrto_UhYXYaxuUDusfw&oe=6AB157E0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-mF0PDOBAIQ7kNvwEIg4-I&_nc_oc=Adp9trrwvLwobRrGC_pgOb_2Z1FMyEjpC7_TaVj8AtiSxw3NY9yR6zCrHrqQVzsQ0CY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2V_zumaaNK-qfDmIlN4YfeOzOGvxBhi8-knk6Rz7nKA&oe=6AB1332C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsBdPg_B6ksQ7kNvwFAVS0f&_nc_oc=AdqdSAiaRspEK8kuBXy9lFcTg--dMKcF8r5fqVfXPzHu-d-HfwsZ6jE0lwgbd188KjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIxOnU4tKM_zH3el22WFnanxmJuQWTy0UtBaMZogbdaw&oe=6AB142A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lZumWMwqC0Q7kNvwH-GlSF&_nc_oc=Adp4DM97x-jyWmD97UdAzQLDlZ0vGLdZj-pij0kkFNKnS3A788NSB3h0GU7XWjOV35c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5-tKDePa4T_roE68DxZNXjUpLS7HUUYW5B-IDdyKpOA&oe=6AB13B9D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd3PdM6zF-wQ7kNvwGw5Hcb&_nc_oc=Adq-iM4m7YS2cQMMEi9GdCmXg6wp08smOsq3_3qCXnzl4huFSdEdMMuB_TP9IYk0VQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIopfatZg1RXfwUTwMAPFvvwHt0ah7mC2Z5FF0eMME9NQ&oe=6AB140D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDQ2Qan9P_YQ7kNvwFFEYjs&_nc_oc=AdqF7x5SEW2MzKayvYQxpNZU16UJlc6TpTJ16mhItDRmrqTuz3mDEoLLgWo1PZHxbgM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsQvLuK3X2PEGYOfkv2sMhFw8dwlfnvmqlFZRS6glxcQ&oe=6AD39F66"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aXFOMgDx84Q7kNvwFyTWHw&_nc_oc=AdqqHRILMCO8X8sA9AqxRwnb1AqV4V0IC9Rq3Rxqr9UCFrvRwq5vFfgdb-Xg0nlm0aU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeIgqmLo6CVFbEbphN4wQStrFmXnNAjvclWKncpS6X-A&oe=6AD39EE0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysimnfAzDwUQ7kNvwHm49iy&_nc_oc=AdoOhf96eg7FikkT7lMXMV1QvUpY0GwclnH4-CYzZd0x32_stzbDzUHgyPWgJYXrtss&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO3C5fNJ0VVSgkL8rNJMwgD8V7sFypJ_se8CNLPPUtCw&oe=6AD3B26C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXK1tqhS5AIQ7kNvwEFjGYu&_nc_oc=Adp9ekiQUTDpcHdAHUVSW6-18DnIKYnTgRqvjE3mQu1Nvq9lc9mBRWTsMJVIz1TLn-Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoCrOVLH00Hu4xGvZky33xOX1OJl8Fv3bnUoaZlppsIg&oe=6AD389A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_YF27XH0Z0Q7kNvwF9PuBV&_nc_oc=Adq4xJXwc6tJCG9Bzy6BJq9kE7bJDXl2QGMvdixxemCv_W4QSak2G3ps42jNsRgyOI8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs1nbAdB8wd4Ewld_nlgwy6-gpVNPyiN1sn25ltqC80g&oe=6AD3BADD"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snoegZfj0XYQ7kNvwGVXsrP&_nc_oc=Adpf0OCqB_XRhEa-rJqQaZUiVRMPiiux_pKe_fNDw7ZW-XWwMCc_p5dFhpu3Eh75o8A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOJ8LtgarPZkRBQDQx1htMnQIe1fY270E_z8Jp98zFJw&oe=6AD387D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZaZ8wO3u-QQ7kNvwEWzcdA&_nc_oc=AdojsVUlf7GDy63f5fwCr9W3AHhqs3CQdvsjJBbPTvTgGFB_CODGyyQ8saKnl3joBZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdbXtbQX3kBdHrmSGrUdpd0_h9Mq_DDitmMq7gkIn0hQ&oe=6A9D59A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5hSrFsyRUoQ7kNvwG5ecsh&_nc_oc=Adp_1S8iBRualrr0ghTMNeTLXHpiRi3cATBOseHFrVQfEHIJnNk6S6QT0TKOSzL1-Fw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSTMiMQxc2TlEYZDaXRsRPyiEoR44dJuLOoPEenQdlpA&oe=6A9D5920"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG_V0Qm5T9YQ7kNvwFa_lu8&_nc_oc=AdpzP6eKvxOSOu0HIbkJR4H7DJoNVlic_h9-rHGdOZeKhuf5yd7v9RBL8-J0_n5vUHo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzm8UXWJJrqRV2T-fe9qQw54X6CLe8z69wYjNctXoLJw&oe=6A9D6CAC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4xgeP1NRIkQ7kNvwG3wE3r&_nc_oc=Adq5RD_0erEPlo0JLmNCa5jd6PD0drLIR9TAx9ZZVa2w6YsMwpAsY1PdUX_UssQecW4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId7sCWfaGvzIE9U-J20uYAbDut20CgPSlIXCsj1oDxXQ&oe=6A9D7C23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Osnfk7aUg6EQ7kNvwF_UJ6p&_nc_oc=AdpCW8OcwMdXVEKUNG0RQ9vUCmaOCgtPYkC6vxKMjWLFpMYyaxeoWI-AnHzYh8Rtw-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxGRQj3kmxVJUrt07Nmt58GN6aUZezOjOKlpNPQ70j1g&oe=6A9D751D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYGYUEMxJpQQ7kNvwHYYkUw&_nc_oc=AdodXGp5layF2SnrrkB93mmBwmWZ9Tf5MsTKAUkB9SpVSjl8rPyn7grBAR1-6rTVyfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-Xwjs9UiOYT7dPj1NOO0s3CuSRz5FJqW1ZDZxAjRUbw&oe=6A9D7A54"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
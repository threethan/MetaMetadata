318386545635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktGS8OTTnaAQ7kNvwEI9K7H&_nc_oc=AdpBpYwVC8qmjEY0JaL-OyLr-7F4LcNLdESlNN66IQ_dsIqhZ1_ZEHOHDCog-oytna8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFClkAVgKmMId1rqPiSgP6ErjKPU_SZ6hXH-7IFg5-spg&oe=6A8D87A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju8fDlIG8VwQ7kNvwFa8wBE&_nc_oc=AdoGz6UXzi39StIl13u5xHV486KqFdyvmNj2gEFQK6ef4Pqrlpo7NPPHGANl215clv4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY5HAoM-b8AYFAFgu96MnDSf-EGttH-3S6VjmrvYkmIg&oe=6A8D8720"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSTV4dh6LfEQ7kNvwEBHuRZ&_nc_oc=Adr_tKm5egt019_Bu5d8S6FvaLar9k0mcmaiebpB1-Q4uHaDXIjFQTm5UHNhEpyil-U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH08G5ckWoq5zdvunsDUl9L8RnNVZBj4JZPjVjMKg0gQ&oe=6A8D9AAC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvfEwits_HcQ7kNvwHs2T0U&_nc_oc=AdplR5_HcBjAJ82RqusRb5wyCqLo7L9ACQ6V-H0Ve8jVqJY2Be8sVR1H5mOOEFqi4To&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdybf_3s8jGZJtrerupx4jRpGWpjChEoJBY9kxUi2wNw&oe=6A8D71E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLGoN0AXIHUQ7kNvwFGaUCV&_nc_oc=AdpsL3SKzNeoh_rcOqcAUI4ZbaJmMMZEmHlqNHZkliC4FF6tTFQ46g94NTg2JD8B5ys&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjkHZYnKzoZILUwfad0B6m8RXzBT3AQi-R9Tt-Ii3iYA&oe=6A8D6ADD"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzPVt115LYAQ7kNvwHNulT7&_nc_oc=AdqxSTa0djp55azzKqRIsopwx5dSUT7vtaRjCuA2zCYjMNqnnjqZaF7_nuqujo6Vyfo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1C0GFx685dMuQ604RGOkTWGL0p7yww2aDEU8mSNek2w&oe=6A8D7014"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc
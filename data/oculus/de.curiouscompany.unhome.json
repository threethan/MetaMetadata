45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1zF-DHywYYQ7kNvwGbODT9&_nc_oc=Ado_6kK7pETrSFkoxEUHrPp930tOdRZivPdAXXx826dJ380XI_LIYUxZEMjMcxnP-oQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ-YdEsXOA4yl311dc7w3_4Ep10nGuZGYaLeePNW2bpA&oe=6AC7C1E6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0O4R0hFe8kQ7kNvwHlIDJN&_nc_oc=AdowQc9IqOUlpZ_PY2x1to1IFHQg6fkcMljecZJE174UevoZl4iucTmsLccAre-rie0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-a7KJLgGRkPpud4B1dCEJflbWv1m-_C9z590YqReH8A&oe=6AC7C160"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPpfrL0dfaMQ7kNvwFTQW8s&_nc_oc=AdoD91SQHqBaKZGcp1raaHo-M7NZfzhONxFt8fjOzJI7VYtc-jHgE1Jm_bIDdIAXzew&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNES7BEmCAcemdpzIisD0aJke1jXcIhr4IzW7W3qAkAkw&oe=6AC79CAC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StbCcJAJK5kQ7kNvwGEzJIs&_nc_oc=Adp3BE2uFiYUGT3dUxz5F8Z36YF3NPpPykeu3leWYo4ynVKhXrs2YPnXoWn8RwxV53I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGwyUouA7X5__HST-stP5vCTURmpCbWDG8Y6h_ROggkw&oe=6AC7AC23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q56-fynaBI4Q7kNvwG3449V&_nc_oc=AdoKr6sKOSs8HvmudUwUhWtsX3dAxVxT-2RbQbDRaqAjdBKfsqFGfuLOx6jJvjq5-Ek&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg9vFCsYJLPs5MhgwplUuTVkYbXRAgGXBlHiqgJWiEdA&oe=6AC7A51D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65r_GGPkR_IQ7kNvwH_yib5&_nc_oc=AdopB8gEKz1sAkIAQQEl-g0m5_5Je2_uPFDq4_Bt7DMZt3w86x_-ZgvJ9mieGPSA-b4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsGOZ4kGGNsNKbCufFHRuXuoO9xIMFK5v_TOGvgTCdSg&oe=6AC7AA54"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
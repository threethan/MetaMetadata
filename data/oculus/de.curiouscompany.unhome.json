18386545635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czLrrk9i-pgQ7kNvwHoJDEO&_nc_oc=AdqvbLuLooiN_WZdSlcqi3VprzqxGMPbIx8xMhOFSXb8IPWXXXDLNPPMIxRx2JocJQo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoD7A9sex8GfOk5om4LhDw9U5OBcjiZep5Eyc5R6N-Dw&oe=6AA93726"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haqDdHFeB7EQ7kNvwEO-MAM&_nc_oc=AdpQ7VPQ0hkzfR8wMVAZ2-r5hoJFbgbpKYNMOSi9iCcdgKXswBiR8xWr9GRYxc-wBvI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMmnd_ikEldEqJKSZKXAvl6AwgEseMSwyAKj7AOQt7Mw&oe=6AA936A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv8OnM5bI4EQ7kNvwFJXwHZ&_nc_oc=AdotChZM65EziKm7aMAEKfA80bZX6B5HOUAvh8U9exxdv_NtU6cKMbnq6q1vOkdJIVo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0Bq7lAXbGZuqsmxNBeN_gTfSEL1ZNkZiBxZCZ8Zby5w&oe=6AA94A2C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phymWaeK3PwQ7kNvwGMvCaN&_nc_oc=AdpYoukCvuDSL-hMz0XlN7H5Fd6goeBa7lFIeqGVBYdJM-m6-1cukhk1JQqIdF100BM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoCTkttzZD67ztr0ho5WgvEAcrhLhlgkfAupWjxYm6Uw&oe=6AA959A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHq9Ack_dQEQ7kNvwEGu9sR&_nc_oc=AdpBry9ryhuUwbGLN0ip7QUFUabdbMmSLus7hebgWcqyoTm9SJy43V_FyFx4_evfXYY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx6ClIIyeXOo_UZeEj7NwGaUNPT0Fq4OikJ-Agz6Wagg&oe=6AA9529D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hI11mSHWe8Q7kNvwEN5Xs0&_nc_oc=AdqU8upu9GH6vFYUADVqsYiedanei7fGqTwce6bCEv3saLV5ksJbgsGaWw2yl8KoWXE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItSNOuPNLW_vCrazReJDF6mwjUA2n9tUg_LCNs-VaIOw&oe=6AA957D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjD2v3rxLawQ7kNvwELd2PI&_nc_oc=AdqjNsx41oxcj_e4vD2kTFiSnB4yHuAJBYtcTEQnYjiuHTCGEVq2obIraiPql3-LlIA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmwaAsuWD-QIPHQVHe1NSG93__NJca_LgIHclbh_lgWQ&oe=6ACFAAE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FihFLPd-F4Q7kNvwEWAfJQ&_nc_oc=Adoz4Hy1Eh9Et8C9zBXelReHaqzqU8WunsJUAJ76BABcwn78blr5q_e8UZF_FaxJ83Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNmRbmumyzXf5KYamnr-HAixjnkfZFEnl1UWWPjlHxnQ&oe=6ACFAA60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QamzhqGe5nsQ7kNvwHLnG-m&_nc_oc=Adp6BipcEmRjDkukQjhIoFXLFoUXZqzzNcO1fdA4V0olEls_LTHmR1BQwbiykaGNkTA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO34V3sA6DrjHAdl5z-W0KpYHqeSMo-KJODJuMMOAvcvw&oe=6ACF85AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WC86cUsjEMQ7kNvwFK6jV0&_nc_oc=Ado4qYP8a0ceXWPqIjunyCrxUhebbZi4YPY2P3I1VnYf4bU9dHMWj-NyX6Y3dnwWoz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQCUsg8fTubNTNqp00QgFJrLBetBY6pW0aQAdnBilPWA&oe=6ACF9523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP1oL8VHKx4Q7kNvwFSjHcC&_nc_oc=AdqS-pEb8a5MWE81rzkskq-sUBxYYvi0LkBwlakF1irAnhLnlpGzusLCIXHIK_Bg0HM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLgYioLifPcBIhoKV8v7FbZrEEoYkqHMq09BEgJt9YjQ&oe=6ACF8E1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgG9Mjgmxd8Q7kNvwFjoXfn&_nc_oc=AdozPmJBHpjQL_bpwemB_4-RUQtUU1QEXURHc2GfOD65wIDc4G2LkdStPkFg4m7_1Ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMA_cpK3XsmDmA7nHlddfkRjt22eCDpIzuzHz0MvK4_Q&oe=6ACF9354"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktGS8OTTnaAQ7kNvwGalOUe&_nc_oc=AdpVQr6AWoq8g9mlqWY-t9yTsuoVJK-U8RIlZlf1v_o85ciGHbvpCNUylX5ibEUy3-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGlTIJYGrw3OBX82UWT7XwaelzbuElYXaBCHi2ofPI3Q&oe=6A8C3626"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju8fDlIG8VwQ7kNvwFw6Fil&_nc_oc=AdplejZRjUheuMgumUcgFbeDzIc60lgYroEy7dYZpxeG1kvbHBQWnOPO3-GqoZvTB-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5mX91qOO1jB8aIGYs1gekDge3gkxfaqS5zAqxqa4vhw&oe=6A8C35A0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSTV4dh6LfEQ7kNvwHz0caH&_nc_oc=AdrcT8_PxWpcv3GyOSOIyh3OafLZNEkDD6hQhz5hgwUa8-zbtxuQDYognoeRj6rET7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw0ZHpYoWz0E2yqxoXQh2sYNaxO_7JupW8CbYz5Hc1kw&oe=6A8C10EC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvfEwits_HcQ7kNvwGzF_js&_nc_oc=AdoIj9KUjBZxfCj1iJ__HZS45gEtFm9ISRhTPAVEz3ifsK5_qBjr_bWWQ9pfHLFfqCo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoiTSTbN0zqt0hAZijU583zqNR30mSC3tERskc_LkFmw&oe=6A8C2063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZedcxPeNbsQ7kNvwHOqQX5&_nc_oc=AdoE9SUVkuDmPoS6P6Fa7I-PewNkgSDMiao3Qr02XcdU2VaI2ynK12hW4iGC9idRhV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHMan671rnnwStUY5eDL4VwZypQgcsU-oeeuupNWNrOw&oe=6A8C195D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzPVt115LYAQ7kNvwEvimTE&_nc_oc=AdoJs1yzj8fdAd1l_yT-xRHkfNWpZbjaUu440UEWJwIPwnjXCN5QAJhF63patU4rk_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR6eWc0PhGY6vwtGbEsWuNtlLMob_0heDozKTC6GbheQ&oe=6A8C1E94"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
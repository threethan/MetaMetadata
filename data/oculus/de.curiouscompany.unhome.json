45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoI82VuV9mIQ7kNvwGLjcBO&_nc_oc=AdptADSh7ma3Hc_czKqbO5k0M8kJpvBRKht8pZJnWe8C09hQZLivcOwJ6ySS9U7HSpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiokmI6Oi0b5O5T0u70NKOg8-vnOjOth2MQIxIg7wlUA&oe=6AF737E6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UpUUb1mcD8Q7kNvwHqrvAj&_nc_oc=AdrsIeiSgxxat02NZdmaiGZRzxYPB6a5hSYprBJV7nbbMYLc71OXQmD-qnJFCCKlw8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROMMT5DOS9jPlvd_0Xo91DrGOsULQ3ITFC2biHSr0eMg&oe=6AF73760"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOD3aQvwnuQQ7kNvwGwEc_g&_nc_oc=AdrAj1ytGcHHsUkSzaeVGG7gctra156zit1wpVE5ELEME_646Qj6MVDpUdbg0alU2o0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDV0eYqcV98nl6NN7lBnWpKX36XoCBJikCuG1Itf7bcw&oe=6AF712AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OJ16yde6aoQ7kNvwGxA_x0&_nc_oc=AdrfzWQZZQLesWNNX3vvp3zHDYFXFjcIiM1mibLpuaUjEo2rJ6HDJIRHnMHafUIbpO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpc-ayEhna_kRx8WyyQ1Z3WrTcu0oFn-GEFYOCFSxX9A&oe=6AF72223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2seqZp0FOVkQ7kNvwFwcw2J&_nc_oc=Ado2Yu6dVZu6btaB84ngHqxr09_5gXMhH56kOoT1anD5PX0kFQ3nhRrmVlSXZmrPqE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDNa1EcrAjx4sac1VBIE10f8IGTc0SN6p9pvHLWhxlrA&oe=6AF71B1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9OuUsjNMQUQ7kNvwEjrgh1&_nc_oc=AdoWhPosGe_1laBAkO3TK5cFL_I1echaKKQqzMi3Oe_pg30Uee3kUi4pvv2M731SK-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_0wvgE0pbPHGvTU0Mtyccnj_N23eC4dTI-1JH8_MG7g&oe=6AF72054"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
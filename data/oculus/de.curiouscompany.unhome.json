45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNsZdZiIxFIQ7kNvwEOzju2&_nc_oc=AdpIEp_ZgnCFK2gKA96jIvH6VFz9ABUUv2dGtcZ9lpXL6-h-X-SGXrs5AqzzgAzgPhc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaTjlBXbJ-HP3jzNhaeBM2AG8cLPNqgT6rJ9UKg02Www&oe=6AC67066"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGpTFK9NyZoQ7kNvwEaO9w3&_nc_oc=Adoltxvx0o3gqOZvQ4U8G6SvQiD7HR-DsfiQaZhkzTsftOOqFhpmQa5yfLmn3bqN1lU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwUhvlTzwnzPj_HYUES1X3yKoU4s79Z8bXNuqsinIKDA&oe=6AC66FE0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPpfrL0dfaMQ7kNvwEuAMsB&_nc_oc=AdpjWN7RrwlFz9Z1-qZ6jglAlC3gV_dz3sLFLnT2GJpPjKJGofmrOXBuiWeQQAzH4YM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0y7be7fnlf8fdykGeYbkZpnhHm_QaLPb7R-x4LIBb3g&oe=6AC64B2C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcIj84rvxhMQ7kNvwE6yjrr&_nc_oc=AdqTbChtjBqPZJ_MFGlq20hWV_TVLNIJql-n_Wmkn__5ZUd9a2-Mx2Wsir6UWFv-Df0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3gGEeATcOpXyWrYHCme0plH6hlWQ6IElk7xU3GRgMNQ&oe=6AC65AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q56-fynaBI4Q7kNvwH0A75A&_nc_oc=Adp_3_2SlXyTW2QpzwyQ77pNkmiE5-KGXfSrE7UgTzHKpRZbgr1x5ZGInYY7Xca0nf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmiLF4eTr9XnT1RKRMBzMynN6LOmuKwgU6dsedAdxSVw&oe=6AC6539D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65r_GGPkR_IQ7kNvwHMeT6q&_nc_oc=AdrUcG3sI1D4yKhlsfRX1Dc2Z4laeCevwUMZQU96bZyJXBxAoPNz39vsWuGV4mkoVgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPEDXJ1AluHOhBSs9ozlcZfi2Q0sQe3HHnfj0TxHCJ2A&oe=6AC658D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
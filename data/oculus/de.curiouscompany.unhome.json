45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9KV2Mi2nYkQ7kNvwFH0amN&_nc_oc=AdraCYAs5tBOn41G0eZ1_teJ67LXCKKQSlOM7_hnXhM77Wp68Zr6xtxMRo_MAATYdrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5x5iRC-lkhNe_AvxakQKadFovFY7kT9kzCyuf7a1Ghw&oe=6AF5E666"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgOinhj-L_UQ7kNvwF-bFCB&_nc_oc=AdqZt3PUTdP7X6TRNN9Fd3NkgMPOQiscg4fGNqXJGNhQ4ZNwL4fFO4A3uDna2GbnGAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIlVreF-StOmbtHtPCli22R7WK5UJERzgSgTWO7E8Q7w&oe=6AF5E5E0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOD3aQvwnuQQ7kNvwE7w9l6&_nc_oc=AdrIiBGMF7UKrAQSiUgm2hJWvnw7qHzW07EgnToxB1fxNBNsxBrjw3Za1a1yaa_PdZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLwJ40VV73qqx-u28_az9lusakjAxBSNL5FS9uhbIAzA&oe=6AF5C12C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmEpGKny490Q7kNvwFa9_Ip&_nc_oc=AdqetBlaC5ZboFUTNr4aVKhn-hornTDgnosGPRikr2h2mzndK0PsCVaZtj3cOBQ2rBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkCKyxzTxW3wP-lD5QMvlIN__RHNSFA2BcafY3jL10tw&oe=6AF5D0A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2seqZp0FOVkQ7kNvwFBcj9C&_nc_oc=AdpL6yLbffrKqYtpy5tex70nEbEPgVP40K3LR9gsAlBz3jos_hQqcJ3kY98hWHv4UhE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5dCpbE7IM8ojOMfm2cZqN4_yP6kwLjYT4irs8ReQ_cw&oe=6AF5C99D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9OuUsjNMQUQ7kNvwGE4tJ4&_nc_oc=AdoQiSI4BL1za8rU7L2zb_grz83VTfzudeYWuzRzHM2h12AUqDft-SzgsxIvPrK6SS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQUcT4i9g1wACE2kpwx4B84VG1xaL9d_DJywCC4Ast8g&oe=6AF5CED4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
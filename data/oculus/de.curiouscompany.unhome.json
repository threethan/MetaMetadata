45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1YmAP4fTYEQ7kNvwG5UJlo&_nc_oc=AdqsR_g6c2GTFkxREzmIvDK10hiDnLYCgteamI_KB8tvlocz5ZreOqAaSdiRto6KXPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ2TMnyTrSMBLtG0mcGIQas5khFmcThXY_jiEdN_GOjQ&oe=6A9AEEE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPRqQHYsbIcQ7kNvwGitbR7&_nc_oc=AdrTY25dM7u2B9CqtssIPVXZk7ycXzy1n8aoT5opSJtTmdNMYT8lehiltoONZihcoDQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqFJ-qlMH9rR_rj49249U4-c4ZmlEmdjKKNbte3bEHCg&oe=6A9AEE60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG_V0Qm5T9YQ7kNvwFqY5Xu&_nc_oc=AdrznoonoStEYC0qjuwVa2ydr770ndmX2lT-G--eaEQ0aCnUgOuHVHca5PM73KRab7w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIntjrVu8ysxvg23x1LH5nOQGk2fS-dfkRTnt2_rTNYOA&oe=6A9AC9AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFlJdPtagMcQ7kNvwG4mtbB&_nc_oc=AdrR07HsNUhn-tlYTzJ0r6PtrA6rR4jzc2nEaYo16SVlW2y31QfGqZQlGoQaKPYtlEg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIomRRCsIXmBzOAEFYA9ivqFCAl7umGvZ5ftxxcBCBDfw&oe=6A9AD923"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8BfF5sJNScQ7kNvwG9QLNb&_nc_oc=Adq_wYkfDEQc8l3B7efH3pWmt_4OwsF5A48S00rsAxBerKGWcqBOce4tGNB3zYKvdOE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBimsg78OA73kLL6uDsTvL6vTV93Fsr5bWMyPXfg98cA&oe=6A9AD21D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYGYUEMxJpQQ7kNvwHLslbf&_nc_oc=AdqhzSjhbFzXbvSp4tKCFM21awm1ejffMyqRwJpVefD-YUNAUY5bpWqCyBWIz-rSjGo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXYWRdC5aNXNlbeUIwBrnpNJB4Dyhk_D8GU1-2MjOrZA&oe=6A9AD754"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
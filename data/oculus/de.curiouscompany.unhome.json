45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQEmKKEmBFAQ7kNvwGZXERG&_nc_oc=AdoF5G2o_k92mBiChZsfnz1nPh5oAak4VVAZbmlM8TqFdeisiOw6hAXyUKnBDgRCXyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt-6BMzNfx2f9rDGrjc1R9myklQlcT5wfA_KlNz6B2RQ&oe=6AE09626"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9Am9XRtBpQQ7kNvwGpbF6t&_nc_oc=Adp8hI0oSRiZWR7jo_P0vWRkH1u3AmWT-XHxNleqkHV5dv58oCr4-HdRZ6WH_tVDl2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgaIhVnryf_zAnf7hH9NDYN22bZD6n7jYWlRi3IoceqA&oe=6AE0CDE0"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC62Lq88FwEQ7kNvwE5UsEi&_nc_oc=Adp9ALtNsrqPsvCt7myN6cbIXdJYDVFSX-8ZMm9yOu7xd1eMhtUHNJeFG18kjE8fbd8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMOG0iJZX9zAsNtwL9xWF72RY2orrhTG7uWsgZzuXJ4A&oe=6AE0A92C"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESrS3_JPraUQ7kNvwExiJVp&_nc_oc=Adp75W4xQnkCPT21Iv4LA6RrzPtU8UrWco7ca_z3jgxntr9f43qVxc2eKtFQ3IVQBrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG-bXog0oGYcPlCCeTeOYfVctZp-QGBbmQXj9hWNaf6A&oe=6AE0B8A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfYsa_fvQ1YQ7kNvwHfFOGu&_nc_oc=AdoUj_p1mrKKOIGryy_UW0jEwE5o1zwadBA0oSUzbhvjelSunViQ9QHvJzg1H9ecVqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8TyWJlFxr_Ih7CNihOsndy0u0bYhSc2o_nOKKjF9RWg&oe=6AE0B19D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4pWt2SMSHsQ7kNvwF2Wm_O&_nc_oc=AdoMjLE9aDIihwHZsOTlOSC0BLkQ20jzWIoVqmvs_qIXvHvlZj52g-r4iDqw-DgC_UI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxEhK7UriIDSJnM4v5kyNF57rTrW4hxAadDMfpZyJctw&oe=6AE0B6D4"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1YmAP4fTYEQ7kNvwHliPVw&_nc_oc=Adof_-9Av0y_pbhq0rUQIBbIYShOa9ZQCba70NnI3-OUWW8k18iZcj3rb3i2R283N8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhS0SvMBOsm0RIU6EXXVIwdIGRUuHsCAHJTlJiF2DtGw&oe=6A984BE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPRqQHYsbIcQ7kNvwGGYtBt&_nc_oc=AdpBtCEDbq9pQ3yEk_rPcfXz5fNCOluF_U0TYfu5GvaZSqPS-FiFTqVhPHIwe1-wy9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4K7ACQ2r0rUYcAbbAfzA33G5ve-TGAai_csZnHr3BDQ&oe=6A984B60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-DSdkBL05sQ7kNvwFZ5pXD&_nc_oc=Adr7RHlbPE4Kyxzq_M0VHW6SJ8PaNSH5hPovnbu8jcbFr53vfX3KFGjUCuSCFzG5QZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmE_H39c31ab9-Ync5HRGMlegLkCctaPYkFA3ikwvR3g&oe=6A985EEC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFlJdPtagMcQ7kNvwE6Z2db&_nc_oc=AdoxNeDfjb_tNoRmMg0k8bnXRqkOQwxPzeTXoQ2uVeojCT_HtcNeFwrpG2Wz8__uIEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5an1ZuVFXjiA6XUeql-tEv5X9Mg9YS8hHII-JQxGYWw&oe=6A983623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-Q4Bfe3cCwQ7kNvwGW8UpW&_nc_oc=AdrAVgaytOCqxx-1tfqzb_q6Ctyeq2A5yoXJQUhApGhoNsIcbspkHM3iiPeHdNmy21g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjVNnZ-KUrEFK-XUygI7Bfxu0Udapcq9hH-_94Ie7HuA&oe=6A98675D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izwSzrarhLUQ7kNvwGvu4_W&_nc_oc=AdpTbjJ4Hi9_fFrJCJ4lKWy55rJrvH6DOKL4RhPR5nb0rjFVtspFlyAtdz2txJKZ8dE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb0r0pWhi2rrTX2wyfktmA-2mCnxsrha_29UvehOk83A&oe=6A983454"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
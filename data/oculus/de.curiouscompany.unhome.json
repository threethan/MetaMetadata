45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoI82VuV9mIQ7kNvwHoIjoJ&_nc_oc=Adog7t05aLPGcpOZUdsYsyqOuYb43CqpRi8MBjz14h7joUZbpg5tvJVRQsgnDHpeaYg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ97zps_rPlWyoTcqNVUE5DbFB0kotqU8f1huO08-oyWQ&oe=6AF9DAE6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UpUUb1mcD8Q7kNvwHuZS8W&_nc_oc=AdqDhcMDlaHu2VP7vGRgc15KO-7YVo12rp7dlVODFGmmDwKCBre36jHQ4PNsComXVgo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL_6U85KlQSW1PLRqKeoXojCOSMuk1LDk9Xnz5QWHZAQ&oe=6AF9DA60"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U96mi_0B6TMQ7kNvwFF7AeK&_nc_oc=AdrcakN403OMVps2Js7ofnIeDZ8fkjx8IgRO2K-kHue8XwkHrV89f1ymhmjmbieXKlQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYwp0lrbOTE-dc89RyyMvtsewl4PKlEOgn6Q95SxpaOA&oe=6AF9B5AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OJ16yde6aoQ7kNvwFolugw&_nc_oc=AdqS1uhJUJkTsAKpMGKPPDVG0KS92zxfDYB2cOnjFv5ggudjv8oMUmcOOwnMc1brt88&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmCx4pdYewxoGDyB7jPFVbyIcm5kLE9NjB9oV-BpA1JQ&oe=6AF9C523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhpxcNyLs8YQ7kNvwGo2Zhu&_nc_oc=AdpscNkRCi0PJo3vHj0BTJYLXS6FLWRskKdpxMuUmUnrR5bJ5eJX_jl6YO6b1aJdXeI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0VZDq0ZbR5FtwZUF56Y5wuTf-CnTh_h1Srp7sBDKhQQ&oe=6AF9BE1D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHewuIKPhA0Q7kNvwGoB2gl&_nc_oc=AdrEEEXmOrAxpAlG08iVyLpj3IM2a7un2dEzkxPwG1mBGoT5n1SerzajchjSIK_zBhM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh87NxyAr6PbJFLpu7-jWA3j0vjgFGLAqozTUWog7wTA&oe=6AF9C354"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
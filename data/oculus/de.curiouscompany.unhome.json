45635574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQEmKKEmBFAQ7kNvwE5So7d&_nc_oc=AdovuHcKj4B5hodQLV6Wv9K3eB40r_esLv4046WfLrgLHOtOgA6Y7a-Q6Z4P6Pq1gGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM1BjqqMG-8NoQ5l9gQgPPts_IPrWQwXF_jGJOt0Kfig&oe=6ADF44A6"}, {"file_name": "Screenshot 3.png", "id": "1060831386196573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507817984_1060831389529906_1016791131303812603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9Am9XRtBpQQ7kNvwHdeKsr&_nc_oc=AdoYhMVLgqVlvsFDHYXn0ZU7qjvS1F9fxGANPgrZZEV5hO0HXVdKeyEbRZZ004tR9zM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6r7vK1S-1S4EuIi31Ek6dFbJHd2VtJL0I2OaLLAp3vQ&oe=6ADF4420"}, {"file_name": "Screenshot 4.png", "id": "1825881095056327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1825881098389660_2530756457114390955_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC62Lq88FwEQ7kNvwFIXv6t&_nc_oc=Ado21Hgfs1hlin2E9YTD-ODoSS6FKT3SFRXyyb7hNmJ0MylzkIGprguxJEMZdvyUskA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPczjZIwk6R5V1O3kBSXscDWLKayFkkauaMcpcV4zjlPg&oe=6ADF57AC"}, {"file_name": "Screenshot 5.png", "id": "3502138863262192", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_3502138869928858_7787816880001642657_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESrS3_JPraUQ7kNvwGIQIF6&_nc_oc=Adr53HuUpcyOEcwt-AcfQApO8AAV7oTq25aRibUrwLBubd4Kaa_l1n-IHrI-_gfkVlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZwAmVzNrxcLgBXtVRAUrc6yVeuBdC0vp3ok4e9e0opA&oe=6ADF6723"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image DE.png", "id": "787533563959714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822968_787533567293047_1530673455780050193_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PStKuUOmtg8Q7kNvwE2UCdZ&_nc_oc=AdrZsADRzkyCopQmL4UNUa6XfNxPTf9h0w9GLBkb-45PkoZvD5tHWfXj2rY-hPM5BGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMadkMqyjci6CPL6pt7XmLboM3U0rI5-1NazRYoysyMRQ&oe=6ADF601D"}, "display_name": "UNHOME", "keywords": ["Obdachlosigkeit", "SozialesBewusstsein", "InteraktiveErz\u00e4hlung", "SeriousGame", "Entscheidungsbasiert"], "long_description": "\u00dcberleben ist kein Leben \u2013 und es gibt keine Pause von der Stra\u00dfe. UNHOME l\u00e4sst dich in einer 20-min\u00fctigen VR-Experience das Leben obdachloser Menschen hautnah erleben. Vom ersten Fr\u00fchlingstag bis zur eisigen Winternacht erz\u00e4hlen vier Kapitel eine Geschichte voller Unsicherheiten, H\u00e4rten und kleiner Hoffnungen. \n\nKritische Entscheidungen \u2013 ob Gespr\u00e4che, Hilfe suchen oder Selbstverteidigung \u2013 pr\u00e4gen den Verlauf, \u00e4ndern aber nicht die strukturellen H\u00fcrden. \n\nEntwickelt mit der Obdachlosenhilfe GoBanyo, macht UNHOME Isolation, Machtlosigkeit und den Kampf ums \u00dcberleben sp\u00fcrbar \u2013 und weckt Empathie.", "short_description": "UNHOME l\u00e4sst dich das Leben auf der Stra\u00dfe erleben \u2013 realistisch, intensiv und ber\u00fchrend. Triff Entscheidungen, sp\u00fcre Isolation und verstehe die H\u00fcrden der R\u00fcckkehr ins b\u00fcrgerliche Leben."}, {"images": {"nodes": [{"file_name": "Cover Landscape EN.png", "id": "1963852451103283", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830021_1963852454436616_1351239702989579055_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4pWt2SMSHsQ7kNvwFiGJ3J&_nc_oc=Adr1yfMctVLvKlxFqZSiP3zUWQBVq9Q34Ti9xf3xtxh3SKZBxh8sfdK0Df-Z-sXxl0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3GnRc_y18PBLRuz8nMZJbOjXChJlwmI_jwYPlZbGoZQ&oe=6ADF6554"}, {"file_name": "Logo Transparent.png", "id": "1859213305026394", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_1859213308359727_5739948848953148902_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
13", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1430328555708946_8196409280864225682_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r-3fvV79pYQ7kNvwHAJ6Da&_nc_oc=AdrQqwjMMbisjzjtSpnGuo-653JEuu70CxX1TIK77Gs9hTZx6bIGnwzeRmHN2iTCu7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqBpg4h0NPzJN_OL-Dr_SVQCpqrY1Uz81k2UJbiIA_ZA&oe=6AFDD8D8"}, {"file_name": "01-mesa-praia-2560x1440.png", "id": "4484421311774319", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_4484421315107652_6969555186823909618_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IyEQ-Ud8-gQ7kNvwFGeydr&_nc_oc=Ado8Dronok_KR7x82gBUB5zt609p3bIG7ANck40Y7XsHBTWeNH5DZQbqfI7Z9DcQXqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0b2MU5Xw8H70Sx2ebHMvBAwuyyMET8hDcLohPzb9o2A&oe=6AFDB883"}, {"file_name": "02-parceiro-praia-2560x1440.png", "id": "1064016359720804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1064016363054137_5851058928877445161_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe313n1zWqsQ7kNvwHj_4Kp&_nc_oc=Adox-R2ep6pA8VTelTOOVk8ovRNkMS3XxGWKVx1Yb4pf7a-EdOVQ9-DoYG7IfC33xz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4HEs7NHOlz-QzY9QqrbqMg4uzu_Yv969cjHKe8AcHKw&oe=6AFDD694"}, {"file_name": "05-jogo-adversarios-2560x1440.png", "id": "1437579681624931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673645340_1437579684958264_2008715721653283032_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtqV1djPg6YQ7kNvwGutqhd&_nc_oc=Adrv5749PBblDgZ-w8BNPbD42iVRQg40Ki7mPyXtVMvCLyI7ed7MyzxodWSJoSrBNMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLMbTlgb4o-Q3GXLO5MVuYzpVW3GMOlGnaTi8mVb-92w&oe=6AFDC1D5"}, {"file_name": "04-consulta-lixo-2560x1440.png", "id": "1068970736060859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_1068970739394192_3950516609133741563_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tbe0WN9GwrkQ7kNvwEBb-16&_nc_oc=AdrOZsnt9ZSl15frJPf14yXtgzgKlBxIdEtqygu6veK0r8AX7k3OSLP6gD2GAQXCgCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhAoRlr_m9QCa52BA2S-LLtKjzeIGX__nWELXB4sneUA&oe=6AFDD9F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Buraco VR", "keywords": ["buraco", "canasta", "cards", "multiplayer", "strategy"], "long_description": "Pull up a chair for Brazilian Buraco. At a table for four players, build card sequences, complete canastas and score points with your partner.\n\nPractice with bots or join an online table with optional voice chat. Matches follow the Buraco Aberto rules explained in the game: two partnerships, reserve hands, canastas and a target score of 3,000 points.\n\nPlay in mixed reality with your real surroundings visible, or choose one of six virtual settings: Space, Beach, Shopping Mall, Office, Mansion and Classic Dark.\n\nOrganize your hand, inspect the discard pile before picking it up and browse the melds of both teams. Spoken prompts help you follow the action. Adjust the table height, scoreboard size, background music and game sound volumes.\n\nDesigned for seated play. An internet connection is required. Voice chat is optional and uses your microphone only after you grant permission and enable table voice.\n\nThe game interface, rules and spoken prompts are in Brazilian Portuguese.\n\nDeveloped by Daniel Lima da Silva.", "short_description": "Play Brazilian Buraco with bots or online. Build canastas in mixed reality or six virtual settings. Game interface and spoken prompts are in Brazilian Portuguese."}, {"images": {"nodes": []}, "id": "1674948530867608", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Buraco VR", "keywords": ["buraco", "canastra", "cartas", "duplas", "brasileiro"], "long_description": "Puxe uma cadeira para uma partida de Buraco brasileiro. Em uma mesa para quatro jogadores, forme sequ\u00eancias, conquiste canastras e some pontos com sua dupla.\n\nPratique com bots ou entre em uma mesa online, com conversa por voz opcional. A partida segue as regras de Buraco Aberto apresentadas dentro do jogo, com duas duplas, mortos, canastras e placar at\u00e9 3.000 pontos.\n\nEscolha jogar em realidade mista, vendo seu ambiente real, ou entre em um dos seis cen\u00e1rios virtuais: Espacial, Praia, Shopping, Escrit\u00f3rio, Mans\u00e3o e Escuro cl\u00e1ssico.\n\nOrganize sua m\u00e3o, confira as cartas do lixo antes de comprar e consulte os jogos de ambas as equipes. Avisos falados em portugu\u00eas ajudam a acompanhar as a\u00e7\u00f5es. Ajuste a altura da mesa, o tamanho do placar e os volumes da m\u00fasica e dos sons do jogo.\n\nO jogo foi pensado para jogar sentado. \u00c9 necess\u00e1ria conex\u00e3o \u00e0 internet. O microfone \u00e9 opcional e s\u00f3 \u00e9 ativado quando voc\u00ea permite e liga a voz da mesa.\n\nDesenvolvido por Daniel Lima da Silva.", "short_description": "Jogue Buraco brasileiro com bots ou online. Forme canastras em realidade mista ou em seis ambientes virtuais."}]}, "developer_name": null, "developer_privacy_policy_url": "https://buracovr.codex.app.br/privacidade/", "developer_terms_of_service_url": null, "publisher_name": "Daniel Lima da Silva", "support_website_url": "https://buracovr.codex.app.br/suporte/", "website_url": "https://buracovr.codex.app.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
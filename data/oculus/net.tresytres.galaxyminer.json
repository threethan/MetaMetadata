n.com&_nc_ss=7f20f&oh=00_Af4B6xQBcSgq87ADom8tAu6ULIrv41c51onMYMGvHN7UNw&oe=69FE06BC"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOha6-uvgVIQ7kNvwE4Lqq4&_nc_oc=AdqP9XM7mbMlE5fPZadrYyxs7aL6GiFw007V-K_pqkupHD87VuKYa_XRqKaw6ES2cVI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4le9MzCwdD7hOESqLTRKqqWUYFKOr1qs9soppCZoSmgQ&oe=69FE05A5"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVoYoGnwXHAQ7kNvwER69u5&_nc_oc=AdrQAnnojpDaA6o72Xq_uU-QRNYRzMeGB0MVKoUVHi7cpY7ieZADD27LHOctmFS7dW0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hh5RVRywn01AUpJFrGoeEK8WLK3T-iGIn0js7awMsZQ&oe=69FDF173"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2tHK4d5TuAQ7kNvwFd54rd&_nc_oc=AdqCoaZdBD2gBGFSC4riVPeE0RhVvHTISEx3qAhTArbS96KnBD8Ofv0a03GVOeSYnzg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63wgoBri4nnuKwbfuidn0b53WFM-aZEYDWyEZIVJ3VeA&oe=69FDD363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYbE1mFGKTUQ7kNvwGXkbpg&_nc_oc=Adoj6c1Xi1_myyAJe3A7dM8Qe4gWp_jVjgaJGa_eYiDWqCXIsOgH1ToEuIBF4WoHSf4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fnrlqF_IFU4mwwqcCIhQ_zvU6bIB3hFZfO-dwzlPISw&oe=69FDEF1B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-2
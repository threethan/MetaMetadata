n.com&_nc_ss=7f20f&oh=00_Af2euPsnAHgfW0eYNsCLICtUB_H9Jjc-fbGojnjm2RfLjw&oe=69F3427C"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZapyM4PoroQ7kNvwHPixmE&_nc_oc=Adr62duFLZhw9ksRi5RGezBT2srIth712PTvQzPxT3cxFH9ZuxrATmO0-p3Ehoamezo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cEg5t9dmtPpS3uwTQKRgAvd4EPqTkULhYhKpUgeOxGg&oe=69F34165"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOFSDIsf-o8Q7kNvwETqMWZ&_nc_oc=AdoOKf6rnz9UHw4RbassfC2N-BTuwawyGGoz7oU9GRCrbOo8yMnfW4k81FU1YJjHL50&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07XMcMUsJ_cb7d1bD4eG8LaCdn7Fn5exfTizp5bWF94w&oe=69F36573"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHfe-EVhELMQ7kNvwGvg03n&_nc_oc=Ado78tQObbsP9Bcko8gxfYnsrofMG5QaCT9_3TlKAQ-b094CfXE7qXubnh3n1-ebrk0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LG6xMU-d8s-UCapk41SHaQe4ivDTXXiIYvmGE5F3IOA&oe=69F34763"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQeKqrdZq_kQ7kNvwHx2MxN&_nc_oc=AdqaHm8iF32--MilaCDUM3Gnfq1_c3Eo_PTeEKsPo3ah3jFwnGVs6J4zyCvGm0Nmz30&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oqcmBW0RpvzNW6PL0a9_eEucblG43k5eKckbEU3u3Zg&oe=69F3631B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-2
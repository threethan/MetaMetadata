n.com&_nc_ss=7f20f&oh=00_Af-1uUnQqVCAH3XwM_I_36EolwGZc-X6c0ZJswbrolaR5A&oe=6A4537BC"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdxlS544L2cQ7kNvwEdyyLm&_nc_oc=AdpMH27Chv6l7Ws0brN2e-PUEQN7QgV4g9c36faJ4T9OTGNhZxLdpZ12_CTGpBSc6pk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ggr3s0VkN2JxgFHcXKk5qR6Thl6X7_TUlYXZFbgdEfA&oe=6A4536A5"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asu3UNNUzrIQ7kNvwFXphci&_nc_oc=Ado2BluNFonN4y2kgfhALKEfyAwjSJaLC4uNwujE0DuvUHEg0WxoulFRB-d9DD0Xv-E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nyKj-4ICdjKJO3FGBExdcqwhdxe7JDBS1yHLYz9Q3Og&oe=6A452273"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlhsdTznElgQ7kNvwEJa_QX&_nc_oc=AdohsfkUyWXTkZ1GOzSxBtach6OMQMO42eIsQ90kXe9Pn42KVp4B-ZlwgSCpLOnp-xU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82v0IE0AdrQrQcSjltaOK3hO8Axh-VTCghfUArQ5-VXQ&oe=6A450463"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbMccrrcOgcQ7kNvwEkJT6s&_nc_oc=AdoebZt2T6uxO5JxJsxnGIPJ9PRsWm63_ZWOCPmuWmvFv4o86JVhjiYtDc1dskOYPtE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L_S-aLNO1VTlYvMXTxaRXDUZEU8qdj5nGHRvv3CV1hg&oe=6A45201B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-2
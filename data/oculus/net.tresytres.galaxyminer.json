n.com&_nc_ss=7f20f&oh=00_Af7CryQp-oMBmM7JIx7FuLlPt-L6wKB2oAyio1XeRPButw&oe=6A1B07BC"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmBTk7pZg8UQ7kNvwFMZcNJ&_nc_oc=AdqqD9XTpqz0DQvo9FIxdj1f_ZpWw5CHNH6SxA4QVSYpNgZYAd2nVbIvz8WCkQwPhQI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68RNLL_xrFOmJ499MrvU5J9CfOsLSf8IUF5S-I9X4Ueg&oe=6A1B06A5"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmCu9kQ3dSQQ7kNvwGEaSIM&_nc_oc=AdqXYowtWW_1sVwlbF2SWGfiou-eNQiHXDmAM594fed15mI4KRt89VM5i83j2y338XQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af535kcjrOcoPWfImoRkLjT083rX9l392OT89QRqmrpMpg&oe=6A1AF273"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANaZ5F_02aQQ7kNvwE093y4&_nc_oc=Adol9rj1-uracDXNDAjxWIevs5gaLL3kv0zvWk3k3yRvL9w6bfHG5TnbJEqgOSbG_DQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40gBX44uSXZ09vZoYzG_tbWweJ8rrxsEm3zpzxpvrVpA&oe=6A1B0CA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_mTB9R5T-kQ7kNvwHT34yJ&_nc_oc=AdrMyjijOcGpdbxpmBtsv4Rga8CaaP9RzdtrXZMMsVPbPo4pAYm1j7HeON4EHn9H4ns&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rrKfEjxR0-YmiDhvQyjhzKCzziFG66RcFy8KUK-Tm4A&oe=6A1AF01B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-2
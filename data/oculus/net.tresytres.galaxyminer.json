6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI52JKa8TpdrgyZ2sD_coiquND6K8XfACQaZUtzqjMYrw&oe=6AA969BC"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4vl21U9NY8Q7kNvwG2XNCT&_nc_oc=Adr0iCvEMTVRr7FvJ6ieMXrk_id1maqYYfJ4djqJ64BiDSanw7PH9PeAkISBeKg4Fbk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1BkOn2myd3u_ZCOBb4m0eoyFLh9Sbi20nDdoUkE0dHg&oe=6AA968A5"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BymGYVf5eMYQ7kNvwHYjPf5&_nc_oc=Adp9kIwJVuJlSxGu7avRipZviO7HeJGqEjK2FcsAjKd2ZGG7QduCy0YZIYRzeYjj848&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIim7cnVL3Vzu32hJKyEvhKDRkEQh2SEGdQ0uXtBH8e8g&oe=6AA95473"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2oRA5h6ZssQ7kNvwH7JBfZ&_nc_oc=AdpRq4LVTNr6oavAYRnqYkivQ93BZ35ara1HimSx4jupgcU0teQS-LjGgCshi9_ms4w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkEy4vPwOD6qZc8vHR4Nzpqnhb5NfTlutQk3XOOYv-SQ&oe=6AA93663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKtv4LRYKAQQ7kNvwEyderd&_nc_oc=AdpMx9x6JSXrV4ltbHVNYnWkG3gjXQJ6d8iHj5r7dwvkietXlAH99tx_biY1X-ufkCg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcq6Fd0pG5wrOBfSXLsLvngTU6o7Z748NlbPJ9BWBaAQ&oe=6AA9521B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn
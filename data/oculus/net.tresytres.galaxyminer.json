n.com&_nc_ss=7f20f&oh=00_AQNF5s4WgA3EMf-FkKupStjvm06nwcoIl90faOJD3O5PjA&oe=6AE36BBC"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCO2H7gPpGkQ7kNvwE2J95f&_nc_oc=AdpY6E2am91vL3MY9pwdK19TyktrTOPUjXRAgMjLVUcx5lcMw_2V2AbB_8PE1nN52iA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPQPlEE77vLQkEE70NKbt_8ytbBnBFa41AsqaDeaEuTQ&oe=6AE36AA5"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSureBp6k9oQ7kNvwEGyXlE&_nc_oc=AdqQg_LfkyEVMo23KW3JWCYyu9_mOqBBkyxFRDBAycRXeQhYXestzuDfqAk9IwECYV0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvG93Jn_3LYRWxb6KiBivpdm0k6_HWyV0W8ozumPleLA&oe=6AE35673"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSlqmdb1PiEQ7kNvwE36Q-6&_nc_oc=AdrGbpzNOubloRJoCEaqYOoQPT6VCxyulBrxQKlxQdfFHQ-pZFJZeE3m0NfLEmrhITE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWdk1nQLYAyPV2XWk5ztfL_AR9AZSPp8VG-_D_q8iyYw&oe=6AE33863"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uflIsERtAjYQ7kNvwFzEcZU&_nc_oc=AdpmMmKaormOWQU6wG7MP9Va-Qsg39pM-yLYiwXbsXhYQMCVXVmkYnH2PXgJS1LyoQY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTZRlj3M09iGB3Ltc_A7jsVttb8C9BPBavL0vuUvXKQA&oe=6AE3541B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-2
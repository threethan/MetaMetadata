png", "id": "1295791743945340", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnrNncQueJcQ7kNvwGU4UIg&_nc_oc=AdmvLnlX33-2gaW0DXHuV74qILnXdtemNLBX7_4g4EQNlFttJRAHSZO3HI6fb7KDW5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsyf-MWFRw8bRTxCgbANzo5Akh5cE6Sifj9rj7g328H3w&oe=699849E5"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQsZLMWvzxEQ7kNvwHUtVej&_nc_oc=AdniE2kSoTEJPU_ofvHfrcjWPsmabGwfy0VlX0fP_cF4VyARu92R__ClbO8Ku47GoMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfunLSUFJcByImrGO6jH7W32uRcom0YfwKMcV1MnecEyVQ&oe=69986DF3"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPhpY282lxcQ7kNvwEgopDW&_nc_oc=AdmGq7W0yTKnPCrC1PqCNgjwDTKX0PErNmBGi9ou5N_W-VfEFf5tEqstIoHW8OKxbuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftBA4TgMKSPDIriZjBNItrgTSRr6BtsIPreQdlwdbEBIQ&oe=69984FE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7wT686E4q8Q7kNvwFR_-No&_nc_oc=AdmN012mVlDSwlmVY1FE772S9c-pFoumhivl5hkSgbu44wSn1vfqwkcxj5wsQBa-WL0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvv97_DcyWjKuBaQk8Icxa3JJw4zbE4h3O7CdPNRv0ZBg&oe=69986B9B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533842_1638881456407422_1165805238263742464_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL1I4hPJMVkQ7kNvwFwaZsM&_nc_oc=AdkbAXuJ8zgddMxyqi9V
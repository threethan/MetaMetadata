n.com&_nc_ss=7f20f&oh=00_Af-0Q-3FXEtBSBEd9RDf9ng46879P6hl4BWUacJ-H3ghJQ&oe=6A24423C"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksIFISuim1UQ7kNvwF0UXgM&_nc_oc=AdpSY__ipgdKeL7A-RedNfhrhdJZBpa5Tm5YaYmtFJeiRTS9kiECWyWthF2O2Ld_zMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zbkGEBvmeg5-tD5bvHF7UlHObAOiBb7TrYDRa6sCt0w&oe=6A244125"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJZPQCos9EMQ7kNvwHWwifO&_nc_oc=AdpqsneXOL2iLg3FP7fQdPiy8cFAac4HEj5POjqRaFhC3mqRfdV-8edLM_QcIku1Ue0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tiLiwsiAi_2JiQZPh93euY6qn0eVI9P2PjW9Hcf3DIg&oe=6A242CF3"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhCwNhdWk4QQ7kNvwErc-0m&_nc_oc=AdrBSma-1FpfRxKj4TeQJ_9mNHJAWwToPyQiq4pBiKSxOD8CsfybxOgp84gz2KH81MA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NQHn39FvVEdw1MRz3GuRqORqnwr6ALa1T700k7r5zog&oe=6A244723"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlincD3H9IQQ7kNvwGbtzJD&_nc_oc=AdpportLDswqe5vR9RrDrANQz0aMHP0xatrrco8fdbUWyRPz0e1FHeSD9hnAdmJ9PSs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FEntGhh7VAlubj6oQFQTV9SrKPwkKqMPqQRg_so7gXw&oe=6A242A9B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-2
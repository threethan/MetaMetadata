n.com&_nc_ss=7f20f&oh=00_AQTAsWurkDOy3D8_QTDOgLzhKBdyLIVE4Kb6WKbSJD6pWQ&oe=6AECA63C"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPPxUvTJM2sQ7kNvwHUZ6hL&_nc_oc=AdpGOeepSv48H_20-I77nFa-8q23-ueTjHgsKOLAssaIcZ8z3XrMTsDqshIPeJZM4aE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4CZEYbFshK8Km24OdkDqA-HnIUjew8VxKcc0575BV7Q&oe=6AECA525"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbYl9B6D9W4Q7kNvwG38Yeo&_nc_oc=Adp3KZQZfwDC1GS6FOsNteg_K9-gDi2uLYN_De44a7CmE9N0A06stORj_2ZW4k6Yx7U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgDOLnQlUX7LIUPNV8l1BfUOLm-tYYVTiZhWk1U2oYrg&oe=6AEC90F3"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AllVxfJRXiUQ7kNvwFJxVQo&_nc_oc=AdpoMXpKqO_kOv2w9VcI_prKVUkE67P0X_7wIJ1Mj7VZHLaBXP2CLI37SbOXMD2cY-w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA04EXEQZdYVivmS9Ecl57AYV1wR4racBg_8vbyGz0EQ&oe=6AECAB23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFa7sj6y0T0Q7kNvwGvBtAj&_nc_oc=AdrvtJNQxFBgSdW3HdeFXmz1lEgDtr_Yh11LNz2KQNOoRFZyjk94w7IOs-52KqWOFng&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRebt_sqQW8NsdVPlIQYygmgddinn6UqH6ShduKo6ARsQ&oe=6AEC8E9B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-2
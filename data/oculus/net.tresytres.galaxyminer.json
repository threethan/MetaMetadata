n.com&_nc_ss=7f20f&oh=00_Af_y82reO7PB74PKVuGY3QxtOvxxIFXrNKdPZ7vId-4wgQ&oe=6A3D4EBC"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bxlovz0E_6EQ7kNvwFFRD-L&_nc_oc=Ado7MYEfzujbUBeUHjth2FTTJ_SJQ5-a1cs_cy6uL5RAhCo4v8lJ-rmRv7fxI-n7Sm0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cSfc110wn1-r7xI3hktdv50PuPL-i06MECFMpHFj6Hw&oe=6A3D4DA5"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QS4FDxSy5wQ7kNvwGfd9A6&_nc_oc=AdqvGzUODrFXImzIAHahE6hqQ4_2dQzL1GXeJY1LdoGTj1Yeabvrkiy_RUE6vFFiU3U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iT2T4eS1Kg_RZFAj8uA2DwJ-Xdqf5drl1Cx-ehuVrvw&oe=6A3D3973"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhAgU6pVgHUQ7kNvwHKGPKL&_nc_oc=AdoQbB-gnwdgzmLkQEA9u5lc2tLVbQz-glANtvOqIN4BbP60cJhTyD1161u8EVU1h9A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-al8YizHhAFmiPfTV_ljVy9F3cbD1CP2a8kSJ7XjdRXg&oe=6A3D53A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWoBs2g5dSAQ7kNvwH4eoj1&_nc_oc=AdrGjGLy7RpZnHqXfQDB2ni3foA_3xmXTZCJIU7agmMteY6FFsBxYfIoUJ-cwqiCZ8g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HEUz_pktpfobNuI7ZGxPAletZH7121i7r9ED37YmdSw&oe=6A3D371B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-2
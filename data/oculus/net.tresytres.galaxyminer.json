37_1160373264061102_2430040458253041664_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXyQCrFYS-gQ7kNvwHj0IXu&_nc_oc=AdpCTWUfzs2-89lOy9BGZ7CqroCgg3sc6o9gSZswo2V-qJP0SXHywW05bSzv6EWOd10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSj8BIkV8YyerqDDgQE8HWsJ4MPUIoQUc-yNWXmNpZ9MA&oe=6B0C8165"}, {"file_name": "migrated_image.png", "id": "229915041467231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj1rPVgZH78Q7kNvwEmG7aZ&_nc_oc=Adq91dsqkXu_58xMMRcokOejwJ0QK2YaJq-1kOPbBAtSt39gyTLFZZQZ0h0kb7i-U4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzMEzhy_muFFrSQ_lRNX7oHaPiUkhvrXqnjCPfBHeVtA&oe=6B0C6D33"}, {"file_name": "migrated_image.png", "id": "205803630677613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q23hndozNQQ7kNvwE-FOzA&_nc_oc=AdrlKs9x3pd0xoRJgzjpcYx1_ncGn-DFp6pCymxix2thRr86I0f4g6VWnJH9KnJH5Qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToM4g_phtAkOc0t0Gi7i7RR3JAQ6egizHdTzSejVBMPA&oe=6B0C4F23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1143350413148906"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "974794515983913"}, {"status": "CANCELLED", "id": "367388230340505"}, {"status": "PUBLISHED", "id": "136702933702924"}, {"status": "PUBLISHED", "id": "1770618129615995"}, {"status": "CANCELLED", "id": "398293573933162"}]}, "baseline_offer": {"id": "974794515983913"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1486576800, "status": "PUBLISHED", "id": "974794515983913"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1180002868787676", "version": "1.0"}, "id": "41169979583651
n.com&_nc_ss=7f20f&oh=00_AQCVNNBI9sE_2BNRQoJ0CG9gBOGfLedpDBzxNGD_Eaeb5A&oe=6A64A37C"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t66OCmZyxMQ7kNvwG3txVl&_nc_oc=Adp8W7HNkNA1tBsWv5Z2r1sZT7a5Qly9_X-AbhdPJhOdRm-xt5x5XWXTjbPhbw_CoUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwo6TsNprZqtv8ei1JfTLcUZLBxfHl5lre6duTUQ4kfA&oe=6A64A265"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2NFXBJBsrwQ7kNvwFoxzL3&_nc_oc=AdqsU4iuyJgtKY2YMokXz2I1Fn43DSZZX7EWXMrb-8kDtO4x1-5o3Ru6x9VJlXuU-qY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqVd7wGNN7L3jvcOtyzM61wSnKqL8h5k2ip_e1R8h8lA&oe=6A64C673"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_rCW13n5ZIQ7kNvwG2WMWU&_nc_oc=AdpmXWfr0xGXDk1cefaLNuap9HRTkO1EeR71aBy6w01lgplX718sz-Q7VIMh8iIW48A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXQUah3vIA-E--cENtpNqp9KNrTHCXAoNfZhXWOegZKA&oe=6A64A863"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhvrBbaW_5cQ7kNvwGQSl4u&_nc_oc=Adr6uvCIUeRcIv2ulLuy23sVAiUHns9b3lcsqRJpE6VomfX4x_HPTMD-wSMBW5zbp9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhIqQYjV0_qFjE6yfnJPfx0EtJ-lMalo1Scrtcj-Bc-A&oe=6A64C41B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-2
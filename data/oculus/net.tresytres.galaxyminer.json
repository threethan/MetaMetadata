n.com&_nc_ss=7a30f&oh=00_Afx1V3SUifO045My8iKN7svdNFBELfIuSNNwMV9fks0WzQ&oe=69CA63FC"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6AvQqKnwhcQ7kNvwE82QDI&_nc_oc=AdpdcTOlq5bJDvdHT4YVv-5lRwZBZGre7hGc5z6Kl1SlMLhNQxlp0UO5EhZHC2IbVBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj9JrWPlix_xVUd16xg8sOsf5xdWvrBsVuoLYZXZoUGQ&oe=69CA62E5"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc7WaEMjkO0Q7kNvwH4HGPJ&_nc_oc=AdoFzoIaBnvFJP6KKSt1Ix-HHXMgeAwE3KLSZJ1i3VtEh7FjA6RqfEm2v0jqtCjg3Uk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8tuupKJZnV9IItwAU9DFDge9FwcOdjoRbIV92ftFr0g&oe=69CA86F3"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2NVQkuqGg0Q7kNvwGv9mpX&_nc_oc=AdrzSS8HemjB1Cj56mi_JqBrB9Wo8oX2e0gzpz6bLGwa1D5s3-3QA-hFGVzWd2a2XIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMiDko50PLZQYprC_DDhWM43VnXGTxHFCbmgJo-oftUA&oe=69CA68E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfQ88GQ1ltQQ7kNvwHrasD_&_nc_oc=AdpUZLrKPby7mFWbKI473ZBksaofHzQ_SGNZgp-RLmOQ30RxkimjAHlYSZYAOjUMt8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC0T1sgacfyypnLBjyJK6yoXGKcPujTTGf9jWReOyUNg&oe=69CA849B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-2
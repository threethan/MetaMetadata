pe7Sw3QZ5y5HSqwb97yFDQtjuUhLtKTQvEw&oe=69B9407C"}, {"file_name": "migrated_image.png", "id": "1295791743945340", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139237_1160373264061102_2430040458253041664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKTMYgydJFEQ7kNvwHlHHnI&_nc_oc=Adk0D5kDKeZ4Y1CvSF0082S5Cg-RRMLAYH6hZyjOOz5KKSBdd2PHhyGHGay8ttywq28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7ftzkw9QntL8CjLsHAzZ_amEG_jbA0mb_b9XrxL0znw&oe=69B93F65"}, {"file_name": "migrated_image.png", "id": "895586677566787", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602069_1834469796821079_2736480709760778240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Y7oBgMfWTMQ7kNvwEJDekQ&_nc_oc=Adn6ItqjnuoZ-SWElx857yU5XoSKIPZLQ8oP6qxnmoGQpf_HZWricLiHwHHkD8wOChw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwPcv0LHMGIphoTk2ev7nseAzM43u2LwwxWTGCPzyyvfQ&oe=69B96373"}, {"file_name": "migrated_image.png", "id": "540881936542966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727931_760280377456823_5300337101823279104_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8s6MZR8vnN0Q7kNvwHWESLR&_nc_oc=AdkP5fu3wft9nd-GmwLwbALtOdhp81SGde48Ua0kO_i1D-aCLlnb3P6h9bl8uAzpYp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPLEYd6Bvtw4cHkM2naWUmGYOWsbJ2Wu4pAurmh7oz9w&oe=69B94563"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cap02.png", "id": "158876197996360", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162683_158876201329693_7299251667776569344_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_D7hAXrCQQQ7kNvwFKvHAx&_nc_oc=Admuq7UcQunzeAC1UOKf5r54GqupgwUBdVPZ0J_9fpuM7M-pBbDlQi4-bokwfZJPtgA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTqvQALz2h65Rj-y-pivJ0igoZSD0CGpWaIrJ5dw6weQ&oe=69B9611B"}, "display_name": "Galaxy Miner", "keywords": ["shooter", "scifi", "space", "fiction", "science"], "long_description": "Life in space is hard and you chose one of the hardest ways to have a job, to be a galaxy miner!\n\nYour job is to navigate your spaceship to the most dangerous asteroid fields in the galaxy, destroy the rock giants and collect their debris to recycle them to earn extra bucks.\n\nYour first missions will be with the standard ship of the Space Miner Corporation, equipped with an old space machinegun, but with each mission you will gain experience and you will be able to unlock different weapons for your ship.\n\nStart as a rookie miner until you get the best ship of the corporation. Destroy asteroids with the plasma gun or the amazing lightning gun. Enjoy Space Miner!", "short_description": "You are a Galaxy Miner worker. Your job is to clean asteroid fields destroying it and collecting debris. Gain experience and make upgrades to your spaceship. Unlock amazing weapons, Laser, Plasma Gun, Sniper, Shootgun, Rocket Launcher and up to 10 astonishing guns!\n\nEnjoy this immersive VR experience along more than 500 missions in seven amazing space locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3y3.net/?q=node%2F5", "developer_terms_of_service_url": "http://www.3y3.net/?q=node%2F5", "publisher_name": "3y3.net", "support_website_url": null, "website_url": "http://www.3y3.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "617816905963270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533842_1638881456407422_1165805238263742464_n.pn
: "Bullet Time", "keywords": [], "long_description": "Bullet time is a casual action VR game inspired by movies and games of the same genre.  In particular, we wanted to focus on the balletic grace of slow motion gun fights.\n\nThe game pits you against multiple AIs in a simulation world, where reality has blended with fantasy.  You are fighting to escape the virtual world that you have been forced into.\n\nNote that the game is in early access, so there will be much more content to come!", "short_description": "Bullet time is a casual action game focusing on the balletic grace of slow motion gun fights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1erlgi4H70wBQ6tAAt0efr6D-SDKBOUwvcdTNZq2uEk8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eyemobi Ltd", "support_website_url": null, "website_url": "http://www.eyemobi.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7295202933896433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974874_615117553024926_3395704455923427087_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7EF2AlryUgQ7kNvwEiaNgG&_nc_oc=Adre2NHD_MQ1iHYhI3U24XH72SaIDppZnomFP2Angpulso8XLR5KfW6v4ljCjZfbDxQ&_nc_zt=3&_nc_ht=
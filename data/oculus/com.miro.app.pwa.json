z7glvbDyk7-31RTkuRCrNT_fNqqrcfBaX1oI6dgaBa_WOQ7qqeRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K-GA3BX_K-Y8jMLCYBMWBcFKRj-adxlPPMR-_WGzUYQ&oe=6A355182"}, {"file_name": "com.oculus.shellenv-20211130-113747 (1).png", "id": "406981194453857", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974453_406981197787190_4263381406012866646_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX2EYRCVFtYQ7kNvwEz3QtE&_nc_oc=AdpMElgJjoI8xvaFC1AYOMihmtZy19d6mAlqJx3v5wpDf_CtNKnoaIxy_NesDwxmKO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ydaiuq4_Jy0VEZMjscU3v1ZzVY9m9Qyr5b5_vTqVbig&oe=6A353F27"}, {"file_name": "com.oculus.shellenv-20211125-120348 (1).png", "id": "642766493411665", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974762_642766500078331_7578208648623068373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeicOhp1dE0Q7kNvwHT7dhk&_nc_oc=Adpz_mJhxpLw7uJeh3SWwddoGxTrqFTNIsTLR3D5w9qKSJwp1mS_beG5ydopkcqZrqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95PMkVp3dy_b8PtNgYza2DJqRn1rGT4pmsAgd8riB0Iw&oe=6A355D21"}, {"file_name": "com.oculus.shellenv-20211130-114336 (1).png", "id": "615008293152701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_615008299819367_4109496001641683634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1OGaGGQjzIQ7kNvwH52i1n&_nc_oc=Adp3AtkAhlXKytuub4ClKL144ehOnsitHLl3zaEe3PN1xfTqyz9IeLOFIg0BQt0aUCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AESQ4a-jmo-GpelYa-9FAqE6JHu1IWUkv-yM1BR8A-Q&oe=6A357286"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2021-12-05 at 17.41.26.png", "id": "1288205531608958", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003281_1288205534942291_6447482674783543975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofA1qLmQjCEQ7kNvwGSd6h8&_nc_oc=Adoom3CwIsMFcgpPArcVV214l8k60jem3FzoA8GtlTr2WMQgBKJE5onaG3d7S0z8BdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-Zh9-9NpNSww8Z48kA-ucF2W3oJGOQQ4vjBOHVkmzmg&oe=6A354B85"}, "display_name": "Miro", "keywords": [], "long_description": "Miro unlocks creativity with:\n\n- An infinite canvas to help you ideate, strategize, get organized, and work with your team without constraints\n- Whiteboarding tools like sticky notes, a pen, shapes, arrows, and smart drawing that let you easily co-create\n- 200+ best-practice templates to help you easily facilitate brainstorming, Agile rituals, design-thinking activities, and strategic planning\n- Integrations with your favorite tools including Dropbox, Box, Google Suite, JIRA, Slack, and Sketch to streamline your workflows and see the big picture of your projects", "short_description": "Miro is the online whiteboard for team collaboration. With the magic of Miro, visualizing concepts, ideas, and solutions as a team can happen anywhere, any time. Miro helps teams sync, flow, and feel the connection of working side by side \u2014 even in remote, distributed, and hybrid work environments."}]}, "developer_name": "Miro", "developer_privacy_policy_url": "https://miro.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://miro.com/legal/terms-of-service/", "publisher_name": "Miro", "support_website_url": "https://help.miro.com/hc/en-us", "website_url": "https://www.miro.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE
k_tV3mgIkhZHX5mk6kOjh3gMaHZb5xjfnLx12FjvBo5UWjACKDHc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIR4CcxeDgtZBAuTlMKQCAO86stGG2gl7zND2Ct88zbA&oe=6A71F682"}, {"file_name": "com.oculus.shellenv-20211130-113747 (1).png", "id": "406981194453857", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974453_406981197787190_4263381406012866646_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-2rQ-jfXr4Q7kNvwEGYc9H&_nc_oc=Adp03xxy39GSGVK29KkL9XlYHSuk6CepDWYml7wP6fmx1PYh_7aK99oyog1vVxquvEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzAVZqH2_nRKNxikNmO0HG6-Rl1nrqR6rHsqOJ_6EiZw&oe=6A71E427"}, {"file_name": "com.oculus.shellenv-20211125-120348 (1).png", "id": "642766493411665", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974762_642766500078331_7578208648623068373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S_117BUflwQ7kNvwESrIJj&_nc_oc=AdoyUpwmHJ1LvMwhUv5oHr51SuYGrpRdzrlDpZFWmdo2bnFKtnHoQaov-nwWhI4i2-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFME63VsdtoT9Nqed-Wst7Sa2HFp14e8HxlIpTcQd245A&oe=6A720221"}, {"file_name": "com.oculus.shellenv-20211130-114336 (1).png", "id": "615008293152701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982666_615008299819367_4109496001641683634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHpeowFr5dQQ7kNvwHQilrT&_nc_oc=AdqyGGIb7WlDPLz2Mvr7Nyzsi2DX9MhOAt6M9BPuQphWVxiSRxpzyFZz3sTRQM_hhI4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwbDmAGHAGDTbg9XKLhMxtb9FnqvomK4A27IZzox55xA&oe=6A71DF46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2021-12-05 at 17.41.26.png", "id": "1288205531608958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003281_1288205534942291_6447482674783543975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWKLHFsRGTMQ7kNvwEwAWBt&_nc_oc=AdqJfNBAND8kGHd1qevGitUdQ8tG0HwFp-UqY7uvO4bKC_wZFFxN4ikGskz0_SkfQKM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2GrHj_1GvCJC3yy0RatujNs1OZ7i1N3KYqhXYSu9hpg&oe=6A71F085"}, "display_name": "Miro", "keywords": [], "long_description": "Miro unlocks creativity with:\n\n- An infinite canvas to help you ideate, strategize, get organized, and work with your team without constraints\n- Whiteboarding tools like sticky notes, a pen, shapes, arrows, and smart drawing that let you easily co-create\n- 200+ best-practice templates to help you easily facilitate brainstorming, Agile rituals, design-thinking activities, and strategic planning\n- Integrations with your favorite tools including Dropbox, Box, Google Suite, JIRA, Slack, and Sketch to streamline your workflows and see the big picture of your projects", "short_description": "Miro is the online whiteboard for team collaboration. With the magic of Miro, visualizing concepts, ideas, and solutions as a team can happen anywhere, any time. Miro helps teams sync, flow, and feel the connection of working side by side \u2014 even in remote, distributed, and hybrid work environments."}]}, "developer_name": "Miro", "developer_privacy_policy_url": "https://miro.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://miro.com/legal/terms-of-service/", "publisher_name": "Miro", "support_website_url": "https://help.miro.com/hc/en-us", "website_url": "https://www.miro.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE
sAvawPfSWQoi9mquXGtUM_now_pHu8yDGJBK43_-em0KORXUpACQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10D_ocpNGBmf9--VZ8i585XgWyWfUA0irc6P_DHkGE3Q&oe=69DA5A02"}, {"file_name": "com.oculus.shellenv-20211130-113747 (1).png", "id": "406981194453857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_406981197787190_4263381406012866646_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP5BifMcabQQ7kNvwEj_lTA&_nc_oc=Adrd2E759I4H_F0kV7KbDm5tmLb0zFHwRNdtjhCBE97hVUx9Y9BmPMo6Cv7rxNLFzSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1poIUrn3cBdfdN1fBbvEexsbO35cnS6lw8LOtyMqQ0Ww&oe=69DA47A7"}, {"file_name": "com.oculus.shellenv-20211125-120348 (1).png", "id": "642766493411665", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974762_642766500078331_7578208648623068373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WMJa8JG9oMQ7kNvwFVjA3C&_nc_oc=Adpegt2Fs-ZoyAn_bdx2Vhn9K2ilL63uvXd68qp_4j--5Fly0TaiDeV0iD9Z400hplQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rP6lxJAhRWaOCYKs2MO9SFvPWobTCpWue12mmS4a2lQ&oe=69DA2D61"}, {"file_name": "com.oculus.shellenv-20211130-114336 (1).png", "id": "615008293152701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_615008299819367_4109496001641683634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23I77yD-J1IQ7kNvwHE7xzi&_nc_oc=AdplJtI3vNTi572SOyigWnuuqT6TYv96OSdw71cIQq2uYENe1boz0WnC6HR2Nx5a_gA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VXbQ-k1Wh4Ht5cZUw4vukhUZDZKtlXM8BeZc2upNUig&oe=69DA42C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2021-12-05 at 17.41.26.png", "id": "1288205531608958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_1288205534942291_6447482674783543975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XGMzpSDQJsQ7kNvwEePxTH&_nc_oc=AdoA2mZmyld_SXDnG1UpqqZxc3XuyKJfqB-HM58kFw7EEJjWcuesFvEIhqGP5ehS_Hc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vYwlqDb7x931H5-CFTpIY05vJ4MJUyKaZuA0DygQtUQ&oe=69DA5405"}, "display_name": "Miro", "keywords": [], "long_description": "Miro unlocks creativity with:\n\n- An infinite canvas to help you ideate, strategize, get organized, and work with your team without constraints\n- Whiteboarding tools like sticky notes, a pen, shapes, arrows, and smart drawing that let you easily co-create\n- 200+ best-practice templates to help you easily facilitate brainstorming, Agile rituals, design-thinking activities, and strategic planning\n- Integrations with your favorite tools including Dropbox, Box, Google Suite, JIRA, Slack, and Sketch to streamline your workflows and see the big picture of your projects", "short_description": "Miro is the online whiteboard for team collaboration. With the magic of Miro, visualizing concepts, ideas, and solutions as a team can happen anywhere, any time. Miro helps teams sync, flow, and feel the connection of working side by side \u2014 even in remote, distributed, and hybrid work environments."}]}, "developer_name": "Miro", "developer_privacy_policy_url": "https://miro.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://miro.com/legal/terms-of-service/", "publisher_name": "Miro", "support_website_url": "https://help.miro.com/hc/en-us", "website_url": "https://www.miro.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE
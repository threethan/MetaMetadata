JD4D9jDJt7wQjjLEOuxlabJasyWJndlr_iB1CJcuywUzDTHhK7Ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUvVRMlW4XgsVWVOVrjSFnx8dEGLiZW6FWxNJZtduu9Q&oe=6AEF3502"}, {"file_name": "com.oculus.shellenv-20211130-113747 (1).png", "id": "406981194453857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_406981197787190_4263381406012866646_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9cdX6aHYQsQ7kNvwFDPeLN&_nc_oc=AdrVsPRiJsTUtu3BSy8ScRm3qnS7MeRKGC1s76amhyi9IuZRUYT9kgWPnG3cXfSRuZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG0RaMXDMwY-tt-05zKxyjKknPhqpigZZRGSNbtIqGEg&oe=6AEF5AE7"}, {"file_name": "com.oculus.shellenv-20211125-120348 (1).png", "id": "642766493411665", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974762_642766500078331_7578208648623068373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkwG1-bQY-YQ7kNvwFig-ZO&_nc_oc=Adroc5_xxVRqmLyoZU04OyvrQ9dmYw0zIzD784F7ms1vdr3CG1wn_ovTdZEeOXDBjls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_6S92QOroKDzYLJ_SwWm7LOyhJr7wqrPUQvuL2gNU0g&oe=6AEF40A1"}, {"file_name": "com.oculus.shellenv-20211130-114336 (1).png", "id": "615008293152701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_615008299819367_4109496001641683634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMsE35nWibYQ7kNvwFPs8pv&_nc_oc=AdojPfLLYHH8Uvej_QV3_3jBi1uScdU8uo5xfbcjawJXylL8mGNMViuS-OtQgtA6EnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjui1Y_2z_CAp4qfa_bvjezFBehFptRipXujQaCBVOqA&oe=6AEF5606"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2021-12-05 at 17.41.26.png", "id": "1288205531608958", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_1288205534942291_6447482674783543975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyYoFFuj5mQQ7kNvwGPjleA&_nc_oc=AdpgncWmGyg6Hg2PaMhgpKYOxkh2X51WCqWHyDMkNhFLaPn_Jc2E5RIyUxoNdTM_LvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfmxxorYjR6H8wbNcm85Pjmqwid3u6hsKX-hPzt7l5fw&oe=6AEF6745"}, "display_name": "Miro", "keywords": [], "long_description": "Miro unlocks creativity with:\n\n- An infinite canvas to help you ideate, strategize, get organized, and work with your team without constraints\n- Whiteboarding tools like sticky notes, a pen, shapes, arrows, and smart drawing that let you easily co-create\n- 200+ best-practice templates to help you easily facilitate brainstorming, Agile rituals, design-thinking activities, and strategic planning\n- Integrations with your favorite tools including Dropbox, Box, Google Suite, JIRA, Slack, and Sketch to streamline your workflows and see the big picture of your projects", "short_description": "Miro is the online whiteboard for team collaboration. With the magic of Miro, visualizing concepts, ideas, and solutions as a team can happen anywhere, any time. Miro helps teams sync, flow, and feel the connection of working side by side \u2014 even in remote, distributed, and hybrid work environments."}]}, "developer_name": "Miro", "developer_privacy_policy_url": "https://miro.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://miro.com/legal/terms-of-service/", "publisher_name": "Miro", "support_website_url": "https://help.miro.com/hc/en-us", "website_url": "https://www.miro.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE
g", "id": "642766493411665", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974762_642766500078331_7578208648623068373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcQMgqSOrysQ7kNvwHwTmfX&_nc_oc=Adotr9mwsLN7o-otsH6po4uLyzZk_EeLRxVrltKsB8-KZkXBWPTsc_EGXYDmrNCoeVA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyAVrM_lPE6SiE5P1_timx8E7skiYk0zM9uc2eDeR4OMQ&oe=69C120E1"}, {"file_name": "com.oculus.shellenv-20211130-114336 (1).png", "id": "615008293152701", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982666_615008299819367_4109496001641683634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMXkfPFATrQQ7kNvwEOA0rl&_nc_oc=AdpWLk7HnHFk4Ob1GTtWYT8ChusvyLLBnKCSK8_bTdtJxOr9asJuxB54mfTbszdJvDQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzMcYFo_wPPuRPqDaJBzFIzyXqz2KA8R4PimKmg7sg0Xg&oe=69C13646"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2021-12-05 at 17.41.26.png", "id": "1288205531608958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003281_1288205534942291_6447482674783543975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yweOXTyLKGwQ7kNvwH4QaiI&_nc_oc=AdqbRVTQs5nMJXH2EHAM5Cmp97aJuLhCH8p_Gs9poddXvHdoyNmmzSkFyyWC_oFs6yU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd8glwNUw8z876Afhj9s2GBNAFeGCjFnAGbBMfeM1www&oe=69C14785"}, "display_name": "Miro", "keywords": [], "long_description": "Miro unlocks creativity with:\n\n- An infinite canvas to help you ideate, strategize, get organized, and work with your team without constraints\n- Whiteboarding tools like sticky notes, a pen, shapes, arrows, and smart drawing that let you easily co-create\n- 200+ best-practice templates to help you easily facilitate brainstorming, Agile rituals, design-thinking activities, and strategic planning\n- Integrations with your favorite tools including Dropbox, Box, Google Suite, JIRA, Slack, and Sketch to streamline your workflows and see the big picture of you
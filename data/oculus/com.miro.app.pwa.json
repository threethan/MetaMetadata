ifAWAfvpPaecT1fsDWkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvnMofYsutMyip5NxDoMrgiLpZhr4LAui0Ni0HWNuYeBw&oe=69A84102"}, {"file_name": "com.oculus.shellenv-20211130-113747 (1).png", "id": "406981194453857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_406981197787190_4263381406012866646_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOWNMdo_fYcQ7kNvwEskCNS&_nc_oc=AdlsLUPmU-qjiwJCNo0MkI3P0-nQM15g7I5bl9GFimFLNDTgoaPzxVK_4YDXbFmAN8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afur_Yz9GjtSf17YGjKwDkyV_w5iw8aqxrlQZK7-cVGOgA&oe=69A82EA7"}, {"file_name": "com.oculus.shellenv-20211125-120348 (1).png", "id": "642766493411665", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974762_642766500078331_7578208648623068373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYys4I0qugkQ7kNvwEbkJpe&_nc_oc=Admt-5VX8cn0yY2Bb0XDCKQfOTtTJuW-Crq0VsmwxPjS5hvnSQ3PbQc8lIAV8E-zonc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftH8WTdgzpG-iaMUMwEQVZIlyVhJrGAPFYy5nkQCjfJPg&oe=69A81461"}, {"file_name": "com.oculus.shellenv-20211130-114336 (1).png", "id": "615008293152701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_615008299819367_4109496001641683634_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkQ2kUGPlfEQ7kNvwHjBQnD&_nc_oc=AdkXJkgC0r0tXWiiarTInXIpQvXxf46P61HnhFegbAQAIGdqj8PZ2xlg3Cl7dfFqP5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuRiTq0yzT1SYwFqgZWuWxGP0R1mfhtERGIauKfBOiXKQ&oe=69A829C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2021-12-05 at 17.41.26.png", "id": "1288205531608958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_1288205534942291_6447482674783543975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffqexCugpI4Q7kNvwGlBBnZ&_nc_oc=Adm8mPtsr3SoPjzcah6aNogaiMCB6bDGbjgQjS-4r5z-oH5ESwpFjSmutXjarDzTQpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs62AX17Se7gtm1JRr4quhnA7oHe6d3AsPyzM3oUwDPZA&oe=69A83B05"}, "display_name": "Miro", "keywords": [], "long_description": "Miro unlocks creativity with:\n\n- An infinite canvas to help you ideate, strategize, get organized, and work with your team without constraints\n- Whiteboarding tools like sticky notes, a pen, shapes, arrows, and smart drawing that let you easily co-create\n- 200+ best-practice templates to help you easily facilitate brainstorming, Agile rituals, design-thinking activities, and strategic planning\n- Integrations with your favorite tools including Dropbox, Box, Google Suite, JIRA, Slack, and Sketch to streamline your workflows and see the big picture of your projects", "short_description": "Miro is the online whiteboard for team collaboration. With the magic of Miro, visualizing concepts, ideas, and solutions as a team can happen anywhere, any time. Miro helps teams sync, flow, and feel the connection of working side by side \u2014 even in remote, distributed, and hybrid work environments."}]}, "developer_name": "Miro", "developer_privacy_policy_url": "https://miro.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://miro.com/legal/terms-of-service/", "publisher_name": "Miro", "support_website_url": "https://help.miro.com/hc/en-us", "website_url": "https://www.miro.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "UTILITY", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472216757677394"}, "review_messages"
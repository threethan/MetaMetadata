XfpsvPkQ7kNvwEdIUSD&_nc_oc=AdrS_B1Dh2ypcuMO-4NRyNhfaO58xgjqBd4c2z7U1kTrpTi2oFBDrrabWqBUBToNPao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHiLUdOguolUNtCv3yRV4d6i2solu8hQ3FlsWnrTYTrg&oe=6AC6567B"}, {"file_name": "screen4.png", "id": "1701189816730687", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031424_1701189826730686_4427856205856697856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBIzWxw3O20Q7kNvwFqU-DA&_nc_oc=AdqphDTPTqGk9MXY84Dip6zhRK8Iopwc3fNSMqQKJEAgalScDqfc8837fSQlOgAQD70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJoUPPA7_ChkukSwOMaAsIsngT6DVbUW9f9q2yebNwkQ&oe=6AC65575"}, {"file_name": "screen5.png", "id": "910324089795393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031428_910324093128726_2097995587102720676_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0rk_mvtyZIQ7kNvwE--xKa&_nc_oc=Adp8X0CwzNhtGFT2k6UqM8b41XHJAQ1mZ_vqQYfu3UAVdER_u42XR8Qv8X4PjL4h-vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ1ZoE4bEImLVaPv6R2E-Q6q_oLnEHTTPHMrizygqEOg&oe=6AC65C21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "275558960690261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_275558964023594_5031283073068139714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Od04uLw5doQ7kNvwHHSe-0&_nc_oc=AdrNgsB6ijNfXHaHmi-T8WEglTCc3uGiL96083b_W1p2USUST8Ed900uMAnMJjdgw3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYQZkKbrkKdgwlgkc5kevGo8k6Y9xVYLaOqu-81BgJbw&oe=6AC66E6C"}, "display_name": "Days of Heroes: D-Day (Demo)", "keywords": [], "long_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day.\n\nComplete diversified military missions, from short- and long-range skirmishes with Nazis, by employing anti-aircraft fire, destroying enemy tanks, and breaking through the trenches and escaping from a POW camp. Use over a dozen weapons typical to the World War II period that have been accurately reproduced in terms of appearance and mechanics.\n\nFinish the campaign and practice your skills on the shooting range, which offers four different gameplay modes. Once ready, unlock Hardcore Mode, which will take your cleverness, strategic thinking, and will to survive to the extreme.", "short_description": "This is demo of Days of Heroes: D-Day, try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zenappsstudio.pl/daysofheroes/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://zenappsstudio.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3121316818125732"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "290180622467103"}]}, "baseline_offer": {"id": "290180622467103"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1616979600, "status": "PUBLISHED", "id": "290180622467103"}]}, "liveChannel": {"nodes": [{"latest_suppo
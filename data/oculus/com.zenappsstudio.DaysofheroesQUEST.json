i": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982586_141976484469299_3715368043751202176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSlaw-m5tK8Q7kNvwHzlPBg&_nc_oc=AdpXWgpLYx_tkBUqGAg1RZ8kYqLUq8GocOBp3DkyWxr6IG2QKsJN6_UistWJbVnTw-U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39BBcszp7Yai57wckAGKx89ysmVNJ9QCx1C3PgK_FSGQ&oe=69E6377B"}, {"file_name": "screen5.png", "id": "910324089795393", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031428_910324093128726_2097995587102720676_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svBMg-FwbDQQ7kNvwEpZFIT&_nc_oc=AdqEpSw76wE0F_XFHPSlBeqQzIAgDazgif5t5qrWFS7Ekl7X-3lxEpm3LMOUlfcNkmI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ByB2FCzhWpwI8AyvyH7yQtUsL9P8nifNg5bTj9dmA0w&oe=69E63D21"}, {"file_name": "screen4.png", "id": "1830561624180636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304053_1830561627513969_8218921561172535826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K3QZCAKT20Q7kNvwGd6Elb&_nc_oc=AdroxYF4GEUT-h4-wXM2k4dQkVAHMNKfoIJ38ubJFcYZKJXAMLeZIEZyYs7lNjNITiU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y3Eycc5l3bO0nT39yZNWpH8xnKfQ5CkUYCN0mFSzMeQ&oe=69E611C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "275558960690261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974677_275558964023594_5031283073068139714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvymZJxuZxUQ7kNvwEu-gjF&_nc_oc=AdpoKQM5R-G4S1ZOxApfSE1MMpTSgjZp_BbZNMQn59LgsVFNUPJFefXtdqMoXwHOuGs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z28OUAHNPaYW-TiOSMbFDG80ThtGVDHGJoFXLVA27nw&oe=69E6172C"}, "display_name": "Days of Heroes: D-Day (Demo)", "keywords": ["Shooter", "Lowpoly", "FPS", "Heroes"], "long_description": "Get ready for the landing.\n\nIn the free Days of Heroes: D\u2011Day demo, you\u2019ll dive right into the heart of the fight for the beaches of Normandy. This is a taste of the full game, letting you experience the intensity, atmosphere, and mechanics of our cinematic low\u2011poly World War II world.\n\n\u2714\ufe0f Try out missions from the full campaign \u2013 from the first clashes to desperate defensive stands.\n\u2714\ufe0f Handle authentic weapons \u2013 rifles, pistols, grenades, all faithfully recreated in look and mechanics.\n\u2714\ufe0f Feel the chaos of the battlefield in VR \u2013 fight side by side with your squad under enemy fire.\n\nThis is just the beginning. If you enjoy what you see in the demo, the full game offers even more missions, more weapons, and a complete campaign experience.\n\n\ud83c\udf0d Learn more: www.dohvr.com\n\ud83d\udce3 Join our community: www.dohvr.com/discord", "short_description": "Days of Heroes: D\u2011Day \u2013 Free Demo\n\nJump straight into the action and feel the atmosphere of the largest operation of World War II. Try selected missions from the full campaign, test authentic weapons, and experience the chaos of the battlefield in VR \u2013 for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://dohvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user
i": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982586_141976484469299_3715368043751202176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSlaw-m5tK8Q7kNvwELMNdF&_nc_oc=AdowFjkWES375z7Z-evfrX6VaoH7NLctKrp7T4xp-NrzdN2_OTAYrgDu7ORS9eCB0xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KBbjN69lN_qfuxWXmpPKG9bh6HptsbVXM8YYCfftvcg&oe=69E8DA7B"}, {"file_name": "screen5.png", "id": "910324089795393", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031428_910324093128726_2097995587102720676_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZy9EP9PVi4Q7kNvwGCI2hf&_nc_oc=AdpOR6LJwbTiV8MpNJVQsgmL36isYGGs7xSe_MNzH3DbxHQAm3stEErYzV9vg6W-ptU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ha9rvXVBuoSMiMMO0bT6bODKM2yQumOa09xHEujd_6w&oe=69E8E021"}, {"file_name": "screen4.png", "id": "1830561624180636", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304053_1830561627513969_8218921561172535826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlG6rJi-8zQQ7kNvwENXyy0&_nc_oc=Adp2ULpHRV16wdJ_ZKKZjaouo-6D0KFwKa7XZji0cBpqSRpYKm6oFrgcsatzSEdPL00&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YqSiDhOMH4y2i3QgH-Ax09oADLmcsbkcB6aMwO8ZVcg&oe=69E8B4C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "275558960690261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_275558964023594_5031283073068139714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxbRMIa4W_oQ7kNvwG4mwhB&_nc_oc=Adp21cEEZ6Rsf9qhMwkUkFVisO7PSuezDhsPXL2H_jgr-DBtqHVDM5E5AmQ7E1CusWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fH5qZrWVroqUxMUjP5Ds-7utHzCcA1SD_AmHtCRWaLg&oe=69E8BA2C"}, "display_name": "Days of Heroes: D-Day (Demo)", "keywords": ["Shooter", "Lowpoly", "FPS", "Heroes"], "long_description": "Get ready for the landing.\n\nIn the free Days of Heroes: D\u2011Day demo, you\u2019ll dive right into the heart of the fight for the beaches of Normandy. This is a taste of the full game, letting you experience the intensity, atmosphere, and mechanics of our cinematic low\u2011poly World War II world.\n\n\u2714\ufe0f Try out missions from the full campaign \u2013 from the first clashes to desperate defensive stands.\n\u2714\ufe0f Handle authentic weapons \u2013 rifles, pistols, grenades, all faithfully recreated in look and mechanics.\n\u2714\ufe0f Feel the chaos of the battlefield in VR \u2013 fight side by side with your squad under enemy fire.\n\nThis is just the beginning. If you enjoy what you see in the demo, the full game offers even more missions, more weapons, and a complete campaign experience.\n\n\ud83c\udf0d Learn more: www.dohvr.com\n\ud83d\udce3 Join our community: www.dohvr.com/discord", "short_description": "Days of Heroes: D\u2011Day \u2013 Free Demo\n\nJump straight into the action and feel the atmosphere of the largest operation of World War II. Try selected missions from the full campaign, test authentic weapons, and experience the chaos of the battlefield in VR \u2013 for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://dohvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user
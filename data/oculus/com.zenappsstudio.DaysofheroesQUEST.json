c_ohc=s4C0xnShYE0Q7kNvwGTu75L&_nc_oc=Adq_B3-ijrRdsiS0zku60P1eI-aJoR9VGZc1x_dMQ0fiz1kYIQiviuT8tAfDy6VZMg4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq4HJPo3Yefe5DgVvAxWmrxn9pzRj8VJRLCP5V0hilYw&oe=6AA9557B"}, {"file_name": "screen4.png", "id": "1701189816730687", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031424_1701189826730686_4427856205856697856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4KvtIuOYCgQ7kNvwGv8HyE&_nc_oc=AdoJvyb09qx0Yc6vn3kVOVUFU-SJVG8rvWfeTSKXe2jHPMnDc-nkqnzBWfEbyy8oZKg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHHl5c3dJQY8szGtqrZPAlLMweVjyuWzHyukBF8UFnjw&oe=6AA95475"}, {"file_name": "screen5.png", "id": "910324089795393", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031428_910324093128726_2097995587102720676_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JjKTpgrhDsQ7kNvwH9kY_B&_nc_oc=Ado0X7UkUrhEf2f1H5ECk6GtB5dVrRvJ7hK5yXcgYxCRXv7C7C6Vh4fKIaiC3kdQ9Xw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWPyVCa4BFrgzyX1H403H55DiqSTMWaWCVobL7n1Eu8w&oe=6AA95B21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "275558960690261", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974677_275558964023594_5031283073068139714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiYao0qCRPkQ7kNvwFIBRCd&_nc_oc=Adplgcu3d-c38d8NhwU1i9yldMT0-aVqmkHNctVo_tDe4X3aKxg-PpVwHkw7UrWDVFs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcctqIKJdEz4ezHzEdpivimsat5tgNhG_qqAJTAzgkNw&oe=6AA9352C"}, "display_name": "Days of Heroes: D-Day (Demo)", "keywords": [], "long_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day.\n\nComplete diversified military missions, from short- and long-range skirmishes with Nazis, by employing anti-aircraft fire, destroying enemy tanks, and breaking through the trenches and escaping from a POW camp. Use over a dozen weapons typical to the World War II period that have been accurately reproduced in terms of appearance and mechanics.\n\nFinish the campaign and practice your skills on the shooting range, which offers four different gameplay modes. Once ready, unlock Hardcore Mode, which will take your cleverness, strategic thinking, and will to survive to the extreme.", "short_description": "This is demo of Days of Heroes: D-Day, try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zenappsstudio.pl/daysofheroes/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://zenappsstudio.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3121316818125732"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "290180622467103"}]}, "baseline_offer": {"id": "290180622467103"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1616979600, "status": "PUBLISHED", "id": "290180622467103"}]}, "liveChannel": {"nodes": [
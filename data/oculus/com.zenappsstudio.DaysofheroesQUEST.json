nt-iad3-1.oculuscdn.com/v/t64.5771-25/38982586_141976484469299_3715368043751202176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNA73LoTTe8Q7kNvwEdim8w&_nc_oc=AdqOkUl_S2ut9E5gBt4L24u1oIsbPSSCQ2bmbY-CVTHN23mGlq9QRHFyD7EbK676p9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VXsMvZDNOd3EYtTKlMNftkdN1GETQ5L5ocd6f1doLMw&oe=6A1EE7FB"}, {"file_name": "screen4.png", "id": "1701189816730687", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031424_1701189826730686_4427856205856697856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAjyLueGjPsQ7kNvwG_Wyhj&_nc_oc=AdqVvtsUhnxqFvtJzZctlxDhDV8XqbFcJuMqelG74-EnefpTgIT2siyq94FeXLRU-xw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fKOBIJetXtSeW1cRFTxUGnjfNT-NaBGWftWxoHvLE9w&oe=6A1EE6F5"}, {"file_name": "screen5.png", "id": "910324089795393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031428_910324093128726_2097995587102720676_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iS0mGih8koUQ7kNvwH_SZDW&_nc_oc=AdqPlyNV7u0YFTyXChe3urKgq4_8xM09tDWArPrn07y-P6JJI4vX8O6b4IZ5l9c92fM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wUggxuAvGKIsyjkT6eYPSOAB-HL16vBcToaFnXW_wwg&oe=6A1EEDA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "275558960690261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_275558964023594_5031283073068139714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1LDbKTs2l4Q7kNvwHyBlhP&_nc_oc=Adpa9w0yToBjALeOQZuMclpvZiQqoz823MEkwAE-_ye_-ZuQoH3anG015bbpcFrlci8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pbuKr8yiNUPgO7bTNV2QsuUN9khu6LO_uiNLIDBpmPw&oe=6A1EFFEC"}, "display_name": "Days of Heroes: D-Day (Demo)", "keywords": [], "long_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day.\n\nComplete diversified military missions, from short- and long-range skirmishes with Nazis, by employing anti-aircraft fire, destroying enemy tanks, and breaking through the trenches and escaping from a POW camp. Use over a dozen weapons typical to the World War II period that have been accurately reproduced in terms of appearance and mechanics.\n\nFinish the campaign and practice your skills on the shooting range, which offers four different gameplay modes. Once ready, unlock Hardcore Mode, which will take your cleverness, strategic thinking, and will to survive to the extreme.", "short_description": "This is demo of Days of Heroes: D-Day, try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zenappsstudio.pl/daysofheroes/privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://zenappsstudio.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3121316818125732"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "290180622467103"}]}, "baseline_offer": {"id": "290180622467103"}, "is_approved": true, "firstO
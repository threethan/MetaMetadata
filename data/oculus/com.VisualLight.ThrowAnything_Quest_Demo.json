&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRG5sh0A1gelxNFJ8LnODNUozCxrD0pfM_XsosSN9Kunw&oe=6B0D99BC"}, {"file_name": "\uc2a4\ud14c\uc774\uc9c02_2\ub370\ubaa8.png", "id": "5484982741575988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75286675_5484982744909321_4763272697472173640_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_5-B2UFwQ8Q7kNvwFCscPe&_nc_oc=AdposHBotbI_dG3d48O9eSDk9UtyI207piUXsMnGkOH3aHWB2ikKRfVXo2TTc_KzPGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSA5OxgyLY0E0R7ZXxlzRrFl-IV3uSLnpSwD_edyk8eKw&oe=6B0DB4DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_32bit.png", "id": "1408245342844354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031320_1408245346177687_71002812634206035_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNWUDElop1UQ7kNvwFwL2id&_nc_oc=Ado3azbmf20dN5zRQd3ofv4mLIxyxVsPSdPGavlZGEMeKxOPQ3unuHHRRMXHYi80RFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAkZE_3wT9FKywnKJVwRztsxccUbhXk95IxCjS76QMBw&oe=6B0DCB0B"}, "display_name": "Throw Anything Demo", "keywords": [], "long_description": "There is nowhere to run... and nowhere to hide as zombies climb up the walls hoping to satisfy their appetite for brains. The only way to survive: reload your guns, destroy all furniture in the room, grab them all, and throw anything you can find to take them down.. and we mean ANYTHING.\nFace off against starving zombies in high-rise buildings across the globe in the VR action defense game, Throw Anything!\n\n\u25cf Key Features\n\u318dEnjoy laying waste to fully destructible environments!\n\n\u318dThrow any object within reach \u2013 humans included!\n\n\u318dTake on 6 challenging stages about to be overrun by the zombie horde!\n\n\u318dDefeat 5 mid-bosses and 6 powerful \u201cmain\u201d bosses!\n\n\u318dCollect ancient relics to save the world!\n\n\u318dDefeat zombies and get powerful weapons as rewards!\n\n\u318dTest your limits at various difficulty levels!", "short_description": "Get secret missions from Secret Delivery Agency (SDA) and save the world from zombie hordes in the VR action game, Throw Anything!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "fr", "es", "zh_TW", "th", "ja", "id", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "470167381279178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982663_491937331802182_3726344809787161215_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKbIQYCRJfAQ7kNvwE2G1Pq&_nc_oc=AdqQ9orPjbh44Lo3UEnkmLYH7QfzerRkiQ4Ow0PV79GbMXWMUSLQdqIIbmSsezLLsBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6qhF3U4IfmBKnMFEnh0lFxUIAMp8zuUmBYRNyFnIwxQ&oe=6B0DB9C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Throw Anything Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "i
ailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project_Possibl_Kathrin_Hallo_2021-04-09_18.00.43.png", "id": "441688053593859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_441688056927192_2539482727317571655_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pCxj5XJGfMQ7kNvwGaW0o_&_nc_oc=AdnDS1_VVN73xQ2B2EEINPKMnraLAjaOK8-tQ9xFlsdsGCL6gKO5tLpfE-ArG53VndQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-xDMC4s_5taNkS_q1yxnDOFEFmJNNmLDPA75AW761Dw&oe=69A0524B"}, "display_name": "Possibl", "keywords": [], "long_description": "Possibl bietet Virtual-Reality-Trainings f\u00fcr Arbeitssicherheit, Vertrieb, Sales und viele weitere Bereiche an. Neben dem individuellen Lernen ist auch ein Lernen in Gruppen m\u00f6glich und sogar Gruppencoachings k\u00f6nnen bei uns problemlos absolviert werden. Neben dem Lernmodus bietet Possibl auch einen Pr\u00fcfungsmodus, in dem der Lernerfolg gepr\u00fcft werden kann.", "short_description": "Possibl ist die Plattform f\u00fcr professionelle Virtual Reality Trainings und Schulungen im Arbeitsumfeld.  Wir bieten Ihnen effektive Trainings, sofort einsatzbereit."}, {"images": {"nodes": [{"file_name": "Logo_Transparent_Posibl_Brand_for_Oculus.png", "id": "1456172264724894", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_1456172274724893_7811624550343936119_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI8wY3i_LD8Q7kNvwGisri7&_nc_oc=Adkr8C3fTXGVSV25D7aMcX_1e9n_g5dpHoQsX1XY9BWfrFzKCDtYzDoZi2U7ZIwitWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumFfH5PA8AtVrhevPgbH1FE2-ekwQtVzgMsDFxpIETxA&oe=69A032DA"}, {"file_name": "Hero_Cover_Posibl_Brand_for_Oculus \u2013 1.png", "id": "1141819556291489", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451772_1141819559624822_7623867907620178626_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWhSHlpjCUEQ7kNvwF70rLA&_nc_oc=Adn1sr0rJ8_mO-s7c
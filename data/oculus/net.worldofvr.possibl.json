ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzzhZwoVZ9EdoKp7OgmVGUJoTut0oHn2nj2ETy_BeUCJA&oe=69B95591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project_Possibl_Kathrin_Hallo_2021-04-09_18.00.43.png", "id": "441688053593859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210889_441688056927192_2539482727317571655_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiSTpF-vzi4Q7kNvwHDs9Xo&_nc_oc=AdkIgoV3WKfGuFb4lyxDyoB_F43VJ7R15qOVWvwXXuScdonVEU6tMFX-1kguAs_ViEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2YoYrEPLXOFgFERPuD7fK0smf-tuZ8LvAlB6lmGI1Xw&oe=69B95ECB"}, "display_name": "Possibl", "keywords": [], "long_description": "Possibl bietet Virtual-Reality-Trainings f\u00fcr Arbeitssicherheit, Vertrieb, Sales und viele weitere Bereiche an. Neben dem individuellen Lernen ist auch ein Lernen in Gruppen m\u00f6glich und sogar Gruppencoachings k\u00f6nnen bei uns problemlos absolviert werden. Neben dem Lernmodus bietet Possibl auch einen Pr\u00fcfungsmodus, in dem der Lernerfolg gepr\u00fcft werden kann.", "short_description": "Possibl ist die Plattform f\u00fcr professionelle Virtual Reality Trainings und Schulungen im Arbeitsumfeld.  Wir bieten Ihnen effektive Trainings, sofort einsatzbereit."}, {"images": {"nodes": [{"file_name": "Logo_Transparent_Posibl_Brand_for_Oculus.png", "id": "1456172264724894", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572936_1456172274724893_7811624550343936119_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOX1_rockNMQ7kNvwGh-liZ&_nc_oc=AdkAY9VZQf694NoXkKxFLSwBbeCRZh_fPVZhaUJ8kBwT93K4FLMuR__APTntCfrAp5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoujjF78HiZFS2rlon_1gezrgTHwaHe4f-VSWdU75Xsw&oe=69B93F5A"}, {"file_name": "Hero_Cover_Posibl_Brand_for_Oculus \u2013 1.png", "id": "1141819556291489", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451772_11418195
ailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project_Possibl_Kathrin_Hallo_2021-04-09_18.00.43.png", "id": "441688053593859", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75210889_441688056927192_2539482727317571655_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pCxj5XJGfMQ7kNvwEdC_c6&_nc_oc=AdlEoheRWIb3PwjZFGWx_Wi7YezjLFwiznskULwODd6LrAxGdV9UBKtbLmotYS4wVm4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsAW1wqAhVhRMCfrhEoKiNjfpTC96QNVA4wsXlosO9PqA&oe=69A1A3CB"}, "display_name": "Possibl", "keywords": [], "long_description": "Possibl bietet Virtual-Reality-Trainings f\u00fcr Arbeitssicherheit, Vertrieb, Sales und viele weitere Bereiche an. Neben dem individuellen Lernen ist auch ein Lernen in Gruppen m\u00f6glich und sogar Gruppencoachings k\u00f6nnen bei uns problemlos absolviert werden. Neben dem Lernmodus bietet Possibl auch einen Pr\u00fcfungsmodus, in dem der Lernerfolg gepr\u00fcft werden kann.", "short_description": "Possibl ist die Plattform f\u00fcr professionelle Virtual Reality Trainings und Schulungen im Arbeitsumfeld.  Wir bieten Ihnen effektive Trainings, sofort einsatzbereit."}, {"images": {"nodes": [{"file_name": "Logo_Transparent_Posibl_Brand_for_Oculus.png", "id": "1456172264724894", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57572936_1456172274724893_7811624550343936119_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI8wY3i_LD8Q7kNvwF8cfsb&_nc_oc=AdkevUlp44LMF-w1j75BbmTqn1NnfMPCQXLzMZHcTRdCEgyOVB-tHMismuL2sUAsDzY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfviSMDP72vbs0QwyPIr7JMLi8F6_2f_lvni48G4d7_qbg&oe=69A1845A"}, {"file_name": "Hero_Cover_Posibl_Brand_for_Oculus \u2013 1.png", "id": "1141819556291489", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75451772_1141819559624822_7623867907620178626_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P2qG3sxQK4Q7kNvwH6n6BM&_nc_oc=Adn8hMoCuO_kukoTJ
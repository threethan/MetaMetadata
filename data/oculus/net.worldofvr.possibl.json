wCATeC-mRM6DKA0KCc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uHZw_5HRGlRfR5W0DJk5AIWtxfwojvRaA6KEDDfN2Aw&oe=69E23411"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project_Possibl_Kathrin_Hallo_2021-04-09_18.00.43.png", "id": "441688053593859", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75210889_441688056927192_2539482727317571655_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDPYNRjwf-kQ7kNvwFlRaGS&_nc_oc=Adr_lBuL7-LMFofP4hTxvAzOtUTUqK0WYhUWvnYEndDC45NSTLnNVZZFlBERNNBV8DE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LVLgKT-jRn0vCvD5fOMvZES_i_u3BeTCDDEWXC6R5jQ&oe=69E23D4B"}, "display_name": "Possibl", "keywords": [], "long_description": "Possibl bietet Virtual-Reality-Trainings f\u00fcr Arbeitssicherheit, Vertrieb, Sales und viele weitere Bereiche an. Neben dem individuellen Lernen ist auch ein Lernen in Gruppen m\u00f6glich und sogar Gruppencoachings k\u00f6nnen bei uns problemlos absolviert werden. Neben dem Lernmodus bietet Possibl auch einen Pr\u00fcfungsmodus, in dem der Lernerfolg gepr\u00fcft werden kann.", "short_description": "Possibl ist die Plattform f\u00fcr professionelle Virtual Reality Trainings und Schulungen im Arbeitsumfeld.  Wir bieten Ihnen effektive Trainings, sofort einsatzbereit."}, {"images": {"nodes": [{"file_name": "Logo_Transparent_Posibl_Brand_for_Oculus.png", "id": "1456172264724894", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57572936_1456172274724893_7811624550343936119_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCEni5exQQwQ7kNvwGkQBXz&_nc_oc=Adp7t_WZ9l7qKz5THjkmllGQts4Rm0PzgO0WKm_HJbQ7HD6_8JqzD2Fn-itcfiRF4ns&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lH3D-gGhYISkU8YFXikRmtSf-diFc9q80cW8994CgbA&oe=69E21DDA"}, {"file_name": "Hero_Cover_Posibl_Brand_for_Oculus \u2013 1.png", "id": "1141819556291489", "image_type": "APP_IMG_HERO", "uri": "https://scont
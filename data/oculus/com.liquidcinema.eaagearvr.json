7a0a&_nc_ohc=UfeV4FckrokQ7kNvwHypDUV&_nc_oc=AdlGU3FxtFTUZnjlZAazi_xBT4pCTZoYBZxFp8wYV96pHFs85v3SX_0thRYZ-wHufUk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzhT_jVpK1oy48ISdiyCWTpWEGKqD1s6UGSQPAUF-FTvA&oe=69AAC5F0"}, {"file_name": "migrated_image.png", "id": "632888014176109", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162731_335568550217296_4379027107427123200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDaBvrZMLWQQ7kNvwGIdr4s&_nc_oc=AdmJbOHIwBYQmTbtgJ7mA933OXe2iQA1ZbWEltBjVR-9SnXeTyaMmI78F2gAG83vtms&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVX_lK-1Wh79msuo_XJsYjjgak0H_5HF-q_vL6xJ3bzQ&oe=69AAC59D"}, {"file_name": "migrated_image.png", "id": "512654792775710", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162707_1959155564349770_3011727709014327296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4UDCPa4HwkQ7kNvwFi4AW2&_nc_oc=AdlEVvDhm-WsAzT5uHSvE1I7Rg81okzEa7JSqK7kzcVaLmV7FqPfCMG7w23auC79Tck&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZgpzlSRcqAxcj1uCR4sRBrq63zEk0WWWpH_P3hTBIYw&oe=69AAD676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EAA 360", "keywords": ["Virtual", "360", "VR", "Flying", "reality"], "long_description": "\"Take flight with EAA\u2019s 360 and virtual reality videos.\nExperience the real life sensation and excitement of flight with your virtual reality headset or Google Cardboard. This collection of 360 videos and virtual reality experiences take you through various aspects of general aviation. Plus, get experiences and point of views that aren\u2019t available anywhere else; from the cockpit of an aerobatic plane to the pyrotechnic line during airshows, under a 26 ton water drop and more!\nEAA is a community of passionate aviation enthusiasts that promotes and supports recreational flying, of all types! Offering free introductory flights through EAA Young Eagles and hosting the World\u2019s Largest Aviation Celebration in Oshkosh, WI every year.  Learn more at www.eaa.org. \n\"", "short_description": "Take flight with EAA\u2019s 360 and virtual reality videos."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.eaa.org/en/eaa/privacypolicy", "developer_terms_of_service_url": "http://www.eaa.org/en/eaa/privacypolicy", "publisher_name": "Experimental Aircraft Association, Inc.", "support_website_url": null, "website_url": "http://www.eaa.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "EDUCATIONAL", "MOVIE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "419676289952632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162706_1843189345708008_2900385758516871168_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdrX5xcx7PAQ7kNvwHILmx7&_nc_oc=AdmZOORy3SB8wHKFEIjACT-1ztSjypGjFgclK9j-l3wHV88sWZ8CIWxjA6UG3lQ4_AM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRP8K7TQarisIHywR--rbcb1gNt1rGM3dTBknK4ed39A&oe=69AAC975"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EAA 360", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1505926002, "lastRevision": {"nodes": [{"id": "1225065620971934", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1441572095934452", "is_first_party": false, "enables_in_app_ads": false, "is_concept": fa
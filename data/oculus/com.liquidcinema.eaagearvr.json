_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OCfxfwtq5AQ7kNvwE5H4fo&_nc_oc=AdpTdHVC0rtXUrw8IuiPI-FHBpXc5BTXCsDF9J3uB7DujeVynpM0z2KgC5GK2ANNU5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLgPCoFpsrNgBh9BpVbZaNrEYFoan2_5EkYqN3oS8ACA&oe=6A786FF0"}, {"file_name": "migrated_image.png", "id": "632888014176109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_335568550217296_4379027107427123200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuNKyoSqAq8Q7kNvwG0wLp7&_nc_oc=AdoNdhE-pFMvaQtXrhfkHq49uBFzN5f0NtU4BDF6UItUZiOGEPx-JQFp6dgE0doYk_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyAivO7j5erBoks6VN4FxkerwMsmhFzO1B-aCBRFb-nA&oe=6A786F9D"}, {"file_name": "migrated_image.png", "id": "512654792775710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162707_1959155564349770_3011727709014327296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ4kFYEXa-8Q7kNvwEMWq1S&_nc_oc=Adr_woGB-a-8WubnguXC5I9pv70buUgxSGth71V0EFMT1oIO-CS9goKKPxJ08ju48AE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGqTy-jMgmxu7Ecj_m8PAgkCsHQJ3FawaLPMEu8c19_g&oe=6A788076"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EAA 360", "keywords": ["Virtual", "360", "VR", "Flying", "reality"], "long_description": "\"Take flight with EAA\u2019s 360 and virtual reality videos.\nExperience the real life sensation and excitement of flight with your virtual reality headset or Google Cardboard. This collection of 360 videos and virtual reality experiences take you through various aspects of general aviation. Plus, get experiences and point of views that aren\u2019t available anywhere else; from the cockpit of an aerobatic plane to the pyrotechnic line during airshows, under a 26 ton water drop and more!\nEAA is a community of passionate aviation enthusiasts that promotes and supports recreational flying, of all types! Offering free introductory flights through EAA Young Eagles and hosting the World\u2019s Largest Aviation Celebration in Oshkosh, WI every year.  Learn more at www.eaa.org. \n\"", "short_description": "Take flight with EAA\u2019s 360 and virtual reality videos."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.eaa.org/en/eaa/privacypolicy", "developer_terms_of_service_url": "http://www.eaa.org/en/eaa/privacypolicy", "publisher_name": "Experimental Aircraft Association, Inc.", "support_website_url": null, "website_url": "http://www.eaa.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "EDUCATIONAL", "MOVIE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "419676289952632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1843189345708008_2900385758516871168_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzdsrq-Ts44Q7kNvwGfM3dn&_nc_oc=AdpKZfBcZJ8Fo2dHLhbdxnSwAd7WwI5pqiPwfz8SMueYpQNvThNqe3mK2GrrPWoLVA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmCSavfwAo7C68mp8tW-DQubiwvJHwGd8cIsLZttLQBQ&oe=6A787375"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EAA 360", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1505926002, "lastRevision": {"nodes": [{"id": "1225065620971934", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1441572095934452", "is_first_party": false, "en
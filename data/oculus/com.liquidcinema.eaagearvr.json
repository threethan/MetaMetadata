_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Of8J08cd2YQ7kNvwHE1imc&_nc_oc=AdrP_05K66QH81PUlFe4fgvKn9aeRtrGZS1VrGR8zl9mkpNtQ16QDu6QeAS9tXcsijs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq9sz9KyjWSn1ItRQNd5cJdoYeilH01DlnnKZragL3tQ&oe=69CE5E70"}, {"file_name": "migrated_image.png", "id": "632888014176109", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_335568550217296_4379027107427123200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhAVUHgUfXYQ7kNvwHs78Wy&_nc_oc=AdpYRj7pMXwp1f57kXpPTUf1BuG9zM7mM4aOAZ4EkPuC7qPwSg-bPX0mFKBSNV9BeEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMm040IaSRZAGzTOcICyMxE1Y5u6WqYIu8-clmowcV9A&oe=69CE5E1D"}, {"file_name": "migrated_image.png", "id": "512654792775710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1959155564349770_3011727709014327296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1pIWYFmtQoQ7kNvwHTsQIw&_nc_oc=AdoFMjgkSCLCtYMpx5NkhR-0y0OjIAfJFc9XS20QcAvqmb413Y8nAyv5-iv89bFw3FI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmmKuwSw154h0JetCpDLa7aWfwRsR6OIJ1g_J4bCIB2g&oe=69CE6EF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EAA 360", "keywords": ["Virtual", "360", "VR", "Flying", "reality"], "long_description": "\"Take flight with EAA\u2019s 360 and virtual reality videos.\nExperience the real life sensation and excitement of flight with your virtual reality headset or Google Cardboard. This collection of 360 videos and virtual reality experiences take you through various aspects of general aviation. Plus, get experiences and point of views that aren\u2019t available anywhere else; from the cockpit of an aerobatic plane to the pyrotechnic line during airshows, under a 26 ton water drop and more!\nEAA is a community of passionate aviation enthusiasts that promotes and supports recreational flying, of all types! Offering free introductory flights through EAA Young Eagles and hosting the World\u2019s Largest Aviation Celebration in Oshkosh, WI every year.  Learn more at www.eaa.org. \n\"", "short_description": "Take flight with EAA\u2019s 360 and virtual reality videos."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.eaa.org/en/eaa/privacypolicy", "developer_terms_of_service_url": "http://www.eaa.org/en/eaa/privacypolicy", "publisher_name": "Experimental Aircraft Association, Inc.", "support_website_url": null, "website_url": "http://www.eaa.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "EDUCATIONAL", "MOVIE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "419676289952632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_1843189345708008_2900385758516871168_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMp2NM1xmnQQ7kNvwGq92-9&_nc_oc=Adr3G7ZLIvuFpyxfedoE0XifTCy7uWLlKyhcunnIGtQGyvFWvlGQaTEoFKfg68qKs9w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEKhfFMECULOS5Crt1jJs-DZfdJPMRU9MFDyixo76ybg&oe=69CE61F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EAA 360", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1505926002, "lastRevision": {"nodes": [{"id": "1225065620971934", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1441572095934452", "is_first_party": false, "en
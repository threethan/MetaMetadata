219456_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xKZHC8vn9wQ7kNvwHv4teV&_nc_oc=Adq4ETzAuvLfCDij0B36ghsOTR_NIigrMUiW-3cjyqkUgGFz948xbh6FSY_meL1A2WU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_MWW-LIR-wqstuL7GJ9JKGgv_ZB8bMnje-EHwjJcZOg&oe=6A8D87F0"}, {"file_name": "migrated_image.png", "id": "632888014176109", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162731_335568550217296_4379027107427123200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKaBPlEWOg8Q7kNvwHxr38w&_nc_oc=Adp43WS9v8feHrtMc7SYXjzI6cqaU0o3g27dN_VNx6iwEnXKdWoMG645lCUduI5zEaI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHh8vjWniuQLSQT0lsGGK9qdAX5GCnvz91lRY4sb3myA&oe=6A8D879D"}, {"file_name": "migrated_image.png", "id": "512654792775710", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162707_1959155564349770_3011727709014327296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VwIpxFxWOEQ7kNvwEm2qsz&_nc_oc=AdrXn3QTZekvVKEjFFEXKhW7xhUcxn97aVz9SOh1BGWV-i7GQE6ZmZFq1Zh4vW5zbpI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_2i7IXipjKjclsRNb_7NXu3y4qc4JwrrMuCtyAEzK4w&oe=6A8D9876"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EAA 360", "keywords": ["Virtual", "360", "VR", "Flying", "reality"], "long_description": "\"Take flight with EAA\u2019s 360 and virtual reality videos.\nExperience the real life sensation and excitement of flight with your virtual reality headset or Google Cardboard. This collection of 360 videos and virtual reality experiences take you through various aspects of general aviation. Plus, get experiences and point of views that aren\u2019t available anywhere else; from the cockpit of an aerobatic plane to the pyrotechnic line during airshows, under a 26 ton water drop and more!\nEAA is a community of passionate aviation enthusiasts that promotes and supports recreational flying, of all types! Offering free introductory flights through EAA Young Eagles and hosting the World\u2019s Largest Aviation Celebration in Oshkosh, WI every year.  Learn more at www.eaa.org. \n\"", "short_description": "Take flight with EAA\u2019s 360 and virtual reality videos."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.eaa.org/en/eaa/privacypolicy", "developer_terms_of_service_url": "http://www.eaa.org/en/eaa/privacypolicy", "publisher_name": "Experimental Aircraft Association, Inc.", "support_website_url": null, "website_url": "http://www.eaa.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "EDUCATIONAL", "MOVIE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "419676289952632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162706_1843189345708008_2900385758516871168_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1NTuLTZWOUQ7kNvwGalKCg&_nc_oc=Adrg_EMPfh6tBD3NlllbLeKI0izFFnuVDVPx_Qow5S-mpoc12bGQPMqsNjywfPAfG7c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv94ew4Ns-54jFBKUEnFctvGkRMx4_z6QtX3AtUgMmWw&oe=6A8D8B75"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EAA 360", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1505926002, "lastRevision": {"nodes": [{"id": "1225065620971934", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1441572095934452", "is_first_
_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjgKlXfsN_0Q7kNvwHLV2BQ&_nc_oc=AdqICpEJ9ul-QxA8c6-gwp6e9ivWCvu2DnJdjQhH-O8IQzOaWnvJWRnXuDg_l8lzP-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXcPPuIBZk2jo2rkEUv_hfmuOBHVQJf_q_sqLqHedZ8A&oe=6AA7E5F0"}, {"file_name": "migrated_image.png", "id": "632888014176109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_335568550217296_4379027107427123200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YPKw07pcqMQ7kNvwHQQkD4&_nc_oc=AdpOsm84HZnLQWH4A1uGGxxu8bRmOekvOWAvtm1KpK69uVLU9fZxBAxt-R9MLlEJqTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfkW0-1VVt-84I9ia_7NXIAZbgtn5FcWlPpUu4GNmQ7g&oe=6AA7E59D"}, {"file_name": "migrated_image.png", "id": "512654792775710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162707_1959155564349770_3011727709014327296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f84hPvUx6k4Q7kNvwE3jsR4&_nc_oc=AdqHj3xRphHeX_ARw53iFFdjvE5tn3mavInIH1kEZGc-0ob4V3K2asWHvi61wAqPvX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_ny1PaKGWNQsnUaac7IXHqcOSO9_3d2rpQxZ22fKuCw&oe=6AA7F676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EAA 360", "keywords": ["Virtual", "360", "VR", "Flying", "reality"], "long_description": "\"Take flight with EAA\u2019s 360 and virtual reality videos.\nExperience the real life sensation and excitement of flight with your virtual reality headset or Google Cardboard. This collection of 360 videos and virtual reality experiences take you through various aspects of general aviation. Plus, get experiences and point of views that aren\u2019t available anywhere else; from the cockpit of an aerobatic plane to the pyrotechnic line during airshows, under a 26 ton water drop and more!\nEAA is a community of passionate aviation enthusiasts that promotes and supports recreational flying, of all types! Offering free introductory flights through EAA Young Eagles and hosting the World\u2019s Largest Aviation Celebration in Oshkosh, WI every year.  Learn more at www.eaa.org. \n\"", "short_description": "Take flight with EAA\u2019s 360 and virtual reality videos."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.eaa.org/en/eaa/privacypolicy", "developer_terms_of_service_url": "http://www.eaa.org/en/eaa/privacypolicy", "publisher_name": "Experimental Aircraft Association, Inc.", "support_website_url": null, "website_url": "http://www.eaa.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "EDUCATIONAL", "MOVIE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "419676289952632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1843189345708008_2900385758516871168_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGuNjtiKU14Q7kNvwGqbx2z&_nc_oc=Adr29LOFP5HCQcJiDIbHRF2F8hOciFH3RhQo6ixTb3yOkEV6IRHhzhgxMImCro-e4CY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3GwQyKO0-epNMP9AmaWkouMDM5l-v-TFs4dm1wFt5sA&oe=6AA7E975"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EAA 360", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1505926002, "lastRevision": {"nodes": [{"id": "1225065620971934", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1441572095934452", "is_first_party": false, "en
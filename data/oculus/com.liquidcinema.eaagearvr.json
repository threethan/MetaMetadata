_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7RNCNB8Fx4Q7kNvwFDTL7v&_nc_oc=AdrCJ85cQF2bOh5E1shiQWA_qhZ3sKz5xqe73Vkkrmh-6mzlGCGhAP1vQGzGFcWZ4WY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJktAkUFsMxvLw_zKgGJiLAbVgguQSycB_I3YM10yr4mg&oe=6AB3C370"}, {"file_name": "migrated_image.png", "id": "632888014176109", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_335568550217296_4379027107427123200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBH11NHSlWQQ7kNvwGb8rys&_nc_oc=AdrdjkqTnrrlk6I7BfzvXy4EIb2HDI_Wy5K_Ma3nO4uzTZiOADflvFV7q4lqu3mui7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL4PKnU_nglX_QfBqOQMJEeK8UW8ZkdnkxwGjT3aMohQ&oe=6AB3C31D"}, {"file_name": "migrated_image.png", "id": "512654792775710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_1959155564349770_3011727709014327296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8yDuV3Rh_QQ7kNvwHK7uvq&_nc_oc=AdpqtrcF-N1_WnSOYHEpx3ONIN5yd8OAhhnD-GnFOEqdU-E7MCHqSzp3excYLInyF7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_p4JrrkmuQxayflPzXcMlU2nU9XbQ2H9um7aJN1_tKQ&oe=6AB3D3F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EAA 360", "keywords": ["Virtual", "360", "VR", "Flying", "reality"], "long_description": "\"Take flight with EAA\u2019s 360 and virtual reality videos.\nExperience the real life sensation and excitement of flight with your virtual reality headset or Google Cardboard. This collection of 360 videos and virtual reality experiences take you through various aspects of general aviation. Plus, get experiences and point of views that aren\u2019t available anywhere else; from the cockpit of an aerobatic plane to the pyrotechnic line during airshows, under a 26 ton water drop and more!\nEAA is a community of passionate aviation enthusiasts that promotes and supports recreational flying, of all types! Offering free introductory flights through EAA Young Eagles and hosting the World\u2019s Largest Aviation Celebration in Oshkosh, WI every year.  Learn more at www.eaa.org. \n\"", "short_description": "Take flight with EAA\u2019s 360 and virtual reality videos."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.eaa.org/en/eaa/privacypolicy", "developer_terms_of_service_url": "http://www.eaa.org/en/eaa/privacypolicy", "publisher_name": "Experimental Aircraft Association, Inc.", "support_website_url": null, "website_url": "http://www.eaa.org/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "EDUCATIONAL", "MOVIE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "419676289952632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162706_1843189345708008_2900385758516871168_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y0bcd3HUyIQ7kNvwFD1Tdm&_nc_oc=AdpNrx5wNtr-5xOCy9dpEHN_VNeqZmgC8VjWyFus3GSrCMna_kyWyQFI0eUwBz5qFFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7ryNn_2ZcOOkQewEZwkzjiO8Vu_wIUtkiB8wCiwYf9g&oe=6AB3C6F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EAA 360", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1505926002, "lastRevision": {"nodes": [{"id": "1225065620971934", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1441572095934452", "is_first_party": false, "en
_PHy-p-i0bKOCdM5Zx8-ihTbfkOojY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnnlPXm8pmJs8IriwnGnAFWjW7kNm1wUG7L9fiXRghDw&oe=6AAFED28"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(1).png", "id": "2512656605772229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_2512656609105562_3003886504710913853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAEWHgMrjD4Q7kNvwFp27B3&_nc_oc=AdpqBPhhcFJhizhFgu6tB8MtMhxbhk2_R_lgbc_l-fujWPsKJ767JEr-OorRwRWrSkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa-rdfcyjq7nlCeOm9bzIN34yW3758A2H22NVcGkddZQ&oe=6AAFEBFC"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(3).png", "id": "2625272311164193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295625_2625272314497526_3350721239664333417_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6BV49LKzKEQ7kNvwE-aA_M&_nc_oc=AdrB7TfK5voDEjWBahG3io7n86-FCuWPoIU5Vali69QMTDQHOuNTaKsgb9HteIDd7sc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSZnXWSM4ALIgwlwP2L4RhVBF0_1ovO1P4d9dYTRhsoA&oe=6AAFEACA"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(4).png", "id": "1709030593136977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311558_1709030596470310_5012350818877405887_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye5ZrwwwozAQ7kNvwG02Wkj&_nc_oc=Adr_86JH24UqRFGKGPNkScJgq-iffomrjV3eOpyWGmV6krRHycQwzAGvwMAfcSuCe4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKh5sFV1Mabb9jL8qKNVw52J3mU5qmJlclyFfef2GSYA&oe=6AAFD5E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoalieXR", "keywords": [], "long_description": "GoalieXR transforms your real-world space into a high-stakes soccer arena. Built for Meta Quest\u2019s Mixed Reality capabilities, this immersive experience puts you in the goalkeeper\u2019s gloves\u2014dodging, diving, and catching blazing-fast balls right in your living room.\n\n\ud83c\udfe0 Mixed Reality Gameplay\n\nYour
htBolB_X4mgGTi9kfHEBQI14huOs2c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOMT_eQuxgcl6f713Qf4_1abCujmFfH8U7HKlQZq--Cg&oe=6A803EE8"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(1).png", "id": "2512656605772229", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619485_2512656609105562_3003886504710913853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRsbiL7hGUcQ7kNvwFmSLFC&_nc_oc=Ado4F5LMz2-g37C00Yq-i9RFHfBJrHEwJQoz2BcFKzB8KrbynYuwHz7iQW67suVPYns&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBxKsUa3Rg2OaHSsEcYRhyZS50D9jS0TisuDXp9ayLjQ&oe=6A803DBC"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(3).png", "id": "2625272311164193", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499295625_2625272314497526_3350721239664333417_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXwWXnBCQ1cQ7kNvwEtuw-k&_nc_oc=AdpNS-gwTf5dyJqFw5ZUOH-NKXoxmdumZQZJdun_hZKKPMwaooGt85ph2yBaGhG1NW0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESADA6mh_Nk14CQUGG7s0GJI1BeP7Ix_2jqFLLP8mtLw&oe=6A803C8A"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(4).png", "id": "1709030593136977", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499311558_1709030596470310_5012350818877405887_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IbjGG_Q2GYQ7kNvwE8CLWo&_nc_oc=Ado-fR2TvnnGqEp55URF8kJXxTtdBPYh_M7XmfILStbDwFsFi-jPn_ltK8_Ubrd3MTE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa14jj-7i1GEC6W51yTvB-ZLpI285-mWIdq8ENrb0vmg&oe=6A805FE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoalieXR", "keywords": [], "long_description": "GoalieXR transforms your real-world space into a high-stakes soccer arena. Built for Meta Quest\u2019s Mixed Reality capabilities, this immersive experience puts you in the goalkeeper\u2019s gloves\u2014dodging, diving, and catching blazing-fast balls right in your living room.\n\n\ud83c\udfe0 Mixed Reality Gameplay\n\nYour
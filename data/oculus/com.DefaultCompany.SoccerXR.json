0_1917721308799131_7993570981820438448_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIDVfxQQuZIQ7kNvwEKCZe5&_nc_oc=AdpPgw3GO2VB-caOsqUtvFexnt0dw0ll5KybBGcy2Heyj9qEkAqkOVjRl9Ioh33DP14&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTguPkxi3v3_j0Hok4c8W6vl7xtliQbF_PtODTdo7bRRg&oe=6B0B1CE8"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(1).png", "id": "2512656605772229", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619485_2512656609105562_3003886504710913853_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWxI2tsxt6IQ7kNvwHZImhj&_nc_oc=AdpJUt07TAg3tZjRSEhqaVjAn_r-W2C2YVrEQWAnWLmlGYxhsRikKgL6jweYwXpnVh8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4g4K8CpSESVHe4q5gLwAXCpwDsg1HtDw537QJemXSDg&oe=6B0B1BBC"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(3).png", "id": "2625272311164193", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295625_2625272314497526_3350721239664333417_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXKzHAYhwAsQ7kNvwFw0pTR&_nc_oc=AdqFNSOYB6riEk7YrM1-8SzCU3zHnnjjUOwlcmxwI_TkRIjmFnYUwfccHb6wzKBxjgg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRhfhpEPyKkwIP2Jixp5v7nj9zlMSN1_eusy2P1yTB5A&oe=6B0B1A8A"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(4).png", "id": "1709030593136977", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311558_1709030596470310_5012350818877405887_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38Njz6gfdLkQ7kNvwEVzr2R&_nc_oc=AdrpkMVLd-8hZikuoQY-9TlRUcusBedJG0TrlunGIMa--dVaVSLiGAxoFKA4DocLfxg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwvv8zWl1HCzTmT5qJQemrkzknvX8hjFlVWYk4Co_qXQ&oe=6B0B3DE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoalieXR", "keywords": [], "long_description": "GoalieXR transforms your real-world space into a high-stakes soccer arena. Built for Meta Quest\u2019s Mixed Reality capabilities, this immersive experience puts you in the goalkeeper\u2019s gloves\u2014dodging, diving, and catching blazing-fast balls right in your living room.\n\n\ud83c\udfe0 Mixed Reality Gameplay\n\nYour physical environment becomes the pitch\n\nBalls curve, dip, and rocket toward you from dynamic angles\n\nPrecision hand tracking delivers lifelike saves and reactions\n\n\ud83c\udfae Features\n\nAdaptive difficulty that scales with your reflexes\n\nGlobal leaderboards to challenge friends and rivals\n\nReplay mode for influencer-ready highlight clips\n\nCampaign overlays for viral launch strategies\n\nWhether you're training your instincts or showcasing your skills, GoalieXR delivers the thrill of elite goalkeeping\u2014right where you stand.", "short_description": "Defend your goal in MR\u2014catch blazing soccer balls in GoalieXR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/93d52aea-deda-4b12-a582-038ce6aa07f4", "developer_terms_of_service_url": null, "publisher_name": "Xzec Gaming", "support_website_url": null, "website_url": "https://sidequestvr.com/app/17969/goaliexr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25457984713788188"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculus
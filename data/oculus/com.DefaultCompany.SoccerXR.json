wBN9aVRtJSqBwhoZ77dcuCp3BqhDCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEvBnSas48kj7rHwm1htQzEQkcU1gjrXywKcR1nyqRtg&oe=6A9EC9A8"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(1).png", "id": "2512656605772229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619485_2512656609105562_3003886504710913853_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3kgDxsb4N4Q7kNvwG7VoBm&_nc_oc=AdqYtevm-o2Jl5ew3NurFLSYmH3P5zDh--0jfFcqS8gvY9as-KlBWgQ_t-4AMWhVLc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL40BryTnVbEtw_1BrdYs8GqMqUessdDT0aZGt7xrbtjA&oe=6A9EC87C"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(3).png", "id": "2625272311164193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295625_2625272314497526_3350721239664333417_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGp8v1RszK8Q7kNvwHm3xyk&_nc_oc=Adqvpb5P_mcBeQQKx34OM0TjSbf9YkTbsobFvoYcgxbcRr098ITtwPmPuxj0A8wpXuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZBJlfATngiE2vmMBS57hWkHmZ9Le28dJnGaU03uz2Qg&oe=6A9EC74A"}, {"file_name": "fd26d2164b0082bdb91e85b79c42ccdc(4).png", "id": "1709030593136977", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311558_1709030596470310_5012350818877405887_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NgXDxzQ4J8Q7kNvwEQVY6f&_nc_oc=AdrUMWkCSOfdarZ8P0kbT-qk-VV9V18-k9ABtUkSEnJpi4NwKVQahVbLiGlqwOD9GXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJccZus_bfoN6LuQpD-9dO4CN34PgdzmRuSQj7uht7MbA&oe=6A9EB261"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GoalieXR", "keywords": [], "long_description": "GoalieXR transforms your real-world space into a high-stakes soccer arena. Built for Meta Quest\u2019s Mixed Reality capabilities, this immersive experience puts you in the goalkeeper\u2019s gloves\u2014dodging, diving, and catching blazing-fast balls right in your living room.\n\n\ud83c\udfe0 Mixed Reality Gameplay\n\nYour
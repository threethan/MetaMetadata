-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLtJ6dSO87Lk8Z8NyANqIRTNET77O3lSe5fB2pB3rUBw&oe=6A95B978"}, {"file_name": "audienceSelfie2.png", "id": "905084718475997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982672_905084721809330_5288877997263683448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tBxUklAWTQQ7kNvwEqsZC6&_nc_oc=Ado5nHAxtFS9l4c1ALdF8kTWEkCuOh2SWsD8mvXvpdeKGyQ2wPxyjWEiecDq-LFdOoQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDxXSPd6ICQxuIptYi-uPfW5HWIbdpnLBdpdJ0Mw8Ttg&oe=6A95E10D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "performance.png", "id": "1165920501766480", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1165920505099813_7391780715915114790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAPgiecQ5fsQ7kNvwHKP7BT&_nc_oc=AdpESC4_V7WVAokeEZCVwZtWfrfmh39Jdctmhu5F0MD5XkV-RLqiABhwGn7KXWDG8u4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_QpoV-u2dF-vRE7a73tkag6eyhkVZKuIA_x_BYo17-w&oe=6A95C403"}, "display_name": "StageTime", "keywords": ["karaoke", "sing", "music", "perform", "stage"], "long_description": "### \ud83c\udfad **StageTime** \ud83c\udfad  \n\nWelcome to **StageTime**, the ultimate virtual venue for live performances, creative expression, and social connection!  \n\n#### \ud83c\udf1f **Why You\u2019ll Love StageTime**  \n\n- **Instant Access:** Jump into a vibrant virtual venue within seconds and start performing or watching live content.  \n- **Perform & Entertain:** Share your favorite music, comedy, or creative content on stage for others to enjoy.  \n- **Connect & Socialize:** Meet new people or enjoy shared experiences with friends in a welcoming, lively environment.  \n- **Customizable Avatars:** Express yourself with personalized avatars and unique styles. \n- **Content Creation**: Easily record your own videos in app with our camera\n- **Evolving Platform:** Regular updates to features and settings keep the experience fresh and exciting.  \n\n#### \u2728 **Perfect for Everyone**  \n\nWhether you want to share your creativity, enjoy live performances, or simply hang out, **StageTime** offers an intuitive, engaging platform for all.  \n\n#### \ud83d\ude80 **Take the Stage Today**  \n\nJoin **StageTime** now and discover the perfect place to connect, perform, and create lasting memories in a vibrant virtual world.", "short_description": "Step into a vibrant virtual venue where creativity meets connection. Watch and perform your favourite content, customize your avatar, and engage with a lively community. With instant access to a welcoming public hub, StageTime is the perfect place to meet new people, express yourself, and enjoy unforgettable shared experiences. Whether you're here to perform or connect, the stage is yours. \ud83c\udfb6\u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stagetimevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuware Ltd", "support_website_url": null, "website_url": "https://stagetimevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8942709132509188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "10055299054496911"}]}, "baseline_offer": {"id": "10055299054496911"}, "is_approved": true, "fir
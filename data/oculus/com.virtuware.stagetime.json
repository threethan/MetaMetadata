ro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAdcTSJkxSe16fJQlxIHIzl7K2uKhEs6QjYhKUKXP-rw&oe=6A974338"}, {"file_name": "audienceSelfie2.png", "id": "905084718475997", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982672_905084721809330_5288877997263683448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3odKUrZrn0Q7kNvwEZikWJ&_nc_oc=AdqY3fQCdlb_Y38fhIpF7wLKSwqoEOdB6vuxnOxyu3CK4MUTv4N9PMnLWH9l-OWrYm8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk38ktIClAGgisnpBdLgxQkSqaB-niH1hP5ryAab2Pig&oe=6A97328D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "performance.png", "id": "1165920501766480", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75422387_1165920505099813_7391780715915114790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAPgiecQ5fsQ7kNvwEbaNre&_nc_oc=Adr3BNY7q662cYoLldcKBHvMtMnr9WMbpbMg_Cz4e9bQmpzjG_35HxyjiNZ1FTXsq7M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf0LuLIvk5I84H9QMBjJ9ONgKmWRcV7MeSczQivWqvMw&oe=6A974DC3"}, "display_name": "StageTime", "keywords": ["karaoke", "sing", "music", "perform", "stage"], "long_description": "### \ud83c\udfad **StageTime** \ud83c\udfad  \n\nWelcome to **StageTime**, the ultimate virtual venue for live performances, creative expression, and social connection!  \n\n#### \ud83c\udf1f **Why You\u2019ll Love StageTime**  \n\n- **Instant Access:** Jump into a vibrant virtual venue within seconds and start performing or watching live content.  \n- **Perform & Entertain:** Share your favorite music, comedy, or creative content on stage for others to enjoy.  \n- **Connect & Socialize:** Meet new people or enjoy shared experiences with friends in a welcoming, lively environment.  \n- **Customizable Avatars:** Express yourself with personalized avatars and unique styles. \n- **Content Creation**: Easily record your own videos in app with our camera\n- **Evolving Platform:** Regular updates to features and settings keep the experience fresh and exciting.  \n\n#### \u2728 **Perfect for Everyone**  \n\nWhether you want to share your creativity, enjoy live performances, or simply hang out, **StageTime** offers an intuitive, engaging platform for all.  \n\n#### \ud83d\ude80 **Take the Stage Today**  \n\nJoin **StageTime** now and discover the perfect place to connect, perform, and create lasting memories in a vibrant virtual world.", "short_description": "Step into a vibrant virtual venue where creativity meets connection. Watch and perform your favourite content, customize your avatar, and engage with a lively community. With instant access to a welcoming public hub, StageTime is the perfect place to meet new people, express yourself, and enjoy unforgettable shared experiences. Whether you're here to perform or connect, the stage is yours. \ud83c\udfb6\u2728"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stagetimevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtuware Ltd", "support_website_url": null, "website_url": "https://stagetimevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8942709132509188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "10055299054496911"}]}, "baseline_offer": {"id": "10055299054496911"}, "is_approved": true, "first
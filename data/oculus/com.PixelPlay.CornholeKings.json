.com/v/t64.5771-25/38974493_280381654041566_142084116441005820_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bZPeCeieOwQ7kNvwEqdIZa&_nc_oc=Adr0YrQuAK_eAijUsMwPBchuJoXz8g4xJfQ1s4S1cTcRYtOMqD1aAfiC0EKTEd4vmx0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCnLH3J2FEKyxzUpDN1sZXVahduxFhr0Pf3CyeE0BP3Q&oe=6A7DA59E"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WeKgxNjmf8Q7kNvwGUu1kX&_nc_oc=AdpU3OeB2KJSOMpvOjvdnUroyCL1i00OsBxSsW6SucfVak6WqYKC6j54HEU-oVENnFE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBQLy1A0deNC27pBwwlgNk8EbSLrVbrqbE3vwf95f8qg&oe=6A7DA51E"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFa3VLnPNM0Q7kNvwGcrjeS&_nc_oc=Adr4DZaN2hcB2QmDEdeqoL1rFxeEAKk0qHlW42G4liih7oIpIjnppkSyuUhyi7ebTj8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUzMwx-E1u5iXFt_lzKzb6vGfcnsJVU8pZdhCLdY62UA&oe=6A7DA468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qlELrRwuNEQ7kNvwFQ9JgR&_nc_oc=Adq7PLRa4BHe8uIaHAg0sJKMFMxWAAsragNYmjq-9X-15z40zAwxTTCmu1aLxQH6Sb0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHydmqx517jWm876u-T9WKd0TlKcjoSyQoPaK69uQoe9A&oe=6A7D9CCB"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAx2tyWSEicQ7kNvwFtLF9A&_nc_oc=AdqlLZcxT2-BI848UdaYfcsCsJkxkFstY6m7Ca6z-jSJGFtCar1KxlUpbVRDvvCh7Bc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFzB_X0z0_6cp8zHzT85trzELzjf-3gWq2UhLWgGLk8Q&oe=6A7DC6E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category":
wMQ7kNvwFClJuq&_nc_oc=AdkaByMwzvUIOthI0eO0Y0ARvXcy6sO4RjziUAhiSfw6yv9Y7u_-PAk1JYjcLIsOFIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftmY3lIhzL0KN_AoNxIszO_AIvgJDAXq2cusTHXoHEvLQ&oe=699C351E"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZdyki-O1lgQ7kNvwHsOLaD&_nc_oc=AdkxFgqI7UxD0PXIYb331Trd8J2QtdRLZS25rDBUCmMqNW7Sx-yERdm9e19j8Y1fu6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfstTLAC4j6nL6nhsBU8tIrxTLf0gAE9eJynd2HMX6yPzA&oe=699C349E"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=908mAgSHXdIQ7kNvwHS_7p6&_nc_oc=AdlUceDA76zjj5va30RBuYD6lhkUTyMgHzstd03LDrtRak7Y9EZVN2otFl2QpOGmddM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsy_gyBxyFHbRByQy8pZ4lZ5x3m1rHdVch_4RZO6_nQNA&oe=699C33E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNZEozhROxYQ7kNvwHKVoTD&_nc_oc=AdlkdqY5iRUgqrr2dTY4ttdVou3iV0rg296MbHSBYRG3H29aW6UEQXOT3Du2gbNAIUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv6JJTiohXs9QnPwtMBuhQCdmNsEGVRe45J7cUAOYKmaA&oe=699C648B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPEY-F3mPBcQ7kNvwEJS0FB&_nc_oc=AdlC4ouF_ePfYOUATJLyb7uMfsEaOM9oT-0utRC3PhRvgEQrM28Q8HWzOAFc577FtiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsTkO0OCmFgFUr6rkhSvh1F1756cSkKE-8NW28X712CUA&oe=699C5663"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "releas
iwQ7kNvwFBVPTn&_nc_oc=AdkyybE1eJNeVoeLsP7qFASVL83bP7MWBSDckxQSM3-YIOfziljQGds5AT13-1I_RnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv2VLQvFmeV0HfZscm1BqFUSkhLUY_E1wdHi4VzVgPAMg&oe=6999921E"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDeWjd6EC68Q7kNvwFzDKEa&_nc_oc=Adnr2Hs7QIHngjrWsCGmfx1aj0T6hxa1QdF06jlWnTXQJ-uY9IVUGqWGQ4Gj_4V9OvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGaCVtjraX1QUtcbkWqLi5fhjX01Z26sqdGdP7RuLQvQ&oe=6999919E"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=908mAgSHXdIQ7kNvwFW8v0t&_nc_oc=Adl8p_-WHSgCOmvxGUf9pcEke5VxD3a7YEl4kgFlw_Vr2xGKAdCoWMbQgQYQ3dhaXPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudZJHSxrXA_7iMnnV-Z9BBlET8czX0diB3FOakCyO7yA&oe=699990E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbAQsAcCr2UQ7kNvwHe5kDh&_nc_oc=AdmPqAcUAhu354BL2vLtIhbFx1Airy6MOomus6stpfUm9lIfyvnhQNFafR4w_U80mx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftgyDcA2YuL4nQUYWvsc7i3KHeobwTQDaV2KU-gyJdWxQ&oe=6999C18B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z565GuyQrEQ7kNvwGwdE92&_nc_oc=AdlxGXXvG7jVOvlU_uR4dk682Hhp-I6zP7pAGnn7hXFtdyK34LeWifwIHTxGDIgklPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCw9wWBPrr-bkjKrT44xENl3LY4J3_bW1GGMX5_UHJxQ&oe=6999B363"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "releas
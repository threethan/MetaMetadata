.com/v/t64.5771-25/38974493_280381654041566_142084116441005820_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiHzLG1ZJfkQ7kNvwHwpH99&_nc_oc=Adqn75RGXdQHc7s9RQoxjtzpd4Nbpcn6tyEKK0UKtaoKXSGzjqE5RDKhMfpxiBhVH-w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8P-MxsiC-BipQxCw--ZLjjtw8L2kIy0Nsj5-l7ZDe9A&oe=6AAEA55E"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ftYZ7z3tb8Q7kNvwHJzfvT&_nc_oc=AdodmcQ9utfcbmkuEyiyiloYDdshKA9_RDDUlPlvBHanqEkGRcprMw9iyTaF4OFAMMk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9k-tVEg5nL1KZAGUWzRol7B6QtlKB4QUhtsUXNDfv7w&oe=6AAEA4DE"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py1GjMfYgHwQ7kNvwHZICNQ&_nc_oc=AdqU7-qGiC4dF6cuSmSUmwG_eZsu0V3WqM38IAZMjRpILYNwyblOrW9NO5oSIMXehBM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSrbuwBMq8VpGJlpBY5l5gUfTOHCbFA8Hl0AvIoxc7mA&oe=6AAEA428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrMw3DY_6Z4Q7kNvwHAoqXo&_nc_oc=AdrTu7DqBWrdzoV42etHJh-j9T_sXOkvnPHJNdiEKYYQ-ma4yS4CiIOAYOQx_Zvb_ro&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd2iQZ_2259UHwe5WEZ4T7KhdaB4C7Q1Up_0C-OANKwg&oe=6AAE9C8B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61NPhB_DINkQ7kNvwH2FwLz&_nc_oc=Adq7L5_cpBgfnu_P3IUaZWNK32mfFC9lRq3eyFyye-bycdi_HloB4x9suoykG3YviJo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJETVPrY0lE4pdWsCSdSuAefaLfICXCw6LzXzvNNg_W6Q&oe=6AAE8E63"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category":
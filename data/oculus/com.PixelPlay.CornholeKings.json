.com/v/t64.5771-25/38974493_280381654041566_142084116441005820_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnEiQVswWnsQ7kNvwHo81kl&_nc_oc=Adp61-70Hxrjq1zhCC-0OgYZ_it9g38jvH-NVGWDDDzsg7zJrB_pqLgAAdk110s6hdk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4it4TpgwhmKoMiN4kmiQH_L1FAqTTez4aDqLJ8X8P-2w&oe=6A11C2DE"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpzG7YZp8ewQ7kNvwH2poAZ&_nc_oc=Adr2z9l9niaSQthzlcmvjfC1SzBhA_7Vf468BJBhgiib8EcfSay5yw-5FebyC4Ltt1Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Id-2R0FDe5bsWkvUeugbGcDFCADEYAO61snpr3Mx9Kg&oe=6A11C25E"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPwaczqC0eAQ7kNvwFBalin&_nc_oc=Adqwf2XK3ePgzAs_0GzMMRTtn9Yb62TN_oojBFwjOQCzwKSx7QIVdFUTklrCostl1z0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IErtpxRIakYOLiN2ZuzxWGdtam0YGtpeNCm8yZqbXcA&oe=6A11C1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDIHncgOE5wQ7kNvwGNgwY7&_nc_oc=AdpIxx8dLCA8DmclvaZ7q645T85Hk5H46WKK5gqK3ML5gcWMRAVNi1eAUmu7Ey4z9BY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64lXEaLofbV0_gdKyPRFxP8JphVtwXb2orJ2bf7LmKpw&oe=6A11BA0B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PdIfXTMTRAQ7kNvwFrkhqB&_nc_oc=AdqPvJxytmrzEz45loFaCOND1OCUq0kdIAlwfwTPaYchtx2DfgJaoiymyl36xj2DKdE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i5YUitkLeLvTZIp6OLLefrk8KCxopEUUp5Qwv5Q2R_A&oe=6A11ABE3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category":
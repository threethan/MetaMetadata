wMQ7kNvwElQbiH&_nc_oc=AdnOjGStSMNarTvmvnHu4-BabnxLKj7_0yqGtJR1rMqUS1uy9fW9E6l1nl2d2dWWe3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvSXdEhnz0CNSi-EdSqBV9c9V7v_aR9ccXulTyhUg5ung&oe=699ED81E"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8kLECGtZ80Q7kNvwFgQznL&_nc_oc=AdkZz2NV2xWSZqs-6mUMlPAvMv5IzTx62npcr7IMNAXUbhRf9cI7Oo4U1lQdeYhOFzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftgqkBakb6_qwewAeLNAmhTzVSFY0qPlRN6qT-a1ujfng&oe=699ED79E"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATDU7HfSlvkQ7kNvwG58GX0&_nc_oc=AdnPEi0qAC842xTrpgesz0VRUA7u_1j0S9I_JyJ1QHcLog-yKNoMTHQpTfkx1EdqevY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftW2Z19T0ar4JvQbmiVsORvookdEw59Tg0Gzh5evpgLeg&oe=699ED6E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNZEozhROxYQ7kNvwGQXu34&_nc_oc=AdnRAXsMdJnh6AGXh_yu5Frf8wST93uuC1N3Fw-BFJRnIUEOSEYiKjaLHiQGQ0f_nls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfujdIXfY_WgY95Yx-wzfe-YEACydSegX7YkVF-y3CaaGw&oe=699F078B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPEY-F3mPBcQ7kNvwHn8U52&_nc_oc=AdlrQp8YglKF8HvKaUWBrJ6u0wFpeJaIaoGt6QRJ2PU_aM5SrQeGPag0Gr11PU7PB6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuvP5ZJGfYwu09f0_6lJPi90iXNhTr2H-8fInHRBktrqA&oe=699EF963"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "releas
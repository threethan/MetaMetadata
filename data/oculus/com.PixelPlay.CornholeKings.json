.com/v/t64.5771-25/38974493_280381654041566_142084116441005820_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSYqK1NSQaYQ7kNvwFEJ_AA&_nc_oc=Adoy_lHliEHcn9g0pLzWf8fkrYXnltHlqqypGA94Pa5JUxbAK9nn33u_m6cpVd4Scyc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITHkr8u6s3eOxz_BDBRCE5TYdSuvcDceTuyRN2K3LUdQ&oe=6AA95F5E"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2PeU8fIDfcQ7kNvwGhurKm&_nc_oc=AdrssLI1vbGXns_Ko57jLa2AtFk0-pqqphAs20oRxHqDSmyaQ6yiyjCaZwqxKchhJk4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdHAfa5sdaGj2I1fB5eWzkmDdKE68ri-zywukqxLi4KQ&oe=6AA95EDE"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1N3zmhOQGsQ7kNvwELgdjX&_nc_oc=AdpEDJS8sQaaIZYkmq2Ytz2m5963rgByyV9GTG0ZwjsqQ3iYB-GyPDWq17xlRRJIhBA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID2-MoYjm7DdPN8GChU6xinMDpMupI0ik0z9jcL6AtEw&oe=6AA95E28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQJyHnimvWsQ7kNvwHd_jwy&_nc_oc=AdrldRhUDr2wPJDnc_VooDDIievYCJL3xsSdXeIXDs9tw9aGW3gTQmPbzl1wB5OLWC4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxht5_s0YgnQuO4QKfTt1uUInmrEqYe1zsR7HVN2Wv7Q&oe=6AA9568B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RthTzQjfbW0Q7kNvwFySwt4&_nc_oc=AdoMJZ79L0JRO1G9beKq45hAZ2b4k8BMakoxLl-burvUYCrh7vCakp_Zjz_xWLDHRTk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv1l0TDfxU6QDOnk90S_7ui_cjqhY9clZONDe4WwCqoQ&oe=6AA94863"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category":
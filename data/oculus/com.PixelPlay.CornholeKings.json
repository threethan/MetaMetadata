XMQ7kNvwFFCMov&_nc_oc=Adm0LQMp64BaB5aKc06peGSSZr3f_ZC60ZeHpz5GvPDGlS_idOGf1iudy0G69l2rRdM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuQ5Nsmdjw8xD_9Do6PxYuJg4x2GUZ61dpjboWs2mgWZg&oe=69A41E1E"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15oEI61dhyMQ7kNvwG1eIlq&_nc_oc=Adm15yHelFcuL4zFRxcUaqGOrq-lT_j81oBMtVuJ6WrgnLs8OLgDUnC13e20Qo15OKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftAj3PRF7BnMkxaFOXqtcBVOfcaKsHz-e8nmx9ON5lvpg&oe=69A41D9E"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVyMIDa0rIsQ7kNvwEUu5oN&_nc_oc=Adn7dDOXtKGOeZ6UgOVAr79dMN5Xw6SfAkD8PpMfjFA1BjKS6IxBtkKb5Pegqxl6xkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftqGBga2fhdNgzBaQTQQYtS0bApYKYMwKWzjWL2QtASng&oe=69A41CE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YMI9fX-29sQ7kNvwGY-DLv&_nc_oc=AdlbvWhZ9EbuuCA70xLZThiceNHL5YsMUghALy2GZqD1Dg2_l2k6u_AP4mvOy0ZV8zI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu0DTBBJxIilci1kT36Ro0PUCB5ZX7MfuemteUhQdd_DQ&oe=69A44D8B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dacPOeyCNu4Q7kNvwE1woW8&_nc_oc=AdkKdKgKDEV8Gx6-rLoE7IHhaYmEjvmJVn6fCieb1F2x51-js-4GNUPur3xWXYZ1NDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu4LNewYt9yrh-xsYM13Onk6bYnfLECCm1ZgFjILWY0gA&oe=69A43F63"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "releas
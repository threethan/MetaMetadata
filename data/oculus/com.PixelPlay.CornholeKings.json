.com/v/t64.5771-25/38974493_280381654041566_142084116441005820_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjelPDXBvZ4Q7kNvwHsHCPh&_nc_oc=AdppHZ8c8QqEhhBhH4yyeqi47lwTnnbF_Kc81EZDX6h-kgzNVrB9BzcY7XOUUgINq-A&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mkcehjHLpdX2iNYN5zmF71uo_ZB69GYSSN_09R1CyJQ&oe=6A394FDE"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeaKljulQRsQ7kNvwGINwpj&_nc_oc=AdoYUvErnWU4oY3mDzWOIr3oGX4g1p4TqA9GP5HIxcDZmE4T_cYTMNStXySYtj_HSvE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IOb1aKUklgoGTPDuxjtuI5Rp8zBnxHCpnyga6SLd2VQ&oe=6A394F5E"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qv7k4SfhUMkQ7kNvwHBEF-3&_nc_oc=Adonx23YOjp9z2SUzyk_nN6Homo8Iw9g6mLxJCxjfeqiV7UD5na6nKd0PfG8tiIBaho&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h_1wluIHO23tJkdYHwSfn7_gazSjcbZvZ8NHz_opxjg&oe=6A394EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mikMp5ny4VkQ7kNvwGmj8CI&_nc_oc=AdqemuiByvECFxnqgFV5vshVS9eDU4H1gE2tY5GjE63khRs7isqabV5c0jssgVh2DuI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xQtHGMRi0fRJtgrZLKKpHTJvsy-LJVh57cZssOa0PLA&oe=6A39470B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4RHBs4DecsQ7kNvwGhOx4S&_nc_oc=Adrg2U64ADJp9tzl9U1RTB0tcIKYhi8IWrMsSGoNIbOBYkNegXrK8jpuJGtTtp2-Z2E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CVrb9fr46y-Fpq5eSYkszE0qlFF3dl4R7OGlDiap7_Q&oe=6A3938E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category":
rove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1ftkD6TrTYQ7kNvwFXon9U&_nc_oc=Adr7MeRQM--5cEOvoN0QF2_HRKJm3aV5k4cRFGSTwJ0XBjMHsSquH6_rVVqduwHK6_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8vMAr4c2SS4DMVgJ8GJ8vps_vR5K1TzvCE_eg8Cd3pQ&oe=6A2AB863"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category": {"context
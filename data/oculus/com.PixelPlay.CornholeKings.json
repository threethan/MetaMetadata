I9bPQHxo6ZaAPXzhO1xMHWg&oe=6AFDB68B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2DceI8rKqMQ7kNvwGF5zJU
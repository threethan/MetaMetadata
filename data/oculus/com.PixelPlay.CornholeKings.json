akQ7kNvwGi7oNR&_nc_oc=AdrVRoJTQdR16NmqDJ5E_veh6r9_N3ZFuMFQ0bU5ezkLG7GYzlM31eqa4Kz02CJ_fHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2P6QLTX_Lg7DAiL0Z8-EfaTB8PtJqJaI3fjCcS4p_uIA&oe=69F0CD5E"}, {"file_name": "Moonlit.png", "id": "2523370821128508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_2523370824461841_8000900030911977518_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LYSSdb4BI0Q7kNvwENKzvH&_nc_oc=AdoHgSCrnOtNvUkpZ87c5iBE2z4xdWziijMbs6B0pdSMfxjGGnI-9LjAj5_0_HgLFGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0H1IcDkGlv-R669uRXPQ3J9xdheswuTMog6HsCpNM7ZQ&oe=69F0CCDE"}, {"file_name": "thrown_options.png", "id": "1129912437754400", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75251817_1129912441087733_6368377298574334626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxBX20bHuWwQ7kNvwFXEX5D&_nc_oc=Adq1fD3JuPoWoQyt5Np9g9vWd7nd-a4SU-f4lKxLM3lmz0o62fEMOAThoJaKXNSoMNk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af36uFXJWex7ZwPXYKv8RpZY1Tqkk4os8OZyDtGOsElt-Q&oe=69F0CC28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-2.png", "id": "3137210816526586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001726_3137210819859919_7411783923870106968_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OaCfhmHro0Q7kNvwFJzg3f&_nc_oc=Adrs2j7y5Bhp43PHb2nF2f9lGrATyMlmxN7pDl08LHCvQNqMG7bNRvyT5e6u7mqBZ3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3L2w_tTogOai9NlEwAkwcJ6EGapTi4O6SERsfMQ0vgZA&oe=69F0C48B"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.milkyway-publishing.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Milkyway Publishing", "support_website_url": null, "website_url": "https://www.cornholekingsvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "623731939601103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_275474591203255_5096381427050533869_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LplXIwqqRyoQ7kNvwGj3DIR&_nc_oc=Adr5sIN7Oeygsc1zGVRWoKCkPOwfrIafkjYfPHl2VRUieeTbp9DGLwCpPSw855kIUcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2v7RPsDaEZCsKoGnCZ2vhez7crkpPCexxxGlChyc8vZw&oe=69F0B663"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cornhole Kings", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "releas
_598776684713797_31685399956134805_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0PAQYDdyOIQ7kNvwGxlI4Y&_nc_oc=AdrMSOXN1pq-cVIseMY0CbczdUBChYXKAELwOZ2pyp43UKBB_R96OEhqPY5xrm7B_aI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pk73zJRDRx-kiU4Q7VmqFBLMh99QzHgkPWaGNnC2N2w&oe=6A39425F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cannon.png", "id": "1636085980056791", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75307248_1636085983390124_1291042619885571627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFmZOXWK9_gQ7kNvwHbE6s1&_nc_oc=Adpm2H6cP6QbG2egmZ-BIV2kE6kUq3I1htdnHTULdpkyKjk136ZqUr7WGqBa0Ejcm5M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mkAyuR_qg1i-Srx3KLgDJOKSK_GpiY5aSmBEdD0OK4g&oe=6A394CF6"}, "display_name": "Cornhole Kings", "keywords": [], "long_description": "Begin your legend now and become a cornhole king. Travel through time to the ruins of an ancient world to the palace of the king. Compete in global challenges and even face the mighty cannon on the shores of a deserted island. Prove your worth or remain a mere peasant on the stage of history. Configure throw options and board distances and relax to the sounds of nature as you throw the bag of beans. Life has never been so good. \n", "short_description": "Finally, play cornhole in VR in some amazing medieval places with real bean bag physics, unique challenges, and a global leaderboard! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jeffjinks.com/cornhole-kings-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jeff Jinks", "support_website_url": null, "website_url": "https://www.jeffjinks.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscripti
t=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSOzAFFNRt5CRxYxwMP6iH8MxagNwFHDVrT99srcXZVA&oe=6A4F8EA5"}, {"file_name": "2024 HG screen 3.png", "id": "422911767473865", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974552_422911770807198_2018748843549627820_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vs6bimGyYX0Q7kNvwFf2lL9&_nc_oc=Ado0b0UCtHet6BB9iJWfQipt8Qu32_RL03a-3Zgr8HbhuE3ZaOhUdDQ992wP6dW6PXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXMUCE8u-j8jPKc7Bpc2ct17N0CZou8jYgeYoZRA0q0g&oe=6A4FA5A8"}, {"file_name": "2024 HG screen 4.png", "id": "1054432909633298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974702_1054432912966631_7046083185660917993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab3sVpCGqxgQ7kNvwHggTyz&_nc_oc=AdqWPXBQSGjTFtKHFGbwwpwZ2D27C_tm6z66Sy8-LIX4HsDFmRf8yYQ1usVrtxwev48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoPNUM9_0wJYrNbMvC5EK3s9cRUyyIbG--CNynyfizvg&oe=6A4FAE22"}, {"file_name": "2024 HG screen 1.png", "id": "527879776285288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75557067_527879779618621_2727265542105493653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrEHtvVcBFsQ7kNvwEGYiVd&_nc_oc=Adr3Bt7SbCuvFNXNMOVLeIXCOZuOytOWpyqD8SkQDKUESNGIwo3TMVaIarwQw-CENqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAAf82wI-lyt2GNkHLT0DXohBSyKpXN4x9HLIaF4fxgA&oe=6A4F9161"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmBfoctAgP8Q7kNvwFRy4lc&_nc_oc=AdrIzmUBawd6O-Ge37skw5ZjSSsDAO2EiMPVQqYogUj13XoM4kc7k7SHMao3JA7f2mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhhxrlIXqOs1OC3LGguYcTOZxchnPiVO1iYNfeVHhGkw&oe=6A4FAC7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojSncg1fayQQ7kNvwHGuBFf&_nc_oc=AdrLt8TlNIoz5TxduP_MpAiRhtdYZiZiPAEVn9YD1oTnB7Sm9VLOhF8huPKruvGN-yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE5-VPaijTIuCm2Y7qWZatfki1iiXrp0ec5iHoQgmQeg&oe=6A4FC1E5"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
JQgVN7xH-x1TtsTMmBVDbDvbKZd_rKS16Kr-ps9eOh8w-HaewGCZNAX_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_PrqAb1QYc3zNwcZU0CrujSyrhkGl55PCbDnQ0TnzJA&oe=69E38420"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvzP4sU2T0IQ7kNvwFdda3q&_nc_oc=AdpoSpekK6ILWUh6wfjhz63xH3ljoKmsaK8lgJhEqYUXmiFoGVZjq1_avRrHYYnWh98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kAsS5v7DXTQ6c1b8U2gp6QOL07I--O9_LZI06Ymuu0Q&oe=69E3900E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJWjCahpgCwQ7kNvwEuXSsU&_nc_oc=Adp5o6ApZ32YWOMR1dInu3Vj5syztF1psUTAzX6hbeER1aIzPARXkWnxAGwWgXUJxho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d8-Vj6tLzqmOZEuzIGEnxX-8RiC5mZvnNZN3PO4hrsQ&oe=69E3652F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfQtrHNBEZEQ7kNvwEzuxFK&_nc_oc=AdqP8p4OtKs9R1nSISBkjUKnQWnWNMR-mUClWYTfsE6QwejIUIYTnBSLM27jRdugGpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bOZb9kchMpTgKHXNZw-7UGRUiW06TEXdSxSCMw9MlNQ&oe=69E36A1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duP5qQ1vxl4Q7kNvwHlE0yG&_nc_oc=Adr6WBnUVfz8Ts4BX9qlqW81MdJEhWMr3QHWvOsy3ddlTeoT7BmL3Qt25ap4F59lN1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XDduaP_yT8RoNsmosnAhuFkjYN1fgIvmwDPilthX4DQ&oe=69E3947E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
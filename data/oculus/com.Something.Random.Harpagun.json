vKPGgfqiv3EmgfYk8i1aU5qXYre3XSreiN3q3SOxaNar6CLlFFTnVPHI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJtVchyfOfoQuQXjhgT6yIm3WViEkLOCWxNDNIj7cB7g&oe=69CE6C20"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaR653kCEcEQ7kNvwE1evvD&_nc_oc=Adpp8Kya-CYs95VHnBYQ0Wmu_Re97whzxHr_KlXIQPVmchdU9KzPmlcS-T2mjL1qqXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQhbo2ZKW7r-H7FWNPBTupXk8qiwSgF5I5PM_poZixzA&oe=69CE780E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYvDmFobDdkQ7kNvwE4Zkxu&_nc_oc=Adob5jQ-biV7U7GcskDvvOFAY00xwLMiIiZx39j4jgChkudsdx9-KS_RX8CGooTVpH8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBH7W0tbFSZYg2FCJJ7TLyn7uwcmM7jK4G9jBvIa0yUg&oe=69CE4D2F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrIMf2HoA-oQ7kNvwHICWBr&_nc_oc=Ado2eZtc-CXqezFxbeh78cKruoiYEwFwEHJa4r7_52vP_pCRpcSZUeSpW9umAOw71yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYaF07AiKv2xB9CHxyKZGK966cIjfAfnKvCoOYksN2aQ&oe=69CE521E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQduLCVGXx8Q7kNvwFMR_EK&_nc_oc=AdpyJ7EXU6YyS2bTKmFDX86AvGYCidVBwuxP0LaBTBUqyzo6o6MLLoNde3gxzrpqTP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytiHduVY_zOhOwEwf5HrpNATI9KynRluN_x-CwJE_ieg&oe=69CE7C7E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "develo
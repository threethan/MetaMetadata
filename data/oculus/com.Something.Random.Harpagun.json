yMaYt6mumsQBqewMQNmSoutj-N89Smj-CAY8V-Ir51pQgcTjsEz32DEZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEF4GxezrtR-FXpDXwlpx_kPt13DWRwgoV53wPiRaRjQ&oe=6A845B20"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p28wS9sb5lgQ7kNvwFY_GTd&_nc_oc=AdqoB0luM6I3bLtXKe-mgr5Zpzs_vXPp0kKbunJEig79wR-Q6r3oxGpoWWIhuovRF5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw2Slg2_2v0WfSm_NEVDzOa7bM7vpleiA7P-Ey1JEd1g&oe=6A84670E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixcxj8gVO_AQ7kNvwHm386i&_nc_oc=Adqp2Q-uT77gPB1FDPcoJ-cwkbXRhS7ON-RUXPfCocUMcqLPTMp0peiUiOTOvTJ_-2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-eFEoX6MMVErk9aCprmD-rXZWO9diAGWG285lN7taQg&oe=6A843C2F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaJjiq7grLgQ7kNvwH4pAIO&_nc_oc=AdrwUuzWTsPrV-s7W0Kns4S4FxpGC1jD4gdelmAZtX7jmRLTipS2s_Dng2kdgSduTjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiP1Tza9-khUs2qbDsECMr-HV3YSL4MP8Yt3s7q7ZrSA&oe=6A84411E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05fscVpB8iUQ7kNvwH2YbKV&_nc_oc=AdrAS7oS-IWq44NpGIrY8b6Wmt75Jgd4eZdIZsvxXyYNrFFRRfDsDMvfrQLgBJXj2AE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8hVIzB3PuVgPnDTnPrtjQgJZGAhaHYgU0jnyNFT6BCg&oe=6A84333E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
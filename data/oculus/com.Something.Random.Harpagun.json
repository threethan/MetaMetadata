gSHj98oyP3u3f-E5hdT1rwCBvW_rGZaERFruARa1fgETxQRarOiHrivMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsI3b_SOze9cOsZ1AZLPwOdv8q2XTYa3HjclgXQuqw4A&oe=6ADE0120"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZPc5DdmrUoQ7kNvwELHpOC&_nc_oc=AdqJzvIVLy-wMAlQc52fwTDpdDpJePJHdBVsX8rBSP48gwmHnleb2GJo95N-b8n0Z90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwIH035s2d39WGraIuqx-AG6uoyEeoFZaH921OpAdYeQ&oe=6ADE0D0E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl0avrgm6-kQ7kNvwHVWTzW&_nc_oc=AdoUbBD3IqiOFck_FiMzW4atizlmm3ivjwruuEPFPLrjUMze3iQKXp9x59I-iphPOIU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP73avoesDp0PcydRUAVZjZTNFQbsQ_duCbLVNamFN1Yg&oe=6ADE1A6F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC1cCnSeeuwQ7kNvwEA0BpD&_nc_oc=AdraHfYeZV0BA9QTzAXGw23AoaTwq28m78E05OJJ0IlIkQ90dKETE1dgjXtaBRIk1bc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPszBEq6xcK1hcWdA_2CfuNcRsQRH6cxgtRzEIk9WgMQ&oe=6ADE1F5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9IP61CZb-MQ7kNvwGg3mF6&_nc_oc=AdqLhu6d4lw4veEhbGmJ9ZgbFHdNTtaWsFGQJhWh1itZPiSahxu4ETQOPf9XSkeqdlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeCHYCAB0U2kSWbifzztA_DNwOD9D5UT7ZOF3n4kYXKg&oe=6ADE117E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
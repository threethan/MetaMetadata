NxEUvMteBgNAlPmwWZbB4DhiugFlOqQu9PRNu7Zw6hXd0Anb0Iv1wp1R8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsXelodfMnhhBHi1S28m_vYG362FbqzqZ-EyqIDwR2Tg&oe=6AAA96A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fe1oG4yrAAEQ7kNvwH11Xyb&_nc_oc=AdqglaAcPffJ4lQ5AMTV91wxiHyylw9Ela9OEKjgQLMC2QbG0rBJfdthTheA7BBHMl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiAEHykCEBktUw3DKcXe7ATG5PWfbN8REt8coVoUJ9sg&oe=6AAAA28E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptmAnzDbhL4Q7kNvwE1nmSx&_nc_oc=AdqDHNGaKvv2CDMHCR9HsEFpKCBqiDwV8839w98w-7uknABHhfXhUiEakF4PTVgx2cM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDnqMo_FmoVJ-zpG_s7y7qmXNRffXp7k8hGYO-wmoS_A&oe=6AAAAFEF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC1_2WNIkKsQ7kNvwFP4CYn&_nc_oc=AdowcQv7GMs7TrE_JPwaP6hFsEjsFMI4yF9qYvqLdtqB-hkFFWotKX1gX3fD_PBedPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv2h7nH5aiRTzNMjkMDap8utfwxu7SoF5SJyag7HHxzg&oe=6AAAB4DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlEA0FBU8YUQ7kNvwEGKvTf&_nc_oc=AdqJfWWQydiYBpYSiSiBdwgCmNViypjfwMXasKPdLtbRCwPCnh_1vPsVj6LPjk7tAhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFwcluBM943faNyx9QWLFqzZhtGJcyc6UdMTCoB52Mig&oe=6AAAA6FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
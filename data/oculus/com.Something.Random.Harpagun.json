UWN3wlus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsDPuAcRIwCp8V2cQzij3BaRe208jfH_YDtKkOkW9SHag&oe=69A830A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoAPqK4WgrEQ7kNvwGk9zqq&_nc_oc=AdlknT98wkl5ariq6c7n0VUAx6s4o0ksQewMB2gJ8sqNKnaxWytiv7ICu_gD3wE8aTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuaGREkz7ZlcEac6BTH07lEwH9laIn6wh6V33iQwH_zQQ&oe=69A83C8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw0LAKM2nvMQ7kNvwH3w6cb&_nc_oc=AdkEhc1RSm_XnYkG3FV-H212blOzzlSDIdI-E9ejYvHJ4ewklcLI1lGBRkRMcD-6RlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_Qg2EiSeXw8KQolbKfZDiPs-_OWyv3drJzb0FH1fxIA&oe=69A811AF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxuO7XPq_kIQ7kNvwFJrid3&_nc_oc=AdnApEQO_0_2h725leAB20T4Ay66YRpQAQ57_2SOnE4Px6X3gK_JLLap3jLilfNCUrY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqUD77l_13pIZO4V8lRRxreVnEBznT5nvQyPfCIk8BUw&oe=69A8169E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3dlPl4jPRsQ7kNvwG7KF94&_nc_oc=AdkC-bYfzmUDAimGlcdP0dbNIJen1Faf_DsA4IJ8w-99LOq2KI7iUEsNoCBkeAhwXLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZM9DfgQPH4CwOvg6WlCXYVeDyiz2r14hvQb32YuUfNQ&oe=69A840FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random
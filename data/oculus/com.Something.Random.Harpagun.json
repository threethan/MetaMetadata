t=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bIkCE6KoPHvzqjLYEi0QJI9Sb5EbGYYJ9fzFSRnGdRw&oe=69D3A1A5"}, {"file_name": "2024 HG screen 3.png", "id": "422911767473865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_422911770807198_2018748843549627820_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frlGKL7mvV4Q7kNvwFH-Qbc&_nc_oc=AdrwOjm1qOdByrYk-jVNYZwzgTlqAvDQG31_Jf8_OKG83u6gKCCiieYPOPudvjHqneI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wsCWRvS9-mY327lhCzVT4FOj-zu1rRGleC96Cz72nfA&oe=69D3B8A8"}, {"file_name": "2024 HG screen 4.png", "id": "1054432909633298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974702_1054432912966631_7046083185660917993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-PmxLhiQSEQ7kNvwFE4n0C&_nc_oc=Adq4VscYscHtJVqx_mfxyyocsqG2Kv_-AZ1ACUGIBc-FVY9dWrp3ujHUXZIuiW9_C04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xvYKYuYrhUdo0aIHVTrVqX8IeFyBJ8NonWm2elJeFwg&oe=69D3C122"}, {"file_name": "2024 HG screen 1.png", "id": "527879776285288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75557067_527879779618621_2727265542105493653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqq446tteIYQ7kNvwHkj651&_nc_oc=Ados3Ip6Xv9pviiiKCoBYonhjbLVtrdj8a197Ai74tPtkrDfRYjc2H6I84XpF_tPuQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IBfo2q1cLxg-9xLA0YZ36zVAJnysSlH0aUYu90umDnQ&oe=69D3A461"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T21zpnCeXeYQ7kNvwH2hl7a&_nc_oc=Adrje53bvLXUNR3Y0jCL7CryvCWctiflOoCOI-8_zXkqjXNa_LNbCsGd2hGR4ApoZFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o01qQSgR7uHpeoVNDVk-kdppKmK7cCcHwmHiC0J56Wg&oe=69D3BF7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rllb-bTOqekQ7kNvwHEXsBX&_nc_oc=AdrwY0Jb1-t0DMQG7C58jHtRyqS_Dp6NHLE5Hu1IkIKWat-Bv4Tmkq_4d-vC_G4-IOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lL6GvYJbAc0l23kfS4nqJjCYRUkLb2zn0MSFyNU1DLA&oe=69D39CA5"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
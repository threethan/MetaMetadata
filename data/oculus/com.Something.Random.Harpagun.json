t=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VEn0QHjeVhJ_J43kmYmC8x_N9Mu-gK5cI58q4m_CfbA&oe=69EA0B25"}, {"file_name": "2024 HG screen 3.png", "id": "422911767473865", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974552_422911770807198_2018748843549627820_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IK6Txc7NjzAQ7kNvwGFj8QJ&_nc_oc=AdrJ4uYTyhWTBdWcQPB6aIYMpuxNIqpzHLVY5mitgfKXka5lRAMNgS_q9WDQlgJUmc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sYCyovE4857AeTVBYO1KOUCnfLxRqSM932Vg7HJraHg&oe=69EA2228"}, {"file_name": "2024 HG screen 4.png", "id": "1054432909633298", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_1054432912966631_7046083185660917993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NmgfODT1acQ7kNvwGWoumD&_nc_oc=AdqIaQC7dUfQV6v4nIgWXr6OQhAY9trvLK4GF3TYk7Bk_h3CzlD4YGTh1c05iI74GXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uYLTcqo5-ZkPJ9S9g6QkH-USBMzu7fca_Oj6_AMrIEw&oe=69EA2AA2"}, {"file_name": "2024 HG screen 1.png", "id": "527879776285288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75557067_527879779618621_2727265542105493653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6ra-nf0GdUQ7kNvwFSPZvN&_nc_oc=AdqsoouwYQD0KDHCDWq-jlyP8UGW6AT5KqyjVJ-KxdsE8XHLngAzmpLvKEAE6d_Ycs4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tjVMu0imbPHJmr9HfFkN6qYzbJ1owTiuauubNJ_wD3g&oe=69EA0DE1"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e1IPk8w2u0Q7kNvwGrHFqW&_nc_oc=Adoh2ZerREWDhEsAPpbmoxFYxPS8rGi51O5MYzKeKq1LvSew8qvXmxsXsU8ryxe99Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29_AQDFps2f5dkIffU3da6lFUK3Gikz54cGm8Nz1SiMQ&oe=69EA28FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QC5crBWA4P4Q7kNvwEN9Mus&_nc_oc=AdpGb7EPs3yYZ0RQr2fOU9OHxKgsfxQyYvVVvxR_qLbXs208a25Z68ZIOEO8wOPEpwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Qazepo7Fjcyfa0Xpcu945KewCfQ3Wn4xsku4pB-Gczw&oe=69EA0625"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
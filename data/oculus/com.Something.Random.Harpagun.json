gll0XaLTPryIii5zsFbeYzKGWFPqhP1rq_q2mOQggeX0R-iaWrnhZ6O1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZFIWBqiwf6GWRCuAu_97HhXGSuMSomGxvqlHdvmpU8Q&oe=6A8C4420"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wsj_2APCmjQQ7kNvwGp9BYp&_nc_oc=AdplrICBV7orxmjq4hWNB3HYN9kLzyJckbVQsD_DFWR1BPMQ1tAHb5aXxsRPBs3pB6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBIfT5MKuTmmqSits1N4-iF9NEVhmbRoKfVeYAG9kxYg&oe=6A8C17CE"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFUtL8NzRiEQ7kNvwF0GEqy&_nc_oc=Adrep3oV_f9gmxcVBsvvLZ_x3LMhxZpDNUL30-Hd-A-K7XV6topPUZA4bKye_yHHdac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh9mZoXsAEMW9pwglaCKo8q7KXi5O7W6FfBaUdDgSV6A&oe=6A8C252F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtmyQBocXykQ7kNvwHsb8rj&_nc_oc=AdrFgIivMlvcFDtHZAPsDl6h6b5DBXa8R_NRYjU52ueBIRYd6qPCJQT39YUujYcgNrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEms_932gCE_oUi4g-XZ_Yi4y4q2OMMLX4bsZxyVBC6g&oe=6A8C2A1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8mKQ6qJlpEQ7kNvwGSNHxW&_nc_oc=AdqKBLiufTHCoe02Q-AFzOo9xG4bgBrEtOGxyS2pmRH2Oi5hrAUExTeIrX2DbJ1gMAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCaKIWeCB5qu4ZW2_YlUaIZFqiEINBzVT0fYT8y8645Q&oe=6A8C1C3E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
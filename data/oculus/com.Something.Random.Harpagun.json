_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhpOApyZp3sQ7kNvwG8W1kE&_nc_oc=AdpkN5ypV44jCpIj1WdxWvMb1L3N_2ycyeN4jqr-hkBpPYIij_YXrEhsSWIHfPHTqVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSYAQqIviy--QuiN7HtvBXmmRhBEDGoX-ycWynA4azRQ&oe=6B0EF321"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgsD1UV1l3oQ7kNvwF6iUqJ&_nc_oc=Adqcq8_fVOWy7ySno1res5FTrLP-lKnA5g0s-xita7pZaD2ryrDym7pN5Xn0ubdK68Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViPC0o9ZfMnkn3RMj8PqiDelYtcWh5t2P_hPjKrm80sQ&oe=6B0F0E3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_ro-1K6TVAQ7kNvwFFUY2k&_nc_oc=Adok5CJK984TMDo0VoK4w2chFB4J33fNGrve4_l3M95BUBZRErRH8I033T5cGZO4Euc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXI-Ah32qATg1kaAKzOc4HcxihFNbA7Ndf31ANEuWCmQ&oe=6B0EEB65"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8927242637289344"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1050940377963099"}, {"status": "PUBLISHED", "id": "2215030059283364"}, {"status": "PUBLISHED", "id": "956522820793465"}, {"status": "PUBLISHED", "id": "1648744666421426"}, {"status": "PUBLISHED", "id": "1838081496854224"}, {"status": "PUBLISHED", "id": "919133157202623"}, {"status": "PUBLISHED", "id": "4178302222417912"}, {"status": "PUBLISHED", "id": "693780630203053"}, {"status": "PUBLISHED", "id": "
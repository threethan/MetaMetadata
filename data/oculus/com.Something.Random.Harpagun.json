oe=699C5320"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oetwoDm4aQQ7kNvwGC6ayg&_nc_oc=Adl0LLjC-F-VsaO7EV-jOW1yB-ILQodpIt_MCHoYctrN1vOAWH8XFB39bE-PzJVygxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftkwKsgbegeKxMk7n3BZIWjZGBuWfXenq4ugR7FnWnSBw&oe=699C5F0E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy4OLAjxovgQ7kNvwFzFdCO&_nc_oc=AdnsngZmuFElCp7mTw9CeA8A7crOQ1yKLH1Bm5nyrFTMcGnHe5lZ1Za52Q0mvbBQV_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs7N3o5V2YCJ5-fkzRaQX5Mkt2_G-NgX-MRBC8b3s8fHw&oe=699C342F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJxPFdc2dtIQ7kNvwHj3aGE&_nc_oc=AdkCiKJK0V5-RUG92eattbCZn-I64r4FhYMHm4fgxkPfN0-uJYzz9CDqUKyyh71uxpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsnfplEFDciNMMzJCNC_P5GeS1KFG55BdJrTlDTyor0_A&oe=699C391E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wj5P_obyU8Q7kNvwFDoh2y&_nc_oc=AdkAQrfo2_AWdW30nTm7Hq5Smvkv-875fW9cbzhQpAN4JXV_6x2mdJDPAFar5NfLoVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu5fhenQyw4txeEvjtkS4znlIL4K6Nkll_7DfrQ9AHeKA&oe=699C637E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
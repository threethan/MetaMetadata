C0JaJHhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTlv4NghUIGa9FxezMSX0Qrz_hN7BqJbK7lqO-R82d6A&oe=69B6B120"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5TjcGpOdFkQ7kNvwHtX2-0&_nc_oc=AdnD4QVrNH9ENmbWnaPrIfTkWE6Oi-fhJ9jX-NYSrhpdOfWH1C9_zaj4mzvKYv2dzmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzh-lTR8vA2Qh0RsQeItSC69mzxPIU8tFjEOfRxrxchuA&oe=69B6BD0E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMa87_Ly13sQ7kNvwHSa7IT&_nc_oc=AdmC2Ok8QHsbu-lS8YSU6tWyfDlDi-F-MOXP7mbB5Psb_rNdI-Mj98APtRp2-wZq1cU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsHoHUwF_lvWwvUH3uWhQwHzLHrlWvjdcJJ7gblPEwjg&oe=69B6922F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGeKxQSi4v4Q7kNvwFtpeCE&_nc_oc=AdkpAE7T66k69aZYoFpqtCtpunMfxXhTlyxJ4Bpfsl29OWiNz1ouriT_XXbP8byr7eY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzO1XJEIxtM-Ek9yyVL1UJh6B9fodS5WglXsDQyGIdMLw&oe=69B6971E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2BCfRLrRLwQ7kNvwELkjjd&_nc_oc=Adl75OL3CEBxpNAXDVx8en00yefOy6zMTZJv-xNAv4kUTS717JlACdO5yjlzCehoipE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxxj3MnIo80T22w6ukzrDumeYihWuRGG7GTY8l_HT-rag&oe=69B6C17E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random
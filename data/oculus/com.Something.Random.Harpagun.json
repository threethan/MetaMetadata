Cv7oUvbH1aRkc_snWYU8rjGVREgFDJVHAf3PgKw_y_9IaigB8-5HRbUsY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-khz9saL4sbzcdoHP0J6MxaMMjETj8yGAWWdS3OX3Ohg&oe=6A33EFA0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G0-HzH0bFEQ7kNvwEp3hDr&_nc_oc=AdoaSDIDGal-SjyvV7exk2JskZNOFoU0Lm_bH3cMbYBQpeKvMz6PLNIMHhBrdwv3O48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TNwVZnAEfjvrDO_UgBslH9_UQn8FlfdukkG1WOzId7g&oe=6A33FB8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTG0G3sbSMwQ7kNvwFDF6U2&_nc_oc=AdruknhkO8j2j4e6uWqOR51utkIjfffp8_trU7LfA9YIU9YA2hUjxUhhtgRC10BTu9Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qakns7bw0kY8Xu50qUbehII81sQ0cqEpRbEF0nkRHHw&oe=6A3408EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFfeG24ujlwQ7kNvwHYuhxk&_nc_oc=Adp3wOmrVue2B-8JO58KgGQiL9wG3b4L2RX3TpMCs_dOGkTd_-aOJgI9Ck3KotNmReY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qPfqddyiVfOiJMeVHasjTUOWtKa-LNo5fRQtPyjmUSA&oe=6A340DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUxCrc0lDzUQ7kNvwHKxKhl&_nc_oc=AdrFFrp47VlpVn1uMEl8Mmq9L-UaL_F1tdjSd9nGbX_ifmOXuRY15MMzXDSVm16TJrk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gu9EQiJrDLS5eoaF22HhXO6CfjJkZ1ElqjQgZu9q2CQ&oe=6A33FFFE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
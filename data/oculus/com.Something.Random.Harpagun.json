oe=699DA4A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oetwoDm4aQQ7kNvwHcAv6A&_nc_oc=AdnMpaAJtey_zUmSSH8jcUAHFHJI1AzqRKLb_T58Onc5tZftQPYqnSVeCOqUBTgf7Yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYQkvI60JsObKYn1pZ8PbgsLu6LHa83VqsVfyD33QwOQ&oe=699DB08E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXnBeLVjbKsQ7kNvwF3B0PK&_nc_oc=AdmntCZiuAzUfJubQ6zJBFg3FXMLg5FiuZHqQgXmLVa3JM56yq4B0j_6GgKW080WZ_k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuzm_BWslb4NwuCZk-jH4x-ZTwqWsQRlyg32reJTkxt5A&oe=699D85AF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJxPFdc2dtIQ7kNvwEyi8oI&_nc_oc=AdkaWQLG2PliXCJHMUzlKVhLVp7PtblGpXxjo_-7XL7OPDhp4fVIxJG7708E1vNCwak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTcXzzr8G3Gg-8W240l45kJIDcYLj-VD9ge4PhpyqeHQ&oe=699D8A9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wj5P_obyU8Q7kNvwEWv88T&_nc_oc=AdnjUxPrMSX3LIfe-4CC8FAF4gb4N0D2167fhs8IAEvZFV4o2A1pnqzZM9r1xQQfg44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsE4ydm3DzNZ_AuvPU9iuQUuSutlQW8mIoiBQQKZGo25Q&oe=699DB4FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
4B46q1hJwKPiIOAO-jaQFX4He-j8DZZbBoz3WuWyo_Go78XmzzABK2iw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmESxF3OoZn2wqNXvx8PNNM6sb1e5KlE4Hnnp7AS1u6w&oe=69CBC920"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaR653kCEcEQ7kNvwEsqMsz&_nc_oc=AdoDAeDtmHTnqzHXG_K_qfdBp-o8LNxl7AVzObtaaYH0tu_-tmSNhk0yCS1K7RpldZo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy03C0ILBiuY0oUanRh4NBOgrQS-ItuyFZzZ8dJXujAIQ&oe=69CBD50E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOO0csxu8qYQ7kNvwHZnggv&_nc_oc=AdoH5DvcULTh3mX8GRSblX9PvAKpFJ0cgXX4YDA0D1VRCjQfcrcgouMVQqgsY5nZhrI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygGOJZu9q2acfnAAIWdbfdlGKwBtD6ydQk4zePWa4Tdw&oe=69CBAA2F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-7pVHPrXjMQ7kNvwGkko7i&_nc_oc=AdpuSYuGhbGNRtRcIR4Y8pdc6e3jRbns_pPv5nCLIDmdb7gtTloNqwGPylFw_nATmuU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKz3s8hHieIhtg2bz7YG90GR0nYx_R_aO40o6xaiUKWA&oe=69CBAF1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQduLCVGXx8Q7kNvwGWB_DX&_nc_oc=AdrGon6J_jFYHcHdFgUib-EjDebPWSo90ScjXoLDhMEIeuTafyJ5yAomxUV8HeBloDw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpUyhMrf5sNw6DaEmdkhHa9CBzCNJxfOiwOEixtmyR-g&oe=69CBD97E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "develo
qWfl9Te6sENag4Ek0kRd-zWdiF4K4zWP8o7CujkA9MucUXDQE_LaiLozg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCA8nxkQ6t0ShKgCQHOvd-nZv0aH2U6-TLUQiD8X-WHg&oe=6A748920"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axJzQGhdOwoQ7kNvwG3dNE1&_nc_oc=AdoF9fWVj0ZJnVxo2JcjpB-G1wYMDZ0zPRiIxjEejUXvcKxMo2g1dEwAQnCK6MiX_kM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn3RJBojk_zEH4CQ-Cw9nAhMhD2Yq9UWIR2niXsmR0rQ&oe=6A74950E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RQdRAnx5FAQ7kNvwGxD7XX&_nc_oc=AdoJsZN6C3UmEp5e1I-XTlwP2G4Lx8g2kezQB0rUvGZkZ-A-SGrsIZAycEbWFA5ztqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW9QasOSeDZvgYCkqliPa1y9K3DNYJDEZTwUwvvcvvwg&oe=6A74A26F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xslxAnVPRMQ7kNvwFSAsJG&_nc_oc=AdqFpvu16rigYcmRrbLNzpo_v4DEQSf6GdkvmNb8svB6mrq8h02B-fls2TN4jUt9XQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQnZGhqJqiTju_WUji2g6PGQVHWdrBsc2sHiAPIgtgqA&oe=6A74A75E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAghtf4Y6igQ7kNvwHWK9Xa&_nc_oc=Ado8rgodZ8-hwy4ORnANHwVgL9Yg27TwYZCQpkysLEFgmb2qnP0cRcvINsVIRuBbz94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvl8N6o1Ll0I-LuFk6pRS_7CKBNODOwa4X27dVGiNcvg&oe=6A74997E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
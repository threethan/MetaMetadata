ame": "2024 HG screen 3.png", "id": "422911767473865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974552_422911770807198_2018748843549627820_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTiucuDxCKQQ7kNvwHWA06c&_nc_oc=AdlMAcIBwHtCRs452HsqcGgyeau1ETLVftWFeB6tzn4CvEW86T-HdhHGLgbVVTlPkfQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_htoFmopnB7yoF2BUDyd1ul2-nzD1tZ7oUe3qYhDlpQ&oe=69B95AA8"}, {"file_name": "2024 HG screen 4.png", "id": "1054432909633298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974702_1054432912966631_7046083185660917993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfuWXfK9KJ0Q7kNvwEZ_a4I&_nc_oc=Adlh4j82IYVuPuoPrxxZu7_Kp-UBq9Wiho7bFMMQeMN9ftOdPwruISKmS49Xn-LptgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyge7n9Ay6YCGz3gI_gEeUp0mAFfkcGb5B-AhBTMvKkmQ&oe=69B96322"}, {"file_name": "2024 HG screen 1.png", "id": "527879776285288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75557067_527879779618621_2727265542105493653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLpDIW8e3XQQ7kNvwEgBd6H&_nc_oc=AdmoZg0N8-tkfC2BMTrl2atGHuqxpmI2FC_5Nuk8KhAAz9dulD2YYwb1DwF7TJAsFr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxg_pSoFWpen3xgSae6iV9UMibj_DynUchullOVy8dPEQ&oe=69B94661"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghGebkaldCEQ7kNvwGkOXdi&_nc_oc=AdkCgn1J3xc5zHa1So6FSBMoGrAfulFCoVUjumUgM_uZGn2V4SOn0eIWPrEmFdbKt-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2lEjoNX2p3YG7-osLNYlc9qLfzxSPbTqLuQQ-BqxhIg&oe=69B9617A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihH-kvImAv4Q7kNvwEKZIPH&_nc_oc=AdlhNnOwFYDbqMgdyaC9AO9LEfdIGv78pQ_9dI93Z6dpHCTRlJ4kG3gjZ_qr4wnzjM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwA0jSBA5qN80Lzs4UPexy6Zco8DMbsWybK-wALPkfdrw&oe=69B93EA5"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_
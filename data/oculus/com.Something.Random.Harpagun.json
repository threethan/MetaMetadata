Imq7sWss&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyHJ_W45StrOLhfkHa0YMJbR5xR0T5IBotOOv-wDlzeEw&oe=69B95420"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgHquakVu0EQ7kNvwHCQv-n&_nc_oc=AdnQ9Gj7WwZ0UpTbAVBF27oMjGEfj1Xuwa2OwzA4meDjx4FmhnRMyS0obh48QJMma-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGGxuF1MAlyxc4EZiZf3Fvg7_C-EEY8PF9KOE-xvROdw&oe=69B9600E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4endckKU7uoQ7kNvwFPTnei&_nc_oc=AdklxOYNKIhX4zd-xpMYEuJa3CKfrFw3zfZs0rVtjrpPfop68wC6Lp1yrHe_xzTkSrM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6Bz-CdmMYme_Ef3iQRoeOBktpzJ2K_ZS7GGABn0vsvQ&oe=69B9352F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGeKxQSi4v4Q7kNvwH9mlYM&_nc_oc=AdmGahW5hK7VexfekHhwXu9OsSV7DRagKPwl7CRK2C6H-ehogPlm7cjywHh8SbQKcac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzpup63tXchqx0sF71qSVr2vsJPEWoakV22kSRVJ8fO2g&oe=69B93A1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkyQtWLHBb0Q7kNvwFhjWt5&_nc_oc=AdktnzMX35WCMMp3NbcRZ0-6_YW0C4CSWLgB2NQOwZ_H7bddNY_Yno2tL45tY5gshrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxbRuHoZ4Oox9fWoq4FZNPUGrOXofzV7vGelxJGuxh7eQ&oe=69B9647E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random
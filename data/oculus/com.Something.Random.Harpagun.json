P-DXE9UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1zy7MYmVxbfAz64jC2tDo9LHe6sTu8ujw7lO5wKbdDA&oe=69B55FA0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5TjcGpOdFkQ7kNvwHWZh1x&_nc_oc=AdkJAMpYUZHK2-QXawLYnnI23pNHde4y8LoL69Us4V_AGSzX5gNCiK4eLZGQ3Coyzto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRaHW8Awe0nim7VDx1wu3iOsNbYrTiM-s0LG6nFXSTCA&oe=69B56B8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMa87_Ly13sQ7kNvwEGe2FY&_nc_oc=AdkmdBVdel7J-MLDOgRMhBaT7Io52s_5Qnn7SdnabeGt_a40L2Qfc7Xq5vSOzOQY0E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz31rxHrentgWBhgyaPPxDucEYFAkxGWPMgdjVKQBUrdA&oe=69B540AF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJiDA9YA1TIQ7kNvwG-LTSX&_nc_oc=AdkN6_TjE_SO1AbVP0-QBcvFBfaR4EkOsikYg1Q9G1JlUgXMJwGRqz3sqyESwuTG68M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJKhzmHlzQZBGLzVbdztpkEzxm27Yuv69jy18-L1_BsA&oe=69B5459E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2BCfRLrRLwQ7kNvwGpa9lo&_nc_oc=AdnyJzAHTpXfxZTgjuqL_mgPQ_KZlCI2SQ4DoqG3L8J1gx2wXyXXVKfjxFWQY4PSoF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYFzAEQqukp5k9b7teknWpUptWokLCp0pw7O7gJvmARg&oe=69B56FFE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random
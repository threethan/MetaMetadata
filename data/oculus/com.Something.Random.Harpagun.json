a3NsQJKhernW0lvYqQnRZg73I6vy3Kx11VaaGeeU9D6faveE6FWLew9AE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfk8nuAKUopT9fLUbww3q-Q2AI2crLVRhtYFKSPIvICA&oe=6AABE820"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fe1oG4yrAAEQ7kNvwFzAro5&_nc_oc=AdpHSfVB4sngR3eOP9w3Tz5LuIYkG8uuNVdn6TztG_roi5p4t8c7ySs3ROokCN3mhwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwcD5Pe2vpSNhvtcNa4ZuinKwBfjCDAmCPfjPetYE5Ow&oe=6AABF40E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptmAnzDbhL4Q7kNvwHt79jU&_nc_oc=Adp3EctmbjZK01aJLGcW2gs-kb0FV4z91NS6TTXVDFf_4OCZiHK9El0rmgbox-vOEsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM93vRLUBXG2AbnMVL6p_RMf97RGleFgU-cC8wdjwCZw&oe=6AAC016F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC1_2WNIkKsQ7kNvwHcVehw&_nc_oc=AdpaGGZ41RVUXBxtuyVKXDNnzN21FG5FmXzP06LEWs9p8u3cLCiWlJVYeFGWa9A9kCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu2Gt1lpwWH80y-VSiLg2eFj7scBhQRZ6dncX89C1HMA&oe=6AAC065E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlEA0FBU8YUQ7kNvwGXJmGo&_nc_oc=AdpWANmbAQp-CsGsHT4y-zaj-6UtsWTFObwvEgCWn0fB_dfPOwx26DMcYF_D2jV_AD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQdurYFfSQAH_3eUmQQyKiG9i9aD-PfOPfa9QAuAwGzg&oe=6AABF87E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
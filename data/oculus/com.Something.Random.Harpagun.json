sZZ04dKsH-vj-fttOpIWhJKtuqXJ-MQdw9OJN8q1wBeF8jnV9S0tSSUKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14Gp-qp3yml-fgEX7t047F5hT8c1-RpxBQDI4luKhLiw&oe=69ECBEA0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mlhMXrrDmwQ7kNvwEVhsr9&_nc_oc=AdrBGn4KBc_A2S0c3NAvKj60Huc4lr3wQIPeGy4w9cwb626BODquFBuHi7eY6Co-hKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VS9nzAmBTg6I-NCKdlP2VECG8ZG89lPM8hU3OQw4-Qw&oe=69ECCA8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Ho12fwnkUQ7kNvwGpJxbw&_nc_oc=Adom_HWE1TB3sMbRRaZNthiuK3yI4wF6UIHJwm7yAMoBhiOxMCWyib7d_2kMwVkA0h0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TuF06GveCtfWcXCDewE0Kesap7tkw6xtrJ0nLS2FXPg&oe=69ECD7EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-77MZjMvvMQ7kNvwHa2q9w&_nc_oc=AdrFIsOIUvxlW_LTVhC_EsETX8JrwD6ZvUVI1ADKn_jV9Bhav-Z3Z9hJSqDVdi7l-L8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v3nhUT08Q1b-Gl8wNszcHhgw7xJV_uchNJTs480xQSA&oe=69ECA49E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNT0jrjFfXkQ7kNvwF6wQny&_nc_oc=Adq0RZdvnf5xtT-jHsoEw8cTo4Ssd09Zy9nH23F7lzbgiJw5mshzCIoNG89t2tVCXjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2myxJgpzstzEOpMtBlOIdLUYlAE13fM2KnxxE3nJYetg&oe=69ECCEFE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
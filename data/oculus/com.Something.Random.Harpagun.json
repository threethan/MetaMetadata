bBbZNMOPkqhr-xMA2MjR9qGZmJyyHSIcZN1pw3pa1lMxw8C8ML9JT9jE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4_oqNqf5ssnbj9MtkuBi7WS5MgQKDWT-3kaNxPn6Pyg&oe=6AB91720"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbUyHVCwTusQ7kNvwF9EOOR&_nc_oc=AdqSwaaN0QzaFxjHuARk07Fs8IRle3hW2Q8_8uDXIX2hvKYLstiVgk8RfJpKtkbVz_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8w3diknwqQqPbNJzcBExx9_E9TUkmN_L0KmkqIc5yRA&oe=6AB9230E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0aC3A9NAmYQ7kNvwHoM7lT&_nc_oc=Ado1N9pC4fKUSIIa4jQHMlAIPw40DxDH6eMivfLF3IH6VjCmzGDQjgGzeXj6wxTd-Us&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGu5BLKnOVVuGf-nX8VuJvPHEDxbPDUotW37E4hVWICA&oe=6AB9306F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKPMBzGVBCEQ7kNvwHIbE1C&_nc_oc=AdqlcrvsB7pDLgeEjtCQX4SnT9M6yQdhpHnGOy_eOd58irY8lz67h-Bpub5e84dFLjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKCUKzRXX8X29S82u6Cs9CTsoqiG2naP3OKHraefBV1Q&oe=6AB9355E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVBsOwuh4qcQ7kNvwFsSStJ&_nc_oc=Adq2bhY4k4EC-7u4Z3PnWyn094h-wrVyShCS9g5iSJHCfX9miwxLk9dURzOz-GBKiDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoPxNPRE293duCfeJ3TK6NvYqRvvhbgsDpD24MH9aVjQ&oe=6AB9277E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "develo
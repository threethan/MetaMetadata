pOPbJFvigNvRudav6aC011L-W-GzWvxIMVELUTMuEC93FkOWcjQR54Il0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53tLTFw1igOf7_WDOfJ3J_-KEjMNifUUpQqYkK6cQrHA&oe=6A159D20"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klbR0DBpjn8Q7kNvwGxL1vC&_nc_oc=Adq4YDzBmXNY0a3hG3pIloVzYkBLptSpGEHnkix_Bfd5vTGUOTYoixWLBpURIWcgEN4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cUtq47otC0NjR8jF5gZcJ4gsQtXN4a9BpWiHxIbQ95g&oe=6A15A90E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d06iZq7lWJcQ7kNvwH7wGF_&_nc_oc=Adp2__4qiQz4fdq9Ib55z0Fs9wziYYq9DFoJwQlvEGnmYODK_gAR58rs8d4XzVxHfFQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XBBE9XMVK5TB-z-TMumMXrw9i-Fa-ECA0uKcJrmnJvA&oe=6A15B66F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2zBdWJnZvwQ7kNvwHIta0h&_nc_oc=AdqI4Ut-3HG6l-I7zEk7ypNNPtuyPJ_XA4OP0h-q6n0twl0i-0BAxX03h_h0jF9dSNY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41xQ-89ss7fy7hXtbA5RyCGwvETSeQvhFThGmHyEh0eA&oe=6A15BB5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3mjCUPYEf0Q7kNvwHFcMeB&_nc_oc=Adozvaagb3Xkp_YJIBuJKl77ouLFKqQKkxO5AGGUuaDnUawvPLVp7O4BgORGwYiH0jI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kiQTIKdS2hZE3UA2MiFPukQfLbQ4YafZW4i-VD9N0xg&oe=6A15AD7E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
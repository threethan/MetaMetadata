-_TGFk2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxT7QPonSiTQ8pV3220OpOadOhi4AUUsHRQ2pyckze4Qg&oe=69AD76A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzivWGGK628Q7kNvwGSYMkg&_nc_oc=AdkOmAzLqnbmvC9TsAXqMAWA9EvpLa9Ey70ST6bvfsjJ-z_ods9Zz_Y_A8IOEh_GlVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjWF2ZQRMjMoEqpR4-HTJ4An1LwtCufNfzpCgYF9F_UA&oe=69AD828E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-wX4J6HhkMQ7kNvwFplgYV&_nc_oc=AdkkMf0CnTweTft2TzW1z5ftqxKqnHMLtTieaEqvksFsYHdJN8yx7w9zb46pcxleTVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJQrpO4_sjn2vXFPJafwNVrKsEz_PUAe6YsSBqb8N51Q&oe=69AD57AF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA427t7LHvQQ7kNvwGrNJkn&_nc_oc=AdlpvlTi8bsc8xvZZ96sLIJkL0VA5V5d61t_Ypp3L5ZlQTnRvSYHF4jmxs9QG0U0vm8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9g2Slj78bhzLFYximAvctBrrM8S4Gi3jr8KAHqMGpug&oe=69AD5C9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M31GbwWvlRAQ7kNvwHRGg0l&_nc_oc=AdnUO9gwX_xplQHg1KtlzG1UPdxJRUlrvD-cMI8X4IswMlmpot-TR-lrgMnuzwv-OJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_5Hv59bGZMa6frF8bUVFHojr_2JQ9IF1pv3KPs5yQMQ&oe=69AD86FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random
tent-atl3-3.oculuscdn.com&oh=00_Af31OUQgcNP2cEwcG__Ak6A3pZ6-RkDlx9xT5ibyLGQ-tA&oe=69F204A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVPX4nBxvY8Q7kNvwE-Lhx7&_nc_oc=AdqKQjV4ajggjGO8HighNWZ0b7FbRqoggqvNRf1OcQPyvG9GRo5xFpBYuUJ9EHArZFo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3h4FncXWraRJ08A-O3HLnRLSC8_8xuySkNNr0gnjka4A&oe=69F2108E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssDOfN_a32AQ7kNvwEo6Uug&_nc_oc=AdpSJtlTIItKLWsiq4ANubIQPkeSLw-I3AuedFJ9hMJKTrTv_6iMkXNdLtDgtq6hYc4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-O4kHybkAh7Npea_ltVApmWGpI2vYbM_icGJ1Pfy7CQ&oe=69F1E5AF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQPj58MZvfMQ7kNvwHxULmU&_nc_oc=AdqAz-6mz4q5uCB5q-tk64CpihPBTNn7JF8PdPEz6YjDhPPAc4YWgDOjuhJwxkHSNUE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tMpdsC9KJPIa241_PrKfGtis2pkb33lmUrRYVBHqDsA&oe=69F1EA9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfZwj9ogKnYQ7kNvwHPc_a6&_nc_oc=Adp8xcagzzo_h_xwaN8S5IaoTX1qZuiR1DGpEsktejsN_4ZZdAXVUSAX6b0KCgfV_ow&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1OUwjaioyxZqA4apXuqlApYaP6dM-aI69C6AidO_S14g&oe=69F214FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "we
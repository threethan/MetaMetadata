C8Rqd9g3dTxv8lMdnS7Z4QaZFel9tRanRia4A-9DLPmeqaE428m0qzKiM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JQjsCGVytvoKymuMKADE8yENTmFLM9BgQ0tNK3ei-iQ&oe=6A071CA0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1rxLFBuZFIQ7kNvwGH2wg8&_nc_oc=AdpR-qCYdwO43mYIo-Dt3Th1CtnKsDbDZNGTYXSDU_nkyYzF_mhJ79XeDmLZ4EltSDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Yel7b1erweQOcKf0eMyF_U4ZepmXMDPjQI_ebMry1pw&oe=6A07288E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlrwSDIpKcEQ7kNvwGg337F&_nc_oc=AdrXjA9Fszd3QGib0DiBvqBHMAvGaZVJwH5BPJwwVFPhCrCAXa3e9iCjXIz4C7mwl7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42ewgLf0ci1BxgHQzAOw5fLFBAC04AALpCSjRb8Qmpxw&oe=6A0735EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4SQIs37bCYQ7kNvwEFJuxs&_nc_oc=AdpbRkUn--CSwoEyIIOHeG02L44nEGMDDJQdvWN3mSE6LUQivMkbu7nChqaO1-niUvA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AF1swdKZQL4WXvv4u9syQPBytQmMHoIkn9pBl5qYPJQ&oe=6A073ADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfd6IESfte8Q7kNvwFCic0l&_nc_oc=AdqdGNNSA1Cu0yyV0iEp7xZReW948h2RjdE72RAR1Ev0YliZwsGpCAX-SHw3CCF36-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xUkple9sa-RaGOQnIgibFa9RDFXQt9OM_pNeIPTI3JQ&oe=6A072CFE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
7wHuCEak0NyJwFqIcs-jI06jIjrk9ENluroou6WBa-ddDxwnhF9sRmD3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jo7NAVpyHqSVFm0ZfJB4Jd_KKqgZOPkdvsKXA1TMyGw&oe=6A256F20"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-KpJAkxLE0Q7kNvwFKT83z&_nc_oc=AdrGoCzrpPBSB2-Cbsaz2vwTKvifXsHQwT1eyu5ln5TTukV4-mw3q-DS5nksedGfR08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TbQlQBO60Pna5KfId0B-FDR1eOtn3DzmR_MNx7SQyfw&oe=6A257B0E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZwfKysGXxkQ7kNvwGfuumi&_nc_oc=AdpQyOoIYgeYJWeL5b7mLzQf1ts74ovWeOsNyDf1cmPxkzyHT0lAnke53x49Ml5TG9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9THgK9ZGjFvZaT2abtc1-aVn8nnw9NMHbW8ho2r9ZxMA&oe=6A25886F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAhWTP7M-f0Q7kNvwFd3Z3d&_nc_oc=Ado7vqLUifRjzbTmdAz-K-oiDYvvnNV-sCAmuzlbSSETlr8EV02R9dpnGtqPz3fFOmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vqERewHncbg3dBLDNn7d-jo8HZJOnaeU-HqJwL1ViZA&oe=6A258D5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yvvjMifs00Q7kNvwFVk0qR&_nc_oc=AdrWehFTNr81e1IbPO_SD1xEL2g7_FV5G3IVRIt0VK7OANPUzDdsZro_5zrCaZ6rTGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qg5_gIqO319fK22JJFu7f2i2lDAlntWz-IZ106ghipA&oe=6A257F7E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
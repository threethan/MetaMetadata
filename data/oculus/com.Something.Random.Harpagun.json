TZ7qnBvE9KDa7ixAt-9HjNK_fxrn-NzIqZkhgzru6jvVMb8RgWeDQknBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6BP0_fd0nU-7oJlutopxJO0WE5ASg6JU8G09TbJHSaw&oe=6ADF52A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZPc5DdmrUoQ7kNvwGBgud3&_nc_oc=Adqj6lW_3_2XSdadoIsJ6bswPOh4zsMGdJELcBfIMq_k_n_XZgcJFvJtdWaffmP_Bdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe3DlC_3bL-kuIAt7fjJzuz30si1NonVIKnNkC2w-Cyg&oe=6ADF5E8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl0avrgm6-kQ7kNvwGbECNM&_nc_oc=Adoc_TBv5xjUFZ2BbvVV08OhHjGmP5-C_w3bRZiG4or4Sg2ZI2TqxvHmxd29gImLaXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYqyuXQR_2iAdZyNuy_QzG_4oyKnPTBlw8N2j6gn9_Xw&oe=6ADF6BEF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC1cCnSeeuwQ7kNvwGJvXvr&_nc_oc=Adrgdsvv4q-sVRwEsXSZNua9OcSYPi73x1EfYmjQdLdBD-nN9FbYRFSEbftVgOA60Ns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe0Ac6MuUYAk_1fcRECkeRBoAI1hmqNnGJf3SYqc-UTA&oe=6ADF70DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9IP61CZb-MQ7kNvwGT45DA&_nc_oc=AdpS6ODcCpi949yyWqQmzYNxXh7npNVdCHLfng7ybpCRYYKlIF7xq-qx2SWzi8B40oQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr_UHHE84VVBhJeqDsKyT7De_S7h7pVRapWN7c-KUadA&oe=6ADF62FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
f7IzCRdc2TBFfHhY27RxG_PrURtqN97oZADe1OXEEWdWTCKZ_mU1HUeYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ8RZ9d1EGNb9NjTcG_kFxBBAOfsZb5xtWjBykU_X-vw&oe=6AA6A220"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZLN30pXZjMQ7kNvwH70ioP&_nc_oc=Adr5yaiwL6-okmPyCo2qpQFVe3RMjd_0PKkECr9S24P8pMQf3G6pWM7h5sI_GWRIhgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrl8Jxt5D0ojDlkczGk7zttgrz3Ox18aLFFtCfHiugHw&oe=6AA6AE0E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwZ_QeC8mQoQ7kNvwEaqzEk&_nc_oc=AdrENWvTAQnzYTNXXEnYY5hBCKKScrcCczOf9wNKC7oel9sX2UyvVmWRT4R93OPdwBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJEYDIlZyKHXwyoMM3BkvaMIn-_BjU-viyfOKrbylV6Q&oe=6AA6BB6F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZR4kxbvu3sQ7kNvwGHZ1I7&_nc_oc=Ado3sOc_7NdUwsAuacG6c2CSUu9U1w2YZtRTKtULq87IkAzKRwkAnJ1UGCsqbBjiX9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDRg4Ihxv1s8xRYu2k5jtfg9bqDO_9Nzu2ODGNvNXlWw&oe=6AA6C05E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOxiZ2y-4W0Q7kNvwGtT0id&_nc_oc=Adrn4zur4cWn3cgkTgBOwCXgutwut_UlyOI0qfHzBRdP7_tSkDFV2kc5A6k1xX6hW4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTw_zTHfbXf-ZZ2F41qMB-jCuw_Xjp4JFglVX0hCgAiQ&oe=6AA6B27E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
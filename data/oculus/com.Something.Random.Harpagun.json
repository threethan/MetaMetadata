oe=699EF620"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oetwoDm4aQQ7kNvwEXzAeN&_nc_oc=AdlNq88WDohVW2JAC41K_4jZJ_e7CAIMidTGhCZMhT7lmcm4_Qt0f1Lol7mZJ3wLZGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftKxBkoRt3qFCza848yIihFV-M1zH0nNk0GguUQiNu1pg&oe=699F020E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXnBeLVjbKsQ7kNvwGo3Zhp&_nc_oc=AdlnPz2BRu9OYNcM0DHWmMVlUDRaSaHbyCL18U1h7OwZF4K2pWq2jJO2Jb_zxmI76qA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afumpuf2UB2KFWOjOOq9Q_8eQyZ5Ap70AAbM8e5hLydZDA&oe=699ED72F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46Oer8v4PvYQ7kNvwH0YMFf&_nc_oc=Admfatd9RwHmfbsOQY4rnKF85Vyk95JKyuTFb-Z2AyoP536sHzDbEAGCqM6nRk67F4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvYcpeLqyaFKc96Ir_8kGB2IaBP7zLiY3oYcS0DNzFtSw&oe=699EDC1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wj5P_obyU8Q7kNvwHQZM8N&_nc_oc=AdngVcF068UNW1eAs3rznO1UBwJVAynDipMzNSxMyBa0zmPKuPCcxjQEs486Dl6vvZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsdTbXse7BTBaQ9XEDBC0hsUBiTA-I2ZYhwYfTXnV8i2g&oe=699F067E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
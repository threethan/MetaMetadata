mAcbnhkRRc6UE-QQyoRui9MAO8Mt0Fv8NiGE8TMz5NRrj9lxtvP396qpE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dV_LPeoWqPAZKyVta3yp43H10xXd0s3GpRj32ko1n1w&oe=6A411EA0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZ4DbqUx0kEQ7kNvwEf4Gqs&_nc_oc=AdrsCDs-xTF3CxNc393dUdZ-C_59PomWrX4P7ZDdVvv2DRCG2v6FpilnX_FEPZZLZUc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VtXaS_ooV4dYGK67lZ9gXL-KypybfeTnGT4P-gZyEWQ&oe=6A412A8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L471fgTZKJoQ7kNvwHQ0YrR&_nc_oc=Adpc5_HVoTjybFQCXpWKmsCs5K3J1CGHfuVfJdkOnglPtP3iwmWNr8V-zZVCx53Vi4s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OJBSzgffYRV10PQDGND6grIi4HEDxWn-YYAn_e_EEiw&oe=6A4137EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5qrzIECxEoQ7kNvwGiMwNa&_nc_oc=AdoD82SXzEYOwLZWAaumTx5TRS-ybs7EsnJ2D5vEXcT7VRP23vmqOB_KH3eUy0VEdHs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xf9DGi1Pistedg9abGWPG0n5N5p28eypPUIXRG-AzZQ&oe=6A413CDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcVcFK-MBekQ7kNvwGLAllt&_nc_oc=AdpTKobytQctwjShVIsVRC9F4Uvdb6F5a_yh9wdj3Rb3obF41uba1tgN5PLJRFbY4m0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gg0rxLIVDBy4ETeVz6KaY_vnK11k9VcYR9Ba2dGfm5Q&oe=6A412EFE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
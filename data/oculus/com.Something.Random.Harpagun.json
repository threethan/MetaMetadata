K6dIJEq6XOjFpupajBDhKx54CCP5cY297WfRGc-IRwHCtd221Lkpipe6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5BNfcuIEW_H4H8r4pFtqsUlWHetKV6J2d9kZrqirCKA&oe=6A7C7220"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJm9qkiPoZwQ7kNvwHhIgXH&_nc_oc=AdoPUuaIQLrsBljZhxj_FSXzvH-WyAAmYg3tPLvdbgF6l71lqNuoMn2ICO_KCGd7N_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRW7l0Zq8ILv5sCMng9-iqul9JSmwiGzloNtSHknAmSw&oe=6A7C45CE"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tij1iU6vnXYQ7kNvwEv6nmm&_nc_oc=AdoSoGavcy5O6mVEzPPp7ZeDnIqDi8l3i0mzBfg5hDt0N08l25bFPBvzYUSKe8Xouno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhMOasxoSugtnYJMLHHtP4lRQjFpv1yVzzzvkpsa9U7g&oe=6A7C532F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNgcGXJnCfwQ7kNvwFvan57&_nc_oc=AdrdSi22WtU5ScAdyuE0pDnsIxlZPw9wUrCXYQa7QqnOqIlT6cFPkDfsVjSM7OAErvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGazq2tpdE8GV2Q9rSjbDNYqqThzOH771DEfZUc0KsFFw&oe=6A7C581E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP3Rd0dPkt8Q7kNvwG_8gaT&_nc_oc=AdoZ1dgmQo-u9pgAl6NZE4fxn1u4CypUh_I82GuUNK2xZU3uzuKH4-o-Cbo2zug2GE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdycrVXvh89y8xUueAhCmPoo1XzZNe2BxVdilw5_CQHA&oe=6A7C4A3E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
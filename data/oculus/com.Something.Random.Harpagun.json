DhFFrndo7r3nfU8TDATLXfg3xcygLmRuI8KoG-PzibXDeaIDDIG-RBFE0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFOKpJ4BMugMkcFM0v_zOqF3HlNE7BBYPK7_1DoO_JTw&oe=6AF9E8E0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msQoPE5gbsIQ7kNvwGYHBRg&_nc_oc=Adq3hPgB0JbxvchCyr8w2s-EppdSktj4zaUOwcUWJpyEncYyzCLw5d6Gi1F9T8so-jE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR60j5jJl-X0BT4B5tXh17A_D_044UZ2ouK1jaYOzy8lw&oe=6AF9BC8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hemf3CfYqEAQ7kNvwEwKpUj&_nc_oc=Ado3J4sClCREdDTZPCVibosDYNdhYNTCVopbrI5dAKzIar5hWVAVqQzvoLE2G88N6G0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToGVxirlSKiUdpLQoGZqscl9e4YnSCHWcs-FzzTmWJAw&oe=6AF9C9EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1cFWylHxEcQ7kNvwF_7T9M&_nc_oc=AdqI2-uNjeyjudsndmEzN1oSZ_W0hsUwEUPXUWqwgWMz7KTPF7HW-zi6VEHf8buGl08&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo4uyhynrSxuOQHorf_pwGyBN72OSuTvX0wGIm76JC2w&oe=6AF9CEDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J65Cb91KLH0Q7kNvwE5AqMI&_nc_oc=Adp1h0-X8-9LhBRU_b00tpKVJ9nN06cDn69qK9MMgRB-fnkXpAgAnahYHF9qZHkBGZ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSixUxfR2aDcVUp9oqAys55eKx3gG8KqtMNz1WXV5Rg6w&oe=6AF9C0FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
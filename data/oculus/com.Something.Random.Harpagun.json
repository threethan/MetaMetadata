3ZJkdOOzokw87p3oNMI8D2JlLLuHAZBLK0jnmrb6zYp-oaWQqIqkq_2MI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxj1rkvpGrDG_fQRiPBGVYKliddbbt0w4JQy6qlVvsrA&oe=6AF5F460"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t25OZHYV3P4Q7kNvwHha-e-&_nc_oc=AdpWlBZk05QxiFsKIYvHkzU8Ay-dieQ7bk2GavpxX7HppP1iu_A4Qp-8HWapXdqnz1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkvBszdZWjE5lhpr6nLtw9d7RvKX221oR2ySH4BeLb_Q&oe=6AF5C80E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMq0_jBwfscQ7kNvwGsRBQp&_nc_oc=AdqN1ZEY7P7jsmpeEz1pHxHf_TgGBkv6yusJ1TwbiVynswU5GtKGWATmXqBLC4EWpLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Lpvw-3Vl7WC0Q-5fDMZL4VfMSOJKCnWlz9ryqY7pMg&oe=6AF5D56F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwlZTc5UYCIQ7kNvwHdKkNq&_nc_oc=AdrxFnLvzO77-92Hmcv0sQaQbiEQnJD1RV8zMYZRGITdFJJY3JGxaunq3NgN2_6VVCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd_BVTaW-TBE00cBTQ9456oZW4juuIUe_2gCZ42YTGxg&oe=6AF5DA5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfNafyfVPNIQ7kNvwH6ENQm&_nc_oc=Adpe13yp7o90FLgtLD_CISMRAAcDp8dNxo-9Og0dcHCuiAk64ol2X3UyHjfEoeccTNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiMOMg-xTC9pGcwScG4_8wqNmoGldCPuNCkdqfQRpjCA&oe=6AF5CC7E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
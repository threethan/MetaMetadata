tqX4Ef3SkBn6rT3yz_1h1YAosOZS6EANoMsbhwBJxuRmJuomunJS57OZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1vrjT9myqeh_rM_CPn6MfzjsvA2bbIJ5FV7EE2VvZHQ&oe=6ACF80A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrwI73_uKngQ7kNvwEOJ2HK&_nc_oc=AdqktbgDycUk_JUrdaf963LeWuquY2FCymzMdz0DS8-73IJWJdsDsLS7NIpSiCbFnIM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd5TfCuRq8j_JkR8ic-9VihaaEDY5RMVv7GXOhlmszsQ&oe=6ACF8C8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O28S8ayQqdEQ7kNvwFp7Sdw&_nc_oc=Adr97cYVYwzLXGwTBKku3NeeGrBgTjnD_Ci-00XPn9aODOvAfJL0dP6tyh7hm3d1ygk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7mvLoew3G6DSBP-YueiYvR3vmJlmHqpAoNO8Ce99prg&oe=6ACF99EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K0MdXDCWqAQ7kNvwGGtgFI&_nc_oc=Adqn9AzmtmpRIhiVgCXF46n4fQgjyhpyeaJQMmCtOarjwXS3v97QwC8oQ4VCdG2L6qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7QmbpByUM26jPGkPrZHSo5P4eyusu-5HZCYVBLWzUDQ&oe=6ACF9EDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH0OQ9Dyy-sQ7kNvwFQIiD7&_nc_oc=Adqz2Hi60TvJvAAGFfcHwBVXEur-jla6FDxg93QCxiimPvDhNO9KipBXeOLrGCb4Sp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7c9dbvnAzur7txURZnVAdhH1qznGwW-ynWmpYG8A53A&oe=6ACF90FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
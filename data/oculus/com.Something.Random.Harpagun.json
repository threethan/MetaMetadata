BIN8PD8tNH1HC79MJe_Z5ADrN07AtP8Ft1Mv4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftpQqIJX3z9J_lOvNrUsC9y4kHhp8AmUL_oCdayGC5wVw&oe=69A19FA8"}, {"file_name": "2024 HG screen 4.png", "id": "1054432909633298", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974702_1054432912966631_7046083185660917993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_XY5E_DpyoQ7kNvwGfnVm4&_nc_oc=AdneQfXDX0kxcOe0-pEnqEDQDf90vVoSyCgo1j5Xf0ho3gOokgm2zin7pVw9ATYwfZ4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuwebjtMQmkqwzAcbpqd8X88p6CTein7sQjYkULPN06hA&oe=69A1A822"}, {"file_name": "2024 HG screen 1.png", "id": "527879776285288", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75557067_527879779618621_2727265542105493653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjY7aWQSM3MQ7kNvwF1ebzf&_nc_oc=Adn3seg5GKWcbqyh_D1jmK0e7patB1yrCre2M6q56E5PfvDA7y6TXO-6UwTi9tzKFVE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftzUvF0QZdhqI66D6iK4OP-IbtMYM55-GJYmWmRNWplLg&oe=69A18B61"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=451TcGRIfoYQ7kNvwHoNN9c&_nc_oc=AdkHq3Ozcs6fGiRtGLjp6Hy7KXIa4sfqXVj2uGICq5rjtec5_z5eF0bsGmeuS1cQDoo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvaLYTDO78uKnpE4m562gjw4-hMYG57r-eutD_OgghPlw&oe=69A1A67A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrUxIPYVHZ0Q7kNvwFRQmGq&_nc_oc=AdnZTSrk-1rJZVKFxfvrQ8fZnOr7YrSQCXucyXnxFd0CVeJwwbPfW0KfON22nX6s30M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvys5yOeja6oy1VrL0o1Dyf3rDdznTv0l-ymIU1C-hTMQ&oe=69A183A5"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "s
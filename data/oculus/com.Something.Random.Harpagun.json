t=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MroScMU6osntJi6Z-BtEk_S_kn-Zto5OCdaY2Kw77fQ&oe=69FB2EA5"}, {"file_name": "2024 HG screen 3.png", "id": "422911767473865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_422911770807198_2018748843549627820_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGLhQJcTGPAQ7kNvwEXL_E8&_nc_oc=AdqEdfXV89MpJkcpG2hfiwpqJIeObP1YUxiegRuAriv1iXdUTYXp1uRT9VgFJrhNovI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sBTIXztcoYhX3G_keJveLvePMGI6VFrRiNbLkcZ2gPg&oe=69FB45A8"}, {"file_name": "2024 HG screen 4.png", "id": "1054432909633298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_1054432912966631_7046083185660917993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITZl0VgvVCgQ7kNvwHdc0j5&_nc_oc=AdrF4RBdgI3x324HNNVZ_oEqS2Rb_L20c7ovtZpmdvRiVZ8U8bV2UmVPVpBerhA6_q8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XFissf0FlkAJhfdy1QF7J2bOz3gATTmQPn-bI3svbaw&oe=69FB4E22"}, {"file_name": "2024 HG screen 1.png", "id": "527879776285288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75557067_527879779618621_2727265542105493653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhpWwrL_KA8Q7kNvwE870-V&_nc_oc=AdpaCFYE0mupatdMJmH8Vei5-vW37gSs_N8x2MIqUpvEoZSnwTg_GzCRQdrmAumvb2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KAhRsbig-sQMEDE6rqugsZFYncKYa--cQO-eDcJxGRQ&oe=69FB3161"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFRVhGhRpOYQ7kNvwHyiQHH&_nc_oc=AdociizbazIBGjQ_GT5GO7AZc0Y6Zm00-cVK6OB-RIrhg-_cSyvx6kChxQonYOnZYEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b9Xj3oWDWFXxdImmljlSAZretQC_HAEa2VbgUW7JhmA&oe=69FB4C7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFz93x_BpwAQ7kNvwG4ZcOW&_nc_oc=AdpZ8I5oEpRrkgOCVkzaY-ychyoTjnQvVB55ewBf-r8e_FmrNEc4zKgfulGbtTRxv1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66iT2mLH7cGa7j9dHVZHAT_ficZ6rovv33ckmiw9NnrA&oe=69FB29A5"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
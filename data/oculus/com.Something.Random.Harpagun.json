1NntC7BZ0LRlwYYj3rWHbRfLXmQ3vMxfSPpPbATuOviQ-HT9ntYtfJ39U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I6pEg2RmwqQrFmAozVFpmj_L6c3lGR0jFCLxhgitTKQ&oe=69D3B220"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcKdOxKEOTsQ7kNvwFBkbr2&_nc_oc=Adq_XkQCI5uBqokAW3nu5gH8pH9V_F7DMRmd51SDcMI47BOCNsQOvgwuKhVzTBLj0Cw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af046cjFU0rU7K1299U__IdBCTTd3Q1_vlcJY714ZvJ-pw&oe=69D3BE0E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d1CJRA__tsQ7kNvwGRRx1q&_nc_oc=AdpHCF5Xfh_HekM1cNgHkM1yM00DOVrNXcbNskMypR9J0SzlkDNRYlCT3itPaW-RPHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ilnweQUvExeMbh4LO3weRczIgA1aEtc-vcMU-vfndGg&oe=69D3932F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQfX9Ltd24oQ7kNvwEdAn8Q&_nc_oc=Adq6WOXoF0I1gsr4dl1kYZGy5Kp-kwjkpJ0Yzv6dLA0qd-OpUT2t_nl1yMWVUYF2L4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sFH9qMjlkGalk4ExbAanExA2JyZ8fPgrcMSoX46HQoQ&oe=69D3981E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Paq206ImpEQ7kNvwEZNYuv&_nc_oc=AdoMKfJJTtfRcDdMySTfspUbzsn_jzgWUv2AnXT7LCvjINsF3uPzJ2GWjQ9-1-tO0ZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o39e_-aepAgJjbbioqvi6gIbHN_u4rbRvxwIu2Qi5Cg&oe=69D3C27E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
1K6PlwppaeKHhTMNXGmDnTRTVTwSyJKHxQdIrJI3MtG7V2GnIXwhi_Gm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn3WGOtcxvVvCHl13EaJH17StrKmjRKYe8amjdSLxnGQ&oe=6A95B6E0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAgH39koDK0Q7kNvwFMHHlS&_nc_oc=AdoeIcUtUQFAznkeQn6ZgaJJBoBVDB4ZrfR19siYFh4QcYf7SuzuMs912qpxgBn5wZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtUfjB3HptvaB9nQaVw0YMa7TbyC2k-qds4CCi7kXv3g&oe=6A95C2CE"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6StbKTjSCs0Q7kNvwFm_AaL&_nc_oc=Adqe0iCBLEXGoGgXratTyvsPF8nTF-OgF1KbPF5iAu0VZfqfRFHKszkg8fYaeNRgGTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIUKn735RuEt6RsV5PbFWaB4so8cd0k2_v4-RZA7DUAQ&oe=6A95D02F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2zDgRKUbfwQ7kNvwEOHVoD&_nc_oc=AdpV5Yw58aSY0-fIgqYTLpuCM7OsYaP6do69tUsyAINvJ5vC1MzrzfF7496SwafkzA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9Fwgp1XfA7Oaqbt6-3ys8Nvo5QWhwb9cR8_611dtvMQ&oe=6A95D51E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTlqKtdCqo4Q7kNvwHEa5OW&_nc_oc=AdqqO95otTRXX4rXF__sS6qfNpt2Fd-PVSU4EYCyLYCg2PoZ_viuxtvAojDyOLKAy4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvzczSzoNYZFrXJxFmHK8xZ8rzRn-t1-h1wYzBDepoMA&oe=6A95C73E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
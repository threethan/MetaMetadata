JZJ24s9axavywu5yFupdNU-CCQ9bnyVIuuolRlteD2u9WAhF2bbtMwuPQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyiOySBu_OPF0rm6VaJZHnIhfvlmMi-N2KRDnKCFrPFw&oe=6AF0AE60"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx6lnNs7RMwQ7kNvwH9C7Ui&_nc_oc=AdqEEpwBQrJU4poSWADRNmsQKeBeApbQczj6GDOamWHjf0jgSNRei8qNs7KdhGWx9oc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX0L-O2Ec2wFfDUIleGZ4mSwtfql24AraXKYHtBghCAQ&oe=6AF0820E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ffHSZ1fiYQ7kNvwGn7xXL&_nc_oc=Ado3B4puF41fUsDfbaQp2HSnsBYDIEJOiZaf0xlRANsEXNzBpIUbzAjulBsTBGMEjfI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRn9OwX2ozm2Z4YisC_YjeYUZmE2gr_j-DPP-BynLf8w&oe=6AF08F6F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Mk6chIGxNgQ7kNvwFU_c1p&_nc_oc=AdqzUzwx4411eKBiT-FnClMPlnTD1EwsLPGR-_SnOBMHmIPwsvgNzk2e-lfyqLMr2ls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRidC68FrC0iUe07TxCKXzPWasEIyVz3CLM7H8ae9czgw&oe=6AF0945E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWq2_c6phHIQ7kNvwE-JYpU&_nc_oc=AdpPEVgZmr-DFuSrTvqXBZCZX6wH15o5-51y1y-OaLEnQQar0WHbCPBYssTpkJhAs6M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyrH4MSRqtoyOMZ56CLFcBNvcU94M1W5aeRWZ5hz8Rlw&oe=6AF0867E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
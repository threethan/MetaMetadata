fZzl50QVhiX4RUhkG12AS4Q1Wjf1hTHavBrrljXNDFG7LukaQRjMNmZg4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y0Q3r_DtieoPsHnePfgfZDhn1ZfhEHzP_2f0ImMMJiQ&oe=6A2C06A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG4knKSPDkwQ7kNvwEs8ho1&_nc_oc=AdpopQdJX5uiYqU2G55xQmwIoCBHZzgntX25PJOa1xbBN-nDRYAQjqaWCkQISDt9Cqg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3wKLxDAfuIt1-GBo1ekt5jzbUkyOpu60_thlvy-py-g&oe=6A2C128E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cRnHf42sroQ7kNvwHoqw4D&_nc_oc=AdqDWnrwGSud2P8NDOfw_2fAVg5KSC8tK8abVvpWCs5buRrjrwXPUcYEEPepL7_5zE4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yWLIR6N_ymmFiTChcNOKtQMf0pr3FBvFqyA_RzVzzrg&oe=6A2C1FEF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7ORJEeyrtUQ7kNvwERF90X&_nc_oc=Adq7_5AKDsRIjpSvqVNHAnKpQBVG_jjCyI5YaLcTcfZk0BOY6MB3FvFoPDzwyIPh75E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v3ubNkmCRJbzp4of0y1B68wH6yHfWRYnJJf2GAsg7iQ&oe=6A2C24DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC0YF1Av11wQ7kNvwH1sltA&_nc_oc=AdqL9EekQ4Mn97huYvTNLou9Dm_3_Ew_1hYl9YcZvRh0lV_0h6_UdO0uXUsv-Zbx9w4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QWdncbeuR4-qNGmooIss5bwQMmotYNN66-IP7_BTmeA&oe=6A2C16FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
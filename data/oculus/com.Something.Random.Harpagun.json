AclDB88RNI--RSJi4xvHPW_bKbMLIc1vW6MESBLl29V2BaYCKPcJb_rLkhyQfuk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JlSvntvzgdnT9nR51H9OfW83CJE7cQiUAwGRW8PfGQA&oe=6A11A8A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tpjj8hqCX9gQ7kNvwFvRi_T&_nc_oc=Adq4qjLHxKXPSRvH_ePT-e4Xy_iIJ1CVC3rByy85qGcRpZAtVB-Pp9tOBaawCNHO9nk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w0Cv88DaDWm6m5qq3DEzT2290okzb_TiCjiVAXENVrw&oe=6A11B48E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTp1BClC7hoQ7kNvwH0yS14&_nc_oc=AdoWbzJ5wIJ4bjVqyyldQK6yoqcdaWUnaD-7xhDzyPT5MqW3fkk5Yk3t3x96sBzrV_Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NVvjnrmeOb6hVkALYV-828xIy0oeikWZDHRIw86wjiw&oe=6A11C1EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwvxQYhd97kQ7kNvwEJ4PbN&_nc_oc=AdrEWB_dBoLoC8oti5R1Jr9ZT9w6j1cV6XaXR29pb7aC5XsYd4TZ9hbIcW7_WGvH16s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LbflLY-pF1uILFNg9GZbF2bgk42MOUtrt76HjYeOGLw&oe=6A11C6DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdc8hdYVFpgQ7kNvwHzcEWp&_nc_oc=AdpO__hsZvDJCN1m8o42rpSglVilb7thArqcwzJy91jbd-M1AO-CxBOtkurHvwRb7gI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HIDg0uvWCVCK-lTpFiARbqa6QANCyu-sTP5f5xpGbmQ&oe=6A11B8FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/"
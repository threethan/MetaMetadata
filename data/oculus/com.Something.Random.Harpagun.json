f8Fu_y3hic5RWAC97slkU2JqKF8KPhNmE94WdN3gzjHDrC1xDU4DxqY0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBxXakTKIgBPnbdwMmrPBqom5cthX4a8Tn5nKyRAUZlg&oe=6AA7F3A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZLN30pXZjMQ7kNvwHcTrVR&_nc_oc=AdqwMpH9gUXr5SCPKFcjWeKvv6gyFAlhqR58W3iFsKFsaks1SAsy6BykDWV36yv0Ey0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ2MmDg2cxfR-NZra8V4_B5VigYgyAOL1qJFwfimKRyA&oe=6AA7FF8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwZ_QeC8mQoQ7kNvwHGE1DI&_nc_oc=AdruinrWv1Q1Cwvq61O2mM5yKxjS2SO2Ei3QVOOb9bLZmvIBSXDjbWQgPqdTMkgnAXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8Uld09BLte6-prbq7sU7NTkPvapPxNBsiuLSMlrsrZg&oe=6AA80CEF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZR4kxbvu3sQ7kNvwGmhNEY&_nc_oc=Adr-Y9LDfAyM81iVnkUezapXKcyTwQsLW_rtW1-4Jw3guSTCnaQNFmyRI3vvYDatuv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCV1C6Wji2i6GgRIAdlffxmGEpYjd7ravhgnlrfq3OuQ&oe=6AA811DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOxiZ2y-4W0Q7kNvwGCHW7j&_nc_oc=AdqUz_jVoCv7dcr5oARh9oTJaC8Xl4NYNb5EogXjeu-uS15umnDJoFwCSLXkomy4KxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM5BWl-nVroYyR3PUid35qaI97R9z9gUs0e4W_IkKYoA&oe=6AA803FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
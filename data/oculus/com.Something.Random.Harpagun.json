jNWHJI742fno39-bz0PIcPe5CDNSWVNLTde3Ew45TWzwL0yRfxpVHRyHg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7yFv7k0OWznIH5FlY8BsGdfd854dA4JjenLfLle9zCw&oe=6AC797A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPC7Soill4EQ7kNvwEcRiQ2&_nc_oc=AdpaAM0Yn8QzwKDldXxuAS1p_tHRFl7LTQcVCXWWNtZcf1gLMZ_wivoS-2HViqehz1Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkG-W92thE-t9uipWOVizxPwCJSi1AkjbO30F-2QKMgA&oe=6AC7A38E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOoTZh_EDtsQ7kNvwFXX0xy&_nc_oc=AdrfVVm_EOCZjMmlmnZvP9Y1HM_sp5YnhPA0QH9u8tVjTKxdagE0vzT9Qpvt9u61eRQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCcjqhuhzhsTNEg9RQeRuZaAdvIXap-w5SV2nxUFuL4g&oe=6AC7B0EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6kLwAZyIHYQ7kNvwEPcUcR&_nc_oc=Ado6pwPRAEEk8iFIdYkvkrCPvk2kqrXUSIlCrjy4y018O86u1jOXIxM4MeveGogbWBM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOqRQRpthO7hHmkWACcs9b8QEXT2kHczl0AcCefQ1j0Q&oe=6AC7B5DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8lJUMZLZloQ7kNvwGhtSu4&_nc_oc=AdoXP5CEWR4lUi8Jk89h-8O5dLnBunwfK_-bdkXO11fDWCacEAS2CqxXiaJls3vjeUM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGKYR3v1T_N6APbrkjXIVX1vmkIOl1KZcXkDRiVu_vug&oe=6AC7A7FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
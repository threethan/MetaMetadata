jAxvGNuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHSVy1QcP5adaDcm2vov3CZsEm6IV8siUUoIPUqioggA&oe=69B019A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciMsqdy1Dq8Q7kNvwEQICiH&_nc_oc=AdmkhUi1O1jqnlh7t5TP3wHNVAaadXLpjx90fqFZLWtzDddKj-NQglMZW7dTMgeM2JY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_ThLKmUAFkHFPw4FDKnJbI_t-HottB7y3fHf-qaHocA&oe=69B0258E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-wX4J6HhkMQ7kNvwFkXYzD&_nc_oc=AdnSg8z7xQ2U7YME0hx-_Np6sKBKKtKd7oK4GqmIzbWwtC1tRJi0PpxVTasjpxxbw-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAtX0XQIxbyn825IskbIBEeczmHC747Sn9_7Hyjbr6XQ&oe=69AFFAAF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN_ZhW2GTvIQ7kNvwGhgzX6&_nc_oc=Adm8weXDSMmyXXbMzXTyZ1CxM-l5gXdnkkld2fkMbkYeeTdTLQvDHUqceISOPc59An0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfydWmAmcTJIyhSPnklzBfazKA0UUnpwrlV17zj1q2bcvQ&oe=69AFFF9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcGJ0VJb0z4Q7kNvwGeUNVQ&_nc_oc=AdnscwskNP6KkrPreuap81YjHe-fbWahwi58wbRDF-_rjS2pxdQxcJDNWXN8I-Ot7z4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-z9qyFGCv_R6M3QxxZmR5Waj2o9ztYwiN-Z2-cXMI9g&oe=69B029FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random
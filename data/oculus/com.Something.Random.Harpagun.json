1uPbk9mGMhrmLdaOFautxCDlCguKCzuJ3KT031FePfsQpkjL5j8Hxp8dI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk8bKXFXXEGzkcRhtjFe3YP_caW_dpiwY2rDQP7TwV4w&oe=6A918A20"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd-9oOEC43cQ7kNvwHQ6zzA&_nc_oc=Ado4H0gogJAsvyedoera_6FOlVf8WFKqYU1Gg5afrpXN-a4S6QOyFEt407h0dzFcS9k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcsw5I9Bk5WfNgri6Zf-yhEiUVPZX-9890VnaTa5kh9A&oe=6A915DCE"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-KlalKb3aAQ7kNvwFnuRGV&_nc_oc=AdqyQfZ0G3FLJRN2HrJsQWZmP9qF2wV-7-7zziBsUbDbH2Ff_TwH0oA9anLOWPzv5jw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuasy1AxNeampAlYp9Ca9wH1RnodQVAoxc2U9weLrkDQ&oe=6A916B2F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vGfAnzie14Q7kNvwGKe-6f&_nc_oc=Adr5r0tIaioAVq-RD0XKeHY9cOFBl95Xc4w3SiGv1G4kGx5bWzWUm3ci3iSKRPmYfVw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDMZf8gG3X7YU-GfK6xlKdsb-YRFcPhNEk18J6a1XakA&oe=6A91701E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD9V4MmzHm4Q7kNvwHprF4P&_nc_oc=AdoEyCglWlhlFdX_gQXJ-SlWx5oIpNbB1tmQa87igZN8DJBjZl4yPTI4yXk-vztZdiU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBc0TkdhXDfD1MR6sgqFjozNJkrVCKniDXCMHZoZ6m-Q&oe=6A91623E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
AuO49t6gc_TVC6eh80qs4BpNJq5mXfK1YZzJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftPNFBdiSHvY852kleE7gdvERGbl9S4d_dEigM4umYvHw&oe=699EFCA8"}, {"file_name": "2024 HG screen 4.png", "id": "1054432909633298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_1054432912966631_7046083185660917993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqK-nKtCFu8Q7kNvwH77C2_&_nc_oc=AdlLQyUAsMs1nKVNLhBoZXH5zq9NmawfdCJLdF4_hyLcZVJHeT4iuSlhmZ14HTMMuXQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft0U82Vz7lpxIAQToH-0xIgFdZhzvCj_Inw5KmWfd6HGQ&oe=699F0522"}, {"file_name": "2024 HG screen 1.png", "id": "527879776285288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75557067_527879779618621_2727265542105493653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNam2JgfaFEQ7kNvwEcVKf5&_nc_oc=AdnilU_sha3xO0g1K_ZLDCdVwlT72r-C5Ros2zc5iuAJUEcjgW7cK7-7gWPoxEDynYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv77ooOKIz3F8qlBS4OaDDFKJ1li6aZkLMeBjNVz2oqUA&oe=699EE861"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu_B0eQ2MG8Q7kNvwFXVrLR&_nc_oc=AdnB9-xkV2qUc_sRdm1kFqrV_Oesu2l5Y_2tv0i-O5yEGuKuacIj1bTCPekLMITNndI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfswqrUx9pBWUcaX8eKib8DiqJbJpJk5UsUobs6LlEo8aA&oe=699F037A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0uW8z2t9YwQ7kNvwEkdUIg&_nc_oc=AdkSPl2p88KK5EyWD9chkMvJWxxRqw9nf3NTYfohQ7EmcS75lC30Rh10K0BMcRUAIu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvgq-yUf0t-mB1txCVVkmB8t59fBfqydJkBOLOgUoUnng&oe=699EE0A5"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "s
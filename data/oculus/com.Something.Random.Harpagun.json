Siv17jgY9yD_Ole3Vw7Z4cKZy_gI0ueHNTHRS3ENCpYzGWszkOw8d0k4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ikCLBBowN96PKCtBrRDbpGFjcFFOnyOj4NHwbSGEl-g&oe=69F89C20"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6nMIGq2XmAQ7kNvwHshrka&_nc_oc=Adq9wN-j8ioZ69wKZazc3fDvuSWSI_P7FHZy5w3npHSaXlR5e79JqZec4Wpeo-sDbnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FHnEGLmxSxicc_k6cKL-cWbrwnM5B5AFCphoieTFJ0Q&oe=69F8A80E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc7_dO_kNaQQ7kNvwE4NpsB&_nc_oc=AdrPhhr7o0yq2vZrhxZk8jswg9-DPKNQsuBubxxEabCE5Am4fIvu_Warc_H34TCY21E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Y1FEB4w4TSqXDJUaW9gfSEnlYDB3nTKf1YzUGl6SwaQ&oe=69F8B56F"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKoEp-41QhIQ7kNvwGTCS7d&_nc_oc=AdrIVMLlXPS9oBGg48jaofzp5wllp2gASuGHrONYUi8OnfwuBJ2ygSCr_b5uXJ0asqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KXJdQeOBIYgDYNCsUTvQQB-M__4kpdbR6CjLznaEWGw&oe=69F8BA5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCrU4Tp9Y7QQ7kNvwEIb6xX&_nc_oc=AdrOQcSNILw5yc10MCsT6Mt1YBr-Iudv6NJRXcbh3AlzAhv5H1SaJGtCxeumO0nJiJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HWuJ6rr6uRkGQDrgBXYdJvCUM7NTPWaQdskJHhnbTgA&oe=69F8AC7E"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
F0p7YXu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBc3LIUWeD7Dv4s7R0lx6X_WBdcxvsiGicP3CKboNmTA&oe=69BFEBA0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3TmTYx57SMQ7kNvwE-U5tf&_nc_oc=Adnk6y-rhTqSABSJxmVnoyBeQzHj1ADgm1iDYPxF3HuxoLBNW1C9l35zattK5cJ4Ois&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8vxQWdqP5irwF35ztnLVzv1oE-Z3OegQl9YSIWKVhJA&oe=69BFF78E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdL6SX7NECcQ7kNvwGJEH5Y&_nc_oc=AdmQsEdSo4cTK44pEcxJcw6Nwol58xxYMDsKH5tqscoE8sf5hgidfuETDhoz9JZFRag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxT_VHpET4diilj7fHft30MVhDmYAtqWMBXCHyOod3ijg&oe=69BFCCAF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4hYeudKG1EQ7kNvwGPqR4p&_nc_oc=AdlrUJ73QvKotfsV6WVhLw58ED2-vzuKu2ImfVXM2eud4ie4JjB3kMtNQ60ZFLUC_Us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXvBRZrp0EBgJI6n7-u68qyy5ZRFIPyzWmE5426xxAJA&oe=69BFD19E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yImxAXjyu8wQ7kNvwEq3RJa&_nc_oc=Adm62MOYcYA5fbePCH9FFJbMW4LllFYgJ78gd3rvtBXAVg3jcxZY0lRl9k5hZ4h0ja0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqZ000yHt0NspvuTDRwyCrTf8IVLESOE-3164ej0e4Lw&oe=69BFFBFE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random
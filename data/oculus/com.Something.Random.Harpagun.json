uE7JyYwx2_xpk9alOAWdrRBt0mOdp4-jegjhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftqIWwXZfONju_OGlFhTSLIQE-YxKB_2qlNyw_lqZRB9A&oe=699C59A8"}, {"file_name": "2024 HG screen 4.png", "id": "1054432909633298", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974702_1054432912966631_7046083185660917993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqK-nKtCFu8Q7kNvwF0sKX1&_nc_oc=AdnXHbzXa3ysADRw-BSJTsyWP6XLU8wSgOAHHbHG-Nb6i4Nf1I7cLKouhuQu3yM5QZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftbQMVmYKMww1jPEpoolIanZg6lLA49_42kcZmBhzhe-g&oe=699C6222"}, {"file_name": "2024 HG screen 1.png", "id": "527879776285288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75557067_527879779618621_2727265542105493653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNam2JgfaFEQ7kNvwGtEpYg&_nc_oc=AdklmrZktjgBW_YgF-i2_T8jN6s5FIJTCN6B93rEP-Yx1jViV0V8ylDMO16rEScLrwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftUpozyjVYAtP7c2XzX3Hu1b8ozhPJWgf8uTbKcU0rVHA&oe=699C4561"}, {"file_name": "2024 HG screen 2.png", "id": "3704187989892735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982651_3704187993226068_2653672913754187359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TukJHvbHiYkQ7kNvwHVmfA7&_nc_oc=AdmC0hPp5Al-yvI6Mle9gDD-MzItJQq7enCwShBotHAktja6OMnRkui9xMaHFEx_zo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfumhscP75yUzpxSyNc3139oNQE5foJqX6CsqvA4aHkLjQ&oe=699C607A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024 HG Meta  Cover art.png", "id": "1870037076837448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451774_1870037080170781_4936049721755154926_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-miJGXcTVggQ7kNvwHljOUd&_nc_oc=AdlNig1YOmG1AGnRGM2ZJJRxeebRfNCncTqahCPVx9aSyYcC5j_nIgWPSpoT7_A-P_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsBzBPXBr6Ts8P7qVKgzXK9vj75ABwba4rAWracwcnu8A&oe=699C3DA5"}, "display_name": "Harpagun", "keywords": ["Harpagun", "VR", "FPS", "Gun"], "long_description": "Be Harpagun. Get stranded on a deserted planet. Accidentally destroy your own rocket. Be swarmed by insane critters. Wreck stuff, throw aliens. Argue with your useless crew. Smash more enemies. Meet a girl. Have hallucinations. Listen to slav beats. Shoot living grenades.\n\nThis a game. In VR. With story and stuff. Also combat. A lot of combat. It\u2019s good - you have weapons but won\u2019t use them cause it\u2019s more fun to take a washing machine and slam it into an alien\u2019s head.\n\nYou can move stuff with a gravity ray. Enemies too, just yeet them into a wall or something and they die.\n\n\nIt\u2019s an arcade game. You know, one of the ones you actually have fun playing. Like an on-rails-shooter but not really because you can move around and don\u2019t puke. Just try it, it works. If not - return to sender, spend money on other stuff.", "short_description": "Harpagun is a fast-paced VR shooter where you smash alien critters, argue with your dysfunctional crew, and destroy everything in sight. Use weapons or everyday objects with a gravity ray to wreak havoc. Built for VR, it delivers chaotic fun, immersive combat, and a wild, hilarious storyline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Something Random", "support_website_url": null, "website_url": "https://somethingrandom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "s
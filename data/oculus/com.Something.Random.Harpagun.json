DpQBBuKG2bir4ItNHQOKOgyKwsFpWBd1pa5sGXwy-WLL5o-1Vgcc2zvXw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNiSFxmQmwAfvHV7mE_X5qa0-OHUT1xPAraIB00aOXDg&oe=6AAD39A0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gu3sHgRkzMQ7kNvwHwtuVo&_nc_oc=AdpOR2Q_yASxuPIc26waCbZZeYejkl9ZrH2dTMQOooGfA6eqcdiL1wgH1f178c82zNE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInafT4HAkpJGCyTU5QWE8JkLko_pB6vLageGmhhLerNA&oe=6AAD458E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptmAnzDbhL4Q7kNvwHeqVtm&_nc_oc=AdrwX74Fzbd7lM0ASBLaLuQZPV59SoZgdXvRiQY3CW8jv_TaauUP4bbkzxs-XAxbhY0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpV3FObc9BQ0v5nL9OEYOb0QIISkMNz9x9KDgt1mXG2A&oe=6AAD52EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC1_2WNIkKsQ7kNvwEDMgBQ&_nc_oc=AdofBv5lpbX5LAY7XtgArdSNDflaJJgs0gp2Rk1ECz9My5_AUtqu_SZd-ybTO7gsxJw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9dZwRyOlrnIzwIMHP5AGWiZaeqLrxcTIpnJzOyG1KPw&oe=6AAD57DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEstVvb8N-cQ7kNvwHO0C4X&_nc_oc=AdpMTLuXAntF8tahbg0TCX_TAuyMH-LLry5v_o6RVOc2Ju1hbtBr2Abx3-sUbU4vwRM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi8vV3mfdHvutl9-5E-d3JJFr_nBHJYTz5uZGeekHryQ&oe=6AAD49FE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
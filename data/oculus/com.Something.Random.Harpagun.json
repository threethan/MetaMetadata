0yxw2P8N5vJ0cOpw7xNmB5EPx-3ygEOHwv1TzBGGh5l3X5uMJrcKz0ng4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65hK_SwPsy9xQ4iSnSVxtOyDjLhW15WoYpNO9Ji9oCLQ&oe=6A09BFA0"}, {"file_name": "1 (1).png", "id": "633349055925298", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393901_633349059258631_4933730090199956324_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1rxLFBuZFIQ7kNvwFjPIVW&_nc_oc=AdqG1OtwZuE-QcmXCo7JyNol_2l07ilQh6CZ2zclRnedXfrgbEhtbs_qYLQoP6piQYM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PqbrzmBvMz3AcjuuqMJm1H7XXYWeID7VdvUCWKjZbqg&oe=6A09CB8E"}, {"file_name": "4 (1).png", "id": "1120706306046756", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393328_1120706309380089_236304662529196651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74kLBtXg7pcQ7kNvwEyDE4G&_nc_oc=AdqMHlguoSUE8F0IRs-qq89NwiX5Tfe7PWi8oetVZ-wIKsWVCZUqeuCwmTSRcR3tTqA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AQ4riKrvDFZGhRV9IBXTMOwYXYeKFakLn6OV66UyTPw&oe=6A09D8EF"}, {"file_name": "5 (1).png", "id": "1521943535138836", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391937_1521943538472169_8219480418294683202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAvoVmSHXfcQ7kNvwHYedQW&_nc_oc=Adoi89UIRUep_Sh584zkCAxfor8yebB1An70vmIIpQNkPtkkpI73psu2cyqRS_oaSSw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lO0yRXv0Aa9Mvw8rxaBYSJQI0_9iz4T9-uFDPfOdldQ&oe=6A09DDDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HarpagunLandscape (1).png", "id": "968233611977036", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392016_968233615310369_818056555988740763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfd6IESfte8Q7kNvwHt3lc4&_nc_oc=AdrGuD1AsgkGe6Ij0emyB_olOq3wSn3kDmkib1TKgH1_Jy4YXoshuT_Z0GLQYue3O9g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jNB5IPg49rJl6Y2fTDDmF3UoDaKo8v8C4jglrjG0rfw&oe=6A09CFFE"}, "display_name": "Harpagun", "keywords": ["FPS", "Shooter", "Action", "Adventure", "Arcade"], "long_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals.                                                      \n{1047767720451531}\nYou\u2019re a cosmic scavenger, looting abandoned worlds with your crew. But when one of your team goes missing on a long forsaken Earth, your rescue mission turns into something far bigger than you could ever imagine. Will you find your lost comrade? Can you make it back to your ship? And most importantly\u2014can you trust the ones waiting for you onboard?\n{3059828870842158}\nEmbark on a wild trip through retro-futuristic abandoned Earth. Throw, shoot and smash your way through vivid, colorful locations as you try to get back to your mothership. Fight off host of aliens in your unique style - slash them with energy blades, shoot to bits with machine guns, rip apart using magnetic rays or even run over with a tractor - the choice is yours. \n\n{2122304118217010}\n\nFeatures\n\n- The sharpest **made-for-VR combat**.\n- **Embark on an adventure** - it\u2019s not just a collection of levels, it\u2019s a full fledged sci-fi story\n- **Quest-melting visuals** - we couldn\u2019t squeeze more out of the system even if we tried, the game is filled to the brim with environments, effects and high quality animations\n- **Riveting soundtrack** - funky beats that will make your blood run faster and your senses sharper.\n- **Arcade and Arena modes** - when you\u2019re done with the story come back and test your skills in combat-only environments, the campaign was only the beginning.", "short_description": "Harpagun is a story-rich FPS (First Person Smasher) full of sharp, improvisational combat, energizing music and stylish, headset melting visuals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://somethingrandom.com/privacy-policy/", "devel
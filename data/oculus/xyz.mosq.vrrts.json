9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILAKsNPHwh0Q7kNvwFacBZ9&_nc_oc=AdqlxhLHOTFs2XrHkXxcOvCJC4fIml4tfSNZm20mRPlfWAhI-4jPqhJ4UgEAPkOKXF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dHb_mo7faQ4phLQa8BiYWyUqbdCvwMicRkNJBRGD_cg&oe=69EB5E7D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWmV_AtcAOgQ7kNvwERy-WB&_nc_oc=AdqiAaqcWyPiPC4eMX6IyMLDy6TnW4tSKXlihQgBzWKac0qQL3F56BpkUdONza4IALo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04mQFo3SvO8SWhRHi6AiwDt-Vt2MLgJmlWus-HV_Goug&oe=69EB6693"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBM5rhmMn_cQ7kNvwF3ca6y&_nc_oc=AdqFJr6MbTaLjd4kV55tzQeqJRUih-fPLdJ9OL-SECNV1ZtAx0KFOswwsiVRqCznpxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_ufdrVWWm39XReMEy1mLPxidHwXgBuP-U7ZzcNVfvlg&oe=69EB8932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubK72VOw7UoQ7kNvwHRfGFB&_nc_oc=AdqKD0jvwEyMpwbol4DfK5MBsxIfsk9AUChcjUtFriU_zuzo2_xfjJDEb1DsI_QgeCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ura6LV3kObOECjG5SWLPTc5x3ifOjoe543lsP_g7APA&oe=69EB629A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=al9Q4Juo6H8Q7kNvwFpUavg&_nc_oc=Adqv5ilw_JWz5ucYoS8y2ss5axP5011RGhgKt4hJKk2dI_OqkjG_EYfVhL1UhYrggv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sqbju2AurQCdcl6EXazvdb9WK3polLLVu-kZZFg3RmA&oe=69EB7045"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHBQ5MIrNOIQ7kNvwHz6-YN&_nc_oc=AdqXk0KsYdGzqNhE5yf_vqlZ97rtizvdCZe8nbP7QFpRkopmGd9nSbBLJ6UJun3KXcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06zHObzj1BFr244Uf77FML-R20nEbDlPnmChj0NuxqOg&oe=69EB680C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculus
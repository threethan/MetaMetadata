9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k72nSI39JnEQ7kNvwG1GDO2&_nc_oc=AdpIRpUMxTrhzHIqdY0H3Kk7nxO3lTnX5V9UzMUBtFc-xythwIwTqsxjX_Huae98SiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNo5WREtEpgFPGiyLzeWTx9qWihgjN5HWuJrema0uDAg&oe=69CD0BFD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LgH9J4sPEwQ7kNvwGmrj_N&_nc_oc=AdoVw7E4vkv_15W4RWR5CW0aHG3kC4HFCJXEq1Ex5v0kOFoeCF0NM3rMUoSQAisuE5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7cI7EK8PLhDkjs3cv6wDBvs_XES5rfyx3fUJLThmjHA&oe=69CD1413"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjlYwHh75E8Q7kNvwEyqVjX&_nc_oc=AdrPolaa29JWIusX7JjSeWvrqsRoO3YvmVNXiN8qxp93e5KMiing6mUvJetu2kV3Ipc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxOdtIY_X14dn5mix3U6ddy4bjI_JcQBFqmdkahwY12Q&oe=69CCFE72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVRkC7z2dsMQ7kNvwEeelf3&_nc_oc=AdpWRS2EAcZxTtu0abgc73--CZB7u6MIWtvxbHGuEu7NSYTCRaX2VQwiv2tECmPqVG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiDxlD7lzbAVwq5AsFqkvCBBaiY6UFV6Pa63GF3Pjsyw&oe=69CD101A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_DxEoBxye4Q7kNvwF5pRf6&_nc_oc=AdqQ3cTRQk_GRjhfb5mmRE-2OY2gAgyb-3jZjXmFNAeIsFRuywBMKKm90fwpngElxc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKj30Y81OlkasJXoKHx1S1udFcVOUJgYW5RzgUM-ZIyA&oe=69CD1DC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEBmhCIGWJ4Q7kNvwGoX_Fk&_nc_oc=AdqJbgUa2LxqN5vhvWhdC5vbo6SDWSbaZGEzANTnlE9iRrbmc7gt6CSXuw783URRIpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbHEc_extlXtPSHTPfkIwVUpESFDgvphZ27tn7d-76GA&oe=69CD158C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpy1GpTg9_8Q7kNvwEiVwZr&_nc_oc=AdqiYqfB_Wbx2a4dR6qrODPeZ-_YFb8qGi6bqre3U-xdz3hWTnverC7bAUWI9jYbL00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT6QmECyzjqXKLeng95MHE6fk47GQLwv1lRY7qw7gzaw&oe=6ABBE3BD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vi6KwIpCbQQ7kNvwHllHiG&_nc_oc=AdrRNSChnQaBB3upg3iJlIGsXXacxszFAhnElD5LfaLgiPgz8fYnBCX5mX3iEGbfVsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB-Z2x-MTrVoCwJfr7AXSBB7BsUSnXRMAc3kErlEaMJA&oe=6ABBB393"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTV4S27woUQQ7kNvwHHJugW&_nc_oc=AdqvhJm9D1EvoLdC16MAME90fZlsGSkSTn27dliMQduxVIN_DbXpUr5VovdUSvLIQpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD9WnhTGPWXNJyb-fy0h2TotBL4ekTmB9MQ2OY9wK5gw&oe=6ABBD632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ54QdwkZcsQ7kNvwH1XdFF&_nc_oc=Adrn7fYUpbEnCdNZZCL1bi712MMUpyI1rbWuQTOSgDnHvJvmcbTwMlqz9NGy0rFs6NQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNwJbkvI6AyVBcY1drwDRkZRjb4xUS4Hn1e8lRvRJCUA&oe=6ABBAF9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhfSv__LrEkQ7kNvwEgIBZA&_nc_oc=AdpZFHUBZR1T9e6-euhEpqNvfk89PAmYUaR_c1UnhCMNgU4fSeFJ3Xti0f1PbnKhSKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_AxCWV1E7P-e6a63zDh03ajm9GwLsP-H2j7LRhC5OJg&oe=6ABBBD45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uGf1iq-d-4Q7kNvwHhGz_p&_nc_oc=AdoUGuOHa8k7BFyYwBnc-a-awY-nedF9E4oNAFsrIQqunApBCFpD6-X5uJJiN-S3oUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJOlp2YTypnBuowPY84sAmhcMavtehJo-c3LcWhHaysg&oe=6ABBB50C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
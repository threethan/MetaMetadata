9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6efxN017W8Q7kNvwFqu_RD&_nc_oc=Adp1EcBjk6SPAXbXke5jY0ozGD4esLD3Hrf0M7bV8dD-NJoPYdLJfDD38zAuTXEsxd4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQbDq-7SnzNrrYzR_nG3WLbbFyibZhaUBC5R0_mHSj1A&oe=6AC7C13D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNBpmK2JOOYQ7kNvwEoL6Hi&_nc_oc=AdqCbHdtn2YKfrSt8F_krrRhX6Uk91uCWDjLmC5F1hqgHE7caddWjjTS49qKunq3W0s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnYSd7bedPxSR9k4NV8BU8mOL0ioBwlRR5Cbbjavk_JQ&oe=6AC7C953"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmR826qO1ZEQ7kNvwFwuV-g&_nc_oc=AdpCS-xshR23UCjXWEoc-LK_aTmaGhBrvEao5B0bnqZi_mcyMuhP3XJGbSYJoCDLKvo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHzrl8UAt5zw28J3j50nUWijQcjaEhg0cDg_0pf6boVw&oe=6AC7B3B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FqX0L8BnMYQ7kNvwGRJ48B&_nc_oc=AdobU_AxYRuOy9k_iMd3JozRRJVNVYYT1JCbLGYm46xSDvb7BmB-3cRhTW_Tw53Ui4s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZGcxPE0X8fYuXQQTTLMn78LozJ5XmQ1A4eka6Od8UAA&oe=6AC7C55A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZecD5x3nzUkQ7kNvwEAUTHa&_nc_oc=Adq4aM6RAyiTEGNS3_G7GDSzus-TJNKtRmT2GTTBbLMoAmds0B2uWBbHnqeiaqJD5P8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7ctk711_d4H4dlwq47epRKGhd_Y3E-JO002IykQX0uQ&oe=6AC79AC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTJTJXronM0Q7kNvwFlwrHA&_nc_oc=AdqM_IPh6eImC_K7gu4CLDtr319Q3whJeEWFv-YM05_fuMQz0o1gFtv1Ow3BRHx2Ckc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOio9skui78R_ej-NKaII0BYU2oaBcqd9pSBnZdaDDIhw&oe=6AC7CACC"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculus
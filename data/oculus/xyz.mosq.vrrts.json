9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhmfSK1gkQkQ7kNvwFi-VPa&_nc_oc=Adpp3Ypi1DDDICc8VgJbnPbhQEw-oOMyWDnyVgnFx1VRmmdbTZqtg8WF8W1qSzLsOo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4m7XeWt7vIk0ePadmwBWFf0Ptn6Hl3EJxvGMAvfRASQ&oe=6A7C637D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8b-os3JtngQ7kNvwGVznQp&_nc_oc=AdpqKCMhvg3bL_9qAT1gsl6p4H7mmg2IYWHiM-A-ZUDPhgL6tHYumQqRNqk_ajUm1cg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeHGNEjleOTP6iPZi5XgAS_kXoHmqllpKY4a5-tylq9w&oe=6A7C6B93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sku05lwoicgQ7kNvwG3BkB6&_nc_oc=Adq-qnn_-udwgtUM6upg3qdIlzJa1Ag3vrZvxp2ykpqV7orB_9_miDpwBjOuHX86qZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM6ABuQ9fKM02N8mRbdjQybwnDuRAxcNlUvk4GM7iWcQ&oe=6A7C55F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrXo3y-cRBAQ7kNvwEvPCPT&_nc_oc=Adqxd2Epauqqru8XldgK4CznW1w1Ar0TuT79QuI1Jgo73ZoY48RU6VwDLRylN3kLMyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyuAexNEoSQK13x7qPf68akdB9ym4T5V-Oo-9kaHrDlA&oe=6A7C679A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJcQHXt64koQ7kNvwEQ0BHx&_nc_oc=AdoCnQsW8ZFlN_-lHsV0qOcQZDWHLi5I8rC-daqJNV3ZylyYOMByQL4upX3h8jeuod0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwOGTXt6XOUaoUpkWETf_zSdwNzvwcFMAIzoCRp7TGWQ&oe=6A7C7545"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI-j-W_3xxAQ7kNvwG8JAzb&_nc_oc=AdqA19IZhJS7h9DF4oKJ_p8_xNwZ0PFLXIoQWWqXQzTWzsQ6qjh7ua_0wTx1Va1qzbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1ODWkgDdvpj8ii0u7L6sL8pd2N2QfOVsi1GxjDek9XQ&oe=6A7C6D0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
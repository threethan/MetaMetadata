9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36u8tBgmQ0wQ7kNvwFs9kXj&_nc_oc=Adrx5gwR5C2pgjS3CIGep37RgvbMobEDSC2a421Clsf7XSZFKB7GsSxAAGCnfxy6ifM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22Dk7FNEG9ZRFkUuck9UFwqxp6Lgf_wDameVKsNH9fRw&oe=69D6467D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm0rgba0vu8Q7kNvwEalAO-&_nc_oc=AdqrY_aCy0Rc2DHIQazAFh2u_apRCWrFgVi693duPiDkISKxDCbP7XNSMM2s_l8nC9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O328u9fqA2oXYsIFH-oS71-GNS2gnBiZvv9fG5E0uNA&oe=69D64E93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDVdiy8zY7AQ7kNvwHXqY62&_nc_oc=AdqTj47-vT54PZs5Qth8zvj-wIE_oXyRRCU6z0XxE2fPLU-2U_5tjGpdF3iAlfBTdXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3glo48j-kDw-YTigs2IOeqD9PXsrz-DmfvEVgqmqyrfQ&oe=69D638F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGwj7IaPPyUQ7kNvwFUqMRZ&_nc_oc=Adp4IKwXWL7QNlMWh1lTtClpUB-SER9VYf6EbW3SIQ12MxcvPbQwundzMR_qJvgQUCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WqKS-1I9wLrle4Y9iLTBMJmT-eq7idDfCxLv2TFXqqA&oe=69D64A9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_0vMK2oFRIQ7kNvwHSX08U&_nc_oc=AdrBTh0-ilnZBR63EOOWj3qhOJlp6_Rp2K5GUNrBHHA4ds1vNRCPtLdNOs7-kfb-_n0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xzIB_byOOQ2w7B318DJLfnUPiGy4ei91wQA-Z_aiydw&oe=69D65845"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1mR73oJB1sQ7kNvwF6EYAV&_nc_oc=Adolal2klblinw2a_BCy9jT_paSfuXeOpXB5S6EWe_fc7wbLXZHiiFdSOtpYaDgZA-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GQkcQIDi2e18u6kDK4Tyadx9u7doUHgoAAecemtKcRQ&oe=69D6500C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
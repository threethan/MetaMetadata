9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLfuCstxDNAQ7kNvwEwCh2P&_nc_oc=Adrgn8_6U0BcSog5SQa7-q44Ubqhwg33lbW5IXnpC4y4eh9d88FXzqMqZtdTt8UbRY8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcDUpF_oWqN635PiHiLPvt_no9Vjhrgse6yLAETUokWw&oe=69C6747D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTqHFj0a_f8Q7kNvwFliU-z&_nc_oc=Ado82awvC1uBfU9SVZn73NT8X2UHRSF1cKamkhAP5WuCdh5EVGXWGYJUT78ZQKT0s9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWBoffnuQkoFmy-C0cfQlBfnV5VqPPEGQa2ZK3XQ-xIA&oe=69C67C93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Guu5YOnnT6QQ7kNvwE_QzTI&_nc_oc=Adpo8qPAExqEZh1d_-4AkLG4MiVSILjkChGxr8x84oBAGoMtQo4mWH1OaxdwDqTkBh8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1LYR_outV2Yi2coDWRBplz9nkxsSEuYW0lZRQgGnAgA&oe=69C666F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw9FMxBa--cQ7kNvwFMfRFl&_nc_oc=Adop2Oi1i3p3VOFRB1emCtnWYXnBg56dAihl6PCkWEUN5TdMgadif-jw-dIBddsAC_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv7F9W5pdmmuNbIijfPCZSPmpGlyZ07uKtZxpgvJPzmA&oe=69C6789A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkdzpKkBrlQQ7kNvwGqJ5Y0&_nc_oc=Adq5otRxcLpdLWglEiIauEz17qbBvXTD-r90vJgElLgV9ibf_Btz26TVwbKBQFsYsOU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHmbK3YY5o5iTEh7kihph7bEaqqMTQUBbLP8RPtqiocQ&oe=69C68645"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH6KKJ_qa7gQ7kNvwGf-JFX&_nc_oc=AdpR4fb175_1K5pLXL4QQ9Kw5X-mg_ffdCxqHtjR02xpb6cgvIf4AkTzd3ZLrDyF2yU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycZ-HK4B7mdAtGbl-AKeaF2VZVkc2ULgAIpfcKFbZLWQ&oe=69C67E0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculus
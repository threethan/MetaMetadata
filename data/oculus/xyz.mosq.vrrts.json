5_63241492529224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHJ71SLsujsQ7kNvwHyD0rI&_nc_oc=AdoF1Al1I3mvR-2sATzAmYgr_YSazkjoYuaLKt_0SM7op4VlhKz04gVWr1vQHAWgaKg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW983A-ksO4ZCzxXC0JXLXHR4BXEAnThy9uoDX0Gj01g&oe=6A8D86FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE9qmnodAx4Q7kNvwFiogEb&_nc_oc=AdqvudxzQWvqF-JAXCxhf2QRpReK2blplbBkNqX4yLmp29gBq7d_82pkcmJlUmeo2nU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyT1EsQbLtqstJZQCyCk76vDXVdsD8WOYFK9JZjNDXTA&oe=6A8D8F13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPymx9vYkcQQ7kNvwG4I8ow&_nc_oc=AdrL058YcBeOG5HzO7IaEaADFYOxrttbvpnbEaFM6vnCTu1ywkxFxcDjqwl4PqSzRVs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb0KI0Dfr6ElSJokIxIO6vi9U44vgvRvcAy4OcX5WHeg&oe=6A8D7972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJMWzMwyjKYQ7kNvwFMqg2m&_nc_oc=AdrH7ebI0dCaAzd5mOiSo5yLHXBoi1uheKy7g47ByREzLp1cstxfZQlRvA664A15PWo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc-HbL-fyCwE3ctyb4ewwqFk5DyMVE2M-MlJB1ahcI3Q&oe=6A8D8B1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvcOO6m3vIUQ7kNvwEAftpf&_nc_oc=Adr8g8FaucS8KlJH7kUqLHaJG-gtCy8sKZP4RQsNjZ_p0axHCoSlWipsxd3dClLldnE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI1dqyl1stXvlnL-hiZuluI0dF_-5iirl_8JFQfDHdHg&oe=6A8D98C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcqCoJK-RsMQ7kNvwG4St2H&_nc_oc=AdqziPuN2z4Y5hPjrcnRjJTyJyI2MuNeNSkYfF3FHjcpDLS7yMcgali0lE08OuMnLYc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO46crB3duD6HGh72-IYfHWVR_1ZtXar89vWafU8IGog&oe=6A8D908C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-l
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVlYQ1pcDPcQ7kNvwHIFpmg&_nc_oc=AdpwtomuiL1DwsIp5gYIdmlmBuj1BFWacmagKRAbt2VaZiwhl3degkZ-Ht1oNhxqiJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IbN0rsVh-nw3MBvcKsnxcjNJJWowcdRzSwI7OjH_Ynw&oe=6A0DA57D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHXfdTaK7ycQ7kNvwE5gkJU&_nc_oc=AdqiQuHVlY-Yc9ILYT_QTPtohOeRsHOl19DdyBC4uZrCiK6rBvsJBcaGgHeu_RuI6aU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RrXWvJlZC4qFb28vcxbHLkvWuQTuo8jcFTarKpsrTPg&oe=6A0DAD93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a70r-X2ek5gQ7kNvwEWJ2sC&_nc_oc=AdrUmwH43B0nxOeV84G7x7D_Ly--IhpO8ceSK7QlhJa8Uug6tt5W_kuOicJ86_oKd4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47aJRlQD-qrESKsxx0c-Raz-7b_I186JtBIeAemZgS5A&oe=6A0DD032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfAdRQgbqfgQ7kNvwGbsOWz&_nc_oc=AdoNV_VLIyFt0HUFTr63bxvKI5EmhyYbwMawHPjSqQ7KQy9OMK5g1xN7LqcqizzYKmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45BcjUNm5s-gJuoKUpcUA4YssNCFuA4Q-kyHwLysSu4w&oe=6A0DA99A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA-EWX_lf7kQ7kNvwFbOBVP&_nc_oc=AdoVFGmp7j9YyOiZ0Vtxg_BwHvGpWU51Xe-2RSaFO3DDpAcWRdcvj24NjTi9dyM-Z8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51Ey0xU1LMEGVT9H9nFL5tGj9Ui5TH6g57qKX6RytScw&oe=6A0DB745"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPNN8e05zMQQ7kNvwFpkpEE&_nc_oc=AdpQzzhkI5BUtI3Vttv0Y0iCD81tXzAu3fSCF_8JYOTmg3-nXJ3iS9TGX2l7HMhamRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71RXOzQsBQqaD2ZvbgqB6ToLv8IfB6U_9QqgJh1rgR_w&oe=6A0DAF0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
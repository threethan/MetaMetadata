9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYy5i4YEnzIQ7kNvwERHoOi&_nc_oc=AdoiLHvPw9jy4stElq5o6oMLfzlWgy7PhTjHMnJTABt1HaDx7ycRE-z0k6zVigXSa58&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzhOUzTgIFR-YDmegdm4L7TmtBntZryA0elXgEFPHnFA&oe=6AF9DA3D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb4NBuGW5jEQ7kNvwFPh5Uc&_nc_oc=AdqyIIb1EFytbCBkDQP9RFv5awfCFFxU6xWu2J4MpyWK0oeKPzk0z7LsxZ5NSzhr-HE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcYSZfWNZV7oBrZ0bZHOky3g2i15_0JD9B4sXPnSrUcw&oe=6AF9E253"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwmrFsKDiy8Q7kNvwFbi7Hl&_nc_oc=Adq4ZFtXGhahoyATNcuU5iray5B6jV7NHuHNmGrhm05avZ6OcDjscWjq4T9R8WINq-Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ1FNnturKMdXD3zRU3xwoF0H2Z1pqbe0tNRG3Fz4Zaw&oe=6AF9CCB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvtbGPbSi3cQ7kNvwFagCOW&_nc_oc=AdrgoYUoz35-mabwpHty9tLoMHA6Y0lrWry77G4VWtADphxV5MicH52WWOknDm9kdWI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTztSa3QQ1rDP-LgBhZYlcNWO9crQXXxI_OqXrZuFlR0A&oe=6AF9DE5A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAZYkaO5HvQQ7kNvwGUqTEu&_nc_oc=AdrfcMSlKQ_9Qwmbcy6Cl9GojYqwHrzGTS2Jplf26lAJ3NfiFPxUtWhseWVvinHJj6E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB8i9hlgzVhdSuKYa1jaNhuw1C-JtEbpD4-Nb9omAUYg&oe=6AF9EC05"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rolbWSj79TsQ7kNvwH4jwPC&_nc_oc=AdqJTY9TK5vg8XG6e83zBO7ecVB8aJpSWxabsXbcF0c1uJG9CGR4hdmO9XUY4Jr7t3U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0u3hrVJOZn1hIh4ZECgTU1hcEzVYGCoj2rwVusETIOg&oe=6AF9E3CC"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculus
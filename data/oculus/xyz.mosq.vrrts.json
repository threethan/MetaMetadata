9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23A5NJoXepIQ7kNvwHSxKKR&_nc_oc=AdpKiXXECA129yy88X-itATv0B8f3WDlTvIpKaP3f7Fw_Wc_rkQYtHff55onRsO1L90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6BzKcat7tpOyOOKmi2tmjzxei7UOZvdjUI-iR-10yxw&oe=6ACD073D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xySQlxbj1oQ7kNvwHahSY2&_nc_oc=AdqExTyh-k_O5zsYzv1n14EfaD1dKGnOU2_C_bzstvFQb7dE65Kq4Fz4VG_5kcE3y7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7WyszyxFZVZnc6l1aXSOHc266uDgXWhvvocKiTKYVtQ&oe=6ACD0F53"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtoI2Ia8yeEQ7kNvwGeLFCr&_nc_oc=AdofXLqlweBj-bIs6r8YcePCwAVmVES1UlnVLhqU75d_waakY_7DQcQrg2qatjRCZEI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdrnmThE8f7MO4Dbxad7Rzp2ww1jFsyJD9t3zwX9NFLQ&oe=6ACCF9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCaeodem0aEQ7kNvwHuUBnQ&_nc_oc=AdqurpQzKoL7fvbg7UV4OI6BLQSFAvvIGGmjTyQtv8F3_VKPzAI_kheGS6_C9rZcosk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_dROs8X-ePpts4gnx9QmCn1Z86eRWadbjgwCdYnuTag&oe=6ACD0B5A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gqeYarahXIQ7kNvwHMaR4_&_nc_oc=Adp81HJXAnHis9gdc5bl6mpuc4GqAVOhsUFegQXjo855FWdc8tu20ThrVigsbDvCWXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPMGPvRn1RQu1XZ21s29N5ikc5XmYZbaCAUzxTAKyurg&oe=6ACCE0C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7gN86vHsYMQ7kNvwGGsCdA&_nc_oc=AdpkB6ASwrjGitbs3bqoG7I2aDMMDFMneVsdUBnEoUKl-WmYIUkJY4T6Xe3DRujHShw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkB2NPVPu5I8zRMAgvl3ja-ckRssZB6zwIvHU5--iGdg&oe=6ACD10CC"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculus
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnIRMiBn9iMQ7kNvwFIUaHv&_nc_oc=AdpMRBinTx7DUOg6uDMyzij4V2l6MN0vMuR6YvDJ4ewGzuJlBNo_6SxO79969Md96tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjOEpBbK6ID0o0KW2M5JvMdXx_HR1em-Aq0AmTik-xIQ&oe=6AD24D3D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FNbEOkO5S8Q7kNvwHD6k0i&_nc_oc=AdoXEyBhs6K7yqWXt_Syoiie7Xsmv3896ZnkX8YNBkrmNDnBbimaEJuV98S3ByZPfVc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_xZZZ_hkhql8Nd8fjJ0IBq9gasazKrjs3sXu56nyWvg&oe=6AD25553"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TUOLPMs0rkQ7kNvwGNLMhr&_nc_oc=AdpT6MmFpzXeHl7pSVt2of6nmjYsyNNGM9BP0SyUrBE6ir3S9w_teiQHu0VwWJFOYuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGI-ZfGpp2fcDV6k3NxcXIbEgRBLRwMe9Pp6jT6iiIPQ&oe=6AD23FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRT6E-Pb4tsQ7kNvwEKNbjr&_nc_oc=Ado2os7huQYmUaRxzLlmKGRz8Ra02ZV3nLdscnlcOBY0Yz7e5GCDpQIVvvkVtG1zti4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-dRLt3n5rtoM7K29RforPelaHYqYrFxRIcX90ON5WFw&oe=6AD2515A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlI_Os7ibwUQ7kNvwHwbUkH&_nc_oc=Adru25f3EfYrjY6Eo4HL6_TSRh5e3qvXGt12_5thtLmHoyQC-En0jsj5bfj9a68JaQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHOClMeWRZcHKsBWiTzWlsPrfao5GCHeLMdYb-IHujTg&oe=6AD226C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTSVQ0_Dg7QQ7kNvwGNpgrY&_nc_oc=AdqrNYDuwYsZPMfews-zT7n9MBGcITCMYx9apIuOVYNeUk2nn6qJITmwzeM3m8e1Bts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx5uIqQ3TW5XoOHSYzyDmhy4jIVK1i_WNy24gJ3li8yQ&oe=6AD256CC"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
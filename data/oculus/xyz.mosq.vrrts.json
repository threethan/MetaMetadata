9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3ZjyXfok38Q7kNvwHjSbl4&_nc_oc=AdqF98GrmmLXS7XuhkTlqcnsRRwRJFzJqylw9HkGcLlnCwaQkPSfY9QenWL3pry60wA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxJGd64ToFUlu8gJMUiEsiXEp4428Lql00TmR-5Ti8cg&oe=6ADF7C3D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mULCFWFWWgIQ7kNvwFRfV17&_nc_oc=AdpmH9-dGZLcxCHT_lrcbAn8zEo4vVXVol1j-Bh3nBw-ASN1DfX6foHzBKZM2zrFbIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_a-tjn5dUFxVT1pfaT6MGFml2-CONfYsatWXlww3WMw&oe=6ADF4C13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0m8lgyzjP4Q7kNvwEIIcDt&_nc_oc=AdpqgqtTqaIF_eagxRMSzEyU5y9ZFGwBCjgSezvgUKw3AAjp0XnlVpRMsnBWg_e8cwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn--SvGVx3gwrAybtHZPEl5uzQhwFMEtqjvuMBUlaV5w&oe=6ADF6EB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HractzIxDEIQ7kNvwGmgblp&_nc_oc=Adruv_OS1n7P_IYDfq3jzcHKhQ8MQo72DXSV3cZymdJtSIiUSK5124SvTbe7Atm_p7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiMe0hE0Q9L07lwJhRWnnbiLJDArU93uCnqe3DgFvQiQ&oe=6ADF481A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9RwsXl5jX4Q7kNvwHb3Bhp&_nc_oc=AdpuqhEgqZ7vqbUE0Immo5IzsdGwwJYXr8GvEeL9tjKcle8ZaNENFajn3r9TTZRaErY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIIRAqQP-w75RYeqyxQZuncOeRdixbe7KIJ6CP2GWQ4g&oe=6ADF55C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u46xTfqMNpYQ7kNvwHktdgx&_nc_oc=AdpQH9kV-Qwa6XEMZhb9VdFFbMH82YfdiZEzus5WQywMa198bh5Ia5lwLf5ODGxSpbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt0XS01NcHysln2EqAAlVZ1Mb-g_7JxP076gbwB4Beeg&oe=6ADF4D8C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP_TKI95UDAQ7kNvwGCPNWC&_nc_oc=AdrFc5f0jwrIJZur4u_U3iExYkB52C_BQUeOalhjnup43ctzgMUc9DVVVRdieUIqCOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ikjDNn1L02bTdzk5niPmy_o6I6sLtg1nB2GE_ROqJnQ&oe=69DA3AFD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdG9ifIU3WwQ7kNvwHcVDhd&_nc_oc=AdokixER95zzjueF-j1XFLvXmkUdVibNg3GkoKfPUhwyi-80Jiq4iN8vpWDcK8_BEPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ViwNHpUezB_CTit4oNe68deEIhXKfQx4aCISw-Wma_g&oe=69DA4313"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUXiEwDJvRUQ7kNvwH2ikAt&_nc_oc=AdocAsug9maUzlAKrm1eeWqaaS_KpdbBSnrRLbR426s7KJwwv35gX6CNQmASOHggiqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O4-PJH4h07rUYCuswWvpJ09CE0YqqsufmGmgHBgbbqw&oe=69DA2D72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBUChGqPqZgQ7kNvwERyYtn&_nc_oc=Adr0IiO1t1nxLNWW0fhroLlWOqi5vIm-GGc8kUs904ZQ2KitJZi-KLhgcjQUNRG-XqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3isoRqebICUMkcKr2Yy9UAnQjes9JOO2tJmdqr9xaKVw&oe=69DA3F1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2ZOlZNwTnQQ7kNvwFz0CiV&_nc_oc=AdqSn0a7lI9WsSsb_2JCFTaPuHC7WYFKWwcrqxf5HIIaCN3caUe0-SBu8z7V2VIuEsc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g_CapXDHFy83r_1vz-4D8OMwI7mtbNdY06QeSJ7HakQ&oe=69DA4CC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zllkttTwNoQ7kNvwE1o4cS&_nc_oc=Ado6-UW3pXKLKZ4NsWl61032GBqHxXOKOe76iHIrG5ByvlT0evbFPfC5zejuQkVUVc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20xoiTCs8DbVpgfwDKEWj9ZseQguBsQzuJE8DtPVIHjw&oe=69DA448C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculus
529224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIdnZgX8Iu8Q7kNvwFb9PVI&_nc_oc=AdoBJG6q9-aDd8lGf4-oxJLGRg1GsLjhKMd6LgolcvgRnDQfh9dq5_aYy1qZanD_IhQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-88yg3CLC9sF5Shewcs3_PI0QZSXTCIaWHCVwCS6T_Qw&oe=6A395F3D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAC5EH-KnJMQ7kNvwEHZJDW&_nc_oc=AdqhGmiQyIdlVjWXOp-2CgsxUuqGxdnGYT8mZFmihaq3nTJ_4Jx2RBkJyNvEXLpXpCI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97LbXHs9MBQDoIZAjXJjVI1eT-7xz_0rjaWPVZQgOmdA&oe=6A392F13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkfeCAfmtEIQ7kNvwEHPESI&_nc_oc=AdpIOXhRSVsJ6KFwrs5EPrOgZXzqa4REJ0Vk_IgQUXL8dHIVcr9jypyfmT-HgzUONSw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NAqURTv20ezpNSTwUwJOhOO252Cyh9yLGrIld0dDeAg&oe=6A3951B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb66O7IUopwQ7kNvwEZrSOG&_nc_oc=AdrpRTA30jSXlFtzzpDCwhnGSVUnLlABUtNTCXqtoRLmHiUuavZJ2d3y5dbxV6W8iSQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QYO-Qi_gsWYcysjCVlXoXq4vBg8wXoFdkprHKdN5FnA&oe=6A392B1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cJj4sj1N7EQ7kNvwHtZ8Pl&_nc_oc=AdoKtOVR7Gkw_7T4wgLO9iJcOKDag_vnqDatlLmfIFcmwoam9Vg6nx8VDsCm-hR58S8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4C-FOJzkZ99THZ2YBEGeYo-t5qwR0m115nP002YkC-g&oe=6A3938C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDt8jCHFLQ0Q7kNvwG6e7SU&_nc_oc=Adp32sq957Aua1sUVCK_Vrf7YddBf6Nh2mTlxfediyIn4bk9FV46xRwZDXMgLzfQtro&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_BHM5CJvHBxw5TOr40yoFdnZKO-PrET7aOAcxy8gTSQ&oe=6A39308C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-
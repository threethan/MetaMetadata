9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31rWTud4I_gQ7kNvwFHsCGq&_nc_oc=Adoggtztx9bFXDrJLyu2Be75B4mhwpCGQcDl2B3L5i4JXscoyjGkwNX9jlvRQBO2kzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEzykVbEmHfONXGS12gLIpgAyMfJFMgazcbRlNnn2zvg&oe=6A6356FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMEil27cP9cQ7kNvwGu6D3x&_nc_oc=AdrpWXYZWXSQidgwpafoTY7Zc-uBPMR-JOKLfJCSonGPUZFPAc3M7CfUbI3JRUkm8Ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG5VAg9orY4pqPLPIAm75sWNzXtmLZb5_na5vwT-8pxw&oe=6A635F13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jADPVGNeHIYQ7kNvwGSPnPy&_nc_oc=AdpaWHrI6QQ0NObA9qJR5IxAo_aQhD6tlkm0bOLQKgi_COQoFSY7hYA0MpV7v_ousxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRRdKUHFbabXGACF7l6mnlS9tJ04bsdd9cVwIWD3hbTA&oe=6A6381B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAjDBSelfiYQ7kNvwG9gunE&_nc_oc=AdrW5wGBS44vf1gueor8Wu0TmLqGacxb5HEtiQCd9656bQiWsR1loXIo06ie6Bd4ZoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCOb40GQNFSDeEZcuijqcF1HyfR_lpwqsHKpotZTWPOw&oe=6A635B1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7SUOK-ouC4Q7kNvwFaHdK9&_nc_oc=Adr56RSkv2PQD0zxf6bG4VMwsa9BLfqT9Kkt0IUlhNp1N9PcrC21Dtx7X4urBWyRPIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG1GOTwZucdT31udnS98c3yntJGkSzN4Gq0ySxOa4rLg&oe=6A6368C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fqRDvxdgsgQ7kNvwETaCVu&_nc_oc=Adot9IZGbs8EKCwFJmsB2qhvjCJr6u_VouNC2XosdPGMnl0nViGXMhiEJFRSIyuWZVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXOrweOCyeOBD9mrNNvV-YDCpxsqDffUzPMhhkEXLTEA&oe=6A63608C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
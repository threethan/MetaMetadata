9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-jbj_BvrsYQ7kNvwEDSQO6&_nc_oc=AdqIKbc5wSoptvPfUxTfr4r0pDu3RMIT-NymfFvPMbmFSYOb0hgpWYN3yqMrnnU82Zc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkPToi--oaiV7KvmbzB8_q45Q5S3dUZ3lSRBc-2Y6bMg&oe=6A5627FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuy_avL3AsQQ7kNvwEC-8U3&_nc_oc=AdoWMEqmHiTaCX9mfYh8SHoiJr1PxgR2x-m6h3NoJ7w0-zJmNOrmu31AwbceJngLLZo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCZLHzMdydo4kdgkCDfyFz3k0HeUKEG0720Gvz-dljZw&oe=6A563013"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGEicLYsxpcQ7kNvwFWE_DH&_nc_oc=AdqfvNjH3h9-rCJfdpnO_CmD3tom_eVC52NNCSGQodLGzkeLUaeA1jh8dpnETkxOjls&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1ulTCyG3JO2Ji2iu_-V0DkNwETeoFMYlSfkZPyRH6NQ&oe=6A5652B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6sjT4KNqKgQ7kNvwGnxwJ-&_nc_oc=Adr6w2gNHmndmko9rZ97_ZfTXZ39QQgkABqMEaU9HffxJ8b9BwEK3zFF3jJht3r3xcQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfXMgrIG5jdR3xUdYN1nELDPsCRUzhpELA8VVfqR9I5Q&oe=6A562C1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMPjkllESi0Q7kNvwGLMCWK&_nc_oc=AdpSinDlpG_99KSIAYciGJeDD-c6ucH6odSyAPXGPMrYEgsbOd1rFP3F6BxhrVRJon0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5qk6mAfP1xlOQwaUKATH2DAGk8e7H5tYQKKmVY9-q4g&oe=6A5639C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pfumJ-WYAAQ7kNvwEp08YE&_nc_oc=AdpG8zZl4dm-flXH9CmeWgL0lclpKPxATKeMXRNpsuDfgNCP63lBLV8bRDPxILOfA6g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgvt6tllwobrJkCSCGxj7KBNKHbDvYP6WoqfJ_7_-vyA&oe=6A56318C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculus
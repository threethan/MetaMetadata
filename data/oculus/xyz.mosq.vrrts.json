9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4glo_odCi8gQ7kNvwEC3-b2&_nc_oc=Adp1oZNXkqh31eOS7jwcFZbbDErIY9vCcwYIPkaHMP7RPaTsYrvtk2RbeKJFWZnHspw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbk_8g0bDssPJ_K2GVPyucTPPBNnjU4b-CcK29kIyaXQ&oe=6A5CBF7D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOg9DBncSzIQ7kNvwG8_ZX7&_nc_oc=Ado0h5JDiUQJcdTvdO-KHNwDwoTh7oJ1wv5UoPHdVOLeNshjXoK7QdzJHBFbPOaTMaU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYkzvJbC8gC61wptKhXBnV3LFsa-WwYlm1-zwiRKp-dg&oe=6A5CC793"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-TpU4_jh7wQ7kNvwE7ZkVT&_nc_oc=AdrnGHoTCCWPNDWOBId2LBT2QMeMS5ID2AHBm3sevWmnkqjpWoBTGG3Qjcn7NjfEoh8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfDkkwR_JUne4LO7YjPEVlQBIMcI40pONjOc1D_eHPoA&oe=6A5CB1F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxEnaJ2z77sQ7kNvwEDw3Dx&_nc_oc=AdqFZwnADt489o8_0O_KNvKtB1Kow3UbTpzwmyNcdxN0X8kocpuBpD-JhrwkZePsvO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVwpObNFfJyxpeaRo96X-BimqRT34IbCxifYMz9pDg6A&oe=6A5CC39A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKVsRH1qU3UQ7kNvwH3FBkQ&_nc_oc=AdptBSLzsI8g3WiBxA1Zx8hSQxlfJtv-j3zAWQscTjGV0pwrU2iZ_rMSaj34QthyL0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJpTIxxlz2mPooDo9Dtduufp6WYvQ9xGoZajq2W4caKg&oe=6A5CD145"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJL1KoyedO8Q7kNvwEtkf3k&_nc_oc=AdpUikvYoKTwJm6-0ZcjtfpnYUTRRTImhRL41ql6nlcG0tn_X97b4m4IJ1ry_xOWBXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2BVLASaFz4CJokDXLB7e0sUNFvIzonjJIr7PiRxFDBg&oe=6A5CC90C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculus
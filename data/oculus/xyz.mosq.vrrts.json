9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgpdLGFCG78Q7kNvwEUwExY&_nc_oc=Adqey_2hL8A77shJkw-gwDR50bOjLcbecX5zbZi-xU1F-wbGJQUsybiDMxYuZ-XEEXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHxFE7qCxlAAX6ELGWQ371BLlLIjrIWz0lnejoJcq3rw&oe=6ACA643D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCFV8SC3kvoQ7kNvwGZJNst&_nc_oc=AdpLDuZOSGTjtyZATEOw-WE-PFYHauuKVxOufDHDm9x_WE5gPiIWavCuoSXFIb_LS74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsclYe79JHc14SlVTetf4d9zC_aPZxugqsL2bJSpbDuw&oe=6ACA6C53"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtoI2Ia8yeEQ7kNvwH-eX_w&_nc_oc=Adqp8CU9znL5psP9QXJvnVcEnX_OqUIIM5cgXRIH-RU8vtSiReMfcB6iTCex6xm4sUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl3vj-669wq8djcKupqubw3gdQzRmd4vCdmK8ifkPM2A&oe=6ACA56B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqJMYemvkWoQ7kNvwELDh34&_nc_oc=AdqPOpNSjqViT5LV_9Jig5ewKikrVznlniphbjn4QrE6Q-lvZEsk29LTL5eDEk8IfS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNicd1OHgTKWHf11MJG04bVcO2GpQm3ip8Be3l2NJNcIQ&oe=6ACA685A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZecD5x3nzUkQ7kNvwFSkQ7p&_nc_oc=AdqsB-HOy1_5mo4bHF12u6snBdaj0cdeYKzYhaW__4isbeE2W7MTclLvQw9iqDabcjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV2jX7BoGUA9S1_4bxkkRInNMCx1gixl75XUpfM4UoZw&oe=6ACA7605"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ammy8_8apacQ7kNvwEOzNCT&_nc_oc=AdrXP514kpOP9JC3cA1uUTxxphGVxX3YRCjmatqVxN5rb4iX69VydYm0n2OlWlKv4kY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7xdcc_gTbjjIJVEkCosN7EbTKv4AB6wBEpnR_AVmHQw&oe=6ACA6DCC"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
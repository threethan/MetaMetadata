9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNk7XTGbbd4Q7kNvwElNB8j&_nc_oc=AdrCr5PaeNdTkaXgIJvD48cJftR5GgLgCcc8sklLXsRjRjOowxvWU-E_SDJi8v_-HgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9ZiqYKLcfXRVqZ19VHWh0dwtmmjacTsXKcvgf9flL0g&oe=6AEA083D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLbwZhmECKAQ7kNvwEFx-5P&_nc_oc=Adp-j_W9qyUtP7q5cIxh_dIt7QQ6GPIdqkY32dNVzLjpksWo2RKaNOoPWSpYehjdWz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ4eMLYYYox2KH4NozdVbHcTVuxCmXa9hmNolgmMGKKA&oe=6AEA1053"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAZ9IPQI3msQ7kNvwGcprOs&_nc_oc=AdosaCPvnYXHSHuAtnIxONSf7tXvZIngftcndeBAcOw7yps0xQ3ofRmHtVR454I7Jxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgDJdwrpT1uAtWDSecq9JlhV8bWhIvGn46K7N_SBNquw&oe=6AE9FAB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP_c9oS12PEQ7kNvwH4lAD3&_nc_oc=AdrDGYKbEFvIGVxbTT9AfHbkGC09HmEATx_yLPizRgAYXSMNrrjUsLLJrHKpDWlFfJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7iugbvfWB4UdD6nJe9zHybdjwwFJ6LommdOlAYitiYw&oe=6AEA0C5A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2RknZqsAKYQ7kNvwGTsEVy&_nc_oc=AdpvVIOSgYwidABb7zM-Wy_i3qELy4Etnx6JAlAL2UwvrP7-N0zUVM2cQdInRfVvX1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThRwO0wTHKWIJNUZtp-yptonIhL0ctmmGFK1iBKEJ7yA&oe=6AE9E1C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjoCB3Exrv8Q7kNvwGHymjG&_nc_oc=AdoCfIeTc7AgVyrlxC5RAmvKPZd3yBZ1W7oI9GC_F5tJbDiYk-okcsHGJDisFbJ0CAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKcpAUsP4E7G8t6usLjCvAU1HkHKNj79OFz4kSk_6l0Q&oe=6AEA11CC"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
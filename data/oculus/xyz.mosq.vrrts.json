_H3TE-m-fCvoW9dXZpdwCXi86W2VzgbBeGTVt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-Hv9150tqAcEjZ0k6kgAVQW4RVT-A2CL474BCgHXpDg&oe=699D95FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Gmp09mwuksQ7kNvwG6vU5P&_nc_oc=AdkgotVRWNawRlxeShUzE62d3WFoYODE6JH-6P9AvxNipxPIBlqwsAUKroql1LhA3u8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftOqQBgU4oeTi_PYYI_F-1Go6OBv3RA3x77OuPSB-txYw&oe=699D9E13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKjZNB0Hy5gQ7kNvwFMRctw&_nc_oc=AdmqipRCzxraMQ4HC8aRyRZVPuByVrPU6_YRbYmSOnzTEh5ZuiiaHZ_sjffG04ITVRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftCjyZNm7iwHjq09K7SWzqoU1dzvOXsP1PI3sl4ew9vrQ&oe=699D8872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7mqXU7_TqsQ7kNvwGasbyv&_nc_oc=AdmufxRph8_OhjYiXntdHK_8UMLpiq5ZNaqIF8Sl1Zi_QL0lwn-nmdFH44DYmyiUZnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvUqsRIZ4yXSOa_OcDYUpxGQ18nxzHdckqfn0OFYarfA&oe=699D9A1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riwG9Hr--aUQ7kNvwH09RUZ&_nc_oc=Adk5KVWZ_rhwP2SIxgY1vagLhBkU8-XWqFhkWzBgNRkUrLkj5vBT-yyr4-SSM61zHhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCAO_xtVp_iDFtkcytiHpzZeIm64W3eRv9WGh_PIYOHA&oe=699DA7C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KkrnGr7lLoQ7kNvwE9EO0P&_nc_oc=Admw4RuQkIHW0LOltuCj3EGwYVnJxTOAyE9p0f3SSw87UeQvz2grtWRztD84O1Yd7Dk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsedjmZ5kjXIIFFTZFngdDuAPPt__84f3Vad0G96P4WEA&oe=699D9F8C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1572766622922308_961628044886678894_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88n3JE0D-WkQ7kNvwGLkxYm&_nc_oc=AdnZjANfQJmUuaiLoS6O0znJnCAEw8m4DJrZh6QgalVgdQbb
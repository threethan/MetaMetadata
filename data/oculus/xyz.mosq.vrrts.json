9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQGKYcP4l6wQ7kNvwFuJ9ab&_nc_oc=Adpu-eWzX8LtiOuaukHwrOM0wklFvGyPOvoVjHY7FHPQoGroNlBlGPH04Omd1Kp1olQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ7Y20xrcomJAdHSCfKAJp8zr7LWdQ8uhCipt5zEpgUg&oe=6AB0063D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXeMHKazs9UQ7kNvwHKmOKB&_nc_oc=AdrAuXrPkxxEBfX7f8Gf_5MGVRMEeYkNGCBHkZXxgbfUGtnMkzTBkO5mfF76ubvq5vY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg6N0-AtebtXW8sDjOToah3D0XZUjFLv9EQ8i8qxx7uQ&oe=6AAFD613"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRDgBBVcxtoQ7kNvwEBV2Xh&_nc_oc=Ado2Ss_VTv8BDVm8b3VoSO9Ye5j87RSiCxgJAUS_T5HdFctwhGnLnrzc1uZJ9-NpzJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-Civhc2CSJul2ySw9oEiayWD9FcDIMSp1x4Vpd8M1nQ&oe=6AAFF8B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svRDKVSz_PcQ7kNvwEQhg9X&_nc_oc=Adpq0WF3APVh2IdSSgFzD-melnb37sfdoQ3QAaOr1Vg-mfu4-2n-Il_HyWlnn3547GY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR6qnhJJPMUQgfEosakp3f4nLj0Jrng1vzXwX2SGk3bA&oe=6AAFD21A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCz78e6mtF8Q7kNvwEATPLF&_nc_oc=Ado-SK7-q5wPkVaX7xZcqnJrnFo4mUZEhHAMJwjrjo0-rAspVylhNG6empWXt7aKZc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXU1vCY74BVOothYuxXTi8FdgHwriDD5XEWq1bRp4_yw&oe=6AAFDFC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSiSH7X-468Q7kNvwEvJ38n&_nc_oc=Adpt-NrEiu8aXzacz6ndzh9w_5g1i0ZUxXcYZwDE7uOmXQJc_EDfJYPmgT98zaEM8p8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWxnnDd7EWyn0bcb2BrJJe4xBQZ3i6q0cZ_LxASlI75g&oe=6AAFD78C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
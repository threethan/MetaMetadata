9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liXbZYfBD4wQ7kNvwGtUcAf&_nc_oc=AdqCPFmKyDZwT4fsKRaFujLeUqTGPha5dPvm3FgcifLGWmZE8Z5BDtyRgs53jcY37ig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ52lsBN96kAm353eNww0C91K4v-r9Hb7W6gio_mzoH1Q&oe=6AEF4E3D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6qa8W8EFKoQ7kNvwEg23CK&_nc_oc=AdoMmtEz1rMyFyQXPeewrqXqW2xl2eWDSGWLLFQvT2RJAG2KOYBh6nr4QFT0UbxdURw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVlSKHtMAccxJ5s18Uo4O_PH8I-EgKY__I0Y4025-tLQ&oe=6AEF5653"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBSQH0mXJzQQ7kNvwGGPPM9&_nc_oc=AdriNpZdMiDIsK4-pTqEExx0niYElwXQnpKuwwtcFtd9bsVAdfH0sLg-nRVHmrAJe7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR27_2f94461b_ojx1zfBcuriK22hEhnM1w8cUBTqlS2A&oe=6AEF40B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wvMdvCv6rYQ7kNvwG02a_5&_nc_oc=Ado-SYMYTo6nnQpVTmkguM_3YtB0gQUnAYqVdBiejVc2gnYqi2iG0Qifrfa930xQAx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr6rSpERUxNlIn8MdRNTyXNLgOUHANs5rSAtRwbZxi-w&oe=6AEF525A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnwpC_8FdmEQ7kNvwG92bFp&_nc_oc=AdrhCaOn8zZwjHRh1XyO9ue4AwEzPftzKVeEiPB9P11GDswtXgQrGIcyJa8TsS7AYWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBtkCSWC7B0HHLaKV9mphzQyuPCy_bfPTTMBVkuXZMyg&oe=6AEF6005"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO0HbmFuIuQQ7kNvwHjtS1I&_nc_oc=AdoSWtWb0WF4TmnT95HnqDHRcJaPrdhBqJ0cyzsN8S_BZMbjM3Z9Rqr7bl4mQ-BsOek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNgdrwQl-GwfMNdFjMGOZW1yo8eTr7UnsLJ9a8DAR92g&oe=6AEF57CC"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
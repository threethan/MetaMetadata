9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSyRzzJncqYQ7kNvwHUcLH_&_nc_oc=AdrVrYEZNO0mfOxDk_IH9MAA7arc5Uw3y9h3YZyYdU8wsqrogAwEihRAdq5IEq_guOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9IpQgV5Bn6RPX2pWS95GVJYLeAjs9XrjQHaIh645KZg&oe=6AABD97D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5fqN_V_QtAQ7kNvwH4bnj1&_nc_oc=AdoDEGkDNjKDukEK4ORxVcIALrtUQpcHQhryqsIZzNycwUPvTMgRrONwSt9S9j3KEJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKevh19qfUm3GSyh3DeBdfaiD2JWXF4AuTT3Ks9YD_7xg&oe=6AABE193"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IrhDrA-5d0Q7kNvwEUlQFr&_nc_oc=AdphrMDRZUviEd7VYlHkOgZxxMJBep81FdT2o0hV0x7u8dbCasAciqB659fPO1JAn7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9eco27KvyBRAtA3MXiVW2cCXP9GIOpiZb8KzAKadi9g&oe=6AAC0432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUu7pyDf3usQ7kNvwEGJ7gl&_nc_oc=AdrNg0536sO_Qm3B0celapzER_wJ3roPKeUaSBqTHo8IXu5WG99d8izbtJkbDOKvxpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-b2BQKE1hQutPF9RmAoCKLN0MZoyt8FJ5ftYn9PAJRg&oe=6AABDD9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IQT_8AzhHcQ7kNvwHCtvSX&_nc_oc=AdrYQUH9nHdufL68g3n5JszGdB-kdpQEDVXO90i3WHl7ljFEqgfGV0DifGJh3AIgao8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaxhux5KlexsYMVt1iodScq7PLYhpBHaAwRnstxrnx0A&oe=6AABEB45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH35_u0y_QoQ7kNvwEBPn76&_nc_oc=Ado3C9wqqVyzd1YlBkqtcc3R0Bx6dUsmI0SZLhy6K2BYnfauNQAF4Fg8jIYlOaP29_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMTuHFX2ASiBCJilPHe-FjRcGxjv3H3bhy6-nnSOPwXw&oe=6AABE30C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yT6WnVFNCV0Q7kNvwE_6oZV&_nc_oc=AdqJ2txyT8CjuTJBYRBafMKd59k3Lgjhxn2qB2ZFwUPEhahj59nNR0BRiz0CIYw_5s4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUegNv9rcL15lQHHM24BQIazMjdK6FbBQVp3uh71e8aw&oe=6A5E10FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNLjsg2c8nwQ7kNvwGvT3hl&_nc_oc=AdrIAKBCmAf9cLd0dXhVfVNZRvb8OlSlf1Pm7dIYFH2MTLDcKyTq6Sq_KuUpp9vUK1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyedaM-YjdmP7KIE-MgSHpzBrynY1d9xVAV6EcBN4RIQ&oe=6A5E1913"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-TpU4_jh7wQ7kNvwHbyjp8&_nc_oc=Ado8uihq10DlDPnNjRLs46DJBHjRp8-PSgYYqbpdc6XxJqQRSDNGVOIHd03uRjn68Ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUMyh94jLWUs61Koj7MrsjvtnajzGKaMVUgnyzEHqqaQ&oe=6A5E0372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVlcokA6ddIQ7kNvwE3aC0c&_nc_oc=AdolhXovPSEf4Ag9N46pity4vBtbRoz9MP4FOdKX3Sq5F2hQebWR8IgH9NyEmb0Vz24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBavMXBbgejhocD6E6ZXbHe1nHTJ9RghARYn_x5KbgPeA&oe=6A5E151A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKVsRH1qU3UQ7kNvwE37pAM&_nc_oc=AdqYs-rkhLhg4fWGj2gf3CwSYnkhtFkZwEh8IhIm3Li_DovwmEDkDMc3wOxN9HwjfV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9li0yK8fzh2YxSLHSpIOxrlRf4khvVxBeU-z2Nxzfeg&oe=6A5E22C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJL1KoyedO8Q7kNvwGPvGzT&_nc_oc=AdqOnvNVheZ85k9ViaxzyYDzS5oKrwnoLAgd-VooRUkPnf3Z0YjZciZo0zAsJLZu3Ds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCujbCfIek2ufoYQbY02TmBUlceu5KCdrR1xjV0auQ-OA&oe=6A5E1A8C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
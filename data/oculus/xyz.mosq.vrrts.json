9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf4X4ABnBEgQ7kNvwE69FCS&_nc_oc=AdphC2lU104QMjjeyRbH1q_pxOGWajHE1q4s10fOsJBt-0C7ATccd7YcadZfNolg01o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOefi3Yk0j5WY7P_w8P_0fZDGPsImiRuVyVwpfIQIQtJg&oe=6AE613BD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4P2onBONAEcQ7kNvwEupOPt&_nc_oc=AdpO6M2nR27ysysco_EeBs2OKDbpIIw-vCHSzOUbWrhVSYB1pS22EXeZm2gBoeUVmgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5JJVZamZO7lqJZOm8EgjLjPzOG70QDU9m71tKvmggeg&oe=6AE5E393"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdyYNB9UHmgQ7kNvwGSPqDm&_nc_oc=AdoOCXEKaQBkB7zXrLNRFpnXZypz3USOl7Yfe447FqCcbbrW0JLtDF23aj5i6gUN-0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvzFwFuCGbMpVAa_G7MPhynAXSxhYXfZmUGaI4SWw7Ow&oe=6AE60632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uixznk65BeEQ7kNvwEs-LQb&_nc_oc=AdrAY09GE6WZAwUUmd_Rlxa4KEX5kmD5Jn4FLOQHHnkIOuS0SHVF8tLqRS-8aIlfYJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7lRcGxFrmHK8OR9Y8WJn3hUSHnpI0F9cqBY_ecHV-lg&oe=6AE617DA"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyWQCKlDxskQ7kNvwHC6NvQ&_nc_oc=AdrV9UkO3-nk0DDAlW8eIz5S0FDD9N94zzw0HimxvlW6q-pxi4pn5XkGsySsw05D7dI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIRbf5RkLGKrDPnKinalzoNmnejSaSSKRRTXgHaq_n_g&oe=6AE5ED45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3V2WB2dFDAQ7kNvwHmVFes&_nc_oc=Adpk9r5ufthU7A18FlC2wRb_C3PWVIxlsynC4HGY7lr7HyhdzGr6uSMrXbqR4ZNfY3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9efEVTn3asLekTU_cDdZHULOKzRUPGVxHXFFNMS5cdw&oe=6AE5E50C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
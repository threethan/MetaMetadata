IBDyEua7MQliZ735gIkUQBmPL21GuCFxCXtzt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLpqyebc4fabkVLt3Nt62VbneUayjjSOubcytbE1pHfg&oe=69A6D07D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9Z3eQbmJw0Q7kNvwGXh7el&_nc_oc=AdkEfnnSg2TKoqCpcixX6djEcSx2K1vWvwAgSe1F_ewX3pkH3m3CShS7Jpd7I8RBUC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfscavQ5rM6mBlQcrb2Mp2yFKS5eW8bBum0uGCcg_OhE7w&oe=69A6D893"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7wmBEJVj5gQ7kNvwFQcJ79&_nc_oc=Adl1GPXzewRTLyfJtrzODP-0YnglxZ9godMCfqeBM03qXhU8alHXg3PrGNG813QWhUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsX4wNoqru7CW6AxhaAKPhR6g9jdXukxBc--M9h_fPASg&oe=69A6C2F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWE7hxOHDAwQ7kNvwG0DBaf&_nc_oc=AdnRmW7AaZc3QRUzZT2KPclvftAv5SauKIpPNcYpEK-mHLJizyfpCsTWdJbQQXPIZfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftizKhYyjom2dt4BT645hXFo5qlwMSqF0tP6H7-rdoTJw&oe=69A6D49A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOtckOh9p1wQ7kNvwHW5BMC&_nc_oc=AdlW7ByImc8g01ChmfiFM5wTnERuDJ6cFO7kBURaTTN3K0G6lDHZoAVh8ZHCN9izht8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftDqf5mwwjwy74QlpdhRKhHSJBcKHK-7iBi08Qu5DpfKA&oe=69A6E245"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcHaC7iXGVAQ7kNvwFaHaUI&_nc_oc=Adl2AUoxY7WtsT72CEnwoP42RUW0SIRaukFI312u4vgKwqOd7KpODNXLQDD1iAtT034&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsTydED221PcyNYdlKRN-gdW_8nwXvezy8r6AO_Q-9g0Q&oe=69A6DA0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1572766622922308_961628044886678894_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EBtJhuj3yIQ7kNvwEESBcD&_nc_oc=AdmwPPDGeDfmHiOx-61mBitNtwBWUc3nRaBNZJs
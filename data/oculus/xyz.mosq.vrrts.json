9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q22sfWziZFEQ7kNvwGRuMMI&_nc_oc=AdrmGse57Ay8iFfh2TPhcycmDiKVeqyH8DOvI81aBzIelchAUU9-2NQGmzXP4rlj7rE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM80tYfQCB8Z2Sl7EkP6J0sxQJGlWAeFKAgIAx8AUidjg&oe=6AE3387D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6noHcPss_3cQ7kNvwGj37SQ&_nc_oc=AdqEsHrXCEJ7ifzsYPw40k_IK8wEZt2VVj_wegtF0SG7cg4kyWuAFWUdSlFTL8fhr_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo7aYsAtBTJ3ViGvKtqxB0bbx0TvntoMhlvMLlPk9vsg&oe=6AE34093"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zQJrLifIG0Q7kNvwH5T8UR&_nc_oc=AdolvwXSvDfN_CsCA0R-9mivD-EyeDkfPKeDICZTxviLFXfLaJTC_wKLuU6Iv8vUxi8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-mrzQ5sjz-dQ9b3xQEgCwlQ2yWrnO7qWcv09kHC1rBA&oe=6AE36332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luoaDmmCXo8Q7kNvwE0Nqx1&_nc_oc=Adpnp9hWEkxWyRh9WPkh7zQjIgAJbjJgF5HE4T4wYgp8VU5gd4rf2hmTJXiuq0aulf8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM14A0ePhgvrc0S3WIfVOBoh90rFJsO4Lp3rANIPoQwpQ&oe=6AE33C9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyWQCKlDxskQ7kNvwGYdfRb&_nc_oc=AdqzTi6euBOqFbUhM4-37K7l7BH4mBZc4g0zzOka-IbctFSdlpTcfKWwpxkaxgW5LRo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9k7q9PsnlVVyJ2lYZR-5O2YfcyMBvxmS9qdTxK7ERvw&oe=6AE34A45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlmV0lEBcvAQ7kNvwFeJCV6&_nc_oc=Adptyzrf40ia8jI-MBMVruKJuJMYuHjLnm-GYgzss1aM87WZIUYAHn4muOs6o8hzxcs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI_tgvLTyXIi7yztDv3V-d9bw0mB6xNYFV79fqUQKYog&oe=6AE3420C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculus
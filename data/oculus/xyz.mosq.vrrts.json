9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9s6TX3_kL4Q7kNvwGnQiCg&_nc_oc=AdonuCutwXDpQ7F0n576aGzuzgS_l8FaDsb5Xw8HqsPCVqqOza7mW-nLG4KzEzQUISs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE95u57sYDdo7gOmCh_Ekg8ZnRTXVmQOx5h3lb0GDPmnw&oe=6A81A97D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkHh4DTPvv0Q7kNvwHNeYvA&_nc_oc=AdqW-2OH2YLQP09Py5HxPbwUnLNlCjNInXxluJXpt1f5px-qAmUoj3BZCYX6GBvCST4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJY_H7nV2YFC-0wwj3K1udJMHDBLm8U_yVF2QUGWhduQ&oe=6A81B193"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImiT9qwr5rwQ7kNvwHelFud&_nc_oc=AdoA6NvYg9fnUrg3oH_ENbzA3Y1mY3DmqjG6j2Y5IhyaR9ICw8mUVzNZeM2tqsVeJMA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_RE0wU9fNT-pFErG6R0IunSOf1jyG98vFybDC-IRSXg&oe=6A819BF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ao0QzwbehIQ7kNvwGbyR5R&_nc_oc=AdqSgW5rZe14UWtw2UCq9MMHLGqhjATFpWwRQRn2zwB3NXXu0mkwdtmBj36uqi0wMRg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG24z2T1m6FIcQ0XZPkdtvvjip8StKOUuhNp82jiQCz_g&oe=6A81AD9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IO_knEj19VUQ7kNvwHhidF8&_nc_oc=AdqFk_Lh4XSJCpQQdgk20fqUkA_esKc6hDftBJhN4Dj21RADpJcrBUobLWiSv5k95-w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9XTSpati2qoJZfdpjhUsUiAJ-6WNWXgVMwMkUxCqRRA&oe=6A81BB45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTm38Tobvu0Q7kNvwEW_Sku&_nc_oc=AdqWz15RoSRfVz7U0TCNhrkwlF4Bsv_bg2woV9xJ4P1EX8rKR63WzyAUwmYLY0TBigk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoV1-bGhEm0xNLuc-PvwM-iimCEAF59o1df0tSFV1pxA&oe=6A81B30C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculus
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZxQhmjwClsQ7kNvwGIs0kH&_nc_oc=AdoVdMhqQ0Ge1VTiLMivCvpVoUZ_WJTktW8rkjHWLB1YnOmTUSjYA_ge5E-YUwsaGuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWfqQUnWF2O5ZcGzXMVXajoJgjRLEkXcgO0bH9wWfFVA&oe=6A7328FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZQ4eI6Ol74Q7kNvwGSBYsV&_nc_oc=AdoMJg1f0RuPX5UB-0Dk4yJyN0M59XlA05ujFywGQUxLKj-9XxSpWqUi5Nnkeby1wJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHffJzg8Hw-JPbo7FURNbsaNtRw2Ror7mHgYgYfNPUmtw&oe=6A733113"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1WuHs4GqzMQ7kNvwHbn5mz&_nc_oc=AdpH6wkNfVUBxFze1zsjIcqxIt_f5nxbx0nr0QBEIsaiP8uS5v0ZUJM3FpQLk8B4_0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnfoRZg52QXMT17-fFNHNh8o5RQNusqhHFtEcoBmctDg&oe=6A7353B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3u4iAAgY9QoQ7kNvwHsiCc7&_nc_oc=Adq0Is9jXkueUMrkyYTq242cy_zGv4kJ7JfRLux3f69rWa57yGVfVww44ZIYRGQPNYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcNjwxkbFsU8gtf_5kcSMSSaxoYeyj5b3zrISmamncFw&oe=6A732D1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCV8eI2xYYoQ7kNvwHPjhBN&_nc_oc=AdqO4LkEDZlmyZtNCWkML0YbJliNcvyTCv8Nb72Klcni3ZNjJpPGfNe_PyUv9ff6huY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMmHtZhdEo-n34pU2PZFmtSStBf5m9Ere1ppj-Ujrs0w&oe=6A733AC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2NAHnJjALwQ7kNvwHr_fhw&_nc_oc=AdqLmmXJkNIw5Rvhr2SyjEWhTa4Vhb3Q0fbUkJ5p0Bd1DthmrudX1dkbX45LwPk02V8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhbhSHEcSWUQQM-sFGUITVVgHfXMA87FI301NBCD5EGw&oe=6A73328C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
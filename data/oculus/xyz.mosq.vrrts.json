9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyTo-wIN_74Q7kNvwG0oFnZ&_nc_oc=Adpj31iTczP8PYik4wJSNSumTW3_20p-zqtjIhhrMStN9oOyBpv-lvUkEfiqrwsUuEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0trlOFwNqUuknd3XemtJDJm937v9y90p0oTNcq2WeZsA&oe=69DCDDFD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFL8DrC-ZMAQ7kNvwEPg3pq&_nc_oc=Adq-UeVgfnMaszh5hfdYf7UE_111VDC9PSApdMnzt-tN4OEQo5wgwVc1cYHAFG655dk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BLtEvWFgC1bQvtFNKdJ2sJJ7DiooClJlGc8VLVBLtOw&oe=69DCE613"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPZ3vsTI_UUQ7kNvwE0AKHK&_nc_oc=Adpw8hcoWf_zn3vEs5kJ5XO06eNNTOyOfMul7Q9-2Wbstqqz8gFvA8TVe3-nY-5E59E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23oKJZ8baV1iSWWv7yGuGBy7hd0Di7qEoG3nCF3S7IVw&oe=69DCD072"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUHb56bz9lEQ7kNvwEiCTq8&_nc_oc=AdqD8FVvd3kcljqOBwtxiPUTSVgAIRKq65ILECO0TFassav54L-Af3nfIy52U0KbHz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05uYxPhX6_v9_wcJYB4gFayS7EFhr223UkzBocanXL_Q&oe=69DCE21A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2ZOlZNwTnQQ7kNvwHWdkOM&_nc_oc=AdpnC_xVs0qpnJaZGUQkcT0v-txxcz0ZnUOuNefDKB_R-eo_of_owwrdI2dZKCOamzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GIHDWvpwwmKlvHr_uhkx-BezWfqncviqse0P0TV6s_g&oe=69DCEFC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-qj2Xmb8KAQ7kNvwF5uLki&_nc_oc=AdqZ-BphCH3Zat-O8bD_D1gYDforei-EKFIIN_aHoeZBNIUGiRm_L_TfnD9rtPjyF-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xEeALgKIxA-V9oHmgPOlg1fFOiAz6AdJO1CI5TYDNYQ&oe=69DCE78C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculus
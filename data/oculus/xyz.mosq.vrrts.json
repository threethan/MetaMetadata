9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waMz8pAN9aEQ7kNvwFoZKnv&_nc_oc=AdoO69BckzXLqn5Pd4FBIEejEgr7MKHj_SuzJzGB3goxyT--_ojF2G8h4amrbzL0BFs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuc6HQCP-vp0gkhsmt0yqeLi5Z1ldSAh7yj0LiklHKRw&oe=6A65F9FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBUhoaPzw6oQ7kNvwGEquqm&_nc_oc=AdpltBDRFQXslYE3bbyv6Q1ADij-6Dw4av3iueM9MHQAxmn_hrqtTdtgDke1jYSSizQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZGeRVnFqUyG_2hNns7hvXSR6pu9zJRpROffzcX7UYkQ&oe=6A660213"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jADPVGNeHIYQ7kNvwHGVlzm&_nc_oc=AdqZHFM0OS_vOnYio4g9gOxzhNvLiS5LF2WPaWMak8ZpXB5dslO9b9wPs1nHgHFHR2A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu2fBY4JME6VKT9vUQ5Oiw1St7Z47vksdt7e_ad2WXVw&oe=6A65EC72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M_QiuJpe-sQ7kNvwEew0bL&_nc_oc=AdqJAWb-qCxMTOAH48uxPKk_3vRLEyZlBCITG3MCuuhXuDF3CZEIww_jZxuX1VtuaXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBkYjKQ-4nlh3UYyC6NfOZ--DVuoeWNBEa8P4okHkizQ&oe=6A65FE1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBmpD2pKYJEQ7kNvwH3YbUt&_nc_oc=AdqGE1p4vIdIIoXPybpOhOYkOjTHUY8Jubgm8UveEIpjTN1MPi2ryMAO0aZ_WibvOyk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtYNEk7SChR8WE6el0fTNXoGTJP1r2GNj4esEstiIHpg&oe=6A660BC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fqRDvxdgsgQ7kNvwFtGol-&_nc_oc=AdoMLmYfVdY6FSAwAJw8ql8geUuhEDJMK_itVGg2IvHxx7wdFozRmfOI98qvScEYTSg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTv2GdI6siBiVMKzXj0zKSEFkj1hMbJroNXQn-s2E_9Q&oe=6A66038C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculus
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZYFXSZKNC4Q7kNvwGUF9KH&_nc_oc=AdpzqrMX79BJIkham3Xzfiy4cnl68eBT8Eng2r5zs3zLANk69VnfqNq9scLOoit6xbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QYzE6yWHgzR8MtG0qnKppfqfJy-UoAuSAF8ogCluRKw&oe=6A2598BD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guITpuAPlk4Q7kNvwHToDVE&_nc_oc=Adqmtut4c_FzbmQsEJzUb7oUoM2CcAuYkmfFZXQ15OkN50V9L9QHHSx3tTXWdZPIAiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vkWaZrzqIpUoms7Z-tFCspcW8R-wlePj0Z9J-x6sFhQ&oe=6A25A0D3"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR-0enYd0_0Q7kNvwH2rqsR&_nc_oc=AdrAsSPr3wQRF20wVJ08yfXh0_sPODi74RBH4GUNq2HUY6-MAen_S4YrY662x4ddeo4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bMLUA7NY4vyJpdfHQvbCh1msn3UHOfBLkjlCO2Se0cg&oe=6A258B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHvReWrmalIQ7kNvwEEq7W2&_nc_oc=AdoopfoA6g4jjhQXusvn9nkh-klOMs-5TQ-y2hZZUaQZgBl1y5NFckCpquNCXBPBQrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tuT4qXGXkGobtNRHsb0bNMVUGxM1o3p23pI3ZnPp-Yw&oe=6A259CDA"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oT-CD7VtCAQ7kNvwGKN0Kl&_nc_oc=AdqaeN6ULe_zwd2QebE4rRnCaLJd0S00ALFZRbjL_bv5umwCNyIkuyQe3zPuK6N57rA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jYBmKxu9j30DUKp-0cY0i1tks-b_74KgD2Xja-6f2Vw&oe=6A257245"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rl2jA581edUQ7kNvwELvMXc&_nc_oc=Adp1wJKoGQGdCAg7_RGtP2NtdezARFyX9CH7LVngvjjxx3lneRDfxVkHe7Obyol9H6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hGclINkJUaG-ypHm_snqm1QoZKxbBPVknwFV5F_0xBg&oe=6A25A24C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXaaJxT036YQ7kNvwGq6kEr&_nc_oc=AdrUFLCOJ7u2IvlofLIDAAXTeJ0ZJGP1F7yWFiMnpApNuyu2Cy4CAWbhnsGMXcnDu0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8grV1j2GtprTm8AP6_zwApOneG1EPN7NKgAqJ1YWfMmg&oe=6A2E9AFD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeiI7fOgW0EQ7kNvwFqnKri&_nc_oc=AdqiVKvPGytNSW9ZGLH3ke_K2D2qFlqrFDbuFZkftmyJn1YJuVJTqf8PMq9EZcwhcy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j7l0u5mvUgScO5i-pgaUozUdfx5Txfqys0YI-GnTIsA&oe=6A2EA313"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29iSHyyWfPoQ7kNvwHRuToY&_nc_oc=AdqCOnycbYPg8SsIuHQofBU3hT9ruhsnt7Et04ZL1T75kHlkqxWgb-fGvxoOGdwHTtE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jn5Roq3LZHMvmPNefLmnaBuRrfsuPYxQTL1bunuru9g&oe=6A2EC5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TMRpuNIaG4Q7kNvwG88ktl&_nc_oc=AdoZwSl_txSobkaAHxMuHgBnpi8WpfGwcvfOxm2VQB-Mx-RKMMLJ4EcrkpzktSPnGWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gmz87bkwNXqDzgQuBNHbxmJ5a1cZTgJrVFhyPfhkU9g&oe=6A2E9F1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQ4C5vaDi5QQ7kNvwE3Mwa6&_nc_oc=AdpFwRKi7iUqAfTfP7qsc-RUQ-rW1RE3BR04C5Z1tmbHdjeV4zqTHT_0jbnqpFFamLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0ol41QfhHLY95ddav1AJ4brLGrn3RtSj_B9krUwTSKw&oe=6A2EACC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gh_WvjovUUQ7kNvwHoSajF&_nc_oc=AdrM8o-m3s5NsywnEJG6AI2b-NEecW5hIMsULOXN3OE05wiMGBtXzgxGBpx4h8OW6SA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kgX3AlUM1HHHfPj9woZhJcm4wexHUSHClDprSp57DGg&oe=6A2EA48C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
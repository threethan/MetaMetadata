9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31rWTud4I_gQ7kNvwH2AElk&_nc_oc=AdqZkIpuJHOYxwD-ECCfWlpuLM2J6uhNDrmNLqHDRBjdI4snEallvjimoZTfLUkNo6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChnHY_VcDtbzuWwBF2JsUTdRD7K7Re3ika-8kwhy-ZfQ&oe=6A64A87D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMEil27cP9cQ7kNvwG4qtS4&_nc_oc=Adr1Uwvi2Ml9TDsm1QwQt0XcasMVNyX_BY0uEM8PFs7-uw6u0PX_tiRaTwECWqe100w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8F5fwvCNrkNqNLiCPodzJbPUPyaBuWT4JvBdlHq11TQ&oe=6A64B093"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jADPVGNeHIYQ7kNvwECFcnq&_nc_oc=AdqiaQxwHQL1WR1FC-2jbnqmmKT5Ifixp1Y2pcxDLWR0IExZeq_m53dMY2-z1KeWImo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSXpYWPHy7PFJ1to7ZU3PnB54l75iwGr_6SiepJGD2xw&oe=6A64D332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAjDBSelfiYQ7kNvwFOZ2sK&_nc_oc=Adook3fFF2h70a4ISMm-8ZAc5aNrPdYR8smecwPo_ulYF4dycGSYXLgfiSbT2tUsrEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk_ojIa_5cIng5iBrPCeGxW9Nhlh8TljchG1EGgzw90w&oe=6A64AC9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBmpD2pKYJEQ7kNvwFB0yIa&_nc_oc=Adoh1Tr1xAt1-lOi7QnPzEgIXJdzR5ZsPSJuVb48BSW6L-AjhBSZHzpwKjuD8XzLWaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUqqIY0Xd6m64PFi-WMaE3xufMwDrg4TtEQL3zsG2q4A&oe=6A64BA45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fqRDvxdgsgQ7kNvwFeApAk&_nc_oc=AdrVfbjs5OHzF5JuY2bRsUg9L2T9hRwJ4Xj2FhiToVLcTbVFv1TKj0wpgsYRB-MDz1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV1MWkgympS2m8H9nlvCMcFNbS2XMmV8ct1IkvLROKFg&oe=6A64B20C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
AKdyDkYmLcNmUZ6SL1m4GgkTcdWqC1SnVYYTvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKVgxhlTVWZFFKO39pfCg6UqxM16s5CrJMCh1ljJzjcA&oe=6999A17D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuGihQqiy4UQ7kNvwE0fSaZ&_nc_oc=AdnGCFmTXxe5DmAB-y1-dG9Bwrv2zJqG4d-Ovv435MM1nqDw_bG2fguUXRaHuZeg6aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCv2ffmd1lkY0VDyK1r-THUd1KT8TjKm4ZQO57yI3S3A&oe=6999A993"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9fKTuXYj4wQ7kNvwE9t_T5&_nc_oc=AdmXx8S-pN2e2-a-adWl64phvPrkVZ3mvUocR3IdSogpuLsNdytwK8K1OeNJmwH5Y-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu8iFh8Yn4Q-b1jt-g48L8tcld8CzmD_DX7fNGTL8GrRg&oe=699993F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEIUMIXcmSgQ7kNvwELkArX&_nc_oc=Adloxa1yWayG5CQbu0zZKjnaWB6unwt7R_NnMyIHOqAPYLp0SZ-KEmOaz8e6H2Rqxvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuVSgXghyLuP_X1_Z2BJOBesfGiD5djwr7txos3IUkCA&oe=6999A59A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otkc8JneXjcQ7kNvwHxe3ZU&_nc_oc=AdnhMsJt5VwoIUf_-jCx0bUE-A2-JhsV1gwxWliIhEXzVxNmIs0lW3LXViQiFkNxOaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqyAKYzJm8PVVRAJ893TqusqaqHCHwb0Zy2b6iPNzoNQ&oe=6999B345"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXW3A3PUhHoQ7kNvwEl0d4i&_nc_oc=AdlqAG_zaTNuzYMvqfGUBUVh7YzMU_nnFcr4Llst1KzdkSGQ6bfyv2PQ0oZU6_zt838&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvXp0Fi0V1laidpsuApyRNhOWuCImsa9CElIemkB1afbg&oe=6999AB0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1572766622922308_961628044886678894_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYAjhGjV9E8Q7kNvwGVz3eG&_nc_oc=AdmCVUGbfT2mT6_ReXdU5jva736Ln7y-8OxjfooLSHCTM8ZI
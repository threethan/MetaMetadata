H3QRLvQvRAMR1YOD04aQBA468a2A79IOO7u9_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLcmJXLJ3kGRM8gMyyl4I1vs-NqxQxbNkpJDJYN5vQ4Q&oe=69A2DBFD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y433nYu4HFkQ7kNvwFdZPZ8&_nc_oc=AdnE1SrVMKNQuG5JrM2-tEzLCO-Dsegccat6HRelJsVJjEl1MvJJZEsXdGS0B8lI5PE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZPfa5aqVi9vLQgmInX9O5aC60jADuaadNLM5G-4dxYw&oe=69A2E413"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhBH0Fdz3GkQ7kNvwFwVLws&_nc_oc=Adm55sbQoGALuwzJYoYsoJX_ftv3sMOyce6pW5szL4MGCjf4UJsX84o4jYd64GskdrA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsSWku9KLhwqTQkMShJdCbUn48fe-5UjwDVkmBGi9V5Ag&oe=69A2CE72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VntyKPSshW8Q7kNvwFGYrRt&_nc_oc=AdlNMdxU7HCrH8kyMwcqiPFAIWzJtZCTDi68PbBabHTwGbKWJQy-I18o-mqAh3Lg1uk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfspLSTm2IWSQxko5gNTXGugsBdLjJj-nAAU6f4Iwy6a3Q&oe=69A2E01A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHJg-55VXSgQ7kNvwGaPZ24&_nc_oc=Adm90J0VK9-aqnid3254u9z7Nj9b5ha3GgWJjV00YDN1Uh0rBeqfzjUF3cfunFz3_l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft50REEII_rSQg0HfwRoFOSuZb9OBUMRUo_X5YuJCdmmw&oe=69A2EDC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYOgU3dXIvcQ7kNvwFCtalz&_nc_oc=AdlqTpJjDeVRHaYRg5qZHwdT8vUEZMQTtLwySCsxE_gXk3Zy-KYQ0lKyVnaV-Bwc5c8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuVjD0WKMs6-34YfW2N9T7lHoM6NjvYMzxjlW_y4Pmq0A&oe=69A2E58C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_1572766622922308_961628044886678894_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWMf_BddbnkQ7kNvwFzrx2r&_nc_oc=Adl_mMULHziIdECbG2BaqrrRJcmBzpnFBtdyPFo9nTBqdeJs
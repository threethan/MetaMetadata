9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgpdLGFCG78Q7kNvwG4cP7a&_nc_oc=Adoz6LQoLzmoC9hTnhE3TfboDyHZeW3yikXUQDSyiisO_99N1C9-J1XHvAwLco8Qwsc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONeIOkRRwcix2ARQ7xxXIyGgj2LBcnAFoohdpFYGYM7A&oe=6AC912BD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCFV8SC3kvoQ7kNvwF2BqAP&_nc_oc=AdrtxYYClfBkJeq36nMi1OI1yVVIWxgwZicsFlnRJ-mm72tGyzaj_FpBRAQDoVsIUI8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOug44POgi8ZldN_XhA8QWvGK-pGq48zA-CGb-DdV4yuA&oe=6AC91AD3"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmR826qO1ZEQ7kNvwHNz6y4&_nc_oc=AdoZL-7bJAeusc-rqOXmop7yx3oVdAAugN0xFbSjtPV8rLiMNXhi5e0qbv4k6WG6TLU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSo_GI8bqw5XHq6cQ-SvggG-z3-oWZErdtAbzxRCHGEg&oe=6AC90532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqJMYemvkWoQ7kNvwE7_mCz&_nc_oc=AdoKS3G06avLAFdMBYf8aaECbwp9SL3K0sdV8fWuMlcV-rjKymuOm_Yrr0XLYMhjhoU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXpQFSsetOKGre3n_xunRqPjhxET0o6UcJENAwjWiRsQ&oe=6AC916DA"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZecD5x3nzUkQ7kNvwEXP7DD&_nc_oc=AdpIcrjzFws_k9QinMGLFCVhbf5lPTkLwSpgMtAo28W-XBdGQvKFEen2vdHaWlKR1sI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJIQAibaxP3tJuOSpY_rrzHhH-HLEF52tgwz-hiHxsvg&oe=6AC8EC45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ammy8_8apacQ7kNvwHx2G8x&_nc_oc=Adq3NT9KF-I-dFv4GkYrbIMy9s13CsiZANolimzrFYdSi01alrfNBKh30D8Y7M8yONs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvMj28FFn57_X5cnYvvfsoGOLY1USnybGSuHy4sMdzpg&oe=6AC91C4C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculus
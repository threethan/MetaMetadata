l1SCI2cCIVLsaVDBg5YNa9LTfgichwMnAwxge0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft2Vo74zYlEJEZoUr9ndygTlfXKVy6gKTXutudRQbeM7A&oe=699EE77D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Gmp09mwuksQ7kNvwFv1pHj&_nc_oc=Adk-qLINH72blNAJ_K15-KfXv3m9R56D2VUkbr7y-hYgGUU126I4Oc43IrpnnRZFsGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftwTGF5dKD_7kuwUsVC8EyQ5av_hZo5jGJ2F0CgsO5rNQ&oe=699EEF93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKjZNB0Hy5gQ7kNvwHdo7Vr&_nc_oc=Adnl6V9NYURnB6GgxdRZeRB57FQBxcW0v9X1dCVILV8tRKnxevfgFAdPt1kbsEb6Pqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfviAU6l8OJ_ua9_NYW2lmMkSuNKo90TbdrYsX1h-aYE0w&oe=699ED9F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7mqXU7_TqsQ7kNvwEHLu--&_nc_oc=Adlxnbiuc2kZu6c9DUG7XauY2Zg15u09h7s0KTYeUrOGFpdvQPPNj50pmjW9MejLFGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvD4QKBdk_P901UanC_-wSsaueSJMv5bKjASNbM1-CCqg&oe=699EEB9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i62pTKYuhZwQ7kNvwFK3joo&_nc_oc=AdkhnHVp_Bn5fYOgvLEDmtVFGlMX_0VO5U0ZsT7PX8sns12Lpyqu9H1MZGb0SgU5V3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft_Kw45To1MclwWM1Qd4I2M7vXCrON1mqt7br6L-puHmw&oe=699EF945"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KkrnGr7lLoQ7kNvwETcMIR&_nc_oc=AdnrqdBoBM78xap1uYG1M3ZYmCt4Mseo8FJAjk6Vtp01xPRpRpfeYVYODwbmCfY8Qi8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuHbo0ObYUpgCNWjRtEwv_oSt9zgZTL3GB7QfQZMbZgOg&oe=699EF10C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974802_1572766622922308_961628044886678894_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSW6Qf6cZXoQ7kNvwF4TrBn&_nc_oc=AdmhV2SzrBAUkgFWHpkjj2iLSWNQ4h165e1IyzBP8BtxrslI
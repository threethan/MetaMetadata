9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ljRsF2kkjcQ7kNvwE7c6Wh&_nc_oc=Adp0EZGD_t3uhEcyOqIXDopjpOaQvrhQg6lAMHSLGQuZjkLYCDgLaYCAv61Inp9lCIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Re2NOONjaSYKoAgdVrrHvfG5hzjh1bLxXKfHr5Zx3yw&oe=6A1869BD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q80cdQKdzEAQ7kNvwHMpik8&_nc_oc=Adotq-hc9Ms4K7BaZEXKUzzLsXFVwfkp-Iv6KDn6qg15DwDOXb-2a7ZcmoT8P_NUqvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59Y6fxsXinaYny2tJAma0ZuktXtt7dr6K-c5eQ0uFxAg&oe=6A183993"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvVw1mvYxLwQ7kNvwHpfC_q&_nc_oc=AdrOrptRH0GmD1Skux-NrCRIKfpVr-MSBdU0pqmDRw9pbq48autt9Y-rfpaGI1LitrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ocer-bQ0oLDj7yHs8FslcQoDbpMX9XExpJUIqh0ZGYg&oe=6A185C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8cdXDt6O54Q7kNvwFatP3d&_nc_oc=AdpE9zbl6hMPEzyAS9nJ7okfJ2dZx0hi5DJdeILWjTqE6fDvQvRSlCGsG2hrrd6qNlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yz1He1Edgp6k4ZxMnQT23rm-sR70SSOccIxXz7zYl4A&oe=6A18359A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs2XG2Cm4VYQ7kNvwHLcdSg&_nc_oc=AdpLK8htJyHapO0DcH53ji2GUxc_EaSTf22cUnijncrDyhCu6ZxA-XtyBN9of4uKeBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63Fi6Z34MaMxDNql-tRjYJHa_T3rP_e1ud9hlmWYFJMQ&oe=6A184345"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C92slnlwyoQ7kNvwHgjgQo&_nc_oc=AdqZ2Kf0tOHzJawpxPvMzYh1Rt8JtmkYOUs1aSPJyDMKrgLbf8DiZgHsRchuRXoQfm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L8HwtOWJkpBiv7QCecVCzl5Cb_Jwdu4bOl8pp9Qd9Zw&oe=6A183B0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculus
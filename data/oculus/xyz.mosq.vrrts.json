9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byliV5FiQVQQ7kNvwEKXyQd&_nc_oc=AdrmFp3oFPN4chC8VMnCtA3OAr86AphjYCaeTJjX1l9_6JFDE9AFPWJ-DX61BKkmO-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMUWd6Xw5CraG4Jfv8Slw5ewCxOkmRYYwesOgdJ1DcCQ&oe=6A52337D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woAWKc-soWYQ7kNvwGOc9pz&_nc_oc=AdqAVWFEuI8S1lFVaZsKLXU84TY2dx1VYXUeFh7N7xn8KoKgjS4vtAdws60nSll6DsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCutwvf8k-TfaLDjUxJBZseq0MnBsNeUTb6E8mCsBlY9Q&oe=6A523B93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_q5ynuEnq0Q7kNvwHc6E3e&_nc_oc=AdrDSuYqaPwD1IO-2UGbPLwptpNHgMmXpVnxEG-HVglEJOvuVguP2lCHlML92m3xM3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApHah035o8H7X8kUEd748gPoFrbTP40H3o3hVG_YlkXQ&oe=6A525E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIJO9_TXKvkQ7kNvwGJVf4C&_nc_oc=AdrAnjjzXJ6WZD-b4zmLeeIKPO2HqOUKOemgEv9yuwUmJSLf_7jvdzk4DwppeUjz-6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOOc9g0qCNinTsEMMP_-srxGzqdOH5V_pI27im9I5jLg&oe=6A52379A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgkaCMnDKP8Q7kNvwHlqbdP&_nc_oc=AdpAybGUi3O6pjwbQQP0d1qIMu0nl3e5gcXy-U3pqg7uIiKbFF1XFdafRXRSZqS6oVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuk_wctHFohYJgiTaHknRey3vXxf0lyzy9MfV3qYGtlA&oe=6A524545"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zjq2EtYAsNoQ7kNvwF9FRJA&_nc_oc=AdrNfCFkZhUACKtsXxdDae0UacDwhf_2I0DRmWf4-WHY3fETpwaU341qdAyFS0P-WBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe_ELdDOqW8VHjI3Jby4BUYcy8UgoNLLekD6WNK0QD_w&oe=6A523D0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
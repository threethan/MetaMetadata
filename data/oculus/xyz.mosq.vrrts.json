9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ljRsF2kkjcQ7kNvwFEAbjk&_nc_oc=AdqToCUgpmKuTMlQtnSP8fg32sMsIDZXZE3YLgzeruBBKAes_KsbeXRr06_gpErz4nw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vd1NPfZDsp6q8YtttZAhL5PXAGB98nS-NTm5BBmBVDA&oe=6A19BB3D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q80cdQKdzEAQ7kNvwEPUh4i&_nc_oc=AdrCIeO_k50RMXw6N2rIwDGnH6rdOXQlWNIHDiORE1csCY5Xik5wkHYUKmetElDoGMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_NX7eB9z3h87W9J3nDyEY-6H91grIh5EiqnPUZJtioA&oe=6A198B13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvVw1mvYxLwQ7kNvwE4gRBa&_nc_oc=AdpzVL7QN6bL69-sZmUDXqpBp265oBFhH8bOxh08147rpp5oogCddOO2jjfc0oIBeC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jXrBN1RyJvVhSqYa4x72wOkcPpdR2L1FIRDcX0FMrOA&oe=6A19ADB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8cdXDt6O54Q7kNvwGK2GGF&_nc_oc=Adon8uNJxPvv_WACikf5kKV0WwMdpEZoy5SeK1jiTdCeMUSVcaCpdxTGaniAsyG6AuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YC5kU82JTIaIPtlpBoWXAnZAY4CofHSgVpakyVWc-5g&oe=6A19871A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwK_IsMPETgQ7kNvwFOzaaK&_nc_oc=Adoas--LMd0tkZIv5wMewdv6ENUSZfeGbBlbpALaG4NEE9NLy7-sNW3GajjeSArHv74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sIJ5dKATHY0jK9-w37ku-4LvyNrQoNU0DQDSnKSbciA&oe=6A1994C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C92slnlwyoQ7kNvwHSyUEd&_nc_oc=Adr7wu2kiGPvdkGY_kIxOFwz7ln8iW6iGBurVwoUHdu0bm2QSiZwVA42NQzTjj1WcfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mHp_CMEagSbc5mdtnqY-gRLUYMra4EHh3XwG0LfYcgA&oe=6A198C8C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
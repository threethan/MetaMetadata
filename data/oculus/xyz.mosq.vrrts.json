9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-_3HBqfZNMQ7kNvwElvUKj&_nc_oc=AdrechNWw9Ehr49UmGcMIR0LzBDjjqdLz4daGScJMZIkWL67xLoUj7azgQBcW9NqsvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfArhpEfrE79iffPwvcWPdUvZdtklLRzCAvaCdRHyuEw&oe=6ABE86BD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRB35yO_FTAQ7kNvwFRuALr&_nc_oc=AdqkdfGoeHxjN98Dysxs9pZJPAOo_aM5TmlMxKgxyYHW892516AltZApggM83mYwpX0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrQNUlcVUkIzuR76UJCSyVSVL7H3mSH1_uzrZycRUcNA&oe=6ABE5693"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGS8pdsvL1MQ7kNvwGFyLXn&_nc_oc=Adr703Fk694BWSOXr2puHKauK74TePY4zBIYdsbpGK_marUaqpu0-RwTwgwMjxHK2FU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMeYb8xxM0GVd-GocqEaU3MStOHxS4Oosb-oOQZ_Cr_w&oe=6ABE7932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ni3BjdGC4C8Q7kNvwHKOORy&_nc_oc=AdrJklEz6IUlRXldnn_w8L2GYEIeYx62gCMx6PZqyHruxFot533GBBQJVnPQcXJfB8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJphpk5kKF_MbJqeYMmIte4LmSzpGyb_5p1NXkz0m8UJQ&oe=6ABE8ADA"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhfSv__LrEkQ7kNvwHfBhjG&_nc_oc=Adpt8eCmeOzOmYohZm6yNwDLiu7FtHvvb-i4TYOPyATSEbOW6xlBThQbesypB0cA1jM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtBFgkS5S7-GF_5sclbf_PS2DUMslqLGKs2oOyWsQeuA&oe=6ABE6045"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukkuhmGVyRAQ7kNvwF64e2E&_nc_oc=Adqc8MZlqZupS19VKJNRR4pGlc5chwvBjxgepJSOd62Fm7mkMbCDVYwKgDeMHCVCcDI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcbge_ONjo8GB9F1BaDEa1E6RIpbIY_fxPUdjpWz1txA&oe=6ABE580C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculus
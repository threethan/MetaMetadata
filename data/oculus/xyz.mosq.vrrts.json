9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNk7XTGbbd4Q7kNvwHyTlB1&_nc_oc=AdrIqO76VNTPv-O0IqtTIRJtyOfkxWmT59XaJAJlP1xXvoM89xWlMtgD73MHi4oe1WM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbYy5ZsELlXfbZoNQrezFgZUc0URpK9n6JLKItX3VPyA&oe=6AEB59BD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLbwZhmECKAQ7kNvwEBd-ci&_nc_oc=AdrqVhAm7j2yjaq1iVFVbHIiUjc2n3plRaqefj4RfdmIuqK1W56NS9QJB2qpGEGI2pU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtqPwgM5MEir32Q4mIrawcajj6cPgpyH95vZ9pYUw-2Q&oe=6AEB61D3"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAZ9IPQI3msQ7kNvwHme9xY&_nc_oc=Ado_7hv_4b_S6qhlisFuF5wbxXw6x60hJLHLWVNlyWHtVrNy5g3i5t3uDvlhR8Zgzds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSxXKDTgWv3Em2kpHzFhc3FIZD7GqxjuviofwEjMtSAA&oe=6AEB4C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP_c9oS12PEQ7kNvwF3vn_j&_nc_oc=AdpVkShst-9384CV8619b4eR9vH1BSBEmK_YvpAwHx5XHcIl2tXd_UbjqR3bsXpbX_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMC9JlxJIUjNWXBN21OggA4LZGpRL20HTDBqXzTQJ14g&oe=6AEB5DDA"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOaGSQ4Ws8kQ7kNvwEw-Mr7&_nc_oc=AdrbXOPPRbeoNZ1TeiQod7mekDEwCcTeyMciAMsCQ21pRLjQc4wS6sficBbfJicvae8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgLmRpUn1hsuCRF1m3Xt73iSPE2sbMbDvpNXouFpCGIA&oe=6AEB3345"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjoCB3Exrv8Q7kNvwEZe7mQ&_nc_oc=AdqMqldbkp2nWBAYBjCnDfifBrnFD6rOaWrBG8Rjxf5ck132fJe158fd25lwNVvzDNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCKDPVkZ8dnCC2QAHuLT9FP4jVwBquixagFVYT_5VzbA&oe=6AEB2B0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
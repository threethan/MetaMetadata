529224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSyRzzJncqYQ7kNvwEeNx0P&_nc_oc=AdoG5C1bESoGwm_p9mCM8nxbCdgk-NCFlDq_0kD7RxCUDKSTEC3kNYAr4gySmFXOVDY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ40hunuUhbaemrFOxDY1vhOK0XVsgjSSaVYMLwVx1grA&oe=6AA9367D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5fqN_V_QtAQ7kNvwGhgOKG&_nc_oc=Adqpfdcrzpr4A7--osi8GNwS7V2VxCpMB-xCA88p2qVoo0eEVbx6cfND54JowX8rVH8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu83A_wA9NbOHOITyAN5cmIfqp4BRZ6npYHC0lBG58lQ&oe=6AA93E93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNoqSeV4LH8Q7kNvwEMeLr4&_nc_oc=AdqeG_I0YeVRZaRNiIOuSsagb_hx1i50fiiXuSXIJ0w0_nVqkFIsOBYoNRh81ONxwMM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUg7cO1JEYtxKQWl65WBu0Xn0NOhkIYYI4nNTEzyzvRg&oe=6AA96132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUu7pyDf3usQ7kNvwErWa7s&_nc_oc=AdremAWzuyje6B94OSTFgTOgEyVWRLHoFnkuN82d3WpzmQSBvZ00v6NbW24imVbhx2I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKAFPEkHkbm4eASnMfiwMH_J0j1wzkPPWYAOUWDmdm_Q&oe=6AA93A9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFKzPFFKeVIQ7kNvwHIjIfo&_nc_oc=Adpm-ipHLBiQ5BuCIm7_9XZ6tHxPZmDdYrKUQlPDzkHSuqbK5VUtjciGWBGO92ID-h8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm9PlIeX5Q17dcsLN3LSm99YrpJ1yCHes7QvLFwWrF3g&oe=6AA94845"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4mhKTh0JdEQ7kNvwFljZNh&_nc_oc=AdrDTsXAA2Lpsu3ddiHej8djsyGE0zoNzphoQgkJdfnr-jAnFUK-WeJC07jEPtlBEs0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNtlaiBmmGbjr_1Xu13plxh4W2rRV5nEVbajueEjU0YA&oe=6AA9400C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-
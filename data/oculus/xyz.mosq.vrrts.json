9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVJPwvyQQwMQ7kNvwHHzlNa&_nc_oc=AdpePPZtfvDRz_e4XCe9uZuSWRushWOhlRpILSHhKFAtFfzdDIWFXe3jAwP5NtEwQAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9mOrSLi3y9Cv3c7xMvmWYAFFldgYDSfb7--oIsP0_eQ&oe=6AA7E4FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hXr_Y8LcPIQ7kNvwFKC5bG&_nc_oc=AdoGECkwPZFKroJlnqVdCaKo8ZMUZlg6EqoQmLlPj6BnLWs0h0U7zQRS5uykrDjcIz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_ij_wXZrtlXIdo_HnUp1k7ZNVa2RUxm-7AkRytO87Wg&oe=6AA7ED13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNoqSeV4LH8Q7kNvwEBTzbZ&_nc_oc=AdoBaze-Op_UC1Fh9bqDAY8HGT-Z_vQb-1X9G-KETQ8Cta56TEqb-8My-codals8XS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICsbwE1ZcLece37fhL3Yau6jSbUYjSDIyUU14idqj0PQ&oe=6AA80FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6If4ysQAuRcQ7kNvwFpMiW4&_nc_oc=AdptfPRsKNW95deaxvVmPTXJSFLwqUh6bZpAbH5TwMr-tdV0C9vYOAlSiu_Uem5eWiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIikndiF8hiLyiCF_eIGRGlLgb8v6k06bvdiGB4NrzkvA&oe=6AA7E91A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFKzPFFKeVIQ7kNvwEog03k&_nc_oc=AdoRUXh3_-MKFr74FxoUhABkBb8N0MIgWaW7VkxyFOTvdVGVjX4EDObAbv_Up0tsGRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_TNYWtQPdokRHyAPOJew8GxRztzfF8Juq0jOto9nO0Q&oe=6AA7F6C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4mhKTh0JdEQ7kNvwGRD84d&_nc_oc=AdrM0u2nnlKy7_afGw6ZNCvPW31lut6wJl9_DNSVy_ZKV4mDf9tWkzzroo406DO10Uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzK5xQKgRN5LbxkkznzvqtWmYxxizOM2rocCWcl4AHqg&oe=6AA7EE8C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
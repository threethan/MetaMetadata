9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3ZjyXfok38Q7kNvwGip2hV&_nc_oc=Adq0BwmPjL9R5VGCGWExgFmjaOjNHHlW8C8qejpe67kh_2SYo5e3KWMmdPEmyYJnPdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK8TtL0lyPQ1CGJlGp-pNY0TautL3Fn8r-KlpGew0oGA&oe=6ADE2ABD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mULCFWFWWgIQ7kNvwGL2a6y&_nc_oc=Ado_0GhqdZe8xqHcT1DbatnI4sXVvXq2ixssvw9LU-ai9zBHB-jfiki0scQ76stCGt8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8mwG6b-mF_VJk5vnbSz3a9bbnsgjzzw43KeO7l0YAEw&oe=6ADDFA93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0m8lgyzjP4Q7kNvwEfFFQQ&_nc_oc=AdqkKF-9Hhd4OO5ekmZfMlllOgH2G5_6qcfGUxOYYEOD685FZLvYI5CgeYxvL4He0tA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlllm6ekQ5mUR8-7z1jXSNDiZS58WDOWVAObi8w0T5mg&oe=6ADE1D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HractzIxDEIQ7kNvwEXpiJE&_nc_oc=Ado6afYuhS2sD0Yk47mo6XtQ9ttolWwmh9ZoVSn90qOKkti2rKDu4MwelrPgb1upJHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN33ockwGBpOqei8X3qE8E-DfyenbhunZBqZ8l1PfeH_g&oe=6ADDF69A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX_ZsSDJmbQQ7kNvwF_V82L&_nc_oc=AdoEvKevHsvBTmyUHujjPibONM8aecXCtLiUw81SuGNttiG5kluV35tQGUAMY42FHgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ3d2V9hcJSvKzilsSDPlLgR6hBI7HOJ6qwYIOuHhf8A&oe=6ADE0445"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u46xTfqMNpYQ7kNvwE7nD2F&_nc_oc=Adp43JrO3sJYY8rZ7QX-LZWZeGOA1s33aeKDkL5Z36GzQ5XVbzsVK0QsmYtTLQ-ZyLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9YmbGLRk3dhHSzguKiFVQOF1cPa_P4iZ-mPgXt_tq_A&oe=6ADDFC0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculus
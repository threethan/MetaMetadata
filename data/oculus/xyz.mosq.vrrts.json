9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILAKsNPHwh0Q7kNvwEL6SSO&_nc_oc=Ado2kpGl0MaU0SoWaFMMHYKgX3fVVAoJCgCXCsnMoH92udsd925Yazt22f_LD2YlXZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QBPLMclnXMX5c7sMiJfk14csOaaBCejGVT_Fqqbo1Bw&oe=69EE017D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWmV_AtcAOgQ7kNvwEwqosY&_nc_oc=AdrMvK8GaFsinSYpHcaf4zWGagzquVOqc1lYFRZlrCvXT-wfkIG981_5drlzxhtCA3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BQBAB8gWZdTfZDrtCZeF-asbUgGSQgTtbnz2P2GV3iQ&oe=69EE0993"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJhLz7ywFN4Q7kNvwF6nLIT&_nc_oc=Ado9rcLTACSCVfhDe8l03DuX0xDXPeN89Vt4V2KHZt1yY_SN1tTQVf0dhGaIAQdNvv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09AF4AcRV3lwfrlvhRX-NBPAdFrm8pcJQGGzDIe3-3Sw&oe=69EDF3F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubK72VOw7UoQ7kNvwEEW-OZ&_nc_oc=AdrIBwbbKGm9yfdJgQWOqMFX4BeLB0OpMah-3E6y6HPtriJg0Jzafk0hJXV4Xe3e9uI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fZa3e86WI5GqGplQC7Ug_QrNBIhZJ-T7jvKFQexxG-A&oe=69EE059A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eq_AKnGsjoAQ7kNvwHYRaDB&_nc_oc=AdrlQJ4OiqLHsnzi68XYtTNR2EY6sMB3hI78BFrIRAg5fWI48-IjQROPGniS-BSBGME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y3aVPGnqAePPCLBjJcmAcSCI9-KSeXVTOKqx1Va3U5Q&oe=69EE1345"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8XRE-aeBycQ7kNvwFUKqYU&_nc_oc=Adpzkyukbu8IFbgiD2sMOT2kKJXNG82l5FBN--nA5fixVNVIkqJjro54oXHG5H579I4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2erUL8rNMwZuUijt4NFUJYm_c8upMQXKxTumkFlxRGKQ&oe=69EE0B0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
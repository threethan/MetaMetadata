9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHJ71SLsujsQ7kNvwGzV1aH&_nc_oc=AdpkACXTGO9AtDtR2cOoQbjUWVwpGWcMM2ndzjwGCr9kz0bYQCH6w_nfTlOrAtHs9pQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMnVEpldCjzvCjICTQ2dyuGLhM8iwwxmpvoKqBglb6_w&oe=6A8AE3FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cUmUb0-yBgQ7kNvwE1NJM4&_nc_oc=Adonb1thh_qY6KUwMBH5CHO2I3xmTbMAhRy_oAdLIG7ZRni3l-KnfTdVg6R48uWCAvE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYZdqpFABsjH-tLptmYy-NFGBQFbDKreiekWn7ogc2_A&oe=6A8AEC13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPymx9vYkcQQ7kNvwEp3cX2&_nc_oc=AdqzWyVIR7_8DnL9yYSJ71W_ZBzOvh9WKuY7QfyBZXEvYz0g-UYbXrhSmxkiKM7UPm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNDVdV7N7nKHelS2_H4AAIS9j0yno_eS7mhzCh0voTYw&oe=6A8AD672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4cxPRuKDokQ7kNvwEzt0pb&_nc_oc=AdrhbwOVnEXzEW5_lydBZGngJHXwCz9ComF99X6TYhXqtkhZA9aWjqqfgrprKbgPgP0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEErUdHvrgWAbPhiXy-ACGcGEL6Hm9bm9_jyU4ipSelEA&oe=6A8AE81A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN36V-fmR0sQ7kNvwEDQBAt&_nc_oc=AdoKKW4wzVWZpFm0Cs8nGX0AQcQWAlJ2itA_GzeSCepV4X1ghGWS08FgWBB2fiqLIEs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDKge8rOclyudNm3DraUty3nYk-0XCKVkDaGrSZ_yhzA&oe=6A8AF5C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcqCoJK-RsMQ7kNvwEsIbZ5&_nc_oc=AdovGk-B86_ba-2zryrDZxKWA3sj9IVcL-iyWNF3iHfayut-8AJKWTmF9DkeKtfjRi4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExXT_X2lX4ohPvA3EGgials5gZBpby1pNe5kPbvoc80g&oe=6A8AED8C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculus
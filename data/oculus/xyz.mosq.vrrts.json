9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waMz8pAN9aEQ7kNvwF2l-NQ&_nc_oc=Adrg6qQgnnI15b0yIk5lbwuJk42SA_fpPfxe7UPGkF-w38YzXB96Bfo44xrAemVSPNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATSQG_42gB9y_pReBMY_6j0p-Csl8T_MLqYmBwGU1o7w&oe=6A674B7D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBUhoaPzw6oQ7kNvwHRFp8y&_nc_oc=AdpysHTsKbGDxpxA7Y3q94davfaswFKiQBsIaY-zbig4PQdT6jvVfcZzLjXsBBNzmrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxeWt2SFnIP8kbYCFs4SNoUlwhU9DmkON5dimdCJ87nA&oe=6A675393"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-tZMNqLu5IQ7kNvwED-UwB&_nc_oc=Adr-8pEEevABM3x2j0IpRDsIhOHbu2e5f3BNWVjh1vymsJKsBEESXPoZA6t4pkG8A24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD642dCNZQblVUJpO1rYISL1_vcvgyCdysVWtjfSC-05g&oe=6A677632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M_QiuJpe-sQ7kNvwEIQvWO&_nc_oc=AdoIy84yb7lCkLnqpufbnlESLbKtOnF-BBFWgAZwp-nLFH9p4hIO4YyTHQSI2oqlhfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3FKdces1X9eb1Trv859TDanUaAtGfM1oSKlcMi1Cm3g&oe=6A674F9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBmpD2pKYJEQ7kNvwGKo1Wd&_nc_oc=AdoecJ5YZbp7DcMINbt-pnfaUfkqcvsJCIM_9ZSdfoCfte7MCZnAVnQb4sSI1qJE0CU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlPefPUcgZ5PrJ1eixiTYhBZeB6c52eVnZTV6T2Xkj0Q&oe=6A675D45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxt2PC7bOp0Q7kNvwFQ-caI&_nc_oc=Adq8nEoRSkSWLGPkIr0ViG2uLqBL-PB4IL__zXlaf0X3sIjLrOKluXXiAtQMtC50vek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT66sRzwCMcGV96QHqDpRtSj9t5tbM_ZPQMbcx-mqUug&oe=6A67550C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
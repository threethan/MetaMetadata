9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xRvRz6qBT0Q7kNvwHF4wgQ&_nc_oc=Ado7PqoAElqZnI4T4iJfSzvrpY3XdYrudJ3OYAZXYS7tmmK0Jk36m_gsecLU2UmWWmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mbcEBsgWApLpSBYXofVxcR5tGVkK1n1TOieHfa_r2Tg&oe=69FC81FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-vv7XdskKAQ7kNvwEVbqH0&_nc_oc=AdrslJ1BAc42ZlVQQgyC8xJSWzUJzolNz9Rp_I7NgdbFxnB-2JtVJy9eDyYdK8MoMEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4faBiPVF6Uo1E-9cyBWLs-qxO1rCTI97paz8ewyLaUIA&oe=69FC8A13"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoIiKkqEqUYQ7kNvwFwqrU-&_nc_oc=AdpExstc52ULJq_B0-nrA9AZRUtkNoLKG65jZOPTqdQIax8bML99TCvy4CqstoM5VRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cABBXXP_8dFRPrXc3UlX7Wr5qIAYVfZ-s6kU5AP9Ywg&oe=69FCACB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv7G1h4fFS4Q7kNvwGUDQZA&_nc_oc=AdqnEwcQKidtsKaskkzJB-r2L3s2EI3fi771ozBy1RuhIyxiSpjhVRotE_Jk_PTkwJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QjZkabyz0cobvQOQV8Crf0BFHYAESv107Qn4eFmhslA&oe=69FC861A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwvspryHmBEQ7kNvwFbIzjz&_nc_oc=AdpYJoki218aOtjB4yqOxVn78vwoPfQUHLy0JtpuDPWz4GPSjGAwJLdbgPoZbfVVY6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b5fGc5hKqH4TPJMjQkhBoglv8nURGVyNxMwO0Sl5i9A&oe=69FC93C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OETWc8-ys7YQ7kNvwF8rp26&_nc_oc=Adom5CxMT6dm-I0fqnSM1NsRa_I_Kg--dqR5NR9m3KpFmf_bK64O828Oq1fok4js7Ho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kH7uzjimkqtheoMBFuSwyZmLXF1ODkKu0ZVCOqlDJrg&oe=69FC8B8C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
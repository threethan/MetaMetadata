9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZYFXSZKNC4Q7kNvwEZtUuu&_nc_oc=AdoeQxnJH61kTUgtiN86FX9PTHtI8jN2Qik3ASoSt976Q9gdxRYpH7FJL6m-BokpD9Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ADjY2SBZpupt0anXSJGrCHjIwuPetwHF341w902WKXQ&oe=6A24473D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guITpuAPlk4Q7kNvwFJyb9Q&_nc_oc=AdqdVRPS-BPKdWMC8J-0cev5B6GED47W3USmhaAb0Cfut3Nwo4eLaMF2rZHodNm7HlM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zASzgd5QclkGAVBhGofHq59Ay4e6dJlgLv-q_XC31fg&oe=6A241713"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR-0enYd0_0Q7kNvwEN0Z3p&_nc_oc=AdoGcIWDKWX1CZC7ARKLA1VCpIOL-f7id5L-_YzZJehqqiMIZXtRwhZlyPm91Su7J-k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jm3WB4NMkUyfyKcUGbk_4jJtXFMtiqWPLG9ry8YAFVA&oe=6A2439B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHvReWrmalIQ7kNvwEI1PYG&_nc_oc=AdpDKyLBMNHZuC2pK8_s5gt_RXsbNURbMeV3ZaM7JSfjj4gyEC7eLpUZsfvyAwzqBBM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HBToP5Jj_bPnuQZLkg0yBe2QqhSytiA1_0Hg3D3Fzcg&oe=6A24131A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jKZbMgBrKgQ7kNvwHeerHA&_nc_oc=AdrzmkW1DKHnbCwPRevQaZwnu1G3-KddT3QMvoaUaHHGljSEol8HoDYISKgJN2aQ6bk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__LKMXuQ1Nc0rpXcrGjm-26bglwQD2K1yH9W84p9f7BQ&oe=6A2420C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rl2jA581edUQ7kNvwFjT38a&_nc_oc=AdqyiBdv_ifDnKt5cxm4kfIGEA0z7lDUsPnPsAFZe2JtqVtXQnJa5uKlscvZzL_45h8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h9UeMr6mzPKlYOElXl3qMFBqPI8DeA7HZYvv2bJRzIA&oe=6A24188C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculus
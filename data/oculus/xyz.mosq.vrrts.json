9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJU-sPnz-z0Q7kNvwGJ5D7P&_nc_oc=AdoMnH-NawS9417cFrrPRRrqf3ksIjQ5mR2Bncoag3zvv0fwjwB8rOewr7Ye6Yo7am0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs_DL6cvkpHX5UycN3dPrgRBHaoaa-LXOnxRZn8x0jTg&oe=6A999CBD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blNeKAQw6YYQ7kNvwEuXOF-&_nc_oc=AdqpDf3Z-SfuHWVNSUWrBTRFJbG9kPVukooB-sLoQi_vU9QP4ya8dPTNJYkzqSjxXYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2Poh-CQA3lcVYLyiKUgiSPJTq5ChckBhE18Nk9X3n3Q&oe=6A996C93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVYXy1-mXkYQ7kNvwGsX6Er&_nc_oc=Adqtf6AfFRVfspjF8l5IQ1cUg_P-3S0KMt--amvrmHV6030Odt8y9rVV0vJH-8DozSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdksqQbkladIalRPklinfR91ktdnRnGuG0x9UcjD6ypg&oe=6A998F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t4KatJZRNAQ7kNvwEerioT&_nc_oc=Adrhik8Ucbvt9PQGrUlVkgqsMOrRODCsxqYX2NFKstpNaDFexnNPCUlNEM9GtCZbAM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLssKD4dke5D8XKTXZdXC9fIpppIB3vqU3WGh1dsZInog&oe=6A99A0DA"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oGy6d4mZsEQ7kNvwG0z544&_nc_oc=AdqkIJdqGRcd6JR3VNYiNirIAgld6YiCTnaGSQp31fbRSGE4CEHBLbP30_8QAn2nq2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1S58FHYTfwtq_qYnT-PY0eoL581tRBxnPCeCBhhadVg&oe=6A997645"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yx42I7FBgcQ7kNvwFDwjTl&_nc_oc=AdqJmAy8y0FQJlTxrAR0-5fKQofwiyJGw__xPm8bZb01ZEXj-WiOMp4nFzckDLtw7tQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMHz7c1rIb3_2iEZ4jGH5_ssAcVsdcy5UnuUC7wFKFfw&oe=6A996E0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
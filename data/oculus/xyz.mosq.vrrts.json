9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpy1GpTg9_8Q7kNvwEb_u9k&_nc_oc=Adr4aMbxNn8hBwqo1DoIkYtICF7ANZVqzvtVwcbfAZ_3-X3l18jaok4LWS0IEza7F5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJERKN_vivAKXDtNsqZZNR77d3T41pGaXrT0-3eaVuVNQ&oe=6ABA59FD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vi6KwIpCbQQ7kNvwG-5Yza&_nc_oc=Adoula_2FFJRDv6SEMGRFGwtg7n9h--FdrkM3ouWOqE22sGMxzhGrZ-dP1qYYxMYxys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFp9P8R8TxsZvCFO3VOZb0pUHJavwvfxab620YFOa-ig&oe=6ABA6213"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTV4S27woUQQ7kNvwFoNCrS&_nc_oc=AdrurNLTYPN3ITAcnbdDNFZ2m9PGrP06-o1wABRRURttA7wBgzxNWCexSIhZIRh7vgo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6RlJJFGDaubgiZTTUg73eB-jf5_IJgRXma2jST7fOaA&oe=6ABA84B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ54QdwkZcsQ7kNvwE3qvPD&_nc_oc=AdqEmpVVY525F63HsKz4Gb-wDK7dc8uP2NS5l2YS8eK9FeiwSdMVElZ1YHo8bH1s4W8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtdukbf6A9VA-BjmFep3W9iPwYazr1p96Or3Wux3Uz1Q&oe=6ABA5E1A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22mBNg3Jp4sQ7kNvwFjoiTp&_nc_oc=Adr46esPFuUhhdn9M9ibehVBGZxU7AdsRtgMA1iSbCAmw21DHLDbb0175StlLd5D1zM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLug6q420T4izoOTKIaqRHDSBu8XRqo9kTpkgbbDMLchg&oe=6ABA6BC5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uGf1iq-d-4Q7kNvwHBh8EH&_nc_oc=AdpGj8uRZCjtZwzZr0CMEHm0jf4q8Zklh41NVLAJ_UJSgaJxZPYW5myL2x5L4zMuZ0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw-_3IYb_8b0ys0WyWLxUdjwy5xOV-47O-gliPMHVECA&oe=6ABA638C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculus
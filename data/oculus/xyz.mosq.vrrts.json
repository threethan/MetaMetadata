9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP4KxoXrVTYQ7kNvwH9cUkM&_nc_oc=Adoa1Q8Xsf3oiSIhlqZ3kYwvpBmG1O9X_6pGa3toYc-r5P52DNmplXegxcYFavaIv-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOXtVnWDsUuowvNN8DG6T2wNDtZYYMbYu8Iltk_K61RA&oe=6AB3C27D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6khuFBNgLcQ7kNvwEWdkg8&_nc_oc=AdqAuM4vxHlbTbXtX8Y9MHIF1xEhELmWuWkBUbrwW0UJrDlqhHwKe6wU-pPk6pN28SQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsoky3gLN5lopGS3PeRAMi_VnJJKoCDrOpTzACIncN1Q&oe=6AB3CA93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BchEWdfVHHwQ7kNvwG88elD&_nc_oc=Adr7kbdkQ1EM9ADXMTZN6uH-OfKexUf-_RzbBkiJGpMn2xv9T6tF9RPrVEe2wXCgwCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRdBwdvkHpmwYHT7kUZ_2np_aw1tLO4fancA4-kUwOZA&oe=6AB3ED32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVb6lCLzqEoQ7kNvwHuTbij&_nc_oc=AdrGXVZdQPlgWNNh1r3_QuBVRJ9NtLwzRBj3M0a_fQgyP08XRBcgejQRjx7mEvQGqao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlW_qgMpMMC8w4TAFqQt723uAvlmDwyiZFonHpwI6lMw&oe=6AB3C69A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEVVQV-Azy8Q7kNvwEKG8oR&_nc_oc=AdrWv6KLn2hgdXH-qVfV_SK0-ZADQLOARW54q-hEAlzcjD0iKW-OCibskn-0NAB9K1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG1F4cBq0bWjRTfYB9FQRkBq8GuZc-nRS8_LfUsChvMA&oe=6AB3D445"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZBOoMlwkvQQ7kNvwGvLixE&_nc_oc=AdrLkSeputuXqTfpnf_RfcDD3pTUh1o4hiaWZx3qZehJV-nM1fuf8iBo0dqoA2sgIMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoIxik0NwkRD1tn9TAsh95m_IQsUAmxrDgdWZ8J6RSwA&oe=6AB3CC0C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
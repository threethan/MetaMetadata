9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-_3HBqfZNMQ7kNvwFCQChf&_nc_oc=Adpw9lYtTdGBo4g1Q3R6fuSuFY_35vAwSbCSfnESelw78jtVea3YuwsZu2dnyhUWBPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrT7NSEPGrkYpcjEgTcodZVPvBA5lowoT4EHPNakPbEg&oe=6ABFD83D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRB35yO_FTAQ7kNvwGxRodq&_nc_oc=Adr4qnIZ8LR6fg2jAVF8J94a3U5ZWPVT7aBlnpNbhaZrP9ius1CdKqdZZpUIntaqa3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQDJ-bD7sGGZoENZN9Ou7LA8M4JUN0QQACndMM_8i1_A&oe=6ABFA813"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGS8pdsvL1MQ7kNvwGBtp6t&_nc_oc=Ado1WvUUfP3RAte-EZsXOs4BSBFI_-tebl1PbU8SdcKzErpKyUTPMxHq4WXMiIhHcrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOryASm9XLGzUapzMHPxvYGgRAIgBYdtIbzuLEfjWkiBQ&oe=6ABFCAB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ni3BjdGC4C8Q7kNvwEd-ikr&_nc_oc=AdqrbS7lJgJqXEwIXl33OjUqDFz8ngw93SkL2Yyx3izENYi_SNMUKDO-iRT5c9QHUm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAsK7555TFAHddugw9EQ0UoWSY8i1ezMVpynyXsaV8nA&oe=6ABFDC5A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyxt_3TiPBoQ7kNvwGC-U6Y&_nc_oc=AdotZ-6bm_gPgwuo3-vnMmEMNmPU1zG5SuZsDK_q7uLxt7s0_80LSJqOsoL9epHzdUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJMLg_IioJ6Zo_dMUUHPt7ZGOe-HwJLGvfWBNqqelPiw&oe=6ABFB1C5"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukkuhmGVyRAQ7kNvwF6dwB7&_nc_oc=AdoQKdGkxyoBr2cQjleATI7x7HV8O7ps98VL7IjOnxozP0xbmYttmsbp8Cf5wOhOZ4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtipeUe7jSqRkinO2X3AlyU1eIhWp6BRP3MsHvv4WHmQ&oe=6ABFA98C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculus
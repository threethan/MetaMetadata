9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9s6TX3_kL4Q7kNvwG_nsU3&_nc_oc=Adozetr-4_swlqgK-K-igXoS83wV_5OIBYaUw4uc1cY5Od42ihB-s9h35fACP98qUhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqvRPOgWa5t5O-zdlOEcJ8Dy9VMLSoqbu6cKUuWhkrkA&oe=6A7F067D"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh1Hx572e6wQ7kNvwHa61Fl&_nc_oc=AdrLKLrYCmw8Ts82nP-GuchNS-EUjPKtejAEn2_2-89JXh8K5ZHTe59Ho2ZHggnc1Yo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7HyyxClf5-Xe2w5-2759yntUDI15NfBKsPomupPL34A&oe=6A7F0E93"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImiT9qwr5rwQ7kNvwH4xgIL&_nc_oc=AdoykLspvsMzbPSdJMCaGJFbhd-PfUXmDNgb2Z_n7m3YwJ4kBjt8Q_u2IgDzaOkEnj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBpjqC41dlsGmM6f-MTCuVuuaOnPR5C2b_c2iFbfKkkQ&oe=6A7EF8F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ5GiNhVyXkQ7kNvwH92Nls&_nc_oc=AdqQ9WDY9PlrqARmmzYThjnG7wbD9kmoJ51wc02WCA-fx_8F-eWwKwWh7g1Q_W-GJ6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyD3uN5geDO6oun45zdSpSa95HiQ-YlX_Zfm4F6jjkhg&oe=6A7F0A9A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJcQHXt64koQ7kNvwH7RbrM&_nc_oc=Adrg5qPSd30UuCsW5IWD25eYJZzRfu-4AqbDYR05_7CMfHCK1k_7I1TYg6iCjRLq8eI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpbzu_gjOvOE46nATjSW1Wu0lSddHsfHivEuyCYmNdDg&oe=6A7F1845"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTm38Tobvu0Q7kNvwE8r2uu&_nc_oc=Adp_aHz0r5X499bZzjJuWWF0CdlYk5kPLcYIFLCS8aQ_6ndGigkMG2mZ8nh7Z8Ym9Tw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAxug3WhP2bQd25PGT04HlQTPe5R86mzc648DQExFTGg&oe=6A7F100C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculus
9224115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXaaJxT036YQ7kNvwFaQXTV&_nc_oc=AdpHAj4AZUz8KF8nhZBwIPLLhe9utm6QjVmo_yH8nQZXi5txsTfz-aOKezJ_oZ5XyDc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GHYcQ1CqmmWefboCLeEz7M8_-awA2rh4GIRjh8kDKLw&oe=6A3024BD"}, {"file_name": "20210525-021212.png", "id": "208898750900245", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001711_208898754233578_1590425003260610296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeiI7fOgW0EQ7kNvwFYUI56&_nc_oc=AdrorvS4XWULVO3Rl39GDVcSrMDKb2aN9POBKohdFFewn7IDM4tyxMXDteTGM3om9eY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--qVP_KnbThUCMfI26e5CNhhCP7IaM6eAIHVIURdu29w&oe=6A2FF493"}, {"file_name": "20210525-014936.png", "id": "490029918982047", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982562_490029922315380_2472132374884165007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrEQGpOkwHIQ7kNvwGLmKz4&_nc_oc=AdrJeURHkTjYYcl9iz9omA7vDlt8UMc7gJnUfL1MtgIUtTRBp0g3Ave2rOxe2imqyI0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F0DMMn_7fMLUEYbCb93OS_tpHCK8PN6xShPyynQXnMw&oe=6A301732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8 2021-05-29 23.06.46.png", "id": "873940063188913", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974479_873940066522246_2661076465911733640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TMRpuNIaG4Q7kNvwFrQLuA&_nc_oc=AdoOGe8ckV2gxD3ccITjIzwmHWBx8m9OjNK8P_xWZZ6dbPnk9RQLcrkxzy1b05ziBAA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-zlo8ZncoyLibBWVY3XkMmg0x22STKzo2EzG8c3YYwQ&oe=6A2FF09A"}, "display_name": "Playing VR with Girl Friend", "keywords": [], "long_description": "[Description]\nEnjoy the conversation with your girl friend!\nThis is a strategy game.\nPlace the units in the map using your hand.\nDestory the enemy's Base to win!\nDefeat the enemies before they destroy your Base.\n\n[How to Play]\nUse your hand or a controller to play!\nPress the button, pick up the units and release them in the map!\nThe left and right sticks allow you to move the user's position slightly.\n\n[Type of Units]\n-Base\nThis is the Base.\nBuild your Base stronger!!\n\n-Fighter\nA common flying unit.\nGround & Air Attack.\n\n-Factory\nA factory unit.\nIt generates cash.\n\n-Bomber\nA flying unit skilled for\nbombing and ground attack.\n\n-Tank\nAn anti-ground unit.\nAttacks with rapid fire.\n\n-Anti-aircraft Artillery\nA placement unit using missles.\nEffective to flying units.\n\n-Sheild\nA placement unit for defense.\nIt has high durability.\n", "short_description": "Let's play a VR video game with your girl friend!\nThis time it's a strategy game.\nPick up the units and release them in the map.\nThe units will start fighting automatically."}, {"images": {"nodes": [{"file_name": "Art_1008x1440.png", "id": "4244000545622202", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974522_4244000548955535_6121386002098751284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQ4C5vaDi5QQ7kNvwGdPXPH&_nc_oc=Adq_nJ8Qa8SdfMVbc0y8YJfWcloa9g8cvscpv7mLUGhZ8AcwKxfiRNicxnJZtb2WAe0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ECexPqOJAeWE2pNzed98oVkdqki___fHl0wYAqzbRSA&oe=6A2FFE45"}, {"file_name": "Art_2560x1440.png", "id": "3609745079249612", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974800_3609745082582945_8822499596742085698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gh_WvjovUUQ7kNvwF6aVjT&_nc_oc=AdrX3LYxPd79MCMQWMJf6Fud1gwzne4b0cAUdKBW2vkdVHq7Y-MK0G1_JJmdxQ7vLxY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8505x-3ep5E7BBpVXyr-2xKZ1P4igLxj6c1-0h_aH_jQ&oe=6A2FF60C"}, {"file_name": "Icon_512x512_JP.png", "id": "1572766619588975", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculus
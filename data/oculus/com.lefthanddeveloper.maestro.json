771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Of3_75qwkucQ7kNvwGmZVbK&_nc_oc=AdqI_wMxY4fgvGG6NW0Ue7LvEAufA_f0Vxuf0wqVyIolDGbMKDtWmKNsFnPehwH52Pw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPgD4IoM2jT9kTSiw6Upy_9t_aRHVyntg1RCW4wMNc2Q&oe=6A82F893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nkOvEcO-ssQ7kNvwFMvE6V&_nc_oc=Adr11tBYrFKl7CGTTeeivgk3ZJf7iGH257aTYa8W_qKfkO1ZEssKoDES9-gjsYaLtmE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnZmPv3gqDPF2a0rM3Y2EUQdq2oFJIa5GrdVAY_XV7vg&oe=6A831688"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W85yfBbQ9eMayAFARDxqwywHG_qa6eSY6SfNwW8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "c
=6ABFD574"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SL4jnMw_dsQ7kNvwHJOGN3&_nc_oc=AdovXQzDBHUyYJNBbcwAjL4_ywRM-7WlpCim5BqRd-G6FHAfQEqfdxebH2ogJBWrqgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORywa_bAMs8c389PQn_GqzeQw1Yk16oXZaSnJiN5GjuA&oe=6ABFD5D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbWJo_kjxKgQ7kNvwFwqkVy&_nc_oc=Adqo8mK6JmbX2PbYrqsErURVr2s3rC-bNaT_lr0Htd5wChnvGWYAZ8-TMneuqvtPiFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-z6Nw85vgmn6PdRZUk7XVlqmq31C0nofMe3ITX7rKMA&oe=6ABFBB88"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W85yfBbQ9eMayAFARDxqwywHG_qa6eSY6SfNwW8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Lefthand
4qheSXTifY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCKDmbBRiwQosx_CTw8TkvY2ko-qxwJmL-Ii_aepU8Qg&oe=6AF5E2F4"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd5IZMVpq70Q7kNvwHuu-kO&_nc_oc=AdpacKXJxDjqk-idZs6QPqmbhKkcbMQfZRth4mVKum0WVIQhcLUMMZ02gKiY5XuWpQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl4HIBJT-QJPGOmyHnjjiV5wI9rJlzRkWjvFFwnfE7xA&oe=6AF5E353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFxAY6s8emsQ7kNvwFFERur&_nc_oc=AdqT6RjdHzyt3dmB3-HLgSdlIgSuPyP24TFzKoLBNlo0iJVLQQdKlaA5B65AKcZdWbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGyk6uolyTBPo1kt-q7zkvjlKVGjta53D0nCqG6quZOg&oe=6AF5C908"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
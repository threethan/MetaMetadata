uhzRoOj1fQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbTU4gmLlUEzNMz2qzm-CrwhE_HAKVGH8mKlinjS2ClA&oe=6AF33FF4"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_j5vkgFBaUQ7kNvwHz0A-p&_nc_oc=Adpw6mLBgSwdL_CkbVbFLYqe0DZeOH8nOdgyqRL5w0Ddzhbsx-eZHMdjSgVqHsBqK4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMhYdgMlC84haO7LBl4E7FQJMWaTJjIR47T3jgGVIcag&oe=6AF34053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVBe0ZIAaF8Q7kNvwH37Z6P&_nc_oc=Adq_KjO0un1L96CkS0w8eAlc8OZ_OUZ1bQQ8FTGoiCLr5yzmZDGBOVOX3UWHsk52YlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc8nhr0br1g2786eQGdmHnLh5JbXRb6viCzbses-gRfA&oe=6AF32608"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
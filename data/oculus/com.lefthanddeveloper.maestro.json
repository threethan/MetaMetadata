awDQcXAEM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPNR6iSPx5oL6ItDqgZq_Mf-nhMB5brDWcpygnX5aybw&oe=6AF49174"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_j5vkgFBaUQ7kNvwG0M5Zu&_nc_oc=AdqpMdDeLG0uE3qmtHJMmcBlRyN1y9Kp9jFhgHdRRnCUd9Uh9c3dKQJD8yk52-2dV0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgazvKtAu5Xrlmh_ptl0oCMau0V5dWMRT0oXq6ZHxA3g&oe=6AF491D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVBe0ZIAaF8Q7kNvwFn4z5f&_nc_oc=AdrtNDiJmbuuIM4eJPEF5k-JY-rD0cMw2qfqZHPxvR1FoHGRNoeBdmQy8Im9P5RWLOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKL4ZSTq7bksuFVYZ4gHohHPwXPuNitN9gbyain9kp2w&oe=6AF47788"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
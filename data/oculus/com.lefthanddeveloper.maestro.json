atiykbPsXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMpUkR_dgIqXqzRM0JEcULNwhrqfAMYGCiNnTCnahauA&oe=6AE0CAF4"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfIxxuOsHNEQ7kNvwExmMpY&_nc_oc=Ado2FEu2Sjh8UWnm5J2dkz-JDSskAYL_iVBWTqiHgAyGDq0kBDCPEYTHbmm-OMQ5Xi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOngiQfzR8LpyjlzKJBwtNCgiQRgchD9GpREsx_-oE8KA&oe=6AE0CB53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8X5vvuj2V0Q7kNvwExiVb_&_nc_oc=AdrceD2hBIr1s4Q2zTfiXwYFiYN-BrYpQIZttnth1CgRgCWdJCT-VtYys-MdxW_k-Bw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPipKVqe_RrEB8v2x1_1lXbeFvonC-hnN_lDI-zeRF1uQ&oe=6AE0B108"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
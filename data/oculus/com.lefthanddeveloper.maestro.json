d37Qnx6z_E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxn1iapzE0bM5Wnsix3-dT9qR4PWQI00a2bJY8Riuydw&oe=6AD0F8F4"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-WV8C59u1cQ7kNvwEMk4eC&_nc_oc=AdpiK00qqUFO3YG4Zduw5H-5IpKLMNZm_KFowiz8qW7uWMudNSn13tGkCQmzX7yI3SM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORh8Hdh7nvJfP9wtqMZ59g5c6j_TVOB0Mni-d7twnoXw&oe=6AD0F953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSFjP8SXEaYQ7kNvwHgoUqi&_nc_oc=AdoOayt2yYc1v7BmAAhFrWw2UXOrjc1Kpc2SY3gqH0BrVwzZWJdZXt99pEPh5ncOTb4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQT5YARadQvTVsBe2QSnHsZ9N1D42wZJzanP-sDixb5A&oe=6AD0DF08"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
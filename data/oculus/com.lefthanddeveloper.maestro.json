=6A941BB4"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=812QCSJyCz0Q7kNvwFNA31P&_nc_oc=AdqHLRmWM7fU0IcGLM7_eI0Y9AjMH0AwJmOX1BashSiijLy0uTOANG9a9b17LsXlPJA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPSQqh47u0hbyvycZr0oVf1cn0GAFdZDS-5o64wIkzAg&oe=6A941C13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PEgkm1ggBgQ7kNvwGuV8pc&_nc_oc=AdrWIWelEaH5c2td-1XjTJQwtkZEoJswhszxBcfzTp9lUIKKdGiRJ6V6wn6JTcQAyzE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcyPf4xwgHYJoxL-32KF8CipSVB3aLgYQ-0b8Gd2w4fg&oe=6A9401C8"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W85yfBbQ9eMayAFARDxqwywHG_qa6eSY6SfNwW8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Lefthand
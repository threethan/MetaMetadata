ElmFM8VMHn57ujZe3x0dypNyoKCZoFQ&oe=69A028B7"}, {"file_name": "Screenshot_4.png", "id": "1303611317264708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003230_1303611320598041_3465733085901840330_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6rEP5P-NT4Q7kNvwHfIRHU&_nc_oc=AdkTTmLKBwSsDjL5Tdl8z4GF0VKDWUktI5Tzvf-oY4W60qTWbSOQDQc4xG1wsJjLMWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCdZ7Q9doctnMXWfGXNPeFZHz_lS3bmA83dByCo7DPcg&oe=69A03634"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCoQEiI8T-4Q7kNvwFxB6dK&_nc_oc=AdnBgKYuzBmFDHcWw8Ze3QMOTjN8QYjRpAdiAl6yjhNKLBuBOmZrSLhsp9-NfAZMMFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSNmPPnpPtsB45NAbr4rWyX4JcaMwlDRrSqXtYVXdLfQ&oe=69A03693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svgqJheq6p4Q7kNvwE6rdYM&_nc_oc=AdkTAZket2uelEwwUAXXijJfLTQFFLg0rF334F523SkCN5L9m6IHp8T_nc9e6mgGipI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvxIniSdYgxQ2N340F9jXKePSILm2abRpkE0XnbB5wmYQ&oe=69A05488"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W85yfBbQ9eMayAFARDxqwywHG_qa6eSY6SfNwW8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "800155698254750"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "510257978015046"}]}, "baseline_offer": {"id": "510257978015046"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1719878054, "status": "PUBLISHED", "id": "510257978015046"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7934086813296961", "version": "0.1.5"}, "id": "336963871997076", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6649759941729661", "is_concept": false, "latest_released_binary": {"__typename": "Androi
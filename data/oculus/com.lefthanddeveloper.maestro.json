zYPBtif-PI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_q47yeeYRqbAOeIDZXFU8_H3xu-5nRwwGWgJBKeNnMA&oe=6AEB56F4"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMYEWy-gd7AQ7kNvwF6GBNe&_nc_oc=AdoH4Kv4Ktarioe-5jKZfs_EP49gpo3zyOYNCg-6rKNRfBroRBnrlCdd_Mst6mXGMMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA-ISHitd_5tZiGYY-mNNZppcmBJaNtpcagI8MGX61bQ&oe=6AEB5753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yHyOtUpdF0Q7kNvwFMJxZ8&_nc_oc=AdrOqiKskKW3n-mFpipMHqB3ET0TQbi5vnE-pfJ-J4cQqbj4KYEmt0KeTr1Ju9pLhP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi3Pn_ZdNxXCJfhpEu7lLFPxJqemZeQcgCTIbCvY5JXQ&oe=6AEB3D08"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
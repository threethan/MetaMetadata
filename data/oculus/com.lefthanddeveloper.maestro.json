771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6duMGre-8gMQ7kNvwEmwe6m&_nc_oc=AdqxUf1n33k_2Ia8YfAepP473CrURi3JF5bd79yrbYGicQBH0nEylzTZpeFpRfq0404&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyzKTU0wtHZwhkb1qvMgGNxL_Lms_LhEaRaYiC6a9sUQ&oe=6A58C893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxK5JxSNX8IQ7kNvwEKHeTr&_nc_oc=AdoXcMWwopKFlYNP0goVgEx7Z0d7BWhCLqTzYwxWimvU7H7Nut_4UI0wEY77o8qbMEE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXkIdJFzGb4JHsHEF1vI6k2avU7obj_6aspKACW3kn6g&oe=6A58E688"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W85yfBbQ9eMayAFARDxqwywHG_qa6eSY6SfNwW8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "c
e_rfk8wen0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmM0gda9VFCf3oByEzjrEd3v-KiPRhxmAzd6rWu-LGXw&oe=6AEF4B74"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-omgPh01D_kQ7kNvwFn9wQ7&_nc_oc=AdqrAcnHsqDVK21yCci_NRhe2EvmRArIlyxxX4fI3FzeUwm12bI8cDx21kmbyMcwXAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkZxx_l1kTw5K4LSugLFSddxw8zD1JH6rdbhsuLvcbCQ&oe=6AEF4BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxqAU7M_8YkQ7kNvwH-GHM6&_nc_oc=AdovHRbJVJOtJ3UBlycWol_ceuA6Ub0c77UYnzltTaTlGcAwl2eMHVC2PuugXJwjT74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL6E4yMfQWbS1-rFNZIyBu6o03y-eegj3-9tA3SGhtxA&oe=6AEF3188"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
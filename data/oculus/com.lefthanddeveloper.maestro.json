L-ZvzOX9ys&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXJT6bUsBW0DBeTi9YkmH1jNyMluwh61x5Wo-X9fkSkQ&oe=6AE8B3F4"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EynSmbfwTpsQ7kNvwFp8m3f&_nc_oc=AdosbpG92FzFQ2DJJGDFRn9cMddZ8-g0AQc4kKdu1jb5CzXTzPswgj9ZV6J4VlQZJBA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUiRg02It4ZO39euMvVRzRsV4hz-hm8gMAxrMuTGMtEQ&oe=6AE8B453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viEGIQho8ZQQ7kNvwFeqHxW&_nc_oc=AdoXIDJRQ7wLYT1gBlh5uCeJ_fb7_0n_nyTRyFMRFC8nv6gRhoh7d5cKMrsrRCde4U0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKpdea6N57Tg4-I19GmYV5fI3sBGSkE1bKXuxi4VHuRQ&oe=6AE89A08"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
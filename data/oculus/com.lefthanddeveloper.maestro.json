_nc_oc=AdommmsJKh0Fe57PieBPAoTl1y8tw5kBi_Tlv8_JBY88XW5so_n9_OqfMweJsOG-yh0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Dy1aOfE8SaXCTZ1TqzkKOlAQBTM_UXdigk-BYZShigg&oe=69EF5093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_TU07pdiocQ7kNvwEDE2qH&_nc_oc=Adr99ojJuLO2em6n87g8afdmsgEazQn99_Ua-xpkwuV1fpyfa0yHXuWThfNk91JvNV0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0azJxZKard9iKIIqWgOgxHW8I965a6UPO4Hswf0QnbgQ&oe=69EF6E88"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W85yfBbQ9eMayAFARDxqwywHG_qa6eSY6SfNwW8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_
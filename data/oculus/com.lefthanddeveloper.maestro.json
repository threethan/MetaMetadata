MpHiCYHkxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvooomi6r_IB-GAO-XKxbraRu7r0wV29gOeAblUPfAXg&oe=6AF1EE74"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_j5vkgFBaUQ7kNvwGmuovu&_nc_oc=AdqjKbiAG5zRRDwGSdzvFjNUSNL-_Ln3_E8iNoHpHgzp8eW1VLt6LM_QRs-drrLvD6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvfvycD4uTKZhOhiDzC3RwB3TC4G1RNtKTDlXSsGxC1w&oe=6AF1EED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVBe0ZIAaF8Q7kNvwEF3CH5&_nc_oc=Adr1vXkpJ7w7OQxlUkXAtskyDCfcMouEIOFCJ4VNqAVWHKjVPSgu85DfJoQbl9keeUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiaT4mcq3mkgb3O4KzG6fFZyor3veKkp2wG92Y2lYvAQ&oe=6AF1D488"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W
E_9Y-KBwDLsEBzRDmf-YBX7D3XaD5Rw&oe=69A6C037"}, {"file_name": "Screenshot_4.png", "id": "1303611317264708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003230_1303611320598041_3465733085901840330_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sX7dbZv_J4Q7kNvwF7z0pD&_nc_oc=AdkV5Vsl23l8xOZ50jYM6HzCX2w9ysPeP_soW1fdeTnqMckyWvoNverVPPIZGu18Knk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCvz44WtrSiyJ8LtZUsFnllAcADOTFGS5A7PKPYCmQcw&oe=69A6CDB4"}, {"file_name": "Screenshot_5.png", "id": "1216829746337100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86652082_1216829749670433_7322505928456726581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQf4_LwleYAQ7kNvwHR3xSA&_nc_oc=AdmMTTfVrXr62SFVXYhEMuUEnUFXnjB5VwhGSoLhai_Cpu-SXmJEUjndcEZp6OVqRmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvlYdFaYXZLT5qEp6d2Z_udpQu9NH6UIgsHgrQSllxicg&oe=69A6CE13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_4.png", "id": "801734578759872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65229464_801734582093205_3429637741390320800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrQ_LbBFfdUQ7kNvwGnZQyP&_nc_oc=AdnmxtJmkly8ZmeNKW36n2gDm7-T-StN3SK5SxitDT3WSyhr7CvA9X05Fy73pw6cZUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMwJHlyULujALlG0aHGU9L4G3qyMXnSFTrdfJf5D2XLw&oe=69A6EC08"}, "display_name": "Maestro", "keywords": [], "long_description": "Immerse yourself in the world of music with Maestro, a groundbreaking VR music player designed exclusively for Meta Quest. Unlike traditional music players, Maestro transforms your listening experience into an interactive journey where your hands control the beat.\n\nUsing either hand-tracking or controllers, Maestro allows you to manipulate the speed of your music playback with simple hand movements. Speed up the tempo by moving your hands faster or slow it down with gentle motions. The power of music is literally in your hands!", "short_description": "Experience music like never before with Maestro on Meta Quest! Use hand-tracking to control the playback speed of your favorite tunes, transforming listening into an interactive and immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EXl-W85yfBbQ9eMayAFARDxqwywHG_qa6eSY6SfNwW8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://www.youtube.com/@lefthanddeveloper1522", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "800155698254750"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "510257978015046"}]}, "baseline_offer": {"id": "510257978015046"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1719878054, "status": "PUBLISHED", "id": "510257978015046"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7934086813296961", "version": "0.1.5"}, "id": "336963871997076", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6649759941729661", "is_concept": false, "latest_released_binary": {"__typename": "Androi
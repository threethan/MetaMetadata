25/491824082_1288443943393586_7134963771411609571_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYDEsRxFmksQ7kNvwGVuoGA&_nc_oc=AdrJqjoTM0XwlaKTZajXRrwiWezJxDJa9BOQrupE4_IPW89iZtWr6mQsqOMBpLyvceU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzFMYLmVMeoOTMQTWcoBE4T6lZbzOQrzVLxZkC1mIZQA&oe=6A621B4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2757444434617969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828008_2757444441284635_1251445495212775374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juDpj53W5GsQ7kNvwGlS2Nk&_nc_oc=AdrTk0eyiJO8hq_6DsW0IaGw-_eAhNpfRmW5bHYoxbLNGmT-AdsWj6KmX4vQ5u0Fnp8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_x13vhYU4KAIP-ZrC6lK_SpuLah-VjNKTaEGZVl9nVw&oe=6A6224DE"}, "display_name": "Ruckus: Boxing Ball VR", "keywords": ["boxing", "fight", "dodgeball", "rageball", "bladeball"], "long_description": "Rage Ball meets Boxing!\n\nPunch the ball at every player in the arena. They punch it back \u2014 or they're knocked out. Most knockouts wins. Become King of the Arena.\n\nGet ready to sweat, scream, compete!\n\n{1003646162126954}\n\n**RUCKUS** is a SILLY, CHAOTIC and **SKILL-BASED** free multiplayer VR game where you use your arms to move and punch the ball to knock out other players.\n\n", "short_description": "Rage Ball meets Boxing!\n\nPunch the ball at every player in the arena. They punch it back \u2014 or they're knocked out. Most knockouts wins. Become King of the Arena.\n\nGet ready to sweat, scream, compete!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": null, "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
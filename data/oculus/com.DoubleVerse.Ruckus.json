25/491824082_1288443943393586_7134963771411609571_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n3mwLKqmqgQ7kNvwE7xfmP&_nc_oc=AdqL2deKSzFvZaqLGIne0P_Ojmsp5-LBOAuCuJTDqup0MYO7P4FzyXmuHJew-gBKJ10&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjTYaORKoxXstzRAVqvRIQK_x1Dioqvar9q-1Mc_x5zA&oe=6A9747CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2757444434617969", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491828008_2757444441284635_1251445495212775374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOshNVBo40kQ7kNvwHm2a5Y&_nc_oc=Adqtvgn3qb7oiQrIgWXJbOQyzloCczbeKPFZGD7RPhsuj4PRN0R2R0Eq1SMjVjZ1jIE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUEYZyRuoyLPeVvxqeADJCLmSANThhD_WA_mLQaNQ3sQ&oe=6A97515E"}, "display_name": "Ruckus: Boxing Ball VR", "keywords": ["boxing", "fight", "dodgeball", "rageball", "bladeball"], "long_description": "Rage Ball meets Boxing!\n\nPunch the ball at every player in the arena. They punch it back \u2014 or they're knocked out. Most knockouts wins. Become King of the Arena.\n\nGet ready to sweat, scream, compete!\n\n{1003646162126954}\n\n**RUCKUS** is a SILLY, CHAOTIC and **SKILL-BASED** free multiplayer VR game where you use your arms to move and punch the ball to knock out other players.\n\n", "short_description": "Rage Ball meets Boxing!\n\nPunch the ball at every player in the arena. They punch it back \u2014 or they're knocked out. Most knockouts wins. Become King of the Arena.\n\nGet ready to sweat, scream, compete!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": null, "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
25/491824082_1288443943393586_7134963771411609571_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_BW-HIKThgQ7kNvwFNxfz8&_nc_oc=Adr_X96-jy4jyoNsujETwYBhxyqLVOpnZIv6wqZGKlyvPr91ZKgyvGsYbURAOF8Tm00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XktDf3jUvRjcPwWJiJyBoBT6gSEmJrXguSc9ENGAmDQ&oe=6A35484E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2757444434617969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828008_2757444441284635_1251445495212775374_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOKXYkE5CskQ7kNvwFOH4Vb&_nc_oc=AdrSo3K3aJoE9uHqD_1jFXQSZGcLXDrHlUUkENUVoirpkzll7Ajpv5QpDWjmSRob4Fg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8pm7rVtY2rnPdiEodNYyCdKeLMkCZoG5xRgFPS34uPQ&oe=6A3551DE"}, "display_name": "Ruckus: Boxing Ball VR", "keywords": ["boxing", "fight", "dodgeball", "rageball", "bladeball"], "long_description": "Boxing meets dodgeball!\n\nPunch the ball at every player in the arena. They punch it back \u2014 or they're knocked out. Most knockouts wins. Become King of the Arena.\n\nGet ready to sweat, scream, compete!\n\n{1003646162126954}\n\n**RUCKUS** is a SILLY, CHAOTIC and **SKILL-BASED** free multiplayer VR game where you use your arms to move and punch the ball to knock out other players.\n\n", "short_description": "Punch the ball at every player in the arena. They punch it back \u2014 or they're knocked out. Most knockouts wins. Become King of the Arena.\n\nGet ready to sweat, scream, compete!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-minigames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": null, "website_url": "https://boxing-minigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765422
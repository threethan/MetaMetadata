c=AdqN4SSkeqthiyOhuT_gPZ4kSvsAhApKX-YspXQzUGk__alvsYyzZbdiQ2xu8ZZyqVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG38K4g9HdGLTHo2I7QQEmKaH32Tg_hw1SVHgY3M8jDw&oe=6B0069C0"}, {"file_name": "Screenshot (2).png", "id": "2405864629843551", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_2405864636510217_8661711515329381756_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5b2xPHtHgYQ7kNvwH52cQQ&_nc_oc=Adok5HrAKUJJp6vA6R0fQ7viVvf77Z2M6ItFEGqgqWdPkxOhnxJZ9CnDiIgcOV9eKWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9QmArWFRBAfgdbuzfjqo4WcMtXPrxIyrRrX69V3tHrw&oe=6B008840"}, {"file_name": "Screenshot (3).png", "id": "883047010831080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_883047014164413_7626733331377568725_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4QxemC1nsIQ7kNvwHWsS2X&_nc_oc=AdqjlNpP26SNsHdzmiWW7B7Y1kPeQZRiLHEIhxGJBpTTMv5JCdEzapaSJ5z52AV-Plk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqjhktSmq3OBJAFW8s7cCcmvqfsjBLfwI4j4sceebeyA&oe=6B005E36"}, {"file_name": "Screenshot (4).png", "id": "3755343124775189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820496_3755343128108522_7928250503930238696_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqjVCtZmRGAQ7kNvwGsv6Hz&_nc_oc=AdpMI9oEMxq0wR0WfgNUzLoj5_YQh8WB5H3qxTGKkq7WbQAbNXYYab4RMo7SCQ4Qn8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk7Pcm70yrrdJXH5C_mxx8udc3T6cG2ix9gYwxRa4yyQ&oe=6B0081B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey", "keywords": ["gorilla", "animal", "free", "parkour", "platform"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? **YES**. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n**Avoid the Ouchies**\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n**Climb with the Tribe**\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n**The Tower Never Ends**\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.\n\nDiscord: discord.gg/liminagames", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mode
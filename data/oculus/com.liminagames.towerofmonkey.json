=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXEioQ0MPBdzq2k5Wts-sQrGwO3gBURoxgC1a4kzQW_Q&oe=6AE74380"}, {"file_name": "Screenshot (3).png", "id": "883047010831080", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819845_883047014164413_7626733331377568725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaPqgviNk-IQ7kNvwF-wB84&_nc_oc=Adq0md_DeYALvytZVgDi1Hcf735g8QAP_v8iUD_tyxbD2GpEnJCgYI8TCbLv6Qok-xM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScpLcMUKpqtzUJeQWB5_FI2PrUy6ljuFUr9vby40SLpw&oe=6AE751B6"}, {"file_name": "Screenshot (4).png", "id": "3755343124775189", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820496_3755343128108522_7928250503930238696_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_u58ef6OqEQ7kNvwFyhPUe&_nc_oc=AdrSbI_nXP0rN-0NUZSP0XoNjLDi8GwWQlCFpUuudvEPTHOy2zbKfkDdM0A1H1dH40A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq4DeQgBvVB8i14Ge0Dx7X8_fNf3a-FPDXNQfJtktFNg&oe=6AE73CF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey", "keywords": ["gorilla", "animal", "free", "parkour", "platform"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? **YES**. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n**Avoid the Ouchies**\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n**Climb with the Tribe**\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n**The Tower Never Ends**\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.\n\nDiscord: discord.gg/liminagames", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25559961817023137"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "786491187737291"}]}, "baseline_offer": {"id": "786491187737291"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766996280, "status": "PUBLISHED", "id": "786491187737291"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27956623064023655", "version": "0.6.3"}, "id": "1426356359498439",
c=AdqJGaI-KZRi5v2LSRR0oB9wFcnd2sRV6Sj0j6e7TKx73Q43cW6Mr3DeXTAlwMNsAf4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHENvS8fiwIpTm_M7eCCyUqWlMheLmM3JxXMSXLO4unA&oe=6AFB23C0"}, {"file_name": "Screenshot (2).png", "id": "2405864629843551", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819356_2405864636510217_8661711515329381756_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJf2qRNeBRkQ7kNvwFu_McI&_nc_oc=Adq1vQHLjRhLT1WAme5iLv6zw9Cxru3Ly7RnvLCjWsyMYyuOgg3nHRiiJxRMn0_DJdg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoPOlrAFzdQSeQYD9XcjvePOt52qJh0my4e3V2pgwmJA&oe=6AFB4240"}, {"file_name": "Screenshot (3).png", "id": "883047010831080", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819845_883047014164413_7626733331377568725_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi96BC_lx1gQ7kNvwENS_cQ&_nc_oc=AdqE_hZlGrRCaDHFk87mHkxrWPTL7RBqMnV4m_ZnWu7bRHfU5h__LsakixAHGTL9mxc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQF4uUfPQ11iurqIK4Rn0AkWoraVSFFTriUA3aCQaEPQ&oe=6AFB1836"}, {"file_name": "Screenshot (4).png", "id": "3755343124775189", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820496_3755343128108522_7928250503930238696_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skjrFgmnwWEQ7kNvwFyCoyd&_nc_oc=Adrv292iG_kph3YEYii3xOCbI2psrci0-7BaHmmNE70TKD3yGEbvXioyM_1_H1noOJM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7ivbaaLYvxaclbchyb9cktfGvJiS-Ppnm_kJ_NUPYvQ&oe=6AFB3BB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey", "keywords": ["gorilla", "animal", "free", "parkour", "platform"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? **YES**. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n**Avoid the Ouchies**\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n**Climb with the Tribe**\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n**The Tower Never Ends**\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.\n\nDiscord: discord.gg/liminagames", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mode
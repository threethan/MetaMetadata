c_sid=6e7a0a&_nc_ohc=OplIHogomD4Q7kNvwHCSKEo&_nc_oc=AdrmhrUHcWgvQ0YPRy-oKPY_EvBPeLBnbuIsXIp4mfg6zDhW1CF3neGH5cmf_wRtUu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EFd9GdDAK5p9EyKaJJhFWI1SnfEK8MN2M4QlAPFEKaw&oe=6A2ECE2C"}, {"file_name": "GoR_Screenshot_3.png", "id": "1446890033368178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_1446890036701511_8286296088903947577_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaIHR-3I-74Q7kNvwExtsgk&_nc_oc=AdqiT2vsW34uS31NeO40iJb9AOXHKB9MgWs1Ad2bB2t7EVC7iHNRTfYtcMlyMR4P8Lc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jyo4Khl18IR4RrXNcLnDIYqYVIrq7s_0vqWtlozQtOg&oe=6A2EC74E"}, {"file_name": "GoR_Screenshot_7.png", "id": "856453679910351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240103_856453683243684_1099444270990054844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXhoDRSwP68Q7kNvwE9AJqs&_nc_oc=Adpl8DEUbBmQRAVu-IatSl7ruBPUZtadw6bys_zX7G7j0alaR_nN992_2eCLE-tzq2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6qz9nURGKMiGZpzMorZO1cMgKbLGa91peH-Yvsrkpyw&oe=6A2ECA3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GoR_Quest_CoverLandscape_2560x1440 (2).png", "id": "367027853010393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_367027856343726_4644918959835281840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TJyAFg_KXAQ7kNvwH9Cpqt&_nc_oc=AdrppMg4qrnPlp5xCyDkiTzIpfPiJhuTFl6d_5eiCPbVNlXXa64MK2OZPe6L6DZb8ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83sLaDmg_XbC0FmE4UgPQCzQ-aMlnoDzLqNAQsxFuOaQ&oe=6A2ED036"}, "display_name": "Guardian of Realms", "keywords": ["combat", "sandbox", "modding", "melee", "battle"], "long_description": "Step into a groundbreaking mixed reality combat experience with Guardian of Realms. As the Guardian, you are humanity's last defense against otherworldly warriors and fearsome creatures. Your playspace becomes a battleground where portals open, bringing enemies from another realm into your world. Are you ready to defend it?\n\nSandbox Mode\nCustomize your battles in Sandbox Mode, choosing the type, frequency, and difficulty of enemies. Face off against armorless warriors, duel with powerful foes, or battle monstrous beings with fireball attacks. With modifiers like gravity manipulation and chronokinesis, you can create epic, surreal combat scenarios. Plus, with full mod support, the possibilities are endless.\n\nSurvival Mode\nIn Survival Mode, protect a sacred crystal that holds the fate of the realms. Strategically place the crystal in your room and defend it against waves of enemies. Heal it with your hands if it takes damage, but don't let it shatter\u2014or the world is doomed.\n\nEndless Replayability\nWith mod support and a wide range of customization options, Guardian of Realms offers endless replayability. Every battle is unique, allowing you to create and conquer the most challenging combat scenarios.\n\nGuardian of Realms\u2014Your world, your battlefield. Defend it at all costs.", "short_description": "Defend your world in Guardian of Realms, the ultimate mixed reality combat game. Battle otherworldly foes in your own playspace, customizing epic fights with powerful enemies and wild modifiers. Protect a sacred crystal in Survival Mode or unleash chaos in Sandbox Mode. Your entire real world is the battleground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "
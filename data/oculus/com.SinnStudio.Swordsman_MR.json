68403617897_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2xJ_2CM_sYQ7kNvwF_dZfs&_nc_oc=AdpOBvRoSylFzWA2zJ_lxKpnyozEzXgmTgWtH2klv-VVBY2NHP6VCGCcuDNIvO43yCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrW3wCCfUsPumO-ek74_1hCnLJLNZ-FhM2Sq7SLywcYA&oe=6AFC82EB"}, {"file_name": "GoR_Screenshot_4.png", "id": "488428967420549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_488428970753882_7398902325596969709_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkXrCvqeB1YQ7kNvwEa4lce&_nc_oc=Adr2Sz9XrxSto7hosc2UIl4Yf5rlURSMHgac0vhj0BEPmiP5aFigj6MrzSTvabPt9dM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwDAQcodWttQf8DtzTCl1qO0PnoMhB-aKMYsbk3WO-Tg&oe=6AFC782C"}, {"file_name": "GoR_Screenshot_3.png", "id": "1446890033368178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974775_1446890036701511_8286296088903947577_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keZWyA9BHOwQ7kNvwEBBQ68&_nc_oc=AdrUJUKgbYwT1eSu5x5peNspsRhZXzQmJjPvcrW0EeQ6JNW1tButnAIUO5cV516nz9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz4jhtWdvezksLVRAN4Bv2BegTBiZaYzT4IyokyzwQ1g&oe=6AFC714E"}, {"file_name": "GoR_Screenshot_7.png", "id": "856453679910351", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240103_856453683243684_1099444270990054844_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWemrAd_xyMQ7kNvwFDCd6p&_nc_oc=AdoEGF8cc4BqPoHxrQMZtGhco67I1aLzWCTXHK9VkxtEhwWSSOxE5IKx1vE8tcfUztY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs7J9Q4IcAEXJEVeyRTsmTQvC21EKogrnNW8hoZ8PoYQ&oe=6AFC743C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GoR_Quest_CoverLandscape_2560x1440 (2).png", "id": "367027853010393", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974775_367027856343726_4644918959835281840_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jyo5ytgdV0EQ7kNvwG_IPo5&_nc_oc=AdrXSuadiwslKUvepQ_N24_IGIPdn-7F-r-7pMCWdM6YE2WYy5skuu7-DRReD5nFWJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4JmJdU5xLXfs7KCGFNoGTp5hxQc8z2gRnYV-UIgN7VQ&oe=6AFC7A36"}, "display_name": "Guardian of Realms", "keywords": ["combat", "sandbox", "modding", "melee", "battle"], "long_description": "Step into a groundbreaking mixed reality combat experience with Guardian of Realms. As the Guardian, you are humanity's last defense against otherworldly warriors and fearsome creatures. Your playspace becomes a battleground where portals open, bringing enemies from another realm into your world. Are you ready to defend it?\n\nSandbox Mode\nCustomize your battles in Sandbox Mode, choosing the type, frequency, and difficulty of enemies. Face off against armorless warriors, duel with powerful foes, or battle monstrous beings with fireball attacks. With modifiers like gravity manipulation and chronokinesis, you can create epic, surreal combat scenarios. Plus, with full mod support, the possibilities are endless.\n\nSurvival Mode\nIn Survival Mode, protect a sacred crystal that holds the fate of the realms. Strategically place the crystal in your room and defend it against waves of enemies. Heal it with your hands if it takes damage, but don't let it shatter\u2014or the world is doomed.\n\nEndless Replayability\nWith mod support and a wide range of customization options, Guardian of Realms offers endless replayability. Every battle is unique, allowing you to create and conquer the most challenging combat scenarios.\n\nGuardian of Realms\u2014Your world, your battlefield. Defend it at all costs.", "short_description": "Defend your world in Guardian of Realms, the ultimate mixed reality combat game. Battle otherworldly foes in your own playspace, customizing epic fights with powerful enemies and wild modifiers. Protect a sacred crystal in Survival Mode or unleash chaos in Sandbox Mode. Your entire real world is the battleground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26956653637315058"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1380752389634695"}, {"status": "PUBLISHED", "id": "9450201621715231"}, {"status": "PUBLISHED", "id": "2006666163164199"}, {"status": "PUBLISHED", "id": "1121641806160581"}, {"status": "PUBLISHED", "id": "2094093444361562"}, {"status": "PUBLISHED", "id": "563635682700515"}, {"status": "PUBLISHED", "id": "723988466509975"}]}, "baseline_offer": {"id": "1380752389634695"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746724620, "status": "PUBLISHED", "id": "1380752389634695"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34363481503298864", "version": "1.0"}, "id": "766126105410651", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "A
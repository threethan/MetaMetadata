nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsFqXSpyXkntXCwpeOcDSj--skID5bzp5_SDkoXq-pV-A&oe=69A579EC"}, {"file_name": "GoR_Screenshot_3.png", "id": "1446890033368178", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974775_1446890036701511_8286296088903947577_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn5gDl_4j2wQ7kNvwEFbqiR&_nc_oc=AdlTWodgr-CUV5GylQcaYxAWu58kMXZt0TGFGj6cBEnb3UHR8dfhfVX5Sm53ITQU2mU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftaU9vuDBoyfsfL7HvutjgPG87Gm5zr07wCVWQIy1FpOA&oe=69A5730E"}, {"file_name": "GoR_Screenshot_7.png", "id": "856453679910351", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240103_856453683243684_1099444270990054844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDb6hMYZ6kYQ7kNvwGcKVgc&_nc_oc=Adk8OH-SvLVHek3xbsJAIlN3Zq59yawqN8dUruvBs3BBnAh1yzBU9Hc6mZFavcp9q5w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsQFmNDWERAvCzSNqOLgdnsCJDD1QTvXUPNvzdYjVFAPA&oe=69A575FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GoR_Quest_CoverLandscape_2560x1440 (2).png", "id": "367027853010393", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974775_367027856343726_4644918959835281840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8mXlRpgLDIQ7kNvwFfw8zV&_nc_oc=AdnXH4vrZkz34wVW-jE37paXKqaSqrJfhyWn3Qom9q8w2k6OpqCQFX6JwNrmii0NWmM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuKjiTgE89rh9l-abhmSDEyge3QcYA-9mWj2ZhGl2pHhA&oe=69A57BF6"}, "display_name": "Guardian of Realms", "keywords": ["combat", "sandbox", "modding", "melee", "battle"], "long_description": "Step into a groundbreaking mixed reality combat experience with Guardian of Realms. As the Guardian, you are humanity's last defense against otherworldly warriors and fearsome creatures. Your playspace becomes a battleground where portals open, bringing enemies from another realm into your world. Are you ready to defend it?\n\nSandbox Mode\nCustomize your battles in Sandbox Mode, choosing the type, frequency, and difficulty of enemies. Face off against armorless warriors, duel with powerful foes, or battle monstrous beings with fireball attacks. With modifiers like gravity manipulation and chronokinesis, you can create epic, surreal combat scenarios. Plus, with full mod support, the possibilities are endless.\n\nSurvival Mode\nIn Survival Mode, protect a sacred crystal that holds the fate of the realms. Strategically place the crystal in your room and defend it against waves of enemies. Heal it with your hands if it takes damage, but don't let it shatter\u2014or the world is doomed.\n\nEndless Replayability\nWith mod support and a wide range of customization options, Guardian of Realms offers endless replayability. Every battle is unique, allowing you to create and conquer the most challenging combat scenarios.\n\nGuardian of Realms\u2014Your world, your battlefield. Defend it at all costs.", "short_description": "Defend your world in Guardian of Realms, the ultimate mixed reality combat game. Battle otherworldly foes in your own playspace, customizing epic fights with powerful enemies and wild modifiers. Protect a sacred crystal in Survival Mode or unleash chaos in Sandbox Mode. Your entire real world is the battleground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
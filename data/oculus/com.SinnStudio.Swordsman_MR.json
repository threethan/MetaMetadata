nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLocjqEXNHwXPY_ZCwWwo2fOSFZ8xm6JZihNFxTy3WWQ&oe=69A6CB6C"}, {"file_name": "GoR_Screenshot_3.png", "id": "1446890033368178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_1446890036701511_8286296088903947577_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn5gDl_4j2wQ7kNvwEtHrlV&_nc_oc=AdnVG4heb0wRx82ny1G6hK0-7d1Y06RMd5DxjjiYqfTV_wPLUQcF5xQ6bxIPA24V3_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswHWcTSWC-Fp8nmZW5u28DTUfEqnQQ1eeJh7PMdtC0RA&oe=69A6C48E"}, {"file_name": "GoR_Screenshot_7.png", "id": "856453679910351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240103_856453683243684_1099444270990054844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDjZ1OsWt2UQ7kNvwEB0qVE&_nc_oc=AdmeetydcZ0b5l_7qbNQ9xSJaoPxhB0JT015C2kjDuWpKGvlBjTYjVvPkTv1ObKv55c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfscXqDArbcbLZxKPPoAlyYgM5vV_lH3uyhSq0BiBb0-Xg&oe=69A6C77C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GoR_Quest_CoverLandscape_2560x1440 (2).png", "id": "367027853010393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_367027856343726_4644918959835281840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8mXlRpgLDIQ7kNvwExrWKK&_nc_oc=Adljk6X3F858rfVNBeS6hfQ-mv4gheculxewsOPF49ybj57GL-_rgZr2Ly1FAb8c8qM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvzr9vkZ_NUqHv3OJ1SS1lBtEnEzbEaP6fUC8Ry-CrAhg&oe=69A6CD76"}, "display_name": "Guardian of Realms", "keywords": ["combat", "sandbox", "modding", "melee", "battle"], "long_description": "Step into a groundbreaking mixed reality combat experience with Guardian of Realms. As the Guardian, you are humanity's last defense against otherworldly warriors and fearsome creatures. Your playspace becomes a battleground where portals open, bringing enemies from another realm into your world. Are you ready to defend it?\n\nSandbox Mode\nCustomize your battles in Sandbox Mode, choosing the type, frequency, and difficulty of enemies. Face off against armorless warriors, duel with powerful foes, or battle monstrous beings with fireball attacks. With modifiers like gravity manipulation and chronokinesis, you can create epic, surreal combat scenarios. Plus, with full mod support, the possibilities are endless.\n\nSurvival Mode\nIn Survival Mode, protect a sacred crystal that holds the fate of the realms. Strategically place the crystal in your room and defend it against waves of enemies. Heal it with your hands if it takes damage, but don't let it shatter\u2014or the world is doomed.\n\nEndless Replayability\nWith mod support and a wide range of customization options, Guardian of Realms offers endless replayability. Every battle is unique, allowing you to create and conquer the most challenging combat scenarios.\n\nGuardian of Realms\u2014Your world, your battlefield. Defend it at all costs.", "short_description": "Defend your world in Guardian of Realms, the ultimate mixed reality combat game. Battle otherworldly foes in your own playspace, customizing epic fights with powerful enemies and wild modifiers. Protect a sacred crystal in Survival Mode or unleash chaos in Sandbox Mode. Your entire real world is the battleground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
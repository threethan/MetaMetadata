68403617897_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy_bWP3hUzEQ7kNvwHHsrPx&_nc_oc=AdqwEqDG5FzJBNIAR8VQxzITOOtjfx4OkQU1audkt9_DSu_01my1VF2yeq5uM_2A56k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRR6VBwJZ8dDZNdIEslhZlxNNT8RJ9apuDhbJlXI1Xk1g&oe=6B0C54EB"}, {"file_name": "GoR_Screenshot_4.png", "id": "488428967420549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_488428970753882_7398902325596969709_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t0F9q2NGl0Q7kNvwHin1G5&_nc_oc=AdpazZdNEeoCa7YdlpyQeujmeGOr__ZHyZg94NGQKhPyw99DyLHF38C5l-g3RoARYDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTM_RhRflG-47omlLbFG4yIQkHFSwuZ-hYTi_I9DrQN2g&oe=6B0C4A2C"}, {"file_name": "GoR_Screenshot_3.png", "id": "1446890033368178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974775_1446890036701511_8286296088903947577_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCvsN4ha1REQ7kNvwGI_l6E&_nc_oc=Ado9UxVfHorpxTPjSqrWwMz9yZ3wG2-j3IjW9BbOqzhVLOqsQoO2aekwK3XiEKUopZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgXJSAdSGj40klDBArjwc6O6Gj-Y3T_N-rHl0aQcu6-Q&oe=6B0C7B8E"}, {"file_name": "GoR_Screenshot_7.png", "id": "856453679910351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240103_856453683243684_1099444270990054844_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYvQ1sTfImkQ7kNvwHkMZ2Y&_nc_oc=AdovOyc8P-Eu-MEobu9FgIEWd3LHyLpRSMR41eEhNZ1GVCEBopDKfO2NZZct8ON-eBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1kXytBHmEvAbjHIKdWQLFNk0uhAlsokmgqIQoDwxv9A&oe=6B0C7E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GoR_Quest_CoverLandscape_2560x1440 (2).png", "id": "367027853010393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974775_367027856343726_4644918959835281840_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh-AJCZ5ypoQ7kNvwFooPkP&_nc_oc=AdpeY8yhKEToIfZXoyn-XQpEcnXR7M93cWDeJg2BvBKT2325s54E9sOaXsw-VLRD4GE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTNkSuS-62Du-5GJnDOxtBPRBLvOgH7M7WCgnAJ0kEbA&oe=6B0C4C36"}, "display_name": "Guardian of Realms", "keywords": ["combat", "sandbox", "modding", "melee", "battle"], "long_description": "Step into a groundbreaking mixed reality combat experience with Guardian of Realms. As the Guardian, you are humanity's last defense against otherworldly warriors and fearsome creatures. Your playspace becomes a battleground where portals open, bringing enemies from another realm into your world. Are you ready to defend it?\n\nSandbox Mode\nCustomize your battles in Sandbox Mode, choosing the type, frequency, and difficulty of enemies. Face off against armorless warriors, duel with powerful foes, or battle monstrous beings with fireball attacks. With modifiers like gravity manipulation and chronokinesis, you can create epic, surreal combat scenarios. Plus, with full mod support, the possibilities are endless.\n\nSurvival Mode\nIn Survival Mode, protect a sacred crystal that holds the fate of the realms. Strategically place the crystal in your room and defend it against waves of enemies. Heal it with your hands if it takes damage, but don't let it shatter\u2014or the world is doomed.\n\nEndless Replayability\nWith mod support and a wide range of customization options, Guardian of Realms offers endless replayability. Every battle is unique, allowing you to create and conquer the most challenging combat scenarios.\n\nGuardian of Realms\u2014Your world, your battlefield. Defend it at all costs.", "short_description": "Defend your world in Guardian of Realms, the ultimate mixed reality combat game. Battle otherworldly foes in your own playspace, customizing epic fights with powerful enemies and wild modifiers. Protect a sacred crystal in Survival Mode or unleash chaos in Sandbox Mode. Your entire real world is the battleground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio", "support_website_url": null, "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26956653637315058"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1380752389634695"}, {"status": "PUBLISHED", "id": "9450201621715231"}, {"status": "PUBLISHED", "id": "2006666163164199"}, {"status": "PUBLISHED", "id": "1121641806160581"}, {"status": "PUBLISHED", "id": "2094093444361562"}, {"status": "PUBLISHED", "id": "563635682700515"}, {"status": "PUBLISHED", "id": "723988466509975"}]}, "baseline_offer": {"id": "1380752389634695"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746724620, "status": "PUBLISHED", "id": "1380752389634695"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34363481503298864", "version": "1.0"}, "id": "766126105410651", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "A
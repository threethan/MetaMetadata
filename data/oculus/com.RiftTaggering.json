, {"file_name": "Screenshots 2.png", "id": "716145757730831", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499321757_716145761064164_3118037334709437907_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-hT4NL0E8EQ7kNvwHY8oLE&_nc_oc=AdpVhc_x0NeIBA4PaMYdXLnV8Yu-G9OAS0qU-FSpZfBP4fFJ6OHK4fgFXD5Nj3Mgirw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMbRBEdKh8xCPIzXfRoTEN1iAlkncvXcpFudd9FRgedQ&oe=6B0B1AC0"}, {"file_name": "Screenshots 3.png", "id": "2184946912011778", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499316628_2184946915345111_4985966241605257735_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfodj0BkkqIQ7kNvwFbRumL&_nc_oc=Adr95ft6_sQsZ85bbNNuDJZ5PthnysPbkG_PPhXtiFLETcEAXCwJWQJgv4uTHJFFBdU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXLcDn4X5wnBOzyST_38SpcH-NAlV__jHNF7ZQsghVsA&oe=6B0B3CF2"}, {"file_name": "Screenshots 4.png", "id": "704878675337768", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499335980_704878678671101_6493553801597356852_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fNpNX09vbwQ7kNvwFJDyzH&_nc_oc=AdqhReqHgeqoiIed3piHUL17VspRgho4SrXRF1cWRb6UrzNtKVnzSQKO6Jo4TwPcDWM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYsrsjuZzJp1yLoHpjUg9IFA4b_9ors8VeVr1JwIpk8Q&oe=6B0B2EA3"}, {"file_name": "Screenshots 5.png", "id": "698511592666911", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499347625_698511596000244_6021295984639726420_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=6EuykrxQ19oQ7kNvwEgZTKl&_nc_oc=AdqssB0Qn4no4OMlOlgOtn6_7Nh04v9z7y2Qed6CFQE7KJQvMNccqu9v6mN0kTS7_Is&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrMF0LbeK-32kDrVXfvn6J7fy5mCD8wbL0AiHZtJHLoA&oe=6B0B33FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rift Taggering", "keywords": [], "long_description": "Rift Taggering is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.\n\nWhether you're playing solo or joining friends in multiplayer mode, Rift Taggering offers endless opportunities to sharpen your skills and discover creative ways to traverse each unique map. The game combines the simplicity of tag with immersive VR interactions, making every round a fresh challenge as you adapt to new maps, game modes, and a growing arsenal of moves. With customizable avatars, community events, and constant updates, Evil Monkeys aims to deliver an engaging, ever-evolving VR experience that keeps you coming back for more. Are you ready to become the ultimate Rift Taggering champion?", "short_description": "Rift Taggering is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate Rift Taggering champion!"}]}, "developer_name": "JAYYLLC", "developer_privacy_policy_url": "https://sites.google.com/view/jaydenunblockedgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYYLCC", "support_website_url": null, "website_url": "https://sites.google.com/view/jaydenunblockedgames/websites", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED",
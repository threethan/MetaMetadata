, {"file_name": "Screenshots 2.png", "id": "716145757730831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499321757_716145761064164_3118037334709437907_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bc_CSZVy-UQ7kNvwGAuqg9&_nc_oc=AdqpDAfmGUunpdvxqmZgV0xwu6VWVtSdzfZf8fpA05ZH4u9j5_43p1sch6urTOslRtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbrwpg4BxGpJS1tee6tdFFZViYMo46vW4r-qVJx-7NIw&oe=6B0DBDC0"}, {"file_name": "Screenshots 3.png", "id": "2184946912011778", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499316628_2184946915345111_4985966241605257735_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMxuRRXZf6gQ7kNvwFAKuPB&_nc_oc=Ado23syMrGkqQEPoQBzV5zZOulpRUAYfemH1DAMFxPQWnhmPSZIcJgmj_vLPAwxQfxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjxPqbWWQyU7Xo6kWSyDBrV8xiZLQDMdquNkK57F5w4w&oe=6B0DA7B2"}, {"file_name": "Screenshots 4.png", "id": "704878675337768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499335980_704878678671101_6493553801597356852_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fNpNX09vbwQ7kNvwEP3-sZ&_nc_oc=AdqKBodHsIZpKd2pZlW4uMdr51MtMTNBhBa5sRapRB4pPK9Sy9DlENU0oMsHCT7cy7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSl_ukvscLe45opp_XxypFjbq6qgQWOAJ_V4fpZNS5Amw&oe=6B0DD1A3"}, {"file_name": "Screenshots 5.png", "id": "698511592666911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499347625_698511596000244_6021295984639726420_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=s-FtQe213GcQ7kNvwFDp4Cl&_nc_oc=Adq9uALTwxMSREPvc3JguzgkaFxyfDxCgf1QmsSKAZGz3NQoJTn3etXI_CN6yP6Pu78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQb-5j0DPkmhEUPNcaDP70XPMPQgxO_WTLQkMtxlKF7qQ&oe=6B0D9EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rift Taggering", "keywords": [], "long_description": "Rift Taggering is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.\n\nWhether you're playing solo or joining friends in multiplayer mode, Rift Taggering offers endless opportunities to sharpen your skills and discover creative ways to traverse each unique map. The game combines the simplicity of tag with immersive VR interactions, making every round a fresh challenge as you adapt to new maps, game modes, and a growing arsenal of moves. With customizable avatars, community events, and constant updates, Evil Monkeys aims to deliver an engaging, ever-evolving VR experience that keeps you coming back for more. Are you ready to become the ultimate Rift Taggering champion?", "short_description": "Rift Taggering is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate Rift Taggering champion!"}]}, "developer_name": "JAYYLLC", "developer_privacy_policy_url": "https://sites.google.com/view/jaydenunblockedgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYYLCC", "support_website_url": null, "website_url": "https://sites.google.com/view/jaydenunblockedgames/websites", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED",
, {"file_name": "Screenshots 2.png", "id": "716145757730831", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499321757_716145761064164_3118037334709437907_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4sVJzQKPS4Q7kNvwGNkfbd&_nc_oc=AdrKW7bwzMJJ0IGQJQ_UblpHwnAujuhJvbYLY-c9SQNZDe8vfGoiiXCizyXl8HlbzqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQGPzxQ2QL1ijK5tc49Ph6M3eqeqzfxyLoH76xz2yirA&oe=6AFC6200"}, {"file_name": "Screenshots 3.png", "id": "2184946912011778", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499316628_2184946915345111_4985966241605257735_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwj0agKneDgQ7kNvwF9Excq&_nc_oc=Ado8Vczv6GQFGvAXOMHR3IMe8_yklXJ-3X0HTgHSCCR1TKT7RTk4_APHOmlVn_kBA1A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT9dqf0W497OhlKnCTrxuHHZaMcBHvp5dTijAwal-Awg&oe=6AFC8432"}, {"file_name": "Screenshots 4.png", "id": "704878675337768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499335980_704878678671101_6493553801597356852_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m10vM50njHoQ7kNvwGM5D4C&_nc_oc=AdoVOySzfrqTaLBbt82NsJl5hQsXOeMomn_s2tO3Y8JYd54puN8q8Km_aAlJnvc8zDs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRTA67N8K7eZAuuij81xZrDK4zNYEuKHtXnygLJqMeGw&oe=6AFC75E3"}, {"file_name": "Screenshots 5.png", "id": "698511592666911", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499347625_698511596000244_6021295984639726420_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=oNmyrxovAXkQ7kNvwEO9QZC&_nc_oc=Adq6ek_U1NH_vA30u0lmqfHNCeCSIMOIL4vpix3eYpefxkCIm7xpv1IR11BlUaRtIDY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9K053DdVKLe1L_Us5m-0LxcI9lg6oP-3cRhCoCix2YQ&oe=6AFC7B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rift Taggering", "keywords": [], "long_description": "Rift Taggering is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.\n\nWhether you're playing solo or joining friends in multiplayer mode, Rift Taggering offers endless opportunities to sharpen your skills and discover creative ways to traverse each unique map. The game combines the simplicity of tag with immersive VR interactions, making every round a fresh challenge as you adapt to new maps, game modes, and a growing arsenal of moves. With customizable avatars, community events, and constant updates, Evil Monkeys aims to deliver an engaging, ever-evolving VR experience that keeps you coming back for more. Are you ready to become the ultimate Rift Taggering champion?", "short_description": "Rift Taggering is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate Rift Taggering champion!"}]}, "developer_name": "JAYYLLC", "developer_privacy_policy_url": "https://sites.google.com/view/jaydenunblockedgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYYLCC", "support_website_url": null, "website_url": "https://sites.google.com/view/jaydenunblockedgames/websites", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED",
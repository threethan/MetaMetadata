scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499316628_2184946915345111_4985966241605257735_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meSfmPErwp4Q7kNvwEVC8C7&_nc_oc=AdpavK_mCCzRKTI8XMFF--YjyvmY6bgUWQ8poNaxGbTSSHkBnqYuXTfiUW1tg2SGuPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWD5ZiyBilEirMvDHZZhzQVBXxDOwJDRoQANkyPBNy6w&oe=6A899972"}, {"file_name": "Screenshots 4.png", "id": "704878675337768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499335980_704878678671101_6493553801597356852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEjq4x5OxTwQ7kNvwHevmyk&_nc_oc=AdrbIEByP0bZlJaeN-faorJKMuxvVW6eTIlfN7Y4krgP_bPK72QH7BgI0x6L1qdLaPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHQWcJcb_JkOQR10DG6IVfGzLpdIxNeHwUAu0QMnyaDw&oe=6A898B23"}, {"file_name": "Screenshots 5.png", "id": "698511592666911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499347625_698511596000244_6021295984639726420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=BAtKnp1MPpMQ7kNvwG8J-S1&_nc_oc=AdphdYntr4ONKq_Nn6txeMgzs4ZfoGpZ71ezBP5cN7c8LdMczYswPiI5qzZU3R9Ryew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRyZCDvnY3LcO0diTFuGqgf1er5qwQkkc-SmJENitcEQ&oe=6A89907C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rift Taggering", "keywords": [], "long_description": "Rift Taggering is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.\n\nWhether you're playing solo or joining friends in multiplayer mode, Rift Taggering offers endless opportunities to sharpen your skills and discover creative ways to traverse each unique map. The game combines the simplicity of tag with immersive VR interactions, making every round a fresh challenge as you adapt to new maps, game modes, and a growing arsenal of moves. With customizable avatars, community events, and constant updates, Evil Monkeys aims to deliver an engaging, ever-evolving VR experience that keeps you coming back for more. Are you ready to become the ultimate Rift Taggering champion?", "short_description": "Rift Taggering is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate Rift Taggering champion!"}]}, "developer_name": "JAYYLLC", "developer_privacy_policy_url": "https://sites.google.com/view/jaydenunblockedgames/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYYLCC", "support_website_url": null, "website_url": "https://sites.google.com/view/jaydenunblockedgames/websites", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8620818518043021"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_bina
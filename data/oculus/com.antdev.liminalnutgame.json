1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yjXyICv_fYQ7kNvwEO7wC3&_nc_oc=Adr0OeoxxUgi1GiG7gLEATg2pgT73Bv_NZjlf4haYz1_DgBV4MRVDUn9z5oYpUdHqiM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ECeZXccQuRhABzne1wNSe0c-ACIToPXx5F2S1F6y3mQ&oe=6A1B0285"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNEEyDmnUEsQ7kNvwFJFWX-&_nc_oc=AdrTcJ71sRPzZQWC0g52shw0nmhGoRaL5HBqeYYRQvOYSG_BmE8Y8KQpKeFUIm57yL0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NvJRENk5VWeVhxPfHi4445WdV80yyK09LWIJayObMCw&oe=6A1AFD9A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RO3oZdgZgM0Q7kNvwE55TCn&_nc_oc=AdpKFE28yWrDX6wx3-x2yuSTgeKiEEuwOwiI1ycjltt377UT2u1dPMbz7zQiXWstvLE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yQiUR5jIPhsIeQdKr4i5x06GwSfSxzE5PM00xRVcETw&oe=6A1AFCD9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4LUWG5pR9QQ7kNvwF3kEUp&_nc_oc=Adq--IZFPWGSYMZ68i34Mbu8FTozUzbjbndF8hbFdmhq4SzbfKd93tvUBM2bd0vVoAc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ewkMrHey9kzilSsgQZFvG0PIhGhpDWBlds7IImnTMSw&oe=6A1AF5DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iaBS7e9OhoQ7kNvwFrsVSX&_nc_oc=AdpuZhEk7S_tmCPJK1fO6AWrTLWsasgowdIGVf7_E6cP7EinXOw9Z37cercL7tu9PYs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43ZPO-kAln_B0ml0Ay35N3oOAUWogtEw7RsZ0qKctvUQ&oe=6A1AFE9D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
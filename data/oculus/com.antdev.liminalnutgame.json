1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZcNL5mOub0Q7kNvwHtIZoF&_nc_oc=AdoukJGd0L5BwblhaynLkFcqvKb5k5IKFcun4YmvtrgU3h51m4XRaCE1Ayoap0qbU2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ixgg5D44WI3AUOppi0gdrHbKDo7laAColKeSp0qVALw&oe=6A258E85"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbudBbseCb8Q7kNvwEGh1df&_nc_oc=AdoaKoJfZIHmmoQNiP9Z2T70k-YLwJqGHFNq3En6gdnjxWQ1zNskcXObPo88MUh9nPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UG3SFy3PyhhPO1Cz-hkRcZNW7l4nQkJ5Ps21EW2bXiQ&oe=6A25899A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWv-_nrGtFUQ7kNvwHXPS1q&_nc_oc=AdoKDiEsayEgnEpbAzZyVCKxqnPxKs6RUILwFI7zTQWs6LAu4dGad3Uq-o6ML63xa68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZT7FmPoYntnXevVB-6u3A4CtzdwN1uurTmETYlR66Vw&oe=6A2588D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvyt9iBUnXMQ7kNvwEOgWDX&_nc_oc=AdrVocl0AkfLqGrA3CuRxU8rtI6e-zFtlrs1sq_g-gmo5GbqySrT857VOdyMP0zbVEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Us_F8lxtE-NTNVYlMSOTAmkp2_MaOoGLewCPDFF8jYA&oe=6A2581DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HMap7XCKQwQ7kNvwFeK08s&_nc_oc=AdoVREH-1bY6O8miU39mCQ8-E099QwbnnLU5tCTCSqxudOThStUxz30jVi2WXWuzHjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E-2sLpxpuG9-VWcTS8UbSHiwoHXDvdyO_Ze1PjtRCYg&oe=6A258A9D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
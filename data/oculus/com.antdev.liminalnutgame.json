2.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY_63HqDv-gQ7kNvwFXxbVm&_nc_oc=AdrExyGbP5gHw647rA-PZWvuqgPhIB52eEtqBAP26Kq26Sf66LZ5RSjHTwX52eBhbf4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81q7cDF0Phv2cWY0c2uYZ-3bgKNnjJhJzYc7YN8BEo6w&oe=6A340F05"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUUB0AGZSW4Q7kNvwEEAtIA&_nc_oc=Adp0ADCKvo5pTGueXzXxSMDyFYIfyWtDYjxzjvgwTprC2ug27DYzXI6EBgNhMA6VlbQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DK-RVvSpecb0xVX5fYsq7SWy9nFTk06VX4S4S6yQSfg&oe=6A340A1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKrJDFb9VhYQ7kNvwHoE08o&_nc_oc=AdpmZwJo5mtd8EMwSyO8J2qJDXdwtRs9C2wIolOC73wOvZGAsYiAJL0muE9QLUebEXI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OhPEtCL1ke2icdyK7UTWq0nl_aVL4Sf7jphzqI0fhnw&oe=6A340959"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRURXuwbmR4Q7kNvwHyoahO&_nc_oc=Adp1nbatjD-9hSjphnQCth2Ycp9VJecN6sCEZzQLg0dxrE206r-cX11TwzTfN1Yu4zY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SkC6j2OYqBXxw5nPHAZoOOtRVmAkeCBHZ018BqMlf2g&oe=6A34025F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVWo3ci9sLcQ7kNvwEbMCSW&_nc_oc=Ado5OTuOnc_wZSDDLiDC430-AwnFUiYWdyRnOTfOHW9NOG-cUcOig1o7vKZNzXrVBjU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pEHY1kdU3LPwc5lszM9NosVnsl7nxGO_GpBoQXJoIag&oe=6A340B1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
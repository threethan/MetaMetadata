102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drJOEM4QBCAQ7kNvwGKjGQC&_nc_oc=AdlzYX6syF1NKWUYV6JwfqW9MgaZN1oE23IKatZtL5vKvmddG8Wj01T-Bl2mHxQPyqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv9fT3d89O_Ay73rEU3HkkAgKR3YBUP1cX4pY54PAXbGg&oe=699EDD45"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3ADecwIObUQ7kNvwFg7cvK&_nc_oc=Adm0a_HsAIEm62t0nLnSzqe1K16-LPYs28n6MfkOYxZO__-Ubi-vAFQu8Llug-6JXAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftYKQOQvoTc_ZVfqRUg95-Vn7EtZPuo3YQvb8Izrr0eYA&oe=699ED85A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmde4-495UoQ7kNvwGewZJS&_nc_oc=Adktv4UQCFZED9MngFYOAd7yGb7S4KY0J5H8VlbkwMd8qpaWkufxpHcgaFIbYZAodPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsE1Y74Rw2KyPIpdUNWLszd9l0EKF8wpVwkE1t4CIqZDw&oe=699ED799"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mCc2Zt0C74Q7kNvwFoVvXF&_nc_oc=Adlc0dEW7dpq1SRqwSRo-G0sOPCJuqGufbYF1MfEYsts-VBwLCtx6Stsf6ZEAcNZmhU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu8AxX0Uc2jhm1HwLNOu7wxS8sEDHfKAom-3NF6LDZ7mw&oe=699ED09F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=884iOQg-688Q7kNvwHcUAWd&_nc_oc=AdkNdMr_7IjgIkjrNxs21fjjVYsmP6FLp8l1Mc0vUCqftM5sL7nzm0wUqVBfdb50144&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsWKypeyJd0es29eeYg98LBQ8leanSTJqu3C2nLDGmiFw&oe=699ED95D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45
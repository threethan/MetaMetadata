5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kh6W_kamSPwQ7kNvwEy8Gxj&_nc_oc=AdlHfOTbxRfvDp6OUoC3P5i1b0oD4GcRrwYt0XSzlpypDWCnq26zfS_CzfxEvYIUsrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwn-dJ8bwtw8YIMc8Z_oGeWCDJ9RmV0OyIARSrG82bScA&oe=69BBDE45"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYD-RIEk13gQ7kNvwF2atOE&_nc_oc=AdlpoVAXyTc9PGsFVEQMIHEjp-Mz2i6oqBScxVf0FgPqlR-qAwTn7L1gwpBFr9hz1yE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhjKGkmlqetgHZB3x3GA0iilgPozmhKO07DmSRbH0Khg&oe=69BC119A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5lW_e4uZlIQ7kNvwEi50du&_nc_oc=Adm8knTjHdTwUQv3GifovdK0totXvzEo1FzhoT70dBnWG-r0c0aZ-j8Yf0nUCFv1Wks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQTJe86iA0WwVidjIvnwB0LBguZSh0CyAkdbuZ-nkrpA&oe=69BC10D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgOYV18w_BcQ7kNvwHejBDZ&_nc_oc=AdnWinj5zItU9bjZvqY4Blp1wsWDIf53iPQPH3ZizkylGsnuX4ENsm3izEBTQUFFyt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBEbPoBqx1R7-us6nPBpss9Oodyo6kkJjRFQzv8x4E0w&oe=69BC09DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADVBpWG_KBIQ7kNvwEe0BXu&_nc_oc=AdkX6tlOBr8jVH81P7ahCVnl_5Jgm7BRxXElxabsvMCCoCs85Xj2F3GCiZAVeaLCgzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhmzOnOrWQdVP6Nx9PJXpaVk2FIOet318XhYInVLeFlQ&oe=69BBDA5D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
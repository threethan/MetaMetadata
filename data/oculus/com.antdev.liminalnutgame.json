5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOKt4r4uc1sQ7kNvwGsV7qr&_nc_oc=AdmEXhNJDBah-8lAd0KDUs2tdMJL4udKBZpk5owU9sEe-ZycUXy4eHcs8uWT_6KdbIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvB5oNbR8chN5-7V0Qv_JpFzbwCmlTiH5LWgfZvo1CUDg&oe=69A96945"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOTczoAPkmAQ7kNvwHFkrXw&_nc_oc=AdkDTA-rvL31gZ0gpPncHsO6SnM-RHylcSB__ip6mKcVmUcBA078b6c1LCqzlwl9fJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftMspRS8V6l5NicEXKxln3tCYNlO5h4FT2u6yGCeNXlTw&oe=69A9645A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeY7eDHzYZIQ7kNvwGMA1oW&_nc_oc=AdlJF96mZYBJqrd4PK05zcAknHCU78Pl5aedFs8cfl86ugq1e7l2OBVZnAnymSvLOQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsI2QiVo_g7B7kl-bjgk6-gjn78zeQixNYF5YgWJIoIUQ&oe=69A96399"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU-zmxYJw-QQ7kNvwHH66jH&_nc_oc=AdkM-J-U_4do-w87Uc9FZzDMGhj-FmXMaEjqJhpunK5g31bX7l5GUZ1DVQyKsASPSrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvax7y_1HeY4DE669ip6kOsubEfjYKx9-IplBotyEvg9w&oe=69A994DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaIR7GvOEJAQ7kNvwGgH4tx&_nc_oc=Adl27ny1FSbzvM2VT4pNTBUuIwfIILGvgMaa2xzu2ywOrQSiR9EphCo45Axgq_aw2yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvhs1L3JjZVdkCfntnDY7h4LIUvUYAN1NxDMqsR3D8PYg&oe=69A9655D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
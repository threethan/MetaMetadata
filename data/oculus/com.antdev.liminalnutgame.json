1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY_63HqDv-gQ7kNvwGbyUkI&_nc_oc=AdogtP6UcjPHOMZoGrQXoDv4Ek0AAeBkBcKBxqoJ3svUVgCdHhlSS-aXhEEMNxTB5Mc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0GSBmTYVQn1CfzHYIHOoQaWleng-vMWv59cwpj5L5CQ&oe=6A316C05"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJO9tqUirGcQ7kNvwFTZZTM&_nc_oc=AdpcoxCTfEscnEPzTUZMdnsYrJHielYpnBwVzz9h9WQIrKH4JxjgxULsMYvEJUgG6Ns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VAqyDq6KlBo8-bOseNZV3S9jOrIJJHp4cI_02HB2dPw&oe=6A31671A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4sKQaO2y64Q7kNvwEu2bgJ&_nc_oc=AdrvgxG0j-6pe_fkWomrD3Tc6DeHFdTr8jbqZjO-_UBbwDB3uJc8dBq0uJK8ARP9YxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eho3FtDipmRP-PNidJxRgyL6u4yTQ9-xZntq16YZyEQ&oe=6A316659"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL6w7pDEyj8Q7kNvwE3VBfK&_nc_oc=AdrkEfdPBkEJSPYCGYEco5TkNrhuuiOy3Tkyb1bGVJlRy9qFo0hzOpI-XW5uT9OyIEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IDZYaNycbywWfhQzx20SwVsXzBx6155z-wszZbfnfZA&oe=6A315F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ze93nw3rkgQ7kNvwE7oABh&_nc_oc=Adr5GSAj8T1pQ0HTjdnfpb9ku75BX_QvCtuA3uQFCx5VwIzSM2VaZN8U9rqEB7FsJ54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0p_duiTLYo0_nKPg1QjOYTKPKYjo8GZTcvfE3kHc-CQ&oe=6A31681D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
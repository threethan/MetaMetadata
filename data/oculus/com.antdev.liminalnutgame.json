1IA&oe=6A53AF36"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eaT8lCYG7oQ7kNvwGP4kXC&_nc_oc=AdqpFENpdcIAsWvbS-Pb5i4pS00PZqO0jcQo-PWQUdSuxXvRIE7rbuou0V1O-utwZgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHRXRP607NemSC_vDsojskItOEKreiBIkOSvQ1XmYM8Q&oe=6A537AC5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MO7V_5XD1UQ7kNvwHZEI-o&_nc_oc=Adrun0SNPrRg2TRtpOAu7XKmAn_fq04Ccm4KBiekhjzx3p0y-Vmopt3upXUXw7ltTVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1edfa1KEjfRXnFZOngisGEakiZB62Dkwk112TGlIssA&oe=6A53AE1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg6XvcXxv4sQ7kNvwFD5P5U&_nc_oc=Adq-jVdW8CcVOQ4IS5rzUBdSRb99djaIokHxA_ZzlHCVcv_54U7u_aPvtiZHUPrw6ZE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOMruzJUmD6N9pjJ6sVdoXvIifHdoYG6512yo0lntL1Q&oe=6A53AD59"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0lAjgosYVMQ7kNvwHtJNjH&_nc_oc=AdpDzp99wh6UyjVUz6DiV8CBZ38ykhyz3rct4ky5S2ZshU9iPviZ38nMpjdvz-0ANcM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkeBbkwoI8xnvMfKbVUkmCAX3OUKXcs5pwd-bKEHA66g&oe=6A53A65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_uQSdMSImIQ7kNvwGA5hPH&_nc_oc=AdoeF53irnx-6nnoBBTB-6sdzaON3EtJER4eU9HwU977-P-kavzb6_jozWZBtx0eeLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxT6XaD-RPurnwAKPdVtSRd4o1DRqQQrrkFoLjW05cpQ&oe=6A53AF1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
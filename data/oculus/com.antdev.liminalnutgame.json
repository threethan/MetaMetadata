1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHFMydKTxmQQ7kNvwEXFBrd&_nc_oc=AdrBG8WDBODhuKMObx9_UyJrOyg9e-WubyzRo2J1pKnRyG72LkM54G_nQtRQQTSB2oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DM-v1fWvI406n6UPl6qKRHWQMpREVOc_J8wcGxlF3XA&oe=6A00A485"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLrsSWiphxIQ7kNvwGdDw0C&_nc_oc=AdpKW7tYNYpRfPT6_mUeny-DbOl5mEzbn79lxeLwHxWybIJfFqOIyF0jcJBLAfcgmQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rbDP5Y6aO-a58Er-MKZ9iQdqdMyWtuYPwz_CqJ8I1Gw&oe=6A009F9A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr-zbyZIZd0Q7kNvwG4dVxv&_nc_oc=AdoNS-RdRad__DKNMt9nijboLCsrCaciWByrJwNZO9DkauUQh5HdmySc94EagQVFdyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gIY1Dz13FWdqSrHXET1arL9j51sclr4BpvVvkqZu8AA&oe=6A009ED9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-NRlJqZM6YQ7kNvwGT4WHY&_nc_oc=AdrxIMFuQmvvwNLTdqcOz5tljLCc3t5K-GeBE6LAjFiW_Lfl9hy6p3Yeu51cj8CtKms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mXZhoNlgA8zx0YRS1qxYoVL7pSF-szWEWTnRPIxP28Q&oe=6A0097DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9kTs9ke77sQ7kNvwGxTnKy&_nc_oc=AdpI4UtyaazG11wLMeAbIWEk6x3eheoJ3_sSbFjQAXnbLk0xHG0WWX3tbTb1R_3Y4w0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cvXAD8LvJRq9NqiVHb-1rKPcFGwjAQgKPUuE441c59g&oe=6A00A09D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
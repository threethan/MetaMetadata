1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7dEF0Wup18Q7kNvwH4sbw2&_nc_oc=AdqxS_cDqp_omPOvdf2B7YEVbVF2RGU86nkpOYHVFLhwlZ2WXO9drQFvx4FYDGWxDzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jVTjcHK8_hu0EvIYh8BVpDXZDW457BZAAcuLnq1d0uw&oe=6A356085"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUUB0AGZSW4Q7kNvwHlrAhs&_nc_oc=AdokkCIAPkMvm9g3ruJyUvqFgOiSINjSX3BhkHHrlRZu8nQGtchEuY1euFl9A6932gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z8dVShDpNDN9RAsfbQnsjZgXZoRR-lH4YpAJHb8Kl2Q&oe=6A355B9A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKrJDFb9VhYQ7kNvwEy2Ea-&_nc_oc=AdoyxmkhiU5kSppskFKpUse1xN0f6IJS2dWJGlMu0OxBx0V2NfNUDthgTUk7wGc2sw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CddvPiRvGl8cM1MHW7huYl0Ns4BLgOeNGoNBES88Dfg&oe=6A355AD9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRURXuwbmR4Q7kNvwEAdENn&_nc_oc=AdoGu_lwom7kc--gfbHdYkHMhJ4yHxPDljJuloqfnZbN1fgJ1issF0AzM2f5_4pJIAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hme2SiCjxoi4v02JZ7UV5kMZl15MPKjN6hVVxiuUCqg&oe=6A3553DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVWo3ci9sLcQ7kNvwENOMD1&_nc_oc=Adpl1bmqcMGOmhucwhCMwwybPh74TfPEDB__oDMBZNWvrMr1RaSKUQIvfqM0ySZeh00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84GQob3SVRMUa4lyuLboynzGRx7U4V11IeGKcVWPNyPA&oe=6A355C9D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
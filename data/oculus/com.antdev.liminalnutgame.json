PDA&oe=6ABFCA36"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZ5jb-CQ0fgQ7kNvwHWbb7y&_nc_oc=Adofls0HWt1e7lfuMU7iRnJfoSQ-fw9Ny0bS3-NEiIdK0N6iqOvK5cFqExX-at42Fto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLwaj4ugh9R15llYCWZNA6VLWIziE_IdbUKoVg4_zOBw&oe=6ABFCE05"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHXtZkS8-sIQ7kNvwEtSRXV&_nc_oc=AdqTZZStTbgtcgFfAzLLSqjIZJde8H6HfvIxCFKSvjm9ApKWEOHI1JQ_73Nth-RPqbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Fc08yINnCNhz27QL9VaT4jzNyHdTc795kLCkhqCwug&oe=6ABFC91A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBAPkbJCt4YQ7kNvwH_1uq3&_nc_oc=Adr61i6jNVCmpI8M_pGTzPqS3uic4iB3bWqLjVpXHmSf1FDTHTJZnyQmdHG5ZpdTPNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCrV_hatYJZj61BjRYVQ-JVUpxevJnNDRQCsgno2iUng&oe=6ABFC859"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9KaKFAw768Q7kNvwG0BZtz&_nc_oc=AdqjmaCdmaAK8Jqi2M27u22arU2qD7DpRcWyOowpirg-E2i0UoYzgPnItX9OHG9_Q08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhWfSq5amen66mBcvLme1lKVau1eUCFix_ptD-2ENsZg&oe=6ABFC15F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loJvZRhk2pYQ7kNvwGHz_DR&_nc_oc=AdrXzfN4tPe3IHjfr5kusb17WDweIGcdnNy-9q0ICa1t7HpaZdg11UnRvYRJWye3RaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfnLVgkHVk7mot51La6Ze7EySJnBM--aVjBEjwBD0REw&oe=6ABFCA1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
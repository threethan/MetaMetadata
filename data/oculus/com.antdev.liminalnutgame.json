1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0lQanhlpE0Q7kNvwHVKsWC&_nc_oc=AdpydiHXWfWCqGgGMvtyUCo6tkc1Nu0xQZZsKqym-wfBOzAYe_naPob_jk8Yl171rjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gf6HiA2uJYqoG7_WCInae7ZvKF8rhqac68oq-I9QmQg&oe=69FCB005"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yOUlOHv4ZMQ7kNvwGEsUTm&_nc_oc=Adp1iCscKCrPOD7t-AoAovKm_gpU2Iz2Z41pFfzpExZYzs-38YpyEGlSSlkM2UkTKRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v4EzC9d7op0GnWFlWU7QQ2fArmjHzP03v1juZMSg8ag&oe=69FCAB1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0znpIkWCGsQ7kNvwHHNNLZ&_nc_oc=AdrsDjOiOcwsJgWyDTLRupFbi_gEss-VJN9pgxpwav7zSFVrNF7jOUT60JsGM0wM_iI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T8J6Pjhmj6VfoYv5utJlQqYmyadZE_ruhvPlXwUc1Iw&oe=69FCAA59"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jokw5O0P2scQ7kNvwGrxyR8&_nc_oc=AdrME2ZPIIVrjmEEk6GdRPPg0NE5Y6MeCuPgr1X1KWhX2soL3-SvXH5WZOzHMgi5c04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jzc3NT6FrCg29MTO1EPu7vUYvFhMTRZBcR2qmuVeD3A&oe=69FCA35F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_6ktzhH1oQQ7kNvwHGw56h&_nc_oc=AdriqOr8FO5rFE40DJaJzr52QOADSuqtKp8NWsdf_41i1zgAJIMZ9Zrlu7HqH82pdPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lAKUJ-tejJvhYB4SL1UxSjT760bXliAuoVKkGbSVCYg&oe=69FCAC1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
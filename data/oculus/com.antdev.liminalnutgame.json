5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_p37kDHCEAQ7kNvwHVokKv&_nc_oc=Adkm5WjlUQ9Fh1QMdgR32rwGxJqtUpSb3mPFawPGeuQcYgnAcRcYeHyTMKXb5YxHvyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5M2vpW1iss888FuHOj3yo80LBZyK9J02VtbbNVe8ZVQ&oe=69BFD2C5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Diknt-punD4Q7kNvwExFGYw&_nc_oc=AdniAi6IXKrBXpXKjKER3a9UL8eexRY5RhHZ7P4vaJ8hn1_JZLAihmcLJ3S8xr1KRYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUd6dhyxtVqjy1MJqA8ZnlIRTjmbqgofyUqc5RM9JRYg&oe=69BFCDDA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTvB67Z1GuUQ7kNvwF0UxaM&_nc_oc=AdkBhvZywnAxifCQSUCwjkmbkpoWhJlY2BWsjb_n7eZMkBKrsjJ0y-SVgKvTPIJc2wc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzT9iUvVho4nhtzAn_7c7k4ADL5_MKY-Z0fUBCN3RqzRA&oe=69BFCD19"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyBmEuUDxfcQ7kNvwHTw5jf&_nc_oc=Admkf1us0JYibxvAJxpRMikZGq3iZdt4edXiBNEGzp4VNIfHA1AP4c9WLVqiLTHqwjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRnfbUEsmB16b1dWprRSpohH7VDMHhWWniyBy_tkSf0g&oe=69BFFE5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGUXhywEkiwQ7kNvwGNqSOy&_nc_oc=Adk4t5UZpqu-uZP4r83FgtIRvg6mMI-SrpTMHM8ubFWFRw0lWpDe6Jfl4cNoeLTP5r4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1p5mc2g4Gl_xFQhvAA6c4KBLV469kvTGC1h6TiXfbow&oe=69BFCEDD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
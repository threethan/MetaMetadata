5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQhEypIg4LsQ7kNvwFj_6k9&_nc_oc=Adli2NKNuw38JvMj0ww7kbmMPo2Qzx0nuT-Ukrij1OKDyAW99go-qRtRtyuDWtnKDtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxbEQWA8sry_cYLVSmNfNqoyzz29r3PeB-wQXRhVYbkWA&oe=69B7E9C5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maTCc5I5rPUQ7kNvwH3_C-r&_nc_oc=AdmTFReILuvuzcB35xaT6QMHpIRTrw0jZxlOUrTlcwdG9o2NY05hw5mLu3G-mRGNLTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmHIMIE_2F2gLhy0y__6hIxkO15tmJeF6u-jgqGSenVw&oe=69B7E4DA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPgt0M-_ZkMQ7kNvwFAcg0W&_nc_oc=Admk5iNMlOYYMyvdaNWLFmpKrTD6D1Og9mDB2Eq1y1r_ARUmRRNLrlIF-7wVJdP5XsI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxW8esPBXElKw0AhVMq48I2XVht3HWmrv-SJ_O0rIJT-Q&oe=69B7E419"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s7rFAK4PssQ7kNvwH3bI5D&_nc_oc=AdkLy5GO7I3PTP3b6cEdmaAjEEKh001BK6aimpSZYrWN_JaB8OHJq-Gg79RMceNrO-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA7QqSd0ouJVD1qVuVvQ---1-Eouo0bJbTRAJgogNlSQ&oe=69B8155F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCQrGr4qLzAQ7kNvwGT8fWu&_nc_oc=AdkW0H-m-5yvpEMK3RI-9GlxQ07zJXas5lwOVmOfc45Q-qa3UoedIdOG-D5pkiI0ax0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9IhNu5R_dgWbzmP486H9YVYeVsYQ3BrN9DhACkHu70g&oe=69B7E5DD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMnvhCAm-yIQ7kNvwHcMrWH&_nc_oc=Adqt8AMjXatrn9XXZUmdPrnYHXXtbdKT4PIOhDUPH4t2SaGI_BerAlGCUGmkHzUDguk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bga0lbrb8WJ6WaQHFMl3jFZm6xPcYLptAFZBSqYQWOA&oe=6A049905"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-21uEqe6ExQQ7kNvwFF33SO&_nc_oc=AdqD6i23KSMlNUtLd9P00PHK5c8xm02wnOu5SwHvAmDYS7bC40XUDDx2hrCqt0p1eP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hdJ5UCHLZ3rnbeEpdtl2ntpLRQZNZ-I0jBQCkgKumFg&oe=6A04941A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEXfSpyTq1sQ7kNvwGQrmgL&_nc_oc=AdpxD4RfGoU5T8JAFc3OEC0nNVFZoFszsR-XlqNA3j5Qfi1M3OdRH1hbom81id09G40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fWZa6f6Ia5t-zQojy9JINXjbtcZN6XzrwH8szoh58NA&oe=6A049359"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znzmWp_-ZNkQ7kNvwEf5WeX&_nc_oc=AdqYoAi-CSLEi3uonh1rowvNjN5Ij3FXvJe-BteYyeyTxbAibG5Iv38-GIkEN_AAKIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48JlSs0Y-swOT0hc4KT2Go8jM3NOBRQhnyl2C6DL3yTQ&oe=6A048C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApaBC1yr3GkQ7kNvwGVSx9e&_nc_oc=AdpfJ5n_Ndwedyf2W7MsEmeSSmFV1lQ5uqyK3HhTOQEolOS5mC6sffNzaUz74Myu4Po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sAHNrzsgBAScGNytM-ClCSUKKAYxFo5Lx2S2QTxokng&oe=6A04951D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
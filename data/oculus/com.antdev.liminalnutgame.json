in2-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7dEF0Wup18Q7kNvwFr1B3h&_nc_oc=AdqPV9bJsIeAgKVO_mj8xQB8zHtWtuT-SN5JHRKYeGbX2T_GX7_7CvJ5xHy51-4Ovpw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--X3KaflcHJHR58uIE7bfzlBZKbTw0B4QeBl8Ujsc4hw&oe=6A36B205"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUUB0AGZSW4Q7kNvwGzo9eV&_nc_oc=AdouL_8VrcnQNVF1Zv6_HQmXDU7NdFIzkNUuXz3YWzImWSQIzrL347KcXEpHkv7qU8g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82Tsnzm2f14JolS6Xjk3mSHVEcpJWQiREYGQ-W8boDEQ&oe=6A36AD1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKrJDFb9VhYQ7kNvwHBQJX8&_nc_oc=AdpEAtKbRp6JAIgw0NmQRSSnn0QQM8kb8MAgkJhbgBJuVBebkSTg7ldzth0i_K368TQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O26KHjRo_1h02jZ3S35xHn0rRdRg3M1EMGW_mE7fMJA&oe=6A36AC59"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRURXuwbmR4Q7kNvwH6fqg0&_nc_oc=AdqudEhp-QZ_G1Db3fhdBSpz5AljrBaNfxK-guXo96oealTlYFxOy4aTTT8A0OnoikY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S52OXZtitwjAq5mGA-p89l3RM81Z8GMLDtEB-IPALGA&oe=6A36A55F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pd0CdmIbLuAQ7kNvwGwmuVF&_nc_oc=AdptN9DyBIHABVAJkR4DTlNs3outmrwLoib8OEGgDHpHbpo0HYgZCWoOoign3UDXQBI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88IBYVIEEtCxBtZFi4ehPCQY5dHOmut1IxKK9-d5Dbww&oe=6A36AE1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "co
5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2HwqdLvlPkQ7kNvwE89jMC&_nc_oc=Adnq6YCtrCRvfSgi6xNvGIdmYwt4-BrfvRpNYVjelpeqoYgxPvoc2tg3oTdOsrzql-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDul3XjImGpb9u_vycoV3Awf2sohDcSPgZsSGDrvJJ9Q&oe=69B2A3C5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCIiIJ6iLjgQ7kNvwFFd4jP&_nc_oc=AdmWqk5hGf0knb3ChFwB3FxiZu7thDRlC3NmeB3hdL7atb7EU_s6OkILJmXByuMPRqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_l_r1RPd7SHJOn62q9GSPfKmfCNB3tyZQ3aKeMNbr7g&oe=69B29EDA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gzX_cpRV0cQ7kNvwGuzCS7&_nc_oc=Adm-DaS0QIIlGCzhFolNZ1VoYsIYdVCsrLylq31OADnfFub-v2PDYRcQlvfhiV_Ub0w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVONkNJNJS6u2XCi4ikw6Slp6GKUUcmktOlfLAEp7iJA&oe=69B29E19"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VdB04s3LaoQ7kNvwGwdikR&_nc_oc=Adko6QCtr93DP1kxi9CeYBdWd6r_E0IZBml6C8S7MXNNZ5_DSxQ6K7akxxaKsd46Mhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcmxhlChu5xlc3jzEXxV29ahYcUj-3mEEeTOyuCFytJw&oe=69B2CF5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xnpKaRhrlsQ7kNvwHSq0iU&_nc_oc=Adl2TBnKCVs8DlwVPcnJEoT284b8Qet7R_vZvfAoY7nYC4lw5zIq8h-PaBxoSZsvIjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afymrruj5_0lmtQ95nJfOcbTvA4ZxD66TPUzflpNsSzVfA&oe=69B29FDD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
LaQ&oe=6AC11BB6"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZ5jb-CQ0fgQ7kNvwEP_9X8&_nc_oc=AdpWFqj2rlLA32LhwiySjORrDfH-N39YDxKPpj-5NVU0mZFzf-SOX9hPn5FVPljcvPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO9o5Ay4OgbBfUEm9c8oDtd1pFMCwMM7bd9JHTuOop9g&oe=6AC11F85"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHXtZkS8-sIQ7kNvwEwMsa_&_nc_oc=Adrwtn0mDY8nG5rThTHoiN7KmA04zZRSJGkasZEWcUT0uj7LYSGd2zpFzUyAlqgrLXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmnrKk8BO1XfKBGQiUYUu9vB0ZiXakeKYiHP3yCxg8JA&oe=6AC11A9A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBAPkbJCt4YQ7kNvwGVZSuE&_nc_oc=AdpACokDEnjS4e5-oJ3ydwA8X5U_j3D4-I7g9ksDRKVgJUPTlFhCTv0p6cGf5bV8Uzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEcZaCgLTRrVc1SsUCiC_U93HL_nniZ_XbE7aeyvwaGg&oe=6AC119D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9KaKFAw768Q7kNvwHt97iA&_nc_oc=Adpz8dFTOxLhMRAdLJ6LTStzcyjW7kqfLTLxdxW0jAc8mxDynwinZH89f6zVk6D2BOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvn3XlbcPCUY_QDD-dFMxGiM6SlAukCquxmt_-T-z-rA&oe=6AC112DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4B88TusTV8Q7kNvwGfAZP5&_nc_oc=Adqof3dJTY2jkanT3a2zZARpTAkAXAha1n54pSO5hVCHXQhMlCXbZ0GfUjQootP3xq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4akXLEEne3Yp2JlTJmXf3B4CTK0g6da-03U6xiv6B_Q&oe=6AC11B9D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
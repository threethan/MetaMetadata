5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_p37kDHCEAQ7kNvwHfNaoz&_nc_oc=Adpt24SRDRPp0fc-FXZPZe5UIL4m5vxR2m_dZ723u2xvp9u-ZmThOJKxdtGtPcASIfE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiybylbQTydzqNUMW56EDYMqZRh9gr2iTYyoZfQWkRJA&oe=69C12445"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEfOBLZeOWoQ7kNvwEVcf4V&_nc_oc=AdoVOcVztdFNXnrPgYLNA2k033iGt31WM2S9cNEOH1CgmzvMUKsvE_5WaELzpMSUSS8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4wNw7fin3dD5VKVjBwx4UfcN5LCii8wVn4SDfit59pA&oe=69C11F5A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol2VSt8ym7gQ7kNvwES9xlj&_nc_oc=AdrTeDh2gHNd7EgeRzT4iq7WqnSvEQtnE3768Ep4SQxKNelZRLdoLwFA3SJ49qlGKLU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1d3gxgZm2rss3KDWbLl1ibZ0qWc7lDnkLiE0ua5zQOQ&oe=69C11E99"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbhh4qEspK0Q7kNvwH3H6Kh&_nc_oc=Ado32GurGIzG3X4RZ2po_R-yZV4Oz-N9TLYCL-DPUz8VGM5SCM8rHUqYsS8oGobaIc0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7P4xgr5fwigBrN516CMUPzh4cT5d1IyD6If71ZzFHzg&oe=69C14FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGUXhywEkiwQ7kNvwGXZJ_1&_nc_oc=AdpZPHFgWaQyzD0wzqNascq0zgFVB1qKIkgv7nr2qjppjJczlOZ9opaJjlUv2Yz9PsM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrTVEgoPvKAMLVcEp1ct294czGGeXKS1h9netr2m76hQ&oe=69C1205D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
lvA&oe=6ABE78B6"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_cH0o-zN1gQ7kNvwH8_pO0&_nc_oc=Adr5Q6g2kUjkbU3vMKqfF-6-4JsDPXPpaCJwGphYJdMsiDI407X6TB5KHwaQ7mPbuv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSF-zJPX8e0MA7UVy95oApxwMs9d2weAMpOG7rk2h_dA&oe=6ABE7C85"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHXtZkS8-sIQ7kNvwHQ0Jgc&_nc_oc=AdoZB8ZMA0EqWTKeiCEq_6OGDb_MURyCesT6bO-_07chzGyICkCek_snhgVdqPnkaGs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlDVMmLhXRj-uQB71VyJVtD31VUF3AhQTFlIa-Oec_Cw&oe=6ABE779A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBAPkbJCt4YQ7kNvwFY07O_&_nc_oc=AdrD0pg1Cu7xDY9hM3U6LnXS8aYmi1KUTvkYtCMkL7fcKx_mU3YfPrvKIOzhGkgvY3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ7_KmJz5VPf0UWcnX3QDoR6CLbAAbO22X8wAC3PTR4A&oe=6ABE76D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9KaKFAw768Q7kNvwFpdAyo&_nc_oc=AdrKykLIhrRbe60Z65fy575Ua5AMQtX-uNej6-0p_bRZa6T3uy5nRMQBW5O9vwyOzlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJby-wB137Pxe2OcO_DI_WbocMPeRQ-ThfwJ4faEVR89w&oe=6ABE6FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loJvZRhk2pYQ7kNvwHXImxc&_nc_oc=AdqXwMzpPpVyonRefHoFvzXA6KIyIF1zVZApZXnSvf5g5-qKkyYUkn1rtqbEHaJ8Kl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcHLrC4OkLffN5MikUi6FIwtd_SMUM4jXX6WAKEYIszw&oe=6ABE789D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
6zw&oe=6A3D45B6"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu5gWMToJIYQ7kNvwGfrP4k&_nc_oc=AdqhTG13heyv2iZfoZtYyiODgCl164GksCd264KoVHZcqwaBWpJW0WY0dpin0V6AWBw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UJ82PTgkgVHTkSTouy-WeQCD2KuTfEilFGmw_r5Ampg&oe=6A3D4985"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlzGZxW1SREQ7kNvwEBCsQ2&_nc_oc=AdrhawD2gJ2tLNswCGLL0XauWzuLnIzBCaMmqqGtlnKS5CkkRzY5ajtwgtPKKKrtovs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af899Q7OmnkMSHkGNkRHdVSkMvPCkS7SE6qTB7sMKIQBGQ&oe=6A3D449A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L1qh-2axDwQ7kNvwG94zmP&_nc_oc=Adr6nFHdQCACVNa18bhLbo8g-6CRrPGmwuyp2KhtL8KqjJHKIFXLHi7kNZAOyBMlryg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q-NhINcUItvCnF_QNfppKq2wNErO-poxoVO5lKFWU_g&oe=6A3D43D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AB-lclCg708Q7kNvwHxut8_&_nc_oc=Adol5szVui35V4VOXbFnSVTM5zRiO1J-hfhx11Po1g6c0MR1QvinGCoE35DnQ51O7OY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WeGbyOlv0pcNuk9BqkYxe7cOWcVozY4frACz_7f6LAA&oe=6A3D3CDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drIzQKsuUHEQ7kNvwFDOHsC&_nc_oc=Adp_zB_aIlhl87jIdup0BnX7SohhKw9xrlPUCyfBCmFAHnS8ffeP37UnRQKDmmARMLY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BESJ697wk3nVzP2NTioV6ZkbddmW7y1fZ1RFaU0pxVQ&oe=6A3D459D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
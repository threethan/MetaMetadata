1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqg9YPtkC9gQ7kNvwE3WL--&_nc_oc=AdpI4fmd7BnxI3xdSSfI3RdB4KdUYyW47vJ2JoJPEfhllslCDwKH_LiThysdnrSsg_4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ES_BqoWY9W8CAjrK1CGPoWr1KvmrQi-j1Mrrd9mHXfw&oe=69EF8105"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSONd-jU5oUQ7kNvwFwJr1d&_nc_oc=AdqRz4LZZayfWU3ssA9qf5P7E8Un15VfvCEW0vge1GYuOmfku3g9yL6MOwax5xHPErI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3d-zvEKyrL3ar39mOpki8DpMtjtPwf5oSyZTnwhfoqfQ&oe=69EF7C1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2DGrAOV_PoQ7kNvwGJJjqt&_nc_oc=AdoZ4JRZbkRzTpriXOoT-XsQEm5Lp3uSZCvqweeg1W6QMEcVDF7QUY7KCg3CZTnDRts&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-A6dhT7VTr88vJN3dFpEdHl23XcPKWja7Cd324LZZtA&oe=69EF7B59"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rvHPAWK_wwQ7kNvwFFYP9X&_nc_oc=Adq7t27gUtqlk7S7h1-ICBWaKDE5rWUjg5j9njpQ29eAuEd-etfEzjrCFo-36d5Q8EY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08g4UIE7lAxjsVpgBD7c_tI2yeD85455GymUCN9fydKg&oe=69EF745F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPLkRr8YgFwQ7kNvwE9BvWI&_nc_oc=AdqEsNHgTIVPhGNo5SYMuOnQk9he7eOIt9biLITizZNdonUQzUBr0rjgTmwL8r7ooH8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14XpC_rAPm2h8wE1aHLpFHBOCqQQZh3MD4iZKQ0Puzmw&oe=69EF7D1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
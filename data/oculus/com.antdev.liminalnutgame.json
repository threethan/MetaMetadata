c_A&oe=6AA56C36"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N9HR8GwgfwQ7kNvwGFFAJ8&_nc_oc=AdoWy1mtxfmCzPPp5afUMA7JYuByD7YD_PLPa8jPeMHynYZQm_F2w78_YINVDh7c-dk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYzRcLWTBAc1fxvBdNV11r0vdi3W91Ea9ivY3E4BWI-A&oe=6AA57005"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEea6xjqLKoQ7kNvwGVx0hA&_nc_oc=AdrNJirU5qQ1F1dF19SpuxE0Iqt31KcgE6_We3OYLGbGV-yCVp4IqtlgQLhsWWJiSSo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKXneqJ2XlUnqpyj6lIzB2pryf4QtZn6nOAxuA99I2_w&oe=6AA56B1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZlgC0dYKqUQ7kNvwHl19FX&_nc_oc=Adq9_jf7R8ZJgFyFjtyhK2W2TmlZYs9abGCjABzECVlwwbxK3NdsgR0FCUbc8fLm6oo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF9aLW9ENp1mj1W0KmerzXGliukAdxrbup6KT_bYhp8Q&oe=6AA56A59"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNzhr7uDWWUQ7kNvwEZ1fag&_nc_oc=AdojPWsFhD_hjjGRcjGz59cRZr94AXErVIjGwl9vs3wFSOy3XlRqYcSf5l_AtjJfM3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVgUAMrIX_8lPmUnjer-G5XpravR_Bpe_u9qKJBk8Vsw&oe=6AA5635F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_en0hkIYNIQ7kNvwHrcUFr&_nc_oc=Ado-u_tYLG9xKRNBdq3YBEO6MtFA0eMxhm8kGfAmXgfmsp-lOfk3BaXFXoZqxQIocWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjjt29lCaAyh1tp_kAog3aukUkwZrX9ff-GQkcQHinNA&oe=6AA56C1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YjVoXjPTOcQ7kNvwHRjpmG&_nc_oc=AdkPW0E6cOuzcWMAjXZh4IYZGrVsMRJ62NbvNRSUj13iISnmum0tzw4sdVRQ8jHSlDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftYRcl6Kptu541e9X97A8wT34WydnMvEMgVArKO6JV7dg&oe=699C3A45"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsJ6KmFZjWwQ7kNvwEQmi-o&_nc_oc=AdkPP5eJzniB4bXkYfSKahlaEmzEaIbA5dwE5FKLeiTaPVEi_8NPOEyfOGXPIoEZ840&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftNqaxliBzsA-eiMr3CwyDZO7AXLK0VC2cvbkjB-uw9sA&oe=699C355A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-gt0tjK-F4Q7kNvwHZavo9&_nc_oc=AdkWJQ5LqGs5jSZ16P7L52Lf1oO8M9HEXf-o1VTZp6lij_QEadVVsRiVuk40Ov_hWns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuZcCKNo42vW5Mm6qKkFEIM_uEB-sD_CLm6no32AYfceQ&oe=699C3499"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPNkUjMMMs8Q7kNvwFb_jUH&_nc_oc=AdnL1yXDJeek4lObFxqjcUf25xMDYLNYPBRzvh8wSl9fuOr_isC_yxNbhUSPDKKrq4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvuyYq7d34nRbYOnfN07GZp4P4vRy1AUpe09CQzll4WUA&oe=699C65DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=884iOQg-688Q7kNvwFm7USh&_nc_oc=AdnC8Dr0KZB-LCQaLTh98WU9mvcfQZRPO1NPcEfYi4xZWLGf8n0W9lEt6jpRFweMyJ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft17e6bTQLAa0YQD9JtK6KgbvtwawDLyvs3yUj_Tu-Ahw&oe=699C365D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45
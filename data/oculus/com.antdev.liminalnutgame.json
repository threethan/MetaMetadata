1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJWp71-0MrEQ7kNvwHhSsrE&_nc_oc=Adqv7CpnyQZOpD-df1dBcvPSfILssDP5ZL4UVXHjJ_aZ05e4tGG35hcULovNgcmEVXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_p_nA4rQ-4au96Y-ipdAyPVId2TMma7WbHvkdRx1daA&oe=6A05EA85"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-21uEqe6ExQQ7kNvwE2pCA_&_nc_oc=Adpf1sLB2HjTkh7IZ4w6PiNVnDSzi2XW4aMXIivcBrHoUH2O-EIFnxmUw3Gtt1GvlhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kMz_Y6aM5oh8N7K-q5NcATcrAckGRJOJcJQaGvPOJxA&oe=6A05E59A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEXfSpyTq1sQ7kNvwGQ08Mm&_nc_oc=AdqwDQx3DHpbG6wHaimfAc6HmRmAe-YZUOW0dWieTDj6Czlq69rpjoRWuFJun6dAi78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cfSjUBV41CsPaZyj_LD649q_xVBblvjRxl-IkVdjvrg&oe=6A05E4D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znzmWp_-ZNkQ7kNvwH6J3Oj&_nc_oc=Adps6cRqmdb1f67yLYR2f_2z_AVGd1L4CpLv6wKnMsi0lcAK7zbdq4QaRNQql5CLBgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kR-TOD7PvfBOCTc1na-5--qDDTOvLmlggeVLG1huwBw&oe=6A05DDDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApaBC1yr3GkQ7kNvwFfZWLp&_nc_oc=Adr6ivyGyFv-9Sc4RctZ2n8s7fXXrtmwOAdNxu8lYEA8zQfwHNL7g1JnJ8TBhGZuVfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69_npKVds-9gd22_TyrTNIYXlICkbKiejuoCl9MX__cA&oe=6A05E69D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
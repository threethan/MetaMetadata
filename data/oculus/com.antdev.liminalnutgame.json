HfQ&oe=6ACF9C36"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc1hVLU55-kQ7kNvwHJEwjY&_nc_oc=AdosLApfM9HJg1BmLZzAoyLuDaJbypUr92hi_CoC7gJU5Fl2OEsLTPjjUJl7idkFIBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO32PqH1yVKLlwRDY3mQKEzcu4EgoQE3S2P-bnvFrL6lQ&oe=6ACFA005"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCwwIZ_eoY4Q7kNvwHjTNs1&_nc_oc=AdrQx849CfZwOwT5OagZ_hAx2PbbGhQTy3A-hupJ7qUY0VOdRphgPFs4CxT8wzknmiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFBuSFBXZ0vw5MLUqezs7H4PhVf3FpGKl1GadiB5RSng&oe=6ACF9B1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVL5L_OFQNIQ7kNvwEuo1yi&_nc_oc=AdrFzy_bCpY0vRChz9tCOFLfFd5Aq-3hjD_vrOS5_5VURIezNmh_kFsLvaakLMLMbEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY2DuY_-LZr3VbOEzdRtT3aGUPuoydYkkl06E9E4JlpA&oe=6ACF9A59"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj25r8DNSjoQ7kNvwHAp8IV&_nc_oc=AdrQFB_0Eje8F7xFZl5kkSehRWdLvkS3sKdfsLKW3-n8h0Mo-LfNH00vvw-k22UCTvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLtRE_em7e7V3FgR_tYjszQr8Q8ZKHsM1d4_O3YztdOQ&oe=6ACF935F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JZTaA75WGcQ7kNvwEI-6O1&_nc_oc=AdpwKsp-aNGUk8m5n0kv48KQ_rOxlLXPntbWyP-73E9zSplny9Ssw92gcT9wP1vZRJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnUO0BkiMJFEh7RQV4DSWLsekTDI7BcCGqMXIkRp0ZuA&oe=6ACF9C1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
2.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3JqGi9_M1AQ7kNvwGP61z6&_nc_oc=AdrOu4i4YZF8tLaAL4mdzrUvb0CvHssdHPU0Fk5H-paS5fXVJyu3VEhBib7I6AS1diI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8RjG2A1Qrta_0nSOz2aXsAMS9Ay9G_5u2_vhdoA2ysg&oe=6A301A85"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJO9tqUirGcQ7kNvwFiKvgF&_nc_oc=Adqq-vw2KfXxJlXKOwxQ93sFTUx0_ISRcpqDQHdvqnJcM8IkEgo80INNt2tLYZ23hK4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FGHu6Eayzk8QlT5QP_iq167JEeWXUc0rXLrgORRqolw&oe=6A30159A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4sKQaO2y64Q7kNvwGg5ObX&_nc_oc=AdrjKIaANutkppeg9_hzZyUvwBey1TTvIYEGiwWAZa1ESh6K7k6WhuKm3327CxdAmbc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UDR_11_YX0nqkJC0YicuIkG4wlasI9CqCtlbY3nnGig&oe=6A3014D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL6w7pDEyj8Q7kNvwH3HGlM&_nc_oc=AdrWoq-TiuHL3-V6WudJcwdCiyoCbTfqiZhmQ-ICDdXgpU3zeCmRzDRu-TmE_OtY494&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TomSw_gphyI10huyl0izk94GvyU6_dlBlAR1Jez0OLw&oe=6A300DDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ze93nw3rkgQ7kNvwHGVPnL&_nc_oc=AdqeJuD2CG2UuJLccuTH146KTGf-qSAh-P-meSOEL5Sw-iMzvDhuray2sUx_fBXUi3k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89793gyAlNnOuR_obcTeRyZO1oTXmcx3PbER__KXFdww&oe=6A30169D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
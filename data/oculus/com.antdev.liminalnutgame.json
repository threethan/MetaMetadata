1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZZ3NlM0utEQ7kNvwFprb7f&_nc_oc=AdoJrCVmbjsfqeaXCi0mX9F-pWsnW1EXEXFMXmfzIUvmyzlqozFumTPgUhZ6GBLNRW8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Dwn-R6L5Ktzz14FUtojV9RibeblPUdBq8hPpHq2kgdw&oe=69F61885"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLxLe4htLosQ7kNvwFso7ps&_nc_oc=AdqijAIlH5wFjIWQn6ELhe69Q0Xu2KfDh7yWUHtneaMNKbiUhULwvrStp6cZQ5UwAJw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZtOvYw0pHuCIs9ptOeQ-G0ZWTvg1SYjbHDJsvNxVqDA&oe=69F6139A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUrW6lVIjaAQ7kNvwGpQRA4&_nc_oc=AdqyLZ-W8VmWpI-e8BBppPucDnsn6qJARMJFYJr4HCwbZQssCWeS-zJX-unqDBHSN7k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wAUU-8OOAQ9XlnhS61o-l1nyYtcffUqTeN-d3hvnZVQ&oe=69F612D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2ODMV2ya94Q7kNvwGEM4rn&_nc_oc=Adot2ZqgX8uokBuzCl6pv9wWbslHVbdKPuoThX1ulakNXwALkC3DCjTg0nHAYwIbu1c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iSxjfL7sdY9OVdp3Gx_2ccFc1hRa8mmvpE0lk9Q_daw&oe=69F60BDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgKCJPy9LLgQ7kNvwHhDXGL&_nc_oc=AdpRVOh09hZ6mfqo1vhNcWKTAkQb_6jEhssQm0SLwozPgipBRoes_Mg1amN20ZUZwlA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QJ-Gh24PLoTDnqYG2SzIc647xGGS1EDdJKidYongMow&oe=69F6149D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
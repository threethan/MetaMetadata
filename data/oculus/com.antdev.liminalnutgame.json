71-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuabRAXW8TsQ7kNvwH62zHQ&_nc_oc=Adm9vVIlCyCeJ52bgTY9VJ3kHcPssReW8cmbmm5bXMFcMX-hggZMettwe0AHa8xCOQU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzA66LpB3OTTQJyhqJBJm1-15Ay4Khk_f1L0OT0lAlQVw&oe=69AABAC5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOTczoAPkmAQ7kNvwENNeKe&_nc_oc=AdnMPj3wVTd13pJ5XMZDup_HijCHla33gEknBzoPN8Z2qxzXer0eM178J0xgOJDIv0A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBMDiCcevyJ5Rn-banXOEyNTq06rNHmQSX0CZyTyWOog&oe=69AAB5DA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeY7eDHzYZIQ7kNvwHFtKdk&_nc_oc=AdnxyGP4TsoUJlcsHmskDP0o98xaY29Bh75G7a87p97eKXHpk3Di3tObekcdXOQdWjY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPbCZqpFplV0Dm_YuA1O0aRo_tvoXKc2GgjqI5_doZ6g&oe=69AAB519"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU-zmxYJw-QQ7kNvwGQHf_B&_nc_oc=Adljoqds5uweKAkAQxMoPaXGlbweuG3UZfQp8WzDVYvIKzpR5qyuONDr0-KnV54jR30&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYaasseCjvGLiTCZxla8ei6WHnlC9Xxj0N-4s-dVBA0g&oe=69AAE65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaIR7GvOEJAQ7kNvwGUyhAS&_nc_oc=AdkEXHNzxlAcdG1limyddcnC_odNe1_fFQonbBNDnd7nh1alqai4rpQfJvaKPeHhpbI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMrhHlit8csesiTmfZ0y5bZa1Eicrj5I3qKL07fwPmwg&oe=69AAB6DD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_t
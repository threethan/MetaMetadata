1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZuYRWtfzqoQ7kNvwEr9KVr&_nc_oc=AdrCYs3J4nLt3NPLGXmmTgukbksiK4uRqW1Y58A47mF2g17CgQ76VyOh_GuOyitJa6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TjqW5gW5gt-251gfDRsqmtFHQT7a0TLYTsqPK2GGBnA&oe=69E4BCC5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWYdfrDxUh0Q7kNvwHPFpDK&_nc_oc=AdoAwuqMeBKRvaP0CIInFD2RsEKU1Gito6I9sGfRQ7U-XLf-Lqlj5aORLZDfac37In0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rzWnarz9PHx_TbKJUMRlBT1bFUy0L49kBJw_MLq5WGQ&oe=69E4B7DA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8ZQH7UK1GkQ7kNvwF0ZZf4&_nc_oc=AdrgonMnziftCe7jIr1ObcYrBDmIfmSBfVD2oUN0s43EyU7gclDx6qCxG5tmoJ01EJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oEgg38hXoVlGF-GbWOcfXvI172Kmjc5LppNWStGc7mQ&oe=69E4B719"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kMk9taPjcwQ7kNvwEQYRSF&_nc_oc=Adr4eqEXisIBvYJMshm2oTWY_kwUYG9sutqk4ncKJNsZvJGW6efoQcA3KO525TA_ho4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wZK4h8TALUUO5C8ZUJsfxd2hKEX5LpsooWSZBqNBF2g&oe=69E4E85F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knBa83hCtmcQ7kNvwHcK0zG&_nc_oc=AdrYqNlue2zXfhmltU11oGuCoyJn9g2DeJhkxJJpKclYoXdE0L5yBuoNKbO_VAzxhsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A7z-5DjoWlXP1zxEkef099NKmYaBNxkW1ERsNrqRLAA&oe=69E4B8DD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
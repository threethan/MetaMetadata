G4Q&oe=6AF334B6"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGfLH-Jc3v8Q7kNvwE-HW0M&_nc_oc=AdoN1hN0vmGQ6NZnyvjborRThSqBa2zcLuf3_gYKMY_gIIXBuDBOL5j7uV7s4wdPseA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-NHTwphBCDRsNkHKmxOqH_0qus0oLCGJZgQv3T4i6gw&oe=6AF33885"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yo3qS49vfcQ7kNvwHMPIid&_nc_oc=AdpPeboLVOHce2PR4OCVrUbPW-9Ze0iQKO2UAIbn4QI0urbAJAHk-ZuGhsheodj5oFI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRo4z51n8r_PlgogHErJvy8wXQxpS9jIZIKbSrkEJ81w&oe=6AF3339A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZp1-suiANUQ7kNvwH0ikL8&_nc_oc=AdohQ_xks8rUepxqCnNcPirW4T-j4JOiJawHn5QPsPFCzVxibpvivaji1L1kv22nJPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1I-oPDsXR0dwxffTKGXfw8oMiJqdEPSqx4aG2VRXArw&oe=6AF332D9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtGi-IfsfS4Q7kNvwFD2XpM&_nc_oc=AdpL8PNDe9N_LOxWmllb7Niu6TSfIvqPa6-rSgt8XV2RvCM325eVgCY2iOlIM4WLzLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPgPsualV07HqLftVE2kEL9POTHo2U0DHrrSTmxAobjg&oe=6AF32BDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG7nvtGZYZYQ7kNvwH11ggs&_nc_oc=AdqXAthUTPw-uUOJtc6cCk1rcl2qgO9z-GPCE0NSNpLIwaYUpCv8UoXjX_uG0raIS3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqBg6ALIzbRUOeY-2nP-h6shvd0OJRvs930IrOPcG7-w&oe=6AF3349D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
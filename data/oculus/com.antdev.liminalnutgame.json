102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drJOEM4QBCAQ7kNvwHHzcnd&_nc_oc=Adm48pHRkF3aEEg8vdwA2xmtS3Q8WloT8wsT4H0O1J48x2sugWNxZbtJPw4GinKLLwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsrw5MFiTHAn_ixRvtUgVRGlnYhhbTuXPEneqYUBoVknA&oe=69A02EC5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3ADecwIObUQ7kNvwFPZe-0&_nc_oc=AdngFBstwbjj5nzL2lkO_-JZgTkSccwPmappc8nO4TSmNG461yGGJRTwaZM2dtdL9MU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvFGeR0PV8yuWsPPbkV1IreMXjClz57fmhfvuLe-imRbg&oe=69A029DA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmde4-495UoQ7kNvwESZuGa&_nc_oc=AdkI3CEbliAdQZyzfSTtG0z14FlN3lK7Jvz5fxQ41g-CJAFjY91XcU-pEO3zREryvmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsaYjAP00ceafW4VPeOFogyOxMzVjmRStG_3y9Sx8mJqA&oe=69A02919"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mCc2Zt0C74Q7kNvwEQPnYO&_nc_oc=AdnwwY-PNh03bulSRyqqC_uoil-KIQnXDwucujmckLrTt6UgFLBBfGsWkFLA8iOLdvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsg4uyTP8tHdQ-OEyA1IAidK1v4Nk-sUW_OnDoP0GkUZw&oe=69A05A5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZmdVGdezsgQ7kNvwGNGtyx&_nc_oc=AdlrS8CixxWKSAFqsXPf8Cq8y_fDVUuxXvpUeWhsZbdXBpmCkZ6RiE1KwIjv9VyCzQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslVg1u6iQdnfG6TFo1ZkUGoTovXq53B-obG5qaVt0gBA&oe=69A02ADD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45
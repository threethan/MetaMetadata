2.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SJSjOef8L4Q7kNvwHN0mTL&_nc_oc=AdoT-FGMfLgpAeWG-WzjKF_SIHc3AwokGRt2QMGIi9gfTiOpq8dDnX_FA_oxmMj0SFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HpffpTmoveb_x97NUGrU6LB9emBkIMtwQCUz0vkG9Bg&oe=69DCD3C5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49_wpvPps2kQ7kNvwHdfCpg&_nc_oc=Adp3ZzJ9cej4fWP3COuQUHdu6OMlaEYgJej4l6wXbTZUt2Ww6mkQkkFGyGklXM4Hkjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0faiRzoubOd2hNuRMh9a6AqUySaoAITzvR-8tVDHlT_g&oe=69DCCEDA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0B4MVdsAtYgQ7kNvwHYi9f-&_nc_oc=AdqhZssBfg0zUM56nLCr75m7UDjS47MsoHxEadcO4tqVAxySUZ4c2LlIzYKLGWSq21I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2je_R7CP2r-7Jsq_ht1iPnUnccKLEDuE78MgOu4IIXGQ&oe=69DCCE19"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYtTh88dVw8Q7kNvwEjP6P4&_nc_oc=Adr8EooZE8hINuLJZMi_y3DwpSDmtAGLf0vA0AK-UYzWRTrkW2V-OaMw0WpXKdajttI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q25eCVj7ByqLcuRpsWNO24Q9u0wmxyOKQsEjdlEKXvw&oe=69DCFF5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK5mEQ_fGzwQ7kNvwGDVgMp&_nc_oc=Adr545uet3W1u3OOH-V8ckk6IrBvSIHlxRevJJpgLMaQyMq9U9V01XC-CT58TCBbKs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ei39naEpHDPGSKDPFrn_g19A6nQdijA9fscbCgvRVjg&oe=69DCCFDD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
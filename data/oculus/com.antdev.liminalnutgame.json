102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YjVoXjPTOcQ7kNvwEmJRXz&_nc_oc=Adln3shoUv11THOJuDxoXFKMzek2EQWnwb2m22Vvy5M257dKlNIkMxOj0NtjbBYunkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsfBW6ARNfaC58YZlvGfHFwh0IkapwKAdX7E2TNXtHTtA&oe=699AE8C5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsJ6KmFZjWwQ7kNvwFmG1dW&_nc_oc=AdndgTi1c8k_puajUKdj4ZtzuwNejNPKHVSvL0PVXD0vgsQ3LRXWgchc5jwemVPaRUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu9NAjkirXKpmV9K6baCXIquW_wSO2iMKz-qEAjqtZRXQ&oe=699AE3DA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-gt0tjK-F4Q7kNvwE2E4cF&_nc_oc=AdmZMZpMDx-PPw5NUSGbPvkRC2t7Uors5vUpvtx40FIeqp6e_NKiw-GoXsP2WFEtvZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs1V0VeqqzrH1KQNV0R_8SnDotd02drr8kHaTaJt0vyzg&oe=699AE319"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPNkUjMMMs8Q7kNvwHvIWWY&_nc_oc=AdkSN3qGiHDqBJsw58oKd3j5AqHG1aWktlBEbrLlKRifakPL--p-qifsC-2x1Va5UUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft2Xe8aABUcrJ0qMtl2NOM-6EMChK-O1_zaEmgfH6KCeA&oe=699B145F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NHDXEMD86wQ7kNvwFT5X63&_nc_oc=AdlCzf2MaWIF65M7E07yPf0ic3sMBMFjhAMf3vYiChCLIE680wI2El8FZ5KrnrQsKtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvt5JPzJmYtaOq7P0feIRmNlj6YhKBhcJq0pufTJAjeKw&oe=699AE4DD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45
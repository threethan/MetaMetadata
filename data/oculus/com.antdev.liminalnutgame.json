1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itCzfxXLMqMQ7kNvwEA5v6D&_nc_oc=AdrsxGwI1z48Sk0zhQ4yXUlPhcRCznrwmQ6SNRDxEfTeUVgI1BWOnA8_MplH-P8JIOQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f1iETh6EAOeEJvIr0iAq25dVGLYtG4uWl5KnK30Ajiw&oe=6A243D05"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbudBbseCb8Q7kNvwEeu_Vm&_nc_oc=AdqFnI655Z4tm-WHvnNZwC-9OUbRxqu51ts79nRq6wsfWULTCdTkAlVs80Tl8pKKm2o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jf7kl3BGwOKLjJb9Wmthzdn5VNxZHfZRFBXnr18Ih8g&oe=6A24381A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWv-_nrGtFUQ7kNvwFc7CzQ&_nc_oc=Adpvm_r1IhSGDy-WbL-QrGqX--EvRRr_6WQsdy8FnaNoIyGn-O1GTvl8SP2USxFkJuk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fZ7fKfUuAr4XLtNQJuX-wTwhnquZrMuFIpU6pVZRx4A&oe=6A243759"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvyt9iBUnXMQ7kNvwHV5b7r&_nc_oc=Adr7lMhHyVm4ECn8lymANmjfvZyif9P0-A-aSV5D_JTKq1JgsrTQwByCmzWoC50yjLo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LCmVfAxLKLSfN4VNl5e2UBfTGvU0pBanN8ekSEmY4zA&oe=6A24305F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HMap7XCKQwQ7kNvwHFZuD9&_nc_oc=Adp3Ql-ctgjrw3gC3X2h5EYlyMGsTBOX6yuCV_JAVpGWCclvAq29VKqnupdUnIjwuRg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81la-YeD6AuasGQQmGqVdhoUJ3JoY9-XcwO6mR6ed_XQ&oe=6A24391D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
2.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNsXHTeqm0cQ7kNvwGXPDwh&_nc_oc=Adpsqk4yquBQCBOZDyrO4aRMU9h8MB-NFkj5IS_3poVbU8nFFMwsfVRAE10dIsxovEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJAsxYfVqjsLNfTtrLfNTe7EtSTHWyv2XQyq4Qvcrg4g&oe=69C3C745"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEfOBLZeOWoQ7kNvwFHgX0r&_nc_oc=AdpvVS51kS2J-mWGicmEvsQcjWH6RcOS5AZh2nKybwBO9Sz-VXuszwLsUp4saoUPgnQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPPVMH9FwsMbWBjyiUaJQD3IboWNchdO4VODJb46L9CA&oe=69C3C25A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol2VSt8ym7gQ7kNvwGPGDRs&_nc_oc=AdpShqH5Y7RazjFI9g9op9v7ZnfqdbuVDPWu7RU2P1oWIzkMgof5B2jXHv40gHPflm8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDLhAuPuytc52GPgHCUbrtNHww80uEzXDY98JuVGrAzQ&oe=69C3C199"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbhh4qEspK0Q7kNvwHlOukA&_nc_oc=AdoZKqVqmWS6n2WuR3j8WeAdwsks_5dS4B-U2DffYPuqQBsmyIWGzyfAQtxLmqRVsCE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxjvus9pUvRbOjUco1CZjbBXv6tM1s4MZvWGvDTBTSZVw&oe=69C3BA9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk3SI99FBn8Q7kNvwG7R0Ou&_nc_oc=AdpMJxUZVITP22o2IfTxCgdNT9Fq0YHpnfVDitqrdiaeld2uNoT2jeVyE0i38hrumUo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvNyN3NcBMrWWWc6HSiXdIJkBP3cE6wkepZrI7Y3D8Bw&oe=69C3C35D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQhEypIg4LsQ7kNvwG1jEMF&_nc_oc=AdkIFE5JOlV341L7R9UBJIDqTw6T7_mTHR3P3G6Z8BrLVUuZwsHo8deRa0tR-al1XiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSy2M2LltCo-KL4hFQkFI_90p5sU_V-6GF0CJaoqKiGw&oe=69B93B45"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYD-RIEk13gQ7kNvwHq-BWM&_nc_oc=AdlrXWtyM3w7B8EB0iWCruyOMfpFeH5kORQS73WndjXV39HYf0rWNYq4jXK7z83nMyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqt8N_eFAg8l1PHTK0b25s9kAOOMq0apkosBEPogBOlQ&oe=69B9365A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5lW_e4uZlIQ7kNvwHgyYe4&_nc_oc=AdnDqTcAJvcVt5qXcX2_YKruEO10PGi8zG_vPlPhP4t-HnOYitUrLX6_2TjU86FHzHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afygk4b0KTgG_bUDPy5ZJ7uAQNAV5IB2c_5QPHzSNhOuWA&oe=69B93599"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgOYV18w_BcQ7kNvwEIRWse&_nc_oc=Adm2h3GJIaEVyhtkBFq2HCvA3a5gaZvji-gqaxJtIh14xcXhfijb1d8cXUxhBV_1CSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNg8I__bb4OmwUZZhbui_N8n_O7PWpQ6LB0EdSX_YIJQ&oe=69B92E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCQrGr4qLzAQ7kNvwHg9obp&_nc_oc=AdmtYKwCbC0S9NIlI8p9fthqG0ALJTKoaopWNvv7D2mPekj54SH_u0moQtt5X8JkMFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZfKD9Yw0VkXl9At6rTIiMoE8yUmxX1Ga6bbId6vR1JA&oe=69B9375D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
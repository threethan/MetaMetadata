jFg&oe=6A6F2676"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-MtXYmzhfkQ7kNvwGRS3hw&_nc_oc=AdoHqKRG_KEjJC63YxQvb1WuIR6HLC5X0Qqit_gsI-JummBggch5Gu9PhD2Jd7EpBEc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbbCzQTmlX7X89pETIIL7-TVCLSptgWfty0NUUoY6tgw&oe=6A6F2A45"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ86QB6FcPIQ7kNvwEE31Rf&_nc_oc=AdrJsaNF3e0mX1pDijyUYNGRmuyE-Lq4HcBRkSMIwEwB6Wt7jdeQ8nMbj8ZDPuacyMk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxsEeZaHvVkSbwLdar5k4mCI0wrvqQc-vhhWADVrGjzA&oe=6A6F5D9A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f56y4Q9UP70Q7kNvwEl0tAq&_nc_oc=AdpTIf0di6jLfwLFtqAbfoqCq7Zl288LNYcaSTgi6AzMkblDLExN_mN87mh_EI0Dt-k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVwIgjgM9xiufbED_Jwg5MaHXsixnDrLg7k1-Lic6Dgw&oe=6A6F5CD9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6lS4EYLrUsQ7kNvwGH9ZKx&_nc_oc=AdrtWjhqY29W3RYpFBEvHX3XzZ7_ZlDIx-wxEWkkDc6axi-kvAUmhOKDlVXek6WbInM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiYNKuieiXsF-easNf_2w0pjJVmuUE5agyfAL6ak3DBA&oe=6A6F55DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPodx3xWfa8Q7kNvwFiLzxE&_nc_oc=Ado8J1eYv5iLlqC5obEyDVbIrYuMpcIUQ3mB6l_wtHS9GCksZTi_FNS3k03Hq9jtPWQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA087r2ybsxv7c3iD05fwMMzd7Ildj8x8cdk-U7x2OTGQ&oe=6A6F265D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZcNL5mOub0Q7kNvwEEaF0s&_nc_oc=Adq-WXgYb5p_MwunvzCtZxap3tn4x2y2lGNHorytZwUrzlkgJoX6tHUKcy8WUCai2Hc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N5VVFYn1hlLO3Ff5FWpEEGRPv-Yjdi_ebjRSm08E6qw&oe=6A26E005"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbudBbseCb8Q7kNvwEkZk7f&_nc_oc=Adpx1zauBJBGMhBZqeE01Ehl0fx9-iMgnLIBvhcxQOxeAQT-s0C0Pc3Lqn6ZQseTVdg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V15_fRNYVpgMYcKDBqC0Ic5D1k22e0GRcdCIZXUUdcw&oe=6A26DB1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWv-_nrGtFUQ7kNvwHGqeVg&_nc_oc=AdpRdjyyXqGJyNc6l0n3cN7i8O9dln_p5SIsrZ-ebJRAKrnWJK98K-k25xq7iGmki9c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DGz4SYJMd29nDArWJCdik1sSokHI3yAuu9rBGOIILAg&oe=6A26DA59"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvyt9iBUnXMQ7kNvwEGXyhy&_nc_oc=AdrypIRbeD_dLVeipLlkCyOkGklv6rmVfodYYucRtcLUThSuYLsBZZSd0C9CUD_eKD4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8p7VqihOKmyB5gvGirDoEZjWrIG5eGPvpKBIh1A-iFQ&oe=6A26D35F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCsceo81lk4Q7kNvwHNZBrz&_nc_oc=AdogfzW-54Fj7qP5jeEz3vt8jrhcs6Bt3PICXVKk3UFJ6U5i9v90zcqmacJZsrhAkks&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fVHg0hHI9aKLjHMDdCch9xsN1StsiqM_UT7nsqhCUhA&oe=6A26DC1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
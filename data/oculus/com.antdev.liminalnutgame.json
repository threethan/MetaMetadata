5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQhEypIg4LsQ7kNvwGcE0DS&_nc_oc=AdlcH2voNSxbKl7QEX0tw6cux63YS-6rUFj67rKEdvg_0FBuxBzSkrsphEUeClNB32A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzA5Fnv20ML1tsTacVLe3iKNHlgqEs2_d1JjgBgZJ02Ag&oe=69B69845"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maTCc5I5rPUQ7kNvwFX3VsR&_nc_oc=AdkOr-NAEC7iGYp9wkd96G3qiRD3JyXvmRjta7YZqtPtqwi3f4yw-3k_pFe7patlp10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC0htVYZSqiHpjDIfoVYaGSZQ2T4rq6TTUZkyeWwDrNA&oe=69B6935A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPgt0M-_ZkMQ7kNvwHbtDu4&_nc_oc=AdnD7uPabLFWBmraNWct63ZAk_BXKFWtoZmGUxODNSlOK-1GeWWNSkFSebUmWGReoXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy36wzT6PBc8mS5e8FrzH9rILTDh18SbQ_M51xqBw4oHQ&oe=69B69299"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s7rFAK4PssQ7kNvwEXE9zQ&_nc_oc=AdlwbBJb_vsWiSH1O4-nV-9zk6t5ajgM4x_RLGhEeRXVNmWzMRhjtiKQNW-psMwsWWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzcsu-CKe6l5baDz2ctrEfHSMmVUm7eaP45OBMkgJpv8w&oe=69B68B9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2vNcMLzou0Q7kNvwERi84i&_nc_oc=AdlEPUanEFJYq6WN4WhMJy0VQ09kF6xPR1w4C38MfWkxQYGqnrjOI4w9Dyev0xUpnRI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzfhOueod9wZhjcNO9m8LksBfrw9mgvs6TPXTVL9toSQ&oe=69B6945D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
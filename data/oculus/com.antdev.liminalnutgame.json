5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kh6W_kamSPwQ7kNvwHYp72j&_nc_oc=AdlDnUoIWSaaWukmKjS5PHSwkCafF3LIc1IcS3t7En6Vq_uEsc7a82WPSoo3PHZR7kM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzdVdKkYsJFPeif6MK5GCIICPwysr2AAb7SR781H-nw0g&oe=69BA8CC5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYD-RIEk13gQ7kNvwGWm9pZ&_nc_oc=Adn4xGEkYO18SSfaIA-RQdm-yr_-QpxB25Z4Q2QxnUX8u40xRRKJtBKH5JIXpF8AhRk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMKP3Tn1Rju9cUOquc2lGcqhFqrVGTvvhMTqgWNUYjTw&oe=69BA87DA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5lW_e4uZlIQ7kNvwFR3PhR&_nc_oc=AdnvNhoDyy26AC5wORE8glJjwgXRp50ReZBW8Zp9rtELInqL9WSNZCq5CH6AyQGjhRQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY4lqMs4GuJkeRMVwNTiTAemKXpZhJ2VrLSVUTWXUj7Q&oe=69BA8719"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgOYV18w_BcQ7kNvwEO3-qX&_nc_oc=AdlQe-ciTecl2fked6fVVoMMELrwaKspJZlq3a2CnUj4agnXB4esB-n_K6Q5Qdyhe1g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBsxe69L5LtqdazZP9HCk4ZsvPCFTtkeOvew48KlfuYw&oe=69BA801F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCQrGr4qLzAQ7kNvwF7RJKY&_nc_oc=AdkXowgBlniCqCvUKonc6wXlk2k5Sz0LGn4GMAltF2OuRNTo9glJ3iDPlG-hS51uEEA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfweQhp-Y9XUP2i9pF66361ILm8eXcOhABL_-oX5uSVGGQ&oe=69BA88DD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
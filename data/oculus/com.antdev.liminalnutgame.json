HWg&oe=6A452EB6"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXu6cB8QmtgQ7kNvwFCbMkS&_nc_oc=Ado9GiT6FuWdvHihHsLdub8KCopyq-gX2IPw5lE_ZC0udrrIFUaLhXvjntC27dl0Z7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ddyx6EQxAD9ngDePoc2Ixb_ivDPEhiZXusTK6T-LkLw&oe=6A453285"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be9LoaUhgbUQ7kNvwH76yMM&_nc_oc=AdopkCucJebF3FLdtJ0umLKDw3689LvAFVbuoCYdmeJcEFCzV61b0jIfPCpAIRBZgFY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g9PLIIHHZpe-ZQTZlFG8uLxqbBgbdLpcc-6eX1sxMHg&oe=6A452D9A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGnwuntTRYgQ7kNvwFEBMYK&_nc_oc=AdrCOWUwFcEaxGcHgIVWzN4uqokirKSQUHasL4zTvK1cNrEYwwmg391il8eZ2LdJtf8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N1OJ0Wss0xU0EpbgpyBMgnNMKc3l3gobD0mLpKcbgpA&oe=6A452CD9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dlqKo1OE5YQ7kNvwGowT9j&_nc_oc=AdrcWyaeC7ymM9uNhbDY9447gYV4LaL4vQ12rY2veYJWO3UEDwBCnygHvpJtN7q3h0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fOD7OPvQ1abs-cRkDhHTpmLxDH_njd_Xkw3gGhwdyEw&oe=6A4525DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVU4EYinZRgQ7kNvwEWu8JL&_nc_oc=Adpw_i4O544XghmKzB5s5asl5hVvo4HAcu4zfC6Le_hHuhpZldpU0qjMRhGbafPXvh0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QHSbkmOcmJ5iipjzFU7ptjAiXtoDavh9dc-lfezdBXQ&oe=6A452E9D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
5Qw&oe=6A75F636"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR07EqRN1NwQ7kNvwFGkQa4&_nc_oc=AdqcRvCdkpe_SkstbzzI9iGRaZTCVdjOrZHM44RYubMOeAtUoZwxUzw9kiYXbEfnndA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsWgnydNEr1Vhzl7RvtndMyVE_N8uhjaXy8nwlJB0hMw&oe=6A75FA05"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bpWCIUp4RUQ7kNvwE2CULV&_nc_oc=AdqvxkEWPmd-NSP9E7yE1HQiKVVzAmu07YVNME1qiQBAQkeoBQDz4gNTrEGIO2yIx9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMYHRlLhT36K1Txj7DFkm2_D-MQz00r65KB9HyqSCrGw&oe=6A75F51A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QqmqlBZpdEQ7kNvwFFEwhA&_nc_oc=AdptRzShtVE88jM0Wg9g2MfWimF7yoeDhFYKP5arYNqaPPNHFO7I6ocwei3Pntl8k1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG70utc_gFS74kZBvK0h6EavVjr-MElpdhA1NGthThIfA&oe=6A75F459"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvYld0hHXpoQ7kNvwECHwbo&_nc_oc=AdqJAHrh1ysf4PnuH-yWdcrtDzWIT3ETvUBlaeM3nU8rejZjZLQWQCTUbJulKWk3JkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdWTWyPCEq5BJp517H9aDMH623U_EUvYJ6WmvOv4KY4Q&oe=6A75ED5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLaocniq4fwQ7kNvwE1ILFU&_nc_oc=Adqowz8fJSo57RB7rnwsPbS4FUQ4mlf6RDw2a9G0qZvzgwJmeTNAxOF2746C6kC8N14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyxfsYI7mw-zfUCsc_YhlR_HagLvHU8q_2v185WnZgBA&oe=6A75F61D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
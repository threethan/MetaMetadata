1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHFMydKTxmQQ7kNvwFRWrvc&_nc_oc=Adr1jnU_8Ee4N8Vy4YOqpTCiXuukZQZPW15Apwyhei0Eoz6zeKgZVNLsVDAID78sFI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45Zv2FHomebeRmGtSsDpUqo0ywN40B7wGxlkU6YG2OkQ&oe=69FF5305"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yOUlOHv4ZMQ7kNvwGZBSVB&_nc_oc=Adqa9eR_faAyShbKlVGi0AF_vhJTEkQGuS5QyPLf-KvKXFuEqpv1WXkbYT663kPp_BQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FLLogBmlXn6dQZ-ULg4N8xuZHRkFNUgDNiCr2mQVOUQ&oe=69FF4E1A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0znpIkWCGsQ7kNvwEQ77Rx&_nc_oc=Adq2Uw06RBv02tLg1lHF21fTzl1k4h5QY4jSdaekM03ZF7WplbiYwLAz29bxX3NIU9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l-_fZ1_dvk2v3oAMFbxm_0L_ruO0LJm5hrj3zhou6AQ&oe=69FF4D59"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jokw5O0P2scQ7kNvwF1Dv1n&_nc_oc=Adr2--hFoJxsOulxUK5H-GVgG_SJNtUAighlfPI1Q6v3bIFYuyzr3c_sP6ts5PqPAsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ttV29KXxecvE61YJtZ75XjWPRk8L1cXCLm4ZWNwYc-A&oe=69FF465F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9kTs9ke77sQ7kNvwE0AeWQ&_nc_oc=AdrotioS-emIBykm1TQX7VyRuQmY2Ai23MIzq3FnPG0Az9NcJejXwoAZwUyEmWSMvM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ns-sdvEmlJgUzVMktVxA2Hsb_yXV1RiKvbsnXl3s9zQ&oe=69FF4F1D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
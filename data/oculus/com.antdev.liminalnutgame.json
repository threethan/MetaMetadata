RGw&oe=6A662436"}, {"file_name": "Screenshot 2025-11-16 211008.png", "id": "1121275990201878", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT251LT-T5oQ7kNvwH3Efnv&_nc_oc=Adp5TguHEOeYiEXv-QBfVjAAshoDLq0FWPWi0W8Ez1rqDmjGdqECtnkq7w8FtZBdOhk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXH1N83MYHjGWTck6Zulj1yXEVhbLicuT0m108iuGnrg&oe=6A65EFC5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTizwFwuwcMQ7kNvwF3tRby&_nc_oc=Adqr6jpFBNi62lzjI1i2sOFLTFHPC-N6yFQWi-mDjI7O6ZNp9pDoSv0O4x6_0u2XT4Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ7hngtn4qY4rvMKH4oBWFKm6q7HpH4MkugUmWYuNXYA&oe=6A66231A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpcvSMb4OeUQ7kNvwHAa8OZ&_nc_oc=AdrdVkMw3FaleLsxDohLQ-tEZEjSFbSSOvUoa8S4O2oUtlSyS8BnXz1rE5povhaym7w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbbP3VYeyVExMjgMlEQF3Fp6GRiftW8AiDr3pcCyesIA&oe=6A662259"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M99Ywv0GaFIQ7kNvwEWgOKr&_nc_oc=AdoOghNIoPjK-azDlmzdS2ZPB0_46bVcYp23nyFNMHl0Zxx4PHlqGWh_YL7sg23ZbyM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfARR2wSHJuyJFSL9u86cDhR4ur5mIumXw1aYdPMmqDg&oe=6A661B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGPwNSJdu-4Q7kNvwFTOATJ&_nc_oc=AdpSyodW0ObabHBne23wCu4T7YSUnUNQpghoS0UAy2-6tLGhRKyYdyeAsLEXqPygygk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2LU4-_FrbrfaMmoblJ3Hg385QbmP5sraFD8ob-kH40A&oe=6A66241D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev"
1.oculuscdn.com/v/t64.5771-25/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZcNL5mOub0Q7kNvwFudsYd&_nc_oc=AdrzIPe_X8EV1KOKmc2e_Og1ogMTFIl0jeOaJaPXnItrL7aAHwCoqYzIM9wQuGJdLHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t0q7hWj58CUBckoleVNsuSo1lNuG6MCwwqr-4DAbqdg&oe=6A283185"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUiaF6jGeIAQ7kNvwGvmuSd&_nc_oc=AdrY5CYRbFoGR7tqA48CCug9U_SnPiA6ULMm6QYShnWaF4fE3oAtrlLNPOA5HgBbr6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gHxKUNHVo3Gvd7gDCsELBI6hlcQ-pL5jv9Yg7xqJ1ww&oe=6A282C9A"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K39Mmu_d8sQ7kNvwHkMD5z&_nc_oc=AdoQRL9kMrNZUYTEddNOYN87SR6WSB0NMRCqhsWUjdSgqdiet8s45cDNVgvW4XW7HTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ud1Hd92ZoGDO4Q0AvEkjlmTvf714Xm_YCTRgOY5rrFQ&oe=6A282BD9"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2McsWuRJuNcQ7kNvwFkI76I&_nc_oc=AdpshW3KQ52tvevGgJ4t15Lld9uoJmF-r3eAhV8xUm4iKxR-pI89GracY2xtL8Vlkkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8waitepwFxsKgSPUwgekJN_GQawZaF9i_hNpiVdseXuA&oe=6A2824DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCsceo81lk4Q7kNvwHStQgh&_nc_oc=AdppZF4mkaEID8-M2d9_NQpbzMLxQcm76Dsf-NFfRYCopNA4a2wMLi5LxeHDcmuHxx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-an3txq36ppGVsplEnfyBElXh0aO0VKjlKv99RFy_v7A&oe=6A282D9D"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_ra
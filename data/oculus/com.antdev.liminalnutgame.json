5/499296127_1121275993535211_7862140905568129073_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnyXPzKW7WAQ7kNvwFE9z-L&_nc_oc=AdkJ-rlS5VaMQTSqoh8wUVvSPsxjYUF5VV_iocx6rXxlVkdaJYyiPJrmFO5LmiifFtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNWQeOPJQ7SH--5KS_gvnMtnWjSCES6HB7UDzeyrxyFQ&oe=69B000C5"}, {"file_name": "Screenshot 2025-11-16 211108.png", "id": "1421766882708448", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296214_1421766886041781_1939832000218159526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu8SkMaLlSUQ7kNvwFVPR-y&_nc_oc=AdnPOKSzgica8L3EDU5y9TGWy1Mq2DL0ZHH3serUd_wz65Gwj_ZfZJZ3jW0TXal6QLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9qjvyll89xOezH0wEBvQhAltKkuC4Sets274Tb-blPA&oe=69AFFBDA"}, {"file_name": "Screenshot 2025-11-16 172346.png", "id": "678595735324175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830815_678595741990841_6557123804411198938_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BraqQnvl8-cQ7kNvwFqu1Hg&_nc_oc=AdmKAn3rEV43KJEy7n0Ue9VMKwYweMBzx7LJy0C911Mi-rtkPXiEeHk26L8dX22VLNE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRwnt_xagAaMudgCSdWk-zQb1pcb4cV09PznFuNQTWUg&oe=69AFFB19"}, {"file_name": "Screenshot 2025-11-16 210904.png", "id": "4111287692472059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296033_4111287695805392_5526222534182734005_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L30lvqkDB6gQ7kNvwFh3MpO&_nc_oc=AdnN0RZF_25lERckbC22SX-UXavVxLjvSZMWTszpBmu-Cq9LT54n_hroc6xE73yL87U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrAHSBG5CsKsmuwNAQ9GdMcBtql3UZScIOFMmlzF-fsw&oe=69B02C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LIMINAL APE 7.png", "id": "808212475378762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_808212478712095_1828740972187102867_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xnpKaRhrlsQ7kNvwFHWQUm&_nc_oc=AdmPjBMiq-mXX0gg7n8aQB8o-3-P9p-W9D4TQZb_jP1qvuWDfQ5u_OeKn9ZYtcci8po&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgAlnbLZT4tEH3ExlGabifB5xYs4dJXf3EnJuAJdQo_Q&oe=69AFFCDD"}, "display_name": "Liminal Ape 7", "keywords": [], "long_description": "Enter the unsettling world of Liminal Ape 7, a liminal horror experience set in endless, maze-like backrooms where every corner hides danger. Explore vast, eerie corridors as you hunt for scattered gold, your only means of survival and progression. Armed with grenades, you can fend off threats, but beware\u2014monsters are fast, loud, and relentless, hunting you through the shadows with terrifying speed. Every echo, every flicker of movement could be your last warning. The atmosphere is tense and surreal, blending claustrophobic spaces with the unnerving emptiness of a world that feels both familiar and impossibly wrong. Will you navigate the maze, collect the gold, and survive the horrors lurking in the darkness, or will the backrooms claim you as another lost soul? Strategy, speed, and nerves of steel are essential\u2014every decision could mean the difference between survival and becoming just another echo in the endless halls of Liminal Ape 7.", "short_description": "Step into the eerie, endless corridors of Liminal Ape 7, a liminal horror adventure where gold is your only lifeline. Scavenge treasures, craft chaos with grenades, and stay alert\u2014monsters are fast, loud, and relentless. Every shadow could hide a threat, and every turn tests your nerve. Will you survive the haunting backrooms and gather the gold, or become just another echo in the endless maze?"}]}, "developer_name": "ant", "developer_privacy_policy_url": "https://sites.google.com/view/liminalape7/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalape7/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": []
=1-7&_nc_sid=6e7a0a&_nc_ohc=ub_Qbx7A1H0Q7kNvwEpmEEY&_nc_oc=AdqZLzsk3IFXwyUR7hUKhVf5CGmw3KjFhWwEv0qDy4o7HC7Xi-DTo2zxSwMwfxJPOsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmxKniKdbP-actJ88LJk4KfXuh5fAvP_DzmsNZQfyW3g&oe=6A620B22"}, {"file_name": "migrated_image.png", "id": "198526064742498", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974522_2383939695155107_631359715770630144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72m3QxDLjAgQ7kNvwFH_BII&_nc_oc=AdpehQ4_p7yXAkYU93ahGENS8pAtaj_SiKZTtmHM2df7bLO5DZ19vED53YzUnFbZ5fw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoMqMNCMsvsJUhRQo5-YasNdAES4m0htOUSGO_Gq7ybg&oe=6A6207DA"}, {"file_name": "migrated_image.png", "id": "1044829839229730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031311_1512947312177404_5062727583884378112_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlrwljJQLYIQ7kNvwFwOZW6&_nc_oc=AdryPdlQwVImlYk8dSW_WrzL1Dtx0IOpHuoLdjr9dr-oR4GAmPWAjEphuPrcTh6p4y0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1ZtnfONUbACVOB6Im_IV8WmvwFRhh_LWrD43NmCk5hA&oe=6A622B23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/JPY9Gg", "id": "496854654200319", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982631_496854660866985_2400507082009739264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrNfL1vo7O8Q7kNvwGNdQfc&_nc_oc=AdrBBcG8DtkknMTq9zEAEQWcDsAZH2OVpcaJAGbgFC-uZYC8ztfPtpk2n3t6ej8rBRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn-41miREsx908QC6jQzIkFDVtCXMGCgALj6clm49V5g&oe=6A6228B3"}, "display_name": "Lusail Stadium VR Experience \u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629", "keywords": ["World", "Cup", "Qatar", "2022", "Lusail"], "long_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nIt was in Lusail where Qatar\u2019s founder, Sheikh Jassim bin Mohammed Al Thani, lived in the early 20th century, drawing up the blueprint for a new nation focused on the human and social development of its people above all else.\n\nThe centrepiece of Lusail City, a newly built and truly state-of-the-art metropolis, the venue will write a new page in Qatar\u2019s history, while paying homage to the rich past of the country and region. \n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629", "short_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629"}]}, "developer_name": "Soluis Technologies Ltd", "developer_privacy_policy_url": "https://www.qatar2022.qa/en/privacy", "developer_terms_of_service_url": "https://www.qatar2022.qa/en/terms-of-use", "publisher_name": "Supreme Committee for Delivery & Legacy", "support_website_url": null, "website_url": "https://www.qatar2022.qa/en/home", "category": "
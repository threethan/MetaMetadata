=1-7&_nc_sid=6e7a0a&_nc_ohc=9ry0Yv09cLoQ7kNvwEMmQzs&_nc_oc=Adr6bK6K_4XxpfRILmYwfcmKp-Kdi0YObUI8qJMMULAjbJrFutoLBkXNPn2NbYjOFbI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxhhiOE0f3U9RuaOy8DI4eDE4-uAGCo6gLcL89F0nRrw&oe=6AA15322"}, {"file_name": "migrated_image.png", "id": "198526064742498", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974522_2383939695155107_631359715770630144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaubSu35wAMQ7kNvwExt1HX&_nc_oc=Adooqw1qbqN21Jxqk-UAslXve7wAFZy5RvREe2syPSCi4e86TQLneIPWGhqi4HbyPDE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUSLbToT6Br77Ib05vyvFmjb_D9wKOwfA-BQ2qs9sZkQ&oe=6AA14FDA"}, {"file_name": "migrated_image.png", "id": "1044829839229730", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031311_1512947312177404_5062727583884378112_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9O12OsrUWgQ7kNvwFHQQQ2&_nc_oc=AdqUZcMNAlWQt8hEGLAzNRRDVoZds-8U1YtOGR2llBHt5DB9Q9cSt6PsdbxzlKCLbf0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3rA41pfADoDAQlJ_CvBk8ODHQt3VuFE36WEDmhJ1ffw&oe=6AA17323"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/JPY9Gg", "id": "496854654200319", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982631_496854660866985_2400507082009739264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTLeV0zbJ9cQ7kNvwGvnoPF&_nc_oc=AdpZTGxOacH_We8xaTwqJCLNJFsUTalb_Er2Oxco0V6neHqDXaPi9WayWJxZXCQI_PQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQFKmSL-HZhlEnZnRk7-6K1DvEINb62wPobhE7VKYnEQ&oe=6AA170B3"}, "display_name": "Lusail Stadium VR Experience \u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629", "keywords": ["World", "Cup", "Qatar", "2022", "Lusail"], "long_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nIt was in Lusail where Qatar\u2019s founder, Sheikh Jassim bin Mohammed Al Thani, lived in the early 20th century, drawing up the blueprint for a new nation focused on the human and social development of its people above all else.\n\nThe centrepiece of Lusail City, a newly built and truly state-of-the-art metropolis, the venue will write a new page in Qatar\u2019s history, while paying homage to the rich past of the country and region. \n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629", "short_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629"}]}, "developer_name": "Soluis Technologies Ltd", "developer_privacy_policy_url": "https://www.qatar2022.qa/en/privacy", "developer_terms_of_service_url": "https://www.qatar2022.qa/en/terms-of-use", "publisher_name": "Supreme Committee for Delivery & Legacy", "support_website_url": null, "website_url": "https://www.qatar2022.qa/en/home", "category": "
=1-7&_nc_sid=6e7a0a&_nc_ohc=T2wVeWLWG68Q7kNvwFwW_Pa&_nc_oc=AdqOp6Pbi9sWFYQ_cvSCOWTpifNySTn2GiJ-vubU5DG6puAeP2DyyOVMpApeRka8GzM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1tPkqyUbgUbwXYbJwG8P2fcHSnhAGSbShywWrUXUSjg&oe=6AC91862"}, {"file_name": "migrated_image.png", "id": "198526064742498", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974522_2383939695155107_631359715770630144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tKuQ0UpSF0Q7kNvwHqdypt&_nc_oc=AdoZyat295tP6ncszfPVAMhhpSjkN-q3sqTiS9kAqpuYITSKsg5Fadl98br8lwT_3_U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyU6Tu5BL15hI3ch6sZ5hhlAY3rb2qyyvxQ2eTgrAYgw&oe=6AC9151A"}, {"file_name": "migrated_image.png", "id": "1044829839229730", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031311_1512947312177404_5062727583884378112_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP0aOkrYghIQ7kNvwFiXpqe&_nc_oc=AdqyAtO5347b_XUl7IpEH8a8hCwWgiUil8hj8LXTfHCD0ie7QlpdcDHrqrKB1NyMLtU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMvQ3N4u7BCSrFcyTihoo-3qrBBpPKro2X8NfE89v2Lw&oe=6AC90023"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/JPY9Gg", "id": "496854654200319", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982631_496854660866985_2400507082009739264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4Qloq8rHo0Q7kNvwGMRapz&_nc_oc=AdoesuUu7jztS6SFnoKPtLHRZMwghfYe-vnOh5_SNfEt9Q25idTeioBYAskX1mClrZQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdXpUKv0C7SueBd-mmV73LXHXVcpKYBhoH1MGjgWpk_Q&oe=6AC8FDB3"}, "display_name": "Lusail Stadium VR Experience \u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629", "keywords": ["World", "Cup", "Qatar", "2022", "Lusail"], "long_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nIt was in Lusail where Qatar\u2019s founder, Sheikh Jassim bin Mohammed Al Thani, lived in the early 20th century, drawing up the blueprint for a new nation focused on the human and social development of its people above all else.\n\nThe centrepiece of Lusail City, a newly built and truly state-of-the-art metropolis, the venue will write a new page in Qatar\u2019s history, while paying homage to the rich past of the country and region. \n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629", "short_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629"}]}, "developer_name": "Soluis Technologies Ltd", "developer_privacy_policy_url": "https://www.qatar2022.qa/en/privacy", "developer_terms_of_service_url": "https://www.qatar2022.qa/en/terms-of-use", "publisher_name": "Supreme Committee for Delivery & Legacy", "support_website_url": null, "website_url": "https://www.qatar2022.qa/en/home", "category": "
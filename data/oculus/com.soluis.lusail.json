=1-7&_nc_sid=6e7a0a&_nc_ohc=RRyr0mG9vaEQ7kNvwFB3WhT&_nc_oc=Ado0nU9xQjthcq9Rxj0BAn4gpNmIUJVVHTUlCpXP__H3fvpGbBY4zA0k1pzeAKg-1yA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99gtnddOz-2tms1YfjDlxzpaGpOgBveFCTGkVR7-auNQ&oe=6A2414A2"}, {"file_name": "migrated_image.png", "id": "198526064742498", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974522_2383939695155107_631359715770630144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBR264OUI9MQ7kNvwF5Aqga&_nc_oc=AdpR_chy2lEfd-y8HpFM2ShHCV69K-GjsNVFRjLd4_lLlEBpn2POUgi4wgkD5mAA8e4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sgT0zLE6D17JjDCNu90O-TwiOaveNwi5Ugl-tbFnywg&oe=6A24499A"}, {"file_name": "migrated_image.png", "id": "1044829839229730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031311_1512947312177404_5062727583884378112_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pJQS5AsX88Q7kNvwHYv8e6&_nc_oc=AdovZ7jVvlR83YhXV3Rn4XtFQgu3eqsm7Nl_f_kEoSMeHJ1Ykfh4GZm50nX1rEXYsRQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qPBOCPLEP37PHmEc6cPWBHOtC7nOudso8B82vHTZYHw&oe=6A2434A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/JPY9Gg", "id": "496854654200319", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982631_496854660866985_2400507082009739264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztUoY0W8Lt0Q7kNvwHELpWn&_nc_oc=AdoLEDYlQokz3ex6st9PzAAtS9Km0NWKfv_8ycGh5d7EP2exKzWjVKN7RPVGHcCjoSw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84Ha-pKK8o0XqoeQ6rQJ2M1XoaOXibdNdSCWd0BVsY-g&oe=6A243233"}, "display_name": "Lusail Stadium VR Experience \u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629", "keywords": ["World", "Cup", "Qatar", "2022", "Lusail"], "long_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nIt was in Lusail where Qatar\u2019s founder, Sheikh Jassim bin Mohammed Al Thani, lived in the early 20th century, drawing up the blueprint for a new nation focused on the human and social development of its people above all else.\n\nThe centrepiece of Lusail City, a newly built and truly state-of-the-art metropolis, the venue will write a new page in Qatar\u2019s history, while paying homage to the rich past of the country and region. \n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629", "short_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629"}]}, "developer_name": "Soluis Technologies Ltd", "developer_privacy_policy_url": "https://www.qatar2022.qa/en/privacy", "developer_terms_of_service_url": "https://www.qatar2022.qa/en/terms-of-use", "publisher_name": "Supreme Committee for Delivery & Legacy", "support_website_url": null, "website_url": "https://www.qatar2022.qa/en/home", "category": "
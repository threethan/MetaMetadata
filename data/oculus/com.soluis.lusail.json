PH3h_CQ5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7DFQ593-4BfqNfKIWM1eyErfi3jgywfSIjRlt_UXb7A&oe=699D9BA2"}, {"file_name": "migrated_image.png", "id": "198526064742498", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974522_2383939695155107_631359715770630144_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3v0F3cN6ZwQ7kNvwFYG0fy&_nc_oc=Adl7g-V8h2Gdm8cH1aS-FgjiggtgOOrry4ukqsqb4lG3dH3da5os_qRGitxjgHxRiJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuA_KNC5XW2kx91ooOi9Mx-Yb3Awdr3OLAruwzhpgXs9g&oe=699D985A"}, {"file_name": "migrated_image.png", "id": "1044829839229730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_1512947312177404_5062727583884378112_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oZsndOi4tMQ7kNvwFyi7xg&_nc_oc=Adl1a3JWpm8NnF3LJR2GSLcPdieWHoSfBNs6iMBOlaI3mpyENkRvc9SWpoz_-nUD0ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4KZoSzvwaWl3vHoXrphOPHR2Wmh0fjfWBxlYMGWNj3w&oe=699D8363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/JPY9Gg", "id": "496854654200319", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982631_496854660866985_2400507082009739264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUPGtgjd5NYQ7kNvwHQyqQn&_nc_oc=AdlgcwhV8s7dFb8oYBxhUqYjBCP6Okm9vjGuo4VFtfMkNCF7D8dk7PmDylrhiAP2FiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4vChbkNgJFvp_I66t6ukLUdSmDh7xut5a13QNivUpQg&oe=699D80F3"}, "display_name": "Lusail Stadium VR Experience \u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629", "keywords": ["World", "Cup", "Qatar", "2022", "Lusail"], "long_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nIt was in Lusail where Qatar\u2019s founder, Sheikh Jassim bin Mohammed Al Thani, lived in the early 20th century, drawing up the blueprint for a new nation focused on the human and social development of its people above all else.\n\nThe centrepiece of Lusail City, a newly built and truly state-of-the-art metropolis, the venue will write a new page in Qatar\u2019s history, while paying homage to the rich past of the country and region. \n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629", "short_description": "Get a front-row seat for a match at the Qatar 2022 final stadium. \n\nOur Lusail Stadium experience puts you at the heart of the action in the 80,000-seat arena, which will also open the historic tournament.\n\nThe Lusail Stadium VR Experience is available in both English and Arabic.\n\n\u062a\u062c\u0631\u0628\u0629 \u0627\u0633\u062a\u0627\u062f \u0644\u0648\u0633\u064a\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629"}]}, "developer_name": "Soluis Technologies Ltd", "developer_privacy_policy_url": "https://www.qatar2022.qa/en/privacy", "developer_terms_of_service_url": "https://www.qatar2022.qa/en/terms-of-use", "publisher_name": "Supreme Committee for Delivery & Legacy", "support_website_url": null, "website_url": "https://www.qatar2022.qa/en/home", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genre
-7&_nc_sid=6e7a0a&_nc_ohc=CRIjdS0eGX4Q7kNvwFhR9hG&_nc_oc=AdlWAhQsLRraWAbgQo4WfaYZWrfXdAiw7nb05F9vndEF2Fo3ZlvxTkPsci4DSce0uJE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlcbUmqsdiJdPoSdUPTbTlq8gmaT3aoCZzmNqAESJ9Fw&oe=69BD2DDC"}, {"file_name": "VP_Screenshot04.png", "id": "3821418694783511", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974816_3821418698116844_7113988467098878859_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2odInElzZ-MQ7kNvwFuSG8a&_nc_oc=Adkx0B0oasOFIMt_kWKYsu9oOscRmyMJ36lMyhUXa8tUMq2EDZmktXdq-WOzM-khwbw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTgfhOBqmOF8GxdnCUKBiFCzt7emDDSywp4VLRhn5J9A&oe=69BD49B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Video Puzzle VR", "keywords": ["puzzle", "media", "video", "player", "cat"], "long_description": "Video Puzzle is a relaxing and innovative virtual (and mixed) reality game that blends the challenge of puzzles with the magic of beautiful videos. Step into a calming 3D environment, where fragmented video clips are waiting to be pieced together. Every puzzle tells a moving story, bringing mesmerizing scenes to life as you solve them.\n\nWhy You\u2019ll Love Video Puzzle:\n\nRelaxing Gameplay: A soothing experience designed to help you unwind while engaging your mind with no time challenge or score.\n\nImmersive Stories: Each puzzle reveals a unique, dynamic video that feels alive with motion.\n\nDifficulty Levels: From the start you can choose how many pieces your puzzle should have, from simple to complex (more than 130 pieces)\n\n\n", "short_description": "Relax and build puzzles that tell a moving story."}]}, "developer_name": "EVRESNCE", "developer_privacy_policy_url": "https://www.evresnce.com/videopuzzle-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://www.evresnce.com/video-puzzle-vr", "category": null, "comfort_rating": "COM
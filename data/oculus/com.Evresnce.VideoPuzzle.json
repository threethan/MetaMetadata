wmlvE0b9cHRq57B4eggDnGv6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjBnWNSOcuBsvW3s8GKicTKm_lz825dbo4Z-kRItDXeg&oe=6999955C"}, {"file_name": "VP_Screenshot04.png", "id": "3821418694783511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974816_3821418698116844_7113988467098878859_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQNXZxsk5dUQ7kNvwH7HXZ1&_nc_oc=AdnzoAUwicJLhLmJp8F2LJJXe1_hEKTtbB1gKatT0MudcYwo6Edfh-LRfQONifz9EFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsap-9M7JidbsYUaBCHQaGSpYU2ZeeN7z3cpaF8bVylYA&oe=6999B135"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Video Puzzle VR", "keywords": ["puzzle", "media", "video", "player", "cat"], "long_description": "Video Puzzle is a relaxing and innovative virtual (and mixed) reality game that blends the challenge of puzzles with the magic of beautiful videos. Step into a calming 3D environment, where fragmented video clips are waiting to be pieced together. Every puzzle tells a moving story, bringing mesmerizing scenes to life as you solve them.\n\nWhy You\u2019ll Love Video Puzzle:\n\nRelaxing Gameplay: A soothing experience designed to help you unwind while engaging your mind with no time challenge or score.\n\nImmersive Stories: Each puzzle reveals a unique, dynamic video that feels alive with motion.\n\nDifficulty Levels: From the start you can choose how many pieces your puzzle should have, from simple to complex (more than 130 pieces)\n\n\n", "short_description": "Relax and build puzzles that tell a moving story."}]}, "developer_name": "EVRESNCE", "developer_privacy_policy_url": "https://www.evresnce.com/videopuzzle-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://www.evresnce.com/video-puzzle-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
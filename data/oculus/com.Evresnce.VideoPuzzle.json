_2054110266116046981_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOGbuDywq-gQ7kNvwGapTY7&_nc_oc=Adr3geIFzK8B2PfNM7yjcR9xPxct3jWPY0yNv-COJdfn0QlXb2T7_SUJbHuP4g6qtR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SK4Hzz4Tu0l6vKFw9XCT-vInv1hH7TUVe2l6wUUFaLw&oe=6A1DA39C"}, {"file_name": "VP_Screenshot04.png", "id": "3821418694783511", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974816_3821418698116844_7113988467098878859_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NtcOrgQRDoQ7kNvwH_B-PA&_nc_oc=AdppaPx2my8sgof1sHSwK56b5LBfQXen6DgPzQGIU1Ud8LMLiBRTk0oBpyywwpiey2s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sgPqUS4iestZCnPBc0FvGaySr7TIn9lhKCUsyoje7XA&oe=6A1D8735"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Video Puzzle VR", "keywords": ["puzzle", "media", "video", "player", "cat"], "long_description": "Video Puzzle is a relaxing and innovative virtual (and mixed) reality game that blends the challenge of puzzles with the magic of beautiful videos. Step into a calming 3D environment, where fragmented video clips are waiting to be pieced together. Every puzzle tells a moving story, bringing mesmerizing scenes to life as you solve them.\n\nWhy You\u2019ll Love Video Puzzle:\n\nRelaxing Gameplay: A soothing experience designed to help you unwind while engaging your mind with no time challenge or score.\n\nImmersive Stories: Each puzzle reveals a unique, dynamic video that feels alive with motion.\n\nDifficulty Levels: From the start you can choose how many pieces your puzzle should have, from simple to complex (more than 130 pieces)\n\n\n", "short_description": "Relax and build puzzles that tell a moving story."}]}, "developer_name": "EVRESNCE", "developer_privacy_policy_url": "https://www.evresnce.com/videopuzzle-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://www.evresnce.com/video-puzzle-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8586912771429098"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "953362227461362"}, {"status": "PUBLISHED", "id": "769993822559756"}, {"status": "PUBLISHED", "id": "4048193985468179"}, {"status": "PUBLISHED", "id": "1021268453148961"}, {"status": "PUBLISHED", "id": "1524832084851631"}, {"status": "PUBLISHED", "id": "585802097774328"}, {"status": "PUBLISHED", "id": "435552422885339"}, {"status": "PUBLISHED", "id": "2004686216682310"}, {"status": "PUBLISHED", "id": "2004029603344638"}]}, "baseline_offer": {"id": "1021268453148961"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "953362227461362"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9166773486776354", "version": "0.1.6"}, "id": "958464666108620", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8586912758095766", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9166773486776354"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name":
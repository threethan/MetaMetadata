_2054110266116046981_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_8-vcHLieIQ7kNvwHj-Jn3&_nc_oc=AdqeMl56A2cboyTDnS5EZcQyhDbKB59QXfcsaG2tN8aJX06WH-ZU7XPiQcgcWWjvtYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CM9jnJKi0pyUjsgqAKXHG9VfXEwJysQBkSJJQXMfTtQ&oe=6A3BF61C"}, {"file_name": "VP_Screenshot04.png", "id": "3821418694783511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974816_3821418698116844_7113988467098878859_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxO6Zcuk3w4Q7kNvwFKgelF&_nc_oc=AdptcYE0rXy3AgU9og0ESx3yH1Rh08nqKvm2Yaz2S3XDB68VrWrxtDngC-odEZuauTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hoekdu8ZTGvLAR-BL8oFbz5WCeBMubi_Yfh6XDge54A&oe=6A3BD9B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Video Puzzle VR", "keywords": ["puzzle", "media", "video", "player", "cat"], "long_description": "Video Puzzle is a relaxing and innovative virtual (and mixed) reality game that blends the challenge of puzzles with the magic of beautiful videos. Step into a calming 3D environment, where fragmented video clips are waiting to be pieced together. Every puzzle tells a moving story, bringing mesmerizing scenes to life as you solve them.\n\nWhy You\u2019ll Love Video Puzzle:\n\nRelaxing Gameplay: A soothing experience designed to help you unwind while engaging your mind with no time challenge or score.\n\nImmersive Stories: Each puzzle reveals a unique, dynamic video that feels alive with motion.\n\nDifficulty Levels: From the start you can choose how many pieces your puzzle should have, from simple to complex (more than 130 pieces)\n\n\n", "short_description": "Relax and build puzzles that tell a moving story."}]}, "developer_name": "EVRESNCE", "developer_privacy_policy_url": "https://www.evresnce.com/videopuzzle-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "EVRESNCE", "support_website_url": null, "website_url": "https://www.evresnce.com/video-
t=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfeDY6fyZ3jyhazGD53kZGFkgSlr-2DDG9AGeMeTrXUw&oe=6ADE0630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soccer Shootout", "keywords": ["soccer", "football", "keeper", "sports", "health"], "long_description": "Experience the high-pressure world of a soccer goalkeeper from a first-person perspective. In this VR experience, you are positioned in the center of the goal, tasked with defending your net against a series of challenging shots.\n\nNPCs will fire the ball at you from different points across the pitch, forcing you to move, dive, and react quickly. The objective is straightforward but challenging: you must successfully catch or block the balls. With realistic physics and spatial audio, you'll feel every strike as you aim to become the ultimate shot-stopper.", "short_description": "Step into the gloves of a professional goalkeeper in this immersive VR simulation. Face a barrage of shots from various angles and distances, testing your reflexes and timing as you attempt to catch a target number of balls to win the match."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Papayaw7/SoccerShootout/blob/main/SoccerShootoutPrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "DOBIISON", "support_website_url": null, "website_url": "https://dobiison.com/vr-experiences", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SIT
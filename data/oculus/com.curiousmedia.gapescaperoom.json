, each representing a crucial aspect of nuclear plant operations. Utilize your knowledge and analytical skills to unravel intricate puzzles at each station. Your goal is to efficiently and accurately solve these puzzles, ensuring a seamless and successful activation of the plant. This experience not only tests your problem-solving abilities but also offers a deep dive into the fascinating world of nuclear energy operations.", "short_description": "Perform maintenance to keep a Georgia Power nuclear plant running smoothly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiousmedia.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Georgia Power", "support_website_url": null, "website_url": "https://curiousmedia.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6776704185792383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974786_614100384190725_925032827248109186_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vyJ6bPwOo8Q7kNvwGS9ymc&_nc_oc=AdmXKDmL4uBFNNlS9FPzyNeNiLvX_vZso6cpm7c0gHWr_2NFp-FMoMvmxcv0CDTsgw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftsjIDzIjRngTi8Av46vnTkMH-UkUdij_7zas3tSN8BEQ&oe=69A059ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Geor
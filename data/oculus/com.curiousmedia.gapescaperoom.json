0_297720853297151_4572669089127476332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfF6J6Z69UkQ7kNvwGBpLXW&_nc_oc=AdqGs8NuolwEiEOZCOry-luH3fOlckXcIzl5S3ARzsgcWGVz41hBCp-3q8YZcnmcRY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1g9FNxphCcVpU3_MP_rned00aRzDzJhvK6-9Zy2wUPOA&oe=69F0B94B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Georgia Power Escape Room", "keywords": [], "long_description": "Team up with a partner on an immersive challenge at a Georgia Power nuclear facility. Your mission is to ensure its optimal operation through cooperation and strategic thinking. Engage with four distinct stations, each representing a crucial aspect of nuclear plant operations. Utilize your knowledge and analytical skills to unravel intricate puzzles at each station. Your goal is to efficiently and accurately solve these puzzles, ensuring a seamless and successful activation of the plant. This experience not only tests your problem-solving abilities but also offers a deep dive into the fascinating world of nuclear energy operations.", "short_description": "Perform maintenance to keep a Georgia Power nuclear plant running smoothly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiousmedia.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Georgia Power", "support_website_url": null, "website_url": "https://curiousmedia.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAN
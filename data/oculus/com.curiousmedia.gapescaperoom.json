om&_nc_ss=8&oh=00_Afy1caSR_xfGQMKXmExHYEsOHpUDZLSCOPCpfW-BHA-yWw&oe=69BFF121"}, {"file_name": "screenshotdvt14uiu.0ge.png", "id": "297720849963818", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982510_297720853297151_4572669089127476332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXgVNIM3sJ4Q7kNvwGBLZZ2&_nc_oc=Admqv1YkNlFVqq_Z0cYf0JISKQ32ZNe3Piy2jgX6Hn4g5sHjpbnEzlM8KNd4IISbbvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyo6zAzsvettc-aI_9S3PImJbpkF3fe2DuxZLeTekztfA&oe=69BFF1CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Georgia Power Escape Room", "keywords": [], "long_description": "Team up with a partner on an immersive challenge at a Georgia Power nuclear facility. Your mission is to ensure its optimal operation through cooperation and strategic thinking. Engage with four distinct stations, each representing a crucial aspect of nuclear plant operations. Utilize your knowledge and analytical skills to unravel intricate puzzles at each station. Your goal is to efficiently and accurately solve these puzzles, ensuring a seamless and successful activation of the plant. This experience not only tests your problem-solving abilities but also offers a deep dive into the fascinating world of nuclear energy operations.", "short_description": "Perform maintenance to keep a Georgia Power nuclear plant running smoothly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiousmedia.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Georgia Power", "support_website_url": null, "website_url": "https://curiousmedia.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
ag&_nc_oc=AdmhzJqHwxlri5uqYFUhoPwbfAsbeNwf4APdNZEFX9yivIQInhNcgvPYYDfxklNJDiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsOIsugEkHoavFOjwnBZoKXKngTKT_rrZT0HwzEwFcOvQ&oe=699AE88E"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-13.png", "id": "539771675452286", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441581_539771682118952_6302483095945675433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s9qau2NBBkQ7kNvwGesNal&_nc_oc=AdnQwVpmZPs0z-UsVdu1FZxvsiagtgrE8ZRtjMieQp0_rp-nqc5qqW2n6engJKLq_t0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsP64rtufpze5DrMd1buihpFhC-8JZNkAeYLHq4YloWZA&oe=699B1336"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Simulator", "keywords": [], "long_description": "Monkey Simulator is infinite collector game, where you get to play as a monkey and explore a huge jungle! \n\nYou can swing from vines, climb trees, and run around with other monkeys to make new friends. \n\nThe best part is collecting a ton of bananas \u2014 you can find them all over the place! Some are hidden in tricky spots, so you have to explore and use your monkey skills to get them. \n\nAs you play, you unlock fun stuff like new areas and challenges. You can even have races to see who collects the most bananas. It\u2019s super fun, and there\u2019s always something exciting to do.\n\nIf you ever wanted to know what it\u2019s like to be a monkey and collect bananas in peace, this game is perfect for you!", "short_description": "Monkey Simulator is a super fun game where you get to be a monkey, make new monkey friends, and explore the jungle. You can infinitely collect bananas, swing from trees, and have the best time ever in the jungle!"}]}, "developer_name": "acuity", "developer_privacy_policy_url": "https://sites.google.com/view/just-monkin/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "acuity", "support_website_url": null, "website_url": "https://sites.google.com/view/just-monkin/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8587067764707521"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031647_1605233796774244_5557377529454485694_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgKPlYIgqp8Q7kNvwEDXmxc&_nc_oc=Adn7LJVJ4QsaAjVXJLgANdbGReM3w36IUpUVC1nm5nGL9bZ3xbjmV25wKoknCoI_QJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvtkh668ROUm3FoLVHIBtZ0ZKC2luCbsGOdRvzCMDnTkA&oe=699AE38D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1730248740, "lastRevision": {"nodes": [{"id": "8535061819908116", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8535061776574787", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "536813165775013"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "image_2024-10
.com/v/t64.5771-25/38982576_1220528295668747_9168871133726391712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiFqhT94xZYQ7kNvwGzAYq1&_nc_oc=Adnjh-sfxb_2LW_Cg8eGWBmcOUP4189kJmTYvLIONXDo0EN_Owgw8AzPtp4uNR0HUbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvxcVcWzar9Hz6N5HGpDobQ5InGJ8XmZT9opYWvgxuvcQ&oe=699C52E8"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-50.png", "id": "890634889706187", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974915_890634893039520_2908307765705401704_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBbcDNH3QScQ7kNvwGEg8Y7&_nc_oc=Adk03Ds5Mv64hfDWbmdDb5vdAqvtM88eNwbhJfQ0y3sG08iWRrAf94lPE5z2rCAX96M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftoHpG3Uy5OVDfkTeWu8tLXt8HANpPRY_dGfoU2W-asiw&oe=699C6523"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-08.png", "id": "1717231009091739", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003265_1717231012425072_7597067315306313324_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqC-dNkqxJgQ7kNvwEyK8OH&_nc_oc=AdnhzSUMr3x0feL9KfxYCpuROByYG2pTBSxgG_DhSxmgvVpjW0ibU1-MYf-EbwW1z-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfslZaeEkDUKlJPQAaNPK1GMMzkkb-sNMW5n7wRxdjxmqg&oe=699C3A0E"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-13.png", "id": "539771675452286", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441581_539771682118952_6302483095945675433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s9qau2NBBkQ7kNvwHChv2n&_nc_oc=AdmAIcHtfqLi6DtnvwmGXF08YpX5pyrEYqtcjc3GFFj7fvexdiY9Os3Oatx8w6hA8wk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs6teR4bzwjaviGFnswCaD09BiOEA9KZMRw8Erywp9Eag&oe=699C64B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Simulator", "keywords": [], "long_description": "Monkey Simulator is infinite collector game, where you get to play as a monkey and explore a huge jungle! \n\nYou can swing from vines, climb trees, and run around with other monkeys to make new friends. \n\nThe best part is collecting a ton of bananas \u2014 you can find them all over the place! Some are hidden in tricky spots, so you have to explore and use your monkey skills to get them. \n\nAs you play, you unlock fun stuff like new areas and challenges. You can even have races to see who collects the most bananas. It\u2019s super fun, and there\u2019s always something exciting to do.\n\nIf you ever wanted to know what it\u2019s like to be a monkey and collect bananas in peace, this game is perfect for you!", "short_description": "Monkey Simulator is a super fun game where you get to be a monkey, make new monkey friends, and explore the jungle. You can infinitely collect bananas, swing from trees, and have the best time ever in the jungle!"}]}, "developer_name": "acuity", "developer_privacy_policy_url": "https://sites.google.com/view/just-monkin/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "acuity", "support_website_url": null, "website_url": "https://sites.google.com/view/just-monkin/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8587067764707521"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2065674553885256"}]}, "baseline_offer": {"id": "2065674553885256"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730248740, "stat
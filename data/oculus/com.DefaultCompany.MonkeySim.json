r8&_nc_oc=AdoE65ns7Z_NePrKsy_XfO4eC6o3KrgUH0l9S_4v7Auhmf_zNjI1PCliqRkpqFu9Kbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af16JyGnyrEbxcU-KGXxwYhigTZrg5VFI6bM3yHHWtdrXA&oe=69F09A0E"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-13.png", "id": "539771675452286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75441581_539771682118952_6302483095945675433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nAGlWRVFKUQ7kNvwEMJWvt&_nc_oc=AdogK0oXQMghoHd8wo4E09L0k9itHzlGvh3xetda_s1sSJ9suRVl56B3f0_fYKw8khw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2yvEFn-v8m2N3XBcYdMjoMJbPu3PT9D6apWbM1-miCcA&oe=69F0C4B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Simulator", "keywords": [], "long_description": "Monkey Simulator is infinite collector game, where you get to play as a monkey and explore a huge jungle! \n\nYou can swing from vines, climb trees, and run around with other monkeys to make new friends. \n\nThe best part is collecting a ton of bananas \u2014 you can find them all over the place! Some are hidden in tricky spots, so you have to explore and use your monkey skills to get them. \n\nAs you play, you unlock fun stuff like new areas and challenges. You can even have races to see who collects the most bananas. It\u2019s super fun, and there\u2019s always something exciting to do.\n\nIf you ever wanted to know what it\u2019s like to be a monkey and collect bananas in peace, this game is perfect for you!", "short_description": "Monkey Simulator is a super fun game where you get to be a monkey, make new monkey friends, and explore the jungle. You can infinitely collect bananas, swing from trees, and have the best time ever in the jungle!"}]}, "developer_name": "acuity", "developer_privacy_policy_url": "https://sites.google.com/view/just-monkin/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "acuity", "support_website_url": null, "website_url": "https://sites.google.com/view/just-monkin/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8587067764707521"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031647_1605233796774244_5557377529454485694_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMIGGgg7UI8Q7kNvwEJtGDB&_nc_oc=AdrcqxlI3yEpUK3evTQ6KuWM-BhUoCGulmZSplPW_oQC7J0l4fTKJi3w-WRiHRn9_Zo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af01yNL5irK37VoQw4B1UEha9zl26gpyYexBXNhF3f0fDg&oe=69F0CD4D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1730248740, "lastRevision": {"nodes": [{"id": "8535061819908116", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8535061776574787", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "536813165775013"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "image_2024-10
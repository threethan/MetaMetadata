dndvVzNCz7l0bPYv3tizNwfaumSMAzUf3kWVCD6UTRU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlKU-JR2GteVirjgwocCqPUbsRFO0W0Yvecc_z18Ivgw&oe=6B0DCE8E"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-13.png", "id": "539771675452286", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441581_539771682118952_6302483095945675433_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKMKiotnry4Q7kNvwFyBO84&_nc_oc=AdrkzjDpxSlw7uYYvy_aCZBDwqY4zXMK-k77De4ghxj93VFFrzTjHxvKakWAbv6B3Yw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcSWmG5phf8bXqFdhOR2KX2diAfeu6q8C8SWhNlOoxfg&oe=6B0DC0F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Simulator", "keywords": [], "long_description": "Monkey Simulator is infinite collector game, where you get to play as a monkey and explore a huge jungle! \n\nYou can swing from vines, climb trees, and run around with other monkeys to make new friends. \n\nThe best part is collecting a ton of bananas \u2014 you can find them all over the place! Some are hidden in tricky spots, so you have to explore and use your monkey skills to get them. \n\nAs you play, you unlock fun stuff like new areas and challenges. You can even have races to see who collects the most bananas. It\u2019s super fun, and there\u2019s always something exciting to do.\n\nIf you ever wanted to know what it\u2019s like to be a monkey and collect bananas in peace, this game is perfect for you!", "short_description": "Monkey Simulator is a super fun game where you get to be a monkey, make new monkey friends, and explore the jungle. You can infinitely collect bananas, swing from trees, and have the best time ever in the jungle!"}]}, "developer_name": "acuity", "developer_privacy_policy_url": "https://sites.google.com/view/just-monkin/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "acuity", "support_website_url": null, "website_url": "https://sit
.com/v/t64.5771-25/38982576_1220528295668747_9168871133726391712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiFqhT94xZYQ7kNvwHEVcQF&_nc_oc=AdnwMFCg9H2cHTSF0nHQsRrGDNn7D9cBeZ_w_tVlxJK8O61lIoxztgA191kf6-JTpVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftxV8KeXZ5_uNknIMH9CqSFC0B-cAn_88DtDZ6QLSrhYA&oe=699B0168"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-50.png", "id": "890634889706187", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974915_890634893039520_2908307765705401704_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBbcDNH3QScQ7kNvwH_NS-k&_nc_oc=AdkWOA4LI-5FpHogRiLSr1nQZatf3Fl5o3oR2LRuehGFrvvs85khDdWqBhfSEqt_GI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftxT3Ll4F0nZz6Jgv7_YCn4yEgyyHieQQ8nQ3ZK4F6jQw&oe=699B13A3"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-08.png", "id": "1717231009091739", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003265_1717231012425072_7597067315306313324_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqC-dNkqxJgQ7kNvwHjevag&_nc_oc=AdmhzJqHwxlri5uqYFUhoPwbfAsbeNwf4APdNZEFX9yivIQInhNcgvPYYDfxklNJDiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsOIsugEkHoavFOjwnBZoKXKngTKT_rrZT0HwzEwFcOvQ&oe=699AE88E"}, {"file_name": "MainScene_Custom..._24.10.2024_18-48-13.png", "id": "539771675452286", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75441581_539771682118952_6302483095945675433_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s9qau2NBBkQ7kNvwGesNal&_nc_oc=AdnQwVpmZPs0z-UsVdu1FZxvsiagtgrE8ZRtjMieQp0_rp-nqc5qqW2n6engJKLq_t0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsP64rtufpze5DrMd1buihpFhC-8JZNkAeYLHq4YloWZA&oe=699B1336"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Simulator", "keywords": [], "long_description": "Monkey Simulator is infinite collector game, where you get to play as a monkey and explore a huge jungle! \n\nYou can swing from vines, climb trees, and run around with other monkeys to make new friends. \n\nThe best part is collecting a ton of bananas \u2014 you can find them all over the place! Some are hidden in tricky spots, so you have to explore and use your monkey skills to get them. \n\nAs you play, you unlock fun stuff like new areas and challenges. You can even have races to see who collects the most bananas. It\u2019s super fun, and there\u2019s always something exciting to do.\n\nIf you ever wanted to know what it\u2019s like to be a monkey and collect bananas in peace, this game is perfect for you!", "short_description": "Monkey Simulator is a super fun game where you get to be a monkey, make new monkey friends, and explore the jungle. You can infinitely collect bananas, swing from trees, and have the best time ever in the jungle!"}]}, "developer_name": "acuity", "developer_privacy_policy_url": "https://sites.google.com/view/just-monkin/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "acuity", "support_website_url": null, "website_url": "https://sites.google.com/view/just-monkin/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8587067764707521"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2065674553885256"}]}, "baseline_offer": {"id": "2065674553885256"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730248740, "stat
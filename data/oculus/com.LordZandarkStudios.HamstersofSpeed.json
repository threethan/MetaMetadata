eywords": ["racing", "multiplayer", "party", "action", "social"], "long_description": "With a hamster ball as your vehicle of choice, compete against other players in various mini-games! Use your real-life movements to steer the hamster ball, and master the technique so you can win first place!\n\nQuick join to play with other random hamsters, or host a lobby and play with up to 3 other friends! \n\nWith a unique locomotion system, you can experience being a hamster like never before! The movement system is calibrated to multiple playspace sizes, including both seated and standing modes. If needed, you can fine tune them even further for the perfect experience!\n\nRace on racetracks and play mini-games, with new maps and gamemodes being added regularly!\n\nStraighten your fur, fasten your control glove, and get ready to roll!", "short_description": "Live out your dream of running around in a hamster ball with this fast-paced party game centered around a unique movement system! Compete against your friends in different races and mini-games while using your real-life movements to steer the hamster ball!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hamsters-of-speed.my.canva.site/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LordZandark Studios", "support_website_url": null, "website_url": "https://hamsters-of-speed.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "24419923674331484"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1221392407455334"}, {"status": "PUBLISHED", "id": "2007512723301865"}, {"status": "PUBLISHED", "id": "1926191304747024"}]}, "baseline_offer": {"id": "1926191304747024"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1221392407455334"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27906795012310982", "version": "0.16.6"}, "id": "1293711055579661", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24419923647664820", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27906795012310982"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1293711055579661"}]}, "change_log": "v0.16.6 Release - Small Update\n\nAdded:\n- New pressure gauges on the control glove indicate how charged up your Jump and Dash are\n- Hamster tubes in the Hub now have support beams", "created_date": 1785265392, "id": "27906795012310982", "version": "0.16.6", "version_code": 81, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24419923647664820", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27906795012310982"}, "re
\uc18c\ucd1d, K5 \uad8c\ucd1d \ud3ec\ud568)\ub97c \ud65c\uc6a9\ud574 \uc0dd\uc874\ud574\uc57c \ud569\ub2c8\ub2e4.\nZOMVIRUS\ub294 VR \uc0c1\ud638\uc791\uc6a9\uc131\uc744 \uac15\ud654\ud558\uc5ec \ubb34\uae30 \uc7a1\uae30, \ubb38 \uc5f4\uae30, \uc624\ube0c\uc81d\ud2b8 \uc774\ub3d9, \ud30c\uad34\u00b7\ube5b\u00b7\uc18c\ub9ac \ud6a8\uacfc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c \uba40\ud2f0\ud50c\ub808\uc774 \uc544\ud0a4\ud14d\ucc98 \uae30\ubc18\uc73c\ub85c \uc81c\uc791\ub418\uc5b4 \uc815\uae30\uc801\uc778 \uc5c5\ub370\uc774\ud2b8(\ub9f5, \ubb34\uae30, \uc880\ube44)\uac00 \uc81c\uacf5\ub429\ub2c8\ub2e4.", "short_description": "\u201cZOMVIRUS\ub294 \uc11c\uc6b8 \ud569\uc815\uc5ed(\ud64d\ub300)\uc744 \ubc30\uacbd\uc73c\ub85c \ud55c VR \uc880\ube44 \uc0dd\uc874 \uc288\ud305 \uac8c\uc784\uc785\ub2c8\ub2e4. \ube60\ub974\uace0 \uc9c0\ub2a5\uc801\uc778 \ud55c\uad6d\ud615 \uc880\ube44\uc640 \ub9de\uc11c\uba70, K2 \uc18c\ucd1d\uacfc K5 \uad8c\ucd1d\uc744 \ud3ec\ud568\ud55c 20\uc5ec \uc885\uc758 \ubb34\uae30\ub97c \ud65c\uc6a9\ud574 \ub05d\uae4c\uc9c0 \uc0b4\uc544\ub0a8\uc73c\uc138\uc694.\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dmong.net/ppr-zomvirus", "developer_terms_of_service_url": null, "publisher_name": "DMONG GAME", "support_website_url": null, "website_url": "https://www.dmong.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "s
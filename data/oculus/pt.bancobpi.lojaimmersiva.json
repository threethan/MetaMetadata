dghnltAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXKQMXfWNNnEgZmefsv24AuPvfLOXdegEVRfyIryWvoqg&oe=6B0F0353"}, {"file_name": "Screenshot_CallRoom.png", "id": "587784756865517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_587784760198850_5788244412023641540_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzAkSvuvVKYQ7kNvwGksxC_&_nc_oc=AdqlOx3f_soPVTn3-oe9pHiFOCm3p_8yNboZbHYYQt-AEmEyOwZL-2unsNSr9XUZ7k4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4eT-pXglnVxmluZ-TC9Le-H4RpuLE1mfxLT0SJZKNNQ&oe=6B0F0249"}, {"file_name": "Screenshot_Game.png", "id": "1014130093053868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974892_1014130096387201_241344584862789906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf9fOgR1MHkQ7kNvwGplOMD&_nc_oc=AdojGJ27bfjyW3pvWuUTZC2kvJxGueJvA7QnprRoJUO2ogPy6jn0cMb8BKtM2jeYOUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmaDzm5uQc-DVIA-4MzQXpyxxeL6S0ZLCVSd7d1muWsg&oe=6B0F0AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LojaImersivaBPI_Trailer_Cover_Image.png", "id": "785340796468094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_785340803134760_8400061164987075514_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMzDs0rBy5YQ7kNvwEVO3cT&_nc_oc=AdqrTX1y-Zc_wJInxli5lpjgKFuNpnwvKIismsy0fj5PjBC3DOjrgZ_ZVBOGu3PwX_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPzvRPATHix5kl6mwm6-KEHh6Ow10r3uIoGUspJLBNQQ&oe=6B0F11AA"}, "display_name": "BPI VR", "keywords": ["BPI", "Banking"], "long_description": "We believe that banking should be accessible to everyone, no matter where they are in the world. So, we have launched BPI VR, a revolutionary VR App that brings banking to life. Step into a three-floor virtual building and immerse yourself in a world of captivating content and interactive activities.\nOn the first floor, explore a range of exciting features designed to enhance your banking experience. Interact with our tailored offers for different segments, simulate credits, enjoy a round of mini-golf, watch engaging videos, and even connect with your personal manager in the immersive VR environment.\nTake an otherworldly journey to the second floor, where you can walk on the moon and engage in a financial literacy quiz. Dive deeper into the experience by grabbing digital twins of prestigious wines and\nluxurious watches.\nOur third floor is dedicated to the Portuguese Football Federation, where you can get your hands on digital twins of illustrious trophies, delve into captivating videos about women's football, and even test your skills in a thrilling goalkeeper game.\nEnter the app now and embark on a captivating journey through the branch of the future! Discover a new way to engage with banking, breaking barriers and unlocking a world of possibilities!", "short_description": "We believe that banking should be accessible to everyone. So, we launched BPI VR, a revolutionary App that brings banking to life. Step into a three-floor building and explore our offers, play mini golf, see promotional videos and even contact your manager. You can also be in our Portuguese Football Federation stadium and get your hands on digital twins of trophies, delve into captivating women's football videos, and even test your skills in a goalkeeper game. Enter and discover the future!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065257", "developer_terms_of_service_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065258", "publisher_name": "Banco BPI", "support_website_url": "https://www.bancobpi.pt/particulares/contactos/contacto-outros", "website_url": "https://www.bancobpi.pt/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8980383102001412"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031596_837023494619477_3911549703943640217_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1TlPHnGIgsQ7kNvwFrzEfT&_nc_oc=AdpdhCoFM-bE18DI2NOAvQT0OpcIZYQx0b1glwWW40Ac-p9yEINDWo-Hpuf56VM_onI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWp_dwpiJHQtPqsmQ9VGov3n43jXeRj1Giij5EnkBsDWQ&oe=6B0F1F13"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BPI VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1666258200, "lastRevision": {"nodes": [{"id": "5502144296491994", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5502144219825335", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1134061934210198"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "LojaImersivaBPI_Cover_Square.png", "id": "1157636411458823", "image_type": "APP_IMG_COVER
56p7tX5U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWUqM4VV8mtOVKWHLMAmLu9hY9wfqepCRs0rdMB23Npg&oe=6B0B0ED3"}, {"file_name": "Screenshot_CallRoom.png", "id": "587784756865517", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974819_587784760198850_5788244412023641540_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgHGYgB4egEQ7kNvwGlk5QG&_nc_oc=AdrE9T-iaTSv5jl9Jqo5fuwljx5cwxWlb9aGccn3AzXcL8U3js67bSqxcA0RBa8kw8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvjQ4VS-bCrPVsiJnAWx__T6Hw6OBeMSTukXzmJAbsVg&oe=6B0B4609"}, {"file_name": "Screenshot_Game.png", "id": "1014130093053868", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974892_1014130096387201_241344584862789906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4a8qPOPlgMQ7kNvwH-hR3c&_nc_oc=AdoyH4tbu5_rbHgQMbQFoDosK2TUcKCvYEd3gU7_2n33ynzqjXgy4IQsCNDp2GlGbak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRaQBRtlHyzVy_xX6At4_kCOEX0WeHbVKK3kKksS86nwQ&oe=6B0B1633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LojaImersivaBPI_Trailer_Cover_Image.png", "id": "785340796468094", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_785340803134760_8400061164987075514_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMzDs0rBy5YQ7kNvwFCDQwz&_nc_oc=AdqAGqMzJeaMFH8fWuc4suKKimQYw_keZ7nJTf5CZvZPWL4JFduv_gF7QgUOYEQ5Ylc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxODFn-Z4g7zWXDMi_zNuj6Fid3MeaCehKiuC5q_tLZQ&oe=6B0B1D2A"}, "display_name": "BPI VR", "keywords": ["BPI", "Banking"], "long_description": "We believe that banking should be accessible to everyone, no matter where they are in the world. So, we have launched BPI VR, a revolutionary VR App that brings banking to life. Step into a three-floor virtual building and immerse yourself in a world of captivating content and interactive activities.\nOn the first floor, explore a range of exciting features designed to enhance your banking experience. Interact with our tailored offers for different segments, simulate credits, enjoy a round of mini-golf, watch engaging videos, and even connect with your personal manager in the immersive VR environment.\nTake an otherworldly journey to the second floor, where you can walk on the moon and engage in a financial literacy quiz. Dive deeper into the experience by grabbing digital twins of prestigious wines and\nluxurious watches.\nOur third floor is dedicated to the Portuguese Football Federation, where you can get your hands on digital twins of illustrious trophies, delve into captivating videos about women's football, and even test your skills in a thrilling goalkeeper game.\nEnter the app now and embark on a captivating journey through the branch of the future! Discover a new way to engage with banking, breaking barriers and unlocking a world of possibilities!", "short_description": "We believe that banking should be accessible to everyone. So, we launched BPI VR, a revolutionary App that brings banking to life. Step into a three-floor building and explore our offers, play mini golf, see promotional videos and even contact your manager. You can also be in our Portuguese Football Federation stadium and get your hands on digital twins of trophies, delve into captivating women's football videos, and even test your skills in a goalkeeper game. Enter and discover the future!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065257", "developer_terms_of_service_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065258", "publisher_name": "Banco BPI", "support_website_url": "https://www.bancobpi.pt/particulares/contactos/contacto-outros", "website_url": "https://www.bancobpi.pt/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362
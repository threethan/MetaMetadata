0wDlP6eQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmXIo_V-OQYDT9Xamd9gcTBg1hZ6kwPyWDNkc34mmT2A&oe=6AFF3153"}, {"file_name": "Screenshot_CallRoom.png", "id": "587784756865517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_587784760198850_5788244412023641540_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TixEByGAzs4Q7kNvwGjzU1C&_nc_oc=AdpT_6xX9DbN8KJucXS-lu2PFHnYXBcedzwYEyYz1dreqkbhhIF5ldFCMyKp6Ld6zt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy3NLsjYgZgUUokRyjmFw5GadycYpEQEyt-SEqYc21Dw&oe=6AFF3049"}, {"file_name": "Screenshot_Game.png", "id": "1014130093053868", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974892_1014130096387201_241344584862789906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5AW5wvfdYkQ7kNvwHrcIFd&_nc_oc=AdpjYjO0aN2YtA1Mj_zo2z216rm6tYJQbKESORjYYz63Asz_4IoVp8WUkR7iXLvjJY8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_nhb463kNzyK-3cLdfrxEFStaUUcO2_ePMpFF7-cVdg&oe=6AFF0073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LojaImersivaBPI_Trailer_Cover_Image.png", "id": "785340796468094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_785340803134760_8400061164987075514_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAVf5c-kZlgQ7kNvwGKNMBt&_nc_oc=AdqqptUIkjKiUTuK42OM4tyLgujme5T8GXuxodKCGOV7xq6OQOWoW1CEclLkvEGX1jw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Gq-wHA5L6a4q9h3_4l5n_LxHZvQsKMqqeEcfTRcsJQ&oe=6AFF076A"}, "display_name": "BPI VR", "keywords": ["BPI", "Banking"], "long_description": "We believe that banking should be accessible to everyone, no matter where they are in the world. So, we have launched BPI VR, a revolutionary VR App that brings banking to life. Step into a three-floor virtual building and immerse yourself in a world of captivating content and interactive activities.\nOn the first floor, explore a range of exciting features designed to enhance your banking experience. Interact with our tailored offers for different segments, simulate credits, enjoy a round of mini-golf, watch engaging videos, and even connect with your personal manager in the immersive VR environment.\nTake an otherworldly journey to the second floor, where you can walk on the moon and engage in a financial literacy quiz. Dive deeper into the experience by grabbing digital twins of prestigious wines and\nluxurious watches.\nOur third floor is dedicated to the Portuguese Football Federation, where you can get your hands on digital twins of illustrious trophies, delve into captivating videos about women's football, and even test your skills in a thrilling goalkeeper game.\nEnter the app now and embark on a captivating journey through the branch of the future! Discover a new way to engage with banking, breaking barriers and unlocking a world of possibilities!", "short_description": "We believe that banking should be accessible to everyone. So, we launched BPI VR, a revolutionary App that brings banking to life. Step into a three-floor building and explore our offers, play mini golf, see promotional videos and even contact your manager. You can also be in our Portuguese Football Federation stadium and get your hands on digital twins of trophies, delve into captivating women's football videos, and even test your skills in a goalkeeper game. Enter and discover the future!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065257", "developer_terms_of_service_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065258", "publisher_name": "Banco BPI", "support_website_url": "https://www.bancobpi.pt/particulares/contactos/contacto-outros", "website_url": "https://www.bancobpi.pt/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8980383102001412"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031596_837023494619477_3911549703943640217_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDTB-aZZZzUQ7kNvwHPeV7d&_nc_oc=AdqT0vXG2kQFHQUp8YD1hv8gmxFMdBYxcj4gBn1xo6PhI82rxREgQd54WB4Eehl1u7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjyLbcxuPIh0OtkV-Ce-uw3BWilUJbxI7RGVdq6ze5gA&oe=6AFF14D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BPI VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1666258200, "lastRevision": {"nodes": [{"id": "5502144296491994", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5502144219825335", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1134061934210198"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "LojaImersivaBPI_Cover_Square.png", "id": "1157636411458823", "image_type": "APP_IMG_COVER
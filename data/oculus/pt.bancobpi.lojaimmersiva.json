LxQ0b-no&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKXIvjhEbvP5YnW_sDGOKVYQ6QGDcR0zpovg-mXxEuCQ&oe=6B086BD3"}, {"file_name": "Screenshot_CallRoom.png", "id": "587784756865517", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_587784760198850_5788244412023641540_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OUlKGBF6lwQ7kNvwEjGChd&_nc_oc=Adrlxe8GC03WhzKwhTC25QYnPPkjy407Wj4_jUybMc-fZzO0owtOCxA4ykZEiMZnQjc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuZpueVL_lf7OJx53Zxxx5s6LZ-XeWt2B6-vYrVouqXg&oe=6B086AC9"}, {"file_name": "Screenshot_Game.png", "id": "1014130093053868", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974892_1014130096387201_241344584862789906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mDiZNOYRVIQ7kNvwE-lkzI&_nc_oc=AdpXzgkQ9fpHvSdrCnKolCf113Gnplfu17H0SeMun6hMrWIJArLUr814BVgaADohX8M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_S_yp6CSvqC-P-fpzSggNcDEqnX4bqZZigi2pQubQ3A&oe=6B083AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LojaImersivaBPI_Trailer_Cover_Image.png", "id": "785340796468094", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974819_785340803134760_8400061164987075514_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hl0-6h5ag8IQ7kNvwER4YYq&_nc_oc=AdoCHLWs9akgzPFFldQ_YDIYWSCdVWZrhEB6BVO-tI-9pTYd93L3gpZHRn6LCy1AOe0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWHUoheU5eiHmKmBh_gRzBhMeSkbOUI1zQ2am8rMuDhQ&oe=6B0841EA"}, "display_name": "BPI VR", "keywords": ["BPI", "Banking"], "long_description": "We believe that banking should be accessible to everyone, no matter where they are in the world. So, we have launched BPI VR, a revolutionary VR App that brings banking to life. Step into a three-floor virtual building and immerse yourself in a world of captivating content and interactive activities.\nOn the first floor, explore a range of exciting features designed to enhance your banking experience. Interact with our tailored offers for different segments, simulate credits, enjoy a round of mini-golf, watch engaging videos, and even connect with your personal manager in the immersive VR environment.\nTake an otherworldly journey to the second floor, where you can walk on the moon and engage in a financial literacy quiz. Dive deeper into the experience by grabbing digital twins of prestigious wines and\nluxurious watches.\nOur third floor is dedicated to the Portuguese Football Federation, where you can get your hands on digital twins of illustrious trophies, delve into captivating videos about women's football, and even test your skills in a thrilling goalkeeper game.\nEnter the app now and embark on a captivating journey through the branch of the future! Discover a new way to engage with banking, breaking barriers and unlocking a world of possibilities!", "short_description": "We believe that banking should be accessible to everyone. So, we launched BPI VR, a revolutionary App that brings banking to life. Step into a three-floor building and explore our offers, play mini golf, see promotional videos and even contact your manager. You can also be in our Portuguese Football Federation stadium and get your hands on digital twins of trophies, delve into captivating women's football videos, and even test your skills in a goalkeeper game. Enter and discover the future!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065257", "developer_terms_of_service_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065258", "publisher_name": "Banco BPI", "support_website_url": "https://www.bancobpi.pt/particulares/contactos/contacto-outros", "website_url": "https://www.bancobpi.pt/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8980383102001412"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031596_837023494619477_3911549703943640217_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBevO5ZyNKAQ7kNvwEUIUQW&_nc_oc=AdoTNMbBWK7PzqVSHufK5JliVMZZnex3R0qlAM8M7ARerXetQiFgq8E8VOd1NLzHrEg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsEfxyPw_0wFUsTYvVhm5AWoCbwzlVoU0SgbKIAVIBSg&oe=6B084F53"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BPI VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1666258200, "lastRevision": {"nodes": [{"id": "5502144296491994", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5502144219825335", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1134061934210198"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "LojaImersivaBPI_Cover_Square.png", "id": "1157636411458823", "image_type": "APP_IMG_COVER
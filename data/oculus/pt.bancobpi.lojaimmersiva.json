creenshot_Game.png", "id": "1014130093053868", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974892_1014130096387201_241344584862789906_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1osDIxA_G_0Q7kNvwE06p1R&_nc_oc=AdqlhmHSNPCVdxK4O408dHkipO5_rtF0QbHjBUO1k26LWqh0PWxQ3HwKHPJ4EN9DDRU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Tr49pwomKizWLgY247ExOLLXcn_ScMsh8O_80v0oNcA&oe=69DE47F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LojaImersivaBPI_Trailer_Cover_Image.png", "id": "785340796468094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_785340803134760_8400061164987075514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-Jr6dFmwz4Q7kNvwFzF94t&_nc_oc=AdrR8iby-W6Hvf9mHBY9pcNxAzEswSx1KY3j6y0OtOYqoiiF0l9N8bry91MQj51Kf7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ad1aGjmpQuL9NErOJw_AElTKgpRaq1BrJ84CfgDt1XQ&oe=69DE4EEA"}, "display_name": "BPI VR", "keywords": ["BPI", "Banking"], "long_description": "We believe that banking should be accessible to everyone, no matter where they are in the world. So, we have launched BPI VR, a revolutionary VR App that brings banking to life. Step into a three-floor virtual building and immerse yourself in a world of captivating content and interactive activities.\nOn the first floor, explore a range of exciting features designed to enhance your banking experience. Interact with our tailored offers for different segments, simulate credits, enjoy a round of mini-golf, watch engaging videos, and even connect with your personal manager in the immersive VR environment.\nTake an otherworldly journey to the second floor, where you can walk on the moon and engage in a financial literacy quiz. Dive deeper into the experience by grabbing digital twins of prestigious wines and\nluxurious watches.\nOur third floor is dedicated to the Portuguese Football Federation, where you can get your hands on digital twins of illustrious trophies, delve into captivating videos about women's football, and even test your skills in a thrilling goalkeeper game.\nEnter the app now and embark on a captivating journey through the branch of the future! Discover a new way to engage with banking, breaking barriers and unlocking a world of possibilities!", "short_description": "We believe that banking should be accessible to everyone. So, we launched BPI VR, a revolutionary App that brings banking to life. Step into a three-floor building and explore our offers, play mini golf, see promotional videos and even contact your manager. You can also be in our Portuguese Football Federation stadium and get your hands on digital twins of trophies, delve into captivating women's football videos, and even test your skills in a goalkeeper game. Enter and discover the future!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065257", "developer_terms_of_service_url": "https://www.bancobpi.pt/content/conn/UCM/uuid/dDocName:PR_UCMS02065258", "publisher_name": "Banco BPI", "support_website_url": "https://www.bancobpi.pt/particulares/contactos/contacto-outros", "website_url": "https://www.bancobpi.pt/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8980383102001412"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
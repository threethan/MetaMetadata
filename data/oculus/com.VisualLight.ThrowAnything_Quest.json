d=6e7a0a&_nc_ohc=yIELN4gS2fYQ7kNvwFb2dar&_nc_oc=Adq2Y4EO9Vxhmkqj8h8iWoB7VzdCiTEALb_3G1Y9CJfvViYKe-4q05T-8ZYXhPp4sAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xmJjOntDHf_AC4KqgFO-dUGwefNhuQkHZT2JHdZz5FQ&oe=6A0B1524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_32bit.png", "id": "170020154803939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982663_170020158137272_7980502875436620937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eEhEaXWHYMQ7kNvwEynpcq&_nc_oc=AdqUxCK_UV3KWfqGkMNtZ0bWMs1O2AiYWvTX5zBBk9sr7AwB3XJj71oHrPDlOAyjL8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IT33-2ONj6J3rP4Vk8z4LehhTkz6meeRXgqqi89tGlg&oe=6A0B1829"}, "display_name": "Throw Anything", "keywords": [], "long_description": "There is nowhere to run... and nowhere to hide as zombies climb up the walls hoping to satisfy their appetite for brains. The only way to survive: reload your guns, destroy all furniture in the room, grab them all, and throw anything you can find to take them down.. and we mean ANYTHING.\nFace off against starving zombies in high-rise buildings across the globe in the VR action defense game, Throw Anything!\n\n\u25cf Key Features\n\u318dEnjoy laying waste to fully destructible environments!\n\n\u318dThrow any object within reach \u2013 humans included!\n\n\u318dTake on 6 challenging stages about to be overrun by the zombie horde!\n\n\u318dDefeat 5 mid-bosses and 6 powerful \u201cmain\u201d bosses!\n\n\u318dCollect ancient relics to save the world!\n\n\u318dDefeat zombies and get powerful weapons as rewards!\n\n\u318dTest your limits at various difficulty levels!", "short_description": "Get secret missions from Secret Delivery Agency (SDA) and save the world from zombie hordes in the VR action game, Throw Anything!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "Visu
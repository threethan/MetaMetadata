f20f&oh=00_AQStjcbaI3B2W4yekeZ5cYWKvYI9dzaBpC-uHASJWqdwJw&oe=6B047CEA"}, {"file_name": "\uc2a4\ud14c\uc774\uc9c06-(1).png", "id": "940705000094340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982668_940705003427673_3899426170847427188_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHfw3CWbTgsQ7kNvwFK8zln&_nc_oc=AdqiDstmDhVuA01bNjpTaT7Dt-5l7L0Pf0I_L81yJ0eOTwqJ6PNJOLBoDyOOkmEMNOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVhaPsWCqFnhdGVB3qdh-ph3liQJjmCFaqVboQ444mIg&oe=6B0478E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_32bit.png", "id": "170020154803939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982663_170020158137272_7980502875436620937_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooFa2t3z8_8Q7kNvwHvEiL-&_nc_oc=AdobZ5eg-6MGAQNC-GPVyMJDktNhCboqBPGZRy0yN03zxPSMQ_aUqRsDIGLyJhntPvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9swZKHSAN7z4nyBMPzah_wFV9H6LKS4LxFcI_jM6fJA&oe=6B047BE9"}, "display_name": "Throw Anything", "keywords": [], "long_description": "There is nowhere to run... and nowhere to hide as zombies climb up the walls hoping to satisfy their appetite for brains. The only way to survive: reload your guns, destroy all furniture in the room, grab them all, and throw anything you can find to take them down.. and we mean ANYTHING.\nFace off against starving zombies in high-rise buildings across the globe in the VR action defense game, Throw Anything!\n\n\u25cf Key Features\n\u318dEnjoy laying waste to fully destructible environments!\n\n\u318dThrow any object within reach \u2013 humans included!\n\n\u318dTake on 6 challenging stages about to be overrun by the zombie horde!\n\n\u318dDefeat 5 mid-bosses and 6 powerful \u201cmain\u201d bosses!\n\n\u318dCollect ancient relics to save the world!\n\n\u318dDefeat zombies and get powerful weapons as rewards!\n\n\u318dTest your limits at various difficulty levels!", "short_description": "Get secret missions from Secret Delivery Agency (SDA) and save the world from zombie hordes in the VR action game, Throw Anything!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "fr", "es", "zh_TW", "th", "ja", "id", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "358265959171405"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982667_287018692767106_8995660834806231287_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jizYUTCrWP0Q7kNvwHwswAR&_nc_oc=Adpqnx4loWrkmuN8R2J9MmWZJGWB8nj2LjtmIQWGLRphaUN_gA3PxiBPU8lTtVUPdaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnJSyrAeT495fvGoUsXnxJGIcxs0jlblo4LPkyytqBWw&oe=6B045746"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Throw Anything", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival
H&_nc_oc=AdrNSPBB9kiGbV_AE99iAUDBX_jCpnviAPKLqK_-rpFzSgbwQoDQTQ6kMHS5laV8Pfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLGBXWH8k1Yd9TUmPUD7MNyUFAAUMBefOw6zhSz3qk2g&oe=6AF5C17D"}, {"file_name": "screenshot_3.png", "id": "1118508923845795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1118508927179128_8587038926791648511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiQqmeipSzYQ7kNvwHA2qIG&_nc_oc=AdpA4DZeukAyd4kr8J0f-mqbd8pbK_gO85WBWRLi8r9W-jM_77UwjdBIfjIAwLZ4KiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPabwg6g8F7VduRi5G4N5Dn3K-hVZCQ7bTEQ7zCrEAIA&oe=6AF5DAC3"}, {"file_name": "screenshot_5.png", "id": "1804468194016324", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596106838_1804468197349657_5489780076622700452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKMKSPebJ78Q7kNvwF38Mg2&_nc_oc=AdrKGKlZryNXS5Sw38rGrxnlmk86J1cLnOKZvIN12-lYZEqJkYYJZqOQdYdKUTtj5Is&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjd7rE8ZAJm69V_hPv7G_dFkiw7u-uXzRtLbAVaSKLNw&oe=6AF5ED84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2172703076960542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_2172703083627208_7845957007001519687_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pcz9cRTNf4Q7kNvwEttz7X&_nc_oc=AdqF7bvXymSE99wB7TlyMw9Lv5ytE3LcaRUfqKUF42QxNb7x6eDQHukHyUyNQVlVqTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSyVke9cK_Y1vyG9FY7y1jyqyrXa2oHNkIVFNudaJVtQ&oe=6AF5DF86"}, "display_name": "Surgery Simulator", "keywords": ["surgery", "surgeon", "doctor", "hospital", "medical"], "long_description": "Welcome to the operating room, Doctor.\n\nSCRUB IN\nEvery case starts in the corridor. The Chief briefs you, you scrub at the sink, and the doors slide open onto a full operating room: surgical lights, a live heart monitor, an anaesthesia machine and a nurse holding out your first instrument.\n\nREAL INSTRUMENTS IN YOUR HANDS\nScalpel, forceps, hemostat, scissors, Bovie, suction, retractors and a needle driver. Pick each one up by any part, the way you would hold the real thing. Cut along the marked line, seal the bleeders, hold the wound open and close it stitch by stitch.\n\nSEVEN CAREER CASES\nLaceration repair, glass in the wound, appendectomy, a nail-gun injury, a sponge left behind by another hospital, gallbladder removal, and an emergency where the patient's heart stops on the table. Grab the defibrillator paddles and bring them back.\n\nA TEAM AROUND YOU\nYour nurse, assistant and anaesthetist talk you through every step, hand you what you need and cheer when you close.\n\nARCADE AND SANDBOX\nRace the clock in Suture Sprint and Bleeder Blitz, or open Sandbox mode: cut anywhere, throw the instruments, call a code blue. No rules, no score.\n\nEvery case is graded on accuracy, blood loss, closure, time and safety. Climb from Intern to Chief Resident.", "short_description": "Scrub in, step into a real operating room and take the scalpel. Cut, cauterise, clamp and stitch with your own hands while a full surgical team works around you. Seven cases from a kitchen-knife cut to a crashing emergency, two arcade modes and a sandbox with no rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/surgerysimulator/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/surgerysimulator/", "website_url": "https://citiview-games.pages.dev/surgerysimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
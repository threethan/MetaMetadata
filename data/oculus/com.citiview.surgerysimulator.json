4649963465085491542_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZ-l-zwCM8cQ7kNvwHgRLeh&_nc_oc=Adrbu8HYxjsd2C39pf3kCUG6EIsKqnmxxe-MfmlezP8NzEzXmc6kdUV5F54k2BJak2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTli7Q7d2Ht3MgSuttyDfjys5Y0aToGMBp90IZEuHf-Kw&oe=6B0C7B84"}, {"file_name": "screenshot_4.png", "id": "882532094944216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/613094043_882532098277549_1692592295974427977_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZjD1lH6HVUQ7kNvwF-aAA4&_nc_oc=AdpUJuWslbDw4ehA6PcN3KQP6X-dtU_XmJo2XZVcmKb0VeZVdyNkGLHyOLcyQmg-3pY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSADfBIuesAQtrdPeH3b2dG50ejSv9k4ShREdKhKmsGAg&oe=6B0C633D"}, {"file_name": "screenshot_3.png", "id": "1118508923845795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1118508927179128_8587038926791648511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQHx_nhskoQQ7kNvwFkypVW&_nc_oc=AdrqTVmav6u5hP_8Cp0Mi9o_1qv3hxs-nYn8aqShgyl6Shofp-mEjbTCY1sycgdTl4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2OzNe-qkzgtNR3iWCq9GhrLxsEvEdIiL8gaCDG49OoQ&oe=6B0C7C83"}, {"file_name": "screenshot_5.png", "id": "1804468194016324", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596106838_1804468197349657_5489780076622700452_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-X00SCaJOAQ7kNvwESODV4&_nc_oc=Adrh28DPhfQPz7Qxk59uZ-3eTHzggkXnxL28rgRgbcjpr-lqmLtLod7WT5iPFm6YkWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbT0T76ZAGd7Ymbp_ejBq7CeQlGb1junZ7-y_NsHIsYw&oe=6B0C5704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2172703076960542", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673652249_2172703083627208_7845957007001519687_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTvrSPBCnwYQ7kNvwHABtZW&_nc_oc=AdpoMRZbvUCug3csJkfwbTSquEwTaSPZfGHVzPSeR4pDCbvJS-iaKafbSJs7i43YFOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMyGQaLcu6y11-QwE35I7Scmf1j0Ajcic0qQHcxqIJMQ&oe=6B0C8146"}, "display_name": "Surgery Simulator", "keywords": ["surgery", "surgeon", "doctor", "hospital", "medical"], "long_description": "Welcome to the operating room, Doctor.\n\nSCRUB IN\nEvery case starts in the corridor. The Chief briefs you, you scrub at the sink, and the doors slide open onto a full operating room: surgical lights, a live heart monitor, an anaesthesia machine and a nurse holding out your first instrument.\n\nREAL INSTRUMENTS IN YOUR HANDS\nScalpel, forceps, hemostat, scissors, Bovie, suction, retractors and a needle driver. Pick each one up by any part, the way you would hold the real thing. Cut along the marked line, seal the bleeders, hold the wound open and close it stitch by stitch.\n\nSEVEN CAREER CASES\nLaceration repair, glass in the wound, appendectomy, a nail-gun injury, a sponge left behind by another hospital, gallbladder removal, and an emergency where the patient's heart stops on the table. Grab the defibrillator paddles and bring them back.\n\nA TEAM AROUND YOU\nYour nurse, assistant and anaesthetist talk you through every step, hand you what you need and cheer when you close.\n\nARCADE AND SANDBOX\nRace the clock in Suture Sprint and Bleeder Blitz, or open Sandbox mode: cut anywhere, throw the instruments, call a code blue. No rules, no score.\n\nEvery case is graded on accuracy, blood loss, closure, time and safety. Climb from Intern to Chief Resident.", "short_description": "Scrub in, step into a real operating room and take the scalpel. Cut, cauterise, clamp and stitch with your own hands while a full surgical team works around you. Seven cases from a kitchen-knife cut to a crashing emergency, two arcade modes and a sandbox with no rules."}]}, "developer_name": null, "developer_privacy_policy_url":
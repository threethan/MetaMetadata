.com.br/privacy_360viewer.html", "developer_terms_of_service_url": null, "publisher_name": "XrLab Play", "support_website_url": "https://xrlab.com.br/contato", "website_url": "https://xrlab.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8435029539898448"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982654_958674832599997_3071436989863670543_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctLicBvYC_IQ7kNvwGuLG-n&_nc_oc=AdkxsMV8ohgGqB16gL3St47YfMUzLKl8bFUwJsSOsKtZQuCgONcygTp8OryEIF4rgxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afun3_UXYhMj7m31EHANRhNth5p1yv2WZR7iPBr8TgH9GA&oe=69A813E3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XR 360 Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1720817483, "lastRevision": {"nodes": [{"id": "7022208097847273", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7022208074513942", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "146918352397751
a0a&_nc_ohc=TU34EakByJkQ7kNvwH8aGz9&_nc_oc=Adql5l_Gn5kz5_-71Mbv39q2Q-u3ErdPM-f9CA2CJSR4ptv2sn3brBuO3tMgugWPoZw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBt2_THxo67LNJHdB1waX8jfuKU_VWlAQUV_wx4GpfyA&oe=6AFB1A0C"}, {"file_name": "screenshot_08_hot_hoops_2560x1440.png", "id": "2065097937515205", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623179_2065097940848538_3324267286427798521_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI_Jl0hweSMQ7kNvwFHEIxI&_nc_oc=AdpdHbpxoBZmmklDu4u1kRA_8siG2W1AgxH_hzwCeH0J9YU7Ss2suc1SBGUCaZk7LpQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlRed3Ak7ghqWCk8fmE4-EpD7wQ0pzPAWoXzNe_mW52w&oe=6AFB292F"}, {"file_name": "screenshot_06_fun_run_balls_2560x1440.png", "id": "1146904307898821", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593877129_1146904314565487_1960606042468191820_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSEx1DY6E38Q7kNvwF93PvD&_nc_oc=AdobXAdUMxioExvdoSx9EaO-DBGLrGIoE1kv1Jl5iqTDjqoevnEO0eP9u4CZtZkGQ4k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4fkmSdTfcEOr23Iepe9Q9F-iA1WPJzNSrZwVFmrF5SA&oe=6AFB1A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_02_main_menu_2560x1440.png", "id": "1089835637018903", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628449_1089835640352236_3498612582983051025_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA6MydSWM7cQ7kNvwHJfAap&_nc_oc=AdqEm_33Y_zGFZeuzp_ejKmqUhLgGlW46QaAPyxcSa-Qiam57YGj4qvAWi7SXLFQJwU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6aPyFUMN6iWHfitzKrsvofMKsKrB6mwNwdAHT84qc3w&oe=6AFB4A4A"}, "display_name": "Buckets or Bricks: VR Basketball", "keywords": ["basketball", "sports", "arcade", "shooting", "party"], "long_description": "# Buckets or Bricks?\n\nThe lights are up, the crowd is on its feet and the clock is ticking. Grab the ball, set your feet and let it fly. Every shot is a question: **buckets or bricks?\n\n## Nine Ways to Prove Your Shot\n\n\n- **3-Point Shootout:** Five racks around the arc. Every last ball is a money ball worth double.\n- **Half Court Shots:** Heave it from half court and hear the crowd lose it.\n- **Bank Shot:** Off the glass only. Swishes don't count!\n- **Free Throws:** Step up to the line. How many can you sink in 60 seconds?\n- **Beat the Buzzer:** Start with 20 seconds. Every make buys you more time.\n- **Swish & Slide:** The hoop slides side to side and speeds up with every basket.\n- **Hot Hoops:** Three hoops, one target. Hit the lit hoop before it moves.\n- **Double Buckets:** Two balls, two hoops, both hands. Sink them together for a bonus.\n- **Fun Run:** Watermelons, eyeballs, disco balls and a toilet seat hoop. Hit three in a row and set the net on fire!\n\n\n## Feel Like a Pro\n\n- **A living arena:** Thousands of fans clap, stand and roar as your streak grows.\n- **Celebrate in style:** Set a new high score and the roof rains confetti while the lights put on a show.\n- **Pick your challenge:** Easy, Normal or Pro difficulty, so first timers and sharpshooters both have fun.\n- **Head to Head:** Pass the headset to a friend, one round each, highest score wins.\n- **Daily Challenge:** A fresh goal every day. Keep your streak alive.\n\n**Grab the ball. Take the shot. Buckets or bricks? There's only one way to find out.**", "short_description": "Step into a packed arena and find out if you've got buckets or bricks. Grab the ball with your own hands, rise up and shoot as the crowd roars, spotlights sweep and confetti rains down on every new high score. Play nine game modes, from the classic 3-Point Shootout to Hot Hoops, Double Buckets and the gloriously silly Fun Run with its toilet hoop and flaming net. Easy to pick up, impossible to put down. Challenge a friend in Head to Head and chase your best score."}]}, "developer_name": "Ako1 Studios", "developer_privacy_policy_url": "https://bucketsorbricks.com/privacy", "developer_terms_of_service_url": "https://bucketsorbricks.com/terms", "publisher_name": "Ako1 Studios", "support_website_url": "https://bucketsorbricks.com/support", "website_url": "https://bucketsorbricks.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1385501247980905"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2138482580095007"}, {"status": "PUBLISHED", "id": "1569520295208449"}]}, "baseline_offer": {"id": "1569520295208449"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794772800, "status": "PUBLISHED", "id": "2138482580095007"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1391207317410298", "version": "0.1.0"}, "id": "1813704332957220", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1385501237980906", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1391207317410298"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1813704332957220"}]}, "change_log": "Version 0.1.0: Welcome to the arena!\\n\\nBuckets or Bricks: VR Basketball is here. Step onto the court, grab the ball and find out if you've got buckets or bricks.\\n\\nWhat's in this release:\\n- Nine game modes: 3-Point Shootout, Half Court Shots, Bank Shot, Free Throws, Beat the Buzzer, Swish & Slide, Hot Hoops, Double Buckets and Fun Run.\\n- Head to Head on every mode: pass the headset to a friend, one round each, highest score wins.\\n- Practice mode for every game: no clock, no pressure.\\n- Daily Challenge: a fresh goal every day to keep your streak alive.\\n- Pick your difficulty: Easy, Normal or Pro.\\n- Your hands, your way: shoot with either hand and choose from six skin tones.\\n- A packed arena: thousands of cheering fans, a light show and confetti when you set a new high score.\\n- High scores and personal bests for every mode.\\n\\nThanks for playing! Got feedback or found a bug? Email us at support@bucketsorbricks.com.", "created_date": 1793125962, "id": "1391207317410298", "version": "0.1.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
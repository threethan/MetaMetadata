scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBt2_THxo67LNJHdB1waX8jfuKU_VWlAQUV_wx4GpfyA&oe=6AFB1A0C"}, {"file_name": "screenshot_08_hot_hoops_2560x1440.png", "id": "2065097937515205", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623179_2065097940848538_3324267286427798521_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI_Jl0hweSMQ7kNvwFHEIxI&_nc_oc=AdpdHbpxoBZmmklDu4u1kRA_8siG2W1AgxH_hzwCeH0J9YU7Ss2suc1SBGUCaZk7LpQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlRed3Ak7ghqWCk8fmE4-EpD7wQ0pzPAWoXzNe_mW52w&oe=6AFB292F"}, {"file_name": "screenshot_06_fun_run_balls_2560x1440.png", "id": "1146904307898821", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593877129_1146904314565487_1960606042468191820_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSEx1DY6E38Q7kNvwF93PvD&_nc_oc=AdobXAdUMxioExvdoSx9EaO-DBGLrGIoE1kv1Jl5iqTDjqoevnEO0eP9u4CZtZkGQ4k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4fkmSdTfcEOr23Iepe9Q9F-iA1WPJzNSrZwVFmrF5SA&oe=6AFB1A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_02_main_menu_2560x1440.png", "id": "1089835637018903", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628449_1089835640352236_3498612582983051025_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WA6MydSWM7cQ7kNvwHJfAap&_nc_oc=AdqEm_33Y_zGFZeuzp_ejKmqUhLgGlW46QaAPyxcSa-Qiam57YGj4qvAWi7SXLFQJwU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6aPyFUMN6iWHfitzKrsvofMKsKrB6mwNwdAHT84qc3w&oe=6AFB4A4A"}, "display_name": "Buckets or Bricks: VR Basketball", "keywords": ["basketball", "sports", "arcade", "shooting", "party"], "long_description": "# Buckets or Bricks?\n\nThe lights are up, the crowd is on its feet and the clock is ticking. Grab the ball, set your feet and let it fly. Every shot is a question: **buckets or bricks?\n\n## Nine Ways to Prove Your Shot\n\n\n- **3-Point Shootout:** Five racks around the arc. Every last ball is a money ball worth double.\n- **Half Court Shots:** Heave it from half court and hear the crowd lose it.\n- **Bank Shot:** Off the glass only. Swishes don't count!\n- **Free Throws:** Step up to the line. How many can you sink in 60 seconds?\n- **Beat the Buzzer:** Start with 20 seconds. Every make buys you more time.\n- **Swish & Slide:** The hoop slides side to side and speeds up with every basket.\n- **Hot Hoops:** Three hoops, one target. Hit the lit hoop before it moves.\n- **Double Buckets:** Two balls, two hoops, both hands. Sink them together for a bonus.\n- **Fun Run:** Watermelons, eyeballs, disco balls and a toilet seat hoop. Hit three in a row and set the net on fire!\n\n\n## Feel Like a Pro\n\n- **A living arena:** Thousands of fans clap, stand and roar as your streak grows.\n- **Celebrate in style:** Set a new high score and the roof rains confetti while the lights put on a show.\n- **Pick your challenge:** Easy, Normal or Pro difficulty, so first timers and sharpshooters both have fun.\n- **Head to Head:** Pass the headset to a friend, one round each, highest score wins.\n- **Daily Challenge:** A fresh goal every day. Keep your streak alive.\n\n**Grab the ball. Take the shot. Buckets or bricks? There's only one way to find out.**", "short_description": "Step into a packed arena and find out if you've got buckets or bricks. Grab the ball with your own hands, rise up and shoot as the crowd roars, spotlights sweep and confetti rains down on every new high score. Play nine game modes, from the classic 3-Point Shootout to Hot Hoops, Double Buckets and the gloriously silly Fun Run with its toilet hoop and flaming net. Easy to pick up, impossible to put down. Challenge a friend in Head to Head and chase your best score."}]}, "developer_name": "Ako1 Studios", "developer_privacy_policy_url": "https://bucketsorbricks.com/privacy", "developer_terms_of_service_url": "https://bucketsorbricks.co
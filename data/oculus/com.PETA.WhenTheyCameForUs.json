.com&_nc_ss=7f20f&oh=00_AQMwYvXBtK-b51E5i--u1oIB9PFSSqASlAmi3MjqsMgM7Q&oe=6AD231F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAJzbjv35FcQ7kNvwF0BXv0&_nc_oc=AdoBJqOVw1u-KojvivjMeQ-4kah4VE9vH_qpFDFqJB2ZZfTFjBeLMehN3lvBBSteOC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOog59Xis4TWEgnGQmlGnqmFJudfJILHvSGmoCu9kaPw&oe=6AD24421"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eg8EuZ-0MAQ7kNvwHXarKl&_nc_oc=Ado-PDXwLNbMPH5DcgaN52tcRD8sX8PAowaLzDxgfqcPUnEQ8AqHLy-TSfdx5VBn6rQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8UO7xrpXK7PJPtErUpFF1g6h7QoDVD_4Bkz-8cfunHw&oe=6AD22B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMyawwkj8ykQ7kNvwETG0cD&_nc_oc=AdojDUnkZH4Dp5uTOuv6d4PmBz5-B0AKCWvmsFhkW85eUBgWOc3DKKTcaqHrNeM7zjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Wf12oSvEaAWBQYvLihOJNcZdpswA3l6mCkPccADlww&oe=6AD22B05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0aoDCbs9wYQ7kNvwGz7ecu&_nc_oc=AdohvsgQiyZkmaMOGYQ-spyO5VHfEahdnQxoamgg6qVDIS9f6eFhoZoC7ml_XbYjxyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2IAHKgBlBlq-wCKrGX1KBScCDqafWPiM5nTileO1GtQ&oe=6AD24F90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcBM5IRCpHsQ7kNvwHZUIhE&_nc_oc=AdqXbm6sm6A4CZA8xDqZ_VpDhvX22_ATLtxmMXil5C8M_UFi2VoR-4FOUBQSPcxk1XE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7QlHyDnjbQhS0Y6mJrAr2yr-ALqNJ2zOTq-g2aX__Eg&oe=6AD22F84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NU3TmzHaF8Q7kNvwH_hotl&_
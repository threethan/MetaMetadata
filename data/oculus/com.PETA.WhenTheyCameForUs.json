.com&_nc_ss=7f20f&oh=00_AQF4DnOAHSwve6g4Mbj-u73VJ3zmTTUieYwAsUPVM2VbGw&oe=6A974EF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6mv1R453igQ7kNvwFvkrIQ&_nc_oc=Adr86nu5xfkmIowGn3r1RUFAnG-Zs_hx3USo48AhgBid5LbiiSMcFANSaOkhXAk4QUw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8iNq5Nu3TF12OSqiFd2s5oZ5gIid8Zr4HpH3SoGjv6Q&oe=6A9728E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5kuYCPaC7cQ7kNvwFcS9A-&_nc_oc=AdogrgDyPgD3CZPgjnrwieiyUE-kim7AzcleJX-Uuny1L0KR8K0jL0bBGkx99OiFIFk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyL2qqS8-C0p0IqozVgRxCZz7Gk0ORq_aYBmPcUUm8Sw&oe=6A97483C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44UbU9gGo0sQ7kNvwG_Ptj3&_nc_oc=Adr2IdxydQo76W5CLvwea3M5e8cmIpo78Q5liB3MJmX5dOcUBn8zFmN5Ph0TmaVvvWI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlQVFz1gr6o0Qo0SWD4fJskAulaz21lKsj15u61djNMg&oe=6A974805"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYZigM9HqpMQ7kNvwGZrT5q&_nc_oc=AdoMsucgSNNLmKR8fZ3sYnfwpZKH1ytDRFG0WLpzNGKMQiLVdanmB9oIZDrZJA64rjc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-w1fYJR6DjeQ1e03Yp4uplgI9bgnR0ekfCWjihF-htQ&oe=6A973450"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCGnP0rGmH4Q7kNvwEuJfNV&_nc_oc=Adr2YlEuhaNVesMRfGxRk_-E0wizgMaaKKalJzTx8EB5SekCPThObp9GrDgl0OIDZeQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVxrH6ptxOmxiazXBkHNhlN2BpKe3hEznCflMjfqEXPQ&oe=6A974C84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLzrQRYsNpcQ7kNvwEEBF_1&_
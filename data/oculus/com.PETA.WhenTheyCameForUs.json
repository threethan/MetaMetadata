.com&_nc_ss=7f20f&oh=00_AQPoiMz1j83SbMM3NYO1toWn7pt--Rz0JnRLyBmEFZexPw&oe=6AC8F778"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sowx1gfcMb4Q7kNvwHYXBCj&_nc_oc=AdoLGSNF_kWdD4Xwko1jU_7pAVhSyMMbrxbx1YwHVjm47vm51iTa2gm0xCeQ69a2gg0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy6ZhWG33ZVYStE4inNmviLqEsh47CTkgIWgiyd5_wTA&oe=6AC909A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g70ZBfLWkI0Q7kNvwHsF4sI&_nc_oc=Adru4uoi6P5cntCQ0ZxacTRSIkVXKYbN9x-xZnem11_xf_fOpwlSuw3o3ZVl1OdGVIE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH1TJDn80gT5S5HISABspDhR39Vu7eIHqtmrQH-2Yzvg&oe=6AC8F0BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ijbdmLVU2EQ7kNvwGxV1da&_nc_oc=AdpGuM1gTqqDo1cnRiBeRb-0rz16qHuffRC4hqGfrc5J6S1ciYTrcedG6xUwUuyWZgA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPEleIA4uz6ItL1TlBwwTPHC0cCHtbLtm_-o1DV9e1Mw&oe=6AC8F085"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEY-cLGM5O8Q7kNvwHpvrmD&_nc_oc=AdqZb5Qg6M_aZadsPKwnmutVTXn5AvoOeQNclL367PPqscnc75K9_IvsTwS-vAoiNus&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNswaK8ulAsaCPBD6dvqH79JeflEHN9rHMmJ_hj2IJug&oe=6AC91510"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUKuFk7phIAQ7kNvwFe8qkb&_nc_oc=AdoeXFW7vhiEJJ_MMxLgsZnXKG1j_TlgA2REnfw3gxNL2hwpIep-3XvCt_tyCWu0RHA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfKJ4JtLn8HumliNd8EJ6EyVVwRZLh2c5kJE3_7bFJgA&oe=6AC8F504"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whJY4C6xu-4Q7kNvwE-lFgQ&_
.com&_nc_ss=7f20f&oh=00_AQD4dlUjX80bWCcgdNhaXKNjJU8XIpK0Ss5Wis1M3o1LiQ&oe=6A6373F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LOz9x3ZXP4Q7kNvwG3ftd2&_nc_oc=AdrIj5dlwN0_5CsVCPNxOsVVzfinHf8I9-zdhecUoa0BqTIw_5UpQ9dpXXBLo7bZctw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbfyOiWffm3Q5RQUn6mKl6kaSKGUbiYXK24tVt1o13Qw&oe=6A638621"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGybsusyonAQ7kNvwFGAeGu&_nc_oc=AdoMdb2WDU1d5WaY9-Xtu9ptiHEcYGXNSAw-ldcZ17zSuY1oTBbTjafRYSX5vmcfXig&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5x6P9PPCVKhInJ0LZb63mxSTVRYTfMoG0njXlt18lvg&oe=6A636D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZLWg5aOJRYQ7kNvwEMfWtH&_nc_oc=Adoo2ivSTIvJ6fXNrfets8XQUu4zss4T-Rm0f6d9YmGKfOfSvXnmZ2K1n2jbjy0ayL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtZV_K9Qws_A1fhSuy7IG1XClR5HLXRczoK7dfGEwEXg&oe=6A636D05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9DwQcXSKSEQ7kNvwELZegq&_nc_oc=Adq65jF4siZJHidalY8XvTz2hxu2mA8GVF5qO3ZkX9d9LG7uyncOpQlMdAPYYHESXsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMphBbu1keKd-NRWNuOe0v8ABJlI7zbTldR-noyd5gXw&oe=6A635950"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23PiGVw7_bUQ7kNvwEFJp4_&_nc_oc=AdqNdZRqSuPT_fUxh_Ahjb0yNrmBFr_woudO10vHVs76xcl8tV_9COyUSRwY-8PfpBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKZFtCh1dnC5B6JexPp99BQvDFQOZ9TFjfHGexM4GXuQ&oe=6A637184"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maa3uYnabYUQ7kNvwE2a00i&_
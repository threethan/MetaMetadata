.com&_nc_ss=7f20f&oh=00_AQTvtZB1YNtOEgFGGIdhqWhTYNhxVDwcgcRjx7gpbGbVMg&oe=6AE749F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzvMkAtUxZIQ7kNvwH6IVMz&_nc_oc=AdpgoNvzBqyAzIHSEGMHLnOxXvoua8KdyxNQZEZRmWSCri2fWQSqNCU76BmUPSG6Itk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMPjNf6s15KaijDlUy2cYly7DVzTRVlvPjVef3eECFTw&oe=6AE75C21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2_h9eyY8mYQ7kNvwEw_WjU&_nc_oc=Adp5-0UDGgi9K8b4UcfMWl6Z85J9zf3TKAVSIHJ6l4Pw3CmxomsQqhoTHPdFA60PFq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZJ-BXdtBu-BzfrqJXn72acLUkZxb2nKcpj7FmkAGIag&oe=6AE7433C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYrnOuavxv4Q7kNvwGlPxl9&_nc_oc=Adp4wsc8tEusEFzlb-F32QcHtTxfIhPZ7DUIOodaaflmnK6IL1ge0S5umDr0kjER8n0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRif3ypC3TM0mwVVVf8BJXRe7oDn1GMbADHy5ru-DRBvQ&oe=6AE74305"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt37Bcl5zVsQ7kNvwGFh7q2&_nc_oc=Adpd71hsh_8aFAoOK_rCWFE2WHLcTH3s63LgajkLf1kRlTxEGswdkSOrqZQ1aR8edPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMl4YvyGdhm8g6RAQaeQA3gp_JFQp0fnT4jECgKP8JXA&oe=6AE76790"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syAxjEWdWVoQ7kNvwHDzJO0&_nc_oc=AdpQN75GLhpWgY7G0cAJIiW2s_UO4N2kJZcOiox9F6TUzvR_avs9cahEFSVu45e98Io&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1xuB4nnzWdXQtLYsLtH4pT8YwvMIprCNsZPQQDM28Zg&oe=6AE74784"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDhUxLih6BMQ7kNvwFSea7j&_
.com&_nc_ss=7f20f&oh=00_AQIFIzs1-ihpaXAjWWW8DyxIBVcXJ5wAbeH4sMvJPATplw&oe=6ABE6B78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4W_nbYcFwQQ7kNvwE0nijj&_nc_oc=AdrXao0aLJbw8XUpUrOe3fDkJKW_nzpnFVAelFWQB75W-LdXT86wqROF0nQpj2uBWJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAGerJbIwNVYeAdfb3TK-CSVN2PvEGfheFUDAvzDejLg&oe=6ABE7DA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IbJR06TSbkQ7kNvwED_t1y&_nc_oc=Adpq7uEOWntoLbwOFg10AYpXzqjQi-viX2hMMi1RHowPT_kGRZziqv7L1Bmkz5TGiAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0QpP2GozyvUV6XVOSj3oaoqspUVo58kJX-dniz4oA-w&oe=6ABE64BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFKFECSug70Q7kNvwEYFKJ2&_nc_oc=AdqTKl9F5WdaYRnGpGlrzTtAAMDHGZCVXhfGAWFxZ8oArOnB34Kr1fKqkWllC0bIdBI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwtk1yuaFfLWKYxcDtTIbY-tHY3EgKmqyG-FlnqJRqQA&oe=6ABE6485"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80bBU4-rN-4Q7kNvwE3AvlO&_nc_oc=AdrhP8niHc7mHIHX37p-Wc5OrcfjvUE1tNqos9SletMX_quQOeekFVeRHsXj-GwZf7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRDgmL3lwnWUc6hQLM_mffYTj_h8WXfAyB5G1_Hr5Xdw&oe=6ABE8910"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL1whZbTc-gQ7kNvwFHfz5e&_nc_oc=AdrSjsV99UA6OuODw8Ryrz8wty1pzXw7855M1nLy6tgTYmvgTxuB5XDJ_76U0wp87o0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9R9Wr1mamv6WVzY3dF7n7a8JbkLK63HlbXLC9KH5RPA&oe=6ABE6904"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQGr46bXpeQQ7kNvwF_w-uq&_
.com&_nc_ss=7f20f&oh=00_AQMCFtpNVZWImY18dmaOEFALPfC4aRgjN9wCG_RwaCKHDQ&oe=6ACB9A78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl6OR2LrgQcQ7kNvwFs3hJg&_nc_oc=AdqsqJt2FznHtGhS8W2d_bwOrIiEwaw8fPTPIm43P6-BJ5vbKvoUQujalD_m6bzBpjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn-5duIgizDKxULQMEGvO7JzEOHhsKufxaBX5Xr0Lc_A&oe=6ACBACA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs6awedBTIAQ7kNvwEfLoJ-&_nc_oc=AdoaBkuGWn3bm6AjelgZSHc2mpjCicJyQVwsfknbHFkT0TSMJl5QPCzYItdt7e554fY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGxUCtIIaBqlA9smsDqlMQh0TLEYRgMOrVu7jx_s5dzA&oe=6ACB93BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNXz1-Pq7HQQ7kNvwHIFB3o&_nc_oc=Adprx64_CnsnQJ5g0rKO2bZsQptOIzogz0u2n4LOWB3CLMcyVOmV6H5nF3bypw11FsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBXU31glBetukqDxKFfBzgd6dRx9bQfv1d4vAv7NmnSw&oe=6ACB9385"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEY-cLGM5O8Q7kNvwFfkbXr&_nc_oc=AdpOxvG8k_CoRaQz9vhs49pcaLP1xUkVCY3Q4LkvhePR-c3RF13xv3VEnVDSJ-eLU4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5WHEY6e5j8bqY32MkWgN4EE6r9ebcQpDXBsnRmz07mg&oe=6ACBB810"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLR_-KfkHNsQ7kNvwH5ulgF&_nc_oc=AdoeP-dPyAjJpeL7fM0EXxtu2uNVxG_SUeNf3oRfnuhDqseIbywPFgeHuiHRBD3mIDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEe1_Un_k_MkbKrDRRT0RmCRCf2smaL_dMBZf8lnpdYw&oe=6ACB9804"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whJY4C6xu-4Q7kNvwFo18nU&_
.com&_nc_ss=7f20f&oh=00_Af5rpxwtdBLvvO4qjNRYFo3kB_J9FioisW3QchXme93u_w&oe=6A1D9478"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx1Q7VgH9K8Q7kNvwF2BGCI&_nc_oc=AdqBoW-rKz8xJkXU6m9xQh9PhWPZEMhNlm8omyS_sOv6S9QfM3mfMEyRhPHVWT96S_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fVQfUuOfKnONKiaumcT9nLvHNtPp7WMV8UYEclmaPKA&oe=6A1DA6A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqVt-bi8UIsQ7kNvwHi3CcX&_nc_oc=AdptJ9434936ceFW8xli8qkSOJXNIf7vbH7Vx9r8nxeG9yKS3WgjJSe12a4XQVGdTfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_uBoXAapAf13KXBbSomo_NOF0CP3Gyq3Pp6ZExRFrHA&oe=6A1D8DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IDFB852ztoQ7kNvwG-zmGO&_nc_oc=AdrnhG0eZeOeOytJDFyhoNTJfKOGOKzsuMtYrvul0LeuVUSGkVhoZKRYG3_FlFY0YhA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lr9T023khZcE7PmmJMkJdZR_T6_o9EpISx7i4BJu0Og&oe=6A1D8D85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFgcSyYO0-YQ7kNvwEb-Z2y&_nc_oc=Adr9Ps2Ite76yDPE09xos9JHTvGi3IOqu1aOAd8gIdsqRf65gXKzgoiemibWs0R35eU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nl27QcYjByEONEWU98eOVy6z39fCvscRyltVMQRuTOg&oe=6A1D79D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9eBWW8DFLQQ7kNvwFI_dCb&_nc_oc=AdqjMBfBZs3keVuy1ciGq8zMQbJD45r6_DPeXBoG6cyoQEh5U-W2pkergTPm603yNn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LsiPjnjNI44TcXT6zO1pTGLGswtyOKu91ns4b42_X_A&oe=6A1D9204"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRjb1Xl9fvwQ7kNvwEChCwp&_
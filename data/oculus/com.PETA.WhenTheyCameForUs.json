.com&_nc_ss=7f20f&oh=00_AQBvIk0XDtJDQtThfcQh9wkEslrpBAOZm-BlOPTilfUf5w&oe=6A4915F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTgeRIqs-XQQ7kNvwEwv6RJ&_nc_oc=AdqyKsOLd2WGd39HjpFV4rN7_93CggRxipo3LaEPbsLcjkW0_0kgKrE6Y7qW7jfeZmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChAgrjeBvKYvOPlILlyXhEypcJI3pnU_gUni-dDaFqKQ&oe=6A492821"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUkjI0qRGiMQ7kNvwFBm3dI&_nc_oc=AdrjAAYcLFa5oGoY0J3XLnWC7-tcd9Eihb55owQOyc2mQ3WZ_FpSyG95xb7KNrtFtX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB095hsSYfRljwkpyEIgPGTE5STniy52-u30KD6udA5pA&oe=6A490F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHJjF0larQ8Q7kNvwF7_3oq&_nc_oc=AdoVnMcQJKUuAVIstkaPwbugbypiXqhC1JABm8eTa3I6zQBj4XRS5CyZ1g3vYj84D14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAscvzoMxprN4E19ByiduOQwqF4FTM7pQ2Fd1Y5AutfDA&oe=6A490F05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yeO1o4aue4Q7kNvwEx-xwV&_nc_oc=AdrRABocchW_O76oyjL5Zie7uqnzwJjyQk1IkaBMiHYspYAxU8jv-4mLPnItV_dD5ko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCismWhjV-ZGvDQQMbFbFSTCz7QZXMdAnxRkV2CWA9iKA&oe=6A48FB50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zD52AWMr0KMQ7kNvwHNyWgM&_nc_oc=Adr0KGPRGn389ixtmH6CmWcgtpwf9cfG1eWlfKx5puWaFzjnCV23vF8hqpQCvk-7s6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBMrOpy1jNHJ9SqYNCiBR12BiLIOkkPhzMVwmF4IJIlA&oe=6A491384"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wBixrK4L7sQ7kNvwHD_aQD&_
.com&_nc_ss=7f20f&oh=00_Af5OgXe7StQJkMmbIOSMmvDxO7iZCPouVxThCnZYXZwMDQ&oe=6A16FCF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyfVJZLhlmEQ7kNvwGGGFSj&_nc_oc=AdqWYw0u3zv-Za19LC8nhhvyJLO7XL3GnvGRd3XvEatLwt0W9u1D_dN71HoR0rY8h5w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YtJZYyn1kytDkMpgSA3OR6Lxc4hzI-B6NE-RVLo23fg&oe=6A170F21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oane8GM9KJcQ7kNvwFqqWkK&_nc_oc=Adpv1C3OBun46h6b1IOVvfXX4pr0zLLVusKXYL-yFcW6TpUZyTsl0D9r6OM-kgj51VU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PRUulERHgc5g6kGXIof_akhM9IazjeNLCIu7_xpjahA&oe=6A16F63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_r4ssZTjqMQ7kNvwFCCouT&_nc_oc=AdraE7y2l694Fa8_Rjgd-7SoUg7xCWJwbSVsv8g8GBBtj_1CnfFlkIPnjl02XheOyI4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bm6_x3eqKZd6UxASUrRAUy7cpPfUKT6pjoY-l3iPuYw&oe=6A16F605"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj5YZ1P5jPUQ7kNvwFT8l-m&_nc_oc=Adqi6v6tucXYZJ8YShZ-xBuIRS1I3rs_gH-GLcWkt-QyS_S9qPAyA2kH57ZOUk9jzwk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GCdDOjeF9QGevn222V9ilaWtyeKFeEjGM8lzAefGEoA&oe=6A16E250"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mtX_FXuHTMQ7kNvwE0NnUO&_nc_oc=AdrkZc-O9eNUlDMmmXY_eMpn2-WuwqCSCZGxMtd-bk8ReUlb8TIGPqU674yyffmMfkE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bidYExMzrR-jw8donhMRZTL2UgfGBejAmWjJAGTTogg&oe=6A16FA84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHCgSGnA5ToQ7kNvwHngZIG&_
.com&_nc_ss=7f20f&oh=00_AQScGdriLO1S6vIJYclUMienAp_xtL3UY5EHA2_FkxV3jQ&oe=6AF478F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwPxshrp9kQQ7kNvwHM6yuI&_nc_oc=AdoPEcjzQV6tmSyWDsN5FZMQjggNC5HJZ4WmOS62i24bjjyH1XJo5eHfaZPjXw_8Mv4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1ERzqhQUP63JEkZtdN0NIG88k19jeZpYuAzfDfAXINQ&oe=6AF48B21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGuHRCwv5TUQ7kNvwEMOnIp&_nc_oc=Adpvvy4GQtqWl2zoMAQzI-gCXUlJ1C473rYude55dfq2qi0Rz6gSnWUsYldhcglFbaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScXeNiOscvHyCzDCsIVa9tSWt4FKtWqR9773GWwxAkXA&oe=6AF4723C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXCRwmNglP8Q7kNvwH8sG0p&_nc_oc=AdrhYEe28Af4oaMkSUvQLnzpvKdXPuOOCn8aRMHxyUqjCNH0eKTGMwjxuByj7TfT3_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbRTnIODl_BIvywiZCt41gYTcyKdjcCtZwnrXiqHgrGQ&oe=6AF47205"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zKRnT0barAQ7kNvwHG4hzz&_nc_oc=AdqMu1ltkKaSGRMxZWx98MjCB_13FsZkT9gvCBMZ2FYF_iS-UFTIpXNoW86pyObtXp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSctQ6MLlg_dFyvzmv76tEM4Wxpq2TNJvIWeZUnaXOqjA&oe=6AF49690"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0bNFUulKDcQ7kNvwFYU3Lg&_nc_oc=AdpQW4u8nzOOalCVA2W72qGtI91XfJPK47a0Nq0Qc6JENxpdARxV6DNTU57lmRbb6QU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYxL5SxOQOr3wQqSf2gYZSu_TdUoeXx5MwNSeMk4Np1Q&oe=6AF47684"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6Ib6qoOEpgQ7kNvwHVynkq&_
.com&_nc_ss=7f20f&oh=00_Af6kd7lP-pwUJWQYajCFTx_qwc-n92geiA4A9UVPS37meg&oe=6A203778"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-UlCYx2wNAQ7kNvwGzmo1h&_nc_oc=Adpu6acvTAbAnRk02uWXZ6oi1kxcSNvb9Z6HNxsWqXbIFu4upQeAvgoBJtctxY700HY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q0TS-lp45Bp4C92xzlsyGh9seBTw0VPWus8UtCXCKiA&oe=6A2049A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqVt-bi8UIsQ7kNvwHMSZDc&_nc_oc=AdptDETb7UIW448k3ri-xjTM-gDvnCYT5v7YhF2gr2m8FuPtMD5KH3Q7Xw0be-N1WwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lQ-bUQBcYLX6Qj597BHolL3wrs0-eqrwaOrVKViq5hg&oe=6A2030BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCtKDCvw2C0Q7kNvwFbwgbN&_nc_oc=AdpGIP-mcTWYyNSwWNLqIrWAHirHf-2h8NOkCUmUCyKIStH1etDckAcS2kBZLviznBk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p3M5oKLjos80NAvNxSDnQNb7sAN9IUNRAfOeWT1DuDw&oe=6A203085"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WQrHEYwiiQQ7kNvwEeML2X&_nc_oc=AdosE0Le2nJpICqNlRawXoZ46sZSyXRXkD9GkC4fXWv1xVI2cABoeyduofDGi5ALVq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af796Hzv5bV8OZbYUyO78yMBNI7btFB1mqBq9qUNZpZaQw&oe=6A201CD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa4ZghGjIP0Q7kNvwFhbW7_&_nc_oc=Adq0Q-UgGhshR_FvAai8TwMaSwtKHE9RmdNBNd5meqRwSDqiZuxALpztcK5MLdzwGE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lNStZIZKltrNCalMxTdlF2iqG1mqNgiV-1a_Bpwy1Fw&oe=6A203504"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnctxg7NQ08Q7kNvwHhFYGQ&_
.com&_nc_ss=7f20f&oh=00_Af5O6uzGrmZbANgBd4gP8j1s244QtebM6d1RPXLl00IVxQ&oe=69FF41F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xczn19kHE84Q7kNvwFa3Q5n&_nc_oc=AdpCrSwSxpKgNqS4IN8htybHYBaZHNGa2FdgJvZJCQVyOue9Ze11y1EBzkugOdAapJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LtFyu-HcrwNHJGfS3NWLMBvDaYXQfvR67X81e5INx9w&oe=69FF1BE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGYV7v4Y0aAQ7kNvwFEmjnc&_nc_oc=Adqj7Y5lWl0qhKlNyYvYNVnUfgkBz481ijbygCAwAkG-JX1CYB-RbLJ9hBX5WIoeELc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XxV-iQyfIDXOV6AAS6tjXC_l9IqfIdRBIbqXQ1N37Ig&oe=69FF3B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0T-SV0GvqEQ7kNvwEkkyaJ&_nc_oc=AdppgX00XoqmplujGs04WK4fILUqVut8gkA4VbwAwLHwl3KUre6gDyhnI7SkMGw16LE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VRM46iYgq4RuoB7lGss7u8LJOGjvn_54fmMLnnEVIIw&oe=69FF3B05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THinjzlQnRwQ7kNvwHxb73k&_nc_oc=AdqVfKdi_RCoN5z58AmRvIfTdV8K2Al-2nQdQDI-xvGd3EQn8ofiEq5GdpZYgkF8X6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af435O0ZSR24Yomgspp9h9Ncl2ssbxMgqHgXv-nQjNGQog&oe=69FF2750"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XL0egKbUBQQ7kNvwGwzejt&_nc_oc=Adp8brCeErI-M9rAhBAyi-2ap1_3RiPUFVd3_bfYs4W4Ax0M42Waq2c7hDaMkDmW6y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63G7xTtQ-InhGDq2zMo6R1riebZYrY2k78c_fnYyq-Cg&oe=69FF3F84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBdSRkZGWx4Q7kNvwFMB08z&_
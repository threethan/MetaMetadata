.com&_nc_ss=7f20f&oh=00_AQFjVZeNDu3fmw6Mrqx8dJChKMWglVJQDPlHUiucqmCOzw&oe=6A70A2F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adRTi0sVlrEQ7kNvwGSsW-G&_nc_oc=AdrlsHYGkE8Ec2THKIzfu_2Hxhg3Cowj1TWEdCF0z-9-0T5SPLalOxhI3yCU7j9wRFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwjmWnj__Q9R8Ciu7s0N_7cSFutfBagdXDax1qdBhKQw&oe=6A707CE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmME3mFkuIsQ7kNvwFaXAqr&_nc_oc=AdplnbsF1bcCZjxBjAHEIYhK-lCCgR0FeReYM5a_QIiA6tWrg1x5TN7FqT9_tPleof0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG79bzKWa3Lfcl7IzqLdzVGR4B7rM58NShSgheDnXlnyQ&oe=6A709C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-kNC8jevyAQ7kNvwEcp9LM&_nc_oc=Adr9mviM7wb7USLJZ69sorwcFemaMGaH6Mx5WLrCaKADf8Y240lll2JqywhmU-D3oYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdjOCmsg7oXokR-twdN8wxfSmzuA7_tpks2ZR0DX55sw&oe=6A709C05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swOsOe4BWkcQ7kNvwFiIK7p&_nc_oc=AdqJGdtf0fWT4RQPqpasZKK8ULKQQ6rnKYFs4dEWXr1AlInEzcgHhwFr8im1qmbuZrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsB2fX9yz6pWFmlMDuTp2UiBuZgP1Pjv9xzeXYIs8uZw&oe=6A708850"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f90TQLEg20Q7kNvwHJ_7VT&_nc_oc=AdqwqsnJPeH-U3Ibp7f4UhCpTQwbvqF07_SyZtw_qXJldz9QwA_ohHwmGRNGkPJZIZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2bMRBS2KQdvyIAGhBlp_j2M0OAy2CMUm_jkabJsFR5Q&oe=6A70A084"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd4qaMNKlrkQ7kNvwGf1fA6&_
.com&_nc_ss=7f20f&oh=00_Af6RahnhYr4ECndSkuL7xBdXBwh5KmQU0pajNzW6Qvt27w&oe=6A199FF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvHC2ozEanUQ7kNvwGAdWJJ&_nc_oc=Adq3sbx5SUYGMSJ3KFDlbYhPjf4nNoEKUDegv3YE8vSGECoOsbxkH92MKy9YgC9AD6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GPBFp_xcNGWmB1kYjKyAryeBAE-VSmk219YMp6ARO4A&oe=6A19B221"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGCdCTU14SAQ7kNvwEYKjfj&_nc_oc=AdobYNvDOe-2spR9HC_A2_u_Bggvho60ohtXXz021WeuDSB1-V9KyLxJeHaHHGqLtEQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EKOHoHqonii2L4kE70IMDQSjyYVRWnUCxRNNHn0dBkg&oe=6A19993C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz5PaYC0WroQ7kNvwECpJI8&_nc_oc=Adr98BVnLuGOFIpRcPCRwEevehS3SMj_todrnf5ootN5vqg6iW8Koigx7Hka0xWTLu0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GAwZ9v6DbQuOdMRX8fV1Tk6fmZaI2VLEAILqQIw4IgA&oe=6A199905"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj5YZ1P5jPUQ7kNvwFazsEr&_nc_oc=AdqksjOSBvk0Rc1yH2dT8oa8miQPma01GjrgBotUjNhRa3z6h4IaHv4D_BEdZP6izts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QECvDCFotwdrgV-VbWJhfuFI_2t5LkBhGs6zHtM2nEw&oe=6A19BD90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mtX_FXuHTMQ7kNvwG2Hl3E&_nc_oc=AdpL5G5mn5H8fsmCLRmNoWpTyFEkPlVV1ZUyP-G1l3X32dnQODU3-YOzQOfl9ON4iEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kXu0nizHU_w0ntLjf3lEVFBStxYRCK3kw04vbOb-oQQ&oe=6A199D84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWlmH9LK-fUQ7kNvwFztE9e&_
.com&_nc_ss=7f20f&oh=00_Af4gSjR5LbzrkZiy5-QcigSHbVA205NCbiFLcQ9GhxD0jg&oe=6A106578"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKsHlqr6xf8Q7kNvwEvYN6K&_nc_oc=AdrrRUUui_xO6lCA05O-C5lCHrM-FzfAFiXxd_hXY58e98icU6pH7MIl487-TtwLFCU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fce7WaSU6gWae9-e3UwNP-7C1jc9pVVPQTEzVWT3Npw&oe=6A1077A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHHTjcLz7UIQ7kNvwFYBMsx&_nc_oc=AdrC53PR3m-tNZK9CigQNbUrngPWdvT7g7lupIayj-SP9bcnXEeL-oyUHDYpD0HOR64&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ACrRMUqLvJ4XwnSP8MlxOLDZHdDO7dH1I1ENJTuAhTQ&oe=6A105EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_OJ4A7hcH8Q7kNvwGPQ8gc&_nc_oc=AdrMnvb0notbI4e3PIo6_KSr--0uTtVRdbPDJS1fHqsLIp6Zqh9RptWaYaQAvqWZurg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bohexscFSS6saz9vhQ14Hgc5iZDlPRVsfEWxPA0GgUw&oe=6A105E85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTIfwh8Puo8Q7kNvwEn3UnI&_nc_oc=AdpXXFlnAIpb5caMZJ9M4Qi9OoxbwAwx_YNs2TlY918J-P-x2mudjnJeIaF3el6Ku_U&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AMPr8ukXg3OuaBU8yOL1gljIC6IDMJ_zhTjI3vMoCgQ&oe=6A104AD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGkSxUqJyLoQ7kNvwGxVlkH&_nc_oc=Adq2AQsHTDwLO4Uj47F1hf-fepOvADI9mZisCpSsbKRJBdaWTAzdBElj-dxemJminaA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67xMd6t9mNPqTPH9jCNMmHhQXK4jBMos1NM0Rpow8zag&oe=6A106304"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwQG1ivOVRMQ7kNvwGseihe&_
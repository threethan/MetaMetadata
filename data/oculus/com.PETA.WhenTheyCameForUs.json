.com&_nc_ss=7f20f&oh=00_AQLcSTcl17BXwro6F4l44btgnE0Kj5uRtnSWiuRHuSM0pw&oe=6AA801F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msepEKl3ZT0Q7kNvwGTM3cf&_nc_oc=AdqN0LCzm2BgssLlSeEuWDK7RC6ackLG0knvqyO9D-HrdH4DUiAH87cZoynSPoQKFwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT6LIsdtJZJeGQ0Lgt6cu7pqcS0TrD96D5JKsQGQNAGQ&oe=6AA81421"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhJaDHDk3OcQ7kNvwGOwMZt&_nc_oc=AdqDoFshn4bXP1o9MSwzXLOvrd3KQwdp13LAb_toC2MsKUpAI22VtqOYMH1VA7Xz7_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbjHgk5UCxlbcgNk93U3vzBuxcPianrExNgZy1lnH6AQ&oe=6AA7FB3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWR-yGq3hfAQ7kNvwFqpKvy&_nc_oc=AdoJBrxvQrxeCzr2JKbxuHapDHet1UNWOH4TbBJbt20IqPXZ_6jCkWCeZpA7YNjfKWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl4T84gZBie4sD_xBq_G2tlZ0-NLXtHLeZ1HXT_35YWw&oe=6AA7FB05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xylz_TYVwXsQ7kNvwHLgC1m&_nc_oc=AdrQVgUDXJjZBXA7YPGqIbPVuLLcG4lMrUWZmDqXY3O_VyYAvzuD5T7JCmcwqZSU6GI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0ycB6CtMWQNBrmhZP6n9XElso0ruRPgPG28n3_cUmDw&oe=6AA7E750"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRWvZl2otHcQ7kNvwGo9gWc&_nc_oc=AdoTOvdabs7bMQU5oy8vmsUNNSYCk5QLhm8hOTi6ViJKubWqm3GlZLdARd9sGLo3PoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ36jWwlwpztqZRy3i3Ih8SXsLBlHa9dsgvtTjtWMvIw&oe=6AA7FF84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ju3fBgO1uAQ7kNvwGlABX6&_
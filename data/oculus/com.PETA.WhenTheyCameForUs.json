.com&_nc_ss=7f20f&oh=00_Af55Sn7vqDNVqcB0W-fk6hetHM_1dIsc9JEaaIrXvIqDgg&oe=6A184E78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvHC2ozEanUQ7kNvwG-G7hW&_nc_oc=AdqztBGQ5uFxgYgwZ9ZEooACdqfvxlxL8biSBJgOrpENXgi85_8yOu8-YDDhOSSrzOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bAMyHjPuLnDsohf91kBMhNTh_u1kNrnyXD18XNDhxHQ&oe=6A1860A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oane8GM9KJcQ7kNvwHokNF7&_nc_oc=AdoyjbnuRAGShKLHggslLXwob_GxKI-KfdG2ye4jhrcXeXu9YPX8t9zCK55EtRGKSbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pnhpGvZ5fopjcVpnyIv_m8llby7smCWhDo9o2gjl7aA&oe=6A1847BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz5PaYC0WroQ7kNvwHndqXT&_nc_oc=Adqy5XnR6_kAwNnSv0UH3ZW3JSHZ6rVMwWUoiIiLr_hbHFJU9gLomKKi3Fb5CeVT2VQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RmQLpwF9CIsSwNWN8d_Xgfhg6Rp9TjNNj8sMicdkz8A&oe=6A184785"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj5YZ1P5jPUQ7kNvwEuby-F&_nc_oc=Ado7OuTeusFlpaZKS8PQeAoSmqaxSJELSs2lZ0V5D2BHVpzMme0C-DXNmQRSKUHdcf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O81Ngfe23hYw5KbIF9qX8zDrRw3NCIzWHzX336k65hA&oe=6A1833D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mtX_FXuHTMQ7kNvwEur-WR&_nc_oc=AdqdzHPDN1UVvGUQ3001offzbuaIIjv9lGt29gVSeVGUozNMgOIn8MaDvWl_2cMXvJc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GLcOYPgECPmY_mV72g4lA8KJ1QU45Ioh7b4IHO8aaMw&oe=6A184C04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWlmH9LK-fUQ7kNvwF8aD9B&_
101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pews4DvnPYQ7kNvwH2T8lL&_nc_oc=AdpptVvM6Wu_oedp86qgH8gVqgkU3qk4hpCj9NF5iTDgaID3vct9t1SI2xi7HEUFOsc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNtyWeE6VTqNfguajt_lIU3TvLg_A5ehyfR3Dtmmc_Kg&oe=6B09C938"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxWjk70RubkQ7kNvwGTeBJn&_nc_oc=Adp940mTx-HODl3IFsUz8zmfxeye1S8RQ7WZz-VJCONkSLKc8cofOeKpRG-DQTDgprk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkHVex_XQW6T7TAUi30hUA6NjQ_pCVUcOR54HuqnY5AA&oe=6B09A321"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJKlwJPkcoIQ7kNvwFpLHGY&_nc_oc=Adru5V5Ckm5gYO0bOLgF-7f_LHeUNgFfZiGGYS9zk0VrJk7Yl9vguk5XvbNLBo_Y9QY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV3ZH7gaAoHwVnLbun7GLtzwPj3OTOvD4dAebHgfY_gw&oe=6B09C27C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0JM5lm9ZeQQ7kNvwEfhDTu&_nc_oc=AdqlLl_EFh1p2-ulNyBYMIGcCaCje2yR-aYV8bA36XQal5xYFBFticHl_pbM0eLYLuc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlXFqnBdJJ-HPkwFt-Zm9ZFVO7ALPPhWCCrwcNvXJYfg&oe=6B09C245"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyccIbY3zuEQ7kNvwGeYqDV&_nc_oc=AdrA9k4iJfz2VrQkQ9RT1IU6eB6J8n-gQ0SzYTKMzy6Q-E9yGrAopAy_okSuLIQuuhE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsUl2lqOvJ86ReonTrrW-5ERcDF_k-8QfGCHS75N2ToQ&oe=6B09AE90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7rLwET1ujAQ7kNvwHbKwKp&_nc_oc=AdpvKwBfofUKTOoAMv1KwXuCKO-wuMAyGwbTOgwLPy2-zz2D2RYEvihK81bar1BqtFU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh
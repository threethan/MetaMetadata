101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQOI5ybsKBMQ7kNvwECTQjO&_nc_oc=AdrpM78zMApcJKl8ftO3eqnYQ0rr9p4TgMqF8PpKYZrrz917n_L_DvCEW4wtDccyNqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8iCRpfom1LN_MdO4BBcS7mHV7SbFfrwchvLrYrOdjCg&oe=6AFDB378"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02G54shyWj4Q7kNvwEOrBhV&_nc_oc=AdrBijbL_veJY2_5n-8atBAPzJ4SpBUvFA-KEhgjuD2XIUPXm2m2mjRAT2E8KrswmUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkCMbQbypqg23mkoXogmE6Gn-wrIdOzE-nVxhiHXG9Kw&oe=6AFDC5A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhSMbavRGfQQ7kNvwGSCSpa&_nc_oc=Ado-sg8esN0R9kUd2zLoJYqO-F0KFFkkPn6oiZWUUpOP8_UDtcIEP0_WuHeXz5YiW2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShGIxGzCh8alrleqKgY0s8XRF6reuRUgx94aCPnzaDvQ&oe=6AFDACBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwP1Myh9JPYQ7kNvwGt3PEf&_nc_oc=AdrPxVGwlI8M2VeB23aTzlOXNq6sl9YUDv7jLf3HQ8JSOs7cxn0B8VZPNIOPw4ZQQ_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_PXVC_UwVOChFWtwWWyXE_Yg46MDLSZDQAGxASLnzQQ&oe=6AFDAC85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8o4cCEAU_IQ7kNvwHWbsg3&_nc_oc=AdrgqpOzkRB68ODh12TBJK4vjJrujxUjZ1_BCXZGFCz0vixH8DNsG4YGMIiw1MSzqpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz7Qk-D6WQg99l-5Lk0mO0EHshrpy0CiycLVcd62V5pA&oe=6AFDD110"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYKhmUGb-UYQ7kNvwF3oWl9&_nc_oc=Adp50R8rjs3H9oZYt7CpYGhRgLIkcyxB4rxylb763vHiwrTr8K9PUn_Uju8bqIJEPi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh
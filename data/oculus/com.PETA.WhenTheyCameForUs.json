.com&_nc_ss=7f20f&oh=00_Af5qtEePm0xQAiEzVoO-ASfI2HEL_oYUzl-6qk03XTrpBg&oe=6A0C70F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2pH6Ih9sx0Q7kNvwF3bycp&_nc_oc=AdrlUvcGDJ9u32fbo_yOtLnLhR5uuv75crHzBhaPCUkvXv_vNveHyIJfBAUK7-mHyU4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x1ecc5zYn8nHLAAUh5L88X2QDkwMPa60nrvZ2hzGJpg&oe=6A0C8321"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igPjff9g0FAQ7kNvwE4VgnQ&_nc_oc=AdpoGzUN2I85BV-ZacoyaRHOxZ1C0h5ADfS4nOsN6q6NF4JmTOmJFePPXGXXEK-OyMY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H5CZzenQB38pppoPMiXyAdZmeP7JpO1dPKJkQvhcwVA&oe=6A0C6A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFa9lA0qkkoQ7kNvwHklESU&_nc_oc=AdqjTcCPw6P_v67XZHhXXuKEv8GU2OHkdNT5b50QzSMdOVMJVBRvaJmLJnF3geqtmkk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7abBADYAdX4F85tP1T_q0_-ezpGhIiXde7O1f1XgIeeg&oe=6A0C6A05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFH-8K9f8YsQ7kNvwFWeDa0&_nc_oc=Adou_pzuEMMXDz-QcNGLYK0_x5D-FUvQqiyinx03ARJyqNZCOFkyxgptdaJ_Xk466-Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wdFfajOXtG0R2ni_btn-V7MdUPdSfkjiTktnZBkGfqg&oe=6A0C5650"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TgdQal6mW0Q7kNvwGnhW4t&_nc_oc=AdotBe9dVNosxuE-lgfO1zsuftDkjNKwQ2oZIXEwHad6mGsFxblSspt14dch_TSkeO0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TE-ZaTHNbLV53Cl0njzlx4oI_7aZcsWfA-u3FFzujNg&oe=6A0C6E84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSmH7g_N5tkQ7kNvwEuC81J&_
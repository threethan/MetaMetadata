.com&_nc_ss=7f20f&oh=00_AQPrrOGkSD8nVIHRxxq2efVEK1W1knyo5HGRXrm9u6TMXg&oe=6AC10E78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4W_nbYcFwQQ7kNvwGAC717&_nc_oc=AdpxComvZEKZ9Kgn36_Tv1RNtB4Lj6cLfxVIn5YnPMqaZyb-XjhxlUntMUhRfbppu5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoqBGJMAFgmL_8Z1m3O8ITbbY9Z_ZXQFEximWHIWoy9w&oe=6AC120A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wibNpHi0OJkQ7kNvwEw4ZSM&_nc_oc=AdojM0jC9yrQpoY3vrsmRjCE6vKT2gj7F_L7tEJDLyuFJt2sB7u4oVFeVtTI1ulW_As&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkETQ7XfiWWKdy-tV_BZxAquYRlZe_6yl2ub_fkPnIrw&oe=6AC107BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFKFECSug70Q7kNvwHr9beA&_nc_oc=AdpQ1w6lMir2GBxYztFAZXLxcucM52wVw5fC1Ios9CW12MdpHIhIpg-DmjwO2lazxLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbHGGgwU_p0clcy8tDoHb4tacq29dhlV2mP4yHVJclWA&oe=6AC10785"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhrbYTtwClwQ7kNvwGpvdpt&_nc_oc=AdoLadrFh5tPC-CE5eEEJzZu3_WsfxLtw-A4LgEBXITAuKm6PB38FSy6HOfrGrr4hC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVQMJX22jnSNUvJc97jbI_ayk4LSm9ugyEKBmDam5EDQ&oe=6AC12C10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3HOFJjO_Z8Q7kNvwEolyfq&_nc_oc=AdqUqyVIyTAsExOGZEzB5S50isXxzt12WkYh762bnDUqiYCfIsG8XT8rGU9z14gM9Ko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIlU6aMc8pR7ZV-1UoHJymIp6pYX2_WidkllCy10yUcg&oe=6AC10C04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIbpkIQ6B74Q7kNvwFMa2XQ&_
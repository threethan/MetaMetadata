.com&_nc_ss=7f20f&oh=00_AQM5uxLoKBMj05hqXbRaWVCRq5v4troJBjLagrLLUfoq8w&oe=6AE5F878"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzvMkAtUxZIQ7kNvwFmaVm3&_nc_oc=AdoSvHI28WiKYL8wqgEVjlWmZABeT8zFRhU2UtAlnK1XMjduT_uqKWnWr8YUy5VMa9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGd2FS7yA2PnBWSJ5-Lbwq_-YAgWnTNoYiONt-5xp6KQ&oe=6AE60AA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USLUOhFdXbYQ7kNvwEqPBqF&_nc_oc=AdpgLhQHVsXgHj72TWUf5U9MDw-7KpJS9ek9rQl-Z2vPWeTuEYlTswTYzD0oJxM5VMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBDfpuq_qVmMVmDTtgXUdn3rEiJS4gZPIpQV6RWxdoTQ&oe=6AE5F1BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYrnOuavxv4Q7kNvwFffywg&_nc_oc=AdqduausWHoFB6jh0D9-jjr0mid1n2itvoJp8fvcvQpngGo9SKRAD0IMCuooWJemPbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL4lnY4-NUm5ojenzA-03kFYJPdyEd0U9mhgzEsP8ywg&oe=6AE5F185"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt37Bcl5zVsQ7kNvwH4QR5-&_nc_oc=Adrp2uScWmxX7lH0ZrnPsc4DlKv6cVO9ycaprPGD94ISTvbiljoMXKlVohhCQvgN7-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeeUwGcAcDNKYsRvd77ER3bEgBOnGBHfgLIGcwkbsu1Q&oe=6AE61610"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqzCQp5Z6jIQ7kNvwEwrdqS&_nc_oc=AdpX_HTwQeZJLaM8kL1gaCZrDT6rCnhbkNHPv05s2GK6PyoEaAGyg-rrYaqEMHJ2XaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPECIwVIJ2j8h5ifke0e_xeMHNvO9ZXO3GurDcWS86mlg&oe=6AE5F604"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDhUxLih6BMQ7kNvwHyb_pd&_
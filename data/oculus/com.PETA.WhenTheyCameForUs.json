.com&_nc_ss=7f20f&oh=00_Af4mvEONJU3iIngEaqqWfKABKxtoIgK0-ezSFQf7GAeY0w&oe=6A087C78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ-81CBrO8IQ7kNvwFlaGe1&_nc_oc=AdoXT4_-koVfG6TMNO8gdTQQH5orEG8JVwsfkwszA9XR6U0TEEZ3kJywlFfqgigaH5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hOb8GWQPNIMmAwW8gAEARmr8o26MvOvdWNxKENySJ6Q&oe=6A088EA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=415GRtvmQ44Q7kNvwF3DFyk&_nc_oc=AdrlYAWGkuiTv86DbVZNkribVd22s32j-YBVQ-ISfyFUsYJlebNnhifRmjxuiMPL8CY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Unfa4DVm59l1sNQsIHnBPZFgel2DqG8lnExhgwMPifw&oe=6A0875BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5VLNrm9fUoQ7kNvwH-7RBD&_nc_oc=AdqH8j4bz5jKkvG7jfT52y8o6_0IDog2Cr3cuJ2WgYiA4rIuW3Qx4VgJNa4TMQCUOqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PDdD34nthvjJZL8Pqrhl6mqXwrm7zh_xYrKuAzv3QQQ&oe=6A087585"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFTTrir0WB0Q7kNvwHRQDMw&_nc_oc=Adpp7X6av9IVQ3kfxeaaqSvMvIuw_IqAcdkA2oCGyQuWU_weLcd-_VVMm14ikxCB5mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-OjIa-tjQMczijkL5kjHP_SDbRmCOzDTOsejur1blgA&oe=6A0861D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFCE4-d73H0Q7kNvwHLummq&_nc_oc=AdrvU5fC9-7BhVVheCJhZUGA7K6dxEZqjaZn-cIg9ygdSRh4H8krQUjMSEl-NJ9GnUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a1MWInwywwOoA3aVqaGUTHjeGqhkvEdPgL_LYUrUkxQ&oe=6A087A04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drjMmqSKgb4Q7kNvwEWRapS&_
.com&_nc_ss=7f20f&oh=00_Af-y-bD_lT-viT9y4XMNlngOl50goE9FN6rIgCjB4htFmQ&oe=6A412CF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtiNIqOJ0RIQ7kNvwFEMods&_nc_oc=AdpvWkHl3y5gNSIGVcXaLjWKgRXTXmY_2_RU8eLYZklcpk7NcAfUqIQP9kQsf6T89S4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8vlSxsKvdU34pTxvQ9sBWkjonbczuJr8nimPJSXa00A&oe=6A413F21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfAZMtyi4ZAQ7kNvwGnnSkb&_nc_oc=Ado304Gyu_aVe6fVutdAXMfTzJKMnMwiAsaTBfDvVAMgUnBRfoBcUAmIWgUsYxoAHGs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vYQgioo__mOufnwC9sfqmkQ86pOQGbco3cw3ROLYHOQ&oe=6A41263C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaMvWYaEKe0Q7kNvwHfun9Z&_nc_oc=AdrQevYoGW5_rnqKPtyT1tGedKWyoZrUhr7OBcTCXmR8wzOp4VUfOpdLL8dD43Qi1v8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pUiEq-PJX20jrxCU4zdzYwdNUSFqB7f_DYF86umP3_g&oe=6A412605"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWWT7DLwxrwQ7kNvwFGcn-d&_nc_oc=AdqJKqcvykZA9OlsZwB9jBD03LC_yguDeJCDwO75k3lBC-c-FSL-qPzdX7WHOtyKbbg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GPIFmhLUU83UOTQNqvDgdq23iUREAH-0vG4uNYvdzsQ&oe=6A411250"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0l6Auju7twQ7kNvwFMd0mw&_nc_oc=AdrPD9fZl8SiYdP4_Scm3EXhF2gGkVYvvtKMtLtmO4r8rfwFfVuiJ96TPDOngjRFs2w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3AledDID0rUzy3_QnKGQonCWUn2dXCYJRaNTS-FfIcA&oe=6A412A84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0kO9avS6uQQ7kNvwEL5g8a&_
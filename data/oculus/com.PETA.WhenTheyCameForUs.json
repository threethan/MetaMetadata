.com&_nc_ss=7f20f&oh=00_AQQ99cj7j1Rd1pI2TUvE9GMTLgP8ye7I6ac9zwGweBqCAw&oe=6AF08478"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwH2kgAJUTsQ7kNvwHlSo3p&_nc_oc=Adq4XTC5MxfHiAf4mjhwSyKa_mKchk6t9tz9XQrUPYGia7CWT7bJQmnxzKyDR1-y-w8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8erKIC5AEECpIY4T9A4k70ZbKE2QkeW9csylwxzf99g&oe=6AF096A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfkrAKAXyTsQ7kNvwFbDTOG&_nc_oc=AdpwzV61VUYRdpZ5VMScAgRRgDspI3foHaiF8T-B8r2y7Mpyf9xfsyuXRBFlpQW-LNQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyaiNj0szccyt660-UBFKYONkZ-xPMoLATKbfbF1PZ6A&oe=6AF07DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxpSt8Sd4c8Q7kNvwEawUuL&_nc_oc=AdoADa6uDjPGRbuVyMBAke4SwdCmL7YrjDHd7iQ2T2fQ2WSomUMfZfjQLnLTjN7G_uo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1VgOjv2aneAiijZwE4TGKW3An8UUSU1yuPO5Zske95g&oe=6AF07D85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3tgtk0oSLcQ7kNvwEJ77YG&_nc_oc=Adp6e4NqEAbwtGiKE8PbMJ4nTAaavknBPeekubVPeU0gW5He6-vEYiigS9O1JZeauyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROnQ2AFlt2JyPjLmc5tuWcxPsn6-xp617MYowAPY7erQ&oe=6AF0A210"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RTVQfDTmcwQ7kNvwGJObOI&_nc_oc=AdqkGqVC-7sfMUjtwt1GOvkAVZoQcovgOU4rWmenuSg8hfGei374YbnyUnWSFEA4HqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzyE5Krgbg6gBTp6ZhyPcePUMsifHMXOEBKma8wJx2cg&oe=6AF08204"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwHtLPqjAnkQ7kNvwHf3pqS&_
.com&_nc_ss=7f20f&oh=00_AQGDHyMjjO-xaZ0y_VDiydGxIJ-ShxMW8eCyWMBwGMReug&oe=6A71F478"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adRTi0sVlrEQ7kNvwGg-7mM&_nc_oc=Adq42PxPpvlXTawfWihHwy1uUlL-y9yAEjhWx_epzK25EDfGT3b_YMYr1WpiuLtN4YI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBe4yIabhycdqaJlwgrlzIBRLXVop3ES2QfhX-SR_q9w&oe=6A7206A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmME3mFkuIsQ7kNvwGSGBX4&_nc_oc=AdrgkID06kKYMAn8_AsVGQmmM0gpo7Xb-eJ0qH4btXWN2jAu2XR7gdsfgqWu3EN1I0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpAUUPYLJ9ZKbkm_WGbshsWi4WWmBFJolVFwfzZrZl3w&oe=6A71EDBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-kNC8jevyAQ7kNvwHdQEHi&_nc_oc=AdqAt_bIYlY_4UTxTWACgH2bjjrY2PT9qkVwFrvm7XJEtQ7Cht1CSLwhdQqSAzadsLU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxnWJVBMragwNCIdgmKgIw5k4XKMMEVKb6qkZQjn_iXw&oe=6A71ED85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsRR48396ewQ7kNvwEl2EuD&_nc_oc=AdriTAe3Dxc0HtzVIXRlC-bnEIDvi1mxBbhJ4S4eEe1XIO_KWqiT6RX68GzXZBvg5U4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE00KolXlmqKYgPlkbKgVL9T2SYOwbDD9XljKmfo4q-vw&oe=6A71D9D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT7bA9NuRl8Q7kNvwHpn1Z9&_nc_oc=AdpxVdlvb495Sq24YdxGzgnraxzoNtiJ1oQ_RV072ZkF4uziA7ox25E6oijVaOUfAyg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEZJsqOmRjplSIYtSAUsb1k2MJYyD78964TLiV1gGE2A&oe=6A71F204"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd4qaMNKlrkQ7kNvwHzCnD0&_
.com&_nc_ss=7f20f&oh=00_AQKGlSRcGUfF1P8fYQqVQ75J6Zt7HxTnAnP8gv2ydJg--A&oe=6AA2BBF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVUbIRg4M8cQ7kNvwG5qrsM&_nc_oc=AdomQihPLkiWs00C5boY18GLIacU1MkB285pPo5ec_39lKmRLigb-BB1gKUSB-cql3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlBUCKKgHChyrzRS_P9q0-y4jHsRmGn-CDQKA0DOfTLQ&oe=6AA2CE21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfQ3ZzM8iL0Q7kNvwEhOV95&_nc_oc=Adqu2G8U23DbV3X6ey6u6Cz5zJt8RnGQQzKBKbawVTY7pN3q9sbodFTgrUQBS0T_lwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUxZvZIVEyy-Ig6mTRbBLF1OqNoeUYuDWlvo3ogDMXGg&oe=6AA2B53C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0XTcCNHYNAQ7kNvwHAh2q_&_nc_oc=AdoH34wvVIcSeinQJJJATP5ki_tgZYn5CRpNapfXOCRAHYbo3vcnR4gDbaYaq16smno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISIev5SOQrAwV6IFi57syKDxlSfkI7l6iOe5_DnZKacw&oe=6AA2B505"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izw8u8TfB3sQ7kNvwEtX6pD&_nc_oc=AdogPakZDFOH4TsyOJurTO7R8BbbOsyIMm9oHqoefYwZ6mNVlZbyKNNNRa2BUIiIhVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4l9_olHuUt59MYA7BcuASC3eSNQBPYYgcffa8ki87nw&oe=6AA2A150"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzBnNF6XyXkQ7kNvwGPt276&_nc_oc=AdoebNvruUf99owEgOscknOm-qCZbJyrt7Q3auhhIRHmNQAdp79TU57L3ZH99qwT9aI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMsql1xubBIqe3at3pGGlZ3UT3QG8iZMYhDIVrx97Z8w&oe=6AA2B984"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agMeDFj8oJkQ7kNvwEtehsm&_
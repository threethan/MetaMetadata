.com&_nc_ss=7f20f&oh=00_Af4ZQHOldE67bleYUsKPl_Jnx0QHHO8q9P4RKA3Wed5kRA&oe=6A1459F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyfVJZLhlmEQ7kNvwF4oL9b&_nc_oc=Adp9cBUkzrjK3zlI9RkJlWxcQGrc1qPO-uJY22mhFF106auy0-AGiH9_Zzf_NYgQhno&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ldFB2NG1xv1zb8yoeJGur5rtDuPORwqKhV0PuCQUEaA&oe=6A146C21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByuHEguP6UgQ7kNvwHRZbli&_nc_oc=AdqBapxuJRP1QburaDnX3M0yezSpDsaz3UchPHYyjqSS1-7X7u_5_LHajSdvvIJyTIg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jtau84LgxWZmmItsLYrati1lZhUIGLbptnJ-EG895wQ&oe=6A14533C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_r4ssZTjqMQ7kNvwECspqp&_nc_oc=AdrdjJpyUMyUKiA5i1IdC8VWD9NzqDAOG1ciU2aL-TDOEA2zMfoeuHUbdsfPASMHQ1s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TaAHuQIo6IiybdhjLTr4QUWKzck-JkgfTKxsF7qV0Ng&oe=6A145305"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-YAAGFghQUQ7kNvwEEF-_q&_nc_oc=AdpXRTsxh9342IQtH89AqNCOtuQDqHwgdwNXKHARqZsgf4Abdlxby2wgVq_4HDaC_6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UX5sgLLZnmn0pVo2nKB5W20cTpyNYpTJ7hiIS1VgW2Q&oe=6A147790"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udQEQNeZyQIQ7kNvwHXCJHI&_nc_oc=AdrdEs-0yW3Q_cP-whJqbC78V5Eiefc0Z1eoOC9mPI7q0phXWVeGMfj2aJrew4wyodk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nqQnyaNZnFUUDro0hjaSri29qNejbWlr0atoSvcQyOQ&oe=6A145784"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHCgSGnA5ToQ7kNvwExZOUN&_
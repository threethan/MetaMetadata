101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SBzcAwLibYQ7kNvwEzc3Hj&_nc_oc=AdpOV37JCNW6j4j745kYc9xMYmI7s5Ms_7os7LCoPKO4ZHfIyVJKhKk6pfBfjW4qoAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFMLWCiYQ3ATLRjj-yrKE42Rz1BLpzay_DQ1_OKWjvSw&oe=6B0F0F38"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vULfxokwE0Q7kNvwFM7wf-&_nc_oc=AdrMBqhFJMmWd7mjPHGDfvruZC3SZviqiKbPI5AjXPxMJkoZn_XSOlsyOYVFanTsrYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXP9LjmGBTfJKuytMEiFWWuDhFZA7YJ2DtqocpPAupVlg&oe=6B0F2161"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgO5XKcgss0Q7kNvwF6YOjy&_nc_oc=Adro0QOxjl0qwuDD2jaUD7yaU-dazZlsJ2xry2_Gjck46j39tGmQACou-8YkVRKfkN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNM8GYNa6I5rMy90es6Du4VeCr3Gj3oaYZ5x1pTvWo1A&oe=6B0F087C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzsV6htJpRsQ7kNvwG3ix5X&_nc_oc=AdrULv4Njui9SOfWFe41GGos8YzmZPcPNUbvXmM11YCOBecoyzWvH-oIIFk1ozNA20E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjBePw0R4X4tUeq4HfE1issnCNKgpkX0uFYYYSO1AMkA&oe=6B0F0845"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hPdMmZdmnYQ7kNvwHzgh9f&_nc_oc=Adr5_lE4t1KMNdakCGaG_Os4CnM9vgGutW_ePZtgvrOzvQow-fMp95YtgBxF1hUcULY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUllqh5VCtnUDpCbxY8DIV704zoyFEQw1AYHevQaBZtQA&oe=6B0EF490"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUYF0ZGu8p0Q7kNvwGN01ro&_nc_oc=Adq70nE94hl2eF4HcLdJqpL1wY5iWztQ_6Hasj20i0Ang7DI1Djuoy1phEMKpmIfvKE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh
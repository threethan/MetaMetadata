.com&_nc_ss=7f20f&oh=00_AQBfXnIsQu5enfBEq233oDNWqK5g86SgBSWBerpa8-bICg&oe=6A4D0A78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDGPDzyS-UEQ7kNvwE9DL6s&_nc_oc=Adr_TfJlz8WBM61rQoeJ8HROIo50ae-LFzHi1Z7i32qf4mmH23wcJjN2P5x1Dl4U-AA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqhRz3erPG_0gMMh0O4UHYC7GB8lfa__msv-JDOE93ug&oe=6A4D1CA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2GoRbgz6OMQ7kNvwHzfj2J&_nc_oc=Adr70wt9pED14DdyRlsx1TjcXJW1FfoShsxiE8yaBSrVCZme06knn8Mdy4y1Ao9w66c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPJ9fY3XBGhxUZgV18bwwP2XfGDnsUawrunbxmVpY6mA&oe=6A4D03BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5BHxetL9_cQ7kNvwFr6ENc&_nc_oc=Adp2oNvyFaZC63cFWqSYmT7twG18JEigQJFiCtLoy8ynXx2HUlKZSJAjQ8qHALamFS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApnf5q6ISlyvFjwrTpIyV976CsBWDaBP7oZ0d-Zb6KWA&oe=6A4D0385"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfyLbHAKJ50Q7kNvwFnBEiB&_nc_oc=AdrHwDXr6SxFC_aIrcbZ8OVTOS5QrL-LeCzrzoAWLA7wVTVj68rWqgxGT19h-4fx5P4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4VubiFJ6BrjU1G4RPjVHEM5xnR7kKW030qhJ45D-ueg&oe=6A4CEFD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyTaqBdBCsYQ7kNvwHYq8Zr&_nc_oc=AdqBI2O-d6Snlu0R3atlBF1wcKnYixZYAhW7rf-Qfy1ba_0En4mLRNtSviI_KDjIdIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8MX1irBhWcruBC-W7ZdG6u3p9XntZGLqSP6udwJGzxw&oe=6A4D0804"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyI7YhmTiVkQ7kNvwH5aaeQ&_
.com&_nc_ss=7f20f&oh=00_AQM_0zAPDggxShAzKHNSWbkqTLC_oe6dVzAaE08SbaLI0g&oe=6ACCEBF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl6OR2LrgQcQ7kNvwEM7s61&_nc_oc=AdpohnxDbYUr21joSWASdUJPR54gXFftUWfbrjTzaQzVqpUhuIpNm6EWx9cSpKeyNYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP21NhH_79nJhu6vKX_vcENex3dwhOROTVwGCei5ADf9g&oe=6ACCFE21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs6awedBTIAQ7kNvwFDJD7W&_nc_oc=AdrCufUQ0m7JmSris4DDx4hugAGRHKBGG2SPqkZ0WwwI-NujECSar3El6OpqMB1_g8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv5aRctdpao3JgvbALPTK84ZeiOkQ6eNhXvnG1YEp4Wg&oe=6ACCE53C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNXz1-Pq7HQQ7kNvwHsYsuo&_nc_oc=AdpLC0gQBHDQBjlMJfAlPbOQqqFhPCDcT_a0n00JrrUV1v3qwVTZMjDY8fmjAwoYUSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPez2cA6ItLXwvqXJAlrOcT1flmPMVLp0PU9ekgOgh72g&oe=6ACCE505"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1V3WtCVBI8Q7kNvwG6HvAX&_nc_oc=AdoWzd1nyPbdMZ4_EBmzJus3rjdhIF3QSd5_fYkgvMZ5SS5m1Hl4PMlMDieiOAv856M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKH60FbDVku7BwhUfoHlFgEEFfIsb9gn1KWbMojwaF1Q&oe=6ACD0990"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLR_-KfkHNsQ7kNvwEnHoJj&_nc_oc=AdoJUGzIAccwOAo8cXMQiwSeDnq7KyqbN_UNp27xt9u1ACJkzVbYwX2B-J16fmubpHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfsHaVvWUqIC01jSDEKR8-UKGI8qAimxp8D8Jf9E8_TA&oe=6ACCE984"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5cYec1V8C8Q7kNvwH9Kvqa&_
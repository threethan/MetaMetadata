.com&_nc_ss=7f20f&oh=00_Af4DrcnxmFyKtCl4P7XqQ883PnTdBZe0BJGIhI-t2TFzQQ&oe=6A1AF178"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvHC2ozEanUQ7kNvwEXRc7j&_nc_oc=AdouVbya3BjK6UhnRFf3kUjHnkR0GXjqHD3OvB9cUGwWpxAnxyAKGQQamAlJtqI7u7M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76AXWDlgmCL8fY0hOYDNiC-_eAvQWQ03F9thIf6dPsOQ&oe=6A1B03A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGCdCTU14SAQ7kNvwGDJFyA&_nc_oc=Adra5uJ-48L1rf18he9H3EvEiwF8dbnMMtPfg2OaSOqdClt5EUmsI6bcCm0C_MZZrt4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wh-txS9OJmhrXaVu7zqSL4eS3_paJZpgP5bxIBZ_KQg&oe=6A1AEABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz5PaYC0WroQ7kNvwFNvuQz&_nc_oc=Adpb_N5O8ZlV45gnZl3RjgtKdPTjZrJWZeSCwveIBepN3VdxssG_gk8iUfNrtCh0XaM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ze1ZiTYnRrKUVmBM7Podf3meYq6klVJ5zHK3S_U1B-A&oe=6A1AEA85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFgcSyYO0-YQ7kNvwGbF10r&_nc_oc=Adp6QrxfUy8qAgPEp6_5BkSf97ixVQRMxiTJP6OqAoKK_QhUouypFJPZzzMYz0yVffg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XW5cZyE18lNTUPBzJtsEY-Z2xTDTM_D1qtmuaNkv8BQ&oe=6A1AD6D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9eBWW8DFLQQ7kNvwF7U75r&_nc_oc=Adpxta_Hgrjxe3WwQhpItYtwV1nfv-OKzLdai_0rt6cntTTdgkSuJiAJU78m4gtoBqw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oIZw__ANwvHvDbxPUpaTS7YNbW0XP1gjcVONTN1GUMw&oe=6A1AEF04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRjb1Xl9fvwQ7kNvwFyPAsv&_
.com&_nc_ss=7f20f&oh=00_Af4aM6upj7Bn94Gawp_xr1HFK_PWoILU1JaML4Njt306tw&oe=6A130878"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKsHlqr6xf8Q7kNvwH6-kna&_nc_oc=AdolLtS47kIkwmemqb1T1SAZ0MfwesofJfnNWdt9swk-fMVDcJGCdVyB3dL-nCBlXwQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af463M_pJ_05AVBjPh46U9bfw7Dz3sDFLpPB8GT8tIVHaQ&oe=6A131AA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByuHEguP6UgQ7kNvwFibcpf&_nc_oc=Adq1QK97tCqInIKdHyYdZP8n5Qs5JqupXUPHpVh11wx49IhXqoJe7HS4PjJ8y6ytmr4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6myQWHt_JYk_2HpME50TrC9RLIlJtho7omm7zypwxeWQ&oe=6A1301BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_OJ4A7hcH8Q7kNvwHi4qNb&_nc_oc=AdqZSKyrff1hHG8lK6nQhLcDZ15ixQWz8PSF57nY2cuyrbUe9fd9p9-Rpg-e8KaI0SM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xDOQpX0k0faSYQbPi0QUbjnt9KNuAch7ife9PAARhyg&oe=6A130185"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-YAAGFghQUQ7kNvwHrIBlX&_nc_oc=AdqWrps5KeTkIXJRZHThJ6O1dJ_xoRYxR6RZZ6_NDFYZJvM-nSm-W0vPGU2N49vtc04&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rsYIntfzxn0DPy59XNvql5dirdT_fcnLVpD8yzPjpJg&oe=6A12EDD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udQEQNeZyQIQ7kNvwG26fnl&_nc_oc=AdrU6zLT7PdDltlv8KS2z5nI8EQwf6GpZCIq4sX9MIvpE8hahFkdG87FyX1xZlIiIVw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63drlGoCQDvAFPupOHJ9OSh6Z1xo6OFTE2eXOgxoP7oQ&oe=6A130604"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwQG1ivOVRMQ7kNvwFHuzYz&_
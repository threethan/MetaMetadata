.com&_nc_ss=7f20f&oh=00_Af87KrcQny-lnSDX6v2t-ktUrDGuXFES6tHCcHRjXT8-jg&oe=6A43CFF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vydg9IJixKkQ7kNvwEIvVxc&_nc_oc=AdrAeFtf9e7hq4xUFnlHfKyFl6cq_NdS9ndtsFiVm2EGAhK_kBWduCWsHdohSmLhPd4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KoJ3U9HE2Uc9MZBbCGNyTJjnjKHkMF9s8cph-bMDpMw&oe=6A43E221"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfAZMtyi4ZAQ7kNvwEMxRqW&_nc_oc=Adrjv2Nkrf2K9fmu6T4BroM6hxcObbY8aLAoQLDe24gXkbbYtVDxDdbSjxXgn1QVzA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ktsCipr11rI0aNsnmWv8br4znDRNX6V8IAftWyCGhTg&oe=6A43C93C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCse0mPOpF8Q7kNvwGvbQYF&_nc_oc=Adpyv40iM_EBuMvNsVdrFvLZd9hsPI5pFgi5Pkh8S_6ftXVo1bM-pot1JqyhZN9KnjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nUXfclo3oFIEf_-jpK6SfCn6xcmctE2sBVKgSKqiKdQ&oe=6A43C905"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omW595LsjloQ7kNvwHVTlN_&_nc_oc=AdrdcIZiuEtNi320LoZN617ZGl7BD-pTodwNuBPrk5R3W9ls9zitjSEiX1361eqA0uY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tBvvTi_5zMvlyMEYPgFAI23O7FPeK7WK6o1rY_-X5Yg&oe=6A43B550"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR-wd5jiWgQQ7kNvwEuMUPJ&_nc_oc=AdoRUY6NLRfHckCCIi_Tikf24YfiTWp98vnSAeM53gDtdtxwegcaoVN0zCDqRyewGvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oSz-Bp-Sl5Jx2aEbjDYYPSXH1LI4-Fz7wNc4nVQOOwg&oe=6A43CD84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo32AaYsqdIQ7kNvwFq1I-d&_
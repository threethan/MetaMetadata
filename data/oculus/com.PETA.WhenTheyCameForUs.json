.com&_nc_ss=7f20f&oh=00_AQBE6cFCJTg-sOA0FetqbQVZwpgs3m6ZCB6Fz5IDiXgptQ&oe=6A6A0B78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsmlhaEXfM4Q7kNvwGldPfl&_nc_oc=AdpQtCjaAYRakyrrPb7JoL1xemliiOixyEIU4D1BwB3edvvqQl4NjXTdH-yPZef-urA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKTUkdJLT6tUMS7s0nHH5-FVZi5q2vLkVABQjsHlYLUw&oe=6A69E561"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENTST3hqig4Q7kNvwEV44MX&_nc_oc=AdpL8VL6cZAyLkDlUcB5ym0NLfhZd_CJtSDQ17johc0fRsAvgws6_QLZXtXdh95ee9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPjMKA3MMTs__Q-OfJn75pFTeV1WnRX7HZJdcqwykmPw&oe=6A6A04BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdMmrgUaJNUQ7kNvwHMjbzD&_nc_oc=Adq37rcROz0vk6ybGmNPrIo4JngsQ9DKqbDDOLMvGFQMzsAPbMySv1kPVUuP194hDac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVIFmX7vFjYJloSCuecnFoNnqBkYDmMK5pHqqvvu6rDQ&oe=6A6A0485"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qJzzE55AaoQ7kNvwFELKZJ&_nc_oc=AdrNL3coKkBkY1sfNaVsJhoLwCkeTDyHJ6VYd-QN0EhfCv0aW3ppEDJlcv2V7NooRCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0SsG1OU546dqjNSR9QjGrPyAXu5GRCpl3KgNBYSXTzw&oe=6A69F0D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4b1yMNomAkQ7kNvwEwDAmu&_nc_oc=AdqdbxA_3R4YpSXdG-fB_gop2OIF86K-hnEHn7HR9XfMMd2dFs0q9gLRu_E9mImQk64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqz8AeCST7ORYLrG6ntHeBPT7nmQWCL9NQdYkRZrP55A&oe=6A6A0904"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81p5GSucZZ4Q7kNvwHdzg16&_
.com&_nc_ss=7a30f&oh=00_Af1pJZ_0VfQh58jgiHqId6BUy1VtbZS8LX_ibCADdkcicQ&oe=69E786F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpJnhYkc650Q7kNvwGCIg98&_nc_oc=Adp3kWv_VUL4M_FVqCno_GJpnChqQTJZlsn1GA8PFE3OvQN3V574qYD73-45mNHE3A8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yAQGrE3-T_E1iBfpFTKHSwGO9o43sn8O6RtaOaIEXrA&oe=69E760E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYHOxAqMEQQQ7kNvwG4ZXXC&_nc_oc=Adoc0T1OE6cG_dzkwlhC45zxBQLkidMStCr8_Azd6SdbtxqGGPGtUzamGL_oaF_H9cA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xjry5SuCb3my_BR95V0OU8g2JT-6fzcLQegBzSu6M6w&oe=69E7803C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLSGgXa8PawQ7kNvwHP_YgX&_nc_oc=AdoQOyKnDLahx20M_kQukHLqdquWiaRbosoz7bc7n45JfYkl6KD0acY-wH17OvQe-8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iTLGla-BMzxIj7p66NcEfVf-1p5Gxuxch7TABNrxZfw&oe=69E78005"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doWtn9G8OrQQ7kNvwGwuvZp&_nc_oc=AdrXwoY6SKb-9B7oM7omsKrbKSnr5yQEZ0MqMWTPQfQrDjUJMWNrRG5A065Nh7KrDFQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GlHY4cEcCt_oO_DrDJAy5Hz40cmnMDLS0L4i_a6tUIw&oe=69E76C50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBcgNo0-DDoQ7kNvwGu7-PI&_nc_oc=Adpf-U5l8-d8gadbc9654pKAALapVbIq4HvgZ_9U-tdJC_ZsfEk5U2Z_ebpqZoKmBFM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T8_EWylfjHSZZVrWH9Yhdmb5tTKN-2e5gHRJb6t9kjw&oe=69E78484"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8nd8D792MwQ7kNvwGVQVO6&_
.com&_nc_ss=7f20f&oh=00_AQEa13SfXkvXnZoYLxMmp6SKyvK96BmD7YVI-cBV9CHq3Q&oe=6A803CB8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgF0I13I34EQ7kNvwEADzMM&_nc_oc=AdrUZv3SMoo_wH1Wb3y-BDhYbGYX-B1oOMoWA51dd1xWhUUMaIxG0gpbxfZWvlMycp0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEhGcKJQ48-H_NwTQUyn9cwm8B8xC6KYj1_MVqhf3BHw&oe=6A804EE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqIw8x-q-e0Q7kNvwEoXp9d&_nc_oc=Adqxc-DNld0J4XJmqQ3TDBHKsliv6fi5Vzf988O35OhPHsteaXuMNsZ51P33Ye71tIA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJCspym2Qf99AQnC19XTBAWOEIXSKTEKIo60ynRjf8sg&oe=6A806E3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoO2gTKlHhgQ7kNvwEe_KyG&_nc_oc=Ado2bK7tAFFMNkbj55w25kR7LumKuOvZw6Lzvp7Sfi6dylrw-YCbR4aDWxyFb9ZDoGM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO28SsXZVHng40jS-BhHWSU21utx9MvePghxl6oMimgg&oe=6A806E05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbS6GoaC2R4Q7kNvwFS7iP4&_nc_oc=AdpcVaU5gif_BNvDcJAE3Ev2bhQetWv8gTtReJpEOcYcRlRghgRDtCOHvtL0SRLwluo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2JqUg7c1qg_adLhUprQTTskZU1QLZIr_r1JJ_XD480w&oe=6A805A50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcQhgfYoWikQ7kNvwF93aW8&_nc_oc=AdpxcvO16OyL2Qm63oqqc7TQy7bDldAVrnqJil0I9MKKtAnNUvbHL_FPmOXmLVKzevs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8GCl6CAZUTv-zkN81uR3JaInRRrsEdru_Q6-r_pHsMA&oe=6A807284"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajgWDEjKkecQ7kNvwEODe2X&_
.com&_nc_ss=7f20f&oh=00_Af6Rgfe-qCr3YYt2OLrRVUtMptIXR2Gmu0mNk8cqP1sfLg&oe=6A033678"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb9-f_gL5TUQ7kNvwFWY3EO&_nc_oc=AdqdzCN8pl-ThyIZJW6Y3BAlt7Oaz_DRkGBTHWMQZRlWeqjEfUjvwAUgdDCLa6logi8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DcYmvJOpF5pCsDJakq5veh6FSaF1wfuZg2cfCHNRiAA&oe=6A0348A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGisReXdOPoQ7kNvwF37g3n&_nc_oc=AdpC3dQPDfCh6vBPlvEAxqo6l-zFUBYu3xp8H9HSXdG6RQeNpRjGILmlA4mWF_BemEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n--cfAYjeiahDFcJDqcw3w72cJly6HLQoH7PHza9n7g&oe=6A032FBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxpwdA19cb4Q7kNvwFhHdjy&_nc_oc=Ado5dhcr2cxN6Fn64i_mIZNxJM95aHJabCctFicg-09Nhr1y89Q_3Vpe83Br_Xd2e6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68e9BWD68KT6c9BkoMBGcIjVp3k4ZM7DE8x4MmtBiaNw&oe=6A032F85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOYeUFgLrk0Q7kNvwEOmSmN&_nc_oc=AdpFhQ-Di1Wx4NP972nLlOG0haLApa1ytDF4DKVIS2HhTNdjgWRQcEI44ipVULMcZ24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47Lq6QgQ-ivuWh23I9Z_mN2Oou1V_-SiCANZAzqoI--w&oe=6A031BD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdYCJ8UDl2AQ7kNvwHIrdC2&_nc_oc=AdpD-0IsOdLQYP5PaepO3dYYe35eb-gfplCkiMz9YvJygzKQ--aLXbUP8crDrViIOTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ruzYgOKhtf0oa2z5uA0rZhpOTkTexfpR4weCEttJkZg&oe=6A033404"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CecMa91AdyQQ7kNvwGy4SH9&_
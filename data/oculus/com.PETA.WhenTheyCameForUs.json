.com&_nc_ss=7f20f&oh=00_Af8uEjQHzGFzPCVzGCDcDWlTg1pkBc-E5mr8xgwvfJGk3A&oe=6A427E78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtiNIqOJ0RIQ7kNvwEdelqP&_nc_oc=AdrZmWZ2vH7avF_UjwaxPuCZWeZVryTEmNPaNBGgmecltJpmKwYc5iyEYOzNYLbJDEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6gixIpIyqcfBbFA0306QYQSes3S8Ognr00EpoEjwA-Q&oe=6A4290A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfAZMtyi4ZAQ7kNvwHzbJB4&_nc_oc=Adrus9MDCRp_-wRTDvWP9cAWf1rcYGbWUt-xHE6V2nrbf9qWl849rm_I9HuqZnrey2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I_fNcmfwUJgczkMPVOemUkzmYi8HboIop1eZwFyRcJQ&oe=6A4277BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaMvWYaEKe0Q7kNvwEMsbea&_nc_oc=AdpX4sI63nIMdHYVjU0vnf-4DSSUGyjmJxsUMHFAIJhH3jjrJ3alCD3bAoMC74hSdLI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97-IW6HR3YedeIPOOWiLtsSQw31oBejvF7wuAxTTki0g&oe=6A427785"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omW595LsjloQ7kNvwGbYJdL&_nc_oc=Adr9tOm7J8IIP7ycV_A9wtdYXXBDVvCdDc85KKrc7ixeQj5Qa6xejuxmLtXIg6ydsx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pDTzfiYPp1GkgjtyrthXla4eab0XF2cR9XYDig_cmVQ&oe=6A4263D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR-wd5jiWgQQ7kNvwGDnjdP&_nc_oc=AdpEDM5LYzBsSDU0l-KMKQAiMKZBpLhuE5dxKbTycVYM7eoQcNw_ohs1ytQPYgF-k9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hiGAmnroUuJrNpEDCJ2FZYoOSPdWBuCd2EpQDWxCuag&oe=6A427C04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0kO9avS6uQQ7kNvwFOLKih&_
.com&_nc_ss=7f20f&oh=00_AQOqOxGconMfztptZ5g46Kw7S0b2Wi4QKh7kmlZiresXzg&oe=6ACE3D78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg77zeAKuVcQ7kNvwGku__y&_nc_oc=Adrn9plr2OzIA_d52T2NunkPswXdUOESPvhrKqOrayPFrrEovD_TEiv9bpkBR-9w9LA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYmBiqv-WI6jDEL7xrBBR-nx78B0JjxWbFdOgQaVKPqA&oe=6ACE4FA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs6awedBTIAQ7kNvwHWbw2Q&_nc_oc=AdrS0LOBfXkfSl8ptWpD1ODORsNSaAYYpKKL6CXektisJkHK1kTI-8iDYifQGxCXahU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNefr771aIseZiayxmqwzYFqLue91NfkJlQCPh-ZLR6VA&oe=6ACE36BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmxZMnj7qcoQ7kNvwFTLOOV&_nc_oc=AdpwN0m7auQ_9WGpG7sTrK2d_SaJsyCJbUjNLHv-qKh3xR6lSi9uAZA3twReEDgNrDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB3w0oyanEgx7uv-TBZ6wvT9fyIUWj6bRcRMcCWvYEVQ&oe=6ACE3685"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1V3WtCVBI8Q7kNvwFKm6vF&_nc_oc=Adrjt0f6VlPzZlhhQcWZSCjmNAqPJacAIHRYTsoY9in39iSW8rVhcXVd6clRDe0BEEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHaxnsP_7xPflJ8w12NRBFU9vm4bHIf8rTnqO0ghC4tw&oe=6ACE5B10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLR_-KfkHNsQ7kNvwEm7k4p&_nc_oc=AdpPt3fGwZAv_PORzgKBa5YdN2OvhMjxBECRI6diiS_AifiCqtwTzMArHQ02XzkI7Gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLS8f7Yg2PJF9gNAGbwYz7guR8F_6NUEJboZsQDDDi3g&oe=6ACE3B04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5cYec1V8C8Q7kNvwEPuhn0&_
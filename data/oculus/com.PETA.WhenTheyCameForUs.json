.com&_nc_ss=7f20f&oh=00_AQGI8091v2O3EL3qcr3wmlmX1pS3H-laU_0MuQ_tW1DvBg&oe=6A7345F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4AiBuCDWB4Q7kNvwHd3jj_&_nc_oc=AdpIV3b0bRE5Sd2sFM4DkjCyFtmpAMk1xv1C4dxXuSmy8RxazOIkLoGgCSU9_x7yIhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHis38g-X_qh0NgvyNczny1dQwnGy1dgpLH3iKcmpQTpQ&oe=6A731FE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmME3mFkuIsQ7kNvwHS6C-z&_nc_oc=Adq2fTI0oCrttW09hbCNXtrKHVG-b9ijXJyucMRlcbyI1Jttlbm3ie-ReVgYT5jSUiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa4h9wcXTwosHV0x2hGso4C9jHuTxPuKg4ugNOi-_loQ&oe=6A733F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwEUabkLQmsQ7kNvwFV_dwC&_nc_oc=AdplVFEK7I4xTTDtVo5itUFlNsj7yrIXaUGRxl4c6wSyglpv_HUytKZfvtOQznYYRUM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9uzN3ijSE1qDtzWRdyOAlT11R4yJewLJO-h1w40XIXA&oe=6A733F05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsRR48396ewQ7kNvwFFLN_e&_nc_oc=AdqqiQHn1mVnzaqjLuZynnvYyVuLoAvMS0L4gshd5nDq7G1gtjNIfPFQtYL0WRg5TvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExStiEB2OZOC4QNSr6evUzlceNk-UUB8-564wpFBzt0A&oe=6A732B50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT7bA9NuRl8Q7kNvwHSBUbu&_nc_oc=AdrsEnATXSprs4Zy8_OAhujinI3iIVdPqfgSCoYI1g9ZZip9w2iyvh_L4VCJOjohaZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlnkN_RAm6vK1A-04b7666wdhn9vFa0I5k4jLuCZJ_AQ&oe=6A734384"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2k-k7NTUhkQ7kNvwEqWrp5&_
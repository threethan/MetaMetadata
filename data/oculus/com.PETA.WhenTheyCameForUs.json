.com&_nc_ss=7f20f&oh=00_AQNOCRtqaVWtthX-apxNdg6MxN4am9_RpuqZJRvonlvu6A&oe=6AC65478"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sowx1gfcMb4Q7kNvwHrGSoO&_nc_oc=AdqeRrIWyXSILl6rT2mwEjwGTim4JpfLGyAn2tewLpgoqIjDJeTYQ_dtQDtI-aP_MmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw5OHRgNo2yEsrKuADlIeXmkkA9KedipjOmIrkv-RLrw&oe=6AC666A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvRqJgUGvBoQ7kNvwHuTZO6&_nc_oc=AdqGzSSMuDvjbfa4wgUjMfR_HwgsoXATuLt8OtnLHn_wAug8qVTPRvt1CB6QK7-3rN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMZPVMZuhYT45LILYOH81-eQneynSmCP3QP1wJJpQ-Mw&oe=6AC64DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ijbdmLVU2EQ7kNvwHs7XS_&_nc_oc=AdqTqJd0WzRa3BZHG2q8YDSPPr8jdSL6i150aZHhzhAnjhJQPFbb3IaRR-a1fTM_8lQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKOxBXnlru6RehUQ7gbadDpsZzNF8Q82fEkDLQFFHrxQ&oe=6AC64D85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoV02CoNHGMQ7kNvwHxVNvU&_nc_oc=AdqxlV2M2aaQKSRVSz2dTpthoP6Lwa04JhI8ZpeDZXmW30ROX79Fwk7RnkjtUHvoR9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq8IXKVDpP1D0M0MH1V43uYz8NHrEgmwZFx3lcRz0zMA&oe=6AC67210"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3OBQt3lxTsQ7kNvwGxlU4m&_nc_oc=Adr9TsLbP_NWj2nCVqeokDoRQfnUOQ6av1yZeymLv5zU04V2pYWSqNvxZM8iYY4I4dk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNugyXJwqv5zY4OdOLN4BuAzEFj1NJkvlXeRYLv9YWalQ&oe=6AC65204"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2kAmpNQ91gQ7kNvwFDY6b0&_
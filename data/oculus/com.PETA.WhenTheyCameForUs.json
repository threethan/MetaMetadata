.com&_nc_ss=7f20f&oh=00_AQJrh2fBkT6d7O3cYoHtn6Ce-LsZuuYOxOh3rmCT5WY3iQ&oe=6AA55EF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVUbIRg4M8cQ7kNvwHyrKrc&_nc_oc=Adpj9eDcL_cknZIKQ7t503Sv-jCHqV0UUNGUAR39c2jdrwuOlLA4RUkC1Y82GD1VvME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsP56mqQroNw_YoICPuuAE6qwgTFcHRiQKrxyNGgfo1g&oe=6AA57121"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooMM0JAKcj8Q7kNvwERP8mf&_nc_oc=Adq0KHFRsBfNW3PGG9lSc6Tj9i_DKKnrToWfYBC5fypRyO6R2RM6JfsN39SL1dIOBr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2MYs56-gK4r-PxbG9GIvOvlwmNPQ4_F6fj6im3rSyVw&oe=6AA5583C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0XTcCNHYNAQ7kNvwFbiFUM&_nc_oc=AdpovHRK6HIeLKr7JOlWiJIcE0EuOMkm4YTMTK7kszYdW2mtWHEZIUBupg1xc0110vk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDLRN1W3g6tSYQCCHHwV9K9OMCSmDusMhyZpEkzl9S5Q&oe=6AA55805"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xylz_TYVwXsQ7kNvwHhRrlv&_nc_oc=AdqTecHgddPybVVuP6T6FGbcfcSgv9WguEaJqgBFzlp2n51aax7-4OXG4R7vulvHT9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfIjaAEsIn1mkTp_ZtZBCfsYKIGiMRDQHOcpB5yGcxgw&oe=6AA54450"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRWvZl2otHcQ7kNvwGpYmxb&_nc_oc=AdrmJA_I-NdRwm08vqVhxiGgLElY2ic8c86JjesCwMNGefbw6eOkjVCVqDf4XtLrwB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmef6RmcyqRhuAugpxNnIj52418weNDO4h08gCx2HMGQ&oe=6AA55C84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agMeDFj8oJkQ7kNvwEBPN4n&_
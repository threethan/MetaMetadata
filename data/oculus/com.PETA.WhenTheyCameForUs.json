.com&_nc_ss=7f20f&oh=00_AQNgJHHvG1ncII9wo3R_FiPbM8GEO5PIAke-9ZItPfJACg&oe=6AE35578"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r04kL6c0ghgQ7kNvwE2OFil&_nc_oc=AdrAOXFfNWeIki6B_6Dshp20M5xqqjgudy47dlopy752IZY4VkeBU20YRK5ZrCwmM5c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwEhRp34w6-QFVMNZUJCO1h9kvIkJDP2fZENOnKM3oaw&oe=6AE367A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USLUOhFdXbYQ7kNvwH766Kp&_nc_oc=Ado15Eef2gVLpu_eYbbpFUrk347ZMQCaPCi5w9aHotZJsnFDwQZf7Ubd7cmgKKXzzms&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIOtCe2opr4ATBQyXj7qiCmbHZHUJuqNJrjT_NtZcK7Q&oe=6AE34EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZstOL72bmMQ7kNvwH0jLeK&_nc_oc=AdoVfjXE5UfgXwHe068liIulZfdM_nc6v88OFyAy2FM7gdvQD9aPKDH61xYavnzU2yY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdu9pgFO3yG_oyx9tlyQFN6qCuXqHCtLvVMxbDyj8nFA&oe=6AE34E85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jTpklI_ZIMQ7kNvwGCl8v9&_nc_oc=AdpapNGIiNvH1yixTtdnJWjbMXs1QFvXSvbOEVXVY6cr4s28ejnCEmop8YmXLVtO128&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNthvKt6h1mABAy77SXYrmstvlBZ-uEqMe6RgB-HV3KA&oe=6AE33AD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaA-nKtKR6wQ7kNvwH5z3cu&_nc_oc=AdpJoR4awyNn9_4oKktkpzrFxqiNUghoozm8BftOuaHXE_X_CDSyWl5HMQRHXPSoc5s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhIZmLFDveW0iLmqW4V6A3VPWr7HrLi1XjG9gTL2x8yw&oe=6AE35304"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP0z6PcP9h0Q7kNvwGtXmhH&_
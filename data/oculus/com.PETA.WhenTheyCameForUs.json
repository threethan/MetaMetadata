.com&_nc_ss=7f20f&oh=00_Af5pWxesDXoDN9f3Li8GlksLOdYvqi2usZ-T-Zo-HRdR3g&oe=6A1C42F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx1Q7VgH9K8Q7kNvwGdmnLt&_nc_oc=AdpGac5Y1GFujgBcdpi17nCjsUtmEUmcWhuU8HKcRqK4RaWYotCo73tcUPiQ7SAb8fo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VUpZDoa3mvll5S-J1OxzT5Md8BVWEsau8aSnq4rmybQ&oe=6A1C5521"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGCdCTU14SAQ7kNvwH35aes&_nc_oc=AdqWx0d4en1gUUONvIqnEt5v8d3g2I9cN7fMpvioiAkm6bgQnbCDf_q_iEAeYrzuygc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73sgNO6dhC5e0V_UddVjxwySGyfl0-uPqzzR4eagh0BA&oe=6A1C3C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IDFB852ztoQ7kNvwEOzkLe&_nc_oc=AdoJgZN9y-zu89sYPWv5mId-99Ar3h0ocdV0WTnj3fOTXZe-CldpcoTS39KJSpdoCwA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ug7xOppOTWjWSVBxsm8MJxRZNkD3HQO5vL6ZVaLIEIA&oe=6A1C3C05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFgcSyYO0-YQ7kNvwFCr9-M&_nc_oc=AdpC5ueoPuqRRM1vbAQGukpeEwtXyidnIsEewe76w1G_Kihm_GK74RK79oJFXjKK050&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WG5_RMtyIB3CoUpUg1Qi1ZZMszVm0XyIObZNuo91ljQ&oe=6A1C2850"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9eBWW8DFLQQ7kNvwE5rAP0&_nc_oc=Adqsl3zM0M7xVwO0Tf9AL3232VWdbuxsuu5ChAOy5Uz5--Rb1QcslAmf2UfTwsOuduY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LFKXZO985-JjfY5P2-DN_01ZpduP6yln3Bs67ovCIeg&oe=6A1C4084"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRjb1Xl9fvwQ7kNvwEPWy7_&_
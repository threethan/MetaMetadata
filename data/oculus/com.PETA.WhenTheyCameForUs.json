.com&_nc_ss=7f20f&oh=00_AQTxg0Xj0dRaidWo1h28kmRlNP7xTikPNUoz106BslUwuw&oe=6AF5CA78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsfTLOy9-vQQ7kNvwEJN5Dk&_nc_oc=Adpm0XtIJfxtb_yqxuxqvxmDgCoRK4f88WXNtd9aD-a1jEm88H8q98okW0ftQAUcA50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgGFcsqZv8tCiM8nVGYEGca62E1Hc-dKjclBNjtSnBxg&oe=6AF5DCA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGuHRCwv5TUQ7kNvwHDSOiB&_nc_oc=Adpkr8WME_9cl11WPKiL_elzGKmj4Z7MQwubXVaZkwhAxz_7HPUwYIPDnmSQm8iJcHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFDPOZqwVyvbnSIgvZ01pVUmYZiFX9ktaU0O6RngJLTg&oe=6AF5C3BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfDx1E1-q9cQ7kNvwHwuD8s&_nc_oc=Adp-1_dlFQIy_b0AQK_ZnMw1HRhT6Z9bGyeoOWiEnyrVnFo4z2vBMK7C03yJ2qU6Yvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_5_Q4B2qOy7LWp5mCGgNatLSVRcf27RlLnK0Lv_p55A&oe=6AF5C385"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zKRnT0barAQ7kNvwGEdm0E&_nc_oc=AdpogjuHkPgIbKikXRHIhGNeRMUzmwEss14qUwyAKhOVEiEdtuLMhRfRTKSTcuEbpyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZPDwO0CL0SzTpcZmYRm4P9JFVei4_v3k4zajKoLjmvw&oe=6AF5E810"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0bNFUulKDcQ7kNvwGQrPaW&_nc_oc=Adr1A_qGvjYJgJ5NSDs_MPlTEeevp4H_8nuQ95Y_OOqw0zXzaMNxLUPXx0CjZgyvxNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7kbJ4oQUDnzMaWVsL_Ge8zPfnqXPhJ0jIFpXnrRnaCA&oe=6AF5C804"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6Ib6qoOEpgQ7kNvwHv28uh&_
.com&_nc_ss=7f20f&oh=00_AQAW1ZAsF4TFwKP8syjZwd0vrDr3QG5qOZy8UVi3HMk1mw&oe=6A54F378"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6EB4XLwD9wQ7kNvwG3ASnf&_nc_oc=AdqEmPmG0DmMMON_djKO2FflDp3xcio9qMI5FHVEs8DC_L5FIoA2eaV7CqdxKocEw3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7HRaAdNWxfYtsrN9wGKOLzMTWLUSQEZydtEmFtuxfyA&oe=6A5505A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7D_wmzq-3wQ7kNvwFMpMyV&_nc_oc=Adriiq-eKzy5dkD5cl_IQjeV5SQiL8g3oi8aTPcPKgKL16c0bVVyrOohtYaj88ETRSY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbbUollME7J_J7_Y6MwVpoz8_VmJ27PwdBPq0Yw4L5PA&oe=6A54ECBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sx-SA3oCLwQ7kNvwEk5h8Y&_nc_oc=Adp_3XlQLyeRo-qSP1UHT2fvMYHscTRFItlH0wW7hm_9Uq0qxLpGte4XqvhY1cQfY1E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFJTuMmC0pvSoEKwBlApD-OmwBcjziJsxSg6bkFcMeaA&oe=6A54EC85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARtLy2JcZqEQ7kNvwEOOcYB&_nc_oc=AdrDsbkve9J3U82k2p-yyszRdLQ_mkKhVLXBkuwItaB3tLrl3KlrNEIP4qXQU6yvIV0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjrE5tFFoMylehKvmOBbJAP7navcLug46oSjU6pu5Gcg&oe=6A54D8D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJ6R0VfkD3IQ7kNvwEbIaCe&_nc_oc=AdpXrgfp7K0D9EZ3GlFwVTXREKGtUaQLJNaxgcWOWzgOkw7klY0RfvVKre4QKvviC6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnQyATeujDL77hzqdweaEyHm6UyLx1x3x5ElfpdQ6OtA&oe=6A54F104"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH-1WlOlxKEQ7kNvwGA9uAv&_
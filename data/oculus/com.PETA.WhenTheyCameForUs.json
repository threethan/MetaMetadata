.com&_nc_ss=7f20f&oh=00_Af9667oNSAs-1-jEjyY2tX59u79gBvtMQCHWUbaj1Aa0-w&oe=6A3FDB78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtiNIqOJ0RIQ7kNvwF75VWX&_nc_oc=AdqzXh6mQ6PhauYzQ8vFkvVFwNvZ-PgL4vo7mmlTILaj4dtSvUPn39lRwNNeD2cBHfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tx_97xx_g6oZbB_hJVoT6Pi6NeVle-M1ilOxzPOUprg&oe=6A3FEDA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrrCmJFR9VUQ7kNvwFxilXb&_nc_oc=AdpvJOBNTuNwvjJQzYM0SmRLNgkAWshVorwKFJms8jCD4ZlclxtqdsFNtWXEoNlYJHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97ZGzgaGnZUdg-zXirZy_y6Bzs27KyD52rpcAyy7XYiA&oe=6A3FD4BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaMvWYaEKe0Q7kNvwHq6WnP&_nc_oc=AdoPmb2wLDr-_UZFiUQTgfk7rfEupOp_1KUCe7gVSL8Ji1q0Clu24Jt_BZYq2UvgP6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MK9QHbUDRS_0P4XzMZa2i29_y3-WUt1dQ7NLq8aFtZg&oe=6A3FD485"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWWT7DLwxrwQ7kNvwEBnkeH&_nc_oc=AdpUjPRZv4ie3XzzpyTQ95YugJKlHjZyCvSO7Dzc4wuA94IfMRK_tWkJS09ydu3sqz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84hJzt2HD3mWqzHAjIcjSuIxuGeRbouNXfAs7qb6uejQ&oe=6A3FC0D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0l6Auju7twQ7kNvwGlUzn2&_nc_oc=AdroLmsuy1hXRN0job1EFugQtz2WbqIYqoQaXwi9F3KNAQ0vAsZlfbajpVTAUyT8Nu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X8SnLSPXLSoQXCD7GGw269CV238dlhoPZEfmmGMJmiA&oe=6A3FD904"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0kO9avS6uQQ7kNvwHPPM8S&_
.com&_nc_ss=7f20f&oh=00_Af1hj4kykh-5Pu2Xzw5HIuIJs841vmJyKhlvqf0qwKxVvA&oe=69F4B5F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TOIefq4m3EQ7kNvwHmJKle&_nc_oc=AdqlsMdpjVmcfZwxToObygpePOSSW1BVFJF18uoisZLVgpFA6K2GDgmpvBAF-909984&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13TGdlzEpHBMZe4NwGY3bY_Hsp36gIwbX3thuFrxnX0g&oe=69F4C821"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xefTNy19ZxQQ7kNvwFD8cNv&_nc_oc=Adr1Qx9UL5hXzzadQT7H0eBDOjm5XhxWD3l61Pk9ctvhj8xEztr7Np3TGnHEj0c8FrQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-hufIf5tCiLtY9NIUtr04O8AQNtl-TKrkPzPe2T9iaw&oe=69F4AF3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kde7CE3apVQQ7kNvwFuvK3A&_nc_oc=AdpG9-ixtd_RJ4dsA2tdZet8FyWxeVJmjTAvBGjJDfa7f44mZW8h2CjhNfZXzFLdA_E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3uUX6bzME-iyOFxb0qk1gge4RqG7vYP_b_oxx-11Qx3A&oe=69F4AF05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njpKioJpOqQQ7kNvwFXR9Iv&_nc_oc=AdpGjAUIr1mUQr-xtpBukG288G_ig7_TFjltela_f1vPmK1Hcc0XF0nYRq90ufo__qs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3T8LYEQrInuM5sTnxEb6-kFo6z4g3YoXW01n-GBEUDGA&oe=69F49B50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKjAqe-bklsQ7kNvwHJyHJR&_nc_oc=Adpgs7bpVslhGTLiFgjd6wfC8TozOCB53rF_2DMMT3GsnJFmABR0edon9YKpa1qMHzw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QvsfJhC_uxnF620Ilp-Cb9c_9GW_YS806sbLom5CKTg&oe=69F4B384"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL1_nuCTJPQQ7kNvwGzvJwY&_
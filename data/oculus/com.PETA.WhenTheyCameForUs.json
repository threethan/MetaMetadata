qLj9w&oe=69F212F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA9qu4ynPqYQ7kNvwHnNbdP&_nc_oc=Adq2e6MJBeFGqCsMD5KbDmrcdeV1CkQCNMrhOwreyP-8t17HATRlUra3zEROJyieF7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ElWKHg8KrS9KOe8Lf0_K2p3NP_dPUT0BSfIynrBPYwQ&oe=69F1ECE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xefTNy19ZxQQ7kNvwG85y3P&_nc_oc=AdrbcIp82dCjRET53oBfpm1vglsmCRJTk3K56WX03s9WIQfooMuRS1GitygzlB-oO9Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3APyzlAoN2zGa6hwlccTkE0DTlz-vd96b57_oB03oJ9A&oe=69F20C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k79YFiMo_lUQ7kNvwEzmcjq&_nc_oc=AdpS94YSWm0Gl1hcc4Sg8yj9o_795DrIqHK8EhanuuX2jdoXa8w7-aAST1Ky704LvK0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1ZXsL7ZOwU_tfK6Z1OIOq8D_NHT_z57nukMnKRVxbUIw&oe=69F20C05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-q81t2_8ykQ7kNvwFKTEGz&_nc_oc=Adr3ePMZQp-GJ_GyhedSvvd4FESPWu9ks7MenYJPRuZLmKth9P9zL3efQkexTLi4rO4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1fSqkuKmMK80lnO3agbW1n8j2vrIMj326HOE7_35UboA&oe=69F1F850"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hQqXMWfiRAQ7kNvwFdmkbx&_nc_oc=Adq02YwlRuWHwepVr0qF_NlQEMOkMFhT5kgdMiLQ4uAUFK8PKYqhg2qxOCWDevufqiQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af38Dja1DGhg6XKoFP9xt1kM2kKzq4EqTdsnUP9yyfkYQw&oe=69F21084"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAYsDXGKAOkQ7kNvwEuCaIn&_nc_oc=Adr70Yd7G4v43GWnbu4wL0Rrr06nXHK0QMpHzOkmKbipkFb1ehYhem7s2goydEXabCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.c
.com&_nc_ss=7f20f&oh=00_AQLtZ8uUJsnxaK4FpTdEAEbzVgQHYSfkJ4f06fs0KdrFyA&oe=6A9D75F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrvrTk4Lb8gQ7kNvwFChzy5&_nc_oc=AdpVkGIuAyRuT4weUJCGsF2EiGfcNeJDB0E6DE2TxVWBzJmeVf7K5mgLqT_TyBrY9II&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr7PBylSFg3ytlOELXpvUuVPzb7NQAYvwo8UAobzrD4A&oe=6A9D8821"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-gZHDwpYRsQ7kNvwGVaTTY&_nc_oc=AdrFzXPfoYdACEJ8-h57EnoTwQcQy8SGiJMdKxp2a0oh1NS7AVtLmouEn81nsq5IGec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuMNJOFXQavcgpDQ7cgM694fwe6EDS9HEjRzxywAQkhw&oe=6A9D6F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwKH7KPOL-AQ7kNvwEpO5nT&_nc_oc=Ado6P3UddsMLEfHWFfAWFkSm3kkbUisOW4MwyiyNA1AeLCh6TAN3M7xeId2gB4H9cAI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyG94MAPgxJmlJgwagnvv-4RN4CR9ex-5kt9MK_CVrVg&oe=6A9D6F05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yor_HvbnVsoQ7kNvwEbTFNn&_nc_oc=AdqY8mUCcC9nsWzdZmLgHLZgiQpTofsT_M9YUFc4Ru9Ob4kGTA8KjO5nQBvghzzhTEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJadGqfV0tXhv6BAI5CR6NQMNDaTjhweYPy8bHyySPXlQ&oe=6A9D5B50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTo6Ygtxo4YQ7kNvwEBEvcx&_nc_oc=AdqPOirCNOtMsGjjezaCDmFrA7gxvwUP-xoNfAcRlj_vUzBgcSJR3rC4ELGObnWTwfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIfuNHksLOiMoE3zqquEq2HDRpuqqqKZYioei_hm72Tg&oe=6A9D7384"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0SGl_I7m0sQ7kNvwHXMyN0&_
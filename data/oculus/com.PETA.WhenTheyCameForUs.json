.com&_nc_ss=7f20f&oh=00_Af4cZaVliWl106AtWGbz9-1vyrPv52012dZyNlqztr8t5A&oe=6A05D978"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nN4ER6H_cXMQ7kNvwEnz_nC&_nc_oc=AdrRowC8qUvHSroifdQuu0hTO9db8imWL2MBOTez-480ZonRq5qQTOkog6v1QlOuQVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IYN-iotMamjL-f8vNzu8UQM6PNMkyyMIU82hSCzHpHg&oe=6A05EBA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=415GRtvmQ44Q7kNvwHT-I7g&_nc_oc=Adqt8r1j9bukQtvSCrLaKFtNfBx8nyV8KIhpxnAPJpXKhpXlckS0yxVSP4KHbsV0qsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55LnKW9OZyGZy3OHs5jC8VxcMtSN7FuXssGABxg5uTzQ&oe=6A05D2BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMnW26UySvIQ7kNvwGkwNkl&_nc_oc=AdoVIUimGgMABiSSDX_YtSZ5eivmjBZGRMpEmZfCUcOS99ytgUMuGP07HOpmpwL6cOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xkeNUFKtJ8iI7HkoouzPv30mmmdiQmfsWJ2yBhWnFTg&oe=6A05D285"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOYeUFgLrk0Q7kNvwG0-oAZ&_nc_oc=AdomP86wT6PHqdlmKRkkcJxn2LLdGqBNy71sukgamCeEt6d615cFnaEblAoFQ6yP0lA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65gkpQ1fmLWnLVKnutdxks_T83MPmQGsNs1NSLT_h1Lw&oe=6A05BED0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdYCJ8UDl2AQ7kNvwG-MVZs&_nc_oc=Adr6cdcwZStRyqpvpgy9IIHTdgeA6hCQK1o4yv_MZFowkExdUUB8f84HnXqJYLjNA1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7koQyJ6M3BjS0-5TEx0NmYbSh6AH9N7yQa_CV3hL8qqA&oe=6A05D704"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqiSZ4H7vJ4Q7kNvwE7roWZ&_
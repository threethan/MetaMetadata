.com&_nc_ss=7f20f&oh=00_AQLXUDcDGd8ubycuTntZbYUA2wyPpLKsPM2scg_o5YbqEA&oe=6A998178"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6mv1R453igQ7kNvwFJCJT1&_nc_oc=AdqGkfgwDIY_eRfYjKJNRCIiVlY0n5_MJ6F52azkwfTlN3KMctg8xKM-BiaZdDXaLAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbxpx75zrUf5OG2OkLftxp-gS_0QBBs_Ri__D0WCX9AA&oe=6A9993A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngvTF15z9iYQ7kNvwG_dVBR&_nc_oc=AdrYnGGY7C3DIO5cZaxgEcDpMqqRAEAsSRjgONGJx5dw4Fe-Vut546wQclvCAEWUDxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH-YZRNLnH6KcuRECcGgopolrfvW2IrOnKfZUWSFX4jw&oe=6A997ABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44UbU9gGo0sQ7kNvwFz_YT_&_nc_oc=AdpEmAuV-obj7BZal1VsNAH-9gOI4VwjIB0ffGD0oAH8yUZoN1Z33QIG4hjE6_fbEuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0Tfa24S97vizP2MOUVC8U1Yv4ayc5Vf3sCjFOPlVK3g&oe=6A997A85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFpV1KjLjooQ7kNvwFH-M1H&_nc_oc=AdpClUti6YApXPvzzRVge6afg8HuCEKi3Upqkt2lN8kk98TKAMbe-UZ8AdNIN6rxWlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYp5_5BTG1R5EN4c3LSLo0oDGMYRv_9yZ4-rMf8CEa0w&oe=6A999F10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNPWCcyd6awQ7kNvwHjzBcQ&_nc_oc=AdrLe8G5v8GcLS-HV3Xxvr1vPlI_aGySeeIXvDOFntzQ7ML8O0L32RPcKSrWyQwJ5T4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCAo793cfX252Vd5V-MAMxsDHrrz_Guj1itxLNAhy6jg&oe=6A997F04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0SGl_I7m0sQ7kNvwHD7dwG&_
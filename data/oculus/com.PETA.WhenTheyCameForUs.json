.com&_nc_ss=7f20f&oh=00_AQRGKypawuM_75TnkqM4zXiB8wEVLx8c8dL0ua7qLStexg&oe=6AEDE178"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwH2kgAJUTsQ7kNvwFmPDWS&_nc_oc=Adr0wA1tUKDg8KZ94HkgzlNc5bAe37u7KJQac5S_LcTjuemuhsrEz8_hWTCv2CizLO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR_rs3qveW9va40yiw0TjnfbBzV3v-MKU0VV0RZY_w0A&oe=6AEDF3A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYerCl7D6moQ7kNvwFyEici&_nc_oc=AdqN3ffYP3_0JuO-sKA_ttn8NWvjD9ZOG5QB4IsmQ_0u4pzRZUhIrTyDM9LLE_V0H8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4410u7NcsVE40XhfISLfp9wOIccFEVZUqfkLV19_yGQ&oe=6AEDDABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxpSt8Sd4c8Q7kNvwFr3BAG&_nc_oc=AdrPr1Q_yrx15_VPrG1qd9Qt16KF9ut5DlP3hV8A5WjfnbXbRJEMvun0a5YarhnCFk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw26RzUC4dVCM3DA0OayZvUnHoLMh2a_p6aaYUwHCz8Q&oe=6AEDDA85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBe0hyfI4ZkQ7kNvwH47r_g&_nc_oc=Adq8xVoiW7YtmlwEiE5PwG1vIEPOHK1wZeh9kBhpJBSyueFqO8gp2-Gdo-SjEr6H0_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUofT-Nf0diCeFBKaT4SMik5rphfnToflNhy_VeS2Rtw&oe=6AEDFF10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L22NMZ33Dy0Q7kNvwG9aWZk&_nc_oc=AdrYVFrdFFoyOukm0hZ7F9UzijWVc_HiW9XdE_UyqMtXMX8N-8xW6HHfEQf--DsMTv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuOqCwBfJV9z5ZJGsG3SJ7bmloYg9Uqxre0Ge5dfy6mw&oe=6AEDDF04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSbhkzZ3W7wQ7kNvwHp3pDU&_
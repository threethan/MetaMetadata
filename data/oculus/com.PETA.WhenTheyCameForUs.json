.com&_nc_ss=7f20f&oh=00_Af9EOiftpKfP0kxuTs0PB3OdkxUmjB-A9UFUpEerLRnVFQ&oe=6A2D6678"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0SImSbqBlIQ7kNvwH112Yg&_nc_oc=AdoNc1VGSxZBTje7qr00kHxMjlhYipptR9997WYvwFP8dYZGb0HE_SVpfGNe85_8w54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ebmo1K6Ifg-aNe85cPyg1oAlTgJ090fHKXQe33hY1Zg&oe=6A2D78A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duGEsaM2QmYQ7kNvwFYQp5x&_nc_oc=AdqhuxVdITv2pZ1PBPBGrQA4L9NCntKokPzMkAsazbzevY8RwSOx5fu9mmOWvoyLeTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D1ukn_7BeHRufDw4F_eMSImK3SMVpyv4LgD2YVEMCKA&oe=6A2D5FBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fA2h64gPB8Q7kNvwE6y97a&_nc_oc=AdqGPk0OUjIgwfmGox-OCVFL4tzxdQJPe2TL0nxELdnLhD9cfTfmTO_PuuBN2BHmJa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9byVcp3-ykjgIw2cPK3khzRMH1Ca8yc5fAOyvGXCUoZQ&oe=6A2D5F85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsH-CXsZzpoQ7kNvwEkQ5oc&_nc_oc=Ado27V8k539yTQAvC1wp9gb7IPRdkGIUYh9EEh6CLIIhNVF2x7rLQb4lrmTRTv_bf9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qs_8-Xl0xai-ZAgL15xg1mjzYn88H07QnbHlB3FPQ3w&oe=6A2D4BD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNMqFZIXHbMQ7kNvwG9bT6H&_nc_oc=AdrghoBUxfehTPuoLNVD5hjhM3mmsnVUTPCTclmpZHgM3ORAGOHbF4nS6vBKEDyP5pE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VHaz0DGrQSnHWz4wAGRj21k5uQgtUSoQhg9E4dYGVDA&oe=6A2D6404"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVjN03LTwD8Q7kNvwFfhPo-&_
.com&_nc_ss=7f20f&oh=00_Af7potCo9eE4d0AVINGGoZjp3_Z39iNoJzYvxL1Rvi3ybg&oe=69FB4D78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDBzkjg3qnwQ7kNvwFcoDta&_nc_oc=AdrAlm_wMnN2tUwZ8eoRWwA477Ubx2N9Wsh2wWiqBYQp4tzOmCstzS9mB4D91f63C7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78yLHc-KCFBDhBHo7yTwTXeBpqANDj0ycmK0tOtUVOeQ&oe=69FB5FA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcbw3Y4yhbIQ7kNvwE9Wqnn&_nc_oc=AdrySzDXn--yLwUhjzX6GdDZOI8hZLZOsKdgAUwADKkf9Xl0J1saD0XeDreu4a5OM6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EuhsYKGdh4yxX7l4EBC4pHjvOf1zm6Sbecy7yn4wCFg&oe=69FB46BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsTqmQV-DrcQ7kNvwG15su5&_nc_oc=Adr1DLyhzr3h0vyvrP60hB1ySchKxbpzI2IK1QeUXNbzniuf7GO3dWZ5J0ldvYiTqBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q34FAYBT0Ur3UkYAA7tNEcCRpRGxqBi4g6-H5BenLiw&oe=69FB4685"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsUsDFhN0YsQ7kNvwHfCUeT&_nc_oc=AdrAwgwQ_8B1-G7VVP78ujGnc0goJ2SYueJsm7HJp6DqhiEXnjtWlCHYjdCMCNMjoWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V4c9CAm_2Vnb6RdsWgQ0LhJ6cha-J9hcxW7H3to0t_A&oe=69FB32D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIpWq_SrgvQQ7kNvwGbctBo&_nc_oc=AdpcRgoOC50k2Lfa5TsucSIlvOtZi5fuI-eWJLZfjMVyyLvF8SESmov3f7ZBLh-vem0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ifuug6jEOE3wzoAb5FukHkGybEBPE_PECmW3V83CSvg&oe=69FB4B04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCSZ4qHelIsQ7kNvwEbGaR6&_
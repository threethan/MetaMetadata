.com&_nc_ss=7f20f&oh=00_AQHs4XsNgwCg70ugy6yGZzR7Hxu_sq-1IP4OpghSFyLG5A&oe=6A8317F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN51o5dDJ7kQ7kNvwEFtw5g&_nc_oc=AdoFUG4ngjRTu3fTetMFJxlGVpZDHO3k0iY8feqiHk-5zzB1S-vFuL23yMSYsp4pc0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiHdYvOoS2L1foraQ4yvDU1y3eFXv2RXiOusnF84a9Bg&oe=6A82F1E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqIw8x-q-e0Q7kNvwEFsM-n&_nc_oc=AdoSLkdV1z9nn-2qqY6iMIJfH3xzTFKOATi7kmEckpV-yrpXyCKjI0uZlw4m1z7uR8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYB5jW1vVkAEZwizvArmFAyfgu6IDJUGDAk_fgDCUntA&oe=6A83113C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcz6-ltdkuQQ7kNvwFz_h7I&_nc_oc=AdpR6fwhD7dVDbkW7VwqaL86x2yXC28PtrVyjmgAc73p8dlT32YuvykIuyGPKvylk2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZLOWuWrTiPXM_kXRNgzlsywijrA5ZPCGPrs4MqQ6wTg&oe=6A831105"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s75hcZAaVUYQ7kNvwGTmybO&_nc_oc=AdpMREhxjvhn-dDolJRSLtXrZsr2r8TdwVVBs-ywvATSz6g7XbiwOkRvWpyOVczeC2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbF6BcM2oOKN2QjHcFptNJs7eWCmAzwFJgvqP3JU9rQQ&oe=6A82FD50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-1nEDsUCkkQ7kNvwGFsHOQ&_nc_oc=AdrnCe0L3COggQovaFvX2Uwvsn4xrrWWiTe2VSOFxvd1umOHDovJaaXBmbPDWW1zDV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeQt_1G6zQy2UdY2QwdTxzNU7BVgMr-fQosjKW3Metow&oe=6A831584"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mYIYkom6ZsQ7kNvwEy8uf6&_
.com&_nc_ss=7f20f&oh=00_Af-Sx9qjRAZ-RzI-l5t2Dod_HXupFIJnAEK1THEyJXvxeA&oe=6A47C478"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTgeRIqs-XQQ7kNvwEEXLQc&_nc_oc=Adp2ATbPsHnCojB1LSIXt577zW_jQZ07iFtDWCTPio1daHZ6ctbQgz5lsFMQDInS_Tk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1EIIurFG3Z6fs-Ptrb2ISDxau_9nTp1ZyzLls7MOpGA&oe=6A47D6A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1nCWPKeQD4Q7kNvwHfZgSr&_nc_oc=Adp8WQGodfCgdCzMIODTRGTxEiaGheo7tbuPRPYVpiGPYePN4mxdNd3fYKkR-oV4zTs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tog5pnPsPFZ5ga7z62j36INgCkpdFuGgpGX0-qKUn-Q&oe=6A47BDBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHJjF0larQ8Q7kNvwHGz0yg&_nc_oc=Adr5ewet7f59fgr2SsxzvRabANt_W3QvrL275VaGVBFa5AoAbLJRaZWDB4hihwIsAtg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zKVTTRM1rdu6cL2ULV8_sUurYexT3i2SlD2PU3NQOdw&oe=6A47BD85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yeO1o4aue4Q7kNvwG3x1vW&_nc_oc=Ado2LOYNh4B5InRWcELkpjBcD2pa6O_4C8HbpROd4-bunUEF4k97WMZWgmdpomWNF9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96azAnMrCRSS9oU17dvwIWqjRsVxB1uIXa-XEcpMjagg&oe=6A47E210"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zD52AWMr0KMQ7kNvwHszhRZ&_nc_oc=AdrWLL2nhO1CrQYu00DgIzGkAOK-WB4ro4P4p6nHDohoYrlpyVABtEFvo3YiZKnZBeM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1akJAt3uFzB9ip1KIG-37oEbbtyg_-ISQGuE48V5uPg&oe=6A47C204"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wBixrK4L7sQ7kNvwESKnsg&_
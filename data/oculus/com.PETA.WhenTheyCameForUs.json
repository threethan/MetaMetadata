.com&_nc_ss=7a30f&oh=00_Af29bPTgzJPl95NB_VgE48F5ZoT63D-jaCmy6XAn3Z19ZA&oe=69EB7B78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d41XmjkMLWMQ7kNvwGXOMz7&_nc_oc=Adp_gLC3uA9JgRJ0NUimPlRCfIa44UAQNbLyz6PJXesTi7M7U5PxAoWOKewza_Aroa8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YOzyEZEsVbll_A5mYhGF43er3uE5rnNK4LwZhgzmUhg&oe=69EB8DA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7rUuyqyCWUQ7kNvwFd-Ngt&_nc_oc=AdqGgOfsjMy8pE1UvOeDPlEz4Uusp-LguKIph9hLYdIzhiP7qEYR4tw-fLmFCKyP65Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eu71ta1I7ZrbbRW243YmCfuVFRrX1k2ywiF-NyFDgew&oe=69EB74BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryCVu0fdNtYQ7kNvwFVqigf&_nc_oc=Adq0CsP5JHCTY8g_XT0lLV6SzrJj49tH3Y-Xj8r-fbaXzZjdLDSD4QoGdWWJbac8T5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qhOO_5qwMTGZufP4ymU9_81jcBM7bUmJgl7YgGElXKA&oe=69EB7485"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0NlYgPzDpQQ7kNvwEwwy6N&_nc_oc=AdpJiIObPKifhk8HHCnWD6kPh0p0P9EhgQ3SJ0SnR1wJub4EkSNJ66oGmVurHLoAFoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uvCQ2a9YmJR8q44aKcywIeSHADOlLyxIm1mFDKbNEng&oe=69EB60D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU3x8TqTBG0Q7kNvwFfF71g&_nc_oc=Adpe_nBzvOqUOkugVVtTZW5JieqvcMU1zOKmgvzPjyWa-G-vz9nkNZUObCAxjJJbAA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tsKOHtlK6KBgHj_TolNOANQjykMa8lSQUVQ9X0zXxsQ&oe=69EB7904"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlNi-SoMvC8Q7kNvwFhAYpo&_
.com&_nc_ss=7f20f&oh=00_AQMWVYmvW5S7EzCNonxqPOoIryG9Mx2eSwydDKj_CL2Gcg&oe=6ADE0F78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcnVsV888aUQ7kNvwGMcxD_&_nc_oc=AdoWJQOybpeJXV_2zzr0Y4ky5RzXIZkkCQhWJOfppcf2M01HdCtqiBzsijsfZyoTqP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFQoXwE3kJNLz-6tId0qWrfzpuQLKv-rNicvcw8K6OOw&oe=6ADE21A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsUMH7Fd_wEQ7kNvwHAAwLa&_nc_oc=AdrdZf9HLBjnlkvv8CgviY9tfeNiWSRMaXFC7Tv0a0HJdXRRhMXeUkjTMRQH-LnG2r4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnYeb6rEr8Jc3AaVDH6mTempq945l7cEft_7vk_x_k4A&oe=6ADE08BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJhLul2U2OsQ7kNvwGQnsYs&_nc_oc=AdpbE43QwYevEReFPSHFZ0cYaHwaDOKOZpbBXOCpUJSPEvs2oaO-rda74JwXYWS4GiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW4e0-f10c6SR4eww54RCYoZs18xOCvz2E5FbQybCv9w&oe=6ADE0885"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_CRP4g7_60Q7kNvwHn8R4R&_nc_oc=AdoZSkW6FbaVNB6S-vThqWYFeKtRBgs5hlte4MmlQX57pzhqLXKRJw-O1RIyRao1z64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3ZVrBl5xSsjrt497f2I1j9Pf6j9GmimP2vtosXpzA3g&oe=6ADDF4D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju0-_CaxWfcQ7kNvwHk4lBq&_nc_oc=Adpa9udAYEw3rTMUDWttVFYcO7VsC8FvRn4WD0ZWuD8yl6mPrRzxX-buDOPM3qjesZ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPybcOEHCIFnFjBIw8ZydMArubginZ0sTdeLbtWBlaBKA&oe=6ADE0D04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2WNR9EcmKoQ7kNvwGRB2Jm&_
.com&_nc_ss=7f20f&oh=00_AQTuP1aQeoRH_1or2CeVESiZTqaskMizmumfGG0NSO7tCg&oe=6AF32778"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwPxshrp9kQQ7kNvwFTlJO0&_nc_oc=Adqf4g4hdfn4yplQlPMMuq3PoEbwQNNnBN3R9-vxZFaSdJIIUZC066lmUl7FjYVQy_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRywb9PgcmI2e9sudyp6-1s1OAe4q-T4xYEZUfDCfrCxw&oe=6AF339A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGuHRCwv5TUQ7kNvwGInJyG&_nc_oc=AdpBujnRLoXvuqbhN-lTCzDr2b6fcjoy7DiSFgDacp9ugIlNJ-MbmwPkJ1vg8EdW3yk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnXqvkPFELtGpR2BdcYhy1oMuukTRe9Z358qfuSPxlEg&oe=6AF358FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXCRwmNglP8Q7kNvwFlnkei&_nc_oc=AdrJMR5bky8aLI5_0xogDbtRVU0eCQraL-vw7otRvvdNWVpomke5rPuf6kcxmhKBZXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaHQXBQdhAGkhuwokYlA8HE6_pn1Ao0Y9uppSynlYh4A&oe=6AF358C5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3tgtk0oSLcQ7kNvwHWLV3-&_nc_oc=AdpGCOHWEKH5EN5MybarCDilbBtn7QuEd-6dDeCU1PCl0YdbHPrWDvT9j1KX7mhEWho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT0sPfuvyqCaTf3_aID_9Ngx00dDsm0Y8_qtPX7Fn53w&oe=6AF34510"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0bNFUulKDcQ7kNvwGbwLLQ&_nc_oc=Adpq67yT40VF0rVR5DC8Y544RdP7GJ1tqlCUXtpXE7YJfuKGazeQjjX15fP6gcs_cXM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_KZhivUSpWAnoI9VRW9YtEQ5GMMyvHICXKrLKP3EuMw&oe=6AF32504"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwHtLPqjAnkQ7kNvwGE9Zdm&_
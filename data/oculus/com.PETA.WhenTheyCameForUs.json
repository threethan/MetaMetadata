.com&_nc_ss=7f20f&oh=00_Af4Yxz5hUrNR0vihSG5bwxUPAXbbO0CkuXfCfaOeIU3csQ&oe=6A0487F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nN4ER6H_cXMQ7kNvwF09IYm&_nc_oc=AdplzGNSNUfWwmZirsS6sQjYOul4WPB8_Se8SbbhUGTocXV9dzbF2GQJB73m0OQmHBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DLlcdFxxApCaV6jXEIaQCYMolBrth4DyGM5uOGWQ3HA&oe=6A049A21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGisReXdOPoQ7kNvwEfHi_q&_nc_oc=AdqVth6QXnCNof7sq-0AzA8pRv54Nrzejaz_lxy_wjr0Pw0oDRYpdcsTzAz8DyvhvNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pnMfKuHTPUHvU8LuziGw52C4NnpbKVWxzg4Xk6UF2XA&oe=6A04813C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMnW26UySvIQ7kNvwFMFVhw&_nc_oc=AdpDFIhOD7VM4hZumnGjZ-xst7PeEaZG_zuIAsAwnWOVqVNu42E6hlWJ8VKbiZqrG0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YlRi-eaHxNQHBprO3jnubyqJYM9uPqqzaNu7kbvlWgg&oe=6A048105"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOYeUFgLrk0Q7kNvwHalihI&_nc_oc=AdrlA8_O1YhF6X4MAKEM-GAwWo3Gr3zLOC3LV7f_OPWeAc1VoDXNGeyTjNmAw8Cph_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WSnMNFLqYLNDF3e3PqOe1OC40dFiMY1pE_eklTE5X5Q&oe=6A046D50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdYCJ8UDl2AQ7kNvwEwS6vl&_nc_oc=AdoXXauvdx-T9MxrSbgGn5TpMWzZ_66RHH1go6djFJeRY6RcL9T3VPs4_o7hbkP6zhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Il4GMslg9ISpagTTV34wkIdZWDhU9ipxqac22Xl-Q9A&oe=6A048584"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqiSZ4H7vJ4Q7kNvwGDwsQs&_
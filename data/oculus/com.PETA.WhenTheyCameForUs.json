101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq_dG6oRLCcQ7kNvwFYlDtn&_nc_oc=Adr6WCfF51UxeWwAspzEz-cnjlvDVcvVw0DQ63SmZYVd-Yu8weoTzT-8DP0zQD7Zugo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZjo0FSx5qW9-jMpRRbfCZ49VZTHFMh2ICgWSLPtjGTw&oe=6AFB48B8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4jvnl0lUwcQ7kNvwGhO3JU&_nc_oc=AdpOC75tOU8o0VeYW6mlCAL1H7DvKe_BmD-QYGnMF6rPELc_fSykc4Vfqns31ycJn7I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjcK4lQFU2EXRV3i3AQGOADvaE89osY53i8Efyi23nuw&oe=6AFB22A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhSMbavRGfQQ7kNvwHc7o4S&_nc_oc=Adqu_mnESHh58EJwxtTDa9ueT0wcMarE-wN8fhVzA9YbUv9WCQQMRj3RFNShHJZ9Jzo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyPXbeh7SwHQqju-plxO3_Xs8e43wydc9NON0t1dBzjA&oe=6AFB41FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xSEizAk3R8Q7kNvwGARAfZ&_nc_oc=AdoTM_pz7gNCHw41zSnYqUmnRWFraeQKTIdIRbZQgwRqCYVSBahYnqZCoxaAbDIfDK0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7sXcEyA78V-qKLY1D54MCDIh8jUS9BASmAX3Yufd9ZA&oe=6AFB41C5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLYBh1NMrR0Q7kNvwG9mKTb&_nc_oc=AdohVzGPQI0CTCV5YxxaoYcxePlyFdDlUzQGSOEHc_Y1ZhjmgEE-i3dQOmS7N7j62A8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTXR0h40m5UBEv0_Gdilc8gVOC2T5lCJKrOiM6OyFpIQ&oe=6AFB2E10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYKhmUGb-UYQ7kNvwG4cL6y&_nc_oc=Adp3DZXk_prVpcSaKP-7rlzBT_ErzDPHIVhRMTUPlcgX_Jwe0y1xhXvuR1xbH6d7Y0E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh
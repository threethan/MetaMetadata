.com&_nc_ss=7a30f&oh=00_Af1Yig85RvQ4ZbCA-2TAGxQwB9OxlrZH_ELsPbzUZvuMFw&oe=69E63578"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpJnhYkc650Q7kNvwFRpGcP&_nc_oc=Adr30xBg0VmavPjeFYFVmuQ8g24cfXUVXo3v-wB-hUZ7DtXVB9KibvhrlbdBmmGRqWY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F4kjj2XWf7DbXFN0Uvpn_Rvkek7-WGOf2Q2EI14XQ_w&oe=69E647A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYHOxAqMEQQQ7kNvwGzIJ5p&_nc_oc=AdrLASskr3sE-hdzFdDw6YFawkzX4VopYOLZKvc_jq6pfPLQDzkfr554__bEZcYMPTU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SVe6h4GBteXX7ioaQLIMKIP5ZD8VhwyiDFBT3OkkuYw&oe=69E62EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLSGgXa8PawQ7kNvwHwjVus&_nc_oc=Adp8S9XjhOcG1SkOa_RombTv_dXpDS5ZYpgO6kALccXhTVi-JHyPMTTtIeLQZLBFjT0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35icBXv6vPrmdRSOu4vD69Ru-KKYAEYoKpRQRItTqqGQ&oe=69E62E85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDNAREIlengQ7kNvwGwW2UL&_nc_oc=AdryLZiGiSj4IxFTBerB6l7tzFHLdfGHKZoDMAsvHv20DsPp4rzXTtro1a65_4qjL4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wf7pZG7O_EBamd4DDBHALxTOEaC5sefn6eItoKtO_kg&oe=69E61AD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIT9awrfpKMQ7kNvwFgeFh7&_nc_oc=AdompA4Huk9um6HfgdOApokvgMdWh3hbiuvGNUvNN_U2C-Fws6zWvksHiJxpnpoagp8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00FPlSaBL2BWcBn5lLAu-WxbnvtpYaitDoaCIGkItzcA&oe=69E63304"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8nd8D792MwQ7kNvwGK0vVs&_
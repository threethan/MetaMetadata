.com&_nc_ss=7f20f&oh=00_AQHcaJO87LbscTYAm_yUY2KeuzWjGfSptmhVNw3weYTPtw&oe=6A7C4838"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXySngB4FuEQ7kNvwHZXOHy&_nc_oc=Adr5CuXIxKcDo1b3_W0V4UeRRuHlUgg41IpqGZrb7WStjqSpPsnaXUascykVhzd9OHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpRd52PkdRVFHhM15apO42yVeUvzvwwS3ZL-q6bGS9Kg&oe=6A7C5A61"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=babZ1N_BNb8Q7kNvwFNfdUk&_nc_oc=AdqORNE0iiaOz4yqCGXOqzoBwcxttdtu7Y2AsX_M3J117VEy3aJReSx6cDl13D_2Www&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7IIuIBBT-ONPoi9jnYE55qAlavVPqiO0ojsiqSz7HeA&oe=6A7C79BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpZOTBEhkvsQ7kNvwFHwJaw&_nc_oc=AdoUlceoy1pz6rBbEtEOV03IhpR3Ha-fxBgQ-k5t8Gky8xWGf5uGJ1WOShFlLpGFf_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSYaLcOZxrfH3k3kTlvjWAkvDEZcq7jw_LLUWsGDk_RA&oe=6A7C7985"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sELtGKoNUH4Q7kNvwFfPAGl&_nc_oc=AdpbtzIDbWW8VDgmc4HmpbmIGgaWhGtLXdhT8CrvD8CJZQ3XvdZD7E5yNPyyua7pi_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGhIZ5e_xvkyh3V_3POoxPByZp2LO31hbdTiAA_tqTwQ&oe=6A7C65D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLNHXZaovDUQ7kNvwGvBvKK&_nc_oc=AdpjcGMwqS_ukisAiXmaZaUMQ4epLaBxUHwW4_NYO8ya5EHZtmVCMFowAseImndwnLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvq1mzC_jDBOiG2qoMtNFRm2EBq8FhbY_3dOAGsGnzkQ&oe=6A7C45C4"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cRnk7ID66gQ7kNvwHsq86w&_
.com&_nc_ss=7f20f&oh=00_Af2DT3X2IJyTR0uMICRDDPSBbQ2dBAPqNu9uE6iYl3r8uA&oe=69EF6FF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Y8LMLe_T6kQ7kNvwFrT29i&_nc_oc=Adr8BdPnlQZ67mMAHr1yw61cT6NQaDhfHRcmrjv0jkx-JloQw5LlIj9G5SYnihBhxyg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GvTWwgOcsPawc-9VpFarwCiWd3Dg3zyBelxHcrPQxOw&oe=69EF8221"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9ST-lFpcZYQ7kNvwFHuBud&_nc_oc=AdpLpot-UaXtphRXzsrRySTmL8ZBQMuEiw87P2jxyYs2SuM1_tkkKoXV0ITr-Q5iVVg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3j7XUeT3hxqcNF1AM4-RZ6qynj1RbVTEB2daJz3VHNmw&oe=69EF693C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhCWPdNYp1sQ7kNvwFdecKq&_nc_oc=Adry77RDOuH5xm7rnxv3_Rju1Z5wZbap2JK9mZ7lkV51ZVXgtn45t8QBy2st_27kPIc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2u_44rWNuEYMxvsaPGuxQWqhhEYSof0PTaxlbQCVAgtg&oe=69EF6905"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-q81t2_8ykQ7kNvwFqAIF8&_nc_oc=AdqqOdIU6HDJ0mhYiqREL5V27gNPyxAKW_h-yL8J19b3fFi81dSOSf0cbRrenRW99D4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xwj4LU8_KWWIz_p4CBA82ddDKLZVNpCo7VhjloSWncQ&oe=69EF5550"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hQqXMWfiRAQ7kNvwH0WPuu&_nc_oc=AdotTAE8V4Va4ZhVQwvVGYL7G0HgQGzUpXfKPOCp6pBycs1l5b4SPh3QGGjfzLfjstU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-7SJCnLLEBDUwD-xgm0Tzp9xnOnzm7hVXGTcDn9XQRg&oe=69EF6D84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKHxMsnAYAwQ7kNvwEuI125&_
.com&_nc_ss=7f20f&oh=00_AQQ4GUmot7Fhm1FrUkS6e_2mQeqyFpi7p5Clq14-0YHQMQ&oe=6AF8A5B8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsfTLOy9-vQQ7kNvwHHh3ja&_nc_oc=AdpG62KVYfHQ0uyXEfNATVRaJ3ki3oRepkiSrWrajZUWeVm-0biP9XUbc0kKVz8kI_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTSzGwsKQyFIh8tccvIV3FauqzDcboC40Rly1mE9dTSw&oe=6AF87FA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF8BUvF8SPcQ7kNvwFyxCx9&_nc_oc=AdrhWP-ktn7DkED8vLRVMhXvHRL-24HpoG9faIo-Fl2wXYwwOsZo3xUuMlozT1DoCPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTdVepcqRFEgl7crzQHm9gnoGfn6Syd_q5QBMtIy9D_A&oe=6AF89EFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfDx1E1-q9cQ7kNvwGkmWFB&_nc_oc=AdoK9IIiWe5HKJ7cBpaSr4DFMdMRxOypcdb7Et7pxWnHHUJ2dBzY2Me2Dz0NvwKRQJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZOKvbPxp__pDfCL4c1bYOGWE7mXXpqG-DMb-J6dxlDQ&oe=6AF89EC5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLYBh1NMrR0Q7kNvwHO94RK&_nc_oc=AdrvMc_p5NkwKn6NluYT0wveSw56IEskcPN0Xy9wrkSLs0qVud4ox-N4LIYw4cWCY68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQekjiLQ1v08Rn_CEFA7gSK3WXF0oajHL0MHgBOQxeY_Q&oe=6AF88B10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVWrHoYYDLcQ7kNvwEAkL4E&_nc_oc=Adrq8xdlneSdx0-VaNYwI2Td5zo9TZENIvmuCyqPZRZmO2WEi1nkdBV7RwPyuQflIwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ4QI8_ktwE-HFqOVK3UGpOo_ArBwnpd-59weaWs70eQ&oe=6AF8A344"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCTo0_-YrcMQ7kNvwHIBGal&_
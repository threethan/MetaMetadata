.com&_nc_ss=7f20f&oh=00_AQT4uTCdQYeKqhKAw1QxkvdaIpIzDQaU7zOxCK9QGDx4Hg&oe=6AE9ECF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVCgHO8nVcwQ7kNvwH4iqeQ&_nc_oc=AdrkUMWD-_sKPSPiKRcdnnlJYoUxuJKd-jO8rAMU1S6eMhtzaOabvZcP75RPx81nqH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwKbQm0w9BWrSJwRVVTpjAbGZ9MkJCGhXJjTFduyIgRw&oe=6AE9FF21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2_h9eyY8mYQ7kNvwGijlQX&_nc_oc=Adqt1i83QzOGnfxDkXrwm3Buts0LAkC-qH5hCxt9y3U0w0lhiExViNfHEnsATqtxBY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs3VwCVbEdT7WEFcIkvVm2RxEDujpEp1J5_MkdM_1bZg&oe=6AE9E63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7pBVHbQb4IQ7kNvwHFKabm&_nc_oc=Adq1DrBvcVXw4uNmn_cQsdvU_gqM6M40iRfpE6CYgLX2t34DW_REAHky8l_1jvO09Ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7s0oWdFDTIEnqzS1tmN1oSWS_x32iSxBtabC8Ix6FrQ&oe=6AE9E605"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qrbdWw0BFQQ7kNvwEG6w2z&_nc_oc=Adrl_Sir7aPvb2KmXImmLJutOGyVXp7JTycrlRbM9rJaz-hJovVUDZqK_pYOSvVYKWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJXCD7xDSe40C5Zyn347LGYAqSjDF6drb3rWg2AVHfCQ&oe=6AEA0A90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syAxjEWdWVoQ7kNvwEfckH4&_nc_oc=AdpdeLht1vhVGJ8iUS26FIOQH67BXSPAzDLZ_jMXUtEpA6IKM2FYkMxMSef0_edyUaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ0bINhuqmi74JtvjdLrzi-YsOjP0w2lblcik4WG3dig&oe=6AE9EA84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp0Fz5CUnZwQ7kNvwH_8B6O&_
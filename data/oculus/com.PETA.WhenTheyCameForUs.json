.com&_nc_ss=7f20f&oh=00_Af4pT_dr6QXvISHQas60bjRkr0SENFKtVRwOMhiGtzLraQ&oe=6A1EE5F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx1Q7VgH9K8Q7kNvwEJbq0Z&_nc_oc=AdrzK3MR5wty5nD5I0xj4-GwjkfFPE0eRKS_z2y8qDUhGxucvv5mcFBLokIq-gqnL74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44g_rsfFWieghwvDlWgzuTb2a9kXDcVyLQdHVgmXAb_Q&oe=6A1EF821"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqVt-bi8UIsQ7kNvwH3sjgO&_nc_oc=AdqWSCJVO65kmic2TpS4N-Ot-lzcYtj209FzPfrdkyR8lNv6Zvw1C3aYpOg-82OPy0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45qy0cdzpiYtN8b6WxE9VJUH_zdYsgX6ZAL4Ueh3SqXw&oe=6A1EDF3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IDFB852ztoQ7kNvwHm1qD1&_nc_oc=Adr3KgGHJRIq6VRF4HrP0wEn2Husw5_SeNqZH6ebyAT7BSHkyQ4NGYAfLG5rJhliGiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SrYTL6VYKmDPzWx0G7h6823ZjVP1ujaU_YCy6vGun5A&oe=6A1EDF05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WQrHEYwiiQQ7kNvwH_jmG4&_nc_oc=AdrSIKu25IoPu1A-xEh0UL7sT9HRZBKB3ySUaocAc56quf5tkOIHil_x3aUjavITZM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tVslnxKnYutbcd_Bf1GKZYYYtCtF8c8qWREQezfYNew&oe=6A1ECB50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa4ZghGjIP0Q7kNvwHg6911&_nc_oc=Adpq4PzWErR2vULaovzzAn-FDaQR-77Kg5iw4mQdPdIbQwCaWdFbnYtwh7sOwlpP9Cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yQpCkqBVdJ5wLR2myzACjf4bSh7-2pRNmItLZgQn1Dg&oe=6A1EE384"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnctxg7NQ08Q7kNvwHiRn8a&_
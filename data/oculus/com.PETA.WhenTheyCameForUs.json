.com&_nc_ss=7f20f&oh=00_AQMUNJQOOOKSYZ8xdF8NejIalraWA3r8hDxOwPsy1Z22GA&oe=6AC3B178"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7_ujwcaLUQ7kNvwEF1PJi&_nc_oc=Adq8cXTp6XZP9VbYIKHQpshXYu1IlAGsVNxSGHBOP-96bf9wzGpiRk6fz1OLAiP_Obg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcUwhlvzeJKAh2UzD8iAIWP7FbEgCZGDDuZFaXgf9Utg&oe=6AC3C3A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvRqJgUGvBoQ7kNvwE2DPFl&_nc_oc=Adp6QO5mbL7mBCFAM3joHIrVWof5u580ZS5GA2dUlYjX-0wykcsdpuUW0q03Xql6X6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3EuIvJ1p9P6UsPYaob2bwMu3QX1uj9o7DFX-NXdq9MQ&oe=6AC3AABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QyzgYjwt7kQ7kNvwGzorRj&_nc_oc=Adp9AftvyT8eVOsTLyHWDX03xGgC6D_T1LKToUvDrzgDMMFIDIHMJKdTkvlhEiHEuwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGch0ExZNByJejeW7A6QzIagV2hKgvF7t9-tsHR0rEnw&oe=6AC3AA85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhrbYTtwClwQ7kNvwE7bqY9&_nc_oc=Adr9MM8Urv8r9SdfB4eW0rCi0RnDYFTBCZKPZkWTj6_Bxi8mDwzfKR5egmeDfRHHbX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAm2ItWWKxTHBcE-_181q_exnu15XREkjElVRbKNxICg&oe=6AC3CF10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3OBQt3lxTsQ7kNvwEKY6w1&_nc_oc=AdpqswCwCojWfUk6GKsHx0Qn9BOLbtK5qRFRnaqCjKTx_peyZ_ZPPSRqJP5rtBmd9mw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCIMNEeapJpBxNARsxedTP_4utlIDS1XxZp-0eo2ymTw&oe=6AC3AF04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIbpkIQ6B74Q7kNvwEcOErz&_
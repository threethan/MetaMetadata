.com&_nc_ss=7f20f&oh=00_AQABDvffMIIEP1FdpnUFQ6HdJEmp-6-Mf-WquyXoVPP7PQ&oe=6A5CDC78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIod3G4sqMYQ7kNvwGJRkJv&_nc_oc=AdpmGfer2W8c1PnZzGBc-yj6WKeVQzaSSq8RzzVgYaHsCnclGHhZ0IR1hYjFFd9QB74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMl3aFzBY9KSHsvDYyiuPYEX_kY7M--J-5PFOPLgcfKg&oe=6A5CB661"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ETzDsT8FHsQ7kNvwHiEWwY&_nc_oc=AdrxSc_ROgVg6KT4qOPiqwLnbKTk3OsZaJoRSGL18wtHmhOuZJxfVHOkYs-Jh2w3BAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuaq38kx2XZr9Xdy3zvG4ycwoJlJ3f6_PaePmnd2z_YA&oe=6A5CD5BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5hy5zxEP6oQ7kNvwEPxa3c&_nc_oc=AdryLVivhkU40l-5KRqKNka9JV49NH7On8ICf9DyQ2ikx8N3PBvrLWJVG1XfkZ_hJUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjvtBDGM5KIc2STg_jqq3sUAaPENQhgKmTDv8V-hvHMQ&oe=6A5CD585"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Zt9pN223fAQ7kNvwEIIuHj&_nc_oc=AdrSbAbxVVrXF3xKLufP_DGKIKasRoWZIGqS7iNfps2WJIK5ySH1O6rE-n3vgftePgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0L7Xmk1zUqxcEhLgs9LPFKBDPqQ1jcgAURTmWaXox2g&oe=6A5CC1D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abc4JKRWs58Q7kNvwEAtGbc&_nc_oc=Adp-2DzAzKvxdiGP2AIT7FaZQQDIs5EE1vzkrGfL3A4mE9CHD8RcYuh5HQtLvF99fV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAogpBt0o4vd8HgOtcVHdqBNXSk4wwrvnArcOfs60h62A&oe=6A5CDA04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2El9Cd3I0XMQ7kNvwHyrJmg&_
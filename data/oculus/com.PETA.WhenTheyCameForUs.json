.com&_nc_ss=7f20f&oh=00_AQHe1md2IlSKl1TmiUVidLG7R5ZMV6lEPylfrfdjqSaaLg&oe=6A95C538"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EroFGuMybBYQ7kNvwF0ppev&_nc_oc=AdqWM5YoW1nqyGsUD5wB_b2rTvsVZkpWWezWx1Xy5RbqZw-l-pC84TkTDcDmZVboTEY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5rh0cMhAhmA9t2O6RRvyHi-P4WETJ9URwCsamWw3Yog&oe=6A95D761"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5kuYCPaC7cQ7kNvwGbYB8J&_nc_oc=AdpIM4UdlYlSmEKADRAues1PMhEHl7TjZMEPPhfN4nU8OjSCNIIKNYRx6arma04luEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7v64CKOpQIoTp1wr8Ra03OhzOB0tODSL9ALbNY3LjjQ&oe=6A95BE7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OlUsL4QfXMQ7kNvwGs57Py&_nc_oc=AdqO0irdNv7um4KXZPTsdGLYA8PsJT9Qil7BabOTw5o2SNgK8eKx7FREj2aqz8C_WMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFset8sgHSbVXVu1fuLOFWwhsWGikln2uaH4aMSfJ9NAA&oe=6A95BE45"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYZigM9HqpMQ7kNvwH6yH2G&_nc_oc=AdrAO3Zrdz475LB7DSCotWgJH5vtWAkLlUud28TGMxx2UXcgxhgjn07AxutmCc34Yf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEG-Ibv7klRN_Jtg_OfN7RqwHFkTEXLwmC8JrwnDs19Q&oe=6A95E2D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCGnP0rGmH4Q7kNvwEqt60t&_nc_oc=AdpJohCBzxQu-Bh9QAjBs_jv1O4xcWT3BIbp8EnDgDzoNFnaBzcwhD5BVc1e_M6ZwX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaxgOtApxy98YIbYk15QYtPaBzbzeTxitzq1bHWfwx2w&oe=6A95C2C4"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLzrQRYsNpcQ7kNvwG8eMR9&_
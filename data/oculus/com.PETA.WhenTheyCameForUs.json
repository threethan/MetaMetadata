.com&_nc_ss=7f20f&oh=00_AQLowJsSPobxddxOVssG1EDEGrMkWZN-xdlS-PKR5_WOUA&oe=6ABA76F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tArY89SqcQQ7kNvwGPl7LT&_nc_oc=AdrmUsHTtYeXwyOHppPLtInqUhd8eA5udM_Hat3dFPD8lr1kovbpD0bemaYYqDKrW18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjThiIhdwt4CkxkVtPlmNHPHr1dGTF6xTgMxDG7Ig0xA&oe=6ABA8921"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yamtHh8TZDsQ7kNvwHLyPTr&_nc_oc=Adpjf-7xTpoC4roO6b-vp2siN3CnJz9QB06xIU_0jqR6yv-qDYymAvag_iRRv_MUHKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAGlNyUTe8KoszmOm-81BJVwkMzLALZLMFTbE26wn3NQ&oe=6ABA703C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK4dcoACWLcQ7kNvwFeGYWV&_nc_oc=Adpcuuuj7e9mliS9GtO09T6lLlPxzDav5eEORbQGI840Pe2JTixM4wKT9oYRfcJeSnM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRq3KBGrhBHii4yKdo5PDCXvZFDzklFlaQcGkG0vmF9A&oe=6ABA7005"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6te0Uj5OTdIQ7kNvwEhZ1r4&_nc_oc=AdroHuTI2RN8F3nt7yImvWreXZlMMmy16RKN2_JPcz6J03DL5xLUIAm_7lUIZgtnUoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdERr2k6bm-1qRdsWbJf1jx4WfxJfUQPh2Gy1HqOxfKw&oe=6ABA5C50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pumnr9hNy8Q7kNvwEa_NTX&_nc_oc=AdoRC_RYewx8gIjdsjzQm-hUVn2gnF3bxqJhnCLMiZf43K__7t_XBwiKYwOd6S7jofY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxReHXc152LCt4JcEZsjdFuDjiqET_EBfMHnPMcQHq_w&oe=6ABA7484"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv7ImcMbGtsQ7kNvwG6dWOz&_
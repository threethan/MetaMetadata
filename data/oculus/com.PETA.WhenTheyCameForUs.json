.com&_nc_ss=7f20f&oh=00_AQP45B45Y-KleLaow-8DqVHGL5LKIZN6-H8XZi7th44pkQ&oe=6ADCBDF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S87TayLyBjYQ7kNvwFzFY3i&_nc_oc=AdoGIedwiz5BUmAEFPdMsJd3V5zgERtzv2VPIT1apnwyLKrHFoka8EW3oZE7_LhUG0I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_Lq56XOJvnvZkl-WyE2-r6ZRrtL1nMZ4i_NwdHB9Eag&oe=6ADCD021"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsUMH7Fd_wEQ7kNvwHThgdQ&_nc_oc=AdqUh87I14jQZ20VTw_gC1q6ofZ6LY93P1MdurbIn-ooctP7XSVoA99sc1xaXyOl5RA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdmrio9yPlHEj0Vgkt4o1deIohB8cF8oTqlZMR6vhDSQ&oe=6ADCB73C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw06cmFp4GUQ7kNvwG-Ocuc&_nc_oc=AdqmRUB6U6De-PEzKmjaKNHPyDwsyROgVFi7XTZWJ-s6aQNku_2ZN4aHx8yP1bV7-Rg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkHqJjC7zZQZKMeAUrNFqQFvyhwmaRXrQ6O_J3VC8jCQ&oe=6ADCB705"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_CRP4g7_60Q7kNvwF002jZ&_nc_oc=Adr9SZqfFEk1eQs3t1LU5hkzPo98l_SfMSg9ZpLrnj9gc73cPtJNcTl_SIHDLai0zro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP73_wIFp0IetTGkKzyH5LzW_aVYpPmcy7lqY3ZX6Gb_A&oe=6ADCDB90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju0-_CaxWfcQ7kNvwFJLGCO&_nc_oc=AdoDrB8CUby_jRk7OrDy6Cpswx3aM3SgxFjgi2diP7iaqutaTcKEki2sieKxk7jR2cE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzeUX9Dj7AVPPUsX_7cTyGME-mKAOkkYUO3JtO4vxo_g&oe=6ADCBB84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2WNR9EcmKoQ7kNvwEFj0fS&_
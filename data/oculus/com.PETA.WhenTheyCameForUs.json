.com&_nc_ss=7a30f&oh=00_Af0vG1MC1tiNCoCnRQh236i8LkPkBFx3QJEQBRW4uI34UA&oe=69EA29F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d41XmjkMLWMQ7kNvwEksf7Y&_nc_oc=AdpJas2AgllyDXWP6fyD2_hu4E-whVZk5HBzaKRf8xzi_yB2E2OvBrI6f9a0OQS8Hac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af141oiqeWl9vDNanF5Ao3UTCH1zJ1UML-V6W8J9yD2iXQ&oe=69EA03E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7rUuyqyCWUQ7kNvwGZQKH6&_nc_oc=AdqAixryt_JZnZBK8MPOgVsGovANRWWbM7-J6Cob1xIpWO22nASdXxN9F9fSu7sdagU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2riDGUE6lsh8JbZLiBw--tr63yUv7qC5o57eyfZpVa9w&oe=69EA233C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryCVu0fdNtYQ7kNvwHMhpqu&_nc_oc=AdrBT1W0xSz5h9a6qJariYO46YPZQyCGBLNylYfJkslBuiHkeECpgTxF4905T_dtCKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nAX7JE_xmCWyIyO2E-wlx3u6wvCkqekzPz1KY-R-WXg&oe=69EA2305"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doWtn9G8OrQQ7kNvwEUpQNS&_nc_oc=Adr8p6JUSyQtKrtpmO3yejZ16rzt089sHDHiEA4PJaJIloXCxX6ESoU_rjSANJOdk04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WbqI3jxwXrD-dBel6wM2lEU6K20kxPPEb0EzWDWH9Eg&oe=69EA0F50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBcgNo0-DDoQ7kNvwH-MB-t&_nc_oc=AdpoawjC0HRvFM4_PyfcHsTiyrH3Q5zHyjWPc7nacwRHESFASahwyyPbP9KYWrZJkyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2om6ELaFCUTjU8cl4DfOUXe2dbiPm4tgC8op66gUT0tQ&oe=69EA2784"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlNi-SoMvC8Q7kNvwGOBNTF&_
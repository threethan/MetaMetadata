.com&_nc_ss=7f20f&oh=00_AQJVnevL756xO8Juo5-rz4AysQseLlQj4Po7pyJdKEwW5w&oe=6AB530F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osU8WpSYTncQ7kNvwG5kYAf&_nc_oc=Adq-ic29CVMNH_IPx7FjQGZP46g-bwWKcytUZ52d2EtnS-aAdd6I1eMHzm8A5caKOno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL20VpyK4_SzAvZyWn0aI5DVFFK-iTSkrsk1_y6Zekdvw&oe=6AB54321"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGKSIWwYi0cQ7kNvwE2jAVv&_nc_oc=Adp5eXWPk5eXbMygOBagz4G3Z18y9l-381q1845HZN8d_b1H3Bu1Z-lCxqC_au3fWyw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImVjdYe7X59eii7L98aR8m5vzZ9rD1BMTnl9PwYRzEPQ&oe=6AB52A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvfJHtn4X3QQ7kNvwFu10CN&_nc_oc=AdqIe6IbzcSv6uV7PoeVxJ3FFfUxTN-dRypqKRka0AcJGwffjvsc1ceXVN6jQP5Mg40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdOUG2WEzQ5rwSsleNfXHZYAQZbMUlseX8nEGaug8qgw&oe=6AB52A05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BODRfbEG6g4Q7kNvwF5uNl5&_nc_oc=Adpwr1l5380pNO44PeNalAvSOWhE9bhtwhK2d9mMhEIzsaP9NZ273cEB8_bC3L1WIWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-3ELHv7Y6FWr2cRM5UOEyju0j432gn7X6ASPykRQeyA&oe=6AB51650"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWOM47EkhjAQ7kNvwE5LrdB&_nc_oc=AdrK35do1-UaMsZIT6NIq9mnrsKsF7JRG0Ebh_vU9PixAcSY8Fh5rPU9AQlFDcJIjUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTumbtGY7r9Qajcf-Jhxd1G5LUkV4pJwDUpigQUPvVgQ&oe=6AB52E84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQYmdHh7JPwQ7kNvwFGiATm&_
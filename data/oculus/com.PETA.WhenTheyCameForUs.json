.com&_nc_ss=7f20f&oh=00_AQPtt-ky_EWr45ijU6xsfMTdvXmqX0CK4nFRU8uEPeKsEg&oe=6ACF8EF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg77zeAKuVcQ7kNvwE2sIjs&_nc_oc=Adq2GQB7disBXWOyutm7tV0nlwKpe5DQiQA1GKesZ1aobBl3dZOts0GvCkSOCaqpCu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeKiwqQq9cGvxOryXeLC7yZ0MiWQONFvfO97tbvRJl-g&oe=6ACFA121"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eg8EuZ-0MAQ7kNvwHdEcri&_nc_oc=Adq-MbNMCebzHiiozOCIrhqQF5KZAkcr69WpGTkrdG5kbjpQjRFzRHFKx1fr6lL-Eys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhLKVRUOm3YWYro7qZjzVmrV31AEOUFaHM9QN1f3pplA&oe=6ACF883C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmxZMnj7qcoQ7kNvwGLeiSO&_nc_oc=AdrpqOFX_7qLg1Y0UWWpCK0Hca5T9z_nNJPljhA5V8vvAxkYIvPtTdEXIxfetGX3tUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ0bNtbeGrNS0BQL5gAPGOZ4bjYKzpaUgHDd7prms8Cw&oe=6ACF8805"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1V3WtCVBI8Q7kNvwGqWEhC&_nc_oc=Adr2g7_IIHtp-9nqtGKsw9xPSXh5j9CO24oz_JLeGoElVA4ZrUeStuL6QRf1YG8k8mM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhOZT8CiBI4syYE8QFB-2UlfhazNuQcNhco0V8BSIEMQ&oe=6ACFAC90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcBM5IRCpHsQ7kNvwFmBN_j&_nc_oc=AdoH-wjdJN_aTBtZFbqiNvNdFSQJ-Z3YiurA4ZrIsau4LQ8NDkA4mhpLfjBWZCTMFa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_GAD2csqs5tacjulaWa-5GUffozDjAr0yUwdohbB2HA&oe=6ACF8C84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5cYec1V8C8Q7kNvwGxkgnb&_
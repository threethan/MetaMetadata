.com&_nc_ss=7f20f&oh=00_AQBy3X0ljcSjbByoCEaZLgt8U5c7TWPsF7_BZJF7kO1E7A&oe=6A4FAD78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_wXwTlN1nUQ7kNvwE2rUzA&_nc_oc=Adp8VPGkDPZqJnUzDpNwmIoPe0iEW6qx99Tkr2k3MPRqAgZWDzrCigPbMn95gAoI4UQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEZW63FZkaYf-KlFZ8mzDXhiItiA5509EV_Tte1dj1QQ&oe=6A4FBFA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2GoRbgz6OMQ7kNvwHmHUn3&_nc_oc=Adq0eY05du9_KkIFmWTuY4hNGGLTNipC-9cJlQWchm0tUhzcu--QrAe_bFjSgOgJP0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkmJSBhOvC1R8MGY8E2lb6QwOKyoSOObcjR4Vrkwj94A&oe=6A4FA6BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_XKtcx9gYAQ7kNvwG71GX3&_nc_oc=Ado0LtoOEwz6Tf9z2A8w8zsYrmZMlKhrnaU72P1qlrFaVK87t_l9QRNJThBOc9zWH0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUb-kWecHl0gxg9XPM0y3BJ0Tj04CHBdxNi3XttURWaA&oe=6A4FA685"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaDSv-xtHfcQ7kNvwFwKvt2&_nc_oc=AdqkYbAemF-8AIxJfaAFCCDBYcEjnZrippSVNsN7LZIsNR3NCT2njP8obInN3uaEfho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClTMiKXAGGhMz1y6MzWxWk75pYmolb1m0XToqZbD_bqg&oe=6A4F92D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ08aZwitYwQ7kNvwF_5NKH&_nc_oc=AdpARqKJv5WI-c3D_O4E4ltfJwmqcJKT-UlbYt3j9IKEYdsjyBzr8mbeFG7wAhri5T4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxXrOZgfN8yEq1JS1uBXQ0IVt0DoSqyN5G0N-I5-1pRw&oe=6A4FAB04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUHvOjm8bHEQ7kNvwEDIaV7&_
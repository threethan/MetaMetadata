.com&_nc_ss=7f20f&oh=00_Af6YGE2tjqSpTWhYobOcnm5HcYMvNAZWafyXsluhIWhe2Q&oe=6A15AB78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyfVJZLhlmEQ7kNvwFdE11R&_nc_oc=AdopLy_HmedKSSrckE4LnpSoGZkS8df3UOFZJJ1qV6E_Kd8X9xXe-zp7_qJSmD9m8BE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51yX4sDOrVlsLmZSx0YLkPVaQf4TD6gccrnPiKuX5c6w&oe=6A15BDA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oane8GM9KJcQ7kNvwFFLkPI&_nc_oc=Adr8kf5vOILTzkcvVcqlRfGTI4hjlzOil1_UHheQtDoLF9sTIv918EmUi_A-JPWhxEw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DKSmiL3luFWEPAf6CoXbdBZTADYrN927p2GV-pDoDJw&oe=6A15A4BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_r4ssZTjqMQ7kNvwFNbdTh&_nc_oc=Ados7FC0ytAbHcpz97xduLgppa9p7ESBAFR5ZS0oNb4A3f869ezhOHaq3dRTw73FlkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p5Lv3-38RDpXS0ORJsW5jc55XKhcZVdIQjh30qgR0jw&oe=6A15A485"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-YAAGFghQUQ7kNvwFiU1yt&_nc_oc=Adr9CQKfND032a1ysTkEa2w071fFYzwxgnfpjFpXxNyLv3Cl05omGganiklWxy7TvOM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QeB01UTPtJRUpWfSbwKmxKOv4rTqYVNOimiYwqo24gw&oe=6A1590D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udQEQNeZyQIQ7kNvwHihYU7&_nc_oc=AdqSK5D8a8HngyVqdyAVQNlpgxaP8E6oE-zjvxTX58wQhh6bOCwvRaGqIdKdtcqHmHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qfMANgRsOyV0tEk8pXPdOh-H-GQ66g4fno5rBM81PEg&oe=6A15A904"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHCgSGnA5ToQ7kNvwFkDxUK&_
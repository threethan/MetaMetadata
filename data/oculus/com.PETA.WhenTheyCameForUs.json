.com&_nc_ss=7f20f&oh=00_AQDlIQsC0cNf6ksK0RnxkJk8dyyKMJ2DVEC6mIpFiuCPCg&oe=6A6CAE78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiLblq810EEQ7kNvwG5UBfw&_nc_oc=AdpKqBBbCrnu0al8NwBOTGBrJWSryRqlagdkOtiTn1sMCgXr0yHfb95vej7ef_sACmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzWiY-STVv91XSf7pbpzmwPC-uNWimj2Z-qrIn2YHj0A&oe=6A6CC0A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP8ePuz3c5AQ7kNvwHbobc_&_nc_oc=AdpgHVCpkIx-QvShO2BTJijprcLUI_vJRLl1oNBjoWDYNVfmd7Py-MWU_PeVYePeV7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzQTKrmz1pTYAw6nbQ_w_o-GvOw1Zt369gbDNXMlLzWg&oe=6A6CA7BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZPdu9qOxK0Q7kNvwGAq-Le&_nc_oc=AdqYiJdhz96LyME5OO6k6yggYVu35tFM1CNMjkUXLj-4qVcqNZ4RZZLWafsTeFVpChk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEqYVhpfuWDIvDZVZgbhZ5M9zj7k5f5e8NVp2VhDD2zA&oe=6A6CA785"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qJzzE55AaoQ7kNvwHeWR6n&_nc_oc=Adql0vaABfZYTunP7kOlsgMzRlXzh9CTtvMGF8ofIxwOggJkJdmBn2NWAgjXXrMXRi8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD32kToWPG1OAB9g7cJuNjZlYITl1TXLHaR8an5zJuOPg&oe=6A6C93D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4b1yMNomAkQ7kNvwGA8SdG&_nc_oc=AdoJFjZ_md2Lrr35kZWpeWnlu-kNP7Yy2mbhrpQS2D4oSWg5099MSpbhUYjSSXOWSPs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV0zzXwnr3TJyxsnT3O5azrqxUThlUvlnc5ajJZ-6p5A&oe=6A6CAC04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRHs9lz5TwQQ7kNvwHZudmR&_
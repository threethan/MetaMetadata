.com&_nc_ss=7f20f&oh=00_AQLpKQXw95f7vWkkoC3ZLm_H_G8cQl0-DAG3bK0nF0xrMg&oe=6AB3DF78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osU8WpSYTncQ7kNvwGvVzOf&_nc_oc=Adr4KrEcRCLCGOCvKiWcTkaXGCX1UREBZnkkfP3jqgYgTFOq8zUXmqQ-ouG3fsOInDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhXIUqqKU0Kmsi8S7tk3VGzJ4O05tfx8tSpyDnljNFMQ&oe=6AB3F1A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGKSIWwYi0cQ7kNvwEtfnZ4&_nc_oc=AdowEjeHzVtWnru6MT57y_7LQvRVxg9-F7NKE2YgllLEfJPZiDWSdpbBeKtgdjhje_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJqwu-vqDcAPfnGblskiC0Y83EoKEvGhqO7skdEu3tCg&oe=6AB3D8BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvfJHtn4X3QQ7kNvwFcpcQu&_nc_oc=AdqVBNXqYHQzYADhe4rtJbTWBb8hSeLb6mdO2lTjHzOFekoHHPbIokNQdgYpLC4h1WE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINw3rH-MK5xJhdO2xknk6CrWpruj1nX56A504oMDNS8g&oe=6AB3D885"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8abHzClHvQQ7kNvwHArULj&_nc_oc=Adqbtye-suSJ2SF3dPpeT_GEAWVgWkjTTFcxUHoVhvPuX2YySCdGnV1Bk2Vk5eJH73w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkFoypPCqALBj06ounqmAoOqg2voFV2JuL68XQ8pIvEA&oe=6AB3C4D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLjevU3JVxAQ7kNvwESGjIK&_nc_oc=Adr90mzMheDwWjKCONG3HJG73Uaykl0TNS_onsPCNRN6-kYIg9J1qCkFUs4ZFiM_-ps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9vWoix652ECpuNfW-VuRlwedxdjR4gb8i5IJY9H60tA&oe=6AB3DD04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBs2JTaIGIkQ7kNvwG3RcjP&_
.com&_nc_ss=7f20f&oh=00_AQHq6AgU9rjy3GvrMpeY9BNc17zLuklOvO1mZQ0ST9ADMw&oe=6A7F2378"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgF0I13I34EQ7kNvwFGEE46&_nc_oc=AdpeXvnxWxTw8hlHELikltloFfOTrIhJcIaqFZrLy6iNCPHWqii7_tTIqpc7UYdk_NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn_X-bj0PQTJSAtUPk-90OXe9kVlukPy6RSAqIjm5tUQ&oe=6A7EFD61"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=babZ1N_BNb8Q7kNvwHCzU57&_nc_oc=AdrbQgspbDb8aFt2slCVQ5KaubwxeQ9Qq-ZGRFL3WD08sMjoDYS_tTqukWb5ABJjx2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMoo06z-bq_wZue5IrFsz9IpHIeUHXDDXgSDZqFs77oA&oe=6A7F1CBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoO2gTKlHhgQ7kNvwFxsx4m&_nc_oc=AdpN4wAuyR1wY9a4QHt6YgOFxdzqoRryixROOXeXqhAORVXJxNqLqpJb6Gb0yrAM2aQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLU2FUmUhSv-yd70Er0wrLY7XKCTakZkY_e2jALg6wYg&oe=6A7F1C85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbS6GoaC2R4Q7kNvwGcvQJU&_nc_oc=Adop9rHmfO430r5H-z5fzV_ai_sMjox0maIG0C2lyuw0xSmHzc0E8dtmTbQD3JpYDiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1h1XOIzOFUnOK1mTZNLjA7Kr6M79ObCvDBL8MDbb5GQ&oe=6A7F08D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcQhgfYoWikQ7kNvwEJcRZ_&_nc_oc=AdrpHN3-ZZPug3s-OkbNdPG27FuRG-POtdB32qBDLos0cYFCnd3UFKbQkp0wPJR4THs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZzSri4BKijhNNslHl5yazGgozNymLOExki937NaNnXQ&oe=6A7F2104"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajgWDEjKkecQ7kNvwGE3w3R&_
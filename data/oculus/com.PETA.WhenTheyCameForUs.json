.com&_nc_ss=7f20f&oh=00_AQFjIdcmEnMMRMEr8X4hOeBSmGvwYpdzkCUireWJKw1iXA&oe=6A846978"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN51o5dDJ7kQ7kNvwEgBlxN&_nc_oc=AdrX6oL-mJLutrE1X0-jwhid_xZnVKSvDcOANLB2KGIlbpNj54aQEb59KcD9fGSoot4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTuVU6ELKnxo61e-a1X_EHrqKCewoISSLAplWyB1AHvg&oe=6A844361"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HuzfTFYBTwQ7kNvwExnjAF&_nc_oc=AdprLlwE9iCHtsqY23TEOBicDwVGOs_ohYuHIWwHRvX4eLQtb1cB3CNDnxpC2Vlzn_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_HlXmr6CUkbEzFduXJ13l0FJiLb6ykKBSoqIbce6TdQ&oe=6A8462BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcz6-ltdkuQQ7kNvwETNgdg&_nc_oc=AdqPyrlI9XDJbzLmdDR-l4hAl_U541DfVeScz-lN5uJ0EyzBohQtItpJJf3fPb7y6_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwdXlvE98Aaf9BakisZYNsbqCq0lfcct54kiY7_uG5Vg&oe=6A846285"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s75hcZAaVUYQ7kNvwF3RjjS&_nc_oc=AdpySBLef-jd0qAYtjlqklXjIrJ_9pOp_qjRrSLZbOlYIeJGrw52V-xgbdwcJ2IIzG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe8Or6gdCXPvgl523KJPuPkZCZZ7k33iDEn3YcMjnbrw&oe=6A844ED0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-1nEDsUCkkQ7kNvwHtj8_u&_nc_oc=Adr16pGXnTFQp0_62OuquLz8jdS3mgXYEeJ7A2vroHBj4wKgbAZAEb6AxjA0-sXXN74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqutsveEvmrcpLwYKUi4OQHCSTNYuOE_0FlCy-clLhNQ&oe=6A846704"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mYIYkom6ZsQ7kNvwFbOFWq&_
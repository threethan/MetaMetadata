.com&_nc_ss=7f20f&oh=00_AQILcSTkbnozIXfwrAUuQqBWJJIxJ62ZdjYXCcSpOfhDcw&oe=6A9C2478"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrvrTk4Lb8gQ7kNvwFuPLFR&_nc_oc=AdrqmlOEaAlJkDeiU5lV7CPaxnTm9IOagquyBGaNjx2Ffi70dwoST7gUieXERAxMlSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVDdioN84WGoU5YIVOZaWEPZgHOHI30JSWOvDDEe9V2g&oe=6A9C36A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-gZHDwpYRsQ7kNvwEA9-B8&_nc_oc=Adqmk37rBi6diVlc7xg3-LbUZZmv1N0O5FIXeMqzlYF_DvOJM2wg3lwYFmeZ1eeaUVo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2dBifG-ZmI0pwfti48h8ppVN9aglyOBqXV32JlZWbAA&oe=6A9C1DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwKH7KPOL-AQ7kNvwH2vMnU&_nc_oc=AdqjeOoAhyu54Bqm1rjG2Ze7P2MRvLWT0yEOTIopgaSZp4t4nvZDG9nusnwf3tv01io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKht8L2kCSF6ajAPPx2Km8toZqA4DC9t_lKGX20LtFv7g&oe=6A9C1D85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFpV1KjLjooQ7kNvwFKrnVq&_nc_oc=AdrIXPXQXsj8dWgbWv4xxiZ7pxpRJH-pQxOuXgzbb4ZWcwKfXjlzqknoULXNRRK61bc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9oZu2B3vfTlGEyEGrTOvel1Fy2RFYg7rRjNbZkqPkwA&oe=6A9C4210"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNPWCcyd6awQ7kNvwFNukjr&_nc_oc=Adp8Da5ckCNRWw8lYImbKufINXkCW2udyIUSzc9r-R36Tmq8z2zpGHDF7vLisrfmpB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW3ASdp0LNBvDPUxnBpOI1wYYn5qoCBuXwMcoAZcfVHA&oe=6A9C2204"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0SGl_I7m0sQ7kNvwFK-sus&_
.com&_nc_ss=7f20f&oh=00_AQSAocmVOoo7obK7pWuT2rHjV63cGsj-pSbDCWBdqA78oA&oe=6AEC8FF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVCgHO8nVcwQ7kNvwE2BgR5&_nc_oc=AdrvFQtn43sN55ZnO4tEsGeunGH0pfQh0pJEiH61THR8aapWPKF5IlW4-AGURdjJRng&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScsweNbqS3xa5z4ohCHOKjL2nlHJblr6puMJU814Sn7Q&oe=6AECA221"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYerCl7D6moQ7kNvwH6Wy1G&_nc_oc=AdrlWpB44aumh6Q630WxF4vFNfGHEvxdrEX2NjSvEjQCI4GrrQfZkMSNhYOr2feR1nA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaqly4ewUN1pjf5mvVDNBLgbCuf59SYkCfpZzonun-iQ&oe=6AEC893C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7pBVHbQb4IQ7kNvwH_65iW&_nc_oc=Adqc3Gi7DNuqfPxmsuIdDmMoGAMp0c9ZibUcBBgUMRZtmleRKeFPnI6DAsqchCdint8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBf7-ryLYuYz-DHrhmKmhGn-xORf3qVRobGt5GpO9Ndw&oe=6AEC8905"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBe0hyfI4ZkQ7kNvwFxg9LT&_nc_oc=AdoTUs85PXJtwoeJHgeBHw8JQ3I0G_Iq0QshFMKgWgLZry9SW4kqlkAdVzkax9LBgJo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9urcC6t1m0oDGfEwOiRJ3WKyxGUY2-53VzEfQWTLdsA&oe=6AECAD90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L22NMZ33Dy0Q7kNvwFcMK-C&_nc_oc=AdqHIrU4PR6iBNgmWZ-_exFok-tfDgvQTeWjDkADDnvzOpHeDpBiNW-NgxW0Os6Y_IE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCg0KWSAkh1I4QV0SnB-w7yBzKZkJtcHHPQ7xlOSNMHQ&oe=6AEC8D84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSbhkzZ3W7wQ7kNvwHCQMao&_
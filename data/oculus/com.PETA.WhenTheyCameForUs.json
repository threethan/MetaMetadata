.com&_nc_ss=7f20f&oh=00_Af9jJyNGgOwNbleZOnihoI6hp8TvaRZWFGHXifFrWkPLpQ&oe=6A282078"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shSz20ks5RwQ7kNvwGZrhMw&_nc_oc=AdoVTTwYr6iywHzxoCFQJIrTKzSfmVvOECFoYjiW3wJm_Hu8lbfTDdXX38egues1Jls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c9LMXDqFLzDUiHlyu8SdkDXbmfdK9uGW_f9DosYo7ow&oe=6A2832A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6bFZ83uPdYQ7kNvwEIYSM6&_nc_oc=Adp304L6-g5dq-4CscO7dbDs_6H5cDiU1_w2J5U3cmXpQjJC6a_ux75vw12RfNxs5aA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8X9Ne7vRXaRXxOyacD7w3BpR66dag4M8OFwECms2Q6A&oe=6A2819BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dHNBTOxBq4Q7kNvwHDt0qe&_nc_oc=AdrCPWMAyncaEeyNq5pjBojBrRZsVz0reFSrj2MCWtunEFX3D_X9iLC469iQbUXKikM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94rC5BOx_AZgZnRicFaXAH_Z4FW5RTYnL-sGsmH5KUFQ&oe=6A281985"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS_aQpUoKvQQ7kNvwHl6ODM&_nc_oc=AdpkByLwiXOw8jcBHN-8EvyGu3lhyvAHcFmtUtEyotuwpZwLLOmEHygbacyczbSqXSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93YqdVyoPSMqjmpo5RSyHrJimhkN5CGyjULcgkkinUAA&oe=6A283E10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXK6D0FP07EQ7kNvwGT3Gp6&_nc_oc=AdpxVmMy86KUtorb-qk0ULlIqQEf64mbxPArCAlrVSqoO25Xq3g2Lccp17zkxlnllgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xaMOUyYtR_MTioix7XhlyDdHBbuHTeukgfJPEz7VMyA&oe=6A281E04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWUMRmcx_ykQ7kNvwEFAVWo&_
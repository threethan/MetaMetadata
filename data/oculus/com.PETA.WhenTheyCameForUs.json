.com&_nc_ss=7f20f&oh=00_Af52pIUc4c52bFW85L6PjHJBZCVmBvODFlRU17KVoKPMKg&oe=6A0DC278"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2pH6Ih9sx0Q7kNvwEuhZ1M&_nc_oc=Adot4ybVjcLPPAIE4N-TP8253NsPjQNhwpFkOl9vJh1avAOYCl1ASYQIVcENrh84_tE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LkONMv6qmHYN0SZDM5Hsup5hN18eDr9MKZkTqKx3aoQ&oe=6A0DD4A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHHTjcLz7UIQ7kNvwGmuymm&_nc_oc=AdqK6Ic_4RWTBnbF8uKIjCwLd44yLD8k7Mr1tN1GxomHz2_uDLoXhvnX3u5VJ5Qbdx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68YrkVZAc7gm0aH_w_boo5_tgyG0-rcdnD8JyC-_ue1w&oe=6A0DBBBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFa9lA0qkkoQ7kNvwEp1s8Y&_nc_oc=AdpOa51svZKWpUM7g7jwaJegZHVuIMD7-jrflj53nAVJpJ8EFUr2GaEClQQl0rrMFFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42A8m8BnGx4MQTl4rFy-gHZ9s36uybcGSfSZOgC9NyOg&oe=6A0DBB85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFH-8K9f8YsQ7kNvwF9vvge&_nc_oc=AdozDjzrm8NCyGFZz_buJ9ZFBmP1WvOOZNaY7699nd-KtUXcYsB3xBnRHzgIp8NBMIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q0jM7tnLXUbOVvvxAHV3u5L_dRLBuoJ6ULfcd8eYQww&oe=6A0DA7D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TgdQal6mW0Q7kNvwEV4sH1&_nc_oc=Adr6vk5cibN3lSmdM9Ps9WJuJZGM4qRYvaQyHQSFMPus53PQxNoTOvrglVRIVNemvYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tw7SDuglxIiXgqfD5gUzdgjIH1qv0vYmK5D_YEVzpjA&oe=6A0DC004"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSmH7g_N5tkQ7kNvwGHC36I&_
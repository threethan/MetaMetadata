.com&_nc_ss=7f20f&oh=00_AQN06l0jTbH8ASY2ghwPaWD3me_WPpJvucHSraxCqd6toA&oe=6ADF60F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcnVsV888aUQ7kNvwHv3UYz&_nc_oc=Adpa7NZztiDI1S4q7CveIUFs1AUhDis5eYICYSBBhMCa9F5egl7Pyaca7IdKVWd5a5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA6o6srlc0VfkInBhXA7i0mOf4Rep09lYM1WmuQUlxWw&oe=6ADF7321"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK0E2ROANi8Q7kNvwHlY8pj&_nc_oc=Ado5Bn0dyQ5667smrXAoxfVKB2rBxeINf9E74_FCJUy8pXigQ3CrQNvvIUCEOQ8IroA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu_8_f_LNPgvzWn62nvE1FoBGa_Cuhr_Pa4PKmDd_Tfw&oe=6ADF5A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJhLul2U2OsQ7kNvwHgvbM8&_nc_oc=AdpTMeEK9S8ZkAmtQrfUbMLmTyP1qwgGFmcGuogC1tRKGmbnP3TEbN72R-ZIxXsLH-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJx61iGUj9i-Dq9PA1pc-AQwaoshjAk0_RoXc3WveIKg&oe=6ADF5A05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_CRP4g7_60Q7kNvwHFwaLo&_nc_oc=AdqYOpEPkGtaiGmGQeLdoxZ4Z0L0dYIitxvWWGQnFJarp5f9zKyoIdEHBvOQ7d3WdiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgcBqZ4ZPHPwCAuSUiJT-1sBXNkgMCFLec5OAR1jKLQQ&oe=6ADF4650"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ju0-_CaxWfcQ7kNvwEXSbX7&_nc_oc=AdqaKfssKM3WPC-RMyYZFYowufPDHiMe7HHTxO_W31LreMciIpn88sICmrG0QQDKXo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYA0ErB4CfgwQoB3AEVs_EJi01JKOqrV5gA8zZhV7ILQ&oe=6ADF5E84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2WNR9EcmKoQ7kNvwGOkglX&_
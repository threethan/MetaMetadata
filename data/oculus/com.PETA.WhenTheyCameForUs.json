4967012495", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf_HsCtO7eMQ7kNvwHMmvh1&_nc_oc=AdnIGPj50EXyaYaFIan2pkmz-AsJYqulf3Y14Bn0s70TN_3uG5Wl1uNLCQeLIY5hQ9A&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwycOzUocPm4KF1HfG-xkBcOFbCN3NwGs9VuENOUQJzUQ&oe=69AABBE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS0WNw8g_H4Q7kNvwGNNdGO&_nc_oc=AdlsXpy_aru08l7a6H4Hru5C2y5CT5DfPJnBVL_LmcYnOnARh7BPm_pAgRCpZje1y1k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU58s5qFlhO0HkpEV9eHAnPBzTvHYexGCjKC0vOMu7Ig&oe=69AADB3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYUtlpG7QF4Q7kNvwEKkq3Z&_nc_oc=AdnljM5MY75jFYNzgL81Hao6TbB_iSnwrsraN2jZmNo_ogvwRLfDUEspVZS538fwAq8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfHMe0bWQDiuw07sNjSMhrVqn2PuKC5MNtetGMYAa7gg&oe=69AADB05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsiXN4XyUHQQ7kNvwEQfj2r&_nc_oc=AdnVXgZ7gNivL-1XX8XQ2zX3TzHJvkvbY5CHhF954gWpdZ6z2YPZ4KSNT5Bh1NXxhOk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzT4zV5UH9yZmX3aBxXcYPOe0idrdUF5_udSiEhzoWxvw&oe=69AAC750"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IirOBtAzu4wQ7kNvwEqdhjV&_nc_oc=AdnT50HzYCLK6NMkIqWRInhaHhc-FW-a9OmLuIr7pY0rJA5HZL8iVI3woUR-_xhaS34&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfziXGCZGom4BqX-yyEyLh2OCPF8-ceJYkh3a9VhB34wHw&oe=69AADF84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibVu92NXN0cQ7kNvwHaoQOf&_nc_oc=Adn79m2nPUaVZ3clHaEtjxX-qQY7vc7KnVg58ydwl_7y8wsR-alNbthThFBjqH7fW_E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4NN6HGw8bZQG1yVjp-8F7s7Jam_ZzqPffDt
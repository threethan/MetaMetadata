.com&_nc_ss=7f20f&oh=00_Af99AzLIDSUxlBqvfMn9i3cG1FgH-cO3B3TSKXLN5io9IQ&oe=6A3D3878"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tILG5xY4Vz4Q7kNvwFWXceL&_nc_oc=AdrG4DdZxYh1hH_VUoGew2GakPEzL0NscU8Qp3kL0RoituC0NRMZUjZEV2DqE23hcYc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o9JF5KV8xhA1GXb852UE8VuninG0ENQ19Q_itECxyTg&oe=6A3D4AA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrrCmJFR9VUQ7kNvwGk4tF_&_nc_oc=Adod-Rv18WDBjbEoHSKb4RjYS8EzZaZWM-WowpvPtaQkJuWAgufyrzBeNHaoRrmQroA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ewBQnaX3QjEn_4JMxr55LXy5T5d2bPcmDo9OUy8nonw&oe=6A3D31BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYBM1pOgYZcQ7kNvwF4ORBQ&_nc_oc=AdoXt-QK9ebbgzScQ9En7zi_KToh1OndXUHTZPEP0ZUpiyNaUU3_i8B-uPdEgq8l4xE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UVEjfxHlA8BANQySP2aUPVYMccURFZFyKFhKs062DAA&oe=6A3D3185"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCMm-FiuaakQ7kNvwFEiSWf&_nc_oc=Adq7X6FsDdoXikO-a_ik-PAeqG-wbSp4WU4ROCo-Y6-nwPkN--kd7gDkUM7axBpmgDc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dCfgrpKdXWLOXuxJ_EHB6wCkhLvDc2LEcvFVb7rS_YQ&oe=6A3D5610"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0l6Auju7twQ7kNvwHcD5r8&_nc_oc=AdqqxW1Ud35erAZaM1hWrVqMIts0bRcZ8KM0DSrEsLCncclw4SplQ8lEjraCqOmUW7w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wo4QPnRCT16TbxpoOFMtQy873fSLmuno18fiWYHcbWg&oe=6A3D3604"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWu9yDcOLw4Q7kNvwHXuAZP&_
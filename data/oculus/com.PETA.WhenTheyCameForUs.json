.com&_nc_ss=7f20f&oh=00_AQNOwE_eiqAnCAUpJGhQEa9Lo0paeoQVDXFDsHbEvqnOUg&oe=6AE203F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r04kL6c0ghgQ7kNvwGNGfaR&_nc_oc=AdrLm3vT8Gm0v2Ed9jMAIDNLpOPQ2XE78CA7ouumpD2VPE3vc6p3jp1-hNm7Ph78ryI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLKYDN6j5LlBbzV22-0lBWg1ENaIT45Nbpn5G3jAY7Bw&oe=6AE21621"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK0E2ROANi8Q7kNvwH7LjX5&_nc_oc=AdoivZi7EwPp0abY2gb26LfIPXkUdl5DWwcUziL67HrO8dGL4iTB1kcG84MLL5SWuVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZL43efEUM9d-1FmrlCTe6z4wseTcTrzXK9n0p_raU2w&oe=6AE1FD3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZstOL72bmMQ7kNvwE6DOnw&_nc_oc=AdrpJ1jwW0ZzvN-cH8peLmDAYMJp1suBGqpDcnjP40_lhA3G-JEIJWwA3RHfbt4knus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn7ShhZN-NkxKm2e9McEv2XphsFVDAVIN8iTaEpmzFUQ&oe=6AE1FD05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jTpklI_ZIMQ7kNvwFeq8J9&_nc_oc=AdpHSVpwZZmY0_eb0jB48JUqMZUNEXtXR3o1VJnTdbiQueJM6Q6-CzK5mL9LdjlEFYU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvXEYLKvyH9gGMSYt1Wd9Qq7oym8Sxjw9_8C5Wh3vPgg&oe=6AE1E950"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaA-nKtKR6wQ7kNvwF1X5Fe&_nc_oc=Ado5AZtB3PWm6FsUf7yzku6z4fJivkowOyd75FBgnWzd5Nbsmr6KQ7tBa1gGlvsBvKY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORjYVKRld6bktQ1FDTU9FECAhpY6-wSO3ZXPZ4ed6UTg&oe=6AE20184"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP0z6PcP9h0Q7kNvwHSYcNH&_
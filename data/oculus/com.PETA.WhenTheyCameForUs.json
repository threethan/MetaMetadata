.com&_nc_ss=7f20f&oh=00_Af8C_XMvTR2R3f1VkrpnYmGGECpJZ8Os4Wfw1l4RNVmgQQ&oe=6A2AC378"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shSz20ks5RwQ7kNvwHooy4A&_nc_oc=AdrRBnGKOLALN9PPerHqduRpX-w5lYvdWwMXVPpbePNUr618ahF5XcCo2ID4loBu48k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89vTbnfrqt5Uy2h7u_SH5bPxm2yjhUTFiJtDsv8oaQwg&oe=6A2AD5A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOnwlRLjqOsQ7kNvwHK2v2m&_nc_oc=AdpFQugUjtf3H_U2LOzoOArAs7M5YaUHsSOj6jg0zW6r9PA__pq1MPbhhRuBEQy4uAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hbzFu0-x6pLtp8QVSXKlGXZvvbdrt_twebTrbiW7T_g&oe=6A2ABCBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dHNBTOxBq4Q7kNvwE8uzlI&_nc_oc=AdpR38RvNggVLnlSIsxeziFWL8T5Cw7pXSUU8MY9wRpB6pkqu8q0Nmg919BqFxdt-fo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HAA5fJr26o1QUWF_dd2d-kYV-fwqHnj8CZVq6CHkwGw&oe=6A2ABC85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsH-CXsZzpoQ7kNvwFCpElZ&_nc_oc=AdrBVJZQHaywxKpTCtGlNluO15eqNxhAq78-bx0O6oqZaHGe6PLhLfy2gDw7PG-_bgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QoQ0PH9_PpvhYgkDe_mzz9rh7OwAqDLZhA1EbFirWMQ&oe=6A2AE110"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNMqFZIXHbMQ7kNvwFkeOD1&_nc_oc=Adon_se9PJdApJrL3WgJyeCXslebKc9ByIhHlCCwrKjg2h5-mfYk5c_b0Me9kfjmXbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bvwZ5UT6GPtV2FCyZkLlSDi0_Hwrniwu4JwmtHyZDaA&oe=6A2AC104"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVjN03LTwD8Q7kNvwHUulXR&_
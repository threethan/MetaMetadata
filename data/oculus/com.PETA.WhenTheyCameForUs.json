or_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA9qu4ynPqYQ7kNvwFma6Op&_nc_oc=AdrE6VpPWfEy533XYy5HMjPq2SLCse7MVHQnobzXNoGLQBxO97GqklN4ShEoQa8KQhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1W-Yat6Em6itYWWkbirzgFOZH7ko7OHl07niPid5ws1Q&oe=69F09B61"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9ST-lFpcZYQ7kNvwHdS-Xf&_nc_oc=AdoCr2xJr8g0K4QnDRLfLtsNxec_8rHXpDYjyZI3B0TRHRzarUsQfuHDGno2bRBmVW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0meu4t1t8OWQ8j5mrfPD1pGXGtrnU9VUNs_VkBJRSEPg&oe=69F0BABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k79YFiMo_lUQ7kNvwH6mR_X&_nc_oc=Adr44aeSFdIJA14KjS84Fv3xbqw3BUi6wpBFBgcwbWPDGOjQ32tMAo4CgPMVU-yykis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0a-6qS-5BqdQ55z7zcZINEr_p_qlzhNexkWhgdpuSlZA&oe=69F0BA85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-q81t2_8ykQ7kNvwEIWkX7&_nc_oc=Adq6Z-jp7BHSKiqEJbZR4p8LQvdjElywyOTE4DIo1T01Ye5kT3a1mstzA1BeDZ3htFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2y7OAYXa68SWXcZEoVXnfqRb77ovaUoQl3WePfiXymRQ&oe=69F0A6D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hQqXMWfiRAQ7kNvwGew4OJ&_nc_oc=AdrRv08q_cOivVBWE9q8JJAZKSm9CsqzQfZlmrcvwzJQWlwTErnpJ2FkRsVsK4tTsL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3PJGM6zg7uVq0w2JsIRH3LQGmRfB-GqkgJRqRnbCmNfw&oe=69F0BF04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAYsDXGKAOkQ7kNvwG1cCBx&_nc_oc=AdolmpzdW8pmoTnBHvPt5mKHlN9W0PDW0koT-mf_9tOjAs7YOTdvkXku49LcYU6zT1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3paOMAigCny6kn3VfE8Q7qHeV6pX6tctXc5nM8cLj7QQ&oe=69F09F
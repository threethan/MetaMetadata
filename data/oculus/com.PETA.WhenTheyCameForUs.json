.com&_nc_ss=7a30f&oh=00_Af31GZRib3K8T2J3xupUdSqs8SNe-xgyGm44Ox1hTiIhLg&oe=69ECCCF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Y8LMLe_T6kQ7kNvwEdllMM&_nc_oc=AdoLRYKjQZo6DHfnAFi_kDjW4SZN9ZpTcT6eZrXkpQkjBaF2ATw4eJvqWHa36R-dR0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Vjn4MgOhh89OuWDhRhvjqNNJkU6mIKzfyR53cKUyFkw&oe=69ECA6E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7rUuyqyCWUQ7kNvwFLgJA9&_nc_oc=AdpphiQeSFs5YGdvYGh_NJ4-x-mOKw5M170V2rwhpZeU2G4igB_DPTtiuX28EMfxXQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Jm9VlcrqJfbsxGVQqkMLNBU4sosVGrk3WJUHRsj_8gg&oe=69ECC63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhCWPdNYp1sQ7kNvwEpI1PS&_nc_oc=AdoAZdxfu36YQoqXur56dxJTJYNzB0OQ9-4nsW1UymnnkEWym-9vnfVHJfnORGLPZ1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23L823s-Njfc12UHisP1pucnJT1CRfrKVaS0pPfmNchQ&oe=69ECC605"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0NlYgPzDpQQ7kNvwFTl4bf&_nc_oc=Adr9ZAzndu0Br5wtIVnpEckBQiIDSvy9a30h576HExGcBgw5tm2xSL_QTe_GrBrrDN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PtaD75Jl_v4n71T74N_HaIPAFtPJqhCWhjAdVGNueWg&oe=69ECB250"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU3x8TqTBG0Q7kNvwGjc2jX&_nc_oc=AdoN59S3ezAOVHgX79rZyQGiYt8_NWZB47VTHXuEZJUOardgvhWR7FtHr7EmwMCKQrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af243hgm5rFh3rBSrIhTb2Hw2wImicejN5Qect7aE10IYA&oe=69ECCA84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKHxMsnAYAwQ7kNvwFzqG23&_
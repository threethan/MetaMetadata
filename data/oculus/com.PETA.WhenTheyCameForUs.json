.com&_nc_ss=7f20f&oh=00_Af_OAlIVUEVRPQI0MHLFwxr9m_wm-IwNaAEiOEZrR_ZNlw&oe=6A2188F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-UlCYx2wNAQ7kNvwHbh-c0&_nc_oc=AdpWMshPxkwdsZFzUQ4a9NSLq5Zmob2d5lB3RjKwTerBJwXR497aRhjai5rlJvgqZ50&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b3UN-LivqRSa0H0PJFQzBOVNKcywNPysFnNQzeWgVpA&oe=6A219B21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi1VV27KmzgQ7kNvwG1nflZ&_nc_oc=AdoKJp8gHlhJ_IiYjs0Vk3_0_J3cINlvW6vUMve_-J6ck6y9tFQ5YEAXPOBXdE3x44w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-2fM48L-t8l3htUs1YacQ-fTcjFjCAWCyP_FmiRPafg&oe=6A21823C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCtKDCvw2C0Q7kNvwHMJ3dl&_nc_oc=Ado_-XxN61X-RR29Hi17vX-jix_m0DlU7sFCsrOL8VIa9iAgz_vqt73PBsD3iIZJRCM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tVpyLYWUeSHlIWBEU0p2J-UYY1Hwn2Ut6Fvlrfhf2cw&oe=6A218205"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WQrHEYwiiQQ7kNvwEFxrDz&_nc_oc=Ado_irxmLpHzy0GS6jqpo6hCn68zwp5CW4fXi1eHl2sYOYxpqYSNR7tUCo6a8Colxsc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vOKTO7c3G-883cp4XHYzJkFDRo1RZ6PyJW9JV8EEN8g&oe=6A216E50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa4ZghGjIP0Q7kNvwEKlf01&_nc_oc=AdoHHd9sOQG4VVgyxy631yTrdhiNpHLAhCuP7vgbO48yKGVJ-FNeyLKb-nA5N8d9iEs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cbJL0VxVC3kYGrm5Qn9N2p8jkqeLNe5FicdnJkNtH5Q&oe=6A218684"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnctxg7NQ08Q7kNvwHnE8tz&_
.com&_nc_ss=7f20f&oh=00_AQEaG7gQIgTy1QJD6tumwZFwg880oxN5KmnXr3-aNfpOvg&oe=6A75E8F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4AiBuCDWB4Q7kNvwHz_k__&_nc_oc=Adr1x7nEypQ_0Kzi1eQRzjUWbAbs1F-ObHIJLw-c7SKWGJFtUEkYKojd_Jx9hHuVMPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWh3uIvHVyAEp-kRZGo3P4sBAFd9uMLCHrLTeqGk1j2w&oe=6A75C2E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUUeshhdOnUQ7kNvwGho1Gt&_nc_oc=Adp5m1YC7tmjmQczi5gBcVUMurECA-okJWoxr5F69tXOirRLc6FIFHRWIog2gp__A_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1o6WT_gGuxTwvF8A6fd8dH2MFJav3iuQ8thmdZmEW6A&oe=6A75E23C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwEUabkLQmsQ7kNvwFEjJ2W&_nc_oc=AdoSfc64BuDutMFOpHxXAh8wuOIW36YRxlo81WgYQtGEnHpum3nCQe9rvFpqm52zEbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8jE5GjWf6FfyZMAcIVnuPhczZ4uEOjG8omVe79gecXw&oe=6A75E205"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjKY8Vp94W4Q7kNvwGVBYO0&_nc_oc=AdpVKUfSk8tNNBCBNIPXs8PaN91K0aDakJH0yLSu_LcWcFIg42NfAx-qxAaWJ4urKoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhBVEbyNT0g7Yn1xBM1ci5ZrzftsS2QMeyl-m_QySpig&oe=6A75CE50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIj00yRSCqgQ7kNvwGbFvIP&_nc_oc=AdqjMRUuym7Wt2gzAJh0W_RMA8Ox-078FlgF3GWJzJ1W_J4tPGy4CGy01ZN_Sn0zLSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZsSC0ma9PQYs0DpFqV2ltSvL7ktjN1qUYkcrHraDMpA&oe=6A75E684"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2k-k7NTUhkQ7kNvwE6LIAu&_
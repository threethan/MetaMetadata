.com&_nc_ss=7f20f&oh=00_Af19bQvT_aNHJ2FDCE06E1hVH3-FsMZUxo-qHzHAvzL5NA&oe=69F8AA78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDBzkjg3qnwQ7kNvwF60fbx&_nc_oc=Adp0XZpxqehVxQC20FvtMfeWqGU8JbOW4wLZLQ5K8EmDv5lTUczhmXN5GIaiE7v8HYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af189ylN_nx1o0v62EuG0vMPpJy0EOXUuQ2JwaXfmmTS2A&oe=69F8BCA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4GIryVh7RcQ7kNvwHA-cp5&_nc_oc=AdrY48331MDcipYT2QPZLj8GzayqhNXBy63BVPuL3LfL0Oj9CrltdYu-MTjwvbhK37s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08c3V9se_iTDd7d2_7MzKvmK5vTtCae7T0T5SsIj5zTQ&oe=69F8A3BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsTqmQV-DrcQ7kNvwFR6Q78&_nc_oc=AdqNAr9wh3w0xS6hmJSIXXb---JLLssHb55NHPfm-vdJ60rNi0z7N_7zssHO7kkMlK0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oEwXOwoPHHXBVVM1Bs5vTgrwtQmjMcu_EkoX38d9g5w&oe=69F8A385"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-uAgncvON8Q7kNvwG0qAUA&_nc_oc=Adpx27NlYED7pET4enXeaNV6JJrbrxR32zZv15NQIP4PTKt9HR2SeX2uu5QUpPzCcCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oMoA18XquisPFBWZ5jJ1hP0WMgxPxroDkxTogWa1tSA&oe=69F88FD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0hRVAliDsUQ7kNvwEVRslv&_nc_oc=AdrKeb59Fs1DgG8f_WbuWkhnuy026_vtQWI3gzUV541_TrlM2pSddAzGCoycY6qk6C4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1s7B_XV_FEH1fYk9pmJy6-BpVaVYeLpOBXTZv0dVXtng&oe=69F8A804"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCSZ4qHelIsQ7kNvwF3s3oA&_
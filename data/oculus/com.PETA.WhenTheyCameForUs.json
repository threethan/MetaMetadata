.com&_nc_ss=7f20f&oh=00_AQAjAqJE1Rrze-xcbQnYhPkSLgWRyT8TZyglEXQHeDd0SA&oe=6A4A6778"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTgeRIqs-XQQ7kNvwH99Ckf&_nc_oc=Adq255iENKckccwKWhzu7VTD9PuOFgVBPXJj6lsMAx8V-eXggVUkYGNiEwQo2xhdGPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOhawelDXhHTNNfr023g3AvDHqpL5u6Zg-Y_EKliu-5Q&oe=6A4A79A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUkjI0qRGiMQ7kNvwGgSfmU&_nc_oc=AdrohbZOt19wN5-lMo5j6qXUtOtuEcEz8EeW3KpuCXSoPQNJk74QyW7kAsbv8_CDs-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVNwkVMU-6_PZXahdvjDhXYGDuhByfqhnUX1iIZS_lPQ&oe=6A4A60BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHJjF0larQ8Q7kNvwF3ZxSZ&_nc_oc=AdrLulT9-huZlZDK0FyAw1yhUOXhyTogHXyRgO647QOTv4mLKTRjHq7586xZqa596p8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxFCdgFTztnmgbtf3HY1tPTFFgMQ5GouBDf7nTY7B1jw&oe=6A4A6085"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfyLbHAKJ50Q7kNvwF8z3FF&_nc_oc=AdqCK5EBn3CJQP2WJ_3LjozGOQZwHo1qLjP6VQe01Jo6CVMrQN4MV4PXQNxuM46hkc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCAaKW-5tiz_KwmQDL7FJNjZ_VcF1IZVEDyKJweFKudA&oe=6A4A8510"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyTaqBdBCsYQ7kNvwFvCfAh&_nc_oc=AdosG50KLRrCkTvUpCvcoMq34roiZvFU2QN7Ddvp28Y4IYdaGecvb8ZoXQHa_k7HVhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjfM5g3VZmb1j5DJtHv54FesajrjruPYIS76Krc1cTGQ&oe=6A4A6504"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyI7YhmTiVkQ7kNvwEqi9NT&_
.com&_nc_ss=7f20f&oh=00_AQKtQpAKrOeo81T2Vxpuzzpy15_7IcANwetKrsz8fPjorA&oe=6A9AD2F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrvrTk4Lb8gQ7kNvwFekPai&_nc_oc=AdrFuSW-v9X21UptmIc6mNsLI7uxAbWcZRoI4jEgT1zUeWXxYJNNRpDQpt9uolv1zrw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISWIadRrjW7jVKNAf8Zk9Y4a-eNZCyrZp6eYxVDToGGQ&oe=6A9AE521"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngvTF15z9iYQ7kNvwHW_Vkn&_nc_oc=AdpNK-dxQRdG47MWNyvHejum_o24KhEpTY36E4oDS-MNUPrbkuGMjcs9TkpOT6_B3yI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWHVuXjPozbS-8z_WG-Z_RzXLh5dfZmanbcAwbl1UyKw&oe=6A9ACC3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwKH7KPOL-AQ7kNvwHkxoWt&_nc_oc=AdpsrgYsCn5BsvowM4cecwIakukKCmwwSUj3-NUs0YBEfQmGcjuvGOJ7C-hiOlmJeds&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcbCBCdvWG4dsZI7kw8dCcOwQ5i2FuE2ylXf-uBE1dxQ&oe=6A9ACC05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFpV1KjLjooQ7kNvwEl5lU1&_nc_oc=Adr6audH2P4_17wCzYQ7ufIV91MGLpkOzEapMUIXghPAH24YSLEcU31Z1eRPKzKYx6s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-sWr9x1BopiZ7g5MNFGnczU94antCD8b70g27VY2Otg&oe=6A9AF090"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNPWCcyd6awQ7kNvwEn_jUR&_nc_oc=AdoZ9lYftaE2jm-lppUb2v6Yu1e4sw05V2VETdHMFHMlK5RUp3xlqr17BsEBOt5jEHE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlCK7Q425UQwn3NSEAwi7ncikLW1iZ2mI1iODL_NlF0Q&oe=6A9AD084"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0SGl_I7m0sQ7kNvwGXuQD2&_
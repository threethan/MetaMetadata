.com&_nc_ss=7f20f&oh=00_AQPAY4rgPUJvWvJiwO7mjQ0iOK-T18F8-XoeDltVfOY0qQ&oe=6AC7A5F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sowx1gfcMb4Q7kNvwH5XCa0&_nc_oc=AdptE0LN4JtwUAsiStnGOOl1cKZdi_GLO7WD1GPcHQQI0ueu3BVHzufjzlsTklwGqQY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-IpsOOsEtYZGoMZBXLxAOu_Uxf0R4mi3qQrfeJf6ifA&oe=6AC7B821"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g70ZBfLWkI0Q7kNvwGWxibr&_nc_oc=AdqCShrzpoy1dYiLju5c--gkAi2ZVPCWo_HClucwNc1PN4RfcDfBIhh9Wpkw2liecnU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqOc-L7bIvvxMYAITsBofTrvBLsVNSeDgZzK9dDD_b5Q&oe=6AC79F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ijbdmLVU2EQ7kNvwGHteOf&_nc_oc=AdrHlCaS7KliM5Bf3cD5JmbQhs_C17PCDXZepmas6W1Iyblp6PyJLLnbSQZL3nyyzBM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPds1-vzHpmHD0E0Lib3Ruf2K9J_Qb3RxaXFR0Q5o-rhw&oe=6AC79F05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoV02CoNHGMQ7kNvwE0rQkZ&_nc_oc=AdrsM7F5M6pDzw79WYyoouSitCEvTPlZrjsqY-uFSZ8bSYMI4SeVD6BHO2Qym99n1_4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLNq6zB9f45wuKJ4C6Di00kPVGxD5SjB3qF7dCTWeGMw&oe=6AC7C390"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUKuFk7phIAQ7kNvwH55bJ1&_nc_oc=Adq-sZElyvgcdqG0EUOt9a-vOh1ClwJ30NWqxj8LaNfitJDxMfl6595GFDj12l4Npa4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_-cxAgoWg37cwWNivhGJLJrVi3DSM9zj6QS5gpsSQEg&oe=6AC7A384"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2kAmpNQ91gQ7kNvwExwKLq&_
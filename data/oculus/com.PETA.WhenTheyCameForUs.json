.com&_nc_ss=7f20f&oh=00_AQA6sTDiCApNnuzOxq_0mGCGmDERE-8sDZSJ19SGUnp08g&oe=6A622278"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7xlAxjNE1UQ7kNvwF38kCu&_nc_oc=AdpjqW-q6mU58-hyW0b9v0RiiyanXSZksRD9RA2gidrIc1Nho-dqr3ejLMFIGSM5Bc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwaEpSqDQzhpKJp1U2-9lI9q2G9arOzueMVB1eJ13zbQ&oe=6A61FC61"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGybsusyonAQ7kNvwHbAfEL&_nc_oc=AdrJXBovTXpx2Ye4VUg-alzAkdlzFHNCxEhdz28PQbXt_pj79tOFF4ZKKxS0PuDo0wc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6VnAMfnhcFP_FZMd6TeoCut-d3yJeuha_iTD9utRq1w&oe=6A621BBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-zTcrV9t3UQ7kNvwHS1-ut&_nc_oc=AdpAMGbzutTXDwJ_TS_SkM5RuULfhsA5p95gDPsyQKaAk2ng-VP3ZF2-VrBRcCrI3Wg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyFhgiuCGJNyDP4nkRcaOLTGvpTbKzcorMn_178RwCTg&oe=6A621B85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9DwQcXSKSEQ7kNvwFXjvv_&_nc_oc=Adrxcz75HiED0O2PXRKciTWKmpENVLUh8__tPEPQqDkEwy3PqSWm6cqaRk2JGTNw-do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMHrNsz5gccbIqxkk4ZQOskrdIzvJ-P5xvWd8aXJNfUA&oe=6A6207D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23PiGVw7_bUQ7kNvwEJkCvp&_nc_oc=AdpOkyywr2kxwz1JJE3Ao1K5r2IU3puKrmqi8oUYsRfT0Dtce7Izh4nMtnSpmQXfae0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2IAM-6vrd2jEhk46LK8P0t5ZlmuaUXYtHQnQE4B1YMw&oe=6A622004"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndVf22Z1xmQQ7kNvwG9IWXv&_
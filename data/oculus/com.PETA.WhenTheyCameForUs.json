.com&_nc_ss=7f20f&oh=00_AQHXlAk_Gvd-xXtahqRx54W6euCeDMPyaKmdYgWfjR6YrQ&oe=6A81C678"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgF0I13I34EQ7kNvwEBS3ns&_nc_oc=AdpYq31zPehgpQ6cmuDQmL0G3DKWUfBfmGWr3AcXu8Lir4IDpLCM6fx0HWcSK5B-heY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkHxSkuCmR6cTrS870OALb4n7fiZqLEXOSvQzbSaGeEQ&oe=6A81A061"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqIw8x-q-e0Q7kNvwFybRfQ&_nc_oc=AdqBYIckgU62dq627hG3sjfPliAT-lKLBQXnFMbHokaZON17mDjAObgZtZB4prq6EUI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbGoyiQcEELPGlFu7_7CtXbASadhXUemOXUcdq8RE0-g&oe=6A81BFBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoO2gTKlHhgQ7kNvwG2mdb_&_nc_oc=AdqRYm_CYnytl1vRQTGx8lIxIJvxukkizIMd3qbRLjf9-2DyN1X9VCsTDJ36sFGmKRM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbGgJZDsMgTfhCNmLSQy9LuVZTk0XmFJ0T_b_EsT0pQg&oe=6A81BF85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s75hcZAaVUYQ7kNvwEMF1F2&_nc_oc=AdqrTge-ERj2SeBz_HcBYdRPDuFgR6RQ42mvar12b3sM9NDIa5NarFx7i8QNx_RXwP4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa2Z51gzMWsf_ou9oOKuZfy7RLC8zfAGk84kdsDPtfHg&oe=6A81ABD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-1nEDsUCkkQ7kNvwHwYCXu&_nc_oc=AdpiV-SMvfSy3f7RbWkW1nr8hw8ClmJqDVeJQGaOvvL5yRk1co-5K0EBuSa8GiuHz8M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExIjgSiRbzIrdFmhBkqslMP7K1zvSpi_wCZYU3PEryqg&oe=6A81C404"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajgWDEjKkecQ7kNvwFIPcS8&_
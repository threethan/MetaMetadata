.com&_nc_ss=7f20f&oh=00_AQHbtRMnuRy8rDTFHUddQ4Uqg6Bsy2TTF4WlQUCGZAEdNg&oe=6A897738"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WqPjmqj3zQQ7kNvwFOTQHh&_nc_oc=Adr6sr62uB6VKlmDmCdZTwHPfZVKqiw9A1f5SSzjk8GoxbL7a91gSLsL_YnEsV2fTE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGavu39EKu58ReCBjMVkfX8ufmI2Pe83S3qSUKJhg81LA&oe=6A898961"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCCf_Th1qIAQ7kNvwFP2Nz8&_nc_oc=Adr-0fSrV-TYMv9LAS9t-wOPlppCAKiHcjkOZ1PdFB1DQq1_q-MlwBrpd-uZJ4Tk5Z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG00ciZGPT7QGPq78Ze0alIMvV53a8jdTOOg3c2eAVChA&oe=6A89707C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4L5oCBFbjiYQ7kNvwE9PUDj&_nc_oc=Ado3_J8jjHDCw9HGdiqDKTdzm7w36DTO3omvjstaz-4uKjbr2kwiZLJxqnc4zNV2M-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFXsfTW-EQuDSEj1C2epVeYVqB007wnyUexmo29H9tvA&oe=6A897045"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7F_pvgbgPwQ7kNvwGJ4SKI&_nc_oc=AdpQrS2NZ-u9RlE7lD6RI4GvchUlkosRQXPOw9M8UiBVrRgTE3N4Mg2w5ePLAo7yh-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB2vmufoy55g6dKWQe8dri77yYOQCHKnPOp2Z9_pqUtA&oe=6A8994D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ptO0aL9m2QQ7kNvwGsVKls&_nc_oc=AdqW44QYWcCFocuyFVGoUEE4a6025jUcta8G-AA66q2UhjUuL1cNZZNFqHan2RGmpN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh4bA2S4Yiiox0-sn4pUmDeQz5o4Bqm0lEZoAlV2J2ig&oe=6A8974C4"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0FTEaH9iK0Q7kNvwEPmtGy&_
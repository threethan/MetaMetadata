.com&_nc_ss=7f20f&oh=00_AQPTa_65-v5a-3v2SNEypd4q77MWPLKjZNmYaIwvrYSQCg&oe=6AD0E078"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg77zeAKuVcQ7kNvwGXMW0c&_nc_oc=AdpSro_RN0f2HUKSI_I51rMniqMp8SrVfVQ7MfJZCb36ENAaYss9_zqV6cs6bqUOAS0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPVNRugzh-jcY_oNxcpB5tlwm5SDWTc6eZyumgzXp4nw&oe=6AD0F2A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eg8EuZ-0MAQ7kNvwHuHOU4&_nc_oc=AdpR48-n8mtbB9c_KjQsBxlzzbiNq6ofHAy-6Tx6Q_0GmNlN7_5zFN7tqbauwfgM4R0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ38ZsZ80mD8Tx21QHq_VVrBlAHrde-gS3JGjHWBwdZw&oe=6AD0D9BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmxZMnj7qcoQ7kNvwGYYnnq&_nc_oc=AdohJP6hnLBkHtshwy9fv5VtQpjaZzWQPMd4HwStuHPuY2TzKoah70AQMM6Tc0q9uwo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdLjePwMDKisOaM2JZPY1O5neytg3qJoM0UgxjB2PYBQ&oe=6AD0D985"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0aoDCbs9wYQ7kNvwFV9g6P&_nc_oc=AdrXQwtDzyLr8izHGQYSC3-jTYQsvIHV6IRmdDD5E1R38kQAVYoUqY2hCK__L02Mr2w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyqE1fW4HEfL8oPY8j4ut5pp_mdfvmHDfhLVYZ1Mhg6A&oe=6AD0FE10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcBM5IRCpHsQ7kNvwEB8F6N&_nc_oc=AdoBjQZ1AduPUoN82eDVDTTVzVkpNIOqdBfE8dJ3hkueqGgFlxBHAc-1Qk_xiz6YWYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwpOgJGZKkh2YyySLigULso6kczwy-dxa40VQVKckckA&oe=6AD0DE04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NU3TmzHaF8Q7kNvwEKBbtr&_
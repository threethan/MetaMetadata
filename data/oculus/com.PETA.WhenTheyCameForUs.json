.com&_nc_ss=7f20f&oh=00_Af8dpoaIGaq-oKbY5lPay9t7EpJdpMLUOyVvaEwBzvPrBA&oe=6A26CEF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmYGBPdP3FwQ7kNvwFzP4Rz&_nc_oc=Adq808bQ-fvc6EMG5-dyCPrPw5bSWlG2FUCOB4tRgSx8s2JRFt3mKi6EuSLVP-Ravrw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tnR2PY7ApGb4e_6fywlDwA7iUuUqfvccFB7xhzpLlTA&oe=6A26E121"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6bFZ83uPdYQ7kNvwH6420z&_nc_oc=AdpUjJI6d8HUnQNRp2GqhbrKXKcPwUsqsqak1FvfKQJGemjbInl9EggHC9RhM_nAZ0w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af___p9mY6GmE41WmrYaHnMeQ_vFyX3VPw1e1_X7-dmVOw&oe=6A26C83C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nc06yXtDd3oQ7kNvwGa-wAm&_nc_oc=Adr8U0wDz_ahJCQpkxYeOEtxW8xHZhia9z5aHoGkvT0iuaTMhpDmpc-jRfqrPuCWpmc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PCIORsYbmM4Gnj4x75h3ksCJZVuBODBKh6IDtNR9ZCg&oe=6A26C805"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS_aQpUoKvQQ7kNvwHCBe8V&_nc_oc=Adrw1l13UKZpI4OSl0TrYsg4hfI9CXONJdtu__y35kK9wJvWzDpVFbvLkBK9EmqyS24&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89BcYA7v4KyxLl6gQRxNkZ1r8ViJrln74AyrVlMNchQw&oe=6A26EC90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXK6D0FP07EQ7kNvwHeGr2B&_nc_oc=AdrdS7O9REVCI__RLlVe-jWHhIOmYByslMYodeoT8tql8JoJNgEjoRqQVCe5A3uiJQE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KzMdDXEMKhsj0B_eF3eWmNu8BHsCoR9vPCXkancmm2Q&oe=6A26CC84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWUMRmcx_ykQ7kNvwGgMvBs&_
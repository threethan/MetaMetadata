.com&_nc_ss=7f20f&oh=00_Af-ewc2OFu5H9xjR_Yn83xnClrLkNV9esS2u17ryAo1sHw&oe=6A2971F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shSz20ks5RwQ7kNvwEthlzF&_nc_oc=AdqlUqw804N4Jh_dSxNXE4uTut_ByewhiLrvxJKsns_YAtY6xIHugJNEeJQCWUyHbJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kr3ID75Z9ca4gc1flbm80H5urAe-u2HEDa8vRHL3mvw&oe=6A298421"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOnwlRLjqOsQ7kNvwHBZPqV&_nc_oc=AdoCtTNMBaeDAPHfsL8nPmqvbPGRLkxBLXBxSRwPX5AewNKu6jE_t-rYJCeXSykfNgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--I-EvBxQJN90No7k9X-hC6gvbLb5NB5AYMJdVUBwskQ&oe=6A296B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dHNBTOxBq4Q7kNvwHm6YYw&_nc_oc=AdqOV1jHrstxM9aiQjkj8iNJ5D_oF4J3gbpaS3MAYsdaMeejc1_LGRRGRl4bPmDrH2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7UtgGbaNkDvQwrgp5DHgAVzhmtQ8OKi1XGhQOBZha_g&oe=6A296B05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS_aQpUoKvQQ7kNvwHdAKED&_nc_oc=Adpd0SyUVL0GPHeYluVoiO28-dUEcCcFUQT0uOyMNQiCL7V_p3ny2H748NeP-bfBZtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BPxanO1xjOOYqfZ-wqT08UKaBEAWJstPThfS6Ka7m_w&oe=6A295750"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXK6D0FP07EQ7kNvwEnoj3L&_nc_oc=AdqKxx3zLuL3-GQGf_P6hCXozsBZbQTalAK9-WTwAhHPyOqG6zvr63On8tyx0Itl_xU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ixn5NgdszaJhrI0KnByhJJtIhtUmXLa39Ub5-ov6Ibw&oe=6A296F84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWUMRmcx_ykQ7kNvwGmTHGd&_
.com&_nc_ss=7f20f&oh=00_AQGSViQmKEKIDJXBPhTOvy5pWLYWVspXIgd8fQ1IdnwrqA&oe=6A8825B8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WqPjmqj3zQQ7kNvwGJFLw6&_nc_oc=Adpyra-GgLVfxUjkWNgse36ecC2ymINoIUGfuZCuAh6fSl84xu8Rl25TNxST5QQBQDM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhH67CDEf6Sc4TGg-gWZCkmLawN72dGzrlDWaIz7q5xw&oe=6A8837E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCCf_Th1qIAQ7kNvwGGhDOO&_nc_oc=AdqaK-OhXUzaCW2Uplh-VKMufMCe-qmJ5VyijeCzoGoFDRhGmoBsbBuzMpZaMYaXuLs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqbz33Cf9ou8wmzmbj-SGj6WslKOjsG0Wfi1HVkKTT0g&oe=6A881EFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4L5oCBFbjiYQ7kNvwEtWQ02&_nc_oc=Ado5k7lbt7xwdMrGFs5LwSD_Jw1ztEI4tu6FvMZF1qgxVTuzFf15xRPbwVPv_M_y4K8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3PrCeTrQCmD-4iRb4S0JxEI_kmisGzkoEq-hQYtw9gQ&oe=6A881EC5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a5S2i445kwQ7kNvwErpwaC&_nc_oc=AdpEmWAzzPoxTZXr48ij-Rzq7-TAbJka_R2Zrxae15u52rg7Th0Yfq1CjGKzLY9tpvU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZjVDZtl_iYhf_RFc1wX13-uXWcbYbrg1d3WmQhAauaQ&oe=6A884350"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXDQYhbM08MQ7kNvwH6g-Ia&_nc_oc=Adq3ENzRCWa7hW8Q9vtKwZ3yxVmCh-u-ebatPSHTPtPmuwSKKfbUFQT4Np1aU8_vliE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgnp-8MkC4pM8nF9lS1vX6vhD0kBzfU6uJSzBQlPiTog&oe=6A882344"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0FTEaH9iK0Q7kNvwGbsW5j&_
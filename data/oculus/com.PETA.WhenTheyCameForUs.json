.com&_nc_ss=7f20f&oh=00_AQA31wA-QVLOPtpqMf86SzlKeYTyleImgZF51dFv0xTnTA&oe=6A5F7F78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7xlAxjNE1UQ7kNvwHmrhiu&_nc_oc=AdrypoUF23HQtRBP8zojacYZmUjhG0BjspU69-TzCValg3BV1LMgxT1zg67WVb0936A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoMDeV4YUynNGlz5X32oWOU7AVSjtrayTgt99wPiATBg&oe=6A5F5961"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ETzDsT8FHsQ7kNvwGGqrXt&_nc_oc=AdodTlxblA8vG4r4YqfKM_szM8UqtvyACRMdjEm41_Jnj0zXojv4VTW6vfmvBLK2R-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWPe5STMQ5LUXaKoS4sdhQWmiwj8YHaaRp5tCLT2i2zg&oe=6A5F78BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-zTcrV9t3UQ7kNvwFQMFI2&_nc_oc=AdqJcuzuJX7F_7Yt4qObXD2vKt1VWEp4xqfZQokH8lIpOyN_5-w_t-7Fwrcg68Lf7D4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwty0tiC8WOTwcwJYzpj7OJcNoQNGNv5dHRUSVwNxn9A&oe=6A5F7885"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8he6cWQnMegQ7kNvwEXiuNi&_nc_oc=AdqJIdGTGukBJ2pF28mvnkHNYMkPMheH4zCj26nqnJaFSstUIUdMDcRMsBDR2-90PjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkvYxUpDk99mRZgeXFFnltl3QHfAdu43iwxpnjY0oo1g&oe=6A5F64D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7fTTwc3E0YQ7kNvwGmRriO&_nc_oc=Adqp-mNLQa75RdMGSVtA0UDnf4nnTJzjuNRwENCFGR9rd4Aar8PRs6hp8dqH_jd_cjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDmYk4pgvOXscZsCcdTEJiF4wzSLQP3PjQ8k3Y3iliQg&oe=6A5F7D04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndVf22Z1xmQQ7kNvwHJ4wKI&_
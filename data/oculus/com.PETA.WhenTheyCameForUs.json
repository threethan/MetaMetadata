.com&_nc_ss=7f20f&oh=00_Af7mK6A1bY4ZIIuyglr9LYvvURk978t3f4pu9jZqKytfFA&oe=69FDF078"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xczn19kHE84Q7kNvwGY51uH&_nc_oc=AdqvTrxDcu-PDZVJ3fdIfOWHB8MmhUlWQGvS1avIsuLEFVNbO9_XDUcTcXF8jhTtO1E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dLWFxNF6IgQi-2Bl2rQm6FaM7JlFOxczoJir6yMkQxw&oe=69FE02A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGYV7v4Y0aAQ7kNvwFpezjs&_nc_oc=AdoyxMl1BGVnqyNBvt9BcZE04k5xgicIn_Yl4moL5r6cdJvvxpQU3hETjhsxp7wZco0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h36543qbkq81dj29m2NoV5jl4yrJpCbni3_o2XNpcIg&oe=69FDE9BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0T-SV0GvqEQ7kNvwE4neoc&_nc_oc=Adp2RfYoQy-4kXlkggvIS6wzJeb0oDUuZAeop1viJurrVjOBsIA3kVj2qsTFp6uLjPc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wxu18K7G1R25l2SJWVtEWDhF7GsdBmdGAUvdCsVnlAQ&oe=69FDE985"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsUsDFhN0YsQ7kNvwHKb3ai&_nc_oc=AdrLzh1zu9DFQIPtblJAacQEev0k5W6uvmh5K8I0ufzXlC7RT1zD7pGcKySez5QiMcI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s87tObrNNishxTAS2G2ofQBEFY77NpiXrJdlxk8q9Fg&oe=69FDD5D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIpWq_SrgvQQ7kNvwFZofHC&_nc_oc=AdqU6L2ax38F9sjZqK8jrdhi6P4kqqirnqT0grDnJ9AvpT8iKWe_UBeGpqWeR_Z4W8E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CbJZsDY_fsDdsx4nOFhupFbal_hV6HXnYJzzuYHSEKQ&oe=69FDEE04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBdSRkZGWx4Q7kNvwG4tCZD&_
.com&_nc_ss=7f20f&oh=00_AQMfa-un5TF-VuW5qEkcpkVhhrEvX2EkWayFWsrdwK3sUg&oe=6AC25FF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7_ujwcaLUQ7kNvwFbsbwT&_nc_oc=Adplu3o9EKirMSkz3GmUD6yYG1cvAnj14yoswzgs0v8xyXXdDk7vTho9Lt_WgAbKizc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP18TOb-vN8_tY165-YhDdBNS1KkgKnTFGmsdA_ZhAVlw&oe=6AC27221"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wibNpHi0OJkQ7kNvwFYc_ZC&_nc_oc=AdogHmK757C7gnpvoxvdF5iap0hyJmDXyAV7p33XOXTvws7QNPziYSx1NFU9luZ5oDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQyOPCHTp8v8fMEjl5q66N5Hq-fSFNW65DU_ButhsQ0w&oe=6AC2593C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QyzgYjwt7kQ7kNvwE1D2SV&_nc_oc=AdpG90F9C6gS7qLaQ5Os4lSj-d2PsW9LuEjwlRZb7F8yKOSsclCPfj2dXpUxUWX-HgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN33eLVzeCFMgfrzKAV2C2TeHXtXTha9JZe700ygWYB0A&oe=6AC25905"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhrbYTtwClwQ7kNvwHpItDD&_nc_oc=AdqBEEpovoNmIOfpjDVtGMvWh4uw4ltjOLhqY3JaDUUy4wcSYZ_K8Mh1s8ooLdWfrCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7iHMDI23EOdc_YGooH_2onCpe1OCvcu_eETPAC_ArGg&oe=6AC27D90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3HOFJjO_Z8Q7kNvwGNavpk&_nc_oc=AdqPDral1xYQl22-uw-FWhS-cOPJtLUVGSjQ3Sd0wBessKwkYE7YeK23d4YgR9y05Go&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtyPzLDfqWmCtelUnFTY6vagWi7phAfsc-_jQeRyZUcg&oe=6AC25D84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIbpkIQ6B74Q7kNvwFZClnu&_
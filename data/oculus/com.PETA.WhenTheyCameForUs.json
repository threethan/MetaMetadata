.com&_nc_ss=7f20f&oh=00_AQTl5esOmC1T5eenjB5s-DsSLteSCiiCEK2aOVxXTX7VlQ&oe=6AEB3E78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVCgHO8nVcwQ7kNvwE5lmhg&_nc_oc=AdrJcxAIar1h7tNuNOv4-u_WAweROAkihAWnhCsCn-IOE-gx4P2aDtF6e9og22CC3Yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWXNskHhRzIW-QtI2mcWz-Nrrr0B7wWdIL4aULVa8fBQ&oe=6AEB50A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYerCl7D6moQ7kNvwFgx8NC&_nc_oc=AdpQE4botVnlzsYcvCd9Pi68m02vOZFoMDLBCp4rvIW-Xfa8bbKAIVaCy8uMFLcDjnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9sFh1F0TUQYyeGLceBO4uSnkbObs3C3UA5JcZI__wuw&oe=6AEB37BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7pBVHbQb4IQ7kNvwFM2lkM&_nc_oc=AdotbR4wEdMQd9KG2BWCJJWP3C1AooW6ZUGtMeWjQhZ1gx6CnnrhZXPyK3B7vWY1FAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5OB2WZXEB00ZkrVO0wkhxAgPnsAEktz7-OWDUmJldug&oe=6AEB3785"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qrbdWw0BFQQ7kNvwH-dQdI&_nc_oc=Adp26OgTnPPldnmRpFkmy1wYWOPaP4hko0l20HMlbFz_540uUpK5t8hWmtOsZ8bSfhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSOuVVn6yLYyChaPQGOfQ5TlY0bt-qSOvCJ_6eM9I3qQ&oe=6AEB5C10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L22NMZ33Dy0Q7kNvwEaP_ml&_nc_oc=AdoFK05G84Q_eN5eFVbdWIdTw3etqzrCsa8JpM4H4kvnqgCRNsQreYQH3NPhF5rlkzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwg2rr1l5Y73fgPpfjY97Afe1s-FiHXIsYUqOyVGu0lQ&oe=6AEB3C04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp0Fz5CUnZwQ7kNvwFQSMtY&_
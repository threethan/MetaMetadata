.com&_nc_ss=7f20f&oh=00_AQCd4lLRDQvtBrkiKj-liAr9MSIzFc1t6k_EMV_C7jwxxA&oe=6A64C578"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LOz9x3ZXP4Q7kNvwHc0AyJ&_nc_oc=AdoZrjQpe0iMnnOXm5MQheVN2PQUKVPjQ2TZQeraCXmABA-o2YecLslOgDFPZkMM8iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjhJwPP3zvMgbcB2klMBPbaYmdSUU8OM_kqdfj8hRjQw&oe=6A649F61"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGg0yoUkzdMQ7kNvwGE5m_-&_nc_oc=Adp9plHrsWePPqLjqNuq_9jSxMQ9otLYn0AwFIfOST9ngNL-ZsiZc0FB7jVPtdmTUzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCft19K0tpzdiaSNfY7-Yn6U71tp29yAy4bpR8uo7W9Gw&oe=6A64BEBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZLWg5aOJRYQ7kNvwEmmoGc&_nc_oc=AdpOQtsxaV9pCjdqBzHSrfExZf_PWAq5c0Axt-1ZOwHVf7JHAMnxzNLGGAjQgUEUlUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsSM8wUlUs_I0VHUQBw9v1FfQqch-JaG8Lhr7vsuwTbA&oe=6A64BE85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9DwQcXSKSEQ7kNvwG15t-R&_nc_oc=AdqHF1wk3FrZ6MZmZj82Wll8-WNjqvw1QBPWvUE0fpUT8-_mQLe1Lsph7PLbV-1CyAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1hOIlzS1050DDoTn1LBtLVluA-rnErA8g48hvTicy_Q&oe=6A64AAD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23PiGVw7_bUQ7kNvwGXX5ks&_nc_oc=AdoKf-BoAb8Pru5SQSKLls-z5cPYtwPY5EWNbvFHVmZGs2D8p5ETvhuMIrAIWdx-cNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhz8Ejx8ZudeH3k_exb0UBnZhCgzuasilMVnfjz7RULw&oe=6A64C304"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maa3uYnabYUQ7kNvwENVJlc&_
.com&_nc_ss=7f20f&oh=00_Af_2uOdpEbD8Un4q6TMUpwG3WPpm2qjWV838QvkwzLEK2w&oe=6A2C14F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0SImSbqBlIQ7kNvwEcKAA3&_nc_oc=Ado9TMSH0fj0M02ECq1GTphE13TnCCKVE6iLe1Hw1y2izlr0gsXrSY82d4juAlLQnZE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1n6IkwJZMI7tIIDYvfOu7R8JGy803jTGsjJEvf0L5YQ&oe=6A2C2721"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOnwlRLjqOsQ7kNvwGa6jXy&_nc_oc=AdokKpoffAdm1eT9gCjpQ8-Xm8Ea5IPlr_HLJKdczWs0SistqRGPzfwPEfHB_LVg0II&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ilCBVG5UNjTMl6NGVi7zr7pFYVaVPlYDdWv75P28-Tw&oe=6A2C0E3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fA2h64gPB8Q7kNvwGvHpB_&_nc_oc=Adq0G8Bk8pLTAzgZAjgteGrymls72BZl50iZsr1UTcfHyCQV2TG1QjIiLNLMd9K0VmU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88gihTxkKf9ZTx9jhanb6ehQrDkpULlbmzWtWUpxFcZg&oe=6A2C0E05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsH-CXsZzpoQ7kNvwGhG0Aw&_nc_oc=Adr16POvYhmnPqzQR4jzzg5qvzoksApWwIFWC2ZCzyciQerX7GZKdU8uqUHJ6LFKpw0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81IxJADoQ1bH5apRywEUd4q0LEFIEXJrtOJXDbk6l6Uw&oe=6A2C3290"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNMqFZIXHbMQ7kNvwGglk5K&_nc_oc=AdoiG17C0y8-Z4fQQ13fCUDJQibB99DL0pTXjGLqUqFX_ndtwqES77MjsMr-YVlKH34&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9YJDBRS_U4fs7tXularquG4xMf9oVUv3V3spljgppTA&oe=6A2C1284"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVjN03LTwD8Q7kNvwFdAVX4&_
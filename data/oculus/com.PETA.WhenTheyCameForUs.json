.com&_nc_ss=7f20f&oh=00_AQCAA_bBjLuIZLCdbGZRtkTlUMcopTUK86hSgAE6C9G6ew&oe=6A5E2DF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIod3G4sqMYQ7kNvwHebcWO&_nc_oc=Adr7q--2V-3ikJg2SMd5r7glOeKpyW9YCFJaLthzz-Q5yxTQEQKBAK2O0_GJDUTSK8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1G7J9zQaV0G-DMXyy37yK7y7ELjIjaGt68OwzeD_XNA&oe=6A5E07E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ETzDsT8FHsQ7kNvwGT9DSk&_nc_oc=AdpuRvqBlyVEqTs-MplW_nb1hUg2lR21rG1FK4_dOhKQoAtT49qectFI5XmWDV-FKYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8idv2qxhiegEenJ4P1dPtlfrNFEzM4o11Ku23GJ9oYg&oe=6A5E273C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5hy5zxEP6oQ7kNvwGTIhVe&_nc_oc=AdqsmnkAaM3ezebawCykGEp_GGe-2dy9AoFf0cFovNR6WKrRjn0IxNduSfh6-fuznyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzwpvBb790K-W3MuMp8v5olrv8vEeABVrRJu-w-Sf5XQ&oe=6A5E2705"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8he6cWQnMegQ7kNvwGZ3VYn&_nc_oc=AdqK5_cfHcLsSU-o03p5O5SmQdDWcbVLvNDMTNmG8Hv-UQR0ct6SjwTNb96WkwixyHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjGUMsNyvFcotDD2TjCC4ADi-wvrw8YKw-DkUcmuE7uQ&oe=6A5E1350"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7fTTwc3E0YQ7kNvwGhG1Vk&_nc_oc=AdoDe5bUaXomacivg-W4alDZT1dHFCnWKSAj_iXhZ9OXWEYKQ5_G58eRvgp8oFJ1oK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzt7oKLN1Mxdf33n0BgDuFyHUvH1iI66CKc36MDkEpzQ&oe=6A5E2B84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2El9Cd3I0XMQ7kNvwGO7RQ-&_
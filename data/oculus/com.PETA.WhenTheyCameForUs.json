.com&_nc_ss=7f20f&oh=00_Af0w3z68kCEdQ5eHLfa1nSO_JVtxsbA4Cy19QG1w98MJwg&oe=69F758F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TOIefq4m3EQ7kNvwGHRPnH&_nc_oc=AdrzJ8D4taZWQmzUH77ZXdxigEQ9luEyzYjd_Vf6DOqdHj6OB_RXABOjH5Evx_84C-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_480Qlbp5co_H2TNNLqReX3G6iVLeba9_L3_CAexsFg&oe=69F76B21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4GIryVh7RcQ7kNvwFcMHs-&_nc_oc=AdogifzHpmuP1moHewt2BH7SETLXBOcx2fZibPumFQoVjnBD4wg4pAYvo395SreNjNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TPkF092Bcc5-iM74nyKZkOaguKEjlr7ArVcF4H91U3w&oe=69F7523C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kde7CE3apVQQ7kNvwENEFOd&_nc_oc=Adp1tfz79nPPKQk0xvxnK5W8jLmMpVysQr2m1pe2gVBGoTTuzqhD0fOD0UIVP4E-UZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vDjeRMnDqwW1x_8SYZcS2_AmB_-j-oNfuyYO7QOwrIA&oe=69F75205"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-uAgncvON8Q7kNvwGP7hie&_nc_oc=AdoPqwwaj8e6m9X1jU6AKu7afAGPA8DU9Ed9YKy0rtDS1l_96JulqeXDa1PHspfCicw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mgL1uiZT-O3oso8DAJjX7pQ1UR4moVIt7dPoamp7Zcg&oe=69F73E50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0hRVAliDsUQ7kNvwHo_0XK&_nc_oc=AdqmCzohcKS8YsCc6KMD30DqmN32qax9A3R3Qm4TLGF8dblaxoVxIfRCkN2CggpW-Fk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lM8bbUZSqsfmYHRob49_yaSu4MJkIJyrvdfkC7W1dtw&oe=69F75684"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL1_nuCTJPQQ7kNvwFhlwY5&_
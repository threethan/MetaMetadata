101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_1u3KCO-hUQ7kNvwEAQyo4&_nc_oc=Ado5Fpnjx6bdGMvrGOITwmFf882QW32eF1f6RZ1ecxG5xi54klTa88tittQ7arv6LdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwtN4g890gb7iSN-bz1lVYAcOaHul1Ye789Y28iyuJ-A&oe=6B05D4B8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHAcGBuRtQYQ7kNvwGmmSWB&_nc_oc=AdqVyQxUFxRoXdvxXo6HzmJivs60fOVWUvIhq33hE-rGPxM5PaCtugGCkFiD_89ULmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSgjNH4EuQIXRXwrQY6UCPXp2D4XZsG3Uqo3R8Zt1uuw&oe=6B05AEA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL_2IR5JhWYQ7kNvwESE8gQ&_nc_oc=Adrl26_aeHLP0_kgv4-pvIQaeITnbbJ3d2XLQtUcQIYkw0P29hp0oym4QlD8edpT4p4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJw_4MzruYEKTIdM9hhFZe3OGpugb8MQaJUCp7ApKHPg&oe=6B05CDFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ10yRYAe-EQ7kNvwG74VSo&_nc_oc=AdqTx9pqJoi5mPuRdEyVIL66BSKDnK5fgApna1TF2Vq9LUWhG_XDQ5H5opTAtIn7OfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfpGd_3wiHYGn9QC7JhXogdI7KOO5W2yrPt5HkABZWsA&oe=6B05CDC5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z03Bct2FEQ8Q7kNvwE49fJY&_nc_oc=Ado_NOONlZmN7QwEXNxisOTDDbkyaePbQM1aLT5QmYRI0LvX8AQMGI4n3o_iJ9Aggtw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu_yxOrPWpYdA_dr-vyz3nJwMRfDWgv_zGrfIexRItvw&oe=6B05BA10"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QisOW0awHKMQ7kNvwFtiGy8&_nc_oc=AdqwpltgjZC6inS_boXwqEoGUXphPn1b2bgnio0jCSY_-UTZSYPfPdPPwhJ0pXkdJwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh
.com&_nc_ss=7f20f&oh=00_AQDl8tKNUpoZsJW40ROrgHZmJJ8aPqkfRJoUIe2s4Ou7eg&oe=6A6F5178"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adRTi0sVlrEQ7kNvwGyu--L&_nc_oc=AdqDVtcauo1_Jb1RIdVXOQQslAK8LCdKOdAQr18HBJ5D3GBFO59Jnb6ZwjK2589WJcc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzgGIXmdHxpqyUAIFg8CJdapGQTy6C5yt1XKraZvbxVQ&oe=6A6F2B61"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP8ePuz3c5AQ7kNvwFWX3op&_nc_oc=AdpXrLp_i-quyrrCqfz8Wsh6SzXMa45GKILg5qeBAMipUyMC6I2qJ5NXgZlSkS9yz4E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYsjQ7I5gDT1oN8e1RIdSmfa2Qfri9qjFTS30_UsE6jQ&oe=6A6F4ABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-kNC8jevyAQ7kNvwFFVh8m&_nc_oc=Adq2FPybXYY-1ctfO3G_7OQiJlMOVwxadBkkjPlY4A1BdyLBm6xKzGPMcT2UdlrdOVg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWU_s8taLx3hPqkPD47Czi81cLGpi44uVjxdIMfBdyfA&oe=6A6F4A85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swOsOe4BWkcQ7kNvwESZ2z9&_nc_oc=AdolpsHQyUJdmE7ddcMJscj60r9RHbM3qVRXn9sz5UFhsw5QJkGNkufpk-LwhoaN5ss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo0ycLV85z4hYSlwv5qu0k5BgaVFJXe_oVzzaHCEYnQw&oe=6A6F36D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f90TQLEg20Q7kNvwEdsDSY&_nc_oc=AdqsnXZ2MnzSlf31HiYJNuAaQ47nKE9SPYMsuq6SGFaKnkGiB7hQzPVmOIZ08FmHdmI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2e8GOOg71Fuggo7J-k2BBCndm3BgIO9MSL-hAttKvIg&oe=6A6F4F04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd4qaMNKlrkQ7kNvwHbAnln&_
.com&_nc_ss=7f20f&oh=00_Af4E72eZTB-88pttEklhirJHXL0bpIp2tY1PRiMSKzIAvQ&oe=6A01E4F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb9-f_gL5TUQ7kNvwHScBN0&_nc_oc=AdqLRAl8L9vb85W5H8YnPtbKri_XAV9INlQSBcfPHi28AtJrORcRvpeAin6Xm6k_SiE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fS1zKdYhPJ4FQ2bS-MmAHsOzn6YA_MUfjdLPTMydOLQ&oe=6A01F721"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGisReXdOPoQ7kNvwESjNo0&_nc_oc=AdqG6fc7k7sOfkrvN7aMWqAXwDkrmgPg3YAAo_ykEyWXWex5GuCelKLWg0s2NqD84KM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40N6IRXPXw4kYtxecoXM_SjNgMWyfARNo4WRiN9cON4Q&oe=6A01DE3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxpwdA19cb4Q7kNvwE9c9Lg&_nc_oc=Adp7u39CxHK3_8lr_klEGmnQMxFu9TdSAtYDcF8V4OwXtbxSWAFE1oKI6FSyJLHz5S4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_isDgPs1YqW3GvuHRuVj7OmmHqhyAUNZgrr3TwmHIow&oe=6A01DE05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THinjzlQnRwQ7kNvwHgoS7t&_nc_oc=AdpTIeZdjjdTbuLRhN_gYcUGfMwXLPfmSreEqAghfizRIonLcgKY_wfEGSOSZm9PRww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YeQuofE33QA8OfCnGBKgZbOceq1OSt3SOIefnPn8aXw&oe=6A01CA50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XL0egKbUBQQ7kNvwG3sHlG&_nc_oc=AdpfVh_ZzTzCYcNvdyYvoecJ_uZyEPH910eZHExzj945R-GOlcIYEjUvHNFVOXcssrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5McOx18zrRonT76R4jsSzQ-uq6mUpucR6ZqEj2-7OMSA&oe=6A01E284"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CecMa91AdyQQ7kNvwEw_BT9&_
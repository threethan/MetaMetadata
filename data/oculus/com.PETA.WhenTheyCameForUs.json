.com&_nc_ss=7f20f&oh=00_AQPsGd6tk32ni3q7r9Dc9SYecpy1fDCvEFErY364QdKZmA&oe=6AC502F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7_ujwcaLUQ7kNvwHDN6Uc&_nc_oc=AdrtKTdisp5FtJP7lGhJ-sHfjpspYeQ09wcSGUjJKm92kamNZ72flK_PFYtBS9Mqe30&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFHR0bsGFKSFxFABgqkSsvGm5RLvOTjYU8tfPif5b8Ew&oe=6AC51521"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvRqJgUGvBoQ7kNvwGsx1hY&_nc_oc=AdpQLPdgaorS5_lBN-43z65aAtmfFZuScQc-f5uD058XP854XR3ZnDDvLGNWALGzTy4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxYO-IFSSHmzpMDxWiLc-LOs2ETMRpRM58wg6kXQeJFA&oe=6AC4FC3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QyzgYjwt7kQ7kNvwFxIFk6&_nc_oc=Adocsy2qKzh_G_em-ekdNx39ruZD_IjKkmck-73Y62p-XagqrO7BiHsBvoq1VwhCuOA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeGu004bUcnRvLYkFfYnvYoH8w4nCDNBYMgshwK0BkKA&oe=6AC4FC05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoV02CoNHGMQ7kNvwG_heUC&_nc_oc=AdrenzPHuZ-h68R2ok7knKIPE2GmQY6gQuaIgobEs9x2GeTYjrak2hn_zvfRLyeuBaw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ0kK0dSf6wzYZdsk4IyVy9bynl3RTCXY-qy4HIG__mA&oe=6AC52090"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3OBQt3lxTsQ7kNvwFe9YFE&_nc_oc=AdqP4ieyjx1aNIwgwKrY1PreJDqXke9B38NfYg9LD63u5RZYenvLajJKororwqPCdnk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLooTqep1tEQdwn39fVaglmnhS7_UWnBdIr3Z2q31dag&oe=6AC50084"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2kAmpNQ91gQ7kNvwGVn9P2&_
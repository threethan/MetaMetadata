.com&_nc_ss=7f20f&oh=00_Af9XqKy3_ghav0Hy7lG4OZRwXLAfGOcNkGufM_x9z0opZg&oe=6A33FDF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbrQqDxm8f0Q7kNvwEC-RSc&_nc_oc=Ado_YdLuAjfJhnZgh3xrPjfINuUK8SYzYz7XghMeQe2yWPMb6hCgUzlyKcPsLBm-WlI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YthhDvtcIQDzZMV5WLOrkWWUS4v3s2NXBwqpvBEh3FQ&oe=6A341021"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB8gOm5D5PgQ7kNvwEXEUyr&_nc_oc=Adogd3kn5D3AX_nv99W4L4vSOvJrxgTLXI0LgLRUE7Jh5z96JxeJz_hRgJrxxsUt3aw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s9vqXJCnoFCPHXqZHj9QZPIHoapkBIvs0EZLeUA2UIA&oe=6A33F73C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL12aHO4d9IQ7kNvwEZ4RTb&_nc_oc=Adpfy7hIojBjyqkeuqrVMoPt7tNQLtQMrbUzurX64lKyJH9ry_apn4HvmiLo76dahIk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j1bUEdyM2Hj2duRC9XuiIZAoyi_Vdnb1VI72CFRJF8g&oe=6A33F705"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFdTrMdGv7kQ7kNvwH4RIy8&_nc_oc=AdqW0y8fffAuhKSaw-01DbGpvFe0oTgdedJrPVDlQHfjBP5ZjDMN6Ym52io3M8auAOQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yFMd-MTVXoCK0kKmddOmeME93mGtgoJLoO_T-1zhC1Q&oe=6A341B90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhRrg8lmVsMQ7kNvwHTfzgE&_nc_oc=AdojzAMdtnZJBorBiVOXp4bXMhv0dFLFiDs6rsknqL1T1syOwhmsF2mPu_wKxFCggpU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s5z9FX3FPVlY-5rE4t4lm8S3rCIZdzsBcCxT652R7qQ&oe=6A33FB84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blMC384-Y68Q7kNvwFUwfu5&_
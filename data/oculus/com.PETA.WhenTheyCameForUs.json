.com&_nc_ss=7f20f&oh=00_AQLxLbdp6rp288-NwxSuXNnHJ4PK8HmCzDxsw9FhSoxCyA&oe=6AA16A78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R16CiJTFduoQ7kNvwEw2mbe&_nc_oc=AdrvxXhwY5vFvPy-jjVxYL2YPFfG69mB6UbAHWLKCee3S-_5OZh4w5dteURa1JNDpgo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBi8ETrbsFUXE47fwMmwLVwkEw0IrRHhXnXgyBERLsag&oe=6AA17CA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfQ3ZzM8iL0Q7kNvwFKTJuz&_nc_oc=AdqwX2Asi9X_4hQATIlfMRRjngvE8tNR2hbZTpPmcAeAPjBv81C1DJ_phNQUfISP7MQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMnfxU-ob_HKE6zGEwkXreKGukkUJ8V5lfxXSshaBmTg&oe=6AA163BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggwV_uht8YEQ7kNvwGzKrBh&_nc_oc=Adqo_7D1eO1fuZhEfjQfJk_RiwtmfavIbmaR3L1wtA8SjDaKR9DyqZJifLIWumnduxc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCoFr6SIKASdyYmnamoP9rE_DA1h7Fd7503ucAwCEsrg&oe=6AA16385"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izw8u8TfB3sQ7kNvwEz41I5&_nc_oc=Adq99R_iiZLEJmP4B8C9Ns2PJssUHbjRTv3VQHNv_VyL4Gapoya3HaKx26oHrJd3m6U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK_dmH6qYHlnizqYZzBc51SKEGtoi0WpCcFsYrjvkBLQ&oe=6AA14FD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzBnNF6XyXkQ7kNvwELsHFe&_nc_oc=Adrk6Bnq_Y479omVQ1qhxClEun5ajb6vaBIrnKoGwVivoKPiC9RKUMVLPca06aj_sZA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINVZIwp4gLR9dEpUa7J9OY2e8LhFOcUIs-lSgOdatoUQ&oe=6AA16804"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL5SSsMTt_AQ7kNvwGvNbZo&_
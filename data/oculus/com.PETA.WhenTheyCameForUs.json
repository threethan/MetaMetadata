.com&_nc_ss=7f20f&oh=00_AQGlZujnDF8tkPBUt4r4b_7AESnJMG_YSLCTcKVZtaYTDg&oe=6A940338"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EroFGuMybBYQ7kNvwFUaIWE&_nc_oc=AdoFvpmYDqLTLW1dQLwZx2x-RzivunpF75PORBV-XIzGUM3MCnUSD-LdKshgoMvHmIg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH30jclldiBa7awcVppBlP9Q-kesD1jsHTchRXkuFmzLQ&oe=6A941561"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5kuYCPaC7cQ7kNvwHjVzL9&_nc_oc=Adq2KiAPQuFTJ9hcz_ieIztyWK2tLFOeD1ySEghc7JW9uoDyCuRtdZ5neHx4vxlkN3U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnVcme1PbS0zVW7lIdxX95qx4GJEEb4G8kOwl57eSMlA&oe=6A93FC7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OlUsL4QfXMQ7kNvwHKH3Cq&_nc_oc=Adq3TudT13OQc320E7Km7aXR69agfl72sQ1hAnJyBHznPwzBHCOgPdvg8kPrbJ7RRh0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1QVei5dWOhuPyAfKPrHdgNBCj3W9E6rRHr_D8Hea1Gg&oe=6A93FC45"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u267l2_zn68Q7kNvwGRD8VO&_nc_oc=AdqqNEZaNvYTZMpNOXMfzpFjGQQ1lwP1LY0hl6TqMUe4TAXSCgKKfq2xiLQv-dpDqDA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExRpwkPY3SH3YLivUqesRAwqtxwB_gebvFJphqYssREA&oe=6A9420D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaxkDHeKHe4Q7kNvwF0GqYY&_nc_oc=AdrsFMc2lUs6Kfg4WF5XjEv0AMRVwF2v2Ik-aNgSiFPUBjHgspq38i0tAjHuZlUj4S8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZgjPTNIwYf3JfioSudmkO9S_GMubs6uPixtQiUd8JZQ&oe=6A9400C4"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3s8_zlywMEQ7kNvwH0zVpE&_
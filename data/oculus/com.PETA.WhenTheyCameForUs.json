.com&_nc_ss=7f20f&oh=00_Af5_oc_fw8bpw7vHj6-TTpsB5jth21ZO7DB9NNHsfGSxsg&oe=69F9FBF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDBzkjg3qnwQ7kNvwE9cyMb&_nc_oc=AdrX9ditez2RUbyER5AgD4CKUDbe2a49alNCrz0oTttFxqh8xkBxU0dPI10jKg5i-dg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4svHtsikozS2Mg2IzlgrovZhwrYgpei-mpGEfUdndyIA&oe=69FA0E21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcbw3Y4yhbIQ7kNvwEwsKc-&_nc_oc=Ado1m077faxp6R0BPQriGu5IDrAvzFIaasA9jP2AlWSavNCcULer-fbgFqDnHmML1-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73fDGkZRlY8Pr5ZEEnWs5Jb2yMSLQ6x5x2gALeygV-kA&oe=69F9F53C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsTqmQV-DrcQ7kNvwGJTZxs&_nc_oc=AdqLTxggFFZiI3kOkaF63KGq6zCVra9_Q6SdW-802pIikJ4qEtT2T1dDBORN_CydUjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pBMULdEIyoUAD3YZBoT16PZP7N1NoQKTzvvuVj_9oKQ&oe=69F9F505"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-uAgncvON8Q7kNvwE0_DP2&_nc_oc=AdqBM5y8QmIbY5Pcv4rPCqzMQbpOt9vkTGuihnGVOp7qLOaDVWRrwrwkMaTRyxj-5NA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p79F5jYf2D-SpHGHbfSk6Y0yVMIyF3_TZLTURVyPTAg&oe=69F9E150"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0hRVAliDsUQ7kNvwG0qM3z&_nc_oc=AdpawW9BjnEsom9qSYB2M0NF9HnHEt6g7HhIZI9NIAfqtO6P1mZCdZOiQPLP6HIwqeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pIekgYDfXX8zBCYFrSKWIwbGQCCwfTGxX4eFhXH9jCw&oe=69F9F984"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCSZ4qHelIsQ7kNvwFAJxoJ&_
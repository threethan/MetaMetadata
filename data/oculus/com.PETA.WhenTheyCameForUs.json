.com&_nc_ss=7f20f&oh=00_AQE4HCK0KLi3DLyXl0HyJ3GniDhto-1oeRbxNk_KTVTTvA&oe=6A8AC8B8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j60wqCKIGxsQ7kNvwHpqyA9&_nc_oc=Adpa97uQ3XBR5EAUdE4AVNIoiyRx68JxTJzTCWp8c4tVOzR5mjAQUxIa6G3D5Nruiaw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuct3t62fUN9EA5DgTGdGQyKO6OAgctcKPu3ILBW4tyQ&oe=6A8ADAE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCCf_Th1qIAQ7kNvwFJHw1w&_nc_oc=AdoBapmCJsDAjUGOiOWTblD1nW-urGXr_vEp4Zt3nI_NtIv-dMUNRDuh1HHea8qZP6E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG98rvSHEh3jn0qf6qZrLMKcR1YPnYaCc5QPL2EiB9sDA&oe=6A8AC1FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7H39YaYARUQ7kNvwEl6BaI&_nc_oc=Adpp0h3piOmhYkw0r5ecifiPJ8rA3xtgQEZ6ePT6mRy4kB5AFiHJbHabiPviGPBk6MU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHPzHtzAKwTEPJ54eZhjMvwDOfnLymX8tNeJqj6ysAsg&oe=6A8AC1C5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7F_pvgbgPwQ7kNvwGE1V2K&_nc_oc=AdrhqYOH6ce93wAjlopivGWw8FyLCezINwCVQujocZV0wGCMR5-wqbi8k490F0L9-Ls&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLhgJwrTKlv9IdBeS4BhRwuaSC4bYoPFgmDpnZDoU4jg&oe=6A8AE650"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ptO0aL9m2QQ7kNvwHhS2pv&_nc_oc=AdqW8k56a4VD4nvmggbO_DFD7bxuQAVG-Go72nZXDJ3oYpcBht7qGHzfjYtM1d8mK-A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp00g2SBOALPqQ0l800Kw1atx8m7tG316kMlSnC-ytXA&oe=6A8AC644"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aH8g21u11p4Q7kNvwFfcw9Z&_
.com&_nc_ss=7f20f&oh=00_AQFn7QnvfAL2hAG9E3BvfLNBW0I5aGSxjfphWAQLAUcMSQ&oe=6A900EB8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpWiGQVWedQQ7kNvwFFgzl3&_nc_oc=AdoQIlP7Ow5gv7xX09oPKB8fYIVMAf0TQ25T6t8ur66e-mSLC5RWVMeQJ7lBjYRblzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2_XTXjaEXje_X3Rr4CHysq9bII969dzarbTP938ya2A&oe=6A9020E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmFIJg7_QLgQ7kNvwHmi2Xe&_nc_oc=AdoCgj8Vk14tvxD05Z5BjiM5IE5SPquiTu6SUq57ahzb_DQoKgTrSvRe-HorrKz_gjg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhyHogZnqwp8OTJGotFri9xe0sd3ksQ0LazJEV8yRPGw&oe=6A9007FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX_Unn2c75MQ7kNvwGjC1oW&_nc_oc=Adq4rgSG2si9U9Li3n89PLzLSkBva4C9thAYLobh5Emn7-sPaJF-zn927fW3maYj56g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZKfFy67-9u49UJyQL0dOhgJwpnK8qujQJC8CgKVspKw&oe=6A9007C5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4-IUp8zYu8Q7kNvwG1haZK&_nc_oc=AdpyKE9MII00op5cTDx6ywRG_hd8u0mVJzcdkAzcu7MfQtvJ7pOCmv6jmpSiHffTFbA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElgd2HnVwLsvlJC9FMKvzR_eIwN4-RV2INQGlLuAZAKw&oe=6A902C50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TSEDwSa8IQQ7kNvwFMWjxe&_nc_oc=Adomph8utFNZzEXWSlLDUnPcukG5cOBRNoHA2jhymJwuecsfQFQrjLAaLU706DtStAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGlpDQxJIPXuIP5YNx58r-jVTnO5BjfPAl35_9yv7kbw&oe=6A900C44"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXsDiHPG5PIQ7kNvwHmljfP&_
.com&_nc_ss=7f20f&oh=00_AQLLo2rt-sd9PTFhSn1NnRPliHKPze2lF1497meo91D6sg&oe=6AB68278"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOsOg8LEzK4Q7kNvwEwmDw3&_nc_oc=AdofKgtJY6xHM2DcslsTtZigm1IUZs55cDjLBc3SFuhtw0dftmR-4TnIf9DAIuT-x2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX_SAK0HBuDeZQqjc4n1lfL9t55UmzQGfayRARuWdbSw&oe=6AB694A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGKSIWwYi0cQ7kNvwGkqs6h&_nc_oc=Adrfx8o3ItNqisn5I7DPkDrcB2-5ZHdDGVaBH0xPvb3pGAEMCH9OT3yZEdosb793l4M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjSF6evTBvXnxdHdqxNmqUnjS8T92fys-Wfr-enqfgPg&oe=6AB67BBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IoN-xZ6fOEQ7kNvwGHRST3&_nc_oc=AdokRVLVpepCJoy3iszqPVgOomuvLf36HrkxKiBFQO8qF9kZvbSwIYaM-u0Z8cwg8QM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJW_zUtt80DVZnBAOpP1sJtX35azwSx4dSdLDiseGdeg&oe=6AB67B85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BODRfbEG6g4Q7kNvwH81cQV&_nc_oc=AdrYSuB7LzckcDXSaKUk5brzrMgpqNR52lz_8aGjuVsPZ4ViOur4yRcYwK3OZrVtGLE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-6XylN1rRVrWBClWgzW_TOYOR0yjX-ySYXnVAVa14_Q&oe=6AB6A010"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWOM47EkhjAQ7kNvwGhKT_F&_nc_oc=AdqFrWAjesnn0Upc2KjQDzIn6zv0Dy1DhbsLZEG5riU2VMlTekG-sxgwok7RdXlDssc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH4PEZzUVAG3oHn6nzQhCwCh1DyYVQh-D1zIghwuZVNw&oe=6AB68004"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQYmdHh7JPwQ7kNvwFMahMp&_
.com&_nc_ss=7f20f&oh=00_AQGu129Yr4l5RJ7zAkStqQl2kkOhDmXn1X_Fw_Un1tUfbQ&oe=6A86D438"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WqPjmqj3zQQ7kNvwEZ2azN&_nc_oc=AdpcFG6KXjFpz8-8sHJeohzc8caVSkZiF-NAZOIoISDWCNJLtY9eiXYyLTm0ofmk8IE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQE5A6Tf2zVjugKkryrcm7Ynervf3Lq-6ChMTpN7hD3A&oe=6A86E661"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HuzfTFYBTwQ7kNvwHsX-4H&_nc_oc=AdrRTy98Jhd7wdSGEvK8PTYRYffXD8L2FxGna-X5r04iDVIBL-Cx3TOv4Urjq3x42uQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkhsJjWR80Rsra7wHCHFuQ20XsRKMqTdyivhne1v57eA&oe=6A86CD7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4L5oCBFbjiYQ7kNvwGUw5IQ&_nc_oc=AdrL8I59ujuQNDIjeGCxtZ06cyboo2Y0mIk0ZQnJJqx06_2G3pkhpWuFurAmkZrUwYQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF01QxKXcj49KMoj_BhlougaQLIAAZHWYY7fqkYIAvd3Q&oe=6A870585"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a5S2i445kwQ7kNvwH0mfDg&_nc_oc=Adon0pEgq4yXc3JUYPjVKGLG3nkvQ08Llm9a9tMvZ1gu95z5T_K2kDeAMlN_SGqc3X8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5iKxh9l1vJZDZTj8jq_5iZgBJmzuEg4eFYZV0wqaxcQ&oe=6A86F1D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXDQYhbM08MQ7kNvwHAmsrH&_nc_oc=AdpnPnU65991Iitb5LgMVkK_P1grcYb1z0-RtvpnqatnVxBiQPu82TrSfA8yEJe9XW8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkLBxmSj2LnGvA_YEgNjsYIiFu95XedBeQjtygTZBvDQ&oe=6A86D1C4"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0FTEaH9iK0Q7kNvwG1VSwT&_
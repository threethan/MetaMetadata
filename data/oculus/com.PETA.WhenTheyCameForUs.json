.com&_nc_ss=7f20f&oh=00_AQA3EPIPMyEpNWSMyxDgxkF98PKfMv6Qy0X4Hqu8pY9RaA&oe=6A6DFFF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiLblq810EEQ7kNvwGYcl8o&_nc_oc=AdrAspj0Wm64voIx4PB9vM4yVjYMFZBbH13_bRumDm506XQ8ajjMaZ4LfPABKJZgTMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdD6eWMbK_ldl-0k5TNNjBhB3jVg6xdfkxpiNYLagQGQ&oe=6A6DD9E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP8ePuz3c5AQ7kNvwHNAcFh&_nc_oc=Adr8eO4-l7-hfT6W6FI_2pm91voZVXlRFTo08MJMLMBobWpjOfUAcSuohL_vdVadDuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBx_DyjSDFOigtf3uDMynYmt3Fbz45m_EkGRTSgEeWiw&oe=6A6DF93C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZPdu9qOxK0Q7kNvwGqV-GN&_nc_oc=Adq_qdStfmyyLLg6NNn_Re9aWs6DHYLrGabv0LRzGNzA0bWbS0E3RHs5C01AGc5knXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkQKCE2SDOIehs-aKxfhaEDJzC1dUS60HNjgs9f3Wy0w&oe=6A6DF905"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swOsOe4BWkcQ7kNvwG_gEtX&_nc_oc=AdrnatNFN54DpRFTW2mF43NQB5cMBavFCBdL67ENX0LOGbkZw47OB1aUJepzGl4f-WE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxuGYk0tsZYfdCXCy6FK6EgFFf4Q1ug_xdvMSmv7T27A&oe=6A6DE550"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f90TQLEg20Q7kNvwHBNSAk&_nc_oc=AdpkZ1UntQz_hX-4M09NFutizeARhJj1Br7GC-zFoxmzt7SYqnXhJLNmi8QWlO_CamY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxTycvid8glRPk-KGynIjoRPs4fT5hwDmzwSM5dHt2Gg&oe=6A6DFD84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRHs9lz5TwQQ7kNvwGLlg6O&_
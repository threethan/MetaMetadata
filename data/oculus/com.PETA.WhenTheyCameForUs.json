.com&_nc_ss=7f20f&oh=00_Af9osJ1DV2zTandtEsP34wrELwAQgPJPrp4nuhvDoWWQJQ&oe=6A315AF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIRo3FWQM5YQ7kNvwE85Y4n&_nc_oc=AdoQPhohBrmhX2ZsWGKteuVpHb03v42D_F91uL4O5c0Z1lUJtF6tL8etIs3sajpNPbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zeylet-YTeA68Z1J-VM1YVyc4-wtf2ZE5IXePotS3yQ&oe=6A316D21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB8gOm5D5PgQ7kNvwFiSutg&_nc_oc=AdpAJvwr_wEAAl3dQqc3x6NPjzCneacYuiSZV7M2ztRKpdwg3Tp4tFaUSWmSdQqgEFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RhQgxHnl2uEve4C-DGtTRS8gOrJJs2zV3qioRqByaCg&oe=6A31543C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw0jnKyDnwsQ7kNvwFqjHMN&_nc_oc=AdrZyZrauezhFKNcAjQqS0bOR9Z_3hOU7_3-WzNhSFZNEi45DY8BcRj43CDIadhbf3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zbawOmKwO1UM5dVn-v3swFpuY1VvStF7Q5JN2bcu43A&oe=6A315405"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAJ6XXgSYrkQ7kNvwGCezBI&_nc_oc=Adqmdo1ZhXUZybQcR7GLhqrXArliLVP6SMeBkQdkYqsd11d7cWee5pYp0ZUBmAwQLSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LfCtAPOxbJepzTwDMWP9Tmpp-OKxSwiEHcQtr05CWGw&oe=6A317890"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW6FUI54zBgQ7kNvwGGadAn&_nc_oc=AdqSfYTojmVM5DVepc5LiyBCRx4VkveYvgG8WrmBFUxLOs294DZS-cMKg_j3g3lDqXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_07MmJwbZ6BEsLuspgE9txs_C_TgXw_8-pPjH-JlzhHA&oe=6A315884"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPo4U92mTZMQ7kNvwFZpbvd&_
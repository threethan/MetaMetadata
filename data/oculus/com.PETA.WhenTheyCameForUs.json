.com&_nc_ss=7f20f&oh=00_AQD-nyLdaSQjwevzasSQmpGuWy1uuw-My6GgGUWhJzEZ2A&oe=6A6B5CF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiLblq810EEQ7kNvwECdNyi&_nc_oc=Adohno_CE4gmMtVAHeIgaNOoFK9bSPc7s1x90WlNdyXx9vyIMgRSL1fq3Z_e-zwMlnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI2ZxziYKgNE0OXidXRVp2dzRT1HWJLsX6wWW8Ych-uA&oe=6A6B6F21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENTST3hqig4Q7kNvwE_Zb8W&_nc_oc=AdodfqOUN28zenpzM0WFhjxTkobuiSdekUSoxT8kJFJT8QqFTi5mNuegkqoGTJPdXYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvghIOj-PwWiZsLObysdtxTMyefMpFXMyjGUZTSH1rAA&oe=6A6B563C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZPdu9qOxK0Q7kNvwG6jRBR&_nc_oc=Adq3emfXS0xQrAROvVPWWFXruNy79LacN-TFTTxz6-2fTGC6edvbcyyvb1PyWDl0qUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ3CEPDXNtBNcHNOiwOPQ3UCHByga2kE8s-pw_cn6H8Q&oe=6A6B5605"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qJzzE55AaoQ7kNvwH-xgS9&_nc_oc=Adq6s6Am5DeicBtzYntm2BJywypxyId5l0-yNuDCBIg2mB0XbTTNwlwlBdkQDh-jJ1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB69txhhsxXWEmkyuR9KEYcTd28zuNJIaer29LZv2IuYg&oe=6A6B4250"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4b1yMNomAkQ7kNvwG1rCs5&_nc_oc=AdqpJsESWyyLCJCx07HPXjVsUftiD0VjfMIn6IIUAj0LvmN2tWb36l1KOPB0X9TVHFI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3cpHvsi1QK9bM2d_O6hpFNsWgdgmHzHwUDerdo2ACrQ&oe=6A6B5A84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRHs9lz5TwQQ7kNvwHeXGhv&_
.com&_nc_ss=7f20f&oh=00_AQKQiXAqtUb9ubi9MIATg0YweLMRiT1nFiWdxThaAlKJgw&oe=6AA6B078"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msepEKl3ZT0Q7kNvwGCCzlE&_nc_oc=Adrm1ZmJpz3-vwPw6ZQmbkYow82nez1Dn_iSTx_8_CysBFDIhzCXrnEsGCZHe21h5TU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpO2ZG_YUF7Kb4k4Y41HhM6gUx433sgxtTs3j-q7c2CQ&oe=6AA6C2A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooMM0JAKcj8Q7kNvwEp2CnB&_nc_oc=Adqp8U1WeEiYmcvd3HgEMpHHGj9BO0s1CoxdMsXrM8k9Eorje6NhKxUDNd6XgQw7GKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyFNwP8lAUjF4JwiPKrmCkdgNeUO6zbOYR_96adJSwxQ&oe=6AA6A9BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWR-yGq3hfAQ7kNvwFzu0by&_nc_oc=AdoM8Bi4hRRrY0-qB7HvIeDY6zj9LaJX_mLHds6p1oe1IVclUWT7ZSrUdmDzbrTPMbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxNOx18FxoEjf8ohGC9zy8h7xJoiyrrQ1H4yn8ukK9dQ&oe=6AA6A985"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xylz_TYVwXsQ7kNvwF91rf7&_nc_oc=AdrBNxfTAn9shB8GAVz8tb4gYsHVOTiJfnJ3R1GatuRljhUEhWoJCxH8PchYSnDAeEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKQdoLztIMO6FpHgKb6Il2Kd1o8-kLQrrWpgDf9M77RQ&oe=6AA695D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRWvZl2otHcQ7kNvwGwoWgj&_nc_oc=Adqm2EImTGlzDmoHxOTqZfmO_gsaDrXZTZZKLUKvdTQ0tEOCbkC7lQhLd8AzN-z7u7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc7xE5mHqPykfEJd9AQY6V4G0KWb_Rc22MKotWHXXieg&oe=6AA6AE04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ju3fBgO1uAQ7kNvwHFABPS&_
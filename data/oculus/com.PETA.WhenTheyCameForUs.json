.com&_nc_ss=7f20f&oh=00_AQAcbhHD8r5s7BrJCGhEqqOA50F5IZVq76cZF1GmDL5xqQ&oe=6A60D0F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7xlAxjNE1UQ7kNvwEDFwvi&_nc_oc=AdojN9wgoOW3VgrN-WY9e9tycnhjeWJYPMDmZPxcKGxEXR_bz5rhF2E23Ie8rY0OkbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkSSTo6SZiunFoiWqfGexczMEkgtvwaxyx2qGrbiWiIg&oe=6A60AAE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGybsusyonAQ7kNvwG3hPhn&_nc_oc=Adqx_JVnK7oc6qnUdaTvtmozmDK_jccYgC8IHs8lABth87pS3u9lQqvGXYK-FBTRC_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHxk7nhhf0UrGVd9Jk6SkTezMdmVgelRXxZlfpqvT8GQ&oe=6A60CA3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-zTcrV9t3UQ7kNvwFwAJ9r&_nc_oc=AdpSEdS9FB-Nfgm0kzwnCZz_ncTIiHeLdnNH3y0ofnkew72mO7LJEtw_QlzpizC3FHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1FV5BrihVJUAQt4NpuSxzjS7CF91z5Xq4Z0Ebs8-anQ&oe=6A60CA05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8he6cWQnMegQ7kNvwHjyqhv&_nc_oc=Adreu6Ayxsr5P5WuTagtlsaQg1jDgr8IhzqWkZ_gwUn16uOeeDyAiT38lCpOrCr1TBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAuqGMSFrlB3fXLDxtMqnLOZHzoT6xVVGFLtbc8rWn5Q&oe=6A60B650"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7fTTwc3E0YQ7kNvwFsrUqq&_nc_oc=Adq9uz0pFJfz8RbkFMtrcXcPj_21uYB3uiXsf5FCFUcKn9tlXAhDm62rpHQXylwgDQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmbLx0L8jpHliKi7u6zYQlvSgghTn-4hU3QbCeS4nv2Q&oe=6A60CE84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndVf22Z1xmQQ7kNvwFSXkvG&_
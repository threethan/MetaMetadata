.com&_nc_ss=7f20f&oh=00_AQB6YmS-CsXDyt5324GGUqzNaMOUtuiwV_1PZyEQ1qaeHA&oe=6A53A1F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6EB4XLwD9wQ7kNvwEzFQOo&_nc_oc=AdrLxKrIPAe9WDPn4wwn8tPc1p3kwZga82mc2ZxweaPpxmqMMVYPYBJap0rhjpwKT7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxTixf_ToqEHXuJHy2QkrCX1rW88V96c5lvwTJl0shxQ&oe=6A537BE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FQIlYCtygQQ7kNvwG2dWXq&_nc_oc=AdpU7UdLCjfGc_ZY4SxVJBtRxsPtw3cQqnXISpdbXYnvkk8VOEf8Ij5V94VYrjuPTms&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3yko4O08KgHCNMU0M1z3dLPB6qimuZPw5VuRa8Ni4Vg&oe=6A539B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sx-SA3oCLwQ7kNvwFY8DT4&_nc_oc=AdqCH_dVDbJwQxagSyxbHjEMb1gb3-W262Qrwf5U-OG6AehzqkBjecAztyedtw7ewes&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkf14WF-xFPbuWwXnhNJXnRhdmsBY-198bb5jcRJ7Ibg&oe=6A539B05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARtLy2JcZqEQ7kNvwH3Tzys&_nc_oc=AdrswmMIu2tg090mkvIVoPxrI8wsH1ExIm1rF64ncJJJXl7vyJIY916QS-7xG2_W12w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJknink115tZHXe_JW6iYY-vpHSCET9lBkNyq0LpJN5A&oe=6A538750"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJ6R0VfkD3IQ7kNvwHlSDiE&_nc_oc=AdoV0AkLbUxfUqtzpKlUvYi6SGruT1jpOwCQyMAKYyuVHOdf49GW-p7nvyXcZ3pzta0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAYnQz_W0OOBJm62ZIHx1ElckXubJrEh4901JtHmsANA&oe=6A539F84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH-1WlOlxKEQ7kNvwERZJfd&_
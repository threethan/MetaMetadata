.com&_nc_ss=7f20f&oh=00_AQCST2zr7x0C7w_yxLlFqLGzkWDIcp1vkvJXlitr27Z3sw&oe=6A50FEF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_wXwTlN1nUQ7kNvwFdaAn1&_nc_oc=AdpP8GoqrbiZ18Ov5RzKET5bAA82dtDIhq71l0ymLvvVXzu7XRgEiGi3AuULp2zjPGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB0r3E4A7aPEJAHDGmlKB9UPVN2Sf-8NL9L5KHkWzFww&oe=6A511121"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FQIlYCtygQQ7kNvwGuxtRp&_nc_oc=Adp8HYpcmFpZdZRLmYDWsRMD5z7vslQgekfiHwmrXXzt_TBY1WLT123zw8mju4xd4FE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfYDAC46MIg9XoPpFMDnDOKYajyPVM5PCslsuCE9-vxA&oe=6A50F83C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_XKtcx9gYAQ7kNvwGpo0k2&_nc_oc=Adrd6TGEMkfytJTCOFWAWo0X0eww1RxInvSOW5GJYCFfzKo8xHssSGb8wcUmP_DWk2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZMNgdpYTDjtSqlTRM7xdqwhU7_EYJUnSqkDIvMkCrOw&oe=6A50F805"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaDSv-xtHfcQ7kNvwHoX6z6&_nc_oc=AdrBKUbmm3Ow6avNREUeHWesc_RI6uyljPOGN5J-x2WmbO4gEnR69oZDVMfSCog7pkA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDolUDVAlEHiygPNOczT-7wj5svq8LM8kK4CsQYRtMTXQ&oe=6A50E450"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ08aZwitYwQ7kNvwEXV0H0&_nc_oc=AdrkW-WdgQAYykGQ0MJDD7siJyQVBIRdabCu3rM-jENyWh47WeIpsw46hIiQ2CG5Sto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAruUJfLPWJqjyTEg8u9iVXIJcnnb4VoyHrogR_6MtZ7Q&oe=6A50FC84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUHvOjm8bHEQ7kNvwFUXc9c&_
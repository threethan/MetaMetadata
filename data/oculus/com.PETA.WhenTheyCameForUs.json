.com&_nc_ss=7f20f&oh=00_AQJfgAJ7UgaObFAKQd6ZoDf0G_IqGgQwQTXn-jgqgktMfQ&oe=6ABD19F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tArY89SqcQQ7kNvwHNg0pj&_nc_oc=AdpevkOJJXI-064AOQo0h5c7jvhgQOtnFx17eFmXyda1A2ALYx5EJ2MinENs28lj2f8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILHgpPq2k9Vy9rD5WM55cuGPmDjTeMUYUJMhlWg-rmGQ&oe=6ABD2C21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IbJR06TSbkQ7kNvwGecmho&_nc_oc=Adp86jkz3cT9Fn_r6XaZ10LJGi2u1iZ1LOjX2y15kbPa2irVeM5vsICxS-a0s_OFpuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB7Les78l-jL-DGOa5hZXUupP4gmKKOfPV_OVrjJmCIg&oe=6ABD133C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK4dcoACWLcQ7kNvwHQc7pF&_nc_oc=AdrfvwGgG9tDUFF-KEodRdfc33Li8qkCXKZi42juwOFGn0WluF2boBq-XfyWEBYIn6g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0lyHxivVzZqH7gJ1dUlCjS9xjriADQpMJK5i3dV82OQ&oe=6ABD1305"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80bBU4-rN-4Q7kNvwEooC1P&_nc_oc=AdqEOGozyJIToQ7czUX1kJKtD6VQQ6qN1FpXMQoy2_6dQwfPjqtrUVu3alNxbyyxrrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtn22b3l9QsAakkgNHHZAlg2doZYZ_QIBnCcjpXdPnsQ&oe=6ABD3790"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL1whZbTc-gQ7kNvwECqm09&_nc_oc=AdoW7Etni0E55BKfClNdfexnk6Z--FrwohmTNUeeYi2ZkapJqzH0QcpWTlHRUyjr1ZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKwprxrBdn3yqNQkRSP0VvjSvBfP6SicCWxwL-WM7rVA&oe=6ABD1784"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQGr46bXpeQQ7kNvwGstIel&_
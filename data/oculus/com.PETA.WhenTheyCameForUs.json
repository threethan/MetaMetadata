hr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUs4cSlanUlQm0V-cgDZ5je9RcDe49S7FxWh3fZlqG6Q&oe=6A8EF578"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpWiGQVWedQQ7kNvwGeU5P1&_nc_oc=Adofm37FD0lOPs29E06RmONuHlxWIUwtzwx1j-OAk-zSvUOax6aWP9CtkqYkHqsSUI4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6bxHkIn6Yxn4-pDyXCdSPmU1nKFAnBsn5Y89sinKTJw&oe=6A8ECF61"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJs7zW67hyYQ7kNvwEdTb5T&_nc_oc=Adq9BMNmEFFR4PiGrpUuPmTq97T4Ab935zXPGd9o-2eQvxixa6BCmi2lnmNRkSCovkc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq9mEE7SGnqELk7Fusnj1P1P-VazZDv_ADmfNniBp9mQ&oe=6A8EEEBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX_Unn2c75MQ7kNvwHEzJr7&_nc_oc=AdoaYFe36bB2eCZUfCWRtKYPUg3gDqZ07N_Hg6NoTLgE_r67xP2d64gDnSv8zkGSwsU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSzXps77VwwWAU4afNB275E64cnPFhg7V0qaXkw-6ElA&oe=6A8EEE85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4-IUp8zYu8Q7kNvwHfdDwl&_nc_oc=AdrmcZWZl1e9vrR9sap8Iw-Citiz10dG5sF8Crh2us4FgUC_RaE8cBqfxuCD8i7lPEE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0IDu-osBTRT9PFb7O4fwXud4ioOlkm2oWbPpk5XahYQ&oe=6A8EDAD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TSEDwSa8IQQ7kNvwEXXbtY&_nc_oc=AdpfswfbuwrsVSo3UTF9hqKuy_Znd0LYCEjhHXfmXZVpwwHqVVW_J4gybuWmS1zeNOw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKJTF2A_7-EomFXpkyJbcmXImSCVni2-qkVYSHEGHYrg&oe=6A8EF304"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=
.com&_nc_ss=7f20f&oh=00_AQFt7Oao_-2DHotduH7a1f8-ZSuYJeMSJQaXU0IOt3qU4Q&oe=6A7B2EF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXySngB4FuEQ7kNvwEebFo_&_nc_oc=AdrDN9XaeE-4K2RDhfPwZs0cS6W1-aPFuYCUB5JHUFoNOrGJN9eBatKqKniN-cCdlJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJr467dW0byyNy5bUPo5BQsLgNw9yOmIeA8H9xr12Nqg&oe=6A7B08E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwZN3FGs5rkQ7kNvwGjFUQW&_nc_oc=AdqZHPUA0_nz3Hsz7cJ2tFUJV2_O65CYtOJEfUr9om32Wb1tBst2-uFKhTrOWvse-Ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3xPKCHBoIvBRAGnD5b0nDs-DWwThVvMWcjDJRlC9QIg&oe=6A7B283C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpZOTBEhkvsQ7kNvwFyQ9lc&_nc_oc=Adq-zGr8OsKnaBBME32l_wT0EdNGWzVKIf3IOm_8-NJo24bo1CaCvCxoh2GkUYQBg0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmeZ5zaiiyTBoTNWelHikGzUzqkQ_Auz0xVV2_KtIaqg&oe=6A7B2805"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sELtGKoNUH4Q7kNvwHSr0NK&_nc_oc=AdqTKGjWIz-X7HfAJhN7v44gi_dfTURd3Mr-e-C_9IJMz87tNmS_Z-fKCnPA0ux_RQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMEJ_OwBaJs9T0DwtQoYa2fS2BAm1cQZM57KNCF7YWdA&oe=6A7B1450"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLNHXZaovDUQ7kNvwGS_ibd&_nc_oc=AdrlncViA8E42gkLE5Rh-IpZYNOD8V4x1L0Cmdu-PloPmy9y0f2OWE9u8UxFoRG48Qg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_1ZhTXnMPlj-yrxXn_XYYGTMZzkAgjFIQa1_z8H5lAg&oe=6A7B2C84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cRnk7ID66gQ7kNvwGv82nf&_
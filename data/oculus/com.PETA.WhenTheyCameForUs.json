.com&_nc_ss=7f20f&oh=00_AQA_KdaVXsWWWAET-vR2uT8nTmt7LCnhAzPG4nDUrGPYQA&oe=6A4E5BF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDGPDzyS-UEQ7kNvwExIYrx&_nc_oc=AdoYPSwzwzj-xWhEv61k7-gqdEfItpPY8uBycbNGjo9XSFb6eXY3fiYutNpCisBhOmI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0uDcz_Wdna6ecMlQxmv2MTaL4K3QRSPiSFRCWAb6xog&oe=6A4E6E21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2GoRbgz6OMQ7kNvwEfhHJS&_nc_oc=Adpome1vexnfcUUAs1Oedrh0L5llKLyLgw8DaAEzI2kom-jf_44uk1VV5t039QLw1AI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPNeIE7T60do-gFHV9em3gd0_FsTklytlySR2aw4GlEg&oe=6A4E553C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5BHxetL9_cQ7kNvwGCrxRK&_nc_oc=Adq1ERaxJn3IBgQqKCPSW-7RtLZmsbaqKHiq0TD6y1hZ9Ev4VuuwALClopPSYuQvPvk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8G0zC6xs9xiXJFewhSJBtW-VlNb9bsPOcKwjp58rqXA&oe=6A4E5505"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaDSv-xtHfcQ7kNvwE2-cmh&_nc_oc=AdqqioIV8_ooftJ0Pw7wMxUMacIShoRWzlsnj2a7hGt3AK5f0tj3VAiCmecDAEqUvCw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3pgfsf7ryPHP8BGfyc1kU8IokYgbFIXvarp_PS39s7g&oe=6A4E4150"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ08aZwitYwQ7kNvwEiBJAu&_nc_oc=AdqWDkkr9sV_AYCHoC_PJ3PwEExICTGAW68SyLQ97rzgBJ9aT9eZIgSL_8Umx89qer0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2u0eGeKmHuc12YgNj6Wf8nSVN8uNc9dzgbjpF0UZFvQ&oe=6A4E5984"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyI7YhmTiVkQ7kNvwGGB8Na&_
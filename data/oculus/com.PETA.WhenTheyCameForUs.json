.com&_nc_ss=7f20f&oh=00_AQTmMQ7gQJLOK-4ztukwDibKTg7T7nFYMdLvTnkQzJAjow&oe=6AEF32F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwH2kgAJUTsQ7kNvwFtaAbX&_nc_oc=AdqJANKH5VYNxdQqJjrXk4gFuPseIJu0-gnckk8kZC2_bEOWcNft7dtpkxMpFREIX-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVOXt9UmCjZ0-H_Eh_G28r821LBsrvDU4IAwtZR0-4eQ&oe=6AEF4521"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfkrAKAXyTsQ7kNvwH9_Te9&_nc_oc=AdqOaLhSreATS_KjNoHk6HL6sjZ3xihHcmmNdxNj4EiwL1KQ68Ditg5m3UQsmNewU5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsQvSukCTPDGgckYzKukemwuLut-E2ZnhVflZHUUBjAg&oe=6AEF647C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxpSt8Sd4c8Q7kNvwHOX3qo&_nc_oc=AdoT5f3cwxtpZiZyJ6KMZn2pXvc2FjU_y8pcS1lcU47wJML4kd9u4FbtOUgIZ02TOec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLE_YTEoic3584MZJh8DkL0RsvEs1oIBOQ6LaBRelYsA&oe=6AEF6445"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBe0hyfI4ZkQ7kNvwHFZ26r&_nc_oc=AdqBE9ji4Lh1BeozNp1Y_xj0l1pJhKL9I572IZcp2Zo78pL8nYQWHF9kuCBGdbNJbTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjOewTyvaRqBnSYh9l96CDf_zswYIQYSb2pn7r03PU2Q&oe=6AEF5090"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RTVQfDTmcwQ7kNvwEdCUu7&_nc_oc=Adpd3F0pCc3T7d0qF3PSrol_6mpJiZWuMqiP-0XY_ESa5KstmXAm-qD73JQ2Jh1kT5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJWKX2sYnLH2VU8MorUf0YfU8qCf2oT9xjEWGeG3r1Hw&oe=6AEF3084"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSbhkzZ3W7wQ7kNvwEvL5pJ&_
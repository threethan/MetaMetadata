101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SBzcAwLibYQ7kNvwEBU9_E&_nc_oc=AdrDB-eb_clz5KCylljjp2FN5jqq4GthJKn358_LIBn8mTaBRca_5AkmTBpdMdKq4h8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPvQPiBamWl94m_TyPQQlSJT_okMko8Nvmhgj87WSTKQ&oe=6B0DBDB8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vULfxokwE0Q7kNvwGCR4no&_nc_oc=AdqlrTLrp4oFZs5RnucK8NDFpPS_YlSW6lFcSd-fQkROXrD8uUBG_TCPIy5cWeXuwgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRU1-DKFlY3jZpNpsOqmzXyYi6bVq0KCU5ZoDPKZR3ReA&oe=6B0DCFE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQZmGfoGKqsQ7kNvwGiL6PO&_nc_oc=Adpl-XO1o70s3MwTPZIQ8XxcSAj5TSZ9-wU9XsRlF362iJ_FwGylQqDW14SWSasi-ps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7gYOCqRDdiuNcIa4mmnwu1pkJCTgeUqQzIaxN_oI-NA&oe=6B0DB6FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzsV6htJpRsQ7kNvwF8Ob1-&_nc_oc=Adq9nlmclMOfU5RuR8zwrHz-hwQQd54m5tn6Xq_sLIrKzenEMCYa3Z9tZaejp5lFjt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdGvAITGv0u_pwrr-5TMnFQ3OMM8iDTTLsgxSba4jSGA&oe=6B0DB6C5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hPdMmZdmnYQ7kNvwGYzBuh&_nc_oc=AdrebK3aOnMilUjmiZBOXsTE08seOZfYVZ7YLvVBW5mL2emdRhejKd9k_BadHoL3yXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYSRK2ejXbLQtgR1GADVBy2p-bVyUXjRbiGJkkuideYw&oe=6B0DA310"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxEO3yuLh-gQ7kNvwHXbQCK&_nc_oc=AdqY5p1OilrUjC9_IgkoUWcOPWzoN1OHa98QY75jfqUrTyBAp7XdLtqnz2YfhlCdxvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh
.com&_nc_ss=7f20f&oh=00_AQGaZtukHmKxyv5u8JLrB2MmioHfLB9_8Bbb_tswEx2nUw&oe=6A749778"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4AiBuCDWB4Q7kNvwHcKVVN&_nc_oc=AdppJbpPf53ee_hQUJ-gHfH6Eflf6DprKTNRhWeqNwmwnZ-OKp3J0KHqBL7qmfrbqS0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY1jytUQtG1QnusXHfQ5Ywt-jkdKV36GQ879DsMZhBlQ&oe=6A747161"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUUeshhdOnUQ7kNvwGl3NVs&_nc_oc=AdrfxL8b5hEBqbrDmJlYgbfvE52kmVmnclaLAfdAQQLTRyhl2gyCUIOxHOndxSsRQz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvTCBTmfnrcPN6GG75NiLZdzhw1Aj2YhkyCBbAaIehPQ&oe=6A7490BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwEUabkLQmsQ7kNvwEpkuRL&_nc_oc=Adqe5c-9OguZbJ1nZWyoEvnNkO38ZO2tn4oyWKAYrUZ4Ey7chQMpgMoafi91O-jS-wo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqbeoJgRr85hbwp8xr_jnYMY7DkfXMfiX-2yrtxUTvDg&oe=6A749085"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsRR48396ewQ7kNvwGrGMoM&_nc_oc=AdrPLjBPcnshfUqD_6NkxZt5tesmUI8RjvS-f-tVtWuoXaTd3QVTp5bV0-YMT_jwBeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2SIfG8RrW_34TDP-IjWROsR2doGC6nCH5PzAE1RjgPg&oe=6A747CD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT7bA9NuRl8Q7kNvwGNG54q&_nc_oc=Adorxm6CIyfzV7KTu4do0q36EJ9E6TBwX3bF1s4ZS6YJUN7cb38gZeXl9n29xUP2-NA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaBUvoZsblUwFl079DaVE-L1kKkJTVafdKPo4n6AajRQ&oe=6A749504"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2k-k7NTUhkQ7kNvwFa8IzW&_
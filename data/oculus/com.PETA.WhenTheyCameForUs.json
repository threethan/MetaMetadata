.com&_nc_ss=7f20f&oh=00_Af_h_cqKaFk1nqW6YjN0CVKRjsY3KgZHqyTdsXnOMvOkOA&oe=6A242BF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmYGBPdP3FwQ7kNvwGmtfpz&_nc_oc=AdrhgaQfjC8b4brSstlC7kiJ75U5aECw0pvmx34qWuORDlFg-XNykf9cjLanzLB-3tI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8dJ7Vmkg-LXsIDUTmD71k5mFcdYMD5fQUYUTkRj4U7Q&oe=6A243E21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi1VV27KmzgQ7kNvwFXoHAZ&_nc_oc=AdqFHJ115eWxEG-nERSg98ZHSLHYTyM-CLkJ4GVIaUkO_S_Qt6Ea2r_dHRHLaChfa4Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XD--FaeSg9tjEtp7AcTL0UeARjDwNSxeTpyqU0wcfkg&oe=6A24253C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nc06yXtDd3oQ7kNvwESmiVF&_nc_oc=Adq_fZHhX0gzAp64DNifur-7SNyuoP72W63lQgGeq8M5YM1TX-RFuxC8nklvm2d10zg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lWwxOEZMGmtE9fl_OO7Pt1dr3FlBdTRmpWU2QKlM3jg&oe=6A242505"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_VMqRtSHoAQ7kNvwHH_khd&_nc_oc=AdqmctcEF0jafde2_4ZKZZiMtSwMnq4EJj9Imhz2UfPYu3y8JcKt7erVo9RAkoxq11Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98TJCfSfq04xoS9-1CoNyQz1EhLQSZlWIKdZJcPw_4nA&oe=6A244990"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgEKf75Qt_0Q7kNvwFn8gRM&_nc_oc=AdqZ_NGavj-f648krLLHcA0KaeNWBvRA1FjXtRcQIZiaAJeaY8xe1UkhCitDkxc23Kg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PHcMEVPAIY5hQm3lBTw5Pv9SMvcM9jNEQC-_mCv9WlA&oe=6A242984"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRA4RyrT62oQ7kNvwGQRc79&_
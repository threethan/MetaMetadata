.com&_nc_ss=7f20f&oh=00_AQGotPO5RWHOg3vix182LQ7Yoguj0DnC_jPmZXvw9oJfoA&oe=6A916038"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpWiGQVWedQQ7kNvwEAbGjv&_nc_oc=AdpnBenloQWwjEyh3gql8wb2crLodW9n8HrkIWnQj3gtPOV0jOfDIXeZzQ3FCWu23dI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUmgshaE6lzyGe_LK5euplH-lgyqffy-nk8TpYNWIJsQ&oe=6A917261"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmFIJg7_QLgQ7kNvwHICfEN&_nc_oc=Ado9fJWWNI4o3Q4Bky0B1MJTGL7SsMMtHIhFFkWFVlk0QR7CF4SR2D6qcYS53odKkuI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBiElVOKSl70PKsw9wePxpncM9fDBeRGVQtiemRC7hOw&oe=6A9191BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX_Unn2c75MQ7kNvwH0VtTy&_nc_oc=Adq6EOumzaXsK1wkY5zqtfn02cP1t_5z6yDgwT0G8o-SRkHAefGr6iV-_VXxVsMaFd8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvsYZ05sa4-NB8QJT5DyJeskoRipAdoKXtGyS7fRFDjQ&oe=6A919185"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u267l2_zn68Q7kNvwE06ukG&_nc_oc=AdrSXcP7580ns_qzQtcYeFpKfEJovh66JnLcz9AXbMIk0rNf_4nbdGq9-9CWfhICCMM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJYbQ_scnrZgPOyV3LVoJKcZjvUBF_B93ZXFL4eW-McA&oe=6A917DD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaxkDHeKHe4Q7kNvwGqiAPD&_nc_oc=Adoa28JPCImUExVhVv3DEJTzGsskIJsvjTZ6Ow7Ln7grGgz4GYPu3epsetmj59ge_8A&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF334xxNy52RyyqVnGUmxda_7UpK8-_LkYMPB1krElhxw&oe=6A915DC4"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXsDiHPG5PIQ7kNvwF9tzxw&_
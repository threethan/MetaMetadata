.com&_nc_ss=7f20f&oh=00_Af9Ky9wMQWsa7UVOXFId73dXyDiPX-DbwylCgso7lK4LmA&oe=6A2EB7F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0SImSbqBlIQ7kNvwGR4xbf&_nc_oc=AdoUcQ3Zs0p67gtdgHK7_dNIecanw4K7bFSVY3KTZG82rDfZy-SGQ39uKQdir6V0v3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rRnaPGa61peMp_dRDQrs22IJWWob97Ueh4BRHyG53wQ&oe=6A2ECA21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duGEsaM2QmYQ7kNvwHDxCaQ&_nc_oc=Adr5mV5fBCDJsBS04l_pIORy_HK2XRA17yBnpEVKjuHlihUwYlxb517shYxz5E6FAII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WtHW6rWtr7Wp37pMyrsTgB6dHGJJ61TpDlpUdLuZ1Kw&oe=6A2EB13C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fA2h64gPB8Q7kNvwH1hWzy&_nc_oc=Adpaqjao_b-aTRnV49Yvz5lek1r273AP30cMVEm4f_uGHIAnr-06EYEU3RouMrWqlgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83p9ses_oNGKOriHJsHZkBmFUTFEiytWXfq5CIWcy5ow&oe=6A2EB105"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAJ6XXgSYrkQ7kNvwGf1-tZ&_nc_oc=AdrseBr7r81OXhH_b6YACHEZ2ra3-iz4mb3CjJ5hAuLqD0oem2jSc43sPngkpsn3TMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LRxIy2gN4jICy-LUqHXwhivP1ZWAVElXV9qMO54D2tw&oe=6A2E9D50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW6FUI54zBgQ7kNvwFWXtBT&_nc_oc=Adpv3hMz7GqCgq9q7RPkJ-3AFbgUS7oTkEBxRlpK0q-ukpY9wm0OxhnXNJvoneaCVcQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5PdSwbBSX3fPDl3QM6wnvDAVXUDcbWOkpzrB0iaWSFw&oe=6A2EB584"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVjN03LTwD8Q7kNvwGnvMon&_
.com&_nc_ss=7f20f&oh=00_Af_HWmd-C2SIuu3XRu_N0bl3WF91yJHQ2uDVS-71WpGYkA&oe=6A300978"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIRo3FWQM5YQ7kNvwFlwEQx&_nc_oc=AdpuL1Dx-DIj42YmFNXYdRpryUKlYzyEIEsWtfuMTb2QZ6j9mXPXIR2wMiUFRJ00lp8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-InRh8Ue7MrMi_lkNRcCJalx4OnzUJQpwKfCSDmBq16A&oe=6A301BA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duGEsaM2QmYQ7kNvwGtRPON&_nc_oc=AdrMpJt39C-rNkCV5eG-OgRuGQASg8Z5SvOSvVslA8h9m4ZbZAMK_RgUEIvgdE4eS38&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RJ0MaIxawzjB1anWSf7BX7UJPPfLtk8fAa3eB2fvvrA&oe=6A3002BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw0jnKyDnwsQ7kNvwH5jCxy&_nc_oc=AdqVP8pWHulsPSr7-3Iqh52EJKvO1oM9ZVM0olm9-OFB1Gc_lxp5LpHbyTdN1OqftnQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Lz6K-A6dY7Azosf9fRuSP1vJWfoQyvyq0Zqu-TxSj7w&oe=6A300285"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAJ6XXgSYrkQ7kNvwFxPSW8&_nc_oc=AdqdhX1yvo0HlvSMuZP1gNXWQkaNLVjtGa6pcTmZZEqDW2oWdnvarKNG40Y-oeoC-0M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DwG-_s_kKXBuh45n3x6dC2f-RzZ3drrLQoMtrZeCXvg&oe=6A302710"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW6FUI54zBgQ7kNvwHbOsEv&_nc_oc=AdrOUuDSFAmLXf8rkqiR4FTeTjyxIHsUEKPAyjGgfUPCWoUwDa5UNtn-NXt25I37rMI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_geEO0GuBCD4QZTeAMr_DW_jFIGUVMToB68G-5d4_-fA&oe=6A300704"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPo4U92mTZMQ7kNvwGVE_BW&_
.com&_nc_ss=7f20f&oh=00_AQIGi9gFqSOfJBJkSoK7xZKCx00Ygp_p1gJ1j4sXeKydvA&oe=6AAFEAF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=198CHDevfGYQ7kNvwFCzYru&_nc_oc=AdooDcV5yeHyLmYpZC4JrqP2NuRrziK-Mjh-VrnVyyQpuGxZQT3vV3SpItcB86UYcFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzwVnTgGl85KL3Z0yeBAFhg2yFkpIbRqUW-Y3JMnKieQ&oe=6AAFFD21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovzvwQPiZYQQ7kNvwFSO-bf&_nc_oc=Adq1jOV-PaFrFMjW68niyOsssTjOWCVN_A_es7GLxEombUXe0wwZxt6nx0MnJ6HUbbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3Vc_Xo0BoozHPSutTc9hrXoU7jbsklwTZzjYxpo_kjQ&oe=6AAFE43C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhtpCFmXeA4Q7kNvwGKEleO&_nc_oc=AdpCw18kCHtaQg_mj0n4bp36VJwEQB2eP0UQ70opQDC6F7KDF7P8VJaTcmj2QDJcpDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGlUIlrMAl31KTAy0AkkknvcwUlBOM3gcoa9ukrqGDRw&oe=6AAFE405"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob_Iy8Oh6JoQ7kNvwEIilJ7&_nc_oc=AdoLkwlFz55YuHSJFXR2KSsiuvggMEP4wIOp2rvKz83LN12BEDrsw9mX6UBbIM7leDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_tFWOitW0bya9cdsDile5h9lOiDi4dAyAsKYZB5NHZQ&oe=6AAFD050"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WeHYRrLlfMQ7kNvwGvKmpa&_nc_oc=AdrO56hihfmJ6QaWvYc8qpjxxqhiaR8PPCM38wmbt6PmqMn7voHsRtnYAj50B46R6VI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI4hd79loXv3NTg1b4935drFPQdRxZuDqyj21UfYgqrQ&oe=6AAFE884"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UYE8K6r9_IQ7kNvwEI2K2O&_
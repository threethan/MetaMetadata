.com&_nc_ss=7f20f&oh=00_Af4z7cwtx9CR4fuNFkkoQ4SGIevNXzDr6c4RGEtgHbFbQA&oe=69FC9EF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xczn19kHE84Q7kNvwGH0kmj&_nc_oc=AdpMQe6VsKeu1IpymcRQE-w89Kf0jM7Eq_drd9PHwym6XFyhRNfEgYJtzenhApt8N6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b0uv7Lx0-FQeqwsue6ZJiGBmErg05BXCrC-kDP6YYLw&oe=69FCB121"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcbw3Y4yhbIQ7kNvwGT7v9f&_nc_oc=AdqNNfYPPOUBQoRPSUQYmLrPaSHTpfY0NpSISopiaz_RyQ_Mf2EXSoqa1mjDSIiI0CE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ofZus-9Y7tkzaoWFerk0V10Jz-AjLETPmtvokWdydpw&oe=69FC983C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0T-SV0GvqEQ7kNvwHZNX4Y&_nc_oc=Adq-qVDpo9nzraSzaYVll_2GX80mUriSErvaS0w_-G3L0H70pyPrXt6qgtFTfV4HrG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yQoT1O7s0agA5dZG7yEkVcvfZcQrZ1ffxbzwKXPFqoA&oe=69FC9805"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsUsDFhN0YsQ7kNvwH4TMdp&_nc_oc=Adrskx9TRGuEIKSRdUihX-oZIQ2ki8CbmeDaF2nDPQLyQBDBP_Vkarqlf76VkEZAGLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D2lkf_1hfsKmXu0HuwYlG6z6eQfusbHgOipO1M2rS8g&oe=69FC8450"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIpWq_SrgvQQ7kNvwE6JFa6&_nc_oc=AdpgUXr6S67GLuha-H_I6lcTJuSLkXGvldM_Fcy0c0gU9mbHl4g88LyyCr7QnD3UGkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77i2J_2SRChiV2HPz4NvVBQ1tALErHyiva8TDZ-GqH4g&oe=69FC9C84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBdSRkZGWx4Q7kNvwFTFFs9&_
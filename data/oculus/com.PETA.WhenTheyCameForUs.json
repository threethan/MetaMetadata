.com&_nc_ss=7f20f&oh=00_AQT1IfS_OxK80CLydkMPCqunx8LEBrYmaJeTtAhII_zGLQ&oe=6AE89B78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzvMkAtUxZIQ7kNvwHmeWK2&_nc_oc=AdqHQRuWubRbX6367d18ZyGctonFTiOTEZY6me7hAjY6NEqYk-aHVfedeb2AbJc5uzo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWik4-S1ktI802i5y94BSvt_b2xTksFcZE8NrinlP0eA&oe=6AE8ADA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2_h9eyY8mYQ7kNvwGcqSyF&_nc_oc=Adp6YlfEONeRnRlm1ppan5UEug2bslNk7gxWA1S6P0NmjDhoTmwPwZWVaqmRDjq6BhU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRayVePVKMsKQJ7qj1UdUJjkZQW7djnLJ6GWaAJTP_FwA&oe=6AE894BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYrnOuavxv4Q7kNvwG_4z2D&_nc_oc=Adqa-ltqrWMOguKbJdDwM3bpfAanS7B2M7cXPX5dy_ukmrvLnNe0aBt3srIDOtnEt3Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWnJkq7i8Aw5ycaUdBBILK30L_fRQXzM_erFiB0DzAxQ&oe=6AE89485"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qrbdWw0BFQQ7kNvwFc9rpd&_nc_oc=AdoEVlT01p71aKq0FT8v4D8FRZVYByv4arCPA7SwQ7bx5O2Z2YA9erU5wLSsLS4SxMY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb88joFJLr6QgrDsDNBwz3CLugQX_73x6ZNHRzjgy7eA&oe=6AE8B910"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syAxjEWdWVoQ7kNvwHt-JTw&_nc_oc=Adq5F69JuUyfobSxXWT879U-siRjR1Q--Ok4djiXrx_QvJUze-8uGENV7wwFDB1o17U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDtjOusa3c-T7lYimAGIgPsYSU3d5nFsz2WePqLpAJLg&oe=6AE89904"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp0Fz5CUnZwQ7kNvwH7yMu1&_
.com&_nc_ss=7f20f&oh=00_Af7lXjU7xnO9bcFlo6LcBTTMYcAn-GCLsw9Sugx4ieML0Q&oe=6A0F13F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2pH6Ih9sx0Q7kNvwGXUVtz&_nc_oc=AdpqGErWLuhM_KbB4AjapjSpCzwKn0gPpwHfb_ZExgGo0bPlFiI7vifzN7fpcb9S1Aw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QzobONeZ6ZwnjhrzDyvY3JKptP5febAbQrYReUfJ0Xw&oe=6A0F2621"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHHTjcLz7UIQ7kNvwFKMo3t&_nc_oc=AdongpTZMXBTj1Zk_33bmFc1PYxTiw5uf27N05kTWux_FK4NnsOyIQ7iNJZPxIjxZXo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZtpJjExk7hG4bPSu06YQCdnDev0I6tKoytzlOc4g5SQ&oe=6A0F0D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFa9lA0qkkoQ7kNvwGFGpR4&_nc_oc=AdpHcQDBmV-yZA_N5WzVME0w3GYTq1QxFDeDQzndFTIdFsWHv79TKUY6J20tv2ZcaeY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HjtxntWqXY9SeRUbEZ9fSinblERbVs2S5Z0To68BtWQ&oe=6A0F0D05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTIfwh8Puo8Q7kNvwHLI65-&_nc_oc=AdoG7oK6FlEr7D9JY5lJUT6TU3byDj6ATQ90FpLQWfiWujYC6yVo9_pTNHNsjE-Rcdc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57nIjZjmquT_2RDBB1U0IieEdvchyFaGwTLyP9mf5zbA&oe=6A0EF950"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGkSxUqJyLoQ7kNvwHJ9Gx7&_nc_oc=AdrHqlQVbOw_nF5KfbuQOUBfLjEptYiWNQk-_KQW-fFrlZMnLg6GHzBp8fP8T-UJ_DI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o-4s3VuO9oPJvgfCofAF_1nyGp_rEGvGrMW27Zs6DnQ&oe=6A0F1184"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSmH7g_N5tkQ7kNvwEql03V&_
101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SBzcAwLibYQ7kNvwEdftcw&_nc_oc=AdpjME1rjNgAKKDwqXBWgyaxAbWHldkikDv422lelvdKKeKen6ZcCP40xsCPooUR85k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRy7a5X_J0nPiNooAvE8B4Twm3haWX9lTZLpS_7OICYqQ&oe=6B0C6C38"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxWjk70RubkQ7kNvwFfeXqB&_nc_oc=Adq29c6aseaFZWQRnO79y_ADiIm3c0U0kEesXGTCtdDWBRqa-8q6K9odLWkuHsYuH5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsAtfIXEstYLzlscQD_cs1y2t40I3IXK4tpLlhS1Ub3g&oe=6B0C7E61"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQZmGfoGKqsQ7kNvwGCgoU4&_nc_oc=AdpSduf92if10O-2bMRk3mlQ4GwSHSD588SyqC-E6oo9pogD6TojeLIwnsSuXo-Kgvs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwnxMZxu_g35Mokv-UUABUx09_1KHPNiBWo3MF-HbjAw&oe=6B0C657C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0JM5lm9ZeQQ7kNvwHQMfAU&_nc_oc=AdqMT-08XH874TPgW3mHvq2V1qsjsgvIAqtCxuz3kW0CWzqi0mReX88t-2wJqZRSzb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUi4LQmvvXTH1Kq_rBHOoN3IGWZ6dSEWnmzRzpMXRSpQ&oe=6B0C6545"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hPdMmZdmnYQ7kNvwEGZnpf&_nc_oc=AdrebZh5ETlgHeIXuUgefrHGgQaH9A1fWaEjXzMteitEjWw0PykfiDj3ShMLmFUhbGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAt6xy8KCylCH_XYoYb69dZ5EGzObkOWs9Yl0wY_o3oQ&oe=6B0C5190"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxEO3yuLh-gQ7kNvwGHIwDK&_nc_oc=Adpyktt2XlOSI3pGmJkIp0TuJsDaqwcFcxoI8PUOwe2STEweMQMBPCpYGepk3dNjnms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh
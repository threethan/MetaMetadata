.com&_nc_ss=7f20f&oh=00_AQCCoaAMqzT6CZZNymLN4tx0_vOK5q2KUnYaZMZevthPnA&oe=6A6616F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LOz9x3ZXP4Q7kNvwEAFRtz&_nc_oc=Ado7PFLvrt9ekyz0fbSCYws0YYVnuSHHBkwKvdTnixjyo9UsL8bwS5JcQAFCGs7jH2o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgUEMAtVxUpW_OGn2VFHMFyxNK46TBVGeVldxByBoOMQ&oe=6A65F0E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGg0yoUkzdMQ7kNvwEqyt84&_nc_oc=AdoK2eQaLCVby_CzcFSuDqavcSeZxIfA-S3RcfBI_HC-_5VG1VmN7wflOHOIgh_l65w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCODPy9enUShKsBN6rYVtL1-Yle19PqxSvUqBP97sl4vA&oe=6A66103C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZLWg5aOJRYQ7kNvwGD0FqG&_nc_oc=AdrmaOXblc6LkGx7hi_-aIhbYsGAwusJ174Wycf15lLQBxyGL_P61rXQopT7OQbZaHE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIUT0OVykhtmF6xiuItxDn9zyyn1hUG3eUFAJ-mK2CGA&oe=6A661005"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXV0Lh4iSdsQ7kNvwHVo5qg&_nc_oc=Adqt3nQu_vlzZzZTTHt4sAJQbWt9dKY0u6mOt21U5HRo8tBX25wjQc_EQERDlCQ8Emk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAnyr4idnwTyGoGg3XnUecHnIWo0zyuGMMqFnZkQWYMQ&oe=6A65FC50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-RFyzi9hAQQ7kNvwHY7BNE&_nc_oc=AdrQbsWYa9BW0C57g8Ath0WnjwD3SgMnp1s53T0rB1ExgSe0XYswcmT2zDs9FSBKYgM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtOzTOKkyrxvE_brezMkO0ZuWkmIRgravxb1h2X-UIKQ&oe=6A661484"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maa3uYnabYUQ7kNvwHB1b4J&_
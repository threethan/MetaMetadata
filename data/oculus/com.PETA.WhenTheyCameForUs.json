.com&_nc_ss=7f20f&oh=00_Af2LSqXZ9mF40rUbawN06snZAl0k2tltx3HtvaUtMtCQxA&oe=69F60778"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TOIefq4m3EQ7kNvwFf3NTh&_nc_oc=AdrV5iioCR2O5OcJGY1QVr0spGVYRyNynUyM9HQupucteXEGyvZxcR3AaBaansx9y3g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3T5CTDXcgABigFSWbxuodl5ojlz9QhnYttm0TCKZ9F-g&oe=69F619A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4GIryVh7RcQ7kNvwG-YpEJ&_nc_oc=AdoA4freNySHViS0-WLE9EhpAVQp-stJYMZduis7Z3kbuzpF85YxGDJP8uLVjhbVg7Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ATfKzMLIbZLtGD4QVY1jHv6sDUfEOdU7L5XJpRCxYEQ&oe=69F600BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kde7CE3apVQQ7kNvwFouLn7&_nc_oc=Adqqr53EGPGH7TFCP9DW99pSNUr8maq5wQ9y3jjsnPbpw8-4x2DOkGw4yAKF-dq1Vxg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3exmcrrl4TqUHa_i2tU0E5bPtHjaqDZpva1re8-oAEkQ&oe=69F60085"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njpKioJpOqQQ7kNvwG62QTn&_nc_oc=Adp-zZMSGevUFGsRcsLEKneh5cNNb0avnQxyZ3W4IzE4yzXZ3bVfW_HPbDWvyhLPjPk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af110tB9fx0zCHMQoTCa-5-YGfGzZL_eT7Vcbaaen0X1cw&oe=69F5ECD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKjAqe-bklsQ7kNvwEfYNE7&_nc_oc=AdrgdAT_jBYW60fq7QK5ipHAnhQn0kmZXtKnhvJuH6S5j4oWH8iygF5W3if6NEplqjk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qod-khzKJAP0tJa9oX4y96hxU5WNyFrNK3WjS2kvwig&oe=69F60504"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL1_nuCTJPQQ7kNvwFNI8pL&_
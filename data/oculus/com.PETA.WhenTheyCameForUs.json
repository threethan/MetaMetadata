.com&_nc_ss=7f20f&oh=00_AQHZjPBObDCQjwIbUTaw34KdCoH75voEd264Ql2Y2kji6w&oe=6A92B1B8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EroFGuMybBYQ7kNvwHJFo82&_nc_oc=Adrg4HZghCkixr8gQ445n18E5ZQio7BsaWk2ua9x92SE3CZ6yyf9x-ZLvtZPPqURfrU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsxgaZ5UDORDYsIDM_aSAIHsdHXKp8AiBL2dZ5ugZFSg&oe=6A92C3E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmFIJg7_QLgQ7kNvwFoxr_P&_nc_oc=AdqO_a9N71HnWewAS0N3nQNy1pMJv5xYrs5NxP4pQbcuNouU_u1jNKrlAhPXahl4JmA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOJZP9NmdJqEjSP4uBx25LblmU46PXxm1aG7RPzRLDLg&oe=6A92E33C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OlUsL4QfXMQ7kNvwG5xeyS&_nc_oc=Adro9Q4QAYwJoa26vGBbGqgSBCXRlVmUUHHIF9R1iNIJeMLjS3XbX0LLFMy_eRSRI98&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlQNBSi9rr4GGBhouZaH1MqIDe61h1IN1r7gkNWvFpcg&oe=6A92E305"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u267l2_zn68Q7kNvwGEsgu0&_nc_oc=AdpQ_vdisis1GwBpYv0XabfOl7Inar2UYxtNAABTLfZHoIWJ8_iVyHrUuc6-DmCvmuU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKBof4KYfF5GTuya3TS1hzBHw2vah1wgqHnTvEa6fgXA&oe=6A92CF50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaxkDHeKHe4Q7kNvwFuMxu9&_nc_oc=AdqUdg-2D02ExoxiZTmLue1UKcVyBGl3mkRPS9h_B2lNJ5jshoqINKRzrnbbHuWh26o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv4X_oY0KwdNN1GoegAcD_erUQmZ6E4CAYe5gIPUzwng&oe=6A92AF44"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3s8_zlywMEQ7kNvwE7EFL4&_
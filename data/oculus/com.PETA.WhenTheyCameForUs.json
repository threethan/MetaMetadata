.com&_nc_ss=7f20f&oh=00_AQJu-MjPoxyE--_STxBS_8sJNL-g3Dmrxg-SKvhGz5_7LQ&oe=6A986838"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6mv1R453igQ7kNvwFP0qDV&_nc_oc=Adr_EVHtG74CXmMh47gKP4KCJg3bgE-NZSoM5jnEYoj7y1AXISa_0iylhhXHsZqQCZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRe56M6j2TbC2YGycT_K4EYjticfTOfVpTuiwvFgnPXg&oe=6A984221"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngvTF15z9iYQ7kNvwEOtyZp&_nc_oc=AdrEXXTd_OGbaetvhS3UzShyZH46hbW7budGQlwlV5axw7FwTKlWI0HQ2HIAiovwFZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8ZGORLtH9Y1-JXomwzD0ZWeq6L71uaHotfuaGuKKNFA&oe=6A98617C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44UbU9gGo0sQ7kNvwGSgyCG&_nc_oc=AdpXnBpEqw1cVGMsiGqWZCR7eU6ov4S-EhhC-cbqRBvW-W1sqMFqAMzA5_X4A6ItPt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7iBHpaF2BMN9OBHlL-uA_Bf1gvd6kdpg5tfz0javRPA&oe=6A986145"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYZigM9HqpMQ7kNvwHRh_QO&_nc_oc=AdqYSPZJbqWnI8nIhs55nEOlF80IqF6B2b_oluapcB4sC22LDCnm3gBNH67fvUW5TzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxFcZliY8SUyKnCVtqN4KdXYAZgd4dVJpmtxx4VicQQA&oe=6A984D90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNPWCcyd6awQ7kNvwFHTIhG&_nc_oc=AdqlZBwFYNUMo7kHUVi68rfI5j_Jjdnjm0J0MWFaEFG3CfxVrbe0xl30Tk8erXw7Ono&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2h7bJ-3updud5Eh5Ky29bpKkIxLehKWP6mflEWw4CLA&oe=6A9865C4"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLzrQRYsNpcQ7kNvwF6Yuor&_
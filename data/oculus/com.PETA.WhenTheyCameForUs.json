.com&_nc_ss=7f20f&oh=00_AQCMtPreXhMGaCibBd_4r8ubVhPgRCxyzVEgd2kx59ySJA&oe=6A68B9F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsmlhaEXfM4Q7kNvwESc8h4&_nc_oc=AdpK8vHG8bG_YxWq2FC7rHaPCiIvgvCfXKcPAPwjH803ZPTsYSYnJqV5yM2RVzuWOYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9Zzs4Qv8RKoR9pgNHMLV2tcE9CfilFfyNhAZXwyp8ww&oe=6A6893E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENTST3hqig4Q7kNvwF82DwB&_nc_oc=AdpoeJ-GTdTFU1G-yopqJ9nr2KR_Qf2E_EfyERYPFs1bUTnAMNsmC2kTTnMCBY_j-Oc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrQaqcDQ1wJMRVT6Gs9pcwSPflsQksMqSMOG06UPI1jw&oe=6A68B33C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdMmrgUaJNUQ7kNvwFWDYkM&_nc_oc=AdoFkt8G03_2FHlNk93yqmuvQWSSqrT-_NucaQ2BPOYVhAjac7awyBYLexyUckGJHvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEdu7qLskS8we-JijIRcgjRrtoF4_Lin5NtIxTfqZKkA&oe=6A68B305"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXV0Lh4iSdsQ7kNvwGGU8JD&_nc_oc=Adqw8pfFKSGlq4WJt8WMPJavkwuTMnOCx8Q3pZUuNj963Dpb1mbtSGHtVhD3Od66d1w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdTA6meFxNl232QZKYXDscTYJhPxuA5ffFi4QgjOYCRQ&oe=6A689F50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-RFyzi9hAQQ7kNvwFtWE6W&_nc_oc=Ado9D6XEyFGn4Dp3qhDgN1XhTOySwZcEjp26mKeQOqMkq7zB1blXH0ivDIdX1PLoV30&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0ocU-PO1xK9B_b0Vgf7oGlVpDtMRSviNF2IhuFViceQ&oe=6A68B784"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81p5GSucZZ4Q7kNvwEcwrDV&_
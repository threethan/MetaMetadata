.com&_nc_ss=7f20f&oh=00_AQQh663e7-j2RbWiwNcKjCZ2puftvkPM9KaXEtzGgNWDbQ&oe=6AF71BF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsfTLOy9-vQQ7kNvwHjp4kM&_nc_oc=AdonVGBp6dwzmr2R5t9fUyxe-jYHe2vivZoRzR53T2C67b_28XpEuOreTY7bB8HVv3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIhdu2dCqnOUSBR87ayqWyt02McELdEsilr_K3fiZ0Rw&oe=6AF72E21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF8BUvF8SPcQ7kNvwGYj0m1&_nc_oc=AdpwbwAVT5Ysvcq938rl0Tn4woh4tEcUVNVfxV_xtCTMQ5mF7XzU093LvYSLvdwD168&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6AFURtXRRF_SS5oz-h64bZn7q3IfwyA6Qxu050B7HpQ&oe=6AF7153C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfDx1E1-q9cQ7kNvwEGI1Bn&_nc_oc=AdphIzKsUSMy-ejcOXSPfrEFUTrnXdzcr5ANV1p1K-f0xNYb84zflcqjkmrmSHLpEOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbrPyCk-BEVxTLo7IwPgS8Wm8VUyd30u85w13_bLtVbA&oe=6AF71505"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zKRnT0barAQ7kNvwEpq9oo&_nc_oc=AdppZHMo0pyHXudy3z-2oJt-x29By58Oup2VIerCvmlz6PNt03BkSZ18p1soehGS97I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsWfPe-Ro_cUaJzN3hzxGypNAhUhoRULIYW10kBvxoNQ&oe=6AF73990"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVWrHoYYDLcQ7kNvwH0bJ-3&_nc_oc=AdrDTorzzvvJRyPh_WmKkERuqA5SaHm_1adMu5Ay6IdIFDkqh5tu3vAC9_oikT1o1uo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOmqxl29srcNndmE3J1lL22aOqkH9VLVDqkwys_VTzCg&oe=6AF71984"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6Ib6qoOEpgQ7kNvwFpqI-0&_
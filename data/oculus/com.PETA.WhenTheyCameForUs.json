.com&_nc_ss=7f20f&oh=00_Af6uUTwm9nlioduD6lskOCkZvJpmAOHM4kCyvDdrRxHKyg&oe=6A09CDF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ-81CBrO8IQ7kNvwFuRRNj&_nc_oc=AdoDnwzrN2g5MemGzRb9kDl6wBIW7UxeYzvApGWvny7Aus0ipE4Kj5rQT6STHm4lVD8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ps_mxczuJ1g2HTABk5Ea3Vnfy8C4xZcpyB4fnCfahZA&oe=6A09E021"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igPjff9g0FAQ7kNvwEogJs4&_nc_oc=AdqCmeX8UQwzA8-f38uEhBX79urYketNf7Z1l1BsAvC8Nt5SuAzmnqxgCnoNL2XPUP4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jw1vkO0O3c4UUxKey2a6Tj35WbEBg-VbHBMwRqmzj7g&oe=6A09C73C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5VLNrm9fUoQ7kNvwFYqQaT&_nc_oc=AdqkcYXFLCRd-OIp2BvmigQe0TGX_1TqrWrxiSUDxdRPJceqTVz8wx71dEsY_urgaUI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jk-8gQWUIgmu5gFLuhJ3VLjnlkF8epETaaA-GYXurPg&oe=6A09C705"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFTTrir0WB0Q7kNvwFiVn_h&_nc_oc=AdrKTHHxKc0a3RT-ovQtzW3Efkee3nCZhFN0_20VZgicx1IbFUk9uv0qMr_YDfh57vg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DEKG4HzEv-oeNLNcH-Cp07uoQRjGuxrbzhiMCkB83rQ&oe=6A09B350"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFCE4-d73H0Q7kNvwGpdZwJ&_nc_oc=AdrhBhHTHee60704a_3-PrSY30IcFnYAyjeoEVuY5unIdlPaTQWcMKPbUerGdWmcYek&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69ks03kr-s-crCFsQVx4-u82LQIUOYf9ztdSdYXNhmKg&oe=6A09CB84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drjMmqSKgb4Q7kNvwF-CJeN&_
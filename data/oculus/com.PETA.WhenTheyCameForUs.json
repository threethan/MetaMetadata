.com&_nc_ss=7f20f&oh=00_AQBiDHh-gZgznZ4MERzFEaVgHDF3gvQai6NDaRv00Uk5AA&oe=6A5A3978"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmL_bIycjIMQ7kNvwHfINc6&_nc_oc=AdrggFxj_ZNfvHl8CJFjwk7M3eerKcBBa-uNy4lwZZGsai43V7RmWbf2AK6cW_OVriQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9j-ugzKOkIfmOFfj49p-93klVzKV5QjveaAaa_T9uuA&oe=6A5A4BA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17Z8rVOiSoIQ7kNvwFRZu1k&_nc_oc=AdqLOzHXHiAOceLyVu_hiCG1d_45JSkzimxt9s5TivzzlTCVSNHKJRQZfzuJm_veY8o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ_GwIYFQrcAq-Ze4QSTT-c8Rr0gBjf2TuBNYvoUVX0w&oe=6A5A32BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFReD9NuPtYQ7kNvwHxRZ0-&_nc_oc=AdrXtfJZeafgByiEDKCRMzmb7qjeCMZ9J7UhDKQUWvflaejGUkYAG4GG79jtkfwSi7s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3jhHTIxge7GpLY5bANuRKP-M56Ug_x2m7KLvHQl_k5A&oe=6A5A3285"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Zt9pN223fAQ7kNvwHL7Jmc&_nc_oc=Adq0f8WHHz2GLTHtrQXPNcQH689mACK_CtSPCMCR3hc1xqcWVyQi3BceYi2w-sa86d8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRUmll_FBtTeltw4D1mv808zzsddACPFhxRPBTe7MU2A&oe=6A5A1ED0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abc4JKRWs58Q7kNvwGz0utl&_nc_oc=AdqM7pzUpEExSpAaDdrS9o_fqMhbTi7d97fDfZLWZzBqtv4dBnDVZgAqOaNvWgrRtHo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp7uqFeWcBgqghmuVabdO6lsvrfAZM7KlvcaaQAenMiw&oe=6A5A3704"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1cryRsI0Q8Q7kNvwGdPNMp&_
.com&_nc_ss=7a30f&oh=00_Af2HQK32MDG9f703eXIOxZX1KAAVkogl3SHZWGVsovzVtw&oe=69E8D878"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d41XmjkMLWMQ7kNvwFz-0-Q&_nc_oc=AdrGvdnqoNueRM-byOEmyX9_qWGFqJi3cAd1c2t4nusxk41BcnZBNdrwoGA6N_A7UTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vPcguzJcJHQAThDQkwqFJoxEOU77ZMbvjHft9zH_YMw&oe=69E8B261"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYHOxAqMEQQQ7kNvwHEymvz&_nc_oc=AdpHM9HG1UjIwZAPnGzW6bI7VsFs-IqK6LoIQVUVID0hylV0j4G447uxwgZfD8uSYQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GbC04qjL6iKZEt_XgWKvr1OFzCta_WtJ8v0tDSmCbBQ&oe=69E8D1BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryCVu0fdNtYQ7kNvwGGAGmq&_nc_oc=Adpqj3DgSemoqz8CoP0t5O7U1KrvDW0-28xCeh45qp78v6ZyedPaCuI0W_qYtP6zTVA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JBzx51QWzhKSW762Kvx1koQw77D71xb5SVigE8MWxIg&oe=69E8D185"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doWtn9G8OrQQ7kNvwGmxzYL&_nc_oc=Ado2WDaFZSzonsub85F1vGM79nO-zy57N8o1wHZt2TI5rTmjwfWNb3WJMfQ93hIsGP8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dxSlpEtWrLGkYSywHVNuNXVbkLtFeyNH79sU6wLe84g&oe=69E8BDD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBcgNo0-DDoQ7kNvwGbkJmE&_nc_oc=Ado5DuWyCzx3al8UAyMgC5U4NgYr-RKsXqCB4zv2AS6d6wTzizhGZoxpc7_WXLLGE_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af399O9Ww-1RRJVkOhRegR0jnO4I6snmkaElurwpLuhJ4w&oe=69E8D604"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlNi-SoMvC8Q7kNvwFnhdnC&_
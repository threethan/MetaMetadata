.com&_nc_ss=7f20f&oh=00_AQM_oJWEfeixmzhjdwz6tvg8SK6RnujEiREceGJtbqotdw&oe=6ABFBCF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4W_nbYcFwQQ7kNvwHI4VIv&_nc_oc=AdroA7FVAicOGIBf0T2sPYnQsNwjA8-TAkzjYM0IUjM3iGF4AB2WXIbt9Es7-ZuS8xo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3L1N3MeOcrosuj0i-3Zj06s0x0NY1E-dHLt70N75b6Q&oe=6ABFCF21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wibNpHi0OJkQ7kNvwEkgayX&_nc_oc=AdrtTWVcQK3lOLQCSJ0w2qv-PfdxgeVxYHUrVI4QSLhNDFpXKv2wwV5JBrL2DS52lTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN4TARG9eoPwmrqsfYDuXsOsWgi7rsrEuFTfzE3FoDpQ&oe=6ABFB63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFKFECSug70Q7kNvwG1e-AN&_nc_oc=AdqJKu69GryTXqar2TmQMPnuJqUhQrrWVgQBuXE-bTEN6azIELE-1tYaZy4U2tKiOq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHhuge9fP8pkTi2JPg_TT1BBZ99KB-380vQMBnJhpUOQ&oe=6ABFB605"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80bBU4-rN-4Q7kNvwEMW8Zg&_nc_oc=Adqs4QLpe0kjMXVJfLgdhyRJosO4VBNR469ziKiZTVUe1wuh_RCvPh7VoUCKmwDNTGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx4V8QxNQgcO_oT0gdl-ZPEZr2lihXr__KifDY8Ku2wA&oe=6ABFDA90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL1whZbTc-gQ7kNvwHLXmMn&_nc_oc=Ado0qOEoGtFzDrqncHjzKVRtpgp4C93Bhp8xlt4Mo_GzYqSVYHqPZIPElgr0KGfMXyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTAZtujLg51BdesWgQHmdnUQzGx8mHtQtFTz6TkgMX9Q&oe=6ABFBA84"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQGr46bXpeQQ7kNvwFtnUnO&_
.com&_nc_ss=7f20f&oh=00_AQDcZTdRnpqf5eq4n68n9PNvoVSe7BxiG4MV0Q9sPEBHSg&oe=6A5644F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6EB4XLwD9wQ7kNvwEoMbll&_nc_oc=AdpnYiK2WZo81NrCpzPCTeZ1y678C79Sbw-RAMs4iejlWoR15KBfTupBQDVKdDwVYCA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnbaroGCO3v8bYPR5IgbnkDTTsCMfWpKbG87eApqiFsg&oe=6A565721"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7D_wmzq-3wQ7kNvwHlUo2b&_nc_oc=AdrMBFoZueuRF7xEmnxk45Snc0UDuLcLAVQrqHzDu2HP2ev1WhX3HjpVOs696SFstVw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqg4-ekPe9kx1nnNVa61kZkoiL_eTLWs1zpYKz00o88A&oe=6A563E3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sx-SA3oCLwQ7kNvwEhFnnD&_nc_oc=AdrjVTWf35uqtcvSTuGeuy8nn3el15llkHTTDX87L2_HctJmHr4qumk6G4X68KJu33s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6LVGYDT_n9o_qpeYiWtKLWeqxeL0cAZBhPCdEp0k-6w&oe=6A563E05"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ez3LVGteGksQ7kNvwHgm-DU&_nc_oc=Adoqcwwo6LRMXLajY3E1xRLshGv825FbRXeCETLlB7QZIEPMOvH8tcxbmf_VAMQ12K4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN3jGMG61Uf03RJw2uIqgD6UdzAEDiXfVdlN6nXb7hbw&oe=6A562A50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc3ol-5gnJMQ7kNvwGlSUsr&_nc_oc=Ado6qOx0rLeBHcntQM00zgy-mR0G2IiXiLbmNkgfkdjWcgLk078LmmepKN-xUzKjceY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU5SyFg9EaVdrZ7iS1ASoZDuMMqQ_Q-JcXwwh1xKfPYw&oe=6A564284"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH-1WlOlxKEQ7kNvwG6tY3U&_
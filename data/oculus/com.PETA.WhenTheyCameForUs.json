hr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELkLxGsvdYTx_J0U3vBG8fVV6jPuW076U4iyDY5RImPw&oe=6A8582B8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN51o5dDJ7kQ7kNvwFh90QL&_nc_oc=AdoVFmxNq29lq6BsM8jKzyTf7EViEqIGTob6V7H_kp8oaX6LDw0VN4SdCTvpLKbkXfE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi9fOeYBTjgzJ8DQmMttXWTjVpVPA-RPTVQDttgvMKfA&oe=6A8594E1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HuzfTFYBTwQ7kNvwHcI40R&_nc_oc=AdqpZvGZQMjl0BxWXuw7qXtPRdvg4d6y_HmybaG708bfLzHoknDXVctPRDk0EwMQt4I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgKJhZPSF3W91EAcH6UOW1DqqhInZqdvmIckNKX-24Xg&oe=6A857BFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcz6-ltdkuQQ7kNvwFz8iA0&_nc_oc=AdoYbTVtZ_M4yCGNhZXeBTI-1yJAlkTIU3KDFyqd0yasQFOBDQfl45X0WTBd95IqmwY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHci8IerVHVkz7nMti5L2BcbscCS5nSVKGuB1LT5DpixQ&oe=6A857BC5"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a5S2i445kwQ7kNvwG1ZB9T&_nc_oc=AdojqzG6mKUmzT5oHLpZGSWMPVyyCMCr1AlDz7APBtplP-yxjUUP6UEV6CDyFkm4m5g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9rrjY1cAuf5OM6gy3j0HpB5zw8x1yZl7yBmgYuxidNQ&oe=6A85A050"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXDQYhbM08MQ7kNvwFegjDC&_nc_oc=AdrP3lwSRypczX4c4Dc2tGiE9T34Zb7VZjMsbgS7RHVr6SUHod7wK-iI56_bEMArFaY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4PWNooQYNaTzfj8oJ3K_9MHxqGrq9szPal7eGkI39Sw&oe=6A858044"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=
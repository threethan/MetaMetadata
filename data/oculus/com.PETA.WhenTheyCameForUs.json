.com&_nc_ss=7f20f&oh=00_Af9t-D9Lq008Rn0Kf7yYOfDNQ62nWJuDz68YQVD2w1ZIfg&oe=6A32AC78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIRo3FWQM5YQ7kNvwFciGv2&_nc_oc=Adpw8I07RqjNeAhx8aq0y3BrRLFmto4sz16eohK649kqOhLTPyyTy7O1GvkwWT_51Bw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h1cVO909knvKKl5nvmAZIL5fU02vbMi18dD-s2dtYIQ&oe=6A32BEA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB8gOm5D5PgQ7kNvwHNIYXq&_nc_oc=AdoRwE4vuSw4ZAFia_XDJK6Hdf-P26vNlBrjqiEas9PQjmDT2kAEQBhAa38RRImhB0Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_92iTcxzYpcmRK0OjJmXKRmeL3bxOUFCQ0pMRUzdKTEA&oe=6A32A5BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw0jnKyDnwsQ7kNvwHccAMz&_nc_oc=AdoNmJ9e2xYw7VOvKK7NpPoRlUzqoIkY6O5XfaK_9I3KbiL_gXDDpW-Fd3BBZ0YepLA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y0xNS95mYkOisFWdL6kGjBNiSBETREXMLk4siLIKAyA&oe=6A32A585"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFdTrMdGv7kQ7kNvwE2Peaf&_nc_oc=AdphVHhkqxB8_Iz2OAbRz-arX15uGQs8WbgSALPuJgiQT73YlFfDHLjzdU2mgmOOgmw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kdy4gUXbpbGTVOHXAwfyygoOd2ZDqr0xJwq7bNsUUkw&oe=6A3291D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhRrg8lmVsMQ7kNvwHDi0DV&_nc_oc=AdoH1C4v3eUSYXokC5VXcZYy5K95WWjZ7Evu_UMj0S8_56IOTcMbsEdCKJTqeTmTxI4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KZQQ8Z_ImsaNKwfhY0sVgRqPNZF4KVQnx-ItV76e0rA&oe=6A32AA04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blMC384-Y68Q7kNvwEtZQAz&_
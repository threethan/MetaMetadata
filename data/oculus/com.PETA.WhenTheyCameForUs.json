.com&_nc_ss=7f20f&oh=00_AQPqp3PowfyUVE-zovLNsVGufjjeXXl9LmdUvvo_6n2WJg&oe=6AE4A6F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r04kL6c0ghgQ7kNvwGnzbGv&_nc_oc=Adpx2h0939a3zBknUaM-HLj5hZTsTrmc8RCEbnzI5_l1ZvAT9EOcpwMhvxIV_Cdcdug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI742B1bSIC8p3ZPVEZegl4a0joVokpSrO3jBpqWvAxw&oe=6AE4B921"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USLUOhFdXbYQ7kNvwErUl90&_nc_oc=AdqM54fnfjqYP9t0F-4t_Jw5MfSdpsto-8sEgroIO3PXBSKhAE3smO9Zrn0Xk-T2TF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9fJDqfFg4xSy5KAu6KWKv6TSaSqLiyj4FN6BCp_HH1g&oe=6AE4A03C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZstOL72bmMQ7kNvwHrMpMo&_nc_oc=AdocQq6dxNXE7h5S6CJYYaGjFD_jMTcNvrMPTePOTNTN1lc0TyhYNIcPA4S_fpvwYnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3XB6tgChWdjSR5M75eI6TAq_u_zxhVuHMLOmRKub7fw&oe=6AE4A005"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt37Bcl5zVsQ7kNvwHKOEpQ&_nc_oc=AdqCtLKtF0251jaGflV9376k9-xKbaaduX3a80hj15OxuJd5vSI28azRfAs-NtErAxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwBXmJTnKUD0K-hMkmWBLnPtXI75biQWpyUh2WLwxTHQ&oe=6AE48C50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqzCQp5Z6jIQ7kNvwEaw7x5&_nc_oc=AdpG89CZkT6HKofkFnKs1Ds_rBlTUjyU2WYcvoVO-On5_OQLZRgaGpARDVldB0S-AMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZbJWpxXViZzxCutvxsq9FGfGQ1h_fbI-fnSQ7Fp_H6Q&oe=6AE4A484"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP0z6PcP9h0Q7kNvwFZczNj&_
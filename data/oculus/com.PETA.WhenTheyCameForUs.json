68", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001676_491951296532101_4101287377528739009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jn0NSmnNNUEQ7kNvwEQTBlP&_nc_oc=Adln4e242qpKQc00MhNm9u2lNtJoQ0MOjL167lKlyjsTgbGBbsjueRH-4-dgIt_ydz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufN-OrBP5NhjLsMKUvWH8CgYc1GC7LgwchPWlsUPCJCg&oe=699DB2F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L24anWXfzTUQ7kNvwFXbWBE&_nc_oc=AdlXsAM1Oh6y8za9qgRbKZiytAlnLsSDQDX5s8RYb-hPWODy5dpFpiXtWBXAnPq0aDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvipn0cfRu9r5xIZyDG4Mk7uaZOHVM_3cH3gSFGukN8YQ&oe=699D8CE1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Da0hqXkUQdAQ7kNvwG9Fnem&_nc_oc=Adn-ZpCS2IE0K57A-EZSTFeiY8hGtC4KGaaBAHfSBzsJ-cthFwpYNwX_EeY0lRfyfgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8nRUVUgPAE9UIlCVI9V7I52wYlopzcXqU1Rg6GhH4Cw&oe=699DAC3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}]}, "developer_name": "Demodern GmbH", "developer_privacy_policy_url": "http://t.ly/jIgD0", "developer_terms_of_service_url": null, "publisher_name": "PETA", "support_website_url": null, "website_url": "https://www.peta.org/international/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7926720480739174"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1022972152734764"}]}, "baseline_offer": {"id": "1022972152734764"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1722862800, "status": "PUBLISHED", "id": "1022972152734764"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7932791660132056", "version": "0.8.6"}, "id": "744178690948538", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_
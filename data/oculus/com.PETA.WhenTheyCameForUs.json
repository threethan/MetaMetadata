.com&_nc_ss=7f20f&oh=00_Af6pAseHH55Qr0m5u_c0EvxAsyDVZZTReZR_HxIQJA-SHw&oe=6A009378"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb9-f_gL5TUQ7kNvwHg7a0A&_nc_oc=AdrL8JTl9DmeQO8htWyS_HqyFbylCz5dEjv0b8CFu_s2EsdlD2mEeBxP2L6Vhe-7kvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YZ4v8KPSsny_WhnsFJGfFbcb8Y4YO77niE3c4ma8uOw&oe=6A00A5A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGYV7v4Y0aAQ7kNvwFzRSPE&_nc_oc=AdrMrrwP_8ztLJs12lkrRL050xvAlZtFYQ3FusHfMfcikaHZz0rt1U7laktuxNL-uMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G9uEqf8l_yIa3yGnAOtYS9-uSFsDopQKHI-7Du3b7BA&oe=6A008CBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxpwdA19cb4Q7kNvwG31iYC&_nc_oc=Ado-WmdM_spjybmK3kgnj8VZLc004fZAk2XCYkjwhvnZQmK3pXFBnQT4sZwifHxEivM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47TDUm-YNX-NUVLYCV8j3uL9pvzWKO7Tqu7_A_1Gtmaw&oe=6A008C85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THinjzlQnRwQ7kNvwGb7DSP&_nc_oc=AdokOhX0chynfW5_0xQMSOTA5Z1LBs3mbmwPXVGoIYcTNf4xJ34xPLQJa0YdDp8S2pI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TIZrLee1T4imFmYavVoYdMX5FJAqlE7kXZKjhKqzATQ&oe=6A0078D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XL0egKbUBQQ7kNvwHAvpDy&_nc_oc=Adr13ERLQ6LO8sjICO6w0FB2_o_ZCD6WcUnX_5Env_MI4zuAif6SYpD5I0SUdOasYsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5igK75ELRB0lkMu2yGCUaNZ2BkV9XlwW37gPUHT1Ufdg&oe=6A009104"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CecMa91AdyQQ7kNvwG6l1NB&_
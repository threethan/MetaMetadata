101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwyXnKR5ajEQ7kNvwHFHuKv&_nc_oc=AdoDD-pkbqH_AvNHa7nfY3cDs7UfqWrbdOGH4AVvxo-e2ipbjtstXMokq3yeqTVBwgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe7v93PEEnR000tmE4hfwZWpmttjKGokgs4BKRm1cyxQ&oe=6B01E038"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU54rHmYBt4Q7kNvwE-TRvE&_nc_oc=AdoVoJfn3UZiJBwA5uS8nkFaQI12pYLsqaAOBtG9RNECys4mUSqjadnYEFiX0JKmVqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2ogzPxpAdtnFmTpnj-RfI_TrxgHQeULGvwdIxF_N3dg&oe=6B01BA21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSfWTi6L5dwQ7kNvwEakopf&_nc_oc=Adosj2-VCCwZavT_at0taOLk93AI4LULC5kPGosWJdh-fnfYubWyLHTf4ue0NcERT_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1OwNyikTytWpBqVjlwhrBLLojpCyJOM5zS5LA2DEIrw&oe=6B01D97C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7Gst8BEo6EQ7kNvwGPOB3h&_nc_oc=Adr-M0rMCEUpZ7W7ElRFlgN7CtE3hXAcWWa9PfPbzyGaG2oyTMFvpZOxp0jJl8LdndQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHto0NIZZp-ylkXv_9sS0QAsDmUurcl3_NS8RYqSLasA&oe=6B01D945"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmBiC0ic7g4Q7kNvwFbEJRd&_nc_oc=AdrBcohgE29rBxoScR_kCgSxM75zk3Mp7figK-LOHv5zPTUhOQ3P-g8IW7XtB3cNFMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcX9dZOeiylyAdXXQxjiqRtS1dmV7CnNK15Lwz6dbFGg&oe=6B01C590"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2wkOmVg_X8Q7kNvwF5AAtn&_nc_oc=AdoJHJz2hQ99vENRekmJ_qO59csFPI_tFSPtCGOV0xOx9fu1dvGUu9mOcy3Mm4ywwoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh
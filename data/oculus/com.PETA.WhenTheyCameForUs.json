.com&_nc_ss=7f20f&oh=00_AQKCinAw1zcQnqCMe3jYnHuLQwNSeCobFRBDokvs30pkFQ&oe=6AA018F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R16CiJTFduoQ7kNvwEhL_Hk&_nc_oc=AdrRZRD9Q5XCQAGqtJ77fPT3cG7MALPdfauNi8bTA9NlWMcF-XS7U1Vu-HWBnXLDkNg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1EO7Wq6hk89LAOorH_lPtUfU1gm0hZ-xWSJHx9A0kJg&oe=6AA02B21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfQ3ZzM8iL0Q7kNvwGzgg-r&_nc_oc=Adoo4DSjtR2XvXA4n2Prs8kcdzipYtIwYYjdKcxSqMFRrQvrfgiZCWdIq2z9t4I26yA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdgabIzNC1zD4HmhdrOs90i8gyd1viZXLgjeT7_ssAXA&oe=6AA0123C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggwV_uht8YEQ7kNvwFPq9Uf&_nc_oc=AdpdXA_JtDurtE4A8nKovyXGsD8FzX9eGthsz1OB3TdfCVxWGeuAOsvrmUGAQREChe4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8wb79ycWMDtO0T9ytja_l-tURbdmtzfM1t9wmkWVe-w&oe=6AA01205"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yor_HvbnVsoQ7kNvwGpFB48&_nc_oc=Adr-3hrXHgilatEzsG5UHBQjuNLMcAUDtALN2TP-wnZs-rNgCXUxAVvImAt54FW-osk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUjoFIEyUoFDCeTPqtnrGzEDY4tEdgMOBZVx0vYooDTA&oe=6A9FFE50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTo6Ygtxo4YQ7kNvwGV4kqG&_nc_oc=Adp8qMnsefn4HRRj9ysVDNOy-ni8y7mvWFC3zWaKl52jdMMzbVNlxhADIkklSh2Ra_o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFzpbB4lvv7IxU1hkx8i9WG09ckbJXp-6mYo5XRswlvQ&oe=6AA01684"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL5SSsMTt_AQ7kNvwE29BvV&_
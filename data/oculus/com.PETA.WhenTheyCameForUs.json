.com&_nc_ss=7f20f&oh=00_Af6Rf3x5HwSZv8wtFGa6LJUsEc6cTb54x5yKUrsGqces5w&oe=6A0B1F78"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ-81CBrO8IQ7kNvwGbKaep&_nc_oc=AdqU3Msr_QP8tAZtLQpAVkq6o5TT4MBOY6QB1Ro8T2gRk9qSVjkZ-EUtB_95mMQHv2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sHcWJVgPrF_IW4t0zjjygDsqiljiybJM44khYw5MJDg&oe=6A0B31A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igPjff9g0FAQ7kNvwGx_HXL&_nc_oc=AdpPVu_838UhHlA873qEgr6TS9kFFLUPbnzbL-AiJa42XIq6Qn74j8ZL0bECSnJwfQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6axfhhP3AGRjImhp7HDUqEnvqrpoTh54Y3NJcciGUHvA&oe=6A0B18BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5VLNrm9fUoQ7kNvwEDUL3x&_nc_oc=Adpjkbuwy5DHFcptJieAaUP-JbDKmtFUjoBXkYs4LVfDGWgX8M98-CxwA3UOIhZcOwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GjnsTONevA_ZhI3Jg7jraCoa24DynqfW23Psn4XVTmQ&oe=6A0B1885"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFH-8K9f8YsQ7kNvwG5h9kU&_nc_oc=AdoVCGwH3Gfp3SW-MENhr2EwIsQ4k6DLDjcV2io_BiML4-cKc6Ap4PBP4lch2T_S5K4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q6AFstBP6NLpbw9v3IcG4jVKQzr5zXbKPdhhTFtXheQ&oe=6A0B04D0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TgdQal6mW0Q7kNvwEm7DBV&_nc_oc=AdpMec4LpjnfUr9DWkn4MLiqLbohjSKk7xO-jzhDwGzpMkmFkFOCua-RYoLDF5_SI_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52nbLmmbV4rz_eUQG4ICVHXmvEAIZEnJUWD2IdKv8GsA&oe=6A0B1D04"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drjMmqSKgb4Q7kNvwG3Bq2q&_
.com&_nc_ss=7f20f&oh=00_Af4hQ1pRO7F9O5pMO6idzS1edQ3Sac94tmOjv4knX5RFDg&oe=6A072AF8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nN4ER6H_cXMQ7kNvwHopyTd&_nc_oc=AdolyUuDajE9MKqDsA92aC2oRAwfSdvy5HrqZW1mnBRZBvxK6vSmRjGQC9JeYL4sjvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fa6C7avZUMB9fZJnkrymQHBxo3Qnf9aF-x0OzubHSsg&oe=6A073D21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=415GRtvmQ44Q7kNvwEXbkdt&_nc_oc=AdqpOC8xNxWgVvEVMwVuWodLzDCA18be7SrK8qXIHChXpda-SN9HfUQ1wh-iTRoOgUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MZ8n9wzW8WMlubw5Wqjl4vXyXmtCULi3Bob0HGJ45Wg&oe=6A07243C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMnW26UySvIQ7kNvwH2MVV-&_nc_oc=AdprRuNc4iu4FX7qrYcbLCsAieb1kjMkL4JsDpd8RXyPvk00-OGSJYWDYaDuqbOPpII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AoKXWRrIIQh_9Zb7Pwm4fMi--AerSNWLa8QpJkduTbw&oe=6A072405"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFTTrir0WB0Q7kNvwGDApUu&_nc_oc=AdqP2VvHIw_Lea4H9tyA8gCj_qJbAFmXGR26qGTNc0Kl4doQvacO3-XXm_kEUdEG2is&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a4tdmyXFXEFcVEZ5H8-lTU6nldN9FCB1s-uTGkbBcJQ&oe=6A071050"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFCE4-d73H0Q7kNvwGUWbS5&_nc_oc=AdoAdNmwmtbSSsAOiobFMMbZTeHHSH5r3eMbR5_6C29CTL7-NYUmHjj0IPH8VhXmDdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D6NC-iTa6w7r1VqJHX0n-dAN34yXsfXZU6q6eVsMCUw&oe=6A072884"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqiSZ4H7vJ4Q7kNvwFP6DtJ&_
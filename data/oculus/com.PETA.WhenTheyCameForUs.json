.com&_nc_ss=7f20f&oh=00_AQMejxn1d7AX3cIHKwDhNjtQncSbGelABTC5muS-KdPjmw&oe=6ACA48F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl6OR2LrgQcQ7kNvwHFV6JD&_nc_oc=AdqhaYgVQvYsMuF441mUyWbdfI48sJe46bVObO25bt7_oBQtcPjHnfqYffzu46NaZL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvieF1fVoVDC54GUzK0TO4l-YO15-6iviZHM8eSU-W9Q&oe=6ACA5B21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g70ZBfLWkI0Q7kNvwHvg2kG&_nc_oc=AdoxNg0RXl2NKbfa_itkSxnxM1wfy07PRZI1B1jLast_jrwkqjB8ADt2eZ1igmk-Alk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQMRZYxV1xH3L8WK68UmakanOR1RD3-Ri0ligs6EdXNQ&oe=6ACA423C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNXz1-Pq7HQQ7kNvwGgEeQj&_nc_oc=AdpvKmFSIWNPYndw6zE9gpOjsritdVCC-H9PUAmSdOU5Tc5wWCkQO2OyGYB4wXpsAQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhdWPsdQO0msF8bLiq5tRuorNtrDFVpL4mcH-xXeN7fQ&oe=6ACA4205"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEY-cLGM5O8Q7kNvwHrHFtC&_nc_oc=AdrVvoUWjZS8OBv_m9T2GceTeNXYWb7XML1ZZmLLB-y56Z9eqlEVPZWUHGaLhF6on88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPU_XITRk8kFSkQqaZ1telii3Ft7vH2En68aTa4w1Ckw&oe=6ACA6690"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUKuFk7phIAQ7kNvwEq3Hw3&_nc_oc=Adp-wtbCWQtyd0SPv2IXnhiJadGCUGEefVjwZPEc3TyrrIOQ5AYyZhP-C3FmtWIZ2OQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyAKIXPr43a81WXyuCkn8iHBm-RZ-CSw17qpKULneF9g&oe=6ACA4684"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whJY4C6xu-4Q7kNvwEYLQPI&_
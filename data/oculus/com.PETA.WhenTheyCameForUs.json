.com&_nc_ss=7f20f&oh=00_AQCmF6ijDwJncRzoG-yJszUwH7WnMK4CNBq54FTphAuhgQ&oe=6A4BB8F8"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDGPDzyS-UEQ7kNvwExJqw0&_nc_oc=AdrAUHFIzqs5DxS-hM6jxnDwd_mf0TbI9OoTrRCd_KD4H8JWcyWLJYi75yw59io1DyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3RZiOunXg_c65GLBqmswtlok8mnwkgX8hSa3J5ICFuQ&oe=6A4BCB21"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUkjI0qRGiMQ7kNvwHswATi&_nc_oc=AdoPZHvGpj-m9vSRhQjVcJ4UttmeiwDzfCtkhNldixh-Cro3oJGBn5aGCDpgapAAXpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFpju3GlO178vHJzebG_XJM3-DV1FliFAr2WJIcrvQhA&oe=6A4BB23C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5BHxetL9_cQ7kNvwG57KN-&_nc_oc=AdocAzOXwh3UCNqnSOM4mwJaQl7mJL8d2lFLsiSBgpPyzPx0rnvD_Hp5K1m_osRW6Kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvSfraWG2JMX5H_QyCdxb6zbo16RXR_pBPTgmGVVR6_g&oe=6A4BB205"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfyLbHAKJ50Q7kNvwHQGEfs&_nc_oc=Adqh-SKLOFxyzcisz-rKXqW7X3zYvehy2urTQOSt0sVWUeEZhIsr1oDdTwPll0bfe-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKAoxulvIamGFV8xSboeKta24QDvd7yRWjrKG95Qvi4Q&oe=6A4B9E50"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyTaqBdBCsYQ7kNvwGhd8s9&_nc_oc=AdqwPly16gV4wOPoPFokV4zPvfs94swZ8tFpPqD3x9NsMnLMdwvRuXtyzPFxtEHWw-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyG35RkLgrMo8P_CM1w0X6kMmtGhc9Lx_XT0Lw2UT6Cg&oe=6A4BB684"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyI7YhmTiVkQ7kNvwGDudIf&_
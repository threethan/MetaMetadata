.com&_nc_ss=7f20f&oh=00_AQLXnEWma9EeBkcJXDq1esCs5WgSU-ZNUst62Pvkyr2vyQ&oe=6AABF678"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ewiz7E5phYQ7kNvwHvkZBI&_nc_oc=Adqp7Q7opPJzYQj92BbWaUcod73vxYdzEoWzATec8HfkikvTyOYzChSpGKXSvcRApMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnaXbCBBHx8rmrdDMyolJBbBUJzoKXUEBTwIYoLJNboQ&oe=6AAC08A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc3lES84VJsQ7kNvwFAzyNw&_nc_oc=AdoWg_TxtyFhLFSJess_Exi5h5GNY1BFYjTMKhrDh_T0diZAK2MaWwLufyB3nSaHyKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVC8IBNLflzltbTJDD_IisPmhapcEFdo7I4i1MSONRDA&oe=6AABEFBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_I5R4zkv4MQ7kNvwFt3ySh&_nc_oc=AdryDIO-miHGStWss_8K_n4mvCmKTcmL8VZLXj0GN7wbiOy-YuO7v1loUKC09rl5bjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgBQ5-V_f0-U1RkWLnmJYTaM5uTgQXR3wlpowzqrPhFg&oe=6AABEF85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxlKyceCn00Q7kNvwEeSFaR&_nc_oc=AdqlV7ywyD5YE85RilglRZ9eUk5wjb5IIHom2bmjtmILByrrYOYc5rNVx0qAWQTjac0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTXVbuCTjhreDqwDHDydnN2_lc4ZUqTLIsf5c_7_LgRg&oe=6AABDBD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExzVW2qiPFUQ7kNvwH66ISy&_nc_oc=Adqhz2rx7GBAhc6pWTRmGl_6VhQLlnjkLxOif1bC2I1Cr7R5EX_pEPS5ccpEDyGSFPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO_y6oO4T_Me999cqf-hnWNSltRG3qRTFxemDdgtxltw&oe=6AABF404"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Y5EuVvPT4IQ7kNvwGY87cz&_
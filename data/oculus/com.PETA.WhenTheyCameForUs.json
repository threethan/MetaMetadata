.com&_nc_ss=7f20f&oh=00_AQLhNxU92Hs7jsbYXV6SQ93ji88LVaezvImTtbiY05RIqA&oe=6AB92578"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOsOg8LEzK4Q7kNvwGx5JOx&_nc_oc=Adp1WrSksX8bZ8i3wY6tlr0N0cUpFsnU1v_izgxtsiILmCSF_NR6yP2dG4ydPUP-xjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzI8qZ1UgWfnw1j9DVacnSwzh1W-IvoTavy35cAqfQlA&oe=6AB937A1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yamtHh8TZDsQ7kNvwEhWiJ5&_nc_oc=AdpHWDyCG0Ii-LZ04GutDiHS8jMijprbuw9GVsbavWrUMGh_0DgVGZZUc22cUnVfLq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLharosQQ-5kSOVYBdPpj8a4EWnx93RprYuVYcNzzG22g&oe=6AB91EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IoN-xZ6fOEQ7kNvwHG1pbj&_nc_oc=AdpGUH9pb_qaznToZ8rkTjTAcszTk4eGrUKtFAsKHeI8R2DReHqbq2f1zdu1jYzxdC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhjKNlKPPrU3zBVqLwKzDVkiMp61m8g8e8QGquhJu3iw&oe=6AB91E85"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6te0Uj5OTdIQ7kNvwH7SZmq&_nc_oc=AdoQWBxoaMdhN0wum33hGNkhyhl_SabiChegbTOjIcGwjcODsnVD20PPjFeHXt9QdBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVNvdNM0gIgS3dFE71ay4LeXYTbv3EFnRU_iIo-OjUWQ&oe=6AB90AD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pumnr9hNy8Q7kNvwFtMxMr&_nc_oc=AdrX-dwllolI3D7zmZeX8ZM-t9pjItlqII8XnAm9u4EWq4hl_Dy9xGrkriW_0hWKaus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzNt6yrs97ScDw0z4cC7gRM-KtybqGHQW1kJF82yousA&oe=6AB92304"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQYmdHh7JPwQ7kNvwGmu3o5&_
101287377528739009_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_1u3KCO-hUQ7kNvwFbGNBk&_nc_oc=Adp0htna9WJi3mTBb4TiU04K6GTu9PsCZHLxOJWzSEXxka3zm4yqpWKQOAuEvU39jUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxrRlRDH-0DTiJu9Got9aQtwUiYjxaXgzjTHqJBx26sQ&oe=6B072638"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHAcGBuRtQYQ7kNvwE4HjrE&_nc_oc=AdpQj4VCyHScxoDPNuRVmHe6e9g7JgH8LssIkDM2gNUZuTC-hGtKzAbogeSRdjDv5LQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoDESoIdKw6oOf8Lj0N0U5vd-KltxN8Xd-ZucLSfhvUw&oe=6B070021"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJKlwJPkcoIQ7kNvwEZ_IPq&_nc_oc=Adrb6HzfuWw5ixNBh57K3ljGMZ6omDS_Vl14WdRlsJ689DlOWcF-mmtl0MJylMS3wnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1qGvvK43x2RmMqOeAIDtfEtLJBjV2u223mNSR_vU7Xw&oe=6B071F7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ10yRYAe-EQ7kNvwENmxd6&_nc_oc=Adptjlp5Bd8WWkqHNoRxHqNNwjuFwsYww2RQc92Y1W1f_MDUTCtfNi5HwHKmylIB60M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6filRNfDiTMqO8GBmTTcQHTjuBfUHvo20K0QCTEPHNA&oe=6B071F45"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z03Bct2FEQ8Q7kNvwGjlSMg&_nc_oc=Adr6nmhSU8B98GXO2ELlspqbEhqD8YF9flOFI1Z268xek-hoUeXipKbSIRL2cuzeMfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFB14mLDLfIoN7yo3xJBLCQJ39buiDKeq-kWe0j0-w7Q&oe=6B070B90"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7rLwET1ujAQ7kNvwG6L_p_&_nc_oc=Ado1CvRXxlo1BNAWrvKrozyUZWntQkxerjYyHMmGn0SDuuAtz1o1_XlMEVoixIA8yzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh
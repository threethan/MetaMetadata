.com&_nc_ss=7f20f&oh=00_AQJYgzrkUVVE-IT42Wcp6GdS6RNhBWYJ5LrAxMEhpbMlFA&oe=6ABBC878"}, {"file_name": "When_They_Came_For_Us_Screenshot_04.png", "id": "487574967012495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_487574970345828_3654880068530869138_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tArY89SqcQQ7kNvwF7dlVE&_nc_oc=AdqttNHyKLWW2a0HM4cmkCrOOyrwRINM8VSDvZTeaTm92zGTojSClSwijbsBtGTvnTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3sP_yS2PIRZOVp0WeacbCJ-5f3sjYyRim6x44gtQfKg&oe=6ABBDAA1"}, {"file_name": "When_They_Came_For_Us_Screenshot_05.png", "id": "1189515912080105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035335_1189515915413438_7609265572700002405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IbJR06TSbkQ7kNvwG5BFRz&_nc_oc=Adpik3QPLSEkXxPf102YgbwBQg0rpmWc5sp0NAEO-Jpm0A3eu3GaqledbZy_jcmaMJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK50VqZZMelNZnHIZS0yDv_SkLBXGVp31qi1hZv-cM7ng&oe=6ABBC1BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "When They Came For Us", "keywords": [], "long_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. Ein Gespr\u00e4ch, das vieles, was du bisher f\u00fcr selbstverst\u00e4ndlich empfunden hast, in Frage stellen wird. Aber es geht in diesem Gespr\u00e4ch auch ganz konkret um deine Freiheit: Wirst du es schaffen die au\u00dferirdische Lebensform davon zu \u00fcberzeugen dich wieder freizulassen? Oder wirst du ihr ausgeliefert bleiben, damit sie dich nach Lust und Laune benutzen kann?", "short_description": "Lass dich auf ein Erlebnis der au\u00dferirdischen Art ein. Au\u00dferirdische sind auf die Erde gekommen und haben dich und Andere in ihre Gewalt gebracht. When They Came For Us ist die erste interaktive VR Experience, die es dir erm\u00f6glicht mit einem Au\u00dferirdischen ein Gespr\u00e4ch zu f\u00fchren. "}, {"images": {"nodes": [{"file_name": "When_They_Came_For_Us_Icon_512x512.png", "id": "3868352553489513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210395_3868352560156179_6455226502545884092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK4dcoACWLcQ7kNvwFkOgcl&_nc_oc=AdoJW4zCXqdr4VUHEtnORDEHlQzZ9rcBCOklMumJ882clcU-gCcKRa0NobgmoOYWkho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_RmDjqvzOP2HEnkmBq6FWkVmgnKs-3PldhY0RzhogpQ&oe=6ABBC185"}, {"file_name": "When_They_Came_For_Us_Logo.png", "id": "3396177717347236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404385_3396177720680569_8150397944653824923_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6te0Uj5OTdIQ7kNvwE_T88F&_nc_oc=AdornafXsjNzOIGM7q57qAFreEXwE32YQ34QNNiLwkrO41UYml_gvv4Hjuq4rgglouU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKthUoY1RuKxF-mClou5HkPgv-U_rgZ-470Kdc5Y92isA&oe=6ABBADD0"}, {"file_name": "When_They_Came_For_Us_Mini_Landscape.png", "id": "1914618305655529", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610562_1914618308988862_5514753625182742910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pumnr9hNy8Q7kNvwG3kxfu&_nc_oc=AdodCLUaYHxSeVEOWmq5DfTpk4Cce7_yKATd2lC-QYULptxnWhmdwt_EClbZ6_5OkKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaKVGjG-GzddkIM037dKBk_BusRls5Pn6tkqqc_8TXTA&oe=6ABBC604"}, {"file_name": "When_They_Came_For_Us_Portrait.png", "id": "1669406180481677", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_1669406183815010_3382518706062350164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv7ImcMbGtsQ7kNvwEU9wMB&_
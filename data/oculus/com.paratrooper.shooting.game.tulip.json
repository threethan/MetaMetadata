me": "6.png", "id": "1873031583309953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_1873031586643286_1947501056258392492_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-mtPgwYDygQ7kNvwHE3ziF&_nc_oc=Adp2bhNN2AmvrOxkp-4BEXWYclq1qOmfaMaO8E6Z-CFJOxh4AQ9locfHDp7li_gzwJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1tMqvJ0pjnrmOBPYxXI5hrd0gMsTL8RupyWa_iQ1k5Xw&oe=69F0B6ED"}, {"file_name": "4.png", "id": "1107233444854509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1107233451521175_4269948113450723304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD6J1SVvyc8Q7kNvwGMPQ1C&_nc_oc=AdrVhXxvZrdCUgF4lyGVP80a1trSm-D6C9XRmiGGEfbA00_B1Wy3258GY_Jchx0xdIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Cms7b1p8VqJXxBIGNAV2gNTuPpJgq-xD9OgMpbzW0AQ&oe=69F09FC4"}, {"file_name": "1.png", "id": "2041747329931030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_2041747336597696_178723168296540016_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX8L02q_70YQ7kNvwEXtjYS&_nc_oc=AdpQrcP7_mZljZSFo3iz7yrvNdEs7W_ww62-hSQ0zKRXdpQ8OlQ4EG8jVf00vZGeVds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1AsQI-BFjurqbOpHCVMYSWG4i5CQzGjJciBKe3pZbhNQ&oe=69F0CD3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paratrooper Hunt - VR Shooting Game", "keywords": ["Parachute", "FighterJet", "Helicopter", "ShootingGame"], "long_description": "Prepare for intense combat in Paratrooper Hunt \u2013 VR Shooting Game, an action-packed virtual reality shooter that challenges your precision and reflexes. Armed with powerful weapons, you must defend the skies by targeting enemy jets, helicopters, and waves of paratroopers dropping in from above.\n\nEach mission drops you into multiple immersive environments, from sprawling deserts to dense forests and war-torn cities, where enemies attack from every direction. With realistic VR mechanics, smooth controls, and dynamic aerial battles, every moment feels like a true battlefield experience.\n\nWhether you\u2019re testing your aim against fast-moving aircraft or holding your ground against incoming paratroopers, Paratrooper Hunt delivers nonstop excitement and keeps you fully immersed in the fight. Push for high scores, survive the toughest challenges, and prove yourself as the ultimate sky defender.\n\nLock, load, and hunt the skies\u2014can you handle the mission?", "short_description": "Paratrooper Hunt \u2013 VR Shooting Game puts you in the heart of the action! Take aim at jets, helicopters, and paratroopers across multiple environments in this thrilling virtual reality shooter."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31659511750330546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1299107314810038_8687720438381882527_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmcjiKu6ET4Q7kNvwF7O28G&_nc_oc=Adq-M4-ggF2BRYkcbRD9JMbUSgK-9thS-svd9WD-USMfdWqv6XPiXLIAyTNt0OyLQxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculus
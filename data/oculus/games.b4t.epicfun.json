4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usoWwmLEq68Q7kNvwGt9mwb&_nc_oc=Adr_x97kui2FQdG7uJtl3e_Jp8JrsMG39kxUCc9XX0EAd2bSxGKmTgcUV-RJJtWZBm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgEhIvE2c1YPTQ6DLNvTKBVZvFGXtxlfQKlYdMREFOqg&oe=6AAFF622"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJGKmZ6lE7EQ7kNvwFdD3a_&_nc_oc=AdpC40Wht-yqFwcE4S7roAQnsGq3pq7lPrTbN--5aWM5GU1lXq3H67SS_Qyjb6pLKyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9tW-93K52_7Y6DDY2Hfabd-XLD_XhhWeys5WXE4WCqw&oe=6AAFE4BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5IBQRkb-yoQ7kNvwFtYr4A&_nc_oc=AdreN2cSlJEx0UPmuFmxlfgkTscMAqXqV6CQlvd6M1nQtHDKTAr66A87JeZ0lqaHVn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk908BBZ5kDTN4jv6WYS4Gebd3AZhbvNooIhkamc2J8Q&oe=6AAFEDC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXGosEAppggQ7kNvwEj381g&_nc_oc=AdpcJ4_OeDe-K61KJM-XxjL0x2JlrXDnQ4g9gJNww29CEgfpa66TIe-SjkviAdpQATs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV3aevS3abirJvaErEsllck65J4OVaaKyvFwKrhliscA&oe=6AAFFCD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lo_cdoB3PR8Q7kNvwE4ysDw&_nc_oc=AdpC-UPl0g2ZTfyEc7YWOIC8qrA2kn0tMb7oE3eNax8oNL1XD-53ZavSBr8LBLJnf3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLclde7fkdKSsMaszPfEcxcsPT9vl_XL2fnSw6QssjSjg&oe=6AAFEB51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
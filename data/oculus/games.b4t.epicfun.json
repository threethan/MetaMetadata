4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BEwOfbNT-4Q7kNvwH-iQI_&_nc_oc=AdrWPQVEXLHrnlIGwRJC5WeMprDW3ekOOQ-HPdWtE4YFuXeGp6fMJbgdfZvRZpgadKQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzut-lD4uuj2mp-KKWjZcH7AzTYNv9nUKGWptrZJDUXJA&oe=69CBAA62"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTF15L4G33MQ7kNvwH9UCvH&_nc_oc=Adr_5aRVaEGSWj0I-SinGKdCnQLPOTVBSEk4wihyO5p-S9ajD4N5ERFHJmB-0SaWs_o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJiOqoF_3Szt3z-VqMPy77altndcr4QyqYZ2kj92j3CQ&oe=69CBD13C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1suEBHMLe9EQ7kNvwFYwpZT&_nc_oc=AdqtopzVLAFDo9Xy5DSiufdKoJ3rytINC_b9Md5H3LjdGGEgiibBQqJEdUVcUL6evX0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLrU0YY9X7wZynqzv_HIVsCkuz0lB9dxPpqNkNffssmA&oe=69CBDA43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9al-S6ozSrQQ7kNvwFmtFt4&_nc_oc=AdpJY1834sDdHrii5BKGPxyyPxn-UEfru2sP_WQ7GMeshWRrAWM3ElDKlwIpFMMYYAI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaDyfwdcyvhodyrNgQ9-5oWFoR0-foMgZg83wNJTVirg&oe=69CBB118"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUhv6x0dEaMQ7kNvwEtLsus&_nc_oc=AdpIbfySrn8Vzx9w-vj2lx1F1b5Y4UyQEQdbcukpjsPVz-kIhRX5Pw2RMW7tDTfTjyM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6aa1T-TbUDMWR8X46841xbBsBt7-b5Nv1knAj_2iJIw&oe=69CBD7D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
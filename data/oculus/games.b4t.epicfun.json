4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTvQcHdf1hoQ7kNvwHJ9_u4&_nc_oc=Adp2GWBdXuqymlwdclA0SgnBY1ZFtK8Vws1L1Nr3KNV6pyOcOli1P3Dii3hMerCiPVs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AfdJ4yDgyFs9VChhIHq1Kr_YIZ7WI-Yc7ZZry5Cor8A&oe=6A413822"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wURxTY3IlpcQ7kNvwGphJc-&_nc_oc=AdpP2v7P_LwP6ghWRSH60eVZnYzMyqV6H7pmb6F67sihuPVL0wIpzhfnGXnPo4AeO7I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A8Ab5TT2iJiYyFuKxGSsu635TdgdJ1UMLVF6jPOFkkw&oe=6A4126BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0Xfh14-E9gQ7kNvwHWU3Mh&_nc_oc=AdrCh4pc6IzNdjc-Qqqv6eqQ8dQsXoZbXMuI_B-0vu2zkOGgerB9tlxTe6JEL3NoCR8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QcKbTQuyI_RcGO65Tf0b2yFw3YVufEYA3Qpl0iZD5uw&oe=6A412FC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOoRGufYF4IQ7kNvwEfZ0j2&_nc_oc=AdquHQMlrlXmvFcHW_qT5fPckzH_TfGRH9ZqM3WarwKlz9_SnCv1bJ0_cQdX7ieVmGM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-LDxk1DloHu-j4Z6qV25EvnKBpg3Ve7w_tRxMlKPFsA&oe=6A413ED8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VfC-9sFBYcQ7kNvwGUAO-X&_nc_oc=AdovoHXHciAcbEY6FWINLfoCdcgmb-2AfN-M0oU8J_CwtKl1dQk0q_PaG2954EP6JmY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tmOdPscXj8C3cgSYXH6_wnN8gyzCQvrCmojckUExqVg&oe=6A412D51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlqPSTgag7EQ7kNvwFpKzY7&_nc_oc=AdoR19RbiTE5roV1FEPjI1cym_dkll5NIrB577sXJufzcAfIy-OqbKp9JxN7NZ926sE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af942IRJfj8pmgdbpS832Z6duekZ2FgZ1ZS8ZRPoJpKQ6Q&oe=6A47CFA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12R2Qkqsm-IQ7kNvwEp6tUN&_nc_oc=Ado949vROh2N6VlXzfFsoIA8t1tFHpDUsXb4rTi2tufr81wMHfVMc_vrNXpMi1T7FXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vyI2T7LlwKUB8qxfQ3QEE_fbTqc3x-LXu1ou5L26UIQ&oe=6A47BE3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG2a1pcQj54Q7kNvwFUu4SE&_nc_oc=AdqKGthnh05O7VAOws3NLpBCF73UhKfdKEYKMOSp14yifGZ6nUI4V2Z_VWlijsWcwKw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n-NG9rOyPX7Q8JueEQ3fGY0P94EtUJqV1W8CDcsGgXw&oe=6A47C743"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIOBTYWIFAcQ7kNvwFMWJgI&_nc_oc=AdoBCCIciPUERduBa0UBe5FqiNedD15S6BzkIJMEullvoS1u1urC8J8Ez7wQrhYWnOs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U6ZwbFK2_zd2ils5AWTJDCSGc6WkRchvB-sUWvGwjGg&oe=6A47D658"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kngSnuWHw1MQ7kNvwEKPEZ0&_nc_oc=AdoN2kpjNwDxGdpTskUbYYbAvezW80aHZY8MEO-yxfOwNURq_pdHGpAHHi4FIbRIsy0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DcxavZtDVBZJfwVo5FTE8e5nsaOYGq1JbvS3KJa2MLw&oe=6A47C4D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYfMAuwjWE0Q7kNvwHSM9Y7&_nc_oc=AdrfIfKnUoG3PCbjzgKeIS2-R8E-tlJbJdGjb6Uq6J2XDHl_LIIpGr2lAnZHb7nchlQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27rsytmKipSccSLxOqRht8llrqMsEyMuLu40TjuFxQ2g&oe=69E640A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyayFsfKf5kQ7kNvwGCzoAT&_nc_oc=AdpBCWjldvMhpQZJ9a9ltaXVj5HrQrYAC2LSc90huuA6Sp5bKCjqnSCmEti2Wwm3Cro&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nk2jcn65JhjDzrSdxBTOfYIrbZsPO_VY47Bi0s5ugaw&oe=69E62F3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHtgvqzK0A8Q7kNvwEVtAz9&_nc_oc=Adrg18r9ajGtgTZ7aeqWIx9kc_KBdUj72UI-IeEmaedIvYLUCbcg6j4Q53pAoF8LiPk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OOrjRqdSRN1GtojseJYE4oG5IGp7fAa1e-LCLfcxx1g&oe=69E63843"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTrTYqEdPh8Q7kNvwFdkVTS&_nc_oc=AdrCfchO9nUS0smNHKKMqChfpu3qGHQ0ifzJF00xt3WTeejcCWUKTYziI68HwoESayo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af032UHk0VF-tzOTW6bUo5qbg3Iy9dgP7EIBc9eD-5o_6Q&oe=69E64758"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvdLHKzWQUYQ7kNvwEEL-sw&_nc_oc=AdrAnbRLEBqWKONlAF8egTbEhWLH8PTob8i-lmGVHbQRkkk2ONSSOBdh5SR2t7ezl60&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mI5yFgWf0yQGBEIwjZopZtFT3p30PSeY2tEOFQcQ2dg&oe=69E635D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
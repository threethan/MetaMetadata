9F4B8C3"}, {"file_name": "migrated_image.png", "id": "872240139867614", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dy-kYRanCNIQ7kNvwGBgnoI&_nc_oc=AdrCiH6_YIZzuWzljBN2CEmGTWxunFqzW0tlIOh-VOrYH33lIb3z51XopG0yuz6Ea1o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RpWxczWGHIlLHcnuOmyblULXlr4_tLulOSVC2NZDF4Q&oe=69F4C7D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/160mg2", "id": "2705960462757174", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974868_2705960466090507_6493344025829965824_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj7V_2UQZ3YQ7kNvwEJPnOk&_nc_oc=AdoS-kw8xR--q7qED__1mbDHKjs83BiqmfoIjstKSr4Kq6Ig7aQE9WQm7VBmpAGs-JQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lUpNN8HTENVTmjEu1s-FiDj1ZElIPznXoISjoP8wW7A&oe=69F498DB"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n
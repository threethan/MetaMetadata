4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eJkU7T-0tEQ7kNvwFuDdjH&_nc_oc=AdplbekVWxjYi5vJwGAIouGC-Jnb2IyTMm7Bk2cq6KbTJHNUQkAqHSEp_RdOEg5RdIc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zROErsKSmrjEbDPXJafX1zl8k28gc0-qINfoxgbwjdw&oe=6A32B7A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGjPVa7xrJwQ7kNvwH_UUyz&_nc_oc=AdoUI30YSniYk7yR2QOC-skCMm_jC5zrMLEquRaU83wRntSEA9sAPzg4mKXH7Esn6jY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VswaPcmrTY_mbLV0wBf46FQ3jeakMVtfN4BgWqSNfCQ&oe=6A32A63C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mksZxsp3S88Q7kNvwEeen1S&_nc_oc=AdpjwwOjtXc0H-wfKwAqVkZ3kjWbQ-EreR4y1xAjWKi2hkX6YEQJ9v6bZUtY5WKKI34&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GVnDInJ2OGKxvbwjNH3wMz56nCw-tNy50P4h0ybGjZA&oe=6A32AF43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuFxs97fRFQQ7kNvwFgM4ji&_nc_oc=AdpvRqnGBRJ9UCUSzDs5_Fcft-ErtydasVjzNcI1Itx2ZFKEne6DEcMz5ABRJrAMRPo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1SYYDY7vnTD4IE0bHhyZ1r0fZ1mast2UBo_Xq8Tvdsg&oe=6A32BE58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjJOkKtsb98Q7kNvwFL-f3T&_nc_oc=Ador6Rd8HHh_2IHGfOPkb8_DcDk7N1Qf95LrOmaS78D7WcezbEyK_V66PzROvIiK6pc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FTf8-sOTK3DqUrkILTUvP59UMyd0QacOijjI5QTihZA&oe=6A32ACD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
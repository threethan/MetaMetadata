4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1Y8hdXaFnAQ7kNvwFLNyXt&_nc_oc=AdowF-ZtmN4NDSWpC46OfItb13tfX55mPksc66HDlgVaH6GJ9lH722m_BuyWgbYcP38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdKTqFhdKxQSqKfFNLM_YtehEzXRw7cWwY5Ddj0TZvKw&oe=6A9D8122"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRNhrhqW6QoQ7kNvwHVmhxI&_nc_oc=Adovb2ocZwYBhsIcYSnsE_o-1kOVHS6U-NlZ7CHhBdZ1BIRu6G2eXnu2hB6-LU7Uhzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrNF55v91OX4OfXAle40k8T0hXeptm1BSGY0hVwVmdFw&oe=6A9D6FBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2TdXlZklW0Q7kNvwG0ie7M&_nc_oc=AdqIq-3dVaMPjrLD2sReHHXHJWPAHHDF6-HxWvzsMomQkaRW7VYlJWVGOvVhXSr4m-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDhqfR2FHNZOxSuAkjEJMATOltETJY-JLTA0hYLsMtfg&oe=6A9D78C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOCZm27YCfoQ7kNvwHINvHX&_nc_oc=AdovozYrbtpnwr7jWSXK-d8rqWGlNE5oNjBx5LpDA6UZ6tCu8FoouD-kiQjL_2DXvEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5MiskLvaSZsEhtWL5NuYuaW-pzddkLceU3icu096w1g&oe=6A9D87D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWkU9dCNevIQ7kNvwFhYQrT&_nc_oc=AdpkmFEOo372GDfcZEmis3WNQx6PHWL1Bj_6fAWKExJJ_UwSSzCRO7LlNJPa7Fut8aA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeRns1Tvy-U8eaBKp0uuHNsfkJysI3LrZ0eCjyveUIhg&oe=6A9D7651"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
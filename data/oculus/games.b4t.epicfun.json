4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU4I8CdtWXoQ7kNvwE4p--e&_nc_oc=AdrW7voHaW3hMp6qaNqSaAXFtgG0WgYlQkuhYhVo246O8rm-abK2xnVlL-rgeVXq4hU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO39V106PcVSOZwEWn8uR0rCCqVemgOIDTAVjHIEaJbw&oe=6A71FFA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VO6Z5tA6y8Q7kNvwEksFdS&_nc_oc=AdpTrmc-Uq4rMkkRpdOuhuhoyOAnrPR3ZUTMvPENfdpFwlZ1VRVBV6rsBjZk8b_cU6s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtwXmA3uMVrlSqAIGPJHrBnN0omHJ0WzooCPvDHEnTOw&oe=6A71EE3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOjsxTbzTgYQ7kNvwE_DnLe&_nc_oc=AdoLKNT-CB4WsXvJMigQPWjqAe8wyjbK2OZXRjIKcrzWf4tXryrukMdz0vAu1mVUEyw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtPMois7NaGjxLHVKwZQgJEoeUR_3oAsdazT7uz2n5bA&oe=6A71F743"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNZmQXJJh8QQ7kNvwGOdD9C&_nc_oc=AdrF3nsiscHo4wo8SAeZc0wpDMrpFfvDY3gIDCxjrXvecEX-Dt2ecwXnqlAzuY8oT4Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeNrDS8U6Y9ruWFW1K2CabF64uEVQJRmpscbn0LsGxAg&oe=6A71CE18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-HpBMasYrQQ7kNvwH8ogNE&_nc_oc=AdoxU20tJkukNLGgUK2l31j3ksaEaY_458UkmyvOWU7-xk2lzro4g7oF9AX2KIqeZKA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErtBjZ6BwnEZuG130SZc6gBU0eWg0KD7VXhWuezLyuUw&oe=6A71F4D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
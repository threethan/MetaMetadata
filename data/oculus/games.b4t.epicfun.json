4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f7YzQSYp1sQ7kNvwHAxXZd&_nc_oc=AdoamkX1shEYDStSHKDbA1_i0ChKCeb5UPaYELjnSRjjfoUu9ZebEBg3GFBKWxKkwGg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR4Omcfcc2twI8G2mIKwuxRNOkn_d8b6C6CZqV0gwhyg&oe=6ABBD3A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-JdPfODI1sQ7kNvwFUV4zw&_nc_oc=AdpymdaM3UD9w-EfZaYZfvZKaajPoPi5NWFjDfXWh2mrgqh3TIlSDy_BOdGJCGTDjd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJobTYFTkWGPkEPHzVF8bvX-BeX6Wc2mr-MEbXUh-NWww&oe=6ABBC23C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVAUt1mwdyMQ7kNvwHHY-j7&_nc_oc=AdoEzNlM7pdS-LaozZeSzauWmE_RyLCiHOKXyT25D2bfZFt45aPRkYxPZfeUJt9zQCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuTPIDwVbOvBUPfire1LbehjBf0OtUO4FVeHuUAhUiuQ&oe=6ABBCB43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q051iFBut8Q7kNvwEUeUX2&_nc_oc=AdoVcQOvLt4VRtQbbIgQyoUU5u0PrWji9RdEVNP1nlQAQmBgtuGLTw9zlbiv-5dnxxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUI6Apv7m0CK7G3ujHnbkvanPhTH1H_MoOpeIICfTKwQ&oe=6ABBDA58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dWo10djWQgQ7kNvwHbazsg&_nc_oc=AdoVrmWfoutslqzNnPSDndYDQROD4fz4fuGX5kWO4g4NvjFE6vN0B3OMZPpsEi0Ibpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINAUjxMEUx8DJNakAtu3VPmTxKw8CHdRgQv9f0cixyOQ&oe=6ABBC8D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChiLQUHxduwQ7kNvwE7L40_&_nc_oc=Adrjbp_t1_ISoS6_NGkTgsHNVOIFHzgfkks8nqG3jewjbYlPJGvs8-ufPLTRkGflMmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97sWpQM1u-A-CtETlfUQNNingohmlJ6ZoB9zLSQ0NELw&oe=6A2588A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvPppbhAY84Q7kNvwFvrwrD&_nc_oc=AdpfukzMe_EGv0eZ0211DmtH8PGhnbn7S0aCX7oLcyvF6V5OXaiPbWixxg_QLtrpvXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wVhBxSXKQ2vqOVHllQNYYdAq0GV-RNdhkKmSpUu7mSg&oe=6A25773C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vICcmjjymMQ7kNvwHIy8DP&_nc_oc=Adpl39tgGn6JNFR0yBTirC5IReeUA6xJSa4g2J7RCCfZ_zjVv_R4aqa8bHeu1eiJlNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wYXh-c4yf-ckVrJKc8DZ2X5bLmEqY5MlkyEA1ZXQvRg&oe=6A258043"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFyfJkcBwvgQ7kNvwG9oP5o&_nc_oc=AdpXZIScUCx1mQ-KEWZKqUVOJOcxjsevAcAyjKBQQ3POHzwTY0CKkS3HtEMJmaPORog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_UDCuK9j_ta3Zoo9uVl2vwSYdU8VhmUhZALFuSHKWqg&oe=6A258F58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y7YRk2A8dAQ7kNvwGIwldu&_nc_oc=Adrkchl7uzXMJc-5rXRB1HO25e8zAu8GD7WplcZitUzy0rBP8Rr0ymJAbDp4hem_Z5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2SyYnn37jJ5Pe-4vutNOlZq8jHWuhZhSC9aFU6pzpVQ&oe=6A257DD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyA7Nv59legQ7kNvwGuAqmc&_nc_oc=AdqeuRFod9d3fMbpg_wtZu4dRqm8t6tah2_35SO1yaDHRiFNolzeGa1UQptCLWAvKNk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_p2uy52aGAjvNxJTtnKwwJNWCO90uUoam0enR8CEiIA&oe=6A0F1F22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmZ2lsCjQAQQ7kNvwF7N7Ik&_nc_oc=AdrQtu0hMZtjKhz-9sg3Z4rJ3DdSL8RgCpjJxV-yzc_4hUqLh76iffF5fsE-mm4iM4s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67g6nTDZfJd6s_N8BnGUpnuyCcw3df0U8y_VBT56Yl6Q&oe=6A0F0DBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUvhYAfOkLgQ7kNvwHWQc7s&_nc_oc=AdoE5Y9jNUl-u7P8-bayzKUBWcTqrkfPPCVv48O3jIEp8ns2qVZ_sschnP16XDcLo0A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bIa1PcJfuRPBUPGx26Ieisp20KnGAfCkxtt6ZO3kWhQ&oe=6A0F16C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwltW_0DJskQ7kNvwHElQZT&_nc_oc=AdogKTLz4w8Kn-l6muh4sJDB5nffTRenNIaJhUhuo1JD7beG9vMqzeqxBsx-__5x70Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l5i05Nhl3T7vhzUZoKFNsh87dQ7wP3rO4qhEqX3lU8w&oe=6A0F25D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvkUEBUhDDUQ7kNvwGz-XqK&_nc_oc=Adr5A7jSbOFLVflCf9q1IjdLm6RuUYOKUW5rcP-8exKLdrTzxvTbqBWa4-HjV4mY-38&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rSDRvyA6LmAQIFS9lAv2UifSb4iaHuFFjlUOwZBaLYA&oe=6A0F1451"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
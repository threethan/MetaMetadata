4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-dz4wcYtn8Q7kNvwEsuydM&_nc_oc=Adp5OSHNb4BXMC2FMY6QBULdARpPCrCsQdz4bpVtTubGo8-p872jXx5er8TTK_DrYyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyRkzLlVrZtr_fOuFytJJE6KNfdNZKBSlnN2-H5q-yZw&oe=6A898262"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj3ZyvcqfVMQ7kNvwGVIyJv&_nc_oc=AdoVLrJBBaaFgfWmxzRiw0c7Ri77khPgCJsF7EbYWNKM4lC1r7j40Wxp2zOoRroZ1og&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgixx0Cupeb-6UGwy2gF7ffxhyQA65JzyZDPBYLfxP5Q&oe=6A8970FC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRMjsFIHJm4Q7kNvwEF3u-o&_nc_oc=AdoErItLMoL1l-y0eMTAq4_4bSAHlOknx3Dgh2jkeTcXY_N8Nj2mQFXjQhp1eJA3wng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_JHiVMZq7HZZB_dPvJS7gOFuaPMTQkF1paerOb4bBHA&oe=6A897A03"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfJi0ZhhKMwQ7kNvwGCdVB7&_nc_oc=AdqVUPsrPKD2HYlV0nDgAVdrM0QUf0mXCNAlCRh3HEf63hs84bBAHkUiP9aNaZpmxQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8czmINLfnhCejAIL2JB7ySyc-f7XnydPM0AmmaZwkfw&oe=6A898918"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSWztJDsXO8Q7kNvwFYQ4K8&_nc_oc=Ado2D1kgJPJXIjxe-rFvEGIPAxwpn_6vEAbPlyrnoeCTsyTzZ88n2zbp_i61YRaRomY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJGh-RUW9Vk5n8KcVplUjnGZxwjfyj2FnH5e9EOYix_A&oe=6A897791"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
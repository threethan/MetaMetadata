4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw1YttA6SnwQ7kNvwE5HvcJ&_nc_oc=AdpMs_kVp0Cy-6jHa0Qldr7g3843-BHdXbB0Ee0Ltn-scFsWuPFpFSJdWcKaCqef0f0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5cG3HGzxZYgdbhNMzqVHVe1J8omoG0Wlq69ruD6MeiQ&oe=6A58F322"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZ5h-zHFcYkQ7kNvwGuOc-h&_nc_oc=AdqEE9oEX4KJyGhOTJmWLlA2jC96s_Aax4fllBbK9B1w6hU0SkJHXNO6xj7rq3ioGrk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUGJdcgTvY31BIFgcShPSg8XezDV3B34SACvwHaEWJLA&oe=6A58E1BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKlgwEiC97MQ7kNvwFYScBO&_nc_oc=AdoEC0xMzKpzP-31QCRB6Iey90uR-KZG6mjf_fcasMwtMItC6ESehkr3ajuebmJvLzE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdeW2RlGIbcBMfv6KELu3PBmsEoxlKws20BPH3rjdxlA&oe=6A58EAC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duqIpnaI1GMQ7kNvwFHyl-W&_nc_oc=AdrHkIV4b5t2jKmRCppfSLpqIo6tnHu8j7x_2dzEaq7EDynQxr1I2gakjuF547CvbjU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2a6M7JfLKpddC-VKSqQkNafN1utIyhT9AqZTiqk1Ogw&oe=6A58C198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKAA7GSSW3cQ7kNvwGUb-fr&_nc_oc=Adr5__qKKLieOF-UGmMYh7u5tGZoMZ8BPAEJHp-DY8rzQC0qE5E-k12P5eZhQfqqros&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbAJg8NC2ozbAEl7dUcjjj2YhEv8-8hoFF2eDy7qOhjA&oe=6A58E851"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
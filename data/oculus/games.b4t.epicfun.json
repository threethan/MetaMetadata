4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYWtKyi3hVgQ7kNvwFksRcj&_nc_oc=Adq4cad-ahYFfIZsBwr2R_yBEcgIr27qFTRKjySxEVbuhicf01cpybIYWu1sP-ojlRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wMuIu_Tnwl_Hvi6VB8FCy07KcJuPh9UwKQ8aOUEFn6A&oe=69EDF162"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEr2vVxKTIcQ7kNvwHvoiTB&_nc_oc=AdpUelyI9p9v-iWCEhIWVGwjYDs0WXU-aGClcOdjQ1ZNjanssrQ24BS3x43nD3tK4w0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y48Z6kyZiUgEq5HuDQLldJmlE4uf7fCFarz7MMDEnKg&oe=69EE183C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PGqNrurpvAQ7kNvwE8h2np&_nc_oc=AdprEDDPCioPPVYeYEF5k312unwnjcCRolnaMJj7NPCFRvOX5DX7pWqu_CHG-dTn-U0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TnRNNqYSZaJE_Cm1hN5GxhK6mGy2UGULG4AKVDbR7iQ&oe=69EE2143"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzlyDpxeAcgQ7kNvwEarqaL&_nc_oc=Adp6ftyiBi0f19q7d3NQ1wVz_masKgMfEiPsl7gR6ZWeS3mFyCOzaNY_tE2M6KnBLBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iZM2sUY0OWrjNP0f7LVqOziUaeg0zX9qqpZpj_uilWw&oe=69EDF818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdG0L7UdxJ8Q7kNvwGrISkm&_nc_oc=AdoRHxToueBImXycTvMwTSZRa8O8hnY11UaXf_gsFl3zcQn1wIbPmegxLwnt_dW6luc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24XgeuHbCLBGVyH3XMXVK-M7TKBPm5-pFUdKo4a4pBAw&oe=69EE1ED1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
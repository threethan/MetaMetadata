4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lf7gN5mqoPYQ7kNvwForSeX&_nc_oc=AdoOLwCR_jkMi7pFyIzzrw7nETaJkYNzmlVrG_viNmBfP7uwzFErByrtEvntkxwGhUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNKz9eKs3tPB2uONA9b-OzVzn7jWV_7UZEmqZvfA3VXQ&oe=6AB7DF22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPhHnbW4XtgQ7kNvwETVz1r&_nc_oc=Ado6Hp-CN5gZzOtywEpmWM9m5MJlYUdJRco3EQGGOulFFZeC7H2vzZKLd0P4ZxeWAgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCddC5rIIJw_2gUjSacsCtJLMIYonv0Y72qGY8pvJRRA&oe=6AB7CDBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUF3NJPYCWcQ7kNvwF5gMEK&_nc_oc=Adrb5pJ20B8bVVodZQqCLV655Z-ypM-gVB8ekVYPJmBouGF2nFJqUZoGyTcPpedGSsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeMyeCKUHpJMIupNRpQvKuNn3HzYXSSsFOpP6DKNeuZQ&oe=6AB7D6C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOI0L1ve6XwQ7kNvwHh8TT_&_nc_oc=Adp-HeZrv3O4uDxk_rChN1uPU5m3ckbHOfaDYe06HYu0mDRvdbuCa05eX9SniNi5YD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCp_Lele9tkdTCtVqmhscXNJKRWw0qHwRw-tPMGzFc-g&oe=6AB7E5D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF_t2BCVG2AQ7kNvwEnxWiM&_nc_oc=Adofr-UG0VQ-tsGdyW7dUxHAEJ9KJVlX7JoGXNSyckcJGcxwxZUhGO09iczBqEBNiXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt4_gBftcGTrHLhvWTxeBv9WYL3N9IhK4Nty0ncuKz-Q&oe=6AB7D451"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
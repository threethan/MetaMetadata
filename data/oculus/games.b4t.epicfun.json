4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDU86kh8nCAQ7kNvwEVbioo&_nc_oc=AdpWTpnVvu6LOcIAbshDBRgza39s5VfWitCIPvr5C4ysDNgZhs8j_nJmw8IhXS0ADUQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu_FymWI5jhypgOZsynDn_80Hv-SrNPNkZE7TP-ELX2w&oe=6A819962"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsx9Neqdm04Q7kNvwEI6l3M&_nc_oc=AdocM6glaRpJZ8kejZGM0gx4kR8n2xz4Y_Xuq7zNp1nMIfVW4AF2QlMTmedrlhF5OJM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJlSIATba_MIhnUFWXuc5TqTWXglmB6cXrPnSs6nl1Eg&oe=6A81C03C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-p8CVYg68UQ7kNvwGuwxR9&_nc_oc=Adr4qDhcL-oUHr6wPirWTwP2fXEy0W33Bq5qC769QbeKoI_KXvfmcRC9GDHn3PQ10t8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH0wr3QIUOdK8u0NzKNsPYxV0CDV3tFVdGUl99uCYV-A&oe=6A819103"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlQe0lwKMIYQ7kNvwGCNhxw&_nc_oc=AdoqVdftBOxZzqaeU9EcWU_eXeVknjmvqIFpmoKbnjT8RhbcJGt5WgPLREgChMdYe38&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWJJhwTsOQwxntS_gPYVRXkc7JFNDDsAUNKJTYa_YSrw&oe=6A81A018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG1k8Pntah4Q7kNvwHD3HL3&_nc_oc=AdolMr0MPMbw824Np6vZAQpEaf1OLoccCJCwnfVNEauQN-umEXkaHAS-DRrOOhzx2Hc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV9cm8bldVV91SBetuKG7m_xzoqwaXKA4jQQnm_nA1mQ&oe=6A81C6D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLed6QGF2LYQ7kNvwFsWsZs&_nc_oc=AdqsnvTSorcfjpUdv3xOf6H3sFgQ2GcaEmPzVrNNZwAx2jRj9p2G-rcOiVoBysThYiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwe6LxqRlBsFqgZ1_E8kdiG5G2qT_nI384KZitm0sOW3w&oe=69CE4D62"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3Rgk5ltCGYQ7kNvwFnqwtg&_nc_oc=AdpUxsz1AqG1xKsdDILY8SCVoC3hkGLYthnXw2borqR7GPEkReAkhmOeMwrde7dF0Jw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyuoZCxPZIIxMjwgm2axPTCt2BlR2y5kPDWQ4tWG83wA&oe=69CE743C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el1VkmrdD28Q7kNvwFythg2&_nc_oc=Adr9fFUzzPOx46bRa6aHBWkYcdlxne00hpuRaMkX3lHfEfj5ux3oQ3bht9tbo_kHAkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxlbv7zekFx0TRwmcM57NIW9V-KvpByUNJoc1vWagLuUg&oe=69CE7D43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSg2Hp5nSq8Q7kNvwEpftw4&_nc_oc=AdrNEnZNDLHYdQoY-oYOjYM_KmY7wFEL8ouP8b1yBHdiqE7KqbLDRmm02yHYwmFN1gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRK-l4h8XNky3sAnXVvI4tjoFkA631jWmPixah4PHkng&oe=69CE5418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUhv6x0dEaMQ7kNvwEbWkMC&_nc_oc=AdqRDKLU5BFgCEXJf4tlyk9pJtfYi3gOznjHg-irjW5ZPJAVgNpYZflYwfHIM2zkZi8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9SjXBuEyHBTy0jtpxGnaVvm3B6P9ASWvz4d_Fpi0qtw&oe=69CE7AD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
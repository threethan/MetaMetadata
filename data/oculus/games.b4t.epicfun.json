4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgMq4Omf3B8Q7kNvwHBnsKN&_nc_oc=AdpDHrPr4eL_5xibQqIWbdjA3OkR3wa9EqA6gWi67TkHz4QUndkRdmWV-SWaWk81qaQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu1Ov3sPsmceSrvFKRsj-rr2OedoGRZbRpWiEHs-ti1Q&oe=6AA02422"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2r1P2Qks4EQ7kNvwFMgJNc&_nc_oc=AdqXZ2sfJbrNWyTULQU4mTz4fu58Po0jHDyjkhmLZO3jSe-uKtwTnDt15vsEHSdmqq4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzx8xjN9l3xoXxjHpWfZlNwmU2hY2SwUHrf_A-ih7WgA&oe=6AA012BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW3RPHdEf4oQ7kNvwF_zKGx&_nc_oc=AdprFZJJmJOd_bYi2rAvsPKlldy1dPltjkwWB5S5cnCNpzqofIuIGDEaFcjCTHhY8OE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNyggyd8gRd-XiHIEDy24SvB7dYK8kui8o36dP-IlHvA&oe=6AA01BC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix9dNw5ST1wQ7kNvwGNm8hI&_nc_oc=AdqIJuX_-YQ0eS8TkzqdbV_IM6b_tJGwAGMUKid57DSRlpIvlrNsHEp6KNrq9B_USkA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6sZsNXToOtvcEl3378HWa5-kkr0HyDanKRMMBRv4fNQ&oe=6AA02AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWkU9dCNevIQ7kNvwG1YbEn&_nc_oc=AdqxK_Cq0qeJZBTebozEHRwp6iYS95BT_KhIQMazS-iAWJurgDHeeiW5JoIEXa9NxLY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvSj64JhZcDITeShkCd-lFQY6oBpMIHVbg0qqVgMTCpw&oe=6AA01951"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
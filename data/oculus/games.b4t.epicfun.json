4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcTFPPMlLTsQ7kNvwGOVGuv&_nc_oc=AdphbHoxQFhC7bcIKUNzCj2EXieu9W29xYjzaUm1GyweOeHTLo3YuhhNOmuD1XoLxUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFnTTypQ2towmxBXsmBCzlW27u4nY4XXZItGjqqHzIgQ&oe=6AB29922"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJGKmZ6lE7EQ7kNvwEXkwMa&_nc_oc=Adoq3vz5iFXIJ3Gzf0Ij0bNVNoFuB--VnN6lNJ-Nw1L2H2LB024MK57ulMYJyWikQsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLttOkm9ECqzfcmGW3i9zy3NqtqFYz3yEQ2c2JSPlo2QQ&oe=6AB287BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5IBQRkb-yoQ7kNvwEMpet6&_nc_oc=Adqphz7bZCddsmrnENpnh1k82jiWkhFQ0aLnWONPyyJ3ih31rHCLU7wOP-U9itM_grk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKethBikgxr5Jg0q1sOrB5KUB6HfJwOGDWrD_VURciDaA&oe=6AB290C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_bW01cXjAEQ7kNvwEETZrV&_nc_oc=AdpiSEe9XVBBNgO5CE5yXKFDcZssUqhFaCKHJWtvUwvIRxVkKFZglgTLCtxoMKZrZ44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm7ppzemURhzng5I0rB0j7jGDh4FTJrPN5qCWeQ_szGA&oe=6AB29FD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-D1igwTaqYQ7kNvwEu6pmg&_nc_oc=AdrYFr5XRQwxJLHjK6ECV8ttTsna8TVe1GU4jc_9_jOUxXv093pI2tskynnuUwYxak0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzWTT9ug_jjHD8CMIshtIRviwIcy1y3uApPtA9GRChBA&oe=6AB28E51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
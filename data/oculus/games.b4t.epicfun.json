4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCkc7V42WpUQ7kNvwGeHEYc&_nc_oc=AdqN6l577WWch364_dA6fNSAdlsxgW_ma2HxXb6Xe_1Pjc5KlkZrZM1aeTeB63n0Yl4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rcsYxdUErhSR5vrLrpSOwQ1qEN22qOpK80K_9DwywOQ&oe=6A1AFCA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkv1vCvTXoQQ7kNvwGrwdcr&_nc_oc=AdqfotQWAQDzASGkRDo4T7xzXw3JRz4yj-R4V3O-82WVP8OrPQXJmmn_nV8iiPZclc0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4epnq5ADeetx9-XVGVk3sqcgTJGTh6yHhPpjxKszsRsw&oe=6A1AEB3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBZq9uCpy7sQ7kNvwG2U8-r&_nc_oc=AdpJ9gsIJqVdgkuKHeUCXKRwSj9eN4vy-jhHgLkpb50F8rS2J8J9ozEVdP6jYGPXoLQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gYObt4nuuWo2K8oLoHQJQExDXBSoRBMtVkeDJdhqqIg&oe=6A1AF443"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcJ8yzUOBoUQ7kNvwH9Kcur&_nc_oc=Ado4YHkfg6Y-OB6XYqXaLKrDtDK8jLrtPjUPVW4V4DTt5TogmhQSSfeCtOpORmTecgc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73anEFSv8Ynd27l8P3Cm4JrnvKWmu_5TZHsRLm2ZfWZw&oe=6A1B0358"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt3xWYheX6QQ7kNvwGy4i2V&_nc_oc=AdoeBLhStU-VE99rw0Yhnnsq_J9q8WdZhZY8gGgcPPKrTCQDM1Rm1tXOBrPgO3Eyfe4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6apjaovtZ0UcT56I3ZmFimyO7MkNiT8Q7QYUvXW3zsqA&oe=6A1AF1D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
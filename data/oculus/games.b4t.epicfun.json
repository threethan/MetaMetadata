4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svymjjFu4sYQ7kNvwHr17pP&_nc_oc=AdpGRtIH61Arnak9Py3cLT-M6maJTbK1f_Cxp3nRjD7ee72Zb2kxhvtVJ76W6WnBRlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmEGljKf3IcXqt0aKm9TzpNSCRcRmrx5TXyXHylCK4Pw&oe=6A4D15A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWMgS08JuagQ7kNvwEVZd1N&_nc_oc=AdorcqbzXee7VermekTg9EhK56CvqmJ-rW0iio3lzmkwoBmE-_vkg_K0D0rhhC7Cgm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8QhvVaOOwfAmfLoJ0CwhT0BUs-ev0-RlPD80eLpQSmg&oe=6A4D043C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX4JIFnYM4sQ7kNvwHq8d8e&_nc_oc=AdqHMZUv2KPlPTZSculog7paVn1O4g1ZKyvHv0jtC4HJknc5YCadFlkjL1G45TZdrWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0oEGkC8Fq5-bE2j2jQa2gFdZaQU8nJEc5hqyoH6hJ4g&oe=6A4D0D43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OydsA8WSgQgQ7kNvwHK3gxO&_nc_oc=Adq8rT5lcNjBY4WGCWmVeVjmbIa5CpZK4fb9gQ7RngvOnUUOYbMV-djHa0dYWgxgC64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDomSEFuPfnvBAHFBOj9VmN0BTwp93J-_462lw0bNoFQA&oe=6A4D1C58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KXJXTymRgUQ7kNvwGygOjc&_nc_oc=AdqQ6CHx32_-4oeyzqwBNWPAl-i5aoVEZ1-Y5s3dMD9GsV4JQYzoVlqs9KDpjXTa4RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBii01la-U6U0fyiSc8yRDAhizAk8syVH6rUetKKav4gw&oe=6A4D0AD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
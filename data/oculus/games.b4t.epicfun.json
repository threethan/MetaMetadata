/39001714_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk1n2vWHMSUQ7kNvwH_z60t&_nc_oc=AdpsYbCqAraYX9f7DK26HesKhi-AeV7I04BtDPcRIHpMs1JGw5NepENwV8-hzX1lH08&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO0Kyvu_RSOA2GagS02Mtc41Zw5QwBpuPdVFJRuSU3Ag&oe=6A8EC862"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPpZHSW1eDYQ7kNvwE0RO1c&_nc_oc=AdqSdCihfRDNBcCXZYFQBbEpRi9m6Tp9eC39mjGphjv16XOuhas9ZldzrZrx9GmmcXo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRVpTAzz5wUE37r9HJMWBitvNVIDBeSDNOcrp2WfkPnQ&oe=6A8EEF3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9aZJvmzWnAQ7kNvwGhqVrZ&_nc_oc=AdrL1uJDFoYWpjdvYIdYXx3RK3rUHbHJa3gM6HfVQFoMvYxA2Bc3ICnSNTfVLkAX8Hg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLsY_gLc30--ZfTaC7gNl6n1KQYOpTmx0qj2_1Efbq2A&oe=6A8EC003"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPyI17uwzTgQ7kNvwH3vm1u&_nc_oc=AdqAC1WCpmG4BFXijkE4B3SCD9NddThuiLl3RP4ArS9zSVcc_ykSpp57bv8zNl4alvk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbvT53AcXxY81sNKsAZmBSWff7-J-SOzyV5qp0QS8dTA&oe=6A8ECF18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpbLdvSJHKQQ7kNvwFKJGAD&_nc_oc=AdpJTlQpsvkk8rtworrCveO9V9RyJ8BWnsO2J_-h2V-Y3xPpgyASrf156eEmgpSwLX0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIABECDQ88Dlb4VMQD46pGcadsInswfXh_qeBoSqmc5w&oe=6A8EBD91"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
A01E7C3"}, {"file_name": "migrated_image.png", "id": "872240139867614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxVwJ4WotD0Q7kNvwG-aXix&_nc_oc=AdpqY7lN-1lEVuHFLokh_Hfv5XSJzW8lSXRgjsfh8V1ms2LA5KpzrU-JwJVoEft44zc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-fdyjjNCrvEuM7AsbGBbsZAQIcER5AHRRabNfJ5af6A&oe=6A01F6D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/160mg2", "id": "2705960462757174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974868_2705960466090507_6493344025829965824_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DVbAnlP5dUQ7kNvwFkE0Pa&_nc_oc=AdqubBCZQQ_O9G9i76q45wxdf8okEUAG7IJd3cx1hgIQWMGEw6nVO8FRPcU9ie8Q5vE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C_7V5Fd6ROabAz734sQeMpReJvVKdmDxbuNTAj_pn3Q&oe=6A01C7DB"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n
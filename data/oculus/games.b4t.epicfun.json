4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFYd3a1VKxUQ7kNvwFsMw1z&_nc_oc=Ado9SwjZbgzWtt9g3jOzuMkjcyEXmoC7Bpnw7eHLY5AqpDHfquQKP2gRm37Le-Hf0xs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-q_Ma8VkKEfdWzO_hazU2jYLTDh7lhgg5snbp6Agf0g&oe=6A6773A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMxhlJz-e7wQ7kNvwHJARk-&_nc_oc=AdoySTKHHQj-LxQXESZ6ii0jhw25NfqKebnrAzpvNl0MMxB0Cg1GFaUv63kP2Gqmye0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfoF36HZGwmfY7S02Ipym81l_7Ni59WRUU97E-hzOtkw&oe=6A67623C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSpgm7EaYxAQ7kNvwHdRhz5&_nc_oc=AdpERm_gxMZ8Cpuo0YJTFoXwkZ2dnizcnvZt3i6TbVNO-4mW2rMyZd_MO0jSl82dyH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq-hjIymrNFlOWvTxvxAQGVN8eJFbe2FPrTLCPONbOJA&oe=6A676B43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlPV9xQbbBgQ7kNvwGPhwqa&_nc_oc=AdqlkYxLjglLppWVYkhJHbsqP4r0C7bNWXgS2YXLO2EZv1sX2hrJPYIzG9rh9jVGP34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALcbE6ItvCi85-kJGNzKeliO047AnMwWO0tWU2RIjaSg&oe=6A677A58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4gd5hzNnk0Q7kNvwEmDjoT&_nc_oc=AdoGkW9Yuxq_N7qJDOpP-zsdyEA54jj7JvJhHXgcsWGPNs-QJeRnRH_-NQqrZ6ndpjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCksyVEjHSOGGS1Z2WYuvScEKeqcLymAo3pU-yq5El77A&oe=6A6768D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h0vUNPuQDIQ7kNvwH5yHdk&_nc_oc=AdoooVVwxTQUThZ0s_YnOs5QjF--0OYWlBVb0nAwypaxWyKsu9SKLMSDd63sD6aAEBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AsOO3A_aBpCEvZdofC-CKEB0droPICQNeBAThUva6KA&oe=6A0341A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBwBgXnZ4_UQ7kNvwEGsV9D&_nc_oc=AdoN5RWbJwhFGGNFd6aXwTUZSWmKghmGi63MdHdyeL7NK1EXkVd1odNl4FMk-yAd3T8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56yGozlXYefzn7bdJdqc1V61uoc_fyT_TiU9kLxFuaMg&oe=6A03303C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqKQhrRxVrEQ7kNvwEirrZg&_nc_oc=AdoJzQb_zrhp_CJvXcyBkVRhPfYWFUXH9O4iMM2daSPCoAn8ujrz6aL7_qEjVfr0sHQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46mi4e4a6MbL9_izPth3tdmbpCmcW4_ZXn8lZlMzo4IA&oe=6A033943"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxVwJ4WotD0Q7kNvwHqSlgm&_nc_oc=Adpn5InCFtkeXWqjQ5X5Sxo-VBtlJFxOsDXA_W9oIxjB_HAVSa0w5i7nt8TRsN8kWgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wIeIomCI7fpdt7K7LQ3iZAlRxc_RK9ti5dIGxK2BoYg&oe=6A034858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZ8npD6qMBkQ7kNvwHSgnJQ&_nc_oc=AdoCcroDK3X8ob1iP3DboIFMIl0ga9-g8RN1OLa7IeQ7arcfK_ukGz4gaVcc04rFwiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wrfxF-z3Hf3WI0Yhqwb2osmSDAWjEhFRIq1gVM18rIw&oe=6A0336D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
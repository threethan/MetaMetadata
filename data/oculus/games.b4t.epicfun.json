4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTvQcHdf1hoQ7kNvwF_pNgh&_nc_oc=AdoM7enUEVJwq_oc63Gw8uwaXiYv0F-IF3j9b_Q2-ZeFRQFjWCrcRRkRHFh88Z-IzF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9heHOSzlH2ACVNtvwM9IvHp0UccMHdZz69vbwIo_B-3w&oe=6A4289A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wURxTY3IlpcQ7kNvwFtaxzt&_nc_oc=Adry6flPfuW9NIK9N8COAaSTUe2mGgviFvfXKtYjzXdwspzMJSjPhzUzKdJ4hkgJo6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sb86ebpY1N29HBVA23hL21au_DwmiwbvM2oafAh6QbQ&oe=6A42783C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0Xfh14-E9gQ7kNvwG1i1m7&_nc_oc=Ado6BWWrVNCkRtk9s1RsvNlKQCSf5WVSMF8RVk-u01x6QVmKun-K8SzemZIkILEAc1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81B7Uujrkh4PCKr_JTQbH-EifxeHlfqEB9XttrEHkgFg&oe=6A428143"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOoRGufYF4IQ7kNvwGqbMYq&_nc_oc=AdoJfWV4TN72z6raGKY64vARP0lVKyTbz0gMy63_JSu8g1JbW-u0DP_09gQZ_pn9ckA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_76J-nOBeOQnqjDmByAZZNoKFweR8_r4TKxzc4vWe7rg&oe=6A429058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Qj2XCHIejIQ7kNvwEG5DJv&_nc_oc=AdpfbmV3t7dw5Ey4lseOdytpng6bgyahCEoqZ5MVzX_xUeHu_xRiAgYzlTf9pESfJ8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DIgL-jggEDJk2VOjvpX4G1jzi7899OwpY6OKLsTBdjw&oe=6A427ED1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
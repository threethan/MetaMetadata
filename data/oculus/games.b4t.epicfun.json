4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxxSqgujVYsQ7kNvwEu2aAc&_nc_oc=Adp3R7yHZucAmss_4MyY1p49pXLZIYf5lJ_DHn5BSKEHjmIFGmCS2_ekMczrYRQIOb4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dWok3HzUhZ4CM4CwLHSUXJ_Md6cC-t6xvz0Eyqmq56w&oe=6A2C2022"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo0Qpqh3jncQ7kNvwHH5CyL&_nc_oc=Ado8n1rQvziSUu053x5rKwVu60d11SvH0N1ynpmFP-Odqlv_bO6zL-DWKWxvXJpVjgI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qVISOF_izIZLhwR_kED-MV0IsO9xIL6GKMdMcbGgFcQ&oe=6A2C0EBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi7V_tIbQ_gQ7kNvwHIsFCo&_nc_oc=AdqYOA-rdl1MPyXX8hoNtbZ_1C6NofFxwvm3zdcAacY_hzdoZnFtRKiGtegDpe9XLQE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7q0__MuVVXd1SOJJtlBCOeKk1u02gz4llYD68P-5xhw&oe=6A2C17C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfmoXU1RS_oQ7kNvwEd31s3&_nc_oc=AdovaYn4e26ram303nNvZbYztNzD-uH2CG52KgBhpin12wGkIVLsW_2A0w8Q5EFG4vU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HHcMPWmkv_iKCwY9pCM5LdbH3X0dl_OyRB_BXYp4TGA&oe=6A2C26D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umd8dWBBBtIQ7kNvwHszXn4&_nc_oc=Adrdx4axu_0bDPf1yEGJPZeMgNc73XuPo1LoM0nOTl8F1-FxTLt1WeuImSJWUktrYOE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UwRwcZyz1zWNBBQLXFesxHdBJ6uQHeoQUXsPnd94EVg&oe=6A2C1551"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
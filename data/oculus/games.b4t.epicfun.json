/39001714_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiQYH4nb0lgQ7kNvwGGPcbe&_nc_oc=AdqI_gmzIjzLNuvAjYiZAARylYVuQvvrbmalc-sxC2PcQl5QvR-usQKx1ooS87CnAYY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IExRptaHaDbPF5DDoNm9uyxiqhT1IPdFDrYTpqrLCOw&oe=6A394F22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFPMMH-uaY4Q7kNvwFbo4kL&_nc_oc=AdqOFVXvNf-quXHpAfrQkLDqjeU4eh6goUcSnD7p30YpmsL3_yUZRgix8ELuiuKGEtk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P9lnzDUCbl2bj-IXkn7fDVf82pRud7Xif-MFuqeponA&oe=6A393DBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbi58h-AFNQQ7kNvwGXC3nA&_nc_oc=AdppAqikjHtr-ixpemhQH42kudIZJVJWIYNDc6kNa8zVBgE1MzYl_Jxx-pqWjqh3t7g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_awSEY93S9lDHfCQFpYJfd1JiJf0Z-Y8j-lHyJex7g9g&oe=6A3946C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z89aAdWiF3IQ7kNvwHUoaHb&_nc_oc=Adq6vaorFkPYP5XFlFziPzEGMnTiPO2b2RtAV8gUO2Uu7tTvJu1ZfilSXVM1uhX6E9A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8htk_4uBwcTr8wg8ney_WjlGhzOerFyBUOfLkWo7ptPQ&oe=6A3955D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ6d3B2Z8HsQ7kNvwFUyNZi&_nc_oc=AdrE84zFFAnXfhhfDkoY2iEIhJuy3eFnUlmuciG9MMTluwKnJnAoJNlnQYqvFQBkTuE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3DxwpvOMCsicBzT9wII487WnWDH92KqXQfVVJmNB36A&oe=6A394451"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
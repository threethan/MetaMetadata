4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4d7ylRgJtYQ7kNvwE0_KmJ&_nc_oc=AdpdzDYf6CUyquJYKo0jGtC21nUTx8pkHVyxWaabInTjYSJUZpfal30f9S_j2-cN9J8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLwXHKo3io-xGgspw5DcI6DdxuV52lAr9Gj918LnTjBg&oe=6A95D062"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWqvCX32uNQQ7kNvwF3oEya&_nc_oc=AdprkZytlGc25GXcu7iGmq9b7afAwwfU6tyPvQQgEKxFKFEeU3Y6Z8P4Lwi43jK0j1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ-TmUsqQ53lLOXLdBiVc438CS7QlDYWuoDZk0yUSPzA&oe=6A95BEFC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGwmKMvX-h0Q7kNvwHaSP6a&_nc_oc=AdqgKEhzupyIOr7BeOpKrnM8TObSf_Twgms-SAREWVwFtaRhcs27r2t8OdDJ9SajSmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyPRSZ82A75Nf_nvduoHCPV0V8utnQPDEuURwAQyWUXg&oe=6A95C803"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyxrIi1E8NcQ7kNvwHnOsCO&_nc_oc=Adp5Kk3obDjafwQ2MXNITmeha1KjcXU7PkjrVmSAe1ZqHuA6NfFg8YdVNhi1CHtXU9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQuPpLjEuY33g4zqB2vM17TvihPuZYnUpTTTYBAwAeZw&oe=6A95D718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLJHAg08QOkQ7kNvwHGY_Z0&_nc_oc=AdqH8LMEo0hfcrzEcJRU4aIgQwA4rDvQxJ8WBW25vHVmstK4cn8EWFJiU11Fmo4VAbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkLTq6h4duFfo-Bzgs5pSPYvgUFWhOsAyTeTzPhM4SLA&oe=6A95C591"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
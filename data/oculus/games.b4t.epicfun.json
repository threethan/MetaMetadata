4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f7YzQSYp1sQ7kNvwEsYx_m&_nc_oc=Adon-Jk7GxGNn5ru8YUk7C7G8xynCBDI3augBKPsCj0tl_lhWXwAN6rueNdCR9Fz0x0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH5Q3Rqkq55nxR6srYepey5QFhuKAK76fQHdzMlo1N5A&oe=6ABD2522"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-JdPfODI1sQ7kNvwE7MF2V&_nc_oc=AdpYvF9A-HVtgBi1zvE6gGdhHeGUEnvoorzR5OEhHORRVce_NJ6bgLKctrADfQO2DZ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8oWUr5opkWs-5Q2mS23DT3UVwDXZcBujYHf4LMXjKyQ&oe=6ABD13BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVAUt1mwdyMQ7kNvwGIlGWw&_nc_oc=Adr7cWeWoelvyAMDYrIQ_AE_07De0FuWx41JON3lMLFIvIxGtx8aeGFbxU7W2b4ox9g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHvX-v3cNDH_D9h-FuxMtk1Sujo4poOiLTnyYa3wrTeg&oe=6ABD1CC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q051iFBut8Q7kNvwGv1xil&_nc_oc=AdouxbJQcdCsWmfSV_ICmfG-ks_68L3y9v_TjSrDutf4FSRU8OoLVXIdoO18LL_csgE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhHUoEz9iiUIBeC5TQ0Re35x8j5pueAzMcOhbXom6C-g&oe=6ABD2BD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dWo10djWQgQ7kNvwFUSC3Y&_nc_oc=AdrvLff_AT_OgzhyOATv-L-vYZZR0m3YAioGbcJi13GaneTzrvIXDbYaYEGMwAmagmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNlK9BhNH9r5vD7ysoKs9Pw3A2JdaagsCQgynT6tdERA&oe=6ABD1A51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
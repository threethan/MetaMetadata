4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpUfNaUysngQ7kNvwFTenZD&_nc_oc=AdqhHs4UnR8hLJmAGl8ewG7dKKa8h0WcfK-KQuiRF6yDGE6a-9zJgfOgGkRlUAkDZMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r0AJIEIxnb4QJwgye-OGVJ60P-lHO0H3JYAX9FPe4Jw&oe=69EA3522"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2jbUG3s4RcQ7kNvwEw3-jE&_nc_oc=AdqrhdvfAsxyJBsqFnJ8bz3L1wbQRmc8MyhVhG18ReV_I_AY1uQYQcooFxhDNj7gnMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jRsmJTxnxy0eRfuri8WwqPPm67eVv5B-UexZMFSN63g&oe=69EA23BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaRuC6xc_isQ7kNvwFxWi24&_nc_oc=Adq3tegzcHKlI037lmqGGsfWVDpv3L0AebPCRtN0PMqRojLJ6FHw8tobnHEdFEe4AYQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F9s5lSgZVLl8uU-of_ep8tAvM6dH-RxVJ3ky7zpi5_w&oe=69EA2CC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBsIywaFg3YQ7kNvwH6OlDX&_nc_oc=Adr_6HRsgmMPb3fCO12Y67Y7jWtil2wMjjsfJw3-InsO3_itqI8yl3Glu5gX6cXc86c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tk2SlJMPIyPcBVD8qjelRW0CxWdGvF0NSmdiCILGuvQ&oe=69EA0398"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pe3bl8Y5dQQ7kNvwEZr8eD&_nc_oc=AdpFcx6ry40-JnGMy9WxkS1KsWEc1lEK-EGQKttiPJWQiKPAo8RLPpusdCtyenmW3BI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RW2YAjEL0GWWl6gBseA8G0GxeJNb76hw0HSXcsk9Rxw&oe=69EA2A51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
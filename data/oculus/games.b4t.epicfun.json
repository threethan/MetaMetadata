4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLed6QGF2LYQ7kNvwHggJdo&_nc_oc=AdpT2VWWsosHu-GFTQW1l6MRYCRactTYEdx2VgxoodlOhmEL0Rd3dD4ydrLV1a2Cg9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9iTWx63oFJnbvkb7BXvfWB2EC4vrsmWk4UUcGV2liAQ&oe=69CF9EE2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3Rgk5ltCGYQ7kNvwHk_7c7&_nc_oc=Ado5nPaBN6vIHPgECKVrN-agVguh02nXgmELbKGqplJY8ft0xEXtgcGiCJym92ePDXM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvG9uv6VUSJdrzLv2r2-LQkaMqq1UZqSaudmRWp_qFbA&oe=69CFC5BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el1VkmrdD28Q7kNvwEfSb27&_nc_oc=AdrSEOrFVgdo6HevpEmAnS9a17HdDyXh3zrgJXnpEZovqON8ma-tIRUJ4RIcJJjvJIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDDYAdpX6SSLMF0V2WnHdwrVjLKi-TzUDw5OJeT0uCNQ&oe=69CFCEC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSg2Hp5nSq8Q7kNvwHseaaW&_nc_oc=AdrXlRgK6MZ6JNh-nFoVpVfkNx44J0O7zzrz_XCfOARXDeme34AM3faiS8BzG8k9R98&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcxPJHNLgt4MTsDm2J_pxn8VSEXurX17FaR4mrk6fS1g&oe=69CFA598"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue5SHvsZgYYQ7kNvwF0FjFA&_nc_oc=Ado0evrhgJtpfmPVvmZZUi117LambA8Ivhass3sBDuv_WXa4uAgKl3zohy-QCjk2Guw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8qKDfZsgSmJ2ZoSFAvuprwT3brflcalnvADy7Sw_krQ&oe=69CFCC51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
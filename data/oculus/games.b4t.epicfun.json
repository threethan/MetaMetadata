4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4d7ylRgJtYQ7kNvwGIHyFD&_nc_oc=AdqsK6kvHRwRmsCnsYXDByG4hJHURg2PNK7sCQ4uc5BE8L-PR-AcfHJRH8R5_kqJSZg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYUi26ecOsB816rJC4m86Wd5JrUGAYoOWBeUD4wgpNgw&oe=6A92BCE2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZInDN4R3FsQ7kNvwFx6is3&_nc_oc=AdrsRIKbTUixl-5LEXggnWTQvLs0yLz0gZ6ksdOHXTstJCmjo2SqxJn_QyUMb1zYso4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKQMXQEjQ_1Ry5p9KHDwickYVL1AThHZtO2FJfWIVO6Q&oe=6A92AB7C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5LKPiAltQUQ7kNvwFLaBJZ&_nc_oc=AdqPz8yc9BZx4GhO63h-JPBWJoTRtySBaqR1HB-o_j8TpHf7vbqLMLIkA-Y4_gsNf9M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENw1ZVR_XuQa7OFGiMSqIJhGqMck8K0StDPXq6nuWLvw&oe=6A92B483"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyxrIi1E8NcQ7kNvwHojcr4&_nc_oc=AdpHpXOVpNk7tq4GMybUDLIqOuOTJ2S3w9FqloN1mynd7Jj0BJT0j9RLlUmeUvYzWrs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7FSU5HvWIXj66xh-WRtm4aayG3P7sqnjdzUpkAyoLew&oe=6A92C398"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmiN7cVdoRgQ7kNvwFjX60O&_nc_oc=AdqHbfK2sYXTjF-JumtDKBnYiFj_ehbAV4geMw4dhuSoywjS2kl3IHwJWEnW9794WYs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEX3Lsum68fU30MaAKcBkfLQI31kUE6_FF-0z0ol131A&oe=6A92B211"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
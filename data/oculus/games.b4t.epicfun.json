4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lf7gN5mqoPYQ7kNvwGgWByE&_nc_oc=AdojXdXey8Z8pePhxJWNli7t-Oz6kqTDqiDfYNLb2CjYbRlZUVsQ0b-O48YPHYrpU2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjQlLEKwd1FfB0KkoPh3mYp_s8PT18gmfh3bUeGx3-Ww&oe=6AB930A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPhHnbW4XtgQ7kNvwHQjFDa&_nc_oc=Adr4q2EheFScCHxXsQsq997KiUwh_pffwcH1UYs6t26msbaN16d6m5MAnsqzh3y4YPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi7o9LGaPjTTPjFL5DfBf9kGQSlBGsBy5gHMXTJ6E8tw&oe=6AB91F3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUF3NJPYCWcQ7kNvwG6VX_X&_nc_oc=Adq3RyvE0t0Onth2DFdfqa88S5sI47nJ-9sVEF9-Ag7unDaSVKSXog5-5El_pN7SuO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKqWcNSL8vgW9ji_rVfh1RQBff_6f68XqIPioFZfn02g&oe=6AB92843"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOI0L1ve6XwQ7kNvwGdZNO_&_nc_oc=AdpCMZzQo9eCxe4vH_Sy-_RdRkyGkL7nqQe3NCCroXDgPrVkB2_gcH7_xj7vwilhcXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIphnG_vaz05yiCLC6oSy2__n-bJP-FFYTIwOaRyW5l_A&oe=6AB93758"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF_t2BCVG2AQ7kNvwGRADBH&_nc_oc=AdqlM-o8MYT7HjbS7ftJNn7JxVoCtfw2byVKhVAWwxS5ZczV-pQpQTLbMWjTwkeZC80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi1CCBkan5pnhQnauTALDyQkJ1ei5DzXxNNfhIcjfcgA&oe=6AB925D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
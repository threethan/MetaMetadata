4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkEKyB9RO3YQ7kNvwETytqC&_nc_oc=AdpgL1bRcX9IQoaFb4A1Da2ig7rea31Lq-Al2_fXAIVKkLSDNMrBIMtYbqWk3Vumgy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_odocD47XUL4lBMOBTjYrzN8A3rEx0DxaKH2hRZOflw&oe=6A05E4A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slBmS-2oLK4Q7kNvwH129rL&_nc_oc=Adpv-YPnVfXYdWI28AHaabvnINUfpNiWiALTo1-T_fyBBJ4jmCDqZr4eb6Z9rnpJ4xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KqLrEOkebv1h5l446x-q0v6t_Hr-x-7nS-GXjRJAq1Q&oe=6A05D33C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01CPhe43E9wQ7kNvwFaxfYO&_nc_oc=AdqZ8oJ8lDxitlmZPt7KQb2jpX9QehfYJTUEWPYTIRSEACdu6A2BeVHCXFCLzbqNyNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z7JjM_R7wfLJnDs4qIQcgAQstSk4ImQUpQ0hwt-1rHw&oe=6A05DC43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jf0W_TVDxwQ7kNvwGf0jDc&_nc_oc=AdoHZg7PL7b8ik_T-rJtezbekHtJIaky6joNhnPdHG4BFR6WvCRqswHUUJ5aTWvx5LY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cAwQ16ppZB_O4mMldK1EvA4867wOQxCvGzNr7VUHwig&oe=6A05EB58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZ8npD6qMBkQ7kNvwF9hpXN&_nc_oc=AdrONBYo4Q6BcszLG2xyh_FvVHFsanFiNLR8ZnrUdr-L3V3B6Zo4lxsl-H5j1H6pKZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sQX3DeAjeItteAgfibUby8MzuneWtiCGbO3dOQ-IECw&oe=6A05D9D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
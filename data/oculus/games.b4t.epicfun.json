4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcTFPPMlLTsQ7kNvwEVZO4R&_nc_oc=Adq8feD7tSquXe-6FB3AG6OAqL3HGzo6I8-eoLZH4V7N5UyLAv-NGZ0RGV1v_rLX1Ws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBHWJRECVhZN-3bYu3ulxaecd6KWbpNK4-42Xh-vl8ZA&oe=6AB3EAA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGdsw6G-g2kQ7kNvwFKUInm&_nc_oc=Adrh8pH1lbemyNRZVgYZB4XkI3qEAQV35i6mX7IVwKFKWyRUoKtYBxCRopKjpmYyMRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBZlTvbAbkSOEQLj7aQd-U_BFBOTU6rQ3OZ9wmjt2xSg&oe=6AB3D93C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAUaBl6cKDsQ7kNvwH0UPfB&_nc_oc=AdpF7tnGcPC0Wtnxf1r6-FWqVgYKbQbaRxfeFxLSdITLjk1NW4nEIJF6a7cyHUuip9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwGNfk9f4UjrolwOX9U_klzt4OyKJb5UQfTw1QxxOfvA&oe=6AB3E243"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_bW01cXjAEQ7kNvwHtNHWz&_nc_oc=Adp9d1ANtdSYWZjodJnNnq-dCKYVbIvmWExOVBhaD9oo1-YlZ4U_we13gbw9tzrbe3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGW5Tk0_ZrsvGgtw6OFLCnXuKcsv4dFvg4KQzL8L71vw&oe=6AB3F158"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-D1igwTaqYQ7kNvwG2E3Oc&_nc_oc=AdpDLSibJ3m0y9lw-4uhN_DASXM80IBhBKPRGYzNMmyRc6TiWkozFDl5GTgMeu3nFOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5OUuj0hdHShpSwpyai1_ejpkG-sydVl6EKCLuvhWukA&oe=6AB3DFD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeXTo7UYIEsQ7kNvwFHdyFi&_nc_oc=AdrHUR5aZD0qoz0TDVpyyOQI1y4zEGi3nnjGJtdTfk6VnxtQVxa29h8-oOZqcVQ1v0g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QjYU8MMsP4IJeZ1ctrs65YhqxXe1jNSc625LCEPg3Gw&oe=69F8B5A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyecNqyLbRMQ7kNvwEXg2p-&_nc_oc=AdrtwxpsgU3Zt7NIBJs5YwIZkhjYL1C-TmtO7lvJklvR7Lweo2lMcUJGnRfpp7wzUXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UAInZzOpX25_RKSbnlrnndIHKDCqPTo5JUvCjlIKMTQ&oe=69F8A43C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyjc4c5WepkQ7kNvwFTMtty&_nc_oc=AdpUf26nhprGkdrzSFzQ7gi3Jqhe1WpNJmZX8iSQc8KVCn3Mcxjunlr1Mg-ose_sPWI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Up-cr5IGIfHFqFIUrNsnWXxbw7epVfWgzRx4rnJZ8BA&oe=69F8AD43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e75uF60qFeEQ7kNvwEkUm3p&_nc_oc=AdrVNRtsJYJMcnyigAuLCDZW7Diw5ikZallvJZE7SfAkSRCQM4j_atF7w1sClB8akv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lxWQmAntOoL6vPmHeDCjKF9yQT5ZMKn2h4c4HfDoOyg&oe=69F8BC58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W1PDOmgEiMQ7kNvwEr4CUs&_nc_oc=AdqYtbJI1aNrc4liul_o8IOfJmJ15UXzxPaEt8I79rIcqr5rDg9lCc6b8ah-jH7cojA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KK9sy3kUf2nSanUNQ7ZllE9CuqdfAeiIp8tU2wiS-yg&oe=69F8AAD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
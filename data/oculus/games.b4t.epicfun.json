/39001714_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_0fLe4BtyUQ7kNvwGwlBaw&_nc_oc=AdqbHUh5GB6tvJUKHuMUp1MIB6CpmT1bKqlZ0RoghdWT_3kIXZiZTt0gPkm5qbK5pNQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bf08uOh-xLx81GW8VFZURt-oee_X4E2KTzLu5ZhG4Ww&oe=6A467E22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12R2Qkqsm-IQ7kNvwFHuKlf&_nc_oc=AdpV1YZGm0shdiVe5POdDPLx0xxxrevoDjTT0wZQj1-9qIH3HbGNNqrXkssSm6QXszo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oJrMB-Q9ndKR6vjNFbWFi6zFFweXgcSsYK5t2KOtHHg&oe=6A466CBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG2a1pcQj54Q7kNvwH9Sa0K&_nc_oc=Adqz288uF7dijqd0bZQWi9AjDty56ohT3L5fUp2E5eqIKJo5mnRY62SOyj4rm3vp26Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GI19PP8gSWYw1Js2cwn5u48jx6QSsncp_qYysBXjjOg&oe=6A4675C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FeIppO0T8cQ7kNvwGXdtzd&_nc_oc=AdpMr8O-TfgIpnRB-eBopwuJ2flFd1shJZfvgfEymZYksPetFgA-i_zvHDM3V-BwTIY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uhOX7qKK_Be1bvmidwxto2LYuo9rFmBqTJkpZhbD8NQ&oe=6A4684D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kngSnuWHw1MQ7kNvwF5XbA-&_nc_oc=Adpli5Dmq38SlyUIrunEKRvy5Os7OY59GU0evMKn_109ucH91afFbZIRXLIwtQn5MTE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1PuedzodQ5D8SOLCFx7UNViHSxKQFyQyjIduzgcMt0Q&oe=6A467351"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
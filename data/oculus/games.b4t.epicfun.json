4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dzF0uz-0iQQ7kNvwGpsr_l&_nc_oc=AdoiBZOv2sZpWxVlH2GpAihcvv1ReY7-di90vUwxdS9Ge_n9q84UdFWToZBEI00YaSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEQYjakAQ_MC6lvk5XrsknEyMRWKVq2PRFOfBsXYrmPQ&oe=6A60A3E2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-iwF3oCwHIQ7kNvwHynV-U&_nc_oc=AdpMcEjf9GiuaIwBPS8ctqhba9ftJ9wRMSOWlAxLoR0uHVrl_qXnk1lyGZumyvUXYWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeerajksR-9qMilqrQPmZWSLNj_YrpWDXDYlYBtzQ9_A&oe=6A60CABC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eroWQcddWQQ7kNvwFj5EKK&_nc_oc=Adob6i0J0Ze_xqcDUXyuzLcqNBuYTtxkQ6by__F6kN_yfyDGFSxTzUF-0ewhRbz_zWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD29MXOW90hZzPlUNNulm2Ub0lFX8IIvE6FD-2zaq3mcw&oe=6A60D3C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WD1Zl8dBjIQ7kNvwFBxyYx&_nc_oc=AdqU0LeQr4pFmpCefkhCDxgWoUDJgEtAdXUvHDRdFDqrfFlVI0b-4ZSv0x0LG52znIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpeKVp24Es8qTtuBQxMpWocXEJGpEZGHdjMuYssPuNKg&oe=6A60AA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7z0U3aYkvgQ7kNvwG9Aleg&_nc_oc=AdpDYELmXKAPtUW6nxq1A3-CxYtZUSOLBIaMngJIut8yraaneWBmlFjZLG5R5edHnEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUgPjYkV4iIS_lfbXKK4ofeNfzVHsNCJX7QKVpmWA17A&oe=6A60D151"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
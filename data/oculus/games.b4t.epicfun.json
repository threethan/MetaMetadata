4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhfJtZf0s8wQ7kNvwGetcod&_nc_oc=AdrAHQE5djtzvdEKelLhGL2TizoLBeZKvg2D2FYsow_yP-IhfxfIvz0BWmER2i_bR7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VTy-Mq-c1KHswEzax9bUi1iY11GU8QtiWfe7QlNJOxg&oe=69DE1F62"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4olFVBMzk4kQ7kNvwHBEJ3k&_nc_oc=Ado3_imGNbdzbog9Buop9KaZQ7S35vmmgOtuWjyIsHTzj0iY3LhG6rkJQp5VGTzodKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XMXl24aSxkLVlACjxKfUdRDSfh97CQoAorSpkFOeYnQ&oe=69DE463C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AwpXzad20wQ7kNvwGSNC52&_nc_oc=Adr3gxxSqc155qk1AK7UwUKN_VmhWK6LKFO7Ux8rLjNzFw_Fq3YVgdX2lX3SFuLujsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m-Hubre4hLnusu4B9Vlp1pPl03duv1TTBizsyMbToBQ&oe=69DE4F43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtMZlD0mVjIQ7kNvwFozmFc&_nc_oc=Adrs7zTsI4kjh3AGHZ1Hn2ECGq6-ehHJgfXeHgScLjzx2wfAA0TJoSYz7dhpsKEa2t4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1n-4EKjqWfM_lEPbIZO7L67OlQCDBe5jd__Uopig7AtQ&oe=69DE2618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJiAqM0bDN4Q7kNvwGlltXs&_nc_oc=AdqtNokQkHd2K5ytQ2yf8AWYazutHTwN2zwVkvYIanbbGODuDhtKiXuJ8HLyKa0KCQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27YWxUjZTkTVPUXXqwHH-nSlN6Dk8wNv08BFXFNNVKnA&oe=69DE4CD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
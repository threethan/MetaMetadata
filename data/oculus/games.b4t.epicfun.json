4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JFcVkEhpcwQ7kNvwHk2i8B&_nc_oc=AdoecUX9vEDy_kxaw8_8qz8rh1oPsBAGzF3tZbTx5um-qzZm8USesds5PkFuBhgk5HA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3mnEjS7fo0wBWP6u534Vlwb9Na5__1QhS8HyQpz73SQ&oe=6ACA5422"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e46IbQqrX7IQ7kNvwHeVM2v&_nc_oc=AdovMufhzeIwirysBILhc56B2XW1szfLSL_LTyvxXs-GO3n54NKJO5mh5OzEJsZHc5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUOsd5ohiW2ggF4jEkVgswUHs_Vsk6vt5xHSL0N5B6bw&oe=6ACA42BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8T7lr84k-CUQ7kNvwE3HJf7&_nc_oc=Adr3Bfc-jFYw44ExLUrmtvvqbXeRu5aSBrVLYSKgK1r72rS1wkdl9XYvJvnGUNM73Zs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJKXbIqMMXRS3egFvrh3tgAGWADUIGGT_sEsLTJbGxPg&oe=6ACA4BC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8DRW6U1ZlUQ7kNvwHVvmr9&_nc_oc=AdpAl10uYlmQTdhMEFrRwfd_i1Koz1Jo_0q23GWUzQMFu6zdB2WIUO1ocHtHHQhC6As&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9085mCmgugIcuyv07xJ50GFnMKDSiLuc-mEXIEs4ADA&oe=6ACA5AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKMdGAkU46MQ7kNvwFpdMKG&_nc_oc=Adp3OjxC3-naWYTDTt407rh_clZeBL2DzLpp8-_AhhHYTcSbaE5wkZ5M78OZcj1buec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM73rcR3VFaQdWjMbactNYCBCESp0l3OxoLr6Is4-hEZw&oe=6ACA4951"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
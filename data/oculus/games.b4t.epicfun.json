4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svymjjFu4sYQ7kNvwFzMAcz&_nc_oc=Adpq8632jQFrAE3HXQKIMOz-YKJbNwtSz9XRMlAOnCJ_ob8XplnWAGddIcc-QMggDg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkkHDbZMoBllR9p0dAGbKMUDnpexxw0-sqoiTsDuKYVg&oe=6A4BC422"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V15NEL0D4TgQ7kNvwEhfIjp&_nc_oc=Adr0QQv_b2LbGi4V_eaL-KpjnIEsyoANXRdBNm4FnfPWCoST5bvayE68u8O-6s03nIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxwXV_JG0SwbWJa88TM26mn0Hv8ZeIoEPv6Qomp0LEtw&oe=6A4BB2BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9wOLL_-feIQ7kNvwHIBIeb&_nc_oc=AdplCUMxCw4NJzV7F_y1UcBnC4gJPwUdrcvGpkf6Wf5kln5J-9WlFWbyCwJKq5NFjYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDTMOccXr_q6tZah93L-v68iZX9A2azpAzH8y20fCDUw&oe=6A4BBBC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OydsA8WSgQgQ7kNvwFvaand&_nc_oc=AdoqtzNw-XS_SfZPk_JmXue1wcIpUB5emPRvERuiFmQbsWjLhXRe0VIbDLIxAUpm30w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXVWFIgOKBtkA7lpOT6Ciy3pBnrZJ3gXtVE0OyE_wxkA&oe=6A4BCAD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KXJXTymRgUQ7kNvwHekc-l&_nc_oc=AdqXtjodWsf5w7MnUG8vtAn0FGEdIZ-A88bNZYHeItVxCd1zobqsQ3W9ZcYNkscYv4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZs5aBKQqYPhxM7pX8SgDFkuK0mexH9RrTwSHXWKRVpg&oe=6A4BB951"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
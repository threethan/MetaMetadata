4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J93JQEqTLD4Q7kNvwF0wpm1&_nc_oc=Adq1fY2pGXaMqwpHFmJN9dnh-RIpB0pwAkeax1GA_qfQ31X3bygd-KHJF9iADiKsxIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDhki0Kxd81Gv7Go2nvxPdvw3rbnVwgH8IcWaUJeOHFA&oe=6ABFC822"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XP_CeS6GF1AQ7kNvwGN2EPM&_nc_oc=AdplxmUiEHntXWCt3UU2XYECQSu1GPeibJZXvOUDHg0iB98v7u1xEQIwjGlehqt3Fhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr4zSYsZJig18tQVLnKsvVz0JAXr_xA2x1d36biAJhoQ&oe=6ABFB6BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeU2ypAayGEQ7kNvwGo4Qi3&_nc_oc=Adr0V9oOzgqolWUeAzkOJWwVHSCRcsinPszLhUWnBN0S0M4nUgx_COUt3HFlOUZz_dE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgiLE-6RduWF1u3gxXs8yfdauYH8yZspE0m6-bkuVAKA&oe=6ABFBFC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xKcuZ1Qw10Q7kNvwERlI8o&_nc_oc=Adrl8F3hMLjHcQzD1mzSBmNOoWnRgy6oFrmdDEqEUqQCPfdS9-9xvUtkbbQwukNUMaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTYy3EWy6uaqIieSt7Z9ki67Ug8ditJfvSnyyIt7w71g&oe=6ABFCED8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPEpv5bkZWwQ7kNvwGioRxd&_nc_oc=AdrB_xz2Rt0xqJg09cI1qBQ5VZQcsYn190FpYItOO5AYnGeDT8JAE3PJZz7k4ifDzIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2KQFpI93_NVnonHYku0Xp7SFrvpRe-EuVv7fYC1WKSg&oe=6ABFBD51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
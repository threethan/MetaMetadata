4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bYsKEDqvykQ7kNvwGoF0fb&_nc_oc=Ado5jlzsYfH-7VRfJDJr-uwDSWo5QrAbOBoMP04rMiiKmW2ImJC4Ruz2CCoyDAtVTe8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OulqX57sHP-srsZIcW0vzw_ON6fPqPVJs07-wmFClbg&oe=69F36FA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8O90cbzyuQQ7kNvwFdxRoP&_nc_oc=AdqxXI_WKazkx7lmdXYZlnGJj3VCX9skM-_KWG6SXDwgjDF1fG_fCmrxfOrp5s8gq-8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DLM_YMHcC4eJ0v1igsXFqknLVz8DjKnI6K0rR5-sHuw&oe=69F35E3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvFiSZFYphgQ7kNvwHzwIYW&_nc_oc=AdpipI9cVN5ZPfm1BfmWnKhSxBE1YQcFdkR3WBnCqyPX3o_SQFARjMr87H8rCmT_t9g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15tIMlQG1nR0Le3wPXOglL1Ueya0EHWftJXjYLUUil3Q&oe=69F36743"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk-ztsnsCn8Q7kNvwF9tz4g&_nc_oc=AdpVErF-GI4oYIrg8x44HEbdKJYQ5JJBKYM096JXvXi7Ke2j_q9sbmXxL8JYq53BNk8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2crwHzn51G3rbqBbA5LIU20W9fJ3rKipMArsMzw1IIJQ&oe=69F37658"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4yCKjftul0Q7kNvwGkDRsD&_nc_oc=AdoEtJSkU9DBIiySW9K8ycYLzTstwgoS-CQSThysGHC7xERBLUkcqNyMCtMg_i6AfBw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1B4TtE2RxxoIMyUvo4okQIVqlGxeNpUHQKDi1UOzrG7g&oe=69F364D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
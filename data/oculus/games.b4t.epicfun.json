4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk1n2vWHMSUQ7kNvwFQxPhZ&_nc_oc=Adr76l58Q5iQXOvj9hBSQewxvwLvsMZRXDgnuK9yKHJACsEbWt2HTpvvanGuWR9cso4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQGFQjE_os2GJtIUjE-J9Kh-RX_hyukAUogZOGzMazig&oe=6A916B62"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZInDN4R3FsQ7kNvwG1N4h2&_nc_oc=AdqXN_pJa6p4090nfwG05glc_MfSsAhPVg0o-h4kvYRA341Co9vVp_JeQcqAxonm2L8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxHvVHFie6aKLuQ1lG-j3xQAgxY-ffwiI94MCg5P1vQQ&oe=6A9159FC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5LKPiAltQUQ7kNvwE8lYHr&_nc_oc=AdpS-mdiTuG2_4PUZj2zCLDyBMzJiojfMzNNF4MeJdS5xRYBchAjVSJ7HS6J3OPuFjo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP8tWkcCFJumt6VhYotIp2hII47mjsv31uzq2M-YUisQ&oe=6A916303"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPyI17uwzTgQ7kNvwECxyF7&_nc_oc=AdpdDF5laxXHhD-UtRzwETrgdrZC-aAaxHWB7S58iaCorxhmmkYdbVT83WAEfWIQdFo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2ots5PRvX7psUATSWkqwyNBXaQKhtPWWgKmozFxyT3w&oe=6A917218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmiN7cVdoRgQ7kNvwEwqbKP&_nc_oc=AdovL4mQJdmo066kD7LJ74NfCwVVRQmIx4NX8Ke4GRkI8ucDjXwpf_7Et4FEq8aOqS4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNe6pw3KStLWiwZvsiQcE1wzH_jdAWlJRBfPEUS6iLOw&oe=6A916091"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
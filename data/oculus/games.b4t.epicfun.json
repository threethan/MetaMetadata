4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6dtB6edJmYQ7kNvwFS3vmi&_nc_oc=AdqbUW8YAmHkSqtWXucok8SD6O-0xhSpBZF-DJ5V3fopX6_plkq_dmAj8RaZJZulx5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROGC5X0Bzo4AP7DviPOZqvc1zy4zAU-ly65jopUwVg8A&oe=6AEDECA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeX63H2Wt2QQ7kNvwGfmLJ7&_nc_oc=AdoxxmxSLpSHCPiKObpfotg7sWVhkj-kqpB1CqkxqZpbKIOOgVyJ_PKwqiVHN9mjTPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj1qfYquFshV9YEacM260rYHBe0WGy4ZCCaZKQFEMKog&oe=6AEDDB3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk70wUbVhzkQ7kNvwEyw6fS&_nc_oc=AdpAlFGZQCUlTsAslk4l2Jw7phWHrEE-lowJcQYqrPhotxeVgTzlxw6PqBrgk7ZLLdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR-kH7__ZdTYQR4nMkcJ1tW6YdwtAskTXQDWFVTyK0jg&oe=6AEDE443"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7FWapkgL1IQ7kNvwHSMPVh&_nc_oc=AdprOl1cAqDrIjwEnwz5B1KZ5dtA2HhYdTTT2kO-YdYT8-E0dpgj1kp1nwzjxG5pFQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb1pJV3rQRFKIfdBFYl7UJKLwvQriOFF-vH3RrNAFQFA&oe=6AEDF358"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in7qbmiwiEgQ7kNvwHb6Cwk&_nc_oc=Adqb43ItQos3OIWDb0tHsAVSKf39emT5VgWm9zXdaszBLxVkhZLVj2gmdo3FB2xzkpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM9wj6Zx49JwA-RjT_Z1C2z3wBeWqvyeI9H2jP9DLyfg&oe=6AEDE1D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
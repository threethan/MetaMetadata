4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ7TWsKOCToQ7kNvwGUkJAI&_nc_oc=Adq88G4IERbj9Uf3WPcIw2fdhXyUqgwZyc_mDr_Bm8vUm7Hu6Q_-0kPlDwk1X-YnNeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3GsDZ9u5J1Ouf3qEIkchvhQsQduxKwZF9iNHm7yJINQ&oe=69D0F062"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3Rgk5ltCGYQ7kNvwFHmW9K&_nc_oc=AdoTUKzR1n3-lnhl9iEntNK_ecem5MCZYDbEhOLLu1Icdzd54vv4C8UwGAhjNYLgBRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypJn8faJ6LkaOoQK0lq9lndU9Es_uAZJX3iZmAUNrKNA&oe=69D1173C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el1VkmrdD28Q7kNvwE3wJLA&_nc_oc=AdrwVwsoZI0NagFHvLw2Nr5IkmVZXoNHjQTmpek4UFC9VJUAOYmEfX5SXF5QPt5qprI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_w4i9nd69a4Y-qr7RtW8oKpVm3zaO_C8pJiL4WSsH9w&oe=69D12043"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkcLx3dcdeUQ7kNvwFZXQIr&_nc_oc=AdpdYhAiNNf7X7Yp_1-48uUNPxgfgayqLpU78ZNvidH4qoeKUeFOVjmD9wT7Coe3Ljc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmgbI3-0XbpMHt3Fl85vLfWioT9Bl-KDlMIRx8_oZ1aw&oe=69D0F718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue5SHvsZgYYQ7kNvwHndggr&_nc_oc=AdrPe-1EKlnGNNkgRKuwDfgDbl3Y1XfG-TqkTGdSvo9uPVpRxFTVTr0i7gNCkxJGNNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoQUP8l9rGsGvGlIItc0KrEjK9KlUXgVItDo-2MVKVIA&oe=69D11DD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
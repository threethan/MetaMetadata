4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAoCdm29-XIQ7kNvwE5a6K7&_nc_oc=Adr_M8_IF8P10p77cyF95RqWC8CoKk-hCUSNoHEaWgkkzqWcFGH51yR51jU1sJPHH8c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zgdgALgZ1So5F_Ioub62zskcO9R7K_HJrZzKxMsQgOQ&oe=6A1C4E22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkv1vCvTXoQQ7kNvwFLnQaZ&_nc_oc=Adpwc2usYmdUV213dXcBmnYdvOEB3vyVdVLk5Tl2Clg06Smtb0YE7RTh-ef_eufPWwI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wDyTPAtRIfagR0GCauuJhGANmaJtUp64z_57cvhTaxQ&oe=6A1C3CBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBZq9uCpy7sQ7kNvwEoGgII&_nc_oc=AdofmaRJhN31yLTaYzv0woj04Rr-aRwWr1yrz_971fyeztzPtSNPLzpGMd0V1lOHgSM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UV_Z5icPJqkateXeo491wLKtf_dvG0j01rE-vJgY-sw&oe=6A1C45C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHqmnZ_POYkQ7kNvwE-DrHs&_nc_oc=AdqdcTiDlIRbLw87QAeHm-D32XIuWcwost5rraqEtoTIO8k1xKMajYWqOSisGvGdClw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af600nRyTNZm_Yaxs2kNma952KcNDmm6_EWdLaNbVYxVLw&oe=6A1C54D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt3xWYheX6QQ7kNvwH_BG5o&_nc_oc=AdrKwnZi0cRRQ3_yEtTH35Ax4puHJ7Cm92Js3J1t1x9VZ60tbmKBt_g3NmSNDrPgofU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51_l0HwACSa4uH_SfkXrQ3TdjYIuHjZbyloyFfc1hOnQ&oe=6A1C4351"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
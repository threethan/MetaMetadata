4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7HSzSqli00Q7kNvwGRMPC6&_nc_oc=Adq6Zk2nE5EPNKVNMR6Q5R8jYUVPm3kunLTE9MMWeSjdqlEoeBAbf0MWvYYq71vq2ao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu4tP7Qh-Kl1GICi8xhLY1r_dW6Uj8-wtxmxylLIQoOw&oe=6AE75522"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRf5AcAdekQQ7kNvwFQyuIE&_nc_oc=AdoVkoFxMSPHI_aF4EpcCcYuP23XBI0wiFyUiZqzfbPzksn3zlJCwXVSOSczKL9Jyqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwThyh6p3zC4tFwQKVfMTFHjTZz0pN6pfxDOUuUxisQw&oe=6AE743BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZLNCS_DS5sQ7kNvwEkaMtp&_nc_oc=AdrOV_GOIONwe0n9iKRvoUiTZ7npcO4w6IUjtiOvt8v_O-uGL0R4I3d32S3y7uJwkOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnProw7fWLIVpFfUre6zFvfDz51J_-vZ5ZP0UJj8mu2Q&oe=6AE74CC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3kyxfGz3UEQ7kNvwGodBvp&_nc_oc=AdpQikyv5dYycPvlKkMK8ZIro_fYVCB4UZH1R-Q2hDB6u-SRzjvuOD-LxKNwaXiDx94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf6MlVXfJ1V7MyctByWsRYe7FiPSqz97v26c7A2iTQBg&oe=6AE75BD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3LImFbwPGoQ7kNvwFnHcG1&_nc_oc=AdodMVyicRfkYsIKilJDw5g9KdcsuK-FwTJaS3EUBeATqQQHBLf75i9gzh7P9l-GVX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY73Yo_Gnq3M4_qSKxUJpKzsfzwH-g95THRLSIMNfPQg&oe=6AE74A51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
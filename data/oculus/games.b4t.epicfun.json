9E789C3"}, {"file_name": "migrated_image.png", "id": "872240139867614", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTrTYqEdPh8Q7kNvwGVCdiq&_nc_oc=AdpAO4ezrO3DgoqL6Ut4l3t2_GuGcOOPk2Wg7fQPhMruuoA02DReTjMEi4Y-Oazbhes&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1foRHxcsDR8vR6uu7v-4zZ0RgM_JSRJ4H_Bt6QzY2Yhg&oe=69E76098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/160mg2", "id": "2705960462757174", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974868_2705960466090507_6493344025829965824_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UEdnTLH-bcQ7kNvwHrkBuL&_nc_oc=Adp8onEzx9XMfbWrfKq3OCoUUDdNv4hIIC8QAenQ84pvrKJ5HaTDde9OOHQ8IDIaNEE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sQTFZwjcnipRtGIH0jcP7SFu8ZBdt1cTLbUOcXcyhNw&oe=69E769DB"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrS4K2_rKEQ7kNvwHwGeJt&_nc_oc=AdqVjVYcakkYtxYpeiCnWOVTncjHiEMFNsmRNtkD60lnnFgdbiqsbDh8tsodMVjHDTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu5UDdpZ6HnZHmpXNRyecAM6LGG3N9eMpneVsyUNcAGA&oe=6AC3BCA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciJcdiK7dBQQ7kNvwFnqLyy&_nc_oc=AdpUl85mvtlycLg7b-Iz3Vl_tym7tY94GD8DciPnD_iVSxgyEhYF6qyZws0EpOcRiiE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP_NN0lyTQhj0FR5jq23vA_7qwcg8yE_6qUJTpa0YDAQ&oe=6AC3AB3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9k9c0AClLekQ7kNvwGwFgCX&_nc_oc=AdoGsku7CmvFWtk2WQU6P0pgqPtXBHArc5g3btR5dwywgyfwkIxeKyFnBLQznvtpGV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8UaXbZ1c14z4FIoN7crMksBo5UlJHy9hi8dqaup0IMA&oe=6AC3B443"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SWa00YrJ7IQ7kNvwHwt0i1&_nc_oc=AdoNh1vGxSONf9SOvYeVTDuWXyFhJuFCopKc9UFLdd8HHk-XojtTEh4o68rod8v9pew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeROrLGWCtkXdAVJM1kVT-4W0-oM487JisNQfSjn4dXw&oe=6AC3C358"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cApNrNSP1_AQ7kNvwHaGPOn&_nc_oc=AdpIIecbNUjsL3Qb-Yt_vthnClTjtBSu9LlBVX9lEKfBKAH4x3EKrYJYQq92D1xYx8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYkQlDGLERx6drk6YH3yuKTMF0hofEbR2dd_jAby3sfA&oe=6AC3B1D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
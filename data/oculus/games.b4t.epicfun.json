4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nnmb6pB9LaQQ7kNvwFti6Ff&_nc_oc=AdoUIKvx1DK6riGKe_ULgtiNBjSK0HlSP7bK87yqtWJzA7jkMu4ZYd_2C91F1KJkK4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhg0vi3RV4m3F5omf2syELtUvKy1mfL9XDOz2TKe6myQ&oe=6A7C5362"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWmLiTV_h8kQ7kNvwGrKHmq&_nc_oc=AdpzRCmDRyxDqb48DYUnFLu-k9qFOYFcvORpjS_HM7csrNqT8tg1Ehfsb73YXIT4q_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpotC-sxZPC5eOyMB8Z5JldKUOCCgFsTvsdfThRYqrDA&oe=6A7C7A3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URz8ix6cCpkQ7kNvwF3YP3Q&_nc_oc=AdriMGZ2mjS6ncEMER9tHpL2lspCKgUUiXKEp_HrKddWBUtUOfgSpDN4eDftgmu0SCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRx1oZ0L2MdSznsFSP6t5aIQUl0iJSQGYOhYkWGrsSWg&oe=6A7C4B03"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op1rzdj1r_AQ7kNvwF-cZMS&_nc_oc=Ado4oQMhmGuvIuCWwF588sOqwbdubUgfrvPyFCHDnFjvHOrzALqHLi3b3suPT_-6ZB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH6YVIx9twm16Zds7xSeujL15olxVoPTXJBJbKKhjfuQ&oe=6A7C5A18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w64Osd4rydkQ7kNvwFuJ2VX&_nc_oc=Adqc8WIn8u9CGW9pDU9EOhx9KoupBaZQBMeiCT0AZXqKi95At3IpukkFKr52BwVkMPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa4alPwmLkO_FyTbRhQLIBQE6ifHSl4f2kRvB4gldAKw&oe=6A7C4891"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
/39001714_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQQrC1RJYUIQ7kNvwGNYU9E&_nc_oc=Adqu-ZYMCMDxXAQlZbIZXr97sRFNPvho1to3zL97Ru34qKV9_9hcumvwzWSPR05Xdeo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NIxMqPZlD5Us1rhjF9qH-JhZcu1syTMgQtWNy0H7d_g&oe=6A36AC22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4NqwQoopSYQ7kNvwFKWLgq&_nc_oc=AdqS3ZTz4G_mJPYisxTdK6w_AtINMg8JPIhD813C3GqTd8p7t5iMR4jDKdf1VDKjBRA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VJt1Oxy3hg6RsHcQG4TDEpKZemroaaBtzhIW1KQNQFw&oe=6A369ABC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zONDGwUpZhoQ7kNvwEqa_mz&_nc_oc=AdrvJPoAWmw8M1ychCipUVOiGwQ6nUOtZlJvY-a7cnCglewocxN-wfyQ_LLN9ogafeI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R8jtatqjc0bq38p9VvukVR19pKjx2Luk_ethhLzutIw&oe=6A36A3C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pIoQvnKCcEQ7kNvwFb3910&_nc_oc=Adpgb0Uw8lZq6JkWnv55RX4qr5klIPhhlbrxui4UKtCT_euF8pT6G1b5Mn_U4PMsyYU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-11rGWXdAcWmV9ttN9U8m5pbt6MPMzUzZAErpJloKLQ&oe=6A36B2D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad6G-_iIGWQQ7kNvwE3_Qhk&_nc_oc=AdqMrrhlVHXyeY8AomhLQrGPvclBArMsyVoroKnBOxq34jZysNkg2wkYw3IDCij_emA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--cuq3AHv5OUE9HHxitmbQDB5on9b0bWL0pYcVukqbPA&oe=6A36A151"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
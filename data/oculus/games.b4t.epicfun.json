4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeXTo7UYIEsQ7kNvwHGGMvJ&_nc_oc=AdqW8Yp6onxJoN-mBdqzPCvM1O4i9rcUSAzC6LpkK_GdPvDC-NkLcQveTFM7VBAEhMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X_Zsdm9DTIGeD68-H2LiL8R_d5L_NDs3aFT-pyOEbDw&oe=69FA0722"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdMx5Q4Bj9oQ7kNvwFzd_xp&_nc_oc=AdrpmxFZsuFtu6M1kknvIeIZy66aYruYbDn5LJ5Xq-1D8K_9QaFWbs6tSQfKE5aFKpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PW2mnkNKH4ROsyBhxCKNGpZNSq7B6TfYAZwJjknf84g&oe=69F9F5BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABjyA9VeQaQQ7kNvwFt99hQ&_nc_oc=Ado3akwC679tYQkrL5w8yw8OckVrxfdqK3nXMgIx4x_TTFff-toUPejlstZFxutJn2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hskFzpoQwjB8Hi0skaSXCz6B1BBpmVB1BJ5_2zCf-3w&oe=69F9FEC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e75uF60qFeEQ7kNvwG-o_wK&_nc_oc=AdpTqkHuxLCvSNaSbI0WRCWE8gmdtRoJVG5cOVgIa4TsLfOtM2s53WqjPSjUnQKmNNY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kQtlVDGD-TV6N2AN4LvytAVKw_BRizt1j-FUkFFnRsg&oe=69FA0DD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W1PDOmgEiMQ7kNvwFiab_H&_nc_oc=AdoeWZRQ_zz0kuqoU4ClmkRWiKP7_r0Saspopj66LlboXRFHNyJA7kmqb0fDxWRlyxg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fKqB_FXA37Z8arz7HE3y4cGVGkBfcF3cJ4SHNYLJbwg&oe=69F9FC51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D4SACmre2MQ7kNvwEQy7Cf&_nc_oc=AdpQYdTvawZjQabyy58VzTZ1TEUZlj8bqaFCNmLAFuVvhZadJucDceLBNqotk5NYhzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WvZYDrKj45a6wBT5NrbOZ5L59Is9ckcxOfV5VAvopTw&oe=69E0FAA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4olFVBMzk4kQ7kNvwHlRaG2&_nc_oc=AdroYBuOpkqqq30moks93HqSSpzy9mROoJTbMBevKDVzN9I3qIvf2Ggai3oua9ejixo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v4OHmNwgM1xx21ZPOZoiQRUvXtqn-yRm9t4A6Nsy7YQ&oe=69E0E93C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AwpXzad20wQ7kNvwGZ46Gx&_nc_oc=Adp9a5NVRZtLj2R4ETAGzi2qK7ApccwnYLMSxxBXiEjodcMVYM0RtMtfIZKyeR-0n34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bbBfrp9YRWRNtGO8ModRoWw5F6Cq-oI5HDJLKI6ysbw&oe=69E0F243"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LRJ6K1-QocQ7kNvwF5yyK_&_nc_oc=AdrEdUFwNk-S3aCZRGKet9FGl8Mnnon6dBgtNb_sWChLtd-7PfQLPaxZxxVQJ2USewQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_UcLXn4ptdfR2kX8-2yNMs3G3Qa4dY1zq7x2TneSafQ&oe=69E0C918"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njwoQMEYmRcQ7kNvwGUyh0K&_nc_oc=AdrKh3PnlsJeDT2aI0wH10TZxox6aiLHqmyRYPQsMFD_4m8Ktjw4HG_bCfyDh0_IJrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-RLPad12bMY4qoyWpF7jeKQXA2xH1yzrs2zdJeh4rSg&oe=69E0EFD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
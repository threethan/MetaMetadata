4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G7meLfc_DMQ7kNvwH5EReu&_nc_oc=Adpezrh_MdUYBHoqWwQbPiUqAQf_d2d7Y2UmBWamNza82ejw5F3fENjI1_Hi9scmfmo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAALNt4dDGCvDK2iIyNdBFJw8Lmd8budnbBRGF2GeUIlA&oe=6A662222"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMxhlJz-e7wQ7kNvwEnVdDi&_nc_oc=AdoAG7ik-XbjSxlfhdNHRHU6zyCsIIzA7rBlVUDmt60fCaUXV428BHH49xY0esY16bM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGkGwaIyWv0qWFwrKr7DgkcDiinqQjtB-CneU-ZT7OtQ&oe=6A6610BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSpgm7EaYxAQ7kNvwERoU0M&_nc_oc=AdoCAfQ2kSHLbI-Lis3m7XCqBQvFt8ufYbUmcwQ-SyKIyFiDdK_u1i2LLafmS0Rs5o4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRMkwtHFOZ2eE1UYCV_bRywNin3GvhmhwKRk9Om64w0Q&oe=6A6619C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CULCnpC1524Q7kNvwElx2fP&_nc_oc=AdpeAdxzV3Lin2uLP2A3430Q1Zm1xaxmRHxgeevf9bR0MkjH-yyvCZ8j8sBeqU8Bt2s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkrGD3N51LeBTE7OIlF1k7I9dmZkgOal5yuy5QZT9NIQ&oe=6A65F098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4gd5hzNnk0Q7kNvwHRYZK2&_nc_oc=Adpt9lX7opg62qI3qv46xyJ8f2iefwfPOi14PnCVirP85Fmg8NYXSH_BI22I5eDfir8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-uUEDaov8XjVCWazoTBC6FXpaNoFnn_osQwPc3jH-sw&oe=6A661751"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
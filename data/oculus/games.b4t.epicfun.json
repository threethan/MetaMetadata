4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwPaJ6rQNiYQ7kNvwEaVLEv&_nc_oc=AdrCDTbeVoL0NoTWT7wk4sncus7iZvrRypmQ4TYMKJCP7nMiITb_JqAIfT_Tw7SC_-E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4YNmiD5EgxAwFlHm-Hg2dQ9BaYNKoOuCXsBYF2uZsmw&oe=6A8AD3E2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj3ZyvcqfVMQ7kNvwEJABtn&_nc_oc=AdoN4GYbk1_JOWeZmeaNldXSJK_ojsdb9bLZ6G-8v1CC6Yr98W7mzszxWkQRNDN3DPU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe5tF0ZXdUs2qAfFccDvR8lRSp-pTIewI8ESn0UMlFtA&oe=6A8AC27C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRMjsFIHJm4Q7kNvwGsTQ3G&_nc_oc=AdpcuOc-TTpyt7YNiUI7oJN4-lkSv9ojxxMjL0RRcTYJ-mv3WwVqyWBnJ8c_tFoX_5o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjzepTfco0lLFLSghb_DS4Ref2DMeTaoDf2HLWED5Bzg&oe=6A8ACB83"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKc5sOlnqQsQ7kNvwHy8avp&_nc_oc=AdrP6vn977DGuxruYxNj9SVD3CtfcHkGIb1CYtHguviKToWe7vSuzjW5fBs_eLPsYBs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGSDPBuImBj2dImnm9tAmC0lvBU6ZseWfb1YGJ3EPgyA&oe=6A8ADA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSWztJDsXO8Q7kNvwEEDb9S&_nc_oc=AdopDJRYLN0gWQFJY6xmEELpoqfE5pdVVMJj66wOLK1ilnQDW_hciZdKsV-kt4tLnSk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQwmK02N2Na-rsf1RjY1YaXNNhpUUDhP6dn7-SWu5UdA&oe=6A8AC911"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
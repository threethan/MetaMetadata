4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAoCdm29-XIQ7kNvwGsCAVl&_nc_oc=AdrVR9dn91MctzyReDoHb06Ol4GLDLDX7InhqZR10mUcZxBc0UtdQ0L8rk0fsnPFfVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yvGSj8RL07SJOlS6GE01m-tjkS5Q6S7jBBKJFLL6f_Q&oe=6A1D9FA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2enWIcPhf4Q7kNvwFCwOD4&_nc_oc=Adp1qgC7h-7gnfn3Rk7BcAhO7ksaxC90fjCKCwwVDSsvbfMsiXN5j1AMAsDRIQbx_IY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WUm1_XFRcCT8Hqm3-jatoEOj5Vv9nbL9M8M7okG0lgA&oe=6A1D8E3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N6bNh6XHlYQ7kNvwHQKVH0&_nc_oc=AdqURYBRNSg3Tb3TKxtNDDX0Ojr3S9L3NxN0tTnm1o2HxBtNGZGq3tHvuWn-yusnwBk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TTlJrpnk805zfbol0qTx4pz-UoPqtGRAWZdFnOjZyrQ&oe=6A1D9743"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHqmnZ_POYkQ7kNvwEUc9LP&_nc_oc=AdqAAwfaYmX2Z5STstdVQ-MPHPqRA_l4r3ZkhTEsrJpQS4SNjDZtliiYOeLhcKj-3JM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OIzZuuQA_LF2Yu9izpt4X8lqnWrzhyN6etIvbDujn2Q&oe=6A1DA658"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYLfOe6en-EQ7kNvwFdE-05&_nc_oc=AdrgqNOgf42zDwOu_kYWfZUrJk9GM2ZFDJPXixYKaDi6jip10r_HRGXBrqTbyT-cKis&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dImTELuP50fOfrgv3H5bKdYAc0N42Cyktm747xXrjQQ&oe=6A1D94D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
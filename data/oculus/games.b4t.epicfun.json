4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4d7ylRgJtYQ7kNvwHUaEIz&_nc_oc=AdqektP9N2XLvM9EYBNnhQTzLKeVxLDKnt5KLiK69ZfqsxLEQP7kbUOczaBWUKAkR4Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ6hPAhp58Vc5a8k1YUSUCHmKjuWtGwUEEJnt13JkEGw&oe=6A940E62"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWqvCX32uNQQ7kNvwH99ppF&_nc_oc=Adr4VGnMPLuYCplEI7fgoVUobAdjlVuMdcG3tDIbVhe84j7uIJAhs-uo9YReUHWLE9I&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK1bP1bO8G17l2_nDB7SwyBtorB5hQfI65kVJQBdU8ZA&oe=6A93FCFC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGwmKMvX-h0Q7kNvwH6dCk7&_nc_oc=Adrapv53YSG_3CCqzDbEb-R6JqKs9bM3Ze7v3qlTDl_bBDZ3Ed6gC8gPSqpkrnK9Ne0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHco9mzB-3BiVGkK8noHiiR6-kMdEOCDv6KTnEP5OXMYQ&oe=6A940603"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyxrIi1E8NcQ7kNvwF054iX&_nc_oc=Adq9Yfp7kQ7nepFWUIgUDs-OMBjQHmn8yY_BK4yHqqp84StCaO7fU-3nNwzq4C-o-_M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQVL8Ok9TKNtizbtnAsorPZvGp3ueoWhG-5sIzNPK0tg&oe=6A941518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmiN7cVdoRgQ7kNvwF2T9Se&_nc_oc=AdoZSoWkaBS9UxLX4uqV4KEBa7drbWBqg-pZObot1JFQtBZdw2jqA-Ei0a8jy7NKKpU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB4TG80WPf1FBIwwfcmcesuVZjYLyEAKAwg9l0CiwiXg&oe=6A940391"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
AA804C3"}, {"file_name": "migrated_image.png", "id": "872240139867614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngv7lFyyB1YQ7kNvwEYmh7j&_nc_oc=Ado5fy0B0bO7Snfj4-qQCCp_jjfTpVlyoYvdk0kWOovNQ-b02srVNjVcC52LtJ2ekVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8PbkcIZq5TSWVSUBnjLf5fWm9ipeBk-CPX1HYK0fWDA&oe=6AA813D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/160mg2", "id": "2705960462757174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974868_2705960466090507_6493344025829965824_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfxb7eFoE5YQ7kNvwGSezz7&_nc_oc=AdpbmmUT9q17kEZuyGj4t4zX-rrOOuhGAt2ixNsspxncbjqrm201P0gcHeoM22eEpjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZh6eiBy85Rjq5dB4mLkbfEG4ibRz14G3mgXbH9thQJA&oe=6AA7E4DB"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n
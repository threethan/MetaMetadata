4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSQDmJaCDQcQ7kNvwHu6lxy&_nc_oc=AdpJ_Z52z1mvstEWfsRHWbeBqvrfXuK7t5tJwwNTSf-7WacBWtCBZzEG_p0f7Va-84M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGjYI_cnjtJItORuaMuKitGLnwiKQwjmxJWqcHJwjb2A&oe=6AF878A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQzmp3uowg4Q7kNvwHK-jJ1&_nc_oc=AdqcnUsJ6AoXV9-YVt75RXfTSq1LtKFK0f5b9P4KYT_grZ7gSlylW5Gk8CswuQwybRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTpeCIECY8HjbE5xb7L0W1O3SIbWBem7c2yMTRaFX2YQ&oe=6AF89F7C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFKeCKZEtwwQ7kNvwEpJgRd&_nc_oc=AdpszvdD3rJ_m_JhbPBfrfT3eYg8NxK4io7JsuxD7MRn5cUFgtrpFj4603VaEx9-1TQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsfnV3CezefTH1-OcXuZ1b0054V9sTH5QVT_jvTgN2fQ&oe=6AF8A883"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV3dYlTN_7QQ7kNvwG9Katu&_nc_oc=AdrIBRFafuYkpMj0ZE4c1zyfx7OcTEcOAnkWEydVy9jhJtBsctq2KSC9Jt0S27ifdpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS4LQZSjfLs6-yMlOp1CXiVPZjFg6UzdOm9x66oBJNQA&oe=6AF87F58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxUvB9y1AosQ7kNvwEURYDD&_nc_oc=Ado9OBnFyUhpHRIaWZGcHIlPmxtBs1L4geg3kLFP-hZJnPttjkaMgogrExuZyiPfsls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb7xAe2sc3XM-eChwY7OcZTCDtUUTeEFbNFeNW2hyMrg&oe=6AF8A611"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
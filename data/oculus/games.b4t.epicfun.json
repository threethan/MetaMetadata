4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYWtKyi3hVgQ7kNvwFQSgKi&_nc_oc=AdpaEH6MgnolmqrFdz6qSmbFyroLP4rubUnvRe2rBqgyd8_y-qPZGRkH-6FUewKiOQQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0H-ILL2OzOKIcVvPCo0yHHCeHArKLgf7SZKwOa7-7C5A&oe=69EF7B22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEr2vVxKTIcQ7kNvwHnQoac&_nc_oc=AdpuT8ZUMPrDl-zl5KbFFR-aYzECSewikhvfS6kacVitYPOjgFeGrghzmy0VHYKKQBo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gQB7V6cPjb_7ckttZ2bT9-8ezyCK_cyIIHChXh-vNGA&oe=69EF69BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PGqNrurpvAQ7kNvwGQzKAe&_nc_oc=AdoAyfTrN1yG2u8VWB6u6NU9jRjcQjN76FH8JMvg8Mwt87p-SLt3-plhXnLc72y5OZc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UpSfpogbQK-oMnde8TnXmCrFduYe-HQQLd4Qov9uw6g&oe=69EF72C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzlyDpxeAcgQ7kNvwG9-Jn9&_nc_oc=AdqftskfaOljoZBddADFoAKY3M8rxpy5ZD3DrCSTVRPcq95mrDfk9WkZc1qeWpZDEZg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sNt_UPFfa4QUWTOF5B8AkPRkW12mevUifzVUMrPjbng&oe=69EF81D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EpuJw1cGK0Q7kNvwGZmMGh&_nc_oc=AdoktPGZxxcML0LZiAtGHnaq-wXH2CSzoJ9i4ISS5fdZ4Hz-Zcuts3o2ywWnufCJyEk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20bgyqF83jsQPdPg0VOFZLPziz155VkvyRUSQLItBDVA&oe=69EF7051"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dzF0uz-0iQQ7kNvwHtPTxN&_nc_oc=Adpg8j-KXcjpU91K940ZkXLj0hdLyH62G-JnsAhzhnWtYkLmqzE4dCqzCd58EHzv-CE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr8_l_RD6Ndg-LhG77awa7xkkDmbpvIB4ocANuDLnhXg&oe=6A5F8AA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqoB-WkPmuYQ7kNvwGCI0Mu&_nc_oc=AdptHIxW-wlnAtjqYOM9gg0HZjDv_AGGWjuRTMfV56WINd0mPsa-TaOCZpwawd_HORE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU0KoAZGWkYkYSj5Ve_kubB-ipxPhYg4m5fzKCyWgLbw&oe=6A5F793C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Etxm4XOWeDsQ7kNvwGiVnix&_nc_oc=AdoAO_gmEXy3uGCR92GybDyzMKqd2oTII3mBNzx7__nq3Z2JFtSBjOAQHJibF_02gFM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZwXqMu58LQTY6Qj7a0x7NH4Zhy-bF3y0Fc61UgTyQuQ&oe=6A5F8243"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WD1Zl8dBjIQ7kNvwGmf4m3&_nc_oc=AdqV33uNOiJIKNbhMT0geqfYw21Y5hvLP7beAtB9HUFNL3HhJOZF23AMH8vdvSs34oQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuL2MYG90HYtRQK7S3Io747oW6Dov22PnUy-3_TceNOQ&oe=6A5F5918"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7z0U3aYkvgQ7kNvwFLYehK&_nc_oc=AdpjEpdlUHB1w11O1EpNyTeXSHIebGQZNHE5k4IvJO2Nuka4W3GDA7a39O5x2gvXcik&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSZBGwUZ1Br35Aiwzx4SPMdQ8A_Xfb5mv5ljIJGtRS7Q&oe=6A5F7FD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YhQ19BXV2oQ7kNvwFPDIm8&_nc_oc=Ado02u3jMuI_XnQgp9srPlEDhcouTOTZtj1bpkzT7iNwd9odj7Y9W6_2iBoFLHZPYeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoJAnbQItY6mcC0UyDQOANVUaqUMW526Fi9yn5HEX4Hg&oe=6AA80D22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gv5ApBafLcQ7kNvwGUmIYu&_nc_oc=AdoZWGCWKrFbBlO5EXelOzNnxieCk0RUEWYIg9jKHu8VWTfrBQZjLqvrr_jpJql6g_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxceelrJIWbBqu3V-f7HlxP7tWpd6ll9DqeIA65lKJYA&oe=6AA7FBBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zNwndQPTRYQ7kNvwF3bMwm&_nc_oc=AdpshbA5tiDh_mrOKMkUHwUyllbhB3XwJL9l7hhYfFXt7wpmd8_Fwg9gedDSYp16DLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMZpqjYP_b--BBkiu5YiQxj7d5B2uZdnyHO8BBOgZVQg&oe=6AA804C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngv7lFyyB1YQ7kNvwEYmh7j&_nc_oc=Ado5fy0B0bO7Snfj4-qQCCp_jjfTpVlyoYvdk0kWOovNQ-b02srVNjVcC52LtJ2ekVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8PbkcIZq5TSWVSUBnjLf5fWm9ipeBk-CPX1HYK0fWDA&oe=6AA813D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFcVpOp_wxUQ7kNvwGJ4O0C&_nc_oc=Adpah-hIwN0tVmk9woYwzMOMoFxhxZGiXOeZnxsktrUbXx6bgC1l2dr2NDsC0ykS79c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNU_WQnwy_ha4sQovQ69kGpnZ2esP5ztsCG-Pz23vW_A&oe=6AA80251"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svymjjFu4sYQ7kNvwHhX7Qb&_nc_oc=Ado6TltRkxz35FWFvZzwRnyle1i8NkGxPgnDU-imHqc8P3bYGO_OTQmP0YS5GHtORxs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTRoHr-AEm6pD_VbxJ9yS1Cas4HlMLktewPitL7RmBMg&oe=6A4E6722"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWMgS08JuagQ7kNvwEFzZGx&_nc_oc=Adr8kbCr7TSpOssT7u1toEPnmxSLQQmZAW2HH0x_OlTz5lb8lmzVXDXicHbVvQqGgLM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCeuhwz3vWV3rzd_RS7c5PWITT_d-XfQ5lk6AQ7BSrpg&oe=6A4E55BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX4JIFnYM4sQ7kNvwHiCV01&_nc_oc=AdqbCbp0UH262l9knBDHMImA0mkDweuv0yVugJznjTlSh62nZNA3Eflr3UW36DRFeCk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjb1q-9x58AjPQa9h8ZuDZWJOUy0xq_VeSQV65FoO_DQ&oe=6A4E5EC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OydsA8WSgQgQ7kNvwE8IzhL&_nc_oc=AdqbNCTYl6l6xcL-SJtQ8wHjEOrnBTvEHBMYKArB0w6Rn_7YoX8BOrHBT4wOZnToYnE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC9eSqOy6lS6s1mtMucbrZWOY0WIo5DEK9TRBgQb-qig&oe=6A4E6DD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kTExlGF3HQQ7kNvwHi8R-z&_nc_oc=Adqm5_O01A2nCpnbfvWvJtw49uzRn3aUNbQamNVAdZTSuEjn-__I5iuhuTh-hyCDYrw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoWGqZUMBJjN_u7g0Fo5XkQj5r6baPFvYJ2ktaSz0RPw&oe=6A4E5C51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
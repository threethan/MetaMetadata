4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhfJtZf0s8wQ7kNvwFZPIl0&_nc_oc=AdoMUqM6sfxzuPY27I1wAWmtMWSMsYDVMDCVfaMA6SzjqEvNLGTviBU_C-Z1VYkdawo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jVYWtUGgZpLMEH6BVWLuM2woYAUepzCyJKck2A_RwfQ&oe=69DCCDE2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY9xkaRigH4Q7kNvwEw_odp&_nc_oc=Adr4WFXEoQtdvnFrlCQAqjBQMCPVqDYnUOaVs0IeN2h_tluHSj0-51xS2_D0U7fwQ6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nona2Q7k8mmDh1IR0heVi_1tJyJ1y3I1S-9mjbNMoZg&oe=69DCF4BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njdx7Vx_vnsQ7kNvwEZK-RS&_nc_oc=AdpIvBAbIom6DjXg8NXam25xWUIpnnYTISC0dBT-j0h8pIYqcfU8JNjrXlaQodcJWfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b9t8-JrLMrE1OoDpfB00xCuNwXoIYVM_RiDX72hmUEA&oe=69DCFDC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtMZlD0mVjIQ7kNvwHN8AxX&_nc_oc=AdorKlUKj1-4CqOCqMRJjEKN-iMAE326eWhKB6f5IMoRUzwWJMLmX92hv_ngdqbEycw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lQYIN_nyjEa24pshQk6e5gcuDfJaYHmEJOQK3aMD9NA&oe=69DCD498"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJiAqM0bDN4Q7kNvwH_7IKQ&_nc_oc=AdqlqCeC5t9BiYqHbfpr9oFp02N3OLBTv0g3R8iLp11ujjw1U0Z9GnoPpfE-LFBekqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af338RwgpRZHiJiDHPKThcl-1Qv2aunjYa91Ui4WtdBROA&oe=69DCFB51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
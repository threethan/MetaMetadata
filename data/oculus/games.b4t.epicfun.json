4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPdCiIBxHlAQ7kNvwFAl_Wm&_nc_oc=AdpLzgWOs8VM8woD8VZ2nWPUbuYqhQbgRCdM6YJ3nP746J_lw0nWIR0A7xsTVJtnPvw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPyZyXW7qmo8fctVUXFhf12xbKa54t4_UycCNyfk6zKw&oe=69C512E2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgyfrfHauwUQ7kNvwHYk_BP&_nc_oc=AdomV4_XjWAjBgY78ytTCCKoWlD1-_s1lTSmNpJEjmI6MohNtHEqjWtTnrdQ98h2Dbo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjFZ280WrOIDMCsmdp2K-UJFwflMkJb9ZPv--NW_NCog&oe=69C539BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEk9oxvx904Q7kNvwF4HmCP&_nc_oc=AdrPkzCplYTKoG_iey7XBfs4G8QQiVl9m_msP7BPL6WHPsCrSpsn0D6caMio1cktVmI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8qQ-wrw1iB66p4T6e04XMulBgjyX1LrLJ-dcTX_yw4g&oe=69C542C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHtLVw0CjWYQ7kNvwEmixcY&_nc_oc=AdpW9sOIhZ7X7AxCEwAsTC_f_NUht8V8_BUQuCE6-QUilxLlSg6OWwuVySs7hhMHgL8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4M2wxzZsApWbL9cBX64GLRVnFrByLE-ULk5JLrViBrQ&oe=69C51998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV1YX9_PAukQ7kNvwH7LLYD&_nc_oc=AdonLAOwYUT21NnKL-2XpPAW3lDWA_H0SDPU_-7FjieINOU4k8wnMm5DZyBwApBsqAk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhcQmIPH0r2WXBDVnKA8S9ClzoqSnO69HfTvUPkpCR1A&oe=69C54051"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
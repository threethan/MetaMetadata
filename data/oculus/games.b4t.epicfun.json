4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhHgW8fhTi0Q7kNvwGaFup3&_nc_oc=AdrL1fWQtLfny5xuXD3cA3N-h5-Dc91P33BNimB5V53A56q9bk5A1HAZdtVUm0EbC-g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eaJwJSQbsX3u4OjK9HkOC4IT6ybRQl36z_bHDIRgVSQ&oe=69FDFBA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLnU6qkWIfwQ7kNvwH72jBo&_nc_oc=AdpWh_J0R6XySnCOci-aH3mEQGmuzYkGlHckXAFWeaU8HUGkB45NGaY9GtrErFa6MmE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75MJg8eLYZKNtzezZi3QYu_WLtclgOXDna0nSwmH-YsA&oe=69FDEA3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqQjaF-hqJ8Q7kNvwHrQ7IA&_nc_oc=AdqBWahJex5RnMdHV-Va2brDUH6d5gfA0PGfdLdC1ebstmQYe9ipnEkdM8QbA7b9AV4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-qgtYVk8FnfSimVJ7VBtq4wzzvbdImSW0_VHCCjrEZA&oe=69FDF343"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHPDZ6t-HPQQ7kNvwHtW5do&_nc_oc=Adovkj0jxsDX9AgbqAyYC2LFLZb4hvXhDeURHjU9WXNl-78XDkwcvfnflQQTMZ5SSrg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_pKBUUcw3mjbRjHhpV-kCjL2fA4avc6Gx9S17ZOhyXQ&oe=69FE0258"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7Rsd1AAgqEQ7kNvwF6H4g3&_nc_oc=AdrP8Hnh7e3bwjHd5n2L-9Y2ISpXrY5vOsg6xpga_kGbxCZpCzmzin-y5aHUrSOkNao&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44ZEYzHzXhGDxxqBtdLTeopFq96omNQl7JxgXzfrUP4Q&oe=69FDF0D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
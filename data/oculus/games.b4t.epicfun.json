4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D4SACmre2MQ7kNvwHQ7zF4&_nc_oc=Adpw8YWLmcYsXremSZW6XCk4zGKyWhxAGGUseSZlUXnp1M7Q3BO4Jt7uB49BgzVRL0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KfTU4zviBtFa-iweJ4ztQ-8IhF6B0VEnrnnOl68s21Q&oe=69E36562"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4Cr6s8xdJcQ7kNvwFMHIlR&_nc_oc=AdpGas4tA6_afYBY304QDQDcuE2hHmco_RZNOn5hJYtMGu3soo1xo_A7VTB1ZmGqZt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tGc5MI8LkPKtv6EdWxAoI-Ry5PAlm59xTgOqZ_nY1pQ&oe=69E38C3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwwL-W1cBqIQ7kNvwEjaKmd&_nc_oc=Adrqk3my301ZPbe1-fEEJ7ZBNmJUGUV_JFBpbOszqoxM_8ylQ0BYwG8IDaGEvs4fJ9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13HkEye1-vDW5nMknquOzzlU_Q7kmk1LkKFGMb4mjIng&oe=69E39543"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LRJ6K1-QocQ7kNvwHfeo3O&_nc_oc=AdrHUgZ_bCCntdhjYK3z-F6tXwYAhgA7e2KFbBKJnKeZO1Raaek5TAuDy0gl1ZkIPUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-IzPjXkOQMinlETNxB-A1v6j1mbS3IBd7bUhuqoBmMA&oe=69E36C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvdLHKzWQUYQ7kNvwE-b9q_&_nc_oc=Ado-e1H85Nbur8oRxj_2gFFMnXMFj4VJ2sIX0x82AB46CcZzycApVv4dbkzFQCcMFrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35hirlk39lh06L8K-Q-cO9bUGiSrFPioNiW-O9OKdUEg&oe=69E392D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
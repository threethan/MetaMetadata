4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd3iOY1pCawQ7kNvwHqmDV0&_nc_oc=AdpmI4CBMrf083t6KImQOZk8xhbe6WWRU47y1nQWNMvf_0_2HEUOm-s-4PLxCCxpaYQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX_T2EmpiW1_U9D4tjX4xLdEJf02QkcPh6z67uwGVKNg&oe=6AAD5322"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0T6SCYvdq8Q7kNvwHTls2U&_nc_oc=AdolQFX9h7iRgi5TvKo7-Qe__hhoCBuMu8rY117fv8aAohbyyuXfdzBhpUsQ4OqB4QE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwA28rM-Qkx_CFYpwUjO2knlVv9Z9Hm_YIduLdVEUFzQ&oe=6AAD41BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXlbZD4gkUwQ7kNvwE-fmkE&_nc_oc=Adp8Lj2-CAqFifUBPfNu2PR0mCBQBLXoNLM1un-rs6llCnX57OO3V75S6h-FGwY1bsk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBJR-5xHFrpPJf2Auqaa8XtRJw-7DlwgxZXvk1tJ3gZA&oe=6AAD4AC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3iR-oAfwOEQ7kNvwGYHS7r&_nc_oc=AdrJMsz1vcZ-8IwDEc6PJAYxyYODdQzbCcr7AM_SWreqZhuiYu3a1qXQembbBzFphjM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoOTkAgiWvry44OTshW16RHFG8Seru1z_os9ovZJivbg&oe=6AAD59D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lo_cdoB3PR8Q7kNvwFS6Ydf&_nc_oc=AdrPtDMCpseet_gnq-M6szdUQZ2q6hi8WeIDNRVzo5CFxYZM1ZmzldrmuL_FzWzNSsU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8cyETJYflIWVby2axKxxMenXazrckItKmrinMQnrYig&oe=6AAD4851"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
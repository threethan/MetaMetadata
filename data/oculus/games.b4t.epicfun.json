4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgMq4Omf3B8Q7kNvwEsvpXa&_nc_oc=AdrOMply8V7Z8gPV9X2OVgqNBOf_SZhrk_w2VWbuZuHRifxeAlmWemubTjErNzus8co&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw0d1kaU6l8pCt7iFzRz6ozT8KQL5VTzivyh6upW0Z1Q&oe=6A9ED2A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRNhrhqW6QoQ7kNvwGyYDuR&_nc_oc=AdqVEnmfjgT8JsSzbCZwhaC7PBlI6NOJ95rqM9226NVqpHkvSsgqUB9H5B8WjnSxb-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMGD5x-NGbGzQakFZlUaCp24iMsCH38C5bVY8i8eGqNg&oe=6A9EC13C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2TdXlZklW0Q7kNvwHZJxXU&_nc_oc=AdoT5Z0xlkhyfMtopYC8ahwpl3YsmlVHTr6yRHPR4zwXrZ-nFH-0qlv5syRCgcN2TJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLau4v2CHx8kU9WD0udQHNDYM6YnkTmr8KBwXNwPDTTpQ&oe=6A9ECA43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix9dNw5ST1wQ7kNvwEOPWMp&_nc_oc=Adp8lFKATLSjyMlMddUzPq49qphF7Rr0n-AaQw7ttwlTgKxSh4lIVoAw8AJbOBkwIHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKgJe7ZlH3wpb7N7blWOhqsptkFbl3o443ObjO9pL1-A&oe=6A9ED958"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWkU9dCNevIQ7kNvwFFjyJQ&_nc_oc=Adod2oIdnL8M3uhKrqfsY1_Nr5cnPEjM11Z4lw1Rt9nQVo_yxnKGDwi8PiQMGFAFVcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGvqHLffBj2tPNS1GfrCJ5Z5Jg2tI3MtoefK0lAn1ySg&oe=6A9EC7D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
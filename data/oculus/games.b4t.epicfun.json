4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J93JQEqTLD4Q7kNvwHXoS_0&_nc_oc=AdpKPCBgIQL-dpzY57iFMLRrmpZvojRXuHDOo22PB5alZpscGJVBe4WfL6PghfZbbKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvUwBxuZ2DJXi0uChdSike--c4Svzfudre920fiPEh-A&oe=6ABE76A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-JdPfODI1sQ7kNvwGe9REV&_nc_oc=AdoK78LXWksnrXrHLi_WUfheKX2DgtCgh4xo4fdaBLScdz0xJx_pYvX7ctQf2oiCS1g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ50nuhCaab2SqrrDMxT_3wb7HxcodEemWPwDGLQSC1ow&oe=6ABE653C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVAUt1mwdyMQ7kNvwG_clOa&_nc_oc=Adq-kSYGbmDwVpPy6G3rMQNWcwdd2MvFtH1p7vRpUsRG0l8jnJJ3p3L5IsJWdmGC_iU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6u_EfMDj4SKClWX_55KHdwXxU3w6AHEpYET3nQKsUYg&oe=6ABE6E43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xKcuZ1Qw10Q7kNvwEG2Wq9&_nc_oc=Adp_V-WThUpPeHmyA59V17tNPsOKmSqKFGoNDM-Hv2AQZ1FXN7GFP2iMCWaGXIj_ABw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv1WONqXY2RduVEHZmh40mj55m4XXaKKKxVtciRA54AQ&oe=6ABE7D58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dWo10djWQgQ7kNvwGzesrg&_nc_oc=AdrzOf-TtQSCqinpu8-lQhEV9EmZiQXohb1tPIU2l5-WHUwShXwIoxKbl_GF-Ry0xag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhcDvJi8IDtD3Rm5XA8g6Ls5dnERk2jh0MK-gJXwrQOw&oe=6ABE6BD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVMGIWGsTxEQ7kNvwHH41nz&_nc_oc=AdrbSQRxmKPclj4RGr13sYa2Yqnyulv946M0O4CGDSV7PshzPN9aKtlu3nP1_WoGqmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGG0It0NZyjIpmxverLvj6DNykOZ2umAE6DbLGRS_F4A&oe=6A525BA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE5V1Nh1y2MQ7kNvwHjgnbI&_nc_oc=Adq_JHFAX-kx1GZsn7vreOmSIpYqOy1aBWHzVXmgtAYfRf4PVQcprXonhSMlctY2Dzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC02To9UKpdx0wHMZcbHxwLrr1hCOssxXT14mRoltt8A&oe=6A524A3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MuZq0FoyPcQ7kNvwF_EUby&_nc_oc=Adq65ItS92HTq13aHsPSctJUrTvMotJaT_pTYL1Syov_q6lFaTMKt7AX6rRo-dEioYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFV4iLAly_2t7th8LkBpTCqV9izqiisTazyjPZLJtMvQ&oe=6A525343"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHmC2M5j8OsQ7kNvwH-4EsU&_nc_oc=Ado0vLVTpqbCK-alIQ_1Sj48eVwfd_M9jykpdJf0VC6u1u1uCA9-kfmQ16H0toDc4oY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlY4uE2FmUe3_3cpaVHu__3GAtqQg88PKg3gW4VHA0AQ&oe=6A526258"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOt8TsbH3KMQ7kNvwE4Mhko&_nc_oc=Adra5wAEyD17g6TtAbzDl3DtezAaETWExKJTGdmwI8zwirlsVsEFXEGaJOTDbml1eGs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3G-qSdWj2FTVIoCt4blrEdcnxdPHw3pnzpQXeg8W9AQ&oe=6A5250D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
9FDF343"}, {"file_name": "migrated_image.png", "id": "872240139867614", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHPDZ6t-HPQQ7kNvwHtW5do&_nc_oc=Adovkj0jxsDX9AgbqAyYC2LFLZb4hvXhDeURHjU9WXNl-78XDkwcvfnflQQTMZ5SSrg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_pKBUUcw3mjbRjHhpV-kCjL2fA4avc6Gx9S17ZOhyXQ&oe=69FE0258"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/160mg2", "id": "2705960462757174", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974868_2705960466090507_6493344025829965824_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6BPYkIEWqIQ7kNvwG_kt9h&_nc_oc=Adq6uWZxHdsGl5_rSSrXfAn6fysJy1WrmN0dmMi7I05frt6pxvnQrtU2qz76p_BkvAU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75NXPh36rEcIFCh69vwr9L0Iu6voFw-W0cx7-X1H2YQA&oe=69FDD35B"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n
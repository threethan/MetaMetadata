4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JFcVkEhpcwQ7kNvwHCwKVU&_nc_oc=AdpGpGis5n9dxGfgDZ2sZ8ki0i6StT6tjNFaUmM9OcPgMZkavMu6rF0Ju5NiC4C6wMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfjmZantWJ6ZshTjYe_MtZlDqDn-_7Tltk5EV6lpT0nQ&oe=6ACBA5A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTY4CtLAHk4Q7kNvwH9_cxr&_nc_oc=AdqMPluHpCl9asXsiAlCwWnzJPnKJJ5Q0idPc7bNPMXF3DswU-8vcsZjM4GcRLZbVp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7_NMGbZKowj_IWV07P1x4JlmDupXE59r5EQQCTy7GvQ&oe=6ACB943C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmedbQqDalAQ7kNvwHoP8dY&_nc_oc=Adq35QPpq61SKmOkjQiGlYnFa4mt4mS6zwMj4IFrKfbE4iv5Gm7uRTb9iLlQ78WcXtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMTx9bVvngTCPFA98jTBi1BhYbm-FXr1A3yqRLf9ERfQ&oe=6ACB9D43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8DRW6U1ZlUQ7kNvwEv4EMq&_nc_oc=Adp8GO3h3GAKBMpAYJdlz5YfJEd-bWcgCLLihHcdGdcjR1lolTJbigDM04Y-iiN_5MY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0x-V-ABRVdSDJbdKSGipUZAI90cB43xi5EpqdW9Ie7g&oe=6ACBAC58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THHsbpXrDfkQ7kNvwECd8VS&_nc_oc=AdpXsdCcg1IMa0ShDbH_LrbI8GrQ6c9H1cp_DXbui6SWXcp49ProTMCkLBmpVguiO4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfPY90TRZAb4FN-R1Lgfu7lrEdB4CjmPqdCIqjqOUKkw&oe=6ACB9AD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL5oADxxuZAQ7kNvwEvvnH_&_nc_oc=AdobtfonoYIOrQdBql3dXA5FUoTbCgntSzB9Rl-HQSdAbgLHmY-iIrqyovf3Z2u4v9k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoA60JgNwdiKqutIlJx_ChZfI11qBYKQ18gw91Hr8uHw&oe=6A565022"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3DKKYdof4EQ7kNvwFT7Xel&_nc_oc=Adrif7NgPWpY7TTT-D4v6h6SXz2qUGMQ17Q1tju0BBol3syr8l474EDbFEezpaJGaVA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDetTbNSSReCpI2gMUozOxOSUmMh0j7NFmImfKNf2FcfQ&oe=6A563EBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXKfPmetJ-MQ7kNvwEzBP-a&_nc_oc=AdplG9UY0HzjuN44Tw_EYoRe4FCFJSLp0V9P8scRfUZpsr9Esd8AjTrrMdUWIygCHHs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOmOp6UzI4cunwyiGCPzwn1ZHxyaYSHSdTV9QFo0eznw&oe=6A5647C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXpLQcxmwyYQ7kNvwFGpe39&_nc_oc=AdoCSlYlSLrwjf3WdgmKy6FvSUc-3gMw34PUj3ojtSqYM6Gz9NhpeVKA7gEuXK-S77k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkESFAQbnhEu0mI0mKKCciJuTTn7AsiuHdrk40wUUJWQ&oe=6A5656D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKAA7GSSW3cQ7kNvwFbvbZB&_nc_oc=AdqSMFBtdEqVkEOYgbnsU3TjkneABrXD9s7S6_gKUJIjBTw4XrwieHLM5Q311TKPabk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXqRruh6hbT-egIs-neZp4H9NsJM1pBIHreM5BjTeOWQ&oe=6A564551"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
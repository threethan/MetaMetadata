4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D4SACmre2MQ7kNvwFGuQc2&_nc_oc=AdpzykCxmvMfK4JX1Dh4X0YiG_-uNC_6njzo0R0zRFJtQlk0aZHJKgV175gRGJBTHnw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15nc1ZbvfGxpuslMg76pdruW-D2eaF9RLi8_oFtgz2YA&oe=69E24C22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4Cr6s8xdJcQ7kNvwHxCYIw&_nc_oc=AdrgHn6BiiHxRsooefdEphA7LClMEvXE-6SiSPG7Dy9XeQvIKER6VpVGCSW7SHDhT2s&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Rhgw-948VOvKAHoIMRZAIIA2vqYieEteStKeJ1LAL3g&oe=69E23ABC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwwL-W1cBqIQ7kNvwHgbfEK&_nc_oc=Adpx_J58Bp-M1mcHPDkWcuia44bauMpbX8ncYLcgMHmHBt1ozutg8B8ZdkPswGz7NrM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Xx45YquB3gofbTapDf8oUsIJDrsFqbPw6-RXj_H9BIQ&oe=69E243C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LRJ6K1-QocQ7kNvwG871FF&_nc_oc=AdqWKcn4xxkty_iwY9DT2baK4CNcT7hpy-yDUfCrcjlc2GVeYdUHmkvEJlmZeufNn5E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i0LVtNOQGPMHiMHqOaRJ5ICO3vf09PfIjwY2SmxWn1Q&oe=69E21A98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njwoQMEYmRcQ7kNvwF3TQFr&_nc_oc=AdriZSz8ZII-Y6uUuuDI0G6Q0Gd1tXfjCppcLNZTkZaoDakJIXk8otuP_7RIW0tomJ8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Fl_196OqhKG8IA5vm_cu66lieZ6lAoUJKuUdzzBQu4w&oe=69E24151"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
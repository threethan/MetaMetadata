4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyA7Nv59legQ7kNvwF7f1ks&_nc_oc=AdqNEq09h6BnITV0Y_I33pRQBdyhuTJvB9l5myxfqPOmWipikqlmURiHh06zoHcsK7I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XlfQgPM6XsPCK5pk2QUB7D7594KP21yzBG6HfYbteGA&oe=6A0C7C22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uitq9p9FV0sQ7kNvwEx-p2V&_nc_oc=AdoqHdeIKyzE29ki9JRI32Ota4p9nJ4gDBV4cLEGGoAZWGSeKdCgo07VMjR5C73_0AM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sBKkc4W4DmQ50vDPv1cdrMbKbzgrptVvrUnJUv4AcBA&oe=6A0C6ABC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aolWYadkc8Q7kNvwFaa_0t&_nc_oc=AdoEMOXwwF2JV3352Q4yt-kHvmU9vw9CYLqotwTpQnH4sEoMvV7iiNEvQ98rpCMRxXY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W2cVfKHjScJUJHy4vNP7dQGFknSw9Ze4TOpqc45UKng&oe=6A0C73C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwltW_0DJskQ7kNvwEZbDbN&_nc_oc=Adq_Y65_4zqV24TwMCmSTzJ8tqhkmzjrpIHPPfuIr3Unv5K-MhVHkM_cjXZMwp-kjWg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65lhxPpNFTrroJ_kOUtjs2KhJzV2KPU78CogGA45z7fQ&oe=6A0C82D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTI90ugeC6IQ7kNvwEnnwxF&_nc_oc=Adqix14bLbEYmNiwcpT_hHHBYBmJFyy0A2ntYxL2-reyLQiWUssvXWTJVijSdNSYsfI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MqHd02wmkYBcdyPvs-5aGskhjDDYpIyi2mRZM0QLSNQ&oe=6A0C7151"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
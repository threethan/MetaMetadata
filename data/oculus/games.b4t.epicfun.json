A6E02C3"}, {"file_name": "migrated_image.png", "id": "872240139867614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHN8Fy3Qt_4Q7kNvwG50Nax&_nc_oc=Adqx98Ku9MhPhBOl5Z1Ye0tv1caUJBAsQg7tRMk-X6DU7kSXsmtYBBi_29mcCp5FuyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkkLbSFUHkopaIbFubmai0v2j8qMF8U_p6BzHy2XTjcw&oe=6A6DD998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/160mg2", "id": "2705960462757174", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974868_2705960466090507_6493344025829965824_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhb6U2Ch8UgQ7kNvwFKO074&_nc_oc=AdrJiC1dn4PD5r5Izi1BpqnGvDpvln385buuXWBlVKDUMLEk19WQygjHOFrqj4CRLXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6K-P0sv5qb7EEskI3KHOxB_Lsrv4upQsZ5aFB6QwbaA&oe=6A6DE2DB"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n
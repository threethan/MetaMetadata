4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXANXQIGGd0Q7kNvwFx7v9G&_nc_oc=AdpLvgcPDqhdFx4eTpoKCVgyPRM1-FDS6A8iJ-mCG7zXOAle2SgaScypfg0yzU6Dohk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc--YWch4AZoXGvqG6t11mtfuzj19pIsYc0zQibc1CMg&oe=6A735122"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VO6Z5tA6y8Q7kNvwHf0gV9&_nc_oc=Adp9Va2WbVX52teW4Z8nPpzpTr0GUxyxRumHEQ5DM6IeUpKywkiUFBpgI3GtrtftuMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzW8Pn0oEB3o231xgTmQoVBdte9d-I4WYmlTl2m52SJQ&oe=6A733FBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOjsxTbzTgYQ7kNvwHcOolQ&_nc_oc=Adr0XsF_8jgusNlkR8cC7QT1V3-hIgzip8ORE6xefqvlStGftMwxDOYlc6pasO3FbXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBtjYNEs-_1pRWhnZH8rcAaoVCu7tH_Cz3cyD2DPjWDg&oe=6A7348C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEOeWnpxFngQ7kNvwHOOXN0&_nc_oc=AdrnTsoLbcDEhkLKMSpmFynEo90oC1oCrT_vcZ7r9jBT5EgI2m_GHboUe7xov5zfUJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi4h2dJv4Ga9VVLYbCw21j7T6cLVu8rsofC6rfvRma3Q&oe=6A731F98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-HpBMasYrQQ7kNvwFKXvfQ&_nc_oc=AdpVe2u4vdUkDZcF5hJFdY1SD5stuv_FpjlYfDDWYBPc09l_uA4ZGiavr_Li64zSCQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKf9ippv_d3tQ14VWPQBrrY-7LH0TyiiGrOGU4qOkNBg&oe=6A734651"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
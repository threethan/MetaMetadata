4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWxWKVTCvt4Q7kNvwEe2JVO&_nc_oc=AdqnOVCVqSuEO0c6MHHp53OiArgCoD97Cg17jhQy-elzLpCJB_KMjbRiyG9eTr7Oo84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUebKeCVyjWdb7BKnfpjAO8xfqH82BqF3Ebn0lHa_pvw&oe=6A998CA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qe7zIWY3DsgQ7kNvwEzV5UO&_nc_oc=Adr8HVP2QpFfPStctqhcW4cKOWx6P-rw_yaoOk0DdMgPiKxBvL1_4jq09u0M6_0cLIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPw19MRGILuQAYWIQgLMCqLb3aX6r1jypp3XygMvY-LA&oe=6A997B3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSVKbfnytnYQ7kNvwGExMZf&_nc_oc=AdrsGjCpGQdZP4mxMmu1B17R2ldWEUtPyBzC_026RZ-PcG5UUCPNhuX7WE6K6s_wrzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWRD0y-aGPcrgp2IAyJpOne9akjNDR5I0wGVMaWC63jg&oe=6A998443"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFU_JdbYwSIQ7kNvwGlP7Cv&_nc_oc=Adr8kUb0jWruKpj9pVfyP-rwkN1GG_-UlekwOknQwUksY2gPFOhDsVWAdj_68QPo3dM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlo_HUSdTMwBegVPfpsTgZGFCuHDRXZYNmZwJBNTWhug&oe=6A999358"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9BB05inLRYQ7kNvwHIXR-n&_nc_oc=AdrCzf0gxndlGDG8x5Wn8vcyClQa3VJeJgFwfuPXBQVyiyln-iNMOnD9AdyHcRsLFx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOPlowcc_irdPk1904lRubm-HrjujMraFlYiCQ3eUE8g&oe=6A9981D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyA7Nv59legQ7kNvwGgpWdI&_nc_oc=Adq7uSw0wLTxEihm43ikq8zt8NRmNYYKTryTfPi2-5mdQl6ZKuvGphkiHKxowsj3p3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rLH3Lz1nDWYluV1QR10KJ4dwdImo7YesSF2uR0byWHA&oe=6A0DCDA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmZ2lsCjQAQQ7kNvwFJN_6f&_nc_oc=AdotXZ12dMdkSuAHu2de1drVrzi55u5zQ8ikCzTvDD38hZBU3ORnuwMNXwemc6NP81o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FrYBUZeuVd6WiUfAch60S5gI067QQKVe7bufgYj3agA&oe=6A0DBC3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUvhYAfOkLgQ7kNvwGojfiu&_nc_oc=AdpTan50eGXiUZEzKkmMdp7pEPbbZM8fr4rbkuaMJtU5sbJQ_jfKri9sMaW5MUKgSQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af789ymLFfdOK9J_kNnRbSlxKrOjM4pccM432yJOa_sqcQ&oe=6A0DC543"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwltW_0DJskQ7kNvwFs4Hbp&_nc_oc=Adq8d0YPXd9zqfrO_ii2w6Xj_9NfBg_8R5SlzZ5b8xnAECesfWbnqtn47GgOKDdSca0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M_gZo8nnFTR0O0Uw5VewzlAkXie3tQt0HmHUqOCFtSA&oe=6A0DD458"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTI90ugeC6IQ7kNvwFMSBhw&_nc_oc=AdrCvBZJLUGyyqMsiMg36l-8H1571cO4xIEqmooHV1oaWRGcrmuQsrmqcmcGIm8MGBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69hh77eOjyQvOLbL45ad78uPrbdc7_-AMLUo8mqXLwbw&oe=6A0DC2D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL5oADxxuZAQ7kNvwHnPoHO&_nc_oc=AdpIndvMy9sRhHLK81qEh_b-XKxzTixWNmQZPC_8WDBda6epXZL5MjZg28MLgElDt2E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkbw6UF-0JA-OStrRKwR_HY8U-l_RF1NRAZ9k5sO1XdQ&oe=6A53AD22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE5V1Nh1y2MQ7kNvwGzwyWo&_nc_oc=Adqr_yq6YXCdljEc_KJYkqIaHsYM2DQXUVZhSrdgoi1CxYFvpIatVZOACp7DqcnaPNo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6ukw1Kb6ux_yVVVYwyCi6pLOhcMSZfeiAD-Af3qKHiQ&oe=6A539BBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MuZq0FoyPcQ7kNvwF7i6vs&_nc_oc=Adq06l1j3ry4eSA9WzIpG63c9xj6pa6PSg-216twOMJdmOi73DhUpSbjCrBRTlDTEWM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb7tmeo814vVP9pp5GjIk5NEn5EzvGNs7qAKKJoPZOow&oe=6A53A4C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXpLQcxmwyYQ7kNvwGvNmOh&_nc_oc=Adok5VKFt4GN4Yilpa45NXWKpy0qW4FGon_k3Mc50bGU_dfeorA4mtogjNo7ECW-yt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzLR0EpYiHDNULx0oKRiqhf3fb72VaVV43Dte1ms8kqg&oe=6A537B98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOt8TsbH3KMQ7kNvwGe3ENw&_nc_oc=AdqgPp3kRWOFX93wXgkDp7WiwcbcOOA-5EbfE5loZ97Ph7R2YhYfedty9SrIgd8Vj7I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbolA3ktt02kn0MIasMArkid6tXzYxQD-VAPtFNPGU1A&oe=6A53A251"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
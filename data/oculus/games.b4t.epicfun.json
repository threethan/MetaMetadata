4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLP-EYTwec0Q7kNvwEyffvG&_nc_oc=AdoyFXhdK-uKMpStz6qt97DT_rRcdo8AR2qfWY51Vg5V-un4xRMvzeQajZV2uaIM4kg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD0r2F2MVtw3BnySJq2p4WlMrdB5BulYsJtcksIx-Iqg&oe=6AF9CA22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQzmp3uowg4Q7kNvwF2p2L2&_nc_oc=AdptrE5dRtwhUt-S0hDJ2IIux9VCC4pwoFuoOY-8TdzE9QHmgMsv1pZNK6qG-jSL0fs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF3irFOOpkn-lSkHBY-lDAFKLP8m9KleR1SowT3s6NzQ&oe=6AF9B8BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFKeCKZEtwwQ7kNvwFlvU3A&_nc_oc=AdogZE2rc50914WqHKbd-dgEqeHGLFlDtoHmzw3YfcdHZdthOZ4-_0jYTV-F_AyLkJo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2JCYzn_Rr9DxxSmw4R80SCR9rTr9HJsHWvtL4nsUVlQ&oe=6AF9C1C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ0SzZq3XTkQ7kNvwHG4AeV&_nc_oc=AdrB8F9BRod-4UjnVL1FrYPxvRlHD1RcrWQZyKcV6B0qQX7oC9Ft1zjPziTpZ7Xp9p8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR0jx_IHZwHhOS25iDM-XGQjj4OoM3TryLMHQ39x36-w&oe=6AF9D0D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxUvB9y1AosQ7kNvwGvtk9Z&_nc_oc=AdrYBQCXdND7owrj-fEn95FBiNTC_hnBN9bt3C_jKjv00pgbQrXBWtyf91d8eVAZJak&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJizkDPCmkZY0YAMsLrO6YlzsshkurLrtNpWElAa9qIA&oe=6AF9BF51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
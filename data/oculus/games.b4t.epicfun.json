4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL5oADxxuZAQ7kNvwGfkf8I&_nc_oc=AdqJlAJM7n5CLAiF2ZNpTcaS6BhQ2ObOeOZ1o3lexKBJbGjSKPE9xdgwaOZk4piapYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFyARlh2jHVWp2j-8OqIIkJv1iOYlrDa7FUdx90KWb3Q&oe=6A54FEA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3DKKYdof4EQ7kNvwEEi1uC&_nc_oc=Adp6Kmb7t5kmvVNf8uuXGVBQmK3J_lmSAqYtvEKj5Sqqsw4DCEvDeUqwC_tB5xkG7y0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzdKNDX-tTqmia9UxPg6DCk4uZFx3uw5EWwNYd2LQUsQ&oe=6A54ED3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXKfPmetJ-MQ7kNvwFpCDWO&_nc_oc=AdqBD3fHTNITH-kwKm5n7xPY3dnxBuzssBqf-0d-S2rxgKEx7PvbhrzP-ApPnvYEq6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDMk8p2cJzMEuYH7m-3lWLEcAqSUwzhqVLOakQ2_VPmQ&oe=6A54F643"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXpLQcxmwyYQ7kNvwHiitSs&_nc_oc=Adrgj1NfTeRiYAq7VYbsmELmrV3YTQc6jUUqWJmQSWilteqMTIGJG6dUr7S0Krk4Z9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm95F2NFnAeY5gQC3adghcx6wprhHQkIMdUFFHuQv0BA&oe=6A550558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOt8TsbH3KMQ7kNvwEaKSxX&_nc_oc=AdpXZ2mqpAgbdrzuZC9Oksv3ZHd0V3m2yRwGogZyk2lnJu-_rFm_uFPspURnIVMqqps&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8Ia1Ip2UebXpB-zckZQ2k11f0G1CIHaYkSuZKnJ4LAA&oe=6A54F3D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPhu3nukFjEQ7kNvwEf26kZ&_nc_oc=AdpZy32HfVnF6vfXNA9Gu4sYbT-iBa6emMHBQgDWqxPYPbz4r09J2nFf8z8KWbm0k5A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_85kpWYKtK7Q5LFNQ8_XeXFeCx434gSgm2jmBAIxRzEA&oe=6A219422"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGhz2PeRlxIQ7kNvwFBKaCL&_nc_oc=AdruwD3xqbup3whW0Bx0NCdI79M9s8EIWJCElUEupLAKcMp4dHpf9XEvS74vFxS1j1Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N9H3m92JALqLcjb0_KNsZuByBYqDpAlyDbqd0W0sdNg&oe=6A2182BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvlvBWw8v8gQ7kNvwFz0Muv&_nc_oc=Adq5nWDzCgsL_alln5Dqb7wCtAGj4PPxLrNZHFl5IEqDK923i1aO7jk9tMP0UBU43GY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iLbTH1xOve8DMLlaP-PIXre4NbHcnQHfuL-0rMx_Vkw&oe=6A218BC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTpVZYbMs-MQ7kNvwG2oy0h&_nc_oc=AdorFqQFmIBZE0544UhhNcHgK0xpwNss3NNXfHrKu7vsbomO9rdy0CipCkg5hBFlAh0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ULG_JT957lsciWojPiz3LTdTrJSndWGhyiyWAJIuvYw&oe=6A219AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqcILvXYEPQQ7kNvwErnq-L&_nc_oc=Ado-hojJYRSb8nA3j3T1YeqqRZ-ZBaWqB3Lb8ITW4mZm4KLGk7o9kdSctTKX25etTJ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yhaU4DgwWh-mohbEcId-pXwl63HW9HKQtQFM3y_Hiqg&oe=6A218951"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
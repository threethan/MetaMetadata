4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYfMAuwjWE0Q7kNvwE7VKhp&_nc_oc=AdqW41DXycBLksQ7Pl5UmsRWJ71VpDDdfQ_5dZlR9yahzSZU39AuDMhet12eerp65w4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w7ILaj8af7HbUXo28jOuadpmRg70TNc8DKvjI5gehug&oe=69E759E2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyayFsfKf5kQ7kNvwFrU0sV&_nc_oc=AdrenWdFj_G4FWlE7zkNFDBXQ081yUcfU0HUkvF36hh3Pa6Jq3RzdkPvPs4Vy1k68pc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fmyYAlGvX18M8p0CilQR3AluuSfpQ_8hKT5R3Jm194w&oe=69E780BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHtgvqzK0A8Q7kNvwFddOMP&_nc_oc=Ado-mAzDJMIbah8DGF1GdBf0FS2xLadngJW9zS4pDiZjnYby5_6lSrGTniSnibza-Es&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25ZdNIkFHXgg4hOpgDQ892qdJWH7guA__m5Kon8HmWzg&oe=69E789C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTrTYqEdPh8Q7kNvwGVCdiq&_nc_oc=AdpAO4ezrO3DgoqL6Ut4l3t2_GuGcOOPk2Wg7fQPhMruuoA02DReTjMEi4Y-Oazbhes&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1foRHxcsDR8vR6uu7v-4zZ0RgM_JSRJ4H_Bt6QzY2Yhg&oe=69E76098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pe3bl8Y5dQQ7kNvwG8oTm-&_nc_oc=AdqaoUfpF5B18Po8i5kUs5BtNdoH-iDd70W7jO-VJvAUvCqNyB8F0Zhg8qSbo-98QuM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ztj4IlMmXkZOKe-KyHVUF_hFK2Ezj79KFrF6P4Sb6cg&oe=69E78751"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
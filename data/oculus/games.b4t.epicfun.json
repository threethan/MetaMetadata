4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEE-W1OIwjQQ7kNvwEbGT42&_nc_oc=AdoqDrfVNn8Ia_cdTn2TUf8wqazsvSB5U9WA9d0iAG9xAky1h_uDbombeBxJ7rSdWYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd1yZw-gqpJ4uQCuweU0YwuCVTJ4Uejw25TkqG7I402Q&oe=6A6CB9A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewKumvBlf-gQ7kNvwFJPFzE&_nc_oc=AdoYA7UGwgb0XEOcje-4AnYQsYAd68SfQhKyJLHfDapXSOH9lRU1WoUrmqUStjlKbX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZXF60X9SAFxgq2iegYoM3njYF-FbGa3O0sdnuOKkOWQ&oe=6A6CA83C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8C515ShMVMQ7kNvwFO2_Mg&_nc_oc=AdoUDrVG0LBhJovC0KKeG3B5979Yt4FOSX33AovvL-98SkNoJNeixxWq1QIjgTkwCis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZyR2rfwiJmmxOM6mj339NB1ufFwyLqurZOAPM2auFqQ&oe=6A6CB143"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHN8Fy3Qt_4Q7kNvwHXwSrN&_nc_oc=AdrRioCkjXGhPz1szHFhyD6I5AF7kYs7k8YwHLzURQiyOrTzp93rKMMkEJCiega63RM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmy4QdO-cmBbFcuvar4L1q51YItXnIdyRtYdSHFzyRCA&oe=6A6CC058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqutesvaJ4sQ7kNvwEifOV9&_nc_oc=AdpPp6rnd9eWL11ED6bHCQKa5zFgVLMt65vl_X_eu1GW9lMyIiIc5rQQI-wE67P5UFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmC_C_6RkzV9iCGyS04UhbpxmecwUBkcOpoKPFrJW7UQ&oe=6A6CAED1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
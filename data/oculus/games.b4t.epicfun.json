4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3brTYTs1M6QQ7kNvwHrxbj2&_nc_oc=Adpt9TbIy6cti4nQbQlZUGtwy6un9Zk8O44fA8BHOr2h6wYLcx__-LGrirlLFqsqWqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J2lOpwHoYbBBXFUg9hGRRqKy6gdlIGdXRQ8I9y66JNg&oe=6A0887A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slBmS-2oLK4Q7kNvwFhWb-P&_nc_oc=Adq3t1In2a3CNsv4i2fnI36-8wQ0CGO-qTUvxOH3ah_ddv4QrGeB4MLXPRqk07LFtrw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zXkJWZfGynUFaoGy4WqHpQ76y5ksUPTEe3SVUh3jeyA&oe=6A08763C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01CPhe43E9wQ7kNvwGQ_5Om&_nc_oc=AdpFxRrY-HRKPd6lqHEFXCyI7UdYR-sOJCk0fIpuaCYCDIswdgcbqvw6sRP4kGVqMYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EZYM6Z5vw9kMwqWvq5u2TMrTfNzexc470V2cN7NcaBg&oe=6A087F43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaeN376RlZoQ7kNvwFRq1rP&_nc_oc=AdqrVpJfd8a7eS0rVv7j9zsx-WQj3q9g8zVzoBVjTjbwSZEAOCyDxyUbeDaqLv-igi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JldEmBuUj_hFfKQnIN1kk3shycqYe-vuUZuvBlcotZg&oe=6A088E58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me-TMyxZIOoQ7kNvwE_3Eo7&_nc_oc=Adp4MSO4KFVqfYLUzMkW1-UJobwSaZFS1yp-Iqm31OYe5a0UFPm3MQrn01vq7J0W1uI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eBEh7RJV0hw2xEHWLczEPVhwBGWxq-uJUnvI2bSthqQ&oe=6A087CD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
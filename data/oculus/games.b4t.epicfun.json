4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcTFPPMlLTsQ7kNvwFsZrEA&_nc_oc=Adp9SNuq8_a5oIM3IkrZY9XhJ2b9okPjbsGDdIlPFErYcoSE4_mgwIff2zkTkCVu8pQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNqDb2sr9qeknoL4l95dca3S07E_Rm8Y1KlZyjY4KMNQ&oe=6AB53C22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGdsw6G-g2kQ7kNvwHlTbLt&_nc_oc=Adp6G3O10eBtTWII7GQt4Zdm6CoTagjiZILGD8H5FvEkxoBOLPIouxcsV8D8Td4CYYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQTBIDsCy3awTjjGyBGd7EwE8hjBhqlzPkx55AiF0Pew&oe=6AB52ABC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAUaBl6cKDsQ7kNvwFr7iTl&_nc_oc=AdqQ_-1vffFGx2HKkJZKxkD8ohsClzthJFKPJqnKrbEz16B1QiE_CBawkrNvpeUiSlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfNFpQnjUdEWmxmJh0AmL07Py76ChzDen3QwR0Z1HidQ&oe=6AB533C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_bW01cXjAEQ7kNvwGLOZ44&_nc_oc=AdpE5zSic0IqI2F2_fRP8k3PBrcfMZJNpe_or5CMio4G9ggnI5narGDbSmTJ4hoZJUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvMaHOUROLjdqw6WY4_TDTytF6kC8_vPzXa4W984J5nw&oe=6AB542D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5urhXQgapAQ7kNvwG6O2xD&_nc_oc=AdrQ-oHzyxQ0DwLMlUMxCU73an9ZnqwbNEE0vlO8Jck4w_LvGy7j6ovFNzDtpZLtYCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbfjJIvQ9Lf3RLjNVXa6ro15zb12BUF08wR2angWzBrA&oe=6AB53151"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxxSqgujVYsQ7kNvwG86NOQ&_nc_oc=AdrjT73j2fkaU1HT37zP1vBcerOcX7OP2jLBeCA7_33v3j0KN9LM9UqfGkzFSGLlWj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v7h7dMBJCZnuCAoB2musQXEAxQLbjVj1xHdB1LeaeMw&oe=6A2D71A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrmDE31QYV4Q7kNvwHBB1lq&_nc_oc=Adr_sifOzEkplL4pRMJ8FiC7-5tgF63lspzUnmDVR7E8A8yy6hbGJxqfGAI3IyioieE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8liyiCZNSwgo5RQEVXQPq1oQICxgybcuADbctIOBhpeg&oe=6A2D603C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfLzYDPR8WUQ7kNvwHwy-9t&_nc_oc=Adp9h53SXYU_BZz1HP1UJMdN3YzGlBwc2kpN9428yfrrEq4b3PPB-yZ4tQ7_qIGkfKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z41kHRRC__nVI4X1NAxwgHAr-wyz8t1sSPTAhgcNRvQ&oe=6A2D6943"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfmoXU1RS_oQ7kNvwF8D-aJ&_nc_oc=AdpqtrO_lVIhovEg5HbUxeMZQv2mxkpwB3mNGc_x7BV9VtAVnUQHcfVs0NrF6epE0c8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e47PxL63xJPFkIenpCwL3DNNlrIWX4CR0-6UiVZtFkQ&oe=6A2D7858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umd8dWBBBtIQ7kNvwGAlGUB&_nc_oc=AdqNXgwwLPHBTa_zAdzJEpaKpSG-GMHAANj6t1OWAOIYiMhT0fn6ZTWY_fikFxMLVdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qpBYviK5VoKTBcS8uJt78qxsIltlacSay8DHBGJODYQ&oe=6A2D66D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh9v14RjZoQQ7kNvwFXIKsV&_nc_oc=Adr40QLBB42MFUQupmsVqJ60TCliYZSTjHRzcFLm9kRFmJzaTUt1fwwTs1V78lVXzUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0RA8eROecL8ZPkKR27TWoA8V_YI6p3QRQoX_gkP9mXg&oe=6AF332A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrN0Lpagq34Q7kNvwFBrB7I&_nc_oc=AdogSvX3UKLQuQK0R5vzVlx1pGDGQtbumcfYPvN-5s-sPERuZQMP5BEO9SaBf2n6ESo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSOixp0uC5wsMVJ-K7kvkK59iqBHwQzIk9iDPeMp2I-w&oe=6AF3597C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C8MLgGsJ7AQ7kNvwE2K26C&_nc_oc=AdqttGp4aKyBMsyVDYVXUZu9dZTeuwx2wkL0HwtmQ-lOG-3CZ4cgA3WZMOp2v_UnWPQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8kxEkwTyLMXFtAePefwXaRSXY-zntJT1PyZhKIHSKaA&oe=6AF32A43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQfe83ZqMCgQ7kNvwEJjQ9D&_nc_oc=AdoV8KvcI9PFPK1fVT0d8t3rArgLNdViwBDtT0OxVEg_qw9I19zqaa0iNw3zrUwpfIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpCYPAwLnS0XOlp58c1cw5WIPOr9WvMmWCmOG9MqSJXg&oe=6AF33958"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQpg5QHmnYIQ7kNvwHvFdGK&_nc_oc=Adq3z49ZyXh_0Osvn-PmmmrbQ9l6uIpK2814ZvvfHfCkj9fNmzwqnkbHOnipGMki9YA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDloWe2vCLT-WdCY7sxwlywhM5Xo8qwBzHXdK4IWqXbw&oe=6AF327D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7HSzSqli00Q7kNvwGuZpA4&_nc_oc=AdoiapOacB3cnMGqEZ_evU0MxYQ-z9lDhOlKZrXV6kllmotM7YKistx0TmNEG_-VM94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi5QzEmK918wtQF2mkTb5n4p4iGu6jNy9lFypGVH8gqw&oe=6AE603A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-4sq2eQqbIQ7kNvwEVpaeE&_nc_oc=Adqljbg2g6FOPB-lmPvXWrd1SBRT_2ehZzgGa7DYIP-V2UjIzTnBFtW-G_qut289BPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdZ42bffaO3LaqE7xpEwi6-sG27tZbuDzpOzZEUIk7fA&oe=6AE5F23C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsJRyHXsGwQQ7kNvwH7cCzU&_nc_oc=AdrfSuYcdRwuNz1xdriI_uJEdMQ-lGgARwk-OG7NogX7-LJJPqlMPaBg9OUgk4Axo8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkR-NOOtyX1vjJyDVN0jPfvx2aK358kH5g3XwV4ZvwEQ&oe=6AE5FB43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3kyxfGz3UEQ7kNvwHs72OZ&_nc_oc=Adr1ils5M6w2cusV_uEhVJNpvexkjFlPARIRvZtGCbM8_mKSGzrPtLUx5gCKx-Bq09Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj9Hh4uIPi8eeRjUQbGUhInWr-ej27wbiCCQ8KxkR2uQ&oe=6AE60A58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfuV5j3qI5oQ7kNvwFtIiuO&_nc_oc=AdocvBKB3g_PpXu2ByVrxS2aJ2p9UFUJrxaP1MNmxyBxSBslGDygcv5vMDZS8DLhNL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfuZLAjAzudUk9s27rwKyS149NtCLh1mt7yye4ehdQuQ&oe=6AE5F8D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ES1TS50bO4Q7kNvwE03-e9&_nc_oc=AdoJzPPSvEOWinyn5E39XsxBr1Fy1B05gVlqOW1RVHTaubHlLmEaqEuREoxOgRkkgqQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Eo1bdrcZf7KxoN2tMRF3gNcaJGtjoRmK_T9UnOJeh2w&oe=6A146522"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXrLh3sNJsAQ7kNvwFqPofE&_nc_oc=AdpCoTVVMPTFKvp-7ajRk7Nat_-hvuErZuEkIKsTK-zCpvWoMOAOz21S45jJYPY4eZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zskHHcUDsC1exlHAFd_b_cW9BNaBwSTF7UZVj9B29NA&oe=6A1453BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaLUVpCbONcQ7kNvwEb8nXL&_nc_oc=Adpbgd6Tv3Hlkf16tLjc5TZXfmJ37djo5DaU1SVIyqZeicRD57038U7WSTuxwxTFGcE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IqwtVVXNb0JEgqoCTYtZJat0oaD9DDuKK8wiksWbjVw&oe=6A145CC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5JwNcoyEfgQ7kNvwF8Ij3n&_nc_oc=Adp01ht9J0Wnq8uelipGyoLCBogS6Vsq7Uq7g_7-x2TmgT2fLDR3wsRpnoIJCfaUH7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tPJ4i8lvalaOLzpngfZhJXCibIyh7EUxc8SdnL8EXIw&oe=6A146BD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JGLIZFKpMIQ7kNvwELgkMl&_nc_oc=AdqL-oudwQa1Clgd9JCGAY6KoXcxycG7CL8pn9j_ZNJy_aZs8Zv0H4AYqYj1LLet180&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c0QCp6XDX5ClcE_n5AN_b1smEkrnY7MZTV3ORBmR8Bg&oe=6A145A51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
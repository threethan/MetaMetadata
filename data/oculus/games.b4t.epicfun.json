4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPdCiIBxHlAQ7kNvwF4tooT&_nc_oc=Ado2jp3IKN1EpjQDgHFWFzzTcFbWMAt41j-vbaV-kjKJne4c5s4VI6MjDyMPdz3fhS4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx907PYldFxDodZzHzfU8X8M20n7_xSN8XGzH4ONNehnQ&oe=69C7B5E2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvWuU4w86Q0Q7kNvwEwKMVb&_nc_oc=Adonjsl6RmYG11YUJ9jJrbGS_gJ-zbRe-nUfFFFJQxAlQae7dzWyT_r6lkRSu31OzMw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwS9QpUyX-ryy4SSeHjGh6SYl3YmmviwnN8c6CrmAlTg&oe=69C7DCBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKmIuGoB7kIQ7kNvwF9vLJa&_nc_oc=AdqRbDkH3pbOoJvX-RfdtYr0cm3Ouqf-BGUwFC180iobOU65we41yL5gdSa2UjWRnSg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAjGJtHy0UZjsW1u7WvNU1rW1HIU0S8MD6xQ80GlkyJw&oe=69C7E5C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHtLVw0CjWYQ7kNvwEPpBCY&_nc_oc=AdoQiErAKey6z1QSbIX_mVl9pif5aGgbrbZbUmB3fHbmIapybivKbiTIrRyWjkT6Lvs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ1qVen01DksB4oLCTrVDW_vUPsl52DF84lEYY4ciG9g&oe=69C7BC98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfz1F4eA0QUQ7kNvwHfYClS&_nc_oc=AdoYJo_lon6KeALBZft6wEBX82TWQdUTQTGzY1-St53foAfyzHG0SW-68HoaUIyEdiE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYYQbQ8wTJD9s5BxKd3fvkC4c88EtvSvNdGZMEEvFKUw&oe=69C7E351"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
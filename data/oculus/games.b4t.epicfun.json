4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVMGIWGsTxEQ7kNvwFgKI80&_nc_oc=AdoEudRWCrXWIuuhQpHH559dMtoYrTuE0Bhyr9muCfYhffFSee36PGfqo7zH8Nr1x2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0aQQFWBDHFqsBCYAe3np_O2ovQRJaQTBY-q-hrVw1tA&oe=6A510A22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE5V1Nh1y2MQ7kNvwGEwh3e&_nc_oc=Adr-zTbZV9XRjehUdBjpIu0B99En3T5pTFpLc1ldXr0r0xG5TddCCDJiPt6iQ6jHdt0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkppOWiq5X4YFOkNWxjygUjdyr-GjWhZE7-MeJgJSufA&oe=6A50F8BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MuZq0FoyPcQ7kNvwFrmydZ&_nc_oc=AdoZtU2WSiY8DlBg_KGHQEGz2CQfStu7pllnHuQDJk-FLCtyGSXkHoL8XKZ36VULOvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiShbKJ8Tn9BqIUYfRKp_RmNl1lpd69bX7RpYNvmGaNQ&oe=6A5101C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHmC2M5j8OsQ7kNvwG1J49o&_nc_oc=AdofQ8akKMIenywyi9RiMgSYDtesPZ-wUPfAAXM53PpUFC4jYhVziDsVG3zDxX2VbMM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzBGgGsnw9OgOa0yAXAmds16ERAKvIkt9zUJXXQBwXNA&oe=6A5110D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kTExlGF3HQQ7kNvwGl8Xgo&_nc_oc=Adrn4zi89gQBgy-EuPWTvO_r-1STWJD_cL-pWHxq2iRYnHwWr6Kq9R1fPNEiVE-8CnI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX__Z8k51-jjiu1RutdaKoesyCg2FLsm2Y6pVKnj908A&oe=6A50FF51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
/39001714_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPhu3nukFjEQ7kNvwHqMODK&_nc_oc=AdrHCPNPdrEvYV4Ht-qFIHJP0gjlQLSzvYJbsPES_JTkFlQVeaEjBki7-xApDrMa7YM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8riDdEBj0RXbfXLvxMCIKFfGumOXy8QaArPlr6iPQg_w&oe=6A22E5A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGhz2PeRlxIQ7kNvwFo6829&_nc_oc=Adq2HcZ3mqH-a8S-GE_HS-y1ypJGOTHnvyhKNokd5yRW9Jvq1vzhS8Bca8vEfjZXuuw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mphavZkoR3chYdZHKmXOTdnNaFqw1RE9sgrbC_M80nA&oe=6A22D43C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvlvBWw8v8gQ7kNvwGE2mdD&_nc_oc=Adoljqub5F124ZxF9mkctjioimGuMOg-hKN_5tmGsTWfOQkPMLcrB791oQHBjC_kyGQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r0bjsGmhxPkf8CCvvLBHbdHgM-9STc2Xii1GlT3isyA&oe=6A22DD43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTpVZYbMs-MQ7kNvwEvddk9&_nc_oc=AdqkoRihj7Gc9Ewc-GPahv_v4_PaHpV6_xTVcF6ONebwnh8V4cH6T7SRoQfyIU7bwWA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nwDPfizAD_aXKBkCps-aat_5iqXIhizMookypcLBr3Q&oe=6A22EC58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqcILvXYEPQQ7kNvwHWkn1G&_nc_oc=AdoNsrEGAdLEHo4x_iF_qf8YvEVt6Pnsb8DNxfCooKTqQZf6d_k0e5C1O7cuiOl8mFo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oNgR84BxugYzyLplmE7IiK8SU2bFB_fDmrgfmrbxG9Q&oe=6A22DAD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETUo5U9-wXMQ7kNvwHJIEJE&_nc_oc=Adr5JYoyGtE6WsG86y8lue8BbDRAS7z0j0Go1qX_dvkRbiAsnUb1DiYdskm6Y1ssSSc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w2CZPKYXhjJsTpgLKjgi2uGRtbCiZMYo7IIkIDlb4fA&oe=69D8D962"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhzbrcuuOScQ7kNvwFzobxK&_nc_oc=AdqucRkTlxzyJd6ODY444R69D73MfzcXXnSen4_PulkVTOsbh404TLovysOlXNm4z88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kWZuxL91wcfbXSo8oHlJPotP6BYu4d8MIzA7wE7Wr5w&oe=69D9003C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNpSs7yGurwQ7kNvwGSqPbJ&_nc_oc=Adr8EsdWSxVs3XYA23OByp4YJMPb8iqNbyHB6OPKhHYswqrN0X-0BKH39H06MiPqHMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UNGpr9TvnOMHBVQSfGi_q5H8k0yVBkkwiS5gWjxcfqw&oe=69D90943"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDG3MXeWz-AQ7kNvwH2VU8r&_nc_oc=Adq0CAF-X1frGOtNHTEbI8IIlIs9FbApaWjnpHezE5eUwp6jev6T7NNDmDAJp_AR-No&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Sxe9Z69bQCA7zWe_iydMVdy3lfELjH0MWTqkYRCXaXQ&oe=69D8E018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxJ3oVyE2igQ7kNvwFG2ojA&_nc_oc=AdqqoUn7yBBWRxA2Ae8KVqjC2L0ujqs-_CtBa91VMxtUunsmkWO0D57CbJheL6aa77c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af346LSp5ld2o4g_5MD9vRwihbU7xEp2sOmpHWllsRgdkA&oe=69D906D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
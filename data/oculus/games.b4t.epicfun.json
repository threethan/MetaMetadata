4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7HSzSqli00Q7kNvwEM6c_x&_nc_oc=Adq9zvMS3t_keY57U4JfBZ8rG6yGsbs1aQLI4V5syvgJdMxPqZ5ij9bFZuZva31BvqU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfjMWw7r6WRsmIa7O7sr1OP1xsEiPYResOuE8pAv4GfA&oe=6AE8A6A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRf5AcAdekQQ7kNvwFEa6B9&_nc_oc=AdqPKDmiQTF87yhBZhvdRe4PAMxEnnKYQmpG44pkuiTLeGD5laUYmzHDO4HEija5hFs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjWqjhgEDbOD2Jx1pV9sev5cHyMlazQ9fzwAPx7O8ZyA&oe=6AE8953C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZLNCS_DS5sQ7kNvwEogmHS&_nc_oc=Adr4Upjgv2OCt328ugaPQPZv2YDtsW4SACozaZKtBbmYVOwnEVfe_QMApY2rITBdQk8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBUe7n420YnVUnwZnlxfsoYxV7c6yU-J4Kb2YjEK8dyg&oe=6AE89E43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3kyxfGz3UEQ7kNvwFfgKZ_&_nc_oc=AdoE4MmFrflSvN7ANh34fa1O3E8tgAa0sr3OpCB5yOi_wI14B4JOE26iJz4MPzcXmzg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQarHTtQBwukauMew8F-CfeJKE6-OldABM9cebxtuzxOw&oe=6AE8AD58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3LImFbwPGoQ7kNvwEHb8Xo&_nc_oc=Ado3RX2re_Yska-WEG1q4pdTbpZDmpJgKv4WJTufnB7JjURlSR1FyyIv3tCxhNjd7jo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf1hdQqZrYiOf02J5aBQuhWNXDyze1U_rFLGUElpWPsw&oe=6AE89BD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
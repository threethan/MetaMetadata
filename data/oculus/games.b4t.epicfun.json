4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO1Rc25vwQIQ7kNvwHuYZHS&_nc_oc=Ado94fY1dPgkY6GFg_lXNcoqV-xrPa8HGy7JSPSt0skQJ2ZFbfE8i1xilalg0G9eQqM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHOpMZMFNFK9NO2LCx0mN_vYn6PI9rGuBhK6VGcMDU4A&oe=6AEC9B22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeX63H2Wt2QQ7kNvwG-cnFX&_nc_oc=AdojdmiHdGToPTsMQjeeNLxB_vEcFgTzkc4vGmjVY-hfWSfhZo9MWnTzfG1roehx1t4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUUedXSa2K-hvQ1jeeXKEEmvN1nXsY7M2nX0_tmRN-dw&oe=6AEC89BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk70wUbVhzkQ7kNvwEVgOqr&_nc_oc=Adq9o2H_hEy5K4tBA9LVyuNAzcpigXzOVgProLWBn943JcYi-s3PMDFzBT-JxYejoyg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5pfHcos6gBZg7iowpTHZlRgcN1BavGGICINJKi57q9g&oe=6AEC92C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJzPPLwipYMQ7kNvwEomDa3&_nc_oc=AdqAcfa_2MSIP9lsVcf5BreNfbBEaJtXo0BupyTYc0JDyIdsjNqpfoAMFvIT1L9ZIRo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWLW5b5o7pjCYX3cq2IsIe3LBw_cPGnMzsL1gAUKeKBQ&oe=6AECA1D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in7qbmiwiEgQ7kNvwH4xlVU&_nc_oc=AdphRpNtKit5AxnSQfGSTo6Y93J8XILEAOv0KUq68pa_a2OymYLKCLYyeN92e1PBqUo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIPcFUh5ZcMc_Uo6FF69uGqqARRDGXo-w4_F_ymQxRlg&oe=6AEC9051"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYWtKyi3hVgQ7kNvwGzfVXp&_nc_oc=AdqlHxIBp3eeLganMTDCj2ALNdGaT5AKXo25Hxs3qsCUJLztXUjvjMqYh8ts8VPmzr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zOx_lVkb5Z2xlxqnWX2CcYMV1q_ksab-dstihVcfoJA&oe=69EC9FE2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2jbUG3s4RcQ7kNvwGPgWwH&_nc_oc=AdoTDP0WKSwh6_t8lRPgVT5i8cHzDvPMXKE0nL6SnvNOHcHy-gfjVBXwVutRgZeh0ow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OGoLz0HvjJSophD27Oj5_c6Z4p_BWEZYNtRaBZBF2Vg&oe=69ECC6BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaRuC6xc_isQ7kNvwEQ6rUJ&_nc_oc=AdpmN9-4WL1lM6ZjRLGzK2Y4A-jM0u4Hey7wI3c3mrnY_CCd575QrzX8ZmbSiIdRYPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2u8EdobMbLKjQC1EMabdO9HbrEpi_LDHme1fxSrwi-tg&oe=69ECCFC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzlyDpxeAcgQ7kNvwEu8AG2&_nc_oc=AdorkStO3ffA9__cgwyhPqdaQY9Eu3HxS8_IpZ6fUqFfgJp4CZIgCp435TuUtKeAUSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27hSxySL6WTdY8HVQTN3TmYbcnyke6rakAlz0UUrzzIw&oe=69ECA698"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdG0L7UdxJ8Q7kNvwEwmXor&_nc_oc=AdpwtF4hlVjhmzRfxywuUv8q_XBqhKulzKX2lPI5e4Aw9HcukCx_nHTDLCdtCTamVdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vD9XcmgOwfh4yJX9lm_8S6mvXReRKmvMyUkHiKwE5Ig&oe=69ECCD51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
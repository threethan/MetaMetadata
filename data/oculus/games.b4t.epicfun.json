4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Jv6RjWNzHoQ7kNvwERPz-q&_nc_oc=AdqBUHw3ZA2ikqIsJw795wZzHihbXNTSQnEdIWK1rSKmcMB1Wbt1JiXpPU4Iu5uHVmc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOARvPPywWOQJUhVSS0OHDIOvZeWND1Lg0D79RAxMf_UQ&oe=6AD0EBA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zRV9E9fCKMQ7kNvwFQ3pi3&_nc_oc=Adr8eF0A46rPmLvUQLaOAfES_PA9woK_UgRTckgRYOcUGHUHFp_j8Y509Ff2_E4jjiI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMknX-I54TX4fdKsX_S3OUQBsfKkrHXtk3gMvvORk3AaA&oe=6AD0DA3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-26zpYD0sYQ7kNvwGagpuu&_nc_oc=AdqOxrb6mRwL16MRNJnBQTOd6-R0MYK1-wRHnAIPyq49GjIrdTNQsNaiGreLCyA2E_0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMojCPJ6-oiJ0QtojJofY8ZFjVtMCzNio1L4yLESNwoCg&oe=6AD0E343"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2s8kmELHJC4Q7kNvwENqurA&_nc_oc=AdpinAccdvsVVoBvAU30xAMfOxvGq0lmcVzZwNOfTcDn1kT9mf4NjOhbsEu95NPlRF8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt2DApa9yXDZ4AnWRZDnwBLL3DR4cWxQEHRdmoQff9pw&oe=6AD0F258"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYRDVg9EVegQ7kNvwFLwGVn&_nc_oc=Adq64eSFcXxeYYsvnybMy_tO10IWTifo8Gm32_Wi1lqvp0c-mXDvNJkcPYSBuT5bG0M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2zbyGewPWudULSt5R2HLq39AIsAxn3huUicSGptfwIg&oe=6AD0E0D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
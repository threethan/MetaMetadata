4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8E56kKjp2wQ7kNvwEWbv7-&_nc_oc=AdrzbE8KN0JSroZ4JwEPDSe0mpamjpTGbPVgt99GPACRcSkqC6d_oOGrrxeMIu_Gt-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtU7yprvqtVjltqnzQN9BS12717GB21Q5Vo98OCOkCOA&oe=6AC65FA2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciJcdiK7dBQQ7kNvwEUfMX3&_nc_oc=Adpe8prqh-yMDZPuz4Fgj_0Ss2P9Fe8q4zKjPnAh-Id0DZfEoofIMow8dc0mhVwsirM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXA2tyTAE1P-2NnxCjzJ9KLUSlB70dU2pwrtnhjuhIXw&oe=6AC64E3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9k9c0AClLekQ7kNvwGH2yYW&_nc_oc=AdpQ8LQs0Q-e6XYrm7JyRYPbjlK-0Q9rXq-Y0XV9ASjIZ_NdPPF9vAvtRyRz6aemBj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQrnkZFxw9V5nlvOX39HXSMN5UoKdAZMEWuzqus6g3pg&oe=6AC65743"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KwW7D1JGO4Q7kNvwEvin80&_nc_oc=Adr4ovIDci44NpGM9-VvlNJaZRN_2frrFs9BVnvLxlPIekd3_V3ZRYkijZCnbt2Wc5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8DGVEwWKwpnpXirHOwWWAyIsHTevytOSkzS1MOOYx9A&oe=6AC66658"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cApNrNSP1_AQ7kNvwFyn2vz&_nc_oc=Adqpk_mVtYSkKBxeKoQs_o6ZsBVNRaDPfnNNdc06euTU6naQviTg2tBFE_TCr1U_9_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmpTpLP-HudNyBhjuOOEYIeFeDcncKdqSi9lT8rCBNcg&oe=6AC654D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
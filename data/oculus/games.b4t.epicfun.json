4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G7meLfc_DMQ7kNvwFLRIJw&_nc_oc=AdrXxSgD_aHXvew0pk81KG5pQv7qYbodan-0Rhpa7AX-QjxZAoHxOPifrXFCZqNdhHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB75yybu47keXdVl18IrzdzVOqnJRFPgMU_CnhF3p15WQ&oe=6A637F22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-iwF3oCwHIQ7kNvwE7Ho9F&_nc_oc=AdpMMjWsEoHUlrwm-73eH2_IBvt2W6xL4lloarQ-pRzlX8tymdhu8APy4t7GbxgEfPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDic0TuPzMktAPCyHLbUdun61C6exmma6bK7WOtLU4nAA&oe=6A636DBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eroWQcddWQQ7kNvwFjtfhH&_nc_oc=AdrlSkGZQhLgCuwYCV_AyzWiAN2kLWiknXlSRwdNuOla4gO8MApx0JGGP_GVQkiebm0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlzawP1Iija9JiJKNb803zi9jU0yZNJhIPhQuT1QC9ig&oe=6A6376C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CULCnpC1524Q7kNvwGCBZ4y&_nc_oc=AdpSv7tdDraOloI4ggxs2APhZhU8TpwnncwtEyKy2h47BdOi30M_9KjY6cCVNg4oXU0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAKkElLFrQJdXbV7GMS3S38N4Xa3X8RUX8GjZrk_f9FQ&oe=6A6385D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnY8XppSuRMQ7kNvwEncGQf&_nc_oc=Adp3XMEAZ28LXmDbQ4iJ5Asa3RN4Vv14gP7ZAI5Dc_9tg_TrThwK_n95N_uyUcOywjo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBS3nJcHhnSVbSj9eCCZCCHAYLWdPSZmsZ0fHxmPSEZg&oe=6A637451"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
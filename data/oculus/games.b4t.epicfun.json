4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3brTYTs1M6QQ7kNvwH1rQYf&_nc_oc=Ado8r1YCI0hMpOz5pZ_u7TgKFzeV6s1wuPeS5UpHOhDY1kLz_BmJaROrBwrlwBezx9Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FeHIrw-MrOPnXq1VkdqPjIjym0AQ8S6cfo8InlS_dPw&oe=6A09D922"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uitq9p9FV0sQ7kNvwG_Kxm1&_nc_oc=AdoLBgV2zMjrPfxLRmgSZ6jrz9J1nvzwzrOBXDak-pQ_i8V_QLR47in1WBWnpwgxfY0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wam5reuYME_JrO8qhSGnFmPp3Qq1mWCQi1xApGzctNA&oe=6A09C7BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aolWYadkc8Q7kNvwFbcv8V&_nc_oc=Adpr7qp8a8bf4tlo7f1nY70JmmWUPg7t9pLQYmMHVLaWxgVylFdqXut2920Oj6ANeik&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gzATF7YPt9GHn2pDhKR81XIRnnJH1A6_ojM_D8fly4Q&oe=6A09D0C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaeN376RlZoQ7kNvwFYSojD&_nc_oc=Adpwb178I0WgmQ7YW3lon5RwWbNboMBTAZ3l5Lncn5nkOBuQZzVFNP8uK3Swn3B2jKI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58nMG_qayswC5ajjK5cQ9EEtaobHiggkpFNHY3rFLyhQ&oe=6A09DFD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me-TMyxZIOoQ7kNvwE6hWux&_nc_oc=AdoYjF6FS6AZ94gYI6EGnLphxbcA40vQ8OyxEKw0KTpnsUuKpx5yYFOss1Qdwp4UiB0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6530KDtyN3VxncwhkcQfSwVLQzpQ2y3r7T5laUNPhW-Q&oe=6A09CE51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
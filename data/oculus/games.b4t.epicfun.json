4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEfQns88zJUQ7kNvwFw2Z1O&_nc_oc=AdpnS0bse9bl1blDMnz-De46NfZd30WByQAx2OpKsw1PQP0oYwiskjxZSs-9mA_AfIk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pV5NBZ11vM8MwHDSSiMkwZEE6Nhkykxwbt1G7jhDBgg&oe=69F4C122"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8O90cbzyuQQ7kNvwHR_dx_&_nc_oc=Adq5XrVsdl0AySIe_FGTwGBwqopflkFRvqsPGuVFy4OiD06KdEMxdVD7EJvGuhRjnxE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1b0s16pVZ9eZthcyrjDRrDml-VZMrqKbSOjYQScZIdaw&oe=69F4AFBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvFiSZFYphgQ7kNvwHDlSZh&_nc_oc=Adr4R5usW9l6voNUe-8XSthE2A5OZKgDGyV77pyQvjIgz5RW5CpRKSX04TRfI88D8Ew&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1saTV95uDobPDv-R8guEx34LzSle12wmIcD9NcuaSzrw&oe=69F4B8C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dy-kYRanCNIQ7kNvwGBgnoI&_nc_oc=AdrCiH6_YIZzuWzljBN2CEmGTWxunFqzW0tlIOh-VOrYH33lIb3z51XopG0yuz6Ea1o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RpWxczWGHIlLHcnuOmyblULXlr4_tLulOSVC2NZDF4Q&oe=69F4C7D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4yCKjftul0Q7kNvwEvNu7Q&_nc_oc=AdraoTSf5t06Jd8HOSf7F78q8n3XbPyq2flUV0m6ZdaNLuCNbDLKhY4TcZUgFaoEzg8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rNXEMAvAKkk_KTsm0vqpmtrhO7BaP3XznVmjuNEBcfw&oe=69F4B651"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
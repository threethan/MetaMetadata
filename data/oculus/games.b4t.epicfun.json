4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ES1TS50bO4Q7kNvwHPfR-x&_nc_oc=Adrv8gLbS9rgkLkOOdZNb5VLvbN9Kcrd5GBTAdmQ_LLY66riZr5j9as8bJcDoh69kV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y_LGpklIYGfBlXppuwZGJXkiQOycN71ktXl6raN2I4Q&oe=6A15B6A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfvOuN9cDqYQ7kNvwGdtoBT&_nc_oc=Adr6uMdJ6z277IBUKreWCmm5vPSl5_m9UGuBUC5ncuVZYFj-O5QXNPaUfN36RkhNAdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JXwWbW_RdwbOTLagbwtde5_yBvJzj7g7qLF62dB_MKw&oe=6A15A53C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=024wDubFxYYQ7kNvwEThqGK&_nc_oc=Adqj_Gf3Zc8a02WvZLDJyFv1u7NAE3KNrdCdrCDfc9tcp4u8CAaCHfx55tj2FaaiGIg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nb1hekYa3Hxt9kqBbKhjPX0nprHyxC3snnf7TA8IYDw&oe=6A15AE43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5JwNcoyEfgQ7kNvwFyL2X4&_nc_oc=AdoAP1QCHyqLKzz8ZuEY4B-4wNVVcMo6XiUNqAVlDM_8rpnh-RCqfFc3g2zaEGb1-qI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vJ_vMt4xhc2pn9qK8IPl3VBb2wyf-vf04vB4oHFurFA&oe=6A15BD58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_WlRwJd06cQ7kNvwEXGFOr&_nc_oc=Ado6YAj2zaKKj67kre7TKNdDfSvgeXRa8fcDP6huvbbldjInx6ygV8UK5FiMNn6X8AM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af711fDMsQRXMECOd8_lnuB-owwfDJGLP6l3w_7R6kup1w&oe=6A15ABD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
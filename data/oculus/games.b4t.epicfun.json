4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrS4K2_rKEQ7kNvwFLfa3N&_nc_oc=AdoU5nyB5irAQEWF2bWow6z7Udops7wzAxkyG28PfCZFwa6VThb3tJUT0wa5lz7Yols&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr9QMTeWFEngNxZIk4VuhheKqzS2MoJD_Bd7wTcMRk9w&oe=6AC50E22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciJcdiK7dBQQ7kNvwHN6hG6&_nc_oc=AdpQjr4qzYPrYW1r8bGNzUYC7m1hcMHZyEVzTyh_XfpiyLN6Yh0a7pl-i9hsNDzgz80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_7Sm0iX9GriU_mKi6fAT7DLNA2mhumEN50zds8xNcOA&oe=6AC4FCBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9k9c0AClLekQ7kNvwE3ALNV&_nc_oc=Adp_1O561zMuviUlscbPOf4IaO8u6Td1tKZsltR-TRvip6MEnx9n0hjkBnYpjveSSq0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfsTkEzfIiMTbgrvkZFA2TPM1t6ms7jjR_0m3v7exJ_Q&oe=6AC505C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SWa00YrJ7IQ7kNvwGNaxZG&_nc_oc=AdpoCW_JBUb-MtVcTXn50LImwSUk2g5qgepNK24jCPp-Va1Gl_w58_HtgyCCGSUF9as&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT2qdJW9fZs6VQipum6TxNQyK1LDbIwmym62THu9ZLhg&oe=6AC514D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cApNrNSP1_AQ7kNvwFHKW1d&_nc_oc=AdpKirFN0QHbhJ4ra4nD4n-4zW0tts5FV6jD4AaUIrJBdqreP_DbspjuVgQDHAITLc8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQc7dxRkWznvSppv3WuS-j4VxWNgmm9OIYgT8Mp6dWIQ&oe=6AC50351"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
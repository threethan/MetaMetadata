4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJPjcdJhwlgQ7kNvwGr83YL&_nc_oc=Adpg7zM2mU-wlogqHVx8jN5jAX9eM8YCVOAo7oXNKSrkPGX1y_PV37BaTxf_oWUShj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18YkP7pxweUn5QCJiEL0IBP-xq-MfynKE8e0LmqX7rmg&oe=69D4E4E2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeCoWp0t-0gQ7kNvwG8iy9r&_nc_oc=Adr8oqrKuGlCRUtMv1yw7O8fEed4ArvH51C2iZ7mnFgb3fZt4iuxY1Wuz5rR6MVIUao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WQ9h35HXb2Tak6h7Kgwvy_5-BiuNVHYcTeokK0xG7UA&oe=69D50BBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_LIkuWOa7EQ7kNvwHmrrbC&_nc_oc=AdrDuhD9ME9y3uzG5dSagtDqTrNG7KwXwESxY-KzYnP-vqR4uXE4GnQpmznjO9inAZs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mvcEZTZ68mZBZ5Pfx6JD9AsA_02bpqaqtXZcP2akBUw&oe=69D514C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MtQ8Z16fO0Q7kNvwGMslrt&_nc_oc=AdpuGz8968TxI8hiY3of1qi2uw1kkc0ipw5r9OnNz-vwp1Dv6WZHWVnyvLk6BVSGqes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Fx_V6boW2ctMqZ-7zSxRGJjFmB_-sFIV9xVAp2oTElQ&oe=69D4EB98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoTjoQMBonIQ7kNvwG03FzT&_nc_oc=AdroNE2-FV3qs-AT0zmp60aTqSOJsJAQ5Ov1fNzU14GnokWRH3cUNkc6LMgFNiXBFnw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E4xSMM08Rq2halgYKuoMaO1JEPTcAs9DpMv8anDp6ZQ&oe=69D51251"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
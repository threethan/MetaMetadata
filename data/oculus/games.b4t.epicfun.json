4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h0vUNPuQDIQ7kNvwGsIuAq&_nc_oc=Adq_Wbd7ayComSYPMEIX7-iPYDXMRSb8mBNPeBxP9uxl_8St5u3iuxtvDWHXGjv-uh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ufsd5IY9_dlbHtKEX8G-P1TaDqn8Noew_0t6-h8XWXg&oe=6A01F022"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBwBgXnZ4_UQ7kNvwGPc3sJ&_nc_oc=Adr05B4fDX6BLW0ZCeWX1st34oH97HbvL3OE9z1_CNuVQGHZovRg28YPMhvTTEIuw6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zNsd2jNheyoqUtko8HWPGiN0qGHFFa0Dv-OATgOUSVg&oe=6A01DEBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqKQhrRxVrEQ7kNvwHV2Pfp&_nc_oc=Adpmnpeq8SIo0GprcWYE2TUT-rwJUJhPzDQudWx--LUr1i8AQtBGRWwJxYpMZm1fv80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_oPG3OD41_SAUE_zDJrmx_QEMw-uLcMr6B1AR6a8nEw&oe=6A01E7C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxVwJ4WotD0Q7kNvwG-aXix&_nc_oc=AdpqY7lN-1lEVuHFLokh_Hfv5XSJzW8lSXRgjsfh8V1ms2LA5KpzrU-JwJVoEft44zc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-fdyjjNCrvEuM7AsbGBbsZAQIcER5AHRRabNfJ5af6A&oe=6A01F6D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-eBuDKnNM0Q7kNvwEt4IiQ&_nc_oc=AdoccmU8oxAKWM2zVIw2r4IyYxHDp5fQDJkM4vSjje_xpaZ4rBpQskhxts9d0A8Jmf8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xslENvQhn-PtQapn98_TRXygU4oZklC7n1qMXBDuvoQ&oe=6A01E551"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrS4K2_rKEQ7kNvwGw4zNp&_nc_oc=Adpf9kOm7qb7g1Ep863Obv-VVW-zibNRpv45Q8biXveM7oGgLKtwA4FjPXQ4TdW77mA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIyYz_lWELJlEWFP4Im65VlCYHmcAS2iZY_NI366hzLA&oe=6AC26B22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XP_CeS6GF1AQ7kNvwHw_feB&_nc_oc=AdqNFBDpwL4r-VD02hc-ti3aT1jtNGZSzrOPVDF264OnNiVRPrMyZkSNiry0I8RPTYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN57RvZKkDjhoHTVqfA8Q2anxF6kK1p67Ek3N6JxvWXcg&oe=6AC259BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeU2ypAayGEQ7kNvwGJ0aQa&_nc_oc=Adojp6EoDsJ-AN4Z6jqO_tY0n-iBDauc4lDmZFJncYTpeS1pVMPoJuC68lqjtSCj0u8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2gt9WsllkRLOEjSDzSdsKowC6HGzgY3xn4jMa2lgHmQ&oe=6AC262C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SWa00YrJ7IQ7kNvwGnXGIr&_nc_oc=AdoUmlaMXP2ZvOQaHjAw2o2fNBhf_R2fqksxK_FCaK7jbGQz9EOP_XIh8ErAlNw1xbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOemr1_8Dtitr6Ly-XLnPx3ixq2TshW18CULXb4xgvKAQ&oe=6AC271D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPEpv5bkZWwQ7kNvwG4AzHC&_nc_oc=Adr9IMxDDTIC_EeeJ6SHs3qfQ--45Abi4z3CxtPaffRiJY5KcS8kmUCCVwqOMoji4Rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAnayxsEs9aVkX1WuCTQr5iUGbezF6hzLffEY9Owy_ow&oe=6AC26051"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh9v14RjZoQQ7kNvwHnvd-7&_nc_oc=Ado1kUE9DgQYaz22A6FIbRSNgadHP_zJpyuxRDsNMeRyrvFjQEwL5-xv0Crmb_5_too&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaYuBfy6UdgeYTeqVoVV2FqfaezSfe28i0geDKmGY01A&oe=6AF48422"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrN0Lpagq34Q7kNvwFVDnyk&_nc_oc=Adq7F5sO-ujUC3syIgWPYzgh0bVq-h4I-LsfRYffqOtK2gcfqMCFgf25u3__bugonW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbwwpNxVj3YduIOxKG7H3rq7YF2vmJ2Z6OIWhcKvH4aA&oe=6AF472BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C8MLgGsJ7AQ7kNvwFadzCn&_nc_oc=AdpDzHl76vjTwfboDxGlIkzVgKXox87_9V3nLp_dv4mU4n4Rn4ViNcjtoaBFYOeDDlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9NeJuYT0zvFVNhEXBnYeXOq61GYt8cIe-9Cx_xLoPDQ&oe=6AF47BC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQfe83ZqMCgQ7kNvwEgNPqr&_nc_oc=AdrSox10Td4jtNXyqZWMdn2K7PekCRpllJMmZqqOKiWGhEShMPuyrpKxmruzbFPem2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFKR6dSwdCaYYCN8SNKbCSnk-TXLXlgwAnwkPmZk0Xmw&oe=6AF48AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQpg5QHmnYIQ7kNvwHEe68T&_nc_oc=AdoxdqLKyLHTa4dyS8VjZbaH81_thaQOG4Qn9A8zSWjBicqtctkWBC9-ofSsC9tvFJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWE-OLXPZztqOar5FTDVj-pJ4d2w9uERwo7C2_3Nie2g&oe=6AF47951"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
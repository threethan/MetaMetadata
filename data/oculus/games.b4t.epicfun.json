4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPhu3nukFjEQ7kNvwH_5Ze7&_nc_oc=Ados-WxD-LBtWTIyLoCqBq2qrueDlTOjDSB7gQnnSPsXehtqoDLvjwtAzQBNldXwlq4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xc9zSlCQPyy_5q3PqyEItJgtrL2YlGxTPt0OgH0atUw&oe=6A2042A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2enWIcPhf4Q7kNvwHJaJR2&_nc_oc=Adp9qguFQvSvuqPcO2xr_V8F-tf2c3Wa-3XCbr9UfCvksZ6Vg-yHm2xa-f3H4hVXgZo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S-f2hOx9Pd5aL2ZA0fCIiodl9VBQVXLT9vEApcRAaOQ&oe=6A20313C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N6bNh6XHlYQ7kNvwFQ9mBg&_nc_oc=Adp3FtRozeeVNYrVMSOZ_cdoYTAQGOP791HS1XRjBipwIBuN2KozfIPejwh2F-0_UQQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Eshx_5f9P2k_jjjOlFSLp8YOsvIel9WxWGiobmGcHlg&oe=6A203A43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTpVZYbMs-MQ7kNvwHcTW-f&_nc_oc=AdpvrgIehxhQACsrGpA-fzCRyldeMXPmLEwrrQazGHZgY5GlUPa8IDA_CxmsByen280&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5byzIxz5RNIoxxnmYHxaOO1Ia9W_WkTsGC1WzZrQEQ4Q&oe=6A204958"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYLfOe6en-EQ7kNvwFEmsEL&_nc_oc=Adpx7d15CQrtZSOJLtlKdFCc13ewWov5Em4P6CSw700JGJc22IXfHL0SIU44h1zhi8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a6vNlRmHIm-lNnLu8HQwKNbni7Nvzk4eD1Lb8bn7J-A&oe=6A2037D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwPaJ6rQNiYQ7kNvwEl_p7c&_nc_oc=AdrPkwnXAQR3FAbYlEulYeBBpjqlrzZydgjxqYQkylmnRlbNixPQbAOC6jvhPMvQtWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO7z_W-OW3ARBD2aHprFWd22rD92dVxiVopYyXU2lk4g&oe=6A8C2562"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPpZHSW1eDYQ7kNvwGAa3xC&_nc_oc=Adox80i2h0c7zF5fWPEw_bgj96T-jbl3kAYZPqm64Eyl8zdwjHu7WQT572ZPKz092_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_g19ucrvG3TcB18XW2Qme6hwR9BNpKQPQ0cPD8MI6Zw&oe=6A8C13FC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9aZJvmzWnAQ7kNvwE4jgcO&_nc_oc=AdpKcVL295BBiq6kx9AREDSPEEydGsVqhlDh32k-3LNhn6h5i6Gn3ZJW4cdiYgLxPmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJIzubOW9YntFeQZXYB7_jYExjmLSHmtrTBGaZ9nr1bA&oe=6A8C1D03"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKc5sOlnqQsQ7kNvwEZrPBX&_nc_oc=AdqYtDF3aKwB3q7jhzu1ReMyNwXwORbXUvLgiA5MrpWZP0Uc-IDNayyziqdADa1f35U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9lUU7yvxNuAYSJJeDyKMigJkckPp-fZgJh1_UtxOEPA&oe=6A8C2C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSWztJDsXO8Q7kNvwF6yRAO&_nc_oc=AdrXGDlx9Y4hE3uRY9sbQ4_y45fW96-YBGRrhNUYNCVrjN2LbM_eRYlbe7nMYM5730s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhT8CScznspsRSbIg1v9-XraeiqGtrq6jkWzqow3MtKQ&oe=6A8C1A91"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSQDmJaCDQcQ7kNvwGAxll0&_nc_oc=AdpRIAMxYg5KPu1eBiASM6Fv_8zathL6x3M9aUOTbRQ37hwY9jMUcb5vLuCNFfsMtpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-bL93hhVw45Xcex1AJqAri1lVmwjJanhd2JgMHHn_Bw&oe=6AF72722"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQzmp3uowg4Q7kNvwFJJI-k&_nc_oc=AdrYkoBiKryAAHiCHYZXvfR3DgnufVeoNjvGRBA8_aBJqlTU-X0EpJIgKQZJff-WO-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiYv7yquCgp3bDdmtx8rjcyKdE35mF8-Y09b4jSNB2sQ&oe=6AF715BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFKeCKZEtwwQ7kNvwF5EO9c&_nc_oc=Adp49zGE8pxHAzaPyNdca_MLjHL-BxakmlTqBo8euJAj9d-kG51SCNGg67GLdtfTS-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcArMspuMc5j0-tMqodFfDxvv8BBEkiZDwl-xlc2GIDw&oe=6AF71EC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV3dYlTN_7QQ7kNvwFYhYyH&_nc_oc=AdppQi_JOgQmVSGC62eZALAdoZFnObsvxeDbKRVotUDe_2pYOHVGrsDOShw_32KOTB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3bvDYbrrwyvaqp8_kJ5GpiXXznWd_8Ausaap2n8T50A&oe=6AF72DD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxUvB9y1AosQ7kNvwFmf2iI&_nc_oc=AdpzIbwamRAQi7Zv4IyzaDZxGf-d5eshs-4QTw8WMMHQNlGYFnzv3NQvJ49vFWM8I6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAWq-BBRb-kpCorTQ9JKBs-K_ry5Izdb5lzs3wV2cVNA&oe=6AF71C51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
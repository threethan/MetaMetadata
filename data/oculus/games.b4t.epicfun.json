4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QfU8ql2JVsQ7kNvwEUqn8P&_nc_oc=Adpnz7g8Qu2_OHFRFJqe5vu2pvlyg_Tp29ujWFhU45YHk8DBfDcnm5OB0yn-LA4AQOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJZh6a_wbORNQ8gWe0HqRa0jor2by4R2lT7X-msUzoXQ&oe=6AD23D22"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zRV9E9fCKMQ7kNvwGtQjy7&_nc_oc=AdqwOMqn--4cUEUAtpXtFB7cwzCIiU2xPMaTeuKF6Wo6Ts3SDa3pCEY8KaBRn8JqCjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYHgIGfIvDYOMFGfqD1exrlcuAe2xN_KFmqhWAk77v3w&oe=6AD22BBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-26zpYD0sYQ7kNvwHP0CcE&_nc_oc=AdpM01RfiSrjY9iApUSaMSXYteiILXI_u2UsEKCpWSgoY0qSSGWp--POUApWB4bmL3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgX8Wt1sRE4tEJ2569QKWnc9rnegQl1qmpE1EN62m7_g&oe=6AD234C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfspzBg6wDoQ7kNvwEQfrMx&_nc_oc=AdqWUrZPgqALCmf7saP3Uap8JmBiFLQRl9ryYzG802tZiWd0qssZIzdGbOR0TnH1wpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLXF3ZdX0xC05OpG4eoJxvKRI7dZq0RhgvC6iDV6mrrQ&oe=6AD243D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYRDVg9EVegQ7kNvwFure0G&_nc_oc=Adrdd21ByZTO8i55n6F3kSlsTDJekgtCXudtie2OqmVvNS-TY9MAun_axc2eNK8p768&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBW1H0O6eM9K-93yANYx2HqPEU7nT8c6geueeGWFwNTg&oe=6AD23251"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
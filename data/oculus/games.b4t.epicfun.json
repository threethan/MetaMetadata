4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbV-5vuklyoQ7kNvwErG-tE&_nc_oc=AdpP8QzGhIIFMxLNKPrhJFJUFAeHWx8fOYs8hPLQRQMijDYQez7UyVENUcM1toZ3vUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfHB6CugAfYJaVPYqER_ksc5GPHeLtOP09Rw_2ZtHQag&oe=6AE4B222"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-4sq2eQqbIQ7kNvwFcGVBK&_nc_oc=AdqqVS9OMRl25XgQjxqecZo0DTB6SzdjDQu5Z-D4OPQodqf1XcgicU1a4uB-nh_f1Ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi0X-NSQkSci08M96YngjIJd6FxxtaOxgMYjkmISbMtg&oe=6AE4A0BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsJRyHXsGwQQ7kNvwFC8WOm&_nc_oc=AdqTdSzYtXu0_vk_5An18I0lAgXu57TQKFeIYEaY4rl2agld-NzG3RIidEu8LV5W4m4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJL4ZbekaxOhesVB6CfluvN_Wdq9N03idH1F6wzSeycg&oe=6AE4A9C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=518vBHw_KOIQ7kNvwHWYISJ&_nc_oc=AdofL7vZr7tFLN24kjZbZmcfRuM4MRR1DO65-09TDjy7hq1_iQHeJFbwznlcWudN4OA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiKEAsWsa3_g2tbfuhJo20UcA0UUK6mdIUijabByIzDg&oe=6AE4B8D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfuV5j3qI5oQ7kNvwEhEAi1&_nc_oc=Ado7ElYq_m7Aw5k7OHkfI5HXoNjkpY5KWafaisqNC0ogfZORMz6jOJLiXSbnO2OeL3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnAQanwgs3mGQ2H7cqElWXA7M41xrlSFVpjDR9kCUc8A&oe=6AE4A751"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BEwOfbNT-4Q7kNvwEtpTvV&_nc_oc=AdouPpYX8ubWN45amRROFFZe2m6qXCF7CXxNwky4XraYM065OLC4F3GVrpXsDeDK3oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO5vFofYco2TfH_1Gkt7fjHZYMC9VrBp6BooKmM9dCdw&oe=69CA58E2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTF15L4G33MQ7kNvwF4JVv5&_nc_oc=AdrNYi2gADqR979w6zQUiex5qnvB36H-o8nBsCXf5JXkT8ZCsn-4B-bCwrpZIUcdJ7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8lbijGYjDKAv0hUhXA7R7AFHXwfsKycRfcZ-ZNoTRnw&oe=69CA7FBC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1suEBHMLe9EQ7kNvwEBmhVK&_nc_oc=Adp4erXtCSdrWdw78kb0IgGTOvq7a9DwEci0XLxlLGtUFqpsMflwsWJJ2lMNEsYOTgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9CSuFxdIP2l6M-u0KMP8R9BGxOEa20Dov9pnIzxTzYw&oe=69CA88C3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9al-S6ozSrQQ7kNvwHe0QfK&_nc_oc=AdrADe4hUnIQEX_fc7UjFaoaWUQVA4sXC3ezubjRaxOPXXdhJpUhQfTAfNX-VQ-ZzoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWAI-AZc5BvUlr0BVmZR0yW9zGdDXxfbQME-3E95JTxg&oe=69CA5F98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfz1F4eA0QUQ7kNvwFoH_es&_nc_oc=Adqi2nuaOWWRPndE9OiG1bJnX9AxvD3bEduUV4iCW23QvMXY7Idssbuue5Ib2yRJclk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoQHN5uOg6gOuPy84WtZrBiUZ4G0BkqqmiD7AwsUOONQ&oe=69CA8651"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
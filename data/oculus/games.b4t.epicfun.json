4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPdCiIBxHlAQ7kNvwHbSon1&_nc_oc=AdrTQD-JoC0Hcwl34wIFbKuHQk2ntQHRW51DTRusM7cKCw6J8DYT-CuyczfZzQUKo5Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRyN1SZHDV0sfiO1bogZ3qBQLhk--XAOlZkyrf4MOisQ&oe=69C66462"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvWuU4w86Q0Q7kNvwGPx_8_&_nc_oc=Adp_fYTxqFlENM_I1WkkFJB-jIa7jWELgRhcmwMXsAh0fVhPDtYooE0jhj35sQrsSIw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeZKWwfSZQEPEtR__PaoxrnfLdctAUmH8cqjbNi8oYjA&oe=69C68B3C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKmIuGoB7kIQ7kNvwFXoyNE&_nc_oc=AdpsDi5PNiFgx8ENigWKFb3-zDfhuEOYAPHHFpE1pB0yDXvPQiPqlvBjTe9EslvddE0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXawNZaBigomQ3wWPAPn_GjrEnsBZwdND6ZIhmv92WEQ&oe=69C69443"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHtLVw0CjWYQ7kNvwF1zAdY&_nc_oc=AdrDoGX3XR43gPVFFU17BoV1Ny9SUk1aecvZi2Fp22lzqNdwJBA7J4qXH98VoI1Ntdg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMRJz0hllV6_0u0Ch38II1ilTH0rdBUY6Q9SBRjxp0mw&oe=69C66B18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV1YX9_PAukQ7kNvwHB_-KS&_nc_oc=Adq3bY9Qupwpj6496jOM77KBPfvkwXACoUgPHTdXSFww4uB7FTBHndpGaAJIlTAL2os&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpRNqy0j9F_OB6i1YaO2L-Ji__CE6wIxwP2Y28mExHIw&oe=69C691D1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
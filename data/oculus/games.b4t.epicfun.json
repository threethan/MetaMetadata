4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpUfNaUysngQ7kNvwEdp7aI&_nc_oc=Adon2oIBMfCrA4R-uhCCFr3pB1Nv9SYAI6RAibNkFRIag6z_3d50pNGKK5xC7Rglfjc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_3w0yurUavmFRM7M1ut9IKbn1spBOfZISPMEiLqdEHw&oe=69EB86A2"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2jbUG3s4RcQ7kNvwG6TIUK&_nc_oc=AdrZzCGvCi37wxp2HV1JZogqxLLg3fnR-_Jsn3hJZcWcAWOkA-DAA8qSUOuhohQ9MDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QanCs54qKXbZJhR6zhZWZBHUiTQaWbwFXtO3K2ZhGxg&oe=69EB753C"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaRuC6xc_isQ7kNvwEN-GT4&_nc_oc=AdoT4kDQch0zcpfzvDzlxBs4WJ_2NwjgYAPwaD7x4DJ0V0QyDnrr6bIS9ZcxoPYFBNg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c4WUzW7ckytbbHFRIqSSx7Ra_zmjZphHY0BYCmG8fpA&oe=69EB7E43"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBsIywaFg3YQ7kNvwE5CLcP&_nc_oc=Adr8fOUwDFrs4jxQylTOjwSHTwAiz2yLSl3eEt9ZjbDESKocJGuisFpGxU8DZOz-7qU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32TRLLxtAZ0hSOSbUJ420QaE4r0MHH64shQswZN5hIDQ&oe=69EB5518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdG0L7UdxJ8Q7kNvwEhzD9E&_nc_oc=AdrTn-L43CY8x_Z659PmfMs897pC0RiybdsusjiaQb1emO3zuWHcqSkQuVqsgOyXQCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v4CmSCLahYNwvJCxB55k9S9JNbtxK2nnZ9dN24GHV9Q&oe=69EB7BD1"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
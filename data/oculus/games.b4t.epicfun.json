4_2358538077703480_4369944196488888320_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxKf_4biYwMQ7kNvwEpcTKy&_nc_oc=AdrvdqWZ3odqk45lqR5Ig5-CaDEU63DslVQbYgN36MfaAjfBcBrqltFMF1b-L8orSmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d8rVr9L69NVosSvL_9Q2QcyoRMmZ0YdRNAvb3yAoQAg&oe=6A3E9522"}, {"file_name": "migrated_image.png", "id": "532687320784459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_445782872721500_6271141491884687360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XXeQe_FChYQ7kNvwFdu-38&_nc_oc=AdqpRvMt9CUp5oQqs_5G4VsYvMmq703dJZzPoiIvifXs84833lEbXCrEOaNksRHnyr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tc0MTZxbdn_REXOHrecejVoYpKT85gHObjQu9EndHWQ&oe=6A3E83BC"}, {"file_name": "migrated_image.png", "id": "436875970436775", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982493_771491193282909_8623363074084044800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AH9SsTCuENoQ7kNvwEpXhek&_nc_oc=AdpKaJHYhE1S42z7Xoqmhxleem5sdwpGc9TCln_9qLwTd8gciRM5sXeTNC5JlIqLqLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RAlviuFl7w3QCm-Xs-E07-rXOFThOP443AdElj8pYMQ&oe=6A3E8CC3"}, {"file_name": "migrated_image.png", "id": "196250655010046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982636_1419837064833297_6934363611519254528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o21E1hM4OOYQ7kNvwGkb13h&_nc_oc=Adqe95EFinVf6FMmCc8U46Nrl3DlklRMkzpJyYLMEoFPBEMSHOShicDAmUvXgJf06Rk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lsSV_GmVeb34fwE7j4DCo7tHa5NskKlibQb_GgY_60Q&oe=6A3E9BD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/NEtpnb", "id": "2905966889423196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031569_2905966892756529_491074526126276608_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VfC-9sFBYcQ7kNvwEQPG5M&_nc_oc=AdrLikVgZEWBa3OMSZ41OXS9v1_uLjabgp34jUeQkiHCkbq6vBmCrO0Vrb1zxK8n044&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y0GusTmv_E_0uLMJnoV2hXZ7u4dTHurADK74A0fTdwQ&oe=6A3E8A51"}, "display_name": "Epic Fun", "keywords": ["roller", "coaster", "shooter", "park", "free"], "long_description": "Epic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer.\n\nTry a roller coaster, a moving shooting game, a free fall tower and a sledgehammer game for free.", "short_description": "Epic Fun is a VR Theme Park based attractionsEpic Fun is a collection of theme park-inspired attractions.\n\nRoller coasters are our main attractions! There are six in total and each one has a unique theme and comes with an exclusive rail shooting game!\n\nBe sure to test your fear of heights in our freefall tower, and take a leisurely ride on our event-filled ferris wheel.\n\nCompete for the best position in the different rankings of each of the three games: Shooting, Dart and Hammer."}]}, "developer_name": "B4T Games", "developer_privacy_policy_url": "http://b4t.games/pp", "developer_terms_of_service_url": "http://b4t.games/tos", "publisher_name": "B4T Games", "support_website_url": "http://fb.me/b4t.games", "website_url": "http://b4t.games/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ROLLER_COASTER", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
7a0a&_nc_ohc=lDmthjj9IfAQ7kNvwFcW6vv&_nc_oc=Adp0P6XdPLGk89RIZ92N1kRMlIVY3zIAUHBxNAkY4Oes2XhJmzpb1rO7cVYea7yXqN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jz1MJiyyRb9qNSUdlIZNO53CqKFHbOebqsD0oFQwgpA&oe=69D5149F"}, {"file_name": "Riven_Meta_E.png", "id": "779095440879465", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982572_779095444212798_817204160890506524_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=088k8cPBec4Q7kNvwFIeuk5&_nc_oc=Adr6RjJ8dm18LvhWZfns-o_Cgozh0Vpqzni4VkLnJO_T0MpOq3GXvD6lM___H_AyQ3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AiTiJs-7v6A9jDO0DAUNNhe_lAQNvskCDQIx2tOLKFQ&oe=69D508E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Riven_TrailerCover_Meta_2560x1440.png", "id": "334704752373239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036604_334704755706572_5375547853479510896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1XFwlL-js0Q7kNvwHBIzWe&_nc_oc=AdpGYwUMoY7NsB3f-736xZxlVyQvrmAc_T1d98Ola8cZjcyCg3q6MHHTQfbUSXMnDZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Pd_bHu8TzjnZuUJ9YMZogyo0bP6d1qFjcU757b6W5nw&oe=69D4F178"}, "display_name": "Riven", "keywords": ["puzzle", "adventure", "myst", "room", "mystery"], "long_description": "# Riven\n\nTravel to Riven, a mysterious island-filled land on the verge of collapse, to rescue Atrus\u2019 wife, Catherine. Explore Riven, solve puzzles to reveal its mysteries, find Catherine, and make your escape.\n\n# Explore the otherworldly land of Riven\n\nRiven takes you on a journey through a world filled with surreal islands, each meticulously crafted with unparalleled attention to detail. From dense, lush jungles to awe-inspiring caverns, every corner will immerse you in an otherworldly adventure.\n\n# Conquer Mind-Bending Puzzles to Unravel Riven\u2019s Secrets\n\nChallenge your intellect with Riven's cunning puzzles woven through its narrative, offering a unique experience that unfolds as you delve deeper into the enigmatic world.\n\n# An Expanded World to Explore\n\nCreated by legendary indie developer Cyan Worlds, and based on the award-winning original release from 1997, Riven expands its epic narrative beyond both Myst AND the original edition of Riven. \n\n# Fully Re-imagined Gaming Experience\n\nExperience Riven like never before, soon playable on Quest 2 and Quest 3. This brand-new, re-imagined, and expanded edition of Riven offers a deeper story, new captivating visuals, and a gaming experience that stays true to the original while also expanding Riven\u2019s world.", "short_description": "Travel to Riven, a mysterious island-filled land on the verge of collapse, to rescue Atrus' wife, Catherine. Explore Riven, solve puzzles to reveal its mysteries, find Catherine, and make your escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cyan.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cyan Worlds, Inc.", "support_website_url": "https://cyan.com/support", "website_url": "https://cyan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es_MX", "it", "de", "ko", "ja", "pt_BR", "pl", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "255567760068570"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1613807463439723"}, {"status": "PUBLISHED", "id": "2090651721472859"}, {"status": "PUBLISHED", "id": "1129537016043270"}, {"status": "PUBLISHED", "id": "636793642748860"}, {"status": "PUBLISHED", "id": "2613023525562412"}, {"status": "PUBLISHED", "id": "1719519818619257"}, {"status": "PUBLISHED", "id": "1200463524606326"}, {"status": "PUBLISHED", "id": "831961055102405"}, {"status": "PUBLISHED", "id": "1558514938043247"}, {"status": "PUBLISHED", "id": "499439365797250"}]}, "baseline_offer": {"id": "831961055102405"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1613807463439723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34847127218219785", "version": "1.8.5"}, "id": "1444248572600777", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34847127218219785"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773796144, "id": "35304692472463255", "version": "1.8.6", "version_code": 1653, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34847127218219785"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1444248572600777"}]}, "change_log": "e11752-p28613 OSS: Oculus -- Jenkins build 1950\n\nMajor\n- Fixed incorrect sunlight settings being set on the world if you load a save game while on Prison Island.\n- Fixed checkpoint saves occasionally not saving properly.\n- Fixed an issue where using Hide Vehicle Transitions on the maglev between Survey Island and Jungle Island may cause the incorrect island name to be saved out with save data.\n- Fixed an issue where using Hide Vehicle Transitions on the woodcart may cause the player to have the incorrect age name saved out in a checkpoint or save under certain circumstances.\n\nMinor\n- Fixed some visual issues occurring on some steam particles on Temple Island.\n- Adjusting the timing of the \u201cGame Saved\u201d notification a bit.\n- Fixed some minor visual pops that could occur when approaching a tunnel on Jungle Island.\n- Fixed a visual pop that could occur when you have Atrus\u2019 Riven book in your periphery in D\u2019ni.\n- Adjusted the German localization for the \u201cstrike force\u201d note to be more accurate to the source.\n- Adjusted LOD distances on some plants on Temple Island.\n- Fixed an issue with the color context subtitle position not being correct on some powermarbles.\n- Optimized various texture assets.\n- The player is now prevented from loading bogus checkpoint save data from the main menu under certain circumstances.\n- Adjusted the heat distortion appearance above Jungle basin water hole heaters.\n- Fixed some shadow popping on Prison Island.\n- Minor draw distance improvements to the destroyed version of the Boiler Island to/from Temple Island bridge.\n- Fixed the interactable area for the trap book in Gehn\u2019s second offer of the trap book to the player being too high.\n- Fixed an issue with Atrus where his face would get too close to yours in the Temple Island ending where you have trapped Gehn but have not freed Catherine.\n\nVR only\n- Improved the grabbable region for a note on Boiler Island.\n- \u201cMotion Controller Locked\u201d movement orientation setting is now named \u201cController Locked\u201d.\n- Default comfort settings (\u201cRecommended\u201d) now enable Hide Vehicle Transitions but disable Quick Travel on Stairs.\n- Fixed an issue where players may be unable to leave the \u201cspider chair\u201d (Gehn\u2019s viewing room on Temple Island) under certain circumstances.\n", "created_date": 1771614792, "id": "34847127218219785", "version": "1.8.5", "version_code": 1652, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34847127218219785"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771571318, "id": "34837840289148478", "version": "1.8.5", "version_code": 1650, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34847127218219785"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771531993, "id": "34830316673234173", "version": "1.8.5", "version_code": 1648, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_appl
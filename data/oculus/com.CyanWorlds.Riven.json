7a0a&_nc_ohc=M45CvOWpAU0Q7kNvwFcRbxf&_nc_oc=AdqPhP_b_JwJFRdJVg0vF3WS8ri0Nn9xq4y26XT9Gmo9qjwxVPYr6h4Ga4QN-QIf7bY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6ydHNNV23xTzWXubzf6l54D8NV36EyYvgwQ36bhhapg&oe=6AD0E31F"}, {"file_name": "Riven_Meta_E.png", "id": "779095440879465", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982572_779095444212798_817204160890506524_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqtrk0NZA8UQ7kNvwG9pftW&_nc_oc=AdqS7ybs-MicLzz9g6KrJEH9XPTYZckiR-vj9vqASdef0e8yGi526covZa6QLcH60G0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpzfAzujBPNjs6KBtL1lRhrTR2kCW2btkfyjCrSGxF0w&oe=6AD0D767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Riven_TrailerCover_Meta_2560x1440.png", "id": "334704752373239", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036604_334704755706572_5375547853479510896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqaYQUVL1pkQ7kNvwHsfeIZ&_nc_oc=AdoH6ztWK0H6kc5rHV9irMPYvU4PCZFzRehl5pV0gWdgEdtEdJGP7MjDhe6ln1uo-5U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwhx44G6bFYzb5cc-Tu2kBYQFfRTCRxOs08aT1P2Pp5A&oe=6AD0F838"}, "display_name": "Riven", "keywords": ["puzzle", "adventure", "myst", "room", "mystery"], "long_description": "# Riven\n\nTravel to Riven, a mysterious island-filled land on the verge of collapse, to rescue Atrus\u2019 wife, Catherine. Explore Riven, solve puzzles to reveal its mysteries, find Catherine, and make your escape.\n\n# Explore the otherworldly land of Riven\n\nRiven takes you on a journey through a world filled with surreal islands, each meticulously crafted with unparalleled attention to detail. From dense, lush jungles to awe-inspiring caverns, every corner will immerse you in an otherworldly adventure.\n\n# Conquer Mind-Bending Puzzles to Unravel Riven\u2019s Secrets\n\nChallenge your intellect with Riven's cunning puzzles woven through its narrative, offering a unique experience that unfolds as you delve deeper into the enigmatic world.\n\n# An Expanded World to Explore\n\nCreated by legendary indie developer Cyan Worlds, and based on the award-winning original release from 1997, Riven expands its epic narrative beyond both Myst AND the original edition of Riven. \n\n# Fully Re-imagined Gaming Experience\n\nExperience Riven like never before, soon playable on Quest 2 and Quest 3. This brand-new, re-imagined, and expanded edition of Riven offers a deeper story, new captivating visuals, and a gaming experience that stays true to the original while also expanding Riven\u2019s world.", "short_description": "Travel to Riven, a mysterious island-filled land on the verge of collapse, to rescue Atrus' wife, Catherine. Explore Riven, solve puzzles to reveal its mysteries, find Catherine, and make your escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cyan.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cyan Worlds, Inc.", "support_website_url": "https://cyan.com/support", "website_url": "https://cyan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es_MX", "it", "de", "ko", "ja", "pt_BR", "pl", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "255567760068570"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1465228255440118"}, {"status": "PUBLISHED", "id": "1367741774803273"}, {"status": "PUBLISHED", "id": "1613807463439723"}, {"status": "PUBLISHED", "id": "2090651721472859"}, {"status": "PUBLISHED", "id": "1129537016043270"}, {"status": "PUBLISHED", "id": "636793642748860"}, {"status": "PUBLISHED", "id": "2613023525562412"}, {"status": "PUBLISHED", "id": "1719519818619257"}, {"status": "PUBLISHED", "id": "1200463524606326"}, {"status": "PUBLISHED", "id": "831961055102405"}, {"status": "PUBLISHED", "id": "1558514938043247"}, {"status": "PUBLISHED", "id": "499439365797250"}]}, "baseline_offer": {"id": "831961055102405"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1465228255440118"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37936137632652046", "version": "1.9.0"}, "id": "1444248572600777", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37936137632652046"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791239337, "id": "39935555406043582", "version": "1.9.1", "version_code": 1681, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37936137632652046"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787696069, "id": "38899043349694798", "version": "1.9.1", "version_code": 1680, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37936137632652046"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787692052, "id": "38897982706467529", "version": "1.9.1", "version_code": 1679, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37936137632652046"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1444248572600777"}]}, "change_log": "Hello, Riven fans!\n\nFirst off, we\u2019re happy to celebrate 2 years since our remake of Riven was released. Thank you so much to everyone who has purchased, played, and reviewed Riven over the last couple of years. Your support enables us to keep doing what we do.\n\n- Improved the appearance of shadows on various rocks and steps on Jungle Island.\n- Improved the appearance of a handle in the Starry Expanse to appear more interactable.\n- Improved the look of some fire-marble materials.\n- Adjusted the sound and animation timing with the \u201cbone throne\u201d on Jungle Island.\n- Adjusted the woodchip pile on Boiler Island to have better shadows and lighting properties.\n- Tweaked the ocean water at the lower Survey Island maglev dock to appear more calm and opaque.\n- Improved the general appearance of the Temple Island and Survey Island impostor meshes.\n- Adjusted a shadow blocker that impacts a specific view on Jungle Island.\n- Fixed a small gap shown in a visual element on a rebel viewer puzzle on Jungle Island.\n- Fixed a D\u2019ni script issue in Gehn\u2019s lab.\n- Fixed a minor visual issue on the Survey Island maglev and volumetric fog that could occur when loading a Survey Island save under specific circumstances.\n- Fixed an issue where the Survey Island plateau elevator might not turn its lights on when going to a specific floor after leaving the area and coming back.\n- Fixed a shadowing issue in a hallway on Jungle Island.\n- Fixed a pipe not appearing properly when looking out of a specific window in the Temple Island subdome.\n- Fixed an issue where a portion of the Boiler Island bridge appears uncollapsed from different islands despite it having already collapsed.\n- Fixed a collision issue on Jungle Island.\n- Fixed a couple of collision issues in Tay.\n- Fixed a few conditions where the player\u2019s inventory could remain in a weird state.\n- Fixed a specific ladder loading in with the wrong rotation state when loading a save made while within the submarine.\n- Fixed the player\u2019s inability to use the woodcart (without exiting and re-entering a woodcart loading zone) after restoring a checkpoint save between Jungle Island and Boiler Island immediately after riding the woodcart in either direction.\n- Fixed a bad checkpoint save from occurring while the player is using the submarine.\n- Fixed the player position recentering icon appearing incorrectly when the Trap Book is interacted with under certain circumstances.\n\ne12079-p28911 OSS: Oculus -- Jenkins build 2001", "created_date": 1784055280, "id": "37936137632652046", "version": "1.9.0", "version_code": 1678, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6499813506711202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37936137632652046"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784010169, "id": "37925229443742865", "version": "1.9.0", "version_code": 1676, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
luscdn.com/v/t64.5771-25/38982654_378167935274654_8885340828441099019_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvO96WKkH6kQ7kNvwFaHVk3&_nc_oc=Ado_V3GpNW061vgAt3sxPNsYSSCnXdK5grQUOyS7Sxo27nZ3rKuhRhbqT9lx-MTh1dE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ifaFJaP7p_wHX1lKgGVqJENNzCYYsik8NUpLTTpDFGg&oe=69D507C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01_riven_launch_quest3_16x9_v1 (mix & stems).00_01_20_11.Still002.png", "id": "1689644698449718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031468_1689644701783051_6443293304648271543_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqweS931B1YQ7kNvwE1cPYP&_nc_oc=AdrsxlKapRadJkh-T781knpQA4Pp17hYeZA3x_mYIiEDlTk6ifYF4qTWYkqp2n6kGts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PcmDQt42rm1SjEtUi81Qf7HAv5lYrqCI75hT9t0h7Zg&oe=69D50813"}, "display_name": "Riven", "keywords": ["puzzle", "adventure", "myst", "room", "mystery"], "long_description": "Travel to Riven, a beautiful and mysterious world on the verge of collapse. Explore this mysterious place, solve its puzzles, reveal its mysteries, make a daring rescue, and escape.\n\n**VISIT A MYSTERIOUS WORLD**\n\nRiven takes you on a journey through dense jungles, awe-inspiring caverns, and monolithic structures. Explore a world bent to the whims of a man who sees himself as a god and where every corner will immerse you in an otherworldly adventure.\n\n**IMMERSE YOURSELF IN A SURREAL LANDSCAPE**\n\nChallenge Riven\u2019s cunning puzzles, deftly woven throughout its narrative. The environment of Riven will reveal the story of this world as you make meaning from seemingly disparate bits of information and learn everything you need to know about this world.\n\n**UNRAVEL RIVEN\u2019S SECRETS**\n\nWho are the mysterious island dwellers you encounter during your exploration? What purpose does the giant golden dome serve? Why is this world on the verge of collapse? Play Riven and discover the answers to these mysteries- and more.\n\n**ABOUT THIS REMAKE**\n\nCreated by the legendary indie developer Cyan Worlds and based on the smash-hit original released in 1997, Riven has been lovingly revisited by its key original visionaries to expand the epic narrative of the Myst universe.\n\nThis brand-new, re-imagined, and expanded version of Riven offers a deeper story, new captivating visuals, and a journey that stays true to the original release while also expanding on Riven\u2019s breathtaking world.", "short_description": "Travel to Riven, a mysterious island-filled land on the verge of collapse, to rescue Atrus' wife, Catherine. Explore Riven, solve puzzles to reveal its mysteries, find Catherine, and make your escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cyan.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cyan Worlds, Inc.", "support_website_url": "https://cyan.com/support", "website_url": "https://cyan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es_MX", "it", "de", "ko", "ja", "pt_BR", "pl", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26549851507947439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_1734435627084744_1320633504845142970_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuOiNVLU0OcQ7k
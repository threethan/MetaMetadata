at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i1dWBmeWUoQ7kNvwFheR5J&_nc_oc=AdohPaZYzWcu_LgED5N8mbgXQmPdP07j1PQ_NGIeBZ7VE0iIaYBeNWjDj9AYGhVVh2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mVoiyJz5AWjzY-h-OM3APsWpkr64DnjX7NPuuD_CPkQ&oe=69E4D09F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmqG6_lMFzMQ7kNvwEXhbDq&_nc_oc=AdrY83UFEt5Vxguq3PyxCXuhXpeuvzcvcdUXjKuR-Rqq22iHAmoA2CSuvSS6Q9ufLdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14sy8Qwqm4Tw2dmKGmVPpQZisRrUbxKL-2XaVwMMWSCA&oe=69E4DB05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BheTlh6EiY0Q7kNvwFdcTQq&_nc_oc=AdpvpKW2zsaWg0g3_q2gd-xz01oIhQnGmWdDin5b4LXM17QrOsIHCgte6NoPl04WUOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Sn_4CWV2QRXORwQhOCPoZbH23bSX1-BBxvo_0bZsK2A&oe=69E4DB7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KERFJKs2ZwEQ7kNvwEkCyVU&_nc_oc=Adrv99mZPDhQxfWw4A_KZwK7DqGdBBiPPpJ2W3yVQCAUeFLuP7oRGJ8oHmnFYHzw_6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cx0ebM34g8mOiDq4aJ4V6GUG6uJw0XfOBfP1bcunpOg&oe=69E4CCF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xafX0JYXDyQQ7kNvwGBJc0D&_nc_oc=AdqUkktfWHtaPQX5x73iXDy3ZVdXOLt6jYdw8SctWqNGi0t8tEhN8_tonxnap71AFWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KiY0WvhKcuLnS4LJKzR2XuJF1pJpzfPj0-vjKKMhxQg&oe=69E4E1A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
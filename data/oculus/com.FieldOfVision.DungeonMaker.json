at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY34N2cSQooQ7kNvwGtJVvk&_nc_oc=Adr_b3JiiNDjKw10h1Ei4bneXCec-UxDipBZRYE6kwx2guIIcywQ2hqDu6zsXkghHVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EP0yPBs2vqLbLy3FUitS4DplDpHwqV-UYL6QSIreeNg&oe=6A08691F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2nwnJXf4bkQ7kNvwF-Z48w&_nc_oc=AdpeqqFUtf-0324DUA-TYD-hgxmIni7DlUR5VttlVMJII_e2qvQVPKr61WRYdSkhv2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RJYnxXVNv7l-IbU8dNDr3e9iasoRbh-RFIODT9Vsi2g&oe=6A087385"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xwb8CTO2De0Q7kNvwF5gqUN&_nc_oc=AdqUfiK4BO_fCGePi1s3tHMIvnf91bK9vU4T3KXOvn-KnX7MhVQH79UGr556KT3_H70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73rMokZKA_0lXvJA2uARsF9YtFAGKMxy1JHaDcedv7ow&oe=6A0873FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb6FwwRoL54Q7kNvwG723bS&_nc_oc=AdpBYUpV8FDdF2kKZ4XE5xz9xYxaejZeWpV5TmYvL4SvsBlruYemXadnTs0foV5gWoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z0AcWF4obmBTttv_rnrMUlO-F_rlNYZksSDd8wcxVmw&oe=6A086574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQI6dFIM9UoQ7kNvwE6cs_I&_nc_oc=AdqFqdcD1PurWxmUKmPGOF_I8Zr42LPkSwHxycvRG3ocieohGLac6P9UnzM8T8CfmlA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TftSXerxiwd9_7VTEHr94kD23UhRo7T7iAV4oAJa75g&oe=6A087A26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
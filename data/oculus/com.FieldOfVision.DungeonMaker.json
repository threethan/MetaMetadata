at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esKCQO2NutwQ7kNvwEqtH4C&_nc_oc=AdrBR04xy9cRXcg7iLrC44jK3v_i6Ok7Oa4WkThb0zyS8zyHr6L_QpvomZlzuV8fLQQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuZQ_82S9RQbVWiarrcpDH0Dcba4tV3UAJhXXAW6nu6A&oe=6A5F6C1F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQi9efSEJvoQ7kNvwFubh4g&_nc_oc=AdodTnKNRZrAf5Y-buMQ8B67nWmI9ERwQ5Y6Oi7xSKONlQWJZh5d60Frcty3ZsW8DVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL-e_FPmZe9N_mRTRIcUZmEZZ5iMHW3EpirjufNSZcVA&oe=6A5F7685"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXnsFIuMQJoQ7kNvwHNheGa&_nc_oc=Adp2LhLGCoGKhBDBmW8lKH-Wg_cTzY-8SExjcuIIWXwXFM7ybUxuuxmmI4i7_Lz0McU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1LA9goexgJi3XCStdXqNElRnJMyXqG0vz6Av2arpOVA&oe=6A5F76FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ8Jl7GtBnYQ7kNvwH7qjOp&_nc_oc=AdqaeMjUGbXGKzm-YP2TwazH63jhn_zSO-PQGsls-LTi0olSamBGtJI0CriVMbd0R6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALfwI7zpBL3H0DjGyy8X49LEEW3auZjAqv36gSpQdisA&oe=6A5F6874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq-LfuIQ3ysQ7kNvwFOFWYp&_nc_oc=Adp6hL-OUJz-aDAxQXZJ-Wfk09TyjvGlj1-fltVi6P5e0STz3Y0LHWf5gO-enLtRjI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy8zSSmu7np-E_hTLhF6yPYpM93EDAo5nn7Xo5VQdEZQ&oe=6A5F7D26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
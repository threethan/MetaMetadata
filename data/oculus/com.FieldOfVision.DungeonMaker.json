5400828", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GMFqbbNKBUQ7kNvwHaq8Fr&_nc_oc=AdqCRbaDvjOVmhN3ZnsRo0e64fVE2qJ8dta58Di0U8JsqXHDQoRJPMcnQWCCj9VGY-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_OhNjQ6XfvOpMFP-B7JV6YSDpmbV5yhg1pT2Wj6BIQg&oe=6ACE625F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2vrHASsum4Q7kNvwH2rof5&_nc_oc=AdpSyIjpPNMBbVjNB5IraFjycoV_SnlwKwOSXZayx59GbnYoBEfu2w5F6oJQf11rKoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQzLOGRmXb_RFHtHXa-jMNKIHhuLfyqqQNXd1RynJHCA&oe=6ACE3485"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D71URflWMZsQ7kNvwFsiKAn&_nc_oc=Adr59xvRnSobS8nCdKV4mVhG3uPZMj81lqaCHVsqZU6Sqooy9wki1u3-RSwsJhcWmxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9vaBze1F-PY8ahWtq_jG1qvwqi8DFcqulIfyiLVpahQ&oe=6ACE34FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6Mw2aR18kkQ7kNvwHoLKG4&_nc_oc=AdrfcOvJ4LsmEBiCo3RWBms8r0Fe016bXODQqd-k_I7Jq713OuGBK9ZPsrGDpUNuyBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHO24ewzHDe68iSw-aMs6hq4rgCvtF7MYdIIWNSUY1hw&oe=6ACE5EB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX_LHAu7sJwQ7kNvwFsbru4&_nc_oc=Adr5H00fTbjmBdHXWZVQ-L9H4T9GwaHKHyfXOrJ2Nh2A_ox-Nx1karCBD7zwZZiP1pM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj7WL2r0uCW8HjUzrPqK-we9NckkmElNMvan6kXcJ7Ww&oe=6ACE3B26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
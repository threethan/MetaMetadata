at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy3HbJK0_28Q7kNvwEsCPyt&_nc_oc=AdrfUsONnMFpGNwHMKYn-woRtOvI5NL_oAYybAuk1f9--oJouqbh3LNJN_JuQD6EwNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fVafmWWlGjmxt0hCerJZUb-9Y20mT1gEbQEWldoWTog&oe=6A2AB01F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftjzJgQT94sQ7kNvwHgspdO&_nc_oc=AdqEyuK_Q9RpOVgqTxoOiEf9IWEY72kn8QEvqB26ZhgCc42mDE9MIxY2SwQtX__MMrE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e_uVzcgmbnf4Lk6CHWx8u5NrNvgsDIoRAod4H9iqBeg&oe=6A2ABA85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixSsTpZasAoQ7kNvwHU27Nx&_nc_oc=Adpcenvh2oAvSXDwLIDYt1dx6gbAwCHBzWxdbF1MnsbIcQru_23STTwn8q7O_Ydc9T0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UUR56fypy-My4b6OUG-vpatbZhiQzAICAdI0s8-ZT7w&oe=6A2ABAFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGatGWuFXa0Q7kNvwEUXgR1&_nc_oc=AdrRqlxWj53e3AFTiMBy1owXMSiMgRShAbQp73jJdjEFGGBaiKElK0H7SvcMiRhBIyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-UZrveDrLyxoJbu1AACXxqaRTJVasi0cFXIJ8w4XjbA&oe=6A2AAC74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jwmxTnLKuIQ7kNvwELlwHc&_nc_oc=AdrMC6P_w5WCJiLLm74LJggvM8AME9NVOwtktTGv5vQnZuOrqm5SkIbufXJ1uO4AhfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YWFVAJZoi2PBGP5G4QeDhmGpcbSUZkPwqXfrt9vs9Rg&oe=6A2AC126"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
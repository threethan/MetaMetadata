at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzh8Bk935moQ7kNvwG5kfEU&_nc_oc=AdoJSIbLz_Oz_yGIiFebj3Ne7JbthuOpe5C6m3wMxXril4ddgfiOW6D2rkW6DkscBVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hA8a5SoK-J8q-8CuSeHimkZFxhmrgDHqjv-ushHqVvw&oe=6A1D811F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPSXd3gBqEEQ7kNvwF_fBal&_nc_oc=AdqKY3sV-HjLRsiasO1YN4dLE6bCpS--hMfNgFyfhkpdrVbQ4vTHRa1v5sVwu41Oqyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78DhAF5hj6pUyd5xkY9SmOnrEOLb2yDPeR1ks-bAx5FQ&oe=6A1D8B85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0P6vRZauewQ7kNvwFtcHUK&_nc_oc=AdowOI6Fa6WXrdoGybs64SNPVsc_VzpHj917JN0K6AYCNgIeqcHzUnMEEEL7CMUMC8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77pYmAk45fnM6bDgQEhcqwJWYwXdHUEOt8Acu3rtXjUg&oe=6A1D8BFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zcY8LOxGcMQ7kNvwFF5MOz&_nc_oc=Adpty7P0v1iQ8rvnBHS30jkOTU64hZ7Ds1U3SlI8OPCyYq4WmKQfgb2pgwCuJDb6E4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hJgNh9RUc9C9dv9oPPxDMPmJfBe_6itJNFvKTtAawVg&oe=6A1D7D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w41oxmqNIF4Q7kNvwGz0iUW&_nc_oc=AdoR_s4lAD5WGTxcmlWlXXhRhHBrpK5pAIL3VKlYlqMxLIkt0YB-Yg2ZsAM9aEWglMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IQrzLuCpH-irkYv6eBkCHmnNdaMdv_1lkf1oxYCJx8A&oe=6A1D9226"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
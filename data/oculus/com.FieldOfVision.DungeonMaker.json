at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esKCQO2NutwQ7kNvwHVXK2H&_nc_oc=AdpFlNMaoT2x9phpOfNaZrJsnztXZGGV32F-FJrvPaUYqula1e0dMoTH9dYxQUxf3TU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn0dRn8sxa7j9xEE-GNICf6PCon9l5JYOmEyYHY9YNlw&oe=6A60BD9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqgQ6VSyUr0Q7kNvwEfdAqF&_nc_oc=AdrLCxZDi8di5nbclj4bQlhY6IllWtLmqx1Qr0SbFiuQBGTTUyDVvTmFYwTxfR9OQS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGfEc3G3AxfSudKYUlil9kSNa_62i0n4WqAkMPThQ3qw&oe=6A60C805"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXnsFIuMQJoQ7kNvwEE-oJr&_nc_oc=AdosTctUobuxaXsDLrWOMZZ1Y_1Te54442ioKrwslZF5QaDXG-I8Rk8UwIV4W2pzOhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe8lBP6nOHmxwWmEt3xmVeyAlbGopklidowY-Vv6RT3Q&oe=6A60C87D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ8Jl7GtBnYQ7kNvwHKx7pj&_nc_oc=Adrae1z3BnBSl43EVkfES_PmOi9GJrL9y-HBxf7BkesfC1DTfsMOzOgxPUfgK_Zuuhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDieELtm91qNe2o2MXJDm1C5i05uF8Q7aUqvkr8IpnpDg&oe=6A60B9F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq-LfuIQ3ysQ7kNvwFWbFNl&_nc_oc=Adopxf2eMmARSLo64pKVhvevt8S5yypNEBpPw0jfl1oJuMguFIfgdVI-URLju6wqUno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvNBmT37R5fr9l-kNc0PGukz_7SzCKbUPHsZaMdClTuw&oe=6A60CEA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
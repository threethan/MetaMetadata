_sid=6e7a0a&_nc_ohc=HfecWQlnllQQ7kNvwGzwuNv&_nc_oc=AdrQ73uE-Rx-ygiGrUWHDojs8ysN7FFLw8FVrD-roPr1mGQC46Hc1Gzwf_Gh2XqZU_o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWe1TS6_4DPzmHhU2dMDN6XFPKjyWMKB8ZuG3u_1bOzw&oe=6AECB4DF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfYGlCzeAJIQ7kNvwGrbM1K&_nc_oc=AdowPVoaD-wy6IDYGYZQUvjUQu7Dzugr51ou5PEEccmBebw9FPxD77H30ciLGWtOXCk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8wih3iqMQ6zUyiI4jF5MGh4OYZ5XrvGrsUsl7y41yQg&oe=6AEC8705"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HewoVh7UimMQ7kNvwGoxnNX&_nc_oc=AdqSlc0PAX4xakVYQOEJnlSC54O_GxDwuLpMGe0UVP2wSZbyxNXpGRfZl_9U7gFIFx8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5cGjZVk3H4vsWpLRXkncvmTcR0HRA2teoofjQXLDMew&oe=6AEC877D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_nwccFlp8YQ7kNvwHL0WbR&_nc_oc=Adp4HrUvabJwqMdJwonWl-hYDnlcJSUe3gc1IKIRmUIhudyLj3JJd59Pf-HX27QJZQA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdM_8X0mp3iZpqkzhO_yr_QV28EDuRD0axTe0ac9eU6w&oe=6AECB134"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lypLIxdVf84Q7kNvwGAECQo&_nc_oc=AdrT4wpGzMkIcyiLCA59YqC6IMQiENHQ7E85IAR6V3S4akJkrkz6jidHyM673nOxtA4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR32YRLDQIzACAhisXlQqo18a59fTFgmsQ9H03t0wApBQ&oe=6AEC8DA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
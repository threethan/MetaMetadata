g8m_oDIs1A&oe=69F4ACD3"}, {"file_name": "5.png", "id": "643693446735039", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974672_643693450068372_2765381301779825349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUJHn1n8QGwQ7kNvwHd4UY6&_nc_oc=AdqMu2u3Ga-g6sJf1SM-KFKosDnP9N2aBn0u2LUTnEyo3e4gZ3pvJmjHzA5QKhK5V4w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0En2ELvX1hU1UOVkSBaHzDOZ5GwBeZoLse9r4fxhp1IA&oe=69F4C34E"}, {"file_name": "4.png", "id": "535137037942845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974817_535137041276178_8615470723784735579_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65EVdX_aYSQQ7kNvwE7u_W1&_nc_oc=Adq5jvXEWlt4IbMGnTIUXuQcWEk2Za5xtlxsprJNaKP7Sg9-EDv1i5z_KOzDeptBcR8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af273KF0F2hY-YVtbkROH6C9_1bi8m9fauul6iKbL9M0Ug&oe=69F4AA01"}, {"file_name": "2.png", "id": "378241330781577", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974584_378241334114910_3487644665188837393_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a15Y5zHLQmUQ7kNvwHfUJJL&_nc_oc=AdqWE8luMVOZY8W8zdNSwGCl0bbNBr7HBoFRb1jD1XbNUUSqni7NrKsRC_kLrY3GVHM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TiCkX04w6nGBg9oipeyl0ks_n-lvIPY2X0b9pPlnEtQ&oe=69F4C042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "1680606845623142", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974584_1680606848956475_6020773676294071676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOWWtC91XwwQ7kNvwFd9AwK&_nc_oc=AdoZEG-utDPBeqtyJ_wiinTvXRAe7rsJh1uUQPXA4bW16_raGCMtKKBelLjOHO39EDo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2chbNRbKR0leB2a7YJVvQn045CrNuavwA3-djP4xnFUA&oe=69F49C57"}, "display_name": "Dungeon Maker", "keywords": [], "long_description": "Greetings My Lord ! \ud83d\udc51\n\nI hath heard thou art quite the dungeon connoisseur, so i maketh this bawbling passthrough system where thee can buildeth thy owneth dungeon using a variety of traps and items, as well as lodging waypoints to giveth goals to the dungeon seekers. \ud83c\udff0\n\nWhat can I expect from my dungeon??\nFear not Sire, there is much:\n1\ufe0f\u20e3 Proceduraly generated plot and a treasure to go with it.\n2\ufe0f\u20e3 Hand tracking and presence! Use your hands to bring up your Orb of Quests as well as interact with the world.\n3\ufe0f\u20e3 A variety of slashing, crushing and deadly traps.\n4\ufe0f\u20e3 Lava floor!\n5\ufe0f\u20e3 Quest items such as waypoints and keys (that open doors).\n6\ufe0f\u20e3 Occlusion boxes to occlude your own furniture.\n7\ufe0f\u20e3 Walls to build around your dungeon.\n8\ufe0f\u20e3 A save / load system so you don't need to keep rebuilding each time! (Even tough it's fun to build, let's be honest.)", "short_description": "Build your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "355455956363606"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2046368595792601"}, {"status": "PUBLISHED", "id": "30
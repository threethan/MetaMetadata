50585400828", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhjG_d4N6ykQ7kNvwEEWXzp&_nc_oc=AdqZQZDfEYeArvppyRBTGkyzrb2aeb8xOq-Y_qLT1RXADa-zlecptOgnkJAVGm_vLQY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN5-4b1u1XMwQj0AJX9eJWcN_JBZvyXZhZnUdb-k1jtg&oe=6A7DBE9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXVbuxRjJmwQ7kNvwETmZ5g&_nc_oc=AdrDxf1Xh5BIQp4cVYws9k0ZI_9vmPP76L0DcNRUBnq1UYMXS3PMQeuYjeD1aUgMtFo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxpzs1J-Oo2b5QWLZneG347FC4S1ZxSiXjldwZNo9pFA&oe=6A7DC905"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRbPhsU1SMoQ7kNvwG-yaSl&_nc_oc=AdqwUS-9si5PqOo4gjUiapbx2RpHqmIBbAJy_32743_bim7gn--qIGjDeb4Ts-J0EAs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI3KMvOB0P65doj4XdoDdLoV7teDDIXIV2n1Asv-8xlg&oe=6A7DC97D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAsfHHuQrwoQ7kNvwHamtT6&_nc_oc=AdoBZT50ljzeQ6hYHEaFm8A7UzLnwiAIDgWxfp38oBHmsoNoI1z86xsl6UkR6qYOEmU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsLkz0vpezf1pC7kd_KIw8UWo0-QCNkl4RopQNFzt5LA&oe=6A7DBAF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saACQljnetsQ7kNvwEEW9_y&_nc_oc=Adq7Uqurg8L-EWUbgxBUYsEo1QcS7N2V9Kq4EZQMn-5d_osep0raGrDwtgEHIP_qCn0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGngy7H-4jRnUGAtsKo7oMrBjYF0TviZHqkDZgBD2lWRw&oe=6A7DCFA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
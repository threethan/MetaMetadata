5400828", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO0hGlAvMO0Q7kNvwGWzugM&_nc_oc=Ado1G-1fxY3LG-kvvKadwmf0emmZ7qxipHSOMazBBYruyWQUWXtwcZQzoHDuJs0OvXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY9n72Qb2_Q4F-v7unsAuKI-lzld8oUZJDrtXHyxb9JQ&oe=6A8C3F1F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5PeBOdBMlQQ7kNvwHcUrmT&_nc_oc=Adq8ErAwlfwyw1GOn8lWRoSOAc0tiTSsegzeEO7COqSY2hM46_BYs-xB2mjNI7tzIw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoDAUHgBlfkOELw1PuvhgwcNCfkF4sHCKFSANQ0tG-OA&oe=6A8C1145"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QR8V2wda5loQ7kNvwHX0N1R&_nc_oc=AdqLHtVYTFxS9D6bC-q_ULD2Fg1XI1-FtqolzHIa5WN7bISvcxOXed4y15taQ7h90l8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuAGlorNeRYO3tdeG30UboBcvkY2h2Bcrf8qevUanZ9g&oe=6A8C11BD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6bVWXpVGiMQ7kNvwGcDvae&_nc_oc=Adovb65LmVw-_TzCqRPuNOwQE7jRa7_93VC3PWDBDHdCUixvbJu7c8qFl0a_JOvtrBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhNB0HTc6OPQmjUepzfww5s0NLHk-WM5p73I4D8T_y4Q&oe=6A8C3B74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3SO3prNn0IQ7kNvwFzJuUr&_nc_oc=Adoo_1JJ9-MNslixy6L4o7k4wqO3E_CFdrZgqgDjk5H-2FrYbUol3r04up1a5_s2QO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvJXMgPKXHnC50-H6MXjWkRTDz1Yy2exX6FJCRZ_0EQg&oe=6A8C17E6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
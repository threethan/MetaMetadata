5400828", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bs8cpVAOEMQ7kNvwHoiyQK&_nc_oc=Adql_OQCtxfdFgo0HEp8fpZEqlWPNI6_XdOX6LBUilngmjCVJ_tFW_3WSEtM3jysBnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIwfJLni4KHATJyHFQeVSiIfBhAroa6O2u-Pc0HaIxiQ&oe=6A73329F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC6kyOPuYdkQ7kNvwFPM1rt&_nc_oc=AdrshZEgclibRp7Yef119laxbV2dgLyshXOazVJcRkkB7frWVYOLm9OxTuDaSLOGixY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvsM5OwQepXMdc6HdR0xK0obJfLq_O8l4kYuxdf1iQjQ&oe=6A733D05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d16ZbXQocxAQ7kNvwEjTpVB&_nc_oc=AdryD1QVpCqvEQ0jzshgZQMRPUUuiKFidF24vst8MdkXJ9bkV2YoQinmOKn1fbnqKfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvbJ_Et9TKhNDXTgGXNXga8F5Xowk96mO6wyF-ibKFmQ&oe=6A733D7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgUb1GqS0tYQ7kNvwGimIi2&_nc_oc=AdrDPFmxXBk4JQiKqdXH2jWTwjfmi-UO4IKIFEECWvSOCkfEZTsaYoNb6PUefiUkGK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpjH8Ve0Cyg4VIQ0d8Vs0ahceWfjVAQH5lY2PvFPBeDQ&oe=6A732EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH-6v3M5vGUQ7kNvwGnNECq&_nc_oc=AdqILc2VUSJKM2tuDXZ6H9Ef8xBaQu3Em4bHNcA1f0H4GsDdOSQA654hVYMSj2j2Gvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETYpWpt5t793PkDek7EvR9TvBBW9X4Tid0JOSBTic7jg&oe=6A7343A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
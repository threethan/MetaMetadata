at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrl551JfKrIQ7kNvwFqKFiI&_nc_oc=Adq9Rk7hR-0mvlgNWwVhUjEN57HmjG3WZPYOkFI0VdCcIJHTcEyEhUMf4wkqalWY4Kg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-BHBFyCdXPsGiefK2O_k2JGowYnbxjl2T9Zuj48djWQ&oe=6A43BC9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoCBITp_Xk0Q7kNvwFtHwMy&_nc_oc=AdrvQji6wIr6xnGKyfEdkbMtWtZT-ZHQhHZoyrQw5qRDMGArpfqMBirdRdCSHrSOhlc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-31_lYFXesyg8kqfe7Y2fWgWm7SZ2asBaTFbje9Va6Jw&oe=6A43C705"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzW-Be8TvMcQ7kNvwGHR4fV&_nc_oc=AdrgE5OLOYob0W_OQdcHzXqTyBHOhqzeL9P7UndxJXYQB1ZhtnwiEn7n-VqnxGob-fQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tBKgH2k8aOy-ToI2SEs6NrD2iH7Our_5A8VtPvrbgvw&oe=6A43C77D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF90K74Beu8Q7kNvwEJtPX-&_nc_oc=AdowvEEoiXNNOYtp325QO-lnlHNeHo_xDEKZvKInBjCFQWwKzM7PAji1QjDU3Zmsc2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l_oIltWgsWfCs9aTo2K9eCIq1IDcIjpXktA13figsQQ&oe=6A43B8F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wolaxPuU478Q7kNvwG-s2-j&_nc_oc=AdoQwND7bPiygFjzQ4JKLnhJoP7MT1Eduii1cLbqNdI-Ao5hbzCHWeORtci53FlMHW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87nppWvJshJ4NNWTPxn20tH1yz7uVZfzmf6Z5zdMFzbw&oe=6A43CDA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
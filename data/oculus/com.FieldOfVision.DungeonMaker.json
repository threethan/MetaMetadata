_sid=6e7a0a&_nc_ohc=bdEfegXaq3gQ7kNvwGbrhsf&_nc_oc=Adom9329A9oFPe-zqLvX_nGoazcTF02OrLR7Jh5gFiVlgoopMXPBElizKPTA49JY5d8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmUWQ8A4Dmb_Cd3HT9iO9UibQWURqH-3vbGKF1vCNWgw&oe=6AF8925F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7wLG7Q3gcQ7kNvwGw62tU&_nc_oc=AdoaQRRttdcf_0Og3-SHP5kN2DyqfnPCIjoeA7K6dLZ-QeWVXbbdq-sKcxkhS7RlRp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY-h81YOTG9vHFjstHXDcJfp0dDmaqkufGsu7I2gkX5Q&oe=6AF89CC5"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGEz1wBDltUQ7kNvwGcaphW&_nc_oc=AdqH0Abs0elHuBuDKMEyMlYrU4wGwxh0nH4h4g0YFimLAAXLYjvxRW7u7dOV5RLThcE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRIwRaCFQpKySqPWSgHBQg_dcib2gsqwBTm1ucTYvgyw&oe=6AF89D3D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFDvxL7B_4UQ7kNvwFKQHtI&_nc_oc=AdpmhXhznqDI8kmSQ2SAevP-VkYI51MpX-U-mrKw4MowD9Z_wzWdZt3h2ktDb0P1_MM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBijWtDFQYiS1z-9m7TTDfZLT_MthcZfXOkZQo6ynFXQ&oe=6AF88EB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9nVvxZEVcEQ7kNvwHDso-e&_nc_oc=Adqs7kWbKcxTiCMZSrIc01oRtyJcBdkeA45rQ8XEMB8w6LC66ftnowX5wk7b8eXTSsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4gtypyzjG7ADvQFO88Hx_m1Q7ky8C9Dve_m0aMl08kg&oe=6AF8A366"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
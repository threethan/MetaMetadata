5400828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnkrscEhG-QQ7kNvwHVnilx&_nc_oc=AdoLi8sz-wN7mWW8TY4IpmTJlHd8bTHnxm1-2S-HP7MSfBjEictm1mwasFP0jwZ_5H4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB3cP2WvBWwo_7IV2S_W6mTXVeNDSbEI3VU5MUgDEIrg&oe=6ABD069F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWckREebVcIQ7kNvwE1K07K&_nc_oc=AdpZ-k_7R_FcKd2b3P1eJadtWAOpZGs9kKL-t4NnUxn8DszseyaStGZsM4f1_e8Ze34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHcqqgW0v9L1S72U5hMcj5Qdw-nh5939bN9q2L4przBw&oe=6ABD1105"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrKlvJbzkAkQ7kNvwG3UIdZ&_nc_oc=AdriQ6nOewXq2F4pFHGp3J3f1DK9mtr3hwZsgnlLZcfwX-2LRhirIHBuw3IRwEvTTSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjuPOwV3dTJaPX-7NDoYKTURTOBcOPoxS1wCwpEu960A&oe=6ABD117D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHsM3ILRjw0Q7kNvwGwGvxr&_nc_oc=AdrMEDvJhPabMCgrRh9sO8jUCjdQlNpnBqLE0H_Hk0rV3a8Z-mogDdpyAEt0jmC8daQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJVAnuOQ9u2ztJ9nirHgFaxFccmhWUuQI05bfOoHEJwQ&oe=6ABD02F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEqVKQAqSo0Q7kNvwGu8Xoz&_nc_oc=AdqVZqENm9JdNbE6QkCXuEHeMO6eeFWf5pU5EzpwQUFdgw5hWPacG4XDPE2AgCU10Ic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmTNAy4lKt_eC1AB--rf3O3uaTsdhA1d3_8KJ1mDD-qA&oe=6ABD17A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
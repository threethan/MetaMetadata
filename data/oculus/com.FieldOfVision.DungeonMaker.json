5400828", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi8L975h_kkQ7kNvwHQhUVk&_nc_oc=AdrgAdCFM0qA-BQyXBtqRIuM46FocxSMIPBrxv26u-JhVxIJmHeqI83oiCjHvOLdjzs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLvYu1TYCJMLdxbQ3IrntGgsgBrwXvl922mhbyrmYz1w&oe=6A973B9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjEXsImww04Q7kNvwH91KrQ&_nc_oc=AdrmK4u1vJVw9QhxYqCctbFA9aJIJ5VwlHurKLOaqo7oZ1Np5zrSKRpRUpkL-dn6Z9U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4xHTS5wYmRuM2cZnfKR0goeLkOcJBJR5IJRlVVmWOoA&oe=6A974605"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhUc62zrbskQ7kNvwGNmKN_&_nc_oc=Ado2k8S45R6qy2WOeXqpLede9qmL4TQC_0zvvrmcy1IfBSuaGvXQ0hb4BQX0f3CWNoU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDEa_fmEtbE63byP4N_WZYb_aQi1Z65Bw4gQ11N3nwzQ&oe=6A97467D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8Ek0zqz9r4Q7kNvwGsIu8o&_nc_oc=AdqamFLX_-oD9QtYsQk7IzqZ7NcW4De5Uq7wA578r79PTbx4SNBRFMPR8qbbO_doyyM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGekNfppZRJXAalKuU7vB-6ZyX1gPrxsEK7qznGZj9ssQ&oe=6A9737F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXkIpVnNZgUQ7kNvwGmBk1Z&_nc_oc=Adr2lN40GV_Y7BV-W_c9g3_PUQh51mazlUm1ja-EqFP2vQtS260OrLYuHzUS2GAFo4o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaLhkSRJn9drXMkNsmkoM13DX-LqlxbbCG7ZCs0p0YPA&oe=6A974CA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy3HbJK0_28Q7kNvwEHLXW6&_nc_oc=AdpX1prS74PvA41bFkYx0HzH94jbTRzvdEPzEdBTmEAqILXpOWVSNPOsI4xCz09PpJc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6lFRea1sV4KT8TBQW_KxH3kGf0f7WehfM3aFTTB7Stg&oe=6A280D1F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R1RTk-C9IsQ7kNvwEG4K-S&_nc_oc=AdqSHw3IJ1xncRoP69QBI4q9tsEt3XPO0PtkJTdBwjGamcfFYveu2s_n9AhdwvjLNZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fyRXVA5cpfc_-abxBtQN1QzJCxhkHUQRlPJHBo5KyXA&oe=6A281785"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXOyxgHVewkQ7kNvwHMMj0z&_nc_oc=AdoSP5Y2ZmH84aJpEy4gOeTCih-clw4awTbT0YCtOuxf8ZHQaOqwghS_jve_C8ZUU2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c43baVKzlCxDLBJ_kw6DUXBEi2xgMG9TP4JCQMBKbeA&oe=6A2817FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1u9MVjkXgsQ7kNvwE-g5mi&_nc_oc=AdqlyhMbcg1x2ve2H-jdasNB_D0USJ6uXxSxRcsQ2xu5HNtin1RnlqrKB0VB5n1aYSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JIxWbLl4tdASAuGCxy4_N8hgKZETW6_nyABNjQvIBng&oe=6A280974"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AcbwtNDemUQ7kNvwHH8Wgl&_nc_oc=AdqAA25OSFmKH1eQSYS-FNw84AOcltko_HIUYAcDqiyZF3ZQBcvH10AU7vmouwz9E4k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D8_TgVPygS8v3CnZqxwSSNmxf5UvwzqnFVOKzC3DO1Q&oe=6A281E26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
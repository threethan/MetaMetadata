at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekrtS09e19oQ7kNvwHDh9OU&_nc_oc=Adr8R63sLiY6DqY2puH1vwMsPNBk-ljeU-BpDbx-JQ5XrHzZczueXombBI3c2z554HE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDyUpg67_j_YXlWRXT_Vbauxw1bwuRacIPn152YR-DqQ&oe=6A5CC91F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQi9efSEJvoQ7kNvwH61RQ8&_nc_oc=AdqU8jCffC-OQ1BIaYBTrYjzGaZyqVJlpMWlESKk0JrP5dfGyFcKuKLCwrp8F5eNtJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIoNyiApBSSMkwwohj4S_fIVDEJ-CkSTjGtBU1PiohXw&oe=6A5CD385"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwJRPl-X0MQQ7kNvwGuZLp7&_nc_oc=AdpjpjPs3xy8_K6ZK8GiHD4x5eylr7IpuL6odPned5FJ2fBU3HS1u8VmGrjnE5LoA1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApu_PX6hH3UpZvevtMWyO061QmgbXo-dk-n_U1Z5wZkw&oe=6A5CD3FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCHOnT6LEiEQ7kNvwF_iQuV&_nc_oc=AdoUa2ZmC6lLqSrq6-eWgMwRzDD962Abe5riu9t5mVDV1Aguj8KW3srZRO2YXTyzWPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmczn7xsGTGBmKH5fA6EG0qsGBv4CZ1NP-N9U1gS3x9w&oe=6A5CC574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dhOSkdgiwwQ7kNvwGvtlZL&_nc_oc=Adp81jcnIzTaqiZ2MiydUaR7-0dsAw98fsfW8LYlWHkRE84mgIFEqda3qlV_0e6JS6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNb1HEdBfIm0NH3hrSqePYTMrbUGHfRJG-QbMlZXLNIg&oe=6A5CDA26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn20M5wRSVgQ7kNvwE_KxJ2&_nc_oc=Adq_fW6bzamBwcgWNNK1Av_lj-ZeEGNWbKl4BW1mYAtYOnjEItc-oR1n7QQyAiat-Cc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dK3ctmOtkqFVUxR2QFEdmDJw4o8e7QVgfwkd9Z58-mQ&oe=69FC8B9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEDKofda8kgQ7kNvwGr0fC6&_nc_oc=AdqHe9CBuvpoyvQ_vGyIKjHO9GVN-Hh0pnkB1svLrrTh48DI46bcn5h7xq8u2rx0V_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F7bsQ69fZBvMwQjrtL7Zhbeynq0hGPIFWyYhw-GP5uw&oe=69FC9605"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzP4bZBrMvcQ7kNvwGdjee0&_nc_oc=Adp-t5_lgGd4qaxdjZDvGIp9892AVZjImBYLCxkz_VcjXwd-jK6uPzBhwQcqdZyBFtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qBS3TldOV57PHGmkvUdeQ6lEADBxUWm-2BHORA_Nrhg&oe=69FC967D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em-hIuv-7rsQ7kNvwHq7IFO&_nc_oc=AdpxnLIMf25k8QrUrroON3V8KXZrJmfWKmSxJvnLWVgYvvB07kz73E6gP1rTpoeFAlg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EJQvJcgjA1SNeNwfdmg2i9gohmlcWM6VzUhfHbq-R6Q&oe=69FC87F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P6Vya6n4s0Q7kNvwEuiVNY&_nc_oc=AdqR3uqKPVK60CUTxPO9rj9zzeI9Q9fgOVkof6n8VdfOUt0apdi-ZFiNaHA6rqXzkew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fali1JuPOUkzU6dgwQ0PD1G_nxQyYv0DdFcminlx7RQ&oe=69FC9CA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_o9069m4XAQ7kNvwFZ5CH0&_nc_oc=AdoKBhU6V_bl7a9mRlzX3qRVNg4eA659nlFwNfbOaI6Q-Li2uh0eXUFWoYPLPDGPexE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxg7Iyhgl4cQTqCArYONtmsZZHo5vz7N0AJ2sWF8LgsA&oe=6A64B21F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB2wB-2nf1wQ7kNvwGq8Y-n&_nc_oc=Adp4_dePSibsJUgDaLHyrs3dv30hq1EyxclQwStg71W9vmFaDHU2j3VaFqiLwX0SQX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfCTe2IczwCmlObYszJyVR3Bw6wOTiJZmV7KUM_eEmDQ&oe=6A64BC85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BfRKBuEULAQ7kNvwEir-e8&_nc_oc=AdrasJnSeBzu1r1Bd4e59b2noL2lPMYNxyQpU5werMVDHnmGtXrvz7GzFTZUztf4Ksw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTRqiAijrjZ492zYp_R3txdgnecGNwOZS1su1LTxpp-g&oe=6A64BCFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rSA6RT5mHIQ7kNvwGUkpye&_nc_oc=AdpR2v-Oh_NWtRJaYIhHR0l2HOh-FqB7C14E15raUTDrt_UlVzdLfxMFb3qrMYBtv_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAioyQFJU9HCpDQ4bTR6SftuKSBvVy6vOiXjOzA72Gezg&oe=6A64AE74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNQmDvM2IIIQ7kNvwFxMkVq&_nc_oc=AdpEc8YMW4nyTTylfxsv7V-fd_tBFi5DZUFhdf5iX3vBeR8OMv6aiKMFMFXqqXtpmUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfuiWHg4fH47ipJUAOcOPUwZuhRXSmzeJ05SzHX2WFtQ&oe=6A64C326"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
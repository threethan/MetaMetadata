5400828", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PGC1fAitwYQ7kNvwFJ8e-_&_nc_oc=AdpH92WOcCU001BIjbRoT-puIWGR6ba28N-CD7XZBF3PKumIYBBWsrtA_0tHV2rZIGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY16cJHMt4-YN-lXqKFEQcYa3x0A3gnfU3YmeLScbdqA&oe=6AAFD79F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWtZZds8DwYQ7kNvwHh72eG&_nc_oc=AdoR-sOlbMvt6uB-iSG4Z_BF8ywvfQ_55xRMrgKavfRglm65G2PJdt1qFtZxWprpv2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX9R8VOWp_yc98mHd5B-vSfaU1a7ZoEDz1ukCbwO0XQQ&oe=6AAFE205"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yorR36DY_YEQ7kNvwG7tQHk&_nc_oc=AdoJQTdhXc1QwV6asLEPxRV0t1RJ3IuL1kVYJrM4CHInSbXWKAyyN-8lgjcvIpbly3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHTeqP32DOcpygbAOrzkBREPYcq-qYzEaQrvjiGGm9Bw&oe=6AAFE27D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4sy04B0p_AQ7kNvwHUiV7i&_nc_oc=AdqOKu7cemelGSvqdlH7qP-G7Wq9Hx3Zy-FdmvDTjHgzpUzzsCAu5pB5tOMuevTqz34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdCSkOeBFXiORxmBmjqyimgWaSLnV5O2IfWx2bjidTGQ&oe=6AAFD3F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3od5Y9aVcW0Q7kNvwHVRXjd&_nc_oc=AdpgxHqZ8Y-mdQnW30j0LjtasSgwaeGC5K_LG8Oj1Qbw_Ivz614H9RijKLAaiTdRUP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm1vf9Z-Ua9FtBmHKQ3OAYNdKu4sqoqbDbh5wI4jCl6g&oe=6AAFE8A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4OHaNzjdZIQ7kNvwE0-JZE&_nc_oc=AdpC-6bWsPQ5kr0fW15lR1MvIhXWy7z5ETXXwPpkX9xmYBkRX9g1zGGJEPWBgSS89xg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rSDDfDKtAmDPAlPqpg7sWS9rPGf6TDPN6caxowTXyZw&oe=6A21759F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUyJfnRFafUQ7kNvwElFNt_&_nc_oc=AdqCx0sNDaNeGZVlnJk1Di1j1i308Q4q-T-t2nwtwieDb9YXPwodlYz63GDFWu4NTZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-874UQ1S6P2bguY6QrmuETe2jcU0PiKyEkSR784JYR-A&oe=6A218005"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Tt0aK7ZDeoQ7kNvwErNC5P&_nc_oc=AdoH1il0PRvvWF9JuLG0cpzcnCr-d9BCa9WV8w7A-5xo0tFNVpF49LK-21_MkntzwHU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LPcYDoP_afdPK7aGk9orvAySr3RmH4AEBCKhK7i1URg&oe=6A21807D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwFtriCwHRwQ7kNvwHuaNQW&_nc_oc=Ado0bffcxl_oHhPxFuV4_WHoxP6bkG4NlZRFC0p6tg9E5c9WeFmtXTEA330-abZ4_cY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DDTMuyM_sNumbiek7XxbxtkhzqHJjTgeY5D0g-g3mhQ&oe=6A2171F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppiWu2X9RkMQ7kNvwGVKUvH&_nc_oc=AdqF9FNbmJf4YBBDUhVJYAW2Zmq3Fg8iaEG6hxdkCgup2nC2z1yqnm_tfdyryymNH-Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C0k43_Xn2qNf7xU63Ma9ziIjkCXWCri1MLPW7QLstVw&oe=6A2186A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
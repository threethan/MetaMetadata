at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NpcINns25gQ7kNvwHQkp-g&_nc_oc=AdqVaKEGJ8OThPJwegahM9OuePX-a3dgPc9GHz-I9T7Yu1HPA5TGfc5DkTVRBjIbiIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jmwuahrOBoIaEThD-Dmx1Sma-xRe82nej9RCptmZI0w&oe=69F8971F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_fAdroG2jAQ7kNvwEBNyHO&_nc_oc=Adqvj2OBHnoVc5xjjgy2JpaPGSLRtSkJGmgz6QIN6HTGdgBMP0VU9DytE6E4-1hTq8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cmuK_AFi5lgnRE0TMwvKC6mxP7AqXz8CC4FO-qYgVCQ&oe=69F8A185"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QadodXd17JoQ7kNvwGlAYPA&_nc_oc=Ado7pS2iTSPG-gZbQu-kQP_yqD1Kpr674RdGMl_vGKPkNHkn_jITzpTjqHzsooXCDnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-Pt0VdO2QL7d68sAkLB7TezlxK0wQmwSpVs3oc0GJMQ&oe=69F8A1FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vq1mgacKyi4Q7kNvwE0uHIg&_nc_oc=Adp9_t4jOCD9lVggUTjua-xARPvb9JpgLgPiK5fNWOl2kh5moESaBGgGuiZJFLyLf4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JjKyySUfsV_Xl579cqHHp7gIWX2wQF8uc056_M3W8lw&oe=69F89374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTNsm7uEJpQQ7kNvwESgSm3&_nc_oc=AdrLBlmP9KAPi2jQx_7cWAysSj6ktYHcbqwY7poAIFo6VB_pssnLr0WR-hAenboaGp4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xKNfyqkxBKvqcjJ1AE5Vf4zjXfMQzSDLuDaWF23BdqQ&oe=69F8A826"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
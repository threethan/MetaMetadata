5400828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctPEoBMfFdMQ7kNvwF2rspo&_nc_oc=AdpatnWyhHWiBpBvBcFsEO0Hw4S-nS_EjSC_kNCDj7HzZIl4A5Esi0JiVkh-9w6SMoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaNjAXcoOQiD-owMjn2kr3T3eW95wLeEBUZ9w4OSGkEQ&oe=6ACD10DF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2vrHASsum4Q7kNvwHM-die&_nc_oc=Adq900Hm8Tf8FG0nQ3HEpaclPbaT20uzkgZb-Y1Mdtk8c60xyNke5NVyh5NVaeDpxIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9l7klKXoOBeR-DUNRo1GnRzUmEovtlSICeLnGwP3uOg&oe=6ACCE305"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D71URflWMZsQ7kNvwGXabEF&_nc_oc=Adqbjm37pD7GyUEdA5iIoIaIE6RVP8WfQvrs6gb0NejAYHVNPbYQmBhBuXD2o5dVD-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpjVHPVJSwwy2hSg54cyWLVHaPyfMjqBpVGsaB6cfAoQ&oe=6ACCE37D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6Mw2aR18kkQ7kNvwFgqvu6&_nc_oc=AdrjfaNkBps7ihEOXPWiebHI2gSsyBGSszz9RqvK66I8UhY4AUY4loxTyn8CG66TT0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJE7ihrUuDZHhJHXLQbHAG59wteQuY0ulVgdo1qRfH7w&oe=6ACD0D34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX_LHAu7sJwQ7kNvwE26BJI&_nc_oc=AdojXsqyz0kHTWLTm438lrkshIwEj0tceX381lIeowA9kaNTy-9IKrB1lxc4F8B3Gn8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmw3f2zz97h0T8NqHNEJn1EaG87qf7-WsNB86lz5EuzQ&oe=6ACCE9A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
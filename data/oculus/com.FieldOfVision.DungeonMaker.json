at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQqcFpvQCb8Q7kNvwH2Fnnz&_nc_oc=AdppGwYgu0nAb-yfuA_7D305BGXDvDdpByO6bs0vcmWnkd4KbWeve2R9imGcuHLSaBg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af451_qogQRPf--AOjQGLS21G9LrLfajsz6vKLREPVgByw&oe=6A10521F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2rEMP0gDLwQ7kNvwE5YdlB&_nc_oc=Adp7b-olsfiMAfsGfJhxvvDkoxa1EWD4WeDtE2KfEEJbdqiYwZt-ytnFsRkkhXQYDI8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G8WElojw9DdEm3No8CH_ixZDycZqCj8geoTGZkz_9Rw&oe=6A105C85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_T77vpJZZ4Q7kNvwHl8t0i&_nc_oc=Adrd1qOR1iU9DQNvKALkCFazHoeVqF8KYJNGQ3k-DumxiLWPvVtkGYTmOyKBsOG2-k0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d2Yqv_mmRD1uSARGiMReObh7JeL-9PHwwJz2_5a8spA&oe=6A105CFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOeCcOLR3vwQ7kNvwHQPHCh&_nc_oc=Adr2WBKNPf21he-Voz7gA91k78YLAE4nz1UPB9UEmO7vYvRdoiraeVCCzR-4YOE5Gjs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48AvgpbnGY6S_ALnuAZkCriKjOE5t6qrbD7tysaCadnQ&oe=6A104E74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUsov_EovZgQ7kNvwFy39W2&_nc_oc=Adqtc2cZXlt-6F1C26pvnnQcDWt3KYrol-q5UcmmU1oEY9wMfdPCmUvOMyLuWu6k2Jc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TfkyBkAbERmyXbgrZKHBkCupSWLOnL2ReND-LjwAtAw&oe=6A106326"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
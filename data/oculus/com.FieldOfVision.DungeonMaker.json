_sid=6e7a0a&_nc_ohc=HfecWQlnllQQ7kNvwHt9WJV&_nc_oc=Adqcnli5OQv-NMWgurU4Ec4zLIeJlOzV_QDyOYdfYqoJGSIpIk4HyU99RGZqi5qXnT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXpQgBGYtB90CZh7UF2X5G5lu6uVvBDv_0rQkSovldNA&oe=6AEA11DF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOmiSWAaS5cQ7kNvwEviquk&_nc_oc=AdqI82dZFOLSfxp4eBrL98mwRFw9O9wIY1zNlR9-ko8eQcS5ag6dQBbFPlG8Xt7SlAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLtazuzOyiZFJ9WqYVpVNT7T7mx0fJ9tVhtpr0wPOUeg&oe=6AE9E405"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8J33EC1lY34Q7kNvwG5dpc1&_nc_oc=AdoGTVezHCZj-V1BaPMleV1n6p7dr5hjmGXgMd1z3BUC2IOAOEB3CDDIQIqs5T5I_88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC89qHesBRhxMmgnU64VYujAU32bLcUjAAoPdOr1Zhjg&oe=6AE9E47D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaMoEZnLSZYQ7kNvwF9x5VS&_nc_oc=Adrh7MQqV1uWckrPUf_DlzN6MIw3k-FPhSBP2DguJDW59Gme6IkHNJ_yRIp2nRCMGeg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhQR9Jv7iG7acyKhWBCze6Fi54L1W-MZYIl-nFS-P8LQ&oe=6AEA0E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZhISU_cG84Q7kNvwF6hRx_&_nc_oc=AdpQ5fC68EV8gHOHKxS_ld9ML--LA8gK2De9VCRdOYxi0yrD45f5gMmxNCSzw_GMqtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRImWBgm7cZA8CqyS7_wcUNSDm1sVKWm_AGpNi9ShAWMQ&oe=6AE9EAA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
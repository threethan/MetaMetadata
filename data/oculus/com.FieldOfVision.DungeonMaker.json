5400828", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO0hGlAvMO0Q7kNvwEUFJiY&_nc_oc=AdopwslI_-Aar68L2xirKpWsiOcUZERjETgZpxPA-OTCFXAD0iBMzI5htUKq_rR7EWM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH684O8mZ_Hi-7EaYt0Cny_ZqRUeaU6AxjNDodXxceE9w&oe=6A8AED9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfOJ88b1cGkQ7kNvwEBNMgc&_nc_oc=Adq-yrHb6RBeV0PmMxFGSrym-4c7AycwjghioQ2hWs7HlHL0EaAeMRy1cheTOk3B7PI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHCeSkK4SxF9liuNdFu5pUNLoL11-cAd8uN84zxQCoUg&oe=6A8AF805"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QR8V2wda5loQ7kNvwGDhJZ7&_nc_oc=Adpemi6Vvv-ei0Yg7lJL87BbfVkQAQzQb9nJQQtXlAub5T3LorRbc_-mAiDyGXp4lRc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6jW5Lv90dXLVPLBA69Mogrfs_leNw4OxhgJYFUvSXyA&oe=6A8AF87D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6bVWXpVGiMQ7kNvwFcVmnX&_nc_oc=AdqYWxekGtQ9mOA_XIYvAsKqBYBoQAXl8FOMHwkbeXcbOEB1iTkrCUwXOqn1pzCuA1U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWv1CTBK_GnrW1ydyPiGo1DhAk02OFVctclxkIqVbeTg&oe=6A8AE9F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3SO3prNn0IQ7kNvwEiEfE-&_nc_oc=Adr9J1-lIxUoU5NQ5v1wAQli64AKgCSIdb8CR-Iq8SKY-wkt_Nq-qXc4fvbnwKrpnyc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAIZ4M24KVhMLb7z35n_50iVYdOvIuwj-U2JWNalb8CA&oe=6A8AC666"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
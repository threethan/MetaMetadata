_sid=6e7a0a&_nc_ohc=RDS9JLV-qb8Q7kNvwE1SaQq&_nc_oc=AdofFTnHWUFhr-NygmwykgRzMClLcvB3yOndl8Q5Wa6t_2lI9SURiXTyV-fXXUA17PE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfBXWOUReoR8L9QuEEC_cFG_yh8vz5a2TqqSO0s1pVKQ&oe=6AF49DDF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuUTsB6UZBUQ7kNvwH2NScq&_nc_oc=Adp_COair94Pfqgqh8-wkA-wGwGZBZTOrsu-CxRv4HTFZ8JxmzRoteKBhZLSuq5XJfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ0Ku6Uh2QdZYyFVVKsTcA0u71Key6gU6BDRyW6qiahQ&oe=6AF47005"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EabVqA10uVMQ7kNvwGF8meb&_nc_oc=AdqLA7PO-cLdsr6MBy2ADEYP-TmY1bUuYvWtNfW29F3TvjbRK58RaHhj-kihKsfEIK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbyxjfpVb_e0KvujF418i4YGdtgvYRzvEcprQW3oLoRw&oe=6AF4707D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UWBZvKuwHAQ7kNvwFZYeZR&_nc_oc=AdrgrXcCHZ5N6IfBA0DtPkKfPnxLJuQEnrYBhmugd0jiECixYKUBNajevpzqM_3iv5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTxcti3eGzEGk9syW_7snH6ywwljPkFHL4QrNItxWMyA&oe=6AF49A34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDhLavgP1ksQ7kNvwH-J3F_&_nc_oc=Adr24ZrcCe9dKKgES44tb0GBOsbucUPpC2ZmMVPGmPy1rLJ5m32mF67S-SWsb0p141A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0LVtdskA4yEaMzxDlcXyhS6hdBqKD18PFCAbjk4ESbw&oe=6AF476A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWuiZDOO3zEQ7kNvwHJ-cim&_nc_oc=AdoD5aNzs_SypySNlBinE032qeV8b5M9kpd7N5MS_Q_NEW6LVcIAFKVvjQ7aYLoZOBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iiUnb2pRhWDkuwR0TfNeelbxOswkx1X9Bk6N9tbJszQ&oe=6A14469F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW8F-vMllxMQ7kNvwFfNE3Z&_nc_oc=AdoWK2eP8M162vanUju9H8ug0sh95F_f1ZI-vsT4WGlV_Sx9h-CKyCJBWyG8l_I6xlo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EmbXlKCEmxdyV8GfV_cX8o7VaX-3iItvEQJ0oQPdxAA&oe=6A145105"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUT4jDDHBecQ7kNvwG34KJU&_nc_oc=AdqD4a_kbFEnXYN2VvshQoXLn-v1hEv7rUpAhqnp7K2OI2Rlr-l_rG2q3Wnr2UrM-84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PSpO_TooVPLLGGOTOK48AxKRTOT1_8so_gf7YtMDo_Q&oe=6A14517D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9yUYQUshooQ7kNvwFIdCrl&_nc_oc=AdrafEsPFGGz4dy8Pni-6SILRbVaS5GuKpeoM5MqlcNin1tD82IqW25JQNkwypT_h90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-qm0WKuVAoS5NhmztpBucWnW8k3OUBubMT8h0z0zmZw&oe=6A1442F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbVj016OsrEQ7kNvwFoLklr&_nc_oc=AdpfXBVNyNsw4W4SmHzUNMlcI2LTkmH7QE8iVv15cqEFUM8JM8U5OA6UWACpIYcLNyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51_aTCzU7g6-5DqXrdOsnRZWsBYSU5WbIXhQjJY0vA3g&oe=6A1457A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
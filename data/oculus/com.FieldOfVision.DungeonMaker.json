at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WjCNTApq1sQ7kNvwH68dsR&_nc_oc=AdrPg0c2DQcJbjr8k66WBnyzzIy-EKhMeyRYj6Y2CH-PXp7glnlPgt0iGeBuVIPVXo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72CEn3GCuh15sox51ts8Fiazi9z1TCIUNa5mP2yi9fRg&oe=6A198C9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGlztQfyOocQ7kNvwH9WJiN&_nc_oc=AdrBHdsENU4vxsbBpCZW84a4IjEeCTkZAL75kfH2x6MZWvY4qhyoOz3JoQ9TdmMdUWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SmvPetxPZgnaj3RhK7snhBrQDnlc9UJGhRlaiV8UZAQ&oe=6A199705"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01HpDEgA-vAQ7kNvwHZ6oZ-&_nc_oc=AdqFs_jgTpzCVPuaJe_qzlliiTepeJwlEeSn6cW55OJCKpQWLbL0IR5oM30ip0ARIjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58lcwW9SXU-XU49WNORvoObzeXQkwLDaDDfYOyIa0T-A&oe=6A19977D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZluphqUhInwQ7kNvwFgZmQx&_nc_oc=AdoC4Buxydo_dFckcjl2sW5glPvjsDsGyUMnnnfENzzp4CLpgmhMsm-FjULoZk_spPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HntjB7uKyRymeHVeO0Iu6MtYDuazQePIfWLTWiaeY1A&oe=6A1988F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaGNRlgYKNMQ7kNvwHhXP0N&_nc_oc=AdpYGc6XshERUp2KLrFvYC8pdxk5-4mcPgr9YtSahChHYcpvBOGssNgfgxZzapnbWZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YMkHT_wqQX4apay8v92xJuSgbrZ2-Js1246f08QblAw&oe=6A199DA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
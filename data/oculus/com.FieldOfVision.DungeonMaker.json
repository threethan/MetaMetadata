at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDqwrm2gpA8Q7kNvwFVHpNC&_nc_oc=Adoikjsv-sqknt2cUzudm4Xj1RNcofyJMUp0Ijry0bWxmg4Oi2M8nRYyzN6p94BhwCU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRvp970K5wDbhELHdCrG7U5Z9HoL9Ro8GEXGp_ZcJBjA&oe=6A68A69F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZocCdEZq14Q7kNvwHdwZlW&_nc_oc=Ado4ugjqWxkvKktU_jDQl8e7BMxV1zzuL5Fkn1Iktp7HLp0rhIH9JXN0NwCVY_6vTH8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1AWhNki9ZCGeBCLSZO8Pl8IGZG6aC2VtiZFoxlKPY6g&oe=6A68B105"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iYyF9XH2iQQ7kNvwH0YNg6&_nc_oc=AdppeXLA-p3A036OweVD3UWG0a8ZE-uM4hc5HbS-IZXYERRo0_LvwYweX7PkmxYBpR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwkZRZgjca1oo5ZHywV1HnuEL6kq-YIbWeLqfB2nxY7A&oe=6A68B17D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuKJ1iDDBWMQ7kNvwEovHAW&_nc_oc=Adpn8yOzmKXehTwSr4pHs8nn15um_yxIpmeDClz5ge8LTTfdlimZLEZ_ZPxOGSQvc1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo-iHvom-pDgKDeaPuv9jhz3Dc6AL_ghOxFJlqoAZnyA&oe=6A68A2F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gwk06VokBYQ7kNvwEbOt0d&_nc_oc=AdpdjKUUK3Wy6U3j31FQI_gZHnnwOKAVQhJKi4QRhVb1XHgVCmzy6Khz1o-vQEn63zQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyh-Ih2A6_q28DB4veQvK8gRNCnlEEk0DCXG0L8LybpA&oe=6A68B7A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
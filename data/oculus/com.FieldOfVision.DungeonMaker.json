at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YQjGI3KdB4Q7kNvwHJP3le&_nc_oc=AdpXSGX261C8OUkFfC9lFZIDLlrdJnMf6kSMeDnkq8eJF2KwJ0PL6RPf_LDkE085-kE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuKVyiMSZ-YQ60ufBpEo2tSA2CMn1GUwBihYCTCWPp6g&oe=6A6B499F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZocCdEZq14Q7kNvwF0KILB&_nc_oc=Adovtzoj2cWFkRWWZ4WDEajipCxP-Jg2nstqEGnbRVp5a01BeGwwS98QKhVufpcouKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa6SoQSh095qq0cOMO_Hrpw04Uwt9IECAUPf5N6RQ9BQ&oe=6A6B5405"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jY_C3YRhSEQ7kNvwFnOnDZ&_nc_oc=Adpnvg0Nu1wEHaOo5HJxbtEm1iK-KB9LCy5gbdg-TKv-DPfaGyd1Xw93k998z_bu_TQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACOZjcKyoXyu2o6SuXdT4tFJ2ljTg07J53z37jBOPAOw&oe=6A6B547D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsJ2mFZgZdsQ7kNvwFjbI4H&_nc_oc=AdrRJMBPwtzn7Y6VwkQNqy0WRzOyrp0ZzsLyLgNhZfGzfTWcoYUrmdGQ9RmrfYaPv00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHzeGT5wQY4tyPJIbe4bblRUSMStl4fMRhAOWKtKeGLw&oe=6A6B45F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsyrSwlvokgQ7kNvwFnAeby&_nc_oc=AdorO-lcC1UXagGDkFHSJ9MS7WxM2wYNy2TaHBH1pJI9hDqDAnkLWyEJPY0NmVkpaFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFhvCM1ApX9rcA5GPEZgoRqjFTp9n6TeseQTn7-eIMag&oe=6A6B5AA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
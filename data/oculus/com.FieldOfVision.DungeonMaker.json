at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4TxAm005wIQ7kNvwHpzC6A&_nc_oc=AdokEbTev3EUvf4gW6RdSQdxqKiIS6wljEQ8Ft0xQHicwLa-c9f1pt9RDpJAQuiY7DE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAllPPkp_q_guoTXC92xPZQ6RnBSMPHH83sl34bepI0eA&oe=6A4F9A1F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olmOJoXt-LIQ7kNvwEnbTSd&_nc_oc=AdoGm1RcHlaqj6W-axxHFIYQSueShYSmRnmGqLnIDcqTOZQR485FkrkCPqx73S1L1_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCRO1pDMA91nHDszftejTqe4uHfQ9Wlbc9p6sWovKHtA&oe=6A4FA485"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGtkyH_neesQ7kNvwGSi3BU&_nc_oc=AdqgF8XXGXFig_WCe1PKG8z4YGwC_d4ww3dElLlJqCLNdVrwSYDNpGy_aCVHtWbRm2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyUlQVjVs3QbGRFw7fQ34Mesn_tWd36Gn40HRlfjePIg&oe=6A4FA4FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT1uA0VdvDIQ7kNvwGqr8hi&_nc_oc=Adp81hWMan2iRIP3cqrD_pOCuXbGR6wVFce4J-PcCgeumilijKN9PZz1EcWzeSYPylM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTFAiYoG1vKooiIm9Xqr50RRj_hV6ugfh-2afa2NvwnA&oe=6A4F9674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPR0WnXBlVwQ7kNvwGDt-BE&_nc_oc=AdpRFu21_GOtrDGyn_BnLG0D8rK_W3f3lrIjrRt7xcnsI0m34ti4FOaMRi2ypqBjK80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlPBHYgNe0T3kOFCVMaCss7S2aKqql8Z4BX7MiNzMIwg&oe=6A4FAB26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kqy0ECFHOsQ7kNvwF4W1xk&_nc_oc=AdoMhuM-HW4AwKDTSDbEyQ1C4l7CznwD8C9UuDN_gNWxuD3jfrFYkUWiOpUs2t-3NQw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfNCp9w0Hr9N1yQgZpViOw3xLiKxg_6QlvHrBTfhxUxQ&oe=6A4E489F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olmOJoXt-LIQ7kNvwHp0Sqw&_nc_oc=Adqc85evpplvXlI7X4I00BDFKrWlOgu75LcC0V1rNQTqNBIYhh40Y6XMMF-OWhph5N0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEVkzA-MIPHySBDme02_sXhZONXVgwXoBydf2pjn9z3g&oe=6A4E5305"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGtkyH_neesQ7kNvwE3TH6H&_nc_oc=AdoAx1gfErpoJr4KL8yHOPXeNL5zYCBBUPox0Bo0sk6Kg99ccM9LzxDixl5ytNNtbwU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPtaGMdzbtzIWC1MxIQ2PeE6UkmlYSu073H5ukChxGgA&oe=6A4E537D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT1uA0VdvDIQ7kNvwGUdzvE&_nc_oc=Adr9VQu0w_jyEPVSakpQrqSXgAiUbXWLY2PUcqoY5rJeEHVjs-OHjCwFS6FLhKrUElA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAh2B2lmcDumURZ_kO2KYVPYUnCGxmDtXifwHncILhbA&oe=6A4E44F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPR0WnXBlVwQ7kNvwEC4XzE&_nc_oc=Ado1eK7s4cmTNGBxGSOZuS-0znWFIjz-9wt78zPLmWpdtavypPzHudxakjaGFwnKe3Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZc-WWZBA5RSOBNPimyYKVykVI6_NsxfACiOqOBS-I5A&oe=6A4E59A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
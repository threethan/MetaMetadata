_sid=6e7a0a&_nc_ohc=HfecWQlnllQQ7kNvwE-D4ur&_nc_oc=AdqpD6gwwIU1Hkx96f3SKWDXSQrsXfHK0Ryf9g5eNhgKB8Bh3EAeTwYQfKfJ80IRxVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVTJfhZ-wBR6kZXKyyKB__qbOtctJU4rYIesizKnRokA&oe=6AEB2B1F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfYGlCzeAJIQ7kNvwGyQ9PO&_nc_oc=Adrlc7tl-nKN0R07aHEZkCOknUyi7LzSRO-E1X__6dDVZeHKcx2ogjohvSYraCBvar8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQyFHAFxilP1vasoVVJGXD6_XWmcFNUleKEk2gSwYmAA&oe=6AEB3585"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8J33EC1lY34Q7kNvwEni2Uu&_nc_oc=AdrZ9PfaS527QmIXRQIGCMIdTkLGXWlwJZkaJqaHlVLihav7i1Cre4WDqUDTqNBUj-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2gI_wOIEcIYOuYcPIE_s6WoB0vECJNMTVniDKT5vAYw&oe=6AEB35FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaMoEZnLSZYQ7kNvwFIgloV&_nc_oc=AdrkAA5ATau3gPzPoJrb6ONHza84FFFCD3CApATikS89ljrSbEakx8sGOynituzxQ78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrvGWyUDQpsNBSMGli34SjOt-9UaW_DKA--7MSQ5lAow&oe=6AEB5FB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZhISU_cG84Q7kNvwFJUHTv&_nc_oc=Adqt16ZRHz9hlZ2X2wWel2tY6OCT55Mi2iGw_mBro8Ek9s1V2PO-qIAs-Zyz0XgRqRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd806N1Ztu7vA6JdQeLBmCEelPJl1F3FhVcgqEEgWnZA&oe=6AEB3C26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4mmf72RbewQ7kNvwF77KbW&_nc_oc=Adpm6a-3M6U3g8nWV8469WFfLVp7XmyP0SPMjz6KgbcNSjNN91p0WgKUPelsPqMEi3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X_jO72byzT_BRcLPgVS5ywhZWZUmbh5pMlhvuDGu_Gw&oe=6A31479F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbRFL6JIF8QQ7kNvwG7Jb_V&_nc_oc=AdocK_xGJJjdwqbAzd4qvl3IVaFFDpz7wf5UfDtIBAvMOqgW7gh0lectO5AJFRRuJfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e5oKCWn0UBJHHVrV9rxXVOCr3l-_C6hmkbT7Bq82lwg&oe=6A315205"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5v9ZtvZpN4Q7kNvwFvYXS7&_nc_oc=AdrVYA-DT6p-1424E9AFKX5RRKmp4AtWgeTwFEvJFyjW-4Wc7mi9etXRlKnLFdcGQIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rZVImtD2yW65lgMwBj-7M2E0x5nNlK7LxKidu4-seuw&oe=6A31527D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7vaEvUA_VYQ7kNvwGlhTwK&_nc_oc=AdqQqe3byLPdEKmewdH3MYaT-u98S74FLzGkIFS5oBAgvEkDofXQQnjJUB76aTOFxEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-EVMrC0wtdztXOxWj301GshJD9XsBQShkKTajf-KtMg&oe=6A3143F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxhCnhzHQl0Q7kNvwGcbu63&_nc_oc=AdpNU2lqCBs83a0zJjzuOTLCtL_m5h9TQ4uKY_d17xD55lRVZWN4v7wzZhbQtRe1Uzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3IBtViOFH1gvkYTPo1-YnuyF2JfpDhROmDPV51-AqEg&oe=6A3158A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
_sid=6e7a0a&_nc_ohc=bdEfegXaq3gQ7kNvwF5XwDx&_nc_oc=AdqBovM4g_j-V9cb74IFdOs7gxPXaCcD3CeYxz6nWY6Ye_4jguSMGACPnmGwa1vS9j0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCYec0dYQNpuqtMgmmRDOb79NrqlrKIzzutv-uHPq9Sg&oe=6AF5EF5F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuUTsB6UZBUQ7kNvwGTOOVc&_nc_oc=AdqK5BhyUnZywtFgRUFDskOwk3IbtYBsR2wsL0MUKq6pgpiWc5E0E8WnLAlHdxfCKIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRof-_EbsmpPPBh-ZeFbtvGgVp691M4DFpf1P4Ni-MC7g&oe=6AF5C185"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EabVqA10uVMQ7kNvwEbeQ9O&_nc_oc=AdpRaBsHMUkdvLW272tPHdXGWtS3knU8ESAqYCfKIxZ8HbgXKo9P8Jpkc7ZK1pIBmc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhvqsdfrWUP62YINlTP_HiQn_sTULkF6vPZuZ_Q3540A&oe=6AF5C1FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UWBZvKuwHAQ7kNvwEmL5Ja&_nc_oc=AdqOa56XdCXRa75pJL9t8SZNYvGu_ynMb3UmZkA-IhkwQRvcDbZZdxV3bQgNsWcLK4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqpSpO6qk_bCtCllzXnDJMpIFv8FAHuAIZidlnAb9cXQ&oe=6AF5EBB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDhLavgP1ksQ7kNvwGmYgIU&_nc_oc=AdqK8xGxjzeyP7adDypDJDM4WgUM3IVTNTr6AotDlTk5itfw9rAVD8LR-gZaszM0yfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStKOFsJV_WlL_lY93vzTchTfcFnbcoZx6qrH-2oQFT6A&oe=6AF5C826"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
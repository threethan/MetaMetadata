5400828", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTsEkOSxDokQ7kNvwGtVuCL&_nc_oc=AdrnRTH9ftDZwNGGUWCWJgaW-vRXbDNCxvAlVT0slScSlniLe9YKo4Fs6N7SJDhaxXY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6AUVjVy_2XkPHUHBwCMM-K44TFBrPmlJqQyP_oraMyQ&oe=6A81B31F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TR7Gtg0SUgQ7kNvwFFFPqR&_nc_oc=AdpQi-F6VJ06QWAzoaCYTlJj7pukfaOMxrn0XMnC6DMO-itjPgfOFJqyn5dw4VZiJSQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9y1bWtSTCbHb-APW6wwXmaFuKE4dF8xdxEbcQcQkKBQ&oe=6A81BD85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHunhGIUlQ4Q7kNvwHNo9iK&_nc_oc=AdqyjTUhenJecHCutMe1_asDYuIprnkSm8f4PrgmYKSDmtMehJ6m-ELMh_hd5XMrSn0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe3bBlmlD92D5FOTXh2Xe-sgvmebrFpAwmnzWpoHDp_A&oe=6A81BDFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcY65qaa0yAQ7kNvwGbAZVN&_nc_oc=Adp4kZUsiu3BsjtGFAoGLeSBPl-wabyrKLfB1fW7Vp-pvSAIg2AKXZ5XfLLcjwOCjvk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu1b-1lJW80wEioD_pv1A5n50zKbB4XyU8IvvdaDrWrQ&oe=6A81AF74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vob7S36YNHsQ7kNvwF2pCtF&_nc_oc=AdrNntR_8a_Mh6-7VN9JQj71xdb82v3cKYc_i9VUGlYNg2FNzWp6odJbhfcJm36ArTI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHork-81sxC-YcOPsJfJzp6ypbc9kJcCK-b6HX7RzzPrw&oe=6A81C426"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
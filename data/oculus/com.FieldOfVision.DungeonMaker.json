_sid=6e7a0a&_nc_ohc=SYDUYYIYQbgQ7kNvwGMElMW&_nc_oc=AdqfG_fB04UyaKDdJObBOcPoIiaXU6_cbIdly45OJmHilMU6y73P3MupkcOXCmwuaLw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjd3H-HhhuFtMYstbBCdxWvpWaRPTKSQWwWN3P_fNIWg&oe=6AF9E3DF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7wLG7Q3gcQ7kNvwE8GNDh&_nc_oc=AdoGvOWXnm6-L2-vJruGE7tOYbN4kGVFQmMFhwefLXOsyuni-oKoqg3Yqm5LQYIBSoA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU0fISFtQPxPsfHgtuKJ-ZhZdYjsHEUtMfDzgydhEH6A&oe=6AF9B605"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGEz1wBDltUQ7kNvwFGUkno&_nc_oc=AdoJ46TLVFvlSZdtcVdUKmicEtPtTQp23AqMNRbhw2PqFjxlAj4VBWqs8sGwa2cXrJM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9jzvFs8aP3ADY8uq_Nc8whLpYXj34g9a5gJlU4SV0Iw&oe=6AF9B67D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFDvxL7B_4UQ7kNvwF9BGCY&_nc_oc=AdrwHRgcuEoMeWp1poKd-Tkd5MLfFhIP58rPAjO9VEImmGt68J8OAEssIFU3LOhRFyQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUzqFyPIHxOrVueryRGR_pPQat1BRLuv8E3SfHqs9STQ&oe=6AF9E034"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9nVvxZEVcEQ7kNvwHX6biV&_nc_oc=AdqMyepP1u3FULSn1WHNHA0HYA4rYYJURPBXZsudo5OBVP_9dVJZBWkU22zr5hHsRmk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQta98lFj01s6A1UJ1XRSbdiRM-24QQ2Tyr7_OiNslsCg&oe=6AF9BCA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXbyjVFiFcIQ7kNvwGujCh5&_nc_oc=AdrPjBcvRPR_7zR-MBi6xD15C4Z0vNOPK5DnVSPjslCKjm8bRs2m86rPu65BNc4OZms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3UgfPIOjWk63mIcwR_8Xz2Hew3QP5V5NzrOlIAz979g&oe=6A2EA49F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49Sfe-JBn7gQ7kNvwEAZhpb&_nc_oc=Ado0Lzi5jpp87zVWQqTTsyDsdZq7YxUGkrqE8jFP8SNIOcat7Jz_V3uYgJajD_vJdjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Lpjxpm2PFATd8hS5t9LVJoPu2NcWsraleTQasjfb_pg&oe=6A2EAF05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5v9ZtvZpN4Q7kNvwEL-dfp&_nc_oc=Adpcs5Mrx9TyAF919U5QHmcD-fOUEdAKq6NuwQ0Bk5Z61YeF31jq_6rmQRBgk-VmTG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O5Lgb5U4r-M6MLwUy2MuzYJEsBgClj3NJhYvpB6FEXA&oe=6A2EAF7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7vaEvUA_VYQ7kNvwHDuCnO&_nc_oc=Adqrljek0q36MQ_SQMv3WIW0myV6K-cR7KNxwqmmWo1wP2T8BUaSQTJ0Rmw6shK-BCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MtIolWSOIljPnYq-5cGl40M-RBHvxQP0462rEQN0avg&oe=6A2EA0F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxhCnhzHQl0Q7kNvwHi1aMH&_nc_oc=AdoDe0KqMvpBQNsoRySJrWr8JGP92aZYuMTH38l00Jv5v8dUkQCnqMTE757811obekw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Oyja8rvQ0mFWaBnQVrEpKpyZfbywWQeoIwDEYLpcXXQ&oe=6A2EB5A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBkI9AGP8coQ7kNvwFD_mek&_nc_oc=AdoJsQOcxxS865C6BF7g_CmLau4PklKltFpkMrEmc58cqG9p8HjmIp3zL-ujvQ45xp4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vPj8CB8usB_yyHXWKSvHJJMeFi77GbgB77xsetOBoVg&oe=6A41199F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoCBITp_Xk0Q7kNvwGkTqO1&_nc_oc=Adoq0Y7Wz9IWxbT3q3zfRM66_t1vp6DCgFEtbp-hUvApu2GXhM6ImPoj-xR8iGZIt1o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GWMq7hkE-3pHAhr5rpppN1Ey6M_Ko2v6mymXdtM_nSw&oe=6A412405"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpfQ8AiM_N0Q7kNvwHs71l0&_nc_oc=AdqETwAwHEoKhrfMd7UGyBbbPdY6cIkP6ozTsQB9gyaRaqMqX5nkvs6YpNKMZoG9Yik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99E9act21czu-ByfoaEKOjHKr8Ht5ctFMZVgLoLQDdnA&oe=6A41247D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHIPo2lkgT0Q7kNvwHuARdD&_nc_oc=AdoRwN1jzRuzSx0j_x-LUU_czkCoR-QQENeY6y96b_RSqhDMkGDlLJQdiJHaPnor9-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TLkZDpOsgG_b0hG9Y5aFlcc2m8vm3j2hM-rRMY9jfnA&oe=6A4115F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEP3LYspwL8Q7kNvwFearWV&_nc_oc=AdoKdJcH6YoiI_5OoUSO0q0-OhnzFgd2Cu1d9LbAdi4hfEZDB02Ch3ch0ihVkp1SOiE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UXYA3GedEro6kLqwL5EvDxdFdoeaU5jWtV9TIIshPfg&oe=6A412AA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy3HbJK0_28Q7kNvwHk_JEB&_nc_oc=AdrX7XqWtkEzIxaRvMSX-JQpjGmnC4JBFwLkFzJ-WudQBEKtiaO791aZllANxCkzco4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EEvxumLuQl23tYZq4EOQXQhEH0U4C3hjOXvuz_aQttA&oe=6A295E9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftjzJgQT94sQ7kNvwEKDqIi&_nc_oc=Adrnc1H72f06AoH_Ynmxds7DHM9rfoNvKvtmzBSAR1qUm9B4qvyQ7-eqheLBp_zFRh0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zoZDZCnPQ8B1Ktqoawr2RZntsKfoIKcVOtF99Pao6dQ&oe=6A296905"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXOyxgHVewkQ7kNvwEYj6JB&_nc_oc=Ado9fN-NT8dlqLSbJIUQo9uIrBWCvAm4ullMflmxtif1WtIDCWxEKdxZ7cAh33xixSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_daZ_uYVx4ChcSmkEtq8aFF2RZsT8HUicauoB1Wef6Vg&oe=6A29697D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1u9MVjkXgsQ7kNvwHlHmh4&_nc_oc=Ado2_aq7l5Hz4Eq-6O-p0C1KBESBg_vHoXy_-FXK0W4tXg5YOoTie1K-m81CNSV9iI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zo7Zmz2VwkQt1ei5BCJyBrCSF_z5MmKpLktMC9OdFeg&oe=6A295AF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AcbwtNDemUQ7kNvwE_4Vbf&_nc_oc=Adqb4XcaG328Et_EnYqNsGWbliOQmv43SVlFnWLuSZIWxr6Py4gbU2kVy5gEacrceKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U2OVq-rpwElatFTnF63KOWzr7FtPCybAxAy8st3jnZg&oe=6A296FA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
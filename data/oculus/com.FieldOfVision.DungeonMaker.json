at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY34N2cSQooQ7kNvwEkHnB2&_nc_oc=AdqNs1mZDoHlDLhJIogIPP21VeQTaRZQjuMHltsnHVEt8l057B4Qc4V4aJIbDgQqGSs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45qto0bymjrk4_zz1KlDGmssY3bAYuPbaKqoi8ve3IZQ&oe=6A0B0C1F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUUg3zj9fekQ7kNvwHMADDk&_nc_oc=AdpcWGnCrNS5kkXia3Em6hix99B2ysZc1le6Q9YmJpDRuy7qiMbez8iZt--pIEdvfqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pkNIgt1a46wFUZNzWo9nlJBF5HVOqL4UNsCEwZlMgyg&oe=6A0B1685"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E9tthYbjhkQ7kNvwEJTbcS&_nc_oc=AdpmPFr059ZmsGRgLb3DISxJD3kfEJzLXnkX9NXUWJLuJQzYGg0GrACvVKke6R5sRSs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uv_DMmJnxLD38oFAySrZviswS3i_fym98ho62B0UTDw&oe=6A0B16FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGWKroo3UAMQ7kNvwHaPDxe&_nc_oc=AdqOzjmJJK1qrd8ps5KIgmQi3DdkOtulhN8w4TdMgleXcberBdgtpuO0j1VFc4isTEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67mbLqAYSaZYkRwkdMGkyFgQYyp7sD4RMl_Nq9oq6lFg&oe=6A0B0874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdThAN5T7uIQ7kNvwGRPZ9G&_nc_oc=AdrlFyu-7zFwCghx9zIb8z1XA8x_dbot7wzHVHVN5rWc-O-uQCjE0xdcuVO-mz8iQR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yVzc7yPwK1ZeJfrFREJLJiCHFLw0Zuwep14YxY0AJpQ&oe=6A0B1D26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
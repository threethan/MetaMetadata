5400828", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_pE4xHEBKwQ7kNvwEWs2tK&_nc_oc=AdqhYAVqBThpMumiBb12ow2k7kUSeksCsO6M0TLecjVkBsXA5Cv41TcXfsFpwN1SrhA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBpg-LCXKFgipffP4K_dLH-uNedNL0s0zfUnRQaWvDaw&oe=6A90339F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osd0defHrnwQ7kNvwFC7CwD&_nc_oc=AdpZ7PQaYQCsfXcYtgdIXnS_5Q2Wo9cPl-HWwz0a0pP9r69KGyHSyhiGdVW_pyknQS0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtgelvNQ2ZPX8LIYss32WNFlxKmeyBqMh46vL_PJQbEw&oe=6A903E05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VO8MgAM0mXMQ7kNvwF0XTIm&_nc_oc=AdrG0Y1GTr2EhrpAL6tbwheBsMddjvE4zQTGfK8XBXBkRRDjwY7XgUzcI5lRYnGSTjA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUo0a9vg9Z6YERGZzd1blkLwWrUUATmDOZH7NaKHwx5g&oe=6A903E7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfABDzLMBtAQ7kNvwGgsmq1&_nc_oc=AdolE_p2TMCLp4OUYBA78aau_ISKUMCuX7l1XWxacIai6UYlolU9yv1SYWHMSAP0i_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbmaGfdhRHXk7lPrfINcm9AFGRsIUQI8ceV32W5tEdGg&oe=6A902FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU0xLib4oKcQ7kNvwEfyOeu&_nc_oc=AdrcyZhuUE3Ti0yRL0R5g5o04VW1kq7BWpA72bgly0KfQTS3lwVfYWFJ-SsQ20ae97E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXD8C4f1wHrHUmnYyW5HkRc4DnkoKgH2hIvmB9TYSDfQ&oe=6A900C66"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJIwYqGIPgEQ7kNvwGPI8lr&_nc_oc=AdrYWox5LEpymRDzRdYbyDgdfvgmrLUjMNMxlHNyuuqqgBunLm-O7hnaZOurK1vMAn0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_6sB6c--iger-IgoMJ3c5YDueB04_4CHDgOxOFOWnDg&oe=6A3D5D5F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYADFBxsaAEQ7kNvwEXEA2f&_nc_oc=AdqcvqoVE91FnKlT1XT_I5XIZbUjc_IRbL6Z9Wx6-cZzA1rrfZFokzZU7k_NQlyDAWA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UtV3xJoeT7gDERKgAD6-9C46y7GFy3Regns1Naht0Uw&oe=6A3D2F85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xH6NHH3KXoQ7kNvwE6PgNi&_nc_oc=AdqtBKj_hR8mdaXEnsvQNSFu187iqLFDnYwqKeyOXoO-5_5r2D2emTgF2Fjl2gGoYwE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x3Hg-dnva8bxWekrGgdig2WcvFZkmT09atCYPDI80lw&oe=6A3D2FFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTp8QVQBLpYQ7kNvwEAKMuf&_nc_oc=AdogIyFIZQ-U6p5j5kl2jNPS81e-oB80ST1cQlgTXDd_emJjFvAwMjiEq_oVPBSEJnM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-whhDY1dViikQgHTWw-yh7L1rsrcdPHq6fpvmAYL8XBQ&oe=6A3D59B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzPUjgkqRrUQ7kNvwF_JLO8&_nc_oc=Ado_VjzZsAbQ2RhdIPd3aTEMPMWtJ6CLh8vi0XW5YE3XdqxFbgY4a_Hvsve1fAG9NVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1PwI9hfzzSVTrvdGawd8Wzfjujm8bYwsHPS4pkFgl0w&oe=6A3D3626"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
5400828", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_hUo2OHYH0Q7kNvwHgy2bQ&_nc_oc=AdrtbCkiC9GklJqsbI5ZgHFlFI5-wmlC7zLKfbUzq0rwReWek9iK3U3Xigjj1trokzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1i9HBtjxgXF7rGyNa2jJBesgp8gdc2dhksW4pRyojNA&oe=6AA2A89F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Odt5clCkERsQ7kNvwFKmk3_&_nc_oc=AdrTjtlx0AiIos4HD9-BkiY5PZdOajx-R-0qWmo1K3nHBSXDr0z9_rzRvMjHFsM3oP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlq8Fupr0sUFt_hHlQL2om7-S7yF6mfAUkt3MfN9OJoQ&oe=6AA2B305"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByZrnNG9_9oQ7kNvwEN-EzO&_nc_oc=AdpMGAI1FrMC7gBDErVLnlRI0kuB-blznA60LsHPUdKm2wAt3xJEa0-UK1XQeNuQD6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEInzZ-l-3vuZpgIzXeLQxwVYy9gB8coInVYXPqLzKGQ&oe=6AA2B37D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL6q2n_Ju4EQ7kNvwFFdOUU&_nc_oc=Ado9FTlLOzbnvi2g-uVclT55FjlhWD1pIHFl_0s2vVzuY4Rlgz5f_j6N7mz9N4uw7t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJenkEQxRFQU9q4DC_sp3vbblWPCVABUxzcuOTJQUBXEA&oe=6AA2A4F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_MjFpY2saoQ7kNvwELMZxt&_nc_oc=AdqomsoEwh4cBG9E_s2lO2ivBDO9KuE-UaRPx1VkOgRpSOsxJTTDV8JsqQYgeEBNTms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIClDIP_txh9as_jTe67CZANdI9LK9Bw7l8GrPOVqXhRQ&oe=6AA2B9A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJIwYqGIPgEQ7kNvwGfD0zd&_nc_oc=Adph0I4sV4DRvoJF3XfKXxnq-vNchXCH06lv5oCfbjq3H7VUoXFYh26EOiLs9tt4WtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d8NUzbLyptR1dNJEPRoUDjSuy5NqqzXgsIlNDkifM9Q&oe=6A3EAEDF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYADFBxsaAEQ7kNvwFuK1qY&_nc_oc=AdqK4otN-er9dmzq_J0XBvR7tto7Bw-DvoLp3vVjg6EWQ607QG-r2VwjlIIYmZrxS30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nY-8RS7rwnNNTPIK4IpXpTYodH5gP6018OnL3xG5MAg&oe=6A3E8105"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpfQ8AiM_N0Q7kNvwG11FnA&_nc_oc=AdqcuS_JTYOBpT-Lrfi3ViZoctd5AVTV1TzBYnzbVSk5haLAIeQS3H1Y69ebfkYZPak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LdZIlZ051iiYkAH3yNGUb8DxN_J5zETJyDRAvOr80SA&oe=6A3E817D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHIPo2lkgT0Q7kNvwE9L2TD&_nc_oc=Adq-cm9dswUKyyKCxF7VcQUVS8tc3z7rgp4x81Uh1HBVogFvfRuNnba41GHU1TMItgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jC1B08cwg1T2w4neTVOx1x2pPXXYbXkOy5ka4SE57nw&oe=6A3EAB34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEP3LYspwL8Q7kNvwGm-zHZ&_nc_oc=AdoMYOJ1DwGWt7veNN4EBsGA_kI4XIh1QpJPS6mP3lQ0XVj6eqoXuI77gYmDBJNZnek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XPZvV8dly8HXGHE5Gci12TaOUoSK5I9dBBe95WhjjAw&oe=6A3E87A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
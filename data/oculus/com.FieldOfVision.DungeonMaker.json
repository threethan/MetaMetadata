802085469376014"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "482044523410394"}]}, "change_log": "HOTFIX 0.40.3\n\nThanks for those reported the issue with starting the dungeon. It was related to saving, permissions and a bunch of other weird things.\n\nTo clarify, saving IS required when you start a dungeon. So if you haven't saved already, it'll auto save to a new slot before you start playing. This is because if you end up using a portal or the lift, I need a save of you dungeon so you can portal back to it. Otherwise you'll be stuck in another dimension... forever!", "created_date": 1768880434, "id": "26271548599096373", "version": "0.40.3", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5379303768747494", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26802085469376014"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "482044523410394"}]}, "change_log": null, "created_date": 1767054896, "id": "26095587626692472", "version": "0.40.2", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5379303768747494", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26802085469376014"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE"
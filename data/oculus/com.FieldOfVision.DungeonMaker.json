_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQqcFpvQCb8Q7kNvwEMHPxG&_nc_oc=Adquww-muj0gGYf42EmWTsvm00WhB8lu8bNTj-gDRDVoE8_CGJiXD9zW95FIFIiQe4E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c3kNsbuKlbxOlWfboXxjf-rBBUdXqRWgkEdRBO6KqUQ&oe=6A11A39F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW8F-vMllxMQ7kNvwEnY-B3&_nc_oc=AdopCBsfbZYxvgYuWygcTutCsr87yKP18QFTTxsHtsq0Wq4ffkzhcbdN78OPTzfrZ-0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yp9Mdi8X8goXxtoJH8XvUqJgVakeIFFqS3IiTUuMzBg&oe=6A11AE05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_T77vpJZZ4Q7kNvwHYVtik&_nc_oc=Adrq53HF9rfhWJ1c21S21ruNhKImq3J5aDZfpENqhZbDngOCgZzdeQpcaqAAI8c6Pek&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UNheUTmlp-sgXi3FLVb0wdDZkwiilWh14pXTP_FU3yQ&oe=6A11AE7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOeCcOLR3vwQ7kNvwEgDuR-&_nc_oc=AdrBrD-l_Zl2bDersGYpXHd4G0_fCwlWjb-TtcHSdcGD9toXTTar4yy2gFf0Dnn718o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lHDIxFLn5T1xI_kqDXuitJWLG6dbPk3PlaxI62SSHgA&oe=6A119FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUsov_EovZgQ7kNvwEnaitC&_nc_oc=AdpMbvTCuOIJDdOHFyyEcRqmT11har8b4tkCDsMjN3RRHozJTFjTbz_BFgPvDeDYjU8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CJJdYvkGqpnxI15x3gyi0COQlTI9M1yZ9PxZslolpbA&oe=6A11B4A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "17259965
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJIwYqGIPgEQ7kNvwHWbpMx&_nc_oc=AdoP-puexVhlED4-w_CY9s9-5h0rh_6ZSKtzJTWIOOTjmKxaCrcejT1KiOEI56Tk5gY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V4ACtV_D5316JRtOxzI8npCeRa1A9ZtDmjz4xnzfolA&oe=6A3BD39F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXUKt6wELJwQ7kNvwGJAOiI&_nc_oc=Adp1pKF_g5qbnb1krS8GnUPd-tfDud73GRZxR9a5hv3ubar7iFrXQneoFV1qCD6nvdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PmLbyCdxNVWhKLTNV7Vd98dhEuZSE2QJsqaPrlNGAog&oe=6A3BDE05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xH6NHH3KXoQ7kNvwHmW1et&_nc_oc=AdpLf0rw3D9A9xLfWUu5MOUXB8Nxg-6vPAYmFoHNUh5dX1yV3zvSmoceiegfoctwXRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y4L_s8RWGfjx6hKS8b2rphVPKLrH6axFDEPdAMgNqnA&oe=6A3BDE7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTp8QVQBLpYQ7kNvwE9lFmZ&_nc_oc=AdrC1sn_z98eWSo83E32Nya8Ca-W0x0P9NLCtxf7MRnsz2fFuGEHpNOsYpbN4hfvyuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A3fQiqXc-BkppUk8tt2o9cufhIsrchdlr-3h7jIcZWw&oe=6A3BCFF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzPUjgkqRrUQ7kNvwFHqsn-&_nc_oc=Adqrt5Qs4PZo_LwIgqqSbHbggeHZbX-b9RMPc8rFfjbJv1nZVQiW6JyGirqYDnkaa9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GcDRxytAzeuK0qRPO5oNIx9IjEAH1SrYNdGxBIzOA3Q&oe=6A3BE4A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
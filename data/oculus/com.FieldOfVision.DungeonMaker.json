_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYBrbOCI-_EQ7kNvwH9Cseq&_nc_oc=Adp3iO7F8zCact2FiyHgmQP1j2QnlIknq39RsvitNoAIYhqe_Itq4QOIGA8YkbfY4uA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nqLH3PibfFPIumSfObFcYLHZBEySVdCB9QM89qtBbzQ&oe=6A36C5DF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6capWCDvz40Q7kNvwH-xgdr&_nc_oc=Adp2Byw8OLLZiO_nXV-s_GGJ9vHUWJLdb3ak9lqDI7HshgqRqRDnEadLVztgoZGYalg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VQT7A5RmgTG7L8IT-PCm8-PsK0IFC8iIDSjLEZrZLrQ&oe=6A369805"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT5UdpnAZQ0Q7kNvwEwQRY5&_nc_oc=Adr30Vq2d875VcXY-moqoLunqrjLdo0q-UnbMFd3ajqOVVfQF-1SXrlQugsBW5WNJyU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cxf4Jv4ZHaItSAZUhkwco2QbnoYAvvNK5BdRa2CVwZA&oe=6A36987D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iOX2lsui_wQ7kNvwG9ydnv&_nc_oc=AdqjOm86bOsDLHGCWEcPt-Vf3whgZQvXnRX-U95myyz_0e8zNnnXaOk9nHyF3cEB6dQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D1-CW5iCsuH8SZ3QdbRqfIIJjzVJlp_gu6ulgxgFiSg&oe=6A36C234"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ednWKbKeKGEQ7kNvwHWOcGc&_nc_oc=AdqFsPClrQuPVA9DlLkNxg2r7GzMrii8_c9W7_2_J3GFIQc-bYo204Y3Vk0gj3f9-1s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WItqCw9-YNPzSf9xrmdmrsJlavNO9hbLPKh9qoaS9Kg&oe=6A369EA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "17259965
50585400828", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wLSDcTdnN0Q7kNvwH5ofMu&_nc_oc=AdrSW8X-E7wSQbCFNBPR0lUBor43pqzTJuE6BYHiH6zFC34PBwy3TeJPRaE8BXouOII&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwapKnAP-c-kZZFltnqrEbZ1_8ZMR-Yrwyo6N_-LlsBw&oe=6AA9401F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-VknZARYOoQ7kNvwEhDGGf&_nc_oc=AdpLvUjQSgcwezCCdNIIB4wADMWLRlMImuM44SFsDGCi6UN1zaNRkve93oTZeVZeBUc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjyWYvvoQ3kBKzBOYldgz9u2wNnhp_g9u3bAYbewI3vw&oe=6AA94A85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qzafHe8r_IQ7kNvwEKkVLA&_nc_oc=Adofr-jmWisFyNvLjoLzU4aM7-irgu4CiXClalg1AMe5Uftn_dxFOl4BhnsqUxN8oqo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNK9JmoLl6F5Vk0sjWIEYmUB8RDe2xcQbXg4bfrlRXJQ&oe=6AA94AFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E78o7rhd74Q7kNvwH_3dSY&_nc_oc=AdoCKcjoCkpUE7S9W43JpWUdBSVdDZXGxZ7eJgt8bomjVkydPkCwJ_gJpdFVaRYpL14&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC58gK5Z_wk2XzwizPCDwRqHFshUpGWA92tE_-SGDhwg&oe=6AA93C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JHoYa2ad6sQ7kNvwFApn3A&_nc_oc=AdoAe097w_A7AboM6BrDwcIeHMm4ZbZu6w46s-FY3AvZ1dy-akHQ9ZyjUzGJKU2mam4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg3NtWS2CUSrFS2VqkfbEr7kh5p9dRzOVjCBqJC-6pnQ&oe=6AA95126"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
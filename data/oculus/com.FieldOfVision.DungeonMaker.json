_sid=6e7a0a&_nc_ohc=RDS9JLV-qb8Q7kNvwHwFePV&_nc_oc=AdqJ-BJg3lsqov94Gn5kMHO-83X8ueOoEYYjwtf9OtxJXIhr0PQ3213XuP7SP23aOeE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTvDtTf4kT_V8x3KqJPBm8Pg7SD5J22SMnT_vbSaRyfA&oe=6AF34C5F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuUTsB6UZBUQ7kNvwEHK_ki&_nc_oc=Ado5rN2bx61kIrTSkhjIfqeN4Uipzcf2bf8IBkXxzsI-VdBUVDz8lgSNjFDaeRUH_L4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1JGbFQmiPCeJkL4iZU9woaxsdlumZb6WrbbwnUFavPw&oe=6AF356C5"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMfsc3ahtrIQ7kNvwG6Y3s2&_nc_oc=Adpt9HWqmFGiDGGnAqHNZ-CpsG0ZrNGTRSikJlmX844ZLK9JUqWE7mTHQo3FwknHIS0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW2fJUK9QN_9Z7LPhZ2XGsLgIWeFMFI_8NTQJHDNYwBQ&oe=6AF3573D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5S-LV4B0ZYQ7kNvwF5n6a5&_nc_oc=AdpxUONmEmvEi4FyjRgz0sVYZU0RBBgQ7yZWFbfltEkHNqVDBlg1Y3H5cYj_EtNr39w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY8M2td9_yW6MzBGKzQJkwLspLr6oYC3tefdvkBQT65Q&oe=6AF348B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR940PryUeIQ7kNvwFh5y4B&_nc_oc=AdpNiZWr9XNZhyUe86lcYlQlVsjFltAo3MEyiubwInvpRq8tYvXPrFzamWemPbbL3RU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGY_EHGWVqXlM0PAlsYXRQzln7P-UTb70WEgF729iCKA&oe=6AF32526"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
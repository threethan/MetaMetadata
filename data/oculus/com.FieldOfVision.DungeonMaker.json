at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i1dWBmeWUoQ7kNvwEvzMXe&_nc_oc=AdrkcsoayR-RZM0Fq8Zg-DwGTbbjHb8tj6n-chgBjsJ42JoxE-Qm0msa5X8tum_coDQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jFH8GJT1fFQz4Ru33hZ2MtBspTd4EZ1SDOtNh9I914g&oe=69E6221F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XUFPNcPPyoQ7kNvwGiDkLH&_nc_oc=Adpl_PIObltrF8WxxZSSMV1bEI3olznfBUKr00zbt6cyucjqETsTOUdpujAjumXjM5M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lzHcsJ4_Q1yjFM0PfxTvS0R_GUidn84JNvwWl7FWVaQ&oe=69E62C85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BheTlh6EiY0Q7kNvwGN8YN8&_nc_oc=AdpaDeZdUp10zNDfVr5X4CLWbXjA85294M0BHDiIr0tedTwsuuTBBCyjV3AkA2vWDd8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ihg0FYWDNEr6v9KemW5jLY8BQnCwrutxQvndZh5CUVA&oe=69E62CFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KERFJKs2ZwEQ7kNvwEE_sZc&_nc_oc=Adq-mGToD-S2XqebRLPtcO3qZG3bOQYuHDd__bKdAVfW04dKaCZfPcJI6r1dcbe68lQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13DBD797PcAH_-tQsoVBaoC1AWAupkJK5zYRsNqk6hVg&oe=69E61E74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xafX0JYXDyQQ7kNvwGp9RGQ&_nc_oc=AdpIQvmBfHJiJiubRerQOzDTYZTVMb1PoyBH11Nh8vxYLqyAw533zEgcwLXk1so211Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wT0MoDB5nlUBUSJxhUVtQehCYvaH1ZyxU8RK3Kovnxw&oe=69E63326"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
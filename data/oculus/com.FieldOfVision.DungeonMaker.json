50585400828", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PGC1fAitwYQ7kNvwESxGt7&_nc_oc=AdpHPpNeYo-fOoj1D08lXHGqdL50zgg7_NDwhxwMVicZK6sj7ne674vPOWDLf1ed07I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP82tm49Rs7jOdRlC_PwLV108VrnqvJJAvSL1JuFs3rg&oe=6AAE861F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJLBt9cd90MQ7kNvwHqbTg5&_nc_oc=AdqcuDEliLewR-MHbxEFNx8ZkGAO0cMvAZe7-gobdOSTC3aG2dhMfy5Y2ZHBFGIkZro&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNyPEAqYHQD84zdCxxbC7cijQZL_grIgyQGuRaYbYkhg&oe=6AAE9085"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yorR36DY_YEQ7kNvwH-mJXE&_nc_oc=AdqkhHcjx7E3yCuitksT2ibFWkURQO2p-jiqEFRDqUwDfEMkbYRmKeio3cM6eFiiJuE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcaf_3Cq-8VPMWCyhMbtWwYFXPTjxCUvW4_-3vSHh6WA&oe=6AAE90FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4sy04B0p_AQ7kNvwE2JgGu&_nc_oc=AdrXBULoZKbKO8FIiDIF_4KDJUWIIyvClgI8wQRJMr0sqH_qirHke-lU26DDg4uFsZ8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc_YT7vew-Js8E4V3Es28PJVIniW--VnnPOGK2cMuL6A&oe=6AAE8274"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3od5Y9aVcW0Q7kNvwFlZkyR&_nc_oc=AdraJLCgzTpZKyOUPnu1w7zQs24N9I0qwfcvveOAQ4HW0xHn2QmuItaekNnMDR1LFnw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm3H26Y1LOK6wYR54cdNpqkpBNE7ecMqiRPANWolFLcg&oe=6AAE9726"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
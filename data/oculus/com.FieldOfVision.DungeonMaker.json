at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXbyjVFiFcIQ7kNvwELFUx0&_nc_oc=AdoPXx1HdujaRzvpNpHlBn2s8XHWo5JHtCWxy7Y3T8aUkAnk1og-IulD5kg06hBq1D8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w--Koln1B8hihFYeKqCcaY-gJAHzqSfMACLDrXOQ9SQ&oe=6A2D531F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49Sfe-JBn7gQ7kNvwGiHWjf&_nc_oc=Adr_7GmYESuIKmu6rP7HSIqlEL8GMOC589NlGPH21au1lma1z-Q891cKyCAViCZoDhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D8uwyUQdRRxMqkFKzb7-ysV1BjgAY2lYHW7IWEq7jFQ&oe=6A2D5D85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixSsTpZasAoQ7kNvwEUDvri&_nc_oc=AdqXo6fRtHYS3hZlBsuKOHQxH_Rah02rY4qim1Gr3fN1wehk_6ovDKnIIIM9h3wdLz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cKQk6C8tFwiioRFTPFp1psNDChwuH45acUdanK1ToIg&oe=6A2D5DFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGatGWuFXa0Q7kNvwFOTYZ5&_nc_oc=AdqKcEalYUcioJzFtPrpgOmODFmFUZ5Cf0NaaYc_gAr_IgRaZecp2ufKEmZ0bgv0nxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w__TsSL81-ge-uiG3xgI3i0n1p0EdHzIjtmI9tEToLQ&oe=6A2D4F74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jwmxTnLKuIQ7kNvwGmS8ud&_nc_oc=Adqexw_2PpeqoqsVPLNbVohMCwDhlAAJCd5uxhk_EgyNoCuI9-1SG0NIYks-1_yzYpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bq4AFJOgVAlGu78aYggEZ1tRcB-eLJbgsa9PSyrR-ug&oe=6A2D6426"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
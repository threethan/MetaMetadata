5400828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVNCRTPUdLAQ7kNvwG-nP50&_nc_oc=AdoE5lhjORlCP3-vtjij3UPwCt9Qnh3X99RPZ8-lF83rG1tmrF3r8_zu3qjkBDqvd84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfPbwS3FmlIyBa1tl5fFqcsGOnNXYEwIVzVbCKWRH6ug&oe=6AB27A9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWtZZds8DwYQ7kNvwFIMfdm&_nc_oc=AdqQ-i1OPCpNz5s5U1aL9wIWy1XRWhnrc9Oc3gT6rzeuyIuQ-GH-zM_nu2vYtLWGdhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsHTxE0_2coy7ZEKctIYr73jZ3acqLua_9GtKqgkW5Dw&oe=6AB28505"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlBlfDD09DwQ7kNvwExIiAe&_nc_oc=Adrsxb12tT71TkRXzBiYXwWlKJsM7mNtt2BgcljfLiOPexikhruymyljrAgp_CfJLFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoUxjMfyShReMr3iAyKbOMI-sK-sKsMQ-iGyCqKvCVwQ&oe=6AB2857D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hbsDf0X3uoQ7kNvwG7vfTr&_nc_oc=AdqMreq6zRqoJ43QHaqaDeLEV8BIVELBQHSiIy1vgPgkS8wRP3yh6Y8mptDwtcCUxxc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuqNEdKvEYOxH6pp6BgqaG8vSxs3D1-BpKk7dTPDIyhw&oe=6AB276F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM5uwJUT9ksQ7kNvwEElqon&_nc_oc=Adq0ov2rzRyP0IWYSTNw0UF2uVj7ECm1Hw72Dj7Efcb5fKQT8mJZBWsM48lBLTLuiTg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPJDvppHG_lGQoBjMl6DDT6gVRNPmormBXp-giQ1Xq8g&oe=6AB28BA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
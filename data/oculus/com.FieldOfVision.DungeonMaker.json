at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzh8Bk935moQ7kNvwED8hzq&_nc_oc=AdpJYumE10u7VEJ8XRTWFY95mYvTrEJwBWL1cs0Wbn3jj34z2yBhTja7dMJogD22zKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-Hg9nH1g_D8K0-4CvezoHjaVCbakA-Oo1D42-EzxiiA&oe=6A1ED29F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPSXd3gBqEEQ7kNvwEdjUvH&_nc_oc=AdrqYB78F-_uIUnYPYG7N2Hx07GMg6FicrC4Pel7Yl_r4FmCqhGI8hotbagDdR8ICu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZalOHWQuo3j5-ZRV6cSfNkyIQ7ciPjgOsGKLoZRxvJQ&oe=6A1EDD05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Tt0aK7ZDeoQ7kNvwGreaEX&_nc_oc=AdqD1VKF73yC-msa7XT5qlOojXwj847Dh4t7nOpC3JaeLM4pgKDwZZFXmx3RhhmLFqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pUHIUEp0CdxWM8sdETKyFQbMVT-OLj2ympt1lvsRUsg&oe=6A1EDD7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwFtriCwHRwQ7kNvwE7toyA&_nc_oc=AdoH47_c9IhtMEQhQUnxpDZO24xGAbT5CiZOn0TE08KMMC6SrQnVyjDcF9Z_e-g9J4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rRQiyzcz8dRfw7JsgsCu2hKE2G66lH7WDdRlZpzyNfA&oe=6A1ECEF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppiWu2X9RkMQ7kNvwFhmLPu&_nc_oc=AdpA9mqMmcXpvRIRJkT4OYs_nYR-HyyoFIbzxCbtAm4r4wiOCQLzsqru2qAgZQBfHB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wIXILZMXS_EKy3wZfR-ZQ-CUQccRGP-tIcdZTUD2CBw&oe=6A1EE3A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
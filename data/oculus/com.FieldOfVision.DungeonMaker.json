at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYBrbOCI-_EQ7kNvwF_VIfa&_nc_oc=AdrbxpCZlpRTcPFY-cOwdVBvkJDpMTTeTf7MkdcgI2CUTauzvNtec_vt-PY0Q8Uemyk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SNx4RLa8eK_IOFZwy8IslmuHMix_O9zng344DBlfmQg&oe=6A33EA9F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbRFL6JIF8QQ7kNvwEhxz58&_nc_oc=AdpRXf8sP0Wt9oikKKdFBpQ1KxidgjNrET-xFZkoY91ewiU-7pr5JvLly6X6pr9QTEM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gaBeamJkZ24SVt76HMy1ZAIb55ercmAiomkKW-NGo_Q&oe=6A33F505"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDzgHUzcp0gQ7kNvwFccK_u&_nc_oc=Adr-3uCH9bbYRzCKx5Ixs3qoC6ZPWJGrHF5-Jc4Bz53MWzGfY7Ad4I31w_BHnBryTuQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g99GCFKM-8sCC4eDSUfYaaL-cY578YQoa71IRtPpD1Q&oe=6A33F57D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUXZ_J24AWAQ7kNvwHfsfHX&_nc_oc=Ado0AQCalebGL98d2vAM0iwSqGuEyz0om-slBXC3pxdPbW4w_JCauExe0b-hHiNOo2Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K4-jxniJ4UD96atIcungkamej37JXWWtOaocwzOpYgg&oe=6A341F34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SylRJFuJ7rQQ7kNvwEXLNpq&_nc_oc=AdowwSyJzHjBz2gKPKin09aKLvYGr7FMmrkBWOt8wUBOBxCmJBhm4A_XoeOnrdC3-i4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GnSn9RQS3CyIY1gwTsbU9rMk3_l3deNZnYmlAC2szOQ&oe=6A33FBA6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
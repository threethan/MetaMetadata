86D3"}, {"file_name": "5.png", "id": "643693446735039", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974672_643693450068372_2765381301779825349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dkXgfjjRFMQ7kNvwGnK9Ls&_nc_oc=Adqz0d4IGsKKdWj9TKNTZLuEg3QuQfcSMIEMh8Qw-I4Y9hqvmSe31YwTxn0t4kMq204&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN3PhRMsZBNBwn2eaIOprgm_jatRZ7iea2gIIQUp_bwA&oe=6AEC9D4E"}, {"file_name": "4.png", "id": "535137037942845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974817_535137041276178_8615470723784735579_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbtJ8iGXDqAQ7kNvwHJwUGI&_nc_oc=Adp6sdzlIO2oBgWazRD1yQyKd0_ZzvsW36cTAtmfosl29ZGOpX322tIgUNEndaT9Gmk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU-2vg_nvixSGUJEuh8oYV3Nu6WfslvlRpysL84Dw13w&oe=6AECBC41"}, {"file_name": "2.png", "id": "378241330781577", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974584_378241334114910_3487644665188837393_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgWaB1wsvHAQ7kNvwFI8uvk&_nc_oc=AdqOPTn5kK18-8zPWu-Z6bMlAwRQko7oKkSvsCr2tt5e0mOWzCpetX5t3noOa1JdQaI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOa6glHF5tE9YnbxuqFf8EYV-VcREpRUjEzyMGgfKEBA&oe=6AEC9A42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "1680606845623142", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974584_1680606848956475_6020773676294071676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDEG0zKnnRMQ7kNvwH1Qvkh&_nc_oc=AdoGQ1-itS3Mi6snZrSIE2tyQFT0IF7F83KNbHUAfCgEvINsD_qCVXywoW0RDQtW4gQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2r5U6unf10GxixmeSxBXvc6aSjiY-OH_EUCZ2XmVnXw&oe=6AECAE97"}, "display_name": "Dungeon Maker", "keywords": [], "long_description": "Greetings My Lord ! \ud83d\udc51\n\nI hath heard thou art quite the dungeon connoisseur, so i maketh this bawbling passthrough system where thee can buildeth thy owneth dungeon using a variety of traps and items, as well as lodging waypoints to giveth goals to the dungeon seekers. \ud83c\udff0\n\nWhat can I expect from my dungeon??\nFear not Sire, there is much:\n1\ufe0f\u20e3 Proceduraly generated plot and a treasure to go with it.\n2\ufe0f\u20e3 Hand tracking and presence! Use your hands to bring up your Orb of Quests as well as interact with the world.\n3\ufe0f\u20e3 A variety of slashing, crushing and deadly traps.\n4\ufe0f\u20e3 Lava floor!\n5\ufe0f\u20e3 Quest items such as waypoints and keys (that open doors).\n6\ufe0f\u20e3 Occlusion boxes to occlude your own furniture.\n7\ufe0f\u20e3 Walls to build around your dungeon.\n8\ufe0f\u20e3 A save / load system so you don't need to keep rebuilding each time! (Even tough it's fun to build, let's be honest.)", "short_description": "Build your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "355455956363606"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2046368595792601"}, {"status": "PUBLISHED", "id": "303868631890285"}]},
3050585400828", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIDJ6ii5HI8Q7kNvwG-y3AD&_nc_oc=AdqSyu1z-j5CgNs-34lNjZCro6ZE0OZOIqCeNJvCUtTr6BQJHnS_aN4h5grHNwiIGjI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFyfjWFk2xQxeSDUGsubmS4Mkb4Rp9lsYdBJ9unFenkA&oe=6A85A79F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYafcyvK-AYQ7kNvwFVvr2b&_nc_oc=AdrfKzRPQz_LI5pNx-RK93sF7Vig8krAHlqA8Mv1qdjE_n9cuQUA9Dsp2Duibo-7nAY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAfYnM1J2b4FSqpBMmyn0S7oHmJtR0ySCyQdKuFCQEgA&oe=6A8579C5"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pf7EDJB6mxQQ7kNvwGkNfHp&_nc_oc=Ado3PKnsuyIks4AsUuI5K9iCy3dmoNqneoaqOX6-bClUfvYBGu-h0DKyZ-Vh7umP8F0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Jx8eQLyqx5Cj8xmRfxW7Qo1qezZaRdDs-j7Se-oDDQ&oe=6A857A3D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uyzw-BwIBwQ7kNvwHeFinB&_nc_oc=AdqZHOPnLySMA5-vqyRsSsP36Z6K7GksggZ4qbwxivQL0CnYIX2OP_NjXwnWpna3Gas&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7LTqzZZyELqiqaSPP6rGmVIEIVsbYNdB20CX1x5ZkMg&oe=6A85A3F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBUflJ3mi_UQ7kNvwGWncbM&_nc_oc=AdrPG8jTlRda5HeWRAmxpMsvIAbpMcDnLqVLg-Gk_4tNhxYjS2q2tAiHgepEEq4wFwM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTf0l_HvVjFZv9AWAplz74PpnR5EIWxFie1iT9Yffyag&oe=6A858066"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category"
5400828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75451783_503050588734161_2222964453019589899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnkrscEhG-QQ7kNvwESuhoM&_nc_oc=AdpSpTDkbMPEWbmX60774VsoRDoRGt1aj7PbVEKXoRXvrMyvZv0w9aGAf_gXxC1QrXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLODDKsuJzS93VDV5VWCrJuWeZcE30L746iStitnMq7GA&oe=6ABA639F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgCjuGT4FRoQ7kNvwFfKl9F&_nc_oc=AdoFbeGErMWCZIh2c1Dqd2JTOIVYkjSJlwjF2NsbJOtEwnQfehsTO1x9Y6Jmf0Rcsq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuZZs44v825CIuQL7H1ct6Fn4Sx5DNP9fHG7mKXFiM7A&oe=6ABA6E05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J78zHk-eaNcQ7kNvwE6YhxW&_nc_oc=Adq44BK_bndoAler5XF-PEGCsar-NPpr7Wq4Km3sYnw9NKa6r0Cb5SBzNA_Seap4eCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrqAIrBFSIOO72sqpz9F-jURScyJyy7TRfSs1d8svo5w&oe=6ABA6E7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGuTddry4LsQ7kNvwFFyWVL&_nc_oc=AdoibtO8Plumpz_f2WWQrHJMMWflh21oESFZIWCiM1mEqn9Ke1Hpd5LJkz7dmc5tBpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzW71FhwLmI8pqLQymM-OYJDHjKk7Ljtuor3vAPgcNjQ&oe=6ABA5FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6UeG3SqGqEQ7kNvwGjtUMe&_nc_oc=AdrcG9e3nDGDueLLgnRWXmGLUJLUCzULaYr9-bJEYIm6hB9jKMDT4QDRmNKzSiDlto0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7_55gEoNJO2RWnyN60usoJbAgdBY5HHwpIntyM-ibCg&oe=6ABA74A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
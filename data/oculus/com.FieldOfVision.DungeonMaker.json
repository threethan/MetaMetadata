_sid=6e7a0a&_nc_ohc=s0Ekya-JdYwQ7kNvwFXvDAg&_nc_oc=Adq0HVlrswh9y_A2bxWvcHZ4Uqj4fjx9iretdwQ4tvXcGFrYmYClg4Frv7EcatLevH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuk0nolAF_sWW8sw7hNhFdU1R6WjJADPqkCXv3IzPeaw&oe=6AEF57DF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqAU11d126QQ7kNvwEEpNEq&_nc_oc=Adp2Rudu0_6hqMuvQItNfgT0szdDj1xVYNQxBMCgq1Lb_9IJYbf0kchEeW3ngp5iYjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu4QJK65qK-eJZ3bzqopFLYwUSwORk4Dmm69etcD4AQA&oe=6AEF6245"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HewoVh7UimMQ7kNvwGaxkDT&_nc_oc=AdqbB91C1Sh0XFeg-mXwwyej1ZrKLzYJhuao1lpozdMThKnqmoGvHNkoV8x79KRPC4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcpkx6g94s1B07n7h850lEIP-gGlnDhBYZ4Ub4rsHZ6Q&oe=6AEF62BD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_nwccFlp8YQ7kNvwHh57Dr&_nc_oc=AdryWEW67RLpYOCrQ1ya-DGsdrgT8Er5LWmuH8mgfcNAhhbG7bAq3W7tWnbAN3Xyd6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc0s6k98wsV-HDgSHuOyYOx_-eyGQkFQ_f9mVOBruT3g&oe=6AEF5434"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lypLIxdVf84Q7kNvwFsg3Xf&_nc_oc=AdpT8SUJHtLHBBePeDgH2NOsA5SyfI0PVE-LwP6lJ2RHMn1oKeY3vP96D_YnLh5vA9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnxCxd3WPF_cO4--nlZbTboKqZ4l-ukzHl0F1AFfwHDQ&oe=6AEF30A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
_sid=6e7a0a&_nc_ohc=s0Ekya-JdYwQ7kNvwHHkyro&_nc_oc=AdpirtcZGOt78m-lwVJ8TRSPbMcvU0AITqF2qASSqyuQjawW-WOHtTjTZpT0rHsGKPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0m3VXkg4sIiFVdwFLLSzFKVwEtPueuw84I6zUjh73mw&oe=6AF0A95F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqAU11d126QQ7kNvwH-sZvw&_nc_oc=AdoaG8rhe4A5SCOK0sgVvxeGXmA0daq6saFG5PL1jtDo7PnCu_ANWb5JeAVQSWQYZo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMunlta0DCHnZFnnreAF4bP3XD_6vUQJHQXC0OK2KfNw&oe=6AF0B3C5"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMfsc3ahtrIQ7kNvwFOHjMZ&_nc_oc=AdrUSN8mzpP1CeciSkwyHLyxv_trXzq-O9D9bKw0plUFxyBYjg7orM0bfDb3Edz8piY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrNRqA1lID9xD0XkgwZ9CQ242kH2wXE__JExUOW5bp7A&oe=6AF0B43D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5S-LV4B0ZYQ7kNvwHLjNy-&_nc_oc=AdopqKzctrHZzNww2Zq2TibjGA-MFUZrpq2HH3TOA4YxngTsePu9GoKLw4Cx7PzuTHA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC3IYpl5HDLUEnw1y3XIkMJB1We7lpJVTB1ighIUFZIQ&oe=6AF0A5B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR940PryUeIQ7kNvwHjmdl5&_nc_oc=AdpxcJ3aZVpy1J4PVKBpPePZdf195SfgLxNs3vbwIztBoLgGugza4qdLDaCfJqAPEws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi3zwXQu3xAxHU-oZVjw2813zDQZdw_PLcHJSQfBoGvQ&oe=6AF08226"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
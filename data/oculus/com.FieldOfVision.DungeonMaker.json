at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP3y9Ou0cFoQ7kNvwGlXKdw&_nc_oc=AdrCJt6U507AECAc5IUgxhCtn3-Ho-3-AfXg30r2SxTOvxLzrt4nyk4v2G30KQf3HhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M3rtZqCNLtnFUVdSvzmjdQxJW7t05Qun9m4diuLYSPA&oe=6A25A25F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R1RTk-C9IsQ7kNvwF5xqAk&_nc_oc=AdpYzF6ZogAHSdOsBX6lwGPwv2vEGYHLGcMv98QwapjwHjyIF0BkToZW3VL-kfIt5GM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JJOgZ8CWOk3znkjBkqaMPeJxQrp__kS_I8zKZI-LKcA&oe=6A257485"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwDUxfn3IPAQ7kNvwEwpfyX&_nc_oc=Ado5gigLB5IHbRYpSSftyB5xRtmbvEjb30ylyANN_u2iuNkWtTq2sHPID4IsAj7ZcUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-rugZfytpqBcPzyHlVn2XN_lEgMGyzXh-gXH076bMcw&oe=6A2574FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiUK41uTOoAQ7kNvwHoiNvK&_nc_oc=Adq6fcXYkdiIze52ABHlKxEnaNWzATjZsrrF6uxGoOYyjE9DdRpRw8iWszya2NdRfCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q_yi27S1PGD8Puo9GE3YU9_ZzGZo-cgh1kOWIm7exQw&oe=6A259EB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDHonp6tU40Q7kNvwFKB-OA&_nc_oc=AdrL9ch7__WFLaJBv9_RMMchOIze755B1e0xye2vFXgleQ-bXNw_MOGcAKPf41iwgyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ESI_D4YVxzwA6WMCb5k6ZZWX0eWLuPkPe1TGtCmvQdg&oe=6A257B26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
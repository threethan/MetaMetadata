at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDAYI2i-AR0Q7kNvwHGYg00&_nc_oc=AdqDgaKgz3VOsBCU6akniAmtM4KK9IvnsH49XBRAvydywsUkXfi0eVhfxe80d5p88T4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iOqcT_X_KE46TH4ZAhvCZJcqC75mnu4rqAjTalXmTPw&oe=6A01D19F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgrpUW53NVYQ7kNvwEyx8ha&_nc_oc=AdpVwbhCcr7quKlLo4CeZb9s81FSPAVH-f4M_Xa02jAf8mbw1AIGDFH51AnTNUI3D0E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61thNUlZNnp4F7x3bBrCdsCXcvUc4R08u3NJtO5KOHEQ&oe=6A01DC05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2cT8AQRjU4Q7kNvwEwXof2&_nc_oc=AdpFOHDIwTGzFLywo18t7eWGmdv72dBRR40QtXJZGc_BMFliCkY1x_rLbUZzcNRv6Ds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eedXL4Pj-ToS5h8JOgpCxDOUbIMvlaN726EDv3KQfLQ&oe=6A01DC7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jaHg2Bc1GsQ7kNvwG66lnE&_nc_oc=AdpZxI2IIp-bd2SaIzrNmarYs4Zg0453ce52ddilB7sxSJ4O_Msrzj2-mZhLH-ZY0Qk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45lUwzCO0M3Z3FUUMTLr0nJj7JLX3cjUMuRYyvgGgdbg&oe=6A01CDF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_Sju79br4cQ7kNvwEkk91u&_nc_oc=Adqd1NRUWQsbyRrNDPdygxOZu-nizFFia_zRuChePg0IYxcPf0MpU6U5DVGJhF91_T4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hKKp2QuXO5-imh4vawQ1GDm89rdaNoXyAg5o7KpEdkQ&oe=6A01E2A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
_sid=6e7a0a&_nc_ohc=bdEfegXaq3gQ7kNvwHOTOX6&_nc_oc=AdpTfWjhXX2yXso4DTdCLjB5vLVo1IZEYbxVOeEMhYvGhNb5FmlyvsTtqzyEf1hrxLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnsiFC1xCMeDT-j2Ik0xFWDr3K-bKuxY8MHt9wip3yAA&oe=6AF740DF"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK7wLG7Q3gcQ7kNvwEJVo_L&_nc_oc=AdqNfTcPKTJQAlytw2yv6Cw4VztHbvy9yExRCifrmg2y-UAYsI-wA1ZK7we8fPTK3JY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQQuNKnPGHdhHv4Fr9z4ofjTOoLyNJY0z1IqjYnAfDIg&oe=6AF71305"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EabVqA10uVMQ7kNvwFP9C1d&_nc_oc=AdqmMe5XqN1wOWfbtDYyOy88qxGn1C62u6sTWbVOVlGtQLOYmxhLP-lT_aVXsCdbsyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR06vRojnes5wzQEOuH3708iGQ0BkCC86oAUq_elYN0_w&oe=6AF7137D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UWBZvKuwHAQ7kNvwH8mS1n&_nc_oc=AdpZ5sfe4xMD7qe2DHqngSC0wqCuwEDv-fVztdx3iOb9Usj4d4WZ_TbV8Tiw0Z4IN7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_pxt7sKe1HBZq_HrqTioHgvL4MQrr-RWh51wyEZ3b1g&oe=6AF73D34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDhLavgP1ksQ7kNvwE3bEKK&_nc_oc=AdoVrWPJybaPgUBud6mGKF4ru_1YF55dbH5E5uMPyoZ0-JDfW5om-C7_oyI1iUc61P8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL6L2M61FzMSbTm1FbiG4J3k4U1_vUxuX63eIzgCkC7A&oe=6AF719A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscri
at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKovlciPsegQ7kNvwEQfrik&_nc_oc=AdrvtNdaTX-z4t2iA9ykxjvRUpTL08IvPiK-65hoDb1a4ymSovLPmAIw4Ku-24JieMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IOtjEP7SC82ITTuvahfDb4U3fmPHKK6jSJJq49pW9Cw&oe=6A04749F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgrpUW53NVYQ7kNvwFBAuBt&_nc_oc=AdofZinHbyWwx9mkuNGisH_Eu9VHuquJD8hoO3zdRtGWgINa38IUPlbAp78T6hRX3Fo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ed7A5y_ho9NaHi_yxiLiNnuO6oPc4dBb27R2k5YUjuA&oe=6A047F05"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz9Dba3YhIQQ7kNvwHXEwlw&_nc_oc=Ado88DoFLADUOfByc0nrsXnU_w-reGiQrLPE3ttG9SEt1KCJEohKnrel2tmkH6CtqBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66280he2zsWQJsuCI2I6XfAssneDqaGiGBNDlYmx9UFA&oe=6A047F7D"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KIlg6wLA2cQ7kNvwHL0kZg&_nc_oc=AdpOgZgt-SAAUHqSyounQKRmdq2g8U4pyuDs8RloXus78hyObrUnaH52JO0YQIFIH1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c21UcpmUNlHxIioBtF4J0fKyWfeNh_DmJxdf3UY_4KA&oe=6A0470F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1MjDMfYfQsQ7kNvwGJExrn&_nc_oc=AdoFUudmtlFj802xiReD_oXhSa0lXNa2-eaBAEqrOAcyy_dXEXHXDDwrTxTlqn86ezo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kdvzUMkXHwqjhS8IOi7Wj_o4hDKPqxD83sSU8qoEd5A&oe=6A0485A6"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
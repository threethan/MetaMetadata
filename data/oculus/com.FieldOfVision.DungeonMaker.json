ca9twz7ZVcgpyeMSqWHUvtHtMskMwTLtMO2xaUCcLXf_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3uhv9eSKV4GftgG6rwQ9MEGmrmGso3di135L1TwWKsUw&oe=69F0AE1F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR-4uVIN6O4Q7kNvwEkvo0H&_nc_oc=Adpe1tsEJ50E59Qyt71EOJlxTBpMMzZyJ_Gk7NYuGI1dwrSSFSco6DUpPFFsQsHjbnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2bzIKIcRJpeCLfFr5usDCyrw3SScScOA7O3zV-bdO0XA&oe=69F0B885"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7miPQN0UjKsQ7kNvwEy_MHg&_nc_oc=Adqgdaipgs-NpltlYpGYAalhpV7pWuvzsHAsGWOpktEOkeaPwIPexmz_p3eAfF8LpSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2iGGJsci68DN8iIac8NrTMSlzI5rWsfu4VkliCSEkJYA&oe=69F0B8FD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1xOOa0h8yoQ7kNvwHlLXyJ&_nc_oc=AdqRC1swejdD85Mynk6p5HrZBHK1YpDQ_5pSAsvVR6F-lQQUcrXo1bjvU_sO8U8_JlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1RbI6_d-NzaqQmwuEs00_HhLORshsnk-m3KoMwiXC0lw&oe=69F0AA74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8YuiEQivCwQ7kNvwEse_aX&_nc_oc=AdqNsVUXR0nWvaqNK8aDx2AYtD69R4UHz1wT8zV95pDmMBSNjKd19godt4RuQZ8dTnI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3QsUjpi0ruYn-Iah7WswSzItEb39_lUn-sGdVT4VzZyw&oe=69F0BF26"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "
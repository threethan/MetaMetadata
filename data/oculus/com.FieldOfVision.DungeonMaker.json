at=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDqwrm2gpA8Q7kNvwHfhAy5&_nc_oc=AdrA2NFKcOw2Qzi5nYSE5b3XNkyquS0WP-02G9VrsLVOzlKQceAw35PK4bigIW-6D9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpV7s20JyD9eVO0GEokPyQDAC20kskOo4A9J700fN7yg&oe=6A67551F"}, {"file_name": "DungeonMaker_Classic.png", "id": "958112396267493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_958112399600826_936053191076049290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB2wB-2nf1wQ7kNvwFaaMyh&_nc_oc=AdrDmv_t-ek3BbMxau25mHlH5ngQVL9ypNNxGKPWbMsyFzjzAHCF18p6abQ0ywdqUHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6mDY25U9BEN6XkA8ykwBva_jgP9pQR6MttMum2svD2A&oe=6A675F85"}, {"file_name": "DungeonMaker_Tomb_3.png", "id": "1105680564431956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639801_1105680567765289_2699881368188163859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iYyF9XH2iQQ7kNvwHRcfPZ&_nc_oc=AdqtZwakrwQDEy9yWRXxwEtV2KU1hrcKkOSJfYwCELd9GSV-3HMdyMIhjOnsSP1-NdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9ro8knBME9_7GPt44iD1qYDRTikRJPltbHafnkOZ-zw&oe=6A675FFD"}, {"file_name": "com.FieldOfVision.DungeonMaker-20231018-180241.png", "id": "321920080425083", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_321920093758415_78624449223695311_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuKJ1iDDBWMQ7kNvwGObA4l&_nc_oc=AdqtE914Byxp4N95MNadpIjtFKfkfi_qmrKlngUnDaXoB5G0PXS7PMHAak8FiQ3-f7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKTlukrPuLUaCWVKUu7OFRqlymk9fkx2FilJk4-qIkYg&oe=6A675174"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE_2560x1440.png", "id": "2360001101131996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628050_2360001104465329_811509019894970622_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gwk06VokBYQ7kNvwFGhIc3&_nc_oc=Ado5PhYfKjci-FeEetpG2pSw2iUxG7ofz1TZB-x1YCGIGFfq3UqiKdz9-cl_mOdbQDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCocw_AtuswwIoRd3TlPVj9EI1EVfguvHssqrJR0GPlZg&oe=6A676626"}, "display_name": "Dungeon Maker", "keywords": ["dungeon", "sandbox", "adventure", "passthrough", "builder"], "long_description": "                                                                                                                                                                                                       \n{576958931641921}\n\nSires! __Dungeon Maker__ is a mixed reality sandbox game where you shape the adventure! Take control to build and customize every detail, or effortlessly generate endless dungeons (currently in __BETA__). \n\nWhether you create by hand or let the system do the work, prepare to explore traps, face enemies, and uncover quests in your own immersive dungeons.\n\nThis is a work-in-progress with regular updates and fixes. \n\nJoin my Discord to share feedback and ideas: www.DUNGEON-MAKER.com\n# -\n# GENERATE INFINITE DUNGEONS!  (BETA)\nThe dungeon foundation is created from your Meta rooms setup, then generate as many dungeons as you like!\n{1964062794072551}\n\n# SET DEADLY TRAPS AND QUESTS\nPlenty of traps and quest items to place around your home. Keys and doors, plots and treasures, deadly pits, swinging axes, skeletons!\n{884487527165107}\n\n# FIND THE TREASURE!\nCan you go deep enough into the dungeon to retrieve the treasure?\n{492385469938846}", "short_description": "Generate your own Dungeon in your home using Passthrough!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.fieldof.vision/", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}],
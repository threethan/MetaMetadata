&_nc_sid=6e7a0a&_nc_ohc=UjEgfQW8RXgQ7kNvwEu0opz&_nc_oc=Ado1PW2TqMP2sh-ubzvJ2Wa8zgbLandXHVLJPUfye35vQjruEacEMIBifIs0498SwEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIovqQKrZNsHpGFpipbV8WgZHyXcvkjR9mPBMy3AYlcqg&oe=6AAAA477"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cycle X VR", "keywords": ["Bike", "Cycle", "Fitness", "Racing", "Sports"], "long_description": "CYCLE X VR \u2014 ARCADE BIKE RACING FOR META QUEST\n\nRace through neon-lit tracks, dodge flying obstacles, and blast through boost gates \u2014 all locked to a pulse-pounding beat. Cycle X VR is a high-speed arcade cycling game built from the ground up for Meta Quest, fusing VR bike racing with rhythm-based gameplay and genuine calorie-burning intensity.\n\nIf you love Beat Saber but crave speed, this is your next obsession. Every corner, every sprint, every near-miss hits harder in full VR immersion. Standalone. No PC. No cables. Just ride.\n\nFEATURES\n- High-speed arcade bike racing for Meta Quest 2, Quest 3 and Quest 3S\n- Rhythm-synced obstacle courses where timing wins races\n- Multiple tracks, worlds and difficulty levels\n- Global leaderboard \u2014 beat your ghost or the world\n- Real VR fitness workout that never feels like one\n- Smooth locomotion optimized to minimize motion sickness\n\nBURN CALORIES. BREAK RECORDS.\nVR cycling is proven to reduce perceived effort \u2014 you push harder without noticing. Sessions are physically demanding, sweat-inducing and genuinely addictive. This is your cardio, leveled up.\n\nMount up. The track is live.", "short_description": "High-speed VR bike racing meets rhythm gameplay. Dodge, dash & dominate on adrenaline-fueled tracks. The most intense cycle game on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1210376278831302"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2355962558144383"}]}, "baseline_offer": {"id": "2355962558144383"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784900280, "status": "PUBLISHED", "id": "2355962558144383"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1211803415355255", "version": "0.1"}, "id": "28127542010182851", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1210376268831303", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1211803415355255"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "28127542010182851"}]}, "change_log": null, "created_date": 1784642030, "id": "1211803415355255", "version": "0.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
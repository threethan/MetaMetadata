.png", "id": "1046149778065944", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823259_1046149784732610_8880066746435582030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfOyFGkc-Y8Q7kNvwF2hLio&_nc_oc=AdpqetLh-PBOAa2O-72oDrEVk5MbiN5NCDYzrAMkVc8bYNPBcdhfkr6zUkeZI4GjuSo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHb6uxuV0DEzhUaY3_XCVUDQmfCuux960Q7ZGzAiaw-Q&oe=6A94199C"}, {"file_name": "5.png", "id": "920597623641285", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823940_920597626974618_2521043253492521848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prZz-sWTTDYQ7kNvwEt0qXd&_nc_oc=AdqcGASS51AAVSKGnkmonakfSgwNLTetledj3XxVeYDTnr6yCGtJQIE0opyF1jrAHOc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCZTrBJDLOy5MrPK7u_-mD3XEdp3kgRTL2EpSwX-0qjw&oe=6A9418A2"}, {"file_name": "2.png", "id": "27320343750994458", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823310_27320343784327788_1105610351429079997_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7guhaYUPg8Q7kNvwEq8AbI&_nc_oc=AdpOvm54TJPyvw_5ejez4Af49aEqKl2Pa3JvMjk1i4sAdl_lFkeNM6ilLC1L9NJ2sPc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzJKVaBZ8MwT2VZIJMiDJNA3OI0H9Ysi9ZGy47ommvYw&oe=6A9402B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cycle X: Bicycle Game Simulator", "keywords": ["Cycle", "Bicycle", "Motocross", "BMX", "Bike"], "long_description": "Experience immersive bicycle riding in VR with **Cycle X VR**! Take control of your bike and explore exciting environments while mastering realistic movement, precise steering, challenging routes, and obstacle-filled tracks.\n\nRide through **mountain trails**, discover immersive **forest paths**, and navigate detailed **city environments**. Each location offers a different cycling experience, from winding mountain routes and natural forest trails to urban streets where your riding skills are put to the test.\n\nLooking for a precision challenge? Enter **Parking Mode** and maneuver your bicycle through tight spaces, challenging paths, and tricky parking areas. Carefully control your bike, follow the route, avoid obstacles, and aim for the perfect park.\n\n### \ud83d\udeb4 Explore Different Environments\n\n\u2022 **Mountain Mode** \u2013 Ride through challenging mountain terrain and winding trails.\n\u2022 **Forest Mode** \u2013 Explore natural forest paths filled with obstacles and challenging routes.\n\u2022 **City Mode** \u2013 Ride through urban environments and test your control on city streets.\n\u2022 **Parking Mode** \u2013 Master precision riding and park your bicycle in challenging spaces.\n\n### \ud83c\udfae Built for VR\n\nExperience bicycle riding from an immersive first-person VR perspective with intuitive controller-based controls. Steer, navigate, balance, avoid obstacles, and improve your riding skills as you take on new challenges.\n\nWhether you enjoy **VR cycling, bicycle riding, exploration, obstacle courses, or precision parking**", "short_description": "Master the ride in Cycle X VR! Explore mountain trails, forests, and city streets on a realistic bicycle, then test your precision in challenging parking levels. Ride, navigate, balance, and park your way through immersive VR cycling adventures!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
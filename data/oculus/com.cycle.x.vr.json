nc_ohc=fF9LC98SmCUQ7kNvwHIQhSB&_nc_oc=AdqlKRXsQhSw3SBEh3JNaHeMOdrmz-p9-3YEDoBNyWlPezFjJjMFzWOysDWabsgrt3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvUN7L2ppfbxS6fyA45JVCsqwmk6F4pjYYZHA8W-hfkQ&oe=6A9ED86A"}, {"file_name": "4.png", "id": "1046149778065944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1046149784732610_8880066746435582030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTeqv0k6jTYQ7kNvwFDabIM&_nc_oc=AdoWoCNRqv0Wl5sKsxjMinuP4cuhWE4_CNPA6Vco6smCMViz7gcQSxJmATFmLHxDXJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpgiUI9G-MFOZ9aUf8OIFj85hb2kGe6eV1nTg8yKb0Dw&oe=6A9EA59C"}, {"file_name": "5.png", "id": "920597623641285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_920597626974618_2521043253492521848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6SLlVHCCSwQ7kNvwE7dNbf&_nc_oc=AdoB4kZ791ieP44koCQMm3p4LF5A4BGyNzgNfPX90o-ONrj8TdDeFyG_YFyyVXQ28BA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj7baeu5vPj7-UFAKqv5Ory_unnfYEQxXRDW08vrwDnA&oe=6A9EDCE2"}, {"file_name": "2.png", "id": "27320343750994458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_27320343784327788_1105610351429079997_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQHQ9NH9Q-kQ7kNvwE24GsM&_nc_oc=AdrXwOVT8aUsa_nW6h3HPcr2SiR9vLeAh7f8MU_VKVOBQ8B01w_NI74ZLUbpCi-Fpec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtqOxHiNNjBVoHrnAzN_T_LlAGA3KIzlQ0dSXfft4qBA&oe=6A9EC6F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cycle X: Bicycle Game Simulator", "keywords": ["Cycle", "Bicycle", "Motocross", "BMX", "Bike"], "long_description": "Experience immersive bicycle riding in VR with **Cycle X VR**! Take control of your bike and explore exciting environments while mastering realistic movement, precise steering, challenging routes, and obstacle-filled tracks.\n\nRide through **mountain trails**, discover immersive **forest paths**, and navigate detailed **city environments**. Each location offers a different cycling experience, from winding mountain routes and natural forest trails to urban streets where your riding skills are put to the test.\n\nLooking for a precision challenge? Enter **Parking Mode** and maneuver your bicycle through tight spaces, challenging paths, and tricky parking areas. Carefully control your bike, follow the route, avoid obstacles, and aim for the perfect park.\n\n### \ud83d\udeb4 Explore Different Environments\n\n\u2022 **Mountain Mode** \u2013 Ride through challenging mountain terrain and winding trails.\n\u2022 **Forest Mode** \u2013 Explore natural forest paths filled with obstacles and challenging routes.\n\u2022 **City Mode** \u2013 Ride through urban environments and test your control on city streets.\n\u2022 **Parking Mode** \u2013 Master precision riding and park your bicycle in challenging spaces.\n\n### \ud83c\udfae Built for VR\n\nExperience bicycle riding from an immersive first-person VR perspective with intuitive controller-based controls. Steer, navigate, balance, avoid obstacles, and improve your riding skills as you take on new challenges.\n\nWhether you enjoy **VR cycling, bicycle riding, exploration, obstacle courses, or precision parking**", "short_description": "Master the ride in Cycle X VR! Explore mountain trails, forests, and city streets on a realistic bicycle, then test your precision in challenging parking levels. Ride, navigate, balance, and park your way through immersive VR cycling adventures!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
nc_ohc=f3FsXjxF5HwQ7kNvwEbiQ_5&_nc_oc=Adp3C8ShpPYQ649LYmkDlYh_f9j8HrSI3i2ZWdEdB8lJlfKyEZ67BCxevlH743xgtKE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuHcdhBJc8Wj7WUn6j81hQPhpLo3q18IG4P_pBK7n-nQ&oe=6AA17B6A"}, {"file_name": "4.png", "id": "1046149778065944", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823259_1046149784732610_8880066746435582030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgmr1DixVmIQ7kNvwHkh9ES&_nc_oc=AdqfnP83suU4U7Y-sq_k62K9Z9VAxGBklQ9MeSEVlGiwful5pCW-MWUgOoYibhqe5BM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW-wggNsPMDxpqle6crRfWBLwHIj_fUoaRsBKXU_QBWw&oe=6AA1489C"}, {"file_name": "5.png", "id": "920597623641285", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823940_920597626974618_2521043253492521848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stT5DDH77qsQ7kNvwFtoIwo&_nc_oc=AdqPQQw2T6dyqB1TWryVnHDUc2K2meVUgs2rVItUa5iVpNjIE-cF_5C9HPQhpP8lXtw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD1jr-AO-cfW9b_tpZK7G3aZND_O21HSkVNNsLz7EZ6g&oe=6AA147A2"}, {"file_name": "2.png", "id": "27320343750994458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823310_27320343784327788_1105610351429079997_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbxiFu9apNsQ7kNvwE1DN3_&_nc_oc=AdpnVvqEnUtA1SJ0qWGTUjlSVCkhQVEWUQfrhZg4evg02wF-Gci9kvFTzuppo52p0Hk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqoMdZPfjg45HVdjvPCfG42gPbHcCw4J0BHBygfkSyaQ&oe=6AA169F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cycle X: Bicycle Game Simulator", "keywords": ["Cycle", "Bicycle", "Motocross", "BMX", "Bike"], "long_description": "Experience immersive bicycle riding in VR with **Cycle X VR**! Take control of your bike and explore exciting environments while mastering realistic movement, precise steering, challenging routes, and obstacle-filled tracks.\n\nRide through **mountain trails**, discover immersive **forest paths**, and navigate detailed **city environments**. Each location offers a different cycling experience, from winding mountain routes and natural forest trails to urban streets where your riding skills are put to the test.\n\nLooking for a precision challenge? Enter **Parking Mode** and maneuver your bicycle through tight spaces, challenging paths, and tricky parking areas. Carefully control your bike, follow the route, avoid obstacles, and aim for the perfect park.\n\n### \ud83d\udeb4 Explore Different Environments\n\n\u2022 **Mountain Mode** \u2013 Ride through challenging mountain terrain and winding trails.\n\u2022 **Forest Mode** \u2013 Explore natural forest paths filled with obstacles and challenging routes.\n\u2022 **City Mode** \u2013 Ride through urban environments and test your control on city streets.\n\u2022 **Parking Mode** \u2013 Master precision riding and park your bicycle in challenging spaces.\n\n### \ud83c\udfae Built for VR\n\nExperience bicycle riding from an immersive first-person VR perspective with intuitive controller-based controls. Steer, navigate, balance, avoid obstacles, and improve your riding skills as you take on new challenges.\n\nWhether you enjoy **VR cycling, bicycle riding, exploration, obstacle courses, or precision parking**", "short_description": "Master the ride in Cycle X VR! Explore mountain trails, forests, and city streets on a realistic bicycle, then test your precision in challenging parking levels. Ride, navigate, balance, and park your way through immersive VR cycling adventures!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
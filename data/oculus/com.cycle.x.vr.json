610_8880066746435582030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4HubMKLbjAQ7kNvwEdw2Of&_nc_oc=AdqwNWinQZTXgjokVGhOZiNrtVs7-6By8n-G45ZY3as6L3xXuh1G8zX2M9UGg5iXjKU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_ys4g0h2bVH4PAfIX5hme2E4vTOMzj24mWoDKdV8uuA&oe=6A8ED39C"}, {"file_name": "5.png", "id": "920597623641285", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823940_920597626974618_2521043253492521848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uiMUU-7Y_oQ7kNvwFuAwRv&_nc_oc=AdqnRjiPnybw43KQAv8xlQclBz8aTrto683YUXC2DpnWKTAYm-SX0H2eX1TklJdOS9k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqmFFKkpHfMeoaJjTLTCxw6dtUW4yAks8PFg7aLVXJNA&oe=6A8ED2A2"}, {"file_name": "2.png", "id": "27320343750994458", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823310_27320343784327788_1105610351429079997_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IECddkPu_wQ7kNvwHb1sHA&_nc_oc=AdoDLW7ePUF2rLB_p2sEuPsslSjUQBFhRCKqTUINgSQmcuk_4hj73w_0OgGsu_uq85s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4d6Ms7WKiC2rsfXpj4WkvJlYVxzHEGELAb8kfZplr_A&oe=6A8EF4F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cycle X: Bicycle Game Simulator", "keywords": ["Cycle", "Bicycle", "Motocross", "BMX", "Bike"], "long_description": "Experience immersive bicycle riding in VR with **Cycle X VR**! Take control of your bike and explore exciting environments while mastering realistic movement, precise steering, challenging routes, and obstacle-filled tracks.\n\nRide through **mountain trails**, discover immersive **forest paths**, and navigate detailed **city environments**. Each location offers a different cycling experience, from winding mountain routes and natural forest trails to urban streets where your riding skills are put to the test.\n\nLooking for a precision challenge? Enter **Parking Mode** and maneuver your bicycle through tight spaces, challenging paths, and tricky parking areas. Carefully control your bike, follow the route, avoid obstacles, and aim for the perfect park.\n\n### \ud83d\udeb4 Explore Different Environments\n\n\u2022 **Mountain Mode** \u2013 Ride through challenging mountain terrain and winding trails.\n\u2022 **Forest Mode** \u2013 Explore natural forest paths filled with obstacles and challenging routes.\n\u2022 **City Mode** \u2013 Ride through urban environments and test your control on city streets.\n\u2022 **Parking Mode** \u2013 Master precision riding and park your bicycle in challenging spaces.\n\n### \ud83c\udfae Built for VR\n\nExperience bicycle riding from an immersive first-person VR perspective with intuitive controller-based controls. Steer, navigate, balance, avoid obstacles, and improve your riding skills as you take on new challenges.\n\nWhether you enjoy **VR cycling, bicycle riding, exploration, obstacle courses, or precision parking**", "short_description": "Master the ride in Cycle X VR! Explore mountain trails, forests, and city streets on a realistic bicycle, then test your precision in challenging parking levels. Ride, navigate, balance, and park your way through immersive VR cycling adventures!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1227684237100506"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/593872736_1559497872308670_8914060732617067245_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR-UIrMNuVIQ7kNvwE75yAV&_nc_oc=AdriLW7ALOXFmJUgmKMhtILMfD2U0qdDtKwSwhyB5zf9iCCZ06RwWKpW8Dt3hFWBiLk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMz5Utc7wxKSOhqy0vzbnI8p3Y6xIQbn581eR3qmCnjA&oe=6A8ECAD2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cycle X: Bicycle Game Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1784900280, "lastRevision": {"nodes": [{"id": "1210376282164635", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1210376268831303", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1562843548808826"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Cover_Landscape.png", "id": "4454730178177869", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/585727769_4454730188177868_3773946540556964342_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONPWaSTbBssQ7kNvwFJC4xl&_nc_oc=AdqoHcgx3Nwh2vPB9pv_SyeC4Iba4X7T3Z3_I4oIUhv8e5gnZrgznsaJF6L9Wkp2C_8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9N927CG3t0Yi-igeBv8bs1BN_mLPTTmZ_pzAnyhnnPw&oe=6A8ED242"}, {"file_name": "Cover_Portrait.png", "id": "3248451012018298", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.
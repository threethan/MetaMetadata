: "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1945481449533310_2191846996368690939_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4FMOAGcrXkQ7kNvwFRVSBT&_nc_oc=Adrvocyrmowi9qqG1osbWaNhqTeWgjEOd8U-Z0Anl5q2oWUUcxmu0aVHc0GKXamYSNo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTJGxKlDpqWfl0NyNxUWG7dl7c_0VOoElbIBPjp7dYZw&oe=6ADCBDD5"}, {"file_name": "SS 4.png", "id": "720735457476044", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619159_720735460809377_4362620463752212805_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0Q1K-XefvsQ7kNvwEh-Ubi&_nc_oc=AdrAGAPD4HdepN3C0SsF6rvWn8Zs5zpy7o3Zv4wFQ1tCtAzADkb-PWzYtw1VK7Vzjjw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd3F18AVzcFH_x0MsF6iK3TCHI17Jv3TumuS-R4vfQSg&oe=6ADCB11C"}, {"file_name": "SS 5 1 (2).png", "id": "704719362544487", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618252_704719365877820_7376198861048738267_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mPdjUDio1QQ7kNvwGNtpcj&_nc_oc=Adp4XNmxnhCqyFFddGA6F_5aNzXoklvdlMvp5y7Wo0WMWL_FYRR0qGSNSWO1eb8fUnY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1VWBxuZBBxdQjIE6yrneBGl-UyvXUuf5OGpOT7Qp27Q&oe=6ADCA92E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image landscape 2560x1440.png", "id": "3756138414689767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619382_3756138418023100_3858465734849439051_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcInp61cv48Q7kNvwEt43oI&_nc_oc=AdpWfacPiJn-JxJ_opyLjNYXbPzPSnL0qpU5X2rxq6hp2ofQAn5qDfw0DSq8TfKC9ac&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAlTRqmwEIE8-Uvf8-RP7qB8LTVaQWWIcAFauFX1PWPg&oe=6ADCB748"}, "display_name": "Altoura Frontline", "keywords": [], "long_description": "Altoura Frontline is a one-stop frontline productivity platform for authoring, expert support and knowledge capture, built for enterprise-scale.\n\nNo-code Authoring\nThe intuitive Experience Builder lets trainers drag-and-drop thousands of ready-made 3D objects, animations and spatial triggers into a virtual workspace. In minutes you can replicate equipment, environments and SOP workflows, embed assessment checkpoints without writing a line of code.\n\nRemote Expert assistance\nDuring maintenance overhauls, frontline workers open Remote Expert to connect with specialists anywhere in the world. Bi-directional audio/video, MR ink annotations anchored to real-world objects, file transfer and desktop screen share speed troubleshooting and eliminate costly travel.\n\nEnterprise-grade\nAltoura is ISO-27001 certified with SSO, SCORM/xAPI LMS integration, and Power BI analytics for measurable outcomes.\n\nFrom complex maintenance to daily routines, Altoura Frontline help enterprises to enhance frontline productivity and reduce equipment downtime for consistent operations globally.\n", "short_description": "Altoura Frontline empowers enterprises to enhance frontline productivity. It blends seamlessly into the physical workspace with guided AR overlays to deliver step-by-step work instructions. Remote Expert connects the frontline workforce with global specialists through live MR annotations, file transfer and desktop sharing to cut downtime. Prodigy AI transforms existing SOPs into interactive step-by-step procedures, without any development dependency."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.altoura.com/privacy-policy?1=1", "developer_terms_of_service_url": "https://portal.altoura.com/agreement", "publisher_name": "Altoura", "support_website_url": null, "website_url": "https://www.altoura.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQ
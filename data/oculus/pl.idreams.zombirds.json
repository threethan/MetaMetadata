IMUPKeQ3WBrRiT1vvsuY3k3ANIGSQ78MhFYqRg&oe=6A772700"}, {"file_name": "STZ05.png", "id": "1283874142084201", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75542964_1283874152084200_8381873660362613557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzNXm_AcTmoQ7kNvwF9LL1p&_nc_oc=Adr5ZD0nGAFbGpTfSMiFiErViyg0dNG91Kem_o4rE5AryS3gpsynf7DAo6ENtPlLvUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdbhUNvNC3zYfBXSZkUiSBT0MynqHcf8U0OmcrsvTxMQ&oe=6A773E97"}, {"file_name": "STZ03.png", "id": "1128014507731367", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_1128014517731366_6716068742798613670_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PNxKKpBsjIQ7kNvwEbjEK7&_nc_oc=AdposmCGAY8sSOJuxMAOMiROhijoTHRsRMFvz7udpMMROvZ6t3OiVPpk6VXk3gNiReI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXZKt1zBuCki8NWS5qFSTyafp-c_hdL1NHfUkEfddymw&oe=6A77442B"}, {"file_name": "STZ04.png", "id": "447905820093937", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974683_447905826760603_3089029740874095363_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCB9L3UkTsoQ7kNvwFdj6B7&_nc_oc=AdpqfNgYYotDVvXM42DZedT8-Y1YHuD11445Bu-2i0OBlz3hyqshb96J5yvWbwaj9rM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHzgwcEFZPM2xNh3KNICgiduzhXrL6xJoE2VA5_fmYJw&oe=6A7710FC"}, {"file_name": "STZ02.png", "id": "312025850385364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031421_312025853718697_1638126850915926477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq0fHqDiPG8Q7kNvwHBpLT_&_nc_oc=AdqBdpVPmDAj9OOgAqkqfmn50oyOxoTrVp4xq8MuDZjgSiF6oPKg9KPugAT0wrV84Bw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP1kVo00sLY-f7qrkz5EB2zOh7M9fYjX2067qs71Qzlg&oe=6A771581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "600422384641525", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035390_600422387974858_2735575334358700443_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mqJyjQql_8Q7kNvwGG8YkH&_nc_oc=AdoUUYFGL44qpQr3E_DNCLqmypIb6Bz0nSDtYsPALkKOlhdAmGQ_rx7vd0nnKRdgWDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc44ZGmcgX677tKIFwCsYENlR-Um3H192JlDkhRPkIug&oe=6A772F7D"}, "display_name": "Shoot The Zombirds", "keywords": [], "long_description": "A quiet evening on the cemetery finds you playing with your Pumpkin kids.\nSUDDENLY, a horde of Zombirds clouds the sky! Those unprofessionally dead birds invaded your piece of Virtual Reality and will stop at nothing to kidnap your children.\n\nNEVER GOING TO HAPPEN!\n\nPlay your role in the theatrical staging of these thrilling events!\nGrab your ol' trusty crossbow and Shoot The Zombirds in this super immersive, endless gallery shooter. Destroy countless waves of dead birds, varied in shapes and sizes. Build your combos to increase the score or enter the Fury Mode! Collect and use power-ups to obliterate even the fiercest of the fowl.\n\nFEATURES:\n- Endless waves of Zombirds to slay!\n- Diverse power-ups to aid you against the rotting fowl.\n- Multiple difficulties appropriate for all skill levels.\n- Local and on-line leaderboards.", "short_description": "Shoot The Zombirds! is a gallery shooter starring undead birds, pumpkins and a crossbow. Excellent shooting fun for all ages and skill levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idreams.pl/privacy/ShootTheZombirdsVR_PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Infinite Dreams sp. z o.o.", "support_website_url": "https://idreams.pl/en/support", "website_url": "https://idreams.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "inter
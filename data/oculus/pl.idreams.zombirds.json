-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqFmWY-YU3LPskMqslFy6JQGPZb56wfnYnsZH0ugjUMQ&oe=6B0C7F81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "600422384641525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035390_600422387974858_2735575334358700443_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9w8y_7evvwQ7kNvwHT-isA&_nc_oc=AdptuiQ8KVgKhWC74BWcz-NUBc24VEXFEiIgPapchLFXDwZYgy7nT980fuxv-S2zg3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcqZIvUrzNgGdxKy8NaJYoMTeUdVqnmI2eWDBKQ1R7DA&oe=6B0C613D"}, "display_name": "Shoot The Zombirds", "keywords": [], "long_description": "A quiet evening on the cemetery finds you playing with your Pumpkin kids.\nSUDDENLY, a horde of Zombirds clouds the sky! Those unprofessionally dead birds invaded your piece of Virtual Reality and will stop at nothing to kidnap your children.\n\nNEVER GOING TO HAPPEN!\n\nPlay your role in the theatrical staging of these thrilling events!\nGrab your ol' trusty crossbow and Shoot The Zombirds in this super immersive, endless gallery shooter. Destroy countless waves of dead birds, varied in shapes and sizes. Build your combos to increase the score or enter the Fury Mode! Collect and use power-ups to obliterate even the fiercest of the fowl.\n\nFEATURES:\n- Endless waves of Zombirds to slay!\n- Diverse power-ups to aid you against the rotting fowl.\n- Multiple difficulties appropriate for all skill levels.\n- Local and on-line leaderboards.", "short_description": "Shoot The Zombirds! is a gallery shooter starring undead birds, pumpkins and a crossbow. Excellent shooting fun for all ages and skill levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idreams.pl/privacy/ShootTheZombirdsVR_PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Infinite Dreams sp. z o.o.", "support_website_url": "https://idreams.pl/en/support", "website_url": "
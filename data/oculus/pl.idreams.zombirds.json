mpfhIBNVTvb9blQgD_qrtkySnvIxpERnYu2oYQ&oe=6AE49380"}, {"file_name": "STZ05.png", "id": "1283874142084201", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75542964_1283874152084200_8381873660362613557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4GIZN09Sn8Q7kNvwHLT2MN&_nc_oc=AdqB8axpYorUx331CFlrf1wszBpjEQ3snKr4_W5R384QO0ktXS9HtcSQASmMhinOI54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNCOiuQ6zTNl_wDE0cC4KszgN_bzbIEpbiV-SLGsRPUw&oe=6AE4AB17"}, {"file_name": "STZ03.png", "id": "1128014507731367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_1128014517731366_6716068742798613670_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0TOwtznOJoQ7kNvwFKKmCM&_nc_oc=AdpNS6TVmJWke-TB5niyokva5wLDMPmYKAUXX1Igs1km3CAV1B322STLWDTsqRgR_WI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFO3LExvHnQED5600y-GMf_TLRDkkcpF63og2eoarIWw&oe=6AE4B0AB"}, {"file_name": "STZ04.png", "id": "447905820093937", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974683_447905826760603_3089029740874095363_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G618__wjJIMQ7kNvwEUKC-c&_nc_oc=AdrcDs6gH4vzw73aVKcRgLgpnG3y9eJ01kzwAgap8koK8F521y46e8UPmSPsU-u12Gs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtZfqxJBcsPaRxhVJSv21aawjZJ8JPXue4-KRb78hWIA&oe=6AE4B5BC"}, {"file_name": "STZ02.png", "id": "312025850385364", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031421_312025853718697_1638126850915926477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSfkg7oFke4Q7kNvwHZ9WuN&_nc_oc=AdoQODI4qwP-TT1YIb7vvfhad8OfxA6Me1YeGmZNz77IJGExA4VpT7PmlpXZZHuiyhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPomZWfJMa8VYLP_VWH5rOiDNKWUz4moYmoAepR0hOE3Q&oe=6AE4BA41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "600422384641525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035390_600422387974858_2735575334358700443_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBOkuRv9w-sQ7kNvwE8Nf4g&_nc_oc=Adr2VLhCfsMokxA9vhGPk1P4RYkoYzzD7drDF1bRC2QTB2gQLskLowRZ4vI7YUly3W4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0jd-vOy0XAUpyuxkHC-oY0Mbm0xosDmJnmSAcQ4WXAQ&oe=6AE49BFD"}, "display_name": "Shoot The Zombirds", "keywords": [], "long_description": "A quiet evening on the cemetery finds you playing with your Pumpkin kids.\nSUDDENLY, a horde of Zombirds clouds the sky! Those unprofessionally dead birds invaded your piece of Virtual Reality and will stop at nothing to kidnap your children.\n\nNEVER GOING TO HAPPEN!\n\nPlay your role in the theatrical staging of these thrilling events!\nGrab your ol' trusty crossbow and Shoot The Zombirds in this super immersive, endless gallery shooter. Destroy countless waves of dead birds, varied in shapes and sizes. Build your combos to increase the score or enter the Fury Mode! Collect and use power-ups to obliterate even the fiercest of the fowl.\n\nFEATURES:\n- Endless waves of Zombirds to slay!\n- Diverse power-ups to aid you against the rotting fowl.\n- Multiple difficulties appropriate for all skill levels.\n- Local and on-line leaderboards.", "short_description": "Shoot The Zombirds! is a gallery shooter starring undead birds, pumpkins and a crossbow. Excellent shooting fun for all ages and skill levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idreams.pl/privacy/ShootTheZombirdsVR_PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Infinite Dreams sp. z o.o.", "support_website_url": "https://idreams.pl/en/support", "website_url": "https://idreams.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "inter
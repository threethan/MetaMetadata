C9YL4jWO5g70TLNJMJJsWNRL5SkgPF0S_GhuVw&oe=6A92D680"}, {"file_name": "STZ05.png", "id": "1283874142084201", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75542964_1283874152084200_8381873660362613557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTmF1dCA_p8Q7kNvwFRp9rq&_nc_oc=AdrfbgEtapltqpltpnNqvh1uz_PR7kzELr3_g-vtP6uJnsm7HbTV5XPc4A1UBoycs4g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZHoMGIzA7VxQQup4GCidTIUSJiHJp_CBcEhR9Pq7IZg&oe=6A92B5D7"}, {"file_name": "STZ03.png", "id": "1128014507731367", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_1128014517731366_6716068742798613670_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slOGgomxrX4Q7kNvwGBzi6G&_nc_oc=AdqHyvLGW2n4ZVwg4VFipbbjedwMN4vPLintv-OlGU7JZq6vp4e-yIbdN944z1kkRSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjJH-CSLwGyB1oX-bjnb0b88mJ7PNDYB4KRtoF7EJyzg&oe=6A92BB6B"}, {"file_name": "STZ04.png", "id": "447905820093937", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974683_447905826760603_3089029740874095363_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lpqSrQmNWsQ7kNvwGihFKe&_nc_oc=AdqB2ArOXDRlJ8xaHQ1XQBMpTq_1dhecIhTEwv2BdHp0MmGNlaphjNb3I92XtfWJnn0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDSUyK8UiWjJyNcjdSCyO9DPvk944dxWGTMsCwP2PRkg&oe=6A92C07C"}, {"file_name": "STZ02.png", "id": "312025850385364", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031421_312025853718697_1638126850915926477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPnfM0zRZTEQ7kNvwFUTNG4&_nc_oc=Adoe54-XUuQisyvYOb2F81ZcDq64s9bzeBIfx7g5thb3akFrZ5wwc7t3xElbMXaVkXY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6cRObMCSpvbK6JgKqrU5qViImY_cEYYfvZ3pEoMh4ZA&oe=6A92C501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "600422384641525", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035390_600422387974858_2735575334358700443_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnzqhNxpIRoQ7kNvwHxWgOh&_nc_oc=AdqRD4Qh-KGpMqXiIUwFr9PPe67nLgk_oGjAYqQfMF4qiSESr3XlMk-nrmHzc2rUbes&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHuUCU8Usrd63vzo6sQe-XJaLOUAsenv40VwJot4ZPkw&oe=6A92DEFD"}, "display_name": "Shoot The Zombirds", "keywords": [], "long_description": "A quiet evening on the cemetery finds you playing with your Pumpkin kids.\nSUDDENLY, a horde of Zombirds clouds the sky! Those unprofessionally dead birds invaded your piece of Virtual Reality and will stop at nothing to kidnap your children.\n\nNEVER GOING TO HAPPEN!\n\nPlay your role in the theatrical staging of these thrilling events!\nGrab your ol' trusty crossbow and Shoot The Zombirds in this super immersive, endless gallery shooter. Destroy countless waves of dead birds, varied in shapes and sizes. Build your combos to increase the score or enter the Fury Mode! Collect and use power-ups to obliterate even the fiercest of the fowl.\n\nFEATURES:\n- Endless waves of Zombirds to slay!\n- Diverse power-ups to aid you against the rotting fowl.\n- Multiple difficulties appropriate for all skill levels.\n- Local and on-line leaderboards.", "short_description": "Shoot The Zombirds! is a gallery shooter starring undead birds, pumpkins and a crossbow. Excellent shooting fun for all ages and skill levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idreams.pl/privacy/ShootTheZombirdsVR_PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Infinite Dreams sp. z o.o.", "support_website_url": "https://idreams.pl/en/support", "website_url": "https://idreams.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "inter
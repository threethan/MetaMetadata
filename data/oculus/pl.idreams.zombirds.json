A_xWgtBgwRkN12ptyMsE2z5UHTWRhfiYCGyN0g&oe=6AD3A840"}, {"file_name": "STZ05.png", "id": "1283874142084201", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75542964_1283874152084200_8381873660362613557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeuJrtrRLokQ7kNvwGXg6lo&_nc_oc=AdrMHBrc6qOBIAhVPuVe7Pq-EnojH3SuWduVg__IZ0P25zjzQLoCYqdGk-jpi7vVHzc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGAv4tvIe6x4juO6BPcwvsEEz-L8zrNB1x3OiF8S5PhA&oe=6AD38797"}, {"file_name": "STZ03.png", "id": "1128014507731367", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_1128014517731366_6716068742798613670_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWteKGayP4UQ7kNvwHiIHNx&_nc_oc=AdpAs1TUdMl7SIyvuVtiXLHrqil0X2418DVvr5niph9xKiRTFUfJ6dBSF3HkIzc3vpA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObyB441VbjZkMOtrjHoM44CVl4VWQ96pH4K7xOuIkfhg&oe=6AD38D2B"}, {"file_name": "STZ04.png", "id": "447905820093937", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974683_447905826760603_3089029740874095363_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G_AgWfInmUQ7kNvwE2ylVG&_nc_oc=AdpQxbV10VH-OEqlNz-yFdw37sgw727mmJovpmk7qmRhQ7IRFz4Y3DZhTRDBxrm8IOo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-xiuxcUXW3HdzMxxlDjG8PTTV1nnJCYUBDA1CXwnEvg&oe=6AD3923C"}, {"file_name": "STZ02.png", "id": "312025850385364", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031421_312025853718697_1638126850915926477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKEoEEjj5v4Q7kNvwG4hvnz&_nc_oc=AdrlQLas8roY85gCCI2mq0A0doy9BFWO5tQ4w2ol9RmngAYws-Zh0-a_imgdcNUllAM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoft-kuL0tYWt_8HlQCRfQQvpCC3hOvR53pDO-7C2fAw&oe=6AD396C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "600422384641525", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035390_600422387974858_2735575334358700443_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeZ6gzD3PcEQ7kNvwHS4grS&_nc_oc=AdqW85Fy9lXSSqvHQZzq93eNNQhvGnzTAwrXssdQ1hMayTZTltiCzilRXZaQavT8x7w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxfCOiursaoPLrCRzZkgNyvSUfSHYXZs9ii_UHMYpSEg&oe=6AD3B0BD"}, "display_name": "Shoot The Zombirds", "keywords": [], "long_description": "A quiet evening on the cemetery finds you playing with your Pumpkin kids.\nSUDDENLY, a horde of Zombirds clouds the sky! Those unprofessionally dead birds invaded your piece of Virtual Reality and will stop at nothing to kidnap your children.\n\nNEVER GOING TO HAPPEN!\n\nPlay your role in the theatrical staging of these thrilling events!\nGrab your ol' trusty crossbow and Shoot The Zombirds in this super immersive, endless gallery shooter. Destroy countless waves of dead birds, varied in shapes and sizes. Build your combos to increase the score or enter the Fury Mode! Collect and use power-ups to obliterate even the fiercest of the fowl.\n\nFEATURES:\n- Endless waves of Zombirds to slay!\n- Diverse power-ups to aid you against the rotting fowl.\n- Multiple difficulties appropriate for all skill levels.\n- Local and on-line leaderboards.", "short_description": "Shoot The Zombirds! is a gallery shooter starring undead birds, pumpkins and a crossbow. Excellent shooting fun for all ages and skill levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idreams.pl/privacy/ShootTheZombirdsVR_PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Infinite Dreams sp. z o.o.", "support_website_url": "https://idreams.pl/en/support", "website_url": "https://idreams.pl/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "inter
/t64.5771-25/491819239_2146414955822601_9076755540401655931_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPb85WQr6XkQ7kNvwEmzvR8&_nc_oc=AdpNhwXr0904GSukKwnLEyrLgxFzZ94KfgZEFoecAwcYJAahe5iwj_i0YdMozeTM0VY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT0tmysgUDsuXzngTCDfXi5h2XvidwYvcMDOqm0Gljhw&oe=69C7B49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover2.png", "id": "1350425882713220", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819311_1350425886046553_269593922773459254_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2eXcrQqH4QQ7kNvwEVuxGw&_nc_oc=AdoC12lkFuDXkmx_Od2pSG1jj2s89Y5bGychoMOh4ohyZ2Ic5m5tQrOIIskIHh2CIM0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5qhCrtFjXVoemv-RHhu8WM0v547mrUAwhF5-z_QIRQQ&oe=69C7C24C"}, "display_name": "Bad Boy Simulator Sandbox VR fighting", "keywords": ["fight", "gun", "shooter"], "long_description": "Step into the shoes of a true outlaw in Bad Boy Simulator VR, an intense first-person fighting and sandbox game designed for VR!\n\nFeel Every Punch!\nEngage in visceral first-person combat with realistic physics and weight behind every hit. Land crushing punches that make every fight feel real. Whether you\u2019re using your fists, melee weapons, guns, or environmental objects, every fight is satisfying.\n\nBreak, Smash, and Destroy!\nIn this game you can destroy tons of objects in the environment! Smash furniture, break windows, knock over street vendors, and leave a path of destruction behind you. Every fight leaves a mark, every action changes the world, making it a truly immersive playground for your inner bad boy.\n\nExplore the city!\nExperience a Mediterranean-style city, where every alley, plaza, and street is crafted with care. The sun-soaked architecture, narrow winding streets, and bustling public spaces create a lively atmosphere\u2014until you start throwing punches and smashing everything in sight! But what is a city without citizen? NPCs have unique behaviors and can react in unpredictable ways. Want to pay someone to do or say something hilarious? Toss them some cash and see what happens!\n\nSpend Your Cash!\nYour hard-earned (or taken) cash isn\u2019t just for show! Spend it at the local club for some well-earned fun after a long day of destruction! \n \nMATURE CONTENT WARNING\nPlayers can use lots of different tools such as melee weapons, guns, or bare hands to harm human-like NPC-s.", "short_description": "Bad Boy Simulator VR is a chaotic first-person fighting and sandbox game for VR. Set in a Mediterranean-style city, you play as a ruthless outlaw, who collects money from beating up citizens, destroying valuable objects. Use this money to upgrade your character, interact with NPC-s like dancers at the local club. Engage in brutal street fights, cause mayhem, and explore a city where you decide how much chaos to unleash. Fight, destroy, escape! Be the bad boy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://catmoon.co.uk/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Catmoon Production Ltd.", "support_website_url": null, "website_url": "https://catmoon.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24230717406526523"}}]}, "scheduled_offers": {"count": 6, "nodes
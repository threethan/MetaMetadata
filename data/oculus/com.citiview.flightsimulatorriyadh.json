t=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcoH7pO0bDwQ7kNvwG9do7k&_nc_oc=AdoZzw2oPxtAfyKsIc0uUQodJHtgB64j_QMeU84Be_nuP_GaMl1jE0Yl9Xh3iYn5ODk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmVW14d76NCSyPvCiPu7yZe7_diEKPGq4LOVsRc_VeCQ&oe=6AFDC9B7"}, {"file_name": "screenshot_4.png", "id": "982188798282130", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_982188801615463_141867466413868415_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I75Uw2C5Ok0Q7kNvwECBC82&_nc_oc=AdpE6KsOWQVHBIGzoyX2Qxawoqvd6VXr6oLUUWlmFyRsNw5T0YTLgwKyQ3kLQT0sQN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgfAD63A1NdWfTT9JpMRZ6yIS19DcueN4lTEmHiTVAkw&oe=6AFDAEDA"}, {"file_name": "screenshot_5.png", "id": "2223789374852872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_2223789381519538_3775617191335042837_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EJCqFPdSo8Q7kNvwF9j9RV&_nc_oc=AdrHtp1QF_WxC_fDFsEjT_6IsNQ1YDXblT4h9Tmf9nC8WpWlqIpfGva9V3D89wDGMD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP6rp5IY39bxhygL84cwQm8_Edm6lQQR5EoTzd0Cr_ew&oe=6AFDCE3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2133330840588143", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_2133330843921476_4482384886095610509_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xEFb8kL4UIQ7kNvwGX8BaW&_nc_oc=AdqpMtxRMSvrfSmbdISXzI6GTbPZcy4frI5lZO-0eua0oB9tw5mzi6OtomRQODp8Ydw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhCwN55ZlK1839dF89m7MRCTmrli0KVF4h3Sa5mMz2qQ&oe=6AFDE476"}, "display_name": "Flight Simulator Riyadh", "keywords": ["flight", "simulator", "riyadh", "jet", "pilot"], "long_description": "Flight Simulator Riyadh puts you in the captain's seat over the real capital of Saudi Arabia.\n\nTHE REAL RIYADH\nReal satellite, elevation and map data: the Kingdom Centre, Al Faisaliah and its golden globe, KAFD and the PIF Tower, Al Majdoul, the TV Tower, the Water Tower, Masmak Fortress, Murabba Palace and the National Museum, the Ministry of Interior, King Fahd Stadium, At-Turaif in Diriyah, Wadi Hanifa and the Tuwaiq escarpment. Airports: King Khalid International and Thumamah.\n\nA LIVING CITY\nAll six Riyadh Metro lines on their real tracks, SAR trains, traffic on King Fahd Road and the Ring Roads, airliners over King Khalid. At night Olaya and KAFD light up.\n\nFLY THROUGH THE KINGDOM CENTRE\nLine up on King Fahd Road and thread the sky bridge opening.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar at King Salman Park, the skyline in the doors at sunset. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nKing Khalid and Thumamah approaches, a low Wadi Hanifa run past Diriyah, the Kingdom Centre, the Tuwaiq escarpment, a fighter scramble, Riyadh by night and a city tour.\n\nENGLISH AND ARABIC\nMenus, settings, missions and messages in English or Arabic.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky. Voice chat stays off until you turn it on.", "short_description": "Fly the real Riyadh, built from real satellite and map data: the Kingdom Centre, Al Faisaliah, KAFD and the PIF Tower, Masmak Fortress, Diriyah's At-Turaif, Wadi Hanifa and the Edge of the World. Thread the Kingdom Centre's sky bridge opening, take off from King Khalid International, talk to air traffic control and fly private jets or a fighter. English and Arabic menus. Fly solo or online."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorriyadh/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorriyadh/", "website_url": "https://ci
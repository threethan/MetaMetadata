5", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b21RnN2xfNwQ7kNvwFN53Py&_nc_oc=AdpvBLMsAvFKuYKSe-jVD852QVDOvDiaACwIllDFti5PcQoCOaRmK0wJPnyTOXaT8aU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TvuU7TBAruwQYsDAX_87oxX5JZ70n131naej4w-w0xA&oe=6A467900"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEUpPvkp-kAQ7kNvwFE5gwT&_nc_oc=AdpUjgm_YUAksIuT3M5w6MDTYcYUVp9I0WAKHyu9GjSrKj3wS20dHXClGrQP8cdSnNE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8chuXYX74D2fgFIZTQHCDBAuxCs3za57ulCmbj0gwlxw&oe=6A466F50"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwDHXMSIK3AQ7kNvwHucLAL&_nc_oc=AdrExfN6CRZ6EidldfL6uy8Gg1r8wSqy6ZrbLEWiUXO9h8-NvboFb99jD1NlREPpKZc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N4MQTVJt0S3fiXoEeHKa45LBeR6M0OQr9DTBdra_TTg&oe=6A4689B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stimulusvr.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.stimulusvr.com/eula.html", "publisher_name": "Stimulus Immersive Content Studio LLC", "support_website_url": null, "website_url": "https://www.stimulusvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2687655338230691"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "580212787199687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001671_196904179277848_4553172281138711071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVZgUWQoC8MQ7kNvwHfheu9&_nc_oc=AdrDc8kv0MPiCQm9Xam6cpHIKVKTpoAgTmmvycXCOILZ5ae2aV-bPftBlEy601uDmEE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kzCNTABvCoonOzNiLJJB0oRUEJezp0wypVKBar55imw&oe=6A467EBF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stimulus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Events", "id": "2687655338230691"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1669934766, "las
uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HuqwIbhT28Q7kNvwGwM5Js&_nc_oc=AdkTtpsrLEmW5gOeABcq_eb6hlARhSxPTiLmrcc9XDxZJM-BbgpY47DSDoXKTNztXF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYkAzm1raOQKZAHoo1jo8X0wRIz-p0cDpX-nwqRuW03A&oe=69B42280"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZjct46TNM4Q7kNvwFsc1R3&_nc_oc=AdlG5EaF0WDdA9ydVPt9zfIn5qoGVRfBU4dKXTkySJjuOHb-Zzpl3Q8n6sanX4_0ZSw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxLM-2hUKIOVFmIHk-umDAX3DediJcsPVXgtzDguQI0Xg&oe=69B418D0"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-67Dut_SESwQ7kNvwEwZuwI&_nc_oc=Adk0qFfzjoAPxkAl-oADZnozqvXXCQJhMJ0YG5Jq520N5AsfBoLqUM2wVhebRlOy1po&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiDlAZOJMmqYb427EiFVNmiIKkzd-o9rFTVVYhIy1lZA&oe=69B3FAF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
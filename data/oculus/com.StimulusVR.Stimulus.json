uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3g4_qaZam0Q7kNvwHoNvbU&_nc_oc=AdmYGhTYwZiifoZVLH8KW-Z3srfkpzTK6tDSD0FOxYE0-g7BPwN31CPpDGSP6rm93HE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyRoFYU3fB5Zdb8knOa1bqUioE2si1kgoDng6GAhCy2ZQ&oe=69BD5D00"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-t1LZMmRDlcQ7kNvwGnXrDS&_nc_oc=Adl7Lx-CnikTmOt_Cy1eTX-zcBDxz16KUWeHcACyyGKnNHgJpPWGwubB6-ZvboOIzP8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0DlLjiQSsGaMR8ceeNx13mbepNMNLy9zC3DRmOlZwVQ&oe=69BD5350"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqsakSCR580Q7kNvwFJNlU0&_nc_oc=AdmrsTMXCP6_cSkQ1yo13eEnFAc5j1SJUHzxRjoDoVeoXsSDU-oocxaTt7H9fvgpk6o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3uA9w_3hmq_nONDw5uzcKJ5TaW27otjXvzigxr4Jjaw&oe=69BD3578"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
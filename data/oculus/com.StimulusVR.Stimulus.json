uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8skIheX6eKEQ7kNvwHI74l0&_nc_oc=AdkEZJidEz_lxWsfX-UWdsTyQ90B---4X7pE-tcRxaZyAj9Jg4cvz7UXY61t6N-CGwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDb7UFMc9O00E8wWTmI5X4C3pmhLW1suGH0M2dabVruA&oe=69AC0140"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QX86ABNMTUQ7kNvwHhIRrm&_nc_oc=AdlTNJD-QZ_PJQYMgetzfKYIxr7q6G1Q8qOelWkNFsGR3vDFKjkykR6L1VCryGxxmWk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwbrNwp7BEUdnoLU1VPb78QOVZU57XUS-vqaRSybsJ-Q&oe=69AC2FD0"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lT2u0rHMDAQ7kNvwGVE1vK&_nc_oc=AdnLDmt2kAqwxPol8TJHQ7sCisumpcXTx4djURmKhHY5ONT6mbeecZ2soK5HyJKILcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxxwnke_z6EFnV9YfphWEfIlHcUtTss9skt7hBhTl76rQ&oe=69AC11F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
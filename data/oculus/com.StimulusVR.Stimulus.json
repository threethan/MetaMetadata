uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9BAitQUqsEQ7kNvwEXem95&_nc_oc=Admj6Tnuv2KYG30ULok84qZQ0gq05731yf1HTrNkW5F-mlStnq_SOX5-Fx9eqfNdfaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKbym45x9eAapDjOamp5XlpI9Kyi4Lh80LTGQnXH_Iww&oe=69AFF5C0"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d-_UyiiTxwQ7kNvwGi8Rxr&_nc_oc=AdkqwSpsYwVtD-1S6iJPYUHOh3SVRpS6bQVnyN1B0oCmizYlq09KxdL3Ej2ynIlBtvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1Ld_I4rCjUCptlk6m4TcSFRlucGEpC5iYmzMbPQ3mVg&oe=69B02450"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjmiiPxA1UYQ7kNvwGzTp-9&_nc_oc=AdkDUfmWHA8VYr6tCWezQtSXe2SWQQ8iBe_o8LWPbUbEK7_RVu8Snm9Bnr2gpNhsi8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6eXTlrUuEt_tey4WSk1-UCrw7-Z7kYyIDboWXtz9i0w&oe=69B00678"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
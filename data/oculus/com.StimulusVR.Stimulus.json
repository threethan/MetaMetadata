uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8skIheX6eKEQ7kNvwELOuX8&_nc_oc=AdkQbewdeoYDcM_-RsDaCJ7-zJ6r4O_25-hG0foQs2wS2VyoLuNY8nZ4EpLoDfK0jy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsqbydzzX6yzy-mI0a0oeLEpR05ooRXzxLuIRu50v1Pow&oe=69A99680"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QX86ABNMTUQ7kNvwGmwRCF&_nc_oc=Adl7fZeSInZy26g4446FYX-aJSs8iKud3HY-X3OYbC75Nspcu3wpmTjFjTAXp0QhX8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvhVWpXpRJ8xkztniHzt-TMVbhER1vn0fG06jk9Jo88IA&oe=69A98CD0"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH9GUEF9ggwQ7kNvwEctHid&_nc_oc=Adn9cE6vao55j-z7TmdeAratd0VGjQu0A4gDPDGDdP0Lv_jijJ4etNjqJ-c5bfpEj_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvGe2SemmGr4bx_cokrIunF1PtbkqEqtxJPiRmjeYkm-Q&oe=69A96EF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9BAitQUqsEQ7kNvwH--LxD&_nc_oc=AdltnPRqV8bVOcTSouwETbo8DE9d2e-d2FgUOwDvyHGWeB_ayj70_NGTr9lncxQsUrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtewTqQfBA6DTPwIOe3gydsUIlQ9gJFWXvYUpC3uaLQw&oe=69AD52C0"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d-_UyiiTxwQ7kNvwGgsllh&_nc_oc=AdlggzR1rSLmiH7NBbNezlv_uFfRfATsgsivZV5Tso3GF66GcIp9x4I--pse_K0fHyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPaxd67rMRlaLIpDT1qQ2GI-jfUmklxaX6Cx65_c78Xg&oe=69AD8150"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lT2u0rHMDAQ7kNvwFkoku7&_nc_oc=AdlNnM087CxJpCrc6sUzGvP_UdauPlYBW5E1FAI62za5dchX4D0LfFVNr-Y1AaaJDqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu9raqy6yAxsktcRcTMO_kiM54vExXhHBx-V9ZxvEf8w&oe=69AD6378"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
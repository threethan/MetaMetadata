uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3g4_qaZam0Q7kNvwHQJ-YY&_nc_oc=AdmbGaiDIQTdh8SYlDABjlRXI91tmzDRggdGKse9YRqWAYqePPyUuCJMdbdX51UDi8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCC1cC3_GAR66OngNouOBzais3J6L8DXlqMlgb9u_Q8A&oe=69BE7640"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-t1LZMmRDlcQ7kNvwGozxV_&_nc_oc=AdmI7yHGKhkLQliWtxyf5yR6PyyeKTRH9cC39miL7MZe-nKuNa6Ki7nRCVEUqKxwMKo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuIyH206VhBV_MEgxkFJnMHERhj4zT1vpvl0wNkOQ3pA&oe=69BEA4D0"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqsakSCR580Q7kNvwGE3iJj&_nc_oc=Adn4m9zSEknUaIolmA9vgkNl9nxJbkr-pzF4zrV6FvIXn3D-TY66ENdezxjcVU4m_Ok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyMGkhSrbqlcOj02wniBUmrIRXI1B8cxxwCawZ9uPXfg&oe=69BE86F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
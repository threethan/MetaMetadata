 training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stimulusvr.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.stimulusvr.com/eula.html", "publisher_name": "Stimulus Immersive Content Studio LLC", "support_website_url": null, "website_url": "https://www.stimulusvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2687655338230691"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "580212787199687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_196904179277848_4553172281138711071_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM3DIK-G6NQQ7kNvwEnhWYe&_nc_oc=AdrGaFYNXqWKvXiVeuP9QYSLgg83JQJzOQFgT-xWKnycgCh2xlj-CqJctRHx9-pOO_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScvq4wf9ZNZiyBD0VCpFFln9oP7dep8KOcfXxzxZ7BGA&oe=6AFC6DBF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "St
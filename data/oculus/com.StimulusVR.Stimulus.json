uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5s_falVVxYQ7kNvwFTf3Kq&_nc_oc=Adl2YydKCOjY4w3-1YDaxreHz-m6sz-0d0gqp1BeDlWLULH7LZroxe4dxNomr1VOf-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp7FME1_9MloaLCAtZ0RB3gRLAJ8Td12PPFguW8OLppw&oe=69B53BC0"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzdqzH0YRC8Q7kNvwEhTJB5&_nc_oc=Adll4hLbxFEAlC2Fj5NfHnEXZCpcRKNcOPz5Y-5z2wLxzfPUcf2Enx_IFo823y_Wdks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9zJNtpc_mrkKup7G6l176rK_8MqswLwaeKqqUZaTEnQ&oe=69B56A50"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-67Dut_SESwQ7kNvwG0B5Wc&_nc_oc=AdlcEve1Tx0qwWX9Hin5VXycKRm_f0yTRlVik3Iiy89S3AwTH0A8RuY2HikQ94wHlpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQxrGeVFAId-h0L5DYXSZ2Fv8lbE2xU-h3hUfBskqHxw&oe=69B54C78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
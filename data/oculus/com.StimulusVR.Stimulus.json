uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiDlfFf8Z3gQ7kNvwF87wY-&_nc_oc=AdmNHelkafNIEkoY60HazP_ks2klNUNOYc8PR2-jy4ABwwDriUilVT306q9XXt9vPbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcAGb6E-x1qQCteVbrxYSPTcmqmfxwZHqSlmt_C6odHw&oe=69BC0B80"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw8No7djTNsQ7kNvwFqFAl7&_nc_oc=Admf4pl__Z3FaF-kiH1SgxMtbJFTJmXYjJC2I5BxqKxkcegLR1YD_WtA6EV3WTX8nTw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afykck80ROTDMe4oW77arbxa2IZlGA8iw4PJTfcKKOi0xw&oe=69BC01D0"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqsakSCR580Q7kNvwGws_IX&_nc_oc=AdmQF67BXj6S9bpw94WEYOacyhhun_q6RTDDPqCfeAeRBiSZA-kD9-2P83fstp5tWg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxr-E_r1OxNgScTQBb4zMIshfUt1gJvIZASAwePBNmxNg&oe=69BBE3F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
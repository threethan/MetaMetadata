uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5s_falVVxYQ7kNvwGauapF&_nc_oc=Adm1h-9IA_4IS6VQvZN8TtqJARlZAgOR7ZG9VTs9ZNafUNl1iOSP4Ycqnb2Th9AGFx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzm5r43ybkkkppBA_l364-G4a46_pp5cDiRPdLcYCSg1A&oe=69B68D40"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzdqzH0YRC8Q7kNvwFH1Kv6&_nc_oc=Adn5bg81L-FozJ-g92GsF_I898Uh6xO9UQB1LntDpoP_tfjpMykVuvlZm3aFFpmpyBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5paOeKgniISPZrQ-POCGJhOhLTgE3E2uNdpXkBS_MVA&oe=69B6BBD0"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-67Dut_SESwQ7kNvwGTQlRG&_nc_oc=AdnW-NjbGFaMNxUeOi1jYnGUk3XvIufqjKIUAL_alijqQmEFsb-P8xhsH0sk3lu-xr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTkB7HSCdNsXg44yO8LOYgXkULVHVZm7xsMUeWGg0JHg&oe=69B69DF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
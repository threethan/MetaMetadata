uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9BAitQUqsEQ7kNvwFAKdWE&_nc_oc=Adk8qiBDB-sazRxEO-qskUlyPOmFFjvJv0Zs3T8aNaagwZ2zY5-6kDdKh7H5Yt_Iq-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNNv0LHMsvl6-lQYNAaNuuZQEsaF6TCEIASiPgmOb58w&oe=69AEA440"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d-_UyiiTxwQ7kNvwEckmZ-&_nc_oc=AdmD69v-HRVZ9a3mXmR3_QUhN4JBjWF3EDt6pJTeUnGn3dwPxIe_fBi8ix31oOL2Kp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpuNWRekQeRq6fjUlz3P1DZ0R1LMDFq5nWLHD5SDpWdA&oe=69AED2D0"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lT2u0rHMDAQ7kNvwEqAs1o&_nc_oc=Adl5wctzi3bgg5J6uVbbiAZ2h7qOhKINFeuTlA-OQp5Lt0Im3lcgteHzY8-c8tX9wqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjnFD3fD1jmKHg_ixaffI0hmlrp67MbFA5MZ_Gu7zjiQ&oe=69AEB4F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
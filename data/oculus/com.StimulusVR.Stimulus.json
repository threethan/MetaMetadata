 in collaborative learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stimulusvr.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.stimulusvr.com/eula.html", "publisher_name": "Stimulus Immersive Content Studio LLC", "support_website_url": null, "website_url": "https://www.stimulusvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "2687655338230691"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "580212787199687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001671_196904179277848_4553172281138711071_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwe8EEKqIXAQ7kNvwFSIM9c&_nc_oc=AdoAa1ye5qSjScVbwA8Xfzagk7NH5Lh0-DtG-1VPr8z2M5RH8xuyX4rreEZryu2HXi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_9EnNVou-Kn1tQ5Qu6s6UmRyw8S-K9Qktv6gK4g85Cw&oe=69CE4DFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stimulus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Events", "id": "2687655338230691"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1669934766, "lastRevision"
uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HuqwIbhT28Q7kNvwHQOMqQ&_nc_oc=Adlpfrp_FEI0Ef_0uLFFvWCNKio60U4lDF3adxBpw6LZUl1joSkQnicOmGJtVloHhkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyNWc9i6q3-WCFPB0O8yVNk_yNJHJqI9bZAhrMNenhhA&oe=69B2D100"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZjct46TNM4Q7kNvwEJ2xto&_nc_oc=AdlsfT8qAwZ1tclJaQC9k08Z3fHc-_5I0YPaUpO-KpRLMaz2ffOwCHrB8WiQR4Y4ZNk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4EsC7oV2uy7cUhUCxXY-PB8so8eF9qPhY1dpwOLLDdA&oe=69B2C750"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjmiiPxA1UYQ7kNvwHOjUYM&_nc_oc=Adm-G7Ho7qNCs-741KgAMSJ8jKKfqcOxZ8vZoT8fd578pYbW1cmt-RkJGXC9GQhApRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdkB-NAEblU0iNug7cgagPbWv0vc8L96TKbVwwJkWlxg&oe=69B2A978"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
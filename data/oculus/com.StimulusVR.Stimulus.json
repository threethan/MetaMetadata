uscdn.com/v/t64.5771-25/75462957_2495873440566781_1382477657864132648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiDlfFf8Z3gQ7kNvwENTl3P&_nc_oc=AdmINkc87aOIihjiAgFortgytJguv_2LtWIfbJrgAIUC4U218WdlNZE6s9JNcyZChjg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzlI7IG7sExZB0uW4s5AY2BhSi0lM5mHqG0n6rTRH6VUA&oe=69BA81C0"}, {"file_name": "vr03.png", "id": "6287626694597982", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_6287626697931315_3829237236397938044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw8No7djTNsQ7kNvwGqjqLQ&_nc_oc=AdkBqq-TTTLwa822F90ah02M-7XDoTliZKcPe-cY73aHoU9waTdZeZ-8Kf8ORKf7ub4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJwrUeF3tzQ6AH68OgVD4GDHtGOKHZN0bxAT9Xd0dNJg&oe=69BAB050"}, {"file_name": "vr05.png", "id": "1179811005972782", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75339313_1179811009306115_6432136340677436936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XZP9tbM20QQ7kNvwGKBhss&_nc_oc=Adm8n7v4nU0XDPFSoCcZnwXa-Ft6yARlZyeawzLdG8_CtyoJsV98lm0efQnieGxzqIk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwAznHJpnnAU3jiE1dIklkf8YxSTmv1x6lIyaISpmvcDA&oe=69BA9278"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stimulus", "keywords": [], "long_description": "Stimulus is a new way to learn that challenges traditional methods of e-learning. Stimulus is a social platform where people can explore, create and share with each other. Stimulus incorporates the most up-to-date learning theories in a virtual environment that allows learners to collaborate and share new ideas.\nHost training classes, workshops, conferences, and presentations in a private & safe multi-user environment, no matter which device you are on.\n\nAVAILABLE ON: \nWindows PC ( VR and Desktop Mode)\nOculus Quest", "short_description": "Stimulus is a cross play VR / non VR education and training platform that focuses in collaborative learning."}]}, "developer_name
UOb0F54dJDut0q2h5jIw37h_Is8_2MjNQANEBqbdOe7IgJJ5fg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtutQAp5NIL790js__-sapGEqjg6he4bBpiQ-HhJghXA&oe=6ADCD7A0"}, {"file_name": "ChloroEAScreenshot - 6 1.png", "id": "1018463457271631", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827626_1018463460604964_5051656641390661288_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-h6UDsLNEwQ7kNvwGeCm02&_nc_oc=AdoMNf1_EVczqmu-Q6iDwY9AvrbKs9MVutihICfppvPAJoY-94vbj9YXwfV3of8ktrU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3n6aFI7pApguatNErnfWZIuTjcbowe6Td1iCMhRtmlg&oe=6ADCC649"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "chloroherobg.png", "id": "1233563719836450", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593845024_1233563726503116_6987591742962310019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sfFxmMLuh4Q7kNvwGBVqxx&_nc_oc=AdrWHoggU4H6VE4OjLEBXOa_0tO2oPyxYosuoIWjYrxS8DOIN4e3kZ_ND72yGPlRW5o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8Liqho-HlgDBIvr9DllPwrNjG7vjpDiEyjNWuX3iA0g&oe=6ADCA66F"}, "display_name": "Chloro - Houseplant Care Tool", "keywords": ["plant", "houseplant", "garden", "gardening", "decor"], "long_description": "**Chloro is currently in Early Access. More plants, features, and polish are on the way. Join the Discord for feedback, bug reports, and future updates:\nhttps://discord.com/invite/tcqMga2uws**\n\n\n# Plan Your Indoor Jungle\nChoose from 30 houseplants, with more coming soon, and place them anywhere in your room using hand tracking or controllers.\n{955563250711479}\n\nPreview your plant setup before buying the real thing, rearranging your space, or committing to a new plant corner.\n\n# Check Plant Health\nPinch the plant label to open a care guide with lighting insights and recommendations.\n\n# Customize Your Plants\nAdjust the plant to fit your space before buying the real one.\n- Resize plants\n- Change pots\n- Rotate or delete plants\n{1009510518085870}\n\n# Add Grow Lights\nNot enough sunlight? Place grow lights to improve plant conditions and instantly see the effect.\n{2095370171194943}\n\n# Experimental Feature\nPinch and release near a real plant to estimate how well it may be doing in its current location. You can also use Chloro to help track watering schedules.\n\n{1467210054592471}\n\n# Save Your Layouts\nLove the way your space looks? Save your setups and load them anytime.\n\n\n\n", "short_description": "Take the guesswork out of houseplant care. Plan, design, and maintain real houseplants in one app.\n\nChloro uses your room scan, window direction, device time, and location to estimate indoor light levels and show how well different plants will thrive in your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/4d204f05-b31b-4801-b402-c21de2bd888e", "developer_terms_of_service_url": null, "publisher_name": "grassepark", "support_website_url": null, "website_url": "https://chloroapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27601977832803011"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310646_1024580763519088_1513692056547626415_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psPJ_JUxVUwQ7kNvwFNmcGj&_nc_
scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491825546_868369192288311_5820880628795712700_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS6xc1Xw8gEQ7kNvwE7saH-&_nc_oc=Adplp6RGY9UBsLJuAASesK51LlLxNgIkFh_fxH3XJYj9Pp8O7WJqkaAZZ3Lx-W13gwc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeeJb98gWdr7gTdKSlI7Gcr39mJe2_nvh6fQ1CwKYsxQ&oe=6A940C81"}, {"file_name": "ChloroEAScreenshot - 2 1.png", "id": "2231193857650672", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491828104_2231193860984005_3955845176992985210_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gnukh_03v4Q7kNvwGxRxzK&_nc_oc=AdrNiI7svCwuL7S4F2Gvlk_FNo0WEiTRg4a2d2oWgrLxMcahrXsdiDVEXc0fniEhhYc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGLXoLcGh4IEtUsYCi2JyuZ1U20pZUhXGBaEsmA5eLVw&oe=6A9402A7"}, {"file_name": "ChloroEAScreenshot - 1 1.png", "id": "987250140463505", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823949_987250143796838_1044562795842635196_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQppl5cj_OcQ7kNvwEp5cTx&_nc_oc=Adr3vdtxT__m3rR6s-TrmQ89k8KdSzED44HUcy4aJ1FEVl9Ot3ad6YQmgVkzFSqp9vg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNZSF4pkk5y3ncie0oFRObbZeHx51DuxYkYAiq8Apzqg&oe=6A941CE0"}, {"file_name": "ChloroEAScreenshot - 6 1.png", "id": "1018463457271631", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827626_1018463460604964_5051656641390661288_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ2WTRSyMq8Q7kNvwHIuGMS&_nc_oc=Adp-Ar6fvknS3LKQ_Pc2TlO2sRhWclVclyI6uSg4PAL0KhvwdRhN2E0DIUukNc13PX8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrC6OZN3XGdQvYkGJO-8cgBL5xfQbMDZmlB8tEFTdmuQ&oe=6A940B89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chloro - Houseplant Care Tool", "keywords": ["plant", "houseplant", "garden", "gardening", "decor"], "long_description": "**Chloro is currently in closed beta. More plants, features, and polish are on the way. Join the Discord to share feedback, report bugs, and help shape future updates.**\n\n\n# Plan Your Indoor Jungle\nChoose from 27 houseplants, with more coming soon, and place them anywhere in your room using hand tracking or controllers.\n{955563250711479}\n\nPreview your plant setup before buying the real thing, rearranging your space, or committing to a new plant corner.\n\n# Check Plant Health\nPinch the plant label to open a care guide with lighting insights and recommendations.\n\n# Customize Your Plants\nAdjust the plant to fit your space before buying the real one.\n- Resize plants\n- Change pots\n- Rotate or delete plants\n{1009510518085870}\n\n# Add Grow Lights\nNot enough sunlight? Place grow lights to improve plant conditions and instantly see the effect.\n{2095370171194943}\n\n# Experimental Feature\nPinch and release near a real plant to estimate how well it may be doing in its current location. You can also use Chloro to help track watering schedules.\n\n{1467210054592471}\n\n# Save Your Layouts\nLove the way your space looks? Save your setups and load them anytime.\n\n\n\n", "short_description": "Take the guesswork out of houseplant care. Plan, design, and maintain real houseplants in one app.\n\nChloro uses your room scan, window direction, device time, and location to estimate indoor light levels and show how well different plants will thrive in your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/4d204f05-b31b-4801-b402-c21de2bd888e", "developer_terms_of_service_url": null, "publisher_name": "grassepark", "support_website_url": null, "website_url": "https://chloroapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUI
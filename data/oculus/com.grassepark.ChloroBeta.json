scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825546_868369192288311_5820880628795712700_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8MBHPA-sCAQ7kNvwGZ6OSc&_nc_oc=AdpmZ6pEAkJ-GllDUp9mFagRT5_Ke2L5vIzgGYeZcLzQFj_JJvLPvrWNTI6PCbGEi8c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlH4ZTR1ORbikrVT4bSIe-sELarp9LC_6FUR8kl1_jSA&oe=6A819781"}, {"file_name": "ChloroEAScreenshot - 2 1.png", "id": "2231193857650672", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828104_2231193860984005_3955845176992985210_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIp3DpoaDVoQ7kNvwFtLpXM&_nc_oc=AdoxSg1TvFnEYtzOTy5rbgyKeqGbG3qN538bpouv9G1UDWzPP9bOdRXkuiGHEQfYzkQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC_0jM7k3nq-h4zm_9Us5MnHny884GPlOhJdQWrFXRbw&oe=6A81C5E7"}, {"file_name": "ChloroEAScreenshot - 1 1.png", "id": "987250140463505", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823949_987250143796838_1044562795842635196_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWG3qvKmCqEQ7kNvwFX1q_W&_nc_oc=AdrQC5_a8X5ISNp0pPiPtDsqfVI23gpBBSBYMccRLVpm7zNd8M7OIBJ9iT-IENnIRnU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqxQw6TZ-fysAqqsVOK9VH5mxn5OiGkbLMVVbQPtKPXw&oe=6A81A7E0"}, {"file_name": "ChloroEAScreenshot - 6 1.png", "id": "1018463457271631", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491827626_1018463460604964_5051656641390661288_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdqPgQC_wygQ7kNvwH7HbtR&_nc_oc=AdqYXDorQDMFLSQ-4zKtD-AB2nJ5DcJP9iisGQ_8RpglJ3k2HmOtxAodP_YpQLIi5ZE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuJ7OEABS7L49QzHu4MKDe2y71BBCCktUeDM3Um4rbog&oe=6A819689"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chloro - Houseplant Care Tool", "keywords": ["plant", "houseplant", "garden", "gardening", "decor"], "long_description": "**Chloro is currently in closed beta. More plants, features, and polish are on the way. Join the Discord to share feedback, report bugs, and help shape future updates.**\n\n\n# Plan Your Indoor Jungle\nChoose from 27 houseplants, with more coming soon, and place them anywhere in your room using hand tracking or controllers.\n{955563250711479}\n\nPreview your plant setup before buying the real thing, rearranging your space, or committing to a new plant corner.\n\n# Check Plant Health\nPinch the plant label to open a care guide with lighting insights and recommendations.\n\n# Customize Your Plants\nAdjust the plant to fit your space before buying the real one.\n- Resize plants\n- Change pots\n- Rotate or delete plants\n{1009510518085870}\n\n# Add Grow Lights\nNot enough sunlight? Place grow lights to improve plant conditions and instantly see the effect.\n{2095370171194943}\n\n# Experimental Feature\nPinch and release near a real plant to estimate how well it may be doing in its current location. You can also use Chloro to help track watering schedules.\n\n{1467210054592471}\n\n# Save Your Layouts\nLove the way your space looks? Save your setups and load them anytime.\n\n\n\n", "short_description": "Take the guesswork out of houseplant care. Plan, design, and maintain real houseplants in one app.\n\nChloro uses your room scan, window direction, device time, and location to estimate indoor light levels and show how well different plants will thrive in your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/4d204f05-b31b-4801-b402-c21de2bd888e", "developer_terms_of_service_url": null, "publisher_name": "grassepark", "support_website_url": null, "website_url": "https://chloroapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUI
scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825546_868369192288311_5820880628795712700_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fknenuYArcQ7kNvwElvJaB&_nc_oc=AdpEcr-ZBfosxR2lgcRX3fh8gVa2hegRa12tGwp3dPo1gOstOVoT3tFG5hy94W0yQpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY00h9is8c0AsaioQMdKeMce4s0_m6tX6Vj-tK9dfPkQ&oe=6AA56841"}, {"file_name": "ChloroEAScreenshot - 2 1.png", "id": "2231193857650672", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828104_2231193860984005_3955845176992985210_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKQLEacY8NMQ7kNvwFA2PER&_nc_oc=AdpNEkTveJb5SvrLwscqmfaIMt42Ij6aqW2sQOdupMjoQHMJylcvG7PVMZeOdDhbs0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_OQDm5eheTSnurOlXFhDd8kcl4N3Wxue4bUOeWGIqDQ&oe=6AA55E67"}, {"file_name": "ChloroEAScreenshot - 1 1.png", "id": "987250140463505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_987250143796838_1044562795842635196_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqkRfjopBX8Q7kNvwG2t_5D&_nc_oc=AdqlRSYoBvflCf66lDmUpGrPA0AGEB0rqEiM_bPPZnmcbuO9KWULHBa8CvrMb0I1zyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLygbvxeAkdn8rlCZ6BUiG46v7DQSio7cJk_Ftxod5jyA&oe=6AA54060"}, {"file_name": "ChloroEAScreenshot - 6 1.png", "id": "1018463457271631", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827626_1018463460604964_5051656641390661288_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOO_OvURGQwQ7kNvwEXAXKy&_nc_oc=Adpchc2zSjQYrZT1Pk2hR5HjudIoxe8Y0bR9KJMS2b11VI4bhaS8UpL5uJOFRrIOw8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKzbQJqaxFSV1Umgn1cgb1pKYvODcQeMekwtlQ68W9jQ&oe=6AA56749"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chloro - Houseplant Care Tool", "keywords": ["plant", "houseplant", "garden", "gardening", "decor"], "long_description": "**Chloro is currently in closed beta. More plants, features, and polish are on the way. Join the Discord to share feedback, report bugs, and help shape future updates.**\n\n\n# Plan Your Indoor Jungle\nChoose from 27 houseplants, with more coming soon, and place them anywhere in your room using hand tracking or controllers.\n{955563250711479}\n\nPreview your plant setup before buying the real thing, rearranging your space, or committing to a new plant corner.\n\n# Check Plant Health\nPinch the plant label to open a care guide with lighting insights and recommendations.\n\n# Customize Your Plants\nAdjust the plant to fit your space before buying the real one.\n- Resize plants\n- Change pots\n- Rotate or delete plants\n{1009510518085870}\n\n# Add Grow Lights\nNot enough sunlight? Place grow lights to improve plant conditions and instantly see the effect.\n{2095370171194943}\n\n# Experimental Feature\nPinch and release near a real plant to estimate how well it may be doing in its current location. You can also use Chloro to help track watering schedules.\n\n{1467210054592471}\n\n# Save Your Layouts\nLove the way your space looks? Save your setups and load them anytime.\n\n\n\n", "short_description": "Take the guesswork out of houseplant care. Plan, design, and maintain real houseplants in one app.\n\nChloro uses your room scan, window direction, device time, and location to estimate indoor light levels and show how well different plants will thrive in your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/4d204f05-b31b-4801-b402-c21de2bd888e", "developer_terms_of_service_url": null, "publisher_name": "grassepark", "support_website_url": null, "website_url": "https://chloroapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUI
ad6-1.oculuscdn.com/v/t64.5771-25/499308575_1414707966871407_4132476515565204617_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYXLKYWPxLYQ7kNvwEXAiEC&_nc_oc=AdqIcJJKZUZTaaJRlKLzjTKaVwfu7sJX3c72HH1oQar7wad8oxWWi7MrtwbXoeA8Ui0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zrCvl8u0eTOeK0abnzthqm66m0yVv89Jm0IEfD3kAOw&oe=6A05D472"}, {"file_name": "image_2026-01-27_163209432_cropped.png", "id": "1520246055754786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296027_1520246059088119_3105705324303620803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4DOt8zez3QQ7kNvwGjdPoz&_nc_oc=AdreyBzA4XvFjGTCB2byOaDBmRQKMLXugKb3LnrEJqJ2r_9Z-4CO3FfliGbeEbfoahs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CgGFyEmJ0lfS8KoJ38oFAXX9cygBSynR7ucO-36tWXw&oe=6A05D50F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Monkeys", "keywords": [], "long_description": "Virtual Monkeys is a physics-based VR adventure where your hands are your only tools for navigation and survival. By pushing off surfaces and swinging through the environment, you master a high-speed locomotion system that feels both physical and incredibly rewarding. While much of the world is a vibrant playground for social interaction, players must also use their agility to navigate complex, mind-bending puzzles hidden throughout the maps. The gameplay takes a dark turn in specialized horror zones, where you must use your momentum to escape terrifying entities in atmospheric, high-stakes chases. Whether you are scaling massive trees or narrowly dodging a jump-scare, every movement depends entirely on your real-world arm gestures. This unique control scheme creates a seamless transition between casual climbing and heart-pounding survival. It is a game of skill, speed, and nerves that turns your entire upper body into a controller.", "short_description": "Virtual Monkeys is a physics-based VR adventure where your hands are your only tools for navigation and survival."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtual-monkeys-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "EggrollVR", "support_website_url": null, "website_url": "https://sites.google.com/view/virtualmonkeys/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26889139717341477"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298790_1422659056168062_5840535732692216921_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC5J0EM3eJEQ7kNvwH_StU3&_nc_oc=AdqfbrUcuNTtbium_1oajNggRwtloS6pPaapxgQ46sQaHt4GM7gox2mbSj7kOy0ecQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P33eAHigHKVi7Xvqr1puGk8_sBSFZPUVi-AcOMSN7iA&oe=6A05D620"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Monkeys", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 177043014
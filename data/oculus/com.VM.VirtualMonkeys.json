Sd_d5H38aFZXcvg&oe=6AB923B8"}, {"file_name": "image_2026-01-27_164003740_cropped.png", "id": "1668936680745864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299093_1668936684079197_4543260035649532925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hm-c-fGI-L8Q7kNvwE5bAmV&_nc_oc=AdpsTBNYqyC-2yU-_1HFuw6r0akUDpmhEwvuI4UCU2ufDLiAtstE_5DCsqytRiNQhOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIuXC2GiryqOCqvsGUQN2VQYb4_CXOclYjtR1w9aCPTg&oe=6AB92206"}, {"file_name": "image_2026-01-27_163851655_cropped.png", "id": "1062268976054985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301196_1062268979388318_2302541399354106162_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYCO-2-8aoUQ7kNvwHQWb_j&_nc_oc=Adq3ckgAsfTq3BfWd5HcOfSG2xyPurQIYbt5qV6ZguEwYmFAm64KAIbYv4uYhVUHpuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfHr7542eF3m5paLbUu40flGmrJ1Igug7quIm6iFndZw&oe=6AB9189A"}, {"file_name": "image_2026-01-27_163317889_cropped.png", "id": "1414707960204741", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308575_1414707966871407_4132476515565204617_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95YgEAK9OwoQ7kNvwEya2HX&_nc_oc=AdpxTOAfm3bUI1B_SfMtOUWPeqcmkW8t-LWHH-KvhHBHyTNBZmSjnCIlkDrC7iJNVps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2s-mOImb0wODtObsw0mtXa_DI73kSc4nqiQJwSQ1hgA&oe=6AB92072"}, {"file_name": "image_2026-01-27_163209432_cropped.png", "id": "1520246055754786", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296027_1520246059088119_3105705324303620803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzxIkFCCVJkQ7kNvwEKlsh-&_nc_oc=AdpynUGtm4M2UDFhnqHBNvsOklRS4R_BAdw31EDScNDojFoHZIfyq5KS6sQ95H5wxC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmPWafP7Rbl4pMpOtixzwUYlEwcsOa3BboY8GO-u9uyA&oe=6AB9210F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Monkeys", "keywords": [], "long_description": "Virtual Monkeys is a physics-based VR adventure where your hands are your only tools for navigation and survival. By pushing off surfaces and swinging through the environment, you master a high-speed locomotion system that feels both physical and incredibly rewarding. While much of the world is a vibrant playground for social interaction, players must also use their agility to navigate complex, mind-bending puzzles hidden throughout the maps. The gameplay takes a dark turn in specialized horror zones, where you must use your momentum to escape terrifying entities in atmospheric, high-stakes chases. Whether you are scaling massive trees or narrowly dodging a jump-scare, every movement depends entirely on your real-world arm gestures. This unique control scheme creates a seamless transition between casual climbing and heart-pounding survival. It is a game of skill, speed, and nerves that turns your entire upper body into a controller.", "short_description": "Virtual Monkeys is a physics-based VR adventure where your hands are your only tools for navigation and survival."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtual-monkeys-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "EggrollVR", "support_website_url": null, "website_url": "https://sites.google.com/view/virtualmonkeys/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
_Lg0DEbU2TWOkRQ&oe=6A637238"}, {"file_name": "image_2026-01-27_164003740_cropped.png", "id": "1668936680745864", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299093_1668936684079197_4543260035649532925_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5vsqSH2hU0Q7kNvwE63B6e&_nc_oc=AdrKz_SnCVcr130GD9TL7oYP7J_H_Yp_i8_6PT04X6KYp_bmzuE-e7XHZLk2ttK99Bg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA95doYw4jFITC2Tqr9q-qCErml_JzhrNHqi7Q47msPKQ&oe=6A637086"}, {"file_name": "image_2026-01-27_163851655_cropped.png", "id": "1062268976054985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301196_1062268979388318_2302541399354106162_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3ppsINipeoQ7kNvwH1F78V&_nc_oc=AdpTbi7sBkyEEecisDk6ttEU9qU0eUqhBw5Zanb6m4G6N0SFV4V06CZeaORtvv5fuV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB7-BrZyNUaeHUmry7qeGSsYNKv2JjKiwRcIy_915Yyw&oe=6A63671A"}, {"file_name": "image_2026-01-27_163317889_cropped.png", "id": "1414707960204741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308575_1414707966871407_4132476515565204617_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLCcAfyDL34Q7kNvwFpbHRr&_nc_oc=AdqWCSK4__aVf1oYwem0JGziFyxJXX9LpMbFi-GThLZD1X7_I0Ivn1Eh8cpZmjc96wo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANiWNruC-V-qZwaZ3Ua1_jGdi8kUoz-ENUbtHEf6bj5w&oe=6A636EF2"}, {"file_name": "image_2026-01-27_163209432_cropped.png", "id": "1520246055754786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296027_1520246059088119_3105705324303620803_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rQ3z2p1XmsQ7kNvwF9TsFR&_nc_oc=Adr2eS31xZdFMcnSp6SkvWgwV05Jrr5QS9_--IWpGUQa69bIL3myvHez1gASDDn_Lgw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqnw8z6n8dvlr48tkBzaH4WoA1_dyp5zQvCQBkEKQIyQ&oe=6A636F8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Monkeys", "keywords": [], "long_description": "Virtual Monkeys is a physics-based VR adventure where your hands are your only tools for navigation and survival. By pushing off surfaces and swinging through the environment, you master a high-speed locomotion system that feels both physical and incredibly rewarding. While much of the world is a vibrant playground for social interaction, players must also use their agility to navigate complex, mind-bending puzzles hidden throughout the maps. The gameplay takes a dark turn in specialized horror zones, where you must use your momentum to escape terrifying entities in atmospheric, high-stakes chases. Whether you are scaling massive trees or narrowly dodging a jump-scare, every movement depends entirely on your real-world arm gestures. This unique control scheme creates a seamless transition between casual climbing and heart-pounding survival. It is a game of skill, speed, and nerves that turns your entire upper body into a controller.", "short_description": "Virtual Monkeys is a physics-based VR adventure where your hands are your only tools for navigation and survival."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtual-monkeys-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "EggrollVR", "support_website_url": null, "website_url": "https://sites.google.com/view/virtualmonkeys/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
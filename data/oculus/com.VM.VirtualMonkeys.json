_description": "Virtual Monkeys is a physics-based VR adventure where your hands are your only tools for navigation and survival. By pushing off surfaces and swinging through the environment, you master a high-speed locomotion system that feels both physical and incredibly rewarding. While much of the world is a vibrant playground for social interaction, players must also use their agility to navigate complex, mind-bending puzzles hidden throughout the maps. The gameplay takes a dark turn in specialized horror zones, where you must use your momentum to escape terrifying entities in atmospheric, high-stakes chases. Whether you are scaling massive trees or narrowly dodging a jump-scare, every movement depends entirely on your real-world arm gestures. This unique control scheme creates a seamless transition between casual climbing and heart-pounding survival. It is a game of skill, speed, and nerves that turns your entire upper body into a controller.", "short_description": "Virtual Monkeys is a physics-based VR adventure where your hands are your only tools for navigation and survival."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtual-monkeys-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "EggrollVR", "support_website_url": null, "website_url": "https://sites.google.com/view/virtualmonkeys/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
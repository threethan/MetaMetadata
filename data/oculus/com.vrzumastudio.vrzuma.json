vjxLzgK21bn-G4sT89Pu1Z_5C2MM-bZ4lc0A&oe=6AF32B59"}, {"file_name": "neon_n27_highroute.png", "id": "1469137418462869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673716021_1469137425129535_1815054490635510943_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AWDacanN6wQ7kNvwHKFR50&_nc_oc=AdoU0Uvb3STDeyZdvaOUXPkcfUNYRhKpP-N6AtXaCMZn_9SmZJPNLhldAJ4MhPxpXGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5g22zAkg9nGEIZRly0W_5vvvtkPJt8CECjws_S5bX0w&oe=6AF338E8"}, {"file_name": "neon_n26_crystal.png", "id": "2329528681133728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_2329528684467061_8469955956534404966_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYsEXvQ__CMQ7kNvwGpcIjH&_nc_oc=AdoFxNigAaMGtfKtjUW3a5rgfl06jRkaqmM2CpXqrBGPRCUbTWzNR7mYtm-Z2P1MTBI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfCqiXgoAR6LHJZFsuLnWMipPwe68bSl5gbDcbo06WPg&oe=6AF33FAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1581620636270385", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1581620639603718_6147478633536165182_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GL1NmL3M3_EQ7kNvwHO551E&_nc_oc=Ado_oM9P4BodY4lqF1dRbyJyng8ULgbzcx0RNS-j0q4aBJ2D6bMcY5AL8i6L4cOQ6O8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS0pbPWVnsYIFmO9AwuQhWBrnjbpxWVZrzMRnS9_s5gg&oe=6AF3366C"}, "display_name": "Marble Swoop", "keywords": ["marble", "puzzle", "action", "arcade"], "long_description": "Welcome to Marble Swoop, a thrilling and immersive VR action-puzzle experience specifically tailored for Meta Quest! \n\nStep into ancient arenas and take control of the rolling marble tracks. Your mission is simple but intense: match colored spheres, trigger massive chain reactions, and stop the moving marble train before it reaches the ancient gates. \n\nKey Features:\n- Two Worlds, 60+ Hand-Crafted Levels: Conquer the sun-baked arenas of Antik and the glowing crystal arenas of Neon \u2014 strategically balanced layouts with a perfectly scaling difficulty curve and constantly updating challenges.\n- Diverse Power-Ups & Custom Weapons: Unleash massive destruction with Slow-Mo, Stop, Rewind, Paint, Guided Aim, devastating Marbles Bombs, and the rapid-firing Minigun!\n- True VR Immersion: Fully optimized for Quest devices. Play standing or seated with highly accurate eye-level perspective and smooth physics.\n- Global Localization: Seamlessly available in multiple languages including English, Turkish, French, Spanish, Italian, and German.\n- Safe Progression & Credits: Features full cloud/local save data protection and dedicated credits section.\n\nCan you clear the ancient paths and become the ultimate marble master? Download Marble Swoop now and test your reflexes!", "short_description": "Experience the ultimate VR action-puzzle game. Match colors, blast rolling spheres, use powerful custom weapons, and conquer challenging arenas in a stunning virtual reality environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://marble-swoop.netlify.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Redwilo", "support_website_url": null, "website_url": "https://marble-swoop.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "fr", "es", "it", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "suppo
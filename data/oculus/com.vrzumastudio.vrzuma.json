om/v/t64.5771-25/491830441_1390163743198105_310113906233458660_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1PyU2_SY1sQ7kNvwEHrK38&_nc_oc=AdrfwJWJJtUio6mexQYAwF2HUWJGn6N2l7mC90pdN76FpK4SwDp9fzG4KFTf-dqohyc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQyxchmty3dGWwhYiflg20gewtfbLFoeW63ortcDi9cw&oe=6AFC65D9"}, {"file_name": "neon_n27_highroute.png", "id": "1469137418462869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673716021_1469137425129535_1815054490635510943_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBVWRuU_bM0Q7kNvwFVcxjL&_nc_oc=Adq00NhSSGZV6PGYe4YGartL5wGBAcD9Yyi6iVM-hfYMG1vs5SQHJacIqEqk5W37FBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Fwt4VlLh1ZaCzyYbtC4eAMFwobmW2Jbv5BFWsGcVTQ&oe=6AFC7368"}, {"file_name": "neon_n26_crystal.png", "id": "2329528681133728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_2329528684467061_8469955956534404966_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9JRS7GK9-QQ7kNvwFkcGA5&_nc_oc=AdoWeoPvbJXTXolqzswe49d3IAispK1cKobuKLn4S3OV_4ruYc3dQL4rdchskaIkn2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKiq4Yatd9VDKKUzxrnG9PSkzoEX0n6b6EhjMiHM7gTg&oe=6AFC7A2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1581620636270385", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823802_1581620639603718_6147478633536165182_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Nh81bOBmPQQ7kNvwFq25wU&_nc_oc=AdoU4NE8FdjdWnrJXpcrTZcuPkhT18mCBdNUzawpmFHgq14bJOY37S7-I6Mvm6Bly9Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUrseEpkO_myIZRNG1Vxxa2cJMrfvPaDDs_sEwN9gkew&oe=6AFC70EC"}, "display_name": "Marble Swoop", "keywords": ["marble", "puzzle", "action", "arcade"], "long_description": "Welcome to Marble Swoop, a thrilling and immersive VR action-puzzle experience specifically tailored for Meta Quest! \n\nStep into ancient arenas and take control of the rolling marble tracks. Your mission is simple but intense: match colored spheres, trigger massive chain reactions, and stop the moving marble train before it reaches the ancient gates. \n\nKey Features:\n- Two Worlds, 60+ Hand-Crafted Levels: Conquer the sun-baked arenas of Antik and the glowing crystal arenas of Neon \u2014 strategically balanced layouts with a perfectly scaling difficulty curve and constantly updating challenges.\n- Diverse Power-Ups & Custom Weapons: Unleash massive destruction with Slow-Mo, Stop, Rewind, Paint, Guided Aim, devastating Marbles Bombs, and the rapid-firing Minigun!\n- True VR Immersion: Fully optimized for Quest devices. Play standing or seated with highly accurate eye-level perspective and smooth physics.\n- Global Localization: Seamlessly available in multiple languages including English, Turkish, French, Spanish, Italian, and German.\n- Safe Progression & Credits: Features full cloud/local save data protection and dedicated credits section.\n\nCan you clear the ancient paths and become the ultimate marble master? Download Marble Swoop now and test your reflexes!", "short_description": "Experience the ultimate VR action-puzzle game. Match colors, blast rolling spheres, use powerful custom weapons, and conquer challenging arenas in a stunning virtual reality environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://marble-swoop.netlify.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Redwilo", "support_website_url": null, "website_url": "https://marble-swoop.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "externa
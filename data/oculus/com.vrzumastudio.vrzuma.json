e": "Screenshot_02_P.png", "id": "1632886841838013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1632886845171346_5537734926007322128_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSH9nlHSJbkQ7kNvwFp77_S&_nc_oc=AdqdCwGkkhare4TFSWWAUKukVJuX5hsCMi6Q6wAr8oX8ceAc_3UYMGt41ViWyCLVcMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKV3gB3NWvvnj6iwPe6yaEfp1j8Yxu4c0rNhoO2uO_FA&oe=6AFDC07F"}, {"file_name": "Screenshot_01_A.png", "id": "2171750657106280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_2171750663772946_3533499769580409952_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLZFO8aoGYEQ7kNvwHK9UQp&_nc_oc=AdojeSK0Caz_kvTmTfotXfUhyMkyhVB3mR9fj2TcetsW7pOgxH315DeTvAyddi6su-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY4WWKBt_HRGIfp38vNdkzzMhOCeG4cQB4yKDcq5SY7w&oe=6AFDE164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1581620636270385", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1581620639603718_6147478633536165182_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Nh81bOBmPQQ7kNvwFa4GLs&_nc_oc=AdqeehNK1YtVxRWz5zWUKjIhMVwZV8RWuBJMN03vZt4Duh-Q_k-m3I4G128HKe4B78g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPC1uEeQlQ5kIiQC9rVQJxpeAHsyebrgpJHk4rHgQ-Tw&oe=6AFDC26C"}, "display_name": "Marble Swoop", "keywords": ["marble", "puzzle", "action", "arcade"], "long_description": "Welcome to Marble Swoop, a thrilling and immersive VR action-puzzle experience specifically tailored for Meta Quest! \n\nStep into ancient mythical temples and take control of the rolling marble tracks. Your mission is simple but intense: match colored spheres, trigger massive chain reactions, and stop the moving marble train before it reaches the temple gates. \n\nKey Features:\n- Unique, Hand-Crafted Levels: Strategically balanced layout with a perfectly scaling difficulty curve and constantly updating new challenges.\n- Diverse Power-Ups & Custom Weapons: Unleash massive destruction with Slow-Mo, Stop, Rewind, Paint, Guided Aim, devastating Marbles Bombs, and the rapid-firing Minigun!\n- True VR Immersion: Fully optimized for Quest devices. Play standing or seated with highly accurate eye-level perspective and smooth physics.\n- Global Localization: Seamlessly available in multiple languages including English, Turkish, French, Spanish, Italian, and German.\n- Safe Progression & Credits: Features full cloud/local save data protection and dedicated credits section.\n\nCan you clear the ancient paths and become the ultimate marble master? Download Marble Swoop now and test your reflexes!", "short_description": "Experience the ultimate VR action-puzzle game. Match colors, blast rolling spheres, use powerful custom weapons, and conquer challenging temples in a stunning virtual reality environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://marble-swoop.netlify.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Redwilo", "support_website_url": null, "website_url": "https://marble-swoop.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "fr", "es", "it", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
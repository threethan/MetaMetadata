om/v/t64.5771-25/491830441_1390163743198105_310113906233458660_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nk0t3oHoNSQQ7kNvwHbCByo&_nc_oc=Adr-J-2TMtDK_zSXm-gj5QL_m-Yht517Y6syo8sOtjuj1tHXvrg9V_OJXbyrLUboz5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-BvwJ_M_Kq3DbK9FjgL1g5iRNL6bO56lXZOSTXp57bQ&oe=6B033599"}, {"file_name": "neon_n27_highroute.png", "id": "1469137418462869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673716021_1469137425129535_1815054490635510943_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=749tVnD6MpoQ7kNvwEnotiK&_nc_oc=Adqet05i1LNBLcKs7IhuPKnJ_YicwAOX9bq2CsT2pZcW3NzPdONjEMALNQyRhwnfgrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq4umvZ5inmJtlrZMP0gPT15oJJmPlTawqbl2bX0eIkg&oe=6B030AE8"}, {"file_name": "neon_n26_crystal.png", "id": "2329528681133728", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596168449_2329528684467061_8469955956534404966_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCI_cBjBNYoQ7kNvwH7IHzJ&_nc_oc=Ado_Ll4eE_omItfvQGmBJyMqD5hs1TiOZ-6USIndvxN-PyMFsz19cWyIDx5ouCGbM4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIqXGUaIVZshtjrLPZ-W09DqphQJqNH3WmJZHQ3P_y6g&oe=6B0311AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1581620636270385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1581620639603718_6147478633536165182_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVCl5FRpeX8Q7kNvwEjwQGG&_nc_oc=Adoghe_2lGl90RRz5p1G6I1-L-aCF25NeMODncS4Tajwlu0bleviHfKjXu1K63Fvbp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxPDuHmbguNfiw8o3l7I3kVuHsfo-QnariFBCAEOp6Pw&oe=6B03086C"}, "display_name": "Marble Swoop", "keywords": ["marble", "puzzle", "action", "arcade"], "long_description": "Welcome to Marble Swoop, a thrilling and immersive VR action-puzzle experience specifically tailored for Meta Quest! \n\nStep into ancient arenas and take control of the rolling marble tracks. Your mission is simple but intense: match colored spheres, trigger massive chain reactions, and stop the moving marble train before it reaches the ancient gates. \n\nKey Features:\n- Two Worlds, 60+ Hand-Crafted Levels: Conquer the sun-baked arenas of Antik and the glowing crystal arenas of Neon \u2014 strategically balanced layouts with a perfectly scaling difficulty curve and constantly updating challenges.\n- Diverse Power-Ups & Custom Weapons: Unleash massive destruction with Slow-Mo, Stop, Rewind, Paint, Guided Aim, devastating Marbles Bombs, and the rapid-firing Minigun!\n- True VR Immersion: Fully optimized for Quest devices. Play standing or seated with highly accurate eye-level perspective and smooth physics.\n- Global Localization: Seamlessly available in multiple languages including English, Turkish, French, Spanish, Italian, and German.\n- Safe Progression & Credits: Features full cloud/local save data protection and dedicated credits section.\n\nCan you clear the ancient paths and become the ultimate marble master? Download Marble Swoop now and test your reflexes!", "short_description": "Experience the ultimate VR action-puzzle game. Match colors, blast rolling spheres, use powerful custom weapons, and conquer challenging arenas in a stunning virtual reality environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://marble-swoop.netlify.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Redwilo", "support_website_url": null, "website_url": "https://marble-swoop.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "externa
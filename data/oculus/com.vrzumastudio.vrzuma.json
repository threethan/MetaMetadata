e": "Screenshot_02_P.png", "id": "1632886841838013", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1632886845171346_5537734926007322128_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xx3y_eY_64Q7kNvwEA78J5&_nc_oc=Adrv-WEnhDBg3f4QMte0Lp95brLiWrYH22e5KuM6RrruJzHtujibGfLgZqpvjU6-7_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8VN_cXSawNU2yJJNFxRJZhjbWoYXjtbcHWqOcegWe-g&oe=6B0457FF"}, {"file_name": "Screenshot_01_A.png", "id": "2171750657106280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_2171750663772946_3533499769580409952_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIurSacNnW0Q7kNvwHWFKna&_nc_oc=Ado_LJm5GHTGiPG4PO7sBuYut4XAnUVsyZQKwHuYbfJBilnULfpigeWgqqBgVgv15Bk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmuj2hxyqbz44Psi9TASTRUhKwYu2DY30RSxzUISe4iw&oe=6B0478E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1581620636270385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1581620639603718_6147478633536165182_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVCl5FRpeX8Q7kNvwEKxRTf&_nc_oc=AdpCYxfOnwulaa5_ZehLyuS0z1x7SMnkqYZiABMpZIeL3wCQ9WaKpW_wZMXKLad7nYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM1wZVMA_cVayaQc6TdXaKQlbI3cuHlu1eZXWp-2qKLA&oe=6B0459EC"}, "display_name": "Marble Swoop", "keywords": ["marble", "puzzle", "action", "arcade"], "long_description": "Welcome to Marble Swoop, a thrilling and immersive VR action-puzzle experience specifically tailored for Meta Quest! \n\nStep into ancient mythical temples and take control of the rolling marble tracks. Your mission is simple but intense: match colored spheres, trigger massive chain reactions, and stop the moving marble train before it reaches the temple gates. \n\nKey Features:\n- Unique, Hand-Crafted Levels: Strategically balanced layout with a perfectly scaling difficulty curve and constantly updating new challenges.\n- Diverse Power-Ups & Custom Weapons: Unleash massive destruction with Slow-Mo, Stop, Rewind, Paint, Guided Aim, devastating Marbles Bombs, and the rapid-firing Minigun!\n- True VR Immersion: Fully optimized for Quest devices. Play standing or seated with highly accurate eye-level perspective and smooth physics.\n- Global Localization: Seamlessly available in multiple languages including English, Turkish, French, Spanish, Italian, and German.\n- Safe Progression & Credits: Features full cloud/local save data protection and dedicated credits section.\n\nCan you clear the ancient paths and become the ultimate marble master? Download Marble Swoop now and test your reflexes!", "short_description": "Experience the ultimate VR action-puzzle game. Match colors, blast rolling spheres, use powerful custom weapons, and conquer challenging temples in a stunning virtual reality environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://marble-swoop.netlify.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Redwilo", "support_website_url": null, "website_url": "https://marble-swoop.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "fr", "es", "it", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
om/v/t64.5771-25/491830441_1390163743198105_310113906233458660_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bor_jrpqE0YQ7kNvwG1-MpF&_nc_oc=AdpjzQwceg8c94Fx54r3lPD3kaZ1s0xpIfkQOkSio1dtHIiI_RBzUUbLscEiZZSJhbQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVdZowu5ZDjh6EIorcUrSwR_yw2q1UH18w5u7nRKWMjw&oe=6B0B1E99"}, {"file_name": "neon_n27_highroute.png", "id": "1469137418462869", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673716021_1469137425129535_1815054490635510943_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oppD4FjkznAQ7kNvwHWTCsm&_nc_oc=AdrOoyyqLTLIbulr_vLDnTRVCmun8i0vKivPOqMNdvXPj0EqmewiNdHkD2b8hDjll-k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMTSpWV-yE5lvJBZeoK0QRrYkXj1FNmYtk3SL9O5pdCw&oe=6B0B2C28"}, {"file_name": "neon_n26_crystal.png", "id": "2329528681133728", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/596168449_2329528684467061_8469955956534404966_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7luL76v7re4Q7kNvwFWcYkr&_nc_oc=AdpJjUJo49WHhKjgwr6XzWGVlRZIlYr88MCyc6w04c8SBA0vb5ffGVCUG0C4CWlBbFg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1gzyk2guAMIB-AUVXUuUGAFLENp8__CeZXc-aZT_-jA&oe=6B0B32EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1581620636270385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823802_1581620639603718_6147478633536165182_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YrjS1KkwkwQ7kNvwHOyFlh&_nc_oc=AdpKV6QLcUP56u_tWw-xLh4TaniRDmjS95JTDwWxqIdRikjyAZ_MFAi_tuMnNpChbjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTscDLkE_NXBxfsVs2CKuRmZ_y74OaUAE_rIx-7RrCw7A&oe=6B0B29AC"}, "display_name": "Marble Swoop", "keywords": ["marble", "puzzle", "action", "arcade"], "long_description": "Welcome to Marble Swoop, a thrilling and immersive VR action-puzzle experience specifically tailored for Meta Quest! \n\nStep into ancient arenas and take control of the rolling marble tracks. Your mission is simple but intense: match colored spheres, trigger massive chain reactions, and stop the moving marble train before it reaches the ancient gates. \n\nKey Features:\n- Two Worlds, 60+ Hand-Crafted Levels: Conquer the sun-baked arenas of Antik and the glowing crystal arenas of Neon \u2014 strategically balanced layouts with a perfectly scaling difficulty curve and constantly updating challenges.\n- Diverse Power-Ups & Custom Weapons: Unleash massive destruction with Slow-Mo, Stop, Rewind, Paint, Guided Aim, devastating Marbles Bombs, and the rapid-firing Minigun!\n- True VR Immersion: Fully optimized for Quest devices. Play standing or seated with highly accurate eye-level perspective and smooth physics.\n- Global Localization: Seamlessly available in multiple languages including English, Turkish, French, Spanish, Italian, and German.\n- Safe Progression & Credits: Features full cloud/local save data protection and dedicated credits section.\n\nCan you clear the ancient paths and become the ultimate marble master? Download Marble Swoop now and test your reflexes!", "short_description": "Experience the ultimate VR action-puzzle game. Match colors, blast rolling spheres, use powerful custom weapons, and conquer challenging arenas in a stunning virtual reality environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://marble-swoop.netlify.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Redwilo", "support_website_url": null, "website_url": "https://marble-swoop.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "externa
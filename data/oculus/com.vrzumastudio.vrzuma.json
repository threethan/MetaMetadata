om/v/t64.5771-25/491830441_1390163743198105_310113906233458660_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1PyU2_SY1sQ7kNvwFAQ-Up&_nc_oc=Adp7vVdcmVG89V8b-AbjSiLC0bwd_VG6xQjw7TR0XdaDuFYFQFnAgoL-vBG04zegBZs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzvbOsvsytuGEic9LQGBOzHEL9NwaTNdSAfagObiMBSw&oe=6AFF08D9"}, {"file_name": "neon_n27_highroute.png", "id": "1469137418462869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673716021_1469137425129535_1815054490635510943_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9mxV_y3K9YQ7kNvwEw6Nsf&_nc_oc=AdrH_QFobcoB9v57mbl00xGh0MxRAhklJ9rIAfsfUsN_MoQWmyPr29N-kgt77cmG1IQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbwab7yWnRvL-adNCKwFZIHmwQ4pDlF3EAVf6EEiLDUQ&oe=6AFF1668"}, {"file_name": "neon_n26_crystal.png", "id": "2329528681133728", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_2329528684467061_8469955956534404966_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QOSQQJ9G_IQ7kNvwH89d0G&_nc_oc=Adpovb77E0SRBX9QcDsrQ2rEqzisEXo6wMLowSV6tvHjCbTt5foAcMsxTA8GN9iOsEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-WQ_FNe5q0Q_gC4sXxnKhRKqJrPcorVNXzRLehOGNCA&oe=6AFF1D2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1581620636270385", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823802_1581620639603718_6147478633536165182_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYEqbc6j1k4Q7kNvwHMd7y1&_nc_oc=AdrgkRtMIuDz25QebKSwtpjozUMBLOi-p4465Cj-wF4m02RRD3UmrJfcYbn97M0QG5I&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRkTsy3VopODgYlqsHQr_X62yI4BbwV7P4SsQIoh9esw&oe=6AFF13EC"}, "display_name": "Marble Swoop", "keywords": ["marble", "puzzle", "action", "arcade"], "long_description": "Welcome to Marble Swoop, a thrilling and immersive VR action-puzzle experience specifically tailored for Meta Quest! \n\nStep into ancient arenas and take control of the rolling marble tracks. Your mission is simple but intense: match colored spheres, trigger massive chain reactions, and stop the moving marble train before it reaches the ancient gates. \n\nKey Features:\n- Two Worlds, 60+ Hand-Crafted Levels: Conquer the sun-baked arenas of Antik and the glowing crystal arenas of Neon \u2014 strategically balanced layouts with a perfectly scaling difficulty curve and constantly updating challenges.\n- Diverse Power-Ups & Custom Weapons: Unleash massive destruction with Slow-Mo, Stop, Rewind, Paint, Guided Aim, devastating Marbles Bombs, and the rapid-firing Minigun!\n- True VR Immersion: Fully optimized for Quest devices. Play standing or seated with highly accurate eye-level perspective and smooth physics.\n- Global Localization: Seamlessly available in multiple languages including English, Turkish, French, Spanish, Italian, and German.\n- Safe Progression & Credits: Features full cloud/local save data protection and dedicated credits section.\n\nCan you clear the ancient paths and become the ultimate marble master? Download Marble Swoop now and test your reflexes!", "short_description": "Experience the ultimate VR action-puzzle game. Match colors, blast rolling spheres, use powerful custom weapons, and conquer challenging arenas in a stunning virtual reality environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://marble-swoop.netlify.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Redwilo", "support_website_url": null, "website_url": "https://marble-swoop.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "externa
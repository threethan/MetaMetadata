g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO8d5v0FQUMQ7kNvwGbhuGO&_nc_oc=AdrWA3gbYxWtohbZMmKwMKQ5bUyiHTxzNOwg8AIklPId4YQ868a85rJG_WCwwKhIA-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tHQXp-zO3vq4rkvMcxjU9jXLxBEW3VUvrAiFou77-aw&oe=6A47D8B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TS_TrailerCover.png", "id": "659061397244425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828849_659061400577758_866985185781091716_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rez_yLS7a60Q7kNvwFvkzIT&_nc_oc=AdrjPTKBoKovuLClfwx42frcjDzGYJF_oznfuWZzBAav35WNaRyEg4nLf4qewH7ieKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l3bD3JLFB6t4ZI8xZCnuWTZnqVTSnn2plM4mewbushw&oe=6A47CA16"}, "display_name": "Third Seat", "keywords": [], "long_description": "Third Seat is a multiplayer VR experience for couples who want to practice communication and emotional awareness through guided roleplay. Step into a calming space with a partner and talk through structured prompts, all facilitated by Mira, a virtual AI guide.\n\nMira listens to your real-time voice, reflects on what\u2019s said, and offers summaries and suggestions to help deepen understanding between players. Ideal for couples, students, and personal development, Third Seat helps you practice empathy, active listening, and communication skills \u2014 together.\n\nKey Features:\n\nMultiplayer voice chat in a focused VR space\n\nAI-powered guide Mira (OpenAI + Azure Speech)\n\nReal-time transcription and conversational summaries\n\nSave and resume sessions with full context\n\nNo stored voice data \u2014 text only\n\nPrivacy-first design\n\nThird Seat is designed for personal growth, roleplay, and skill-building. It is not a medical device and does not diagnose, treat, or provide therapy for any medical or mental health condition.\n\nPrivacy Policy:\nWe collect only the data needed to support session continuity. Voice is processed, not stored. You can request deletion at any time. Full policy: thirdseat.notion.site/privacy-policy-for-third-seat\n\nContact:\nThirdSeatSupport@proton.me", "short_description": "VR roleplay for couples powered by AI. Practice empathy, listening, and connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thirdseat.notion.site/privacy-policy-for-third-seat", "developer_terms_of_service_url": null, "publisher_name": "Dynamic Sphere", "support_website_url": null, "website_url": "https://thirdseat.notion.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24502173319425683"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1495116075013169"}]}, "baseline_offer": {"id": "1495116075013169"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759160760, "status": "PUBLISHED", "id": "1495116075013169"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26063925833250416", "version": "0.1.11"}, "id": "813372161128797", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24374232962219720", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2606392583
t64.5771-25/499303100_1317051453417339_6882689083198563835_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUKsQaniQYMQ7kNvwFu2ibJ&_nc_oc=AdqGzKC_UXTE09c_ut2mHno5LV88YV4E_5R-HycxDyg-dhaHgOSWZFEV12WbTtkRl_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_taL50pBRqEf7CwllfIaNh9YTSeh9k1HCL6y8LyJE_Mg&oe=6A47E2A5"}, {"file_name": "ScreenShot5.png", "id": "1369782938484384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618220_1369782948484383_133947744299282406_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO8d5v0FQUMQ7kNvwGbhuGO&_nc_oc=AdrWA3gbYxWtohbZMmKwMKQ5bUyiHTxzNOwg8AIklPId4YQ868a85rJG_WCwwKhIA-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tHQXp-zO3vq4rkvMcxjU9jXLxBEW3VUvrAiFou77-aw&oe=6A47D8B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TS_TrailerCover.png", "id": "659061397244425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828849_659061400577758_866985185781091716_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rez_yLS7a60Q7kNvwFvkzIT&_nc_oc=AdrjPTKBoKovuLClfwx42frcjDzGYJF_oznfuWZzBAav35WNaRyEg4nLf4qewH7ieKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l3bD3JLFB6t4ZI8xZCnuWTZnqVTSnn2plM4mewbushw&oe=6A47CA16"}, "display_name": "Third Seat", "keywords": [], "long_description": "Third Seat is an AI-powered VR experience for couples and solo participants who want to practice communication, emotional awareness, and reflection through guided roleplay.\n\nEnter a calming virtual space and speak with Mira, an AI guide who facilitates thoughtful conversation. Mira listens to your real-time voice, reflects on what\u2019s shared, and offers summaries and prompts to deepen understanding. Sessions can be experienced with a partner or individually as a space for reflection and communication practice.\n\nThink of Third Seat as a practice space for real conversations - a place to improve empathy, listening, and emotional insight.\n\nTo begin a session, simply walk up to Mira in the room.\n\nKey Features\n\n\u2022 Solo or multiplayer VR sessions\n\u2022 AI-powered guide Mira (OpenAI + Azure Speech)\n\u2022 Real-time voice transcription and conversational summaries\n\u2022 Save and resume sessions with full context\n\u2022 Privacy-first design - voice is processed, not stored\n\nThird Seat is designed for personal growth, roleplay, and skill-building. It is not a medical device and does not diagnose, treat, or provide therapy for any medical or mental health condition.\n\nPrivacy Policy\nWe collect only the data needed for session continuity. Voice is processed, not stored. Deletion requests available. Full policy:\nthirdseat.notion.site/privacy-policy-for-third-seat\n\nContact\nThirdSeatSupport@proton.me", "short_description": "AI-powered VR roleplay for couples or solo sessions. Practice empathy, listening, and connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thirdseat.notion.site/privacy-policy-for-third-seat", "developer_terms_of_service_url": null, "publisher_name": "Dynamic Sphere", "support_website_url": null, "website_url": "https://thirdseat.notion.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26054789867497346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619147_830349242648682_43158439762021
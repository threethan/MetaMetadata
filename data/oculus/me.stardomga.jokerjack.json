dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwGG0yX-krkQ7kNvwG4zqIB&_nc_oc=Ado87JdJI3JzOhvxL7C3vC0hgOGuzISt65BaL2HNDjFJamZsdv9At9Ia-JV8vZ0Y7WM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIS4uCRQgN-0CN6YNtXj0SguhBfm5Azr2hADF08gpyUw&oe=6A901AC6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASPn-3bstJsQ7kNvwG8dKU9&_nc_oc=AdpTjqTN_gedP1swpibSplVIpZEhVF53PU7fQXxJHzRp3JwZVdD4lc1nPDcrJK05TLE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0ysepKypOfeCl7VuimuBdNLIOEov55JK8EHC8Xx5Ncw&oe=6A90350E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEGSI5yd2A8Q7kNvwFRvzib&_nc_oc=AdpmABhDOQLZtv8-TnZOQvB9bJZyOUtbpCPfv9lQkXUtzx5AdcsXUpjX11nT2KQeiqs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQMh8x4pVf8xjbCgxvH47ALYuekeaokji57PJ0B0C6dQ&oe=6A901CB5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
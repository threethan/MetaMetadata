dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l23_ombpq3gQ7kNvwGTMVkt&_nc_oc=Adqq0E475RacnNafIpxQnipGHzLsr2Dw0GscubjRSBj7myNETRYB5jD2mF-4dMyn0Us&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t3A1bCeLgj9xpSrwWRjfOMigwiNiAtBGO9ydNT9pOvw&oe=69FF4E06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kxzBr-nfusQ7kNvwHFw2rz&_nc_oc=Adrberq0BtWNLW5E3m2-1lSCHdRXWFPOmBhbBp7DZMpAjza5sE_QD_8hAk863SP2k7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d0C_1LFQhkuyWSAKM5yVElT1Cr5yTcxRapJaJ8M29Yg&oe=69FF300E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65hm8eRwiNQQ7kNvwFiezIi&_nc_oc=Adona8b0DO5d806jwLwCtnWZpP5v7S_x8kJhBzuo8qwrXstG8-6du9mqowubUWDbaTA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MRP7jel0Ih25gpdZB5Ji5omilhc5BRtj5hq3AwPsDMw&oe=69FF4FF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
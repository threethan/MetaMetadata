dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfdmkyrVuL4Q7kNvwHMzKdE&_nc_oc=AdolCe10mCdBKx1ot23FasqPBR9L_dvCQyIbXkDHC0dblIp0zBpmDDVBDWq4fwb9Mjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7FFKnLCyeZR7BB_CKA2WkUzwHwPYDRmW84vg508O45A&oe=6ABA8306"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=embDUdj06aoQ7kNvwFCpsuL&_nc_oc=Adpc2scPSIFu4ag40Mek68SWrrfi5T6h-Cczn2p8iVdy5ia_00MQjIJCOp3FbRiCbeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeMSJYNy8iCKAohz5KMu3NQw9NYM3Ew0kmXBFROkGLsA&oe=6ABA650E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4pZfrwYj4cQ7kNvwH5YFeP&_nc_oc=AdqPydv9iemsAaeyqLYOxDehO68SvJLWrt_QdQpfYcW5q2q88Ceq8qP00f--P-I_MGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQOTS7RTY7QCiKZuQjOBbkFhDYe05-k5Wh_5WW38yVSA&oe=6ABA84F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
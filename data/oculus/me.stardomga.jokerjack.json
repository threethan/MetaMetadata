dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFlm-q7QZKMQ7kNvwHLP61g&_nc_oc=AdrYI9s965o38vqBlIib0lRS278OAmXmwy9I_ZPBcLizSDsXvOYj1pBJrwGfGNNui-k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3u46SfTMTc4Jvm_VXWhuj0lsyohYZxJ1Cl8lPYeyUBdw&oe=69F61386"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DQmfNgBkq4Q7kNvwFwYQeU&_nc_oc=AdrNbM9TA42_xSW939PXGkrnZ0Jzj4JWDlLSd3ouywQOI1uET1_gFUr68AGuLscmLlw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JgbNeQKVm_Ty2YiyN-mQZ08SwLkEVThFGcgyjb8rYNA&oe=69F5F58E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbYqCF1ZelcQ7kNvwFu9Qzl&_nc_oc=AdppBcpsnV9CYmMO6rMwx6SjRJfMEiUP0ZdzwERR3tg3RTMChwYI3Exde_oz5DbFX4w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ssqHV0ZgGmyzGxThf3fmhPpYbE-QArkSacq5AI-BR6w&oe=69F61575"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
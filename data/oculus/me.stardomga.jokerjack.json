dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8IVtcGO0DcQ7kNvwFN6rRK&_nc_oc=AdoRf2_NGeP8GAz3lW6lLegPqzn1kyGQdKZkFEvpcf7AdbDTbTYomH4jozBrTvKR9aw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ouEzDnWP2HKDsQfuqyXDoVdjjaEQJkK10HqmtzJhvgA&oe=6A2C2106"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0IHiHkhnjcQ7kNvwFqXTfC&_nc_oc=AdrdostUZGWh3IzbzvpVlVqjhHF2C0QG5XuwIOSi5iUiBdkQaX6GOmYNtdpg1JlbEks&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Ohp1stKq019rPYqVX_kWHBCU-wBJrLWgVMqGWp-AQQ&oe=6A2C030E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRLOQUwrv-oQ7kNvwHTPpEr&_nc_oc=Adr5V2MR-FiZHv7GQRPdma-5-JQpPupCRJRidBRCPJ2oYKqd3lmXa1Alb8qqvArhHFs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yvZbjvLqERDj9KL_9uKrh06RpxqpqM6ve2zrxxUxsSA&oe=6A2C22F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7qWyzcXJxoQ7kNvwERscVu&_nc_oc=Adoyw6Cev17dQHGUVPfXYVLV54nYOdpnmAsdqwITdgkKI2Ld-YOZ9d9czhT7p6mF1ww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7zyXQU4B6Vc-HUplmVMDgcJpNZJzJ4ZQ9S3CQw4_NCw&oe=6AB29A06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COgOyR0LGdoQ7kNvwGPYi82&_nc_oc=Adpc-I64r4nlSF6bIGcIKF5oNQgBmxeSbApFx_bm2utPCL_GNZjx5F02Y4J0TM4BVz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxCs0ynFV4R8TzhZGy3WjlqVrPkWJ5X2J4TI16f62CmA&oe=6AB27C0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4zy7O3cVA0Q7kNvwHQJKA3&_nc_oc=Adp1DnSeU1-vssDO4izTv8GvxymjIvhTAXA6KukBLMnSCBozoNj0QmrqqNsYrxnWGH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQkrRVYC7bF2JuuFrohB7t5XQhOvWloLW6S6ZBexWgtg&oe=6AB29BF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
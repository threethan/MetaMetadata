dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9as2HUnjekQ7kNvwHHPkeV&_nc_oc=AdpVA9Vz1qHomQDV02jwDs_Fl3Rt9xJcR-dL0ue_lhe2RZvK8IWHrW4ij1saNTjGMB8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAatV7oPcv0MA7378KDnG2ByWCMFTeatHwy_aortqEBvQ&oe=6A53AE06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpASc7_u8IwQ7kNvwEX5zBM&_nc_oc=AdoiGOdS0Kdc-F_nadCj9UQ6eR6-5RK_TIrVpLIkdCjgIWH1oemhEA7e2r3AJtHdd3I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKKv3s_rB2oNUplP3s22HAZX_rTN2snNfIRu1Y-szOng&oe=6A53900E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOkbYUi2nCAQ7kNvwEWki3n&_nc_oc=Ado6m2-dtgAWGSXxvyMLCzpSIK7oGe729s15L7HK4wrIycKBuDFZFE9wr_7sK32NIo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi7eAuXjY5cC2Ho_lbAnzkUWOaaPV697mSBO1Amoky_Q&oe=6A53AFF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
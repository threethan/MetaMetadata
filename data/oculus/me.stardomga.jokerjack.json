dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4ThydJCWukQ7kNvwHihrpu&_nc_oc=Adr7DV7w-RpujwNZZROJ4ab5irvRbdcmO1WPnL2hHgtPQ-VzrGdNF36FbGoGsmkefg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaLZXJyXJ0V23cgveJFfmIqTcDk1Enwa8L5UvO2bLr2Q&oe=6AE60486"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mliOrQsjNDgQ7kNvwGD_Sny&_nc_oc=AdrrKxdrY3YC02HxK9mA7C2rmWPpv7PTyTUMoPFbs0tVRpzS7A6sAWD3a2ZKwfUpq80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk9gmnfed6ix_K3vjJ2pukJXmEcaSgumKGJCzi2DIq7Q&oe=6AE5E68E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H__tn0xJL3kQ7kNvwH2Xhc1&_nc_oc=Ado0hnl2q9uDcHLWVQkt3ZZKch8Qwe2u7WVEoWVvwXGmgnRMwhmeBfnf4mJ01nfqSNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI41joe3e2WPyrDNTapPQ4Hretq6ot5ny4YWWmo9wcsg&oe=6AE60675"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
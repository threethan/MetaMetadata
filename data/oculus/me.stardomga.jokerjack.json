dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EweRjgkcDYQ7kNvwEuAyjH&_nc_oc=Adp-2f0DQnBoiAOh8ff5hOnzBGL3ATK1rvJpMw3frtfm3K21x-Xgm5eKH_Iy09LjMIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBvzag00UuGveYx7rd69KbLgQXc8d9XQLI3A0oZATuIA&oe=6AEF3F06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBlpUt3BqgQQ7kNvwF2x4-k&_nc_oc=AdpbCAetLYtrXYfG8VRbVQfLQL4RPen4jMu-eRSS_y6CivQe3fYgNZvXb53yErZka60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHJv_joiCeLbrHrFyjQas8bu9BScJYC6DpU2XSFHYXig&oe=6AEF594E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXf1b5RJZJkQ7kNvwEcf7qq&_nc_oc=Adp8fnh4lffURGAHZd20tEKtSfHsz5pDqqXk2V1EfSIuu0PS0ERFHM695JW1S4topbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8FcYvo0Fb8SMYsAa7P-jOx6zrHx-PHI3aUzcvnnihZA&oe=6AEF40F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23QLWkvMqtsQ7kNvwE-ukoh&_nc_oc=AdrIYnMeZ2yGCFeMcwMfOIrMMJkOxyVLGakF7Icyn7DDHgd4mbi3H6Isy4wNtE0rYjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf0Iio7RYD5r9sY-3zfhkwRsEoxbiQGz0MUOLzJ0mubg&oe=6AD23E06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14SqxammfHgQ7kNvwHZ3ZRd&_nc_oc=AdrNOowbZCGcvAJZWl-0zLZE5f0dTepjjSj4EYThuXzgKCDFdrLHKotWcPHyBf9V_lA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHdDBgpxXe_QfU0wI6NL4EsOSMH3hn3TZCx5nkWre-ww&oe=6AD2584E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8w9cpymsmYQ7kNvwFG01J6&_nc_oc=AdqgSJ6IHfqpRRXsubgQ7NcfoSx3ljGMsXhWtSt3bsGx_o0fcMK6ZdHtkcawWLApGpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyPn4HtndIdMMMJ2Jj1ZeyDjMEm9icYOORgPjU38g9wg&oe=6AD23FF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
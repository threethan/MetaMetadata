dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTfuQIeRdusQ7kNvwED44V6&_nc_oc=Adr3ufA42pGD9bRBEObJHQy58hYgVRJ_XzR9FmVKUeIRe64ekMI-Mzzh2Kxo5vbrfGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUqRijsGeCeJk_W7XwnCg2EMs8UuM_67EIq8XZlF5FOg&oe=6A7C5446"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwmG7SXZA3kQ7kNvwHHNCKS&_nc_oc=Adq8vUKUpfnd8dh4KdLqSKT888liSx5tsxXRCcG5YLZkv5hdrJ7Lsst8GptC7QwRyO8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnyOMknqyYyFyMdbc45EmTNvrdzyjPYqKVHtccVLcF4w&oe=6A7C6E8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7lgOEcm-qwQ7kNvwFcOGl5&_nc_oc=AdpKkr-dY8KaS8wHesANW0TRCFtPZhDljPFAHgeXtBA3mTuf83fFIIhMo0_Kh0A3td0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUFu9mUWqgzig-OEwEnNda18A_Lq94fnrY-Ak_7mK0aw&oe=6A7C5635"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
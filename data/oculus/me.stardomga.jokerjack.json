dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g871G79UvUYQ7kNvwFSoqD1&_nc_oc=AdqMqIEhzVCizqKJWaB8z8j0II519Pgp7oP0HU4yFMpBMvD6yFq7K2fC0cRMkjMl1Nc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h5liJE902hiNwcWevsdSCYamnnrlbQEGeqSDuzNWvjg&oe=6A1C4F06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROtULYSfFG8Q7kNvwHAIzXw&_nc_oc=Adqbv_KYgvw-TeHBYz-3BA4dGsxrAKDeDRNWyDIHZW6jU3v9C4nR_RRdilsjsKf5Dy0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NI_S8SWdNGj5kS2BJ7n36aWgZ-hqSx4NMPM8y9iyCgA&oe=6A1C310E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60ePjmf1i6MQ7kNvwH7ASNs&_nc_oc=AdpxtDxR48AsDmIiXnWJ1cTnFuNtgfT0qgLoDSKjwRPLdKRm4pw0bNp3lhxR7QAJBMs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6opCHH0xoefdRhoDV8CYnkV_VaUklzCvf1kv5NAhJzyw&oe=6A1C50F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcHphm1ENYUQ7kNvwHFr4Nd&_nc_oc=AdpCQ9X-nrJSC80Nj5eN3zOeeLLh5o0lYjiGOCHkaOr9hjDD073AOpCCj1Z9067Y5S4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b9LEqKQq3Crqa0C-nmvJyMDsglqYAMBSiLx7tzXtpIw&oe=69E75AC6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXBShFfz79sQ7kNvwFVgXu8&_nc_oc=Adovm1n5y6SrHheOTkwvI6uqzMDhQwqqw9VGhgZkQTdf_gSj9W-yJFeo-Kj5aoyW6PU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00Hq9hJBs_QLr2JLq6SQ2ZXQx5bUPjJblBRWr1sGYuxA&oe=69E7750E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fIF7zBtp4EQ7kNvwHyz21n&_nc_oc=Adp8GH0EsWppqRsmGEawAON3bOscIqMxDWRCbJ6cnp2ToFFC7kzPki8qovPW6yB1RSg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yZwVp_o5CIF9bNyNGyt6jHRmUeJ-oO7wz-gbZ8yki1w&oe=69E75CB5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
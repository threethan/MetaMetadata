dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMDn3hjHsQ4Q7kNvwHMm_jR&_nc_oc=AdpclVf-028cYU_0rLZR3h-rYf6bXrqt2IxuXr8bBx4dzdmZXBiBY2WF-Ip1N73aMdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9xFjK24aYmdAJip72TPGsj9Zq1bbNTU2Vbf56jx5q_Q&oe=6A95D146"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEyeS7_1d0cQ7kNvwHRvYv-&_nc_oc=Adoj_EIcYm_UROR2r3QYBK83WGIXbO0Hv-ijsv2bW4G0JUhYvPDHxquf2WQ1jYxoYis&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDneocriU_foHgcb0vXSPpp8YxHg_wziOZwagu2NpCJg&oe=6A95B34E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DLV-LorXZEQ7kNvwFFzk_b&_nc_oc=AdqBOCiRLCpQHXiprqLWTNp_pNPLBdkSCPROEEESnISJBC8WKoRkiHzCpdvm2C_dkms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYtEKwg-IxQbDZhKEggkx-o6uNzdL1aRHt7LWjYxVFRA&oe=6A95D335"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
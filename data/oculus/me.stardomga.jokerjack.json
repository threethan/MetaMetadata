dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1ctCG_o0DEQ7kNvwH_v51b&_nc_oc=AdomYt0M9eHCtbU8gwCatCjT8yMLViCRWkpfEMYKJOUPt5GMnDcGR93SrURujX_WQmE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz1LqjZC1njv9ttbzMcrIMMyQ7Ne_oCjAfUms5SrUagA&oe=6A940F46"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z63Qsbwl6WEQ7kNvwHv8V8C&_nc_oc=Adog--4gH3LhSHd38qlLswvAX_GTzdhL3c0ls6oGRcpVQiPmw48glE48n44Wf0cYdr0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvDaNTz6aWAfsXHV5QFGCsiTfWJ3cqsno5X3pyMvr-Rw&oe=6A94298E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DLV-LorXZEQ7kNvwG_1e36&_nc_oc=AdrsiJcNuHRKuDm5YNLqA5V5VHgAilveh8oppJvtG_63rloeRrdP73HP-jZdwdASjvw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk666tseD7Qj-zG2m9SWoQneQsfuoXOi2WUCCVzxfbSw&oe=6A941135"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
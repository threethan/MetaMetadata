dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1ctCG_o0DEQ7kNvwEAz48b&_nc_oc=AdrAKcLGFuHEGykK6hq-lKfo8cVpsKhY3i8Jckk0k-gaWGY7Ye2kc9XeZI5l9kMeqiw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT-VhFQ1l5WyQYZgULpQm8xKsX7LH2B5QnaoDNx2ao5g&oe=6A916C46"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z63Qsbwl6WEQ7kNvwFwaRo8&_nc_oc=AdoWAMAO0IdQM5dcwvQD2_SQkKAI9-PdEkvgE9nnwkSIKGbmec0dn1AFMMeZLziYRQc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmsvZ603rPDzhpPpMW_-VWwFQ0mGF-FVImgagKlF6ndg&oe=6A91868E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEGSI5yd2A8Q7kNvwEu8fUt&_nc_oc=AdoaH6mVovDNHA5K9lpo_jBN2oZ9IVelhocCnOEsLNyKan6VPH1NJSmz44sZKXs919w&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6qxxS8_j-QTBGrp24BTpqjLiL7qUPB3J2KJqGFpD8_g&oe=6A916E35"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLbG6THWWB4Q7kNvwFWyufp&_nc_oc=AdoAO8YSr5s47rW4beqJf_PZ6drZ1tB-mj3CPztgY55h1nNUS4ORt7fWuPL--sxmCCc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P4qG5opxcVLB-eMQyJM-kg9oImxI3gxpsXJMqzj3j9A&oe=6A413906"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dzp9cDNk1woQ7kNvwHyYOAx&_nc_oc=AdqPbLw_NlQ8MdrJ0GBbUap2gONerpGgLojXmguAI_wg00zT00L4wHd-uplhQfiT50k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MVyk64Met53qDEworcCX9OjzeA-PMuPavu760EKWmBg&oe=6A411B0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duxqc9EtWeAQ7kNvwGkd7W8&_nc_oc=AdokFf65kG9BlCCpzBk-ghlMubloU9hqXByS9Vmlgi5dodj6r5QRue4oL2FoD8OFgj0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uuDAPe1hZrVfQy9AAI4Yt9jFxPgt4ub6X9VWmB0bGXw&oe=6A413AF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
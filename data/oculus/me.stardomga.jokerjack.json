dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpUG11AhhYYQ7kNvwHpdyN1&_nc_oc=AdoBBe_I4TLLRayqXDBMEUWlSdMvP4TTrZUQpc-364btWoY65y8lpw6NtFsIvrwDoyA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAn6S-_gqgBYw3j_hgH0aAnqLf0Yn5qSFuT4d72D_6xg&oe=6A86E046"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxKg4KPFRb8Q7kNvwHkXpJB&_nc_oc=AdrGQC4xTlzwHM4t0HJQnuOylGg7p-AYXQsSJZnmx8oTRaWEs1QVR5Anh6Rzm08OMkg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ9ayEaU04qEIKG8IggTPoypAwldOXA5sZJUDPRWL0CA&oe=6A86FA8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-Ve4FvAQPoQ7kNvwGRS2O4&_nc_oc=Adok_8VuzmJklVU1KlOYWVcnppi9pEoia85NgIwwvu7iem9mXX-NW1KScf1JieXM5pY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxH-tV2ML1q8kWrErw9cvi2WCth-yP3ux4glepU35YEQ&oe=6A86E235"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RegZbz-bIi0Q7kNvwHF6Jzc&_nc_oc=AdrMn2oM_WiJud0sgdsR-uY62Kpcb3humpPC3C7uyw33LknIajCTrMc7fB5CyaLiVfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhnEpTrtN6KJZDeOjFd8pcpQ_dsxrgttT6UqHnVVerig&oe=6A5E3A06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M0rFuV99foQ7kNvwGUp-dF&_nc_oc=AdrbZWXg6NejE6KvLIdYfhOx4MNzpMKphxRQ-ZgCqtGl3EcDhDKKmNc5p2ReyLphugs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO-BZCaP4Omn0advMLAE2AAcz3SwdNXUBHBfWFxsY65A&oe=6A5E1C0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51Ty_YVDRwUQ7kNvwFrb_KI&_nc_oc=AdqAGcZGxG3fFiUt1tPJLSTplpbn5imqcmRcNe_aE_zjrjdlJepLo5XdsD-6H0Cu57c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZrFhC4EndAbFg8s4zkt0iuW4VLSEfO0YUZAbxxgny8g&oe=6A5E3BF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
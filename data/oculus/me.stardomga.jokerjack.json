dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf-hGdS_C2AQ7kNvwFJcAz4&_nc_oc=AdqGmuZlguXMYfhEWB5uy4xFRjEYocWgkfpF7koDh7-1SX9_EzQpHQFZUJkkVrK9jgk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAF-OldOi5M8K5vxUza3CAtwfK0kcFVHSXtDxqsN_ang&oe=6A9ED386"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syazrDPxE20Q7kNvwE1GWqI&_nc_oc=Ado1EGTNLDqaLrXun4NZmrh0Fna6wJBlWjpsE2G1Do6-a_4CsV6z0L2DutX8vc5giGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLilCEsFL-38so8RcIL1fqVgZJLPaEku7192bYYSIPcvw&oe=6A9EB58E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww29rvRc078Q7kNvwH7_xNw&_nc_oc=AdoXdzWNQuyDF5Nl7bSlr2N3eOtW0Oh0eBEom8eAoLE-ch5ixb_lOLQoQ7WpOuXNKDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLINK8pj1-03SD-ed8jHQx_FjnenG5FsAVfNQIyAc_cUg&oe=6A9ED575"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
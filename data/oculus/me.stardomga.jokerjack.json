dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gASnj13NEsQ7kNvwHaQU1C&_nc_oc=AdoCxWKriQPKPSu2lsYjonVdTkleRuzGR7zt6UtE79H9he9i9gw1-upE-xiS5J9yZLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJ6o1uGzFCQu9qhi6nEpdY_9EzUeviltQayEkZrZ34dA&oe=69CA59C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGJaxnGIzLwQ7kNvwHZZCDt&_nc_oc=AdomWGha9MPLhd57dI48rNVFHR3vT6EbvYVXFtoswu3M0bF59faoPKgdKDC9EaUDGy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyzg4dsJkLeK-WGTF5xv_OW8hQlhRJck2_A-7-uVWj65w&oe=69CA740E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT7o5DEqiHAQ7kNvwHbB_e2&_nc_oc=Ado8DGZ75pgH4m_TvhIs6XW6OfZxTZbjwjREGPDaTo4t9NT6m7xbUZYcPzsjJNv3nXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhYQ88CYANT2jnPANqbcAws2Id_ddVIOcLTEBZmD9lfg&oe=69CA5BB5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g871G79UvUYQ7kNvwHhMMl_&_nc_oc=AdpsoSy_x1FafoarVeGj5aHr3h4EcgGHYZ4K1IHQB7eLv_DoPQccYm9U4cKU7GxsPFA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sORYn4BaZ8Sbp627n_kMlibii-k-wdeO-AyWfAhtxgg&oe=6A1AFD86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROtULYSfFG8Q7kNvwH6Pe9y&_nc_oc=AdqXCMMuMcGB1ZqHXwfje313OmjLXDrPIeTOYhpYUeqYV6o46QgxYVCpSlbNT7ksKMA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IEjR8rlrUynGW5EluFAfXd6ynE2kwBWk2qWo8biMZmA&oe=6A1ADF8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8LDPJfA1sYQ7kNvwF_ehL4&_nc_oc=AdoCcMe-yNpp1LfPvO8gopUfDJVrRb9gmSc9ln7-uDBpg441iUHuV68OfAIEJNOwPiw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X2NI6kAC4SbU9L6N5cONga54teQMjXljiw11ohH56tg&oe=6A1AFF75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l23_ombpq3gQ7kNvwEkI43V&_nc_oc=AdoWFVYypZKX6XDGG-A1hdu_E21-Iz4wzR8rzVkUl85ShgWwZ8JunHt6uS5mIKljC5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZlYCcoz21BvXT9XifFFu4wPo_RNcKayNj4QKqHItUDA&oe=6A009F86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kxzBr-nfusQ7kNvwEogVcY&_nc_oc=Adrv-Ux5M3K0MFo1OBRezHyNI6C1JhaBiqtV17qXiImwUskmcgUIE1-uZeLYkUcI6OM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IgsqfC6FIFM_rFVrLPYEDYv4zJfjlXO7RMt7l_lE55Q&oe=6A00818E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vt8NpMQrewQ7kNvwHUPSrR&_nc_oc=Adr-ti_2NlqwYwr96gR8k909QStP7QlDFdKVB1jyBtZbj7Vk1WSc7IE6qWQyXLxPK2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rCHr5CmHjGlEqDsWotTxxuHwtmBnCPdri8sRTh9PCSg&oe=6A00A175"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAKt6CDyxnAQ7kNvwEpjaek&_nc_oc=AdrIc1dPa9CUxyfw3xN4OgYbtAs-xakCmDzKiWIK0BuLGU2KDKz8gRq3iHZ-cPI0BF4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzcKKAnhQExkFXjsKhxwK5teqwUkLh9lemIBn0e0Zimw&oe=6AA17686"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6qHzKYqW2EQ7kNvwEmulFN&_nc_oc=Ado3LW0Y9-iBWS_qrkDejZUcxcYiwlxylm4eogrQKMbAtu8jCfwuS3OPIPqRAD0huqk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuAcfQn92zHtfawps_0F0feLCj0coEna1txTB8HDB_vA&oe=6AA1588E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww29rvRc078Q7kNvwEdBmCq&_nc_oc=Adr95ey261y_E-aNzpBm52LeVVK97s_RbYRizmkSd8rCr_jfr2QodbstFYQ3oUhVL-E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK934SaZDAkprl1HWaNUxY2JozVkespTN7qGMO0P1SVpQ&oe=6AA17875"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
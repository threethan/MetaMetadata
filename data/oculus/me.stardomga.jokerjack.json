dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1ctCG_o0DEQ7kNvwH_BBqg&_nc_oc=AdrZAAr6Z33nXK4SCeeuB8eIZMlP_YMid1rF2l3hJpiV2VwPsYii6jeV9w7TOroRx1s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSrvo1gfLAUaapUnhEeQYUKO_Txj8wwU37iFFQU1fazQ&oe=6A92BDC6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z63Qsbwl6WEQ7kNvwExTKvk&_nc_oc=AdrnZkZVWGbeAJD-BOi-IRkN1FHMfLwIA9QMogz4XviJlBHhsXUTi7ScHC-OeV22Jfw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIhYiWKnAAZG6d1vlAMtfDH4qYyXcKFCSgy71G8aHD8g&oe=6A92D80E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DLV-LorXZEQ7kNvwHPH9xW&_nc_oc=AdoSKvQgBIvPj_23Y0ad0ugVYgSAuQceBoDEzdTeJdeGy6_lAxl2M8eX8FmCxQmaI2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU7fpLi1hK4R8UJqX-2t1l4Ala4e9k2pNCVrB4mqG0yQ&oe=6A92BFB5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9S-LH3p2-sQ7kNvwEViCtF&_nc_oc=Adr-yNOD1l7AsCVH8XF-Z51sXP1egsqeT5ewU2kHukfmvuZFnRNjjjSm6dp58PCKl7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATgCu0FNyAzfmKf1Wy9Om0uhfEsnUsbU9SZMIkjYQKgg&oe=6A64D186"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7HCsqg8O1sQ7kNvwEtyfJ3&_nc_oc=Adra8R3WVKCWTjdhdaMfinc0htGPyl46m-HsA07rXI70sZNW394ZtBIfjxhejWpcqA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqqZwTqKEP6sXZWz3BgHcwOZoQvprfdvbUsxUPIKWHMQ&oe=6A64B38E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovpWF1G109gQ7kNvwGP2FJY&_nc_oc=AdoOAOE3mVoosIM7fV32uw59y5R2D0VuvQSezMXlvpZsN7CcUKdQsXMB377Tk2q80bU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFTCOM3C9-n1N-JLrxrQp-TtNwdY4cnVyixGeVXBa48Q&oe=6A64D375"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
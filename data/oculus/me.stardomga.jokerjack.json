dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH2DUrOyj6kQ7kNvwH7eF6k&_nc_oc=Ado541TQsgi91h4LB_3-GoOzEueyBUIbnoxNUgMHyDFV4BhOc_RgNTPx6jdOvhDxaAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECmBY_ksAQaaWUnJYJXui9HPNV8dZrh7AvPWip9ramvw&oe=6A735206"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98cHsdYXBjwQ7kNvwFeB2T7&_nc_oc=AdoK6bcmkKyLoXpTbYwvInULuhlpzWSnz65FnAPtKJxzcZUg8pYSelosmRPU4RYH6yk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLD0vMz8BTVZRBHcX7UI68zQBbUpyUDVYg8et9wEahjA&oe=6A73340E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNGo-pAAdmkQ7kNvwGtb1dm&_nc_oc=AdqEoxZwR7_BEskxmlkG0AdVj1_4ZP6GpfZX467jCQJBXSoGUe9oXZvZgagPqEVe6d8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTUnoiEt0jHF-LuBnb-GPmx9G-EoG0Lz9OAXfzbCrKPA&oe=6A7353F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9as2HUnjekQ7kNvwHEStIq&_nc_oc=Adp0gG1Os87b7ezBqjl-vZPykjBDS0woyhwszJq2d3JahkYKBZbJb67kMHkJORoT_9k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGECXt6T_v-A76QqKJJZBJCf_Ds2PDH41ao1cHy_K9Aw&oe=6A54FF86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpASc7_u8IwQ7kNvwGWY-Ap&_nc_oc=Adp5bVC-kwghhzNiJOM3rjg07iWuaSIDbYuRoFy1aiVC8F2hgB70Qv8Mu_7PYXNi6_Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_AzIWNmTlmeM-zsProQ3scaNIxsXIlYUKFix9uJSrxA&oe=6A54E18E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOkbYUi2nCAQ7kNvwGaMorl&_nc_oc=AdrXiNupArKqt4kdacP8YRHF2_vRUNVenOVZCza1KGTuC8yL4spUazSGAe0wj5exWDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiH4U8D6WS1b_wwNRbSC8BpWT8NxSXVn2cjulMvHf2hg&oe=6A550175"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
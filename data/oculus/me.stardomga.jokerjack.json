uscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atxWtj4x11MQ7kNvwHChStK&_nc_oc=AdoVawdEyI8VHBnGTmA7qqeg3N-y51c_yJRs21XNl4yy416h6ncdUBKMRuOzmUSr5Ck&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dHKkOxIvKVUEHfLWN-q2xbFZBEOvc9gQSKAKcEEK1pQ&oe=6A22E686"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRfmCeP25HUQ7kNvwETBePi&_nc_oc=Adq5IC8tDDnrov1945Rf-1SRx4ltKJnASUDWqkM7K8Kc1kdv2H9F2r2ecLUgXU4-VD0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93Z-0XJvAfSKJUWiHHmykMjjYyBF2iL4YwbMwdsKet-w&oe=6A2300CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdevvxDDICIQ7kNvwH7wmrj&_nc_oc=Adp6mheGSvX3MetBnr2RORTegpqPh-7xa4bBwf0fcYgT2SYQAGc44JKDK2yfHiAxI5k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZJ0KSGUq0wgapLDwli-EhZTzrDjzeGKsqxVfH-hAl4w&oe=6A22E875"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name":
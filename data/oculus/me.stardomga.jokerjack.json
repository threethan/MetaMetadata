-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmaUCDd0_harWdXNnThfy5ixBCRQ8OM1utvqrx9Kkh-g&oe=6B01C157"}, {"file_name": "Untitled design(5).png", "id": "2126669518071187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fcEAwlFrCwQ7kNvwFNKB87&_nc_oc=AdoXlxvpPW0iAeXYDD2iMKYaeDFfVCF2edqsSv8E9xaMMRBxDq_hNVH6KmqFyz2y8ns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO2iMipa6xqaib4ZFe4ybH77k4xfSanpfOOzOyS44aug&oe=6B01EC46"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p3G0hvaOBUQ7kNvwGZvdT4&_nc_oc=AdqS1S0dhENmm4FZAhUGsWlOapLdJnkZ-D9h47w5kXMFH-_EcCNS6miOHryIWpUJQM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzPI9Mc32UrnQiku8u3lBOghCxw7ErEsF9ArJi9OzL3Q&oe=6B01CE4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3D7LPG-GhsQ7kNvwGcZOxh&_nc_oc=AdrPPORb8iq1KNJZwEQt4v5TNYUgUgvnM3C0jQq6Sta74CGgvzbSmAy1Ofg-G1-jKlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeVwE388ApbMHAhsSXyTmYOjSZp3LJwlNmmQ0L5Zs5Xw&oe=6B01EE35"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jokerjack.stardomga.me/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Stardom Game Studios", "support_website_url": null, "website_url": "https://stardomga.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24831202446558371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307422_2483059068817481_1455650575830456698_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2MCxSPpiA8Q7kNvwGo1xNH&_nc_oc=AdqR_7QqgTfKG0YdPnMHYJBiksg4yiAmvbSmEqEZq9u5x7FUflUn39_1s9VCK3PU3a4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxfvUGNstqz6V4pd98AniuwKGVLiw80Hw0bIS1UbThNQ&oe=6B01E1C4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JokerJack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic
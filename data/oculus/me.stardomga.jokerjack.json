uscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhZ8rqTQQfAQ7kNvwEp4t_i&_nc_oc=AdrceQ0oOz6vPTcAZ0yuz2-mM_WHw6LLkMlx5od0G33FvqQmp1qNnEYFW_ZbQCz6XTI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z-fLO69GIXpHva9pNh2XZciIcQGTpB8crasOVu9R3-w&oe=6A395006"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXhUIjOdku8Q7kNvwGYfC_r&_nc_oc=AdqRJxA8RJEnw6CGIdnL1gNORHViRwNWLTSRaNS-33mgIUyIj85CrV1snI4J-rLQPM0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MH4lWNdqJI6jfygazXnMRJpGYU4yyUZ966iNHU3vXSg&oe=6A39320E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYFKj224GkUQ7kNvwGI3Uxj&_nc_oc=AdrJld97aypLLD3-2RMtzu-iRjiPnXlAEJQfZhQ-4ow3SwMVL7qc4ld3e7qEOrjAp90&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5hSnYX1YZ4qoi_RAtgcInSGumPI267ejNlDLumM_tqA&oe=6A3951F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name":
-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW5TjnjMiaC3LDP2oIBj1Aj_O-RPsDTkjKpvYF6b48MA&oe=6B09AA57"}, {"file_name": "Untitled design(5).png", "id": "2126669518071187", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CB5_tWIBTkQ7kNvwG0JPw5&_nc_oc=AdokoRlHkvZoAUlIVSUdCjYGcQHLi2T9ltJDi_jvmrUww5eF3PrxXWQCAB_g5msxOwQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkA6ms7w4_PRrlPp7TENP0KUKsHNHixpeexd_NpCKRDw&oe=6B099D06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojfGXULpO8EQ7kNvwEGEPEu&_nc_oc=AdqHeDfl1_bNC46vJHKAQGaZl8FozZqGgUkctKxvNJd3GMmNXmINl0X8pDoiQl6cdEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKaG_MZfig6tl6DDJsm1YnGhPLpu4RT6KE3qalKUrNEA&oe=6B09B74E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmmTt4JhUIQQ7kNvwHtMXUn&_nc_oc=AdpQXIn9lGicAtFfEFYEZlWjf2xQJkxbc6Trt62-oTXTCJbtEtO3JYz-N6kN3URuxf8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1rGPaAZi5hNRgWlOnm3wGOLz-hA80eAcpPRlbIbOu_Q&oe=6B099EF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jokerjack.stardomga.me/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Stardom Game Studios", "support_website_url": null, "website_url": "https://stardomga.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24831202446558371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307422_2483059068817481_1455650575830456698_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCc_SEzw6sMQ7kNvwGomb3L&_nc_oc=AdruRXYncQTxl9IzjWlpXOh--kgNlD3HYAb5ayOTBgaGc-rhov_NRw9UJeGPKOA4ZPo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFu-eVmdpN5hZIwCFFAj0ARgJUxY_WOc5g49GDUvX9yQ&oe=6B09CAC4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JokerJack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic
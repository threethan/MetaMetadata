dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8IVtcGO0DcQ7kNvwHJ7P7G&_nc_oc=AdopExwhUwRDVmd9eb3LxYsKOZtyBuIfbj-BlRugbfJCc8turd8soLaisXNZ8NF1uCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2nvv8XsXpWKj8tRWgxWfmmkE6IkXrZxAFKKVU6b4xQQ&oe=6A2D7286"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0IHiHkhnjcQ7kNvwEwnC1L&_nc_oc=AdoX-WqMuhZJ7t6-hKmzCMiLqcWnj_M3wvplWFqMkOuXhb7CyqqRLd4K1LIyddpsMGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5z118wi1dmHoynfzNytIle7qaYc32-Dj74O5KRfuS3g&oe=6A2D548E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRLOQUwrv-oQ7kNvwHzF8iW&_nc_oc=AdrwEGAo_a3tD_aN7ijI7w_GLEY2zk8gSnjhjFnFUx4JUhfeqclyF5Jx5lFNUOyL2Ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vF-EN_rGWxQvkBg4F61mz6OQCmkX6ethU8GAr0Bx5Dw&oe=6A2D7475"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
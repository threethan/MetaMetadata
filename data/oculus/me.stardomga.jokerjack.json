dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1MwV9Lq_3IQ7kNvwGPgvwR&_nc_oc=AdpNqWxE1vLqmcHGBqCWHkGlZDgH99NlTfgSPOGerO5jWkZ45D41t3C4jOADPSE1Xwc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lzAo8qwvzw3Y40iENYrJuOQ05Uf1_KXTB4vZVy9qfIQ&oe=6A131486"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6S_VLbTw04Q7kNvwHRgLLp&_nc_oc=AdoPTHRBJnIIwASoC4NMcKuXBblUo9j2ExzjCxrmQTeUlpBqbBzJzjIpO1uixxGQrZo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FrNFyKzNCSvHqQrjuq1Re891Obe_TXU7BLrlvsKymww&oe=6A12F68E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieF5_5Vs8nYQ7kNvwGN7XmD&_nc_oc=Adomq7ht2u1NPgjCFanBhPlLp6NQgXNvwrdL5fj5cqbecFBt7rnkFQNWN3xJiExQD90&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K87qBc027gM5dIfJIu0sCtuQXtGR7PKMeV_HsDsfZaA&oe=6A131675"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
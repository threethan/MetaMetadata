dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gASnj13NEsQ7kNvwHB9eq5&_nc_oc=AdqO36tYuD1xxkDT3PgTy1lzbjzF3WHmypBSp6igsqRNIQSPJgaAXDL5KzlH_C5NIFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUrVdrcnWl_g0980DDhXQem90WZJ7KJpoN6jD1r9g4Rw&oe=69C90846"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGJaxnGIzLwQ7kNvwFRwq-y&_nc_oc=Adq2fYY0p_r-HlDHMJr_0-2DSegP0iTF9Ya76-wvWt7ASEvX4qC2_gzWlwdaVHu_xHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2leaoxIZs4cLmZfH55I-0YlcR-dbuzv3E7IMRa3s5eg&oe=69C9228E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT7o5DEqiHAQ7kNvwFOFvVl&_nc_oc=AdqX7e6kDQljz-i6TWSxGNrbHHelisoNaUgiogcJZ-Bik__7scwRFOWW5RU9cnstlDA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYpY64LJJFx6jpn3efXDEo9dB7PMQBUSV12cAYTh2gjQ&oe=69C90A35"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
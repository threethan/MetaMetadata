dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtTmj37GKi4Q7kNvwHgPDTo&_nc_oc=AdovZPT1v7aVOc-Bh1cZTT0wCe_DMR6qHqJLmkQ1J3_VG7I-wEeVmBWLyEd5mmgGsq8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sf56aV2LlCby-lb2vhA4SdF1L4V5_jsNp7e4MqdXhXA&oe=6A3D4486"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9fA7jsPBLEQ7kNvwF9wlAG&_nc_oc=Adp-gLwdc08mRMaK6jR01f2FUIBTPQSpS4gIIKhfWlReQPtgn7zKKcdzllS8fU0ztgY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UuYDaOEWTrGUjvUY0jEPgezNgWRsf0rxX1gGXul4Nwg&oe=6A3D268E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04KYwHxn67UQ7kNvwG8KLPr&_nc_oc=AdoxUGK08G2u4p0MQ_zU07WckFEAFR0tH2AT44DnHOQtLxFzqu7nG3QXT4o_zY0NgWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97KwVhpfE1PxB1y_012XGmrDHJMhWFV3w32ry_Qcc4aQ&oe=6A3D4675"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
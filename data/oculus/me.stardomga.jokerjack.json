dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1MwV9Lq_3IQ7kNvwF2Khe-&_nc_oc=AdqVlt38hBgR8h3w9yR-HlUepPKNSEB5u2B-A107cjsVqqvYUuVCsx6f4_EoPTtdzeY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yw2XB63tUGUzVuabrX5L2n87DPgp1tq0yJfW2eKzzaA&oe=6A15B786"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6S_VLbTw04Q7kNvwHzENvg&_nc_oc=AdqF0kFCr1cXZyQq593IvzmUvE_kTmKK5THwijheb1NqWmlpwFl_86TfKg-Pnu0sAL0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iyl_MEdJRjEogFhXi4RZ996pqQV4u_-XeSUJjtRIrmw&oe=6A15998E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE7PGm0s3sMQ7kNvwFQhZIS&_nc_oc=AdpSqDLPUQN5I776ywGbky0n3ra2pgW4a5nXZhicfhb7bkozy5AvfktVukQIBi8hDOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51dQuUtX8ndiFjTrkCW8HgVTOvelaDYpHjwFFRYxfvQQ&oe=6A15B975"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
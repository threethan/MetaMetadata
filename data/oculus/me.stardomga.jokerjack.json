dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdOPshlOaOkQ7kNvwGDLoM-&_nc_oc=Adot6sy368nxeF0JEKKF7WGFnRQuMSFWXdJcim_0Vpkx-OwGRlYMf2KUg0_O1euPxmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNdC4R4LTKdwRBZfjcUrWTZ2g-ZQ48Lp5LPirmzquETg&oe=6A576A46"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUNnOzKFXssQ7kNvwGb2UiI&_nc_oc=Adofm1nuhrHomZPoZ7waBJ_kr-fSJzoijdoyqiey3l1K6OCly_yh-GeUKJLJj93yH2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYDxTvZPnw0jv54Yxzy3T1-Se1t596pfx51c6gs1fS0w&oe=6A57848E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uncW6bXOXHEQ7kNvwGA_Wc4&_nc_oc=AdoHrutcpW1CeU-4PHV93rnl0nVsznx6ynwV9p-NziKXfRqSgy5sDBoBWxJnxgHXUsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD89EJrCslm2jxGtmuzC7cRcCdKK2kolb6sOJx2_gAsWA&oe=6A576C35"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
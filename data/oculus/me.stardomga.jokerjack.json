dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEIDa_rj50EQ7kNvwEoXqsP&_nc_oc=AdraakLdrbvbNVpZkxpLwbyQX4maBmtS-tpumGP3DHjepuvSIBRDc5aD686CsljTxuw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHXoLW5ZP_S6mUVp6Mf5aMMechSBUdU2GVPPxvAyjBTA&oe=6A68C606"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTxlu43h9C0Q7kNvwFSXFJB&_nc_oc=AdoY1R7Clf7Ujky99SJ250dubemHuaP2YEwRPTg2c1bBDYU4voKMhy_ai7KjTrrKg44&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArt24rqVD942RZL_E0Z8AsGCh9jSntXYjfIFvktI6Veg&oe=6A68A80E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhHK0HF7xmQQ7kNvwHnvmSe&_nc_oc=AdqsqpFXsjPRpK5wCSIW6YldnS-yBIXndybrRrUMauCuU1tDLriztJ76h4SD51fBIF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdc677DMpA3Sb4zeSENQH_4tgPPlN_8-y3R8RJrOwtzw&oe=6A688FB5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
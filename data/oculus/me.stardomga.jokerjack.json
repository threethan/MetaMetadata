dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-CCVkSA8CMQ7kNvwHBuwfI&_nc_oc=AdpNFi6aIbOWwjQ0ClG7q4j6HYRJsqq9-6Q1erymw1UT8bn_Om1-iQ_zNbtT0NvjbaA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71akHJ5_FxlgeXc8bd2UzQxVPCOhXz2LpYIsrGlIGu4A&oe=6A09DA06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNIWVqHTajoQ7kNvwF1pUIb&_nc_oc=Adqhc81jnBK_Ik6irCK-fEOHJKmHY2_igvwosmPQillPdq2rIAx0tu2p4b8PiTU4dYE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gZTWU2O6Msm8z1Ji0dEnsUtsng-BxkaHAH2rJA7Wsfg&oe=6A09BC0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIfBjnAdCwMQ7kNvwHCx6nU&_nc_oc=Adr8Ow_O-F3IhCIojfBkyLW8BLwqoWA6SqmBxNn72Gmn9oqoLKJO74jFt3YM20QP4i8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rrcwGXcXWDYsDc0pPIRt2xURS0Wok_1vdkFczk2qD4w&oe=6A09DBF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
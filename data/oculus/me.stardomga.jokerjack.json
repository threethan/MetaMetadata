dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCtOsOWc73sQ7kNvwFdiW9L&_nc_oc=AdrRhOJehQHw_dkAbrSUDetzBaop9FqG_FhQKRC7xn34pJakA_TPUglOMpudH4c8WY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uV_jdqRGe04ooC0PBz3pqu1T7W_4_tLTFylWNcfJISQ&oe=6A1EF206"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K462daDp4-sQ7kNvwG_RvPw&_nc_oc=Adoua7tenIpV6wilKi-HoPE1TN9_Fi6QhZErOl4trnVmSR_9rt73MyEawkp1nH4bZ0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40JjZRlrGu0bImlsg7sZqw8h3wcXWkWKGBfO6-21eBEw&oe=6A1ED40E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60ePjmf1i6MQ7kNvwHLunPa&_nc_oc=Adosl3Vfx-fU9qM6CmYI-UvbvAQ53rXWf-e_TwTvgPcYT6NnF68yzIzNaVuMWCq9o7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61jXOpDQUAQFKhK5ceWhthB0I2St9yQkQLh7L9LJfY8Q&oe=6A1EF3F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
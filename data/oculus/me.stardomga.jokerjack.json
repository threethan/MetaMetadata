dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyvPxUeBubYQ7kNvwF6mG0B&_nc_oc=Adp1Z4upOSB8-sgxMVjnNmhLSmzCqD2-rXCbKgIX3HIlwRR5J1k1VreRGjyBHo2OlTw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo1kElYsZUu_VZeWlhv6GI3e8AH1jcOFLL81QbFTPkAg&oe=6AE8A786"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2GmGsCRlIQQ7kNvwHBfdIv&_nc_oc=AdoejWFWfeWXTxNMts9WI-k2PcsZge5Ev6nqzuec1u60haVy2gIz6EIqBVGtrzp0wy8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzHkx3xnUYnKhbHW9Q7CM3QuZd8UUwDu3BE1zWMf_OBw&oe=6AE8C1CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H__tn0xJL3kQ7kNvwEDztB5&_nc_oc=Ado67aiBX8YXaRR0TNRvT5d_Gew268NchqhgRlikehqujbgmPUIJ3j-kEwCCObD_Vr4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOgAj2T-UqhgNQR8YoS6NA7TlRaxMVqaEo5cRb7qybiw&oe=6AE8A975"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
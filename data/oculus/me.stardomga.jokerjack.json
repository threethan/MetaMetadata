dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpUG11AhhYYQ7kNvwGn3kxR&_nc_oc=AdpNPPhQQL7tl116PAZyUml28UT_kYxPgvDfrM1CMnRvHETsgE0tDzw42idHmHDdnKs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfAsTZfvGNBi49IK-aby9BjJnSUy3yXDS4-LvHnD0T2A&oe=6A8831C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxKg4KPFRb8Q7kNvwE3Tz_M&_nc_oc=AdrV_AbhvGSJHtLBQAVJ0fDZ5IU9hULU5aOlI1qPdH7CFUGSQvRlFwLRWkN0QDEHNsE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN3vFcCvupl_JhuphamsnLzHV2oOFctaqoa6JKN0EKNw&oe=6A884C0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-Ve4FvAQPoQ7kNvwEYqv9O&_nc_oc=AdphAmmLH5xRM99ZkmSTbF2rwfCj75j1Cc75Cz5Dg6we0BnGB5JjiTfSut3w8MTS8rM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZIR6GUFzDF_a07ToWe41G2JNRLemtv7BRkRx8MgnjGQ&oe=6A8833B5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
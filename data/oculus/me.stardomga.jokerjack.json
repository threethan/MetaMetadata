dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZIEVHUOQqYQ7kNvwEnlsKg&_nc_oc=AdrUqsaL3ZeVFsLIiZeNLudm7cYiiTOIs1lM_eA6DJn2Z5dIiXvW1q6kuP_Ffr8HV7U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13AbSMBNn0fdQTuu7Vn9qPT68upi7m17o3UIceorO2Xg&oe=69E64186"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5BnEyKGblQQ7kNvwHEMZfK&_nc_oc=AdoOrCSzofuHqS8z3TSZg4HeXEKqpT_QQ1AEGL7CA6v_Lefr1kx9oaAkk_nmRTgNhcs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af143EM2zun3_a49pcc133fTX-oYYla-BVQg8kVTyASU0A&oe=69E6238E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fIF7zBtp4EQ7kNvwE_P5x7&_nc_oc=AdqreeY5f0Xoubfej5_SNfu9vu4bh-DP60_RZOxJvvfDCjUtGfj_qF4PxVS60PuPFjc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AY8d1-iyDUmU0fjWw3Pa7NI9rymZA7c7ZLSFZa1hzZA&oe=69E64375"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ExcpKIElysQ7kNvwEbPU5x&_nc_oc=Ado6V9Z0WtdNyDG1pWG_Yc9SzSAiZ7CMRXMJ9ZY8YXwd1XwQ5fytrT7w0_-d5Moea-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoD5CinfyiMUEBFzNyXnkTQkRPzMAlctRTfbG7u68XrQ&oe=6A6F5D86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wA6QJVyidDkQ7kNvwGs6oe3&_nc_oc=AdoWcvfczcVqyB15dgSqAO716kes8P_Gv4HG9aMmBVKwnkkSVOuWN7uuaKnnLr-Z5d0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1s5l837JUFBKNAujAAUx5ThxdG2HJ_491CjeSsDgo5g&oe=6A6F3F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b79CEhZPXEIQ7kNvwEtuhFf&_nc_oc=AdpV3zpP99nA_Ezb_tCHc-sp-n1RTrVwXg3EzfCjIXGDaKoWkNDjpW8ZRbzxZVO_LBk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjg_yI3kJx9fhFIYgzajwSa3-Kf4ghkEyxLTGABp_qxg&oe=6A6F2735"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knk8qCe8GF4Q7kNvwGWZMrd&_nc_oc=Adp-REEx2VbBPnkHGew6NbfOtApYWm7DvTEBVv57ZpQM5Np6dOmJa6ahygM1VXibpSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPD1SNB3a0DJeFSmDbogiocEsHCF4P0FXf566po7pmBg&oe=6ABFC906"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcG_qnHd4doQ7kNvwF0DlPe&_nc_oc=AdrtXgfSWCI92-dlCu29VaMNREDVINzSGk_GVPNC4bGVhS8692jbbXy14fm4Zd4RxYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ2_j2uqvEVz885x8V_wo1kifPtinqd5aZOKMiNDKH_g&oe=6ABFAB0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H09163k3nAQ7kNvwGUhgs6&_nc_oc=AdovJN6dUD7yqO6-LpNZl6nyQM9moGY2dhO4y7MY7n-GNPscUm49nfe5KKWcMcV1tu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgpxjDyuuZ9vgMHqRfTHpbOhxqUhIS-hcOeBohmKxgBw&oe=6ABFCAF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFsMmdvj1sAQ7kNvwF0uwkO&_nc_oc=AdrUqNT9MGZ_8qX-xuSWJ3uHpLZpb-7bGKWcJeuu9QUqcJDHOsKAiM0J1MeHIwRwudw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwkYt2C6SWloq1qCIWhP9K1wFUSd_PcY9UdZAmLkvhgw&oe=6A4E6806"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mpCpYT4KLcQ7kNvwE0KsBH&_nc_oc=AdpZSOUPlaY6D2qrfc-xHDPKHiVegYlwAfrjxdiaTzgRdznakv7p-JDKjl84i58b_xo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIyvflNjDaiun7DOQH0c3y7m58zMriazUO8JoPY1NJtQ&oe=6A4E4A0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4F1UxPhkFQQ7kNvwGuJCYD&_nc_oc=Adpe50GY-qEE6ocdpH_6mZtxFzdGhXr7J0WV0nlAWThla7Hcv_H49ABX1UpDViBYKxY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCbdgwFIRODEjRI_C87MhZ-eYDvcfcbObn62XAJp1Lgg&oe=6A4E69F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gASnj13NEsQ7kNvwHwoZNc&_nc_oc=Ado80yrjgb0F3fWkpPM6Edn_tdcanjFf388tNHhPq5m5-MVAM19WoyV3sb4FDJycgq4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzF1v3_wCLx3IaHgvsnNIsag1LJI4EILfv5Nu3IYzlOlg&oe=69C7B6C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGJaxnGIzLwQ7kNvwEb8Lc2&_nc_oc=AdpQpqtK7XzJOLrh_kPSOJ_MLznGtLvaXEpLdkeL3FClscM47SGHyhRfQWwvwd5DoAI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU2sDXgNNLmXt0RrEtBbQ0WTueQV24nxaoUCTXqLoqOw&oe=69C7D10E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtwrNdlRYnUQ7kNvwFbPBH5&_nc_oc=Ado760FaQAkJniYsHM1IAg9sQbZIJW-PFzT5GaCL3iUqkVqGmRX5wqS4i4Jg2nF5HaQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBaoMZJ1GtH_LCdtmqcJQSlG3q9SKjZUnuiQtoK9c6NQ&oe=69C7B8B5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
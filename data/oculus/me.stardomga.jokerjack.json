dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEIDa_rj50EQ7kNvwGa9Bfv&_nc_oc=Adr-9DkqByQqZIHHgfzcoqrBF6KJDg8hbKfWQtyk-1kA3GP-FMb7gW-sFr40v6Y3rvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVnDk2vyJfD-ZVTgfQf0V1rbukZqUrV-QXexK0nWDS3w&oe=6A677486"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTxlu43h9C0Q7kNvwHEgzpG&_nc_oc=Adq21IJXMO8ILvSUEfjxIGZZ2GoVePgjCL6372NeKPe7rd2kjkwZs8uGsI1fGSnXbAY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAufTRzrpbmCHeaV7SdbWsqoxrDpJisf-LnCebPCxIPLg&oe=6A67568E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhHK0HF7xmQQ7kNvwH6TMPi&_nc_oc=AdqM0ZtNlYQuxpfN3UaQDk_Mc1NL5huy0bzp-pEPMcbbIk6s9CDXgyzcClwSp-qmqtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC5PoSE10yK9OHMY45dESs9_RxktS3oZt3kHsZIYPlGw&oe=6A677675"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
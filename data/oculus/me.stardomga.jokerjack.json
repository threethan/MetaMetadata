dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf-hGdS_C2AQ7kNvwE9rUQB&_nc_oc=Ado81x_DRi4cWS4mOJ-HOOWgTYL6pLaSQwoRztcR4NIsGk97nCtNYNwz0Scp9T505Jc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBPkvZDsU_gG9nMK2gejhU2tV5A3JicFPhLqUJ38F7Eg&oe=6AA02506"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syazrDPxE20Q7kNvwEm5CiQ&_nc_oc=AdqC2WFSB95WDGR_rmZWHfNbqYGmbLN9iuyN0T2paBMD61Gw2DAAQPfC9ZJ6cWuzPR4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeVKeW4vTNEXQavF5XAWPSha86gWvE2lqpnCHn2Gf66A&oe=6AA0070E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww29rvRc078Q7kNvwFybcGG&_nc_oc=Ado0cv7vJ4yO_PIyNZnPDtOtISTn7iwa9hGiyXB-02Z078_6LyXyYglgApoHSdmi-1c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAcQXMqvt0eY8uKnsC5C0xGO_jV5LsoMl694OPV1R4-g&oe=6AA026F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
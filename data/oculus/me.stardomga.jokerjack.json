uscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5hmdyLfX70Q7kNvwHlup3I&_nc_oc=AdpZi23inBh4nRtcReKK4tDxJgRShcRtTjoAUBAhgwseROx6ZP2CBCpA5qDGiMpDVTM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Oaty0sIqjlWODBG28tTAeq5FC-Al_FXrkMWR_CzAVQw&oe=6A467F06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ5FUsGVf1cQ7kNvwFhh5-8&_nc_oc=AdrNBMooh_43JolSeUizBwT8WYWvBiQWR9l0n0sKP2idt-ofG5VRLx9DvNxM9piXKFU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rw2zZrniL0I294SoEBJFXvOR6FIHbWsXlhs7JH_q2mg&oe=6A46610E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEUGlJPqzNsQ7kNvwFJPDva&_nc_oc=AdoR96re6HMM-gqoX_7e9sKIjcIHD33sPGTH9HKah0NwhgG3AAjmrj_TYg2lV6zmx_k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MElRqz4Ou08pcFG7s2PNjD6Xgk1J4y-TSYKsRJZ-yRA&oe=6A4680F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name":
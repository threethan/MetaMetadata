dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNZXMPMZ-X0Q7kNvwFgQAvK&_nc_oc=AdpQCWMXIgDQOpj_JqTuB295rko4kFP1aui5MymMI1fZ3YRTNa4UfMUqjNhtUuhcVkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DTmAA7jlyJWCZcsK3yLiHy30PuqqaeORPCQLGcbyPfQ&oe=69FCAB06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frI5F6BxxaYQ7kNvwEmUCkF&_nc_oc=Adrpo6dkGDqOlTa4r-AaVwhAOS0FxTVvcPDwW79fS1a4c5bjFXpVJfSN0TM8gj8RdOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65463FmRM3Kw4KQDW4BN6qCG0N_r5-MrHN7LIkbZVrPQ&oe=69FC8D0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65hm8eRwiNQQ7kNvwFWFcYI&_nc_oc=AdrDuu3atAEuAJhVZP5Th-lkDyQJva6LKwS0e1R4oMuzwEt651pkOOQPpapqv-H7EfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oerwRppaDUUBTEJd-1zt0hFycC72cw-I7PO_0j5f0OA&oe=69FCACF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
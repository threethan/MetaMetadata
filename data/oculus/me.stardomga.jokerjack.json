dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMpHULVTEG0Q7kNvwEML-qo&_nc_oc=AdqqLbmy4x16AVdezE4UBe9h1twTm2ogl0dQa2TtYw7O9WXi-4CIvPTla__vSz4FkZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C1FhKhXY1xSgX_BjHKcH1vVeyBV4mD5bcngObZVbiEQ&oe=6A428A86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwlEskRpJqMQ7kNvwExfwIQ&_nc_oc=Adp_4RaXE6U4J1cFhxKc-Ei8JAGLTc9spO4dLYpfHSyeUgFLJIdo6L9hw4Ouhd4YoLo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y2iW3cb2k23TXwGkPVYYjXh24NkZG6Enbz-5JHmlN1Q&oe=6A426C8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duxqc9EtWeAQ7kNvwExYoAp&_nc_oc=Ado6WI7iJyjiS6XtngTY93VsbNQ2QrT_u7ROLjxIzS775xUwQWZ1tC5yiUmBiA_aEjc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9le95Mz1fAw5iOcyzUsg98YecR1zsCj765pRCHaHSZKQ&oe=6A428C75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
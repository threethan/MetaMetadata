dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMpHULVTEG0Q7kNvwG2nkQC&_nc_oc=AdpWx6DxA-h_Ez5qpEf5ZPN724rQeldFfNcroXwVUzuBjBD7TtIYqBPRQXtxaJJyWjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s43Vd4tinjkB1sH371_gyzPm-EdnEidZpylVNzXUWww&oe=6A43DC06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwlEskRpJqMQ7kNvwGvPSSL&_nc_oc=AdpTBUEukvjpV99cbsYehYPeQxXXrB61Rl3yMjouTW_kjhkB6VwpYr1D8I85sDcnuuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1_qEVVIcc2IMbtepR2XxGhzxqdUKfpj9Dc8OuKEPC9g&oe=6A43BE0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEUGlJPqzNsQ7kNvwH7-jba&_nc_oc=AdoNBJs4f39jlNJ--nIsliPYWC1BKzplDa1-TGLnYSCA0QxAHaAT1zBxFc8IV0ETIhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FfOVvVVjqTsMHaek5kasLoPEGGoO5bnZHfwxpFqLPcQ&oe=6A43DDF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
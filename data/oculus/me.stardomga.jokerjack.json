-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2HhbIYSH_f-n7KUl5e6BWEKFCetpxShfkPDg0hV-0ag&oe=6B0D9ED7"}, {"file_name": "Untitled design(5).png", "id": "2126669518071187", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyBPIiCHmGwQ7kNvwESBB1k&_nc_oc=AdpfJy3MiTlJ8760iWD4o3nr63oncu8H52vX-OaHE_Ihni-fq7lRmPaAxfZtPmjJuqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXG_bm6dzKYxBwP4RDzQO9ix8XzQsldy_HBOXtUd20wg&oe=6B0DC9C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYvIptJgDV0Q7kNvwF0f-Lq&_nc_oc=AdrtOtLlNHfMqop84jz0bDHmNPVgqM9hPd38xccKxprCnkoB00MdOxlSVD3hN8SEXcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRO9a8p-wZz-JIzTMgXUbUm_nTpgrYpseB4VGF3NCdRcQ&oe=6B0DABCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl0ZklmS4mIQ7kNvwFm3TXK&_nc_oc=AdpY1ayL_iOlvqXUr-ynyy9mf4NhWgxFdNqQmBpHkLLjwGE5HwxOlvhEy6HpTKOAMmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSq_4DIsd10-c9BzOg3JTj0F-bFPZHzBj_qtpG1ylgvWQ&oe=6B0DCBB5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jokerjack.stardomga.me/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Stardom Game Studios", "support_website_url": null, "website_url": "https://stardomga.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24831202446558371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307422_2483059068817481_1455650575830456698_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iag77nCKL0Q7kNvwF_ED84&_nc_oc=AdpyADtJespTr_tljVGHfXx29_H8G_8oG2qvMnDRf3FyIOySbuwFcdMvfBh1jnhwe1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBPQ4_Z59lvLj8LcQ8qXsfL5xKOOltRC43OqB-eCquDQ&oe=6B0DBF44"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JokerJack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtTmj37GKi4Q7kNvwGMqgHd&_nc_oc=AdoOYO0dlbZbssrtq3tS-7SP7CHre5qUuIIrE0TbP7pC5RD-3IhzcU1xGIt8TYsymbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V-11uWW0T2CG3v2fvQxlbbOtBxS5Re9mx6n2zmTVEOA&oe=6A3AA186"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9fA7jsPBLEQ7kNvwEH4cwQ&_nc_oc=AdoZWoM2_WVTXNumYhVeSvUA_TnLeOdCpqBzF0nOZ32aHQqb0E-7dPcSdSh4seeUXTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I2_HnjTWPouAquPe1uJ3goGflil9-mKkVkxEb_QoGdA&oe=6A3A838E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYFKj224GkUQ7kNvwFXGm86&_nc_oc=Adpl3z8bfZ7BLEXoaMWbxu2MB0FycK2Hintk89GtD0OKRdTGGuiwKE5qjh7DNGMyfW8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C-LuZPBjAtOv7ZMKwBrxzsNUBj4EAKsnSQl-9d4kjyA&oe=6A3AA375"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
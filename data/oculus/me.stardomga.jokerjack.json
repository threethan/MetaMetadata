dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLbG6THWWB4Q7kNvwEohSAm&_nc_oc=AdopA4H24vew-9La86CzyRtsjwi4wWawIFjr1szVammvoWVcMJn64hI1NwOPSfqrDpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K369oAJa0_nElQp-lmqkhsJfzLClovrGkucKk6ysYEQ&oe=6A3FE786"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dzp9cDNk1woQ7kNvwHUBvbC&_nc_oc=Adqyq5bAPgDsdXrM-8bxQFVrrCDORRg0OtaFSeKS3GVD8ubZd4CyVLDxzsfJjkMbF9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I5eufc1PO3mvqlTMStyS0ZJSe-uZNFrBlwr8_AQi2nA&oe=6A3FC98E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duxqc9EtWeAQ7kNvwG71q58&_nc_oc=AdoYvIQ9A6L_bmqHHIN91JBobdozIHNKQquFMy2I_05lPG5doY60p9x6wJWgg4lcw4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gNFaDRY9xjdbYdqeA9KqQu6GswFoZj1IPmVJNa5MRNg&oe=6A3FE975"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
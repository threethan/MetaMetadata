dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t04-51FwVksQ7kNvwGK9XLt&_nc_oc=Adrs4plpYWXtt1-i0WqX_CxTrnLIe_KrqAAqNzqDQECPYffP4fm4e3ZIQrVAAeRS_Vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyE-5Pa5WIlAzM06rZa91BK33b5bbd8G7DdgXko_Gg6w&oe=6A843D46"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOoOlnpd6noQ7kNvwHueIag&_nc_oc=Ado5Ijr3XrIdS9Kb2FmnkyNrvYB0nASHwzlTV19TuLt12_zhZ4hBIN0A4RIq4oh3F3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl7JmS9rqSsDEfrTm4L2Aq8aSn0is69nxiA3X8y-1k3w&oe=6A84578E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaMANs20zCkQ7kNvwGfdoo2&_nc_oc=AdqnT_I3R8isL0HJckAbva54zUML_JQ5G59GTLziklzb8glEFhNirkU9jwNoPiHD48w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN4bQlmZEAz7uT02QE8xOsILnWMaT9SbcMTOkBSEx6Zg&oe=6A843F35"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
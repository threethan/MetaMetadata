uscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhZ8rqTQQfAQ7kNvwEYsx0E&_nc_oc=AdrWly_oicIE2rHLfkEfNImxQVxVVMnZl8LIYkgTuFdswZIQcczsxi2efUadCrv_bjk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dXqYdGGWQsFwU8IR-Dv_pc2uqhWKmac-bKdDlVBZajQ&oe=6A36AD06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXhUIjOdku8Q7kNvwFU60Ek&_nc_oc=AdrDJAQeM1lxNB9FIMgl0sXR_grFL_RWvwHlQduukMSUJcjuFtXiNd6whz_D4e3XQB8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xyGwCYdEe_Cw6qsoMeSFyytoaMT2evLGoIvOGG6MOKw&oe=6A368F0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmKO5R9SUPgQ7kNvwGfEaPb&_nc_oc=AdqyQt6n7g9HIl4Rf9ebaMJQl9TFAON1BWvfVL-xzIcSiJOagSNGfjpo2gtXiNJHJHk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YQKqjI91tPZ-0kTJWWPrTaUuvABg3R8L3A4QeBZMuOA&oe=6A36AEF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name":
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RegZbz-bIi0Q7kNvwFF2I7T&_nc_oc=AdoljVauP9hyWfitdEkiDyR9RFHIaOEQseMePEsVYCaCrqMBUli7lHaYmnFI3qxkCPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCAZW3GodxS642digBwcr1N9vc4osNAgHEwrOGNBTx7w&oe=6A5F8B86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M0rFuV99foQ7kNvwHtW_91&_nc_oc=AdpUgV3FZFpbKgEpkqSJmek9LPBiaVi-s8ALkJzA2Zok2Fno3iuvi-YWrIIQ3nbApvY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCevXYgmSXU2dPxwQizhf9tVo-qnqYjtN8HXauMGRBC8A&oe=6A5F6D8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK6hD9wOEB0Q7kNvwEFmaZ8&_nc_oc=AdrbwN1Vnu1fnf0X4y9gpUHmeJZJ3bmYD4YxJ3E9Taa_n7qsqPSpV5gJ0Fn05CCil-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgtCBqZy-bFn8J8o1FAf_wETJlm0k1achdhiqANBCB9Q&oe=6A5F5535"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
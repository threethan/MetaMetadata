dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVnnfkPnddYQ7kNvwEhbMmo&_nc_oc=Adp3x5l6IzDWuTQ-LRfBf2SMy0FZ0KoLf0xww3pW83rmqTW6_y_StwxnEyEW3P00ggo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA9R8nQzAQRIt_di9VCMZdRxemIsdaZDUH6gk7C8NyuA&oe=6A6A1786"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytc4AYkj2KkQ7kNvwFoSvdZ&_nc_oc=AdrNUkp5KsjjyOIiGm8GnNGkTvPsNMXsAa7xYeaEtos-J774XILbO1Q3ykc7I8zIcxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADNYRllnsK6J8_gybfxzdyskJSlqOzocN6SrHiXDsXdg&oe=6A69F98E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhHK0HF7xmQQ7kNvwH64RCA&_nc_oc=AdprwY5NX0Kq24e_DkT9bm9oEuyc6hWaNR6ZZBp5eAdsTvDhgcwuNUZvIvhdx8pT8ZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd6sDC0uN5HO3DxTV9qLPvMPOC0b_sBv5iV627u8lONw&oe=6A69E135"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
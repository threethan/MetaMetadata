dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8Y1n8OgMmoQ7kNvwH3gvdV&_nc_oc=AdpfwQWd7kFu2u_t4mM1WRRqiakgmvnqfEFgybkkzNUubJngAS6ZlM5cUMIbOlgJYVk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9JCrkb56jkP-O0LRK9K75WloNj4A93CWjTtrF3zgMgw&oe=6A5A4586"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbh8coYHFs8Q7kNvwFZKbcV&_nc_oc=Ado6ki3uC7yPXBpXbTUAaWaWNXkq_lgGIQQ7zHwnS4FTiXSboU_LMUuwtRZ11M8ATe0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYZ_BvAfo4Qv-fUQk0QewmPF_1Ou54vLkEX0MZo-ivfw&oe=6A5A278E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uncW6bXOXHEQ7kNvwEpsRum&_nc_oc=AdrTMQmKBEt8OgDN_4-bwqRZkPApIaugR3VWjM1G283tZPc_vohCTY9FtqRn5NLxvRo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnn4fU489MZgPX5u-wmi3UDyz9h6lVNdeiD7cGNlCClw&oe=6A5A4775"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
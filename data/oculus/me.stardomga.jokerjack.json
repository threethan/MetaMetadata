dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9S-LH3p2-sQ7kNvwFQia_y&_nc_oc=AdrHDdormemUiGv73S3nTIC51DGgfM2SYJKST8FA_tinPofCeFzdI81v6N4XFO8Nfzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkJyk7JwJT2ayqO0gxgy35ogiZfoI4Vs6ZAwjL04ehiw&oe=6A622E86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7HCsqg8O1sQ7kNvwFTXE6c&_nc_oc=Ado9oPe0K-N_pef4rXsatdUPbh-FyUt4HHHr_V1ygWCIjLQHgOZo7Bbu5mLphuRyD5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNglEHvw7YZbaqa9SeD7ez-wK4u2vDJNP4zBPir2x8hA&oe=6A62108E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK6hD9wOEB0Q7kNvwHYythN&_nc_oc=AdoHpWC-W927qQImvxth_c2340B4m_I1n8Zfjr-03EhFVeerCKY3dcZezG3WVBTXJVU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5jqnsEFB5Rb0YPTcgZi8_uuk6A2fKrxS35hvbkbQx_w&oe=6A623075"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
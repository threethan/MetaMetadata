dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMDn3hjHsQ4Q7kNvwGWMY_N&_nc_oc=AdozqOQmrIeZh6nL5ou9_4qOolRpkj8lKucQF3L9bpvggDMoE7H0hyAaag1CO4gz6sw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQGoXfgk6V7jMsh3R5faFlkShoqZXpBINlyOj2x2Ce4A&oe=6A983C06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEyeS7_1d0cQ7kNvwEOq3z5&_nc_oc=Adqemudq82fsWwXoGC1CGmouPqQx76cGOsry7VgeN8eOUNhTg5kCVKCu-GxmvEgOWBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9-qeVCTFGPHQE26GkAHvH5NtEssvadN_x2BlT7UH3aQ&oe=6A98564E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geKjOCmTupEQ7kNvwEWHsp2&_nc_oc=AdpEpubjnVCvfcdTzNUNa5rSfaMcVJDC9RcXNAYn1RnnHvWnfMB7WF7NRsWGDRumJTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3BGyPHIjar6476D3daEIDbPm6-127DT68V9HTrmLzqA&oe=6A983DF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
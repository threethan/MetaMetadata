dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yHmFaSnI_8Q7kNvwFJBE02&_nc_oc=AdoyaQOTHWxsB72591ca1hVktNc0811kyvcfNBmUYWFo3A_gz4rnUafXEbPIognEEwo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIfHfqDpN94B1GPpY5DbAgQT9ADHhYhRw0_JOm6yMMBQ&oe=6ADE1B86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp1Gw4frFVEQ7kNvwFxjGJg&_nc_oc=AdrS0euuslTJIiFivMvaRxTYwAXSmHurLq6t1ioGy1-Ff2cXd5n68bCTpJN8MP2ckxc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1Gp-6Jd-CNgIlmU-zOyCWgH1hS9oJI0D8Ung3kqvg-Q&oe=6ADDFD8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNTBhLhh5oAQ7kNvwGG6Gto&_nc_oc=AdoLbLgG9w35qkkuH2OLz0cLKuN7OVEiPAygPg_LhR8gnxKDcElk6zwJqLJvs4HTblM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKreW9oUzI8S57gK51uScbTBb5A_5t97tkDaO2e_CD0Q&oe=6ADE1D75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
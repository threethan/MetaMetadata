dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g871G79UvUYQ7kNvwGqg0i3&_nc_oc=AdoZeNRVOfiMM08A1m0LaRdwiJLyZEPGTlGS8xXmXOpoNwG8Tb90ceXl_trqWN9l_Js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57TVTKAk8PQf2N8G8XB6LRQksXC_8K4f38VjzFzfKKdQ&oe=6A1DA086"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROtULYSfFG8Q7kNvwGg9uOH&_nc_oc=AdouSU3k8aY1hwBVxG_npoqwbyyyKrjrsWR5apDU3w4FJicnDyg6FFgtPQX3LHqnIYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CL88ZrCMP3Zww_v_pGFKFicK69EHwS0uNMKrOIUriJA&oe=6A1D828E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60ePjmf1i6MQ7kNvwG4XY_A&_nc_oc=Adr4DleGNR-z2iAqEsgwiRRCE-tTaBFdtYyZJnp8ix4K477lwhKoNejE96-vGx-wuzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l6rY2SIqpOjKJbuYpmdvcICCwiJ0bMoEYJ7jIc7R9jw&oe=6A1DA275"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
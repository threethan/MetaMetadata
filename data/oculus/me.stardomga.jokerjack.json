126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iqhPj4vgiYQ7kNvwErdxQp&_nc_oc=Adm3pRjk1XjbkV8Nvgo8qWOBIZWNu5HAQ-Rrt0vHTWL3aZmy81BY1GSX1mFbCxqV0BU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcEPDgzRafDndlPrmBQ3pYLUSeqoOzmruJEQxLMvrnSg&oe=69BE7C46"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-83o7nOaASYQ7kNvwHngdTp&_nc_oc=AdlPLwHKt-cBONSwEtDixBnjXKBBhO4o86XeeN6dco39cIEq6fCmd0n2E7k9kw5aGZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfybtNGHpSFf6rL9HZK0WWPIYZihlJKD-hJUYWmoRJaxdQ&oe=69BE968E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofjAiVm3deQQ7kNvwE6WU6A&_nc_oc=Adkgr1eJ7r6wOiMkdb3vxknMtoW-5mDlPPhpZogUztzY00cAlhBvy3YILHZ-E9H1UR8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx03n3h7JBU6tyc4E6bh84CCAZYgvL9bqhV3ZwP6Pk46A&oe=69BE7E35"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jokerjack.stardomga.me/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Stardom Game Studios", "support_website_url": null, "website_url": "https://stardomga.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24831202446558371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307422_2483059068817481_1455650575830456698_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGUxYUIAhTYQ7kNvwGSQpEv&_nc_oc=AdkIOZ-qgF91jPtD1JyUxxluFEwU26eTkfivMhwJF7aRmbWfkr5vAeCV5ZdmiyHT9pM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVrHxwxbY1J9UJuIIychJdfoWYC2xrrH_zgGksjbPm1Q&oe=69BEAA04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JokerJack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1765561860, "lastRevision": {"nodes": [{"id": "24831202483225034", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24831202439891705", "is_first_party": false
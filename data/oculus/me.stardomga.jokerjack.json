dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtTmj37GKi4Q7kNvwGC-kP1&_nc_oc=AdoJ_-QpImgsx_tdkLLTDZqD2hf3Ic5-RYTmcNKcJQIEgjBQUredE14iSgavOxoocDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8IAN3fYSGqr0nujJYBqWMxdb_lMxjk9MfEdevhB4Mdw&oe=6A3BF306"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9fA7jsPBLEQ7kNvwFgP2hz&_nc_oc=AdrCgdNcqD7X_E517vuEIQXZwMehnFWixQDADaHIDeCjuq8HN0Nwe1-yquoZwDmL1Fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q7WD6hIkwyJ_6B-fzdYLi8QItabi_DsyneMzW_WYHAQ&oe=6A3BD50E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04KYwHxn67UQ7kNvwH0jZTQ&_nc_oc=AdrHAtFiKvM7qVM_spW1IhqKl97gRk6zs7_6X0ZvY5touSfEx1SLsYdsnzQogwUyFP0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ju6-0fZny30pnKp94N43b49P9CquDGFFUQNu_q4CgWQ&oe=6A3BF4F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
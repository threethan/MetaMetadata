dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBKpbJOL5DAQ7kNvwHr4Q2o&_nc_oc=AdrjdDUF24GY0NS7fgZrfY_VUtoGyr-S2eCh-FOHpuJbHftwCInaPsTG3msnwNk8h7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHje-QY2vk70s2LNceGXx-GVZGM8PCito3VnxOKNpD3xg&oe=6A8048C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_EWumqUW3YQ7kNvwGJYTcL&_nc_oc=AdqIf2ZLuoB-LCWXFC6jAEMYN9LUq_O8UJRnJRRTAyipHfoNa9LHBR4BFj91NbjfOgQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRnMf8mJAxiFtX_JGDL-cGvQIYMlQ0-BBZGw0pKOobGQ&oe=6A80630E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIRhELUc4iEQ7kNvwG8cAOG&_nc_oc=Adql6H_PTYUiBbJvUybmaRuwRA4EweGW4twpf5n27LoWFNe-77z1LVHLyoU_2kps3Z8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFH3FL4zBU_WcRv4CpIF2CyrvXcTjrJgN3PLmKT15FmA&oe=6A804AB5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyvPxUeBubYQ7kNvwE50TdA&_nc_oc=Adp3Tvc_TjA-AgoSVjlRR2ODxQo8Mx5XnINOOGQ2GsRL8LFHGX6wwvKRnwN6Rul0ibY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmaNyPrJFCbG_aqbbiyoYwn3r8V5cSHxvwKfjcRsYm8Q&oe=6AEB4A86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2GmGsCRlIQQ7kNvwG6u7Xm&_nc_oc=AdrO3TFt9Br5DrEZsKP9LS1u5lL2prL55uCUobcJ8QCXYX-Plkp45a7adjDkDQoCjnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiGJii3mEALZOASmPfsCvxZB8YZwsUfNjPT8LZ3Vp0_Q&oe=6AEB2C8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPrVulV1YnwQ7kNvwFoC0IV&_nc_oc=AdooQxWedpeFIzJZaAK-4hw5mBzyUx-MSQjUJ2rq6P3QY9l_pmJ_oBQgQUYEbxsZwxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTReYMfS1W5reqPx_aY2p54HYBk4SPbF0ktUXaj--7loQ&oe=6AEB4C75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
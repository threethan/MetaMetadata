dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8Y1n8OgMmoQ7kNvwGgET3z&_nc_oc=AdqFGDr7xjnhH6OmkNTwk-paGuKUOWUDt6BFSAsesxSUUJc3K978w8IsfRNBEhQh7f4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZNv6WCJBjQKIGHDDGnZfKOhPX_ziArocpX25CBtpxJA&oe=6A5CB046"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbh8coYHFs8Q7kNvwHOgZ9n&_nc_oc=AdpUigVKbvLQ1ot2tA6Jim02P4L82shDba0WfS2352KMI2cpNYcP3euzwtMvUn2TwVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDggAGUILPU8vP6N-s1YE23jGgJ_39uHAQmUxk28Sr1Iw&oe=6A5CCA8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51Ty_YVDRwUQ7kNvwE2FBKX&_nc_oc=AdpbirFya29B4wXlmNfCKDc6ZL7x6ZH6xsIboNvFIPIBPdKwuptH7G5qA6PlhHWzptU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCty4hR_cKLfCLKYmx9yUh7sCNOl0_uuHiHtpGL7n-CzA&oe=6A5CB235"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
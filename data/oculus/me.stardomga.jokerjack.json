dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMDn3hjHsQ4Q7kNvwH6S7VP&_nc_oc=AdrwwfrBwxYaq106k3Uqvz_K2_TLwISgx-MfbhZ2YW0On4pefO7ihW5Ip7X5CRzSHZU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvdUv1uIcXq7xA2oUs2WD4dgy-kv0Cnijd4Le8ziazgw&oe=6A9722C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEyeS7_1d0cQ7kNvwG9RX1D&_nc_oc=Adr9e3bQasgEvzT06AllUalX9Zyej4o0XXmHnfADEpoUVnk0Q9g98GHYfke_OLAWzok&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDlXbHhtN5Sm09BPshnWJ0ydchGewuK21InyCLSzigxg&oe=6A973D0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geKjOCmTupEQ7kNvwHYNFgf&_nc_oc=Adqp5KvDdmVnprb8E9MhkBsFUqmWCBmJDQVdb0PTKloVuPdcqx77FIESYYg8oEXQ6jM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjrTEOrguUOj0VlIouPNJkykpW7Zftry3N3rHrJUOOag&oe=6A9724B5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJb2idg7xa3-dfTU2c52oV2S26N5yrjmBv0cCsArRGbw&oe=6B0312D7"}, {"file_name": "Untitled design(5).png", "id": "2126669518071187", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fcEAwlFrCwQ7kNvwE7vWGb&_nc_oc=AdppEvPUG93JpZqSR_QM6N9GC4OnhtI55h2LVlZSmIVrvkOerjFpL8Gvwk6M2PIBgR4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaXAMHVtcsDeA0-LtvUB6yA3-3sLCq18ZMI6Ikmmm8QQ&oe=6B030586"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p3G0hvaOBUQ7kNvwFGjkpJ&_nc_oc=AdqXFA3tqRtIMP9oYtJA4wWjVWAsBhmtpBCnpiKtDxJWuezrkdfm7eBE4wTEX7cnyck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHoEMOSLJ2gbmUYZdjIBSIYiHdNMsF_BiXHRenUxIvaA&oe=6B031FCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3D7LPG-GhsQ7kNvwHw6tMV&_nc_oc=Adr1Qvls8Na_vaMx8tlkWSvjqwOJH_LZjVgzyWU8Kzc3MWMgQVBAQ_gEW-hL--W6Vf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR77KiNCfEc2NfrHGVlQPA4sYSgZKiPjBn33f9QPuT7Q&oe=6B030775"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jokerjack.stardomga.me/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Stardom Game Studios", "support_website_url": null, "website_url": "https://stardomga.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24831202446558371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307422_2483059068817481_1455650575830456698_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1VCxfYRAIQQ7kNvwGjKEPM&_nc_oc=AdpFDVR_PvH4AsIkvcYqF9dCY3XHlpIerLqfVg6kPhUL5T4G_dBf9z9rsg2PD1OAXaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcx7QlkaDfJRZJjMiDvg7fCDh-KyA7OXHYNFWYEIiqlA&oe=6B033344"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JokerJack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic
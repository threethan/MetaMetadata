dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdOPshlOaOkQ7kNvwEkCr3U&_nc_oc=AdofnhI8gYvycyPnuzOWbqLGdetuZZ9TaFaelPH66cfF83AqsOLeWLTbeQQw_-HIJ20&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8kJwb1txdqtLs8Bu2iy1uhBfwxkif61jRU0ANAM_OFg&oe=6A58F406"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUNnOzKFXssQ7kNvwGtM6RQ&_nc_oc=Adr8zbSqolP1N8YFiCyNih8cVVT8u3oT5U8X8K4fTWUp9cla1Xx1RUBRisKlDWSZg5o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfWAsQ8CcVoWkZ1WY75D8vPmy8s9aayzh5fZElDssnHQ&oe=6A58D60E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uncW6bXOXHEQ7kNvwHHs9SH&_nc_oc=Adp5FydXW2wdEnbG-iL5uY2M6qbEcH6s-HG_9csNyN6Y1WW_htCM_f3FjZs-9QpFS0c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMHQN4nJp8pBKCJd8rqFi97DAES2Q4KpYY-okIXF-MCg&oe=6A58F5F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
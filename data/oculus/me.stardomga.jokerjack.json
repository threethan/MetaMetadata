dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e3S-M_sOoAQ7kNvwHvnRMS&_nc_oc=Adq1oXyjuh5gS0Zf0lkLIlsQm2WJQlMFubU3lJuqYO51cyXkNueOgd0gL5fcA8SwKp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-00J1yFkUqjIj-sq9hYrrl9eTuH3EqluTT96uOqHHqg&oe=69EDF246"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbgsinKJfPYQ7kNvwHYF5td&_nc_oc=AdpAfh7bvODE5KQmKMtKVNt5pHsB6unszAq3tHwI0RUyTjbf-3p1yuMh7r0U2tmvpP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s2Z9POzMOEFZKmEX6vZiCO4xTRNzna_LRHYpEZd-k-w&oe=69EE0C8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R3TzV4GSA8Q7kNvwExx7z5&_nc_oc=AdpAKat8aJVz50Awywqlwn557UlGrxDe3AIJmW2Uck3doyc0pEpGU8W_n4E0gqAac34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21HvjYjNq1pV8U7fEZ_xfLGT_y-if02L1P9-BZ7-jdpA&oe=69EDF435"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
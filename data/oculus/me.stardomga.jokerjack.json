dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYUYN0rNndoQ7kNvwHAKn1E&_nc_oc=Adr2VbwTC1RBQR70z67MlyyWb0xpCHj6sVMxl6UyrAFraR2lnh7rq7a1ixFhnNjh1Cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AF34Mwv82xVkkcAMYxdGqJAU1oB0ff6bDNNf6GTRDIg&oe=6A034286"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_MgyHiy15kQ7kNvwGzav0t&_nc_oc=AdqGp_nrCSXIoESn_LHPOFrKLYr5fUTooxhfaBJMh8nlA9aDtzEQQWQb3n-lfacOZKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OpgzB7DaFMxjstcRaC7WvjtYdIgqOMwH4CnyIYiAbnQ&oe=6A03248E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vt8NpMQrewQ7kNvwGXUTI0&_nc_oc=AdqVX2gdzRC8SRRF0Gj-pMj5KjgVXhyp4mE62KA4dl416spNgeXUJHKocYxxtw9s_-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b_2XcYNSH1bF7j13jhNB7yC_7uOLC-bqtGQlgUwZObA&oe=6A034475"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
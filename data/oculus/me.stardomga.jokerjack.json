dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNERq6SgGbUQ7kNvwFSzCth&_nc_oc=AdrKosEL9VoWM1A5xBmkYteMuNf0aVzq-YCMEwLvuKnbTGWhVqfGIqUyjn_VqB3WXE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL2NmEeiMfy51E6hmOQ3jwsy68ubYrm9YIiWNM9Ha8Sg&oe=6AB7E006"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCB4OUVS0_IQ7kNvwE1d6MI&_nc_oc=Adru2X4XNXZkYEuFvn_liNEVUD19ezHWHNjvikc_ZBl3o_APAm3_QZkgjtwYYJ4HK2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNdIGPVPftOqhPqmOgqj2a4VQg6Hi90tCXN4NnJAHDgg&oe=6AB7C20E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilmcnlHTcSkQ7kNvwEHE-97&_nc_oc=Ado4dEUvPJ01syTYUJ7V-uT9IeKxO23JS4glOWfpWE78Xa0nKDEgtOwbX_-XdgSmZIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLkOxZbl4SyDAqay0yaRmmJILyoLTLQVUA4QqGV_Ad8Q&oe=6AB7E1F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88dtcV1ar5UQ7kNvwFWWmUP&_nc_oc=AdqEh3gke8COm7VSNwPh35k9DpG-4NJr9LwnXSDcbYuhiFTONBVCs6wgKFncx56nHaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LawInXgV30pRHlEUem8SVW_yU8tTMr1FU87G6_IWweA&oe=69D63746"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr8fyZiM4boQ7kNvwEApX19&_nc_oc=AdrScYLHERBK8Fk8DaVz3-KcF3jAS_t359ovhnCdC4UtHIGJdpMwpv6wSGZRYyF71ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uFz0QRVZFdKZdRqSas1RAjBFaSdd1UE34pFzIDPIWyw&oe=69D6518E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRavzk-NN_8Q7kNvwFBgPZe&_nc_oc=AdrdFWw5njAIxKrBtANUoLyjtPwi4zGY54Ed9cBFlzqbdrTow9zbleHYVTnFH0T9_hM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LFBWHSkdP5MAcZByDWf5bejjS7m9ilkSfnWsqXEqXDQ&oe=69D63935"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
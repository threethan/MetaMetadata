dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFlm-q7QZKMQ7kNvwGDicBu&_nc_oc=AdpJWkmAmbA7GAXVjoABrZfztVi_VVM24oyuBjqfrhI_Yv6biHRwH8WHcKMedCQ5PMY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BU8xdAvSAxH1gtJu5_-IPotTK2ok3qW6ftdIBzeeghA&oe=69F37086"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DQmfNgBkq4Q7kNvwGiXNEv&_nc_oc=AdokUCN1vVppEGoRtOduBAPfyjPUeFtNDCCEs5MNZvB61N_J72SjyvOprlbtzdvNUG4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tw1j5e-jTOFKZ1-cJjq8schGbFRJMlRqtmqiyVBLPwQ&oe=69F3528E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56mA0IWU6QEQ7kNvwHTz0Rs&_nc_oc=AdpAwQxIYacCnBTKwqviG4QeIvJsrSNC3UQ0b_kZasiHZ6O2SDnATPh3f6X5Ui3XO5o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2J-njJntzn0bbv44NEvrbsV0nB3XpocZ2qU1rNI6_u9A&oe=69F37275"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
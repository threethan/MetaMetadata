-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_bqLhi3jxsCWaJ3boVTMtOUjV1Ox7IZoV8bwTlYlRxQ&oe=6AFB29D7"}, {"file_name": "Untitled design(5).png", "id": "2126669518071187", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMxDMsIenjwQ7kNvwE0tDX_&_nc_oc=AdocPDDr1ptnbil0rmUG4fkwpA14Ey0rWFYqDWP1Z8KfxyfvwYaBUQ7x3Yt25Yf-sII&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcZEYjHMe8R40HhY2F7H5z2ByLPAJhXIrNTQ_tLgV5kg&oe=6AFB1C86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj_8cyMFi2gQ7kNvwGAI9hU&_nc_oc=AdqHq22HHkAEJA1u3TrEhq3U5NWEO7jEV5BtzswIXTC0laGLHHuNHdZeYzNm0bhQxck&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuW7RZehFUqkWzALg1J3aAIU_wBZeGJNVgJOX6d8fAUA&oe=6AFB36CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v32Nn1CqvYoQ7kNvwF5O1YB&_nc_oc=AdpwT42ODjro9Suw5C_AnJ8mX2mgLYunKpc4rZfgNolK9nXNQ_m8yrdndTITK92mphA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsqXJNaHEXl3PxHFBad-XInKcQGHn0LiQE2O2HrlxmiA&oe=6AFB1E75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jokerjack.stardomga.me/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Stardom Game Studios", "support_website_url": null, "website_url": "https://stardomga.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24831202446558371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307422_2483059068817481_1455650575830456698_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJUEdwu6rBUQ7kNvwGtkmnE&_nc_oc=AdrKA9RbkziXWPZtNGZFXZjDVxv1GYGaXAY1plqdE4MYZRmXJoshcpJT_Afa9VjDej8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuxGCNKeQe7D5Ut2lXOPkE9LTO2irPmFJrTcsnEbdcJw&oe=6AFB4A44"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "JokerJack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic
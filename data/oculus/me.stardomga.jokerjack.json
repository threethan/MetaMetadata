dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yxM_tVJC-sQ7kNvwGEPtha&_nc_oc=AdqfuGPQo-Cchy5OevxkihIEO266jfnH13rvTax1ncbxusxoA3ynEO3gZEBDC8nZCQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBYdBFHlJH0UxMTCPkiAxHUSuTJFa4OyY9xJty2qEqeg&oe=6AF5D686"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSrM4graZDAQ7kNvwEIaj4U&_nc_oc=Adoy6iFTO0RcHDbTswPZJu_7uQo18rGkP4f_uNWsgGMh-qqEEB7_Y9vL_R3DzZuzGoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzoTU63styeZEcinAYWTDitO17xhhbd7oVxmmou_jExw&oe=6AF5F0CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM4d9lCSp5gQ7kNvwGMmp3f&_nc_oc=Adqh3DHgZKB1Vvw649BYxXdLi2uBrkPn3PeHmWdyewmd2ELYcUh0fuVCY_NwVdoBLxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAWZ-ijlw52YuyejhK2v_aGPD1wVCbG7Omios7q2-Lww&oe=6AF5D875"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
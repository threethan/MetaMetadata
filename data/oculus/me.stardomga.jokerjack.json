dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgeLuqPWWxMQ7kNvwHALgRu&_nc_oc=AdqT0NKOsJg6MZZBZllZPig6jAbfgyrLIBGmhCjIMnGiuPb5IsOcNPScsWuBNP6DTB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeUwEr9LqHxnzJNxIr-CMx9WIWrBrq6a3DWVZN9MUHDQ&oe=6A4BC506"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP2yd3IXaZAQ7kNvwF61oox&_nc_oc=AdoBU_FZ3fqadXDPD-45pK6yYI3uVnOhJ5an-9qqCxMREwk1P3bP_0aF6BhpSBxKR2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfR-bOSb9tDrGOytvcH9WnDyhtG870PTVuoGvG0Y6grw&oe=6A4BA70E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4F1UxPhkFQQ7kNvwGnTs0E&_nc_oc=AdopFJmoxm1II7d8DuVcJkhQKMgrJ8_5AVZ-Mnz9Qi8ekIONcvfboj_r4Q3VfWU5atg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWjmCG8Al92tpsvp9g0IZC0qaL1C50syKKIivA438ujw&oe=6A4BC6F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
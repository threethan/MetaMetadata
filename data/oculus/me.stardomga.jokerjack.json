dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgeLuqPWWxMQ7kNvwEdhe_1&_nc_oc=Ado7OUP-l5d0qBm-u7O0pfzvcsXdNHeDwqRw9BTa8LjmBJ1__p9xYR6ybhcXQpN3hEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlLkaUDlqzmMim5ovtznKP-MU5h83vM-pFvwBHMSIngQ&oe=6A4A7386"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP2yd3IXaZAQ7kNvwFIhBxZ&_nc_oc=AdreDg8ipE89Y1VZ8qEFkJO48VvSmr0HjLv9rDwapIJV-sQllLXS-qR_FvrKh9R6sv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA7sPYB6d9TuthTnLw45czrJX8ykFidopk1u2A2ozIcw&oe=6A4A558E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAd7SHX7zB0Q7kNvwFMt1ua&_nc_oc=Adq8esaEJ_H_z2xZbE3uULUACCRHOFyoL55hkhGhASMiUq_gYfBxxGjo5RgH55-O_NE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpto086ScHd9itxywrJl2ZjWDiz1OlpNOGjtKO7l5UcQ&oe=6A4A7575"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVnnfkPnddYQ7kNvwHTZ0rf&_nc_oc=Adocy3GCn5NZ_QQBfsnz9fH4qjxrq9Xknrbdv6sfC3ewL3omjDbqYRuB_nC-D7wh0ic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFMEA6XUHnS-0E4uWLwhf99ILGpjt3dIAD2q7Gn7lxYA&oe=6A6CBA86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytc4AYkj2KkQ7kNvwH9IFws&_nc_oc=AdoM5BHoacCEGOH09oOgLO444aYjcPkSUqYr-gmwGRQiPbxfawJYpWKlq2oOLQHnDJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa_Goomis2rzzOW8_tCApjzbwVkh6fHLGsA_7hOoKV-A&oe=6A6C9C8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JemXUv-NxKUQ7kNvwEhgf2F&_nc_oc=Adr-InwcXVagBMQWhh0YVOaOqJ6jNTAX6ZdsnHVCW0jM084lYUqWJ6YehgVM_T4mjSQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9fyYI6cAf9eHitwu3f64xYPcgDjJmbambyNyO-_u9MQ&oe=6A6CBC75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
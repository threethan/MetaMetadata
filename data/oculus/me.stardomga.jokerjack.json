1.oculuscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpUG11AhhYYQ7kNvwEOkVkK&_nc_oc=Adpd2L7P56mDXNp3_RQfkO4IuQ-kTHwM3LmWhUtKsJyKLJ9raLavJ5WIFYa69LCedZA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjn-Ae_VXD5TuMHXHa3rFbQL1BFLlejMQfg3KxlCdbhA&oe=6A858EC6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxKg4KPFRb8Q7kNvwESi2Pl&_nc_oc=Adp6r-3mfUS5I5Pcn_38eDYMc_1wvCByTfPaVZJdYJiD0ia9pZIhqDVNKOI-ljZbX9U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHjv0aU8MKtPdk_E_eWh7Kk7dxl7QoGir0FYAzS1VRvg&oe=6A85A90E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaMANs20zCkQ7kNvwFmVVp8&_nc_oc=AdoHF-Z4lCSQi-btN39Qv8dcEVS0GiGJF-coajpYCg8VlTiN4n9fzziwgboCQN8B0iY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHohKtTP65-laEGhKkWbDDkJC8u5yFRLrss45_GCc2gGQ&oe=6A8590B5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_na
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjPxFfYGuMgQ7kNvwFRdkxu&_nc_oc=Ado_5gWLcEvTL-dECqV9KFaviB6cXJyQ41qTEQvyVP4apacaVM5kAbxTwZmqZLEWbCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFfRPJ6NrrQd4tVp_m3OhIoedI43-V1RFCpkP-6vZAbQ&oe=6AC3BD86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwV2KGiXWKcQ7kNvwGJW1d-&_nc_oc=AdoDKF7EsN_ZZgvba5zTb4Y-6jZ_jnawWRiixfX9IteKoAZyu6vS3ibDT6SC9rQ6-xc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaEdJ2piuygRwqWgeZJjdzqwgAreTgNEEkzBb_imoYhQ&oe=6AC3D7CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfEHYCvi4eQQ7kNvwEXbsxN&_nc_oc=AdqAZxqL7dee2-VXe_KKL3RuibOCYP8GeVp1gWhZKP4KJhuEeaR9iC-fJ_TLt5dTCjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUXf7YST6TwN5mj2W2x22wzKk-lJkzlnkLD0sCrnIO5w&oe=6AC3BF75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23QLWkvMqtsQ7kNvwGVU1S9&_nc_oc=Adr0bIbpHHbNTFQ0E976j81pXhiKhO2Yie8L9vzi5frA9v11J9CokwgzBh48msTysDs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXy-us4nkcTMZE11aSLTnGbD6jFTrL4HDJzjX0hgowFg&oe=6AD0EC86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14SqxammfHgQ7kNvwFJpQS5&_nc_oc=AdpaCrJ6L3J_apXzLyFrcrid3Z4RQrkCvyaEYQaVpEwklKWFEHcYIrbIIliQzczHCv4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObXlG7tAKOAXISXztQEgxN4maW1u1dRIWxzLnE3YkmAw&oe=6AD106CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6swEZPXhyMQ7kNvwH4vuxh&_nc_oc=AdoRzvDm7VKBiVS8dIIW5Ed5U1xmxKeP9yajRp2GXDVSI7ZENuaScRZc-E3KTHYnnek&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkp-5yU9Go_2n0uuN75Kt9E3ha9ji6aU3I20RcfT0PGQ&oe=6AD0EE75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
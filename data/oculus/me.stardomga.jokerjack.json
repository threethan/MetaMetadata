dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpUrdP49qaQQ7kNvwFN0OXq&_nc_oc=Adr2_kMNhCoKQuV00p2q1eo6g4PDzpHXo4S__It3hhyy1HT5FxLMOigph7Y8NebsTqs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfZMLsEncq8Zv6PXDOvxUKiSqz9AKKNOsHH70ZhUllxw&oe=6AC90386"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmKIu2CqgswQ7kNvwE9XdqK&_nc_oc=AdqTU9sYQX3PUU8zPoCLoUo2BxNwCx1CkEEDC_Fo5cyO1vg_Dl-5qTVa_HSQxxbsbAo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0Umsthfz74UKUV490880j6AMe9C6sdT5PbZD5gMQ2FQ&oe=6AC8E58E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq8TbIgmDUMQ7kNvwEHv3V_&_nc_oc=AdqmTkJfp_CS7Hg6zmV9ArwxNAJ5YcdghomVywWiQtvKYFHDpwfOQ05gIavDcHM_lok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhsYekjEa8Y_4j4Sb4IO-tXPp-n5coCfq5HnUtkhywlQ&oe=6AC90575"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
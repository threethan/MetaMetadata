uscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBKpbJOL5DAQ7kNvwHBYMbs&_nc_oc=Adq-g37ZquWRT1W9ZW9uJwwWmvPs8T4h8JAlokk6XpBTL-c6b6Y4V4SGVxnNGCH84r8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa2RmCWHobqDxBatUj-YBZCIJu69O41R43aXJ7IV_vwA&oe=6A7DA5C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_EWumqUW3YQ7kNvwEN-5tY&_nc_oc=AdqU-QITbqb29p3O8o8qNtMihmVmQBWk7_d08Fu4F2oV1Kmdf5De_YU5eqwTponMR8g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyjwnwHiEPKm21-pe_w2V4nYIuuGFzgmOuyAqgAPm-bA&oe=6A7DC00E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7lgOEcm-qwQ7kNvwEFHuYa&_nc_oc=Adpw1RENRGDubYUm4rI9CDy_ypWb58NDPRzKofrQzRzgqHGoHkpG-BcCzHS0fRxw024&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAtdeGVrIoktwFiSizsdvDR5Zy92dGile3sdI7M51WYg&oe=6A7DA7B5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name":
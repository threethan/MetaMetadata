dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88dtcV1ar5UQ7kNvwGrd8zZ&_nc_oc=AdqRJEucCdeTA58MJDwbXaJaM9dMwU4nIkWtpQAZ-FzyZMFwYSuJa4W71iFwL-yDt1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RBC7jj7PPL9Me5BPlC07OK7PscZM_OdsLpvXOumk5qA&oe=69D4E5C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr8fyZiM4boQ7kNvwH6JJ6F&_nc_oc=AdqVdqSdyo7lUvIxRjnSpTCREKVt__B_s0urf5Y77Z41URm9rkizBIwd01PsT9f4-sQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03eWNyJurNmTYE9rDqKaQ0JlVwSw6KNYRnQV7Wlwz2pQ&oe=69D5000E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRavzk-NN_8Q7kNvwFgz0X3&_nc_oc=Adq7q2GVuaOBJMf4mYdkmF68cIx28i6O-XUgeiLcARUg5LcVyz5OavvHhJ05iLckQLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fqyi45NYMKh5-9CHrgmzhIWU6kpnxuNl3y6KVNnja-Q&oe=69D4E7B5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9S-LH3p2-sQ7kNvwHWQXvO&_nc_oc=Adp_Qd70_moOkhK3sGXX3NbaLtIL0F3i3d2zjpHxBqP62mzcDA9TkE35BvAPhJp79bY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeHjn5nKZQF8P7mvro7Iv9RrcIR3RcLACABn02SjOQBw&oe=6A638006"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7HCsqg8O1sQ7kNvwG6MnQE&_nc_oc=Adryxus_8CfxS0Ft_73jbS_lMhj4KhzEI1FCkSzeO1-_sl3VRR3ocuUmRKJMP-u6Trs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzqMErnIGn8joyAiMAEeBimZ_qPOiPI7s-u0nstJh1eQ&oe=6A63620E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovpWF1G109gQ7kNvwHZf3ci&_nc_oc=Adq1pFOhPhiFhc38JyLnE5hTOUXOmeyNusjndZEnWGDPRW__3tTf539kmo3lzVMl3gg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXYXpKgQs24pJa8d-cu67VQFDQuknQ-ldfiUwwFYd29g&oe=6A6381F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EweRjgkcDYQ7kNvwF3KKYE&_nc_oc=AdqFuD7cAW7YFGlJWkzU5hsTXj1ZRY34Ika7ouoPjyN9wrpZYMzOjGaS55SPl46-PBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRmNHtenY3u_tb_zEBp37WJ5FofKmN_oR_gdHu2rkIbQ&oe=6AEDED86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBlpUt3BqgQQ7kNvwF8Cjam&_nc_oc=Adp-VsueCd3T3i4g-8-s_sJatKF3J4s1jh-PH4ebSeBP16dcie2tIUOGcKKZPfnUpiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwLZcWpuxaiznZtK14FjuD7-sL_gguqWYlAxLXWXW6Sw&oe=6AEE07CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXf1b5RJZJkQ7kNvwEcdfAJ&_nc_oc=AdoQzhZJFzchH6g9qXCFTC48jnBhxL41M_-yU6CqZRmPZ3B5TN0FTngN767kQGIlxrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcr3abeVlPzi10BbNMztBmG8A-AXg9Te9bCF51WthFRA&oe=6AEDEF75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
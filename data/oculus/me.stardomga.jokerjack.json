dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMxDMsIenjwQ7kNvwFUUH7y&_nc_oc=AdpXwYOTASW9xrQ-845L4y7BMes8ZW6vp7lKEMNUKwaZBB9jrN-HvRGyWjJF2sYvMfo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbTFEnsnVq9wIcvrycgVdwkmHP0b3jtYj9tBr46r_-Og&oe=6AF9CB06"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj_8cyMFi2gQ7kNvwFQEnKx&_nc_oc=AdqBORLwCxV-qJfBYlEqagEgYpWNUr7VnHrnVanELZdK_Ljx2Zi3PaePkqZQ_-sRkWE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROxZ9086Y1Uag0iRCw_lbHYoLrSSqR0mfnXidGrQL6-Q&oe=6AF9E54E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v32Nn1CqvYoQ7kNvwHv5P4N&_nc_oc=AdoVxPwtDEWEXFuGR-5GkNiQ6YJTQFBdFgDGODdLudep-b_Tyig3TyKA1Ssvl1LNyJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQlrOG8CT0AIGLlEaNNEfFR19PTwE1Xftn5qnkI1W3lw&oe=6AF9CCF5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
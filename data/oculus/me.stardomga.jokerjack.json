dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irN0lC7Hn0sQ7kNvwGK5130&_nc_oc=AdoZVsuH5uh5jF6mPfO65fT8xL4h4_baBSp1hb1zJjdIlXJoAiHEzdYVBO6vIfgwGj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BHlUe56wnzzXJK4QSB9v5HC3VJ5jsdHl9HED0msH5Yw&oe=6A316706"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtX_YA23D-wQ7kNvwGQ_fSh&_nc_oc=Adp1vPqkrCLqatY4DahjVfs6qGYJYE1NVaxhr7iN9tYbNjbG-sqFtImGbNpSCXfTudY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ALb9qPYNfX3fpa0_B474Fm4AINUe3vwqjZJ0Ceq2hLw&oe=6A31490E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK1KAoa3aRMQ7kNvwE1vJ43&_nc_oc=AdohCytBgq89SSdRWN7dvySxRAtMFiVvykHSy4BeotJRVaxv7KB9kzfIfvkTS1TkAqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QjS9aTejDgZ1v9sQpGzOff_gYbW6vqCS9Y0IZDGd7OQ&oe=6A3168F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atxWtj4x11MQ7kNvwH1SAPO&_nc_oc=AdqpwrSgUlqrbm2MkSNqSiFG852Igin6u42Ff60mvzJ-yyVZViROUC20WAQDmOkSgfQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HkWVZ67LL2X--nUGfovCCL7bNmSwlYlOZYq1clKy46A&oe=6A243806"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRfmCeP25HUQ7kNvwFlz80i&_nc_oc=AdqHgARXaiJzlUYYf4iksyDrrVfVp8v80yndMPa9N_ASS7tcZnAzeGcMoj94AHZXaNY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a6dDK7joT_-UkTCCJpMEH2x38CGv-E-B61qNP11cOWQ&oe=6A241A0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0A09qw4vgYQ7kNvwF-GI20&_nc_oc=AdrpjDhQz-aCESdhXFMwBPaRcqbzTXNevn0Ar-moELhziOQma95ZxmYczBX8S1l-ykk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sO7ZlumJkCPF7a-fdgXfPHmDHjg1SE_Hjr3SQ38KVGQ&oe=6A2439F5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
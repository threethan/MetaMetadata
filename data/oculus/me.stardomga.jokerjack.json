1.oculuscdn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwGG0yX-krkQ7kNvwExtWGa&_nc_oc=Adr4bAZxkqtI_2VB6oHz-le3FyCk07DbfXiLc_ZIuRxuSGsJhtmhrKKVyXkK9jtbMzo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnhm51u3OUd24JeqMF93nbU5REmysVSt85a1ZemWEv4g&oe=6A8EC946"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASPn-3bstJsQ7kNvwFnnWw0&_nc_oc=Adr5Nu7RZDp2CYtyzRYhDi-Q6sHz5WhHx4V-fIXYo1FY7AGd_zBXobkgjEZ8yO--JO4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEOhTYjPy7aL4Wuj_yHhWfPcV6QT5mYE_ZOQ8wxVqyvA&oe=6A8EE38E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEGSI5yd2A8Q7kNvwFGptVc&_nc_oc=AdqWd_W7_S70VVMkrhBcJ-75IvhmexCs7bH_Gf6hdUxu4TRv8Fwp-dThAHNEz5FY5rQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMArwzzcxEzweQu0GN9FxWUEvN4u4n57kmMEf4hnKNvA&oe=6A8ECB35"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_na
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_Q9F2xuxjsQ7kNvwHZ3h1_&_nc_oc=Adq4GCbje6e-gK3NwCGJPSPRZZHLup1row9lSEN7IlVMptc2KYVewQ99oO6lasqUvus&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9p-i55bHmeSE2dri1mDCQxkNxETSbJtpLiGbGU7t3XQg&oe=6A355B86"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlU80h0RuzsQ7kNvwFlWSqb&_nc_oc=AdrQtFUZPrYFAZQKeeEvgMQaZ5opNWkk7bI1Km3Irs93u6-rthF0HUTblXY1zbKrHl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Id40JiJjRCoe1zkjql-KyIvXiU3zBJQghxoPdQ6bZZA&oe=6A3575CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmKO5R9SUPgQ7kNvwFXJzQT&_nc_oc=AdpCHuK1RtTi2oiZF4Za57L1Jm0uz2UCCrrhCZrn95xaPMMxy3UVEUn-gVsvop2ra7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-diQqsbJAEDpwd1qhLhyMBaCTSR6Pr66Y-ijSKIcuw8Q&oe=6A355D75"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
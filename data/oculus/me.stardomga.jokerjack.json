dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCtOsOWc73sQ7kNvwG359Ja&_nc_oc=AdoXi0GBLr2ZfbBqAnM8jP0wG5nL8p0wxI8ATZ_sE31S33bJx9_UosSuilKfOvuwcbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rvAnYJp00q31zFjIzndWiLjPTrZHS9CkT8MD62xrpjg&oe=6A204386"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K462daDp4-sQ7kNvwG-Ctz7&_nc_oc=AdoMjEWruNLin2qq9PF21p6Eh78xYythc_jsQxFtZBuMBTabYvCyVTjjUAcuFZ8PByA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7V4IZiTP87T-maBhxtbidXiVmm3fcIaUlZ6OULSn8Xag&oe=6A20258E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdevvxDDICIQ7kNvwFFobis&_nc_oc=AdoRjq_XftbnJZPLT2LzphVfbIFsn77BbZFEeUNFBVwrqNnIGREtZlqxyT46DInPnNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af507x70EiyoaqhJsJIqKsHX00lcAs39H5GweWdw2DIV1Q&oe=6A204575"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
dn.com/v/t64.5771-25/499304938_2126669521404520_4889245258205898908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e3S-M_sOoAQ7kNvwF2cLV1&_nc_oc=Adqyat8h5z9aXQRpkvgoX-y8SiqbTZkT9lkFQOCd0O1EV8GEePolcwVukv0R1GUggxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af101fn6fQ5Ufx4JnDL6ecB58Mn7T6o0cedWm_QarsFF8Q&oe=69ECA0C6"}, {"file_name": "Untitled design(6).png", "id": "835759135999888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_835759139333221_1226925382221171697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbgsinKJfPYQ7kNvwFLkygf&_nc_oc=AdrfxLh0iU86-MwxuEc39V4cfsNqH5_G1z3rQvof1Sx8IiCWC2tH1TCUG1Ov_S53VRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PKDr2jwRmLojRbdfePwecIAJUKPPCyjdrl9IULNblYQ&oe=69ECBB0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Add a heading.png", "id": "1138780128062732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1138780131396065_6580589823139770703_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R3TzV4GSA8Q7kNvwE3Uobr&_nc_oc=AdpPMY5QOXmGWauOrkQDLeRd-TeyWUBXeSvTqqoHjjfmxUVD9CJ6IHtVfsJxB7FMo5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LuOJTMihBAq4kN5Z22meCUIg9LkBaUIpMwqAgmfzjvA&oe=69ECA2B5"}, "display_name": "JokerJack", "keywords": ["casino", "balatro", "blackjack", "deckbuilder", "rougelike"], "long_description": "JokerJack is a roguelike deck-builder that fuses the classic tension of Blackjack with the addictive scoring mechanics of Balatro. Unlike traditional casino games where the house always wins, JokerJack allows players to break the rules using a variety of modifiers.\n\nThe goal isn't just to beat the dealer, it is to generate massive scores by combining playing cards with game-altering (and sometimes game-breaking) Jokers to overcome exponentially growing target scores.\n", "short_description": "JokerJack is a Roguelike Blackjack game inspired by Balatro."}]}, "developer_name": null, "
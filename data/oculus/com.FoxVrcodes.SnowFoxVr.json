 Friends (Game Moved)", "keywords": [], "long_description": "The point of this game is to have fun with your friends while running around exploring a snowy landscape and getting cool cosmetics. It's a friendly and kind space where you aim to discover the mystery of what is going on at the government testing facility and what will happen next!\n\nCome and try out this fun game where you and your friends run around as snow foxes while you follow the storyline.", "short_description": "Game Has moved to Snow FOx Vr 2 \n\nhttps://www.meta.com/en-gb/experiences/6462029810541492/?utm_source=developer.oculus.com&utm_medium=oculusredirect"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/foxvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FoxVr", "support_website_url": null, "website_url": "https://sites.google.com/view/foxvr/privacy-policy", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24216756804636181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974574_885196862674224_7922113059599088964_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-Aqa1zJ_b8Q7kNvwFkgpz5&_nc_oc=Adm33dG_tqscUdOfkICoC2jyQSYgOKfjJrA9-gzHd5ihEXvisibGNFsr_Mm51-8ALfY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLpHtm4NA
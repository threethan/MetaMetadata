he VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WARbfLo72UQ7kNvwGSdWqv&_nc_oc=AdomV4WOj5tFHr90peEBHpLpF-dYEo440N04qLzxjdeizrFmeN_40DbnDXXVAGth8rM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f9jdiYoC6YNjOva4eHDxHxccAHxvjIhyFQ-7XWFO5Fw&oe=6A11B7EC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Place To Pray", "pl
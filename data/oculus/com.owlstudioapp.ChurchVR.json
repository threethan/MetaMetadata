g&oe=6A71F70F"}, {"file_name": "screen3.png", "id": "4440897666185575", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH5igPyFVzkQ7kNvwGKuyvR&_nc_oc=Ado7Z_jFeVKI4DSSiJldDCGv_J701C22i6DnwqJyd08oAJ6N2N0752P5sobefwLvx1M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7w5FPJ13_50smz9PRZt2_6NhiKjvszIK3ogtpxNOBvw&oe=6A71ECB9"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMkUCBrF4lgQ7kNvwG69I7z&_nc_oc=AdqBMJe39V01WwNYX_0r7Js2EpVfarLR5tbZO_mqMuoilIbel0Dlk5vZgCO64XnmWn4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa61dzyDr6apdDce1RenVmFDQ0nJf1045UTJRK8G_PQw&oe=6A71E451"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reh0GXUCVDwQ7kNvwGFkI9h&_nc_oc=Adq8ATKxxIMIVKpLOyra4B9JohCU__mg9LUH9shrF3KMMsYWiRbcJ3XseXotwG1KbtM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSqUxf_vr8lC5J4CaLwxdBnnjf70Ork8HkigEY8Md9Yg&oe=6A71D222"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0AGV0sgygEQ7kNvwGXbBpn&_nc_oc=Adpwm76MSqo-NTeNRRVWS6WBVKEzpoTlOH-fmgXtig-jcu-hJ-I9iR1WDQxbNGX3eEY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgkGo3rGmY1WtR-wXAWOifyPtufq-8DP4ThRJVlNO00w&oe=
Q&oe=6A203A0F"}, {"file_name": "screen3.png", "id": "4440897666185575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CKMtyBNWsQQ7kNvwHMZsbu&_nc_oc=AdrLthBTH2QAvaiOVgWfRwaaOirCBJnO_eX6k5n_csQ8KAyyPGNtdn7ZgCp6oGf60Nk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zVogM13LKgD8aKF4SGnfQCgxTS5lHfbgA_xMY3tiiAg&oe=6A202FB9"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QkeGO4UYwwQ7kNvwFYKxco&_nc_oc=AdpL9x-waDoj3YNWIfesSkoZ_vUiCbCjSU8NUD-KNIPTgl28Ar2QcDdtE8JRw2oCkkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42-DQFdXRY1yDAMUq0JWVoAcfG6EAuvSFvuXMglkPewA&oe=6A202751"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsnT4QOckJIQ7kNvwEFten5&_nc_oc=AdoY70XfYwCQSQjQOqLXeqxBed8DGyj4TziRQmgcGC_Uj20-Mo0TrHfCzvjqg4oL728&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h4ZyEvUCSLO7yHDQlMJ5f7ur45ghA-aslti_WVrc8tQ&oe=6A204D62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpVHXILITCEQ7kNvwHs1QGh&_nc_oc=Adq3wCTvWlFzuGi1YI_2NLODl77Vw3pw_tqYMde3g14YlGj9GLMLjK8qep9dgKiAzq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tcmhivgLJEtvwklx17JWsOOklPW4E3hmFGUxgd3-y5Q&oe=
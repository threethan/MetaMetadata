71-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NROkSBPFo70Q7kNvwHoT5R1&_nc_oc=AdrBc9zmGIPYs6cxkvNKXzu7ZKhYJ-vq7Y_Cc4xk7EWX-H2nCIPNY-AQks2qvZdMM50&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x0Fj96T7N5pZnouzAwBl0BNMuzMfS5qk-p3FuwBXWFw&oe=69FDE8B9"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX1tNnr2I4UQ7kNvwHGPDcP&_nc_oc=AdpA2UXpphYDjk1Ec2x9XnVeaZwsbILjfZz1NDz1aSKD9DQ6GJ9sj3r-8imKpvmyloQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tE0J8AsbwwzE8_R0qOsxqtoKFwCHfPapMLy-G9CitsQ&oe=69FDE051"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5o5CKwks-4Q7kNvwFEYe7Y&_nc_oc=Adq1394CnCT997Vww52Dc3dA0A3y2Q9WCbbBNsyrJ7IzmX5towwdOqAp3CyR_Fu_-KI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55OSrk551rK4UDlZ9xVgygdg9TQvsHXyuApx5aBQlS3w&oe=69FE0662"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iFeDkR2yoAQ7kNvwEC5_lT&_nc_oc=AdrgM3FZRnjRySlmiNWX9cTNIYeF6L7wHS6JL1IoHQXBdZth5OB1ypRbKrTdqr7zc68&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gwtK98wiUjXJntqaSi4T-MScBNvo_3A8W0AajfaO64A&oe=69FDF16C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Place To Pray", "platform":
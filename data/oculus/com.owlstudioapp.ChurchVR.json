.com/v/t64.5771-25/491823310_1516669653355998_8200203795901674021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBGrdhnmMtUQ7kNvwH4G_n7&_nc_oc=Adp16x8bZQjkgfobLbRlnEFYrp0cTWWveGIXasl6X7_0uBqE138YBqW39EaW-NtwoRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlE01piZ8QbNnoyquypjsRDmBUAPJy2NUZPMJ1Cz7-RA&oe=6B05B19D"}, {"file_name": "screen2.png", "id": "1322291033091633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_1322291039758299_253983758757080095_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0MwkmgmLHsQ7kNvwGlDVkX&_nc_oc=AdoADploRX1nauuHfqbf-8u_CO-hpLS3fQwc6wecga2CNdqk3xKXkRW9sKl2CLpkQxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYc-jM2ZZ648OZEQymSDjq_CcVlXMwJ3747nOt_JN5UA&oe=6B05D74F"}, {"file_name": "screen3.png", "id": "4440897666185575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKb5mQ-mDwEQ7kNvwH_AGyU&_nc_oc=Adr6uBsII1Svk7vy5ojS2Q7aSB4Z6OBDgNw3HhjxWWl44ooO5dBKieN6EaUgbSwKEZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTJXhBNv11R8iaQo1VL88dBhf1HvvDgBYMOsGH7bgmSw&oe=6B05CCF9"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNCHmzN7JV8Q7kNvwGOWUv1&_nc_oc=Adq27UScJsclsRlbwfZjub13WeNnM8i3SNmpJc1LFI5k6fyoFOXdxrtuxbdv4o2XwJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2QKohHcIuviXiFYGS30nhH7V8L9rsivIqWgMSZynDiA&oe=6B05C491"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtu3qUmSIHwQ7kNvwG-weHr&_nc_oc=AdqM6Ey0hFlriZ43l2DrQ4-hrUX1AQrAPnOUMOwnwI97MOCdSQSycu-CiwJlO29eYEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBgKAf9yfEfHqzS7ymuz7hzTyzkAtmYlqgqCkvgYDShQ&oe=6B05B262"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED",
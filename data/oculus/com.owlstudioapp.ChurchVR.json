710284281272825072_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk8ut_aA9s0Q7kNvwHESXel&_nc_oc=Adp8Fbh-AKKMFNr1mS1qdzN5rWcI0F-0tnewMdJDRmh-zzk1FcBBvoW3esD79NNzwu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcGQoRpt3ZZqRyuuYt2CnvbAVMJTpz1swTRj7P2Ti-9g&oe=6B0DAD91"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtPJratTAn4Q7kNvwEc7cQA&_nc_oc=Adr3cqVUtqyJ77cgniNXkbR8qa0EFChSGwrB3PMY8GFtDoNdLFKbLEc7cXIDuRGe-QM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-au3koNCmlmE7kEwIRVW_4vJmqWLJ274c49hCJ4zCQQ&oe=6B0D9B62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "deve
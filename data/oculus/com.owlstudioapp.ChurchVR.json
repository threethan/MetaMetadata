0a&_nc_ohc=wdbixHZuACwQ7kNvwHcy8Hb&_nc_oc=AdrHYZdO2PeJwvrYFGN8oO94AKyTc9HkyLgWsi2hJ-iBtzgoHjj4oqRK6AywVks_-KI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3WEVm9gaKMvS8_JIFSvk9kMTL0VC5zE1ZrGkrfJXwqfg&oe=69F0B9B9"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgvG9qIHy7YQ7kNvwHNSfoe&_nc_oc=AdrXp3jaFPnDpVo1gvBfo1bR4qqMXtX5GrAgfDehlNkqhIPR37jpFhcGr4aK-HmYxcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0obr8tNDnVHZRVJ4HBLF7JNL5Sf-pcIj4RSL28h_Xy1g&oe=69F0B151"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulAmFb1QdDUQ7kNvwEnoZ8s&_nc_oc=AdpnHaLvQDTXi_J1UwPs0GnecyJIc6AXeDX7BHolRKsvfqRY9hduAxK7Nf1-s5uop_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3wacIna_BrglAaT7zsqXapMr9W7mv6rqlmZKTc0Ahyqg&oe=69F09F22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a58v32yWzrkQ7kNvwHsCXaH&_nc_oc=AdqUROorRsuTNpdSnS1iO2sovyXU86NzgRuPteAOKUqyWn1YWv5LZJXHyWuVV71WnUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af069BYYq0_ZN1gCwtX7a7DLt07qUdZ3ft6dA5HjeT16_Q&oe=69F0C26C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Place To Pray", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellne
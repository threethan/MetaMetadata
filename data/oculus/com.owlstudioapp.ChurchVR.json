_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdbixHZuACwQ7kNvwHmUJGx&_nc_oc=AdqO7QYv42olpoqxZ7N5iFc8nFtZojaM3KTOkwqnF0Qi9aQBJGU7NifR20qP_qKYZek&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3nu2z7PQbN2SPrzPBYU-oymv4nnOZOF395Fon-EulGUQ&oe=69F20B39"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgvG9qIHy7YQ7kNvwF5cgdl&_nc_oc=AdpRrWWp2PodBDQUvGEwLlVWv90b0XDQymE6voe6GovjFGK4ZPIyL1U3qBQmQsRGLnk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1TF2_FW_uaaBkgxTGjq0RoWdUWnf_9NcqFCrO0Pl4Wsw&oe=69F202D1"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulAmFb1QdDUQ7kNvwESc5UB&_nc_oc=AdoTDSfkZwmOHnthNk-VfXnE7OxSWH5dGErPLaKEWYBOlHU-ngz_8tJeENvRnRPermI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0bzu-HFM9-z5LlkdNggB4R-CWcyjycgpw-fai3u83JwQ&oe=69F1F0A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion
.com/v/t64.5771-25/491823310_1516669653355998_8200203795901674021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wstTl6i453kQ7kNvwHh3tdl&_nc_oc=AdoSONMuQqAKDPixSQsi3IpoVdv5vCzr_h6o_ivWwseS_cCynFADZmJ31HKf6JEw5iY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2Cys8ko5FhuqQ39D3neQn3jFZDWtTAYPvsJ5w8d8ONg&oe=6B030E9D"}, {"file_name": "screen2.png", "id": "1322291033091633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1322291039758299_253983758757080095_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXX83DjlMy4Q7kNvwEz5Dpf&_nc_oc=AdrhNLxSoazUOunRNZ3AAlgvG1dS9IDoeiDJ2tZBbcrEm4Tl1v135w81Ppapg16EooE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9rMPR7CL6aZxRWZxd28OY6w6xOGjU6k1NGkp7gBDIRg&oe=6B03344F"}, {"file_name": "screen3.png", "id": "4440897666185575", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMPofJk4vBIQ7kNvwG-AVwb&_nc_oc=Adp-BoePtE2-H5Wf9qAGs0WYEymuWS7d446oHQr-hwHDYWwFzUXW-fsbUDEmTJPFUpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlVb09-lUk94kvaX3Mo4Q6pbFcgPwbApeb4VXYgCchog&oe=6B0329F9"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgRMrGMgFuQQ7kNvwGzQ2kY&_nc_oc=AdqRmooxwZaZCu3e3qRoeA26m3YuGQctcggLk3eS0iNzfUSxAc1xnMtrktGQV9LVNWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtZfJJOmqY9dKlT2Ay4sr2OedmAarWJb2BOsv3CYH2uw&oe=6B032191"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkOvbFmEQl0Q7kNvwFHiGgC&_nc_oc=AdrpSJTTxtyAnf8uEGx7H8bzulknXpz6jYMCTNlsh4z_V3QNVAamHEh7TSDTStdz_VA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHPaOIcTTI0p04iRHe5gCLsaUUm-Br5_H_a3vSO6VpOg&oe=6B030F62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED",
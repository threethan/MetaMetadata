A&oe=6A47C70F"}, {"file_name": "screen3.png", "id": "4440897666185575", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5_gvYLQHKcQ7kNvwHauvrh&_nc_oc=AdqIFQ_kqkm_26Qsjcsr_Gaop-VwlzY8Xnx8rN24Z8BwEy8wnJ3FF7JF3_xeyTZWouY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sy-eE27OPjkA0ArK8-Ywgq-QpwGtbIgS68sYnxTyX4A&oe=6A47BCB9"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpkpXL6aoN0Q7kNvwGB5yGh&_nc_oc=AdqJnWVL43w5nz0fQvMvTMLhqlbo9VoSuJfS6WGsmiaY1hqHokoxqNIn7WXijZJQ7x0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89_YZN4zien9Lf2hrxkEmCR-fgpOAO7M58bOUwDXThRg&oe=6A47B451"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB70TjWV7_8Q7kNvwGOGyzh&_nc_oc=AdoaohYMy1AC-48lSgMo9lkAgU8KGl7aHbxfIKdX5Q09DDOOUb0gVzRzMNGjK_7uPQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wr_zjbGTPS6aBPPcIcIzGiWUfjTrhV4aLj8kiFt0j3Q&oe=6A47DA62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WM2vNIenH4Q7kNvwFuy5oa&_nc_oc=AdqWnUxtuzWhqwNEed-ROjNNTEAE32uwjIQZ0VPT59yv5pIADndFfA-BELWnsgdMTEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_il7ABOAMuCLX1Utmdp-vrGlTIqI-UmdiwgOvBUJPLxw&oe=
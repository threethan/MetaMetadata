g&oe=6A1C458F"}, {"file_name": "screen3.png", "id": "4440897666185575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKAjYOCWUFUQ7kNvwGPbJvP&_nc_oc=AdqX5nxtY6Kf-tV_faib2e9-bF1qRnnsgT_8biOida6NjEvfMJ8f9bciOJ6VL_R2Isg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71FK1YHGh_hx0UeXA9sDU5d83Pcm5_bm2VviMcuHr2pw&oe=6A1C3B39"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN9FDY8q0K0Q7kNvwF9v1gk&_nc_oc=AdqrUJnt93FSm_Vbl8PXkn_P1t2un49r0yixUSHktcwuymza2pbI7moKJQMiMRJbazg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55OQCoGRFLzXdmjYKpB3TCevY1n_u4UvrFMbMvd3NGWg&oe=6A1C32D1"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=956ui_Siea8Q7kNvwFzca-Y&_nc_oc=AdpIEir4BJ0uj20Pu-lvqWcfSxhjDGgYieOWocqUPHez-v2L3LQrZHP_DFWUUZH7bPw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y4pOw6sgQnk6eUlcySSuoWpPs0SDz6An8Yp10gi6pKQ&oe=6A1C58E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJW9J6I7igcQ7kNvwGbIXKv&_nc_oc=AdocIbEO0pfq9ZjnthMYJhMjT-ToA6k13iZhoIcXkVU12BbQGb77SsZ7VL0oUM_raVQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JjSN0gXI_WobEpcbBkusO_8Fw2Zj6S5f6_Ke8So7iYw&oe=
71-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=116YzJxOHFsQ7kNvwEK2yAk&_nc_oc=AdqfDp6ME9I2uQ3vuyXyj8fZ4BqZ0Tw9eGw2vFHIwAAeMXmUOoNqyj7SsWV7EAunaZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z7_JH8Dg6-BKzv8mH74xQZHLkGbbEbgh2Odd6XRsgQQ&oe=6A05D1B9"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0X1IJAZjBkQ7kNvwHYwMlf&_nc_oc=AdpAjXBVMlRXmvxqw1Y491UlUgvappxFoDTxHnBQ7g2mQTrPNVsjJMUGNg2Qh5J5umw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4amlotHGwpOg7cax0y-5jOAjQqB_yyjIlJNqvs24cR3Q&oe=6A05C951"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtJWUSH_dPcQ7kNvwGQopMw&_nc_oc=AdoyR9z_gskWnQl9-Zn53PQCwkqyOneyBlO8VFQnsbQsADR73uPBgZztdh2P4W2kDLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44W9UkjDh_J8puBA8oHjSwXgDe31TAzp2fFW2SX_wKtQ&oe=6A05B722"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9HxbRfB3w8Q7kNvwEXaAZy&_nc_oc=AdoDTNj59URLHwC9XJEHSs769Zm_7CzYfz00F7qeNo5gcSqaO-k6iBt9O4TKpZ2zxT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kKPUdxxHgoDfgfhV0kX3kXLwAKgnbAYs3E_jyszH7gQ&oe=6A05DA6C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Place To Pray", "platform":
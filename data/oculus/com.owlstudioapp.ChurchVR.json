g&oe=6A95C7CF"}, {"file_name": "screen3.png", "id": "4440897666185575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821719_4440897669518908_1219079461303009790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Urv-ptKwaisQ7kNvwGmB573&_nc_oc=AdpGCisUWGU-ShvXLi0ZRMtFu-ezon9hATsFawtjuVyR64ykD79KwkxsxzjxS3SxXsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2_22WBzE37Rk9BP0p-aW4yi7kSrnMteny627-raJHCA&oe=6A95BD79"}, {"file_name": "screen4.png", "id": "1323391073028842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829163_1323391076362175_6710284281272825072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rptzugB7ljsQ7kNvwGp_VBc&_nc_oc=AdrWP_MZmy2dhTTN3OiOeVlifui2Y5KH6ctqcMmP_UCY16KaFQUqFc7Ord8KFOdBq_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ80_rXW_MmduVtxnbWmxga3eI9a1u6JPqUe8dH3vdQQ&oe=6A95B511"}, {"file_name": "screen5.png", "id": "26929360613363524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_26929360623363523_2113377200488000399_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GOWto2J-oYQ7kNvwFsHr-U&_nc_oc=AdozWPgQ99Xzy_hhlt4FaE7SPRuTTnzcEnwVVqSUAcgQdNs3mH3LdOBiiZTnEqK7fyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj8526Nlj3aFx9NVkeEhw5qdF-hOi-s5A_kT0wcov8WA&oe=6A95DB22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Place To Pray", "keywords": ["church", "pray", "praying", "Bible", "Meditation"], "long_description": "Escape the noise of the world and enter a space of total tranquility. Our realistic graphics capture the light, scale, and atmosphere of a grand cathedral, making it the perfect setting for your spiritual journey.\n\nDiscover a new way to connect with your faith. Play for pray : invites you into a masterfully crafted, high-fidelity church environment designed to provide a peaceful sanctuary for prayer and study. this experience combines stunning architectural realism with the power of immersive technology.\n\nThe Full Holy Bible: Engage with the Word of God in a natural, readable format directly within the VR environment.\n\nUse the app as a personal \"play for praying,\" allowing for focused devotion without outside distractions.", "short_description": "Step into a breathtakingly realistic cathedral designed for prayer, peace, and reflection. Experience the Holy Bible in a fully immersive environment, complete with celestial visual effects and a serene atmosphere. Whether for daily devotion or quiet meditation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/place-for-pray-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 Owl Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/place-for-pray-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26327757273571213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821782_1615165589694390_8902742577937519479_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5D_-iJ0BgcQ7kNvwH7su4L&_nc_oc=Adre7Jr6UIquX3oq8Yie6CtUVkL2x6-H13KbSujuyqsSQrGDzQDEVeqnDJ2aO7Xq99I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfI8n-j12BIkVpm_gxk5nO0AZaChuu_IP6paMyH7KW5w&oe=
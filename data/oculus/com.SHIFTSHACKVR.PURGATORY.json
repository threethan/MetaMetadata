dn.com&_nc_ss=7f20f&oh=00_AQPnkR-cfD0ZEDW6wWhGayylqbB7-2HXyGbIJL5tWQsHWw&oe=6ADCCB8F"}, {"file_name": "499310731_1014560264667951_400985235355889038_n.png", "id": "973148005741818", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823259_973148009075151_2587591229564301562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0ymOkvIePEQ7kNvwHTvkhE&_nc_oc=AdotmaNTMeCaNrJx8pzR-RJSrSGktgQDeK1k3PVsFzKsDLMjNwkRWaJG0pFk_bxYiSc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxas5M58zJDCVzpa8ie3sksDrGT4crRxfFDCLRHEyx-Q&oe=6ADCBB9D"}]}, "id": "1720821272341119", "locale": "en_US", "screenshots": [{"file_name": "499312454_1233453248886473_4025099788355360359_n (1).png", "id": "1393938109343434", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823812_1393938112676767_884525235174470274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIyuYc3ZeFUQ7kNvwGx_9sZ&_nc_oc=AdpMg68HCdq96ziRCX9c1x0OgCfnQ7Gxn-ihVdK_EAema_wTENkmDy-q3pc7Or_inXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRbRm-GfX9uFY0Gh4WheywbE9eAfGQXPfJLf6c2G1taQ&oe=6ADCBBD7"}, {"file_name": "Screenshot 2026-07-27 105631_resized.png", "id": "1890953508529006", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308050_1890953511862339_687789223186382925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7uwnxsKH_MQ7kNvwFAH_EP&_nc_oc=Ado2fKqbE8YF3x3hxQTu6sy9qSvjlvTMN2b-hYL2Hi29q6CKPRFAuhtKE7Nq27ihunk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQYlCNI0KYqE2Q5EnMi3aas-xY5eXtgND74dYzri16_A&oe=6ADCBE86"}, {"file_name": "Screenshot 2026-07-27 110142_resized.png", "id": "1061089976479715", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW-Ns_CnWAUQ7kNvwEMK2qH&_nc_oc=AdrrIVVGKpULSunz7BnaZOSAjPEm_pluy68Fw3f5RSzl3zANLoy65ZCs7g1fDLgGesM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_25a3la0Fz6fkPj1XW5vnxbFKUU6ohzRBlsm2pwGoVQ&oe=6ADCC8AD"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uafOBFRGLXEQ7kNvwHEjoF8&_nc_oc=Adqv8csaj483SbAK90fyovIzH09KPwVwZvYhEPbLzYnJQlabSyLaE62UibNjI5s3x_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHQPzXU97i3NsRkw8txJ2QYLkFSa1WOJKHfj3CKWvM7A&oe=6ADCAF45"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACBiRTbxi_MQ7kNvwEOqUHw&_nc_oc=Adph32DyHSfQ2JG_jRlBhWHeMklUdi73jGgniy-go-OBfWdCPbFdylgIYuJKD3Pdxak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQMlVXzSySp-76GtwOVq_HT00HP78EAryLgpg9ZbMl6A&oe=6ADCBFAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrzALq3U8QYQ7kNvwEGh02S&_nc_oc=Adpz5TLw5CCDBxYZKey1YiU3dgXGJ1arkpc-j0l0Tuidi3dlButl4Li1zFirGpTpypQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH3HW30YzQHZotmjMjC0RNrRKcvyVOPr_Kbsz7sVPnog&oe=6ADCCB8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PURGATORY", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
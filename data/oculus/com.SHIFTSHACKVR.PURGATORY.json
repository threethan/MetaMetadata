9976479715", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQgfh0so8q4Q7kNvwGbqh4X&_nc_oc=AdpDHwJP4pS88qPGBp9YBtHIOwBf7FEN5AF70tTLcYEkxUZ1rSCdz8nQc2HMXcTSQ-E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN513YAsnNR4h00CsWx_71fhU87sbCqSpCrYbA3Lr_-A&oe=6AAEA42D"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAl0mzZOMAoQ7kNvwEK1Qlk&_nc_oc=Adr0LWn1LK3pyHTwfl4lJyyp1RBXNhtxmaaTYv35pcCf_uZ1ddq_iS0CzhtmNk_csAQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy3v7urnLGKpYvUxZ2Y0-nPPrr-3Z75N8T1qtj3PVJWA&oe=6AAE8AC5"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4cVaEfhjs8Q7kNvwEnJo5P&_nc_oc=AdrHrqVvgKbd0m9NgIWZNrIZm50-gLBSYnzVs-xZwW7J23H2ykzjm8nH2_VtGsVu-OU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuK7zl_tfUW-bgt2zGGViyJ1y4-YpBnv_nbyAQH_h-xw&oe=6AAE9B2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1033672812736094"}]}, "baseline_offer": {"id": "1033672812736094"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787601600, "status": "PUBLISHED", "id": "1033672812736094"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "13026319
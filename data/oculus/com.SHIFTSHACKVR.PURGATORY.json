dn.com&_nc_ss=7f20f&oh=00_AQMRI85qa236YFVFxx8aFgMY5WRmgh1wo55j5PuwNXz8SQ&oe=6AD23F8F"}, {"file_name": "499310731_1014560264667951_400985235355889038_n.png", "id": "973148005741818", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_973148009075151_2587591229564301562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgh1_cawiVEQ7kNvwE9ktEB&_nc_oc=AdolMmNOiHr6ixxSGa9OO6gOszXE9OBF1RJ-QUPbhqNtOwH4cgBStnptkviDBqu_J6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOndgq6QhxHOI_I7APcU82bpaPm2S5Yat5gq0v-dYe1eg&oe=6AD22F9D"}]}, "id": "1720821272341119", "locale": "en_US", "screenshots": [{"file_name": "499312454_1233453248886473_4025099788355360359_n (1).png", "id": "1393938109343434", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1393938112676767_884525235174470274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkW3Ey8jzlMQ7kNvwH0oJAl&_nc_oc=AdqCF4r-RexCuaUbfvTDKyhkvo74j6OZSSNEMMQNJGOdVx87SOUcPUdS5uP7svOnbgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJTTPZqg3om5zZ2cMnhltlOc7dG3TcyhXF6e7SpuMCKA&oe=6AD22FD7"}, {"file_name": "Screenshot 2026-07-27 105631_resized.png", "id": "1890953508529006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_1890953511862339_687789223186382925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK0r7y0_nMoQ7kNvwE8kUDv&_nc_oc=Ado5Y0I9I2PhJJGDMJKOiKehRA9Qp68d5L4bBoz1HYaCWJM2U6nQyO2a2hdoG1W1SSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9j3jVxAEwMK4f3yx9CTk9ggfxH4bocjuZF8_dh0HvTA&oe=6AD23286"}, {"file_name": "Screenshot 2026-07-27 110142_resized.png", "id": "1061089976479715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRRe6LDj1pYQ7kNvwFlLyuo&_nc_oc=AdpwlCbOU3BGohrwENNgokZlhkdsvMTlTTdv3sy-sLkh4N_b4RloxnoyA-w1DlXKf2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj6ljODlL-cjkEOjY7LVIPP-0lJB7ZsfsRzPx_Q94-kg&oe=6AD23CAD"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOkeTcc4DaEQ7kNvwGPQa-T&_nc_oc=AdrABWbAg3-eTpAAZ9AMYsIWD8Op-ZGyd8GmKGVUTZwCtFjgl6mEukSf1QXKgXbhACM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM50EoEIl2gzy8k4KSS89oZTANktTOQQcW601R5LBqhtA&oe=6AD25B85"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cMOh2pYSqgQ7kNvwGD9UiR&_nc_oc=AdqCzagOMJ8Xn10Oyylp18LjGPUqwCeCebMCzxe-yOW26jl0Jdspsh8VCfDV2erJLWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQYxuezRfWAcKjx6rCLn_J7z-lVh7fkjmtzaa3I6zaVw&oe=6AD233AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyrkZIUXgOQQ7kNvwFcSGUj&_nc_oc=AdqtxIahdXbfqSkkbEX1L528rBTYa-WdegW6t84-Cu1RIeE0ihuIzkxS2Vxmc6GKLZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU1ImONoQiGfMCiRd3v-SoZ2VIH-EzqK5ESqt8BN7Xdw&oe=6AD23F8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PURGATORY", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
dn.com&_nc_ss=7f20f&oh=00_AQNMkxPjoF0vC4JVsWvttlMCd-KKMHk8HwMBRuyaJnAyUA&oe=6ACF9C8F"}, {"file_name": "499310731_1014560264667951_400985235355889038_n.png", "id": "973148005741818", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_973148009075151_2587591229564301562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WO-MUtNQoxcQ7kNvwEsBDiJ&_nc_oc=AdpQjmdEjpTnfQBpz4zZ3kYUVpa8CHgV0x6zp89fSH2846qPOqoLnPmVTUrt2kk1G2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBv3FzgviQB8wQMmMgP6oNy4EkNziuNXgRfTNjpmQQ3A&oe=6ACF8C9D"}]}, "id": "1720821272341119", "locale": "en_US", "screenshots": [{"file_name": "499312454_1233453248886473_4025099788355360359_n (1).png", "id": "1393938109343434", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_1393938112676767_884525235174470274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkW3Ey8jzlMQ7kNvwFs8lwa&_nc_oc=Ado9ZwaGFlYZtBOGKd0Z-GBxpeh3m_fkca0OIGk_zQ2jhKXV0RHX2M0DWTcf8h_qw7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM01hzHF0NsjKkXpGAlQTt6tuE4NKcZf5lWrGtkhftCDQ&oe=6ACF8CD7"}, {"file_name": "Screenshot 2026-07-27 105631_resized.png", "id": "1890953508529006", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308050_1890953511862339_687789223186382925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E2a0kiuL20Q7kNvwEcqEms&_nc_oc=AdrObgsHjFLn57Vctf0rh1WtB7fYF3J3qTX1qGcXvcdospzRILyF4t1a9RobunIAVQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2oL_knpoB_9zjzRkqXsJMLfnVa0w7TjDWpM3IRWhfOg&oe=6ACF8F86"}, {"file_name": "Screenshot 2026-07-27 110142_resized.png", "id": "1061089976479715", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B9KPsRt7CsQ7kNvwGtNuVE&_nc_oc=AdrvP7a1IQOlzZnCdw14ydtQOekq4S7Pd_Ot8yaad8Vb3O6kK09O8BVhG8VA23TK2m4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON58ksBpeZaBRz4qQiBLTnfdyy2NYe2o8I4bIc4MOT3A&oe=6ACF99AD"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kojf2FZu2FYQ7kNvwFpAgCO&_nc_oc=AdpKxBpTHqMwRKc1dh_X8j6T1mhoVD9eLCLpZf6OZAQj0CbcOtPRCPOM4nFhitDsgdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIsZrTU1UnbFKeADL-Jw9bAk27Uz7ehoQ6jlsg7PRUzQ&oe=6ACFB885"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cMOh2pYSqgQ7kNvwGs_oVp&_nc_oc=AdqwW-yVkUPVWtcKiFARnc4aDHR8GvUTWXUzQ4oSFsj5_98BsL9SxHtd7grcSBFbUPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjIwEWszYYC-r0r5xd6hXp4Xx04FAQq3z3ZEaQbqhP2Q&oe=6ACF90AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENqWZs69IVUQ7kNvwFRXOkp&_nc_oc=AdqOXLXouHNA2kuaesV6X2_Eo_CT6pauUrJi2l7FBAcgerhCHqanyJ3792t0di1okLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB-NUqTp66i39ruWFx03YM6oDLvopsbVXmYLb1xvnEng&oe=6ACF9C8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PURGATORY", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
dn.com&_nc_ss=7f20f&oh=00_AQNgbF9LXWK2s-ZQFYmnIYHrJPqQeVZrQk2XXLHBCFIE6Q&oe=6AD3910F"}, {"file_name": "499310731_1014560264667951_400985235355889038_n.png", "id": "973148005741818", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823259_973148009075151_2587591229564301562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgh1_cawiVEQ7kNvwFMNbdz&_nc_oc=AdrCVP3MszeaNmB64eP5nXzl308BBloLggbjHCN15QoZeY0TcwHpYOVbJ05c0yVJjxE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGk-JfVVl6IrH-aIwlCN-WccDrUTo6gDL65xaqgFgjow&oe=6AD3B95D"}]}, "id": "1720821272341119", "locale": "en_US", "screenshots": [{"file_name": "499312454_1233453248886473_4025099788355360359_n (1).png", "id": "1393938109343434", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823812_1393938112676767_884525235174470274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb-ihHXudX0Q7kNvwEPMHXq&_nc_oc=AdopLiIVqrRE7w6KjjeqtGj7XgtPuZCoit6fq17_ycAsPlVFt-4oUuo2iK9EEGqVrIg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPB96wrbANvuLHAeeXIGNBKwNp311pEKOnwC6uajx45Q&oe=6AD3B997"}, {"file_name": "Screenshot 2026-07-27 105631_resized.png", "id": "1890953508529006", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308050_1890953511862339_687789223186382925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK0r7y0_nMoQ7kNvwE76FZi&_nc_oc=AdrNUlrey2vYd0aX9YDHAjHcOMY1_n5CHnewaCqZhp8Nu2D65f66P7xkqks0YWFrj5s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMB_-xQag3uMp3wRYGd2XpHH5TcUi6QJGK_ABu7PDP9Q&oe=6AD38406"}, {"file_name": "Screenshot 2026-07-27 110142_resized.png", "id": "1061089976479715", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRRe6LDj1pYQ7kNvwENFNro&_nc_oc=AdrQRx5tvhq4qD2ew0HNhzhQAAxpyFA19at8lbpRMo3EUuu2uY9l7qlstVr9JrK2Qfk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn4SfAIAUJa-WOc0m28q7Px2m4f0GatkHsg5PtRjfZsw&oe=6AD38E2D"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOkeTcc4DaEQ7kNvwGX8j3d&_nc_oc=AdrB_3pMz19aAE2afsL9Pxt6WKlK4tX9NIfxSWpEtGXPK77irVM1hnS5jWnJF4zYAFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC7ebE-xVSNOT1UpNbkND-Avu_Dig319y9KWCtLt0icg&oe=6AD3AD05"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u_ydoada68Q7kNvwGbOC99&_nc_oc=AdqflQLwWyOKoEvNB2vEgs1ZD95ezujCHn0i1Xl5JOM-D8CdD5tgqRgQSIv5ZGyNUN8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpVClkAOvHMYyrgpj23DxxeDPJWTBtxYcRZyy_SjVJYQ&oe=6AD3852D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyrkZIUXgOQQ7kNvwFAPHaM&_nc_oc=AdpW0B5l2-bP2DB0Z3Asip2hnF1k6L3Riiew2uwsJygPeyDoOGOuaU54jlUw0AbipwM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJZjEOMuQy2vxmSMhS5H6nPjbD3DkQK2Z3H4x3R-cz5g&oe=6AD3910F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PURGATORY", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
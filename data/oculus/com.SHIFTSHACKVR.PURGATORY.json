dn.com&_nc_ss=7f20f&oh=00_AQOVV7DdFKcKAfq1G2HZGuBPNA3CNEhw6U26rLr9txHf1g&oe=6ABFCA8F"}, {"file_name": "499310731_1014560264667951_400985235355889038_n.png", "id": "973148005741818", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_973148009075151_2587591229564301562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7y5MgZYaQkQ7kNvwF0PQra&_nc_oc=AdoQY7i12b4sp5a3HXNRGnzY1li6sdjZ4M3-rMFbQh3OB2EHplr7n_At9TSg81LXK4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO88TBAkKpjq69tohRaELaPgMYLxLLsu49rdABeH9TOLw&oe=6ABFBA9D"}]}, "id": "1720821272341119", "locale": "en_US", "screenshots": [{"file_name": "499312454_1233453248886473_4025099788355360359_n (1).png", "id": "1393938109343434", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1393938112676767_884525235174470274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I191pRVmpTwQ7kNvwGbGVY5&_nc_oc=Adpkm-1_ujc8OrMu4XtgyPcDgbizj-yKUfrwM2yLi36LENsNsZD1-wcU_enIEJE5NoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpV2LW1yXBDeDmrr_iTsQU-Fvjx8jxg5EkNxD4HKgyhg&oe=6ABFBAD7"}, {"file_name": "Screenshot 2026-07-27 105631_resized.png", "id": "1890953508529006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308050_1890953511862339_687789223186382925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAsH7k77SR0Q7kNvwGGrpiU&_nc_oc=AdqJ-SF-3dL_casnzVwBcvqACeHWFkv8n1zwyzanRr5Y46NxRIuGjuVUj9zq4rggWaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV-X99ljHpwt-i7iWo3Dj-NlavhG5jAVf548eAGRFhrw&oe=6ABFBD86"}, {"file_name": "Screenshot 2026-07-27 110142_resized.png", "id": "1061089976479715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOq0MxD-bOAQ7kNvwFyTZS-&_nc_oc=AdqCymwe-gpdn9fzfl-K3KZxvZyTfyVrdnmfGW1rEVANHszIEX3gCMTXRsDeZBk-hkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7LhY7myE3IBGEn8bINPHlFhS__vMmi-pUi4CRNIzU0g&oe=6ABFC7AD"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoeX4BSJ2RoQ7kNvwGh9FbY&_nc_oc=Adr3GRpdAl8EJ_nAIFWL00M97CnJ29vJBw3NfqO5eHCT3v6CeW1zqfglmeUdf4Ltebs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRkNtbJNmLEbkxLCLcizQjhBmXUALXmtPCfJh0-yJH6g&oe=6ABFAE45"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxofRD2pc5MQ7kNvwFIZ0OR&_nc_oc=Adp4NJvxtg_lqLK01Uii5njNtNMt5jja_x7X4rM5Yt2-6DHWNyDBy0-ZPNXWcQWqrvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP95rTpWfE1LQdQoW0zSl1zdyW_EytAXABNfL1pZQY1vw&oe=6ABFBEAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eru-nqPUDMwQ7kNvwGIXibV&_nc_oc=Adryt2vYWcGC7RXwQ5r4LSLQlZvs4QLD0Oz7wOzHptlmlrRpShS7oWxECaEiwpg4l-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsTSCuljgM7wnx19lwOk5PwebPVrKwwytudM-r69AhMg&oe=6ABFCA8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PURGATORY", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
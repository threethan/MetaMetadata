dn.com&_nc_ss=7f20f&oh=00_AQSe2CW5VqTAq96wF-Vn51bIyHVzJ_b1a_33m_0WKdIszw&oe=6AF9CC8F"}, {"file_name": "499310731_1014560264667951_400985235355889038_n.png", "id": "973148005741818", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823259_973148009075151_2587591229564301562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFNxJYUPw2wQ7kNvwFznDMz&_nc_oc=AdqgCGbLFaKjNETgb94fNwFB_mmOj8Em6aRgzfRD4dTl1iBZTgM3FkaAhRhzUXLKrOE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX5ijJBE7lHKYgKTIhLZ8l_78DQaSt9MPvBj-VSpS0gg&oe=6AF9BC9D"}]}, "id": "1720821272341119", "locale": "en_US", "screenshots": [{"file_name": "499312454_1233453248886473_4025099788355360359_n (1).png", "id": "1393938109343434", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823812_1393938112676767_884525235174470274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a4shVEUnUcQ7kNvwGBSbNB&_nc_oc=AdqEpBBlzOl_s6OyVcnwoyodzxAI8zElutZVc7b7XQQvhzFX6bY4ndF6Vqv-7sv9jsQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNllCJHPqmB--fdWlntKbo_-1cfMZAkHxzt4Rc0lpEiQ&oe=6AF9BCD7"}, {"file_name": "Screenshot 2026-07-27 105631_resized.png", "id": "1890953508529006", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308050_1890953511862339_687789223186382925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfThMPLTZbEQ7kNvwFE08Kg&_nc_oc=AdqfPiqUB5FR3Sj2hr8WCzlF8yjRsfXv4iowW3IGDtnEZ0YlEc4kBUOhyLFMKpWoNyI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4cb2flm3Oe161KVdZDPBzuxoSbh3PZf2JJof1MF5Wcw&oe=6AF9BF86"}, {"file_name": "Screenshot 2026-07-27 110142_resized.png", "id": "1061089976479715", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_If7cPx49gQ7kNvwG6WRcH&_nc_oc=AdpEQZd9w9LLLTMdW5usAr4xZPPZzmhIbvDuF-HmmtkQq0U_ktBHx63QR6X0BbrQAEg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvQGbrah6pvOkNNcxisjK20vrmnV77rwSCTYlF44d_eQ&oe=6AF9C9AD"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhoknXJKmVwQ7kNvwE5sNIJ&_nc_oc=Adp18dKp2kTrTI1dg9YQr-vGELdWmsVTeFtHSqKITN31PKvJtyGzpA8lr3UoU5hgG2A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMks5QSWY_K25dRYdvNZKfjAHeutKWYtUKeUC6YeXrGQ&oe=6AF9E885"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aakT4hXVKsQ7kNvwEOslYo&_nc_oc=AdodpckfCWiv3atDMWhCoeG6-HVT7DCdwaDUNWV-RIwLqOUlZEZ-7IFgYDSSs-Yrerg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRdASu5LLFG0ORb90SsOR5dZofqYZ1e8Z6coSS_BeY-g&oe=6AF9C0AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrmajy1kzd4Q7kNvwF4TlN2&_nc_oc=AdqKFGGud2-lbqE5Gg0EwjSnTx7_sAvvmDZSTwA2Q3jpyycHsTF58cJxOtarhc57SDc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpMuBPDdHebxuyV4wkdgILSxVl3rxa3GOLskaWTTDWqw&oe=6AF9CC8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PURGATORY", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
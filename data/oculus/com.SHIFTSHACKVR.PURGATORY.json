7951_400985235355889038_n.png", "id": "973148005741818", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823259_973148009075151_2587591229564301562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ENfD-cTz4UQ7kNvwEh8U1D&_nc_oc=AdrgKLs4C-Uj6q13uCWnUImx_BttjFTyojN4wnSFkLG-MO2KmGNa7_KV3KSNDG9xa5Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnfDNuUckZt4gwwOIaAt-V1IfdQytovxDdwtCVlCxlDg&oe=6AA1681D"}]}, "id": "1720821272341119", "locale": "en_US", "screenshots": [{"file_name": "499312454_1233453248886473_4025099788355360359_n (1).png", "id": "1393938109343434", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823812_1393938112676767_884525235174470274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZYJBP7n-ScQ7kNvwEIYgk5&_nc_oc=AdoDUn4cuq2c4jGqEmbQglo0OC-f0oTlBQRlSPSEyT-5HlK9ZxaAwVpzRUV3w7pdrOQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSEy8O4D1lBH9_D03Dcd4BUC-7wuBL153ji3Qc3_s78g&oe=6AA16857"}, {"file_name": "Screenshot 2026-07-27 105631_resized.png", "id": "1890953508529006", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308050_1890953511862339_687789223186382925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSQsj9M3ktYQ7kNvwHaRNU0&_nc_oc=AdqWBfex2hoqCqkylUPfeFVqOG4Jb93NjklzZuyFo6oKNbXu9DCn_Hz3cs8y89-4WZo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPJdVVUs-n4sKa29dTonqr8WO6m_Gfw3qGcnS2gzlCow&oe=6AA16B06"}, {"file_name": "Screenshot 2026-07-27 110142_resized.png", "id": "1061089976479715", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKMFc_JV1UsQ7kNvwFHDxVJ&_nc_oc=AdrvnYtEfVCL7bHHMhBS_XNb5ktHvan4R-ejTMlEtYEMK_SHxKoZ8NmXJFnEJAIhlN4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVjeA9dBSGctCknDoyeRlZ7gD6vLoPUke3NrX4rREqQw&oe=6AA1752D"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79ingHWUtIsQ7kNvwFni1Xd&_nc_oc=Adr-fRzSAg6TEFQAgVliVEdP19H5J8MJZqq0ZF1w1pfeZfCFUtZZLHH2ZNMDVRH_Z_g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrN2r7Ip1oEsPsaRfkNGmm3vkWKbAYmQDhfgPmYgrxLw&oe=6AA15BC5"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcbjQSzWduoQ7kNvwGjEiXi&_nc_oc=Adr0fAv4OApUipfEhaaP-vsJVBx7yxW7_7vi2rmkOzGzKGUG7X9AnUpnmfbl_nHTb04&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzDaGBiK3hnme26AIblUAomTRNsBnGHOaRBYsACzQlNg&oe=6AA16C2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXHrPia8tkoQ7kNvwGdIiMl&_nc_oc=AdoPlHWB4SpWymZXDU0A1jc1PjZbn9qqykZeLcWxziKZOgUMoaIY08iKg4STsMkdLg0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAgAdElBBurgo3A4eqtB-qH4m_ATmePdTHTTa39on7ZQ&oe=6AA1780F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PURGATORY", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1787601600, "lastRevision": {"nodes": [{"id": "1228532260345341", "
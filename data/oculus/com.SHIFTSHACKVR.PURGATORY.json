=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvwN-nnmivUQ7kNvwFjJnZV&_nc_oc=AdpzcCL7hFQK1KyIzVLpAeXDpStA7ZzU753Xo4OzN_51APeT4IHTYqAbD79s1VwFR3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpjYUvyeorNWKqth4Zi_FnivsfXP8aisIbqLeIwjjsKQ&oe=6B0DC86D"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeYpgehzehEQ7kNvwG-Iyra&_nc_oc=AdqIaTORmWsMdut4zqV8wUXkiQ9AUlpDOk74lewVZWZG45ofmkJm3TtgpIA5ZEy6kyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxqv_s9e3z4qC313zw6GNp-ZZTxC-hDN3tVqx0r0Qamg&oe=6B0DAF05"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz-FehoMPpgQ7kNvwE05ibC&_nc_oc=Adr7lY82uhTp2XyzAS4s7F8Rfi2le_TpDcJ8yteL58j-aGbsWG6tu9iryb6Bd7M-3Xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlaIKIE-NTD1Dd-1ASoAVrV6TRFLkgr1SdpGWSTIRr0Q&oe=6B0DBF6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZHGCF82428Q7kNvwH_woXB&_nc_oc=AdpLj-zmxA3IFIfJpV5CK0hwoSJXzPQZm9p0XTRgxsiqxIrPnpDPRVQEQhPDgfPX25c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyeo2tTRmygmbh1zlHqCq8A_vd3L0Is4XXeNrhC_z8fQ&oe=6B0DCB4F"}, "i
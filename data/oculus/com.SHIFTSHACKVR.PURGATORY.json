=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XSmbGWL87oQ7kNvwHhML06&_nc_oc=Ado0vyaksr8vJrTZUogGzmBLXd73ykYEM6QRLDGVtgY5042jMzmDaxbd_BhhLfaTRFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCdumS_31pgKVvMZweYrV5N565btPKyK01jqFqiKSjeg&oe=6B0455AD"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkbnphZ8V84Q7kNvwG51sG0&_nc_oc=AdqtTVTcn3444gIUvALO1Lu1nE-kv14H6S3E0Ch5efGSdzZ_Wmu1WXq86Jjwe-quiHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgsuffMrRNh3nBYV75ptMArjXI5EWIXm4--dmcnDuXFQ&oe=6B047485"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlDt-NP5X7QQ7kNvwF-cgas&_nc_oc=AdpPbjUP0UaPQ-RBHkfzi1egWB-isvGbHoL8oI16JfPXy-nIVgYqwe0ijBRKmn_iLXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQyGalsMWMif-xG8N_Fgnpnd8UF9OR2FdmyczUILsj8g&oe=6B0484ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3GLtyDOD58Q7kNvwHWAjyd&_nc_oc=Adq1RI0R6A95RPSrUT7cAUL80JcDKNCOQN0tA4iPq7P5NvEdpNxFYWIwtXPNyNvs84w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLJIF3ZvToG8XeqUvCjINE0v7ZB32n2ZhMsPeUsJnIrA&oe=6B04588F"}, "i
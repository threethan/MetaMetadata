dn.com&_nc_ss=7f20f&oh=00_AQSlgn-B3-O2jTE8lwIEO-Ga_2uroy9v9_A4JcPnA-3zQg&oe=6AF1E38F"}, {"file_name": "499310731_1014560264667951_400985235355889038_n.png", "id": "973148005741818", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_973148009075151_2587591229564301562_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv2y-8kGkE0Q7kNvwFrXmeR&_nc_oc=AdoqJQ06yEpzyncj4zD3nCbBcMbCY3wtHFlsJeuX4XnYenfdb4VDQbTgf3q2Czt_BIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2sAGylNItE2hHVO3phmVAbYBA-aG8xYD-09pbiki8jw&oe=6AF1D39D"}]}, "id": "1720821272341119", "locale": "en_US", "screenshots": [{"file_name": "499312454_1233453248886473_4025099788355360359_n (1).png", "id": "1393938109343434", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1393938112676767_884525235174470274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPMhCjTsU0cQ7kNvwGj0OiI&_nc_oc=AdrdwU3j834WKCNRVxzFyQcqWI7ZnAPiGTf8B96TSLbfQq9cvFc6uZFQue2a3XbNgIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSaA091q25UJYTBaZhq54nBbfNJm46tXaVpbh1DQcYnw&oe=6AF1D3D7"}, {"file_name": "Screenshot 2026-07-27 105631_resized.png", "id": "1890953508529006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_1890953511862339_687789223186382925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v2GTLyB0VkQ7kNvwFtqQkd&_nc_oc=AdqB3qsfFtpVmGbuiHHzCahrs_5pgoTFXJZUTbSN10DF9phIWNnzic-l7Fw15mxnduo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbUCY1Mny4uclXrkctJzv0OwibdmP2M6GNJjHTxIbeiA&oe=6AF1D686"}, {"file_name": "Screenshot 2026-07-27 110142_resized.png", "id": "1061089976479715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312470_1061089979813048_1120021365866097643_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI9S8Si6o_kQ7kNvwGsphjY&_nc_oc=AdqigyjVvcrUUQ3xvagxAhi6imlZEkLUWzE0WG_TttJdh85pSzm1m3jPDmEdoD7asO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBO-gWenIudaHnOkMuI0SNsp6C_JtsfXZQhsY0S2RvZg&oe=6AF1E0AD"}, {"file_name": "Screenshot 2026-08-03 131834 (1).png", "id": "1389722589707207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312310_1389722593040540_7041741358175178086_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaJfYJjYNj8Q7kNvwHr1rlf&_nc_oc=AdqKUr3mLhmvjj0F0TyhnPDAC94RyNRQlktLc1BiOhU_w2k-9UJlHkau0FpSp_W6Iao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2x_x3hCsmjKLnNI4wt1E3N5gOOMkL8XWQJnpaUUiEVQ&oe=6AF1FF85"}, {"file_name": "snip_2560x1440.png", "id": "1762894054719872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314641_1762894058053205_890505931068331900_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlDqnp70Vk8Q7kNvwEyTlPe&_nc_oc=AdqWqbeVKociZNXBvGBc8mVeTIgn4byzN8jIfX6BCnyQ1_5FE0IzKZBW6K3iN1KkMk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaHwF3Aukm_lyrJmMuc9AoZ2wP57hX392MglKKqyVbCQ&oe=6AF1D7AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PURGATORY", "keywords": [], "long_description": "PURGATORY isn\u2019t one of those basic horror games that just throws loud noises at you and calls it scary.\n\nThis one actually messes with you.\n\nYou start off thinking everything\u2019s normal, then it slowly starts falling apart. Rooms change, sounds don\u2019t make sense, and the longer you stay, the worse it gets. There\u2019s a sanity system, and yeah, it matters. When it drops, things get way more unstable.\n\nYou\u2019ll start questioning what\u2019s real and what isn\u2019t.\n\nAnd you\u2019re not alone. Some things just watch you. Some move when you don\u2019t. Some will straight up hunt you.\n\nThe game reacts to how you act too. If you panic, hesitate, or move wrong, it can screw you over. Nothing is fully predictable, so you can\u2019t just memorize it and be safe.\n\nEvery run is different. Every run gets worse.\nYou\u2019re not trying to win. You\u2019re just trying to last longer than last time.", "short_description": "A VR horror game where things don\u2019t stay normal for long. The world shifts, your sanity drops, and something is always nearby. Pure adrenaline pumping in whole body while you witness the true instability of it all!"}]}, "developer_name": "ShiftW0RKS", "developer_privacy_policy_url": "https://sites.google.com/view/p-u-r-g-a-t-o-r-y/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KurovaDev | Hrqmable", "support_website_url": null, "website_url": "https://shiftshack.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1249301158268451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/646413489_1025236693227406_8327142454655171277_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Crr0bWzjaAEQ7kNvwHjYAFY&_nc_oc=Adra-6JncxrFvATNDazVY3i_IsMLow5VD8qu5NmDZOozq2FrslNI5GD4WwN1VtkjmAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYfJc-kYhO63ZzxLBUPM_AD9TCnZj6B3B6WZAzmjYrMw&oe=6AF1E38F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PURGATORY", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
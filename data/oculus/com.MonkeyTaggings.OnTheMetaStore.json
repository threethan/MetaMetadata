rfvgvd.png", "id": "1266204722382046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302348_1266204725715379_6322104400603516117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev9WKyPRmvAQ7kNvwHwfdu_&_nc_oc=AdoVtSg68SzpE12H9uZvRmXLKmrSz_9qMpJaSEDHosJJmG4Sw9PX6lOg5LAVeUhB4lU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcQrhzuJavm96QX9HoNjpu6Xglx_zUIBonVcv5DG-USQ&oe=6A748601"}, {"file_name": "Untiwerwerwerwerwerwerfvgvd.png", "id": "3553094581511079", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295566_3553094584844412_4248645405037299394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2nSsOPUQIoQ7kNvwEggYtg&_nc_oc=AdrEr4CYNo4tviBrRgCyEGhPoxlSDGLtt5x8vQt0s3BdvzAKaIRqJ21D0GWk2DHzjiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4wM3DFqDKqbY3dcm3iN4F_7oSHgceIfcXKCP3DFi2LQ&oe=6A749823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggings", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Monkey Taggings drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Monkey Taggings is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1q447lmKHaxXzG-gqNJE9KcIaOBBOAEABdnIdBVbHtIo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-tagging/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26601809776173646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300738_2131912454269496_5119602185819278205_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POifOAQJj9kQ7kNvwGV4BUV&_nc_oc=AdqcU8Mai0zzTOE8ALZJE1iX7v8FvEcnA77OIj0lbPaSSVjBfpHMm6wNSyeobv3oLqc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp7gVm9COdH4XyOaN6jlFffj8Htf9wU7p6DhzJhKeYIw&oe=6A749461"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Taggings", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1776198900, "lastRevision": {"nodes": [{"id": "26601809799506977", "rele
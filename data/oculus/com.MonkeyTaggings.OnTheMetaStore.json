rfvgvd.png", "id": "1266204722382046", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302348_1266204725715379_6322104400603516117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj7ZkGggWC8Q7kNvwGhcn17&_nc_oc=AdoOuSnSKGUstBwucpXzaeKrfWrw4anHsfXlIX8qs6SPp_1UUWrkP9TjsPVoxfhQwTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDG1SnhZAtoqhn8zd7HHf57_kNiLwO2ZrJvirnGpTEtA&oe=6AEB2D01"}, {"file_name": "Untiwerwerwerwerwerwerfvgvd.png", "id": "3553094581511079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295566_3553094584844412_4248645405037299394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9AcGDt9eE0Q7kNvwGI6B70&_nc_oc=Adp6g3hI3JnBLiNxakkJNEj-Zsp7YAGxeMLf-UicoLBIJTNxF0rbyCV0Yt6tU4Zoy6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ476y73nVKNqV68t0K2bp2ve4uJaRdCFmfkbEaSI2WtQ&oe=6AEB3F23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggings", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Monkey Taggings drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Monkey Taggings is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1q447lmKHaxXzG-gqNJE9KcIaOBBOAEABdnIdBVbHtIo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-tagging/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26601809776173646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300738_2131912454269496_5119602185819278205_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzuA4VtBHt4Q7kNvwEWBT5v&_nc_oc=AdqD5HLg-c00HwGTcHD3GRFXw3sA1JjRCVLdNd9JXpkUNAvZaE4gSSU-8VBvVcXtuN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0m6AgerIYsinsc8eTSzXpM3BqLzVqf_knCKkKbj7zNA&oe=6AEB3B61"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Taggings", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1776198900, "lastRevision": {"nodes": [{"id": "26601809799506977", "rele
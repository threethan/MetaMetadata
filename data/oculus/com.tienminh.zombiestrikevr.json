0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6lq0QKKBV1xpF9MBsXoArs3KdVUSYUvNqnC60bM_KEw&oe=6B09ACC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Strike VR", "keywords": ["zomebie", "vr", "ai", "game"], "long_description": "Bowl for your life \u2014 Zombie Strike VR turns classic 10-pin bowling into an undead horror showdown built for Meta Quest.\n\n\ud83e\udddf NINE GAME MODES\n\u2022 Classic: Full 10-frame game \u2014 chase the perfect 300 massacre\n\u2022 Challenge: Brutal undead pin setups, splits & washouts\n\u2022 Speed Bowl: Drop the most zombies against the clock\n\u2022 Practice: Free throw, no pressure\n\u2022 Tournament: Spend scrap to enter, beat rival survivors\n\u2022 Extreme: Shambling moving targets, 2x rewards\n\u2022 Career: Rise from Survivor to Apocalypse Legend\n\u2022 Trick Shot & Spare Challenge: bonus-scrap objectives\n\n\ud83d\udc80 NINE CURSED BALLS\nFire Skull, Frost Wraith, Galaxy Reaper, Golden Idol, Hex Orb, Plasma Soul, Inferno Core, Thunder Crypt & Cosmic Doom \u2014 each with haunting trails.\n\n\ud83e\udea6 NINE HAUNTED LANES\nNeon Necropolis, Space Tomb, Drowned Graveyard, Retro Horror, Lava Pit, Frozen Grave, Cursed Jungle, Blood Sunset & Midnight Cemetery.\n\n\u26a1 FEATURES\n\u2022 Bone-crunching pin physics & undead knockdowns\n\u2022 Power-ups: Guide Line, Slow Motion, Skull Magnet, Second Chance\n\u2022 Daily & weekly challenges, Lucky Spin, Season Pass, login bonuses\n\u2022 Global leaderboards, custom ball creator & alley customization\n\u2022 4 difficulty levels & multiple oil patterns for real bowling depth\n\nArcade horror bowling \u2014 grab your ball, brace for the horde, and STRIKE!", "short_description": "\ud83e\udddf Strike down the undead in Zombie Strike VR \u2014 classic bowling reborn as graveyard horror! Hurl cursed balls down haunted lanes to smash waves of zombie skulls across 9 blood-soaked game modes. Unlock 9 sinister balls with ghostly trails, customize 9 eerie crypt lanes, and climb from Survivor to Apocalypse Legend. Daily challenges, Lucky Spin, Career & Tournament await. Bone-crunching pin physics meet undead mayhem \u2014 grab your ball and bring the carnage!"}]}, "developer_name": "NVR Labs", "developer_privacy_policy_url": "https://zombie-strike-privacy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "NVR Labs", "support_website_url": null, "website_url": "https://zombie-strike-website.pages.dev/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1222736927579354"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1222732134246500", "version": "1.0.0"}, "id": "1511513837146512", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1220728277780219", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1222732134246500"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE",
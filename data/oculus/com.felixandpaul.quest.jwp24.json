c_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93QnYbhuoJItO9Xm_0rqcQaeQfCyYm_7Ax-PWyCywRsw&oe=6A36A2D0"}, {"file_name": "38974792_373526555118205_1737708168990906618_n.png", "id": "424093060783365", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974915_424093064116698_328685127487459365_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEAlMVpXG8IQ7kNvwEnDgay&_nc_oc=AdpFEfHx0oCOErpUJuuU6KLdvD2UvcKosL66ryEsbrsXDtnu_2AB-qGVpxQGfK_cUxM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iXXV05MQbJdNE0Q8xPVIEgblkX0_duWjTskW_RurbZg&oe=6A369B84"}, {"file_name": "38982597_1831686427306771_8944716696442047570_n.png", "id": "499085819739414", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569445_499085823072747_5707457266201421872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tdB891k1GQQ7kNvwHeyCqa&_nc_oc=Ado_hKRCjIi2J8xjSwUfSlDZyBSrb_LJAr1mZ3TKzfbZgACtLUh4Vmm8dyZKVHDVIs4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wTJuvJ9Uc5tQcuSYkAT96ZOzn9xImzU3hghdxfh_mUg&oe=6A36A6C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75458092_320731461045629_1907865697476670940_n.png", "id": "809005748079484", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036706_809005751412817_7630602916016293470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFn-hxaG1qEQ7kNvwGSTv4v&_nc_oc=AdoUZzkTAwYYyT0k1TzNYVuxcotZbhRKiXn3jtS4Rmbm6qFu7Vu6ghlzTY5MTipAg5k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_YxYOQ8SzhOy0uxaZS8vnpdHHQsIeKNayec_5d4uyHg&oe=6A36A6F2"}, "display_name": "Jurassic World 2024", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nIn Jurassic World: Blue\nFollow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9208354262558381"}, "review_messages": []}]}, "cover_s
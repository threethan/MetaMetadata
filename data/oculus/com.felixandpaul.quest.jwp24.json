content-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TrmHxcGNc8N3zD0wh-iYT_PpzoMhzGQV4oz1cXQUfWA&oe=6A185050"}, {"file_name": "38974792_373526555118205_1737708168990906618_n.png", "id": "424093060783365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974915_424093064116698_328685127487459365_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6cs9Oq5GOYQ7kNvwFPVnsn&_nc_oc=AdrS_NazOoVazj8v-SFujGwH6vtTPIzcdSpzWlqp4qiTRSErinFC_Lx1fKl2ijDHs0I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62VZCpvO2jy_MwAVupuk-6NPMRaXkJT3AoTI4iQ-ftyA&oe=6A184904"}, {"file_name": "38982597_1831686427306771_8944716696442047570_n.png", "id": "499085819739414", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569445_499085823072747_5707457266201421872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6Dj1DiaJcgQ7kNvwEtI7NL&_nc_oc=AdrLl7D6n88SZoixXUxdZdzgJH7mczcb4Bb0_GlhdQEuWFMqMhjmuOmB4LeRt3dlgCo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mIp4AN8FjOKr7QuvFbDA2bxJQ7ocKhkLyw3wASpftKA&oe=6A185441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75458092_320731461045629_1907865697476670940_n.png", "id": "809005748079484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036706_809005751412817_7630602916016293470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnJ9kzX5mdEQ7kNvwF7uDJ0&_nc_oc=Adrm1Hw5mAJeUrEDwa1n8jNwPsnaMilO88LeHVLYRz6E8rp3LbdiVJwo4wFeus2ivBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vo3oPNjiR9PHNL-ba6keMJAJDlK6clAa8Lnmu9Zk9jw&oe=6A185472"}, "display_name": "Jurassic World 2024", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nIn Jurassic World: Blue\nFollow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9208354262558381"}, "review_messages": []}]}, "cover_square_
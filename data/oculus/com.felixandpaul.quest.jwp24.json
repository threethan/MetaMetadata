792_373526555118205_1737708168990906618_n.png", "id": "424093060783365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974915_424093064116698_328685127487459365_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcXEPbUuNt4Q7kNvwHr_oYF&_nc_oc=AdpPZYR_SdwiAHyNI5e20MsvfGyyLF0tXrP9CwW4DsKSc_mWjDvfyz8FFjq1Mgpvzks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0bKpQKeTuddaqArB5rfa1Wa_gO12uQNC8AAlsvbFmdNQ&oe=69F0BC04"}, {"file_name": "38982597_1831686427306771_8944716696442047570_n.png", "id": "499085819739414", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569445_499085823072747_5707457266201421872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0iouZTvHVUQ7kNvwFnHVVJ&_nc_oc=Adp2TCGtSACOLXbq_eHcKQpIiffUx8QnnSBntNuzmSVvthS3Bml1puAen9inggcWe6s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3zVPzncOqN9DbgnRmniSpcLffP1MW-oyon3tFlWedfvA&oe=69F0C741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75458092_320731461045629_1907865697476670940_n.png", "id": "809005748079484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036706_809005751412817_7630602916016293470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-txNtHbQb4kQ7kNvwFb9Efi&_nc_oc=AdogTDBx_vmIQtyv4utkhv5gzTHUh78g0KTzBriz3Ibqh69sMIPttFer5U7K93Y0oaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af10YKmpT_LjIooW1d_EwWrHcw1Mu5NsJhBWD7TzLP36Yg&oe=69F0C772"}, "display_name": "Jurassic World 2024", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nIn Jurassic World: Blue\nFollow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9208354262558381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974746_353958874427061_1372464404182485781_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=
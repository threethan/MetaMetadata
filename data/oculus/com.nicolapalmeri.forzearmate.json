ategory": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1793801880, "lastRevision": {"nodes": [{"id": "1836940147441285", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1836940134107953", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1137597761969181"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "4446733912256052", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La memoria attraverso", "keywords": ["didattico"], "long_description": "4 novembre VR. Un viaggio immersivo nella memoria storica del 4 novembre 1918, attraverso la realt\u00e0 virtuale.\n\nLa memoria attraverso \u00e8 un'esperienza VR che combina ambientazioni tridimensionali, contenuti audiovisivi e documenti sonori originali per riportare alla luce uno dei momenti pi\u00f9 significativi della storia italiana: la fine della Prima Guerra Mondiale.\n\nAttraverso un ambiente immersivo realizzato con Unreal Engine, l'esperienza permette di esplorare e rivivere la memoria degli eventi, valorizzando il patrimonio storico attraverso le potenzialit\u00e0 delle nuove tecnologie.\n\nVERSIONE BETA \u2013 IN SVILUPPO\n\nQuesta versione rappresenta una prima release sperimentale, pubblicata con l'obiettivo di testare l'esperienza su dispositivi Meta Quest, raccogliere feedback e valutare nuove possibilit\u00e0 di sviluppo e collaborazione.\n\nSiamo interessati a entrare in contatto con scuole, istituzioni culturali, musei, enti pubblici e realt\u00e0 interessate alla realizzazione di esperienze immersive dedicate alla valorizzazione della memoria storica, del patrimonio culturale e della didattica digitale.\n\nPer informazioni, collaborazioni e progetti personalizzati, contattaci: ing.nicolapalmeri@gmail.com", "short_description": "4 novembre 1918 \u00e8 un'esperienza VR che combina ambientazioni tridimensionali, contenuti audiovisivi e documenti sonori originali per riportare alla luce uno dei momenti pi\u00f9 significativi della storia italiana: la fine della Prima Guerra Mondiale."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "3775121732640822", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_3775121739307488_1619268098468040113_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JLgK608RVsQ7kNvwEC2T7M&_nc_oc=Adr0vwTeq4EqwGU_jeUWU98SAAkE8f3CzVdOeMrKWoHUBzp4Q-xB4amzI9hFV3zjRAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTh8T-ejOsMd_8Bs864T-3NEKPd5t-1COhowFQp_FtsQ&oe=6AF8ABFE"}, {"file_name": "risorsa_base_universale_2560x1440_icon.png", "id": "2717481492003959", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_2717481495337292_1051352925884923756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwBt_87W1WAQ7kNvwFr-oXC&_nc_oc=AdpTpmOJuJDL1PeTmqbaEXeAnCIKegP9Xbacn9snBLxg6fcAnPm5klmH3iVXINP05oQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxLxBYN3ejV30eL1Af92AL9gvce47WSvhvbdQJ0ZgDmA&oe=6AF87AFB"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1624292412574425", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1624292415907758_886054668859075830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpveuEXppX0Q7kNvwEMgFQp&_nc_oc=AdrGolcgPq0rajsJNGgQK326HZTWLPCMLQzTTOShbqb4HTP4l8VgxdCEHPtEfK_rbPc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdGFE3BBSFV2uPyL_C5woVOzVOXkXKu7H0GjGaCtxS2Q&oe=6AF8A7C4"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1456859443267843", "image_type": "APP_IMG_COVER_
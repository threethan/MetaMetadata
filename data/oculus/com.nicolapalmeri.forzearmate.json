{"data": {"node": {"__typename": "Application", "id": "1836940134107953", "organization": {"id": "910269833441659", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1836940134107953"}]}, "id": "2032256780800988"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1834062404395726"}]}, "id": "1652847106633320"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1836940134107953", "release_date": 1793801880, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1837056097429690"}, "id": "1465558172371882"}]}}, "binary": null, "live_binary": null, "created_date": 1793802265, "id": "1839666087168691", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1839673310501302"}, "release_status": "RELEASED", "id": "1836940134107953"}, "id": "1839673310501302", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1836940134107953", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1137597761969181"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1664939972009010", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La memoria attraverso", "keywords": ["didattico"], "long_description": "4 novembre VR. Un viaggio immersivo nella memoria storica del 4 novembre 1918, attraverso la realt\u00e0 virtuale.\n\nLa memoria attraverso \u00e8 un'esperienza VR che combina ambientazioni tridimensionali, contenuti audiovisivi e documenti sonori originali per riportare alla luce uno dei momenti pi\u00f9 significativi della storia italiana: la fine della Prima Guerra Mondiale.\n\nAttraverso un ambiente immersivo realizzato con Unreal Engine, l'esperienza permette di esplorare e rivivere la memoria degli eventi, valorizzando il patrimonio storico attraverso le potenzialit\u00e0 delle nuove tecnologie.\n\nVERSIONE BETA \u2013 IN SVILUPPO\n\nQuesta versione rappresenta una prima release sperimentale, pubblicata con l'obiettivo di testare l'esperienza su dispositivi Meta Quest, raccogliere feedback e valutare nuove possibilit\u00e0 di sviluppo e collaborazione.\n\nSiamo interessati a entrare in contatto con scuole, istituzioni culturali, musei, enti pubblici e realt\u00e0 interessate alla realizzazione di esperienze immersive dedicate alla valorizzazione della memoria storica, del patrimonio culturale e della didattica digitale.\n\nPer informazioni, collaborazioni e progetti personalizzati, contattaci: ing.nicolapalmeri@gmail.com", "short_description": "4 novembre 1918 \u00e8 un'esperienza VR che combina ambientazioni tridimensionali, contenuti audiovisivi e documenti sonori originali per riportare alla luce uno dei momenti pi\u00f9 significativi della storia italiana: la fine della Prima Guerra Mondiale."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "3775121732640822", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_3775121739307488_1619268098468040113_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dgPkCtzJqsQ7kNvwF0Jycx&_nc_oc=AdpyEcBBy0v8E2htKIndEEbTlCWFFgKMTVr5rxKULx3gLorP0T9Mac9fpnXNb9kN0Xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfyP2yeGgf7jOC_qWsEuuITaU6-9TrE47pDDCY5jFixw&oe=6AF47F3E"}, {"file_name": "risorsa_base_universale_2560x1440_icon.png", "id": "2717
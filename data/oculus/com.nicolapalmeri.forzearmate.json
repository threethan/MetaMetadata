t 2026-11-01 225659.png", "id": "2416901555781648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_2416901559114981_4263184732789922470_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYczpYFskUoQ7kNvwG-_mB0&_nc_oc=AdoHP1Bb0WqDhMggBSJ8ypSgdBIxcXnXzjglmh9DZyx488zYRUTWX4xFryTTCG5nSwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFnL_DMnNfGpK5aH1MDJoRAcdw5-L27fRd_m0Tj3VT3g&oe=6AF487E5"}, {"file_name": "Screenshot 2026-11-01 225730.png", "id": "1425129649250544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_1425129652583877_7127387470504562522_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV1_DmJNCp4Q7kNvwHPdigm&_nc_oc=Adpe4_4NyhVZ0q9T1-uooTJ0SCca3r1rG8WUOYNus6rnlV55lFctQwkTrTwamAzKyhM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSANysRSh5pLS4nPpD3mQ28IvJmazeryIrBDz9EgwA86w&oe=6AF47178"}, {"file_name": "Screenshot 2026-11-01 225751.png", "id": "1615032060166227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_1615032063499560_444513148631960982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqrkLTVGeW0Q7kNvwFg3gFk&_nc_oc=AdqUtOnZQH_JQPaww3qklIgnX3xx0ZEG1zwr724zCrYErtbLn1LLdJVp_Wc56qxfxJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQanHb1sOl2J8Jp2TB7KMVeUL0ji7NmMFSVrzPRhmJNKw&oe=6AF48BA7"}, {"file_name": "Screenshot 2026-11-01 225839.png", "id": "1162734829513155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1162734832846488_4702870220234390177_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdCMfvEcFBAQ7kNvwH3iNQ8&_nc_oc=Adp7gob9E2mawsu1a-mvRyzXREQ48yOJZSmCuhkwimp6PZDKigP4pl9IyMvoJvs1_eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAlo5EIXCYX-6yNxCk-FETJ4P3bBSE-_B9gCuJDozwIg&oe=6AF496C9"}, {"file_name": "Screenshot 2026-11-01 225923.png", "id": "2315631172624370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_2315631175957703_1582558660631881973_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTz3XEb9fVMQ7kNvwGddNpB&_nc_oc=AdrOJ9ssSkghgNVj8JpN9MzNtoc82T8uzbsRcVBQ6I_cK_4ryxzmf9hUBQ2339F6Z0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTKDtQWiDORlZj9tzq3l1eRmuZWc1D1IFpULCvXniukw&oe=6AF489A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La memoria attraverso", "keywords": ["didattico", "storico"], "long_description": "4 Novembre VR\n\nLa memoria attraverso \u00e8 un\u2019esperienza VR che combina ambientazioni tridimensionali, contenuti audiovisivi e documenti sonori originali per riportare alla luce uno dei momenti pi\u00f9 significativi della storia italiana: la fine della Prima Guerra Mondiale.\n\nRealizzata con Unreal Engine, consente di esplorare e rivivere la memoria degli eventi attraverso un ambiente immersivo, valorizzando il patrimonio storico con le nuove tecnologie.\n\nIl progetto embrionale \u00e8 nato presso l\u2019I.I.S.S. Archimede di Cammarata, sede di Casteltermini, sotto la dirigenza della Dott.ssa Giusi Gugliotta. L\u2019idea iniziale prevedeva un cortometraggio, scritto dalla Prof.ssa Azzurra Monaco e dal Prof. Nicola Palmeri. Successivamente, Palmeri Studios ha sviluppato l\u2019idea di una versione in realt\u00e0 virtuale, ampliando il progetto con un\u2019esperienza immersiva e interattiva.\n\nIl progetto ha ottenuto il riconoscimento nell\u2019ambito della Premiazione del Concorso USR Sicilia \u2013 AICA 2025/2026.\n\nQuesta prima release sperimentale, pubblicata per dispositivi Meta Quest, mira a raccogliere feedback e sviluppare nuove opportunit\u00e0 di collaborazione.\n\nPalmeri Studios \u00e8 aperta a collaborazioni con scuole, musei, istituzioni culturali ed enti interessati a esperienze immersive per la memoria storica e la didattica digitale.\n\nInfo e collaborazioni:ing.nicolapalmeri@gmail.com", "short_description": "4 novembre 1918 \u00e8 un'esperienza VR che combina ambientazioni tridimensionali, contenuti audiovisivi e documenti sonori originali per riportare alla luce uno dei momenti pi\u00f9 significativi della storia italiana: la fine della Prima Guerra Mondiale."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aniclo.it/4novembrevr/privacy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Palmeri Studios", "support_website_url": null, "website_url": "https://www.nicolapalmeri.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1839673310501302"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_3775121739307488_1619268098468040113_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dgPkCtzJqsQ7kNvwF0Jycx&_nc_oc=AdpyEcBBy0v8E2htKIndEEbTlCWFFgKMTVr5rxKULx3gLorP0T9Mac9fpnXNb9kN0Xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2-tEe6aYkD-6NaNCbuX5_TA8-5rwRl26MDCK8Hs35XQ&oe=6AF47F3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "La memoria attraverso", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1793801880, "lastRevision": {"nodes": [{"id": "1836940147441285", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1836940134107953", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1137597761969181"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "4446733912256052", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La memoria attraverso", "keywords": ["didattico"], "long_description": "4 novembre VR. Un viaggio immersivo nella memoria storica del 4 novembre 1918, attraverso la realt\u00e0 virtuale.\n\nLa memoria attraverso \u00e8 un'esperienza VR che combina ambientazioni tridimensionali, contenuti audiovisivi e documenti sonori originali per riportare alla luce uno dei momenti pi\u00f9 significativi della storia italiana: la fine della Prima Guerra Mondiale.\n\nAttraverso un ambiente immersivo realizzato con Unreal Engine, l'esperienza permette di esplorare e rivivere la memoria degli eventi, valorizzando il patrimonio storico attraverso le potenzialit\u00e0 delle nuove tecnologie.\n\nVERSIONE BETA \u2013 IN SVILUPPO\n\nQuesta versione rappresenta una prima release sperimentale, pubblicata con l'obiettivo di testare l'esperienza su dispositivi Meta Quest, raccogliere feedback e valutare nuove possibilit\u00e0 di sviluppo e collaborazione.\n\nSiamo interessati a entrare in contatto con scuole, istituzioni culturali, musei, enti pubblici e realt\u00e0 interessate alla realizzazione di esperienze immersive dedicate alla valorizzazione della memoria storica, del patrimonio culturale e della didattica digitale.\n\nPer informazioni, collaborazioni e progetti personalizzati, contattaci: ing.nicolapalmeri@gmail.com", "short_description": "4 novembre 1918 \u00e8 un'esperienza VR che combina ambientazioni tridimensionali, contenuti audiovisivi e documenti sonori originali per riportare alla luce uno dei momenti pi\u00f9 significativi della storia italiana: la fine della Prima Guerra Mondiale."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "3775121732640822", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_3775121739307488_1619268098468040113_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dgPkCtzJqsQ7kNvwF0Jycx&_nc_oc=AdpyEcBBy0v8E2htKIndEEbTlCWFFgKMTVr5rxKULx3gLorP0T9Mac9fpnXNb9kN0Xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfyP2yeGgf7jOC_qWsEuuITaU6-9TrE47pDDCY5jFixw&oe=6AF47F3E"}, {"file_name": "risorsa_base_universale_2560x1440_icon.png", "id": "2717481492003959", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_2717481495337292_1051352925884923756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC_TkvQqgJQQ7kNvwERXTqR&_nc_oc=Adr-ycp136wu2gTnW9rfOApBBR5dys7q-R5v5cNMc5bfveC2xZtM8kcHGCfUNk3_LZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlsuPMu0n2twebtoUgR8_WxzGhVXoOGfpYWrnqcmsU0A&oe=6AF4867B"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1624292412574425", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1624292415907758_886054668859075830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBpXU7TFdyIQ7kNvwGB7SSq&_nc_oc=AdqyTWlHfG-N_-pHOU9ux8tJy_SLSuBSVqvZqkyTIyiA9MVcFhIqMphDHDayZ9Pcfh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3DSNw_tNzmX4vaM5iumxe5xKO9FpC4npjnAmuoMLRfw&oe=6AF47B04"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1456859443267843", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1456859446601176_4002175701461137201_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v48hU0mzUesQ7kNvwERzTx0&_nc_oc=AdoHbVEneyMohoIQwIkz4qmzVdB4TCvmwbJXMF1GPJ
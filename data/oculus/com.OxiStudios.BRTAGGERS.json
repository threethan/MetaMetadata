H7LHll245AQ7kNvwG9jvO2&_nc_oc=Adp91tIUorhU1tMzAZxd7SN_v3nK0102eM-MYrJ5ipVY1CWY_x_sXf6m2hvd1x8FLXw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2JWQhn8i4jzC2epgHAQR034xo8IsKQdtX3gE1E2hTCg&oe=6AFB39E7"}, {"file_name": "Design sem nome (54).png", "id": "1498299677852999", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822467_1498299681186332_7990877917083406758_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVbPpi6_hm8Q7kNvwFWx8Cm&_nc_oc=Adr_lRBjqlazWbhPOpZ7sdDh9a4IKA2M8YEhn2OskGVuSuJXsRtOVc9fv9aNuYqQ7u0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVdcbqhv6lkd-Q9u8fg8zIy8Mj7pamXocE5d8ceQoeSA&oe=6AFB1EDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRTAGGERS", "keywords": ["BRTAGGERS", "BR", "BRAZIL", "BRASIL"], "long_description": "\ud83c\udfae BRTaggers \u2013 The Brazilian VR Tag Game!\nBRTaggers is an immersive Virtual Reality experience where you move using only your hands \u2014 no buttons, no joysticks, just pure skill! Inspired by classic tag games, but with a unique Brazilian twist.\n\n\ud83d\udc50 100% Hand-Based Movement \u2013 Climb, run, jump, and dodge using your hands only!\n\n\ud83c\udde7\ud83c\uddf7 Made in Brazil, for players who want fast-paced action and fun with friends!\n\n\u26a1 Multiple Game Modes:\n\nClassic Tag \u2013 Run and don\u2019t get tagged!\n\nInfection \u2013 One becomes all. Survive as long as you can!\n\nFreeze Tag \u2013 Tag and freeze your opponents!\n\n...and many more coming in future updates!\n\n\ud83c\udf0d Play with friends or join public servers to meet players from all over the world.\n\n\ud83c\udfa8 Customize your character with unique cosmetics and take part in special community events!", "short_description": "BRTaggers is a fast-paced VR tag game where you move using only your hands. Jump, climb, and chase in fun multiplayer modes like Classic Tag, Infection, and more. Made in Brazil \u2014 join the chaos and tag your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brtagger/home", "developer_terms_of_service_url": null, "publisher_name": "OxiStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/brtagger/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "31254710964143994"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36973257262289307", "version": "1.2.0"}, "id": "1677714172883961", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "30510196951928736", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36973257262289307"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1677714172883961"}]}, "change_log": null, "created_date": 1784066573, "id": "36973257262289307", "version": "1.2.0", "version_code": 1000096, "release_status": "RELE
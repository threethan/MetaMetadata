.com/v/t64.5771-25/491822467_1498299681186332_7990877917083406758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmeHHMzyz68Q7kNvwEiwTXC&_nc_oc=AdrfWhcuRjxJ81WSFMrL57Q5-a4GIAQvIgnlNdNeXKNb6T2LG12yYx3lPrzAZOc4SyQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3skmfVp7Pb6P3XDfJQpiSk_ceKIZBRufJz7uDOmJGtg&oe=69C1219E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BRTAGGERS", "keywords": ["BRTAGGERS", "BR", "BRAZIL", "BRASIL"], "long_description": "\ud83c\udfae BRTaggers \u2013 The Brazilian VR Tag Game!\nBRTaggers is an immersive Virtual Reality experience where you move using only your hands \u2014 no buttons, no joysticks, just pure skill! Inspired by classic tag games, but with a unique Brazilian twist.\n\n\ud83d\udc50 100% Hand-Based Movement \u2013 Climb, run, jump, and dodge using your hands only!\n\n\ud83c\udde7\ud83c\uddf7 Made in Brazil, for players who want fast-paced action and fun with friends!\n\n\u26a1 Multiple Game Modes:\n\nClassic Tag \u2013 Run and don\u2019t get tagged!\n\nInfection \u2013 One becomes all. Survive as long as you can!\n\nFreeze Tag \u2013 Tag and freeze your opponents!\n\n...and many more coming in future updates!\n\n\ud83c\udf0d Play with friends or join public servers to meet players from all over the world.\n\n\ud83c\udfa8 Customize your character with unique cosmetics and take part in special community events!", "short_description": "BRTaggers is a fast-paced VR tag game where you move using only your hands. Jump, climb, and chase in fun multiplayer modes like Classic Tag, Infection, and more. Made in Brazil \u2014 join the chaos and tag your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/brtagger/home", "developer_terms_of_service_url": null, "publisher_name": "OxiStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/brtagger/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfor
ontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsNX8y3OsCpp5mA5_LRHUiAR0SfhD9ZEHQD6LC7xaTeQ&oe=6AFC60FF"}, {"file_name": "banana_city_3_2560x1440.png", "id": "1135852009377849", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619382_1135852012711182_8158066296536911386_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23P0gT2wb5kQ7kNvwGvRuU2&_nc_oc=Adr_NfHFnFvzAHJKEGLET6JOc0w7dL2_twy7sZEfLHe3eKlHcUVyCy09MkJ5eN-Eubg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnKlcqFpIJ7Hf2-dRfe7XrF69fL2KQUiO4U7Y3ly4VPA&oe=6AFC764F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rec Room Legacy", "keywords": ["RecLegacy", "LegacyRec", "Legacy", "Rec", "Old"], "long_description": "Welcome to **Rec Room Legacy (RRL)** \u2014 a social multiplayer experience where you can hang out with friends, explore rooms, play games, and create your own memories.\n\n\ud83c\udfae **PLAY TOGETHER**\nJoin your friends and jump into a variety of multiplayer games and activities. Compete, cooperate, explore, or simply mess around together.\n\n\ud83c\udf0e **EXPLORE**\nDiscover unique rooms, environments, and experiences. From competitive games to relaxing hangout spots, there's always something new to find.\n\n\ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 **SOCIALIZE**\nMeet new people, make friends, and spend time together in social spaces. Talk, play, explore, and enjoy everything the community has to offer.\n\n\ud83d\udee0\ufe0f **CREATE & CUSTOMIZE**\nExpress yourself by customizing your character and interacting with the world around you. Build, experiment, and create experiences to share with others.\n\n\ud83d\udd79\ufe0f **A CLASSIC EXPERIENCE**\nRRL is focused on preserving the feel of an earlier era of social VR. Experience classic gameplay, rooms, features, and the atmosphere that made this era so memorable.\n\nWhether you want to play games, explore, socialize, create, or just hang out with friends, there's always something to do.\n\n**Welcome to Rec Room Legacy. Your legacy starts here.**\n", "short_description": "Rec Room Legacy (RRL) is a social multiplayer experience where you can play games, explore rooms, meet new people, customize your character, and hang out with friends in a classic virtual world.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://reclegacy.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Faith", "support_website_url": null, "website_url": "https://reclegacy.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1455279563369883"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624656_2392960547903426_6215325376663745419_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6TWWt6bumkQ7kNvwG4BkBm&_nc_oc=AdpgomOOuBCNHGLX1wrpJy1tpdQQm0MRgoKKIiUh2TMpP69TFFCh8t857m_tkcEnbMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS87VRZI2dD_pLv1pZsy0JNnpbRd18WG0qoMAjb20JbjA&oe=6AFC5EDF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rec Room Legacy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics"
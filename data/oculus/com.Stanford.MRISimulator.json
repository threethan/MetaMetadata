=6e7a0a&_nc_ohc=0UVAWl1-DH0Q7kNvwHPXO_u&_nc_oc=AdnPZMeMnDxuolp4_DdwjFgcTMkzNTBlHRvyoLS3z0UB33wWl_R76slqgwU0P2dvUdo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftxB2iaL-P_WFRuesjjxr4EQl2RWqCk8Ug7sqluF3yu5A&oe=69A1AA2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3AzdZY6vpkQ7kNvwHbu3TA&_nc_oc=AdkRPWKj9o5pfIvOfrmAxyNGU9bzhL31yUAqODbXFZjWkdZqXtIXuHaLSRRV4V6jaPQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuDoinMppZpcj2mLXFP0sgS507uxgAHK6a49p09B8IqRA&oe=69A1A657"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.st
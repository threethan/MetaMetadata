uJm6zHlHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUhTyFtxSBoi6W5hEEtaHFgJrRLkj0nbamn8Fi1KK7Nw&oe=6A75D93D"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpNri1ClyCAQ7kNvwFcrJky&_nc_oc=Adr3Uj-9p-j18DhFyac2Ui0VAjpWScqUFoSa5h7Kv3keulQBNXWCv8GW_KKNRagup0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmjJlZ4ucGrynWRjMfQncq7dt6oJGvCVtxDUpyHpRIMQ&oe=6A75EBAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yF1awbu8PAQ7kNvwE_8Eg1&_nc_oc=AdqsTe3QSD2H5ydwJdMiQf-nSfve0F8bGnMj2wtC-0rVi5DxxZ_2IEwWWpmFRT8NaPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfmfOclVJQ6bfABkhLKO480w8IVSRwJl7MXQp4MsLdRg&oe=6A75E7D7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you 
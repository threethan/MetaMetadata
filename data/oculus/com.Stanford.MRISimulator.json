0a&_nc_ohc=hjzD3Wp2nJAQ7kNvwF1xMaA&_nc_oc=AdqV6Y9W6iwm_qe4izVEvcOXs98tbcN3csEVQ8XJFDgCXDWX2hSmYtF_QSmGb_Aa6ko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11IsoJS1HW_AcOgrJFh7w3hKN8b-jnw2EOUKTjWJSFYg&oe=69D90DAB"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miuVpD6UhPYQ7kNvwEJCVMt&_nc_oc=AdpNQ0zy1PkO1YbX6mEhe9gO1xxZrfiVXFKJhzGOo1zMxbB633UZ2mCK2Fzbx1vZFDs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v7rEEJXdeRISOLAtFSnP5Kfz7J3sehS5qKsSVFg48tg&oe=69D8F6BD"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RCx_BoOM6wQ7kNvwEaovUH&_nc_oc=AdqD-fLkm4_Yb2KHMlL2fFfOtkUrkM2AIME5T-TGSMmSnETTJPquxRqpvnEBmJedklw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rz2zU7ETBka57jLN237iLerLYe9H32e1AbdErm6exhg&oe=69D9092A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYap7xJPYcwQ7kNvwEEHmqO&_nc_oc=Adpqodgjcs2G5Z0an2-6FA844o6pTz6jlHcGkcuD6ErwoHXcZtd2nneEXC8iOQvLRRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04cB-c1n-CYiw_ngq1h_xTtmi_arc-9nt1tjCt_WDVGw&oe=69D90557"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNSftI8NGB4Q7kNvwEtJorI&_nc_oc=AdoElk2Wxxd_AgQzPUQMLCfhDhrKRZNFoE
0a&_nc_ohc=kI6bp2iUHZ4Q7kNvwG7NkOc&_nc_oc=AdpID8-kUbmmMMbw8h1-SDaKwdh9XoguX8yAiZ4lPid8OZ1YVVQmH07-jWK0gIvdnW8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMx0r1ZuStW-LRgt_CdGOc4SdCpKzYDDEe8V6hh3t9qQ&oe=6A8ACFEB"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGV6ezEi7L0Q7kNvwEe-kbS&_nc_oc=Ado41ND8ZZN2jzDdyEE68dhnnIvPCab_DS3YesX6EzV82vYRPcfQYkCFWexEfFA5V1w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3VAPPJBI0vOS5ZMclYdL_T5jWp5dq7cpIgLoGJ5H00w&oe=6A8AF13D"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqKT9bt5kZYQ7kNvwGM9qNB&_nc_oc=AdopeX9X0SvWIeiHeD7Ef6phqF6qg2IdUAhU_P3DAkgZMV6z7Hk9QqkINmiezCG8QDg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdO7DFxTS_3b7HAkZkKEENIpVylcPybclSMOB4AfqRTg&oe=6A8ACB6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKAluv9XkU4Q7kNvwHNpD1F&_nc_oc=Adryok_HROL0cgIpSE0YkxILL3HY0nYRrAjvb2Kn0-A7LCJqQHgxClCefh0qhYIICUo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdyWM657jFQCrAkcj8_tfnq4zHBSUlOURLyM3DrHsZag&oe=6A8AC797"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XbQNaobFwcQ7kNvwGvR68X&_nc_oc=AdpyOnc2tU_AcrK56e0koi6ytnEtBF3y0R
0a&_nc_ohc=sFwIaAp9vasQ7kNvwEt9SQ7&_nc_oc=AdpXcB4qovGsCf9ZxQv30K49tZ6iFYwDnjF9MRyIMcMibJpGmrWKi4FKuUMEtN_trn8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k_iF1eP3g1lXd0pU5a4eNmOu0pRpEnwbRoyW-sZUWrA&oe=6A106CAB"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNXYUPZdXn8Q7kNvwHyYIKp&_nc_oc=AdojALt04ij7cA2qVPAQm99h33m0FigVeaRxcAU_0HAG6hOVNrHMbfTF4tR4A3qsVgE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nqj8sT8zKFz1PaTIVsThLe0gzoAv3dYLkbwIQMIv5-Q&oe=6A1055BD"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn4m4yCvWxQQ7kNvwFk3NRA&_nc_oc=Adq4EqwaK6iJps7L6COlcynt-vLIOphDPHi15VO-fQD7UNj45KB_2JsXYzZnaePxfqA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mroV_OU9Ak5ui8HtO9Rc-FIgFPlpEwUZCYaAtDNLtQg&oe=6A10682A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8ogp5zhq5IQ7kNvwGtdY2u&_nc_oc=Adpzm-djhmQK1oWJpeE6bOoeIjgWnfl5gzWfKI8Z3NZhce--rmvmngtb5LsZ-XkVXLU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yu6vyaI-gb26Br9NkxH-Lo6TOgg2882j8vpJRBwW3JA&oe=6A106457"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UYy2SqSjh0Q7kNvwHkampI&_nc_oc=AdqVKKyCAnfK-nVJHsAQomKU4k2Ngz7U0S
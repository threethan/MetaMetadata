3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afurq6Z3b_MjFRAW5BOkQGpn7e-bIA5xC_-0C5XDqpNiJw&oe=699C68AB"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_gg8KcMEssQ7kNvwHOWXXH&_nc_oc=AdkF6KSX4L44jmnbuj1ISGyPaq5BDYoNRIBMyqEj1y0-xtku6FUbJaOEJnTUg46hJic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuHYzhxlfa1vPDL1K8CcfPispJlX5oBHFJjjxjGwtaCvg&oe=699C51BD"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B4z7-9LDK0Q7kNvwF4dS8v&_nc_oc=Adkswz5wxRXQ41rVv2EBzzI71g-EwVl-VwkClXbOPMTT7whR0i-zSZWn-Wu2YKd0Xio&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv6Nbk860P1xNxrhEhXF9T6cU3iyn7B1r7-aCmUNM_K4w&oe=699C642A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uF-15ivuPYAQ7kNvwG_72Rx&_nc_oc=AdklGQXsLeAn4ntfO3oK9JW2gNJOwF-R9ZF7DNSzF684pxNSife4PefvWYzrfwoZErs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvq9JWCNvAyDC7M3i-Z9dWisU67BrexhLh9njek7ngwNA&oe=699C6057"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QMvziTohkAQ7kNvwGD1laG&_nc_oc=AdnC036FiD74hxAm98QWAUgWsaaw0XgAvHflL3wizqD1Rcjv0GRSO-OC207fRGa8PFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftKqatnBtzq4NVeWqcUXJF5Qq_8jhCtDip5tjtwThEIuw&oe=699C4B7B"}, "is_concept": false, 
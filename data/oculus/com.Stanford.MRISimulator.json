-T9hOE0u4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxYkKq_BJdQERx51-aR1uwfMWaUtzp-QYn3MVV43feqg&oe=6AEF5B7D"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s15VeH5TckMQ7kNvwFRcyqB&_nc_oc=AdrHfA1NRLnR_DJTQ7aQqLMsmy82_g3qPgl67qvmLnEWXbkILKt8cwFDOG7f3OOnPNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2nJpulk2Dt5gEMmjJSvZBg2xJXhtO_SAApUOpxZzn5g&oe=6AEF35AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag0GGSQBeVcQ7kNvwFJ5CnK&_nc_oc=AdrTBaJmThgwH6XHjrrMTCb62qf6QGhW0iAjBHrF2AiHvOoZ6mZ-b95B57MTVUEBbPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbd9uRp_rEg89KxlfPyxRGNIc4U-jlddRsd-4xgrVH0A&oe=6AEF31D7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you 
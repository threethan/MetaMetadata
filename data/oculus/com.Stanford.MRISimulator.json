G36MFxuENg1ITsIdrHicg&oe=69A82F3D"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6I6X3kiTPcQ7kNvwEdyuKy&_nc_oc=AdkdL1FWAPSJ8lTBAFxuga1oA7PB6C7IQPcjXWhBz8jdK5Y4iyRtj9de5Z1JESXzZCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsuBC7KuVosJnaXYGfnP7_tri20S_VnMuyO1EaaaZh80w&oe=69A8096A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK77_58HXPYQ7kNvwGgVeZ5&_nc_oc=Adn1e9MlyU6sT5MO3RiUrApJov0PSs2GN_1NfwG1eIU9vlbX_E0Gao4fR13eUPatFn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsnuJtjCj7QGAu7om4UdmiGyccLitwBl4diNn3dg2sl8w&oe=69A83DD7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": nu
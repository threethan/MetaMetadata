=6e7a0a&_nc_ohc=O_huUfuNqscQ7kNvwFcKbHQ&_nc_oc=AdlPK7mr0qicNF8WFGvI2lExDSpBpohF9BjtO_Oqmroix5jBtaDovs9HQ0ZXqRt7H3Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsU6RQ5YDxR1KSDPHKW5YO93gNnmYxUrSE9a-yvmw-6sw&oe=69A59EAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ykzl23l3vMQ7kNvwF0XQNU&_nc_oc=AdntxDmo7jPVk2RqEsNm_hq47RF5CYAh97eO3DxxHmHaNJqIaREO2GYoYos-QPAYkhs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs4mYApuaWlzK_1iSsU9m-jun2GKLz1MNTLpRuIAAJdWA&oe=69A59AD7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.st
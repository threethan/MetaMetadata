xCd0H5KA7NJRKKdpWK617fStY6bvqNoM7dskwnA&oe=69AAD23D"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6I6X3kiTPcQ7kNvwHdHOkp&_nc_oc=Adl6KTlmhFXrveVTCSqkEDlAheJX0virwHabkoldfuUU5SGFl6O2pf2eVAnEKsIzulI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSCbfgyGmBk_WO8KLmoZXnjePuB9GAvAjc-Yb6oPQrRw&oe=69AAE4AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jx9W3ANvrOYQ7kNvwHXRAf_&_nc_oc=AdlucyatXfmzWemY_KZIxOmFbrkyjHHiG7Woy7KyzU5JwmYcC05JiYaS_AppMy6LBas&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5cfbTYzy0t3-XQqAzYoOyhn26OpeOMvcLkt-Cs_0eyA&oe=69AAE0D7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "d
0a&_nc_ohc=mHvekq25O6cQ7kNvwGP5165&_nc_oc=AdqHZfGYqLCC12aR4i6_QPOc1KBy3HVf8CpBEkVz2pJ5bFysQreWe62YZqF18DgKkNU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqXONqcMe9DlzyvFMY7OQMPn7bAYxuLmmNVIOD37h78A&oe=6ADCC52B"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2LmkOjwWbMQ7kNvwHXU_Oh&_nc_oc=Adq55YQCEi7v7ycpqmE5CC5QTnqbfMu58rM6682B9TFy_oh6YrhCjGFo9_13Tst55WM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-FJtPWMQhfgh0EUEx_xwqt9VPPUuwXGnacGNwKtHX6A&oe=6ADCAE3D"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZN1mHUTg0oQ7kNvwFBMP4t&_nc_oc=AdotJf2xXhvIYL2YlM_xLhBup2B8iQJ8gzyg1egSgeQ8Z3WcYAmHHeh2u-QfgXTQvaM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON105KRJyicusRvz3P05jMAIVsmbtvDNVBb7P0_KX0kw&oe=6ADCC0AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh9UN6gCqJAQ7kNvwFUOzTb&_nc_oc=AdrHJaEwtl6GRVPV1BasA0uCJccQcrFbDmCa_twYCuR2SMc2uX2TR4-w1sDp2nzlXWE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU9WkvKmMTp8mv1B6s247Cb0bzzdAuUHDhbRzUmwwAGQ&oe=6ADCBCD7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCG9z6YbHU0Q7kNvwHWiO5o&_nc_oc=AdoJZTuHHOLbnxVZDlUuboplPlelsLpPo1
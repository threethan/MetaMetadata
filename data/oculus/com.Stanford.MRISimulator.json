ttps://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSjFUnvJMQEQ7kNvwHezx7B&_nc_oc=Adq7QH6OhO6onWOaLT6zQXY5GBBVLQXjwo6E7-OsnrYqtW_pI5lhGBh5AZOva1l9NDw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WpjFgZm1IYU-dxO5DiJrxNJ3nO095lVYT8m-iUfOKJA&oe=69F215AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuuHV-9X2T4Q7kNvwFv5KXQ&_nc_oc=AdrCvF94rmAUedRZvZLHAnX6TXLHRaCbzwP4xTGVw4bA0LySiTZpDXAuy0gRbJ_cpGg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3vCgLORKnXPIHVjFHZLUrXxUzj0wb9IrBnPZWNwkkmmg&oe=69F211D7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_
0a&_nc_ohc=1IiB1oOuOEUQ7kNvwF04vZO&_nc_oc=AdrVeahRxRmznUegjY-9Kdqe6xY1o3hUABV1nrvyTY6OBg_uAsfmvokQmDtKD8GuvLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARuS3w0-rcahp4ims5DUltKMNsF5Z-sffMPcWxGrxwug&oe=6A5257AB"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKmKD5u2AWQQ7kNvwHMoUQa&_nc_oc=AdqgtaxQAcLxGhng4GX5kQkAKFcRynlVv1AP9lax4mGuhY4aBfsrkJisy8d0Y7aE57s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFCpwD7G4F3bPTFn3AzF9kMUZUwTf7SigsX39L0UhLaw&oe=6A5240BD"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8d1-4nCs1hgQ7kNvwEoaEGt&_nc_oc=AdrGjHkFjr5nXhdTra02VBrM0n0RZKs4z4qYGA_YI7lApC1wtwu1lxfq7VknkRvtB-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8KhQHzHBi6uuYKgvFOS7xLgmeeyb6mDRl-5krgN2AOQ&oe=6A52532A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7ba64qB5ukQ7kNvwHTZ6cm&_nc_oc=AdrMjfzuE_IkuXBV88kvWLoAp-1B1QQdBwPyn7c5fwk076AViHyiu70T8PmB4SXcPUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQeXdidp3UW0D6Bzar1zIlgA_pxBk81qhMjWD2OLjgng&oe=6A524F57"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8MbwWJ_iRwQ7kNvwEnyJNN&_nc_oc=Adq_JKmOuZLiCpkQHA4qOD14g3g0GUOTQr
=6e7a0a&_nc_ohc=5B4z7-9LDK0Q7kNvwEclPhf&_nc_oc=AdkvpZ2-WaFHLCj7aCZfKZ6OOoPZpd4J9CG5XlO9C0-mk5wqQpNi4qTQn2ZfoNcN5vA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsQ9qnsTkK4HY_88MDOScFowQiOjDhc40tAO6LRmk_CIA&oe=699F072A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3AzdZY6vpkQ7kNvwG44Gxb&_nc_oc=Adk_PdY2BY7Tbnj0QsUk_wBN16LqIZQ6Uk_sy35COtZFG4FhAX8vHf3OQDXMyrRqn5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftdCO4v4HkR_XVvdJ9R0wDXVK_0l99JuCfQjFPyl5-MEQ&oe=699F0357"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.st
=6e7a0a&_nc_ohc=xX4It-1iy24Q7kNvwGx6cPi&_nc_oc=AdkLItGZWT32O0s2wVOidTtjUL-zqR3CG9uhuZ7vBdoyI2hb29ecBWBtuu3uWsPuMxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftqkOG9A-lkrqfgk719oT_22jTVFPO4rbFXqHEPcxsPzQ&oe=69986FAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jzltu29nsicQ7kNvwFG9vZZ&_nc_oc=AdkcucVkSJk3s_avKDHLXFYtaojbIq8PUm2J1VZv22TMqV_9HjUK8vjVx-P6T2b9wro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftae7pzr_W--xsZ3eV5STB6QZSDgpLGlUEBkbst3bYVIQ&oe=69986BD7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.st
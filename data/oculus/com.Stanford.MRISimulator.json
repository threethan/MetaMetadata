0a&_nc_ohc=UtHjoMPF_g0Q7kNvwEw9pSo&_nc_oc=Adqsa6sv9RdTCgG9f-htbjIGljjV8xRu4J-2_NZml8yaPaUiCC1bSiwsbhOuCuzvvq4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85jZzsw_d9Ggq-HyqbvlIido83bkp4xWX0Cy4tX3s_qQ&oe=6A31622B"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-yKM8eBWMQQ7kNvwFPx-U0&_nc_oc=Adpz5oYR4uCMf9izUWIE7IvZrvCu8R84YAdeyoiHtgoXNrvP747gHBqqcJMpMpYF7P0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2MfyesjfbfOzbS_ssGSGd1W35_meTwNW0j3vbdAoHCA&oe=6A314B3D"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm0J2IpJkJoQ7kNvwFljBrh&_nc_oc=AdrWYd7q1-zPH4xwaHqNT2dnNFaP-PAurL54w__Y9J_gFxm5cTHsbW74hyzlLJTsHdc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lF5l1sk-ynHdrPqu_m7pV9YnNLvDSaBviUp8FlnIYpA&oe=6A315DAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-rnBhUogZQQ7kNvwGYTGY6&_nc_oc=AdqIcv9svdlPZJRyJsh39SlF5ilKOZQWGD9kRlSMKTsiNbzt90tmmGuOlZ4NNC8JVuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8CNLcDvMA-jnOEecS60uoVLjFyRrswMaZiBH9wZZYlg&oe=6A3159D7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJV0t5jUMBgQ7kNvwFZAstB&_nc_oc=AdpCXNY2vXqt-eHFHo3rVIhGRIc9BkCW7A
0a&_nc_ohc=FYsb5buUGHMQ7kNvwGtV3Ud&_nc_oc=AdpdZmQMrnwRPX3-Itjl0EFO3UmBqIcapZWmdw9VFqmgIqRtSBmv6ab58J87hCvH-BE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J-hNTmaNQ0WOFehwZKbMF30BITnrotKp9u3yFHttftQ&oe=6A0B26AB"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6e2rwYPu10Q7kNvwHYQJm2&_nc_oc=AdqY6jtZMHGLMI98z48CoXa1_1r8H2Bbmo8AA4qNvvL9UKP-RSv35k2IyN1EIeol1CA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B1hckPwT4x9G5XYTrM7vV_f14607zR0Rf60_Se8muWw&oe=6A0B0FBD"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNt0n9BJQEUQ7kNvwFc0zrQ&_nc_oc=Ado1NRaZ0gA3zuW2zjIIc9Tlve4esN1dt1B2-EpQXEJKUbtd59tdKHSHCaEQP8_gRPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72UwQLzV0q9QVGQZJvb7B66655wVNxwu09VWMbG7EJRQ&oe=6A0B222A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kqm7Kee45T4Q7kNvwF4gpQT&_nc_oc=AdpQNkRuYBMyl6HqLfh-DNjlGT4iP6VkYaIpGNUk41z3tjhhD5rEhHu-KsqOW0nqWS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FcSyfgdmFV7yHKriH63N8k8y6upDqphnUz5a7kdnq-Q&oe=6A0B1E57"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kSjJYqioG4Q7kNvwEI-MmS&_nc_oc=AdqrkDP3Zt_-v2vomEOlTzrV3t60boRPO7
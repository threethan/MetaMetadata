0a&_nc_ohc=feN_0HYCgs0Q7kNvwGH-AUA&_nc_oc=Adp3zpNKJ-20L3jgPe9qmi97E5e7Q-RtZsJZ6x6vXwfJKA_PKDQakP1UuMKF8jBsI3Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BFgL2aKmLoxrsRY5Lg_UQEf6vDOSw0Vhv4uqPK389Vg&oe=69F60EAB"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6BAlUP4XRMQ7kNvwE5AYr-&_nc_oc=Adp2EqKnM_Zh-fCLNPiM2p71MVmxrIaCBpTX_NC9zn3kAqGz2M-asigvHG09mA1ENd4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Idw0KBDwcO7HoFd7Ya6k7snLteU72jLA8Oj-esOXc-Q&oe=69F5F7BD"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMKbi94HoaEQ7kNvwFOf5uk&_nc_oc=Adqnkwjtg2uhd9JC8L07LXGuoehWDMLFFk6FAaqcS1EiPukXSxqP46ddxrfrwuZ1C54&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hxE9jMY5HFrNURExBXWX4iwbDT_rzBsJR5DhU3JLflw&oe=69F60A2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GD5OEFDY0oQ7kNvwGzw6zy&_nc_oc=Adp1Pwe8i-_oINkA-YYa0rixclzza8qo7WVU6B73L90UdOTaIrbl7WFnslRI1VsHpPg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LiAW8-66qCTKqCnLsr45zBo-Ty8m7bL04bjNg9HTWLw&oe=69F60657"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnStQGXHY0MQ7kNvwGNfJWf&_nc_oc=AdoqNnl7E9-BGrFrckH3ciOn9QlS-9BHv3
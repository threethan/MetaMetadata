0a&_nc_ohc=x6FMS-cncsQQ7kNvwFGGvFp&_nc_oc=Adpm4SeNireNm1SgOtrb1ewfymzIrThcIXPcuzds0b8Ivj9LofRlAjVhmImsD8QdMd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxKCwb_60ekqYoNmoYRnJh4qtcs9_WCt7PLDtT2ZgObw&oe=6A491D2B"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f77mX0ARBKAQ7kNvwEJVP9s&_nc_oc=Adq0Jch7zEn8z39lTCP6apqgB5Tw9zK3k1eOhsOKR_v6YSPzq636I9g4a1C7kHeYeJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH-cOcl4Jls6UNY2GDRMUskyv37lMjAr1rWlt0pyFcSA&oe=6A49063D"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yu7XlzKc8KQQ7kNvwEJc6w8&_nc_oc=AdpDq1MDH9wKYHA4K8AeSNKPV0GxWp9WsaF2pClyhcsBc4vslDQRWNIdAjQkke8e7fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALr5YWoy4pvxPl3kwuHFEWQRjEPkvq5mwUCQ5ocBCAhg&oe=6A4918AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_BmwYzzTTkQ7kNvwFSSQAD&_nc_oc=AdqrOpY7mMtFler1HCQ_WNWN8dDd7s6L7eEvCwzgxz8jyGuVrbEn0BmSJa2TIzR-7oI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDBrBaSWrPhfXop1iJzM-jxwfaztyVAxhY_ndH-MHYIQ&oe=6A4914D7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUsya6c4WzcQ7kNvwFbOgFC&_nc_oc=AdpxDNCFvmQALSqHtmChu8wDCCy2_Wwf1f
=6e7a0a&_nc_ohc=0UVAWl1-DH0Q7kNvwF-dnCS&_nc_oc=AdmDr_8amC7Fmx8sxbLsUhtMx0MLSdgBp-R4IEitwm-GEby1R45O7LM61J_uSucB_oA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmoMvWVUVTQ42jAOd9dxS_efeZYlvqKk_lhZsUIHaEOw&oe=69A2FBAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ykzl23l3vMQ7kNvwEr0QeO&_nc_oc=Adl_9_TafErO1rvdrWEBjJ4jvw7fSuuLVpwI1TDLEm_LS6rCNM9dNUteFyqisheKAUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvZuCXlK9PLnSDbzL9jgMbnrXYz-g3Zy7770nHTjCfwvw&oe=69A2F7D7"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.st
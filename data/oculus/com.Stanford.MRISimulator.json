0a&_nc_ohc=Iblyad95DbcQ7kNvwHxWLw-&_nc_oc=AdoBEoSN0TljL8mLEAPigkzpQ2VLM8cSvkIKwv5xrIO3ztFMxN7XCTYyejL4Dc5v7EU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WnMJDtp9EZeaQm45u1V2JlhYUGxxYiCDXWCu3Y82rYQ&oe=69E63CAB"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I-7EBbOgGMQ7kNvwHWtkrU&_nc_oc=AdpgOyN2U6rPMzi-M_PMT67GigkoF3yA9V9ZuKF1C2QSonpnjiRytCSZfucyA1DV8RY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18ZMMEztNkyeLT1X9kYREbr5_CJRaFubRmOfMfL5g99A&oe=69E625BD"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P54uY8mB-SIQ7kNvwHilCUE&_nc_oc=AdqeeekstMFZOjmq_BSCpGEutprWZhxB39UxnXg_uOeorY_4K9x2R7p3gMg4r7m-WO4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NkgytHZYZ1ghp1ZsMOMfXqr_GTSeOud5gEG9CBaw3yg&oe=69E6382A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqjtIs1JpfwQ7kNvwF5LKbT&_nc_oc=AdpLBddJyKGZDzOx0tsiuqhrmp8QEjH5dETrMnnCit6PB54gA-FjJGZAwaxl4GARbGI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ak0D9ZV9jbffVvfd8l29UE0gTqsJzO7myua4zzHEFUQ&oe=69E63457"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgKk8MNIrZsQ7kNvwHlUd6f&_nc_oc=AdqZ7ny8UuX_iS5R61hID26D2TATebMph2
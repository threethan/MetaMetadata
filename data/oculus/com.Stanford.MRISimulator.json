3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv7tJEDaedF_GhUc8ARJdqliyIVy-LzO4aVhixX10CoBw&oe=699ED36B"}, {"file_name": "5.png", "id": "556869180626096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_556869183959429_6468358583038224534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozZIS441FLgQ7kNvwHQD3QK&_nc_oc=AdkKAtJe7w9id1Pn6JGfLt0Zswm7JU2Go_H__IdV3UALD3POhN0D_Llr5sExuSEyPr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvPQadISDwNsfDTAZ4HiTg-ATEXC5Kfqf09tfX7gEHFUA&oe=699EF4BD"}, {"file_name": "6.png", "id": "3437595989873886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488372_3437595993207219_5162603116348091206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B4z7-9LDK0Q7kNvwEclPhf&_nc_oc=AdkvpZ2-WaFHLCj7aCZfKZ6OOoPZpd4J9CG5XlO9C0-mk5wqQpNi4qTQn2ZfoNcN5vA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsQ9qnsTkK4HY_88MDOScFowQiOjDhc40tAO6LRmk_CIA&oe=699F072A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo.png", "id": "3893522640861604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_3893522644194937_386125247700992078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3AzdZY6vpkQ7kNvwG44Gxb&_nc_oc=Adk_PdY2BY7Tbnj0QsUk_wBN16LqIZQ6Uk_sy35COtZFG4FhAX8vHf3OQDXMyrRqn5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftdCO4v4HkR_XVvdJ9R0wDXVK_0l99JuCfQjFPyl5-MEQ&oe=699F0357"}, "display_name": "Stanford MRI Simulator", "keywords": ["MRI", "Hospital", "Cancer", "Patient", "CT"], "long_description": "This is a realistic and fun MRI simulation experience developed by the Stanford University IMMERS Lab and the Stanford Wu Tsai Neuro Visualization Lab to allow you to experience an MRI scan and understand the procedure in the safety of your home. Includes multiple experiences including:\n- a virtual MRI scan with easy-to-follow explanations of the procedure, \n- a 360-video of the preparation procedure to get ready for an MRI scan, \n- a practice game to keep still during an MRI scan so that the MR images turn out well\n- a breathing exercise to relax during an MRI scan.\nPart of the simulation experience can be performed while lying down. Start the application close to your bed, use the stationary boundary and follow the on-screen instructions.", "short_description": "A realistic and fun MRI simulator to allow you to experience an MRI scan and understand the procedure in the safety of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://web.stanford.edu/~cleuze/terms.html", "developer_terms_of_service_url": "https://web.stanford.edu/~cleuze/terms.html", "publisher_name": "Stanford University", "support_website_url": "https://web.stanford.edu/~cleuze/support.html", "website_url": "https://web.stanford.edu/~cleuze/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228235927212673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031487_554219427106182_1060863342676892776_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QMvziTohkAQ7kNvwFgZNpL&_nc_oc=AdmgXJjgaMkCVGN-p79vq_FGIxnkacsJ4thi37GXDSWG56fcMlyx0gQGT0Welv-NrUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsIRMrzXzpyl4gUet-2tS_b3r39CjE07V9frkhcFjl_PA&oe=699EEE7B"}, "is_concept": false, 
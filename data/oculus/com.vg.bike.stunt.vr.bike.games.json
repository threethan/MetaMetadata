wNlKpRLq7E2DZA1vHnBoJFnU5I8vyjcJXXCQ&oe=6A8C1BEE"}, {"file_name": "Screenshot 2025-12-10 071932.png", "id": "874049988397562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_874049991730895_5424359405007883425_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLZPXWAO3aoQ7kNvwGla5in&_nc_oc=AdpC5VMeTmayddlq73fu-UQcsVEqQPBSawXYykSxWoKDkpzgMGKgJ8OGmd-iEhnGa8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8OBBR5XvXydLREpB7RBrFXU7gsha_va1C3TwzFSXPag&oe=6A8C1F74"}, {"file_name": "New Project (1).png", "id": "1938661673347844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507925214_1938661676681177_6267772099121722365_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRYbYlprmaYQ7kNvwEmKWTM&_nc_oc=Adr2_BXZQc_euFPy4MNA4Xf4XosRwnQECznFosc4m5MNDgE6s_FfeG3b0Us9xJrDQxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9tG2NDqtClqnltMD9umxWLhevsqc9XwmXIIB7Li3_og&oe=6A8C28D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bike Stunt Extreme : Moto Off Track Game", "keywords": ["moto", "bike", "offtrack", "game", "racing"], "long_description": "Bike Stunt Extreme: Moto Off Track puts you on the seat of a powerful stunt bike as you race through challenging tracks, massive ramps, and extreme obstacle courses. Master tight turns, precision jumps, and high-flying stunts while testing your skills on unique off-track environments.\n\nDesigned for both casual riders and stunt lovers, Bike Stunt Extreme offers smooth controls, realistic bike physics, and a variety of levels that get tougher as you progress. Perform wheelies, flips, drifts, and extreme maneuvers to become the ultimate stunt rider. Easy to pick up\u2014hard to master!\n\n Features\n\u2022 Realistic stunt bike physics\n\u2022 Off-track stunt environments\n\u2022 Ramps, loops, jumps & obstacles\n\u2022 Multiple challenging levels\n\u2022 Smooth and responsive bike controls\n\u2022 High-speed racing and freestyle stunts\n\u2022 Perfect for beginners and pro stunt riders", "short_description": "Bike Stunt Extreme: Moto Off Track delivers fast-paced motorcycle stunt action with challenging tracks, massive ramps, and smooth controls. Perform jumps, flips, and daring tricks while racing through off-track environments. Master each level with realistic bike physics and exciting stunt challenges designed for all skill levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24859817637054252"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2244017803027688"}, {"status": "PUBLISHED", "id": "2214302249336752"}, {"status": "PUBLISHED", "id": "1000032169489874"}, {"status": "PUBLISHED", "id": "1572801453789640"}, {"status": "PUBLISHED", "id": "1256828352459375"}, {"status": "PUBLISHED", "id": "1561535751738793"}, {"status": "PUBLISHED", "id": "856913640276394"}, {"status": "PUBLISHED", "id": "863861986056788"}]}, "baseline_offer": {"id": "863861986056788"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "22440178
XSM587eA4c7txiOCvqAHp0LZKszG9beMox4g&oe=6A18502E"}, {"file_name": "Screenshot 2025-12-10 071932.png", "id": "874049988397562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_874049991730895_5424359405007883425_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjA7MYWK6wkQ7kNvwFJ6yZj&_nc_oc=AdpG-3DmeKlRPaMPyMnxNUYpBxp_ZAe60At_sM0cxag0anEqilplv5fBi9x62ablyhI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y8AzJ5f7bBhxzgY-r8XWOoZ1bThX24G84XUfPU2Bcjg&oe=6A1853B4"}, {"file_name": "New Project (1).png", "id": "1938661673347844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507925214_1938661676681177_6267772099121722365_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoy7QkjbiQ4Q7kNvwEJHheq&_nc_oc=AdoN5FcM9qSuKOoxbFZ_dLarE2uIQ_nlZS1lKaRSRo5caNYMpjMDco1bwT9Yx1QjrgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FnNdnom0aoIEy6IWFWx8-3wXFk5lKMo_wu1mFBxfJNQ&oe=6A185D19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bike Stunt Extreme : Moto Off Track Game", "keywords": ["moto", "bike", "offtrack", "game", "racing"], "long_description": "Bike Stunt Extreme: Moto Off Track puts you on the seat of a powerful stunt bike as you race through challenging tracks, massive ramps, and extreme obstacle courses. Master tight turns, precision jumps, and high-flying stunts while testing your skills on unique off-track environments.\n\nDesigned for both casual riders and stunt lovers, Bike Stunt Extreme offers smooth controls, realistic bike physics, and a variety of levels that get tougher as you progress. Perform wheelies, flips, drifts, and extreme maneuvers to become the ultimate stunt rider. Easy to pick up\u2014hard to master!\n\n Features\n\u2022 Realistic stunt bike physics\n\u2022 Off-track stunt environments\n\u2022 Ramps, loops, jumps & obstacles\n\u2022 Multiple challenging levels\n\u2022 Smooth and responsive bike controls\n\u2022 High-speed racing and freestyle stunts\n\u2022 Perfect for beginners and pro stunt riders", "short_description": "Bike Stunt Extreme: Moto Off Track delivers fast-paced motorcycle stunt action with challenging tracks, massive ramps, and smooth controls. Perform jumps, flips, and daring tricks while racing through off-track environments. Master each level with realistic bike physics and exciting stunt challenges designed for all skill levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24859817637054252"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1572801453789640"}, {"status": "PUBLISHED", "id": "1256828352459375"}, {"status": "PUBLISHED", "id": "1561535751738793"}, {"status": "PUBLISHED", "id": "856913640276394"}, {"status": "PUBLISHED", "id": "863861986056788"}]}, "baseline_offer": {"id": "863861986056788"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1572801453789640"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24883777
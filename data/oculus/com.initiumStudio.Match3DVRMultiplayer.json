culuscdn.com/v/t64.5771-25/75300187_475426808445704_5234333958588389385_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kco9q9RSrI4Q7kNvwHON_W7&_nc_oc=AdlUSHqh7XUn_XnOnvOd6_maMzZeiLwkD87UvZ7iqaM3vgbRcha-1t77U9H9azjihxk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkB4FAvMQv_Xxz7dN00BmlsvB_ipaE0RNUKElH2f4ubw&oe=69AAD367"}, {"file_name": "1.png", "id": "2337382856637853", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974907_2337382863304519_7023300262399965180_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f84aaE3C2U8Q7kNvwGco_eH&_nc_oc=AdmtEGKB7T1MwZyISpRIP1qTvsOAwdxs1DyV6B6DJ0I1keO7o8lPgBGC7DZh2rIS_Wc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxSwXDA_TvvDe1u-_uqcw_M1bkd4bFi2ZhZcZo6M2lZ8w&oe=69AADD94"}, {"file_name": "3.png", "id": "8970369203027746", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75593944_8970369206361079_1911111715101505234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXFxgltDb64Q7kNvwFl7TpE&_nc_oc=AdleSaYhoZqH5p_AHO2XnBEKs_KCYCxpDMPM4dKE-4nJoe7XSRys7m7kJnjGLsMrkr8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyKSQI6mBvtsZtfspQm2B8PTMZYC1VAuEOi7mOPl7VQjw&oe=69AAD155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440L.png", "id": "1073259001193025", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75593944_1073259004526358_224982520837413700_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysL3f7nobSYQ7kNvwFq7G9p&_nc_oc=AdmW44NOKMcBcBmd7-rZY2k7Z6lfMy3BKKPAB7e-Cu_VpldfdQe4Bid0dDt_17kddk4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afwy4P5zK_MfcPtQloQ7fHPdNvLIWmxfg10-6gSJvN3yWA&oe=69AAC52F"}, "display_name": "Match 3D VR Multiplayer", "keywords": ["match", "item", "3D", "multiplayer", "vr"], "long_description": "Match 3D VR Multiplayer: Step Into the Magical World of Matching!\n\nMatch 3D VR Multiplayer brings you into the delightful world of matching games, offering an enchanting virtual reality experience. Test your memory and speed as you try to find the right matches among carefully designed 3D objects!\n\n\ud83c\udfae Key Features\nImmersive VR Experience: Interact with 3D objects in virtual reality, adding a whole new dimension to classic matching games.\nRich and Colorful Content: Hundreds of unique objects, captivating levels, and an engaging atmosphere.\nMultiplayer Fun: Compete with friends or players from around the globe! Who can match faster?\nRace Against Time or Relax Mode: Take on the challenge with time-based gameplay or enjoy a more relaxing experience.\n\ud83c\udfc6 Fun and Competition Combined!\nFace off against friends or climb the leaderboard by competing with other players. Showcase your teamwork and individual skills in an exciting VR setting!\n\nWhat Are You Waiting For?\nDownload Match 3D VR Multiplayer now to test your matching skills and dive into endless fun. Get ready for the most unique puzzle experience you've ever had in virtual reality!", "short_description": "Match 3D VR Multiplayer is an exciting multiplayer virtual reality game where you compete with friends while matching 3D objects!"}]}, "developer_name": "Gametriclabs", "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
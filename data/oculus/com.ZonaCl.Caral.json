2_5831197800896111586_n.png", "id": "365267459909082", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974879_365267463242415_4269032359821098144_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve13huUO-JMQ7kNvwHcGdKi&_nc_oc=AdogFbsif2GxbeeqraDV7PFlpfrDDi6pl2h1BC4bVXDSgJCMpNKZuLffgXVVm5iUwWg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKyu5SXNFLXjJMrdoyQ3O8IOALumXivNSna9za0f65fw&oe=6A8D9517"}, {"file_name": "38982559_3437680489871236_1699666663770297041_n.png", "id": "1009407900958954", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974803_1009407904292287_3679968250326307394_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNeBPu_aPSQQ7kNvwF7tKoj&_nc_oc=AdrgUXNSZq1d4lyBSwOf1U9jaLTiFi9VwPnWCZXXRaZYjcsjHQ0wW8xQ2VBvpQDLZPA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQuI2Q7I6OXbndGYgEqZdtGG848HXhaykgbghPu8-Zow&oe=6A8D7183"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CARAL PER\u00da", "keywords": ["caral", "peru", "Caral", "Per\u00fa"], "long_description": "Desde cualquier parte del mundo, te traslada al antiguo Per\u00fa, Am\u00e9rica del Sur, 5000 a\u00f1os atr\u00e1s, 4400 a\u00f1os antes de la Civilizaci\u00f3n Inca, para ponerte en contacto con la historia social recuperada del importante patrimonio arqueol\u00f3gico de la Civilizaci\u00f3n Caral. Ideal para estudiantes, viajeros y entusiastas de la historia, esta app es tu puerta de entrada a Caral, reconocida como una de las civilizaciones m\u00e1s antiguas del mundo. \u00a1Prep\u00e1rate para un fascinante viaje en el tiempo!", "short_description": "Experiencia EDUCATIVA inmersiva e interactiva inspirada en los valores de la Civilizaci\u00f3n Caral, la m\u00e1s antigua de Am\u00e9rica. "}]}, "developer_name": "Zona Arqueol\u00f3gica Caral", "developer_privacy_policy_url": "https://sites.google.com/artemar.net/caral-peru/inicio", "developer_terms_of_service_url": null, "publisher_name": "Zona Arqueol\u00
=00_AQQmW6psFfZ7eCYeqkvdIrlyykAAmi5T0kyvrrUGjZdzoQ&oe=6B0C557F"}, {"file_name": "2.png", "id": "3683146305232029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75292490_3683146308565362_5831197800896111586_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7f1jg3C0M8Q7kNvwFLksPX&_nc_oc=AdqeBxw2oJUrr3OR85spOplT9B829o6xQami131mcfWR0wGRi8AOMwT54y6eZ4W7pvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFfAqw_Z-F6mxuVM1Cmbg1loMHEJnapfLpKe843UIqFQ&oe=6B0C6DEE"}, {"file_name": "ss1.png", "id": "3437680486537903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982559_3437680489871236_1699666663770297041_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBY31VzMN60Q7kNvwE5oIyP&_nc_oc=AdrxaUlokcY7UqwDYp1k41k9dVkDPwLhK1c8GZGL23gc2yLnsADo2PYgPYClFvS7THQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8jNpxA0ywe4CkVa4tGelDPNxhlIqyX5Ntp_5WMRjwJA&oe=6B0C6C7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CARAL PER\u00da", "keywords": ["Caral", "caral", "Peru", "Per\u00fa", "peru"], "long_description": "From anywhere in the world, it transports you to ancient Peru, South America, 5000 years ago, 4400 years before the Inca Civilization, to get in touch with the recovered social history of the important archaeological heritage of the Caral Civilization. Ideal for students, travelers, and history enthusiasts, this app is your gateway to Caral, recognized as one of the oldest civilizations in the world. Get ready for a fascinating journey back in time!", "short_description": "Immersive and interactive EDUCATIONAL experience inspired by the values of the Caral Civilization, the oldest in the Americas."}, {"images": {"nodes": [{"file_name": "39001674_587494440371487_7059593033162963244_n.png", "id": "8459267897475096", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974506_8459267900808429_341968
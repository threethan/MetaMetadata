=00_AQVmIxW7Nak7FMtRDqmHcu2DEdvffUXG_bV38t2mJu8_tw&oe=6B0EF87F"}, {"file_name": "2.png", "id": "3683146305232029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75292490_3683146308565362_5831197800896111586_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjAmOXgs368Q7kNvwEJ-JEq&_nc_oc=Adpcop9XqtZKt01RrlkKLC14hVa6Kw8IDF4xvEI-jzuz2wB2ywTg3mb4GauGHtJekmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjDjAGF6Oz9HkvzxK0yt5lDAAqSo8cp3V3bm2TFKo4zQ&oe=6B0F10EE"}, {"file_name": "ss1.png", "id": "3437680486537903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982559_3437680489871236_1699666663770297041_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8AQpPMUAhAQ7kNvwGd0HZb&_nc_oc=AdpJpcXU8sG93oPl4k4sSuhFMIUuLYOSDzFldfYdPGSr3bWym2q1GsqkTV01Aesjqfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3lL_mwAsNPopjEuIgmp9CqED2IOq9dEr_eOlc4EllKQ&oe=6B0F0F7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CARAL PER\u00da", "keywords": ["Caral", "caral", "Peru", "Per\u00fa", "peru"], "long_description": "From anywhere in the world, it transports you to ancient Peru, South America, 5000 years ago, 4400 years before the Inca Civilization, to get in touch with the recovered social history of the important archaeological heritage of the Caral Civilization. Ideal for students, travelers, and history enthusiasts, this app is your gateway to Caral, recognized as one of the oldest civilizations in the world. Get ready for a fascinating journey back in time!", "short_description": "Immersive and interactive EDUCATIONAL experience inspired by the values of the Caral Civilization, the oldest in the Americas."}, {"images": {"nodes": [{"file_name": "39001674_587494440371487_7059593033162963244_n.png", "id": "8459267897475096", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974506_8459267900808429_341968
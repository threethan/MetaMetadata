=00_AQR4ZgGPfbFQoaY-2T_5FIMc1FJEutHg8Bk2ui7UkNTvjQ&oe=6B0DA6FF"}, {"file_name": "2.png", "id": "3683146305232029", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75292490_3683146308565362_5831197800896111586_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjAmOXgs368Q7kNvwFzWd9j&_nc_oc=AdrbOw7VsgKcsgC2AxwmwKW9lzcsrEgI2I6IDAfnDSCQ3hi3gi7ejub6zH-CPavN578&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTM1eCVMv_FckAUqGslyqrCyaBRjSUpZ57b1rxbbwO-oQ&oe=6B0DBF6E"}, {"file_name": "ss1.png", "id": "3437680486537903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982559_3437680489871236_1699666663770297041_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBY31VzMN60Q7kNvwHRPcaE&_nc_oc=Adr_BgaHA25WbHjbMu_7-rDp_xnGf2Q3CX1vzZEYZEUEZrn1fixfg66jPUCEyV7XjUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1pn36BMw9KDUDEsugnSUaxEZTEpjaki1MhKcNLXNU_w&oe=6B0DBDFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CARAL PER\u00da", "keywords": ["Caral", "caral", "Peru", "Per\u00fa", "peru"], "long_description": "From anywhere in the world, it transports you to ancient Peru, South America, 5000 years ago, 4400 years before the Inca Civilization, to get in touch with the recovered social history of the important archaeological heritage of the Caral Civilization. Ideal for students, travelers, and history enthusiasts, this app is your gateway to Caral, recognized as one of the oldest civilizations in the world. Get ready for a fascinating journey back in time!", "short_description": "Immersive and interactive EDUCATIONAL experience inspired by the values of the Caral Civilization, the oldest in the Americas."}, {"images": {"nodes": [{"file_name": "39001674_587494440371487_7059593033162963244_n.png", "id": "8459267897475096", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974506_8459267900808429_341968
4479448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1599668307812781_312849198400901807_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynr1yFV_AjEQ7kNvwGVCa9M&_nc_oc=Adpi3K-9KAppBuFjiwg-n53Jause4VwqV_F_1EKLAy-vnPbBpfr32jGDzKvt5tgqg-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Dm0omR2YWyYsdzq2yY8S73UPWsOziCo6bL45l6wrRpw&oe=6A2EB483"}, {"file_name": "GetGains_Image_4_Output.png", "id": "824656307367692", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_824656310701025_2156004122516689955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZrcbDSOgDYQ7kNvwGyLcaL&_nc_oc=Adr-PeboOWdSP_K3aU9YTOh0H1pQzB8Q-fvBeoQvstp7TGwDj3LfQouaydRuRNf29cw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KnbAprdjfVPPZCLHT0zYjYnFwrrbTGPtxJ25mrul_TA&oe=6A2EA13D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail_1a.png", "id": "1427322052033653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_1427322055366986_8642881163623921336_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SO_T9WX63bcQ7kNvwEaYaEa&_nc_oc=AdrFZQAGLFBKXax4MijyqmRe8COBkugJTqlHwoHmJKVvXKUNfFBTmrCeeAcacBFQARw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86F-R1iBiY2hmeiHTSUTj-Rv4NNeFg0VA36_t0x1OCxQ&oe=6A2EA845"}, "display_name": "Get Gains", "keywords": ["fitness", "weight", "lifting", "boxing", "mma"], "long_description": "Get Gains is a weightlifting tracker\u2014start tracking your gain NOW.\n\nNo setup. No calibration. No complicated menus. Just pick up your weights, start lifting, and let your workouts track automatically in real time.\n\nGet Gains tracks your reps, total weight lifted, and overall strength as you train. As a dedicated weightlifting tracker, it also measures your lifting intensity over time with a rolling 21-day cycle\u2014so you can clearly see when you\u2019re pushing harder, maintaining, or recovering.\n\nDrop your controllers and grab your weights\u2014Get Gains handles the tracking. Squats, curls, raises, calf lifts, and more are recognized automatically, so you can stay focused on your workout instead of logging sets or adjusting settings.\n\nNo distractions. No friction.\nJust lift\u2014and let your weightlifting tracker do the rest.", "short_description": "A weightlifting tracker that works while you lift. Get Gains automatically tracks reps, weight, and strength\u2014so you can focus on your workout, not logging it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dubfitness.github.io/getgainspp/", "developer_terms_of_service_url": null, "publisher_name": "Duck Virtual Fitness Equipment", "support_website_url": null, "website_url": "https://dubfitness.github.io/getgainsapp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26798296719792786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_1442751757057739_4482841564770069604_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rGja214xwAQ7kNvwF2wuTG&_nc_oc=Adp91_OTt40DsdTA1O-k6pazdGx4HHBqnH0BDanjWs6MEth7sChYzkL0hy-tU_5sWKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oLPrEj46HDq5J35D06GkXRpiyB-1Q11lt7jeDR-TbAA&oe=6A2ECB47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
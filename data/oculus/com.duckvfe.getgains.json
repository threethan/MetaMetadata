_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7rWtwbhEQwH52Sl57t-KjvFFbElPadJpuxyhwMVReKg&oe=6A8ED535"}, {"file_name": "GetGains_Image_5_Output.png", "id": "1490451292870128", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499295853_1490451296203461_1304118256621536951_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEOfi-Xn_coQ7kNvwGplgru&_nc_oc=AdoJFGFzD1dM-cVNp3PrgpMo7TLmn9f_CwO8Ie6ASGEzh-JhI2odPY-EsQKpGDtgnZE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQZcDaJbXXJvwJOojq7hMUq9MnynptS7J-zHOIl4tCTg&oe=6A8EEA9C"}, {"file_name": "GetGains_Image_6_Output.png", "id": "1599668304479448", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499617850_1599668307812781_312849198400901807_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmqBLQHvGzwQ7kNvwGvv4Dk&_nc_oc=AdrqPpLMhkg5hemk0DUHO_T6nmzoX9qnLaI7FgEhCpxD4IASS2By30dd24iGZHfea5Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqC0XCiKseG4PERulgK5YCTg6owCIiyVuFYrka5jfOUQ&oe=6A8EF203"}, {"file_name": "GetGains_Image_4_Output.png", "id": "824656307367692", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619187_824656310701025_2156004122516689955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpS7Snu5DXYQ7kNvwFACoqU&_nc_oc=Ado4H2vUoq7Vbf8-uF1E8a39LB8pxTZcZkPFzlYqg_G61KjDs7TiHxO6S8eae47X1N4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlDTx2m-BqCym1PUykUh-_IyCIbNquIzP6FWg85sP_9w&oe=6A8EDEBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail_1a.png", "id": "1427322052033653", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617850_1427322055366986_8642881163623921336_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCaz8Zn-EXMQ7kNvwGzO0sL&_nc_oc=AdqdVD9NPisV0gnTynXJOVCB5pz614hrNPkKI1mulaP4BWob84KnmUVMFTFhJuwAzpY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrtxmIk8W-g0fcmW0NUUjtvKEfd9EedrD_Y-Tjg2dPzA&oe=6A8EE5C5"}, "display_name": "Get Gains", "keywords": ["fitness", "weight", "lifting", "boxing", "mma"], "long_description": "Get Gains is a weightlifting tracker\u2014start tracking your gain NOW.\n\nNo setup. No calibration. No complicated menus. Just pick up your weights, start lifting, and let your workouts track automatically in real time.\n\nGet Gains tracks your reps, total weight lifted, and overall strength as you train. As a dedicated weightlifting tracker, it also measures your lifting intensity over time with a rolling 21-day cycle\u2014so you can clearly see when you\u2019re pushing harder, maintaining, or recovering.\n\nDrop your controllers and grab your weights\u2014Get Gains handles the tracking. Squats, curls, raises, calf lifts, and more are recognized automatically, so you can stay focused on your workout instead of logging sets or adjusting settings.\n\nNo distractions. No friction.\nJust lift\u2014and let your weightlifting tracker do the rest.", "short_description": "A weightlifting tracker that works while you lift. Get Gains automatically tracks reps, weight, and strength\u2014so you can focus on your workout, not logging it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dubfitness.github.io/getgainspp/", "developer_terms_of_service_url": null, "publisher_name": "Duck Virtual Fitness Equipment", "support_website_url": null, "website_url": "https://dubfitness.github.io/getgainsapp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTI
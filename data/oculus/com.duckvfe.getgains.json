4479448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1599668307812781_312849198400901807_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIzjHtvsHY4Q7kNvwGm8Bfh&_nc_oc=AdrobCHNKsSDrCPlZJxhorZPnsL4Rtgp66qAPBztDRpKwqV88ysWk8Hon3TIylGTA5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4fByaD-0T4rqYGTkpE1hI0J9LTrZijygPq_x2rgYD5A&oe=6A6B5983"}, {"file_name": "GetGains_Image_4_Output.png", "id": "824656307367692", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_824656310701025_2156004122516689955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXqV_wGieZoQ7kNvwFN92DF&_nc_oc=AdpK3nQdane8dTZF0yp79KTcYCndQXJE0_9KFaSXvr5XX67VigrgvSIr4GnITqlx9P4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSR4WSJsuc7sChGQa0AHAWbiH7SCsAkSOhHKzL0Ye3VQ&oe=6A6B463D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail_1a.png", "id": "1427322052033653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_1427322055366986_8642881163623921336_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnJBps4YJ8YQ7kNvwH9J4QN&_nc_oc=Ado5JJD8ZxpTgx7ohFdvGx2E1ia-o6736MMObWdUlDfbLltH2iL-twQA4Jn3EcIjeGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPLSFiozGZj1fVPT_9pyEcNGtyO6lqXYZiSSvOONbNwg&oe=6A6B4D45"}, "display_name": "Get Gains", "keywords": ["fitness", "weight", "lifting", "boxing", "mma"], "long_description": "Get Gains is a weightlifting tracker\u2014start tracking your gain NOW.\n\nNo setup. No calibration. No complicated menus. Just pick up your weights, start lifting, and let your workouts track automatically in real time.\n\nGet Gains tracks your reps, total weight lifted, and overall strength as you train. As a dedicated weightlifting tracker, it also measures your lifting intensity over time with a rolling 21-day cycle\u2014so you can clearly see when you\u2019re pushing harder, maintaining, or recovering.\n\nDrop your controllers and grab your weights\u2014Get Gains handles the tracking. Squats, curls, raises, calf lifts, and more are recognized automatically, so you can stay focused on your workout instead of logging sets or adjusting settings.\n\nNo distractions. No friction.\nJust lift\u2014and let your weightlifting tracker do the rest.", "short_description": "A weightlifting tracker that works while you lift. Get Gains automatically tracks reps, weight, and strength\u2014so you can focus on your workout, not logging it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dubfitness.github.io/getgainspp/", "developer_terms_of_service_url": null, "publisher_name": "Duck Virtual Fitness Equipment", "support_website_url": null, "website_url": "https://dubfitness.github.io/getgainsapp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26798296719792786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_1442751757057739_4482841564770069604_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPjiIIuJtmYQ7kNvwGvzxPR&_nc_oc=Adpj-FBxF19DbmKCzclvXu-rXW48vIIFDf_msx4O0n90uWhJrTMY04EbxqnqjAbyVn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzi1_vrAyc0K9LFm6NtEEgfBdhXNn2nrHDubws7UrDZQ&oe=6A6B3807"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
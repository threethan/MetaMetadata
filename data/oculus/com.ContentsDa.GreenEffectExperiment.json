eJ0hgBAVqj4lBDEQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyklb9rAJPNQ5ZnSAxTBagSn_juETI1gTm-epODYAgb1w&oe=69BD3F65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Green Effect Experiment_Landscape.png", "id": "3481996928690603", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031377_3481996932023936_4051301558531483797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV2hcvPxunMQ7kNvwEB4UcF&_nc_oc=AdlMO16DmeMueAVq9qynEHaU1MhK40ht1P-EUjK1J45_RFMSlHCkHUzOeA0Y38RHmLk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzz2sC0oJNpg1jimbzsBZgwx-L13890wLcz4T9XQS-scQ&oe=69BD40CA"}, "display_name": "Green Effect Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "life", "greenhouse", "science", "contentsda"], "long_description": "1. Prepare a regular aquarium with a filter and a eutrophication aquarium without one, and add lake water and soil to each aquarium.\n2. Add fertilizer to the eutrophication tank with the dissolved oxygen meter and thermometer to the tank without a filter.\n3. Allow photosynthesis to occur and observe the changes in both tanks. Determine the difference in dissolved oxygen in the two tanks and compare the results.", "short_description": "Explore the principles of greenhouse gases and their impact on climate. This experiment shows how increased levels of these gases affect temperature, an important concept in environmental science"}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "
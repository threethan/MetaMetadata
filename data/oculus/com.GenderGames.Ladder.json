=1-7&_nc_sid=6e7a0a&_nc_ohc=X1zZJjTYMjAQ7kNvwGs7F18&_nc_oc=AdrRYao14IuLN4P-C9AQ78RXNMT3Fm-a5S-6NROQ5viR68ZE-PtP_y_NusI7z5S7R-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zglJY93ZLR6CSqBiazuoJWXkYEY6hR-IpATqtbVq8gQ&oe=69FB5B30"}, {"file_name": "Meta_Screen05.png", "id": "773991915103608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_773991918436941_5200151582077370008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGXcQf7Z9_kQ7kNvwG43VGm&_nc_oc=AdqCqW7RWH7tljU3hmfj95ccT-aDb5pIbjFFZosfuLutWGVBmDGAd1Vcwd-wmIkGBt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79vkrM6EvmLehOPKwXpamx_y8w_GVMem-ho4vNP6DbFg&oe=69FB3530"}, {"file_name": "Meta_Screen04.png", "id": "1077797753973543", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820910_1077797760640209_3953569218156840975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-uEY1XleZQQ7kNvwGLwXe6&_nc_oc=AdpXkk1PQwVt0lStq9aXnSH795gut-lYhJrtKg5vs2khv91kijOy1-N781la91sEfvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IKX5mTGSMADaNAXhEBBrOXYiFXef5xJoyDr-R1BX4TA&oe=69FB3094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Screen02.png", "id": "1298225785195772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818852_1298225788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqhnSGfj0YcQ7kNvwGrhfyP&_nc_oc=AdqXcU1pK42wATq8zDFfD60G8BLRqRY4n-fhbJCpefP7OT3if3PNOrBkcU0eibRz2tI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_60nWXCyTRtP6L3of0-T9rCPfmXzIFjRGWP6s2OOoiA&oe=69FB2754"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9756031887831809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296119_776280428413708_5991003999670503936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXvgiGrr5uQQ7kNvwFLBKuA&_nc_oc=AdrS_4RxNcSiKci-F2HLruPyVS7lqzhsW7hMKcHoMV0J-iZfudVh_aakQ6G29sbiGuM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uCVwH6BQ96MnKa13_xfMTArd2inCc14LYSWNZK6YYkg&oe=69FB5CC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Ladder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES",
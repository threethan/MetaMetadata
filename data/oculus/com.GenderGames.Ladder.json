=1-7&_nc_sid=6e7a0a&_nc_ohc=V2KR4HAW1SYQ7kNvwH9mAR9&_nc_oc=Adr-5EnRVOvZswv-uH3qfsgVkjiyB7xx0F8B_Vvfp4Ybzq6zeTqj5MlnQ0eI-HxuMzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gO58PF0JzdWt_NMfpsSQRZgDQi_Tba5gJVvi08BUbqg&oe=69FA09B0"}, {"file_name": "Meta_Screen05.png", "id": "773991915103608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_773991918436941_5200151582077370008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGXcQf7Z9_kQ7kNvwHtT6Yn&_nc_oc=AdpEmMy6qIZtyZN1it83uIsXXRp9tXYtA3K9lWI6Ez3hHdltgKQmyJsKY961Sd0drd4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tncKDI3pSyP7d7hTyNKgx5LNQNlXczarsZHxTSuHMnw&oe=69F9E3B0"}, {"file_name": "Meta_Screen04.png", "id": "1077797753973543", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820910_1077797760640209_3953569218156840975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-uEY1XleZQQ7kNvwFgroVz&_nc_oc=AdqbLFK8wylGAjucfw3ccHewV8KvpyBioVQA95JZb7Wnf54BuJJFi2IpTikhnGUG7qo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45e_zKJ-tg-BSotpyjUHHucW7No47Mg0D1mwOCP2rxxQ&oe=69F9DF14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Screen02.png", "id": "1298225785195772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818852_1298225788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcsvUerTI5IQ7kNvwHWitTK&_nc_oc=AdoDNfiTI2RpZQc_gHBkWWc4gKoSyfNcuxPfFzdebVPRT9gle5HH2ZW0RKZrkl4nNno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qc9euG-xqSHe9vqNiw4nX8duxZmSGg0UEsbkru1KGxg&oe=69FA0E14"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9756031887831809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296119_776280428413708_5991003999670503936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXvgiGrr5uQQ7kNvwFSBhAw&_nc_oc=Adom8-xE6fi0YtTD2KTAYFXlB2y8kYvYDZflJ9mqWQLuq5LOhwkcpp1wPdt273Iuir4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mov_3ZYEag3_9TSYa2Y4H1pD-dJ3nOWisAPHoHulF0Q&oe=69FA0B45"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Ladder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES",
=1-7&_nc_sid=6e7a0a&_nc_ohc=V9nHAJuPB7YQ7kNvwEMuhah&_nc_oc=AdoA9T-BJiSlG6qMJ7k5vE6e6QH1BfrKwVcKoOuerHfUif-zrdErX12sgJBkXbPh_CA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Rb9sxzZxaFvHBxdgq85LeChDxanaaiown5XfK85ekSQ&oe=69F4C3B0"}, {"file_name": "Meta_Screen05.png", "id": "773991915103608", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823783_773991918436941_5200151582077370008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NErZWS_OzP8Q7kNvwFTA3Lh&_nc_oc=AdpBjZA9Y5tRnmzzJDzaSnBCBW_Kc5XBWOalj5gsInS7tM3zZbc3arvQdl1s5ORkK0E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lWSpjFy23mo-5HODfJSoHsXM74yawS6lnjuFviRRbEw&oe=69F49DB0"}, {"file_name": "Meta_Screen04.png", "id": "1077797753973543", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820910_1077797760640209_3953569218156840975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxYb390IhSYQ7kNvwH8b290&_nc_oc=AdofqjCY1mASpmFL58J4JEYnOYlnmEmF0wByz1l0y6G5sGGWyCiO2r_dfEk7gdH9Zso&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3M0H2fCXE94_PFAgQO1CeQHapsK-jCLGiIxI908z-AXg&oe=69F49914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Screen02.png", "id": "1298225785195772", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818852_1298225788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3iMQbztE1QQ7kNvwFU-_xJ&_nc_oc=Adp0K4peZCxvJqirZY1f5xaG3rpP604YFn90CP6xGoXdP9l6SkXhRxKfRfGKN_NGdTA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05hC7HJAe73uxxLRVsxTzbVEYNMW8cbYprXl17DVYDvw&oe=69F4C814"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9756031887831809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296119_776280428413708_5991003999670503936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0wPEpLN29AQ7kNvwEa7l9Q&_nc_oc=Adqo6OVS5_dUZnbPmbIJ5DPlfS-njZlcerjeH6IwBudLFMiSusKk0W8gyQYaj8gyBos&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3J3NNvNbzpz1Lt-PeZ4Wy4EYoYEXiATYo2ZOKwdh2jjQ&oe=69F4C545"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Ladder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES",
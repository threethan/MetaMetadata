=1-7&_nc_sid=6e7a0a&_nc_ohc=V2KR4HAW1SYQ7kNvwGceNu3&_nc_oc=AdpXWx9h5NmDUjjnQPnm4tg-HiiN1pb2DIfPPwbMccRUl2qkg8CGxcLl77xqhM2eWlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1j3AthXFccFLlyE4MAqPo-9U9NP4dcC07ttaIQ3nJUqQ&oe=69F8B830"}, {"file_name": "Meta_Screen05.png", "id": "773991915103608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_773991918436941_5200151582077370008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGXcQf7Z9_kQ7kNvwHQ2X-A&_nc_oc=AdqJSShe2_NFU6HnjhVZWzsREHXsFy4orLEAurDqXpvGQKxjqw5AH88JcXKwcRmfMTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fQE-CGBWkyfYX2c6IvalXOn2Ed0JsHJcokEGqVEY9BA&oe=69F89230"}, {"file_name": "Meta_Screen04.png", "id": "1077797753973543", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820910_1077797760640209_3953569218156840975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aYcLrKKpioQ7kNvwGeKtTM&_nc_oc=AdpGBx7Fvx3fEdfsCwAkPhxzUtetJhpIyUzZhqyOLAKX706BIaFrmrJk2YqY09dMsuo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31kQGb1g5ffbFRge87-alt1w8_pc98f-p-SfMSll85yA&oe=69F88D94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Screen02.png", "id": "1298225785195772", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818852_1298225788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcsvUerTI5IQ7kNvwFQFnp2&_nc_oc=AdrmAFDqutp-9dTmpQAeBtVrHIe9PEtHDwhuThH7rJT49lodfVvXfpqCuNR3ptijHvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-B1USQZ4GPujVszs6dd3-nbTc2bFvA-jOPPlTakNcFw&oe=69F8BC94"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9756031887831809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296119_776280428413708_5991003999670503936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXvgiGrr5uQQ7kNvwEy41tM&_nc_oc=AdoEkIT_YQw38LGFVxV6UE3iObzboYSc3bCYNb4pJ67VezvaqwggiQJr1o3e29EhDBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bfuDuSDPmYinDebyC5fpzeRS0gFExIPnzTfKm1wBKog&oe=69F8B9C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Ladder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES",
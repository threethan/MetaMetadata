5788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqhnSGfj0YcQ7kNvwGrhfyP&_nc_oc=AdqXcU1pK42wATq8zDFfD60G8BLRqRY4n-fhbJCpefP7OT3if3PNOrBkcU0eibRz2tI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_60nWXCyTRtP6L3of0-T9rCPfmXzIFjRGWP6s2OOoiA&oe=69FB2754"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes"
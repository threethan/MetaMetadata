=1-7&_nc_sid=6e7a0a&_nc_ohc=V9nHAJuPB7YQ7kNvwF8MelD&_nc_oc=AdrEA9uYOS5S0bPfAucUn16LAOnYpAUlgmQ3vxaSHNUjFKaPfIHy5VDEN2H5jkJmeFQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3L_2pKrtWlbbj9_ywyi0dONi64I-Lr6a_N8QWzV3lwiA&oe=69F61530"}, {"file_name": "Meta_Screen05.png", "id": "773991915103608", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823783_773991918436941_5200151582077370008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NErZWS_OzP8Q7kNvwEbscV5&_nc_oc=AdpnX4r9fRzlgkDptTW5ZdCVxWkTQcojnhLKymHvWXV9dKSglbgnvx4ZAcpFRflXL5U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2maLADij-OTyDUp00h1wchRCFSVld6OGu7izUQq9ZQUw&oe=69F5EF30"}, {"file_name": "Meta_Screen04.png", "id": "1077797753973543", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820910_1077797760640209_3953569218156840975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aYcLrKKpioQ7kNvwEx1mnh&_nc_oc=AdpCiXKD8NJ2RxFQ4u6Na4LlH1lSQP3eHi4loVq3V7CccDqdRHuf2E7zjwsy8cHQSwo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XQ-zAusB85w52Ms3JqT_123ahpo9AsQlmYmLR9Mg9WQ&oe=69F5EA94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Screen02.png", "id": "1298225785195772", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818852_1298225788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3iMQbztE1QQ7kNvwGLNJ0i&_nc_oc=Adpv48XXjSJ5NUhs68wi2aUGIxYiuBEWF9UyGfHQT9SwyBvMfXgcoi6t8a_6QCqSp-Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0j1GjEPabcxIiiBZ4cLUOfIXKO3CtRFN0O15WWc8LcYQ&oe=69F61994"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9756031887831809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499296119_776280428413708_5991003999670503936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0wPEpLN29AQ7kNvwHuVYWD&_nc_oc=AdryaxodQsPSapo-dzyo05QWDmtOJlyNe5Ucj_aZXzRiI0J52LP87wesTX1r9QRmFsw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01mo0_qaFxG08a2kZDYcrrX_ptRM9NZP1PiVeftcCINA&oe=69F616C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Ladder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES",
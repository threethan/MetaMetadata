=1-7&_nc_sid=6e7a0a&_nc_ohc=V2KR4HAW1SYQ7kNvwHmHq5z&_nc_oc=AdqIesKG-J3HNDXvM4ic8Hh_48bB8BVPYwkybPoMMY2oOXjP4CXmCO2fw2hPtWZZR5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_6KewOsDZcLq1wObTdMjuA_5WneWYx-Yx6AmR3LgYOw&oe=69F766B0"}, {"file_name": "Meta_Screen05.png", "id": "773991915103608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_773991918436941_5200151582077370008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NErZWS_OzP8Q7kNvwHR-WnQ&_nc_oc=AdpA6PZkbbHyzm2ZCWpca21Cw8sgvbtwKhT4Dx9hvqK-FvOdlhhel1ICFJJSKZTI_6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FWJAIM0S1Gksv52wqxkeSeN1vP0Kcp22Ap3mp3kVs4Q&oe=69F740B0"}, {"file_name": "Meta_Screen04.png", "id": "1077797753973543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820910_1077797760640209_3953569218156840975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aYcLrKKpioQ7kNvwE8q0dn&_nc_oc=Adpc-2l1oy4B9PFqEycQgAFwqgF1PksaAjDnLsrTZ0wBTn7VKckUpF61Or5JSW5JNHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EiZeoVKzPfn-NYD4k-Vux3Btt4dH-etNOrIczAEpAtA&oe=69F73C14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Screen02.png", "id": "1298225785195772", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818852_1298225788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcsvUerTI5IQ7kNvwHim7qV&_nc_oc=AdplSwTMG7HHZ8igjhkscjPrlOGEo3N74aOM5k1yRWoF1NQ-GLp8n-LVG9-GX5lVaJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ax_EwzgcydtNhQmADEeYGOMoqjq1B8FNj4QYTfcYY0A&oe=69F76B14"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9756031887831809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296119_776280428413708_5991003999670503936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0wPEpLN29AQ7kNvwGki10e&_nc_oc=AdrXyDANr5XIStGv7KEXwKstLrPHFZI8p9Dc7hpSeAkNDdao5hDeOgEMYC6MGE5GIOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KPLhmAVHd9nNffl0NNBsEM5BWj7pZdNzSNkzF8KXpbA&oe=69F76845"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Ladder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES",
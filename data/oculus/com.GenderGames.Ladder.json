=1-7&_nc_sid=6e7a0a&_nc_ohc=X1zZJjTYMjAQ7kNvwH9b9Vj&_nc_oc=Adr6QnrD9sqkW9DfvyUNKSGmtVtY_8O5GUxCrJGjc1ND7ZrfeY-YJpqFTPFN5x4JiKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e552RoD81Tn_5O7JL4fJ3xIRvu_6tLSc4nyp4wOidLA&oe=69FCACB0"}, {"file_name": "Meta_Screen05.png", "id": "773991915103608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_773991918436941_5200151582077370008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-PZXJBvQ1QQ7kNvwH5gkoi&_nc_oc=AdoC5-2vMu1Vfm6omqOxmwF8q041CxOLyWPgG9kep3PaLLt6zJau7eS2-GKNcQFDR5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af705zU-1WW54EZmfdZyAJbCHcfaF4td4mCB6yjK8L6sgw&oe=69FC86B0"}, {"file_name": "Meta_Screen04.png", "id": "1077797753973543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820910_1077797760640209_3953569218156840975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-uEY1XleZQQ7kNvwHKNho7&_nc_oc=Adrf6RGBmFD8QoJqoLBMJosjgC8uiYbII37AsKG3ewzevuKWh-jT54HGy4b1_iIeMpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OLH-M00OcIvi_YuO-2HXKl8Ars37IRdZwKZ2e7iS6MQ&oe=69FC8214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Screen02.png", "id": "1298225785195772", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818852_1298225788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqhnSGfj0YcQ7kNvwGZBNzq&_nc_oc=AdoBSnwH1mjRZ1GSVTjG3Bso5TldLGA5nbtKgFx6qRL8F-JulnVqhCYebhccSwyNz60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60oe6DULriFp121yxVRMMJ0dhoFqyvd7jXzei_bi5I6w&oe=69FCB114"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9756031887831809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296119_776280428413708_5991003999670503936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4yAoiD9LNIQ7kNvwHFCH0y&_nc_oc=Adpd4jH8atHfg8xvgn2Ebl-JRnLOcWYt2NNEDqCUrI1RcQRAvL-QGWT2IRZQ6lmT6pc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46SS_6fhbDoYXTcsqPCXpcvGLYJ92lMy6Ug07DEpRgeQ&oe=69FCAE45"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Ladder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES",
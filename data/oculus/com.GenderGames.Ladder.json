NOjehfXFGj4GZsgBotBlcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0Jtah07DVAaaqSm8F67HOoU7evMgsVt78KIiYQvY8ESw&oe=69F0CF30"}, {"file_name": "Meta_Screen05.png", "id": "773991915103608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_773991918436941_5200151582077370008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9Sp2-Ph38kQ7kNvwGnqjaN&_nc_oc=AdrkIuntkMFBhGwWLv9kwqm-IImIR7yprG6s3u-mIimnE9LJ9FrvKhQOA8JinPW6XcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0vyvE8OviMhGgz2zHcXGqgpdhNxVb5R8uytOBrtyL0YA&oe=69F0A930"}, {"file_name": "Meta_Screen04.png", "id": "1077797753973543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820910_1077797760640209_3953569218156840975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eywJ_fKr868Q7kNvwHiWIH6&_nc_oc=AdpbtRMF1OAxA0vNa-KwjayvYS1mbPK_xOBmWmQqIiZqQJ7YMlr0Wu2g6-YEEbrpMSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1pbV2ZfjwZdFk0OAp-vdW8rQ_edPZ9OnWUtRGLKmGzcA&oe=69F0A494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Screen02.png", "id": "1298225785195772", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818852_1298225788529105_3874422987890896234_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I2vZ_elLRYQ7kNvwFRg6ph&_nc_oc=AdoIrS9187dRkw44Oxjp6fTjS4cMf6yS09QpIhP2n4DtvjLbVO7tD4SLacsc1DSQJZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3S6OXW46Rkl5po4s89bLGkwz8eCL0mUMTBdvoytyn1fQ&oe=69F09B54"}, "display_name": "The Ladder", "keywords": [], "long_description": "An awakening in the darkness... without memory, without orientation. In a lost cyberpunk dystopia... your only discernible direction lies upward. Climb through a world completely unknown to you. Solitary subway shafts, cathedrals of mobility. Abandoned residential blocks, like silent giants. Business districts, once vibrant with life, now a ghostly silence. Bio-technological units, alien and eerie, harbor unknown dangers. Each ascent is a new challenge! Every found mechanism a potential key to progress! Find your way upward, step by step. Find out who you are and what awaits you in this merciless height.\n{1849056925652543}", "short_description": "A cyberpunk climbing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ken-cessna.de/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Gender Games", "support_website_url": "https://ken-cessna.de/contact/", "website_url": "https://ken-cessna.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9756031887831809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296119_776280428413708_5991003999670503936_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59TArmvYVGkQ7kNvwEGU73F&_nc_oc=AdpMDjtaJzk1Z_wMNdbkstvwloL-ltZUZwZ-M6VMKc-qP0-4zidyfWBYaBFkzok0bmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0pAicBYqWBQgKqjQXvBz1kU3BtupyOOuKJDetz5FEHGA&oe=69F0D0C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Ladder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date":
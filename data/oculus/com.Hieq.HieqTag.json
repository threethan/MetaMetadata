gvEM4wQ7kNvwFOlXD0&_nc_oc=AdqetNkc18jX6ACC-wvlMLwJZai0tAvJ1NgeIqYkK0lRwUTxwidR3ZKvrYuMZnZPxyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CQe1CDGU0BmWbfwVUhhOCaeznOMhZqlvvIwDXnMjImw&oe=69F20B2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Bonkers v2", "keywords": [], "long_description": "Gorilla Bonkers V2 is an advanced evolution of the Gorilla Tag movement paradigm, leveraging its unique physics-based locomotion system to traverse and interact with highly intricate, reimagined environments. These bespoke renditions of classic Gorilla Tag maps are meticulously designed to challenge players\u2019 spatial awareness, adaptability, and mastery of the game\u2019s signature hand-based propulsion mechanics. By introducing novel architectural complexities, dynamic traversal opportunities, and an enhanced sense of verticality, the game transforms the fundamental experience of movement into an intricate, skill-driven endeavor that pushes the boundaries of immersive locomotion.", "short_description": "Gorilla bonkers v2 is a game using gorilla tags unique locomtion to explore custom renditions of gorilla tag maps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://html.cafe/x36f0cea8", "developer_terms_of_service_url": null, "publisher_name": "hiequtie", "support_website_url": null, "website_url": "https://html.cafe/x0c872b69", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9425591227560468"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393965_1037630741527591_2373510114493419490_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsdHvnwO3gIQ7kNvwHKLrAM&_nc_oc=AdqHlh5oIz12nh9oBgMUHEboDmaSK3ZH_9v1pyZjGSnB7jWEMYMXXBDJDXKDI8DgK9o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3j4eW1w9AmtRzAdwY4nxoOLP7q29xrs8kuwMqSxnE9_Q&oe=69F1FDEE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Bonkers v2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1742215920, "lastRevision": {"nodes": [{"id": "9249195321866727", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9249195295200063", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "637373209002256"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Screenshot 2025-02-28 173903.png", "id": "1692646577995282", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391855_1692646581328615_3000052067382587803_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4aiFmmXzWsQ7kNvwFBwAy_&_nc_oc=Adq79x5qvPOMNoZMo8UtOwMkG8vRFs1buBwe0VQlBT3ZRc-OWVsvfYs2XTNLoNBPqRk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af054yQ2kI8sWYwOoAwIPDG5lQ_UkuFBC8cVn-CwVTZKMw&oe=69F1EE0C"}, {"file_name": "Gorilla Bonkers V2-Photoroom.png", "id": "
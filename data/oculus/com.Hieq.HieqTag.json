ity, the game transforms the fundamental experience of movement into an intricate, skill-driven endeavor that pushes the boundaries of immersive locomotion.", "short_description": "Gorilla bonkers v2 is a game using gorilla tags unique locomtion to explore custom renditions of gorilla tag maps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://html.cafe/x36f0cea8", "developer_terms_of_service_url": null, "publisher_name": "hiequtie", "support_website_url": null, "website_url": "https://html.cafe/x0c872b69", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9358103497642575"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9271033233016269", "version": "12121"}, "id": "1998831077274328", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9249195295200063", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9271033233016269"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": 
1343404533450436_9080359846175985717_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV0LcRQbmvMQ7kNvwGryyNf&_nc_oc=AdqCmqvN_iKiQGCcZNLcdaK90s-l18p3payX3c_DsQsAQ1ZmUkucS8hGb9_NdYP7wVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kVstMYrDb3Dz0wMTWfpS3kPS2V107qtlG085iPIgP4w&oe=69E38AAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Bonkers v2", "keywords": [], "long_description": "Gorilla Bonkers V2 is an advanced evolution of the Gorilla Tag movement paradigm, leveraging its unique physics-based locomotion system to traverse and interact with highly intricate, reimagined environments. These bespoke renditions of classic Gorilla Tag maps are meticulously designed to challenge players\u2019 spatial awareness, adaptability, and mastery of the game\u2019s signature hand-based propulsion mechanics. By introducing novel architectural complexities, dynamic traversal opportunities, and an enhanced sense of verticality, the game transforms the fundamental experience of movement into an intricate, skill-driven endeavor that pushes the boundaries of immersive locomotion.", "short_description": "Gorilla bonkers v2 is a game using gorilla tags unique locomtion to explore custom renditions of gorilla tag maps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://html.cafe/x36f0cea8", "developer_terms_of_service_url": null, "publisher_name": "hiequtie", "support_website_url": null, "website_url": "https://html.cafe/x0c872b69", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
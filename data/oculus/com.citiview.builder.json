png", "id": "1101328512312329", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/596068480_1101328515645662_1184069190479723207_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL3p8ayH8BIQ7kNvwExFsCP&_nc_oc=AdodkjQE57DtbxC2SUWuWxNDc69fRByLgAEvH-zz2h9Ne43Y9SBssoJ0sFZdK0t7KCc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzjfIGuBfQccXQP914M4P39mGK5uBa0_fQGa_dlGLqdQ&oe=6AF9BF7B"}]}, "id": "1432526722313610", "locale": "en_US", "screenshots": [{"file_name": "screenshot_4_2560x1440.png", "id": "2494294101080352", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595129854_2494294104413685_555423495468428771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvM0k28d4m8Q7kNvwH8ZDuP&_nc_oc=AdouZHrh-bb59DobOzOx7T_ZYoVixSU6alq3Eb5X_i4Ml4kc0EsqEnJ1xk-Av7iTzVc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRylw53cvsZG-YixYkSV9o6O58BWjkmw7ND61ziICbpzQ&oe=6AF9E5C8"}, {"file_name": "screenshot_2_2560x1440.png", "id": "2445739865952587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673558985_2445739869285920_2906248342743221184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tY2VCFgJjpwQ7kNvwHKm4sC&_nc_oc=AdrkeVkOEHjK5bSaTenZYRiCxQxK6D4VyA9c0XTbW9lFVb34LUAUJFadJPQXIRAsnFU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpSZjEMt1UTcszl67h6x3wkZ2dlgL4opurUgsWYIH2FQ&oe=6AF9CEF6"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1100905825642068", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673536876_1100905828975401_6970567505519891560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a6jjWC6qyUQ7kNvwEifFGL&_nc_oc=Ado27podskpE91DBg3AARaUFtxqoWWspST_OK5j73xLwYFHDQ_lcPynCfNg4-57nrvA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnrwFZ79cDciQfjFZonehCfwDLWalr2Gu7zOR_5MoHww&oe=6AF9E60C"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1691510721915075", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673536876_1691510725248408_5287320740908365888_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a6u4-49N9oQ7kNvwGRCQ05&_nc_oc=AdpfFrKLf77Dy3VxSVsb0GUVE0c3scGHsK5_O5FB9lrn0xU2drDJkDIglOgngIL_2D0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5BMWk1e1oLbLj7PNcTDT8r2zVGDoO90sSegWdlS54bA&oe=6AF9C279"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1067009922810987", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673751957_1067009926144320_920389752922448622_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzNfxzjWUB4Q7kNvwHOdGns&_nc_oc=AdpfApImccQE3vQiBrh0zGKWPFabcNI_2lGXBhEhbAts1GOrhWlNVqhrhcsZSD0p4mw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVE2dFU91qmzuMZD1KPBeK_37EVqzIv7-Q2T18aZqZSA&oe=6AF9D486"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1083414617431822", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831279_1083414620765155_6664790562008489060_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jkr98A-euRYQ7kNvwFCMqim&_nc_oc=Adqmn9Un0SdZmivHR8dDPiwb1MfBPq7stx0WsMgFpoz6oZTPUYm-T7OznpZhNPblVVw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1F9Zz1ODi53vAr3rBINxnV0stTQGK9D4tlN8vOXUyMQ&oe=6AF9DC15"}, "display_name": "Builder", "keywords": ["builder", "city", "trains", "racing", "sandbox"], "long_description": "You start on a plaza with three living miniatures in front of you: a town with traffic on its streets, a railway with trains running, a circuit with cars racing. Point the laser at one, pull the trigger, and you are standing in that world with a build wheel in your hand. Everything you build saves itself, and MAIN MENU brings you back to the plaza for the next one.\n\nCITY BUILDER\nFenced grassland with rolling hills all round. Sweep the laser to paint roads that work out for themselves whether they are a straight, a bend, a T or a crossroads. Homes, downtown blocks, skyscrapers, parks, lights and signs turn to face the nearest road on their own. Twelve vehicles pull away and drive your streets. People move in as you build. Switch the sky to golden hour and walk your own streets, full size.\n\nTRAINS\nA big play room with three looks: kids, modern and garden. Snap measured track together, add stations, tunnels, climbs and signals, and build trains from steam engines, diesels, trams and bullet trains. Climb aboard and drive standing up, or let the other trains run themselves and stop at the stations.\n\nRACE TRACK BUILDER\nThe Sky Garage penthouse with real cars on turntables. Snap straights, corners, hairpins, ramps and a flyover into a circuit, drop the cars on the grid and race the pack for three, five or ten laps. Best laps are kept.\n\nReady-made layouts in every world, undo, and builds that save themselves. Single player. Standing or roomscale.", "short_description": "Three complete building worlds in one game. Raise a full-size city with roads that join themselves up, homes and towers that face the street, and cars that drive it. Lay a model railway in a big play room and drive your own trains. Snap a race circuit together in the Sky Garage and race the pack round it. Pick a world from the plaza, build it, then come back for the next."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/builder/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/builder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
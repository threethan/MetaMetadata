n.com&_nc_ss=7f30f&oh=00_AQUUuzZW9vfep4l6w9i-c4gzikiWD46XC7I2D6CGqf3yaA&oe=6B0F1EF0"}, {"file_name": "rekha_screenshot_5.png", "id": "2065822477445522", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_2065822480778855_8562278708461172879_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVsC56_lWp0Q7kNvwFdjwnn&_nc_oc=AdqiXpaE0DPQ9iUU5DBrzXWSesOpKRRhFWWU61Cm5Vv_8olNDVEEBFbMMGu-zmv6580&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXYlVRIeNvHVOuvUnYPirwOcR-yBie8Ttxh5O-cNknoOg&oe=6B0F0054"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rekha: AR Tracing & Drawing", "keywords": ["rangoli", "drawing", "tracing", "mural", "chalk"], "long_description": "Free \u2022 No ads \u2022 No account \u2022 Locks to your wall \u2022 Works offline\n\nDRAW AND PAINT ON REALITY\nRekha turns your Meta Quest 3 into a tracing projector. A glowing guide appears on your real wall, floor, table or cupboard, and you follow it with real chalk, pencil, brush or paint. The guide is virtual \u2013 the art you make is real.\n\nWHAT YOU CAN MAKE\n\u2022 Wall murals and wall paintings at any size\n\u2022 Sketches and drawings \u2013 learn to draw by tracing\n\u2022 Rangoli, kolam and chalk floor art\n\u2022 Lettering, signs, stencils and kids' room art\n\u2022 Your own photos, turned into clean outlines\n\nHOW IT WORKS\n1. Pick a design from the Beginner, Intermediate and Advanced gallery, or import your own image.\n2. Point and pinch to place it on any surface \u2013 Rekha finds walls, floors and furniture.\n3. Lock it. The guide stays fixed to the surface while you walk around a big wall or floor.\n4. Trace with real materials, then hide the guide to check your work.\n\nFEATURES\n\u2022 Room-locked placement that stays put while you move\n\u2022 Hand tracking with a palm menu, or Touch controllers\n\u2022 Photo-to-sketch conversion (Bold, Medium, Fine)\n\u2022 Grid overlay for the classic grid drawing method\n\u2022 6 line colours, opacity, mirror, flip and 3-point calibration\n\u2022 Step-by-step Getting started guide on your first launch\n\u2022 \"Back to locked spot\" \u2013 continue a half-finished painting the next day\n\nFREE AND PRIVATE\nNo ads, no account, no subscription. Works offline; your images never leave your headset.\n\nWebsite: https://rekha.lovneo.com", "short_description": "Free \u2022 No ads \u2022 Locks to your wall \u2022 Use your own photos\nTrace any drawing, painting or sketch onto your real wall or floor \u2013 then paint it with real brushes, chalk or pencil. Rekha is a free mixed-reality tracing app for Meta Quest 3: pick a design or your own photo, lock it to the surface and create real murals, wall art, rangoli and sketches. No ads, no account, works offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rekha.lovneo.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "LOVNEO", "support_website_url": "https://rekha.lovneo.com/support.html", "website_url": "https://rekha.lovneo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1550382108147625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839671_2757864687981443_72831786971511742_n.png?stp=dst-png_s360x360&_nc
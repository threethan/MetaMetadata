, {"file_name": "rekha_icon_512.png", "id": "1066538753058561", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628449_1066538756391894_2984936769591031699_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmykHMtCXMYQ7kNvwGfu73t&_nc_oc=AdpnWHJ2iYjm4zYwK6Sw1YsCfE0ooG6dPfl1BcSDcfBtXIhnhdXxYXgssw7pd19nKpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnT3DI3-8ZlihO4kcJgP7ym-Sr127xnljnk7Gt_JVXnw&oe=6B05D05D"}]}, "id": "3716302258523627", "locale": "en_US", "screenshots": [{"file_name": "rekha_screenshot_1.png", "id": "1789031885647231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619369_1789031888980564_3857230338982669639_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7WcowjAbmwQ7kNvwFxdqS0&_nc_oc=AdpVYnhKYFsHu7cxq2i-O_nT2CkNOgmkObNLLAVaX42zplWRn3E-Ra0k4Z0JyEonVwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr2jgIYf6DdopwyA43AzrkPpxJFSw_MjTCRoWcLATSWA&oe=6B05B642"}, {"file_name": "rekha_screenshot_2.png", "id": "2401650080644543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619374_2401650083977876_6949916971465054027_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNTJW_IbR8sQ7kNvwFpAfL5&_nc_oc=AdoyJDAq4W4Tb-64leSXyVP0_yIdf5QR8jIVbwQ230NiLlgEQxRGc9Ae-yCHwgrLhDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn6xr4pZYddXN3-0sLbPqPuOFx_4h9T7ZB0ap2xHNcEw&oe=6B05B751"}, {"file_name": "rekha_screenshot_3.png", "id": "29022569067363740", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620666_29022569094030404_3698964816103530403_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kikTrt2zOwQ7kNvwH-HmYj&_nc_oc=AdrYv8hYXsErdBDTUEjkS4w1AgdbnyG-Qgdt12F-XbtG8oiqPEc-yHiJF944vKEkXgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcPydl4lafr2oHUazOM3dUqYQi6GXQRpaxLw4hDwhwNQ&oe=6B05D667"}, {"file_name": "rekha_screenshot_4.png", "id": "4559346754395116", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628092_4559346757728449_8030282916042492529_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VelhquNwq4UQ7kNvwGJyp84&_nc_oc=AdqHqx9qjeajx-tX_qSItVT6GdKD2C7G5I9IWTU2Y9pV4qTUPoO2fjr9NbvPJL_zmPw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1rDK-vOUSuXw86ebLOUH0ucan9GSzgYY7keCrjSHKYA&oe=6B05AC30"}, {"file_name": "rekha_screenshot_5.png", "id": "2065822477445522", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_2065822480778855_8562278708461172879_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWk0FG-0g2YQ7kNvwGvaC7F&_nc_oc=AdrIq1U1XYSMiyILRQKu3BJjUghTL3IXcyN7hRbm196nAfsvzHjLZFkVxhubyHUxoS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1EAk_9vERfRtDAaPsECFVsa83azRorK3AiuM9tMraMA&oe=6B05C5D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rekha", "keywords": ["rangoli", "drawing", "tracing", "mural", "chalk"], "long_description": "Rekha \u2013 Draw on reality.\n\nRekha turns your Meta Quest 3 into a tracing projector. A glowing guide appears on your real wall or floor, and you follow it with real chalk, pencil, brush or paint. The guide is virtual \u2013 the art you make is real.\n\nHOW IT WORKS\n1. Pick a design from the built-in gallery (Beginner, Intermediate, Advanced) or import your own image from your Meta Quest headset.\n2. Place it on any wall, floor or table. Point and pinch to move it, drag the corners to resize, and rotate with a snap to 90\u00b0.\n3. Lock it. The guide stays fixed to your room while you draw.\n4. Trace with real chalk or pencil, then hide the guide to check your work.\n\nFEATURES\n\u2022 Mixed-reality passthrough with room-anchored placement\n\u2022 Hand tracking: palm menu, finger taps and pinch-to-drag, or use controllers\n\u2022 Optional photo-to-sketch: turn any photo into clean outlines (Bold, Medium, Fine)\n\u2022 Grid overlay (3\u00d73, 6\u00d76, 10\u00d710) for the classic grid drawing method\n\u2022 Opacity, line colour, mirror and flip\n\u2022 Precise 3-point calibration with tape marks\n\u2022 Dark, Light and Midnight themes, click sounds and haptics you can customise\n\nPerfect for rangoli and kolam, wall murals, chalk art, signs and drawing practice.\n\nFREE AND PRIVATE\nNo ads, no account and no subscription. Rekha works offline and your images never leave your headset.", "short_description": "Trace any design onto your real walls and floors. Pick a drawing or import a photo, place it on any surface in mixed reality, lock it in place and trace it with real chalk, pencil or paint. Free, offline and built for your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://reachlovneo.github.io/rekha/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "LOVNEO", "support_website_url": "https://reachlovneo.github.io/rekha/support.html", "website_url": "https://reachlovneo.github.io/rekha/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1525404073978762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626728_2478247889369672_655820188785508964_n.png?stp=dst-png_s360x360&_n
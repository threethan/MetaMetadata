5528770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_766850238862103_5229660708327826108_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbYIkw0GIfwQ7kNvwFI45Vi&_nc_oc=AdryPXlbbCD1yKCHprs-DFsmY9-ZdJozH3_UBISohM7g74ETSKD7ruCowGpatz6_fbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFu_MLiwq1VHWagQr3mUmx4Gapj1YtN7m5sQBNgaUnxg&oe=69C90799"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forsaken Innovation", "keywords": [], "long_description": "Forsaken Innovation plunges players into the heart of darkness\u2014an abandoned research facility where shadows writhe and secrets fester. As you step through the decaying corridors, the flickering light reveals claw marks etched into the walls, a testament to the horrors that once unfolded here. Each step echoes with dread, and the distant glow at the end of the hallway beckons like a false promise. You\u2019re not alone; unseen creatures skitter in the darkness, their presence palpable. Survival demands more than courage\u2014it demands innovation. Will you uncover the facility\u2019s twisted past, or become another forgotten soul lost in its malevolent embrace?", "short_description": "Welcome to Vortex Labs your service here will be to test new technologies to be released to the public the rest will be (REDACTED)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nextchase/privacypolicy?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "PrismDev", "support_website_url": null, "website_url": "https://sites.google.com/view/nextchase/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEME
ls claw marks etched into the walls, a testament to the horrors that once unfolded here. Each step echoes with dread, and the distant glow at the end of the hallway beckons like a false promise. You\u2019re not alone; unseen creatures skitter in the darkness, their presence palpable. Survival demands more than courage\u2014it demands innovation. Will you uncover the facility\u2019s twisted past, or become another forgotten soul lost in its malevolent embrace?", "short_description": "Welcome to Vortex Labs your service here will be to test new technologies to be released to the public the rest will be (REDACTED)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nextchase/privacypolicy?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "PrismDev", "support_website_url": null, "website_url": "https://sites.google.com/view/nextchase/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "8731351636910724"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974907_921250542737890_7599138907565056258_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LdpF0cfZDoQ7kNvwFJevcQ&_nc_oc=Adp9s1aXRbP1VCOGbAfzCwOSnb1Z_HF5AVPGuDv-LloLjATnsJG_FZn0pk3aBjr44co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aw8A-n_Ilf5j
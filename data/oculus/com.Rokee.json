9280917368698_1555660852804455312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-MTzfwW2doQ7kNvwH1awU3&_nc_oc=Adogd6HUGllkD6enK5Rv0auR08dDzc7j-p_A1lpDRG9zW2mu4-qFDSHkko97QBRWDFw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK0fetTCshxs1YJMafKPbVKGch_RJYqol2SmHajxfrBQ&oe=6A882EFD"}, "display_name": "Rokee", "keywords": [], "long_description": "Rokee is a multiplayer VR game designed and developed to help people make friends, have fun, and compete in challenges. Overall, Rokee is amazing and quite fun. The Beta Testers including myself, really enjoyed playing the game. I hope you will too. Rokee uses Meta's processing unit to process payments and security issues. Rokee is a verified and managed VR Game issued by Meta. The Owner of this VR Game is Former YouTuber, VORSHADOW.", "short_description": "Rokee is a multiplayer VR game designed and developed to help people make friends, have fun, and compete in challenges. Overall, Rokee is amazing and quite fun. The Beta Testers including myself, really enjoyed playing the game. I hope you will too."}]}, "developer_name": "VORSHADOW", "developer_privacy_policy_url": "https://docs.google.com/document/d/1uApvFCq8WOFh2ayHa4ixXVpLLRMgwnuOzNu__CjAe_8/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Bn1kI0cN6CIzuqEYfCScyjsTB0_nMuckuMyn6zRHxK8/edit?usp=sharing", "publisher_name": "VORSHADOW", "support_website_url": "https://docs.google.com/document/d/1Td8YxFldGNUcpSyVk2DJwnYgffwj7NpL5-e-CeCbbB0/edit?usp=sharing", "website_url": "https://sites.google.com/view/rokee/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
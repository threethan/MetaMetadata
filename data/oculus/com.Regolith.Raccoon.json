 or want a new hat? tell us in the discord: https://discord.gg/HfDbNKqq5H", "short_description": "you're a raccoon. climb everything, chase your friends, and spend way too much on hats. free to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/pixellandslide/home", "developer_terms_of_service_url": "https://sites.google.com/view/pixellandslide/home", "publisher_name": "Pixel Landslide", "support_website_url": null, "website_url": "https://sites.google.com/view/pixellandslide/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1811395953443383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623585_1493013456066648_5460404173443265506_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWxhRKqkggsQ7kNvwFdkEaa&_nc_oc=AdrrLq9fKXpf0f5_B0jfX_aW5KKxZ9SQef_n0j4RR4Wz6GLXZBCUz0exkyZHbLPV2iI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYBNMAtUJB7kocE9STcCnWIJ9K3RCzhkPA9MFCwE2OtQ&oe=6B0DA6E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Raccoon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "4597
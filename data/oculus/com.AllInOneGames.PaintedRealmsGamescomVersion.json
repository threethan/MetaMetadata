com/v/t64.5771-25/499618252_24941930315501166_5630600238007271378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4I_Mt8JSoEQ7kNvwFul3M_&_nc_oc=AdpkLjlxivxIaNRz9HcGPvSbcW8Le0AWZ_Qsv7sux3sklzShk_EWwxcOCklw64IOj_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRGVEnbAp2SscQ6aZFuOryLtat3wBM6Q6XlBFH0QLAbA&oe=6AEB44F0"}, {"file_name": "4.png", "id": "1164452051868170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1164452058534836_8680613022875370471_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQbM7h7ek_IQ7kNvwHgV6Kx&_nc_oc=AdpeuyUZjlMeqdZV5m4njaTYpeQ_lZk2Qz_gmslajtbUn7QBaCG2FF0YLVQDbvzCaxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcY-SMqOW4nriCBP_izlrtG1eOMo43OfjbtZYwVzbZGw&oe=6AEB2F6D"}, {"file_name": "5.png", "id": "835846522507208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618039_835846525840541_3349035754661619138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCS038qBZMsQ7kNvwGC-MzZ&_nc_oc=AdoiWDctHGzUXC_F3IZGjoknMkLw0L579Kbwtwnydzp9R-o5MZCAsxJYeJ6XDbN7xAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBk6GUCboq7PdLSBZ2RX4_lwkBCuGuNhImCv4mI7D5aw&oe=6AEB544F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PaintedRealms_CoverImageLandscape.png", "id": "1242734424538306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1242734427871639_7320096193581072004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5880UdPMaQQ7kNvwEDdvKq&_nc_oc=Adr5eQS21d0i20nZ9h4O299A8dY15pfW1-0x6tSjTHJ44Ztxh6KBBajStVNEscimyy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdSnoeaARMO2vjuXUwATPKqOQU5e5nRpNKbRN86r6SKQ&oe=6AEB50F3"}, "display_name": "Painted Realms Demo", "keywords": ["cozy", "painting", "wholesome", "art", "sandbox"], "long_description": "\ud83d\udc7e Join us on **Discord**: https://discord.gg/dH8uKv7tm7 \ud83d\udc7e\n\n# Join the Restorers !\n\nIn the magical Coquelicot Museum, paintings are portals towards living worlds ! Play as an art restorer and use your brushes to save the painted realms from a mysterious Eraser Artist. **This is a demo version.**\n\n**Immersive art** - Rediscover the most famous paintings as immersive 3D worlds\n{2020461498710789}\n\n**Restoration** - Find the differences between the flat originals and the immersive paintings and paint everything back to normal\n{854306483740831}\n\n**Creative freedom** - Help the visitors of the museum with creative quests and wake up your inner artist\n{1376429067462623}\n\n**Sandbox** - Customize the museum with fun and easy to use art tools, such as the magical brush that turns 2D drawings into 3D objects !\n{1562077004939594}\n\n\n# Demo vs. Full Game\n\nThis demo version is a short, first-taste of the complete game. Here what you can expect from the full game :\n\n**More content** - The full game will be a 2-hour long adventure : explore multiple museum galleries and immersive paintings ; meet new inhabitants of the painted realms and complete a lot of creative quests.\n\n**A complete story** - Try to find out who the Eraser Artist is and unravel a story about creativity & self-confidence.\n\n**More creative tools** - Expect fancier brushes & a color-swap gun. It'll be easier and funnier to customize your museum and to do the creative side quests.\n\nJoin us on Discord : https://discord.gg/dH8uKv7tm7", "short_description": "Play as an art restorer. Step inside famous paintings, turn drawings into 3D objects and save the museum from a mysterious Eraser Artist !\n\n*This is a demo version* "}]}, "developer_name": "wondie games", "developer_privacy_policy_url": "https://wondiegames.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AIO Games", "support_website_url": null, "website_url": "https://paintedrealmsgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37169131676068735"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623314_978556888277912_6644834485475586395_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axdEwji-SMoQ7kNvwEunjog&_nc_oc=Adq0AeCyJTBJWvvF--gh54ypS2w2MniW4QLy1KMwTD5Oz67IdUs6hhFnabans8gJD0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNKgAeteW1nA0J1S44ygYmlwyV59CwuoP3_RhfAL6X3w&oe=6AEB600A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Painted Realms Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1772283600, "lastRevision": {"nodes": [{"id": "31389821330666494", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "31389821173999843", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1571375114279987"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1483104849438007", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painted Realms (DEMO)", "keywords": ["aventure", "peinture", "sandbox", "cozy", "mignon"], "long_description": "# Rejoignez les Restaurateurs !\n\nDans le mus\u00e9e magique \"Les Coquelicots\", les peintures sont des portails vers des mondes vivants ! Incarnez une restauratrice d'art et utilisez vos pinceaux pour sauver les peintures d'un myst\u00e9rieux Effaceur.\n\n**Art immersif** - Red\u00e9couvrez des \u0153uvres c\u00e9l\u00e8bres transpos\u00e9es en environnements 3D immersifs\n{1671391980485996}\n\n**Restauration** - Trouvez les diff\u00e9rences entre les originaux (2D) et les tableaux immersifs (3D) et redessinez ce qui a \u00e9t\u00e9 effac\u00e9.\n{1100400108837436}\n\n**Libert\u00e9 cr\u00e9ative** - Aidez les visiteurs du mus\u00e9e en compl\u00e9tant des qu\u00eates cr\u00e9atives. R\u00e9veillez l'artiste qui sommeille en vous !\n{1557564002151951}\n\n**Sandbox** - Customisez le mus\u00e9e \u00e0 l'aide d'outils fun et faciles \u00e0 prendre en main, comme le pinceau magique qui transforme les dessins 2D en objets 3D !\n{2292515427851520}\n\n\n# Demo vs. Jeu Complet\n\nCette d\u00e9mo est un avant-go\u00fbt du jeu complet en cours de cr\u00e9ation. Voici un aper\u00e7u de ce qui vous attend dans le jeu final :\n\n**+ de contenu** : Une aventure de 5 heures avec plusieurs galeries \u00e0 explorer, plus de tableaux \u00e0 restaurer et de nouveaux visiteurs \u00e0 rencontrer et \u00e0 aider.\n\n**Mode multi** : Invitez vos amis dans votre mus\u00e9e, montrez-leur vos cr\u00e9ations et peignez ensemble ! Partagez votre art facilement sur les r\u00e9seaux.\n\n**+ d'outils cr\u00e9atifs** : Plus de pinceaux, un pistolet \u00e0 couleurs, une machine \u00e0 dessin magique... Ce sera encore plus facile et amusant de personnaliser votre mus\u00e9e et de compl\u00e9ter les side quests artistiques.\n\nRejoignez-nous sur Discord : https://discord.gg/dH8uKv7tm7", "short_description": "Incarnez une restauratrice d'art au mus\u00e9e Coquelicot. Dans ce mus\u00e9e magique, vous avez le pouvoir d'entrer \u00e0 l'int\u00e9rieur des peintures ! Sauvez les tableaux c\u00e9l\u00e8bres des coups de gomme du myst\u00e9rieux Effaceur..."}, {"images": {"nodes": [{"file_name": "PaintedRealms_CoverImageLandscape.png", "id": "1875270090084793", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1875270093418126_4929975559813552448_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9BbukP07n8Q7kNvwHQagnk&_nc_oc=AdqWXjmCmLkh9lbDShAQKvz2OpW4s4ZIetXNIK9sCKRwe1Z4BUfOoOVaCbBjypJWyiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkFNnk3rnG9O8ecID07DVXAxeQOFdvVSOsfEBPS4_o4w&oe=6AEB532D"}, {"file_name": "PaintedRealmsLogo_TransparentBg.png", "id": "1501013481175421", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618910_1501013484508754_2505749268124110971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=971N9Z4QpcEQ7kNvwHMOeaD&_nc_oc=AdpwtNWt2ve3fb2K33Zc2mM-k_1FQgNvi7izy4UdsxypG7-fcZ5K2txBiGT8SRxaqy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCsinT8hCsozbm4BNd35O8YNLZV7ird-f84Rg9SO0PEA&oe=6AEB4E47"}, {"file_name": "PaintedRealms_CoverImageHero.png", "id": "1318867373312922", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619113_1318867383312921_6482859639422436600_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcOxUfXCjxQQ7kNvwH-UOBT&_nc_oc=AdpJYwejNRfgMClqFAfdIxbY1U5VQB9QTsv0y3wFDakC7uWvTwsDxSOqVBBzsyOmo44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL1xwxLr4AkqxMlhTAf39bw0sgcZIAoP2Mxqj330mj3A&oe=6AEB3926"}, {"file_name": "PaintedRealms_CoverImagePortrait.png", "id": "1197855208861470", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1197855212194803_2663272450921361275_n.png?
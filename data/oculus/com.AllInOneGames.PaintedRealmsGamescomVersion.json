VAgWcfe30aTOPIQfLwIxTunT0tf1kaDk_t1gKd8UYmu0NuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNAL6uUXMsIMt_dcOtI2ivhvudArgVeuYytMEp9crJDg&oe=6AEB4E81"}, {"file_name": "3.png", "id": "24941930302167834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618252_24941930315501166_5630600238007271378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4I_Mt8JSoEQ7kNvwFul3M_&_nc_oc=AdpkLjlxivxIaNRz9HcGPvSbcW8Le0AWZ_Qsv7sux3sklzShk_EWwxcOCklw64IOj_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRGVEnbAp2SscQ6aZFuOryLtat3wBM6Q6XlBFH0QLAbA&oe=6AEB44F0"}, {"file_name": "4.png", "id": "1164452051868170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1164452058534836_8680613022875370471_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQbM7h7ek_IQ7kNvwHgV6Kx&_nc_oc=AdpeuyUZjlMeqdZV5m4njaTYpeQ_lZk2Qz_gmslajtbUn7QBaCG2FF0YLVQDbvzCaxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcY-SMqOW4nriCBP_izlrtG1eOMo43OfjbtZYwVzbZGw&oe=6AEB2F6D"}, {"file_name": "5.png", "id": "835846522507208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618039_835846525840541_3349035754661619138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCS038qBZMsQ7kNvwGC-MzZ&_nc_oc=AdoiWDctHGzUXC_F3IZGjoknMkLw0L579Kbwtwnydzp9R-o5MZCAsxJYeJ6XDbN7xAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBk6GUCboq7PdLSBZ2RX4_lwkBCuGuNhImCv4mI7D5aw&oe=6AEB544F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PaintedRealms_CoverImageLandscape.png", "id": "1242734424538306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1242734427871639_7320096193581072004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5880UdPMaQQ7kNvwEDdvKq&_nc_oc=Adr5eQS21d0i20nZ9h4O299A8dY15pfW1-0x6tSjTHJ44Ztxh6KBBajStVNEscimyy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdSnoeaARMO2vjuXUwATPKqOQU5e5nRpNKbRN86r6SKQ&oe=6AEB50F3"}, "display_name": "Painted Realms (DEMO)", "keywords": ["cozy", "painting", "wholesome", "art", "sandbox"], "long_description": "# Join the Restorers !\n\nIn the magical Coquelicot Museum, paintings are portals towards living worlds ! Play as an art restorer and use your brushes to save the painted realms from a mysterious Eraser Artist.\n\n**Immersive art** - Rediscover the most famous paintings as immersive 3D worlds\n{2020461498710789}\n\n**Restoration** - Find the differences between the flat originals and the immersive paintings and paint everything back to normal\n{854306483740831}\n\n**Creative freedom** - Help the visitors of the museum with creative quests and wake up your inner artist\n{1376429067462623}\n\n**Sandbox** - Customize the museum with fun and easy to use art tools, such as the magical brush that turns 2D drawings into 3D objects !\n{1562077004939594}\n\n\n# Demo vs. Full Game\n\nThis demo version is a short, first-taste of the complete game. Here what you can expect from the full game :\n\n**More content** - The full game will be a 5-hour long adventure : explore multiple museum galleries and immersive paintings ; meet new inhabitants of the painted realms and complete dozens of creative quests.\n\n**New Social mode** - Invite your friends in your museum with the multiplayer mode, show your art and paint together ! Share your creations easily with social media integrations.\n\n**More creative tools** - More fancy brushes, a color-swap gun, a magic drawing machine... It'll be easier and funnier to customize your museum and to do the creative side quests.\n\n\nJoin us on Discord : https://discord.gg/dH8uKv7tm7\n\n", "short_description": "Play as an art restorer in the magical Coquelicot Museum. Step inside famous paintings and save them from a mysterious Eraser Artist..."}]}, "developer_name": "wondie games", "developer_privacy_policy_url": "https://wondiegames.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AIO Games", "support_webs
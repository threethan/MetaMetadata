E_YaRAbvgYxuAp1TWzFHV1s6k5LX2eTZc22djtbl8TOIBxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXqwoilZ7NP2d9fHMZAuJgtSx-fY6UXGfbzz4cLDTlsw&oe=6A75F901"}, {"file_name": "3.png", "id": "24941930302167834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618252_24941930315501166_5630600238007271378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X9qkdmsUEQQ7kNvwGJxQY-&_nc_oc=AdqvXmbZIuEZDUNPeXEhPIeLAQDbIig7fDSMuDmGXnd51v43cMS4hYaJuCZ8UrcCDks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvuBBCacvmOnS6xl7fDPrQ7mGui2IXRIHrt7w1VmjD5A&oe=6A75EF70"}, {"file_name": "4.png", "id": "1164452051868170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1164452058534836_8680613022875370471_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ehswo3qrqm4Q7kNvwExMIbZ&_nc_oc=Ado7GTkyokgkwrUgWACmWjfBf_gsqat2e0-R6EUwDFnH2yMtctnpdAAEeAwHdbLrPoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlIHuaWk8G6tGuQtC7KuAGVr1SpFe2WYlsUCdzN-_7pA&oe=6A75D9ED"}, {"file_name": "5.png", "id": "835846522507208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618039_835846525840541_3349035754661619138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JztyP6Laae8Q7kNvwHurVSM&_nc_oc=AdqWTyF5RAkuhjlx8GjAT_Z26KDh5rumAequaqaab9iGYuvUebtSstt5bTnjCG7Dxg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE441z7h2Fknh2_PahUIrPkpOkg42jbNZQs4SpLOkya_A&oe=6A75C68F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PaintedRealms_CoverImageLandscape.png", "id": "1242734424538306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1242734427871639_7320096193581072004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAjEyG7wcNAQ7kNvwGxGjNA&_nc_oc=AdpoWWWkUBfABdUCxCpRtvbJc93RY6doL5de3XHCOROK07ENzD0k8jzucrR5BvYjAaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKxrgbr1dhNFJa2Vw9KlJ4ax55S1-yWS8as5zqngeL2w&oe=6A75C333"}, "display_name": "Painted Realms (DEMO)", "keywords": ["cozy", "painting", "wholesome", "art", "sandbox"], "long_description": "# Join the Restorers !\n\nIn the magical Coquelicot Museum, paintings are portals towards living worlds ! Play as an art restorer and use your brushes to save the painted realms from a mysterious Eraser Artist.\n\n**Immersive art** - Rediscover the most famous paintings as immersive 3D worlds\n{2020461498710789}\n\n**Restoration** - Find the differences between the flat originals and the immersive paintings and paint everything back to normal\n{854306483740831}\n\n**Creative freedom** - Help the visitors of the museum with creative quests and wake up your inner artist\n{1376429067462623}\n\n**Sandbox** - Customize the museum with fun and easy to use art tools, such as the magical brush that turns 2D drawings into 3D objects !\n{1562077004939594}\n\n\n# Demo vs. Full Game\n\nThis demo version is a short, first-taste of the complete game. Here what you can expect from the full game :\n\n**More content** - The full game will be a 5-hour long adventure : explore multiple museum galleries and immersive paintings ; meet new inhabitants of the painted realms and complete dozens of creative quests.\n\n**New Social mode** - Invite your friends in your museum with the multiplayer mode, show your art and paint together ! Share your creations easily with social media integrations.\n\n**More creative tools** - More fancy brushes, a color-swap gun, a magic drawing machine... It'll be easier and funnier to customize your museum and to do the creative side quests.\n\n\nJoin us on Discord : https://discord.gg/dH8uKv7tm7\n\n", "short_description": "Play as an art restorer in the magical Coquelicot Museum. Step inside famous paintings and save them from a mysterious Eraser Artist..."}]}, "developer_name": "wondie games", "developer_privacy_policy_url": "https://wondiegames.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AIO Games", "support_webs
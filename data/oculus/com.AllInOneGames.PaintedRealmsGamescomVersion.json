n3q6Vus5hENgF2EwfevrVrZVwyguPaY9Up3v4ot-cRcu530&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsK_F-YizhYtEr5NLdUXYYfRiPh2liUJ3sXI3_8uY70A&oe=6ABA8701"}, {"file_name": "3.png", "id": "24941930302167834", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618252_24941930315501166_5630600238007271378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKSXCLz_qnkQ7kNvwGHKHbN&_nc_oc=AdqjFEpSpv6sDD4Pc_38WMfxN6F97ChelhpedSB5Jihg5khB6ln2cY0urIk0k0ZI1oY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg1vBXNlySYLS3jVQw_3Qoxmc_f99pIalRa00exmsEUg&oe=6ABA7D70"}, {"file_name": "4.png", "id": "1164452051868170", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619751_1164452058534836_8680613022875370471_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSuocdKi2YcQ7kNvwHopL7v&_nc_oc=AdoqDV5nxUoQfNJKw7JuOYmHUBoJP6v7aHpli28qZYYWubHp1_QZaZZiFbVDxxnB1z8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB9gWMqXZsvjs-299OkKQynt1kjNzGk3SqTCs4jFI1BQ&oe=6ABA67ED"}, {"file_name": "5.png", "id": "835846522507208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618039_835846525840541_3349035754661619138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSLIlsk90H0Q7kNvwELbsoW&_nc_oc=Ado16SAbGw1ik7lvyjGDSBT2t-EinzNzZSJWJFG7hP7hb1b9wWQTFbx4si-rdnVJLJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-LVZkS0CJ7dtBbvnuof83vW0VihRhlMHUrVdQDOUFBQ&oe=6ABA8CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PaintedRealms_CoverImageLandscape.png", "id": "1242734424538306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1242734427871639_7320096193581072004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZa4dLHCBv4Q7kNvwEH6NF1&_nc_oc=Ado_1pqLZ8y9s4ZjN5RbrpkBBT5HJCvyoCxkSX4I12LqZEdQ5fZEVMAQqbZCYQarMA4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv00jSsscob_sAacP_wn97GGwf8eI5LNkVPb6eh3VG9Q&oe=6ABA8973"}, "display_name": "Painted Realms (DEMO)", "keywords": ["cozy", "painting", "wholesome", "art", "sandbox"], "long_description": "# Join the Restorers !\n\nIn the magical Coquelicot Museum, paintings are portals towards living worlds ! Play as an art restorer and use your brushes to save the painted realms from a mysterious Eraser Artist.\n\n**Immersive art** - Rediscover the most famous paintings as immersive 3D worlds\n{2020461498710789}\n\n**Restoration** - Find the differences between the flat originals and the immersive paintings and paint everything back to normal\n{854306483740831}\n\n**Creative freedom** - Help the visitors of the museum with creative quests and wake up your inner artist\n{1376429067462623}\n\n**Sandbox** - Customize the museum with fun and easy to use art tools, such as the magical brush that turns 2D drawings into 3D objects !\n{1562077004939594}\n\n\n# Demo vs. Full Game\n\nThis demo version is a short, first-taste of the complete game. Here what you can expect from the full game :\n\n**More content** - The full game will be a 5-hour long adventure : explore multiple museum galleries and immersive paintings ; meet new inhabitants of the painted realms and complete dozens of creative quests.\n\n**New Social mode** - Invite your friends in your museum with the multiplayer mode, show your art and paint together ! Share your creations easily with social media integrations.\n\n**More creative tools** - More fancy brushes, a color-swap gun, a magic drawing machine... It'll be easier and funnier to customize your museum and to do the creative side quests.\n\n\nJoin us on Discord : https://discord.gg/dH8uKv7tm7\n\n", "short_description": "Play as an art restorer in the magical Coquelicot Museum. Step inside famous paintings and save them from a mysterious Eraser Artist..."}]}, "developer_name": "wondie games", "developer_privacy_policy_url": "https://wondiegames.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AIO Games", "support_webs
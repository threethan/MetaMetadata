.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApC0xidgaUMC2wVPsq6WPBTMTGPDNzYtD6GCJIXsgDUg&oe=6A67460F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PaintedRealms_CoverImageLandscape.png", "id": "1242734424538306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1242734427871639_7320096193581072004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99_b1_MC9eMQ7kNvwHtXCrO&_nc_oc=AdpOreA2fMy24_tsZ8uj43DGDNXWlxsZW2W5hdvQOkwKXQuNCc_8sdVQ_mjpGWQChg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDER-oyrjg4xy0IpdsNUHadFqLO5Y50xOfvV54j_Qfgew&oe=6A6742B3"}, "display_name": "Painted Realms (DEMO)", "keywords": ["cozy", "painting", "wholesome", "art", "sandbox"], "long_description": "# Join the Restorers !\n\nIn the magical Coquelicot Museum, paintings are portals towards living worlds ! Play as an art restorer and use your brushes to save the painted realms from a mysterious Eraser Artist.\n\n**Immersive art** - Rediscover the most famous paintings as immersive 3D worlds\n{2020461498710789}\n\n**Restoration** - Find the differences between the flat originals and the immersive paintings and paint everything back to normal\n{854306483740831}\n\n**Creative freedom** - Help the visitors of the museum with creative quests and wake up your inner artist\n{1376429067462623}\n\n**Sandbox** - Customize the museum with fun and easy to use art tools, such as the magical brush that turns 2D drawings into 3D objects !\n{1562077004939594}\n\n\n# Demo vs. Full Game\n\nThis demo version is a short, first-taste of the complete game. Here what you can expect from the full game :\n\n**More content** - The full game will be a 5-hour long adventure : explore multiple museum galleries and immersive paintings ; meet new inhabitants of the painted realms and complete dozens of creative quests.\n\n**New Social mode** - Invite your friends in your museum with the multiplayer mode, show your art and paint together ! Share your creations easily with social media integrations.\n\n**More creative tools** - More fancy brushes, a color-swap gun, a magic drawing machine... It'll be easier and funnier to customize your museum and to do the creative side quests.\n\n\nJoin us on Discord : https://discord.gg/dH8uKv7tm7\n\n", "short_description": "Play as an art restorer in the magical Coquelicot Museum. Step inside famous paintings and save them from a mysterious Eraser Artist..."}]}, "developer_name": "wondie games", "developer_privacy_policy_url": "https://wondiegames.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AIO Games", "support_website_url": null, "website_url": "https://wondiegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32482162851432331"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2414243549015497"}]}, "baseline_offer": {"id": "2414243549015497"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772283600, "status": "PUBLISHED", "id": "2414243549015497"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34706874115627849", "version": "0.3.3"}, "id": "1102733285398659", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": 
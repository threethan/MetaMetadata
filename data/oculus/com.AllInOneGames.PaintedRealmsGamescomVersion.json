wpF71xyIvTf119MEWwkIl85QASMDpe8gIQnKr1otG12Mfc4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtPelAcgE5L1S76dRxcPktPxi_fnIakXTOyuaXp0feOQ&oe=6AE36581"}, {"file_name": "3.png", "id": "24941930302167834", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618252_24941930315501166_5630600238007271378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iq9ZODAVXKYQ7kNvwFbt8DN&_nc_oc=Adpq5H5qRtQpf7j5aq7PGwffIzCpnEkcgmrovQN2fw7cnqYrNvk8niH12exrvU59_8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMY0_Oh92ScZ0QCERaaLwv5sjiHlkTAL9Y7C4uuNl5cvA&oe=6AE35BF0"}, {"file_name": "4.png", "id": "1164452051868170", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619751_1164452058534836_8680613022875370471_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdiLgC7otJ4Q7kNvwEBh_qP&_nc_oc=AdrqUh0aECoxhVITLl64W3h8FzFKYxtzDkU8gB_cnWg5baBU1ecqc2af0MDSSjMg9E0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNct-YWFuw3aI6TiJ-cgXyGaBGnqW2eo84jy0zT4GMNHg&oe=6AE3466D"}, {"file_name": "5.png", "id": "835846522507208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618039_835846525840541_3349035754661619138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gs7Q8ZTj7tAQ7kNvwF5z0S7&_nc_oc=Adrtbbamvz6Uayp_n8xf7aH1XZpleWMYY-YoCMCM2_cCLbzLVqZ1PR1eQ4_3z54VZDw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhtPnwgvAzKt1O5UXSsNsfmfBt-afcrJaA9n2dXwu8_A&oe=6AE36B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PaintedRealms_CoverImageLandscape.png", "id": "1242734424538306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618472_1242734427871639_7320096193581072004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coEMB7aIkk8Q7kNvwGkSeD_&_nc_oc=AdpPEojuvbY9FzOJ4JaWYsgQV8uHmdmSw69i5CqPZs31zoTUB1SCK1jMpuIU6ddsJZY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFc_2KLuEcfzEVjhZEv56hVJSVdoCmSPjXXv-Cva-AnA&oe=6AE367F3"}, "display_name": "Painted Realms (DEMO)", "keywords": ["cozy", "painting", "wholesome", "art", "sandbox"], "long_description": "# Join the Restorers !\n\nIn the magical Coquelicot Museum, paintings are portals towards living worlds ! Play as an art restorer and use your brushes to save the painted realms from a mysterious Eraser Artist.\n\n**Immersive art** - Rediscover the most famous paintings as immersive 3D worlds\n{2020461498710789}\n\n**Restoration** - Find the differences between the flat originals and the immersive paintings and paint everything back to normal\n{854306483740831}\n\n**Creative freedom** - Help the visitors of the museum with creative quests and wake up your inner artist\n{1376429067462623}\n\n**Sandbox** - Customize the museum with fun and easy to use art tools, such as the magical brush that turns 2D drawings into 3D objects !\n{1562077004939594}\n\n\n# Demo vs. Full Game\n\nThis demo version is a short, first-taste of the complete game. Here what you can expect from the full game :\n\n**More content** - The full game will be a 5-hour long adventure : explore multiple museum galleries and immersive paintings ; meet new inhabitants of the painted realms and complete dozens of creative quests.\n\n**New Social mode** - Invite your friends in your museum with the multiplayer mode, show your art and paint together ! Share your creations easily with social media integrations.\n\n**More creative tools** - More fancy brushes, a color-swap gun, a magic drawing machine... It'll be easier and funnier to customize your museum and to do the creative side quests.\n\n\nJoin us on Discord : https://discord.gg/dH8uKv7tm7\n\n", "short_description": "Play as an art restorer in the magical Coquelicot Museum. Step inside famous paintings and save them from a mysterious Eraser Artist..."}]}, "developer_name": "wondie games", "developer_privacy_policy_url": "https://wondiegames.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AIO Games", "support_webs
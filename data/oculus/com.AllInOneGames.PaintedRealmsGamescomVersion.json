Amj4M8iz5i9fqVShiMnnO-OvDXYtItg2TnpJfyH7g8tUJz4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuIRClYk5QtYDA4KnAL8wNnZ6wj80wSclGUGezdf-0wg&oe=6ADCCE01"}, {"file_name": "3.png", "id": "24941930302167834", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618252_24941930315501166_5630600238007271378_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glMOX1mQ8egQ7kNvwHdZuXA&_nc_oc=Adq8elZRExCbnjTUp0Fq8708ZMfsku68dqZmS7Z5IHK-Ca9MQPbnTdpdgi-yv0b3Ezc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsuI20t4DMeMVJsXMuUgQCbfHLJBmX8tRQmGYswou1jw&oe=6ADCC470"}, {"file_name": "4.png", "id": "1164452051868170", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619751_1164452058534836_8680613022875370471_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LngrUx4x7CAQ7kNvwE-2dkK&_nc_oc=AdpyeiDbfoqaxT1aYSBTLFeInycMb3YEKDNNVVP2YVbkd83M7ZlJMFhG1FwBAGsrNE0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW1okUY6oI6Mlx64D4EP0XgyxwIK-CYK9oGEi6MNj_Qw&oe=6ADCAEED"}, {"file_name": "5.png", "id": "835846522507208", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618039_835846525840541_3349035754661619138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYKr0dcxxAsQ7kNvwGhBgMR&_nc_oc=AdpG9uETe7lntgjsb6BmyZm3sfhElBWG1Mj_0kAywvA4G3SKwHcl1lUZevODKfg26Fg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlo0YLmZ1IMtIpziTMn9X7nxDizVIvUTFKDec5GkbGug&oe=6ADCD3CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PaintedRealms_CoverImageLandscape.png", "id": "1242734424538306", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618472_1242734427871639_7320096193581072004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZU67eLs6-4Q7kNvwHw-qXQ&_nc_oc=AdoBK_YXVkuwthBRKv0BwGYqBQtzYXIAkqScqZHNAP5v5n5TfXOyfSEZm6cBbe7BqPo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNskNACZqWszp9DJmjlVZCtFIuDYBhcGB8oD_2qeEVRxQ&oe=6ADCD073"}, "display_name": "Painted Realms (DEMO)", "keywords": ["cozy", "painting", "wholesome", "art", "sandbox"], "long_description": "# Join the Restorers !\n\nIn the magical Coquelicot Museum, paintings are portals towards living worlds ! Play as an art restorer and use your brushes to save the painted realms from a mysterious Eraser Artist.\n\n**Immersive art** - Rediscover the most famous paintings as immersive 3D worlds\n{2020461498710789}\n\n**Restoration** - Find the differences between the flat originals and the immersive paintings and paint everything back to normal\n{854306483740831}\n\n**Creative freedom** - Help the visitors of the museum with creative quests and wake up your inner artist\n{1376429067462623}\n\n**Sandbox** - Customize the museum with fun and easy to use art tools, such as the magical brush that turns 2D drawings into 3D objects !\n{1562077004939594}\n\n\n# Demo vs. Full Game\n\nThis demo version is a short, first-taste of the complete game. Here what you can expect from the full game :\n\n**More content** - The full game will be a 5-hour long adventure : explore multiple museum galleries and immersive paintings ; meet new inhabitants of the painted realms and complete dozens of creative quests.\n\n**New Social mode** - Invite your friends in your museum with the multiplayer mode, show your art and paint together ! Share your creations easily with social media integrations.\n\n**More creative tools** - More fancy brushes, a color-swap gun, a magic drawing machine... It'll be easier and funnier to customize your museum and to do the creative side quests.\n\n\nJoin us on Discord : https://discord.gg/dH8uKv7tm7\n\n", "short_description": "Play as an art restorer in the magical Coquelicot Museum. Step inside famous paintings and save them from a mysterious Eraser Artist..."}]}, "developer_name": "wondie games", "developer_privacy_policy_url": "https://wondiegames.com/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AIO Games", "support_webs
69D4F4A3"}, "display_name": "Avoid the darkness", "keywords": ["horror", "ghost", "lights", "scary", "evil"], "long_description": "This game is the proof of the existence of evil spirits. Get ready for the best VR horror experience in this fantastic horror game. Play this with your friends, or guests. Let them to feel the fear as well :) Turn on the lights quickly or you'll be in trouble! Focus on the signs, and you'll be a survivor, or the darkness'll kill you!", "short_description": "This game is the proof of the existence of evil spirits. Get ready for the best VR horror experience in this fantastic horror game. Play this with your friends, or guests. Let them to feel the fear as well :) Turn on the lights quickly or you'll be in trouble! Focus on the signs, and you'll be a survivor, or the darkness'll kill you!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lebersoftware.hu/pages/policy_avoidthedarkness/", "developer_terms_of_service_url": "http://www.lebersoftware.hu/", "publisher_name": "Leber Software", "support_website_url": null, "website_url": "http://www.lebersoftware.hu/avoidthedarkness", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "698081741685605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_121395275234205_2030205953915224064_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKUKFbAemRgQ7kNvwHLU_9-&_nc_oc=Adr
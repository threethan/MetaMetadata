dTQm_m_kTdPZbqAaR0PaP6-jCQnxTkp3ZA&oe=6A3574C0"}, {"file_name": "screenshot 3 APPLAB.png", "id": "1000781134532481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031651_1000781137865814_3334090383662162375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nkp_XJ9_WIUQ7kNvwH2gwSc&_nc_oc=Adp4DGBIFxgUbweyS595sM9RTeRkm--Xcrlx5qMjXEo4ycSg6ONMH5zL3lQmYfyo7Nc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5asRIzdi29nsljltqf_X5IXgZDVFE3b6oierXKd0iwg&oe=6A35675E"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPHacz_OqTgQ7kNvwHzvkUw&_nc_oc=AdpGSiY7GWv2HDsnILXoOP_LyJRM3vQNAUz1qOxevVimoKOyzuLrIViCnHh2UFLN41U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iW-PEBb12J80y2Idu8F36j_TmqrocPiIsGrUEd2m3qg&oe=6A354D1C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETuoCHAFYD8Q7kNvwFz9Bg6&_nc_oc=AdqwzLk1FznH1z6C-rltqJDt92sP_9XRhzLgT7j8kCfU3VTN2qNrBITD0-G4We9AP4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UvIipEQMGZp94AMPGe6dt6kqvINTHWVWzBFFJloBSLQ&oe=6A3556B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIx0R4fSInIQ7kNvwESU0p5&_nc_oc=AdrMApg5d5-4zuDlAwMkMRr1nClhTUUPEAntajnMgvck9uKNNwpmdLWhcsnhxC13j00&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oqihXYeThNQZrtrp97XXKtSsj0M2W-OS4UOcM1Wcmlg&oe=6A35446A"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy-v2", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7238173966278727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974792_795910735641249_6472845604324236885_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6S9DhtljIwQ7kNvwHCK-sV&_nc_oc=Adp1Zy9NGXQzyOm8rRgXS_uTcJBT66srH8vSkkF7gEUV228wqf2ggZGdTgOnx8aCX7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__BYthzo1SByS8oIagTKOt6VnAs9la0VuU3cMFKMyuIA&oe=6A357206
&_nc_oc=AdrPrVobXDhbRHYLY2MnO8f-K_6ysrnMI6zgVJpdrbYfj4gkAfYqNITHPYeikaBwrcA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROAeEFDnw4Kxs4CxJ-gaR5JJEVLs1MquOS3fEg0QOq9A&oe=6AFB285E"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btHelwDQXm0Q7kNvwEHYhBl&_nc_oc=Adqsz-yMuS-anbmLkdFCm8wiPqu5mlCxL6otwGoQvXBClMSWIhk1plEvryyCUjbLhuQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwdPl94iSSmf0V1YVRezmzkDsDOPxUSi3Axj7ArDEVXw&oe=6AFB465C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw1Emm9igNAQ7kNvwFuDtWl&_nc_oc=Adoq3hnhSJzZ8RCithk__aK8DHQN5D12GjuFshHppBSLS2-S3-sca_pcmZ_Z4jatrl4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDIHoWC7pO8IkC7uLxo2j8YOMvcl3nlUUxNJ9ku5Zbag&oe=6AFB17B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd3HRYhU2uEQ7kNvwHwXnWp&_nc_oc=AdrvcYASv1R8yENfAYL30KUWugDCOHKVGt0mEzkeh3lu5Q9QZye8EDZA4c5xgow5cTE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkB-EhR4nzzlNcxbj-uQJsnSJKvd9uKS3ZvJOyllgU5Q&oe=6AFB3DAA"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6608899815872815"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7844620842300700", "version": "EXPERIENCEDMONKES_V2"}, "id": "348697707567701", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6608899802539483", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "784462084
_xvB-N87ToJy4ous_gwtQCq3Xy54kudcdA&oe=6AE76F40"}, {"file_name": "screenshot 3 APPLAB.png", "id": "1000781134532481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031651_1000781137865814_3334090383662162375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GP6p1rY5910Q7kNvwHCBWau&_nc_oc=AdoeokF-QtnG8ijpckaND27ZDTO_ljo40RKfOi5Y8p0ePQXi_GZyKQrzSDuNL9MWENQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWOt7ZEzp9a_90iFBb1QGfAvY2fwMx3OY_ntRffoCX_g&oe=6AE761DE"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiYPE0i4eJoQ7kNvwFt-O1k&_nc_oc=AdoBQtvKR-N52Qb1aqnOAkx4ccklOxzEF4Ej5DHTSeGbxzxTkIAfDBRrAEmrVP8r1fo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc3-40CRdXJrprynyHRwk8GC22mxml2E_ytMcKUngMhA&oe=6AE7479C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmSnR0BfPm4Q7kNvwFCemFD&_nc_oc=Adr_ddUjU7kMmuDtmDdxU7M7sVeKA8s5BqUXaS11qQZtkcIvLc4DgSxOHi4RQUURzUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd4CFjcVTfNqjzfX48DQsps51-VerdHhHKPIxaiHbgLg&oe=6AE75138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQsijFF900oQ7kNvwEmkTmu&_nc_oc=AdpgZmrcBwrFpqU3cFJlHMFra7b5H5Vp8havOdA5pB9fQTbCgEnnLX_o4nD8Pm2O3k0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI_NvyiMmFdbQANYnDxH3esNmYNv9QI80H4jxHAzGsvQ&oe=6AE73EEA"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy-v2", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7238173966278727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974792_795910735641249_6472845604324236885_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdWaF0XDy-cQ7kNvwFi4lCb&_nc_oc=Adq9ojI5wzAaRvcmOPEEukkv3B4QlGx68pQ0lVfLq93GLsVIRSuH6TJO7ap2Mb1YePw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTGHS3y8MzsCe5qyO-T4pL6meyD1BUMurCsXEYuI3Fow&oe=6AE76C86
Xg&oe=6A77381C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NpBFG8QHA0Q7kNvwGHadvV&_nc_oc=AdpuaFmnfX_bDkcy6JuTyHcvIA_F1ZuGrZe0Wlg3i59BlAd6ku-6XnXuwX37ECsiC-Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtm-jCNpZ8Zsgdq_Nl3BrmheE3SjpFfOOf1sIWxzGqTQ&oe=6A7741B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69VodWyq3A0Q7kNvwGQO29l&_nc_oc=AdrgyF0iBcFC51j-7bLOCojpAxcaFYMY_5S6pVHQeHG6lHRlaW2G8Q0_t3uepFDeogE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGx5O4gXp_oJou5M1osl3XMrE7z_hGE6fKxd0vNKAjlQ&oe=6A772F6A"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "N
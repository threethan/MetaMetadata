j8lZsIfbg7NE3uVALU1K5sFj7ntOIBE0nUobgQVQ&oe=6A7DBF00"}, {"file_name": "screenshot 3 APPLAB.png", "id": "1000781134532481", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031651_1000781137865814_3334090383662162375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tpn70dI_in0Q7kNvwFW1teS&_nc_oc=Ado_3k1uAfqSKxXZbkocQegVMconrmf7KwSN6Vx2vC67E3yv_Vx4rNphKGGrOFaYRq0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnrPzATw14FPHsvMfg20W-IXK1sJzHjKqmgzmXoe1L2Q&oe=6A7DB19E"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZK6J14pu-8Q7kNvwEpdCjm&_nc_oc=Adq4PKdG9rD1KZoqRBej6mv3KpViHa3NchQf9blHUV4Wv4xhpYq348Wyqo8sPK14AOk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFna2NnYm_Na0gmawag8ikiW9KZcmxmdt4HmGccN7Q_A&oe=6A7DCF9C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mikgsESjBoQ7kNvwFqfkLa&_nc_oc=AdpOLxN5gq_71LieVbqD-5k-lwlMhooCsOzPtLBw_Ufjv-MNjToP6HaCkLrH6fH4dPQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCbs7GtGi9SztZECitXf6AAHCinYte2nG6Lc0AiRSWSw&oe=6A7DA0F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHULKkLgBdsQ7kNvwGzD2ZC&_nc_oc=Adqb_4OepE2pEa3c_Cc6e83QhvysfkOx0jDwUqlXF56aWHtrXzHyLXBkmeCo8ciKvpU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLCWKeuPv5LzJ32dQAEgYNZAFC43WUy_XEODIOdU8lfw&oe=6A7DC6EA"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy-v2", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7238173966278727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974792_795910735641249_6472845604324236885_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4E16KzdZ0EwQ7kNvwHGypCw&_nc_oc=AdrT27muf_UztT5JRpVgBsySBnQOiphsU4ifHDOV9Wr7cj3u9pYLBOm99moMWm4adh0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5hvp6jrjzTt3cRHCHiYhFWa64yTfCXxE3ojV6prmtdA&o
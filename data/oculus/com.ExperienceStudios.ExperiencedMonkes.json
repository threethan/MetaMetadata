U2KNL5z0Q7Hk3CT2trmGbiC88-Td0lRw0g&oe=6A3EAF40"}, {"file_name": "screenshot 3 APPLAB.png", "id": "1000781134532481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031651_1000781137865814_3334090383662162375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_BVHb_OxwIQ7kNvwFIUrlJ&_nc_oc=AdquOA9H0nYiGkEJm6T4QkeVyZuQTjXSg6EjplzlHopCYsadifsN89t4C9jzqKwi2WQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Za2PGl-XzvyZtb8PV2KeCdmoc2fInXHnQJoBz0F95YQ&oe=6A3EA1DE"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVdwsM74aPQQ7kNvwHL2yYz&_nc_oc=Ado4y4SWnz9w_DjgDdkA6Wp4CrRMGbUjg-sntmAhvYStMiA22JuzBL-FsbMal4WENc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qnwT0QEyxQiLrVzx0Uhw6jGgMY6uY0D8fu233IA2fwA&oe=6A3E879C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-kUetTZDyAQ7kNvwHZ5yoY&_nc_oc=AdqshbAfHe0VRyLOvekRBXdIdzMiXC_fxA7tTFrckBkGWx_-yjO69aVY2HkAH7gCYdc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I76oNVKdK2ymne-CkJXZ91LS6R_GItuvCNl2P0bvZ2Q&oe=6A3E9138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQYWHQCSZLIQ7kNvwG_9bVt&_nc_oc=Adomr0jvjDZdZ40OE5BgjmclI6YgslwiE-nCnpACNjHHIsXXQTfp6Xg3deQZ9SPY1gA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BjBAcJtmbKBp3oTclC4VJC3WOs9PPXlyKVdHdPTmN9A&oe=6A3E7EEA"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy-v2", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7238173966278727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974792_795910735641249_6472845604324236885_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwLwZeH_BRsQ7kNvwGoWWmQ&_nc_oc=AdomZtmIEl0VcUXZf-4d0BznNhj9DxyvCNPnDA1yAcoYqgiNTt_XiKbBrWidm0Kk_yQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hv8_kMpia4dtsZ2R3F7fusskdGpdgAviJug0Flch60w&oe=6A3EAC86
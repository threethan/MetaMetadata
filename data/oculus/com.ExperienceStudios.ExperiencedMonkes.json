e=69B40980"}, {"file_name": "screenshot 3 APPLAB.png", "id": "1000781134532481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031651_1000781137865814_3334090383662162375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZzXwzipPaAQ7kNvwF0MiXR&_nc_oc=AdmQE4DqASqVIeriPdiLw0V49iaOV1pRZEvWqYDsRqX3xOQTkUneTO2PF99EwMUpFUI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfziLTkARGQ06tUYQVSw0cQ-PMWPqBoWd0IK_EWTW0xLsg&oe=69B3FC1E"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9FN4zIFejwQ7kNvwGucosx&_nc_oc=AdkiMf0MZPBBrq8gs2QWaw71KjGM1Dhm2QtLKpT6rZ4hB_VfvpzbcbCyxIQ556hk_xg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxbqcmf-Ye-t_yF5Vb4nBLJn_XaN-vHjGERXDb9ZaGYyg&oe=69B41A1C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5glKtY7WoTYQ7kNvwEiAwto&_nc_oc=Adk0ybE1K3qA3J5suydz9STd9YPtI3onqLbvT1u_5mj8h0KH4u1unGPAymdBMEUuh7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxz6RBgrOM5iUDxz_tKKXGEAhysqHgt2SQ0-VUFwbWYhw&oe=69B3EB78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojkfFxVONcYQ7kNvwGLywq3&_nc_oc=Adm-UfY_ByztPMdiKNNK-o3RAQEgSabS0QOJlCPbDIvt4ordT5ZknWRabBEV2PEETpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfySWqqUbHmkt5WbQi0sZVA0nG_ivHbCrZ22Rrz5kSQkuw&oe=69B4116A"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy-v2", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7238173966278727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974792_795910735641249_6472845604324236885_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TnVHW8r2t8Q7kNvwFxYicO&_nc_oc=AdmBaIONBQ5rgRblVhVfCebRTRdHJDZTlWIJvZpvmkNiOLs0E_lxcc7eMxqjtoaqQm4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPOsUyG2Ldb3YLV-X-gQGuNAQCiTJYwf3928BAQWiJ4A&oe=69B406C6"}, "is_concept": false, "is_test": false, "is_trial_off
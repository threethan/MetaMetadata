iw&oe=6A86D1DC"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOmg0_AqlckQ7kNvwE_3bwL&_nc_oc=Ado8WnDY6vvusNTTVt5W0gSCw18sgDUL9wo8UZXD6LAy3WECNucs51qy27H7wo6COZk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUHwGbc5Ev9wPkyu1R65rBWfTqgKPfsI0wFMMK6uZVww&oe=6A86DB78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP2no4DnMwQQ7kNvwEdfdPp&_nc_oc=AdoKbkVJouYs4rPRKPrO0F-7tpMaHyrUaulGHF6UA7VyXv-qLDhwb942ziL0w2H04LU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcPywTtEsTyqh7m-zW8Tr8OkZ5Pecxqrtg_dIwF-V7Tg&oe=6A87016A"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "N
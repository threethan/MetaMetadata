HA&oe=6A73439C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgDAEnn8q2gQ7kNvwELT0iv&_nc_oc=Adp0kxBTyxdgYdzYN2dbvn2pMyte_l-HlBREuaEM5og7ilhCG552I4IneieiN8Te-F8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZPq_yQhMZUsP1m5iVtRuIgebAVPJGz1oGVL4UO1drIg&oe=6A734D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmZAEsFX9qsQ7kNvwEKyyBk&_nc_oc=Adqwn0C87e1ClSDtoSovB9phxGm_lxnu36st52QVi6f407Aq5FX7_qQ3fS66It8-D10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUlZe2ZyEwefRcgWJdnVyB6JnXEW1dM-hGyd-1YY8JOA&oe=6A733AEA"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "N
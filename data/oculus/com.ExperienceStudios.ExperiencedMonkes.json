-Q&oe=6A10631C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C4-USMo2NQQ7kNvwEPrH8E&_nc_oc=AdqK_-IRBFXD_S3F7NVCJOjraSvr3zhnJ4-sHayiM0x0sdQguQXeQVdGNZD5sEBk8ic&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ui3cO3pHqraHZnzwYPgj0GjAslUShYw5dght6X9rWaA&oe=6A106CB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSZOUiUGT8wQ7kNvwFsxKIy&_nc_oc=AdpQq8kwYNJ57EciAjp7_gFY_kBCNHaU6J2ybUXTxjfpi5xKz2p4cfDFEPxWFAJHX7A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eVGKxgS9Zpgo_FEARN0jHLCIpdlKb62EIGxiRqmTjhQ&oe=6A105A6A"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "N
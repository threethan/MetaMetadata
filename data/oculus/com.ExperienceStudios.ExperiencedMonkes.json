UA&oe=6A30071C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ie45dfi7udoQ7kNvwHadBAG&_nc_oc=AdrS7N5Oi3w1zBtkjUwsxoa-L4SbzSSCGoLfjxku8xRYEpEoEt32v3MOz6ntBRdTKx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5qiUPoZIxqeasmUbCb0ZuW35U0faJotv6jgfADpPjug&oe=6A3010B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3tyIUeMBj8Q7kNvwHgB35P&_nc_oc=AdrQ-FHBmbWmZLPtowFmfWR5O1EPBD_X_xn3yZe_G6ico0O030BwsIcyedK0Ry0A1Sk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ymulBzngyjDHBTN8G1ugDkTxVr08o_Sqh0H5vlO5lCg&oe=6A2FFE6A"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "N
cQ&oe=69C7E09C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ0x7YZXR28Q7kNvwGGu2uf&_nc_oc=Adr14JS4rwxRq7CF0_EYRwnQmlawXbKgWlXm02Yvobl0ODSdXOY9DUl8Y24gzhfF5y4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyllRT0DuPRTNmQJ6YNeggxOx-iBMLDcI1nwYbIGPNycg&oe=69C7B1F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfPxmbzzbVkQ7kNvwHVp1b9&_nc_oc=AdqVUiNAR0WFTwPxEpnxhvuH9Keopdx2Q6wYSBqN6gb3xeQhQl2YBfRQELzCfsMXFrs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQqqy1-RRo0R6ZC4bR0ZLqH8Kr5ci_zRdcZR5L2RytNQ&oe=69C7D7EA"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "N
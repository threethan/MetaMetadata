p_Z5MZbBxvleWnYA9FdyherOtIa-6_v0rw&oe=69CD1600"}, {"file_name": "screenshot 3 APPLAB.png", "id": "1000781134532481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031651_1000781137865814_3334090383662162375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFWPO4JiIzUQ7kNvwEWpIMo&_nc_oc=AdoUGgnvq-nNsnaKbt4-jz-jmagSmlEPzBA5xMjNfUmIF4XAfgZCf_AMj9jLqvELpdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyZQgipOGdjWCUEH9xR1wxzvWa1bvyaGRzViYrAirKhA&oe=69CD089E"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mimxlDVhTeIQ7kNvwFIumlh&_nc_oc=AdpuRvYxz-1mCJipoglrg144MEfCEoHixL-b3Ubm3O28XfpIxb7rOhbg1Hn3FS4q-K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrOIsS726zs5OAkIO0ZWZUraTgiUyyT_3Gx-w8wx62rg&oe=69CD269C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OH0RsaABtQ4Q7kNvwEjK3Y-&_nc_oc=AdqqnWV0PmbxDNLjCvZBvoG6UVb974AEqBlT-BIcRHaRLTIg1uuGdhimY6SoxGJlC_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUfefXBIFglrsOQLPusWiH40MX79N9lZhrN3bSRPagKw&oe=69CCF7F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NpIMU2lPZ8Q7kNvwFaNnXW&_nc_oc=AdpUTT3onakwuykQ5BnDyOa5sd9FMLsmMbc9qSH2xADnrTHbVfpoZi34AfmqoDZFVho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzli_8X_yICKU2MMo0T4MEQLMJqnK5eGq3UXpbtzlyBVw&oe=69CD1DEA"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy-v2", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7238173966278727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974792_795910735641249_6472845604324236885_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHjNcZvxk5QQ7kNvwF0dPP0&_nc_oc=AdoXNw66zLo0VtIpOlTX9u74q3dT4gRRU8x5vTHZmTyf-xDPoCA9LGLGyQOJMV83EoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMAGnkvY6xtU7t344mMkgeD83_nS9o2kVsGE9vFfM7Uw&oe=69CD1346
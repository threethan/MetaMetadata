_CpJVjsLYxMukOBatxMATKe1eN9RvdQWng&oe=69DCE800"}, {"file_name": "screenshot 3 APPLAB.png", "id": "1000781134532481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031651_1000781137865814_3334090383662162375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSyFDc3RPioQ7kNvwGF1MMy&_nc_oc=AdoWf1IwBhcrihywKsqGMj6C5FfB7Bwie3LHKTHzg2mVPBI6GlnkgHoC3lyT3bzmZeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tabvYknWovO39LTAmAvlPrxu0qAKo2ZBuenwEP9KmJg&oe=69DCDA9E"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YA3IX1KhPtQQ7kNvwG_rq4S&_nc_oc=AdqYUNAioWDHZ4I5LbQybAYU1cGgucUw3XxvzlFFNSwecL4BaVDGsuzVI4QKoPfdBcs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04W-RY6CjUEJOHUbsEY1lFQ9CXy4MMHtJQL2cA9TF3dQ&oe=69DCF89C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vn7SeklXMsQ7kNvwE3QLoK&_nc_oc=Ado6jaBoptpKD5nT0kC31Ra6BwfVQcpGc7rfQC_EBWvLe3s9X4XdDJWhKujTUH6kHoU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g2-IEL0x-xoBnk0QQxsEogVlPwNUM8AmsvK8NVA7UuQ&oe=69DD0238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inx936AH-4EQ7kNvwExBCjo&_nc_oc=Adr-Hess5tksT0Sq_ug_xe5CQd-ZHEfNl-hOuiJLPjaPV_LUnFTVcIF69dhv2qlupyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oQWDVLZ4dpPa8WCmdJLAwp3-iU8MTHeQgG6FZwJ7pSg&oe=69DCEFEA"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy-v2", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7238173966278727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974792_795910735641249_6472845604324236885_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Css40M6rFBoQ7kNvwESfjpt&_nc_oc=Adpw7szz3hQC4bXotODs0GBsZo6obYw0xth49DktCoRZFaBDCycVQyxbKjhQ8-VLuWU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EY3V8f0yGEBrn8ILxKen-ZWFvQcqDfCoYjJKqd5F2pw&oe=69DCE546
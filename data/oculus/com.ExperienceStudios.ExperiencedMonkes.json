irwA2WiKKSQEPUI4D_1BCnRPO50dymdrYw&oe=69F89780"}, {"file_name": "screenshot 3 APPLAB.png", "id": "1000781134532481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031651_1000781137865814_3334090383662162375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ9ocuRQRzUQ7kNvwEsk0Mi&_nc_oc=AdrtBqWySX4QT9KKkckxMfwQ_cY_mrokxRy2Xhl2gIvSteK-gR-p6BXldBwpwDTy64k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OK_lUCtyJPvsnoLJ2aQuG-l9rP0e2y4czSKKIKb6Z2w&oe=69F88A1E"}, {"file_name": "screenshot 4.png", "id": "319289320717489", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974645_319289324050822_4246648943781780246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z2NxE9TTuEQ7kNvwFcvfgi&_nc_oc=AdprUEM1IzsLEYvQsOYAkV3ZzYAimz6iS1w7N03RZZcyQ38skkJ-lsVqrd0d8SCu-Og&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZQ02MsPT2EXzGb0pJoSKaAg5IZrFKXssHLcVkI25YPQ&oe=69F8A81C"}, {"file_name": "screenshot 5!!!.png", "id": "345461034677613", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035312_345461038010946_2387788764125178036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ8XXAJL1HYQ7kNvwHJnd2a&_nc_oc=Adp3FIj3PaAvKyzuD3dTUT4pJ0-0OhE4qVMS1xHG_XGYbKNMQbZhGufLyIaGYY6vHyM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rP4Z1Mz8JKuXA28bMYKk9sAcHKWPL4X8YwuZia5Zxrg&oe=69F8B1B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot 3 APPLAB.png", "id": "1003286644275061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982501_1003286647608394_8346372999363423708_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt1KvTWwpXAQ7kNvwGkvK6C&_nc_oc=AdqggmsqBrAjR8oNK_WsG_Nh5ODkPRN55adW6f7B0ZekG5-W9UvFTuzFSkLmtp0M64Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Gg27LuREMcb5LDhPEEZSg8_nFAFsdBnueHLKobtqvkw&oe=69F89F6A"}, "display_name": "Experienced Monkes", "keywords": [], "long_description": "Experienced Monkes is a VR game built off of the popular locomotion system (it's open source and it is the locomotion system the popular game \"Gorilla Tag\" uses) called Gorilla Locomotion. The locomotion works by hitting your hands off of objects to move. In Experienced Monkes, you immerse yourself in the role of a monkey in a forest habitat. The game is currently in beta as I'm writing this and there isn't much *yet*, but in the future more improvements will be made such as more maps, and custom hats and things to wear, and more! Enjoy!", "short_description": "This is a Gorilla Tag fan-game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/experiencedmonkesvr/privacy-policy-v2", "developer_terms_of_service_url": null, "publisher_name": "Project Experience Monkes Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/experiencedmonkesvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7238173966278727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974792_795910735641249_6472845604324236885_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTccL8xHRJwQ7kNvwG_GQLj&_nc_oc=AdqmYnmKc3yIZqyNJ6pBvBBFhbK9CPis4JOdq_bnw9d1CKKN4Y0G8xx2IQlWk87TT9M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DsP71x-IABViFc9lUazdW3QU2OL_cWQ5Lqasl0L-x3g&oe=69F894C6
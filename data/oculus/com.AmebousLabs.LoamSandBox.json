Glw&oe=69A6C895"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Loam-Sandbox_cover-landscape.png", "id": "3201924836799745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_3201924840133078_7651489994577875276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nm8Iq_ai6wQQ7kNvwEWX2aY&_nc_oc=AdkcPAuZp5qgGYkLyUg5blpSPP7UCTxHOlndSIjan3Z11CiaUxTG6iZGKoffz0KQYYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs1343cJFSvSCjhd63IS_lurqYy5KMVAdQDVSE2lHN1Tw&oe=69A6E726"}, "display_name": "Loam Sandbox", "keywords": [], "long_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve always dreamed of having!  \n\nAs you step inside, you\u2019ll receive your very own garden plot and the ultimate freedom to design it to your liking. Bring life to your new land by growing plants and placing d\u00e9cor\u2014who knows, you might even attract a few critters while you\u2019re at it.  \n\nHarvest and sell crops using the communications console located within the shed to earn Solstice that you can use to buy new seeds and decorations for your garden.  \n\nDesign a space to relax in and enjoy. ", "short_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve always dreamed of having!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://amebouslabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Amebous Labs", "support_website_url": null, "website_url": "https://loamgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "gen
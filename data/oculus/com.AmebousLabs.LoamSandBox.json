j6-mJwLb558U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_dl7j5UvdlXRmcR_8u9Kj5jE3XRTS7MoHpFaAl7oacA&oe=69B00315"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Loam-Sandbox_cover-landscape.png", "id": "3201924836799745", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_3201924840133078_7651489994577875276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU_unK7ptoAQ7kNvwEZMPkz&_nc_oc=AdnSgpgoptqEclhFFP8rKG5lZvceOIqhpxeVfTiZKNA3JSfz5h-ziC1dfVcasyKHO5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSDZQN1FczX4WKIScedu4aKMaaOJGd4aB21R7ONjokSw&oe=69B021A6"}, "display_name": "Loam Sandbox", "keywords": [], "long_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve always dreamed of having!  \n\nAs you step inside, you\u2019ll receive your very own garden plot and the ultimate freedom to design it to your liking. Bring life to your new land by growing plants and placing d\u00e9cor\u2014who knows, you might even attract a few critters while you\u2019re at it.  \n\nHarvest and sell crops using the communications console located within the shed to earn Solstice that you can use to buy new seeds and decorations for your garden.  \n\nDesign a space to relax in and enjoy. ", "short_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve always dreamed of having!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://amebouslabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Amebous Labs", "support_website_url": null, "website_url": "https://loamgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
QQ11nd2vbKUoDF61TO4eKDACmfasB9zwEDLTZE3Y5MIFw&oe=6B04593A"}, {"file_name": "03_Horizon.png", "id": "5139060749440740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_5139060752774073_8882231032804691816_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffZw7ccyNgsQ7kNvwEFLajL&_nc_oc=AdpXJvkynXpFgGhPnZ2J3baBV-JTdnmm4D5ARGq3KlYCvSkPR9dE_M1AYpfdnfHA0z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQhdEB40mcXHkMb9nttgHGg-J4bBahgXFmEkh4Bcdw_Q&oe=6B045E55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Loam-Sandbox_cover-landscape.png", "id": "3201924836799745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_3201924840133078_7651489994577875276_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WuNfqQIdJ4Q7kNvwHGzGme&_nc_oc=AdpMU3va1dqIvo7rMg-9_KFE2iAQ3JMgDG0FEuiVLw1Oen31mXqnc8nl8FS2Ko4NCcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWDIZVoSRdgCXvYxZO5bC9v8qDPNr1jVpPywKgBWO-Ng&oe=6B047CE6"}, "display_name": "Loam Sandbox", "keywords": [], "long_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve always dreamed of having!  \n\nAs you step inside, you\u2019ll receive your very own garden plot and the ultimate freedom to design it to your liking. Bring life to your new land by growing plants and placing d\u00e9cor\u2014who knows, you might even attract a few critters while you\u2019re at it.  \n\nHarvest and sell crops using the communications console located within the shed to earn Solstice that you can use to buy new seeds and decorations for your garden.  \n\nDesign a space to relax in and enjoy. ", "short_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve alw
8WxVQ7XQA5T0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHktAcTVW3fqTJIZJm0kcjONhdipxgrC0bcf3LX82iPQ&oe=69BFD515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Loam-Sandbox_cover-landscape.png", "id": "3201924836799745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_3201924840133078_7651489994577875276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xC3owrtyC5kQ7kNvwHImV6c&_nc_oc=AdkVv92S0Kj4eLoBaxjhti1KmwPryH82XlF1l9xsqfpndWoVhw1DVEB9vQHrU_M-qNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzso4WjCD8IZ3b6CF71rORy_ggLoebqh9E1vf5ALPrWjw&oe=69BFF3A6"}, "display_name": "Loam Sandbox", "keywords": [], "long_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve always dreamed of having!  \n\nAs you step inside, you\u2019ll receive your very own garden plot and the ultimate freedom to design it to your liking. Bring life to your new land by growing plants and placing d\u00e9cor\u2014who knows, you might even attract a few critters while you\u2019re at it.  \n\nHarvest and sell crops using the communications console located within the shed to earn Solstice that you can use to buy new seeds and decorations for your garden.  \n\nDesign a space to relax in and enjoy. ", "short_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve always dreamed of having!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://amebouslabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Amebous Labs", "support_website_url": null, "website_url": "https://loamgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
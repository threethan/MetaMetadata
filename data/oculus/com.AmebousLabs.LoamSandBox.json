QQn6Ln_BvS9YX6ZaexzqragV-HLUYVbnCvsMErgAjvTzg&oe=6AFF133A"}, {"file_name": "03_Horizon.png", "id": "5139060749440740", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974444_5139060752774073_8882231032804691816_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfFhDxS8LAgQ7kNvwH0ifnI&_nc_oc=AdrMLuEnpyftKR5eTIQGRDNHjdqY8ybbnO0s-Vao1bZetFY--B8UA5v8qbShjqpuYCI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoEOM5DvIWb2LEK2PxAeTmS0ffIMv_DlKDIE52KLoEWA&oe=6AFF1855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Loam-Sandbox_cover-landscape.png", "id": "3201924836799745", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001687_3201924840133078_7651489994577875276_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsILRGWsWXEQ7kNvwER9T8V&_nc_oc=AdqvhvUo-D_g2dN6U7TWdbvPWQ9JEF0fLREGTHNhXy4IvU4oNKnekgBXdnyrUAjMHRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdOTL08YsPPtCv4MCmnfcnel3WOypGeG6iL6EfjPeq2A&oe=6AFEFEA6"}, "display_name": "Loam Sandbox", "keywords": [], "long_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve always dreamed of having!  \n\nAs you step inside, you\u2019ll receive your very own garden plot and the ultimate freedom to design it to your liking. Bring life to your new land by growing plants and placing d\u00e9cor\u2014who knows, you might even attract a few critters while you\u2019re at it.  \n\nHarvest and sell crops using the communications console located within the shed to earn Solstice that you can use to buy new seeds and decorations for your garden.  \n\nDesign a space to relax in and enjoy. ", "short_description": "Welcome to the magical world of Loam Sandbox, a garden sim game where it\u2019s always Springtime and you have the creative liberty to develop the garden you\u2019ve alw
9&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5nZVLCa750Q7kNvwGE1Y9n&_nc_oc=AdrWKMGGnb4dDkKahM4aV30_0eqsRBQPrwqR9xDUFLLc_42Cg5UwUvOU-4ByN1HC1kI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIzVXMYEK_nDFpL70dNPcPf5e3OvVsYHhM60VjarJxOg&oe=6A9EE165"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWJi8g-LiNcQ7kNvwEOsbPo&_nc_oc=AdpGtQuzAqusAkA8si-V8B_yx0IxfJXMai5bZEj7NMYRHPMnCoMpIr3p1V0z1GFPmSw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtk7ZJMB_NZxeUdaSrwzX_eg03VGSd6W1XCLbPTiNXTQ&oe=6A9EBD18"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNNTpMRtHS0Q7kNvwFQDHvU&_nc_oc=AdqwS449_pfnAdjUxsegmCYHSEFBeWbBl0q9aWG4BMasMSBpwEJSvdbYD1inFJR0OAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNCb19Siz9giapLEhfs0ZrWXJriHXt5Bs_CNpI5LeMLQ&oe=6A9ED4E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24o85HhjKpAQ7kNvwEWb0pw&_nc_oc=AdrQp7NFRs7x8sWKReY3VQTxWvWsYqFqvp6VZRk3_cNYULXk-JX8psHt52t2K-FASRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnbb5uMyC3z-1HPxKjENfYCDmtFXoDLMI76TURVVh3cQ&oe=6A9EE1B7"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UMwYpFEMH8Q7kNvwGQl20m&_nc_oc=Adql6hKOv2iwVFVxAJCLbd9vQz27UR5VRJlAKei9AZk9vHEY40jxstqdQ7orEQ6JVyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&
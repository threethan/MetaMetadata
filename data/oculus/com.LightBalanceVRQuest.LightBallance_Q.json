5SOP5gYLnwBv9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZCREl6mmklecYiC3o5fprWxr4bbEuYeQ5WA3EFIIbIA&oe=699C4325"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ_UxpwSnrEQ7kNvwFwgJAx&_nc_oc=AdnkmlepO_oNpb9ROklySnAKijD5z7BdUMxkSyqnB9eM9RHFxZr5FS2L7wFtLidzOBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afssop7-ThXhsJAWLvOa9Rd4q0RNIZFzqurihX0Z_NgSMg&oe=699C5718"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuBMumkIPdQQ7kNvwEaGK5K&_nc_oc=AdlJ3x6ukUNyDhdJVj0sah7Xna0SjSoR_Usby3caMN4p-Kb9Zp2nwXXP7NQsYycCXN4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afundj3jUHpRkpWK7AyvWHHBtaaF0VFKW6LNmOcAUnTCmA&oe=699C36A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iiuv-CZXhy0Q7kNvwHwhDml&_nc_oc=Adm4W65O8_IMHGjIONs1_CqI5YkgK4tj7OZiZvYkh_uAwFF5RgRU6zQrh-jPAaeLMOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvTZXYKlvi-OYWdy2c2gEFearDxyXC1J7q05LfJgPWo9Q&oe=699C4377"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPAvCe2LVegQ7kNvwEW4iB8&_nc_oc=AdloYulLbe4RtW5_D-u0a0p23SI350rB_pa9_g6e66x9pZL4J5AibEAJWegB-tX_qA8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftzn0TagUGfMZJQY1ZxJah0_Er8dRFtPh_TngI34VkhcA&oe=699C6636"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Light Balance VR", "platfor
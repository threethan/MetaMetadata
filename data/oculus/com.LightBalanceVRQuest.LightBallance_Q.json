9&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Zo7GvOmLOUQ7kNvwFdcWK_&_nc_oc=AdpuyXuyDkmdYWna3R9NBli8UaSg68Yi7K4H-cgIzBNh4KnBUjpZAk0-MBbUAhZ8azE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR_gdad5q9b1tqbpn4Yl2Hdc16reNhGTKO7-_cphB7RQ&oe=6AF492E5"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daBS5PpphIgQ7kNvwG-GX5N&_nc_oc=AdrzSrnB9xYnwGKI2UlBUu3oEFAc9ZcxE847-5sisagKR_mBpBPMUOjDxiKeiDxbbRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzzZbBmSdNsrTKkMIdGsy7Az3RaHMS62QlSvl8HxOAyw&oe=6AF46E98"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McMMfpcYBcYQ7kNvwH3tQrj&_nc_oc=AdobT8ZUK8y94xrfRPSKpqNSGuHE29ggW5rN3Mj53WFwXjgddPyMMGHs4FfaIf5PD10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSplg2_WzTEatvzX_nYnqn4dHghrmTw1rfSh7X-NV02kg&oe=6AF48667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIu-vjSZasQQ7kNvwFS_e91&_nc_oc=AdoOEu9EupK4-lk6rs3KFtXSy6RN7O6UIeRhy4XF57gB8yJ9_OVm7KA9xwrcG7_xj38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfvgda5S78T3s6Ztf_RN8qA0Z53ljA0lhaooNGSdMYKg&oe=6AF49337"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx5fVdOG0bMQ7kNvwH-bcyY&_nc_oc=AdrzYS0egBYAJcZN9UIDo9CCzSq3mPHDpSP33qbmifBm4q-vUuB2NhLJ9_akNifZMZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&
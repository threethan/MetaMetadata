9&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mF2x5cAF00Q7kNvwFOAHUz&_nc_oc=AdoiDW5hyTOTg7BsYac4TC0qamssN_BSYQTkZ3ADU7zEGPqTkJ5h2twJAIPI9LwVDag&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwhf0Otp0k3rMR14N4Ugqmjya45tkij9tQ5Uc-OExk5gw&oe=69C3D025"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcqoXwnNePwQ7kNvwGuNJBE&_nc_oc=AdoshKyg2xpAZd-S3sXrr-WMg4_oDiIP-4FCpRqNOADQ3RMtGvbip9qqi2k1kuyP11Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydJeH7gFqaR9fP5W7mTcJ4x4JejkIBueA6nXPRCMOrGA&oe=69C3E418"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZnJHeZWFp0Q7kNvwHekAPm&_nc_oc=Ado4J6xGvHIs-X6VUMYn53cxFDFrP2rdsl3nqAlTZsdEa1Mz1aZo2Djslr5Hqvtb3Eo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzER8ksWzFiG5vdHaiit0N-SOnz8gDanIVdC2KvivvTig&oe=69C3C3A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGEiyOPx1h4Q7kNvwEHAsUl&_nc_oc=AdqGoiPyOwrrWesnjODODUHw-NkvKIEf-FIxqHIbrM8fKme8NnKleuDRHmoPJilkH8I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDueP2I8wTZsD3z-F63C5YYBKTZmw21yJ7Vw2r81hkdw&oe=69C3D077"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASXWTbKGEswQ7kNvwEWBiGh&_nc_oc=AdriHo2bb9FVe9y5GjZ8IRXG-oqxWzpxoLJLF-nd_n1abBzVB1dqP51bNIKu-m5RDx8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&
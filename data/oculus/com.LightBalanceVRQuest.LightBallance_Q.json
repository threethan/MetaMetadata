wVdoZEssE88_Ro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftpeps-dmqBDnm2YOQNFobL8d-y94VaTY8mskSoU12ybA&oe=699AF1A5"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ_UxpwSnrEQ7kNvwGbMDmT&_nc_oc=Adn7MHMgPHM9Gl1Wa9-9wDOGqPp9zsWPE1Ec4sU3Hf9vdvDZB-p3Qo06kaJ5Brk7wAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu-2suBlX1UpA9W9FCPhq3rAKOOpiehGi61qk7woJRHPA&oe=699B0598"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQH1-4phx2EQ7kNvwGAqViY&_nc_oc=AdnVRg6C6p9axZLsaTpVWEpZapm--vtpkoAPuF70Geb807cqCT3WFHOaE_0NYWyrUc4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvw-CznpJZWnllUhTzdMyP9TKtHXLOjVIguSj6Rv-TFuA&oe=699AE527"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iiuv-CZXhy0Q7kNvwHkaCd9&_nc_oc=Adkg3aCzbUKwTBipGON36v_gjFquWKjmOYf5_f7NPd2V12W4Ct-e_LmpNI7ElnZbF9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvDi59GQU7RBDrojfpPuUq6dcOXd9AajtH39DcbbwQhQA&oe=699AF1F7"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPAvCe2LVegQ7kNvwHWTKgi&_nc_oc=AdnrfWlSbaJ5l-GfY-rwK298qKU61ob6FIhu-q1v1SlKW_YTkLb0zg-zj4Da5bTBf7Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvXyuPd-YqaQIBEIraEqIPALnjkJkp3c8Wn49htnVOQ4g&oe=699B14B6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Light Balance VR", "platfor
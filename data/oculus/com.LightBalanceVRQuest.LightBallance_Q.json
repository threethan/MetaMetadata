qsccHXYPrsd9Tc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft-YaFTDSZvI9rzjqsL4p7QkDw4zBrjpPoob7YZApgdJw&oe=699EE625"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgLw0LArcGUQ7kNvwFhcyEB&_nc_oc=Adnh2dcGk8KTz1zYnZ2HtNefEKhv3sUP2A36SgLvC9Ln0fy6lMjtHuAzVnRFGAWFniE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsYg2JkNCtalrc4TSTLgz9nyP3wdsSL2NbMuEAJPz7X6A&oe=699EFA18"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuBMumkIPdQQ7kNvwGeVyuM&_nc_oc=Adnd2L2Vpu-heNwkubT8yOaBW6OLf-o7S0wtOUPE1NQHIgy5bWqJbLlKtHpyiY7UekY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvUeQXRI0iewG1A_TIbLQbJGuauX5PjbxR8wVbjS46iYQ&oe=699ED9A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NHfkcJMAmAQ7kNvwHz_ZMW&_nc_oc=AdkyIVo4bIaEm8YYl9go5Wpv0iiQ0b9r65z_gwi6Rttdit-mWrVN1xFJFeuvRSlJ3cU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu5tLwqARI5DY6OD0IcxUHm8A-mexV3pNR8XRvjy9Wcqw&oe=699EE677"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVofP8su1jsQ7kNvwG6MycS&_nc_oc=AdkfyDNajezfsRPjU3JXbLWThmkEhNGEX3CtHIHK5sIL0Zr7LMPFz4_I2GNvtJ6BhXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftzDMvInXAj6OAujJzX-2CMe6u5uuHk0uSHgSotA6YeDA&oe=699F0936"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Light Balance VR", "platfor
9&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH1K3RFV90UQ7kNvwHl3mx7&_nc_oc=AdqAqeDE_zLSNtAwvZMeYCeIs7bQzef5fSKbo80LDBs5aSvIv1JlK7lwSTLiOB0tS4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r1E8MLWl5tO1zHm_MaSSFOpmPhcDxd1FA5BQzq3FN-A&oe=6A15C565"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQRXKEOL_CcQ7kNvwG--X8a&_nc_oc=Adol1q1F8rqZwGDwXMudIPN8U7SrHYTsUGxFRUnwv-iRtYbPhyGIQrdoysXq6MEEe_8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H5XR2Xop3pN85XQyemeabxNXIQ8asGj821whBqf1EbA&oe=6A15A118"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MI-OEkKTgwoQ7kNvwG9HLPF&_nc_oc=AdquOHHiwokq5dziPJUO7-xx34sy9Z4Bmestl9FXyWZzX3pI1mW_rZCcleX0z122-ao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44DYPR_6QW9ZBK3SSoT-mgnJsQ37zNVELE-YinK17gUQ&oe=6A15B8E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYoUTJTM-fkQ7kNvwENtCz_&_nc_oc=AdpS6U57ZT1Up55lbncv6Zp-quxq9XQEHnReGCVvtPMWqhywkvh5myFZPeM9UmxFhJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vP63afhw4Gjkg7zRDjLJFnjrgLJWEPm4IXMGo507k_g&oe=6A15C5B7"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VeKxiaJq-YQ7kNvwGeRA2w&_nc_oc=AdqxhtsbNu1Bvza_wgiuW5tM1y1et5UPtNgIFpEk9S_Eqdr5pHHPoNKenXg5Ld8fr3k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&
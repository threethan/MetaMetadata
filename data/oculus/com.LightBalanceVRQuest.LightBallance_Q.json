z62uIiAYQ7kNvwEvefFz&_nc_oc=AdmDbjM5jPfte1II8LlBFLV3Ikn18r3IP90HtBFBU2BdVIfAlu6NscH3y5OXifiCik8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxASSlT5iXsqz5f-Y8AxEWwbGCCaKn_t6gsygCVFjWZRQ&oe=69AEB825"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM2cNo4zztsQ7kNvwGYGDNT&_nc_oc=Adlp1MGHjBfyOfCW88n2VT_oIOptEC6lTRaPsqkm0ynlN9g09M81aU3Gs9iX3GBBx80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQ-Tg2bVa1y_uL6gaZLvSep6WH7_GywYt99EOezS5JVg&oe=69AECC18"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmsI1-yNmYQQ7kNvwHWiOuc&_nc_oc=AdmTTHAHIkz2a2-2YPftJZJTO1QJ5vmgzBQ8Y0dBG1ft2ovykHr7Yu7LpcKvEdniCu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuDUDDw0Fgu_rpS0iqsA7PiouJXm4HaVU2a-Yar-JbJw&oe=69AEABA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxbjhQWIWD0Q7kNvwEMHUJk&_nc_oc=Adn6eXI6IOhtOJOM2nn9EXZk9A0wkMk9ofa9Sar4Jalgu7AtdFJRwUlMOAXwd6Judl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEFaUKVj5R4K2s8yOY83_5BgO5baADskJyETb-9cbZTQ&oe=69AEB877"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UkZi4-kDoQQ7kNvwE4-Psq&_nc_oc=Adkppqt3c6itzsSAtioqRuS0VO0iGhMB6qfe4NELLKb3BoxeRK2wla_S0Ywc6_GH81w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIWYUuFU06wts6LcpAQFt_kMecp8dvIv642EWVawHEAQ&oe=
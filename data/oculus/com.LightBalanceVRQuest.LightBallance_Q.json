jQO0TDk2hwQ7kNvwHzD0W-&_nc_oc=Admjo_zr_OyAyem_5yxH15vFPUZcRW8XmtqlY6djZvCqtLwS-StOm9fSXfBvZ8R-I2Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOGSe5my2Y-OF6zD9IEAdRsyxSE2TfuOWgRf33nWLolQ&oe=69AAC3A5"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCtWXafrlnYQ7kNvwHrqPHH&_nc_oc=AdnTegeXEPNhrq-VNyERKTRG5Yfye3HNAQNbc4GNAXxTANNtygjvcSZkCAYf8g3XfvM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfybP71KjOkxIY3WgBeLty9EpROBrC6iZwdu8bnC69isKg&oe=69AAD798"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nulu0hiXipsQ7kNvwEPxJtv&_nc_oc=AdnqM5BRHia-0c4pzdcIJjXRgzUOGKjgG0jFay4EhyZ9mgJp37dbT9v9QprYZI74SWQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKqTZh_vQCiVnHKxdn2iAMbVyYlO_t-FqXHy4lDIqQxA&oe=69AAB727"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICFSCBUMjMYQ7kNvwGFVPJw&_nc_oc=Adlsttj4Z1dEoskxh6fdt0KnhBim7rGXe5qKPAFj_q6gtUZempHd3xQVY5ByCT7dgcA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTe18_5aIjnduigxedq7Pa8tMUMMsA5mFEgKh48wd9LQ&oe=69AAC3F7"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nS
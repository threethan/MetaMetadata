A92YqvvJ9oKjKU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvFErUiI9FTtmMjIW6le-n5WIHa3N_r7sREL9_IgKYabQ&oe=69A42C25"}, {"file_name": "3.png", "id": "206405808041462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031340_206405811374795_5436115296110214656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSuBcb11qZQQ7kNvwHsxS4J&_nc_oc=AdmftkinXdZg90L5KwqwlvkiG3ODK6TH-1w4n-7Kqo-BKjAGWqfNdaWy4mqnF1AGZ0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvPjwL1bBiSgd1kC0tt1J3dSxLJ1eLZPdaTDBY4Z13SaQ&oe=69A44018"}, {"file_name": "4.png", "id": "541109240354822", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974517_541109243688155_8018126785420571214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw8MlaGa3BIQ7kNvwFqnrFk&_nc_oc=Adml03eYlPgfDExjdRm4D6MF4jcHK2SuXSdE4GhqdOUUCDPnlYTaaNT1aEqeXPVA8Xc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvnb_66rGkzljebgmwANAlQzqt8QWk85_eWfUdXhR85aQ&oe=69A41FA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LB_VR_Cover_Landscape.png", "id": "553794682663932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982439_553794685997265_4352735320333939680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD7e6TbI4kMQ7kNvwFSNE3d&_nc_oc=AdlKLlEd52-HTUZ_ZPF6WQQjvPpY1t1JGA4CRpJiqLPkZPHd9Pkz_sW9QEyI7hmypoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuXHITxIDRTQ5iQ8T6lEj2KcgZxkZ4ID2GF5NOLJhJ-jQ&oe=69A42C77"}, "display_name": "Light Balance VR", "keywords": [], "long_description": "Get an up-close look at all your favorite LIGHT BALANCE characters dancing in 360 3D Virtual Reality! \n\nRising to global acclaim as the only 2-time Golden Buzzer award-winning dance troupe on \"America's Got Talent,\" LIGHT BALANCE delivers ultramodern immersive neon LED light performances that intertwine with signature acrobatic dance choreography. \n\nSupporting playback at up to 6K resolution, purchase the app to get 6 songs in 3 separate experiences. Whether in VR or IRL, you've definitely never seen anything like it! \n\nCheck out @lighbalance online: https://lightbalance.net/\n\nProduced by @virtualityxr\nMusic by @justifiednoise\nEdited by @channo.yoon\nVFX by @art.and.al \n", "short_description": "The world's most electric dance troupe, LIGHT BALANCE, brings their eye-popping act into VR, where you get a front-row seat to witness the neon visuals + acrobatic moves that make them the absolute best in LED entertainment!\n\n\n"}]}, "developer_name": "Virtuality", "developer_privacy_policy_url": "http://www.virtuality.la/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtuality", "support_website_url": null, "website_url": "http://www.virtuality.la/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359778635650037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974602_840688809903560_8339948250024871906_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGQlE4NCp1oQ7kNvwF9RLK5&_nc_oc=AdnfHMHJbtE21EWm4U7S8yMdpxdBoRlu_L2U1bm2S9dKPuVQaT9Tp9j3C-G1RVe4CNQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsDA8_aPhkqYziHKaLHtQ_-7-ykbch_gzhie1sC5PlonA&oe=69A44F36"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Light Balance VR", "platfor
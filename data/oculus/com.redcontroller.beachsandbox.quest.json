cdn.com/v/t64.5771-25/499622916_2284577338791202_5649043245175952367_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy4eCMGYLLQQ7kNvwEyJ8A-&_nc_oc=AdqErduKlDwD5yHaKP0zp70CFaIMzeMFE8aN8gc8XtsCHukQc5k3RpTYkTPhCUYrW7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVE1EKGSHnjYJAboC1CsQ5blzPjnnHhiLQ-8XTb1tZunQ&oe=6B0EF43E"}, {"file_name": "Sandtopia-131405-2560x1440.png", "id": "29397372449953940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593815290_29397372456620606_6215384534193102014_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLQH0m-wKnkQ7kNvwEb3R1o&_nc_oc=AdoHiNnf-OU1igYnD3Sy4MpLTVtDX336Xg9VeV0ci0V5ngcI3tarlPWO6lK_TS4---s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLPYw9_M9rh7YLmNV2PPfDqVPeIrr3nzYZi4KhFe1pbA&oe=6B0EF354"}, {"file_name": "Sandtopia-131228-2560x1440.png", "id": "1157842056901074", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626806_1157842060234407_8173321943764401424_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=273Lx4_enYcQ7kNvwGZOiq1&_nc_oc=AdreUGwZjOzaukWyDQINv0-b7tYgIr93eXi-T4LzYot-grKucMx3MOfhyOsst2FRtTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUF5LXz7Vim-asmf1x__RaANJ5NlOtTSYa62EeEYOrslA&oe=6B0F1A94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sandtopia-Castle-Storefront-2560x1440.png", "id": "1452164596990189", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626808_1452164600323522_4483735769167497655_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEJSDTTrKmMQ7kNvwEvggNx&_nc_oc=AdqVoN5Kuj_1CkIzGY32ZZqJnixG-H_895CGpu90UvGkjm6yx0Fjq2odlyu05m7_5n8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1-VdkM78x-Hl3XOKji5PemKWrHkjXwdMgKVB6rHZdAA&oe=6B0F1419"}, "display_name": "Sandtopia", "keywords": ["sandbox", "simulation", "physics", "cozy", "relax"], "long_description": "Turn your room into a beach you can shape with your own hands. Flip a bucket to mold a tower, plant a flag on top, then dig a channel from the sea to your castle. Lift the last scoop and watch water spill into the moat. Build close to the shore and each wave can wear a little more sand off the walls.\n\nPlay at two scales. In Tabletop mode, you can lean in to shape a small cove or move and resize the beach for a closer look. In Room Floor mode, the shoreline stretches across your scanned room, even into its narrow corners. Launch a toy sailboat in the shallows, toss a beach ball, or grab a shovel and see where the water goes next.\n\nEach beach has its own optional tasks. Build a gatehouse, collect seashells and starfish, or gather plastic bottles as they drift ashore and drop them in the recycling bin. Keep an eye on the sand. Once in a while, a sea turtle swims in to lay her eggs, and you can help protect the nest.\n\nStart at Open Shore. Dig up pirate coins or earn them by completing tasks, then spend them to unlock more places to play. Ten beaches await, including Ring Lagoon, Creek Mouth, and Twin Coves. Save your beach and come back later to finish a tower, try a different channel, or sit for a while and watch the tide.", "short_description": "Bring the beach into your room. In Sandtopia, a cozy mixed reality sandbox, you can flip a bucket to build a tower, dig a moat, and watch the tide find its way in. Play on a tabletop or across your floor, and uncover pirate coins to unlock new shores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1adiMU92Uh3ZYocBZ6k2DAwk6WoSwqkEVuX1ggmqmg4o/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "
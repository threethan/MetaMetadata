aWQSRF0HmZEVCa7h6l_pmI17zBnr7tao4Teo9RKVqU_syY9HyDDfwcRj4GFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHxYgJIMUJnTnS5PT4GsCUMcmGz6rL-GRA0W8dhxR44g&oe=6B0C513E"}, {"file_name": "Sandtopia-131405-2560x1440.png", "id": "29397372449953940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593815290_29397372456620606_6215384534193102014_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLQH0m-wKnkQ7kNvwFUT9M9&_nc_oc=AdqPLPS-zgpmY1dCP1Fu2ilPG8TbcI90e6f4_fSwAIB2rShO0tojas5_o8JUiSjz3D4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTb1TGJ-pvfaQzPQ4nTg2eBonpLMyRtRdfxVK6E65e3YQ&oe=6B0C5054"}, {"file_name": "Sandtopia-131228-2560x1440.png", "id": "1157842056901074", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626806_1157842060234407_8173321943764401424_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvYCxFYoI2AQ7kNvwGmuefl&_nc_oc=Adqp6PZ0pTfMBj3IuD6-M3SOfWz4_xl9KHOwZzmCipa_sucx1E9wrkj1N1bL4y-GajI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTK5hDRhuXz_FMNZXN4uFkLVpgn0Aaa99B831iXf3thg&oe=6B0C7794"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sandtopia-Castle-Storefront-2560x1440.png", "id": "1452164596990189", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626808_1452164600323522_4483735769167497655_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEJSDTTrKmMQ7kNvwFeUZua&_nc_oc=Adr9KxWjQ60P6VlA70XUqkKQjfPepk5aG5jQDHHa-d05xVd0pGCR5-4cl54O7evE1qc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjt5dG8RGsqfuANyaBIgIgF16PotSfP2ZVrtL53hTURQ&oe=6B0C7119"}, "display_name": "Sandtopia", "keywords": ["sandbox", "simulation", "physics", "cozy", "relax"], "long_description": "Turn your room into a beach you can shape with your own hands. Flip a bucket to mold a tower, plant a flag on top, then dig a channel from the sea to your castle. Lift the last scoop and watch water spill into the moat. Build close to the shore and each wave can wear a little more sand off the walls.\n\nPlay at two scales. In Tabletop mode, you can lean in to shape a small cove or move and resize the beach for a closer look. In Room Floor mode, the shoreline stretches across your scanned room, even into its narrow corners. Launch a toy sailboat in the shallows, toss a beach ball, or grab a shovel and see where the water goes next.\n\nEach beach has its own optional tasks. Build a gatehouse, collect seashells and starfish, or gather plastic bottles as they drift ashore and drop them in the recycling bin. Keep an eye on the sand. Once in a while, a sea turtle swims in to lay her eggs, and you can help protect the nest.\n\nStart at Open Shore. Dig up pirate coins or earn them by completing tasks, then spend them to unlock more places to play. Ten beaches await, including Ring Lagoon, Creek Mouth, and Twin Coves. Save your beach and come back later to finish a tower, try a different channel, or sit for a while and watch the tide.", "short_description": "Bring the beach into your room. In Sandtopia, a cozy mixed reality sandbox, you can flip a bucket to build a tower, dig a moat, and watch the tide find its way in. Play on a tabletop or across your floor, and uncover pirate coins to unlock new shores."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1adiMU92Uh3ZYocBZ6k2DAwk6WoSwqkEVuX1ggmqmg4o/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_ap
dn.com/v/t64.5771-25/499311606_753582007341466_3343332381865829873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usN_8auKZwYQ7kNvwGfqiji&_nc_oc=AdmSA9kJtLWLgjYSlCSOU7HyAD5-jKb3ozQzlUE7q-7orf9eq1DRxVXttLnq9r1t3bM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-egrKkA-P-lG4tmJ0zqkr41saksE0pM76gq5cO7XYfg&oe=69B1776D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1386256719329581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831273_1386256722662914_9059613037225242698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xRJWkbnqrUQ7kNvwHoPzvi&_nc_oc=AdnIQ8cyhG27sPn4t6h95a-TFjQtP8z-eFnC1h2kMIit_2LtAAJfWOMih9KLrgae4vk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5VNfX63hn2_U6EnP4anTgCtqkBImxDF_RMGGy_EQmgg&oe=69B16008"}, "display_name": "The Prehistoric Museum", "keywords": ["skeletons", "dinosaurs", "mammoths", "prehistoric", "museum"], "long_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation.\n\nThe museum has 10 sections and allows you to walk around and rotate the camera freely so you can see what you want. The doors also open automatically to allow you to move from one section to another.", "short_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null
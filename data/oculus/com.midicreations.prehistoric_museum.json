dn.com/v/t64.5771-25/499311606_753582007341466_3343332381865829873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdZPKcK1cfwQ7kNvwGaToC2&_nc_oc=Adl2UeLXsLRqny7fE8Vy1rBw8BY_r5k9fAX6DRJJXKYUeDyV9n9Px1olnkBvlHPKn3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfybcZOzhHh8Bnr3UgBlgEYCyY6u8tN3LcksJoSs_QVj_A&oe=69B6BD6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1386256719329581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831273_1386256722662914_9059613037225242698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uwWxVB6H68Q7kNvwGg9R1n&_nc_oc=AdlKLDPm2b1SlgXjFHdRoOtMAVSNlGZNL5WqKvN5_Ix9kdWL91Yh1mRCSm1u72T8CZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuJCWBkJzJSR9WMbTWMKptw9QbJ_lDRbxiBd2KRmhSuw&oe=69B6A608"}, "display_name": "The Prehistoric Museum", "keywords": ["skeletons", "dinosaurs", "mammoths", "prehistoric", "museum"], "long_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation.\n\nThe museum has 10 sections and allows you to walk around and rotate the camera freely so you can see what you want. The doors also open automatically to allow you to move from one section to another.", "short_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null
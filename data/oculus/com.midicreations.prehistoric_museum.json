dn.com/v/t64.5771-25/499311606_753582007341466_3343332381865829873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdZPKcK1cfwQ7kNvwG1pB8t&_nc_oc=AdnYgOJ4eXbnLIjKfvftf9vWEPymEK9QPgtJCdZl8cTzeCzY4X2DIGHyttCR1E2xVrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgEJgQ9SK7G8xa4-_tdUI0pj3Cydm8Xwaav_WtpXT7Rw&oe=69B80EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1386256719329581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831273_1386256722662914_9059613037225242698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwBZPYPEAo4Q7kNvwGq3TRR&_nc_oc=Adn2b4cAKCOZ3dMHKMga2R3ny5cqNSFt3QeeEojaLiVcjvA5lXUsZg2gAqttzTZTikI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfySbaBfDguJWcQ8BnPFu6HRhfe2dgLtdfx_bAqqgU-Ipg&oe=69B7F788"}, "display_name": "The Prehistoric Museum", "keywords": ["skeletons", "dinosaurs", "mammoths", "prehistoric", "museum"], "long_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation.\n\nThe museum has 10 sections and allows you to walk around and rotate the camera freely so you can see what you want. The doors also open automatically to allow you to move from one section to another.", "short_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null
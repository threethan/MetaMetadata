ot5.png", "id": "1792195198308729", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822828_1792195201642062_2826629175236162016_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxXvqwsDCaYQ7kNvwG-_4z3&_nc_oc=Adq5BQPSq834G2TTzw-BnZTzZnpF5QUsJCSqbarguYECV7UCEMgTe8nU76EaOPfx34k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mgp8ozezy6-W1eUbnVtDCcpJ4A7YGmNKNDqR8C0uxDw&oe=6A468EB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1386256719329581", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491831273_1386256722662914_9059613037225242698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJO4MmLmskQQ7kNvwHnhJsU&_nc_oc=AdrgrqTkvnqj9vdyCLb3jIFDvTvkPksHMpDaz_6oAhrXCC1raUcqCfqmCBCSkIz5FbM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OiyWWDC-eUdvP2AVEX13H1ZYDk7044OF16dkaIgFUjQ&oe=6A465988"}, "display_name": "The Prehistoric Museum", "keywords": ["skeletons", "dinosaurs", "mammoths", "prehistoric", "museum"], "long_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation.\n\nThe museum has 10 sections and allows you to walk around and rotate the camera freely so you can see what you want. The doors also open automatically to allow you to move from one section to another.", "short_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreat
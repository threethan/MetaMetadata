dn.com/v/t64.5771-25/499311606_753582007341466_3343332381865829873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_bNPE7fPqEQ7kNvwE92Omc&_nc_oc=AdnblcbNrTUdggiM4U5fT-PsXiQsw-TNb5bYXFU2iGm1gpf6W1r9YLku30DwYymDmdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYiPCRcGS7E3aAxr6IVJvj-Ma_6jycXUYS474_6dF-ZA&oe=69BC036D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1386256719329581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831273_1386256722662914_9059613037225242698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgUjhl2KPIwQ7kNvwFI-GHz&_nc_oc=AdnvSCfrz0SZkAaAWA_PjFGAC4y_1_QY3G-wnQXocNZOBgRBm4DxBKsUN4Hnp0hpCrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy9eVm2Zp3zvB6qMn9uA_XYw8u1fsMZgG0No3J8y-xfGw&oe=69BBEC08"}, "display_name": "The Prehistoric Museum", "keywords": ["skeletons", "dinosaurs", "mammoths", "prehistoric", "museum"], "long_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation.\n\nThe museum has 10 sections and allows you to walk around and rotate the camera freely so you can see what you want. The doors also open automatically to allow you to move from one section to another.", "short_description": "The Prehistoric Museum is a VR experience that let you watch skeletons of animals of the prehistoric era like dinosaurs, mammoths, aquatic animals, and skeletons of ancient humans, and also view their bones in isolation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null
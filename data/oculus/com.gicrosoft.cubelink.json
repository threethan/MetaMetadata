.com&_nc_ss=7f30f&oh=00_AQWPD5nmY6JrGE6xpEiMqhiqh1ltKYa6Gue0Ip5PNOx6-A&oe=6B0F189C"}, {"file_name": "04-three-color-solution.png", "id": "1658351355817274", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623558_1658351359150607_6999408481969326942_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWxeWQV0FMoQ7kNvwFGMUNR&_nc_oc=AdqRC1X1CTYFAZUyE9WdIzF3awwOZJuPTE2Zn2odwZsc71aSOeeUeGkoQdnsoobY1Lw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX7_sZdzklt_HOCa_ATTX_OHyGVAz4XI-rF56FqTq6Qjw&oe=6B0F110A"}, {"file_name": "02-first-connection.png", "id": "1182987941144187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_1182987944477520_7640072445662457176_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zgo9WOadvgQ7kNvwEiaiOz&_nc_oc=Adq-CQW2MyZ8mQvvokrVsyUm3xoYyAiotWMmYB7OjBeu4-C0MGd2YXGwpqAoHbdfXyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVY2gYQK7suMm0oXaWmc0YAn3ilpiXXzJFBQouNAVbfjw&oe=6B0EFD79"}, {"file_name": "03-checkpoint-route.png", "id": "1603121564355319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593887116_1603121567688652_6032678404008276185_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iydxf8En0w8Q7kNvwELtdcT&_nc_oc=AdqzS4vLcAGAG4fCcM944b_Ns4Q8MsBuamP2YTdRHmnNzH489HAjS22ljZaEQo5O_dM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJrXBVUEE_nAgkvsj5cgvI_5qniQe7Gxx8KjQk1KRf4A&oe=6B0EF225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumbnail.png", "id": "999367329356483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622188_999367332689816_7467903119304242241_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGsf9hi4YOcQ7kNvwFrD-Pt&_nc_oc=Adr0A6k9DthZ-FLVeoRVH33-lZ3F1NFYAQC44WMhPTdHZlaUzQRLZ6jzKmulxH0r1rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGjW7vhnFsSzYj8PGLUUMijIYDF9pB-p77rl-BvG3zFA&oe=6B0EF6E0"}, "display_name": "Cube Link VR", "keywords": [], "long_description": "A calm space. A colorful cube. One satisfying connection at a time.\n\nCube Link VR turns the familiar connect-the-dots puzzle into a hands-on spatial challenge. Connect matching outside ports through a three-dimensional grid. Each cell can hold only one pipe, and every required checkpoint must match its color. Start at either end, work on both sides, and join your route in the middle.\n\nUse your controllers to move and rotate the cube for a better view. Focus on one color while the other pipes become translucent, making the inner structure easier to read. Undo, clear a color, or use a guide when you want another way forward.\n\nExplore 100 puzzles across ten distinct chapters: coral lagoons, jade forests, moonlit temples, amethyst vaults and more. Each world has its own music, with smooth transitions as you explore.\n\nSolve at your own pace, pursue personal bests on per-level leaderboards, and collect 3D achievement trophies. Guided attempts stay out of the fastest-time rankings.\n\nThe first 10 levels are free. A one-time in-app purchase unlocks levels 11\u2013100. No subscription. Designed for Meta Quest 3 family with Touch controllers.", "short_description": "Connect color, explore space, and find your flow. Build pipes from either end inside a floating cube, route through matching checkpoints, and keep every cell exclusive. Discover 100 puzzles across ten scenic worlds with music for each chapter. Play the first 10 levels free; unlock the remaining 90 with one purchase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gicrosoft.com/cube-link-vr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Associatesoft LLC", "support_website_url": "https://www.gicrosoft.com/cube-link-vr/privacy", "website_url": "https://www.gicrosoft.com/cube-link-vr/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "com
72445662457176_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zgo9WOadvgQ7kNvwEiaiOz&_nc_oc=Adq-CQW2MyZ8mQvvokrVsyUm3xoYyAiotWMmYB7OjBeu4-C0MGd2YXGwpqAoHbdfXyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVY2gYQK7suMm0oXaWmc0YAn3ilpiXXzJFBQouNAVbfjw&oe=6B0EFD79"}, {"file_name": "03-checkpoint-route.png", "id": "1603121564355319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593887116_1603121567688652_6032678404008276185_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iydxf8En0w8Q7kNvwELtdcT&_nc_oc=AdqzS4vLcAGAG4fCcM944b_Ns4Q8MsBuamP2YTdRHmnNzH489HAjS22ljZaEQo5O_dM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJrXBVUEE_nAgkvsj5cgvI_5qniQe7Gxx8KjQk1KRf4A&oe=6B0EF225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumbnail.png", "id": "999367329356483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622188_999367332689816_7467903119304242241_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGsf9hi4YOcQ7kNvwFrD-Pt&_nc_oc=Adr0A6k9DthZ-FLVeoRVH33-lZ3F1NFYAQC44WMhPTdHZlaUzQRLZ6jzKmulxH0r1rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGjW7vhnFsSzYj8PGLUUMijIYDF9pB-p77rl-BvG3zFA&oe=6B0EF6E0"}, "display_name": "Cube Link VR", "keywords": [], "long_description": "A calm space. A colorful cube. One satisfying connection at a time.\n\nCube Link VR turns the familiar connect-the-dots puzzle into a hands-on spatial challenge. Connect matching outside ports through a three-dimensional grid. Each cell can hold only one pipe, and every required checkpoint must match its color. Start at either end, work on both sides, and join your route in the middle.\n\nUse your controllers to move and rotate the cube for a better view. Focus on one color while the other pipes become translucent, making the inner structure easier to read. Undo, clear a color, or use a guide when you want another way forward.\n\nExplore 100 puzzles across ten distinct chapters: coral lagoons, jade forests, moonlit temples, amethyst vaults and more. Each world has its own music, with smooth transitions as you explore.\n\nSolve at your own pace, pursue personal bests on per-level leaderboards, and collect 3D achievement trophies. Guided attempts stay out of the fastest-time rankings.\n\nThe first 10 levels are free. A one-time in-app purchase unlocks levels 11\u2013100. No subscription. Designed for Meta Quest 3 family with Touch controllers.", "short_description": "Connect color, explore space, and find your flow. Build pipes from either end inside a floating cube, route through matching checkpoints, and keep every cell exclusive. Discover 100 puzzles across ten scenic worlds with music for each chapter. Play the first 10 levels free; unlock the remaining 90 with one purchase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gicrosoft.com/cube-link-vr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Associatesoft LLC", "support_website_url": "https://www.gicrosoft.com/cube-link-vr/privacy", "website_url": "https://www.gicrosoft.com/cube-link-vr/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4596352513976438"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3955923327884172"}]}, "basel
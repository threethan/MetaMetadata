scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e-GhfqJgKwQ7kNvwFB97Fq&_nc_oc=AdqlIcnt4SuHxhHsqpPA4qJWkNz-ZYhYXGe-ZxFFAP0gQg8jzwv_DqW7A_5TEycp3h0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tGM1mVVrr9pdM97HXhbGHGsftqjL5iUaXyfxBnG3L9w&oe=6A12F121"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCxJsi10yD0Q7kNvwH0A3CX&_nc_oc=Adpd01_T_8vjFNrjpVtQJ6rMBrZbDLE1J_nXCHDxi6JlvK2yUlsSbHw0-WSlpdjST7E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EXr9u5aVsBdfEWX8FXa_e1p__xYEBH7_QbGcwCztt3Q&oe=6A1314B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KihT8Y8BXocQ7kNvwGcDR26&_nc_oc=AdrSmpCzPMsnps5hn6QQ5i4Tgdw_G021naBDfV0Ob-ZklG6D2T9LxJ9DPa3SUjKfYn4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52PZ5GdEG59K7D8bk3yYyP8MA4q7TG_kgi360jALWthw&oe=6A131040"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-RzRkEy-ikQ7kNvwECvv7C&_nc_oc=AdrpfLl0RJQnUNd2jRdOhNHRxhqqY-cFM_KcHlMMumZbtW_zitn1hN8lgXUDUVEPGRY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58kbFGhxVNL1mIomvhmfrpSszHONVxKgPb-rsrR7WSBg&oe=6A130C3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMyfD7W8Bk4Q7kNvwHYwfbu&_nc_oc=AdqZFUPvZ5xVTt4dPOFOGefFjD39OMS8S7y3Amw5v6UTFXUT4QOTCMqBWHFW-Ia4T2M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZDyrjLvTYrOF3ukOxC9DnuZ8pG9c7iCfeFx1eZHlHWw&oe=6A131AB5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXA6zx4NYWgQ7kNvwGZhUO1&_nc_oc=Ado7Zl9rhj04hSmwpJFj1HGCWdO0Hwl_NQ8kGTr-Qlc86xFIgk4mW4ON_JkL-f00Bt8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EG_WIOm2IbuAnRLLBLLFKyJIJdQi9J2Uy0x9H0hCWFw&oe=6A426721"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH3WKEY9hqwQ7kNvwHcMqkc&_nc_oc=AdqwtQW9KOiJ8oCPRevcCnXRP_MweZx1r9XoQnUE_Jv_NYtLaflTq6LlZXyQp3KJ44Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yZFqjSoXy_Ti_1Y55oX_CjYChrPSXU2gNY9Wq1fCAYA&oe=6A428AB4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhRo1yaWsYoQ7kNvwFoHH-f&_nc_oc=AdpNwmfwZOtt8Ancn886Pfu2wlBrO5Eqn0ucfsTaG8COyX4Nif0oDg8CkXYKIe1_hsM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aMLVTTYo0QcBPsOYKDhq-FGw4mtmpV1H2y4_NbT5IEw&oe=6A428640"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXceK2xEYM4Q7kNvwGQUw9b&_nc_oc=Adpi-0cxcfj_1eno4IghvywAZ3HdKmj3S_glfZ9nFoza18QuGcSsAP8rGST423UM7pw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jrQ-C89SJhJd2FFVezOJYwGVPQ38IUqOGDqKCDz3H6g&oe=6A42823E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9iHwNAxeZgQ7kNvwEgp3nr&_nc_oc=Adp5P6mwI-FlldjrchQmZcNcSghRD6-9i_JF-GI-O-25Y03gU52MsHV_0Us9xmixGlQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BnXdtcKAL6rRICpge3znNDh0dLJkvHEtQGAMXC9IPZQ&oe=6A4290B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
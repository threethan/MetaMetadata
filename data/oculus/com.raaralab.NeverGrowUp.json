scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Dv1B8O5kK4Q7kNvwGq2Yrl&_nc_oc=Adpu2DW-5ch04gOs1e1OLqe2M5lf6nQEM08E-E8SHVa3FiQR6ztce3E6PKy1WwU9Lf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m-aSXD1YBjkrMniMZXf8NhTiuapXNM4nSpxZy95CsBw&oe=6A3FC421"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKZF6cwaRjwQ7kNvwHG3mce&_nc_oc=Adr38JEqFWUqeg6gXnXGLLS7y6ZWzClO4jP6OfLHHMIToR1aOLwlV8KlophL15-axVw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g5PitD5uMr7eVNRQOieA1ZSdmvSGQGg1kvhvXSNxV9g&oe=6A3FE7B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nIT8AmeCRYQ7kNvwF0PnKG&_nc_oc=Adpw3CJIeowf2pn4GQM3Qonrpdz25xfUabz8ddzluU-e13T1x5UymCLVrVnjnRjn20Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zwyckuwYkGXdSRXBt7LrzMso3k496MiK0s8gMK24VZg&oe=6A3FE340"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qmmdy0mYFwwQ7kNvwHTNv5x&_nc_oc=AdpNbDkiSEBYyQD2mY97Rvpzde6raF9khB1WtrT7Sw5atTfFVyJxOsNr6io8YiL-uIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Tj2t2dGjnJMOkuKr5vmOwkSEB4fchBNd-kRPbXNO6KQ&oe=6A3FDF3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAk5jpp4zhsQ7kNvwGthoXq&_nc_oc=Adofe5oEHgkHpPOw8sQ3jvYpaL9mFTN6BqebOL2JBniXK91L7lnElQ4hpngrFMHvxNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-14dPgUPAb0X4KYHXrJISJ6SPxJZO9SEnkHclFRgh-Q&oe=6A3FEDB5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
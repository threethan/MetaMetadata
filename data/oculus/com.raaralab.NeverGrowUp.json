scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVMGI40sE_IQ7kNvwGak7Hh&_nc_oc=AdonuCBdpaVXg_vzMitUF82ezlW59gFeNm-QrdXQL3Rp0z7FFUEPmP6p15MgCgo8nhQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnyY4ZFr74VO2Hg6W1O2gzn9FqykUtGrgzYPg2aRVDxw&oe=6AAD30A1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PxjZ0hAUXQQ7kNvwEib-C1&_nc_oc=Adol0ut2gA7u3lPW4Fn8iVzQZZXWQPATWWLYesG1Gx_aLM2UqoBY64r4bsAqieU_ZLg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-24aVhH8lygunWwMEoUuaWnchzKRj_Npp-aD7wCg9og&oe=6AAD5434"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kPaVSaPidgQ7kNvwGKf72a&_nc_oc=AdrkY53e-6PO7RS_p_HquVfiSp2AexfSEWdArdGhJPqnUgUch4-n6jyBgpBDgjsYUf8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxJOkFO9fVAD9fdOP6J7B6lU8y38Gcc09PJocixQRpyg&oe=6AAD4FC0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pBc5P-rdzQQ7kNvwHMVdA-&_nc_oc=Adro12HN7D5GfjwanPElKuMw45qwZAx-DhDuEeVBpwj_WDJL0gIuhgbko2USO-3NkPk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2dkUuz8Dl6Q8GT9bKnT6BnrF0tRhqYpx4Al0DrS4rew&oe=6AAD4BBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO80CeITZpUQ7kNvwFWWpOj&_nc_oc=AdpuOez7UtLOgZ5eVcuC-rFhNLpMWVvH8_Yb93YzoYiohRObpai0RZVLDh4UTMcJvUg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUW-cmXXSWy6u5psuDjJG-RdUHv42uf3XcbOx2qH064Q&oe=6AAD5A35"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgqRb2wu4zAQ7kNvwHiy4-o&_nc_oc=AdrdxCb5ogzO8kxOZkSCcQXFaoeTeJ86je7kzdeIReuaIH-Hai40R_wS15lDvbSRiAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiTkCTIfWQPb-e4pUcuaasP-Fnq4xMgUkHbAcxlzgHtw&oe=6A4A5021"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1nDhZAK7R0Q7kNvwEYjocC&_nc_oc=AdrGj4O1bpvovgahs0ZZlEq3j_Rcq6_l42j8fSQGb7lOAQHohD7mH7AV_wtHHkTn-as&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfdndB_nReq4r7KR4pXAduJsMepctmgp-8Dq3rVTesWw&oe=6A4A73B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi_-H-jfxMUQ7kNvwGkaiPw&_nc_oc=AdrmKDjVaWiWmXpkzlsb5NyVep29i8BBWk6ydjWNupqR7cxHM-h5pjm8rp4llrBvp4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4Yg6pmTV3SajyRUauOKy__Ub37q5kAokHz4ynAuqUXQ&oe=6A4A6F40"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YENPZF6hfOUQ7kNvwHHg5cH&_nc_oc=AdqH6ObB7IzXTBdFPAw0pQ-y88Fi9J1zEm2fm2UG1-tjn5AFoJsEEZ98MtdZYonmQjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbSKMa503DuhBm0_klAOAt5T9Wq-6opjJURu-7Ys9oIw&oe=6A4A6B3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrgZ73Y2Gt8Q7kNvwG7fksA&_nc_oc=AdqSViC11IbMnQhCZ8oLUsTW6jMwUjFAhLDkEmUoNGwKmwkCFi6e9d5oj3cYIxWg8K8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHUANwNMaIKk1fbQSxoFGxO7CQ55d0ekF1NUxE_uFFow&oe=6A4A79B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCtfqA8MkawQ7kNvwF_6bia&_nc_oc=Ado2FxWqfZQls4Wx6b3Jm6w73WjZhbOUxQrZ3GSrZAAS8N0RRqFMq0fWTO4JKqrMLYU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vgjPB9MP35gZx85ZXpBh_-EQhvHvnAarK2FT8a1xKQw&oe=69F49EA1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-S4J1iWFDi8Q7kNvwELNiZV&_nc_oc=Adp-7NkbyP1zy4_T25nQBYN3CEsAGnxezHbEDHXappZCPYHVEqBTrghAeKGfBRyFICY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1peQgLnYxPwbj-ZAf9zY0_NY074IRdNCDfQPQZlx75wQ&oe=69F4C234"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQn56kJxeNMQ7kNvwFsIjaK&_nc_oc=Adq8yL2x2KYRARNfGrgbYwVVgQYYyzHF-4I_lKGJ-yH8vMgnH2NypX0-a3CTaFpVhl0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Geja4EZ9WY0Q6NztI8TVNnisZjjXeMCzG9ePvfkI4Fg&oe=69F4BDC0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYe4dXAYJRMQ7kNvwH6mTOd&_nc_oc=Adq5h0qPTxogCisu4J1DEMMC1rvdVgwC8HMOzFx0uQ1lGVT67mwp-NqeB7oCGv1WtN4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-8TZIC7y21Zu-b8TkECA1o9ewS-3ySGFiTJq97P49IA&oe=69F4B9BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0i6eLaHw2kQ7kNvwEIoNTO&_nc_oc=Adr7skcJUkM1qPfCBq-yl8rjcN-53Pf5dE386hpNB9vWJ7bpSTffhXfr6lxdUdUITiM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07HIIeLWAOVlkUIWxkejPvt7NdAdu-T6s2ABecRjPiCA&oe=69F4C835"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU299HMvZx0Q7kNvwGExgAj&_nc_oc=Adq0NxKz4z4gA050ZruZ7g8fFlp7ZIEcea_-LxlDa6rpzC-GZD_bRsT_pBRGC3irNVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7kWqrgR-3qhji6Gli_768oLEmKlKt05zq93O_0PXw8w&oe=69D10621"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TU3CCt_Sy0Q7kNvwHjYJrF&_nc_oc=Adqi7ia-Zuwh3TJcMrIlA4prcGxklSQj-R00raGOXtL3GWbMYrH_ix8_oSHKHRFmQA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMxsEQuT5RTNF0L5iIGc9i0Gs1CDocYfPwhf3YFrp-bQ&oe=69D0F174"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV7jMRujgaIQ7kNvwGMc6Gq&_nc_oc=Adp4L4Rv0NiJ2XBVsWcIpI5FTFsKgKDA6lMPU92h-L-1nLYKnxSNLB0xOHZaPjYjDoU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtMV2iAKLbTEmCygtaxrwzKP7FKLRXBY_MJjHErCYW6w&oe=69D12540"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1BJyuGZ9BAQ7kNvwFDaoQL&_nc_oc=AdqiPz582Qmci0stS1PSI_hAhiJOlJsd3KuMpznB9t8sjaeYBw80lSJGjQUQLpX60hA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNhY8y_VfNJc2_yVf4Eobsi3aILq9VIt5vKPGCQe9_qQ&oe=69D1213E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwbI33lzHCoQ7kNvwFzXyBW&_nc_oc=Adp9rQlI2_zFnRr50JdIMV-JG3PDrzVKlf73PfQRRXtZdUy4DUQVMEsagd4L-vi64io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxebZrrNsfLLlUB5wNJn5q4za5OV47AgG257QCC0vON9g&oe=69D0F775"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
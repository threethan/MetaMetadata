scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43u4DWOOV1YQ7kNvwHDKdoc&_nc_oc=AdogH9cwWmpPLMc5xZOQYZbAc39tIrnIDwnfYrsn9id-RwCwBkmR3NMIcxL-l1egVM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5DfUhTyAKMxi07In7WUKp0DFD9ftW6zNepnd_SshWYg&oe=6AC12F61"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE2zTKeDjGUQ7kNvwFDqne1&_nc_oc=AdotbKoGkLGvtFBo8YBf_lgivZkrw14sp83XRiChQw1dBE99oSCLPntBwTpU5HYFzfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF5b-WYJ79GUBXTy0tIOY7MjPPKttAwfYNEaPjkCAHuQ&oe=6AC11AB4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwLL-ROAgrgQ7kNvwG5rp8U&_nc_oc=AdrBUER_HlrAnaNr0iDHh7xhLGv6kShBSLlTDodze_bpMR13Wa_fT6EzJPayhh0QKQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1lQbrVDSiRw-Wr7JiyzDsuRZ1WCCFEyfzGVq0JRAPAw&oe=6AC11640"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuElOk8iRY8Q7kNvwENz4n1&_nc_oc=AdonoJ3ywqCSxdtyNMOkaJSQWnz6_lT2aCHZ9KCeDBIKthlBCCt0c2jLEiM4i1Lc7ls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQwEr2iKjxGpxxeZ_-p8ipouGZCOBKXjrWpzuCpgTj3Q&oe=6AC1123E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBDvWwBRys8Q7kNvwHo66qi&_nc_oc=Adoxa-6kd8k5CZT6VnBm6KAEfd3wNvrl5UzX_piX7I9gn4o1N6_y6fPZd1EemPQrCdo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJnYbk0Q8WwUTr97UOkbpGLjKJFivQa4KkVDoo4IGoSA&oe=6AC120B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSCVZsUT7W4Q7kNvwFsS8bH&_nc_oc=AdpPf5_rMseAa5k7Q-HtdaT371shZlf9jhj7fA9QVEhav9Rcqbcl60WG88Qj85rFLb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCwCdvUOa9dPXzFoHgRkVLeJXrYzr-0HlC_h9lEhVgQA&oe=6ABFDDE1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE2zTKeDjGUQ7kNvwFOiQZf&_nc_oc=AdpJORGHB-VJsQHyLDpnVr2HUWI3u6WePOFNaYncgAPXDndMJsLlf_-wx4pq-OQ2mXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTt4hX2gRe6Bw9HXh8CY8k93iuPs-SwgSpeeXOyYgT1g&oe=6ABFC934"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsUGG0bVjCcQ7kNvwFgH4GP&_nc_oc=AdpWQSaOgO2-Gw1ZMqMiRacMZ84vo6Fmqc4B43gHAGzjrnOBHzNwxwHGthR67rClsgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ94QXmsYiVIMVDc6eJD9UeQhOvvBJbNRhbnqlkD9clg&oe=6ABFC4C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpdM6Af5l14Q7kNvwEZPz72&_nc_oc=Ado_Kq8BFFf9VSPHjsJA4LU4FIoNyTcPMNca36r6BzRyar7ECKFavViRlUqfurKM9Pc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvHzOg0yPf9cBfZgqUo1BG3pMwcwqac_zBeb_jUR8jsA&oe=6ABFC0BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBDvWwBRys8Q7kNvwFdv64K&_nc_oc=AdpOHCjzod37YXF0JEeQG784SHY-ygdXxIwNIY9ArGuA1Rab0v4JJaHCjNsf6fRiz-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQJYL0xEWZNn_nUNp81FBs12pDARMczlh-54QB7YykiA&oe=6ABFCF35"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlmNBk_cRnIQ7kNvwGwUeLR&_nc_oc=AdqPMntgxbR7QO-avi407qnWx1JRcXQL0AmfN3AWraM5k_vd_6G5BPRALW47qNGkyhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mSLexSnxFYQNxGbWPsuanUUIF8AAmQlJREGn_9m51Qg&oe=69E0D821"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt_Ndo4qFwcQ7kNvwF0Eoox&_nc_oc=AdqaOSMqmHxCB1NvvqHy2TRGApNu2K__fVmHHGz4iI7BnTziKo1FWsPrGmMpKHacqJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GKy9bw8-tbeBHTwv6EIjkSnn9pAirOL92V0rpV0UjZQ&oe=69E0FBB4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KNtFOfoNQQQ7kNvwHhp0x9&_nc_oc=AdoBWw7PTOLUxFUyy-vE57pHhysiR_kPv4Ikic4BsNH2xrsHpbZ-QVIMQbQHWGIfpR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tAIOnDbVSANafsv748LCCKXmL4Je2_cJ2KJVoPHR3uw&oe=69E0F740"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qff-i-eyIccQ7kNvwFJbsvN&_nc_oc=AdpHic_TLQL_fPH9zEdXFUsPlTbYDuOYqBosYUts0DsB4bGWBTEQQN-CcqyoER9pedM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oVNbAIE4L2pPkvw4C7z_1QUhasAkFpaRkKEesuVDIjw&oe=69E0F33E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEPFSUjmGA8Q7kNvwHue90o&_nc_oc=AdpDLlEzj1_IN6hsvLf8zL6acDU3HCqExpswgYnaVFExX3SLq4_cgOII5IU2TX1bInc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cJT5F3HYj4EFa07YcZFvI78-a8W3FtAyJfVFpRMukBg&oe=69E0C975"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
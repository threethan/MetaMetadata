scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyB0AYhHU1wQ7kNvwHb2Nxk&_nc_oc=AdoHX_30ddS7VHAMhwd98jki8j4gHlVIDGwMz1F2jnfsoh7lF-nB0MvO20VuUwf2whY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7slT8E_4q7UZZSQUcbRGPKCHqJCeTjKtbCWEm-NAlQg&oe=6A64AE21"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqGpXfiRnaQQ7kNvwG2ysXU&_nc_oc=Adq-TWnrvfhg2SCQ4g9ve4LmES59HX5B49EmTkLXR7JyJLm7rVbRYU82VlMJxNN8s_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqiDtbMwTqr9niDCB0-x05T9Tw0RT_YJRVmu4OkIU5PA&oe=6A64D1B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4X_b7yBS3MQ7kNvwGqYA50&_nc_oc=AdprfUF_r1u-1JY00TqMroKtUafNKxg1iBLb5_fWskKJJKCFTSMR7nwxnkXwFWd3aEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_sEBQ3j5x-qHdNAoMj29wS6qZ2L93bv5glVaeDUPxAg&oe=6A64CD40"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFUri4hTMVgQ7kNvwFp6Cb2&_nc_oc=AdqYfrz4zwZLnUBYNdw9ZroO_zdM7v49ZGkkcHwZQIe6ZwoFNy-GrTnXR8tD-EGeCLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0zS2Od9PiCJSUFl-uL-Xpp-J7Jidln8odW0Ufs8T8DA&oe=6A64C93E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_aOA5VA_ykQ7kNvwFw3T8N&_nc_oc=AdrydABcVPAyOuHQFuej3AuzSvE4O7Nxm8lWPrmINjMCzoDaxug4609AeNZtNF-kjNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQtgstmpCtvbw5LgUCoj_JniDULhLNzH_Q4ptbgmQCJQ&oe=6A649F75"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
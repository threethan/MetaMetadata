scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rtvS6JUR54Q7kNvwH0eVJj&_nc_oc=Adrl2ccUp3J1bRCQ5bQXt-dAcDWRh52TVA4Oqqd7Qu03y3hKH8JLi8LWNl03gFBp_so&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0gjlvwq9PvgZ8PZn6lf3ya0nvQNNetfQPCHdwGub1_w&oe=6AA7EAA1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhixkgmwiHwQ7kNvwHbQtA2&_nc_oc=Adr6YcJGirenPOUlOXwv2L-ZCufIpexb4-HE3ANY4Xwb-8A33Vm2ycBXaNGtAS46KzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYQLoJJa5cQAfhZs_H12qFZdk-k7Y56NX7h-TkH3OMhA&oe=6AA80E34"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXcQT_d9hJAQ7kNvwFGIigm&_nc_oc=AdoeWyV3nCQzTM7Nf1fJ3YFykLe_4fm1nppBhKBHkjCw8Kz86LOxYs7H0cOLdOpLNQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO4fThRxsFaxSEHhMd8aCVBMRZWh9m6hB2Tt7VmrgcMA&oe=6AA809C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub979aHdwY4Q7kNvwHowrl6&_nc_oc=AdoIAZ9ZvSm5qT-dfFO1CjAR22wfoD9OSdTQ443mInJ0jQseLmP1sfjT3EMZfr5VAVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7IyT8CuY0_ar802aB-Hl08ZQ8YTgYP1CxpZCljQp5-A&oe=6AA805BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xrUr2BxCT0Q7kNvwHuDMva&_nc_oc=AdowaQCoqx2kO7a2maO_w2exuo1GRK9d5f_c6avu3tPJLdi1RamsP0NauxXGPKbk_Pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvy_yl6ZFzI04j-BqCAMWAQ0hBMIknKv0a8aox5JGt1Q&oe=6AA81435"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
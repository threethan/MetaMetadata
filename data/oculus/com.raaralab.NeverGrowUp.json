scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v79iq6mr8jcQ7kNvwGBfKAt&_nc_oc=AdqS6Jd32--WSrm_ZKUG1eWmOaXScIIzjNqH_yLceFTsK89Cq0lTG3p7VnQqeJZnJRs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7e_tiW7dDLGqC-XbD1XR6eTQkELef3M7DIYBeIsEYIQ&oe=6ADCA6A1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDkkKR9s1bAQ7kNvwHA-EnD&_nc_oc=Adq2YVPBUUz3lz7GtK5K4vPAGz7ZaRQ3eClBedeQa72z3eM592XA_0oKERpJL80NriM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxcB053TrZBzJQHqyyc0-xBGbt0pzwUq-g1wByl2NR4g&oe=6ADCCA34"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcbzZH38YzUQ7kNvwHQ-Q1F&_nc_oc=AdqfwTY21f5KzizS5RErDzBBCdWeYwZbSSqusrQQ_pqGkM-l-pyGKJfFQzw-pS4HrFI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFXDWlQyf7EGK_qXj4VG4jS-4ACxRtRx_Z2nIuu0kARQ&oe=6ADCC5C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7Op5apulVcQ7kNvwHKFdgu&_nc_oc=AdrPAO0yTThNFOwi-n9kh3LzwbV2tGFLzH61qqz0TZV28mTh9HK8qVcc-6AKE1rYBUw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbEZgPa_Z7BJ1YG2Gaqzeb5V8slIG0uh16F0o3vbA1Sg&oe=6ADCC1BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb7UVrufCRcQ7kNvwGS0Ww5&_nc_oc=AdrltMK5LMJBmhdgY5uDauGAw2zkjyHTyZJp5_TRY7dvBXbNpPBbBbqUGrzSyYm56zI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN46hsiU4uIn9S_W99RbED8-hlo3uQx61TyKibiZSJScw&oe=6ADCD035"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
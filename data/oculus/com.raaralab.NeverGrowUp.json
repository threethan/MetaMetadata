scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCHuuG4ab7oQ7kNvwHlOQc_&_nc_oc=AdqcEXRkaQvRYUZ6Rnykwnq8n_Ncct1f4kiLAO3d1YGyoNy1R0q3Ab2OgpsDrT0fIeM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iGAlloBDk1pgFQ8X6ki2c2xW0hhB9B4H3s-HSLevf7g&oe=6A329521"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSEaNFk61-oQ7kNvwHyURkR&_nc_oc=AdpMVBzR72wsR3jXm1_p6W8Srsi75bp9E6Esj9K78dw99XJU0nDihFjG2YF6GmGxyyo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lt0yoCnoGzHZ6ruHDQOz75p9fplp9MWuwtHSSTPwqJw&oe=6A32B8B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKl1ajgX4FcQ7kNvwGCJY7w&_nc_oc=Adr5FAALUHcSTFoombn1cPDJsOSHNjzV7z4rwwv4azWmWBo_eF3Lzt0KBzd8PLIr4Dk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bB8wXhhDESFTAXRWBESz12Vl-H0V5WhDbHJBI4l9HhA&oe=6A32B440"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb6C_R0tB-IQ7kNvwGSMF2Y&_nc_oc=AdrdDS9Tg2Ea8Gp6qGUP-Y4yLz9uCNwf-mQJtgmu9FLzp1REpIgpUhmNzGgpyLqkKY0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zEHtW0x-MuKnqpdLI4b9fOm9H2RFiW-E79NEzndD4dw&oe=6A32B03E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aivUiK-ojrEQ7kNvwFEu2kh&_nc_oc=AdrsVbXmYsWPrVVCAp901dph9FzX9D7lFswPE2uj07suQ8iqi-1iDgdu3o4bDLUT22c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99ChiObaUew-pvT031ENNO6BEx2n9HDvX5FmAhKJXu2g&oe=6A32BEB5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
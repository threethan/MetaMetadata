scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5c4zmSpmaUQ7kNvwEipla2&_nc_oc=AdrIrfOhnjgaW8gYQG8htb-xazXglY669crf2qVGSZHKbQLlpSFOYeIscAr13SHr2EE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w78VIWaOaoCUYkeWr8S7i5IgYSBzn8u0UyL73gqeBig&oe=69E76FA1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR3X_xVWB88Q7kNvwFyAGzF&_nc_oc=Adq190juFbrMAA6DO0tIK0uQwA1KsrhRIyBWharBlnIhR6IDWU31KlGo26SiWgYI6Yc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gAhYHHpbZSI0QLYz9pQwrzvdmnXcHxD3F4-CW3N62RQ&oe=69E75AF4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmYwaf_1RlQQ7kNvwEW2rIF&_nc_oc=Adr9C4XR2RFZmS5kzUFIkyK51kWWo29fwghOghluPhmJHug78caCc0-FrP3D_Cre-hM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HyVOYL8WkX4jqxHESihR8qcdPjtl1XBnaIAfxPMU2mg&oe=69E78EC0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caaEBhFkZXoQ7kNvwGC_DUu&_nc_oc=AdpKt_WtlNoLZPkZ2XO4myVrUQJ3z-TXTZH2XHqY89N5BY6rNhSZc_HAah0zwjS5pNA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J4NV0tQc3uBlYQ0g6gEsSk75k9RzniXFwnQTBv4pw8w&oe=69E78ABE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuIaFOCem10Q7kNvwFRDdHS&_nc_oc=Adrz6Q9AZyLt1UPFPKo-p3trABf6Cz4DE-MpB3XwzMytZvMfZwSG5ATzm8rClx1jyO8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38q8KnyKDPo2b2j0I6qnAqSo4RQgu9yXw1OaNaEOtePw&oe=69E760F5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
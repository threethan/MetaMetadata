scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCtfqA8MkawQ7kNvwEgD2pl&_nc_oc=AdoXXP2LTboIRWL9AmvTYQJr7UgQ4NHs9EZqrtdHM5KqQrkMhw7S1gt3sTiga-h9_do&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LYafmLkf6eCxE7yAOHFQB1j3mjxM6mlEwHMnwFRK6ug&oe=69F5F021"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeR7KSpFSUEQ7kNvwGTjMgn&_nc_oc=AdrH4A0X7BvVrB0SB4bLyx2AHDgThiy2IE9nvI8CVdvfh22ScrRlXE1GMO-hl--NGcg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KWom0mWe9r7Zk826GW_tNKYZHs6iK3DH6iCFEZFxkng&oe=69F613B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQn56kJxeNMQ7kNvwHqdvqO&_nc_oc=AdogKQWuufaKHvN-cwjmArTqnoT4fSi1VbOmc7VYmhpRXzEYEtUiAV-fpB99ls1qy3w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06F6yvMc54jzsl9wrZEDLv0lvzMkuh5k8H-vmmdwZNGg&oe=69F60F40"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYe4dXAYJRMQ7kNvwFOGZPe&_nc_oc=AdoXUWdY7xYeVWb1cXr5vFLZLZHU0jO8Vwaqm6TvU_UrJdVBCl8ZWEqvkmFE2UZOhqA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YButdQgnwO7z_DFt7ZWnjwHT9gDuoctop9m41JhUr-Q&oe=69F60B3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XUYkXTqzHsQ7kNvwE2MJ-E&_nc_oc=Adpw5Ft3o9UhpZHqbnKEWLaFuVBK20eMxI_jKt0c20gdaCc5-PziIri3huCFA2p3Mco&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2E7vedmXtDs9qRGxywbx2Ld8aS6m2SlP6t9_iYzKvwrg&oe=69F619B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
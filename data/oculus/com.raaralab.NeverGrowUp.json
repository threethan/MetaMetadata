scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEUBHRtx_TgQ7kNvwHi9iEP&_nc_oc=AdoId1LUcly7SNZpqIB_N0mugxhDSacrfyRLhlW7qw-LFvA6_zf6VRUFMwdPnyIR3k8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI24nuqnbgG8eHT-0A5x5dBaX-kI08Bq5pfvHayXs6sQg&oe=6A99A261"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNgzIe1TZOwQ7kNvwEe9Kx4&_nc_oc=AdqrYQYfqHUw-CKZ2WAdpZIJKd4LnKz7ZKXRNXEO-wEaHE5KPOHJRldGSOoPM2IAEbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYD7EmWM4HL3lr1kZ2zVXlOEtGu0mTAHyfr2KmFQotQA&oe=6A998DB4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O7c2W59sIwQ7kNvwElnAhv&_nc_oc=AdqorayXG_0eNv1Jx58n9-ccUSPvBwVitkbm7mioHJAo6Xr5cRuHjV5zY83-Qf_kwE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrUlJ52hm53AYyhnW-kJDMbbxNrVDFRemtKTa-BZsJ0Q&oe=6A998940"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uxsEa8uDXQQ7kNvwHu-jPx&_nc_oc=AdofB7KETsh9BUh6ekprVTgaVPDIgOqXOynmf_a4wOC_YdXNdfSFxfxDZe1CLTeec38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk94Gt3_o5qOJeWBiYv-DM7eMgyYAqgqK4uQs118OW6g&oe=6A99853E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyOY-kCrnyoQ7kNvwEQD3J0&_nc_oc=Adrv1UFdIMc6WQgAiIrEB7_0PUx6VbcSrWHVbri4dwhtsoIb5JB6-x3ifRMrxCngCy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc6bBhg07YI2XR5OS4RDHbD8Q03fW_7nM_EXln7SRQjw&oe=6A9993B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
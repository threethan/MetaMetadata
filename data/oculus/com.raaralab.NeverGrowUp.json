scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e9coCUnb6UQ7kNvwGKAazu&_nc_oc=AdpbEoGPxJMZQ-s2Z2t4G6FudJDfkUmbEbaQsIoP-RUh7YpJZnSRh5heT2Pmmm0TuQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdPsUpPMl66ozNgu-EsT8fKwanAjBwgfAlxr4jzMG1sw&oe=6A523921"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4qI-BJ-9ioQ7kNvwHySkFh&_nc_oc=AdpQJYs0RFDs62HG9de1Tzu13scVF8_0uspIcJxs0jqcP2X-QdkCG65EtoEhZNZ5Qps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqevwH4MqtAX-pGuyQKAy_wA9aIPVHsdcD29yOQDMwFA&oe=6A525CB4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J82_GURvlJYQ7kNvwGZ79Vm&_nc_oc=AdqPKS1q1x-WOUM4oO1ed7u-xXFn3ERz44jUE17Zpx3eMvZG4tpNIN3XscM2ix81a3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa7t-7Q9bJ2siYJikErQOxhHwPw6vVwByECWLWFO9rWg&oe=6A525840"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4GEetJ2BjsQ7kNvwE6_ZNA&_nc_oc=Adr_DCMKcA4cshjHVmlteeP-1nZVfaa9evYi6xFcWr0R7q07Y_Uwy3wEMs2gmpG5hk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi1GU47YYyWx1bEQ2wKCstJH1dtZlTnLMqLI9jYq9AvA&oe=6A52543E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCvn9buxH8YQ7kNvwEqwh4f&_nc_oc=AdqTurel1sSkE0hteu8tBFLpw9c5HFGoQx9jSXLlzSAULKyIrLOaGIiFbMuNvHUq22I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmIrg_A1W9u-XGpoE2PxAyeijhMqzuH5kZeIQ7qQjMsA&oe=6A5262B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
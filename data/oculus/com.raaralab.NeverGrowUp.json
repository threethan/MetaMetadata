scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1rSXAIL6zQQ7kNvwEu1k02&_nc_oc=Adorv-uYG5KpdLOl3PFrAfk3Fo9bpcPRhPrQUiVA6okFP07cX5I6qT7RiQBcQw8vzRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7b7VnhFDgNzJ5oEjSejwumjzxkdadvQLBUVj3RR5rmQ&oe=6ACFAFE1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr23Qh6b5XEQ7kNvwGeBrR1&_nc_oc=AdpoNaipQBAc2MFwUq16zuwb08ecg9sn-g8sxTg5UkQGX6WqFtkPsGmVy-LL-Y6W0Is&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8iJqxSGrjYhu476dlR75PuLaykv2GpsJpIuFywiKl6w&oe=6ACF9B34"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGHyIK9T_f4Q7kNvwFD_GDX&_nc_oc=Adpm0pue-qsQmtqu-_uK6nr5lg7L0hO1LLcFZJIqD2T81J-EbvX15Qdo1KiyOyET2uM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtO3aF_iiMXp1DRnEQw4NO-Q7bMIyARGnBfZxTdLl5eA&oe=6ACF96C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxruTI47vtwQ7kNvwGq9uQ3&_nc_oc=Adr5DJV3OxrOw_5CfP5dNlq_5KU2pqobC2_edNj-E3aWUkBeP8UEIFdfjN-biIiN6ZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJjhR8ACDefudQtpUuS1dsCZlU2QEffLCi4hKts4LdxA&oe=6ACF92BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKuVi3v6UJkQ7kNvwEiwLij&_nc_oc=AdpOfmJUQIbHg44doe3XPClFLb9WXiJgwv_Aj4Tv1cr7WPMb5AsXrmOdMlBa-nlNsYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNeEUqkdjb8m8w8aFp1s7jsQA1yHvX2Xj0qiH6M0nLog&oe=6ACFA135"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
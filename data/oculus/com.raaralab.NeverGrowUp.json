scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci4HNYaPaNYQ7kNvwHfihaP&_nc_oc=AdpBibRZolqx2OQuuPap8HVzkycy1TzRP5yHzUfV37aIAA9UHb0InTGI151ddW-a2UM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kPYONBUklSOT-SyfTjTwAifDT6TCO88e8BYrBEpZurg&oe=69DCE3A1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLzyL42r3UEQ7kNvwHJDvkx&_nc_oc=Adpun84D4V0aDo-D4doROV_HDWTwGJQu9X8iI2IxbOzwqbwNvpgrY00fe6M8EGLbBMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GcT6nuKSWABalDCZTPB3UUwzt_8WUYwy-Du9mcqOotQ&oe=69DCCEF4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KTY1rXWIMQQ7kNvwHyuKml&_nc_oc=Ado-imIa3IBVax1XEkWZ0ggO7O-Rvkg3OUOV66FMY7BmsWgajX9WAnJuwvVkeEUKgx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kRf0VGdpoyCNZQ1nx7DfxCxEIC-C4p_RGmVlpwmQoaw&oe=69DD02C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUb4EwcxzroQ7kNvwETRHr-&_nc_oc=AdoyWWy0a31J-pFaMEy1q3bqlEakNGjF_fME0KnIiVkPxuNEDL6hFh1JY5Y_E9-rC-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cDqcoUHwFwWRb_PdmTHVCrkJjDhLWQuzYMD7G3ApSug&oe=69DCFEBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4xgtIvRW_QQ7kNvwEhArzB&_nc_oc=AdoKFKljxF4I18TSoO7j6pdd-8b1mJytYoejPStDGwQxOSBieJQ48gnbpNeLCMGFeKI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dNVsAPuAtYkpw6KYjSscLU7I412qQmB8BaLYYLkzJ3A&oe=69DCD4F5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
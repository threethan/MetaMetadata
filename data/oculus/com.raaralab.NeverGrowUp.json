scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ucRejc6bmEQ7kNvwEQmTOV&_nc_oc=AdrTA9HJTWp_Q2vnmUm3CRBRDZk4hBYL11pwsgbVQjo7e3-Ta8VqosVxun6GYTrnjN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVE5203BNE4GV5M3NBgDCEF7-cUCgDdMdKIWyU-dAprw&oe=6AEE0261"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22dhJEsfARQQ7kNvwFlwR8k&_nc_oc=Adq-rOn01VWLbcN3n9OvJsaWH4vkKQZ3c2J_xbEJCnRsym_5rPvINv3wkv4LH-nbKms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZEeR3MGHHGZDHaKCdqZCEDTaWRv-7MnUV40QnyhVl5A&oe=6AEDEDB4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYl9Nq1GxiMQ7kNvwE8mB5X&_nc_oc=Adr5PzsiX1dfENIlIXiOD-A0bfEmANPtG4kbUT1ggwE_zP3hzV9KxKdFwDmSQfH_sYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_tOvYonKKPrjbvAwdIwVsic-599sm-pD3W9jJdpveig&oe=6AEDE940"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc0dFCGCWi0Q7kNvwEG5qjx&_nc_oc=AdpvT4Ks-sLUFG_dMcGO-WDHFfslYR7e9dAUvONunj83HnWUlTYnQ1cag_HpaZSS9rA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEyccL-dcJ_oqYiRJXC0nR2S30Sz0GCyPoduCIS71vWg&oe=6AEDE53E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTjTE9trlhYQ7kNvwHs3pBk&_nc_oc=AdqiIFzf4rHet3Ak5sMv98nPSe3x-mwVRKfkr6F2zoyDnWJdmki7HrrRVTCz9wx44-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKbK06XJlNQYoFxsSA6rAwxjdSX9Inn21tYrXwRskraQ&oe=6AEDF3B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ucRejc6bmEQ7kNvwGJB6ZB&_nc_oc=AdpDn0bfRD9WZJfYLFQO-dVuNhG4XxDBLFRSX1CKbCku06q6nNzsuNCtyHd1S3v82z0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEDoLJW9ZTOeo4wA2bC6aITmf9ZPvysTc28j14vWnqfA&oe=6AECB0E1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uxdk7QySkcQ7kNvwFTAl_s&_nc_oc=AdqgkIGUMRwWjesAOrleBKGfyEdltVtCX0jlcyK4bHSv-JATXUr-5qc2Iilu2x9YvaY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK1IIwBS0AECSjG5e7TXXU-74_tvV25r8YsF46ZvNzOQ&oe=6AEC9C34"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYl9Nq1GxiMQ7kNvwHD_rwm&_nc_oc=AdoVngeUfkB26CqLb_RDcWMLmSTfdoeznf_0lXHzxuSbjxjW0MzqN7eMSlIUJ5eNJdU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCe1Jd0kL0loo2x7pnn4EgMB7gxM6X6sWSdC27uxmPEw&oe=6AEC97C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc0dFCGCWi0Q7kNvwEvWqaJ&_nc_oc=AdrQNsGaIQ1OXin88OlHQ9uPWE5DF5fnAIZQCtUmVRi6RVDyQ1ReAseSBqJ0WtZvrO8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfOYMUvLsYXNEwarGmhnuR9jtIcxwPdlCvgqLu_tsZAA&oe=6AEC93BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDyrEbb85igQ7kNvwEJ-Ww_&_nc_oc=AdpDrjXRTrBox4hrmHPktmN1WGLhjnwbbZZwCF-p2wwXuPYfFdoqWxYHZd1BSMfM7F0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdkDIWiDFutHjLNkLqirUG8rOG7uVhQa2_pZUP3aeWmg&oe=6AECA235"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
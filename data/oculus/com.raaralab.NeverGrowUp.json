scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttZ6a4aox88Q7kNvwGWuQQw&_nc_oc=Adp2GMpzmHZyd2S90I-NNncPkuwomtqBlcPC6dPaUqzLzjH6U5-3M2hjRQSCJoSzEjk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WCMruG19_6lNZkCYg2CYZfJxwSVbpjQOmLgb_cMaXnw&oe=69D79DA1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVJLzgj7yC0Q7kNvwGXPvjI&_nc_oc=AdocoPveNkMPzTw0EeuUDOgnhs26YflKhJs6kgZFrMCbHkSwNHEAMHfih558d4fN99Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WdcfjjdqwcPAqeQKZESTXWW_-sjj1qKz7Rwti6xadaw&oe=69D788F4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEL5iH2Syx8Q7kNvwHcRX-V&_nc_oc=AdoCRDr3Ca-GVkfhUTjZtM69c9MX9jL14_b_4os63NT4esjGOZUERImA6Sg-yC6qQSI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22CSx67WCrLXp9WbQ5HfUNRl7iYjBWI2yTRrHeUMsBOg&oe=69D7BCC0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R--HFA__dPsQ7kNvwGj7lo8&_nc_oc=AdqT7jm4Mrus5zfEO-avx6q0oBpZlvZXhIxKFjoXYLFQxQir4lgQ7BsXZdDA4ogOsxk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aoDG_hKoETEBXcK-dG6Ecwhf4g0NjyRe1jZRe6_oR4w&oe=69D7B8BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuHWHwdvMmgQ7kNvwE74C6u&_nc_oc=AdrlKkL-6ejxSvg0vMfPf4DXIk7WTq_giwVcvnl4Bmhyo234PT-4mziHXawXfXEMv4Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fDnjn8yDBeCPbtfhn-uFP1Ht4d5J0TeV4yHiBcbYbdw&oe=69D78EF5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43u4DWOOV1YQ7kNvwE9RDuf&_nc_oc=AdoqW1tHIEPFnARew1VJHSz6r5meeKasvaaGwOq8zjJ3PaBfmYi4n33HufnXmF5BBx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGQJuiDUU20fbM-fZ1ulT5InVeMwMe_eN-EH2zTFCDbA&oe=6AC280E1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9B-2n-Ie0YQ7kNvwGEgDpF&_nc_oc=AdoYq8GqJJnOQK17hfqGhL8XZw6fbZ_cpipef2qI2aT4uCvJX7-3QATPyR9pmq0sPYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkyPaS-D1yoMy899tcs1MrULK7xbQJvFzRf50piMKhAw&oe=6AC26C34"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwLL-ROAgrgQ7kNvwEMu7Zs&_nc_oc=Adr_26eRT94bfT-2Xf0uJ5wTFSbRkQ_E4QyZXjH_GkftK7l0ugAHUz9i1PY4jqwFdxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmKSOSLdxttR0UEHuQ4EKCwS1VmINfb45G06fACOgQrQ&oe=6AC267C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuElOk8iRY8Q7kNvwGmEq28&_nc_oc=AdossI8GkG17kVLhLhcw-wGqaSw8Bg859uD0-7Ktdrz7JilV0Ef4ebPu_7VOfcjbPbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBBajdnI52Pigxu9z3syrD1vDq7PiqmwqrIe3X3yZ8kg&oe=6AC263BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SUrVxC1jrkQ7kNvwG2-yoB&_nc_oc=Adq5sN6Dr0OuWFvEyJ-0zvj3QM3gNP5x7EpJbaas8WBCfGM_QqxpEa-tfaq6P6-7Fsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9D_NNBoRgiZSzsHtETSRhlMHBGS7mKtthiUCJzHuDdA&oe=6AC27235"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
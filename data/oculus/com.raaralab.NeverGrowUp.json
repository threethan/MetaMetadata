scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e-GhfqJgKwQ7kNvwGAnNEp&_nc_oc=AdoqUL5iDIndgau4-MO9indGktUnqwyJQipFr_2L-m-tlHrtDb_GHgtlpxmqFKQmpKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fjJL8qzht901i_wxVPkVsqhwliziFHOd5CL9iUcr1xA&oe=6A1442A1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCxJsi10yD0Q7kNvwHAsz1C&_nc_oc=AdomYIpQPb-YlVOKKfLYHofgsVLXcMK-ong23fQ9ksUh2qEyLwcPgRyiZ0KaWIhQLHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ATgF70ZUm23t3VLBbbkBPu0AXA4u0vZI0-LhnMj7ASQ&oe=6A146634"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KihT8Y8BXocQ7kNvwHlnFtE&_nc_oc=Adq0hXckrvHNkO0b_WPWkBHLJzH1KEwqrDsM-pcrMiejfgBE6BJxTlgUAMb4ERvY5lY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ur4rsTpT-9kmlw7DG3geCfyywermeFN0cf_hXkp0ICw&oe=6A1461C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-RzRkEy-ikQ7kNvwGaOBV0&_nc_oc=AdrM208V__0G0HIcmfP87Mpgw1GNkY-H-UsdJ6tSuLyH4EiinMWTDGxp18m_wJxNQ-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mQ2AKnJTaqHodqYq_67WTPU8kMVHe3xtvhX06EcWT8w&oe=6A145DBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpHYT0Mw4DAQ7kNvwFdMSqY&_nc_oc=AdogJ5X9W6R-1276WrQsntQQTcb64OcfJVVHz80qkV0C_M0VtcBXY9UHh5HJnnG6LA8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4isR8N9J09E0GcOfC0KQlrVSWkmEX1APosHgk_mFlGxw&oe=6A146C35"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
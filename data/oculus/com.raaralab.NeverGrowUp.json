scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e9coCUnb6UQ7kNvwGS8oQ2&_nc_oc=Ado-Dv6FqHIWZeYcZ_WdykuIioN4-lRZlu8RzGWCDJMuTsNWzCONgI2msy6J6nQhy8U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7wrLU5LRSysQgdUOYf9QeAOGytVeJqsHzrp7gptjh0w&oe=6A54DC21"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9b5K8NdirScQ7kNvwGY_7nr&_nc_oc=Adr37MzI-T98bg94XRKixWlOcQyu6dHG_81SvgiGfDwzwta1HTD6ikRgfMNq3TjzgqI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3ZoC5Q1WwyTVmdUhMROYCYtLGAbxKI0XW5JLUhJGuIw&oe=6A54FFB4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J82_GURvlJYQ7kNvwGhE-Lc&_nc_oc=AdpzUL98-UCRd_TLgXglsezfpizNprxw4YrX6P9wg10DAj6gYXzKCTWHSr2-1wGVz64&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeBfBPt8K0QWKEuC5fMiERhGU52ywW6D2_PIlpuNDmLw&oe=6A54FB40"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4GEetJ2BjsQ7kNvwE0_Y5q&_nc_oc=Adp6DLUkymOhmT38j_SsSHnLyi7d16JYHr1b_5UCuDWIDZAVoKBEIXUsqaTxxiK5Okc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaEjatmYwLOp3BrGyz5N-LY5RVy6Sb9T9Bsd7tTYXSHg&oe=6A54F73E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pisHY8LzyEMQ7kNvwGo-ae_&_nc_oc=Adr6aImcJ-QoPwMS5J41N_whr1fN6ayqYO3OcX8KGnrdaJSjK_NsuopbzXfBPx3Zsds&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHTfqjTBr-s1ksz8KdThTXO7hAPxoIu_Inv-6FwDp1OA&oe=6A5505B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rtvS6JUR54Q7kNvwGh4Xup&_nc_oc=AdqmoEueecFpFgDQn7ibEmx3GqcijTAbwrEFzJ75NZzwCM59l5q-MjqjHZbiEQYAcqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZEPDL6OwQkJdpxzJPT6M_d1j4gM2wkQohShhBUo8uMw&oe=6AA69921"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X7N-bS7i4QQ7kNvwGLu3gP&_nc_oc=AdoRuRhKHs7NuIWdF0tuSGlh3AfEL-sh7w167vhUUlkV0NSAsR7rKbYhzxGPlldnPgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5sCeumusmgGT49xMwKKPWtlMHWrniWukelkQpZePkIQ&oe=6AA6BCB4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXcQT_d9hJAQ7kNvwEYpNwC&_nc_oc=AdpmvJRHeudx6bG4o9qtgoGtFjWJ5XN0KLSTkk_Ui3kNg1_9oV4U-sGlf5b5yEaYm-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5F4V3fnN6_tSkJAa32a6OI2IjIt-xJYnO6i4Pri3NIg&oe=6AA6B840"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub979aHdwY4Q7kNvwH62IdP&_nc_oc=AdoKpNAXuzVEi-ix3vsvQEUsHWI1RMOVCTxomZRn4h2gmJR2eofh3ZQ5nA2Lf0GsFoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-tCRBPfHVGxqoYpsFs9sYJCBH0SqWZlKym4lxxJ0u6A&oe=6AA6B43E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt8p5-gRHL4Q7kNvwGncjet&_nc_oc=Adr2My_eghvKZwkBxC-CzORkDu8-v04oOUHjRNaXtiVOZSwzfmalBFiVNgqEQsHvW1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEDPI9GoRV9aJ9tckiu3XAlg7F6fPPpiVrdO2hvVinRg&oe=6AA6C2B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
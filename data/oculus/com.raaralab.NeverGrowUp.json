scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95sSLYK52swQ7kNvwEilzrK&_nc_oc=Adq8oF0bBWq0FBI32HSIfBoAM9tn1x4a7c0ROmZCGEvMHJH5H3oQE1sjDmJGFtgQWLg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY5jQsUI2eCLyGSyAVB_ysQsI9mgGQ52w3AFh842HxIw&oe=6A772321"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88k3jKG-BWIQ7kNvwE1j04m&_nc_oc=AdrKb2VUBjv-FlOwhcKWJJRlZgy3pjT-R-xlVWEmjSGxWCNdIbZpOPk4fenqwzu4Hzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAfW6SrDIdMNNEEu0vO3Th2s9FxL09mSi4Et71GWv0UA&oe=6A770E74"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0VBQbYfdCgQ7kNvwGRssfb&_nc_oc=Adqt11Ed5xeeHz352Of2VDdGiY2eNlCFztiCL2AVLunqZeLqtcwt15ENx4uljFUKU8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEw5G-yFFlNCE7-ufKaM3xT-EREkWr3xkZ3JwGYSmmUg&oe=6A774240"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM6rIlMjeJ0Q7kNvwG8u_G7&_nc_oc=Adpy4sFq6cH3bxue_1jQYiS_UPhGI8PL4VmcWCQbHVmHwhbedMEDIw4QtYuIY7Q4DFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpdZPsBBeELh9ooBTN8Sq-dVq3zRBuSstQrHFz-K1ZWA&oe=6A773E3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYEGcyY5aHoQ7kNvwHe1dgv&_nc_oc=AdoWnuvRwBSYAz3oIKPbpQpQRMbv9hbXc3zjgzr5DiHdBJX6T7H2H6nOTJgHdVnPrtQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvtUVV1K1F3Z0vW8xH5lLEluOli3reH3orKkBIx6Mj8w&oe=6A771475"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
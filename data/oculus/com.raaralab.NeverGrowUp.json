scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHWpbB9CH7gQ7kNvwEvSraj&_nc_oc=AdqWFFpW5PijaG039ddP7tg9EskBXi2rWud8cgos6DSHrAwD0pP4YLioki4Hn7hOUiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe-scKDZQwCZJva8dpsLKqwHQWO2BjHtuhGLrmABBFCA&oe=6AE61961"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk8eqmhRrz4Q7kNvwFPUEyc&_nc_oc=AdoqLjIbKTK904gd8_Ilb22ttn-snF4X9ZFbGRaVsVFe0D9a2mF3PhZhp-q-2NB8bnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPouZSUO8kLix3wG0GxUI6oVbPXGDK_GUGuRqUCoqzFeA&oe=6AE604B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N655K1IJOQAQ7kNvwEjjMzk&_nc_oc=AdpGuQgrZhq_1HDS3qC7k8nnSRjlRfktGr-7ZbU7-_1mlOtfOYbQx3QaniQjOGZWGG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDvI71X2w6O8fDjG4_Lnd7M58wutfWS5t_ZzMcYMUbyQ&oe=6AE60040"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cekGexWf5_QQ7kNvwHZuug6&_nc_oc=AdqxtEAhjn6BqzKUevboWKkIcLw4F5HWz0EwfCVlmqQldxOQyd6EotLdPkD13swHnac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Pz2av6ieSd27C-tSvml8uMCegonayZ4pe7u-QE9d5w&oe=6AE5FC3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvYqPQMjLg0Q7kNvwGOXirF&_nc_oc=AdorLXh8X2oGJefTXv6n7RH8_g_yTtwqur08L9yB-L3q8X0MBilocHsBuq1b6pldEoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEGAKwHdjvzggChRBcqOE57E6Jh8YDS9oVBuPwa5PTQA&oe=6AE60AB5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
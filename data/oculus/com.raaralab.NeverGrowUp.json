scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F53XUZ5KNa0Q7kNvwFfy9YE&_nc_oc=AdrZmTcFmYl4LB0g2chXHpJ9NDXLZNGVAbNmjvdytqnuuzHk3TM3cpf9LiYWP22jIO0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeeF-Bfk2hdl5CWAQZJQ8kVrUj-hgee4Yb_unXw0LUbQ&oe=69C3D721"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyuZLfhfLHgQ7kNvwGRyQTQ&_nc_oc=AdoF2am2s_RkrHad5234055Djo2VYn-YoyVme05ueaWcHBv0QUm59xTloepV517hgcY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-S5nqMNCu_F-JBSU6zQZ0icC0cu-1nBvlXc3dj56CNw&oe=69C3C274"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wduHZzgbcsQ7kNvwH3Tmya&_nc_oc=AdplhCqB7_OTT_-w-FHfIywSMtm3gHwhb_SJq-7RuuNg1QVFNaWrMqgPJTlZu_eZ2XA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS_G_A3_UoFUGDAcyqfa7QbvgARGEvs4uJIFUBuhYwBQ&oe=69C3BE00"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e-9d2fsERQQ7kNvwGqI2o0&_nc_oc=AdqGFP4iWhTbxGV4XfzAvfTRSp03OtQqR-NE--UfVu__LDNoS1uSfT6QQKmzTkHDTIc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYNNAU8LRONRdDVLzqK4nLtNmRnftnSYS9DhBb7laNbA&oe=69C3B9FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDHcLBfHFUAQ7kNvwEqSDyE&_nc_oc=AdqNq8gjIy4U-vV2jz8WaawL5a2AzHVqCTEXbbWbA1ke2nx7fHtfD9UP42uc6peaOFY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWCfoFku4doz9MLjJPoA9q0Idr6LS8F84S6Tvq1W9tYA&oe=69C3C875"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
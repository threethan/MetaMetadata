8_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiTHtpAmcMEQ7kNvwEG4dcz&_nc_oc=AdlXVaaDuVrjzfXVJpn9zO08Vz6zJ-GlX-m7vSfTuySx8OfMBIraGOtiql6uVnJj74k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afwt-vMkw1BS2QDpEvsPRaVUFkTk7Yc0ZJQ1RDyhOOySuw&oe=69AACAA1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yONc3mcMLSEQ7kNvwH6jsIU&_nc_oc=Adl2fjmyi4xdtYLSlk0L18ihDEW5qerO5vPxCjefI9CCNB_jUuLRBPiwaWavdNjmGMA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afyfru5Ya7EdEHzqABH_1eaIf64uXWj-w0fH4vQdMTbGqw&oe=69AAB5F4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIk9XF5klzsQ7kNvwHQx7vM&_nc_oc=AdlJU1JNXN96I_6OoEg30G_upJmzttx_vk5dP6eRPygQwyTBovvAyPdAvt37Y9W2_CA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxlccCQLGgvOtidgDBWYsGNhXh1-3QZI6a_uiQFxIFyYQ&oe=69AAB180"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fIeiN6TIjgQ7kNvwHMYV0b&_nc_oc=AdkS2li1Nw3uA5xGMXV0LaE64yo78QVjQUj-MEaC18u_xLUrUk-zNNpJ2cSiAJaAv1o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzktK_6bBn6iADCqPKRgoLpWVaEAlFQ1liqPsM4qI1D2w&oe=69AAE5BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm6U3B9Ge8gQ7kNvwHBanI0&_nc_oc=AdmOb6UyFcGEhHHOb-R7x1ry87qLeaBSylKMyFNBf0tNf5xq6VZOvUyHjmVd70U8p4U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTDg_X-eaU3Fc8xsY-EXDEedodL8tidr-505thESY2cQ&oe=69AABBF5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2392835201
scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXCZyzGhSLQQ7kNvwHrw3s0&_nc_oc=AdoiqSE6HFeCez4MKQmIn6b0gemBsVPNspj4jBWQj-uAU_n_a2mGB4FHC7e1PmZo7t8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGptEnVVKS0wgiEKa2XBOQCq9zM305SPTrAptS75fV_Mg&oe=6A918121"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pz6dlMlrCJAQ7kNvwG-_g65&_nc_oc=AdorNPeFim6yrGG8yuXt2dvILqhxt1QlRTUIkGDcKVBdYqjf5RFl9NaFzRptdxsUD8I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmUfPYhWR5QnBZHjKLx2FQnXz8F6zwnyvyBS-Z6VC4ng&oe=6A916C74"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nnl4whIgyVcQ7kNvwEptb4G&_nc_oc=Ado1LGR9FoqBWZeEOgSuGBBZFUEEx_RYztB9f0cFHuwPJBrvqNncQcbPCX0kJnwN2is&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6h5DZo5qsN0uIEyIV7BT3RTdyGoso_GJFaSI-bDg-Wg&oe=6A916800"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0Dsy0Q4A48Q7kNvwEJCzA6&_nc_oc=Adr9aD9ySvsqY9FQxVst7TNp7QWw4CL6ANODFKnpUHUOqUNRKePCEinbcfkTrTzhwtA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxfB3owqPE1EO-nREIbzLtH34TvxEslWStupPIsj9X7g&oe=6A9163FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqyxSeibidkQ7kNvwFL8ow6&_nc_oc=AdqmXbaimb7oef7iwgh3WoVqZt9qhuvhAF8ysF_ROb3y46MHgfjYWDilLTZG_-I-62g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXj5a6ktab0Cz869e_HjIDcsz_FNGJ2V4WNnjofEC0QQ&oe=6A917275"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
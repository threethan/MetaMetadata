scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7vPLH4LPFcQ7kNvwHlWerD&_nc_oc=AdodXDLBbL19-R8Y147hhVFKyVCpR56p7IFLEVTNDCky0FBpxMOH5ShnFaDqPiscPvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQl5YljXLw_EprPpEYa_pP5Ab1jZVZLt6_p10f8YKvWg&oe=6A748021"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88k3jKG-BWIQ7kNvwHTaSS2&_nc_oc=Adqc23QyEFL-1B-tA251jBw45LGrUCXPfoslrN4UOJ2MtrLkCQapSqQhk_bVhLvYyQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFti4SJ8ZjmU8sl48qDi3ZGggez1CAgFnuRnCut92gdUg&oe=6A74A3B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knLLDOYrukwQ7kNvwGthMNZ&_nc_oc=Adqg512fvcS8GGQyjaSMGbbw-UeVoARhD7w2Pi9BtYo-G36fZ7yzFXA2vgYEOnZdSrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8LJm9YnFVyWL8ud13ihYzuo0OGVZnTfKtHzsIkr7B0Q&oe=6A749F40"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbYmcB-V0soQ7kNvwF-rpxH&_nc_oc=AdrugBWhd9Bwh6AU5JLPyWQUwzkiQ-I-Vy_aVdexEmdDreopfTptFV5V9MXuRSRg62c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU9U8ZOWlG8KO_ZBrm5BbKhLWcyZG2rRjZbfjE8zLEnw&oe=6A749B3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYEGcyY5aHoQ7kNvwE-K2Kj&_nc_oc=AdqF-gWOYYRP8fJzDM06kCyTjShtuyL7N2bp-QEnsbMi_tcLoQFgaMmWyzuv3kLCmxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYaFeIvbvHVMEmGbdnJSD-SLGMgiWM_j4Vyj2rCj0gkw&oe=6A74A9B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
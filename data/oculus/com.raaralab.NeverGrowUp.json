scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eu7UUqjsaFYQ7kNvwFiDGmc&_nc_oc=AdrdC8ULN1pfKzChNyHmCdob7XSjuaZdepXnODTCZYvtM6Uwig7PdN2TDPzefX19PxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS402rM2hzznBMoUAJvnjWyRnMfUO0U_fvjA5GvBhtLnQ&oe=6AEA0DE1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uxdk7QySkcQ7kNvwEdaKMR&_nc_oc=AdpSDRHf9-9OJgGmRpxVgKF9SRFgKRMxwtjOPFEE6j0hyzQn5czAfx7iZGArFn466bQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAJGsTOayr3-g0Xc7N0tPUu7iqa43KS9D858FPuQQZyQ&oe=6AE9F934"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMPIhAk2f0MQ7kNvwG4F68w&_nc_oc=Adr4YtSwA89i_4XdzEyVUvz_GNPf5JPIJDpgpkoWx3uxpctJdhPbnpoJSsF-IrFO9NE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEPB8hP--sARpyym6rTbLhEzeHm7iEX0nXFtF1V58wGg&oe=6AE9F4C0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO20xacy4isQ7kNvwHMOuIG&_nc_oc=AdrBglZodRZoq8CIJV3PwRh0ul5LBouhcFMlxCieejpIf_g64SDuIQCD3an1oeTe-2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYezD5jZgriYR230-KVkbTXy9KL65CCBHZf85lZ0VWdw&oe=6AE9F0BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDyrEbb85igQ7kNvwGnyZvz&_nc_oc=Adq1CbD-As6-dX9NPusY2U-SfAQF5Fu68om7wTOYyqNCFEkyClDB-2175W2P17VUvJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWVTaCoKzUsdj9ixD-6O12maLTzMm6gZT9IelBRFigaQ&oe=6AE9FF35"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
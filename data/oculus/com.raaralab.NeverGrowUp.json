scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEUBHRtx_TgQ7kNvwEtMD6U&_nc_oc=AdoKBzIlDxocS3XmVxsJctIcWs-XtaQ9pN-xuQ91D0gp5Pzl5R0C2Dpi2M4ASOtAGRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGYuAty9Uy_9lM0XDyzNlza_YtcG1G9lhwy7RFJEPRhw&oe=6A9C0D21"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsrQhTwOBs8Q7kNvwEpJxyd&_nc_oc=AdqDy2fwrebjJAKcBgY6u9X-ck1mj4uOYDkHwdLu6c3UVU-p3LOa0n4TeCe-ZEOskyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8UKI4cJiVVIZOpXNoIOfFGcnn4ZbHi1JNFNwVuUZR1Q&oe=6A9C30B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O7c2W59sIwQ7kNvwEX50Ou&_nc_oc=AdoUhBWSfn9ejh-vsADFC6HB767AS4sVsmLPsZ3wLiWhgibuTQqJwgq1X8nxZdo9qnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJwPG9vx9s_1FllNamlaGdHllOd9fhavOVicRSovvM0Q&oe=6A9C2C40"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uxsEa8uDXQQ7kNvwEiM_Ad&_nc_oc=Adpn-IID0piEbS4u9ElyEoJoNbaQwZCD6P_8a98LATHhx33-ExxBi5h8sgEy3qvfimY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxVHSzN7khlqfUJj6wLvGd6EfEL8rseoPg28JuaEhO2A&oe=6A9C283E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldQd9NRFYJsQ7kNvwFEBR0V&_nc_oc=Adrcx1FfI-XLZys-apZyAVIxxP_mZbNAK2oWw_m49t9lCr0Yq2TYqHbESX2O7zsgA9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_yuO45yqa2ZQFC4HlMwmw0KQsURtTLuFPSoz7-fmBBQ&oe=6A9C36B5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
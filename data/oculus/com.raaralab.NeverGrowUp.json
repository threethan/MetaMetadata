_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_usvkb5sZkdoBbeDxpppvXhw94VJKJtmwqjg1TgZPv1Q&oe=6A467F34"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0bnOOhWcUsQ7kNvwFuyP-Y&_nc_oc=AdpalQ1dmwZL3g3ymn39ZgYNBDl6ixjAz362AXs0ielvoCThD0z07OMGwjgDnoSnOiU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gFsHB6IoUI1uB0rgGW2qUsbY7Dc1In5Nn5a-sTluyqg&oe=6A467AC0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MK5YzaMsQQQ7kNvwF6vLp7&_nc_oc=AdqkksZB6mFQkB_5rdgOlvVZ3RzUgIt_AaDO8YkjyNFaMVa-cLZ9Wu6h2t1TR-3WWpg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pxWlwB_SprIPCkZ5eqghP8MlAe21MMcRQOTc7D_dz2Q&oe=6A4676BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUD0xruPP_sQ7kNvwGVWpfj&_nc_oc=AdoW_YquYBrnB12cJaL0NGLC1_XU73g3u5T4WkzZBMiqTLxEWjcZJXegel1zQ2dTFBQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EmCquN_-ix_s-nOkgbT7O2WiY85fyVRZi2fLHjvfEfA&oe=6A468535"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23928352013478270"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2794352434036119"}]}, "baseline_offer": {"id": "2794352434036119"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1722006349, "status": "PUBLISHED", "id": "2794352434036119"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25017663627880431", "version": "1.84"}, "id": "921375312209980", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary"
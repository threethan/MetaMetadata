scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD2P-OB-kIYQ7kNvwENS9sa&_nc_oc=Adouw_EeoOIuAq4-pLc-1C6qjQ5xkAMzh1ZqBSi0ghl-vijRxq6rpxs0fbkaEp7ejoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zbPh1fSsDsth74VjERqq5WwUlbozabNwOLbfdki6HhA&oe=6A05C221"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFrOkoiO2YIQ7kNvwFFE8BV&_nc_oc=Ado6vr51pTsOfHfJLhG0Hi_tvEl0t_G88jTnSB9-VjkAE6XC23CcnBEKxGy5TFX9MsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61nyajN1taHKxJTzo4BqjHb4lsJSduJXWpiJyh2U_YCw&oe=6A05E5B4"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JTyKCHVjksQ7kNvwF1IyWb&_nc_oc=Adpz8BCDu46h0qWU-UEBNOtIMVmZ0SfeYKR6OD0ljB6ayMFA676M6TSG0BnB7EphUvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ItwqvLB44k_KDugOZBBI4ffhTRQ_qN00LKc8yt-c_Yg&oe=6A05E140"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZX4sXegujEQ7kNvwGTVotS&_nc_oc=AdqBBZU-Vd4e5hLAwGKlX9jDKdSDEuSceTdF7wdL6-VWDdw_C713jqbcy2vaocBGQmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wqcb4DFvmnm01IWKoIqxAEFk8hVKv8hxGJeqwCBO9Jw&oe=6A05DD3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AEmhZPSJekQ7kNvwFFGc44&_nc_oc=AdpFjsiatjojUooM0FfZZKgoDnI2xcg5ekzewIcN6S0_pQxyxGGfqGRoIPTGdTjW7sA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WVbRY4MOFQ47mw0TxTEg6h1xwwmbMKdYFE7J0NPySoQ&oe=6A05EBB5"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
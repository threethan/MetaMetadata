scdn.com/v/t64.5771-25/39035428_1427180174486081_799337505828933487_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7xTZ6yR-_0Q7kNvwGRO0ny&_nc_oc=AdpE-RyoJEayhclYNsm5h0V81_wULHl5IDsh79oNibHpvKsxBHzO15Qyr8Oycgkc6t8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ydkO7tT9U5CRGBUd5knsbLqY8C5soLm_uVdrqkHjikw&oe=6A1C2BA1"}, {"file_name": "NGU_screenshot_L5_2560_32b.png", "id": "1208878929733651", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035336_1208878936400317_2180475819105955229_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HfieIIpXoMQ7kNvwFAl6fC&_nc_oc=Adq-mVJQ4f3ihmvALYTf51woyvzqpj-PPY4u0w-MIFcXysluSNEu5rq9m6AulEtyicM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4onGwSbtps6IFWaDDl1taiCo6WloRPfU-I9WR483vAxg&oe=6A1C4F34"}, {"file_name": "NGU_screenshot_L2_2560_32b.png", "id": "593337265464666", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982542_593337268797999_1824983275381052834_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrYiECu5uqsQ7kNvwETTr6k&_nc_oc=AdqnBIiJOj_qKgmzcf85p43gHrRMmhcrOcAblEbJ7R-8GORC8bvWplY3crMCrn-5B4E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jlQzCM3GLwz_JQephdCj8u_vCJdFAhA3smHlhUPIl-g&oe=6A1C4AC0"}, {"file_name": "NGU_screenshot_L1_2560_32b.png", "id": "732145675199556", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982570_732145678532889_2577805792418955577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0QKhI37PiQQ7kNvwEEe8QS&_nc_oc=Adqv8vJXsMiubacZpYlOTwtRKoAM9iWx_ohn7CZK53XkZcxvNpOc-qkpqvX3vy5ZFYQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4De1YzKPjvZraVDFKr9ovytkIt9ouhSNyrr3f97o-sfw&oe=6A1C46BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage-trailer-laurels-32bit.png", "id": "739937187631178", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569471_739937190964511_4106518476436590547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1ihb_faMxwQ7kNvwH4fxLZ&_nc_oc=AdqoB93UDF4qI61n1K-zM4lEcaAqfEBi2_0KBRE-1jXlDCV7r3L0Qk92VBKNYUHurlM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jWrtDA9_QltnZSfI6uDm82AeswhwY3rufXP07sZeCCA&oe=6A1C5535"}, "display_name": "Never Grow Up", "keywords": [], "long_description": "Do you remember your favourite games you liked to play as a kid?  Never Grow Up lets you re-discover childhood play through a series of 7 mini-games -- but not alone! A goofy \u201cminion\u201d demands you play with it, too. This little troublemaker will be your companion, antagonist, nemesis and plaything. Time is limited as the ice cream monster's slime invades the scene while you figure out how to play together. In this game, a high score means a big loss. Learn more about the meaning of the ace score in between the mini-games. ", "short_description": "Make peace with your raging inner child. Play with your new frenemy in seven rounds of childish games while an ill-tempered ice cream monster melts all over your charmingly gross playpen. Keep your frenemy's ace score low in this weird, artsy brawler. Play nice, and maybe you will make a new friend. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.krakxr.co/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "RAARAlab", "support_website_url": null, "website_url": "https://www.krakxr.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
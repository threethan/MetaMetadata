_1586937908814757_4407952414997337257_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcDeFziUFEcQ7kNvwF0Bvfn&_nc_oc=AdoPd-0v7y6y2y2y2zk8lLfpqsh6Ance_sgHYvZMgyG4fxG1sFF0e_JK-7h7NwR4HhE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1lubjhhdDqmwiapdjAdXiFjr9CoqKRYBZCYh1K2XuJg&oe=6A91881A"}, {"file_name": "Game_Custom..._29.04.2024_16-24-33.png", "id": "7488184351299728", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75195904_7488184354633061_2437683571172106796_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4w5r1MGvpYQ7kNvwG-sxRK&_nc_oc=AdpR3eAW_GkUoxDyiL1_rs6T8NiHEtLF2uJ0mqxaWpubGFNeKQ_p3SL6hBP6PzXUuc8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjXRaM_uQsnMA4AFJLaab21Me6owqTErui7WDyT2si9A&oe=6A918C35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Playground", "keywords": [], "long_description": "Go on an adventure where you can run around in heart-pounding games of tag with fellow Gibbons, running through landscapes with speed. Feel the fear of the chase as you strive to tag your friends before they tag you, quick reflexes and cunning strategies to outmaneuver your rivals.\n\nTag or get tagged!", "short_description": "Primal Playground is a Gorilla Locomotive fangame! Play tag with fellow Gibbons, or just run amok! Tag or be tagged!"}]}, "developer_name": "PrimalDevgrounds", "developer_privacy_policy_url": "https://sites.google.com/view/primalplayground/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "coleorsmth", "support_website_url": null, "website_url": "https://sites.google.com/view/primalplayground/home?authuser=0", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_are
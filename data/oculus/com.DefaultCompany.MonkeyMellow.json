_1586937908814757_4407952414997337257_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjBrSd3s8yoQ7kNvwEV7C4k&_nc_oc=AdoP8uRV8KrmTB04q9_Daphs5sSwGgFF1JR-T4ULa-KnBIn3XIsn2FrfLWpigjqvKvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrI1ZBbx3lrz_QBJIYaSj7AsizS-mvHBFm4f04vh2XFA&oe=6A4CFA1A"}, {"file_name": "Game_Custom..._29.04.2024_16-24-33.png", "id": "7488184351299728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195904_7488184354633061_2437683571172106796_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMyM_Sqr5D4Q7kNvwHamrfZ&_nc_oc=AdogFJzv8jNhUPzqQIQvTa7sLU8-hpZ8e4FfQo_Z3zmEkR7Z8bucjpUS19bIq5fbdcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjB6PqkIuhg4M1nsegROTg2uNxrEnj-TdsCae2fVpFng&oe=6A4CFE35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Playground", "keywords": [], "long_description": "Go on an adventure where you can run around in heart-pounding games of tag with fellow Gibbons, running through landscapes with speed. Feel the fear of the chase as you strive to tag your friends before they tag you, quick reflexes and cunning strategies to outmaneuver your rivals.\n\nTag or get tagged!", "short_description": "Primal Playground is a Gorilla Locomotive fangame! Play tag with fellow Gibbons, or just run amok! Tag or be tagged!"}]}, "developer_name": "PrimalDevgrounds", "developer_privacy_policy_url": "https://sites.google.com/view/primalplayground/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "coleorsmth", "support_website_url": null, "website_url": "https://sites.google.com/view/primalplayground/home?authuser=0", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_are
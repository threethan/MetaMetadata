4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AEuJ2PqI8UQ7kNvwFFzihz&_nc_oc=AdlGmrLTpxAx5OcN_tEhZMZPphhpN0Ytz9gAHgtTAhq2nJzhJ65z0m8h7raaDVGl-nI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftUS5BPW3mYtZYlKcCye8bmgKupzi5QWA0bvUanif2jGw&oe=69A82C3B"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiPThg6pKMoQ7kNvwFd24yN&_nc_oc=Adnob7Z0W38crdcHirZvD9FrTbVc7kN2WbL2kgIVgkkbFvL-i50AmQAJ747wMSgRObM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftb8bUHLbhR4cfxCH5lFhMwUg55ViK8IhCJbPeSNJ8jiw&oe=69A80D35"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdU99PAhQfUQ7kNvwGTMBE6&_nc_oc=AdlED2M2zPmvuY-RA0zf1B4Wfl8xLxZyZBCZbZtDCTtac71jccvSz8tFlN0EBihqQ9Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftqViScQmLIu4uDb9HZKC3hVjX_HzsYqhDVuDilqvOl8w&oe=69A82A17"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxKJ2KpjNAIQ7kNvwE-145K&_nc_oc=AdmX7llfZ-6EqJGK_18uKcMJL4gPyYEa3IvIWmTcgFOz9hVlylSD73w0UO5wV0n1VtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftTP16VM6jsvwRcoreKvw_H4QL0Qzjbt9Ijj-xuNM49gQ&oe=69A8143C"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reuHIb0LjeIQ7kNvwGeG_GB&_nc_oc=AdlJcvECoWOeO6ZK-pFbgSaX1iMVFakexcJR5yu0JdGrtRlO_qSOeRp5Jj9QDAvbUg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsfU6LGvULHUEeiHWFL8UNlkK_G2KCg0n9vIseNiKpKxA&oe=69A83AFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mo5s4qLWu9gQ7kNvwHfj_7Z&_nc_oc=AdkN8FAbWknw3zNXMDUNjsiuLCcujN6P3jPS0R5f_KohpwgwvgY-pUaJS_R0_0X2AZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftiBOT4-N1thb0RgmUEvKQYywgVmozQe9mojr1J9webng&oe=69A81AAF"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
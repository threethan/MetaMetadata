4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_utK_pwbGCAQ7kNvwE7VkcG&_nc_oc=AdmV1S5iWpDFN-DtmKtieGTitJz0oYtoYTtFLgAITVmEUPz47hOwaUNPt7CLq-J9tf4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9fFkFIWRUMsVnhN6Srk4ZMz7I8sWfpqPbxoxicfCRHg&oe=69BD443B"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STqpK3Rd240Q7kNvwFiWP1y&_nc_oc=AdlgkxH0ivCiI11hhf2pVzLNn-_2I5ZkoE_eYXAF21iWRFibHrrCa85SQEtQ-jFV7MI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkfgnLVQ-nwoD07OWa55DTjZrn5EDUHSmJmlwBq3Y2zQ&oe=69BD5D75"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHR65cWjy8IQ7kNvwG_1veP&_nc_oc=Adkt5XhNFNKfVUYEd8yqlUsZ3fH9RGoivqiB33KFvoYAo1QVNyhQevG6INJCJvzk73s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfySDT0N_OiKbi7EBFvViiLrdvBO2xNew3gKTFmoFMTCig&oe=69BD4217"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VSCU_3Y_QIQ7kNvwFxpMVh&_nc_oc=AdkUqGRSn_WXdYHTA3rFGY2c1_2oWT0ocaxpJAZdPfDpq4h5QYQVQ4SgbZym4oHuKFg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzSQYT6OLIfQVnX5IdDTE-ojhvFpULyPCP81cD-oKB_Q&oe=69BD2C3C"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rJgvSfBXOsQ7kNvwEMgiHn&_nc_oc=Adlpgp6AwD70hqZR2Snv50TqQCF6jhadf3YL7WZXe5OOImDSvbtVtlgmLhvxvAj1oTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAGZvyhkLzFYbvZQL_WhmCQV_oJD_rVjkuIVMHs1EckA&oe=69BD52FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAA-O-mGZ_MQ7kNvwHSgRP5&_nc_oc=Adnz35pumBRefSXKUbjTuhZRkvQhqcuWRgtgZsbvPYcEJ-ZYsHfK6q97DA66Ihyyet4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1YlwMGOwcv7fSr_SGWjeHQzaLfEyqBS6rN4GaVs3ubg&oe=69BD32AF"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
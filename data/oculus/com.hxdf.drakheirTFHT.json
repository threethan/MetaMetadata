4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELMLBdyqLOQQ7kNvwFLyia7&_nc_oc=Admmzj16gHg3_J1oTqfNP6ny69CUAKtX8ssWJD5GRVyqsjGHe-WiSMcOsehdhYEvN78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLTafvMRrITiWKRjWCM8ZUAL_7X3d9jgOij5okLfv_SQ&oe=69AEC3BB"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guspvdutsYUQ7kNvwHfU04j&_nc_oc=Adk-hJpPrfrYIKG-1ijCDtHZ1i2d6jSoeD54lZEjENWjOeVjE5s-r6x3SK0mT7gcMrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXtobwXZd4oJ6KojKOzdHah2q7nmv6-abNt8ZF1yqrPQ&oe=69AEA4B5"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhQaxdFGMCoQ7kNvwGGcUqB&_nc_oc=Adnjva7M9S0kMR-J63zojkzIJqWTO6pm8Slp5Fyy2sk2yjHZ2DoDaTWjB4TYE2MHTCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaTLUtrJuBm9Vsso8ksDgEB-ImHmSNUdUBPPAlVyszhA&oe=69AEC197"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq0vrbQitnUQ7kNvwGSN4Xf&_nc_oc=AdkBkaRCu5hOkJulNha14tdVPfMdltaiTq9rzGcR3tLIKu-0YwOCNlX6HdF4g6H2wac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS_OfIXpmqStCM0ywx1s4ia1jQ8U-WHiTiYVHizrLmJw&oe=69AEABBC"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugV24PcSbLgQ7kNvwGN_nvG&_nc_oc=AdnSEx6MuYN1qIpGeBLpkIk2zYBDvqI_iHdYmCRZLpFLsj6i58Af6rv1Aa84M08KvxU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjbkmQcfa6LzIyW7DUygm6rO054bPorDsQbQ6xyvORzQ&oe=69AED27F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j21PY7G20i0Q7kNvwFTvEu-&_nc_oc=AdlHp0J8kpqpaTGsOjnr-ZRPURc_jWKfaibRT-9YEa1Ci_rdhQhbenoY_T03mvf7qqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzP1kik7t2zOoSKZNCZenL-5SjwS0rb2DI8_-qfkvC-qA&oe=69AEB22F"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
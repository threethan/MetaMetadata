f20f&oh=00_AQF1tnRD6f5-6MzIdywTviE7hCbFU5RLDjAnW7nGc-Q7Sg&oe=6A883866"}, {"file_name": "75195904_1118516069462508_5856094216064755904_n.png", "id": "386609621185759", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75556799_386609624519092_407693714518394961_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMhO3JpXJlwQ7kNvwGEHXAU&_nc_oc=AdqG1XK-HqqFOT0-Vv78j6n7dbE2Ot0b19sBhzqnbWfvD8zkwg3YteykCDxOD14dbVk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn9BJR4QxvyynKSuDw2uKO-ZLH0QjwLNcAkq_jHBHmJQ&oe=6A881DC2"}, {"file_name": "38974824_961410528942981_7717219569882396540_n.png", "id": "552753263819429", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001703_552753270486095_5007988745406657142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpIpVzAC3dQQ7kNvwEbFNvA&_nc_oc=AdoReEV-Kh1znGFIZxFkS3inDz-mPeVj8GZ5yv8NcienzePX-GYq7ju0MVk-tubo8yo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnXxj1z7ipr_PexPMSRJAk8drmkvrIjsEMU4PA2El4fQ&oe=6A88233B"}, {"file_name": "38974712_872119327617461_7921328541413496242_n.png", "id": "410894992048300", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210886_410894995381633_3367762434149412226_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOkjByXutdkQ7kNvwG48jqo&_nc_oc=AdoWjy9HpHPqrmNLf0WWXyW0tHEXz9N3N2J81z1r6KqTeL1qmIUGxQCtPz8m4RHnwXo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2hV9BAshrB1XZitvXd_ucJvN7raAHC7YmzDMKLNhayw&oe=6A881FE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75422369_471993569038157_9043023931207755646_n.png", "id": "530984482998568", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982695_530984486331901_5808837765461904761_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=343KqUtrXeIQ7kNvwFpHBd0&_nc_oc=Adpd_QuRBwd4HfpV-T06C5K1N-_1cTm32wTHTv88MsSbPA_F_Fe_QgnBBFNfdQFM-AE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuXBR-V8ziMl4iAHlENn1AEUgWLqQSwltER1iaMGWiAA&oe=6A8842EE"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": [], "long_description": "New Features\n\u25c9 Enhanced for META QUEST 3: Elevate your gaming experience with improved visual performance, offering unparalleled visual details and immersion.\n\u25c9 New Gameplay Snow Fight - Upgrade your snowfight skills in Drakheir this winter! Additionally, explore the Endless Challenge mode to enjoy the magic and chanllenge your limits!\n\u25c9 Improved Game Contents: Experience a significant enhancement in your gameplay with smoother hand tracking and more thrilling battle experience with added physical effects!\n\nIn this exciting adventure, your hands become powerful weapons \u2013 forget those controllers, as you wield magic with your very fingertips! \n\nGame Highlights:\n- Hand-Tracked Magic: Unleash over 40 awe-inspiring spells using hand tracking.\n- Fantasy Cartoon Style: Immerse yourself in a magical world filled with delightful characters and captivating scenes.\n- Engage with In-Game Characters.\n- Three Diverse Realms: Traverse 20 enchanting game environments.\n- Thrilling Boss Battles: Take on three impressive bosses!\n- Exciting Mini-Games: Enjoy fun activities like Whack-a-Mole to elevate your adventure.\nGet ready to wield the power of magic in the most extraordinary way! Drakheir awaits your courage and skills. Join us on this epic journey and become a legendary hero!", "short_description": "Embark on an enchanting journey with Drakheir, the ultimate Magic Adventure Roguelite VR game. Immerse yourself in a world of hand tracking , where a myriad of magical skills and gameplay await. Don't miss the infinite survival mode, ready to test your mettle! Say goodbye to traditional controllers and step into a groundbreaking VR gaming realm like never before.."}]}, "developer_name": null, "developer_privacy_policy_url": "http://privacy.5151vr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Shambala", "support_website_url": null, "website_url": "https://drakheir.shambala.cn/pre-registration/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8241846272530680"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1333824891838813"}, {"status": "PUBLISHED", "id": "1423291816306925"}, {"status": "PUBLISHED", "id": "4485667241709618"}, {"status": "PUBLISHED", "id": "1271604567833978"}, {"status": "PUBLISHED", "id": "1566759267736609"}, {"status": "PUBLISHED", "id": "4513777818906075"}, {"status": "PUBLISHED", "id": "1383195976622535"}, {"status": "PUBLISHED", "id": "1218242310155293"}, {"status": "PUBLISHED", "id": "1053268396776217"}, {"status": "PUBLISHED", "id": "574302075676783"}, {"status": "PUBLISHED", "id": "1360893695211211"}, {"status": "PUBLISHED", "id": "658696477021923"}, {"status": "PUBLISHED", "id": "1694878101457714"}, {"status": "PUBLISHED", "id": "1209520094020622"}, {"status": "CANCELLED", "id": "629440703330649"}, {"status": "PUBLISHED", "id": "585975337557644"}, {"status": "PUBLISHED", "id": "949138393810230"}, {"status": "PUBLISHED", "id": "27586243274355258"}, {"status": "PUBLISHED", "id": "1087034189493989"}, {"status": "PUBLISHED", "id": "581651967730138"}]}, "baseline_offer": {"id": "27586243274355258"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1333824891838813"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9269361713112459", "version": "V2.0.0"}, "id": "1425169095538370", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8234180549963919", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9269361713112459"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785225252, "id": "27423933590561994", "version": "V3.0.0", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27423929953895691"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8234180549963919", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9269361713112459"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782116926, "id": "27025240660431291", "version": "V3.0.0", "version_code": 32, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27025235150431842"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8234180549963919", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9269361713112459"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1425169095538370"}]}, "change_log": "This time, we are thrilled to roll out brand-new content for Drakheir. Taking players\u2019 valuable feedback onboard, we have revised the long-criticized storyline and introduced an entertaining new MR Mode.\n\nDetailed patch notes are listed below:\n## New Additions\n1. All-new MR Mode available in-game\n- Unlock this mode upon completing Chapter 1 of the main storyline.\n- In MR Mode, players cast spells in the real world to battle invading monsters.\n- MR Mode features a pure roguelike gameplay loop.\n- Brand-new buff skills complement the roguelike design; players can now paralyze, freeze and ignite foes.\n\n## Improvements & Optimizations\n1. Overhauled the poorly received storyline for better readability and comprehension.\n2. Trimmed redundant story segments to cut repetitive gameplay.\n3. Adjusted monster hit detection, enabling full seated gameplay throughout the game.\n4. Optimized overall frame rate for smoother performance.\n5. Fixed various known bugs.\n\nWe will keep refining gameplay and rolling out more exciting updates. Thank you for your ongoing support and suggestions!\n", "created_date": 1780386432, "id": "26774873792134647", "version": "V3.0.0", "version_code": 31, "release_status": "PENDING", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26774867708801922"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8234180549963919", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9269361713112459"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778820686, "id": "26546659588289403", "version": "V3.0.0", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26546653118290050"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8234180549963919", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9269361713112459"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777021871, "id": "26298830183072346", "version": "V3.0.0", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26298825996406098"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
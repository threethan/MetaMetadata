4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWrnOY7WI00Q7kNvwFLD0ek&_nc_oc=Adkny_SRq-dgqUaHsz_pNIyKBN3I0xSuAfouUntVWNUCdL1cFKA4WQgRHpFRuG37KDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwY-1RtFn4fjw_MtO3HtsbMioKlch7tyYJoZl99tduQDw&oe=69AC20BB"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCcnCsAEo5AQ7kNvwGW2K1u&_nc_oc=AdnITN1cYmUqxYCsGh_xVy4raERn5j1zqYo4MSC8SQTTDi6CwV57JTWbXiTfPgwi0LU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeyaRBYIAiEDXiyKqbQS2oin3IXHSaJ6n4zUrwDFF-ig&oe=69AC01B5"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-15kmKCR1kQ7kNvwEUeBDD&_nc_oc=Adkw87hbjEAISuptQPLwac_7cdhilNCGiCOD77cg0RK4HqA-4lwNz9IhrKJYfW7faXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVB7JU3WtCCUI6nT-4qKTHcbkBBg8vhDz7iPjBNysusQ&oe=69AC1E97"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcjvjyYFnEsQ7kNvwEqy8Lz&_nc_oc=AdnUVaDHY6xz3yvltEGyfpmoDxQ7yKdOCPFa8TOdQRUZAQcgaXekwrDaSqq21v1etYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrJ1itqUx4w01IQ4SExAFhvISqItJEUyxbtuHM3GnkNg&oe=69AC08BC"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugV24PcSbLgQ7kNvwGHu4v7&_nc_oc=AdmLduTrwzkxCkvFFrXzzpRPpMg98cr23bEMdqLQqSBs9uR_fT9xhhoG4SL3hB7k5B8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhcUhNa8vCZG7DIpdA_EMaAEMiEhhUgf6tJ3KsGXmOEg&oe=69AC2F7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cc9M_bKFPBEQ7kNvwEfs0x2&_nc_oc=AdlgXBvWgVULvVZXMC-rlAxeagVo_JtLf-KdlFNXHL4-3byKfREnmpFiBZcUnc4F0c0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9HZODqmOG49t6yP7gPOmBhrw_N1oqRRfuEyJ65zxypA&oe=69AC0F2F"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
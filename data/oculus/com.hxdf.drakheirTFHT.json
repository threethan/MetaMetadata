4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS3VnsgQOC4Q7kNvwHsjaho&_nc_oc=AdkM9iFipEilhTFZazHyjNXwVpN6GPEncwKwZBaGfRjCVvlSa-Gc17mZ5LHKgYsJpeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1QTcOCB6sKptq7dTQBaLqMfpRJ6SBnpidY7yAhZE6mQ&oe=69B2B83B"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOcQAsF4vJoQ7kNvwHIgx5L&_nc_oc=Adke5YeDplS81_LGJYyTo-hGK2v5cBgqqmHwVefnK6lVEij8rQ4kRJmhGP8VYSlFmKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZQMX-wrbkkmeDhYLW9rwH2khEIfMklQ0QO1sW8X9g4w&oe=69B29935"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaIke9t9ezQQ7kNvwFQXeNj&_nc_oc=Adk3UHe9LCQV2O1sqMlKIxBd_ybpmn2DvqAdImq2n5dt5JmzOqgjlFV2J6g0ZTkErew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkNP_QH6NYpaj_YvqSq9WCnW424rZ6RbwxLj6koDtrQw&oe=69B2B617"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnC4XHSqdDoQ7kNvwHrgTC4&_nc_oc=AdlgdP9aMISTteeZabir5Y08yuO-4EvlJInutJRw5bZeKDLZGljA32zbvA35GToH-nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2AXVVR4q-o9MeW86MTOxaMp6bYr1BryIBxmIAdX8Z8Q&oe=69B2A03C"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvFi8RxBbx4Q7kNvwEs0LUj&_nc_oc=AdkIiG7UjJwqtWwYk29ujk_zfl8WswqIXk3Ybh_LQor8liKQCnJ31pFh-iwGTkTvslo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqToXT0BHM9NafSUFV3ZjKc78T76gqzoKQ9DqEKcuWiQ&oe=69B2C6FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMSrg6Mxet8Q7kNvwGlYK0f&_nc_oc=Adkectoaa3c5YsNQ_U_AirQLxURaaZH_0sZxFjcuSzvSw0BsY86qKZJm_iBtEdUdzNg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwv03IpcRkdcw4bZk-KktNpUOc1JLl5jk7B1S_cFJYzWQ&oe=69B2A6AF"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
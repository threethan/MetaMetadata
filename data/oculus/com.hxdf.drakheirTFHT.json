tent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210886_410894995381633_3367762434149412226_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMk7rdltdhsQ7kNvwGH87rw&_nc_oc=AdqfpIQNfSnQ3sxT_kf_TE5ga2poiZLhIHiykleHs3uiVP8plaYH0Z93jL5TN3jQOzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-u6ss_QG61AT9LPV-xb0cC6Gyv8x4ZZRnvDOMQ3gwOQ&oe=6A1848A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75422369_471993569038157_9043023931207755646_n.png", "id": "530984482998568", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982695_530984486331901_5808837765461904761_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK-Ao6CWAcwQ7kNvwFDyx9i&_nc_oc=AdqGfSeGSQmJ9r6kcYy1iSlP3oqBoLEmBe5JYJ1jUJLk6je_nFOu0VN6osZ51ZDgWtQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QB-DxOyCZm2VJ2a0_3pWARFGkFKxfuMFDbs2t3-j3Tw&oe=6A18336E"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": [], "long_description": "New Features\n\u25c9 Enhanced for META QUEST 3: Elevate your gaming experience with improved visual performance, offering unparalleled visual details and immersion.\n\u25c9 New Gameplay Snow Fight - Upgrade your snowfight skills in Drakheir this winter! Additionally, explore the Endless Challenge mode to enjoy the magic and chanllenge your limits!\n\u25c9 Improved Game Contents: Experience a significant enhancement in your gameplay with smoother hand tracking and more thrilling battle experience with added physical effects!\n\nIn this exciting adventure, your hands become powerful weapons \u2013 forget those controllers, as you wield magic with your very fingertips! \n\nGame Highlights:\n- Hand-Tracked Magic: Unleash over 40 awe-inspiring spells using hand tracking.\n- Fantasy Cartoon Style: Immerse yourself in a magical world filled with delightful characters and captivating scenes.\n- Engage with In-Game Characters.\n- Three Diverse Realms: Traverse 20 enchanting game environments.\n- Thrilling Boss Battles: Take on three impressive bosses!\n- Exciting Mini-Games: Enjoy fun activities like Whack-a-Mole to elevate your adventure.\nGet ready to wield the power of magic in the most extraordinary way! Drakheir awaits your courage and skills. Join us on this epic journey and become a legendary hero!", "short_description": "Embark on an enchanting journey with Drakheir, the ultimate Magic Adventure Roguelite VR game. Immerse yourself in a world of hand tracking , where a myriad of magical skills and gameplay await. Don't miss the infinite survival mode, ready to test your mettle! Say goodbye to traditional controllers and step into a groundbreaking VR gaming realm like never before.."}]}, "developer_name": null, "developer_privacy_policy_url": "http://privacy.5151vr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Shambala", "support_website_url": null, "website_url": "https://drakheir.shambala.cn/pre-registration/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8241846272530680"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "4485667241709618"}, {"status": "PUBLISHED", "id": "1271604567833978"}, {"status": "PUBLISHED", "id": "1566759267736609"}, {"status": "PUBLISHED", "id": "4513777818906075"}, {"status": "PUBLISHED", "id": "1383195976622535"}, {"status": "PUBLISHED", "i
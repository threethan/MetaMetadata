4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBmdFuKQtf8Q7kNvwE8-aaw&_nc_oc=AdlQl8egLF8TLEebMgiWevfE603GOkhGf-7os53Nd_gT7Lf75BsVUGRh943UhHo4_NQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCjBgUTjl2TtjkSoJuIXoMJ1PRY_8YKD3fc8AnGWojAQ&oe=69B55B3B"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbGcd7DuwEMQ7kNvwFZ8QDh&_nc_oc=AdnfzoVHyLIJ07Are2b757tmg9RFdSvtlWz78ZEjoIxWCg9Fnh2G93b_O8Rr2oQRHE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzu87aYXfChkV-ojPx-Eo2_dTGPC7NlGMTHSqN1EkwbzA&oe=69B53C35"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9PPyYs54xQQ7kNvwGSaQG-&_nc_oc=AdnKczdzwzbD9vf8N_4ag_qjnL4btM34r3UkfDCTl2JYBKcLeemxmoBafnGaxKrz4jA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHWBxAS53focYF9-EmnYNrGsaOg69RKJdg7LYeF0jA9g&oe=69B55917"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjKdvYRyQQwQ7kNvwEmWDyW&_nc_oc=Adny3gt5BwXrXPCw-KwJKR9PTxjpJzQ7MsrxQj4qRhEiAu7f9na7-2-IylnD-F_Tqg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzJDBKyGBlbDO0e54awKGVDa8KZhzklt0qkK657UB0XA&oe=69B5433C"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDIx5oRYqYcQ7kNvwEIod74&_nc_oc=AdmQSwlbXG55ub7yse28DPmIqpuEzgvx6VNGl9yilhPhBpKUytv8A0x2wT89Ry7xxpk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXluqz9MqBdR8c6Y0XlW_nWu-tH3GkDuXPxtnfpTVsBg&oe=69B569FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMSrg6Mxet8Q7kNvwHGt9PL&_nc_oc=AdlRd9qaso2toXTw4bDVJ_Fw6dXEwzg-kKPVJpe0NAE3dUlKwX85GnRtaOapRETtKXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfymorcdaSs1QylEOUz_KGafzDzWo5ebumQoCoaFJzUORA&oe=69B549AF"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
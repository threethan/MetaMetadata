4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS3VnsgQOC4Q7kNvwE-tUhJ&_nc_oc=AdmkNW2_EvoTxZupDMNPuy9TlxuT9npDG7SxC-pdxv9P_icuk07elL0jOT4v7D0loE4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-PmhzvfmcId0Y9UxFKajL-M3v_moTXH96eHTzCA15-g&oe=69B166BB"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOcQAsF4vJoQ7kNvwHgM81b&_nc_oc=AdmosTnh4sU1rkHiyt5H0NYD_rZQrjhmnJC5hTcPNhDRlb3NYNChYDFul9lwml3aY5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNBD3Qr6yrsVG2ZGoiMgbzth68p4mWox0ItYy8t-IqEw&oe=69B147B5"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaIke9t9ezQQ7kNvwGQQE6K&_nc_oc=AdkM2ypF9lUwVz8rcrS4lW8SG1cq13hColpaFgGAh2VICUTQlI1RCnFj-WE3rTwio-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyC7A5sMN9gEa1AXfIfH7vEpselUZZZVmo_cOYEiAoVA&oe=69B16497"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnC4XHSqdDoQ7kNvwGuQZXC&_nc_oc=AdnsceZAuUvzS7bj1Rv4QxFVJyjYMCcVFOAYBDsgAF7ZAFUiKkf4CGYcJBQ1Vxn9aF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3z8T4DqC4GpWqbOFv44UvtTSj55otocn57Bf0SF29Kg&oe=69B14EBC"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvFi8RxBbx4Q7kNvwGWpt6z&_nc_oc=Adn7ms4t-1B033a2vaTJqYqgKHRTui37-v8szJXHJzt3QSfG6t9l2eK0DkoIBfDOP0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-BNToiAO1XJy9h6Q_DPQ_id3Rvbp1e6R2Jdg_fDPDEQ&oe=69B1757F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j21PY7G20i0Q7kNvwGSb9L_&_nc_oc=AdlC5NG-wMLSFQoOPxigdzl3zYtGboKhHpPt3teD_7cLXiK2ceCdxEIb1CLTt4v-Y2A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqDp_mjk7bYnpxa67Xao0MMm38wtD6ySuuECxLOeZQgA&oe=69B1552F"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
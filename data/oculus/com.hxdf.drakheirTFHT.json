4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nS3VnsgQOC4Q7kNvwH5OpHO&_nc_oc=AdldxZx44CXeP_hy4F0RQSqGQRhQLDxxZE-7ppK7hbhf26hCUVoi1hY-EZFFKlquU2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfztCr1QlaTZ8K3Mnur_U2LYiM4AXfXK6uE1EcueaHwRnw&oe=69B409BB"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOcQAsF4vJoQ7kNvwGyanFY&_nc_oc=AdmfQZ3r81iviBJlaD7ioqjh1W1R6yI9bIOioYrRNcK1Dne9logxocPCXMwxI6U1J7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKcmlm65Fg8lRQ624EFV8PaWVBBI4ntBWo7PUuI1VOIg&oe=69B3EAB5"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaIke9t9ezQQ7kNvwGwhWGK&_nc_oc=Adn8WT-IxxQjO51eCXPjP4dKs5DjMyjewQDUT_bKHRc8pAhhhYpzIAg6boSXSr3IT0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHmlAPvm8S9Td_PjXu3Fqn9hWTIQo16nUEAzDvOwpjpA&oe=69B40797"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnC4XHSqdDoQ7kNvwE-Hr8U&_nc_oc=AdktjPGigrPEMCQA682uKv-Ldrl5eOQYTZSIPxKoY2Uuz7SgME1uPAIQRiPRcHIjtjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2R88dzHYSWrqa4t1tU8V0kJuz9vPXqbY9Zb3OC4n0lw&oe=69B3F1BC"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDIx5oRYqYcQ7kNvwH8H48H&_nc_oc=Admd2Sl9wk3Scg-YetHg4SKrYHWgfYtrlYtY9QlioYjI7cLZWjnU8J81m0wogx6V3Ro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyi5ibBOd9cAD4WL46M1HK7VrPtTZ0f33rwbKAkj-Iv8w&oe=69B4187F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMSrg6Mxet8Q7kNvwHnyVpz&_nc_oc=AdkOjnNAFN515jQkNWreOYQ4u2ziCpvooTcAG7w3DNDZoJA8Jqd5lyxU5BYTkz4q0lQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxEfeLewfmqVOUuiUtdXI13tgP6PZ9NrqYTCeyZcqKvlg&oe=69B3F82F"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELMLBdyqLOQQ7kNvwFZX-KV&_nc_oc=Adliz01ZuWGtT_HBHBP_WYHodkoYttq82SPuhDBv5uE4Ao2-u01ya2nejvX8Lrg4uT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyagZFGsb3_qq-xm2PAP5EBtME1CwWAvvzCKu39yLI9g&oe=69B0153B"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guspvdutsYUQ7kNvwEWu7pC&_nc_oc=Adkh3QfQ8MWkwIJwPNLp2rSy3qgCxLdYRRNrXw6CixPWeS_tbUkGPVNLGuoY-DD1ZL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz29mNT_qw59XUq2v_iLKgWkgHegz56wgn5SRIAivrShw&oe=69AFF635"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhQaxdFGMCoQ7kNvwEXnOIy&_nc_oc=AdlQKhQVHWIrzZB_0mNbDgH-WZv1s1Ad1gKBmrwU1P3xxW8Ls5b2DD2VwV_2Dh1h3XQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4zz1_AwESaEKgud16QgkKvDB9DP4Dr0mZ7RP-W2kIBQ&oe=69B01317"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq0vrbQitnUQ7kNvwFZHhc9&_nc_oc=AdmfgvPaE9YtU3XHIZeQ6oVUHI32Ln-3MGnBVW1Ot63cQafTqo13KwJAEmqW9P_768g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2miOFsI932aSVmsdJmgc7xZ-Du4srMWH1NPEt1irhNA&oe=69AFFD3C"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvFi8RxBbx4Q7kNvwHp29ui&_nc_oc=AdnApdl3QT3ygWOM_0fKAJ8VSrNWUuE240RmEy6rQz1fFqpZbQW3CTiDjC-9qVTpS3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRquJV_1C092Y2DusVrxLyFs0cIBs-91soAAhFDnxKrw&oe=69B023FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j21PY7G20i0Q7kNvwG895Uz&_nc_oc=AdlVjI1fBEeeKcJTlw4ueAtTWx8eUGIMMDn89IbN3mL0a1fwnIBPr7fhnPsPgYPsTs8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2oeiLVHMKHW8AA1DDhx-wa3Ky6UwHwDp2mnK9UvtIDg&oe=69B003AF"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
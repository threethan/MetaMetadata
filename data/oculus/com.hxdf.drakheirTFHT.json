4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELMLBdyqLOQQ7kNvwFHXEKQ&_nc_oc=AdlD5Y7LFsqHPpdOPYXCdmrSWqTdCv8paXMSqiU1EA72M74pP5r6rvmssmHO8AT0yCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwccKjq5yNgklZShj6wXjdvPQQMpMckVIOTPpxX-J3gxA&oe=69AD723B"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guspvdutsYUQ7kNvwHuvn48&_nc_oc=AdnaS-OiiGowmCkkA-jCMOTTP9UdAieRHPRjOj89bafM2m71M9sPmGc53O41-FUjTUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdcWxzhvGlMofJ3j1Lm5ggd-Sm5kJg8bMGqLo4U7c7rg&oe=69AD5335"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhQaxdFGMCoQ7kNvwFZUKwq&_nc_oc=AdkmNNDInz_T_9nsTU2n9k3ZyVH2eiZNhEuDTQm8rr8kbMz5jgEL7g3l10jpsruZi1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRZn3RBLdBVoTQIHhP3zkxW5U3mKxIaF3Ca_0kCRxZCA&oe=69AD7017"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq0vrbQitnUQ7kNvwEkxqIY&_nc_oc=AdlNel3K8SR78Rc5PUyHZNjfd__B6oDoqUuRzNaxCOj-ZO8ZfXu7xrManMh_krLgwr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycyEi6_5Mz_scPvvnHRpO_LDpqmIINzLfE6jI7EopilQ&oe=69AD5A3C"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugV24PcSbLgQ7kNvwHfmPUH&_nc_oc=Adlj5jgwrF065xWvSgC4YkhICgve1mxV5FqcKPppt-W80x08-WwLWmKDdbreMYy5VDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv59zNvmgSLL46AOAO-CSashSnziDP6AIDATL1ING-Ag&oe=69AD80FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cc9M_bKFPBEQ7kNvwGMYQ2R&_nc_oc=AdmBNm_n00kNrwJ0xE_CGX6IU2fXEaxaAyTAb7XfGS2J_bztWEODLYQbhHWdB27RTws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYYfL4pNQhYzNzQFxKRh5uWd0Q8VdZ2i8b1I2X9G4yTA&oe=69AD60AF"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
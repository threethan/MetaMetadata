e": "38974827_308599035105474_2731503160770191721_n.png", "id": "1263185948330429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_1263185951663762_3788424172349860917_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miLUNfSPpcsQ7kNvwF1T6Cg&_nc_oc=AdoVZajD8dXJwbyrhj75WK2LCQu9CBgTU728-mKWmpjxMkTA4wpmAw6ILA_eVpSOT0E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EbOEoXATiaFeXJ1g7L9Ekjtc4lPP9ZMr0JYIZIrgO3Q&oe=69F9F4FE"}, {"file_name": "39035347_3658972047681975_4780521188933485181_n.png", "id": "1230495674821326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031519_1230495678154659_5734551693315562039_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b73fp1O_yuMQ7kNvwGdTThU&_nc_oc=AdrIFHEaMn-VltNc2kRGwlnI1xKQRwwg-G4z-DmYc4Qd_Xysi-jN01KIpkKGtvTASfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mRQ0MC8eTLz8Lbu2M8lQcbjL-VfcuEqhGzwJLgTOklw&oe=69FA0EA6"}, {"file_name": "75195904_1118516069462508_5856094216064755904_n.png", "id": "386609621185759", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556799_386609624519092_407693714518394961_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AohamnAw6BkQ7kNvwFU7Jl9&_nc_oc=AdpD3ORJGmcSKrnNENHnH2nomlI6wmWXwKVWszAMFHVqhsNWQamAl-84v70rQmnsRIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46tpk3JgJFXsnrfu0KQeYbmZ4adZrzLFql13wJ9PWG2A&oe=69F9F402"}, {"file_name": "38974824_961410528942981_7717219569882396540_n.png", "id": "552753263819429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001703_552753270486095_5007988745406657142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkNeTHoemmYQ7kNvwG6caSV&_nc_oc=AdqYWb9kTpt8JWAWgd1acrYU_b_KYlsWWQM7xQ97UxjgNvWbZvx00cFhSnP36ioeVlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pxLFZNpwWvowTdBLdSB40-kU21TPYyCrBM7KTelEOcA&oe=69F9F97B"}, {"file_name": "38974712_872119327617461_7921328541413496242_n.png", "id": "410894992048300", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210886_410894995381633_3367762434149412226_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNMc458k_TgQ7kNvwHQY7x_&_nc_oc=AdrL4KauvJwZUV7Och77yFUf0_95QDXcV9_UEnTIKCmKWyD3MOb318VAqnfz8G--grY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TsO6eQlmYFa9GtN53XfqzArYeuMqizkV57nz4Qp9wfQ&oe=69F9F620"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75422369_471993569038157_9043023931207755646_n.png", "id": "530984482998568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982695_530984486331901_5808837765461904761_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZk-z2IFTGsQ7kNvwHAEZ2x&_nc_oc=AdpNDTPV7VZMmrxhjATdpuF_3S8T9xj9p8X8epPTBvwd0VYOTLDRXkl6l_9f9mC0ido&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BivkRJVZ2YAKL4ZWA43y7s7cWyT9sMKyi8p_bpnjPEA&oe=69F9E0EE"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": [], "long_description": "New Features\n\u25c9 Enhanced for META QUEST 3: Elevate your gaming experience with improved visual performance, offering unparalleled visual details and immersion.\n\u25c9 New Gameplay Snow Fight - Upgrade your snowfight skills in Drakheir this winter! Additionally, explore the Endless Challenge mode to enjoy the magic and chanllenge your limits!\n\u25c9 Improved Game Contents: Experience a significant enhancement in your gameplay with smoother hand tracking and more thrilling battle experience with added physical effects!\n\nIn this exciting adventure, your hands become powerful weapons \u2013 forget those controllers, as you wield magic with your very fingertips! \n\nGame Highlights:\n- Hand-Tracked Magic: Unleash over 40 awe-inspiring spells using hand tracking.\n- Fantasy Cartoon Style: Immerse yourself in a magical world filled with delightful characters and captivating scenes.\n- Engage with In-Game Characters.\n- Three Diverse Realms: Traverse 20 enchanting game environments.\n- Thrilling Boss Battles: Take on three impressive bosses!\n- Exciting Mini-Games: Enjoy fun activities like Whack-a-Mole to elevate your adventure.\nGet ready to wield the power of magic in the most extraordinary way! Drakheir awaits your courage and skills. Join us on this epic journey and become a legendary hero!", "short_description": "Embark on an enchanting journey with Drakheir, the ultimate Magic Adventure Roguelite VR game. Immerse yourself in a world of hand tracking , where a myriad of magical skills and gameplay await. Don't miss the infinite survival mode, ready to test your mettle! Say goodbye to traditional controllers and step into a groundbreaking VR gaming realm like never before.."}]}, "developer_name": null, "developer_privacy_policy_url": "http://privacy.5151vr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Shambala", "support_website_url": null, "website_url": "https://drakheir.shambala.cn/pre-registration/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8241846272530680"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1087034189493989"}, {"status": "PUBLISHED", "id": "581651967730138"}, {"status": "PUBLISHED", "id": "4485667241709618"}, {"status": "PUBLISHED", "id": "1271604567833978"}, {"status": "PUBLISHED", "id": "1566759267736609"}, {"status": "PUBLISHED", "id
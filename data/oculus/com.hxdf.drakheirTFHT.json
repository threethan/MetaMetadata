4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrcHj1NMIKcQ7kNvwFpcZQ7&_nc_oc=AdmAv5Hl1Ags1x_ZW0pLBjvkFBjn1auNkrbTCAvZeU9tMhVb1vHvA3Fkj8oaGAnq4co&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfziYsnawvtMYx_49rPGAkF4gAxS-uxBzrpINcueo3sBNQ&oe=69BAA13B"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD8ytGnlf-UQ7kNvwGBcQfG&_nc_oc=AdlkEOnxXuPppucyD8Ze-jFgpoR5RDKFZ8LgNFNZEp3ldFrOZlCXy8TZc3w5TWgmxvQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkqjX4leEfKGXRG_qmYXVYvmoAn4Sscvx99eChwho6uw&oe=69BA8235"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNXjG2g_YpoQ7kNvwFb9uI8&_nc_oc=AdmM48rfMwXuxpD97fyHy2rYxAiFPgDDkD3q4zkWTkWd69_XvYmDY_PlFFfCI724ukI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKeH36QoaBgrqIydK-qzAMEKwOh7lzsG65QvOIjcVUPg&oe=69BA9F17"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK4VcYfBlYAQ7kNvwFL47zj&_nc_oc=AdnSQLgXPvH7PRYv7KwVdgG_KUbSLCkDG0xMrqkrmVumGCBPQSVic3J3_30_xchAUZc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyG3lS5ze-jMDV7mf1nMOIHj7JUJq8RHYvWTzQQxpehEw&oe=69BA893C"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKKkPUdl1D4Q7kNvwEsYukR&_nc_oc=AdnHllAKWbOd1EOqJs9aJcop6Ry9_2bpKNrwxZUl2SATs_vwlNSq2wQZ54bYlGYR_zw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA5Di3sj7G6MQJPriMBU870j-v3fPJq7Roz8f7oIuoLw&oe=69BAAFFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAA-O-mGZ_MQ7kNvwE43vmu&_nc_oc=AdmcKTyL4XTTz1xac9f9MLqEXm2C6Ar2uR5CKcsAIoo5loFasGrmQEs7S4jQLCR8Lk4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKMWO0X0ehhQk24akzFXrspK6mxjeKqoJ1A8dWVgtacA&oe=69BA8FAF"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
e": "38974827_308599035105474_2731503160770191721_n.png", "id": "1263185948330429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_1263185951663762_3788424172349860917_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-r-2OycC2cQ7kNvwEQqwx6&_nc_oc=AdoLnBf3iskUAA_WeUJ9NIdIwVS5jKvoWS0W8UmI0xaf2HBpCDm6-i13aFALeT0k2vg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61bbinmFnp0n1QQ4qJ5kTSjU1zf9YhnnEtMOV-zQeztw&oe=6A0723FE"}, {"file_name": "39035347_3658972047681975_4780521188933485181_n.png", "id": "1230495674821326", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031519_1230495678154659_5734551693315562039_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_gB1-FqiDgQ7kNvwGSRRfW&_nc_oc=AdrYTXoZPCVTgsSmUJRB7FpN94P4jxoRWop0iDmi_FE0YwGwJGTW22qvvU0iahIshYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af752vbeduIo8FNCyrS5A4CvGyw0j3eyNXS24LxpZqvUGQ&oe=6A073DA6"}, {"file_name": "75195904_1118516069462508_5856094216064755904_n.png", "id": "386609621185759", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556799_386609624519092_407693714518394961_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St36oYkmFi4Q7kNvwGCsAr7&_nc_oc=Adpopo4pM5ItXN8RXNA5ZlLMzWvCT2dYJthVcVziOShSfRXdoIefjEte4i8UXq_yz0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VEW4PqTYHcN5DQ44ikN3otqxNU21ssWfzPN1XQt5Uow&oe=6A072302"}, {"file_name": "38974824_961410528942981_7717219569882396540_n.png", "id": "552753263819429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001703_552753270486095_5007988745406657142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HF2375ijyUQ7kNvwHYYEag&_nc_oc=AdqqCpZvrK_PhLqtQ9fVZJ_C2iHInLPzyhCd7rDS9oLmUiaYDbEyOGpGkLF8lp7AS7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qvSWZ2e0oWgGaMH0Xs0UU0EzyxlsR103lYv_1OKPnbg&oe=6A07287B"}, {"file_name": "38974712_872119327617461_7921328541413496242_n.png", "id": "410894992048300", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210886_410894995381633_3367762434149412226_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mZuz1xeXk8Q7kNvwG2AA-R&_nc_oc=Adr8jW0Fwx0b3NBGn4P7WUB4qOlQbqb8GuBQkCIINkLbD0-e90x5prKTtP0VOu_skNc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dd1hyqEe5ak3fnTy5O5V0irMUczRwswRFdgBhGpV2UQ&oe=6A072520"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75422369_471993569038157_9043023931207755646_n.png", "id": "530984482998568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982695_530984486331901_5808837765461904761_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aH1CFpI14JIQ7kNvwHP9A0a&_nc_oc=AdrTKlBel6fGlYY_XHKwttSbT0cmdscjODlR2mB_COOsivXgD8OVBwATKVYlTFeL7og&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R3bL56WIZV0OYwe6YCtK5Ouapi_Zst7D8mB8jD_5oFQ&oe=6A070FEE"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": [], "long_description": "New Features\n\u25c9 Enhanced for META QUEST 3: Elevate your gaming experience with improved visual performance, offering unparalleled visual details and immersion.\n\u25c9 New Gameplay Snow Fight - Upgrade your snowfight skills in Drakheir this winter! Additionally, explore the Endless Challenge mode to enjoy the magic and chanllenge your limits!\n\u25c9 Improved Game Contents: Experience a significant enhancement in your gameplay with smoother hand tracking and more thrilling battle experience with added physical effects!\n\nIn this exciting adventure, your hands become powerful weapons \u2013 forget those controllers, as you wield magic with your very fingertips! \n\nGame Highlights:\n- Hand-Tracked Magic: Unleash over 40 awe-inspiring spells using hand tracking.\n- Fantasy Cartoon Style: Immerse yourself in a magical world filled with delightful characters and captivating scenes.\n- Engage with In-Game Characters.\n- Three Diverse Realms: Traverse 20 enchanting game environments.\n- Thrilling Boss Battles: Take on three impressive bosses!\n- Exciting Mini-Games: Enjoy fun activities like Whack-a-Mole to elevate your adventure.\nGet ready to wield the power of magic in the most extraordinary way! Drakheir awaits your courage and skills. Join us on this epic journey and become a legendary hero!", "short_description": "Embark on an enchanting journey with Drakheir, the ultimate Magic Adventure Roguelite VR game. Immerse yourself in a world of hand tracking , where a myriad of magical skills and gameplay await. Don't miss the infinite survival mode, ready to test your mettle! Say goodbye to traditional controllers and step into a groundbreaking VR gaming realm like never before.."}]}, "developer_name": null, "developer_privacy_policy_url": "http://privacy.5151vr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Shambala", "support_website_url": null, "website_url": "https://drakheir.shambala.cn/pre-registration/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8241846272530680"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1087034189493989"}, {"status": "PUBLISHED", "id": "581651967730138"}, {"status": "PUBLISHED", "id": "4485667241709618"}, {"status": "PUBLISHED", "id": "1271604567833978"}, {"status": "PUBLISHED", "id": "1566759267736609"}, {"status": "PUBLISHED", "id
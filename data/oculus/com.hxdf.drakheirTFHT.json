4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_utK_pwbGCAQ7kNvwGtiV-a&_nc_oc=Adnl6K0x9oKvLeUJYf9U6K_yl2WKR2COQftnCwXEZ91f5OPDLnh0MpNegWgMy_f5oiY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4Pr8AReWKvpwzAWRoWGpFFufRu2IIhd4XN7FPn3u4Jw&oe=69BE95BB"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STqpK3Rd240Q7kNvwEIxZTQ&_nc_oc=Adm8xxEP9TAj5yj2K2pPRHu-zNIw5rT2lsA9OITU8q73XAKlr7efvfDleb4I09u-G38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU3kYrtSQOpggtUKTwEj4d4UskTXhJM8HDX22e4x_PzQ&oe=69BE76B5"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHR65cWjy8IQ7kNvwFdnMwM&_nc_oc=AdlKEaTSsrLsAQM-RAw28gliSuxsbGuMa006fVOkC-7gYaPAKaBRzW1csYLX_gQEgqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyB3IiK4yKJasvek38XMYFqM3X-43iNeM_ez4FXpP_wmA&oe=69BE9397"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VSCU_3Y_QIQ7kNvwFYJKOe&_nc_oc=AdnPKfgMYqIGH_Dh8MNZR6Lz2nmqDKLYdhgjagNFUjMjwb9shbrE-tf5TqjoB3mQFI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwG6s22vxN3uO9782lq1b4sqiKKStMviWVUtHxdOsrCfg&oe=69BE7DBC"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rJgvSfBXOsQ7kNvwGiPgmy&_nc_oc=Adk-8Aecm8E9hS4MFUpFs0eLpAI8NyC-BFyV6gtBB-MJfEFSjcBST8DIwFKaaYcs_3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl2lJ8CJAPaWO98N1sNFkD96lTFvBNTfSpfgzLn3KGug&oe=69BEA47F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl8v6YZSORkQ7kNvwF4WVXb&_nc_oc=AdkzlqumgnELx67wbvH6J5OssoDQzkR0_91PkEiGp45NcQgi44vBqgd0mgvTAwYHpRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymPiTcmoMDpv5DKN5i8soJ7jvHXATj1v9z44VtfNp42A&oe=69BE842F"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drakheir.shambalavr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Games", "support_website_url": null, "website_url": "https://drakheir.shambalavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25109689211986455"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_4194844480771772_9087489968633352139_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mOxfmj1nL0Q7kNvwFidCWS&_nc_oc=AdmAiswCA9203YpQdgGYtJ3HJqQ2zCFZyVUAEfukFsI2_ad5WpFNQRbV60VqoXRZ1G8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzj8l7-qvfJOi0npy6afK3t2_f9T3ZxXOICgJFr5ceiKg&oe=69BEA041"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drakheir The First Hand Tracking ARPG", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Role Playing", "id": "821934236779161"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1733421600, "lastRevision": {"nodes": [{"id": "8234180576630583", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_
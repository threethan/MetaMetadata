cdn.com&_nc_ss=7a30f&oh=00_AfycaU9YRyzmAJ0GOQgGvLD3FwHPTN7c-XAkPeO69bUHrA&oe=69C7DEFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k52_lF_efw4Q7kNvwEGKyru&_nc_oc=Adrx3iLpYFvbfYBQgujBL2F5SWmOAXgtvM40jE64_ayaF83IJWWHEHklnvjI3yazn4o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy66YtQpGBfjSVz_Oj60iY8hzE-rJ8CTyc5IoZ5uBaE3A&oe=69C7BEAF"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drakheir.shambalavr.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Games", "support_website_url": null, "website_url": "https://drakheir.shambalavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25109689211986455"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619672_4194844480771772_9087489968633352139_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwIXdJk4FSwQ7kNvwFWUzXw&_nc_oc=AdqJQji-03ynOOqJwbW_fpHvh2Ix0FwoMYsAOIjr8KWFUlcopyMICFyCwFwXIw7mUDo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUV1xqLtGMrGTlgeZj9EcLZlMSc7sAFFLbdVSWsn9nag&oe=69C7DAC1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drakheir The First Hand Tracking ARPG", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Role Playing", "id": "821934236779161"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1733421600, "lastRevision": {"nodes": [{"id": "8234180576630583", "release_type": "SCHEDULED", "ad
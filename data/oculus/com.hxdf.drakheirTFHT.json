4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsn9jpR5Xy8Q7kNvwFmhuZ_&_nc_oc=AdoVAAD5CKdGs-UmVZsPjcs5tFHiytJfrquc-sCvAhwWQAVxD6rYpFgHEgReWeOIDhI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUjAH-l3GLQCmpYc49hGgb9V4B4jlza9LUiFUiJCoZmA&oe=69C138BB"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSA5KRC34wUQ7kNvwEehKtX&_nc_oc=Adr6MdV0CjbVM99RTotbB_qAqRreOXAFkLrOdK7m-SuNjjKJ60EGCV6zmvJltGIzYRU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxGYSZtrW5GV_k4wz_AJjAF0JnMHrkB0e7-sn9fW69Yg&oe=69C119B5"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ4PIq5Q9hgQ7kNvwFF8BDl&_nc_oc=AdqzvslljA1HxPgl6QSmah076VqW082T_usLCekftL80pc9TQqKn3AHLsEEuC_vhjPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKRtntLuWGRnYKXzwx5qffC_Ix1xyDrlV1ZP09z5H9AQ&oe=69C13697"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j72C66yjaSgQ7kNvwE6jCiz&_nc_oc=Adq9WbTGJv7MX_s7AbZyLVgGUJBltoPwsqXjBNl30l__VwV-rbFaDfhJWzpnuLRNI-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_t9dSrOdEIHC-0HHQwSJbyTqE8DNPT1TOEs1pBXAHww&oe=69C120BC"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeOOqjPAjZ0Q7kNvwGlWcxU&_nc_oc=AdpEXwZ1UGYRZxxrtMR6fE6AsexhvH9OxDk2Q7h3MrCADl5RCHIZI-25BA4-pAT_I9o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt1VcK7yjZ2K_hVFyHnkl4-V5iYSCOfhEZLfoLOOvywQ&oe=69C1477F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl8v6YZSORkQ7kNvwHFrHUA&_nc_oc=AdqugM0Lgsr98-aJoWHFSJRHxTpVVgvGztfnjp5TzmcJlZe95HJGxky_dxHBiMH9CAc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyT1bVXBQU13rHj5G6pBieNVryx-lZ3HJL3MUZtJZbkaQ&oe=69C1272F"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
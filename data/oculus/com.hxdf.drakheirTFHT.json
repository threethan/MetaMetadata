4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrcHj1NMIKcQ7kNvwGB73fs&_nc_oc=Adk1Bhlwf2pWrHnHMhW8qxSpOqrcg_wB470w1Ecge0vAbQEBVXfiowvASmLrUF-NuFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_iHxAVt4ZX3rb-J_r4yvKBQaYxLNnq-8J9ZEn80iTdg&oe=69BBF2BB"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD8ytGnlf-UQ7kNvwGISDUX&_nc_oc=AdkEZ9q3hURG_dRBVuZf39RYbrDKwfEaDwecVaV00H9Mh03In416UaiTD16Aa0R6JO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxywO24JCONaLgvM45G3bAk4SObwKkB4y1BuyfJAlnwAw&oe=69BC0BF5"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNXjG2g_YpoQ7kNvwGfNtov&_nc_oc=AdkvrHl81GiKi8I0dCCfKqoAhTv5Dbrocriqr2kJam4JCITK_Mm2IHY5UJ7fmwWoCww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyvZTgg2BeNGbLblD44Mk-Hz3KUwVvyfian1Io55hCsg&oe=69BBF097"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK4VcYfBlYAQ7kNvwF8DHd_&_nc_oc=AdmyO_PKLVtRcrPyCTfl2swgmgvrl4B4jaKJEg9dXfi0xz8JWk73_nx_BXxtrCW0DxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE5x7EmxdbTuCK3OAhoGi1RuxkmqBgDbrt6jdoBf5FFQ&oe=69BBDABC"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rJgvSfBXOsQ7kNvwHNy463&_nc_oc=AdlI4rQpikDPXyTz2PHMpECzeLPbAJQdK3SH99Uv2HDDQsYwE1sqgoRcSUmIiZrjjIs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwPh5CW6j5ZJahoNO4rL0pd1gRamsrnmSYZexJNXFqWTQ&oe=69BC017F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAA-O-mGZ_MQ7kNvwHZ9r5L&_nc_oc=AdmHXaMy4kEIlpJUUwS-j4jUkSXaQbpq3qQoSus3kegDAqCpcTCy_uk9nzthCkFIyJg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxo7Nh3rJJmXT0ZHMsR7M6J1X3tMbGcNJ3CBB-6sGF93g&oe=69BBE12F"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
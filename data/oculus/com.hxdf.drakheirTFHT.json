4821_2269438300087810_5229369909595464984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBmdFuKQtf8Q7kNvwE1n3j5&_nc_oc=AdkGIwjrKU7tCa5BwBHI48sF0G33-_y1pvFyK9CXrfrXeTInE90G7OfSxF-xh1UL8yI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWpNFzAMhV2r1e4YJZV5xY5Ji8jJg40teayCc_Y-3o6w&oe=69B6ACBB"}, {"file_name": "2.png", "id": "1798225107688301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392018_1798225111021634_4666208997754108082_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbGcd7DuwEMQ7kNvwERDQCz&_nc_oc=AdmvOQ3TP46pekgcjJTwfiCvTkrfJdXH9yfneEAPJrpK6khc7C0Ql7poI7C-5Mwzun0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwEvHBS2kJiJpmzTRl7Rv33j6Vs_Z10ZcbhGUf-nBhRA&oe=69B68DB5"}, {"file_name": "3.png", "id": "1167507315081212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391858_1167507318414545_3432132936909274250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9PPyYs54xQQ7kNvwHvh2Ig&_nc_oc=AdmIfdD870W_htHxjp3IhKr-JnF-4NZpitoMtR7e697wVLdWO0hcRbhb0HElf1ocke0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyU61RgakyMlhAu1Fs9GmiAVeLUujqBHTWSMedyWZwl_w&oe=69B6AA97"}, {"file_name": "5.png", "id": "1812917276132849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391875_1812917282799515_2228009527508734138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjKdvYRyQQwQ7kNvwFee9WD&_nc_oc=AdnsXnwzMvmipsuzwmYGJPYqzL3hXTJfAlWUbohQakcH_uPQmMeXBfIE2yAIA5Uar98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRIGJPgEbMzKbv04IXw-0WFIvzRs8cEm4RAh_bcxiBog&oe=69B694BC"}, {"file_name": "4.png", "id": "2593731037497526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391920_2593731040830859_4220041557974812800_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDIx5oRYqYcQ7kNvwHTxaA0&_nc_oc=AdnHnWyTJ8SBfqhXfJsoxkJhEeJl_nSct8migmUFdTFm0P3pDomr3Sx5Z5r6SieKxDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFnzvdGuo8fL7RlVFIJ_MaySnhTuMsf_m1pcfT0Uy_pA&oe=69B6BB7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1393299042202259", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618252_1393299045535592_963464294105061832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lyJiYJTKxQQ7kNvwEu1nGC&_nc_oc=AdmKHKqPkr1OnNk-EY00um1q2NnIKMszZZ8ioWJnyYEaNWDk9BwEBdyfBsA9YjkReFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1YsgKq12rCEIJtTIZ6CFfiSyPWKh36rwExYz9tX75_w&oe=69B69B2F"}, "display_name": "Drakheir The First Hand Tracking ARPG", "keywords": ["Dark", "magic", "spell", "dragon", "hier"], "long_description": "Step beyond basic hand-tracking tech demos and dive into a fully immersive ARPG. Every gesture, every movement matters as you explore, battle, and conquer in a richly detailed fantasy world. Our mission is to make Drakheir the definitive hand-tracking experience, setting a new standard for depth and engagement in this category. Get ready to engage, explore, and conquer in ways you've never imagined.\n\n\n{1636936237242928}\n# Use hand gestures to summon various weapons.\n\n{2268714766817286}\n# Try out this brand-new dynamic movement scheme, move like never before.\n\n{572908938510558}\n# Cast unique hand signs to unleash elemental spells.\n\n{352909707881064}\n# Fuse those magic spells, and be the master of elements.\n\n{3521501517982439}\n# Beat powerful bosses using smart strategy and skillful maneuvers, this is a test of your wits, as well as your might. And yes, you can fight a dragon.\n", "short_description": "Got tired of simple and shallow hand-tracking tech demos? \n\nDrakheir brings the actual action RPG gaming experience with cutting-edge hand-tracking technology. \n\nCast powerful elemental spells with your bare hands, combine them for epic fusion attacks, and master strategic combat with seals and dynamic movement. Unleash your magic and fight to save the Floating City!"}]}, "developer_name": null, "developer_privacy_policy
c=nHQL27AXx-sQ7kNvwE85iOt&_nc_oc=AdroyHST57B4uXJwscnhTRj-Dg83RR25xtdZojeaWnMFrHxHJhgpYr5XEKclj3pwPLU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5QtxMQwyIwv4Xg1f5hGsb05l_4W9W6Qt9OOLVwnCY2w&oe=6AF32D7E"}, {"file_name": "2 mirror RealityJay v1.0.png", "id": "2185311265290935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298329_2185311271957601_7016519593196385902_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZkPH1HK1RwQ7kNvwFoSTqr&_nc_oc=AdoVxlFpm5oZX9L5PXTHc75WMhOXUaecD9af3d5FGzn_eB2DUo3kdo4dasgQOVA4a-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL2G0XFmN0pa_gHtI25sVpT9jxcD0SwZFXT0pSLdthcg&oe=6AF3347F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Loadingpng.png", "id": "2248953148938134", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_2248953155604800_2059120964525931210_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBbvEjN0vOsQ7kNvwEsrmnj&_nc_oc=AdoN9Ctek1mr-d9r_KqKy9NxQg8AduYGBw53Uo7jOjI6HebQcoGs_NTcsLyON_E3Lrg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3uA_5CV7J21wzxjCNgI4NvzkjrbSKCik__0YZ5_9IDg&oe=6AF34748"}, "display_name": "RealityJay", "keywords": ["dj", "music", "dance", "museum", "art"], "long_description": "RealityJay invites you **feel positive things, from calmness to awe and euphoria**. Music shapes living worlds alongside with your hands and body\u2014no controllers needed. Just feeling better!\n\nDraw in mid-air, open portals, dance with sentient robots and awaken rhythm-reactive moving landscapes. Become the VJ of your own reality through real-time synesthetic creation.\n\n---\n\"This feels like a **dream**\"\n-Belu\n\n---\n\"It was the most dynamic and visually engaging experience I\u2019ve had so far. Unlike typical tech demos, this felt **truly artistic** \u2014 beautifully executed and immersive.\u201d\n -Michelle\n--\n\n\u201cIncredible \u2014 **everything reacted to my movements**. It wasn\u2019t just seeing art, it was being part of it. Truly unlike anything I\u2019ve experienced.\"\n-Agustina\n---------------\n\n\nStep inside a world that **responds to your movement and mood**. From a desert of tactile cacti that pulse to the beat, to a cosmic black-hole, every gesture becomes part of a living composition. Each experience is **unique**\u2014no two performances are ever the same.\n\nRealityJay blends immersive technology and contemporary art, built in Unreal Engine, hand tracking, procedural animation, and AI-driven music analysis. Designed for both **creators and explorers**, it transforms your gestures into art, offering a playground of movement, sound, and imagination.\n\nCreated by renowned VR artists. Exhibited in real-world contemporary art museums and experienced by hundreds of art lovers worldwide. \n\n**Try it today for FREE**.\u2b50\u2b50\u2b50\u2b50\u2b50\n\n", "short_description": "RealityJay invites you feel positive things, from calmness to awe and euphoria. Music shapes living worlds alongside with your hands and body\u2014no controllers needed. Just feeling better!\n\nDraw in mid-air, open portals, dance with sentient robots and awaken rhythm-reactive moving landscapes. Become the VJ of your own reality through real-time synesthetic creation. \n\nCreated by renowned VR artists. Contemporary Art Museum-exhibited, experienced by hundreds of art lovers. Try it today for FREE.\u2b50\u2b50\u2b50\u2b50\u2b50"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dilucious.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DILUCIOUS LLC", "support_website_url": "https://dilucious.com/contact-dilucious/", "website_url": "https://dilucious.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_PR", "es", "es_VE", "es_MX", "es_PE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25310349448590786"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "24840041222353747"}]}, "baseline_offer": {"id": "24840041222353747"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762467900, "status": "PUBLISHED", "id": "24840041222353747"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29141044625521230", "version": "1.17"}, "id": "794727693093339", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24494518700173869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29141044625521230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794727693093339"}]}, "change_log": "RealityJ 1.17.37\r\n\r\n- New: the humanoid robot now appears as female MorphQ or her new counterpart, MorphK, chosen at random each time a scene loads.\r\n- MorphQ scene: a second, larger sun now rises with the sun and settles beside it at sunset.\r\n- Forest Goddess: the marble statue now appears in either black or white stone, with its veins visible.\r\n- Smoother performance in Cactus One and MorphQ.\r\n- Fixed a freeze of several seconds that could happen near the end of a scene.\r\n- Fixed the Web scene's ambient sound continuing into the next scenes.\r\n- Removed a droning sound at the start of the MorphQ scene.\r\n- Air-drawing trails trimmed for a cleaner look.", "created_date": 1792710639, "id": "29141044625521230", "version": "1.17", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29141032568855769"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24494518700173869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29141044625521230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794727693093339"}]}, "change_log": "\u201cRealityJ 1.17 - BIG UPDATE - What\u2019s new!\\n\\n- New Hyperspace Level: pure abstraction and artistic expression in a dynamic, real-time art experience.\\n- Hyperspace disc: a navigation disc opens on your palm. Look at your palm, draw in the air, pick a color, open portals and switch the UV light. The disc now rises above curled fingers so no button is hidden by your hand.\\n- UV light: a violet beam from your hand reveals hidden drawings and, with a room scan, your own room as flowing purple lines. If your headset has no room scan yet, the app starts Space Setup for you.\\n- Portals: open one from the disc and touch it. It hums, crackles while it charges and shows a real 3D view of the destination before you jump.\\n- Forest Goddess: she wakes, approaches, picks something up and sits again in one continuous motion, feet on the ground, breathing slowly.\\n- Gardener: point at the ground and hold to grow a tree or flowers; point at a plant to water it.\\n- Cactus: touch the cacti and wake the black hole.\\n- Narration: a short English voice-over introduces the light, the disc and each world.\\n- Loading level: a 3D preview of the selected world inside the black hole and tuned loading screens.\\n- Smoother frame pacing and a smaller app.\u201d", "created_date": 1792537653, "id": "29113114494980910", "version": "1.17", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29113094071649619"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24494518700173869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29141044625521230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "794727693093339"}]}, "change_log": "\u201cRealityJ 1.17 - BIG UPDATE - What\u2019s new!\\n\\n\n\n- New Hyperspace Level - pure abstraction and artistic expression in a purely dynamic, real-time art experience.\\n\n- Hyperspace disc: a navigation disc opens on your palm. Look at your palm, draw in the air, pick a color, open portals and switch the UV light. The disc now rises above curled fingers so no button is hidden by your hand.\\n\n- UV light: a violet beam from your hand reveals hidden drawings and, with room scan, your own room as flowing purple lines over the live camera view. If your headset has no room scan yet, the app starts Space Setup for you.\\n\n- Portals: open one from the disc and touch it. It hums, crackles while it charges and shows a real 3D view of the destination before you jump.\\n\n- Forest Goddess: she wakes, approaches, picks something up and sits again in one continuous motion, feet on the ground, breathing slowly.\\n\n- Gardener: point at the ground and hold to grow a tree or flowers; point at a plant to water it.\\n\n- Cactus: touch the cacti and wake the black hole.\\n- Narration: a short English voice-over introduces the light, the disc and each world.\\n\n- Loading level: a 3D preview of the selected world inside the black hole and tuned loading screens.\\n\n- Smoother frame pacing and a smaller app.\u201d", "created_date": 1792527346, "id": "29111770131782013", "version": "1.17", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29111760565116303"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24494518700173869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29141044625521230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1769971385, "id": "26056984740593916", "version": "1.17", "version_code": 33, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24494518700173869", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29141044625521230"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1769904400, "id": "26050662677892789", "version": "1.17", "version_code": 32, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
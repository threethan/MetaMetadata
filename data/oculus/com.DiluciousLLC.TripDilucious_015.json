dscape 2560x1440 v2.0.png", "id": "1333592825416361", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/779277465_1333592828749694_7300502785703969625_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mniDXvj-ODgQ7kNvwFDiV4S&_nc_oc=AdoD9hWkJs8q5UOfymGlsz0vHIEL4q5-zNVxaMv_GtnFf85KBgwVjNq-hq3g9f8wZWo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWV6yjgKeJwPuaJ06K-_6JUmq1pRMsVYfmBv2kIoZ9yg&oe=6AF3347B"}]}, "id": "1009006165557173", "locale": "en_US", "screenshots": [{"file_name": "RealityJ_B04.png", "id": "2320352015450912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654867655_2320352022117578_6204709867932317832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbUCMzEH8FUQ7kNvwGrlN74&_nc_oc=AdpD8vQXgPPG_pLvEIZI-O11_U2D0db7mJpgYcUQrw7ozseAhzLyWU6cFZ27arEHyYU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt9j7kxvf1Qmhevcv3WMN6_6JIQBrNhFwh8GpwfyLnWw&oe=6AF32AC8"}, {"file_name": "RealityJ_04.png", "id": "1084422597801250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/742308944_1084422601134583_4630111069766326484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr4GalzHUNoQ7kNvwFhZbbl&_nc_oc=AdohJqsGw-zAkVzxN4ZTOkwLQiJIpVimg67K-0OcjacWaIJKBph-EvNuVwniogwtdbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSudU-q7I9Mmc_jP2QRAasK05DoIVVRz6ltH31porDUSQ&oe=6AF33D23"}, {"file_name": "RealityJ_B08.png", "id": "1434013378923375", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/790754744_1434013382256708_5486619421090296637_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u6k8qgt5i4Q7kNvwHHLCIP&_nc_oc=AdoDzKNvMb7YswAzl4FgVe2GuYXBki--s2m_IkI1Zn-n9F8FQC3izQKvTihULzUNQEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUw75z-2WLd5tzktVGSyZiNXXcRzlrNocWphbhAxlSMw&oe=6AF3479C"}, {"file_name": "RealityJ_01.png", "id": "1416622480627778", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595133382_1416622483961111_4639973620761147846_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LmZm8QtJvAQ7kNvwF6hgmA&_nc_oc=Adr8ltrDGFIBGm8hX9PQKh5ZXH0amBjp4WLgIJl4TVQt1c4z8UykRIBCAkLYweGkHBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVEAm6UcZoCfyKwhMbvtEqiTiwIzihhC_zXYksmOhwGQ&oe=6AF32F22"}, {"file_name": "RealityJ_05.png", "id": "1667338148378436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/741360331_1667338151711769_5209176596022424945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N8-Fo-6JEEQ7kNvwFyGx9t&_nc_oc=AdoJcY2103OwvyuVEmG5iS1yUVB7Zhuzt-MTUlbRR5-cROAB-igBK_yKedwawg4bYYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_b4TP807hVdEYlbhlC5qEIEGfZ9xh8xOQftBOHWcWWg&oe=6AF34171"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timeline 1_01_00_21_16.png", "id": "1768463917709979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/767772105_1768463921043312_1467147909970713360_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9uGkoaoA7AQ7kNvwEPZiAc&_nc_oc=AdqA9aIHEI5Xf-T2Aw5wt4st0auU5NbM3IV1XrA3D0S2MMgTYVqLNaGe6Rz5xDTurh0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaGWMzfyCf7XZ70whdLHROVimn28OaR9JN_natK8n-Zw&oe=6AF3514F"}, "display_name": "RealityJ", "keywords": ["interactive", "vrart", "generativeart", "music", "immersive"], "long_description": "**Art has never felt so real.**\n\nFind a comfortable, quiet spot and step inside the drawings of contemporary artist Agustin Di Luciano (Dilucious). Hand-drawn worlds, generative visuals and original sound become spaces you enter and explore, made to be felt from the inside.\n\n**No controllers. Just your hands.**\nTouch cacti to make them bloom, pick things up, draw lines of light in the air, open your palm to call the Hyperspace disc and travel between worlds.\n\n**5 Artistic Worlds**\n- **Real-spacetime**: evolving hyperspace where light and lines react to sound\n- **Forest Goddess**: sit with her and rebuild a living forest\n- **Cactus One**: a desert of touchable cacti and more\n- **Meet MorphQ**: a robot that moves to the music\n- **Augmented Mana**: mixed reality in your own room\n\n**New in 1.17**\nUV flashlight that reveals hidden drawings on your real walls, optional room scan, smoother hands, new sounds and countless refinements.\n\nVisuals react live to the sound, and to your voice or music through the microphone if you allow it. Camera, room and audio data stay on the headset and are never stored or uploaded.\n\nShown at Museo MARCO (solo exhibition), Aluna Art Foundation and Tower Artist Studios in Miami, and tried by more than a thousand people on site.\n\nMeta Quest 3, 3S. Hand tracking only. More at realityj.com", "short_description": "Step inside the drawings of contemporary artist Agust\u00edn Di Luciano (Dilucious). Hand-drawn worlds, generative visuals and original sound become spaces you enter with your bare hands \u2014 no controllers. Grow cacti with a touch, open portals, draw in the air, light up hidden art in your own room, and sit with the Forest Goddess. Exhibited at Museo MARCO and in Miami, now free on Meta Quest 3, 3S and Pro."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityj.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "DILUCIOUS LLC", "support_website_url": "https://realityj.com/contact", "website_url": "https://realityj.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKI
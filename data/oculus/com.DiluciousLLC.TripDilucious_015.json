66606676186849_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHvp4en54BgQ7kNvwG1Qv8P&_nc_oc=AdpmgkF-ZDahnnDcnScZKpfprhKsI0rHNU5ZDHWx0uVeE7LxUEdc7geKQx3KYIWuric&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_soPQ2mucVIU4YpcuUDqwfzxaJZGduYyONvku_Y7AMag&oe=6A3E97E9"}, {"file_name": "Timeline 1_01_08_45_05.png", "id": "1191384742412825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300910_1191384745746158_6250949850276541324_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3RD-fAd3aYQ7kNvwFZpLzN&_nc_oc=AdqcETgTOG1KIM1CqK5iR9-OLJkGqkH6XqOH7qKmIaF2zGMGlKbwJfFekAiDKKhmWB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gy3FXD2Umlqp6cYbaUId1DXP2i9GcvpCCNXR_YMr_lg&oe=6A3E98F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timeline 1_01_01_08_01.png", "id": "1634926080807143", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823431_1634926084140476_5221174911337397228_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtqr3a5R-IIQ7kNvwE98jRa&_nc_oc=AdquTW4CaHWz_eSRhXZajVGTTyE0jXDql6LnX_bfRdmn2-b17uHPxqmvGIG6_E3SVG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hSx5rqvJirdAhNv93NlOGe1tT-NuTvqf5A2o21NWEsQ&oe=6A3EA198"}, "display_name": "RealityJay Immersive Art & Music by Dilu", "keywords": ["interactive", "vrart", "generativeart", "music", "immersive"], "long_description": "Step inside the drawings of contemporary artist Agustin Di Luciano.\n\nAn immersive VR art experience where hand-drawn worlds, generative visuals, and original sound become spaces you can enter and explore. Drift through cosmic portals, meet the Forest Goddess, and lose yourself in the evolving landscapes of the Hyperspace series \u2014 art made to be felt from the inside.\n\nDi Luciano's work has been exhibited at the MARCO Contemporary Art Museum (Buenos Aires), Faena Art (Miami), the NASDAQ Building (New York), and Decentraland's Metaverse Art Week. His practice \u2014 where drawing, nature, and technology meet \u2014 comes home to your headset as an ongoing series of immersive pieces.\n\nNo goals. No score. Just a few quiet minutes inside a living artwork. Each experience pairs hand-drawn imagery with original sound, moved through at your own pace \u2014 seated or standing, gentle on the senses.\n\nNew generative pieces are added over time. Become a Studio Patron from inside the app to support the work and unlock every new piece as it's released, along with glimpses from the studio.\n\nPut on your headset, breathe, and step through.\n\nrealityjay.com  \u00b7  dilucious.com", "short_description": "Step inside the drawings of contemporary artist Agustin Di Luciano. An immersive VR art experience where hand-drawn worlds, generative visuals, and original sound become spaces you can enter and explore. Drift through cosmic portals, meet the Forest Goddess, lose yourself in the Hyperspace series. Di Luciano has exhibited at MARCO (Buenos Aires), Faena Art Miami, the NASDAQ Building, and Decentraland Art Week. New experiences added over time. Breathe, and step through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityjay.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "DILUCIOUS LLC", "support_website_url": "https://realityjay.com/contact", "website_url": "https://realityjay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING",
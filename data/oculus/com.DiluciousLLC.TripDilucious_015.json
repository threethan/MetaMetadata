kQ7kNvwH5WHOu&_nc_oc=AdqsFd9rQRNvG6eRpy1j8WhRGh7Np3WeGPWcxtE3ciWdZAakKX_jZslTm-6clmnKVOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I-KHPP54-OPoSL0LoRoyNpoORRS38DaojYQ1B0S10RA&oe=6A3E8FFE"}, {"file_name": "2 mirror RealityJay v1.0.png", "id": "2185311265290935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298329_2185311271957601_7016519593196385902_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBhHz3ohFYYQ7kNvwEe2kxE&_nc_oc=AdpX2MprPwiCGoW6SHn27vD0cprSEXDPLJubWjO-gXwHr5LiE1KOmUz71ky3rBWXTiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-akQdz7MGL-3CFU3VNRfM_Ex2M4T3nJDK1EsF1Zjy3A&oe=6A3E96FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Loadingpng.png", "id": "2248953148938134", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823949_2248953155604800_2059120964525931210_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOkblZfR3lQQ7kNvwEtYW56&_nc_oc=AdrETayaztq_-jNHCtHZvy3poBxtL8x4HLUOlLRdPOnEYD17IfzlUc3xAeiFoMk1bwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nwWqEYaAA0nGkGJxQ8GBYwp-MZWL7kI3n0gOh9gWakg&oe=6A3EA9C8"}, "display_name": "RealityJay", "keywords": ["dj", "music", "dance", "museum", "art"], "long_description": "RealityJay invites you **feel positive things, from calmness to awe and euphoria**. Music shapes living worlds alongside with your hands and body\u2014no controllers needed. Just feeling better!\n\nDraw in mid-air, open portals, dance with sentient robots and awaken rhythm-reactive moving landscapes. Become the VJ of your own reality through real-time synesthetic creation.\n\n---\n\"This feels like a **dream**\"\n-Belu\n\n---\n\"It was the most dynamic and visually engaging experience I\u2019ve had so far. Unlike typical tech demos, this felt **truly artistic** \u2014 beautifully executed and immersive.\u201d\n -Michelle\n--\n\n\u201cIncredible \u2014 **everything reacted to my movements**. It wasn\u2019t just seeing art, it was being part of it. Truly unlike anything I\u2019ve experienced.\"\n-Agustina\n---------------\n\n\nStep inside a world that **responds to your movement and mood**. From a desert of tactile cacti that pulse to the beat, to a cosmic black-hole, every gesture becomes part of a living composition. Each experience is **unique**\u2014no two performances are ever the same.\n\nRealityJay blends immersive technology and contemporary art, built in Unreal Engine, hand tracking, procedural animation, and AI-driven music analysis. Designed for both **creators and explorers**, it transforms your gestures into art, offering a playground of movement, sound, and imagination.\n\nCreated by renowned VR artists. Exhibited in real-world contemporary art museums and experienced by hundreds of art lovers worldwide. \n\n**Try it today for FREE**.\u2b50\u2b50\u2b50\u2b50\u2b50\n\n", "short_description": "RealityJay invites you feel positive things, from calmness to awe and euphoria. Music shapes living worlds alongside with your hands and body\u2014no controllers needed. Just feeling better!\n\nDraw in mid-air, open portals, dance with sentient robots and awaken rhythm-reactive moving landscapes. Become the VJ of your own reality through real-time synesthetic creation. \n\nCreated by renowned VR artists. Contemporary Art Museum-exhibited, experienced by hundreds of art lovers. Try it today for FREE.\u2b50\u2b50\u2b50\u2b50\u2b50"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dilucious.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DILUCIOUS LLC", "support_website_url": "https://dilucious.com/contact-dilucious/", "website_url": "https://dilucious.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_typ
Woods_2K_PNG.png", "id": "410812547065812", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_410812550399145_6317928000855657844_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OQka8AqObYQ7kNvwFHcc_v&_nc_oc=AdmFy6AJjoo0fzqktWCC9H5ZfnUxIFjn0BHc3XvUuoaLjmJ39aJKT28fMB1dIT8o-zM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuM6ePxb3O2wd1CplF_O87-LemBnFWf694jAcS1B6g58Q&oe=69986BC5"}, {"file_name": "MultiplayerScoring_2K_PNG.png", "id": "154890866845984", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031509_154890870179317_2871215941887552977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QupyyZ0DUjsQ7kNvwFLfIsE&_nc_oc=Adl27qFJkNtt4VAs6AJUDLWdi65ckJmrglm9WIW7KyoD-MPwqsUeacqYGtJdLspwV9I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvEx7upQjhS-x-nHM1_Y7lBjk1ICHW5h3vbFzB7E8jlCg&oe=69986D97"}, {"file_name": "Back9Board_2K_PNG.png", "id": "262169482485579", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569440_262169485818912_8878709059878914615_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC0EPSMCwsgQ7kNvwGHbUTz&_nc_oc=Adn4LUGZZFbMB8aA-bkYUQ9sIHndWMzCdwluCXAZ4BzcY8puT0aJh4TDLXtgK5zqgyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs0RWGyKx7P5_qY2PUT63r3PN3VKbFk_0L8_ZDd57VyiA&oe=69984B38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DiscBenders_CoverArt_16-9_2K_PNG.png", "id": "610076236830296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_610076240163629_3637108208520596054_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqlYpAudBSAQ7kNvwHxzP5S&_nc_oc=AdmrPaMIk3NujOQh95wKw2S4V0SnG_XndZq9e8gmrz6P87dDwJEFfnLxQwuebydAvLE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu1LAzb20ntN85q0jNR6xRjEiwkFGcnZqOgmD-FZUHLkA&oe=69984579"}, "display_name": "Disc Benders: Ace Run", "keywords": [], "long_description": "Disc Benders is the ultimate Disc Golf simulator | Hone your disc throwing skills in challenging courses and relaxing environments\n\nNow boasts four full courses, with over 45+ holes to play, five unique disc types to choose from, and two game modes: Free Play & Career Mode\n\nReview your course play at the post-game review board, with career stats that carry across play sessions, and visualizations of your throws for your round.\n\nBend alongside up to 4 of your friends (and others) as you keep score and socialize on the course.\n\nFreshly designed 9-hole course 'Dream Drop Bends' will test your ability to throw flexes and high elevation shots, with pro-level distances\n\n\n*WARNING: Game is no longer in development - Experience is a finished product*", "short_description": "Disc Benders is the ultimate Disc Golf simulator | Hone your disc throwing skills in challenging courses and relaxing environments"}]}, "developer_name": "Free Fall Studios", "developer_privacy_policy_url": "https://freefallstudiosgames.wixsite.com/discbenders/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Free Fall Studios", "support_website_url": null, "website_url": "https://freefallstudiosgames.wixsite.com/discbenders", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8665803790180056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.577
Woods_2K_PNG.png", "id": "410812547065812", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974511_410812550399145_6317928000855657844_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHAkERoNKNAQ7kNvwGzmuPA&_nc_oc=AdlIslfReQcVd06eSD6TEVsLti1OQPfN-ghPBfgcuzvmrP7YsYyb-lMV3vUfijQt0dU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslGx_34ws0rHtho1ICaUmGuqsgEFkXS5mtbvG7r1TO5g&oe=69A6EC45"}, {"file_name": "MultiplayerScoring_2K_PNG.png", "id": "154890866845984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031509_154890870179317_2871215941887552977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9X3oC3AlTUQ7kNvwGpAVPU&_nc_oc=AdkUPxN0yfEZW66t-T4bxv2bXywg2GU3h9qbAoyCXVbWlku0S3eXk7vsu7lm1WOeIlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsO1ocSRPKLJuOhB4ABWe5DTkre1qCwEaLW5TUQpUH0ng&oe=69A6EE17"}, {"file_name": "Back9Board_2K_PNG.png", "id": "262169482485579", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569440_262169485818912_8878709059878914615_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VCU20RkKDEQ7kNvwGTw7FV&_nc_oc=AdmkZUS99S8L4m-RZCN38JgOivVmrlvhuiYQ_GIgw3WxzCnzkg4ntXradjUb7SDTAjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIU1xuOgoAdHb_oUwfvY9nXjUL0IuU1cdERqvjKB_32w&oe=69A6CBB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DiscBenders_CoverArt_16-9_2K_PNG.png", "id": "610076236830296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_610076240163629_3637108208520596054_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3bQ97LsAJ4Q7kNvwF7hecj&_nc_oc=Adkrfoo51tXqkOacNcT52dHi6ByTM3bxMNgukMq3oPYctsXs9kkJD9a6U0ENtBd_mOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsH9yLM7BnFCU6AkEhwP9WPs43v5xLM6F0PwoLAxujfDg&oe=69A6C5F9"}, "display_name": "Disc Benders: Ace Run", "keywords": [], "long_description": "Disc Benders is the ultimate Disc Golf simulator | Hone your disc throwing skills in challenging courses and relaxing environments\n\nNow boasts four full courses, with over 45+ holes to play, five unique disc types to choose from, and two game modes: Free Play & Career Mode\n\nReview your course play at the post-game review board, with career stats that carry across play sessions, and visualizations of your throws for your round.\n\nBend alongside up to 4 of your friends (and others) as you keep score and socialize on the course.\n\nFreshly designed 9-hole course 'Dream Drop Bends' will test your ability to throw flexes and high elevation shots, with pro-level distances\n\n\n*WARNING: Game is no longer in development - Experience is a finished product*", "short_description": "Disc Benders is the ultimate Disc Golf simulator | Hone your disc throwing skills in challenging courses and relaxing environments"}]}, "developer_name": "Free Fall Studios", "developer_privacy_policy_url": "https://freefallstudiosgames.wixsite.com/discbenders/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Free Fall Studios", "support_website_url": null, "website_url": "https://freefallstudiosgames.wixsite.com/discbenders", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8665803790180056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.577
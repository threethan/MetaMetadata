"1406098120605253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819871_1406098123938586_1510794454992753984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YQeufP1SJ8Q7kNvwF1Vi26&_nc_oc=AdrphPNORAmPM3o_9xuaD0n8ndD3w8D3AJ2mXC9MNZODDDKWGwHs7j12Bx3st61_8C0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5iQZ2FN2XhoixqAG-SKIAv1Eqa9n6dLMJ5VNyUAKWvg&oe=69C51DF9"}, {"file_name": "1.png", "id": "721645180757306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818853_721645184090639_87859618346311993_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e84yXcKf-E4Q7kNvwGFYUoV&_nc_oc=Adqa13Cqw97iJyIYoOZTPZqV9O6-21pi2oN6_MwPxGD9ZHuEKsf8WQtrO8-cD9hc1so&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXGJn0q45_czH1l1VH8umb5HHQEUMFD6uQO7KUfu4tOg&oe=69C52298"}, {"file_name": "5.png", "id": "747752907754761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823310_747752914421427_6613924421692745110_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MbaKX_wXuIQ7kNvwEfTIWg&_nc_oc=AdquCdUuqn2EqELgm4wFXMPFaq1A96IBYlwos_4IwsRUCEgOrjiVnT_n564a66I9Kfk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzlafe2JOAL4vuIJTD_5uPTCyEUIhNqyG_Y1xTu28iwEQ&oe=69C53427"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DriveVRX - All in 1 Driving Games", "keywords": ["DrivingSimulator", "Bus", "Taxi", "Tractor", "DrivingGames"], "long_description": "Bus:\nEmbark on an immersive virtual reality adventure as you take the wheel in City Bus Simulator! Experience the thrill and responsibility of being a skilled bus driver, navigating bustling city streets and scenic countryside routes. Strap on your VR headset and master the art of safe and efficient driving as you pick up and drop off passengers at various stops.\n\nTaxi: \nExperience the thrill of the urban streets with our immersive taxi simulation game! Take on the role of a taxi driver and navigate through bustling cityscapes, picking up passengers and delivering them to their destinations against the clock. With realistic traffic patterns, challenging weather conditions, and a variety of vehicles to choose from, every ride is a new adventure. Can you become the ultimate master of the taxi world?\n\nTractor: \nDive into VR farming with Tractors & Fields VR: Virtual Farmer! Cultivate your land, plant crops, and harvest bountiful yields using realistic VR controls. Operate tractors, explore sprawling fields, and experience the beauty of virtual agriculture. From seed to supper, Tractors & Fields VR offers an immersive and rewarding experience for aspiring virtual farmers of all ages.", "short_description": "DriveVRX \u2013 All-in-One Driving Game offers the ultimate VR driving adventure! Drive a car, bus, truck, or tractor across city streets, highways, off-road trails, and parking zones. Multiple modes, realistic controls, and total immersion everything in one thrilling simulator!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23959138500420993"}, "review_messages": []}]}, "cover_square_image": {"uri": "
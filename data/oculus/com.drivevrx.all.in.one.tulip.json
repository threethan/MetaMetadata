ng?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZND3BCx3pBEQ7kNvwGq_Asx&_nc_oc=AdrIdIYCw2glf_TV7ckE5c-JE6ygIWPJWK-DB5acGlOMpSsnPj3P44J8iSuFGJ9-76Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XgnxIGCClGOucRXOOjrhpJhJUAWO9ltocGuDSBhqBSA&oe=6A131EB9"}, {"file_name": "1.png", "id": "721645180757306", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818853_721645184090639_87859618346311993_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j67eWVEjuh0Q7kNvwGtcr5C&_nc_oc=AdrMIcuySfSbXmPLq9HWisLyxga8xAM3npCXTQ-b0CJkWTtssCLxPXL5_H3imKLHIFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EnFCCe_o-U4sE7InssB4Ux3fh4P75i4qQeIxPOfL1dQ&oe=6A12EB18"}, {"file_name": "5.png", "id": "747752907754761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823310_747752914421427_6613924421692745110_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTO9lKFe6_EQ7kNvwFKFMUk&_nc_oc=Adoel0916_OTxrXpK5ozPvvkQmcY8PM5bzlFhTKp4qVsamj1pqidZiYBD7Wu1bS__F8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O6dW8V0L29alcJ5-UFVtQcmH9--JfozyM1_UjYhURYQ&oe=6A12FCA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DriveVRX - All in 1 Driving Games", "keywords": ["DrivingSimulator", "Bus", "Taxi", "Tractor", "DrivingGames"], "long_description": "Bus:\nEmbark on an immersive virtual reality adventure as you take the wheel in City Bus Simulator! Experience the thrill and responsibility of being a skilled bus driver, navigating bustling city streets and scenic countryside routes. Strap on your VR headset and master the art of safe and efficient driving as you pick up and drop off passengers at various stops.\n\nTaxi: \nExperience the thrill of the urban streets with our immersive taxi simulation game! Take on the role of a taxi driver and navigate through bustling cityscapes, picking up passengers and delivering them to their destinations against the clock. With realistic traffic patterns, challenging weather conditions, and a variety of vehicles to choose from, every ride is a new adventure. Can you become the ultimate master of the taxi world?\n\nTractor: \nDive into VR farming with Tractors & Fields VR: Virtual Farmer! Cultivate your land, plant crops, and harvest bountiful yields using realistic VR controls. Operate tractors, explore sprawling fields, and experience the beauty of virtual agriculture. From seed to supper, Tractors & Fields VR offers an immersive and rewarding experience for aspiring virtual farmers of all ages.", "short_description": "DriveVRX \u2013 All-in-One Driving Game offers the ultimate VR driving adventure! Drive a car, bus, truck, or tractor across city streets, highways, off-road trails, and parking zones. Multiple modes, realistic controls, and total immersion everything in one thrilling simulator!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25960523206949169"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827973_722660894264442_6846094607402804359_n.pn
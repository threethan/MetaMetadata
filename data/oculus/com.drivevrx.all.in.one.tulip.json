kiFByicqgsaPsu22sA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XLkW9bE373gpzkWLe71UnJwU67POj51LodAoMvt3EHw&oe=69F88879"}, {"file_name": "1.png", "id": "721645180757306", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818853_721645184090639_87859618346311993_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tihuXQ1nSxsQ7kNvwEtJ5XE&_nc_oc=AdqfAmxRlmyS_gtYz_uMBgZiS74lP5UwJQwkXrIgpbOu1c54DvegXtHFl_TRQjKnPy8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FW5347fNSN1Cu8ilzW0-UzcyUfYWreti8DQnhOtr2UQ&oe=69F88D18"}, {"file_name": "5.png", "id": "747752907754761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_747752914421427_6613924421692745110_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ5uOnwNpa8Q7kNvwEUuoQe&_nc_oc=Adqw2AmmRo1obyRrO8m7B81GtaMspQL7aRIFB3lE5nZKXZRNmI_C_6jd34-dNaKdExE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MrgGkhP78JwVU4ShydQ2vyESwuFYAkqIaw5f18D5A4A&oe=69F89EA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DriveVRX - All in 1 Driving Games", "keywords": ["DrivingSimulator", "Bus", "Taxi", "Tractor", "DrivingGames"], "long_description": "Bus:\nEmbark on an immersive virtual reality adventure as you take the wheel in City Bus Simulator! Experience the thrill and responsibility of being a skilled bus driver, navigating bustling city streets and scenic countryside routes. Strap on your VR headset and master the art of safe and efficient driving as you pick up and drop off passengers at various stops.\n\nTaxi: \nExperience the thrill of the urban streets with our immersive taxi simulation game! Take on the role of a taxi driver and navigate through bustling cityscapes, picking up passengers and delivering them to their destinations against the clock. With realistic traffic patterns, challenging weather conditions, and a variety of vehicles to choose from, every ride is a new adventure. Can you become the ultimate master of the taxi world?\n\nTractor: \nDive into VR farming with Tractors & Fields VR: Virtual Farmer! Cultivate your land, plant crops, and harvest bountiful yields using realistic VR controls. Operate tractors, explore sprawling fields, and experience the beauty of virtual agriculture. From seed to supper, Tractors & Fields VR offers an immersive and rewarding experience for aspiring virtual farmers of all ages.", "short_description": "DriveVRX \u2013 All-in-One Driving Game offers the ultimate VR driving adventure! Drive a car, bus, truck, or tractor across city streets, highways, off-road trails, and parking zones. Multiple modes, realistic controls, and total immersion everything in one thrilling simulator!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25960523206949169"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827973_722660894264442_6846094607402804359_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8ZejBG8x-4Q7kNvwGtW99A&_nc_oc=Adoe5YPJ_Q23EeNiNva86vNiaQAGK
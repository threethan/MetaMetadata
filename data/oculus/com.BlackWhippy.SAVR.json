RLxt9WQ&oe=6A1309CF"}, "display_name": "SaVR", "keywords": [], "long_description": "The year is 2121. Humans have colonised various planets in the solar system. This has caught the eye of a mysterious alien species who wish to enslave the humans and turn them into killing machines by kidnapping them up and reprogramming them. The humans on the each planet are under threat! You are the SAVR (pronounced 'Savior') - Sentient Autonomous Virtual Robot, a hi-tech drone controlled virtually from earth using quantum entanglement communication whose mission is to save all the humanoids on the planet before they are enslaved by the aliens. You must pick up all the humans and destroy all the aliens in each zone before moving to the next set of humans in peril. Good luck!", "short_description": "SaVR (or 'Savior') is a fast paced FPS Inspired by 80's arcade games like Defender and JetPac. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRo0Q1LvVk7WvFg3bIcQxYvHAJSn3pnkyc0CDk3gD2sQLNd680NU1dHNIqkbTTL9-QRDnqMAWU7lPZ-/pub", "developer_terms_of_service_url": null, "publisher_name": "BlackWhippy", "support_website_url": null, "website_url": "https://blackwhippy.itch.io/savr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "264807535727277"}, "review_messages": []}]}, "cover
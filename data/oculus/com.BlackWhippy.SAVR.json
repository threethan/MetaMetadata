pired by 80's arcade games like Defender and JetPac. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRo0Q1LvVk7WvFg3bIcQxYvHAJSn3pnkyc0CDk3gD2sQLNd680NU1dHNIqkbTTL9-QRDnqMAWU7lPZ-/pub", "developer_terms_of_service_url": null, "publisher_name": "BlackWhippy", "support_website_url": null, "website_url": "https://blackwhippy.itch.io/savr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "264807535727277"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "336180231754569"}]}, "baseline_offer": {"id": "336180231754569"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1644961200, "status": "PUBLISHED", "id": "336180231754569"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4972005826260284", "version": "0.19"}, "id": "908441599858353", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4577817395679131", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4972005826260284"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes
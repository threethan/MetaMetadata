OVPvannnD69M3Yi6xCHNR__JKsmo44X7Gu-lY9k795rFa-0JEx7qAUCQIraOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPj8tmhz4qMtF4lxLsJLDWo6ISQDRl8ThKZfFtfGHE1g&oe=6AD2597E"}, {"file_name": "3.png", "id": "2022579901526263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031509_2022579904859596_4744282089049064683_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZrFpeb1uuMQ7kNvwFHADoS&_nc_oc=AdrKVKQGmgSAioV46vNxVAlpr9EGTnumq0uvd9QxlQIwJuoxtww1D5V-3s32SOcpEy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMFTvp-Vocow8kq79KiqoMQXr_6t8kWsHXFAl2GJMqOg&oe=6AD25018"}, {"file_name": "4.png", "id": "1060301425764847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392876_1060301429098180_3558256611982073177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDP-MBs-JXIQ7kNvwFixbDo&_nc_oc=Ado6QkC4CW1H4fFStamUIQ_StmJCnAxt5YQkigKS8hPflB7RWCkHKquu_nZ5fFLgIS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSZ2nsBWucG9UIgC7HFdVWvwtUdYKaMjyX_AWVKN-kHQ&oe=6AD230F6"}, {"file_name": "5.png", "id": "1322374582010084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982440_1322374585343417_2194710727263644201_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYdd3bJHO0sQ7kNvwF54jQ8&_nc_oc=Adok6CEG710Dw8QXslIWXgnMWl4np6nra5SJaFAxmdUziZEjrCazf5J0aT5x86yJLDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaWL-w-hbK_Xs0keaG7KfvMSYyZ31bVWnnEsCCb62YUg&oe=6AD237A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WoX Builder", "keywords": ["realestate", "architect", "configurator", "woxbuilder", "woxviewer"], "long_description": "Step into the future of property viewing with WoX Builder Our cutting-edge real estate 360\u00b0 image walkthrough app is designed for homebuyers, renters, and real estate enthusiasts, offering a fully immersive experience that transforms the way you explore properties.\n\nNavigate through stunning, high-resolution 360\u00b0 images of various homes, apartments, and commercial spaces from the comfort of your own VR headset. Customize your experience based on your specific requirements, whether you\u2019re searching for a cozy apartment, a spacious family home, or a prime investment opportunity.\n\nKey Features:\n\nImmersive Walkthroughs: Experience properties as if you were there, allowing you to assess layouts and designs in detail.\n\nCustomizable Viewing: Tailor your property searches based on size, style, and amenities that fit your lifestyle.\n\nUser-Friendly Interface: Easily browse and select properties, making your search intuitive and enjoyable.\n\nSave Favorites: Bookmark your top choices for quick access and comparison later.\n\nWhether you\u2019re in the market for a new home or simply exploring your options, WoX Builder provides a unique and engaging way to visualize spaces. Dive into your next property adventure today", "short_description": "Experience properties like never before with WoX Builder Explore your dream homes in immersive 360\u00b0. Whether you\u2019re buying, renting, or browsing, discover the perfect space tailored to your needs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindwox.com/wox-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MindWoX", "support_website_url": null, "website_url": "https://mindwox.com/woxbuilder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "ROOM_SCALE
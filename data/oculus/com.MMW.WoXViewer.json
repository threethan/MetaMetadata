.png", "id": "1060301425764847", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75392876_1060301429098180_3558256611982073177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8ckgZEPwf8Q7kNvwGF3jwJ&_nc_oc=Adpds6gezwox6qfsSmKs54o2AR6asSA2ltiuJi-j8mE7UEYhzkSF0L6ZhTj0asiOagc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVOhT1a5517zw2YPIJgDVlGcNcGzQJfs2hQAf2HZntmA&oe=6AC65376"}, {"file_name": "5.png", "id": "1322374582010084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982440_1322374585343417_2194710727263644201_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP_T3NZ_4NMQ7kNvwFxPeq8&_nc_oc=Adpk6B1KUC7g3EJtLc28AB6_2jMds0wmenW98N4PI9Or3c1p2m1WuN5-hY4mArAaFKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORSofE786NKpVK4yVCxr4bdX5IzRT8y6NKl-kNFVQz3g&oe=6AC65A29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WoX Viewer", "keywords": ["woxviewer", "realestate", "architect", "configurator"], "long_description": "Step into the future of property viewing with WoX Viewer Our cutting-edge real estate 360\u00b0 image walkthrough app is designed for homebuyers, renters, and real estate enthusiasts, offering a fully immersive experience that transforms the way you explore properties.\n\nNavigate through stunning, high-resolution 360\u00b0 images of various homes, apartments, and commercial spaces from the comfort of your own VR headset. Customize your experience based on your specific requirements, whether you\u2019re searching for a cozy apartment, a spacious family home, or a prime investment opportunity.\n\nKey Features:\n\nImmersive Walkthroughs: Experience properties as if you were there, allowing you to assess layouts and designs in detail.\n\nCustomizable Viewing: Tailor your property searches based on size, style, and amenities that fit your lifestyle.\n\nUser-Friendly Interface: Easily browse and select properties, making your search intuitive and enjoyable.\n\nSave Favorites: Bookmark your top choices for quick access and comparison later.\n\nWhether you\u2019re in the market for a new home or simply exploring your options, WoX Viewer provides a unique and engaging way to visualize spaces. Dive into your next property adventure today", "short_description": "Experience properties like never before with WoX Viewer Explore your dream homes in immersive 360\u00b0. Whether you\u2019re buying, renting, or browsing, discover the perfect space tailored to your needs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindwox.com/wox-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MindWoX", "support_website_url": null, "website_url": "https://mindwox.com/woxbuilder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8537011196378407"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "536344428995929"}]}, "baseline_offer": {"id": "536344428995929"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729779360, "status": "PUBLISHED", "id": "536344428995929"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8666804986732360", "version": "0.4.2"}, "id": "897957725178435", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bin
wasCy9mI5r893LQPFG_OM0055wh5zAx3QFImF9VQt9GjEjlHEhoxRnm9YjhwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWk9Y6aBy_RwvU9ImC_Sm9WLgL-TbzK1Tuaz3oF_qH4w&oe=6AA7F13E"}, {"file_name": "3.png", "id": "2022579901526263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031509_2022579904859596_4744282089049064683_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlpQfLD1DAEQ7kNvwF7QTHD&_nc_oc=AdpTiUBFbXlHhE2w7SBMU95iEVpDswX2fZK5sewZtUsn_bgdFf6L-F21afdBhyiv4qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK_tAunBB4RXuNYabK_ZPOF1cn71dYB1mBmYqLYhCeaw&oe=6AA7E7D8"}, {"file_name": "4.png", "id": "1060301425764847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392876_1060301429098180_3558256611982073177_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOBo-gauGw0Q7kNvwHSgPgH&_nc_oc=AdqafMSZjPfo9bxHiyTPLfVwHItkg4uWoH0aWmCoSMExMZcKHnFYncKh72yBeWCvMio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRJ-YLvqJr-EEOhOvgCZzcuqWuWe4sJU2WgI6evfhdkA&oe=6AA800F6"}, {"file_name": "5.png", "id": "1322374582010084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982440_1322374585343417_2194710727263644201_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvZ0e4S3nncQ7kNvwGnSUt8&_nc_oc=AdrmNVkNnooeSJfKGAod6G6t1_syn5JpmhTr5Izrf63DfNYePFXn2q_uYy1i93YSblQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpr6okg67MwvN5CpbTwk3aGwlYLN0LO2fhIEMbfUmPUQ&oe=6AA807A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WoX Builder", "keywords": ["realestate", "architect", "configurator", "woxbuilder", "woxviewer"], "long_description": "Step into the future of property viewing with WoX Builder Our cutting-edge real estate 360\u00b0 image walkthrough app is designed for homebuyers, renters, and real estate enthusiasts, offering a fully immersive experience that transforms the way you explore properties.\n\nNavigate through stunning, high-resolution 360\u00b0 images of various homes, apartments, and commercial spaces from the comfort of your own VR headset. Customize your experience based on your specific requirements, whether you\u2019re searching for a cozy apartment, a spacious family home, or a prime investment opportunity.\n\nKey Features:\n\nImmersive Walkthroughs: Experience properties as if you were there, allowing you to assess layouts and designs in detail.\n\nCustomizable Viewing: Tailor your property searches based on size, style, and amenities that fit your lifestyle.\n\nUser-Friendly Interface: Easily browse and select properties, making your search intuitive and enjoyable.\n\nSave Favorites: Bookmark your top choices for quick access and comparison later.\n\nWhether you\u2019re in the market for a new home or simply exploring your options, WoX Builder provides a unique and engaging way to visualize spaces. Dive into your next property adventure today", "short_description": "Experience properties like never before with WoX Builder Explore your dream homes in immersive 360\u00b0. Whether you\u2019re buying, renting, or browsing, discover the perfect space tailored to your needs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindwox.com/wox-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MindWoX", "support_website_url": null, "website_url": "https://mindwox.com/woxbuilder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "ROOM_SCALE
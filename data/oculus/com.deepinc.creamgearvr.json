ce the incredible and wondrous like never before.\n\nExperience the 360 video by simply moving the device or swiping.  For a more immersive experience the device can be switched in VR mode and inserted into a Head Mounted Display.", "short_description": "Explore a world on immervise content with Cream VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beta.liquidcinemavr.com/terms-use-gear-vr/", "developer_terms_of_service_url": "https://beta.liquidcinemavr.com/terms-use-gear-vr/", "publisher_name": "Cream Productions Inc.", "support_website_url": null, "website_url": "http://www.cream360vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "MOVIE", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476381554005762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162754_145236122738827_1880810331182202880_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6T-nYybk36EQ7kNvwGSHZJC&_nc_oc=AdrT2XqPqmDE--Po16MuuLv0eoHvdA__Mq_YDO00rJwwDMMy5hOC_q8aZs27kht9P3k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzT42oB5Y-RhSTcvN1raB8qSykDyExcLdd38kIWQa_GMA&oe=69C1276E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cream VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504112400, "lastRevision": {"nodes": [{"id": "1337764943002514", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicat
7kNvwE9z5ON&_nc_oc=Adqj-Syd41221KxAnd9knOnihafpCGxRu5ij4BM5yuYA904OIGYN3Gzbkm1qNWGEy-o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYnmetbWWeGvxtrOPCnrS1gEBi6FXd9J6UPSQK7dhrVg&oe=6AFC61DF"}, {"file_name": "Mr-2.png", "id": "1540604040800710", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823746_1540604044134043_7039821851878660097_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzm61r8inBMQ7kNvwEDVgqa&_nc_oc=AdpQMzJv1FQc9tAyh0yoXn6fME-6_clEw2uzuEHaiROujtRYCcASf4Pue_oHwIICGKY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlK3SoVOsDfCPDQoZfFaSfIqq1mQFiJtg0KkyfjXEFqA&oe=6AFC6C7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1637319703981194", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820387_1637319707314527_3025907004792913386_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tdGQxFbFBoQ7kNvwH5W4HE&_nc_oc=Adrr-zU4cP2T1--mj4lTNIHT8ynU0X1gdZypeBOZ_uCJBsEt-CF9tUBWOvGKPbNFTcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjuxSpvVPt0Oa5hr0qsQqe7wOwza3pfDi9cAIi9TqJfw&oe=6AFC837D"}, "display_name": "Rehabilitation Hand Exercise MR App", "keywords": [], "long_description": "Rehabilitation Hand Exercise MR App is a mixed reality application designed to support hand therapy and recovery using immersive interaction.\n\nUsing hand tracking and real-time feedback, users can perform guided exercises that help improve:\n\n\u2022 Hand mobility  \n\u2022 Finger strength  \n\u2022 Coordination  \n\u2022 Motor skills  \n\nThe app creates an engaging rehabilitation experience by combining virtual elements with the real world, making therapy more interactive and motivating.\n\nKey Features:\n\u2022 Real-time hand tracking interaction  \n\u2022 Guided rehabilitation exercises  \n\u2022 Mixed reality environment with passthrough  \n\u2022 Simple and intuitive user interface  \n\nThis application is ideal for rehabilitation training, physiotherapy support, and interactive recovery programs.", "short_description": "A mixed reality hand rehabilitation app designed to improve mobility, strength, and coordination through interactive exercises using hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/e16ai.com/rehabilitation-mr-app", "developer_terms_of_service_url": null, "publisher_name": "E16 AI XR Technology", "support_website_url": null, "website_url": "https://e16ai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25951351747872558"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1281471137278576"}]}, "baseline_offer": {"id": "1281471137278576"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777265700, "status": "PUBLISHED", "id": "1281471137278576"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25951530424521357", "version": "0.1"}, "id": "849435518183706", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25951351701205896", "i
dn.com&_nc_ss=7f20f&oh=00_AQEunpwDGxT_lB8-MWAU9_4nO8DVH3zzq-KTsCYcSPpwiA&oe=6A8D763C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1637319703981194", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491820387_1637319707314527_3025907004792913386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3RlxLLfuTYQ7kNvwHdO8au&_nc_oc=Adq3_AJXG-_PbpmsxmqfUJ52kJrPF28xVGv5WFUcKET7FEjq3vcSATtSdDEA9TPuUT4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0zSBdSA6v3piYFVAlAAJTllqJg9AfqQ2JYyyYlzTfNg&oe=6A8D8D3D"}, "display_name": "Rehabilitation Hand Exercise MR App", "keywords": [], "long_description": "Rehabilitation Hand Exercise MR App is a mixed reality application designed to support hand therapy and recovery using immersive interaction.\n\nUsing hand tracking and real-time feedback, users can perform guided exercises that help improve:\n\n\u2022 Hand mobility  \n\u2022 Finger strength  \n\u2022 Coordination  \n\u2022 Motor skills  \n\nThe app creates an engaging rehabilitation experience by combining virtual elements with the real world, making therapy more interactive and motivating.\n\nKey Features:\n\u2022 Real-time hand tracking interaction  \n\u2022 Guided rehabilitation exercises  \n\u2022 Mixed reality environment with passthrough  \n\u2022 Simple and intuitive user interface  \n\nThis application is ideal for rehabilitation training, physiotherapy support, and interactive recovery programs.", "short_description": "A mixed reality hand rehabilitation app designed to improve mobility, strength, and coordination through interactive exercises using hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/e16ai.com/rehabilitation-mr-app", "developer_terms_of_service_url": null, "publisher_name": "E16 AI XR Technology", "support_website_url": null, "website_url": "https://e16ai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "c
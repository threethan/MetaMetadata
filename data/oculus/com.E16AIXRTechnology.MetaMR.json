ahO&_nc_oc=Adp79FYiQX66bd4QqXn0k-weQr15-2zv1YUlNVQwBUMgF25mCFilFgQUwCeBWTTXPO8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsXVRQ1Isvrb1WW2qVE5-WSo2fkkuA95UAzPSWj4WArg&oe=6A8EEAA0"}, {"file_name": "Mr-4.png", "id": "3362366250612125", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818890_3362366253945458_8854866049025020916_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhyOCXfVy7EQ7kNvwFiQCRl&_nc_oc=AdrdQ3MMM0m4HRyMSrMqEeFjMRwbsppzCljbR8lnBaUyCoTB55-XJJ4U27QUHSmiBTY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFE0jrzuraWdej02d7sS6d0dWhc5yDmwpKTUbFhxFPVw&oe=6A8EF55F"}, {"file_name": "Mr-2.png", "id": "1540604040800710", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823746_1540604044134043_7039821851878660097_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-sMxV3QjJUQ7kNvwHHkZB3&_nc_oc=AdoGpEqPUt6Iv-WntJtt1rFGZo8qN3kEGEhzTBA3Bb3ZUOkrrsYiPUZO8YI4mGd2SN8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCMfWCysaMqHUBz-rnfRt7RxAbAYpMUhAtpIlxqFntGQ&oe=6A8EC7BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1637319703981194", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491820387_1637319707314527_3025907004792913386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3RlxLLfuTYQ7kNvwEHiEqz&_nc_oc=AdrvvVQSlZOxUdxLnN5htVtIrV_ZDCCw3j0Row9Ck1Bao-LgiNZ-SjqoYpza7Iw_uSY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1X2yNbXJVkIADp1n_Ljg9ab4u4EWlLw3qNtX52wlqKw&oe=6A8EDEBD"}, "display_name": "Rehabilitation Hand Exercise MR App", "keywords": [], "long_description": "Rehabilitation Hand Exercise MR App is a mixed reality application designed to support hand therapy and recovery using immersive interaction.\n\nUsing hand tracking and real-time feedback, users can perform guided exercises that help improve:\n\n\u2022 Hand mobility  \n\u2022 Finger strength  \n\u2022 Coordination  \n\u2022 Motor skills  \n\nThe app creates an engaging rehabilitation experience by combining virtual elements with the real world, making therapy more interactive and motivating.\n\nKey Features:\n\u2022 Real-time hand tracking interaction  \n\u2022 Guided rehabilitation exercises  \n\u2022 Mixed reality environment with passthrough  \n\u2022 Simple and intuitive user interface  \n\nThis application is ideal for rehabilitation training, physiotherapy support, and interactive recovery programs.", "short_description": "A mixed reality hand rehabilitation app designed to improve mobility, strength, and coordination through interactive exercises using hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/e16ai.com/rehabilitation-mr-app", "developer_terms_of_service_url": null, "publisher_name": "E16 AI XR Technology", "support_website_url": null, "website_url": "https://e16ai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25951351747872558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618440_1477354633878788_8843575319547834864_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4N68Vh0M_wQ7kNvwF5Z4E3&_nc_oc=Adog_Fo9iy5-J_pGFczOJ2yThmtJC5-8y3qE96gxsXRfc2iy7RSP9_nA8OGuk8rSPW8
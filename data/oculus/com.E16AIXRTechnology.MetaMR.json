 application is ideal for rehabilitation training, physiotherapy support, and interactive recovery programs.", "short_description": "A mixed reality hand rehabilitation app designed to improve mobility, strength, and coordination through interactive exercises using hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/e16ai.com/rehabilitation-mr-app", "developer_terms_of_service_url": null, "publisher_name": "E16 AI XR Technology", "support_website_url": null, "website_url": "https://e16ai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25951351747872558"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1281471137278576"}]}, "baseline_offer": {"id": "1281471137278576"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777265700, "status": "PUBLISHED", "id": "1281471137278576"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25951530424521357", "version": "0.1"}, "id": "849435518183706", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25951351701205896", "i
Zc_CGdQ76tdIWrnJLCCk2WM5ZhQ&oe=6A0DABB6"}, {"file_name": "15.png", "id": "2030425817831847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822550_2030425824498513_4512226956402476068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dsgXRGuvZYQ7kNvwEyIqsG&_nc_oc=AdpKKZRidLz-N_9j9QnXYLmnBhetzxY7LrkDNmY2v8mOdwh_r0PNDqOjZGgea6Bj8G8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DOKjBTeg9_UeDjafNcmsQLANsCw_p0CQOKfCPHDd3tw&oe=6A0DB9BC"}, {"file_name": "13.png", "id": "2460787654373263", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822573_2460787657706596_7736767153837395549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld7rLwjkGQAQ7kNvwHjNNlf&_nc_oc=AdohzpIcQ-T9KtMYlp7bjc7MD3apwT75XkkhxAIEi4JxChCXEKLOo2SUd2oUJkh8QOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60AHhCikunGzvFV-VQw3gyIHNaP3mbMlBbMu4_732Chw&oe=6A0DBE27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "potato_climber_banner_2560x1440.png", "id": "1955994921951473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_1955994925284806_9137625690686075012_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxHOhZtr-kAQ7kNvwFLywMy&_nc_oc=AdrFhOVcpFUkgQDZG6A6PaU1tSfHjgf2KHxfJIGMkeojCiPwd4K4N8nRyiwFZ3WdRq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zmaJ7RkBHhlx4ghZ9X6X7w3GP4ts6j2vpYwKtkDBRgA&oe=6A0DD462"}, "display_name": "Potato Climber", "keywords": ["climbing", "vertical", "speedrun", "obstacle", "course"], "long_description": "POTATO CLIMBER is a fast-paced vertical VR climbing game where precision, rhythm, and speed determine how high you can go.\n\nYour hands are flat potato climbers, perfectly designed to grip small flat surfaces, allowing incredibly smooth and rapid climbing.\n\nThe goal is simple:\n\nClimb as high and as fast as possible.\n\nBut reaching the top is not easy.\n\nThe levels are filled with tiny platforms, narrow grips, and challenging obstacle routes that require quick movement and perfect timing.\n\nMaster the movement system to climb faster, find better routes, and beat your best time.\n\nCore Gameplay\n\nUltra Fast Vertical Climbing\nUse your flat potato hands to scale vertical environments rapidly.\n\nSmall Surface Grip Mechanics\nYour potato climbers can attach to many small surfaces, enabling fast climbing routes.\n\nObstacle Course Climbing\nNavigate difficult climbing paths filled with tight grips and tricky routes.\n\nSpeed Climbing Challenge\nClimb faster and faster as you master the controls.\n\nScore & Time Challenges\nBeat your personal records and reach new heights.\n\nKey Features\n\n\u2022 Smooth and fast VR climbing mechanics\n\u2022 Unique flat potato climbing hands\n\u2022 Challenging vertical obstacle courses\n\u2022 Speed climbing gameplay\n\u2022 Designed for fast movement and fluid climbing\n\nThe Challenge\n\nClimb higher.\nClimb faster.\nFind the fastest routes.\n\nOnly the best climbers will reach the top. Climbing vertical obstacle course with precision and speedrun.\n\n\n", "short_description": "Climb massive vertical worlds using flat potato hands! Scale tiny surfaces, dodge obstacles, and speed climb to the top in this fast and smooth VR climbing challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomm
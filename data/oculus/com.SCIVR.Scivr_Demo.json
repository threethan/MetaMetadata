luscdn.com&_nc_ss=7f20f&oh=00_Af9H8hQCaOfaRPdNZL3FOXLtsMMHVDqFp0grzK3YDxcM0Q&oe=6A3FF305"}, {"file_name": "SC5.png", "id": "965418643074841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618297_965418646408174_4911094978214526625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzWoG4MfHf4Q7kNvwEktX3f&_nc_oc=AdpM25s76-Pm-qQahTnXwJqGK2f7gOUU1uhGBSit9hf3VUB9qVtdckuWiasAdYBcgVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84cZKOY-bO1jPGwp2EekyJWXlDnhykFUpkx3N0dUU-sw&oe=6A3FBDC1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scivr Demo", "keywords": ["Education", "Immersive", "Simulation", "STEM", "Interactive"], "long_description": "SCIVR is a comprehensive VR education platform designed to make learning more immersive, interactive, and engaging for students and individual learners. The app gives users access to a rich library of virtual reality learning experiences across STEM, career discovery, virtual expeditions, and biology dissections.\n\nAll SCIVR experiments are designed to follow NGSS standards, helping students learn through structured, curriculum-aligned science experiences. Through interactive simulations, learners can explore abstract scientific concepts in a hands-on way, making complex topics easier to understand and remember.\n\nThe platform also supports career exploration through realistic interactive modules that introduce users to real-world professions and practical skills. With Expeditions VR, learners can visit historical, geographical, and cultural locations through immersive virtual tours, bringing learning to life from anywhere.\n\nSCIVR also provides safe and cost-effective virtual dissection labs, allowing students to study biology without physical specimens, mess, or additional lab materials.\n\nSCIVR empowers learners to explore, practice, and understand science through engaging VR experiences that inspire curiosity, improve knowledge, and support future-ready learning.", "short_description": "SCIVR is an all-in-one VR education platform offering immersive learning experiences for STEM, career discovery, virtual expeditions, and biology dissections. With interactive simulations and virtual tours, SCIVR helps students understand complex concepts, explore real-world careers, and learn safely through engaging virtual reality experiences."}]}, "developer_name": "SCIVR", "developer_privacy_policy_url": "https://github.com/TMai-mostafa99/ScivrPrivacyPolicy/blob/main/ScivrPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "SCIVR", "support_website_url": null, "website_url": "https://scivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "pt", "en_GB", "es", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26891713567150490"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_1655361049068851_6504029601850808243_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw7WTjZjKgMQ7kNvwHcXXtd&_nc_oc=AdrV5nSmXdNeGWUWZJPvPbBwIxIDDiGSaWVnsllHJCtS9h_rfrvR_hQKV3R31KGk3dc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kjiaIG_ULmuexnLvsCU0Khs6djFg51qK0EpZAPUtJbQ&oe=6A3FCCE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scivr Demo", "platform": "ANDROID_6DOF", "cont
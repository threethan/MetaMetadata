dpNhrH9_rAKFP7S6JsSrsCnIa73KeYw3mvqbZUL9qARnMXxxM3UutcCG7_dozTH4Ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5vYRFVw7R9faB5zqdzmvtgqNWy8RZAbr2o-2K1r8Ipg&oe=6A983AAE"}, {"file_name": "1.png", "id": "1287005896777456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822823_1287005903444122_6362063006228621521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biTkz6VaY7gQ7kNvwFBsY45&_nc_oc=AdrhON5Ujj6o9ZG2x4c0--FILd8wvKiBxkXZqCwEtpzb0UMGkiVZcax1po26w95li80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJroNAR4E4FBIpI2aaOSUicOksPAtPAit9Kyd5YgNv09Q&oe=6A984B44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Golf DriveZone", "keywords": ["golf", "training", "range", "sports", "swing"], "long_description": "Welcome to DriveZone VR game, the most thrilling and immersive golf shooting range in virtual reality! Whether you're a seasoned golfer or new to the tee, this VR experience lets you fine-tune your swing and accuracy in a futuristic, action-packed environment.\n\nExperience realistic physics, dynamic environments, and responsive controls that bring every swing to life.\n\nPractice freely or beat your own person best shots. With multiple clubs, scenic driving ranges, and unlockable upgrades, DriveZone VR is your ultimate golf playground.\n\nGet ready to grip it, rip it, and dominate the range. Precision, power, and pure VR fun\u2014DriveZone VR delivers it all.", "short_description": "Step into the ultimate VR golf driving range! Test your swing, master your aim, and crush targets in immersive golf challenges built for precision and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gamebite.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "GameBite", "support_website_url": null, "website_url": "https://gamebite.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592
0AAE"}, {"file_name": "4.png", "id": "2212370359198760", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393518_2212370362532093_9132535613088038675_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCVLZy2jb3UQ7kNvwGU2Aqc&_nc_oc=AdmDgz7eT3e-iD1YUmJ8Mxx8LrER3EHH33FZqXNiCl69I_RvRfTu5R1tleUU450kNuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNTmvV-A5uhGgJJ5rnzUMBlBaemErbxxm6oflIe7iMAg&oe=69BBE7EE"}, {"file_name": "5.png", "id": "4097337057170912", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391890_4097337060504245_5210250059586471868_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7GH7Ja-rI4Q7kNvwG7O7O-&_nc_oc=AdnKOAkEdtgtPUCP1egRbNwo1o2A2syOddce_PLL6A17FXWGB6DV-R_Esc3QBKu0uqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5QkrS_n6Z0Pj1g-0hrz1yTE5QVaS1aY3ZTCTU_HWudA&oe=69BBDFBC"}, {"file_name": "Image Sequence_003_0009.png", "id": "1200524451653416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392056_1200524454986749_795182442484343142_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXN66XilYs4Q7kNvwE4gard&_nc_oc=AdmL0H2RMey7RLDUZeN_3r31ctTxcMI-hEAx7XsZBLnWqjvVIXpawOPQB0BLooTQglI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHSzyF-xvwfpvUt2dLnhQ2VWmohWodwjfybtHJsIBVQw&oe=69BC066C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Golf DriveZone", "keywords": ["golf", "training", "range", "sports", "swing"], "long_description": "Welcome to DriveZone VR game, the most thrilling and immersive golf shooting range in virtual reality! Whether you're a seasoned golfer or new to the tee, this VR experience lets you fine-tune your swing and accuracy in a futuristic, action-packed environment.\n\nExperience realistic physics, dynamic environments, and responsive controls that bring every swing to life.\n\nPractice freely or beat your own person best shots. With multiple clubs, scenic driving ranges, and unlockable upgrades, DriveZone VR is your ultimate golf playground.\n\nGet ready to grip it, rip it, and dominate the range. Precision, power, and pure VR fun\u2014DriveZone VR delivers it all.", "short_description": "Step into the ultimate VR golf driving range! Test your swing, master your aim, and crush targets in immersive golf challenges built for precision and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gamebite.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "GameBite", "support_website_url": null, "website_url": "https://gamebite.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23958905140361678"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1185924693511111"}, {"status": "PUBLISHED", "id": "1052631176714241"}]}, "baseline_offer": {"id": "1052631176714241"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "1185924693511111"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23940934145492111", "version": "1.2"}, "id": "1728499381398701", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "
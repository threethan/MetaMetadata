droJXRQUmH5i-5auudOE0Cim-hhrGOuk2izyD81h0loFuBvHrQO14kb7EJX2edy8Hs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQaIJwv6xbiZ28c0Z7JbYg3bZiDURlmBN9pnRUjMf9KQ&oe=6AB298AE"}, {"file_name": "1.png", "id": "1287005896777456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822823_1287005903444122_6362063006228621521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb6S-1cLc0oQ7kNvwHLMoue&_nc_oc=Adp3iqtVYa3lFDhmpPMZRNaK_8ZAMPfGRCnxf3p5GzCSUiBl61tKDZ1VQPhRJcbu5MA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRr9IbCb4hvHFTZyz-foi36xHoGtynjQrbZRAP4OklfQ&oe=6AB27104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Golf DriveZone", "keywords": ["golf", "training", "range", "sports", "swing"], "long_description": "Welcome to DriveZone VR game, the most thrilling and immersive golf shooting range in virtual reality! Whether you're a seasoned golfer or new to the tee, this VR experience lets you fine-tune your swing and accuracy in a futuristic, action-packed environment.\n\nExperience realistic physics, dynamic environments, and responsive controls that bring every swing to life.\n\nPractice freely or beat your own person best shots. With multiple clubs, scenic driving ranges, and unlockable upgrades, DriveZone VR is your ultimate golf playground.\n\nGet ready to grip it, rip it, and dominate the range. Precision, power, and pure VR fun\u2014DriveZone VR delivers it all.", "short_description": "Step into the ultimate VR golf driving range! Test your swing, master your aim, and crush targets in immersive golf challenges built for precision and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gamebite.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "GameBite", "support_website_url": null, "website_url": "https://gamebite.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592
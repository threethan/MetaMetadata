pk-l&_nc_oc=AdqIpS59othZRwVAlFzJfg6oLcICR0wQVBcQQmGhUCeB3qlqpjrjoRSeioPID-oD_iI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGNTtcegk1qTD4NDeTGjIKgkZJgXKagoizGP7NGGZdFg&oe=6AFDC624"}, {"file_name": "screen_2560x1440_2026-09-19_20-29-05.png", "id": "1406986528231797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1406986531565130_7625733951231081809_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_-eoN3BhGkQ7kNvwH2RhtL&_nc_oc=AdoW5iEy83NS71M6ZsGNIwYPn3erCD3HD6JI-g4OxP2razdUHnq-3527nLkMtRQ5E_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGlMnOyRW6nFcfsnDWeqN3vjZ47ZN20FSCieziYuqPxQ&oe=6AFDB304"}, {"file_name": "screen_2560x1440_2026-09-19_20-29-38.png", "id": "1298679655668004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_1298679659001337_6614122775381089880_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKnWGzS9UQkQ7kNvwFO9W_j&_nc_oc=AdrzIVKo3RfSSBUF4vuRBGOYVSu7nYMdwpehPUYJOF3d9maXF8G-J_xCB-hBysSEH54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyF_QTs1eAjKoc8cqUw-HScFkKK0yGHApQn5pae1OH1A&oe=6AFDC780"}, {"file_name": "screen_2560x1440_2026-09-19_20-19-30.png", "id": "1739610530656755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_1739610537323421_6100310130165285201_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da2F3zhTVJgQ7kNvwHRrPd4&_nc_oc=Adp1FaH2IW0vMEynw8n-JtC1rSKywI1OHPxRGMruib4gl2uHjl6tRAsz1fU2tWgS080&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFLVFCG2SQwT5Kjbd_VUHrYURAy6iFfiQOIxML0GV52Q&oe=6AFDDE9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hotel Simulator", "keywords": ["Hotel", "Management", "Tycoon", "Simulator", "Business"], "long_description": "Step into the world of hospitality and build your very own hotel in virtual reality! Start with a small property, welcome your first guests, manage daily operations, and transform your hotel into a thriving business.\n\nFrom checking in guests and managing reception to cleaning rooms, hiring employees, and upgrading facilities, every part of your hotel is in your hands. Keep guests happy, earn money, improve your services, and grow your business into a successful hotel empire.\n\nBuild, Manage & Expand Your Hotel\n\nTake charge of your hotel operations and experience the exciting world of hotel management. Improve your property, unlock new opportunities, and turn a small hotel into a successful hospitality business.\n\nMake Your Guests Happy\n\nWelcome visitors, manage their rooms, provide quality service, and keep your hotel running smoothly. Satisfied guests help your business grow!\n\nClean & Maintain Your Rooms\n\nKeep your hotel fresh, tidy, and welcoming. Take care of room cleaning and everyday hotel maintenance to create a better experience for your guests.\n\nHire Staff & Manage Operations\n\nBuild your hotel team by hiring employees to help with daily tasks. Manage your workforce and improve hotel operations as your business expands.\n\nUpgrade & Build Your Hotel Empire\n\nEarn money from your hotel, invest in improvements, upgrade rooms and facilities, unlock new areas, and expand your property. Make smart business decisions to increase profits and take your hotel to the next level.\n", "short_description": "Build your dream hotel in VR! Welcome guests, manage rooms, clean, hire staff, earn money, upgrade facilities, and expand your hotel empire.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
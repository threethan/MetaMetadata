90_1406986531565130_7625733951231081809_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_-eoN3BhGkQ7kNvwH2RhtL&_nc_oc=AdoW5iEy83NS71M6ZsGNIwYPn3erCD3HD6JI-g4OxP2razdUHnq-3527nLkMtRQ5E_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGlMnOyRW6nFcfsnDWeqN3vjZ47ZN20FSCieziYuqPxQ&oe=6AFDB304"}, {"file_name": "screen_2560x1440_2026-09-19_20-29-38.png", "id": "1298679655668004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_1298679659001337_6614122775381089880_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKnWGzS9UQkQ7kNvwFO9W_j&_nc_oc=AdrzIVKo3RfSSBUF4vuRBGOYVSu7nYMdwpehPUYJOF3d9maXF8G-J_xCB-hBysSEH54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyF_QTs1eAjKoc8cqUw-HScFkKK0yGHApQn5pae1OH1A&oe=6AFDC780"}, {"file_name": "screen_2560x1440_2026-09-19_20-19-30.png", "id": "1739610530656755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_1739610537323421_6100310130165285201_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da2F3zhTVJgQ7kNvwHRrPd4&_nc_oc=Adp1FaH2IW0vMEynw8n-JtC1rSKywI1OHPxRGMruib4gl2uHjl6tRAsz1fU2tWgS080&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFLVFCG2SQwT5Kjbd_VUHrYURAy6iFfiQOIxML0GV52Q&oe=6AFDDE9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hotel Management: Tycoon Simulator", "keywords": ["Hotel", "Management", "Tycoon", "Simulator", "Business"], "long_description": "Step into **Hotel Management: Tycoon Simulator** and experience what it takes to run your own hotel in virtual reality.\n\nStart with a small hotel and turn it into a successful hospitality business. Welcome guests, manage rooms, keep your hotel clean, earn money, upgrade facilities, and expand your property as your hotel grows.\n\nTake control of everyday hotel operations including reception, room management, cleaning, staff, guest service, upgrades, and business expansion. Invest your earnings wisely to improve rooms, unlock new areas, increase profits, and build a thriving hotel empire.\n\nExperience satisfying hotel management and tycoon progression designed for VR. Watch guests arrive, keep everything running smoothly, improve your services, and grow from a small hotel manager into a successful business owner.\n\nFeatures include:\n\n\u2022 Hotel management and tycoon gameplay\n\u2022 Manage guests, rooms, reception, and staff\n\u2022 Clean and maintain your hotel\n\u2022 Earn money from satisfied guests\n\u2022 Upgrade rooms and hotel facilities\n\u2022 Hire employees to help manage operations\n\u2022 Expand and unlock new hotel areas\n\u2022 Progress from a small business to a hotel empire\n\u2022 Immersive first-person VR simulator gameplay\n\nIf you enjoy hotel simulators, management games, business simulators, tycoon games, job simulators, and relaxing progression games, build your hotel business and become the ultimate hotel manager.\n", "short_description": "Build, manage, and grow your own hotel in VR! Serve guests, clean rooms, hire staff, earn money, upgrade facilities, and become the ultimate hotel tycoon.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
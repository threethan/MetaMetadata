VR. Watch guests arrive, keep everything running smoothly, improve your services, and grow from a small hotel manager into a successful business owner.\n\nFeatures include:\n\n\u2022 Hotel management and tycoon gameplay\n\u2022 Manage guests, rooms, reception, and staff\n\u2022 Clean and maintain your hotel\n\u2022 Earn money from satisfied guests\n\u2022 Upgrade rooms and hotel facilities\n\u2022 Hire employees to help manage operations\n\u2022 Expand and unlock new hotel areas\n\u2022 Progress from a small business to a hotel empire\n\u2022 Immersive first-person VR simulator gameplay\n\nIf you enjoy hotel simulators, management games, business simulators, tycoon games, job simulators, and relaxing progression games, build your hotel business and become the ultimate hotel manager.\n", "short_description": "Build, manage, and grow your own hotel in VR! Serve guests, clean rooms, hire staff, earn money, upgrade facilities, and become the ultimate hotel tycoon.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310544065481189"}}]}, "scheduled_offers": {"count": 2, "nodes": 
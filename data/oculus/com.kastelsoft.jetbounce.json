, "video_trailer_thumbnail": {"file_name": "Jetbounce Landscape - 2560x1440.png", "id": "586942085786567", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031529_586942089119900_994448641142430003_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaLXCOUzKLkQ7kNvwHnYgxJ&_nc_oc=Adnrdjgwt4oGNnJGH5rPHsFcsQwkATbe5pzC4q_oXmx28WVxxP0JM0mDEEluQBajZVs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuNG2S5r3NioAp5wYrWBSHt0pYFiaFz4e2DK7GNxwQmFw&oe=69A180A0"}, "display_name": "Jetbounce", "keywords": [], "long_description": "Jetbounce is a Collect-a-Thon Platformer where you collect gems and explore large open worlds.\n\nAll hand crafted levels and obstacles, designed for multiple paths.\nYou are rewarded for your exploration and boldness.\n\nIntuitive controls: press a button to activate your Jetpack, release it to jump and fly at the direction you're aiming.\n\nSpeed & Momentum is a double-edged sword, the faster you go the longer your jumps, but the more chaos it creates.\n\nIt's a challenging game that does not hold your hand, but you get good at it surprisingly fast.\n\nWill you reach the top?", "short_description": "Jetbounce is a Collect-a-Thon Platformer where you collect gems and explore large open worlds.\n\nAll hand crafted levels and obstacles, designed for multiple paths.\nYou are rewarded for your exploration and boldness.\n\nIntuitive controls: press a button to activate your Jetpack, release it to jump and fly at the direction you're aiming.\n\nWill you reach the top?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1wv8p_ZmThhlgjrFFQX-9JzDVbA1FcMdDUYqefYzExHs", "developer_terms_of_service_url": null, "publisher_name": "Kastel Software", "support_website_url": null, "website_url": "https://discord.gg/eMKhfBmR8E", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504
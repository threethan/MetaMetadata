ld that is constantly changing. Tune into events, changes to the map, or try out the latest cosmetics.\n", "short_description": "Wild is a social VR hangout world. Explore a shared city, meet friends, and host events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thatswild.com/privacy", "developer_terms_of_service_url": "https://www.thatswild.com/terms", "publisher_name": "Wild", "support_website_url": null, "website_url": "https://thatswild.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26886035337720312"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_1037872682247083_2920005251174337534_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_fXp3gn-UsQ7kNvwFGqY4s&_nc_oc=AdoLfpi-EbQD3zxt7-vfdX6oUg-oU2suKe0ihCWYssNTb2cCresBSYGTPmPDdkhTBBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLQGlTZAr9PrbZssYMeE-rUPZZhYrdCjNFOO94i1flEA&oe=6B0489C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wild", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Sandbox", "id": "1990104051447093"}
 city, meet friends, and host events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thatswild.com/privacy", "developer_terms_of_service_url": "https://www.thatswild.com/terms", "publisher_name": "Wild", "support_website_url": null, "website_url": "https://thatswild.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26886035337720312"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "635112089332150"}]}, "baseline_offer": {"id": "635112089332150"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780432800, "status": "PUBLISHED", "id": "635112089332150"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27325533333770508", "version": "0.0.42a-alpha"}, "id": "1747157855833311", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9420701278013655", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27325533333770508"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783375595, "id": "27390907740566400", "version": "0.0.
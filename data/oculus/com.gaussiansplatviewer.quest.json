34185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WVqOVP2NcQQ7kNvwH3oHvT&_nc_oc=AdqbMKcWv5caIDs_KP8ApgoP8PjcvCCtavHGBFE3XhsOqYK9MkwE96NvPZym09POlDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-htZgMZBUbJSCgG7DKOmzQHv6gDPE8N2APoZjBY-f3g&oe=6A50FDD9"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A97y7NPvKVYQ7kNvwFV6YEL&_nc_oc=AdqiV3Q8fgYBpBCbP1HLMk57BSb9S8rdIs7hDsFzdxYLmleAbJPlm7918ShlMlIMUbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABFuVEa94HqgkYnkY3lWIOIezgLBI9LXHiLZdPNPbwDA&oe=6A50F017"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvjqGLBxBzYQ7kNvwGCyaUX&_nc_oc=Adq7LXBQFBtPbkmGuCWKcfQhGVEiKvbUcWM4XlhB8ku-2dA1hVE43L1LQzh8fsLKQ1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSA2dMVknZCt74F1WgciWH-hUvh9OanpbAycYt1owerg&oe=6A5110BA"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fekiv4kdiD8Q7kNvwE8_Lkj&_nc_oc=Ado3jm7WuWtN46CrOOjsOutbr1vYbEmQXJH7H1uXe41JEFSHpAsEtq39be_YRu-poPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfUXPWYeG4noD8c7We1jBKhb0I5FrzHNJXmELvrC39Bg&oe=6A50E71C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoQJ34OTQWQQ7kNvwHQM35C&_nc_oc=AdrUI01Dm168z92Q8eo6OHtW5qraFtqf_VDOoSIa5Lvykdyau2nD8RNMzbPPq1fQ0cw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeaq-IBvwHw7fYxBSCaVa1QHNcBiJE3vlAai-W23H5pQ&oe=6A50E18C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326
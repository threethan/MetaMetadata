34185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WVqOVP2NcQQ7kNvwEF8S7D&_nc_oc=AdoGU6uGEQVLZ19f-t0HeockZfkfSmBPUySU84FL8fyhXD9jU3zcOwpGgjg9e1_-aQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs5Ycw41D8uq56mlRr8vT73ki8MQVojPlNiyP6hjHEew&oe=6A524F59"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A97y7NPvKVYQ7kNvwGu7DYA&_nc_oc=AdroXMH1p3HzlMyqPN5K3_ogWEyRBZ1Kd6LXmGiuN96MzQpDW_yysiJk7fi52qGUvsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAzpnNEWE6YQe5brDf0-IJsltyTmpxCKIS_vZ2KG4ljw&oe=6A524197"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3DUr6T-rs8Q7kNvwGarj4k&_nc_oc=AdroIEKFnvo62yEF23i3N-BuP6_GCoGCXmfZPgC4fIm7N-JUNMJsG9nnqh7rNpTIDY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgDm0BKyL3rkAgTOMo7pGp2JRjwnG5Ic3KwppfyxK50g&oe=6A52623A"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fekiv4kdiD8Q7kNvwHJbtbB&_nc_oc=AdoRbbttJHvJWtt1ZT4QHb68fRTgWB8hppbOh6OE7etYQJlxg6yA3TGqxUmvKczmoK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaB73aJJabTUUsZV6_4cA5UeRwB4X_QA_ouvL6PGOzHg&oe=6A52389C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoQJ34OTQWQQ7kNvwH3UVrP&_nc_oc=Adrwa_whrijimoC00Pef184AHuDdMu5OCJxTqIFr313BL1itZG8bWC9o99WgfPtFoHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlW0fIdzE7xE_oNaHWkNCfC7qP-IffFGRM4zyg2J_PxA&oe=6A52330C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326
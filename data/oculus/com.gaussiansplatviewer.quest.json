wg4wEn1BaY-_jQTiEGbYZgdjWHqx4g23BSAtb2eVp2prMb4ZNhdk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH5L1JteBcJFUyYhyOjganKIvPNqyiuWWLpi2xrJv7QQ&oe=6B08513A"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFKJIA6DlxMQ7kNvwFL9I8v&_nc_oc=AdqN58Bpyyw62UGC9oi4iCYbq9Jp6sAd6Fqe8Bw1cR5YMf0C1cN1N6AhrcjUANSGS40&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEm6lq_bb9RqO-wU1vbh0gQl6PYN_PR-r6rXGLHqYtmA&oe=6B085FDC"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_8P8tetjPoQ7kNvwEfsPyk&_nc_oc=Ado9-_d_KvJk8z3bD8Be4wj1mDFlrg6Qc4p6nW6KZAmosgbOsugtiVFacyToJCvGrNQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8hrSRaPTcAmzCIq300komjU8MEfymqEiKvVUxoiPtbw&oe=6B085A4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1075611242311716"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "927516990308133"}]}, "baseline_offer": {"id": "927516990308133"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782480060, "status": "PUBLISHED", "id": "927516990308133"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1352667034606134", "version": "1.26"}
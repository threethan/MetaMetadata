34185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WVqOVP2NcQQ7kNvwFU1QYh&_nc_oc=Adqvb-qvp5MsS6soQSvy4lLuaoqBzesmHx2glb9nOiXVvlOY8kpiv0foVdzcLFaucUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCir845c_e8m5392VH4Yvbmr-2zatFgoAgCeocGBnDeFw&oe=6A4FAC59"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A97y7NPvKVYQ7kNvwHjOYCq&_nc_oc=AdptuTvA5HsYCfbIh0dH-JQPCkE03iXTGe5uo-t2xO5L7i4kyGZiGWld3lZ33uMOY0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9EMBZ5i9hJN7bI7j-RYDCroXCpq4C_GmJCnddTw4pBw&oe=6A4F9E97"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvjqGLBxBzYQ7kNvwF12uii&_nc_oc=AdoLib-5p992WMrR980RQPEU4vuEEiWZej1fJQ_7M0HavWZnPUtl5JWphp5BPgmCjcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgwv1bDFhnzZWMPtSdAP7k_ZrMFAAFtQKAqARg2T2eqA&oe=6A4FBF3A"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fekiv4kdiD8Q7kNvwGgqNpu&_nc_oc=AdpXZoSyrtSCNJUpcd5sO6Nlis3_i2XXwr1PrB168d8iQtK0CRrbHnlstT2B-Q1g22A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa8NkYaqKQwwp6CSVzLiB8kGhyR_8c2X05geq-NLqvHA&oe=6A4F959C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj3PiWsp0G8Q7kNvwGoNb4W&_nc_oc=Adr4jenq5Jbp9r8jyvk_HbV8rnFa5BUbS4WRda39pL1SeU7V6qEA66g1Wb7VjX9hlpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXwI4vIFStXWRoXrMF3CpMkSxlUAkD9W3LPtNfTqGsIw&oe=6A4F900C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326
t-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1039234185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee47zW22OxwQ7kNvwEALh3O&_nc_oc=Adoya-fKihye40Lg0MWaV2WCoY9EiBGI3xXq2Gq9IF9YkvfbBSuoNNKg_ILfFQpeqnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjZa92rqtdjDcW8pvCfFvcgedsSFjd9iYwTtO-YPnx7A&oe=6A4BB7D9"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T07WaUBSvdUQ7kNvwFypLqP&_nc_oc=AdqoYKuui5F-HwRgcVxnbF4JCYv-JWLXamPhe8M_cd5yJektozGSYPdn3clWVvXx-aA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhTyUwvCNogc684e3nahlMVAKE52cfwVgYOA6GDbhhyQ&oe=6A4BAA17"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgXCHBXbjzMQ7kNvwFAbiWz&_nc_oc=AdoObi87T5z4ZNTSk1MncAk2tCKx4C2dJNBUoGINRnWprsEP7MWk_ZmsFuniRa6qqNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXCW1fhcY3FvFEai71pdJiMNRkBzPwptykAS6uPVgX-A&oe=6A4BCABA"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRC-OHGtVScQ7kNvwERL8AU&_nc_oc=AdpTnPmWHuAfnTmzfbGtDqvb8R19GQjUzjw_J_IvOaT2QjHMq60fPdLrhhSl_vW62zI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM5DKRNOPHWQRgGJ56EY6emVQNw8cmDRoHS0oGd3Z-Iw&oe=6A4BA11C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNPz01wtFEoQ7kNvwF9IVH6&_nc_oc=AdqaXewJBCv7kVAv__oYwihD9iyU0VeG3IufouL6sPWXAmE7QoJTeCCqL_axk6qhdPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvLNIXKDgK18w8l_W5bINkC2FExYQLPnHFWHbPYOhpgw&oe=6A4BD3CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
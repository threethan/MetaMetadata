34185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee47zW22OxwQ7kNvwExA1Hj&_nc_oc=Adq0Xh1fZn7H-6Jk9fyhsXliMii1THDbUdkfdtGvbkE9Ij8S5rwwzh6yV_1IU9mMHZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD-QiV__PwIjRAFFhvNof5gWuPFYlDQ-mjuURJY6sbPw&oe=6A4D0959"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T07WaUBSvdUQ7kNvwEPPjNn&_nc_oc=Adow6bCcwica_cuQltZtkLjs8IKMOsEpK6SS3Q-bCdeBnt5KhCTTqzYZGNiLz2JCVX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8bL4FxLp59lugB4wthNTOr_XajNocpFCRGxT5rNqV_w&oe=6A4CFB97"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgXCHBXbjzMQ7kNvwE1nHYX&_nc_oc=AdqFxgaadxqbRxLLpjk_SAFuU8eVvyuhq5CUO515n0Xjjj_Q3tv12jfsQPaJhMIM37c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsQ2AoH_5w5R_U0XDP3Z7q5g6r1Nx6tPVUkmu6m1U0FA&oe=6A4D1C3A"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRC-OHGtVScQ7kNvwGwowrx&_nc_oc=AdpdyW67biOgRd-ioH96dhLg7UTM-9xR91ZJN9Qwq63Nu-Tvla_5EkQ8CueC3Pnrukw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTGBhYt-SEgCF--8wjlgjfF6CzjjsUk5U9OUrp-Pb07g&oe=6A4CF29C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj3PiWsp0G8Q7kNvwHRLzLr&_nc_oc=AdqktGsZdeJ_yaLXZe62nq14mkkWXi5YM78uGjhMPF2vzFoo1NTVTYVCILm9oC0zC7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfRDoIH_72K_v2KGlUDdjRBRiS77jSHqhKboYomQZl4w&oe=6A4CED0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326
34185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTv2Vynes7kQ7kNvwHD5w2h&_nc_oc=AdrCWAEZt4YD4FiIaBMNIBv5ZHKOpZOV-SowOldUSPPTwip0Fnmnrkux3ggGNUt6f9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxeW6Vp0rN5YuRqAOY7_xLHx-K68rGt0KwgM2xqH9L_w&oe=6A4A6659"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T07WaUBSvdUQ7kNvwGJXWFk&_nc_oc=AdocWWutW7GSmXat96Nch3uvyDOUPHoI1ciiCAJbtayQC3NlUpXkCBUh1qeJP_k5kyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzLMmpSt-D0jg2-_dzZI2Fr6gmPSoPcBLBLbM4QQKqzg&oe=6A4A5897"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgXCHBXbjzMQ7kNvwGryY5f&_nc_oc=Adr4E4CagErnWsrOv-rkTQVYG5vt-DS2O5GmB5tAEQXPkzeXm5OAErDyQyMslmElysw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChP3rQ53JSmK3dsqrzOdtJSlt-Hih1LePgThxxkjA5Mw&oe=6A4A793A"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwALs70FhAsQ7kNvwHkLedv&_nc_oc=AdrUpCIBSjogJOFVNJgI8W-WoGjBnRRDOS9jp7E1lqrcTXkUzMC_Iw8bZY7uy8ImjNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPpG6dz3Kwdpp14hul43SlonQP9ulOQK5WDBbS_uilMA&oe=6A4A87DC"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNPz01wtFEoQ7kNvwGJk5rq&_nc_oc=AdqHvp8geTjoWR6ig1y7mcWuMEpYpJKbBXLuIMUckX4hyIytR3fecCwtXLm9J33TMZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHq0J9_Qg6-IciP-F73ti7Oaq8aqQwoT1YgfefxKAr1Q&oe=6A4A824C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326
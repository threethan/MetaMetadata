t-sea1-1.oculuscdn.com/v/t64.5771-25/491825345_1039234185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFg-ObY6Iw4Q7kNvwFhcfki&_nc_oc=Adod20yIzP7LLtATYJPyHLw429G0g0O5nT-KNDDGz8tJxrR3EsqPJ8Dt0LVZSOmzyJI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPYfKIIgRWzKGPynaAQoDlmhTRzmLp3vnO7CzSzrJnSw&oe=6A53A0D9"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puLIqc0V-OcQ7kNvwH-PO55&_nc_oc=AdqJ0jGqtcsZekE0SmvJPAj-1dDB8SYMOVaYckuTwvba_WTd6LFMMW2zLYRDvHZ84VA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADvmMCRmXQT9eji2uvEADENo6Oi7ijEGtguo9zxpkuQg&oe=6A539317"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3DUr6T-rs8Q7kNvwFhVqaA&_nc_oc=Ado1dAuno8wHrdrQ_mf17dq9wL1dxUTuTvPIzeXCukTdkYyjC7srF_6i0JknYSdGgas&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIV0b5nFsVlISj9biKW-TXfCfCFX4DjAO9Y-yx0nseMQ&oe=6A537B7A"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7sx9pOGIOYQ7kNvwG1pQG0&_nc_oc=AdpLgYmb2ovyxXia8JuXdOpMUDrjMcgkAe8zYhEVPYPc6Fipfy2dwsZmrgRy8MDT5Ew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCusCMp_b-Y8qSs-tdElhkEdW_AcU6NKljaMf6DNlgEhw&oe=6A538A1C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoQJ34OTQWQQ7kNvwFUeT2Z&_nc_oc=AdrlGQN_tQGeCdQvL17kBP8IyBSCdl8YJCgbUNl7fqHwftvnkp_02kSdvLxzbojGDQo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY4JNiIHVW_cxwFfcCDalXfT3g-TmOkYPhiqdMHfOGMA&oe=6A53848C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
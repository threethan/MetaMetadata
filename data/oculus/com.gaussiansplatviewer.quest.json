34185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ee47zW22OxwQ7kNvwEvRnq-&_nc_oc=AdpC7rQkEKJwag8MSKkBWf6LG8jbpL0WkHm6Ac7UIJd0o8866sG6qs9f64RupUxU6wM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK1OHKypASQFjkNPTLn--sxCcABvGpPHZv2PNb_nVGcg&oe=6A4E5AD9"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T07WaUBSvdUQ7kNvwHwHJb7&_nc_oc=Adrm4koOEp3Dg8rfCQXaRYAqVs4vxhYjzsM_I_MZ4fAziArw2Q9lH7h3-4TKIk2I4c4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8tV9G9w6WiI-js2ForNPQY7xPU6lg-xak_deSn5bziw&oe=6A4E4D17"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvjqGLBxBzYQ7kNvwEg7MCM&_nc_oc=AdpC_sZQyZzA1MD8Vso5yS4wOWnBMvQVCmSCU69qvAwgnGC8OCkK42LAynxGCMy3fP0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOb4LQR7aysSnCwv7O1PF0dP6wemRmhbbtHOj3Xl-WWQ&oe=6A4E6DBA"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRC-OHGtVScQ7kNvwEhB9iS&_nc_oc=Adr6yDU4kJ8ty5z7FyIbHLAzrEXs4-DWza9gSIQnTQaHjW0LQTACIwrbtFqKMphJ8Iw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGvNj-PkRBPdkDoNIXOd2v3VDeKAuc32zicwqunPb82g&oe=6A4E441C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj3PiWsp0G8Q7kNvwEuqZW6&_nc_oc=Adp4SxsGLB4VdbsdP3QEglZ_cpzFSdiwES2zWM2rGcf9irlx6z0bcXzXed3YnybRXiw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALjhQlIXdGB6F0Bo7LCCH_vzOQV_lN74-df7c-wZiTFw&oe=6A4E3E8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326
10713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG6LgtLMH-MQ7kNvwE6qzQL&_nc_oc=AdrtSq66upRN7S0L9Ip7cam9Y3WdidglTVnDoDFhmsM0lSIMAWuFUMKq5z9NxzyPXAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJbUoUFPDEAEeVwscDMY_o9kC9F5bufkdQrFZdaCGGhA&oe=6A9D74D9"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QElUrhRzGKEQ7kNvwFs9jRF&_nc_oc=AdpgCC2c69rfUbPnAGSdPDuN5Hr4B87dLp7qFXdK3OWXOk8-l81_HNJhBIEr3jN55Jg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ35YEZpo7vfeqi5-UDjxpXB-_Ss7Q_vLBDLBy9rJLU_g&oe=6A9D6717"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTnUEmayMugQ7kNvwFz2VF6&_nc_oc=AdomFOgeXGKpuJCOTYYizBjVRAD7q1RL0DV24tl_S3ASHrTwlEEL2s0BTeMdFuFt8J0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFQJPzQHpS8sDgtMFj0CLSYg7xBViGUCfQKHX5GsTK-w&oe=6A9D87BA"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sD0t3Vim3m8Q7kNvwGeoalr&_nc_oc=Adp0bZJabFm-vGEop_xD7AXcLzbX8gkhXzy9r4xoyBicrhm6lu1RtIik0fxfrtVOaOU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK19fcGU3qNUMP9jmzy8HTPBs3fBFopnH8UGpH9aT6owQ&oe=6A9D5E1C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fH_3olnnBdcQ7kNvwGtlS-I&_nc_oc=AdrDHjDSBirpdojdPZuRJ8s9xtifbPpFBWKBwE8SQn6O09tf9KwJTGhaA1YXMuxKHM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHFrHkIigtAU0MYut-s5nDrxM63G8oWisA_oTo48la7A&oe=6A9D588C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "393222478507326"}, {"id": "10
t-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1039234185714438_2610713394567281666_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTv2Vynes7kQ7kNvwFTquO6&_nc_oc=AdroQVZU-V-411AfQx1ipLsrJELkQCv12M28S1k5ldzcOaC94u9wyQHKyokrBal91YA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC3rzbjA-N7_hHsUj_K4RcL0VeIO68KiGxJji94tjFjw&oe=6A4914D9"}, {"file_name": "screenshot_2.png", "id": "1608738764262699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/704976392_1608738767596032_1711235809187454662_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhJiswBZ7NAQ7kNvwFWuhLY&_nc_oc=AdqDQAtqPKG06naXCRZnliNkOX8v2pRcclU4oSRcF31KP0rDLPxVkzT0_KjkB16QvDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4S18GsNJ3eKfJMBdMeLnXnL1JRp3MBYWSlLUq1Xv2Bw&oe=6A490717"}, {"file_name": "screenshot_3.png", "id": "4395120384148907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_4395120387482240_875473705056262726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFJNqInGTE4Q7kNvwFXQM95&_nc_oc=AdqqdNjfzgILx3vyFWvpCaxAh9TxH_vOg0Ch2WY9ZZU0PAkfgRwDz2XekQaKYr3FD9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_CxdzzisOq-PNn8dGQuf5jd4m-Hfsd4qbn2wtfvw_AQ&oe=6A4927BA"}, {"file_name": "screenshot_4.png", "id": "1541172497658993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1541172500992326_7866378130643520771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwALs70FhAsQ7kNvwHvvucc&_nc_oc=AdofP47MAHTukHEdPj5HZDS7YlyXEGmVTn1lGytC3Rm2qzZ4hd3tU7tAI476-IKWDgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgI-CR75zg1PVuiOSDMQVDM2I9B61nhPpBijzDui63Zw&oe=6A48FE1C"}, {"file_name": "screenshot_5.png", "id": "2214609659364045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_2214609662697378_2687220015106522791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNPz01wtFEoQ7kNvwFhEEHK&_nc_oc=AdpgI_FIay0kkgwaYauBUXicZhnsutlBkhBG5aPpqDPejPUNizPMUrVH97jg1qTkP4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtOXFluiNe72HJPjZWrYnrmUxAvI9Q2u1gzT7L-JMOWA&oe=6A4930CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GSVision Viewer", "keywords": ["gaussian", "splatting", "3d", "photogrammetry", "ply"], "long_description": "# GSVision Viewer\n\nExperience 3D Gaussian Splatting scenes in stunning virtual reality on your Meta Quest 3.\n\n## What is Gaussian Splatting?\n\nGaussian Splatting is a cutting-edge 3D reconstruction technique that creates photorealistic 3D scenes from photos. Unlike traditional 3D models, Gaussian Splats capture real-world environments with incredible detail and lighting accuracy.\n\n## Features\n\n- **Immersive VR viewing** - Walk around and explore 3D scenes in room-scale VR\n- **Intuitive controls** - Easy manipulation with Quest controllers (move, rotate, scale)\n- **High performance** - Optimized rendering for smooth 72 FPS on Quest 3\n- **File browser** - Load your own .ply Gaussian Splat files\n- **Adjustable settings** - Fine-tune splat scale and color saturation\n- **Example scene included** - Start exploring immediately\n\n## How to Use\n\n1. Launch the app and complete the quick tutorial\n2. Browse files in `/sdcard/Download/GaussianSplats/`\n3. Point and click to load any .ply file\n4. Use thumbsticks and buttons to navigate and manipulate scenes\n\nPerfect for architects, 3D artists, researchers, and anyone curious about the future of 3D capture technology.", "short_description": "View 3D Gaussian Splats in immersive VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mt5.foundation/en/gsvision-privacy", "developer_terms_of_service_url": null, "publisher_name": "MT5 Foundation", "support_website_url": null, "website_url": "https://mt5.foundation/en/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": 
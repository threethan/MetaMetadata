uscdn.com&oh=00_AfshcMF2nWxizdp1F48UyyH1ZM2UKIez13a3eTkFfzXomw&oe=69A19B24"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4FdEfCXY2MQ7kNvwGmQON4&_nc_oc=Adl-dpUn1fdOV0JjOIa0oBoJVIGHqzOQUz-KgQSD-TJsrl_Wy1NyKWXCjtQGwcwVpRI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvD5_Ig2LH1XmgETF66E_aWZFwrJpYHjw9cmfNTSkRH0g&oe=69A195C6"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfb3X7R85pQQ7kNvwEVqcIz&_nc_oc=AdnOOe_Rdfh4iUwtXWYhiX33n2UCF6_2R6phxeLC9fwDuf6radAzm_TCIf2S6vnchMY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftXWl2l3NBNt3MU7j4wfIUrOuJMeNNhweu1648wpF6beQ&oe=69A17E56"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYZln6Bgc6MQ7kNvwFKRDX1&_nc_oc=AdklV-cLQfeZrG7UOdulymmgiRxI13MXkaDIWdvDudtCLZWSTLoWz1FpKeXvq4kCMgI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsYbbx70yApJEON4EPaJWAWJo3PF20d24g_0rISP-PGoQ&oe=69A18D9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT84Pgl0kOoQ7kNvwFcPQ99&_nc_oc=AdlHXAVg7GByIIQ0d1SYP2pRuVvCnmDoRt-UCpKXfNvrWTei4FVSoWhZRVoNWKRFc5M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvQhmFnlWzAv89ybf92mY71iE5eCv2hCIrxLNzfoiKSrA&oe=69A18513"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "6830816583684674"}, "review_messages": []}]}, 
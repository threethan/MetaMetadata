UUPDJuC3Epvvh80eUeDWDLN61rsg304wek0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWln58lmMAYicymsYpwJ0hO_zw5iG41OFdPiyVCDv-Ag&oe=69BD4AA4"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJx1sGw-VtQQ7kNvwE7yCyo&_nc_oc=Adk1FYL4xW_m2rbg_K4GiAPWq1RH4lk5N6798Vvi26mnwf4jThjBSVlmfP3zQplKJa4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzZV8LCQca6ij0HljKFeWdrYNKSdEk9S2MKY4_jXVTsg&oe=69BD4546"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVfZflPiTkoQ7kNvwG8UbXi&_nc_oc=AdnwVkXMr3yaXblPfsgXNq11d5zTO22MJihhdYQEA6qZFrxDu6U2g6krVOUf3NGTOQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdxVbky4sQ4NLAZg5E4F89ab4SuDlOhbaI8RqDAgYg3g&oe=69BD2DD6"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MotDFlCr_fkQ7kNvwG9p2y8&_nc_oc=AdljgfYtw-iUkFrwvdw-BeoNVHkHSWNSgpAbo_-_M8uNuT17ZwWTX41znNHHAtpa0W8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRRsn9Ejsc7gphRRJodzurs-FYIXNmmU0amOs0zVAc0g&oe=69BD3D1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKTQk36m1EMQ7kNvwEJ4ES-&_nc_oc=AdlgP0AjGNa6y7tE4yvpbiE9U_7mHWeDx4830iQXV0HBSsIi1U1G0RwuTymd4k2L5GM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIq9pUiug3rg7Nm1zlIA0VtGUNKiDNYmWz0BfFnQ1BJQ&oe=69BD3493"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
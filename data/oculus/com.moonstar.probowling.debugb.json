fGvLQCIxR9xNubvKzB8CfMSt20Y7aOEypPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUOVG7lJIsWSFmYbfyzHmix8OOyn3xBm8cWgarvz7L5g&oe=69B6B324"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vkzjnav3jSoQ7kNvwEITA70&_nc_oc=AdkjRQY-Jjq3BIiJaA6Sh0_ikm_4clQHRlMwsdCA-p_dHnnMEBsb9WwBLQngt8ZjDjY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6PEP5aq4MO0BYy_IcpzmFygnRjNqjTs8rXUkL0cDyxA&oe=69B6ADC6"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBA3mlYHbbUQ7kNvwHlta1i&_nc_oc=AdmIo-NuncB_vd1yF-IvYp__pp7jGaJ5Yq-facGC2hwQ1LVTvuh0tLQMDuINZKvRd04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD6JyF9gn-u4P1f2q80eYeV44jPcEp6D5jRdW3NwI0qQ&oe=69B69656"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgcy5nyMGYEQ7kNvwGxBjQ6&_nc_oc=AdlNfLowdnzRYvM-sz5d_k09KFXTvsrXVwnLnM_z2iE2ENwOhhfoBUSeeN0b-ERH_Ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuhnCChvg5QwR_NtuuhuQTuucIjn_od_gFTpe77_JRMw&oe=69B6A59F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pW9Ahk0rEIcQ7kNvwHW_Ou-&_nc_oc=Adk8TJh9YIWqxYWosn_mDW5pMUJhP__sB5-u_7MS8EPY8sPsMI2HYj6fELqhsYsKR_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzw8bU5c9N432FmbL8ONhNKAj2wvF2ESx4NhHz70LHCuA&oe=69B69D13"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
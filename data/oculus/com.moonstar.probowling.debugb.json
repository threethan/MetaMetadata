D&_nc_oc=Adp9_BtdzImSscaGSqY2wYkwkFIvQ9oMLV4bGgeiU41bCFj9_nYy7FM-o8uqW-psmTY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQHjNzIPF2rqyvXThzJDJSKcYkaVVmdxYqwyxaDjE5Hw&oe=6A8D97A4"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEP2j47Fw84Q7kNvwEW21Fc&_nc_oc=AdpHDB44W6DNAwcUaPgj0cDu_oG7f4U7XXCQsMgfs-8MnQ6hB1rRt6cbvJkD81mB188&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0Zqipy1AQYlyxm0PuNmu9PH-ys1H4hSZRH0PuH-Gkaw&oe=6A8D9246"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKwTDyrfDBwQ7kNvwF0sunY&_nc_oc=AdrCy4gVWGxGo5tu_licWQ0KXbdgE_JyAhpuLA6sfelLWxN-PY4Uh7irAFoieRgQ7J8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGWzvPSUwmOsn6Pbk07Oc0g2NNqxxDsOoTsahemWfhZw&oe=6A8D7AD6"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZyuKmBP5ooQ7kNvwE8RM3y&_nc_oc=Adp2dQZusbhwvwVLn70H7QUL41mQqjVp5k-sN0CrXr4anrkcw9Bw4IWRRif60jI5NUw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwrX0ESt9UbQfI0lwKKe7yD_SFouAdVb7c_J42vNr5mw&oe=6A8D8A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1yofRx0JYYQ7kNvwFnAM9d&_nc_oc=Adq4KzaOwPtxHHD77XAt4B7aMj6yLEeYmEbwqlrduiLeMRSrrVLRwcT3E3MvfDV1lFc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5QDV3y_WVN_V8nUDN_sZUr9JDt72IhH2Ocm4BV9EcgQ&oe=6A8D8193"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
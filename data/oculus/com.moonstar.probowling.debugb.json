x8OSGYFWK8nBpSA-KW8imEV8w4252UQLrz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvL8eadhMlJ5Dcq5wCa7B6sVLqJ0W4-V7c0a4lRToNCA&oe=69BBF924"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZM4fj9DUVYQ7kNvwGoX1mw&_nc_oc=AdmdnR5r1d9eLkdGkYXVVDkmIa-Ok7EMSI7CA-vkL1Q896jenFPKgGVRtxRFzFDVVr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2Tfh9mFKaPSvcZ8FXWxHVQEprO3ROgjJTIeeNTJrD_g&oe=69BBF3C6"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVfZflPiTkoQ7kNvwHwWfKi&_nc_oc=AdmRedqgBFuTh5jkoHihVL7GoQn93HuS9mCKAz4e5JxNIsa4w7RCip8AkihMmRvaSSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxE2Q5FsAHhtzVZT3BDYS_RjJ4HaFRWbU4CA41TKI3gmw&oe=69BBDC56"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MotDFlCr_fkQ7kNvwGDtWYk&_nc_oc=AdlWnTwdpuQsFXV8hqZb1ivL9JzMEFrvy26ruD8cGSBxbt90Aur7LXS-6ob-G0x9Ij4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsisS4sK-PzgJyNgrjuEQf1aQq0Sk5ELg3WSsF12sV_A&oe=69BBEB9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKTQk36m1EMQ7kNvwG7af5n&_nc_oc=Adnja_OkECwpWcAe6LM7hzG8MAmfeUNKkVlIzOwIC0bmwyNWPc2FXFJ2-CPeMUZpMxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-w9BFp-EeyxPI-xBO4Ed_YNuFs_s9uAbVDBwfz7lDIw&oe=69BBE313"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
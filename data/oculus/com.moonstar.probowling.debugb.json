eJeIMIavsOBS-zASIXM2wRQoLK1hcoKYbFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfznYvUbn8iIhXQXjNH2h4CVX2GdPXsl1E2gbCYYYN5LmA&oe=69BFEDA4"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJx1sGw-VtQQ7kNvwGStXOq&_nc_oc=AdlWtxtpP3IZ2x6A6G6NIF10ASfKvUAkldxTZThfCTkpGFkiUIJEBWpHilYyDSfD7EU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqwHahh_VQ9t7m-yUKjSeaOWSmQIcapfenWpsmhi4CAA&oe=69BFE846"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgYO7_I3xtcQ7kNvwHQW_Fn&_nc_oc=AdlkYBJGw5pMqSCx2RwHbOZgFn7Rnn2Hx0qJYS8ah6Y8FWx748ToKWy-KK2LG-YeAeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqMqU4f_9B_cwZX8TBuedNskfbr3LM3GFSgUxwc-g3Cw&oe=69BFD0D6"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NolVE9SmepUQ7kNvwFywGqc&_nc_oc=AdmRaq_V1-LFWs2HnfQ2iltvt3usEYejf9pZGD6NVllq9VfCWENGG3q7aRUlzJPS0tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIgShPFDbY2PBHa8HqyAMbtTN6zV1wmMA9SioJrrJpRw&oe=69BFE01F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7iQWVMpVJIQ7kNvwF6HIVK&_nc_oc=AdlvFnhpDcSV76rYDlgmzThocOTcTXpbUqyD2kXCvjqCioZrJlxKX7O3yI1BUdYquOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgIBmI-uzaklO5Hu-ho-JXF13DgIr5KAo21C6o7wIf2A&oe=69BFD793"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
c=AdrIXArzMsoJhHewaSCmTt5d1Xbeh5RqFfTID7UnSeLR5SCMrgj_a9j2sca3gUiE6yI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nHcM-e4wDDBTcuK-Ui0e3EActlMdi-oRF8k5jWvqqkA&oe=6A3694A4"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwbn8syjq_IQ7kNvwFhElsm&_nc_oc=Adq4BEeDTaylPD14UJtJoH1zwYXyzshoK1EnoQunR669j_BCI4meS4loyiNNeTcgDiY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MgRGGNzpmX85cg4OPiiKTJxuOx3q9Wct4OXa0yDk1oQ&oe=6A36C786"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJjhzAWaOXQQ7kNvwEUeO3y&_nc_oc=Adq2Vuxm-5ioaGd62BWsRf1vsr6UxYQgHiHqI6c6yuhCn7n5nsPj2go1NlBJiIY0bAU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gn80vzeIdqs8gLDDO30MUVYGlGvM_WrFH77mVDvQ0Ig&oe=6A36B016"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB9z2UbZ0KIQ7kNvwGTRW5t&_nc_oc=AdogaBKxJiQ1njBWfTWQ7zOUWtJwOj9H2Ia5YVCsxwRmOvl5H8mvXDbTnYY-z2QLJHU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rAKc7ldQhggX6NspHzNWw4k4_CB0C2X3wmq2TNK_gxA&oe=6A36BF5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utjMGKKMvlEQ7kNvwE9HV58&_nc_oc=Ado8hH0z2BzFHeeddG6_5dTeVB6tEAtS2cRRnG1OK5xpBnKS_TR82O6sTzawKpmapeE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_22GRBvqA2NMLXsomL9_IjAuyRdhXUDnq8oGGtgBr6kg&oe=6A36B6D3"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_
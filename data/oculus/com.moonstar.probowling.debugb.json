op5bAS_n0vfYrQt2Fd4QBPGv5tz3fNBbaZQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRHWiVyKAoCeVh6eoHV1h-66Wpa83s8BUMB-jV3nA2Mw&oe=69BAA7A4"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZM4fj9DUVYQ7kNvwFWaCwp&_nc_oc=AdkC1VyoeDIN_SExmJ6wtgomBhr2KOqb5yXhCxmdPZfEzOWIjlgXP-baFfEeRqNb8yk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwf4N6nCsvQWFkFKQ38yGJwgOI4ZQf6EHiH5ifhl6zX2Q&oe=69BAA246"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVfZflPiTkoQ7kNvwFRNL7N&_nc_oc=Adkk-tNF5jKRjDFreKP-3PpkHNtjQZRbl9Nhi4H3rJQRChFm2DZlKja86np0SYxogDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyKo5JpmVQ0cS1xyvUKBrD8O4_pFEI6Wf0sxNJAbZF-Xg&oe=69BA8AD6"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MotDFlCr_fkQ7kNvwHOCWM7&_nc_oc=AdnFO1lslgv-Ng05X8u4BouQYmoNLJ1ezrOBTEi5wcztBABHOYv7ozZ-dayw9j_EDLc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3B4XUzceS8MjLo6QUwOzU9n2fSUEX07oEwm-m6KEQKA&oe=69BA9A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBsh-Ucj4-QQ7kNvwHmYPzs&_nc_oc=Adm71y8Z7xrT6uFXaAMjkBydxD8kY--nGGkwAVTjxdry0PfTi4Z4cE25Ypg-yGk54hM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy-yjonx1MMeWNYMBeqgVjURXZwsDyCqkICHx-wrdM55w&oe=69BA9193"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
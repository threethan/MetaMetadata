c=AdqrfWd1qy5CZxbjPS4apW3xvBOYxwgnyrmTGX6-8-cPYSb6gVDROydxtTAU5RQXy9M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9wVbOjuxi1UYb_LBYTOfCydE7ebNh-DkRH78tcvafGw&oe=6A22CE24"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr6FESoni7YQ7kNvwG8F3Aj&_nc_oc=AdrorFIzIudUDViS_s9zIzraNv7eeICcAUtEWD2d_0OP-6gd5YC9qlsX5eEogvAxjYM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qh8CEHpAjsn_Y9zX0O7GUj0GL3uW8SQz6noc95sfdrg&oe=6A22C8C6"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eODo7kq4dZMQ7kNvwHO-Cb1&_nc_oc=AdpqHy098EVSDooXLV-m3KpNo5RJCMPq4uIIa28HRbzWiznso_S5I-4UzfvwuCQGpFM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80u3q1ujGT1UunoNsoiIaNI9eweAnHXrnXgQeVT05LZw&oe=6A22E996"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41h7SERCujUQ7kNvwFFAdzJ&_nc_oc=AdqugR3E9Dr5f_iRW_vcS9G_6ZET2ppEPAesnL8npYM-iE0GUkNGMgMLy7NMVFietxU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DQnTp_AwEqwAE16-4WyapdanETGYFDLhZ0YHzLElGpA&oe=6A22F8DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2UdjLA8d9UQ7kNvwGvFn_P&_nc_oc=AdpBxQNfxB_1ROXkjKgLx43uNeRKsLhCAjB1edVyWskE8NA8qs2p4w5r3bI6LSMno18&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nt4JKljv41z7J7m3TY5hRenxgu89fRBH-heCPduc76w&oe=6A22F053"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_
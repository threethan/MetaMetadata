i&_nc_oc=AdpztR9AP2JfGVLUiDqZY-ZxGIWuYKagUGC2zRsPQDcxCiXYP2OLv8TkRX69NMkxg8c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVWdj6_EwMFAUL9AfH8IYLwa378Hm6jO9-aPKbfHtQ6A&oe=6A85AEA4"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJWgFffKkLIQ7kNvwE_TL_d&_nc_oc=AdopG8p8zXR5ePYp4tRo5OMCgKwVJ5pY9Liy99nthFFShFhbjqhH__HUMxYBTHHHkDw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7CAIoSI3H1Wx__Mj1tCauYwfgReBM2AWeBwIViORg4Q&oe=6A85A946"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d9yH7N73-4Q7kNvwGlMlJ1&_nc_oc=AdqZEdYgleMiK3lYKFfHhunzUCCAVNKfAMZW3FZLRj9b1S0gsmjsrh6_B9J6U2iVqPo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7BzswQ6g_qL8pI5NNuUnYssyyoXTC4sEPqzhIHv2GoQ&oe=6A8591D6"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJ18DR4tkA8Q7kNvwGmH4kc&_nc_oc=AdplManS-gYWUOQRH3xB9cPsYvoVtkoMlGxUS0ArVrVqRj-n_RVp5WKWWzGy6GSq06A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF41QNQlThml2qyAi25C6EpUdDQK60TNTN-ujdW5YtbOg&oe=6A85A11F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vE1wQ5KOzIQ7kNvwE2rDN2&_nc_oc=AdqDApH8w9Glty95PXZ9Cs1qJ9-5L_5HBpD4SZsQe7-dBC92a3aMBuhvaj9NS5KkYfU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxjTlJ1V4IZJ7pfdXSkcK0lPletJQv46ClZyLcBzjljg&oe=6A859893"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
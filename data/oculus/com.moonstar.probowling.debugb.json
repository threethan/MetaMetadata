qF6WPv-tMjaqERdCe4tdz5vkD_FjkunXjgg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwy76t9aOvM193uLaZBT4qqXh01t8pZ-BXSNEUmbbat2w&oe=69C13F24"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVJdJTH_V1EQ7kNvwESpjDz&_nc_oc=Ado9PUdD-9SM-hpflaofObjBRnVBrgSIj5sS1DVJBLJwPhzW_PyY0oRmjFvxHRz0CQI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTBEyTaBXSUEb7Mygqyjr7wg1d1Q-6mCildC1rdQzgiA&oe=69C139C6"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgYO7_I3xtcQ7kNvwEX8Hux&_nc_oc=AdrPJT967bWDD6RzgIQvZuwBhf5OtwKir8rgKNCKO4mxtVLc0EXVgLHdRp1pbdo1FHs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFu3s2W6STBKMWYwekSQjc3l49aob_qqC6mqGGT4oj7Q&oe=69C12256"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NolVE9SmepUQ7kNvwGhB1C0&_nc_oc=AdrfirMiXFWUASKbqY8lC9WcjMzP4FX3cyYacAQc-yE4fD6a3ZKvn0_xrHgOo5ZVCpE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFvIJGo81arxHDnrJB4Y-rTX5l1K1qMBocc9EBrbTaXA&oe=69C1319F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7iQWVMpVJIQ7kNvwFTBNJ7&_nc_oc=Ado9BM2uqZjP2fHvVsZdDL8olsIPa0O3V7KHFPZRpJOzwZnS6Ya1xliriXKCpkrf4zM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRXoNJ6DFnbqse5m2tGfqCF0RK-8T6UCsQuEGxfjBDIg&oe=69C12913"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
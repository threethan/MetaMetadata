L&_nc_oc=Ado7JtKiYun-a6VMi-XToO0Y41l0PBbYZaVHVv5rMa_2W5cNPONeByHuNlv0Idkczc8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtT8QmqEHWsE-f2qOuIgdi95jYCc_HoFOPGqXZv5Aj8g&oe=6A8EE924"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn0vHM0aGmcQ7kNvwEH0soK&_nc_oc=Adqsq9lqh_818r4eAWM1Mv0sSGbbqWzrpxwgTYoC7OERSbdQWdTkqmiaOYM4p65p9kQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnO7OW5ZI3C6oqnYqjjYJljPXz8IoriNmDBiEeLg5D7g&oe=6A8EE3C6"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKwTDyrfDBwQ7kNvwFFyztU&_nc_oc=AdogJ7NPmYTbKRY2yrD2ReICpNAIe0oxLDMQ_0BuLvLLyb0nYDJVMskZ68_OPyTylZ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJXt526m-CdSwWtBITuj_fdLu_SP0jszxHN4iyJ_ZzlQ&oe=6A8ECC56"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZyuKmBP5ooQ7kNvwHVhaq7&_nc_oc=AdqAuABm-lz6qQNgPyOH2aCISwk4E1aMP97NXweM1QJnvQAAa-GCDKTga7JsmmIEkUQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX7Q0JhMNnCgsFun5uKus2lhLRPwG0_hV917PnREtCNA&oe=6A8EDB9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1yofRx0JYYQ7kNvwHkUHMQ&_nc_oc=AdoSWclHVK6viMAhxsiPQkV-tLE9F0uw0nuhY5tGE2idfVSQduFR4K_X61pe4zHagYI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHF5Vkg6KBvx8OCCQ3sJ5ANUetiOE9ZK16JiMOxC41Sw&oe=6A8ED313"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
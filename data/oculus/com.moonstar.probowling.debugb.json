uscdn.com&oh=00_Afv7SR4n9Gj_pQ9siTzMOnXUD-9otwSANSALGU01KxRKgg&oe=699EF824"}, {"file_name": "PBS_screen_03.png", "id": "852506935715148", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_852506945715147_8145460534137450628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpnE3_JRCtgQ7kNvwFch-iX&_nc_oc=Adkp0ocvqOKmDWcZFjqyNVRCqI_GtPDi9acsuEgZCmXOMsb_TwlBkCS0iESxdWBYzD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsiL1_EZmoYEwBQYalRryCJA-1L-q3bamaaSb-hrTtX5A&oe=699EF2C6"}, {"file_name": "PBS_screen_04.png", "id": "1508046849656891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_1508046856323557_936814310806023400_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfb3X7R85pQQ7kNvwFZ2lKT&_nc_oc=AdlQCE4j_-dBzkyxgCt0UnyA6OdUB6PLOVSzXyJrG0_P0e3I3J1PzhKOm66gVecoWSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftLvhbO7l_KzEqhco_O6L6xd4YxOaCmFiiWfqbwChY71w&oe=699EDB56"}, {"file_name": "PBS_screen_05.png", "id": "849228486441144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_849228489774477_1664850757641330586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYZln6Bgc6MQ7kNvwEXu7ID&_nc_oc=AdkQFCEqHSMJhqiTT0lEbN8NmUfBRZ0pmueJN09_ZQSa0p14D22UPwt-dYtK5_hjvl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvAy5AcXmFWeIeFKAdYQviMlJeeSKLDgpt7xHivjXaV9w&oe=699EEA9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "5611790352244147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031393_5611790368910812_4809372919932531516_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOpmMehExYgQ7kNvwFGy5IN&_nc_oc=AdlMXNdhIYk3zX0yZTcukliQT4c2CuddgFx0rnjwIsPW3Z-BwYZlrDKbFJ-5DV50oJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu4PMra9_XW0DtVNsf45jhpZpZ0LjK48olTRJ9FPNmWGw&oe=699EE213"}, "display_name": "Pro Bowling Social", "keywords": [], "long_description": "Bowling is a fun sports game but you need to go to a club since it requires a large space to play. With Pro Bowling Social, you can play bowling in the comfort of your home. \nPro Bowling Social is also available for Meta GO.\nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them. Pro Bowling Social is also available for Meta GO."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "http://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "6830816583684674"}, "review_messages": []}]}, 
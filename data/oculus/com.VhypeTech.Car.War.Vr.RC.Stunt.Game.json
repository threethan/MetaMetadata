983244660_6615002093131769634_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIfrZycbRHoQ7kNvwEn7jX1&_nc_oc=AdpztXLEqdMrp2AcGEDOBvexyfi4EffF0z4VT6SH2f0rJDCkQf5RkrY99lPfd7C3UiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3yboRMLp73OLUGmG1UW4WnolewCFuhArfh5TPL05RlA&oe=6AF89897"}, {"file_name": "5.png", "id": "1062837435691242", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392048_1062837442357908_3730609957565045373_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEN1-8ZKGQEQ7kNvwH4hsQK&_nc_oc=AdpNRq1P9XW_k05bC-450MHZsC-Hb_IZ2zNK4KSmwJknSxf_es3DPm7KQdNDg7cknF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfmysVYYdmeU3wgVBpTO-ah8YQ-onrV-Rlsxf-Rl7Hmw&oe=6AF8A913"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car War Vr: RC Stunt Game", "keywords": ["driving", "race", "mini", "drift", "fight"], "long_description": "Car War VR: RC Stunt Game is an action-packed VR racing and combat game that puts you in control of high-powered remote control cars armed to the teeth. Designed exclusively for virtual reality, this single-player experience combines arcade-style racing, vehicle combat, and extreme stunt driving into one adrenaline-fueled package.\nStrap into the cockpit view of your RC war machine and enter explosive arenas filled with jumps, ramps, and AI enemies. Use skill, speed, and strategy to perform jaw-dropping stunts, avoid deadly traps, and blast opponents with powerful weapons like rockets, lasers, and EMPs.\nCustomize your car with a variety of upgrades\u2014boosters, armor, wheels, and weapons\u2014to suit your combat style. Explore unique environments, from backyard battlegrounds to sci-fi stunt zones, each crafted for fast-paced, chaotic fun.\nKey Features:\nImmersive VR racing combat with intuitive controls\n\n\nHigh-speed, physics-driven RC stunt action\n\n\n- Customizable cars with unlockable weapons and gadgets\n- Challenging single-player missions and smart AI opponents\n- Explosive visuals with slow-motion effects and dynamic crashes\n\nExperience the thrill of car battles in VR like never before. Car War VR: RC Stunt Game is the ultimate test of your reflexes, creativity, and combat driving skills.", "short_description": "Race, drift, and stunt in this high-speed RC car VR experience! Build custom tracks, upgrade your ride, and compete solo in action-packed challenges. Designed for Meta Quest, this immersive racing game brings remote control fun to life with realistic physics and endless creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vhypetech/privacypolicey", "developer_terms_of_service_url": null, "publisher_name": "VirtualHyperTech", "support_website_url": null, "website_url": "https://sites.google.com/view/vhypetech/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36741325648799633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_1434246531079221_185108857377797307_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt8E_VulluoQ7kNvwENSjlJ&_nc_oc=AdozghusxlYDrkl28y-jQTCUFSJOJSO0LnXUt6uGZNQhbUgF2AIXwUIz-iU0vqJMokQ&_nc_zt=3&_nc_ht=scontent-or
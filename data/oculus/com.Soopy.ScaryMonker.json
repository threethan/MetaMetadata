QGM4YVOLwQ7kNvwEJLTg9&_nc_oc=AdpMS_3PwflyIwX09ORZT8lWsZob8o11Y6oYLSplb_Mmjv7_9JXN8O2x7YGU6s0RauM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOALkls06C1WLacbLnse_a1aa6TjpuTvxr86abyo3gyUQ&oe=6AD10164"}, {"file_name": "www132.png", "id": "992011852366584", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391888_992011855699917_4664387633957780153_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBmQp0IFYSMQ7kNvwHOjrte&_nc_oc=Adq909JtRMr84tGvKQIkBqwroAJGXvoSP7mhmlYW4hDeMUx7_W89n4FJEvaA9c45o90&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4rZ6rp-KBk9tPxNWjbSVdvG558Dj1IzAS9_BZic1hIA&oe=6AD0F9F0"}, {"file_name": "Untitled Project (4).png", "id": "1789253262028577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396833_1789253265361910_6269823640374934718_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBPpWRwm1y4Q7kNvwHkj-99&_nc_oc=AdpXlChSb5Ymnh2gabWNipRW32yTGiybd4aiq0DpRsKfJTMcI0_5urj3N_3SttlbkY4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-YteLtalKoN82pueL4qA_zv846nRJVHJ_B9iswjhMUg&oe=6AD0EFE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monkers Horror", "keywords": ["Multiplayer", "Survival", "Adventure", "SciFi", "Action"], "long_description": "Immerse yourself in a thrilling multiplayer experience where players delve into an expansive network of intricate tunnels, each twist and turn brimming with mystery and suspense. As you navigate through this vast underground labyrinth, you'll encounter an atmosphere thick with tension\u2014something unseen is tracking your every move. The darkness is not just your adversary; it conceals a range of terrifying monsters that eagerly await the opportunity to pounce. As you strategize with fellow players, you must use your wits and teamwork to survive the relentless pursuit of these lurking threats. Will you be able to uncover the secrets of the tunnels and escape the clutches of the creatures hiding within, or will you succumb to the fears that dwell in the shadows? Prepare for a heart-pounding adventure that tests your courage, survival skills, and bravery in a race against time and terror.", "short_description": "A Multiplayer Experience In Which Players Go Into A Vast Expanse Of Tunnels. But Watch Out Because Something Is Watching You. You Must Survive The Monsters That Lurk In The Shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/7a10cd74-5f3f-4c0a-aaa7-1d753caf0078", "developer_terms_of_service_url": null, "publisher_name": "SoopyStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/scarymonkers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9488960981159865"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1911496896152730"}, {"status": "PUBLISHED", "id": "848973103984218"}]}, "baseline_offer": {"id": "1911496896152730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773516720, "status": "PUBLISHED", "id": "1911496896152730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9358430600879571", "version": "2.0"}, "id": "2825799064258550", "channel_name": "LIVE"}]}, "is_for_oc
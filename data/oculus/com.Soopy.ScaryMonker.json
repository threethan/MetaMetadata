vTLOay0TW1ZXzw7UH-QunJG1OLfKah4ApQ&oe=6B0B1B2F"}, {"file_name": "wafdwf.png", "id": "557584453966898", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391986_557584457300231_2980009166712791989_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9God8YHmctoQ7kNvwExtENr&_nc_oc=AdrQF-u5LOfBUpxAcOv9hC3yNc61oY-J4cYFBZ-dYno76qxi9_t5xb7xAhvZZ4vOYmk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvlg1NHHdfvcmDtR1-XzcmymomjeRfD9M4IHSkm7WloA&oe=6B0B3BA4"}, {"file_name": "www132.png", "id": "992011852366584", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391888_992011855699917_4664387633957780153_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xH6FoBVGy4Q7kNvwFVFGkq&_nc_oc=AdpJW0KEqnLjpJ_jvuVInm26uFoKoxSZs3XDxqxeEIy8WxJElQbGYjBj1hx17G1mBk0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYh_kHnKHkB-MZas2ntBRCbmi3382JR9d24rX6VhXtSw&oe=6B0B3430"}, {"file_name": "Untitled Project (4).png", "id": "1789253262028577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473396833_1789253265361910_6269823640374934718_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Upk__yPpSIQ7kNvwEm6eRo&_nc_oc=AdpbKZze9TZYqVIUQLePpELhPWnd9jrH4476Q2o9MJ1kjSq60QZUYH9tSPdN8XEYusU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2GeRfFDlJp-hHSuT0Sm-BFzl3IRs_qBV1-yINjaDjUA&oe=6B0B2A22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Monkers Horror", "keywords": ["Multiplayer", "Survival", "Adventure", "SciFi", "Action"], "long_description": "Immerse yourself in a thrilling multiplayer experience where players delve into an expansive network of intricate tunnels, each twist and turn brimming with mystery and suspense. As you navigate through this vast underground labyrinth, you'll encounter an atmosphere thick with tension\u2014something unseen is tracking your every move. The darkness is not just your adversary; it conceals a range of terrifying monsters that eagerly await the opportunity to pounce. As you strategize with fellow players, you must use your wits and teamwork to survive the relentless pursuit of these lurking threats. Will you be able to uncover the secrets of the tunnels and escape the clutches of the creatures hiding within, or will you succumb to the fears that dwell in the shadows? Prepare for a heart-pounding adventure that tests your courage, survival skills, and bravery in a race against time and terror.", "short_description": "A Multiplayer Experience In Which Players Go Into A Vast Expanse Of Tunnels. But Watch Out Because Something Is Watching You. You Must Survive The Monsters That Lurk In The Shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/7a10cd74-5f3f-4c0a-aaa7-1d753caf0078", "developer_terms_of_service_url": null, "publisher_name": "SoopyStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/scarymonkers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9488960981159865"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1911496896152730"}, {"status": "PUBLISHED", "id": "848973103984218"}]}, "baseline_offer": {"id": "1911496896152730"}, "is_approved": true
&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX5sItBOBqqDwvdnk4SP69Yau4J5W-yzxBSyAhcNMv2Q&oe=6AF9E49F"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1597495655396684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823837_1597495658730017_6181913131719431746_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsKPSokf5CUQ7kNvwH28-dE&_nc_oc=AdqvyIZ1o7Wrdcx_V3Efy9437N1fSA2PDziFcDwVQlJzPunwLei-AgQHp6yQRyZMAoI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS7vl3Jx_Hb5Oe8cAN5zPHhMLbRGRw0D2scPmslq-m9w&oe=6AF9DC66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Word By Word XR", "keywords": ["language", "puzzle", "education", "learning", "words"], "long_description": "Word By Word is a calm, hands-on way to practise a language in mixed reality. A sentence appears as word tiles in your room. Pick the words up with your hands, place them in the right order, and hear the finished sentence spoken aloud.\n\n16 LANGUAGES\nEnglish, Spanish, German, French, Italian, Albanian, Portuguese (Brazil), Dutch, Polish, Russian, Greek, Swedish, Norwegian, Danish, Finnish and Czech.\n\n500 SENTENCES PER LANGUAGE\nEach language has its own path of 500 sentences across five levels: easy, medium, hard, advanced and expert. Short everyday phrases come first; longer sentences with richer grammar follow as you progress.\n\nHEAR EVERY SENTENCE\nEvery sentence has a recorded voice clip in its language, so you connect word order with how the sentence sounds.\n\nMADE FOR FOCUS\n- Minimal, distraction-free design in light or dark theme\n- Mixed reality with passthrough: your room stays around you\n- Hand tracking only, no controllers needed\n- Daily challenge and statistics to follow your progress\n- Fully offline: no account, no internet, no ads\n\nSessions are as short or as long as you like, which makes Word By Word easy to fit into any day.\n\nCredits: the French voice is based on the SIWIS French Speech Synthesis Database (University of Edinburgh), licensed under CC BY 4.0. All voices are listed in Settings > Credits.", "short_description": "Pick up word tiles with your hands, put them in order, and hear the sentence spoken. 16 languages, 500 sentences each, five levels from easy to expert. Calm mixed reality, hand tracking only, fully offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/wordbywordxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sq", "cs", "nl", "da", "en_US", "fi", "fr", "de", "el", "it", "nb", "pl", "pt_BR", "ru", "es", "sv"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1104258199142038"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673728339_2358625081616112_2690368312830065173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95eivPOdzXAQ7kNvwEdKZbw&_nc_oc=AdqB3CkvBjz71c1w1TlyWOA9ycdTI_sLpsBy7Y2IkQ7mE9gHoR8HpYWdr9Q665ZZKsI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVtYfecrvp_kCsu2VaLOiz2ue5Ck98F5UwZj-4LVvehA&oe=6AF9C6F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Word By Word XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "A
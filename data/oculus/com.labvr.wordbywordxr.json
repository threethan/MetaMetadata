87"}]}, "id": "2555350191901948", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2_2560x1440.png", "id": "1695234808611736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1695234811945069_329839893095373357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-FexFEhXcQQ7kNvwG3kZl6&_nc_oc=Adp4krvFSep5MEJ-P7v8ifYi8KkEYChb-jhb7pJnzBdngwCVpXiEcupCoLeEdH52srQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN_zvCsrYLc-puVCOnWgFvZsCr7ghjxwg-A2ZjNzHjcw&oe=6AF71579"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1030369956741522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1030369970074854_6034646144114303308_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um-Rt3AG4MQQ7kNvwGqKwNh&_nc_oc=AdrlMPi7x1ll3EGx8IWw8EGma6soJisib8m3s3i_KEJ0Qbgekq4SdAZDJ_tv1BJ5fjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoGZJXzSwgxB9RTzt-MvIetnyyCAWRnmNzXCPKEaZv3g&oe=6AF72E3C"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1429021868801809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_1429021872135142_1329119672013247248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-vRU_a2eY0Q7kNvwG_eSqp&_nc_oc=AdrxjrU3mjCSIa8wYu6hbiQlr5Po0wYWpK_ag7sP3C6LYoG_bMTe2Mu2UFClP1hGK0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAuRWKjYXCWiG8FsQ2Ot9c5o3HIkgJLr5xYKv9PFvHMg&oe=6AF71673"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1690105662675957", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1690105669342623_6688115334799341693_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqjY4AMxJoEQ7kNvwHGkJqa&_nc_oc=AdqdiDQSVdkYEtrgBGI_VssaV57H8qa2x_IQ7VEyKy7C6GYrgeUgDCovZk8wZ7-trxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5MvkdF3dfgKc1LF1xjWHpzKTPIC2S8C2fwXUAe7Fvow&oe=6AF7419F"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1597495655396684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1597495658730017_6181913131719431746_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiyQoScjgqcQ7kNvwEL6_EO&_nc_oc=AdpoCEY2bGsmJ7nWg7cNu54eoxX4o7rezZ75w8u-cb-oaBW7fjI3aTEqwqfM3l6CO0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR07ezgR8Ckn-HscGBT7K4Rir6Yn0vdPi6PU8Xxy7yjQA&oe=6AF73966"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Word By Word XR", "keywords": ["language", "puzzle", "education", "learning", "words"], "long_description": "Word By Word is a calm, hands-on way to practise a language in mixed reality. A sentence appears as word tiles in your room. Pick the words up with your hands, place them in the right order, and hear the finished sentence spoken aloud.\n\n16 LANGUAGES\nEnglish, Spanish, German, French, Italian, Albanian, Portuguese (Brazil), Dutch, Polish, Russian, Greek, Swedish, Norwegian, Danish, Finnish and Czech.\n\n500 SENTENCES PER LANGUAGE\nEach language has its own path of 500 sentences across five levels: easy, medium, hard, advanced and expert. Short everyday phrases come first; longer sentences with richer grammar follow as you progress.\n\nHEAR EVERY SENTENCE\nEvery sentence has a recorded voice clip in its language, so you connect word order with how the sentence sounds.\n\nMADE FOR FOCUS\n- Minimal, distraction-free design in light or dark theme\n- Mixed reality with passthrough: your room stays around you\n- Hand tracking only, no controllers needed\n- Daily challenge and statistics to follow your progress\n- Fully offline: no account, no internet, no ads\n\nSessions are as short or as long as you like, which makes Word By Word easy to fit into any day.\n\nCredits: the French voice is based on the SIWIS French Speech Synthesis Database (University of Edinburgh), licensed under CC BY 4.0. All voices are listed in Settings > Credits.", "short_description": "Pick up word tiles with your hands, put them in order, and hear the sentence spoken. 16 languages, 500 sentences each, five levels from easy to expert. Calm mixed reality, hand tracking only, fully offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/wordbywordxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sq", "cs", "nl", "da", "en_US", "fi", "fr", "de", "el", "it", "nb", "pl", "pt_BR", "ru", "es", "sv"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1104258199142038"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1136529215751655"}, {"status": "PUBLISHED", "id": "1012496115225309"}, {"status": "PUBLISHED", "id": "1929533578402101"}]}, "baseline_offer": {"id": "1929533578402101"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1798056000, "status": "PUBLISHED", "id": "1136529215751655"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1105223762378815", "version": "2.2"}, "id": "1736620105140073", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1104258189142039", "is_concept": false, "latest_released_binary": {"__typename": "Andro
3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS32PO2bEZQY9lNlDzP9EyZwzmhDLytyf1Pjqw7d17j1g&oe=6B04709F"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1597495655396684", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1597495658730017_6181913131719431746_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCgGFxfwZUYQ7kNvwG2wyP_&_nc_oc=AdpOVvPs-BFCuOa5wv0vf9bk6tN8WEKm0ZGqzIqE5S2IU2E86uSNcPkkxRWrmKp9Z9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVbvHJuDzr0PYcvc49jDjEPh67XlAULZoZSfMvIYnjHw&oe=6B046866"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_cover_landscape_2560x1440.png", "id": "999091842658311", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771288_999091845991644_8773837507644002766_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfF_8-Su5ocQ7kNvwFsv4lh&_nc_oc=Adqm_M6uNsFu7kl3VMEl1hqtFiQMxA6uKCv_wQAli3ty_nrfjjn-c6bABGG_HaZQDhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw1ernQZoCbn186xzVnwAWdj3X_sGQ_wKOeVTXsZKPlQ&oe=6B047CCA"}, "display_name": "Word By Word XR", "keywords": ["language", "puzzle", "education", "learning", "words"], "long_description": "Word By Word is a calm, hands-on way to practise a language in mixed reality. A sentence appears as word tiles in your room. Pick the words up with your hands, place them in the right order, and hear the finished sentence spoken aloud.\n\n16 LANGUAGES\nEnglish, Spanish, German, French, Italian, Albanian, Portuguese (Brazil), Dutch, Polish, Russian, Greek, Swedish, Norwegian, Danish, Finnish and Czech.\n\n500 SENTENCES PER LANGUAGE\nEach language has its own path of 500 sentences across five levels: easy, medium, hard, advanced and expert. Short everyday phrases come first; longer sentences with richer grammar follow as you progress.\n\nHEAR EVERY SENTENCE\nEvery sentence has a recorded voice clip in its language, so you connect word order with how the sentence sounds.\n\nMADE FOR FOCUS\n- Minimal, distraction-free design in light or dark theme\n- Mixed reality with passthrough: your room stays around you\n- Hand tracking only, no controllers needed\n- Daily challenge and statistics to follow your progress\n- Fully offline: no account, no internet, no ads\n\nSessions are as short or as long as you like, which makes Word By Word easy to fit into any day.\n\nCredits: the French voice is based on the SIWIS French Speech Synthesis Database (University of Edinburgh), licensed under CC BY 4.0. All voices are listed in Settings > Credits.", "short_description": "Pick up word tiles with your hands, put them in order, and hear the sentence spoken. 16 languages, 500 sentences each, five levels from easy to expert. Calm mixed reality, hand tracking only, fully offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/wordbywordxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sq", "cs", "nl", "da", "en_US", "fi", "fr", "de", "el", "it", "nb", "pl", "pt_BR", "ru", "es", "sv"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1124304433804081"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673728339_235862
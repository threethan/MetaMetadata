_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/596061819_1406500081686672_2546946412237397465_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePMAy00FbEIQ7kNvwGdFnQI&_nc_oc=AdpjmzbUtff7nPEhvWVeeOVKCaMz7cNtfbIHGCVwJT6d5-2qPm2EfWKHY7_2o6JH07Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2u5TQtDCU824seWRRC7KWmBEx7m2V566a6ODttHVZuA&oe=6B0B25C2"}, {"file_name": "11_spatial_tile_180_background.png", "id": "1089471700536185", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673638530_1089471703869518_5096105738562360721_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUPUFgENNx4Q7kNvwGYwUAu&_nc_oc=AdphrHWMC_Wet-v8UCHkU8YPFgZkHWgZcgD1Ses3vhGHEteGCYbLkqTnZc1GmwmaUUE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbmjfWrQmalq5ZLWMvDbcdDWsD0M1F-h5liwPCPKmkcA&oe=6B0B3547"}]}, "id": "2555350191901948", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2_2560x1440.png", "id": "1695234808611736", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823351_1695234811945069_329839893095373357_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-uNQ4jToVEQ7kNvwHZbRQV&_nc_oc=Adqnl2YH_n2BV_24i8TlN7lU0Eve1dsP1R20qDae_71NOtONccDBIpQeA6l8bPVGUNs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0IPnQdPMGhQ97A7TErMZAHGMCL9oy90HWEiTga0M9rA&oe=6B0B1439"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1030369956741522", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824741_1030369970074854_6034646144114303308_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60vjktqAUNAQ7kNvwFYBEjw&_nc_oc=AdozlvKdtEazrnfPssqsOku4mnorZg_NY-Cy1vqVLIK1I5JnM42TRepJnHccotD2o90&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQn-V71-q1e9eTsJKuobije1sfNlvRzeGXJmSt5vZQlVg&oe=6B0B2CFC"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1429021868801809", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827973_1429021872135142_1329119672013247248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTnIE9co_WcQ7kNvwESbLE-&_nc_oc=AdoLgoG9NZ2ecYH22Uhb_elZu4alZocqgdv4YeAfJCGcUJBcKtJSt_fMRbzZ70Xtbh8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgekwUX6Xa_eMYgd2Vw3z0VvbUDZc6UgJGxgvAVEjdvg&oe=6B0B1533"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1690105662675957", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823310_1690105669342623_6688115334799341693_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RemF9-Ps44sQ7kNvwHAxdGr&_nc_oc=Adp-rFuORpFoCkSwzHpfUxzzxbIrZ0zn5LtEBqvFV0aUcMA6ZKsFCKTxRfaDDw6o7b0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJmdOjkevsBvn3hRogep7BvYzCDPXT2GyZ0atICp8bUA&oe=6B0B405F"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1597495655396684", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823837_1597495658730017_6181913131719431746_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_7Ll8LKwbQQ7kNvwGqYX-w&_nc_oc=AdqycOxdznM2-iGHfSYK7i44jhy_OkhoB2GIXcrFoDZtCCsMlt09tqjNmOIkFEqx0mU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRipflj0z6cUHml6jeH8ZmW34hjnKulhWoQjD6o8QALGA&oe=6B0B3826"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Word By Word XR", "keywords": ["language", "puzzle", "education", "learning", "words"], "long_description": "Word By Word is a calm, hands-on way to practise a language in mixed reality. A sentence appears as word tiles in your room. Pick the words up with your hands, place them in the right order, and hear the finished sentence spoken aloud.\n\n16 LANGUAGES\nEnglish, Spanish, German, French, Italian, Albanian, Portuguese (Brazil), Dutch, Polish, Russian, Greek, Swedish, Norwegian, Danish, Finnish and Czech.\n\n500 SENTENCES PER LANGUAGE\nEach language has its own path of 500 sentences across five levels: easy, medium, hard, advanced and expert. Short everyday phrases come first; longer sentences with richer grammar follow as you progress.\n\nHEAR EVERY SENTENCE\nEvery sentence has a recorded voice clip in its language, so you connect word order with how the sentence sounds.\n\nMADE FOR FOCUS\n- Minimal, distraction-free design in light or dark theme\n- Mixed reality with passthrough: your room stays around you\n- Hand tracking only, no controllers needed\n- Daily challenge and statistics to follow your progress\n- Fully offline: no account, no internet, no ads\n\nSessions are as short or as long as you like, which makes Word By Word easy to fit into any day.\n\nCredits: the French voice is based on the SIWIS French Speech Synthesis Database (University of Edinburgh), licensed under CC BY 4.0. All voices are listed in Settings > Credits.", "short_description": "Pick up word tiles with your hands, put them in order, and hear the sentence spoken. 16 languages, 500 sentences each, five levels from easy to expert. Calm mixed reality, hand tracking only, fully offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/wordbywordxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sq", "cs", "nl", "da", "en_US", "fi", "fr", "de", "el", "it", "nb", "pl", "pt_BR", "ru", "es", "sv"],
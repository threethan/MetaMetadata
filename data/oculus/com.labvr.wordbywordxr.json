wParQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXbWUBU9jfzkWY7CvKr2XPxfpuMF7HY2WBPQurXZACZg&oe=6B105A39"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1030369956741522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1030369970074854_6034646144114303308_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEKqQN30KvkQ7kNvwFzVGvm&_nc_oc=AdpfJGupzFTuHfwG8Dn79AmETkwN34t6WjkBAvZhN83iQ5AF63Ud6lf-kbwauOYj0SU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVC9tO3603F5YiHRNc4-mQCvHV64N_tcPXnktisbJF06g&oe=6B103ABC"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1429021868801809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827973_1429021872135142_1329119672013247248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_hV0D-MLXQQ7kNvwF_WSML&_nc_oc=AdoIh4rmvm4Qbm1mvkD7oVxec98Nj71A9i0go-_W0M6ZMggfnAcm-e9A9YtfarM5YVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVidgUgQsL6__dYhqFeSWH8hZIewSvyhQYdSYPY960BUw&oe=6B105B33"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1690105662675957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1690105669342623_6688115334799341693_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcadKkY_36cQ7kNvwGEyIZb&_nc_oc=AdrLAyfssTMDRKbrFNyQwgygmdfdZbf-FcIldtmXWVvrqEx_Kft4W083CfFvtqEAnLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHLqu3Rp76iS0xEu6qxdWMgOicg7c-G1fmZ6tu6QHT1w&oe=6B104E1F"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1597495655396684", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1597495658730017_6181913131719431746_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9S0qjFHjxJAQ7kNvwFXXsdi&_nc_oc=AdrZcuuyGsmvWBiTCh9GSRBvN5V-5mxmiMg-eC30_Gl9HPkdymtiuM0bpyOEQUFnpt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWCjucFyHNDQwhwmHcLtUM_vTUECWyR2fGCfzV8ZnMxiA&oe=6B1045E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Word By Word XR", "keywords": ["language", "puzzle", "education", "learning", "words"], "long_description": "Word By Word is a calm, hands-on way to practise a language in mixed reality. A sentence appears as word tiles in your room. Pick the words up with your hands, place them in the right order, and hear the finished sentence spoken aloud.\n\n16 LANGUAGES\nEnglish, Spanish, German, French, Italian, Albanian, Portuguese (Brazil), Dutch, Polish, Russian, Greek, Swedish, Norwegian, Danish, Finnish and Czech.\n\n500 SENTENCES PER LANGUAGE\nEach language has its own path of 500 sentences across five levels: easy, medium, hard, advanced and expert. Short everyday phrases come first; longer sentences with richer grammar follow as you progress.\n\nHEAR EVERY SENTENCE\nEvery sentence has a recorded voice clip in its language, so you connect word order with how the sentence sounds.\n\nMADE FOR FOCUS\n- Minimal, distraction-free design in light or dark theme\n- Mixed reality with passthrough: your room stays around you\n- Hand tracking only, no controllers needed\n- Daily challenge and statistics to follow your progress\n- Fully offline: no account, no internet, no ads\n\nSessions are as short or as long as you like, which makes Word By Word easy to fit into any day.\n\nCredits: the French voice is based on the SIWIS French Speech Synthesis Database (University of Edinburgh), licensed under CC BY 4.0. All voices are listed in Settings > Credits.", "short_description": "Pick up word tiles with your hands, put them in order, and hear the sentence spoken. 16 languages, 500 sentences each, five levels from easy to expert. Calm mixed reality, hand tracking only, fully offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/wordbywordxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "suppo
EMX46sMkopyaq22gFufjuew&oe=6A119D41"}, {"file_name": "ss4.png", "id": "1244211886091943", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003276_1244211889425276_8974498872973001988_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDqGjmn0aAQQ7kNvwEdVIzj&_nc_oc=AdpOQAJLDxh69BdWW2SqlslCU-YF-ROw9y7XsVV2ge--TORxr-mayn_n9othzGQDQ0Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mfFDNFyGsrbhG8DRcFDp03FNsBAq8qHrQZtZfRc6HIA&oe=6A11B111"}, {"file_name": "ss7.png", "id": "580904566299333", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75462205_580904569632666_392315719889499037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_Fu-1yvyBkQ7kNvwEtw1qT&_nc_oc=AdqOnkPeYSAV4HMdhj85qOE1-MUYUI1yyd1DGqVTxtslVw2TPH_FX7DaDr23B4rcu-g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dhqhhPAlgBPG9q1Y6fCUOWz0Yfui3Xr_vjJEGGWceAw&oe=6A11AFED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumb.png", "id": "1148805262325446", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974874_1148805265658779_4993776223281877737_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGEqIca8Qk4Q7kNvwG--r_j&_nc_oc=AdoDefTefby1pxPsHxtZj01rgbfKguPMn30gi1q4Y7NW6sF8Vz6-GvqpKhSCFWBQiFg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KvUjAUvAr9-2r5f2LgHn8SM1cE_m3AyORe9OeqbkPew&oe=6A119820"}, "display_name": "Sling VR", "keywords": [], "long_description": "Have you ever used a slingshot to hit something? Then, this game  is for you . Sling VR is the first and best  Slingshot game made for Oculus . Sling VR has prefect physics and pleasant graphics. You can hit fruits and coconuts. You can break pots and hunt birds. Some monkeys on the beach will try to hit you with coconuts. \nOnce purchased, Sling VR will get free updates and free new modes. Gamers are requested to suggest new ideas to improve gameplay. \nEnjoy!!   ", "short_description": "The Best VR Sling shot game. Perfect physics and pleasant graphics. \nYou can break pots, drop coconuts and fruits. You should survive monkey attacks and hunt birds. Experience the beautiful treehouse and don't jump.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/maddytroupe/houses/main/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "433104011940205"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2644425949022580"}, {"status": "PUBLISHED", "id": "1098219481022493"}, {"status": "PUBLISHED", "id": "533561188083214"}]}, "baseline_offer": {"id": "2644425949022580"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1648846800, "status": "PUBLISHED", "id": "2644425949022580"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5624259524286098", "version": "1.6"}, "id": "1038728040237736", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4788832087828850", "is_concept":
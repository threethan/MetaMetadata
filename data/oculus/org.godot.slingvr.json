w6-1.oculuscdn.com/v/t64.5771-25/38974874_1148805265658779_4993776223281877737_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4M1M0kQ8zMQ7kNvwFK1Bb6&_nc_oc=AdozY3_ndSMkVEorkmeFpj-0Ep_rE2K-JmioqTmxbJpOpee__kU0jf9n21LwmYBdPug&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19B6DG7FC5vIZpDr_mBjjmQzYZNZ-utEAMO7r0-T_QWA&oe=69F345A0"}, "display_name": "Sling VR", "keywords": [], "long_description": "Have you ever used a slingshot to hit something? Then, this game  is for you . Sling VR is the first and best  Slingshot game made for Oculus . Sling VR has prefect physics and pleasant graphics. You can hit fruits and coconuts. You can break pots and hunt birds. Some monkeys on the beach will try to hit you with coconuts. \nOnce purchased, Sling VR will get free updates and free new modes. Gamers are requested to suggest new ideas to improve gameplay. \nEnjoy!!   ", "short_description": "The Best VR Sling shot game. Perfect physics and pleasant graphics. \nYou can break pots, drop coconuts and fruits. You should survive monkey attacks and hunt birds. Experience the beautiful treehouse and don't jump.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/maddytroupe/houses/main/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
easant graphics. \nYou can break pots, drop coconuts and fruits. You should survive monkey attacks and hunt birds. Experience the beautiful treehouse and don't jump.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/maddytroupe/houses/main/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "433104011940205"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2644425949022580"}, {"status": "PUBLISHED", "id": "1098219481022493"}, {"status": "PUBLISHED", "id": "533561188083214"}]}, "baseline_offer": {"id": "2644425949022580"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1648846800, "status": "PUBLISHED", "id": "2644425949022580"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5624259524286098", "version": "1.6"}, "id": "1038728040237736", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4788832087828850", "is_concept":
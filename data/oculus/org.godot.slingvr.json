ObH2mnJlOLPZdIxpGWMXdih5Tl51YZS9KUdi5-DO8nQuTbCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShpfEYbFprDTBAh_NKVRo-XjqJPwEEAZ1xsOGfdBeOWw&oe=6B0C7DC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumb.png", "id": "1148805262325446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974874_1148805265658779_4993776223281877737_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v75FMcChXecQ7kNvwHiFYQ1&_nc_oc=AdoCdOI4Xa1GPbnWerGg_Ja2viFDq8hY6HbvfCiiCnjR-tn_8dgRi31dd6x0ym-7z5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaVAYnN-MsJ8Tw_L7-_yS2upGSDUi8yo3YqNhHrAfkOA&oe=6B0C4D60"}, "display_name": "Sling VR", "keywords": [], "long_description": "Have you ever used a slingshot to hit something? Then, this game  is for you . Sling VR is the first and best  Slingshot game made for Oculus . Sling VR has prefect physics and pleasant graphics. You can hit fruits and coconuts. You can break pots and hunt birds. Some monkeys on the beach will try to hit you with coconuts. \nOnce purchased, Sling VR will get free updates and free new modes. Gamers are requested to suggest new ideas to improve gameplay. \nEnjoy!!   ", "short_description": "The Best VR Sling shot game. Perfect physics and pleasant graphics. \nYou can break pots, drop coconuts and fruits. You should survive monkey attacks and hunt birds. Experience the beautiful treehouse and don't jump.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/maddytroupe/houses/main/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_
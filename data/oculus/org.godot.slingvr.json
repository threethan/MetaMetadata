11LRtxTo-ByYt8SrS6rd3qDGFm49VWW7geCDqMuFl7b9KPwM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXZxDyUCLxOJ4Cdn0LlNb5QblAlHKYjDrNmByIBVPv-w&oe=6AFB2204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumb.png", "id": "1148805262325446", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974874_1148805265658779_4993776223281877737_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqgWL4C9bbEQ7kNvwEtoRdF&_nc_oc=Adq5Spwf6_GEi84Jy48fyzjJ70c-EytvBKtF6lMJVo4kzVFh9xygyykkF0Za21l_gnk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRqfCgFsrFfUOqoChFk7bbcqiYeQjp7EV4V0F5WeaBXA&oe=6AFB29E0"}, "display_name": "Sling VR", "keywords": [], "long_description": "Have you ever used a slingshot to hit something? Then, this game  is for you . Sling VR is the first and best  Slingshot game made for Oculus . Sling VR has prefect physics and pleasant graphics. You can hit fruits and coconuts. You can break pots and hunt birds. Some monkeys on the beach will try to hit you with coconuts. \nOnce purchased, Sling VR will get free updates and free new modes. Gamers are requested to suggest new ideas to improve gameplay. \nEnjoy!!   ", "short_description": "The Best VR Sling shot game. Perfect physics and pleasant graphics. \nYou can break pots, drop coconuts and fruits. You should survive monkey attacks and hunt birds. Experience the beautiful treehouse and don't jump.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/maddytroupe/houses/main/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_
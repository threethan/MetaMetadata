-25/38982571_821472389500272_5162966059079519078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D90KBgeJNFgQ7kNvwG-GbB1&_nc_oc=AdpYWVFACmvUUVzDllFni2oOiGi8y8IrhbiPEzedOGwhIUWcE2pphzGGF8jVGKZBgjM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cK5ux883Gy94lTnQIpmWDTgDr8q83-B14yXJIHjnVpg&oe=6A1AE852"}, {"file_name": "LOVESICK_IronMaiden.png", "id": "290465370811880", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75241699_290465374145213_846456544522457630_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwnIy_A7rM0Q7kNvwHDnihH&_nc_oc=AdoAd6BHY0YW2j12eWOHPVbVQLaGKzRfpLXQSZSeANXPfapQUzaJby_P2JbJ3VjqzW4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HJQje4IhI7lZ0ll2v2GlqHyYQdTufdJrAwLWpTHnnsw&oe=6A1B09E8"}, {"file_name": "LOVESICK_HearIt.png", "id": "7707043135999196", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036703_7707043139332529_3616758901389835084_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ekc_DB0QxCYQ7kNvwF98-J0&_nc_oc=Adr7rGiCi-MO8TGkvtAHBJHD8oHLQ332O2vn8adAApBRFs1XYDtX8XDAt4GOabrJ4Fs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oj7v61mdQ21J2_6B-YIt8oJAmwCIw5RzRTSg8z-yW8A&oe=6A1ADDD5"}, {"file_name": "LOVESICK_Venue.png", "id": "1236141800687671", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982565_1236141804021004_4948790685474794755_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqgsMpSguPEQ7kNvwHp53yO&_nc_oc=AdqTwbUjVRyjLDuFl-eJAPFqrJI8zpVBgbzAs1pxWITghrnqHTIsbY5PqQEEA44F1mg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e3J6B2cafj9g5QM6vzQ7WtnjApJ0gbLcexvoGj_udng&oe=6A1AF79C"}, {"file_name": "LOVESICK_EdgeCase.png", "id": "832895145371034", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57570294_832895148704367_1851066288184140688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UznrCvT8tUQ7kNvwGkLL3F&_nc_oc=AdqdmaHodyiIy1v0WE-ukdMCtKFvCPqiYna-JmYgvYNWoSz4stCcI5GPvlxSQ8zUtkI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e7GucrIHZkRmSefo9cRkyW64jrMVMrFw9QIhQqLgk7g&oe=6A1B09EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumb.png", "id": "328430030132436", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035389_328430033465769_4701990383276144817_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ79NwWFV0EQ7kNvwHOFpoO&_nc_oc=AdqpdNAjoMjMnNMvoFe72wda07f3Tdp6kPGrUc96UzG0c5vZEgErUBql1btEOaoM-tw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YAG98bQJpHV8la8plUk4ilXxoX2GPip0NAc-1sH4fQA&oe=6A1B010A"}, "display_name": "LOVESICK", "keywords": [], "long_description": "Middle-America, 1999. After a grueling tour that has left them emotionally drained and flat broke, the four members of The New Agenda make it back to their dilapidated home, they have nothing in the fridge, nothing in the bank, and nothing in the future but a whole bunch of questions.\n\n\u201cHow the hell are we gonna scrap together next month\u2019s rent?\u201d the drummer, Tommi, asks the group.\n\u201cWell maybe we\u2019d have some cash if we had an album to tour,\u201d says Dom, lead guitar and vocals, \u201cWhen is Nik going to finally finish writing something?\u201d Nik shouts back from the kitchen, \u201cI\u2019m WORKING on\u2014\u201d but Tommi cuts her off. \u201cHow are we supposed to book a show if nobody ever wants to practice?\u201d\n\nThey\u2019re still after an elusive full-length album and they can't even survive a band practice without tearing each other apart. Just when they thought things couldn\u2019t get worse, a supernatural event dubbed \u201cthe Feedback\u201d plunges them all into a twisted alternate reality. \n\nIn LOVESICK, you assume the role of Sam, the band\u2019s bassist, as he navigates the strange environments imprisoning his bandmates. With each surreal mindscape reflecting the memories, fears, and ambitions of the person trapped within, he is the crumbling band\u2019s last hope. It\u2019s up to Sam to piece together the mystery behind the Feedback, determine what lies ahead for The New Agenda, and find his bandmates before they're swallowed whole by their own troubled minds.", "short_description": "PUZZLE // PUNK // ESCAPE // TOUR // \nAfter a grueling tour that has left them drained and flat broke, a struggling post-punk band returns home. The group is already on the brink of collapse when a supernatural event dubbed \u201cthe Feedback\u201d plunges them all into a twisted alternate reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosecitygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lyrical, Rose City Games", "support_website_url": "https://www.rosecitygames.com/contact", "website_url": "https://rosecitygames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7666162836800586"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1211195453702953"}, {"status": "PUBLISHED", "id": "656830553920401"}, {"status": "PUBLISHED", "id": "1637552503582942"}, {"status": "PUBLISHED", "id": "1158926339307362"}, {"status": "PUBLISHED", "id": "633988909541757"}, {"status": "PUBLISHED", "id": "1365429821468033"}, {"status": "PUBLISHED", "id": "3033929776755870"}]}, "baseline_offer": {"id": "1211195453702953"}, 
-25/38982571_821472389500272_5162966059079519078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztZZgfM7uJwQ7kNvwHMhxWA&_nc_oc=AdrSzuXPZ1dCiaZ_oiKTwlr4YQH13Nw9R6GDhM7BBZsoBeCuYnb5aEe6jXyCd4MhLKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsmKBESJnK9Ymhjdfvo7YeBSmSetQVv2BKRbtumMVuLQ&oe=6AE49DD2"}, {"file_name": "LOVESICK_IronMaiden.png", "id": "290465370811880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75241699_290465374145213_846456544522457630_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQA1485GJl8Q7kNvwHwWaV7&_nc_oc=AdrZzCVih4oUBQOq1owkPwrRXQpxjiysmJ12o_byt7Vgc74UNiY6y1LPfCanSoYiK58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiXbiz5Jp8MRBy7fF8fnMTs46Sp5DGIms8yBtvFWfVcQ&oe=6AE4BF68"}, {"file_name": "LOVESICK_HearIt.png", "id": "7707043135999196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036703_7707043139332529_3616758901389835084_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLbcsZjqGmoQ7kNvwHdfsYZ&_nc_oc=AdrHXpMMxA5yq55M1CstQhBOnmyZ7l8E_3SUy_QPrUYLV_jp6pWVhHLJRx0Dr0kECxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA9fAcOOalNEz3cYRAl8Y5jzKxG1_1tiIgWrKpaAgsTQ&oe=6AE49355"}, {"file_name": "LOVESICK_Venue.png", "id": "1236141800687671", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982565_1236141804021004_4948790685474794755_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6BfTXMXKjIQ7kNvwHHLwHe&_nc_oc=Adqt_u5uL3Bd9nBfgku0vp5PB5kRZadIEHWH604_shZoLM__HxfTB21Jx0bNMj-RByo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX6gJhazynRzgBYz1f_XrsDlAcTsCA9ybBQO-O6DwLnQ&oe=6AE4AD1C"}, {"file_name": "LOVESICK_EdgeCase.png", "id": "832895145371034", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570294_832895148704367_1851066288184140688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck_FMlVZ3KMQ7kNvwHC2tBE&_nc_oc=AdoAfCDyIUTqyZRWKbCD9MTQlxVF48URrv20TQUrP_cN0ahf5ACLyoQu-nr279FlNVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgpjlZZkyoQecl3psafiTwLuQWuzZhxmcMwJnof9xJkw&oe=6AE4BF6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumb.png", "id": "328430030132436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035389_328430033465769_4701990383276144817_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5daIP8Hk-0Q7kNvwE05lgZ&_nc_oc=AdqH7uyUSIwvJHnet8db9PNmvM9dQRhYOcC1ZqHJFDyxwDdd4iSutwza4sah3Tg9IbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIszQZHZkjN4Eq9FNeKCYVf3Gbf1YqnZbg0vnlaQ0_ew&oe=6AE4B68A"}, "display_name": "LOVESICK", "keywords": [], "long_description": "Middle-America, 1999. After a grueling tour that has left them emotionally drained and flat broke, the four members of The New Agenda make it back to their dilapidated home, they have nothing in the fridge, nothing in the bank, and nothing in the future but a whole bunch of questions.\n\n\u201cHow the hell are we gonna scrap together next month\u2019s rent?\u201d the drummer, Tommi, asks the group.\n\u201cWell maybe we\u2019d have some cash if we had an album to tour,\u201d says Dom, lead guitar and vocals, \u201cWhen is Nik going to finally finish writing something?\u201d Nik shouts back from the kitchen, \u201cI\u2019m WORKING on\u2014\u201d but Tommi cuts her off. \u201cHow are we supposed to book a show if nobody ever wants to practice?\u201d\n\nThey\u2019re still after an elusive full-length album and they can't even survive a band practice without tearing each other apart. Just when they thought things couldn\u2019t get worse, a supernatural event dubbed \u201cthe Feedback\u201d plunges them all into a twisted alternate reality. \n\nIn LOVESICK, you assume the role of Sam, the band\u2019s bassist, as he navigates the strange environments imprisoning his bandmates. With each surreal mindscape reflecting the memories, fears, and ambitions of the person trapped within, he is the crumbling band\u2019s last hope. It\u2019s up to Sam to piece together the mystery behind the Feedback, determine what lies ahead for The New Agenda, and find his bandmates before they're swallowed whole by their own troubled minds.", "short_description": "PUZZLE // PUNK // ESCAPE // TOUR // \nAfter a grueling tour that has left them drained and flat broke, a struggling post-punk band returns home. The group is already on the brink of collapse when a supernatural event dubbed \u201cthe Feedback\u201d plunges them all into a twisted alternate reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosecitygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lyrical, Rose City Games", "support_website_url": "https://www.rosecitygames.com/contact", "website_url": "https://rosecitygames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7666162836800586"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1211195453702953"}, {"status": "PUBLISHED", "id": "656830553920401"}, {"status": "PUBLISHED", "id": "1637552503582942"}, {"status": "PUBLISHED", "id": "1158926339307362"}, {"status": "PUBLISHED", "id": "633988909541757"}, {"status": "PUBLISHED", "id": "1365429821468033"}, {"status": "PUBLISHED", "id": "3033929776755870"}]}, "baseline_offer": {"id": "1211195453702953"}, 
-25/38982571_821472389500272_5162966059079519078_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_GCqqWyb6gQ7kNvwHKO7w7&_nc_oc=Adp6jcSutzKtcwveM2U6sv0owMaMvJD4m-6H0wPy4N6LcT4w7rT8U7gBfLawISluaZU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgY8gMBS3qM2NcvymJvBAb3okiaKBkrTjQ574ceqQe8g&oe=6ACE3452"}, {"file_name": "LOVESICK_IronMaiden.png", "id": "290465370811880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75241699_290465374145213_846456544522457630_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39GCeB7EYPMQ7kNvwF92zUh&_nc_oc=Adqe7TBm5Z9DBSyxFIPnFPAV0SrejWRy50zRstWme_RxigY4iM_zoTFb0c_Z1OrPnQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3i-hj2uxYpcAAmfT5Xb5CD2Q9sYA9YD8glGGvi61sYQ&oe=6ACE55E8"}, {"file_name": "LOVESICK_HearIt.png", "id": "7707043135999196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036703_7707043139332529_3616758901389835084_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4kD5-3ftZkQ7kNvwGtXhLr&_nc_oc=AdroElJ6kPGodh_YOfifkkHK_c1sr55R4EIT_Lxmfz7L2HugT8aWMtlYdmlNJYf4C8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnBvLqNz6Nu9jspjrhyaVkEyreRGbq74HItxtoTD6lNg&oe=6ACE6215"}, {"file_name": "LOVESICK_Venue.png", "id": "1236141800687671", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982565_1236141804021004_4948790685474794755_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYrCQOneYZ4Q7kNvwHTKj_j&_nc_oc=Adrz9wcqAyeUJuJ9EJ9pMAS3y36i1kRwM4FPWNiKSmO4NJeovulKMugXGj8B-YzWaio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4c6ifmbxRvVpdGxcYPbY6BTW8Gfp32qEFV85FgQ7pzA&oe=6ACE439C"}, {"file_name": "LOVESICK_EdgeCase.png", "id": "832895145371034", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570294_832895148704367_1851066288184140688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtExP5wrrj4Q7kNvwERMLgO&_nc_oc=AdoM9nZ--v8DTNFc9qH__sF4mcTKMl1Z9F2O1RIYbJe0nM5nTuRTOKYxJ2TKgsxirjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfaHNdLEc7y4kx60ratuzBD9CHjeVRndw6HLQ3tPDrag&oe=6ACE55EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumb.png", "id": "328430030132436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035389_328430033465769_4701990383276144817_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxN-fT9BS1oQ7kNvwF2wz1L&_nc_oc=AdoBu81C33oUdUw-FvbxMzupRDBSVwWrRK7MiW7lG_i9Pz2QVH8PJWs0IspOKFkjqCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg5lz4ohcq4xCf5dQQG6wrhL9cKcwaWY5xQ_dd9avA5A&oe=6ACE4D0A"}, "display_name": "LOVESICK", "keywords": [], "long_description": "Middle-America, 1999. After a grueling tour that has left them emotionally drained and flat broke, the four members of The New Agenda make it back to their dilapidated home, they have nothing in the fridge, nothing in the bank, and nothing in the future but a whole bunch of questions.\n\n\u201cHow the hell are we gonna scrap together next month\u2019s rent?\u201d the drummer, Tommi, asks the group.\n\u201cWell maybe we\u2019d have some cash if we had an album to tour,\u201d says Dom, lead guitar and vocals, \u201cWhen is Nik going to finally finish writing something?\u201d Nik shouts back from the kitchen, \u201cI\u2019m WORKING on\u2014\u201d but Tommi cuts her off. \u201cHow are we supposed to book a show if nobody ever wants to practice?\u201d\n\nThey\u2019re still after an elusive full-length album and they can't even survive a band practice without tearing each other apart. Just when they thought things couldn\u2019t get worse, a supernatural event dubbed \u201cthe Feedback\u201d plunges them all into a twisted alternate reality. \n\nIn LOVESICK, you assume the role of Sam, the band\u2019s bassist, as he navigates the strange environments imprisoning his bandmates. With each surreal mindscape reflecting the memories, fears, and ambitions of the person trapped within, he is the crumbling band\u2019s last hope. It\u2019s up to Sam to piece together the mystery behind the Feedback, determine what lies ahead for The New Agenda, and find his bandmates before they're swallowed whole by their own troubled minds.", "short_description": "PUZZLE // PUNK // ESCAPE // TOUR // \nAfter a grueling tour that has left them drained and flat broke, a struggling post-punk band returns home. The group is already on the brink of collapse when a supernatural event dubbed \u201cthe Feedback\u201d plunges them all into a twisted alternate reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosecitygames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lyrical, Rose City Games", "support_website_url": "https://www.rosecitygames.com/contact", "website_url": "https://rosecitygames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7666162836800586"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1211195453702953"}, {"status": "PUBLISHED", "id": "656830553920401"}, {"status": "PUBLISHED", "id": "1637552503582942"}, {"status": "PUBLISHED", "id": "1158926339307362"}, {"status": "PUBLISHED", "id": "633988909541757"}, {"status": "PUBLISHED", "id": "1365429821468033"}, {"status": "PUBLISHED", "id": "3033929776755870"}]}, "baseline_offer": {"id": "1211195453702953"}, 
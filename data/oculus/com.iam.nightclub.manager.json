=69D90C28"}, {"file_name": "SS_5.png", "id": "1609256230082906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1609256233416239_3324307177008294392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3BOnhIEFHkQ7kNvwHtTDWn&_nc_oc=Adr1WCmZ85Qxtww8GMldey9gAW8o12vIQM-KSlHd4141kxf4wtg-dazGhOXOQXZfedg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R1zPTG6wLNpL9ou0aOH_CFgSdQessDkcHMBXIBuprFA&oe=69D8DF4D"}, {"file_name": "SS_3.png", "id": "1569925067430098", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821782_1569925070763431_1337722932736906518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioGSWq6v2EwQ7kNvwHwmTZa&_nc_oc=AdqRs0Qag3rI-c7zLZQ0vGENRqMWzqgfEDNygnol9wSEOrMTo-I-zduJ0p5GCqhTD98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xbMVE0bCg1hwrZwVhV79yAz6fmMAIZ_2ECnMuURwKOw&oe=69D90017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491821081_904328888914768_8589207024846945929_n.png", "id": "25987088110914206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_25987088117580872_3698370023114354650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAvVRnwNuLIQ7kNvwH3EVyx&_nc_oc=AdqbRfAzeHJHX15JqTiTUMXGLM-4hQ9wnRqUDFUdivG7Z7413r2lN3Y1iIkG3diYxQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L4x2HSfKWPz_iKEY5nSKsH9yMgnbKz1q9PllZqZJZUg&oe=69D8F1D0"}, "display_name": "I Am Night Club Manager", "keywords": ["Nightclub", "Manager", "Simulator", "Business", "Club"], "long_description": "I Am Nightclub Manager puts you in control of building, running, and expanding a successful nightclub in VR. Step into the role of a club manager and experience the challenges of real nightclub management, where every decision affects your business, reputation, and crowd satisfaction.\n\nManage all aspects of your nightclub operations, from hiring and supervising staff to controlling music, lighting, and overall atmosphere. Keep the dance floor active, handle busy crowds, and manage VIP guests who expect top-level service. A well-run nightclub attracts more visitors, improves club reputation, and creates a lively nightlife environment.\n\nAs your nightclub grows, focus on smart management and strategic planning. Upgrade your club, expand nightclub areas, unlock new features, and balance expenses to maintain steady progress. Poor management can lead to unhappy customers and declining popularity, while strong leadership helps your nightclub thrive as a profitable business.\n\nThis nightclub simulator emphasizes hands-on gameplay, realistic decision-making, and long-term progression. Whether you enjoy management games, business simulators, or creative control experiences, I Am Nightclub Manager offers an immersive VR club experience where strategy, organization, and creativity define your success. Build your nightclub empire and become the manager behind the city\u2019s most popular nightlife destination", "short_description": "I Am Nightclub Manager puts you in charge of running a full nightclub management experience in VR. Manage staff, control music and lighting, handle crowds and VIP guests, upgrade your venue, and keep customers happy while growing your club\u2019s reputation. Make smart club management decisions, balance expenses and upgrades, and turn a small club into a successful nightlife destination through hands-on gameplay and strategic planning."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscri
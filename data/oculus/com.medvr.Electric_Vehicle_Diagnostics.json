lSMIkjNS00Qv5td7iMNQz_b4ADYy4xjc0sypVs-CQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhZSJ31Wmi2vv3LN832TjT9yH86iPkZdD5CQk7iN9syg&oe=6AE356A8"}, {"file_name": "HighresScreenshot00001.png", "id": "1627054218407206", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622214_1627054221740539_8219946725028638047_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al-rezUsyR0Q7kNvwFzpjm1&_nc_oc=AdqK1fMT_OvkdnsRLLAa2cK1HgH90KV893b1xxtbwKY90NtY7C3islFkRF7vbrRcqHY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1sfU50L5jPJotE9xxA2sn8-uR49JhJZrEU4qm2EB7Lw&oe=6AE3448E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Electric Vehicle Diagnostics", "keywords": [], "long_description": "Electric Vehicle Diagnostics is an immersive VR training application designed exclusively for learners enrolled in the Immersive Learn Electric Vehicle Diagnostics Micro-Credential Program. Through realistic hands-on simulations, learners develop practical skills in electric vehicle inspection, diagnostic testing, fault identification, safety procedures, battery system evaluation, and troubleshooting techniques used in modern EV service environments.\n\nThe application provides an interactive learning experience that helps learners practice real-world EV diagnostic procedures in a safe and controlled virtual environment while reinforcing industry-standard safety and technical competencies.\n\nPlease note: This application is not intended for general public use. Access is restricted to individuals officially enrolled in the Immersive Learn Electric Vehicle Diagnostics Micro-Credential Program for educational and training purposes only.", "short_description": "Electric Vehicle Diagnostics is a VR training application developed as part of the Immersive Learn Electric Vehicle Diagnostics Micro-Credential Program. This application provides hands-on simulation training for EV diagnostic procedures, system testing, safety pr
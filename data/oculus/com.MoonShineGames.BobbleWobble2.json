1719_1328039732342006_6300158583792028674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbBUrAwqAyYQ7kNvwGpjJNg&_nc_oc=AdpyWLFpDdSVAV2j8dq2axATMimByHmBVrIdPYIcjwYFuLzs12_IcfJokLYXzCXqHvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QBN_RyQMLCUSnLRAeLRRaxUbDehTXyOf349z9Ms3PXg&oe=6A048DF4"}, {"file_name": "ss1.png", "id": "1130083668966454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_1130083672299787_5594156044801816087_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_l2vocc9G8Q7kNvwG7y5ZY&_nc_oc=AdqjsYqMRXzBFIzPDEKBTxBVjc5RNlIVLXnNktWeQyOCtJPAiFvP8Ve--VI6gmaZbcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6381s6jiOPy1yvJUDHBdjIKFHmLW7ykpGTX8fgy8CWGw&oe=6A048B34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "869868965526001", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_869868968859334_6256255762194872727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ihc1De9q9eIQ7kNvwGuQRae&_nc_oc=AdrgCkppnwoWoB7MicAKMz8cLXXvczrZNS9nV-ipazqJnZhl8SpL14i0JS-H4ng4ZCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65NoqPgLMpmiHxQawRhmCphzf6xCwKvMYRN9B7TMvwVg&oe=6A0472A0"}, "display_name": "Bobble Wobble 2", "keywords": ["bobble", "wobble", "moonshine", "puzzle", "casual"], "long_description": "Embark on a thrilling journey through vibrant, interactive worlds in our exhilarating VR puzzle game, 'Bobble Wobble 2'! Guide your adorable Bobble through a series of mind-bending challenges, strategically pushing and manoeuvring them to reach the coveted end goal. With each level presenting a unique puzzle to solve, immerse yourself in 50 captivating stages that will test your wit and agility to the fullest. Are you ready to embark on this epic adventure and unlock the mysteries that await in 'Bobble Wobble 2'? Bring the Bobble Wobble world into your world with the new Mixed Reality switch.", "short_description": "Navigate through 50 levels of immersive VR puzzles in 'Bobble Wobble 2.' Strategically push your adorable Bobble characters to reach the goal and unlock the next challenge. Are you up for the thrill?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShine Games", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32882799971334856"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827626_707372495759467_13462056656717976_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K3I-v8mvE0Q7kNvwE_cipY&_nc_oc=AdoRkYZs8wFjvD5zLm3LhShhn6Fi4PiruC8LRTgJa3hXrcR7gvjNTZd267JmK2NvqmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VktpXhC-ZadfQzZ9Z9_UBRlNiDH4_mC1BD8vmUFqeMQ&oe=6A0466C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bobble Wobble 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1766707200
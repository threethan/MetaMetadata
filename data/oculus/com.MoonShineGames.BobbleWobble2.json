Afu1Qwat0gPuntKapeE_YBqW-2qOuDo56P-s5_xGVUaP6Q&oe=699B15F4"}, {"file_name": "ss1.png", "id": "1130083668966454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1130083672299787_5594156044801816087_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TK93F48ltm4Q7kNvwHOfhHs&_nc_oc=Adm_PD_0odCGkAQWtRI9lEOAphUexZwWduhrkaw_MeY_Ai2YvPOAs-_CwsvJbCEdYz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsoLlYukkNeCmmGfsQTMrVdtXIpyFAEMp9gE60Zau8SBA&oe=699B1334"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "869868965526001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_869868968859334_6256255762194872727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VIGXnmwiKgQ7kNvwGxh6C2&_nc_oc=AdkWxOxEEFCgp2OmcTvWpin0nY9wFkCFokRRAhQouHfaPZgUQh0B2jSaYkrV22lXD1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftvLDobFt55CBV2YIiZfOMKpszGV4G2YC8fZomecwEehg&oe=699AFAA0"}, "display_name": "Bobble Wobble 2", "keywords": ["bobble", "wobble", "moonshine", "puzzle", "casual"], "long_description": "Embark on a thrilling journey through vibrant, interactive worlds in our exhilarating VR puzzle game, 'Bobble Wobble 2'! Guide your adorable Bobble through a series of mind-bending challenges, strategically pushing and manoeuvring them to reach the coveted end goal. With each level presenting a unique puzzle to solve, immerse yourself in 50 captivating stages that will test your wit and agility to the fullest. Are you ready to embark on this epic adventure and unlock the mysteries that await in 'Bobble Wobble 2'? Bring the Bobble Wobble world into your world with the new Mixed Reality switch.", "short_description": "Navigate through 50 levels of immersive VR puzzles in 'Bobble Wobble 2.' Strategically push your adorable Bobble characters to reach the goal and unlock the next challenge. Are you up for the thrill?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/m
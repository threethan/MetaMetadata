AfuaM2uGw1VZRGnkxIpKCWZ68ealHqfqZiV2IjPQ8-U5nQ&oe=699ED234"}, {"file_name": "ss1.png", "id": "1130083668966454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1130083672299787_5594156044801816087_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXykcxQQcr4Q7kNvwHolDMv&_nc_oc=Adm-gSZcEjvZHQr6qQ7lNSJe9W_lz6IRF1ufOVlko7Qe8nwaPs75pF3aqxrRHtdnedI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuSz-tldUmLPV-MqeDg-JSxWCi6wrGhTBLrKeAaFxW11A&oe=699F07B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "869868965526001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_869868968859334_6256255762194872727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0WvI5hHHxkQ7kNvwGwKf7S&_nc_oc=Adkspj8hG75MkMT61nlbfEESafvAsbUr3WiLNJDI-5rfURevEGVJwX0WvkS0c9Xrq8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvi5TA3AmG3tOp6cAGHNUT3jpiUiVrJXiE5rptbRnL7-A&oe=699EEF20"}, "display_name": "Bobble Wobble 2", "keywords": ["bobble", "wobble", "moonshine", "puzzle", "casual"], "long_description": "Embark on a thrilling journey through vibrant, interactive worlds in our exhilarating VR puzzle game, 'Bobble Wobble 2'! Guide your adorable Bobble through a series of mind-bending challenges, strategically pushing and manoeuvring them to reach the coveted end goal. With each level presenting a unique puzzle to solve, immerse yourself in 50 captivating stages that will test your wit and agility to the fullest. Are you ready to embark on this epic adventure and unlock the mysteries that await in 'Bobble Wobble 2'? Bring the Bobble Wobble world into your world with the new Mixed Reality switch.", "short_description": "Navigate through 50 levels of immersive VR puzzles in 'Bobble Wobble 2.' Strategically push your adorable Bobble characters to reach the goal and unlock the next challenge. Are you up for the thrill?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/m
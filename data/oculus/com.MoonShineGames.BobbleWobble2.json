1719_1328039732342006_6300158583792028674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9GUV-dw1YAQ7kNvwEI7WVJ&_nc_oc=AdqeTY4OwDreRxxhrA3bEbCnIEAWkksrHTROavzARH8v_NoFDcGUJLDkebRFbkEDRd8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdgRAu7CNj3gsWHnqR8hlfniRs5SjMGdQef1DT5XbbFg&oe=6A774074"}, {"file_name": "ss1.png", "id": "1130083668966454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_1130083672299787_5594156044801816087_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY_-JJQgXAcQ7kNvwEx9a-h&_nc_oc=AdpC9lxIH7F0Pd5FOTBlZC42LE99DlIErQXVkE47KOlyC-kAnEACm2_vkO5XOfk4tGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7_sKaYukcfDHx_cL3K0nLsPuxLpfjwhc-Hlie7-TXPg&oe=6A773DB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "869868965526001", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_869868968859334_6256255762194872727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtgYLOOMI18Q7kNvwGZ2PEe&_nc_oc=AdrvtcR7KNBBYT879N-MzaPcpEyOte7S-eTTiDHvpO9NaD8ozHeVOcYZ8U1mXEhXWRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF1IOoJCZnu-Jt2Q2RB3zZaWqSDPQNCOlEmRBSDTEa8Q&oe=6A772520"}, "display_name": "Bobble Wobble 2", "keywords": ["bobble", "wobble", "moonshine", "puzzle", "casual"], "long_description": "Embark on a thrilling journey through vibrant, interactive worlds in our exhilarating VR puzzle game, 'Bobble Wobble 2'! Guide your adorable Bobble through a series of mind-bending challenges, strategically pushing and manoeuvring them to reach the coveted end goal. With each level presenting a unique puzzle to solve, immerse yourself in 50 captivating stages that will test your wit and agility to the fullest. Are you ready to embark on this epic adventure and unlock the mysteries that await in 'Bobble Wobble 2'? Bring the Bobble Wobble world into your world with the new Mixed Reality switch.", "short_description": "Navigate through 50 levels of immersive VR puzzles in 'Bobble Wobble 2.' Strategically push your adorable Bobble characters to reach the goal and unlock the next challenge. Are you up for the thrill?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShine Games", "support_website_url": "https://markledson28.wixsite.com/moonshinegames/contact", "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32882799971334856"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827626_707372495759467_13462056656717976_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWWrhglLXjcQ7kNvwGG2p6x&_nc_oc=AdqUcCJASe0BmR5GWpsiitytR1bvs2mbUZPKpDAPK5rmw0WJiCrYbmMMtxjX7VlXaRQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2Rq9DGfH8maj_0dnw_nEjZrCQSzcQRRowG3F0dqddHA&oe=6A771947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bobble Wobble 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1766707200
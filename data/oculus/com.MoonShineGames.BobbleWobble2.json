AfuooNe5AOleX7yEpxdPtrFqxmysLJQn07zYBaLLHZDzMA&oe=69A17534"}, {"file_name": "ss1.png", "id": "1130083668966454", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820441_1130083672299787_5594156044801816087_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXykcxQQcr4Q7kNvwGvwhE4&_nc_oc=Adk9EbFZ_OYZaAFrKa47gj5OUpYp67Ht0bZIP2a2YlQcCXJ1asBB3cYaQazinsk7n2k&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv4RgvhONONO8J9I01SjXx0FYrM211kjmXu7DbMzB0Dpg&oe=69A1AAB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "869868965526001", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491821725_869868968859334_6256255762194872727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0WvI5hHHxkQ7kNvwHMRI51&_nc_oc=Adn0TZJhOSjNK6vUlzYGEl0pGybL6ZqRcOd5cSN4A2w5YhsvU4okj1IBieUz_4I947Y&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afv0Ww8W_UxLNgDoA5XB9HdfFkczahaqpEImanya15Wd3A&oe=69A19220"}, "display_name": "Bobble Wobble 2", "keywords": ["bobble", "wobble", "moonshine", "puzzle", "casual"], "long_description": "Embark on a thrilling journey through vibrant, interactive worlds in our exhilarating VR puzzle game, 'Bobble Wobble 2'! Guide your adorable Bobble through a series of mind-bending challenges, strategically pushing and manoeuvring them to reach the coveted end goal. With each level presenting a unique puzzle to solve, immerse yourself in 50 captivating stages that will test your wit and agility to the fullest. Are you ready to embark on this epic adventure and unlock the mysteries that await in 'Bobble Wobble 2'? Bring the Bobble Wobble world into your world with the new Mixed Reality switch.", "short_description": "Navigate through 50 levels of immersive VR puzzles in 'Bobble Wobble 2.' Strategically push your adorable Bobble characters to reach the goal and unlock the next challenge. Are you up for the thrill?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/m
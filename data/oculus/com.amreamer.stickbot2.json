3-diagram-fix.png", "id": "930200692636877", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295512_930200699303543_7985184760039405914_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in6DnGM8DyQQ7kNvwHANhNC&_nc_oc=AdqLAC-88_iohzzMFrgUMb4-tT2IGNzu1qwe1gc1KyJL0cTUmQ3sKobkXgtg_3N9sWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDWybijh7XP4AIX3vGXyMxHcj2tawx9mzMtbgenK97cQ&oe=6AFC8B63"}, {"file_name": "screen-0-watch-fix.png", "id": "1980181216063874", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1980181219397207_7763103684827519056_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG84t57rajAQ7kNvwFzMofu&_nc_oc=AdrYVu6Vm4DFQMz74TwlwxYiIzHna-Co02N6kdE2BZdSBuGsUa9mkEwcM43oDm11dkc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3lLGDx7U7A3Kik6Dkv0DPw1EPvreZZdhX1wrCtaDPow&oe=6AFC74E2"}, {"file_name": "screen-4-cover-fix.png", "id": "783017094169800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822581_783017097503133_6443691275833994300_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad5P4rKYy7sQ7kNvwGK0DP4&_nc_oc=Ado2xjWVzVCAJHXEu1BC1NfsGPpP2jR7JGDczJSttsRhEov5hNX4GbvJh31lM4hLajU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYwaLTSOjFQeDWejFfW2P6dBUArEk_xwTAE-oOLyl7aw&oe=6AFC8B62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "754920860513597", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618453_754920863846930_2000131279644586562_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fc0fBwLuw8Q7kNvwEZMvFW&_nc_oc=AdqKFgB2yiKYv_5IeqqiKfG-9MM7OxQ_Q95JfvRdsaXZHootNhIBamNdTvmIGEOgubM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx3c88VM4O8VKATNXr7Uk1B_WsE8RxYdm3VNMgtBaewg&oe=6AFC5F10"}, "display_name": "StickBot", "keywords": [], "long_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n\nEach recording lasts 30 seconds\n\nThere's also a camera view in the menu on your left hand palm, \nproviding a live third-person preview.\n\nOpen your left hand to use the menu\nClose your hands when moving around to disable the menu\n\nConcepts and Tools explored:\n> Unity, Meta XR, Hand Tracking, \n> Passthrough, \n> Procedural Meshes,\n> Binary Save and Load \n> Full Body Tracking\n> Morphing Poses\n\nDeveloped on a Quest 2 and a Mac book Pro in around 2 months\nFloor color shows FPS:\n72:green\n70-71:light-green\n65-69:yellow\n0-64:red\n\nTools used:\n> Terminal\n> Omnigraffle\n> iMovie\n> GIF brewery\n> Preview\n> QuickTime\n> Audacity\n> Garage Band\n\nIssues Encountered:\n> Button presses (accidental)\n> Latency (72 hz)", "short_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13VNKNGNB0iONUUEiX-tDbj3dJ1cQDAv7T-ESRB0Dm_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://www.amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_mod
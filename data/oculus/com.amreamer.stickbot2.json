ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsJQ99srUJlLZV-C83gvvNh07O2zdkK5Jx2fpNmzoF7ww&oe=69A198A3"}, {"file_name": "screen-0-watch-fix.png", "id": "1980181216063874", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499307311_1980181219397207_7763103684827519056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g5he6kRiIoQ7kNvwEIQ2rb&_nc_oc=AdmVFs2PE-ZNvhwQ_iFoDOl3-djIOm2vrh97hGCR4VJsmzi0Ap_1E9URr4UbW7yttlE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuFQvHMAejnDDvyDU62bP6bCUI90HiJCLegYb9Y-sQukA&oe=69A18222"}, {"file_name": "screen-4-cover-fix.png", "id": "783017094169800", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822581_783017097503133_6443691275833994300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yD-TrwVs0UQ7kNvwE75a6U&_nc_oc=AdnEo96wmD9ZG_-OeSP2MdYJV5A9VZOg58amYwGQQei_WqjJD_OnyL3nr_w3FcLxQ4w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afuw0iogOg0MSmDezPQ5DcDyu_iARlb2SErVGHCtT64SBw&oe=69A198A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "754920860513597", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618453_754920863846930_2000131279644586562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeOspzRQzykQ7kNvwHzdhlv&_nc_oc=Adk3iLzDYs53qIeRLFYRtYyiuw7YK5b1I74QxWtcxzpW6fIgwnXSxad2hzPGj2M3e_U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfssQumTg_r7YMMjbz2qBDW-jWBUplCQbfxPhFp46fn4nA&oe=69A1A490"}, "display_name": "StickBot", "keywords": [], "long_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n\nEach recording lasts 30 seconds\n\nThere's also a camera view in the menu on your left hand palm, \nproviding a live third-person preview.\n\nOpen your left hand to use the menu\nClose your hands when moving around to disable the menu\n\nConcepts and Tools explored:\n> Unity, Meta XR, Hand Tracking, \n> Passthrough, \n> Procedural Meshes,\n> Binary Save and Load \n> Full Body Tracking\n> Morphing Poses\n\nDeveloped on a Quest 2 and a Mac book Pro in around 2 months\nFloor color shows FPS:\n72:green\n70-71:light-green\n65-69:yellow\n0-64:red\n\nTools used:\n> Terminal\n> Omnigraffle\n> iMovie\n> GIF brewery\n> Preview\n> QuickTime\n> Audacity\n> Garage Band\n\nIssues Encountered:\n> Button presses (accidental)\n> Latency (72 hz)", "short_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13VNKNGNB0iONUUEiX-tDbj3dJ1cQDAv7T-ESRB0Dm_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://www.amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24407837742252111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499617687_749536761236974_2687551984747608371_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_GfVQwCFtQQ7kNvwHFK6cj&_nc_oc=Adk2qR-Wt17nVU2Mbdg0-sz3E2x419QmZJX4yypVo3ECt_3W0vNBEpNV71VdlQr3QuA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftOHE3hBqqB
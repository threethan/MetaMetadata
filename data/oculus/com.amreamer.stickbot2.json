VS8Q7kNvwFc-C7j&_nc_oc=AdrSb4XXAgN-B-Xf2sIdK5rNwUpriy7ebwZc6kS46rnF2bQCJIbqfJzFFTlfCa1alGg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDMxHTFWURhPme8FbRU2sTjq5BgoTADLhSvL17gT1I3g&oe=6A9189A3"}, {"file_name": "screen-0-watch-fix.png", "id": "1980181216063874", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499307311_1980181219397207_7763103684827519056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3T8B8DYOuUQ7kNvwGFBFAu&_nc_oc=AdrCMg97cla3deHMZ9V2BcOo4BIAOYcb6-n16-DPcwIGMCs338_7X-Sbx5x-j0ktMpg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8ubdS9Cdn22nzFVtpkyDmV5isWXd-bZP7X_UZJFztYA&oe=6A917322"}, {"file_name": "screen-4-cover-fix.png", "id": "783017094169800", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822581_783017097503133_6443691275833994300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6qm8V6rGWEQ7kNvwE2CCRF&_nc_oc=AdrBMXKu29NDNjd3FaMWcmV7-_NMZiq8VYYXOdzswhk6bgcyf_c1hSxe3Qc2jmHlP7M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBhqwXYJadFD66nnFwAvZkmTMM0qDmsfG2jRop083Fjw&oe=6A9189A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "754920860513597", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618453_754920863846930_2000131279644586562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDmqnC_SzH4Q7kNvwHbbpgY&_nc_oc=AdrCgowfuRuF7_zy-k1cyEXejSFspWCpg2NqMPrrT0gAnke-AD7z_AXqGx2uC7mxqJc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu7MkiPsRREIDB5COXa2wIZcNhhTT94gI9sIb0LfoBVw&oe=6A915D50"}, "display_name": "StickBot", "keywords": [], "long_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n\nEach recording lasts 30 seconds\n\nThere's also a camera view in the menu on your left hand palm, \nproviding a live third-person preview.\n\nOpen your left hand to use the menu\nClose your hands when moving around to disable the menu\n\nConcepts and Tools explored:\n> Unity, Meta XR, Hand Tracking, \n> Passthrough, \n> Procedural Meshes,\n> Binary Save and Load \n> Full Body Tracking\n> Morphing Poses\n\nDeveloped on a Quest 2 and a Mac book Pro in around 2 months\nFloor color shows FPS:\n72:green\n70-71:light-green\n65-69:yellow\n0-64:red\n\nTools used:\n> Terminal\n> Omnigraffle\n> iMovie\n> GIF brewery\n> Preview\n> QuickTime\n> Audacity\n> Garage Band\n\nIssues Encountered:\n> Button presses (accidental)\n> Latency (72 hz)", "short_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13VNKNGNB0iONUUEiX-tDbj3dJ1cQDAv7T-ESRB0Dm_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://www.amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24407837742252111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499617687_749536761236974_2687551984747608371_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldtnyS5
8eIQ7kNvwERxtzJ&_nc_oc=AdqNWl2WP1yGJtZoxE2GIm9aSM9bxte8Dh65JZ91iWVmoenNz_zw3L8xh8jQEjWEam0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbj6kStOUXKNk5UDIyw8L3Rg5b85NlIcEXHY5wteh4bA&oe=6AF350E3"}, {"file_name": "screen-0-watch-fix.png", "id": "1980181216063874", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1980181219397207_7763103684827519056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB7SIphcGLYQ7kNvwE1ETsn&_nc_oc=AdqCEUhC-TEmgSNV81sQiTZnayQtrVG_OktCGiZE61nedLcZS-LgpT2S1mwVrQ_FaZo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-WF8WadCf6ABjhhQqQGWw6meLLzC_FV9dUWeJiyBXNA&oe=6AF33A62"}, {"file_name": "screen-4-cover-fix.png", "id": "783017094169800", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822581_783017097503133_6443691275833994300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jzCVZC8gk8Q7kNvwEy3NPc&_nc_oc=Ado5O6sJFJoIO2dPkdi4omEFoHlveoz_dyFz6T0eWL3uAHp06Hp8mb09_zkWsIUtC60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9h3-EkilPtTgSvDUJbOZS0fGQptBPWcz1UyqRDqVPUg&oe=6AF350E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "754920860513597", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618453_754920863846930_2000131279644586562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzGF4QUqpHwQ7kNvwF9-bjA&_nc_oc=Adra1v0JanHEXRmMnInII3Butqx4ayaZTmH19OVGdxB4CSz2-z7xeDWWbpigO-SuWmA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Xr8_4D1guwWdiHq_12SJOo5VsSVqd_a4772wAzfh1w&oe=6AF32490"}, "display_name": "StickBot", "keywords": [], "long_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n\nEach recording lasts 30 seconds\n\nThere's also a camera view in the menu on your left hand palm, \nproviding a live third-person preview.\n\nOpen your left hand to use the menu\nClose your hands when moving around to disable the menu\n\nConcepts and Tools explored:\n> Unity, Meta XR, Hand Tracking, \n> Passthrough, \n> Procedural Meshes,\n> Binary Save and Load \n> Full Body Tracking\n> Morphing Poses\n\nDeveloped on a Quest 2 and a Mac book Pro in around 2 months\nFloor color shows FPS:\n72:green\n70-71:light-green\n65-69:yellow\n0-64:red\n\nTools used:\n> Terminal\n> Omnigraffle\n> iMovie\n> GIF brewery\n> Preview\n> QuickTime\n> Audacity\n> Garage Band\n\nIssues Encountered:\n> Button presses (accidental)\n> Latency (72 hz)", "short_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13VNKNGNB0iONUUEiX-tDbj3dJ1cQDAv7T-ESRB0Dm_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://www.amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24407837742252111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617687_749536761236974_2687551984747608371_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm8Ai6Q
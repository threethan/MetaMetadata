ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsoaCAAiTuZYGbeTXBVP3eJ-sGO_G87_Dwyu5XUwFb2gw&oe=699C52A3"}, {"file_name": "screen-0-watch-fix.png", "id": "1980181216063874", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307311_1980181219397207_7763103684827519056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzNk9OepTtYQ7kNvwHd5lRk&_nc_oc=Adkxi-pEOW5wSOhCEAcCJUrW3Xgqb5tOCcxWcQHw5kHYidM9p8d-1NaVdawfbLkAu9g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsUib2jTsW-1JfW37wNjzVzXkeCnDGAO-lBSzWrYhOIkw&oe=699C3C22"}, {"file_name": "screen-4-cover-fix.png", "id": "783017094169800", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822581_783017097503133_6443691275833994300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CGNPtw_uekQ7kNvwH19jqk&_nc_oc=AdlAu8fWgkwban2nH-KYCR11pqL8gZlvHgK7TtzVAGxTmSi5pBMO8j3Qh9uw3FUeMMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv3EONUDFyuNRiYqhehKJpyMCMnr7UtzuG9gBVC5rJOqw&oe=699C52A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "754920860513597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618453_754920863846930_2000131279644586562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Hr1yhCvUGkQ7kNvwE16Cr5&_nc_oc=AdmpAFotXYwdELZMPPYk-xR4sLLAzfStUCxkiskWrDqa4QKx5VqxNVeDByCCNjncNX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftxMN4q3ityfJMq6_jUbecBsDynOWQnJ_rJbCVNNbn73g&oe=699C5E90"}, "display_name": "StickBot", "keywords": [], "long_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n\nEach recording lasts 30 seconds\n\nThere's also a camera view in the menu on your left hand palm, \nproviding a live third-person preview.\n\nOpen your left hand to use the menu\nClose your hands when moving around to disable the menu\n\nConcepts and Tools explored:\n> Unity, Meta XR, Hand Tracking, \n> Passthrough, \n> Procedural Meshes,\n> Binary Save and Load \n> Full Body Tracking\n> Morphing Poses\n\nDeveloped on a Quest 2 and a Mac book Pro in around 2 months\nFloor color shows FPS:\n72:green\n70-71:light-green\n65-69:yellow\n0-64:red\n\nTools used:\n> Terminal\n> Omnigraffle\n> iMovie\n> GIF brewery\n> Preview\n> QuickTime\n> Audacity\n> Garage Band\n\nIssues Encountered:\n> Button presses (accidental)\n> Latency (72 hz)", "short_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13VNKNGNB0iONUUEiX-tDbj3dJ1cQDAv7T-ESRB0Dm_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://www.amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24407837742252111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617687_749536761236974_2687551984747608371_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZsjHrxcfU8Q7kNvwEIZHIe&_nc_oc=AdnW1xq1vnImIqiS_EC5TFe-me0Y9nfwz8gIXpP4A_1yfwQADqolv0CKmNeUavrUM10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs4Nzi3wO_W
EZ4Q7kNvwF3shH4&_nc_oc=AdoLYRUKP86wvgkAi4rUcpz9-kWJ70qSTGC3WtgHXebcrHLfHKU8azbibFpfDqKTFys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKvhqab_vHzD033YowVWAchkCXcDs80n6ber-9OTpvGQ&oe=69C925A3"}, {"file_name": "screen-0-watch-fix.png", "id": "1980181216063874", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1980181219397207_7763103684827519056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow-M1nBi8nkQ7kNvwGOH-OS&_nc_oc=Adr0H4BrHRnon2QFpXWE739hxJ-24J2e3gnlYijMfOE_8jNjBgdS0uMFqPHNgnAxxN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOb7Dmr-hOairn4oB2mmdHAfzt59ZkzXTeQtl8JYPFDQ&oe=69C90F22"}, {"file_name": "screen-4-cover-fix.png", "id": "783017094169800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822581_783017097503133_6443691275833994300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WGipWdvdXMQ7kNvwHjsDsa&_nc_oc=AdrUg9YYFnVnFXv66slPRb34hIwVoBxolmyTU7G17ivgFCsKkFsK0YUBcGfqojUW-2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ9yEho_8Gc5Jgacqk4329dFQY-IUxD8Ubo7gbzSvrRg&oe=69C925A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image.png", "id": "754920860513597", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618453_754920863846930_2000131279644586562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yk4DwoEFUrwQ7kNvwHukyJe&_nc_oc=AdrdgX0ggsDZ0hWqaGVWLZ_CkPXMZ7WokFDuWlQYjSoznAOW8lagkcA4NyEoB6bSYaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyP5lzeb-MIyC9aHG5ozmFyytXxhpxKrQHyVK2TVUc95A&oe=69C93190"}, "display_name": "StickBot", "keywords": [], "long_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n\nEach recording lasts 30 seconds\n\nThere's also a camera view in the menu on your left hand palm, \nproviding a live third-person preview.\n\nOpen your left hand to use the menu\nClose your hands when moving around to disable the menu\n\nConcepts and Tools explored:\n> Unity, Meta XR, Hand Tracking, \n> Passthrough, \n> Procedural Meshes,\n> Binary Save and Load \n> Full Body Tracking\n> Morphing Poses\n\nDeveloped on a Quest 2 and a Mac book Pro in around 2 months\nFloor color shows FPS:\n72:green\n70-71:light-green\n65-69:yellow\n0-64:red\n\nTools used:\n> Terminal\n> Omnigraffle\n> iMovie\n> GIF brewery\n> Preview\n> QuickTime\n> Audacity\n> Garage Band\n\nIssues Encountered:\n> Button presses (accidental)\n> Latency (72 hz)", "short_description": "StickBot records, playbacks, and mirrors your live actions. \nThere are four pre-loads varying from \n> dance \n> tai chi\n> exercise\nYou can record your own or just go live  \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13VNKNGNB0iONUUEiX-tDbj3dJ1cQDAv7T-ESRB0Dm_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://www.amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24407837742252111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617687_749536761236974_2687551984747608371_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7zi3n4
0_AQSQof9HikabvGOxHuM1HeHfKtPcqjNw_j4FgSUfkROugw&oe=6AFDABFA"}, {"file_name": "01-practice-room-free-play.png", "id": "1646841230432063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294603_1646841233765396_6867413823765675507_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZby4BvM4dgQ7kNvwGlAFAf&_nc_oc=AdrTAEDIZojKQ503gKcUbs-bpxXAedvZJIhRVbgbzlaGpgZcBUpLHVTLvIii1s2lycw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsDg4xsxgRT6YS7hLRHvQSzNkB6PMp37lJ_wbwF_1_KQ&oe=6AFDBE95"}, {"file_name": "04-concert-free-play.png", "id": "1686232056239156", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499294603_1686232059572489_760407933934639175_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyk1OqKjUrEQ7kNvwG92bWX&_nc_oc=Adocbey0D-VilOhVKDbOLFS60eSevztFTLP1m_9oEGjRU_IUcdMSWxUJwla60RwV8aE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1kDNjSQVe1Yt8qepr_klN6kAkyuQW7qSsW3fhySa-wg&oe=6AFDD0F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape-concert.png", "id": "1819798845821668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646443466_1819798849155001_1567411386194120517_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SyL3tT3FfsQ7kNvwE4rpll&_nc_oc=AdqsgzYcBprq4x6DTywLHEEDo7l3_qmiOnN73EjRMLpGPCZWS1SJzOqiRYpmZOiKfAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7vMe33KJjxabVbiS7oM8PKnyPlcS-ot0AO6I4F4NVhQ&oe=6AFDDB66"}, "display_name": "Solf\u00e8ge Studio", "keywords": ["music", "instruments", "handtracking", "musiceducation", "eartraining"], "long_description": "Turn the hand signs used in music education into a playable instrument. Make a sign and hear its note. Play melody with one hand and harmony with the other, using all 17 signs, two height bands and 42 instrument sounds. Explore immersive rooms or your own space with passthrough.\n\nSing into your headset. In Free Play, turn on Voice and allow the microphone so the app can identify your pitch and show the matching note and hand sign. Sing new do sets the key from your voice. Echo lets you hear it in the room. Audio stays on your headset and is never saved.\n\nTwo guided lessons teach The Basic Signs and Sharps and Flats, with diagrams and steps that wait for both hands to lock. Three song lessons offer Watch and Play: O Christmas Tree, F\u00fcr Elise and Mo Ghile Mear. Choose melody, harmony or both hands; Play waits for you.\n\nCall and Response offers 1,000 notes across ten musical chapters, from familiar melodies to minor and chromatic passages. Listen, match with both hands and earn up to 10 points per response for speed, without deductions for wrong notes. Each 100-call chapter has scores, stars and a saved stopping point.\n\nLesson narration and captions are available in 36 languages. Some interface and Challenge text remains English. Play seated or standing, with captions, larger menus, mono audio and easier pointing.\n\nNo Solf\u00e8ge Studio account or internet needed. No ads or in-app purchases. By Porter360. More at solfege.studio.", "short_description": "Play a melody with your hands or sing into your headset. Turn on Voice in Free Play to see each note you sing and its matching hand sign. Learn the signs in guided lessons and play through ten musical Call and Response chapters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solfege.studio/quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Porter360", "support_website_url": "https://solfege.studio/quest/support/", "website_url": "https://solfege.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
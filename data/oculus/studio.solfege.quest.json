ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW0QV-tkCoqrz__27pIStZQXxbyStOM8O6J2jLLdAWpg&oe=6AFDB751"}, {"file_name": "02-chapel-high-octave.png", "id": "1777766283492915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654862493_1777766286826248_8038032612766773961_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0YhelT_AXIQ7kNvwFcCxO7&_nc_oc=Adrk79YweVSP-1quGF0e3dsrcXcmVPFqOoiyTsA4ofW1VJ05g6WG1Uonzxb8hi3gtbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJtqNBy0Gst2VGuhY0tM26uVwklxl68gwHuNvudKbBnQ&oe=6AFDD663"}, {"file_name": "04-concert-free-play.png", "id": "2224642648433592", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/742308944_2224642651766925_7287482226677051999_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHU3SxRa9pcQ7kNvwEYyeB8&_nc_oc=AdrJdvzlWY8BruQhXPOF6xc4jmfncLNPzM7Pvfh5cEIPRSUvRiIjiPBXKzNJYOTDmig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbvYVjoPkcsYUdLd8c24RufB4cjkMyzCwS7TAB5eVubA&oe=6AFDCFD5"}, {"file_name": "03-bridge-two-octaves.png", "id": "1435881074578955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/772632092_1435881077912288_1263046094006687862_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQWQSUBSNloQ7kNvwHsFNDT&_nc_oc=AdqZiwHIx2eW_azmmXzoKAXFvD4B_S1wqnUntNaSidWTnvac4vPKCvxGpkvST1EYvko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRukEqfA8n-J9vOkVtB5oXLMkNLRe0tYVQKmAm11Wfa7g&oe=6AFDD0F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape-concert.png", "id": "1819798845821668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646443466_1819798849155001_1567411386194120517_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SyL3tT3FfsQ7kNvwE4rpll&_nc_oc=AdqsgzYcBprq4x6DTywLHEEDo7l3_qmiOnN73EjRMLpGPCZWS1SJzOqiRYpmZOiKfAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7vMe33KJjxabVbiS7oM8PKnyPlcS-ot0AO6I4F4NVhQ&oe=6AFDDB66"}, "display_name": "Solf\u00e8ge Studio", "keywords": ["music", "instruments", "handtracking", "musiceducation", "eartraining"], "long_description": "Solf\u00e8ge Studio turns the hand signs used in music education into a playable instrument. Make a sign and hear its note.\n\nPlay with either hand in Free Play, or both for melody and harmony. All 17 signs are available, including sharps and flats. Move between two height bands to change register, choose from 42 instrument sounds, and play in immersive environments or your own room with passthrough.\n\nTwo guided lessons teach The Basic Signs and Sharps and Flats. Diagrams show both hands, and each step waits for both hands to lock the sign. Three song lessons offer Watch and Play: O Christmas Tree, F\u00fcr Elise and Mo Ghile Mear. Choose melody, harmony or both hands; Play waits for you.\n\nChallenge is a listening game with 1,000 calls across ten chapters. Listen, match the note with both hands and earn up to 10 points per response for speed, with no deduction for wrong notes. Each 100-call chapter has a best score, stars and a saved stopping point. A low Do drone helps you hear the tonal centre; turn it off for an extra challenge.\n\nLesson narration and captions are available in 36 languages. Some interface and Challenge text remains English. Play seated or standing. Options include captions, larger menus, mono audio and easier pointing.\n\nRecognition runs on the headset. No Solf\u00e8ge Studio account or internet connection is needed to play. No ads or in-app purchases.\n\nBy Porter360. More at solfege.studio.", "short_description": "Make music with your hands. Explore instruments and immersive rooms, learn solf\u00e8ge signs with both hands, and train your ear in a 1,000-call listening challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solfege.studio/quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Porter360", "support_website_url": "https://solfege.studio/quest/support/", "website_url": "https://solfege.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "bn", "bg", "cs", "da", "nl", "fi", "de", "el", "he", "hi", "hu", "id", "ga", "it", "ja", "ko", "fa", "pl", "ro", "ru", "sr", "sv", "ta", "te", "th", "tr", "uk", "vi", "cy", "fr", "nb", "pt_BR", "es", "zh_CN"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134836735642166"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2662251740896672"}]}, "baseline_offer": {"id": "2662251740896672"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792771380, "status": "PUBLISHED", "id": "2662251740896672"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1155816670210839", "version": "1.1.0"}, "id": "2285514852214959", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1134836728975500", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1155816670210839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2285514852214959"}]}, "change_log": "Turn on Voice in Free Play and sing to see your note and its matching hand sign. Sing new do sets the key from your voice. Try 1,000 musical calls across ten Challenge chapters, with touch controls and a restart button on the music stand.", "created_date": 1793816461, "id": "1155816670210839", "version": "1.1.0", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1134836728975500", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1155816670210839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2285514852214959"}]}, "change_log": "Solf\u00e8ge Studio 1.1.0\n\nSing and see the note: optional Voice in Free Play shows your pitch and hand sign. Sing new do to set your key, and add live Echo to hear your voice in the room. Microphone processing stays on your headset.\n\nPlay through 1,000 newly composed Call and Response notes in ten musical chapters, from familiar melodies to minor and chromatic passages. Each chapter still has 100 two-hand responses, its own score and a natural stopping point.\n\nA redesigned music stand brings Hands, Voice, Drone and Echo together, with touchable buttons, quick key changes and a restart control for your current Challenge chapter. The Hand Sign Guide has a clearer name, and accidental targets show both accepted solf\u00e8ge names.\n\nYour preferences and earned chapter access carry forward. Earlier Challenge scores stay saved as history; the rewritten chapters start fresh best scores.", "created_date": 1793690616, "id": "1154326750359831", "version": "1.1.0", "version_code": 46, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1134836728975500", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1155816670210839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2285514852214959"}]}, "change_log": "Autumn has arrived in the Practice Room. Call and Response has a new orb and pedestal, quieter feedback, and stars revealed as you earn them. The 1,000-call journey now begins with five chapters of natural notes before introducing sharps and flats more gradually. Hand-sign recognition data has also been updated. Your unlocked chapters stay available. Best scores carry forward for unchanged chapters; revised chapters begin new score records, with previous scores retained.", "created_date": 1793307222, "id": "1150012974124542", "version": "1.0.0", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1134836728975500", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1155816670210839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2285514852214959"}]}, "change_log": "Pointer mode now includes quick shortcuts to Home, Environments, Instruments and Options. Returning after headset removal or sleep is smoother, with improved orientation handling, preserved placements in Your Room, and safer button interaction after interruptions.", "create
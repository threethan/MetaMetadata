nc_oc=AdpZjJHuz1GPqze4rElIJ5XouUdP5ZyZXHYoDboD1sdxelUadaVac9WeoZVl_rL5QXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT99npruwUh2c_fLj_JDmjZThm060Qf0Oq02lR5P0Bz6g&oe=6AEA0955"}, {"file_name": "03-bridge-two-octaves.png", "id": "1435881074578955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/772632092_1435881077912288_1263046094006687862_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2frQEg9eWwQ7kNvwFmbq_U&_nc_oc=AdrJK1QyzWEPhNDzrRaQfpKvPAQqF3CIkor1lwO4Lo24S3Z-V73QzckMfglODilCJac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMHDkh0cDTLJOtivwsJawj1Ut1iVPZYo9soi8Uq28HHg&oe=6AEA0A72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape-concert.png", "id": "1819798845821668", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646443466_1819798849155001_1567411386194120517_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZuqi08KUxIQ7kNvwEeufcA&_nc_oc=AdpQGw1iEE0O1kwWWN3QwdxyqfaSXheYQ8PBfwkt9vmveuf95jelvBTHBJlG4ojpD44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuaBShWAbN2lg9nUQQs4klEdjBIC_NuEcpugSFyvT1wQ&oe=6AEA14E6"}, "display_name": "Solf\u00e8ge Studio", "keywords": ["music", "instruments", "handtracking", "musiceducation", "eartraining"], "long_description": "Solf\u00e8ge Studio turns the hand signs used in music education into a playable instrument. Make a sign and hear its note.\n\nPlay with either hand in Free Play, or both for melody and harmony. All 17 signs are available, including sharps and flats. Move between two height bands to change register, choose from 42 instrument sounds, and play in immersive environments or your own room with passthrough.\n\nTwo guided lessons teach The Basic Signs and Sharps and Flats. Diagrams show both hands, and each step waits for both hands to lock the sign. Three song lessons offer Watch and Play: O Christmas Tree, F\u00fcr Elise and Mo Ghile Mear. Choose melody, harmony or both hands; Play waits for you.\n\nChallenge is a listening game with 1,000 calls across ten chapters. Listen, match the note with both hands and earn up to 10 points per response for speed, with no deduction for wrong notes. Each 100-call chapter has a best score, stars and a saved stopping point. A low Do drone helps you hear the tonal centre; turn it off for an extra challenge.\n\nLesson narration and captions are available in 36 languages. Some interface and Challenge text remains English. Play seated or standing. Options include captions, larger menus, mono audio and easier pointing.\n\nRecognition runs on the headset. No Solf\u00e8ge Studio account or internet connection is needed to play. No ads or in-app purchases.\n\nBy Porter360. More at solfege.studio.", "short_description": "Make music with your hands. Explore instruments and immersive rooms, learn solf\u00e8ge signs with both hands, and train your ear in a 1,000-call listening challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://solfege.studio/quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Porter360", "support_website_url": "https://solfege.studio/quest/support/", "website_url": "https://solfege.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "bn", "bg", "cs", "da", "nl", "fi", "de", "el", "he", "hi", "hu", "id", "ga", "it", "ja", "ko", "fa", "pl", "ro", "ru", "sr", "sv", "ta", "te", "th", "tr", "uk", "vi", "cy", "fr", "nb", "pt_BR", "es", "zh_CN"], "supported_input_devices": ["HAND_TRACKING"], "supported_
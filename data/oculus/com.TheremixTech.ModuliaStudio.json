724603695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR0I1buaHQMQ7kNvwGje809&_nc_oc=Adl6aDSiulyxpifkr5jfVzRVxpJV3-ef_eNhi4de4wtdJ8mr5eaJNCKGi9K_eRnvQds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-xa8CPgPPfCnVmFYVsvWVGGliAhB6yRyIHQZnB-dWog&oe=69A2E224"}, {"file_name": "4.png", "id": "798605747754490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982483_798605754421156_1986649763789961237_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jFqo59VBXkQ7kNvwFZrhsM&_nc_oc=AdlbFvNiMPZX62x_2e98x0klzjPv0XallPmQsEi7vT-epWddryDvYfgRC4hJdB2bzfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtgFnJ3-cd5M5jm2AG5JFAGhEiH4cQ0qxGqOF-47_HpQ&oe=69A2FBE5"}, {"file_name": "2.png", "id": "263294812157372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035358_263294815490705_4150129998500296228_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI7kgO4VIWQQ7kNvwF7hHG_&_nc_oc=Admhtl-s41S5oM0meLtH3lduFbr4nIDvfFpD-Y7tYTOIbat3-j47-ljLBl_wU-0L3vQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftn_e36Wurw13tFgDg0XJkNNJBkilhfRfxiVHdLjGnhww&oe=69A2D667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Modulia Quest - screenshot.png", "id": "522084335580003", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982449_522084338913336_7694930828877611739_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1OkDGMub7wQ7kNvwFEllJ8&_nc_oc=AdlEjOnO2CwpZ2gBzNkO5JXrfq2GG4GeZbRCPHmPlct0z3fbpgR4S-qJPDXKP_0aZ0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPzKqh0Lvu2Q_zXri52XhLLDaIfzid-v1Iy9lYQDiZIw&oe=69A2C751"}, "display_name": "Modulia Studio", "keywords": [], "long_description": "Modulia Studio is a VR MIDI controller. \n\nIt allows you to wirelessly control any MIDI-compatible software and has an especially deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your custom studio using the 11 different modules:\n\n- Session (controls the session view of Live\u2122)\n- Circular Keyboard (a beautiful 360\u00b0 keyboard)\n- Scale Keyboard (a versatile scaled keyboard)\n- Expressive Keyboard (a MIDI-MPE keyboard for expressive performances)\n- Remote (remotely triggers multiple notes and visual effects at once)\n- Pads (a 4x4 pads grid)\n- Cube Mixer (a 3D mixing space)\n- Cylinder Mixer (a cylindrical 3D mixing space)\n- Knobs (4 configurable knobs)\n- Sliders (4 configurable sliders)\n- FX (visual effects)\n\nDownload Modulia Desktop for MacOS and Windows to connect Modulia Studio to your MIDI software: www.modulia-studio.com/get-modulia-studio/#desktop \n\n~~~~~~~~~~~~~~~~~~~~~~~~\n\nAbleton\u00ae and Live\u2122 are trademarks of Ableton AG.", "short_description": "Modulia Studio is a VR MIDI controller. \n\nIt lets you wirelessly control any MIDI-compatible software and has a deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your studio using the 11 different modules:\n\n- Session\n- Circular Keyboard\n- Scale Keyboard\n- Expressive Keyboard\n- Remote\n- Pads\n- Cube Mixer\n- Cylinder Mixer\n- Knobs\n- Sliders\n- FX\n\nGet Modulia Desktop to connect Modulia Studio to your MIDI software at www.modulia-studio.com "}]}, "developer_name": "Th\u00e9r\u00e9mix Tech", "developer_privacy_policy_url": "https://www.modulia-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Th\u00e9r\u00e9mix Tech", "support_website_url": "https://www.modulia-studio.com/documentation/", "website_url": "https://www.modulia-studio.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, 
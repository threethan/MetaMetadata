E7MUXb&_nc_oc=Adq6zoKmUyEJRpXF3sklSC46ndOyYzFwGVUqpykSxZBdqSAmvnu6OpdStF9sao7ZP4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiFKKqcITuFMgzH92ONK_cAr8aHIWRN5vT2tzPJ6cfEg&oe=6B00690B"}, {"file_name": "5.png", "id": "134778495298719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_134778498632052_411711373724603695_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAaeAFqSkJEQ7kNvwF8Xzc8&_nc_oc=Adol-YT916r41xV9oeVt_270sQwi4zjzAiYqgTZRjND3bUDueD-l8Sttn09bh_XDS3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv3nLcncaSTwZ_ob5FModYahfxd1ZWWZiKFe_f4zoG3g&oe=6B0077E4"}, {"file_name": "4.png", "id": "798605747754490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982483_798605754421156_1986649763789961237_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeIunH-C0GkQ7kNvwEZrS8f&_nc_oc=AdqL-p1kQ6g1SmA1lg3UABDLjsV4ytbT_IYuSQN7cUI3_lG0O2eC5CbcG9cB8zG9BuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtQ2ADscUeDHUL96FhmCEoa2ijk0Y2BJ0cu-xf6s1J-w&oe=6B005965"}, {"file_name": "2.png", "id": "263294812157372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035358_263294815490705_4150129998500296228_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VgDhf7WaxwQ7kNvwEqcFL_&_nc_oc=AdrdIxoBP3IbEE8xMhtIpR47sLhrpcAbixerRZeC1BYw0d-99o9mcB9NRYUXJLIOsy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtLPIDmcmxT6Bb5v5cU1z-tAqP-GBepabDEBu-Qow1BA&oe=6B006C27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Modulia Quest - screenshot.png", "id": "522084335580003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982449_522084338913336_7694930828877611739_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x32J8z92sfoQ7kNvwGrUWQN&_nc_oc=Adqx8V98Kw7XjhgVjkf-MNdc-L9-meLRAYGl-hiJCpHwUaS4N_qU_4QT-Ka-SESt6sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0FcG-STT0Pp6JxwbZHfDabxvvD-PNg0WJRkdCi1tHnQ&oe=6B005D11"}, "display_name": "Modulia Studio", "keywords": [], "long_description": "Modulia Studio is a VR MIDI controller. \n\nIt allows you to wirelessly control any MIDI-compatible software and has an especially deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your custom studio using the 11 different modules:\n\n- Session (controls the session view of Live\u2122)\n- Circular Keyboard (a beautiful 360\u00b0 keyboard)\n- Scale Keyboard (a versatile scaled keyboard)\n- Expressive Keyboard (a MIDI-MPE keyboard for expressive performances)\n- Remote (remotely triggers multiple notes and visual effects at once)\n- Pads (a 4x4 pads grid)\n- Cube Mixer (a 3D mixing space)\n- Cylinder Mixer (a cylindrical 3D mixing space)\n- Knobs (4 configurable knobs)\n- Sliders (4 configurable sliders)\n- FX (visual effects)\n\nDownload Modulia Desktop for MacOS and Windows to connect Modulia Studio to your MIDI software: www.modulia-studio.com/get-modulia-studio/#desktop \n\n~~~~~~~~~~~~~~~~~~~~~~~~\n\nAbleton\u00ae and Live\u2122 are trademarks of Ableton AG.", "short_description": "Modulia Studio is a VR MIDI controller. \n\nIt lets you wirelessly control any MIDI-compatible software and has a deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your studio using the 11 different modules:\n\n- Session\n- Circular Keyboard\n- Scale Keyboard\n- Expressive Keyboard\n- Remote\n- Pads\n- Cube Mixer\n- Cylinder Mixer\n- Knobs\n- Sliders\n- FX\n\nGet Modulia Desktop to connect Modulia Studio to your MIDI software at www.modulia-studio.com "}]}, "developer_name": "Th\u00e9r\u00e9mix Tech", "developer_privacy_policy_url": "https://www.modulia-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Th\u00e9r\u00e9mix Tech", "support_website_url": 
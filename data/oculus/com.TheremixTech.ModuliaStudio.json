F6Xg5w&_nc_oc=AdoV1Uh37e6qNlTO4URak0m_-NzXVp2CHZYnyFdwj30G9tGgszo_tZ2KWTBzooHST9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHDBFMDucoIdRCwCunvEf1v1rLim-uK9OFnyIHmidoEg&oe=6B103B0B"}, {"file_name": "5.png", "id": "134778495298719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982471_134778498632052_411711373724603695_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yll9kSpYxcQQ7kNvwF72BH1&_nc_oc=Adp4T0LlljJv-9Nn4GeUNm-Yk3hXY77IykQ55H1VA_kV8bxH2nK__QXUI2thSmMdEUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNEK4ZbBrB-wXw4LY8sjikWeQu0tFgXysnoqBxr3sB7A&oe=6B1049E4"}, {"file_name": "4.png", "id": "798605747754490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982483_798605754421156_1986649763789961237_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOBvefeNVggQ7kNvwHXutoy&_nc_oc=Adqijf8STr-x4jIc8JPCC_YQXozBrJNw3HW_s_qwcu6K5VpTjvFQsvxsBp7SDjV_D6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpv7QYAlVYkNlyWuxpJ7Cq3p3T_pwziGTllKZY-8QjPg&oe=6B1063A5"}, {"file_name": "2.png", "id": "263294812157372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035358_263294815490705_4150129998500296228_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvHDmPPGRVMQ7kNvwFJSH4o&_nc_oc=AdqTpapE3-IDV3WWhEebFrR3rEdARPdt8txCaiWTqX5TPJGzWMLorLQ6AsWOaxaebkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdyIrp8T6XsOKhks8rH_1UF1MfPV1QBqGU86hzTsGFRQ&oe=6B103E27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Modulia Quest - screenshot.png", "id": "522084335580003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982449_522084338913336_7694930828877611739_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXIMhlbZw24Q7kNvwF2Rfe4&_nc_oc=Adomj_NXsDTELzgdqIxndDgNWTEz7v76bbVVXb5UDQubxi73WpCT49LmNVmOHPnuO3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6dYjE0r7RIL3ib4A2gyFpkPOp6PznV61WVIPFW62R7w&oe=6B106751"}, "display_name": "Modulia Studio", "keywords": [], "long_description": "Modulia Studio is a VR MIDI controller. \n\nIt allows you to wirelessly control any MIDI-compatible software and has an especially deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your custom studio using the 11 different modules:\n\n- Session (controls the session view of Live\u2122)\n- Circular Keyboard (a beautiful 360\u00b0 keyboard)\n- Scale Keyboard (a versatile scaled keyboard)\n- Expressive Keyboard (a MIDI-MPE keyboard for expressive performances)\n- Remote (remotely triggers multiple notes and visual effects at once)\n- Pads (a 4x4 pads grid)\n- Cube Mixer (a 3D mixing space)\n- Cylinder Mixer (a cylindrical 3D mixing space)\n- Knobs (4 configurable knobs)\n- Sliders (4 configurable sliders)\n- FX (visual effects)\n\nDownload Modulia Desktop for MacOS and Windows to connect Modulia Studio to your MIDI software: www.modulia-studio.com/get-modulia-studio/#desktop \n\n~~~~~~~~~~~~~~~~~~~~~~~~\n\nAbleton\u00ae and Live\u2122 are trademarks of Ableton AG.", "short_description": "Modulia Studio is a VR MIDI controller. \n\nIt lets you wirelessly control any MIDI-compatible software and has a deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your studio using the 11 different modules:\n\n- Session\n- Circular Keyboard\n- Scale Keyboard\n- Expressive Keyboard\n- Remote\n- Pads\n- Cube Mixer\n- Cylinder Mixer\n- Knobs\n- Sliders\n- FX\n\nGet Modulia Desktop to connect Modulia Studio to your MIDI software at www.modulia-studio.com "}]}, "developer_name": "Th\u00e9r\u00e9mix Tech", "developer_privacy_policy_url": "https://www.modulia-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Th\u00e9r\u00e9mix Tech", "support_website_url": 
724603695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR0I1buaHQMQ7kNvwHOfi60&_nc_oc=AdlvLjWwOh0WjJAmUEe7AL4Uugoa_aBSWskLIUhAjvp6seFHcqOO6uDDpEORZgXSGRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftbVLUE7mdOjlPKhmyGZnxQTCokh6104VapY6nNaMvXMg&oe=69A433A4"}, {"file_name": "4.png", "id": "798605747754490", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982483_798605754421156_1986649763789961237_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jFqo59VBXkQ7kNvwGUnaon&_nc_oc=AdkighBl_R-SZQRRTxVCmFI_ZFZzv9VZqASCcpC_4r1yussBIQU3f8QBykGeFiBWcyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afut50W6kb_xRCEW-MTSlesvmDA17q8r3naoph_xY7iExQ&oe=69A44D65"}, {"file_name": "2.png", "id": "263294812157372", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035358_263294815490705_4150129998500296228_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI7kgO4VIWQQ7kNvwGa56IU&_nc_oc=Adm5y_VR36jh9K3rDmaAuwUU44SmNFwO9bFuatbzoal6C7PiNXHCzEk3A8DZQDVyAjc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs5BKVywMuzqCtPp7o7smz_Rst4-HnhBQ89bu6bi3Iltw&oe=69A427E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Modulia Quest - screenshot.png", "id": "522084335580003", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982449_522084338913336_7694930828877611739_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1OkDGMub7wQ7kNvwHYwe87&_nc_oc=AdlWmGoTEPhxn-2QvexrSNnOYMQBY-EoXZCxelbi50j64wEdusWoOUfzB7iw-A1O8VM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuE2EKix3wez44tzCLbLffOHIm6dYiRHQGklaqaikQhLA&oe=69A45111"}, "display_name": "Modulia Studio", "keywords": [], "long_description": "Modulia Studio is a VR MIDI controller. \n\nIt allows you to wirelessly control any MIDI-compatible software and has an especially deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your custom studio using the 11 different modules:\n\n- Session (controls the session view of Live\u2122)\n- Circular Keyboard (a beautiful 360\u00b0 keyboard)\n- Scale Keyboard (a versatile scaled keyboard)\n- Expressive Keyboard (a MIDI-MPE keyboard for expressive performances)\n- Remote (remotely triggers multiple notes and visual effects at once)\n- Pads (a 4x4 pads grid)\n- Cube Mixer (a 3D mixing space)\n- Cylinder Mixer (a cylindrical 3D mixing space)\n- Knobs (4 configurable knobs)\n- Sliders (4 configurable sliders)\n- FX (visual effects)\n\nDownload Modulia Desktop for MacOS and Windows to connect Modulia Studio to your MIDI software: www.modulia-studio.com/get-modulia-studio/#desktop \n\n~~~~~~~~~~~~~~~~~~~~~~~~\n\nAbleton\u00ae and Live\u2122 are trademarks of Ableton AG.", "short_description": "Modulia Studio is a VR MIDI controller. \n\nIt lets you wirelessly control any MIDI-compatible software and has a deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your studio using the 11 different modules:\n\n- Session\n- Circular Keyboard\n- Scale Keyboard\n- Expressive Keyboard\n- Remote\n- Pads\n- Cube Mixer\n- Cylinder Mixer\n- Knobs\n- Sliders\n- FX\n\nGet Modulia Desktop to connect Modulia Studio to your MIDI software at www.modulia-studio.com "}]}, "developer_name": "Th\u00e9r\u00e9mix Tech", "developer_privacy_policy_url": "https://www.modulia-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Th\u00e9r\u00e9mix Tech", "support_website_url": "https://www.modulia-studio.com/documentation/", "website_url": "https://www.modulia-studio.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, 
file_name": "5.png", "id": "134778495298719", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982471_134778498632052_411711373724603695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUPNfya3OVUQ7kNvwG5CsR1&_nc_oc=Adq1ZmXzsN08jbuwTlt3yO3MV4Jpv4Sfq46o2Oi64wYd0I6YmNg96xr6GrCvLza3bJM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-jDfvi0wsDuusOpnB4APILXLsIKoeycEkhdf3BsDbbw&oe=6A11A024"}, {"file_name": "4.png", "id": "798605747754490", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982483_798605754421156_1986649763789961237_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdU6u2iLdrwQ7kNvwFKEjkY&_nc_oc=AdqSQX09BjhzVyFJ3rKcja12nd3W3p5YtUaudOGO1L4BcF3MkhV11sVitDhAuxcNi-0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cahPTKVKhDwvKEo-N-RxIZBoo8eVVFspg4mYELfVknA&oe=6A11B9E5"}, {"file_name": "2.png", "id": "263294812157372", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035358_263294815490705_4150129998500296228_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PXgLD72WAgQ7kNvwFA-jY-&_nc_oc=Adp9EpYcl-Qukdy6dVRB76RwlgMvJ8jGyk9CfYXl6sjjG49Gj1LpPeDrbvgGEYSs95M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oi1_mp6Q0nMVnzXuzFA6ku5TL-NNvDOXGEE3B8pcDjA&oe=6A11CCA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modulia Studio", "keywords": [], "long_description": "Modulia Studio is a VR MIDI controller. \n\nIt allows you to wirelessly control any MIDI-compatible software and has an especially deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your custom studio using the 11 different modules:\n\n- Session (controls the session view of Live\u2122)\n- Circular Keyboard (a beautiful 360\u00b0 keyboard)\n- Scale Keyboard (a versatile scaled keyboard)\n- Expressive Keyboard (a MIDI-MPE keyboard for expressive performances)\n- Remote (remotely triggers multiple notes and visual effects at once)\n- Pads (a 4x4 pads grid)\n- Cube Mixer (a 3D mixing space)\n- Cylinder Mixer (a cylindrical 3D mixing space)\n- Knobs (4 configurable knobs)\n- Sliders (4 configurable sliders)\n- FX (visual effects)\n\nDownload Modulia Desktop for MacOS and Windows to connect Modulia Studio to your MIDI software: www.modulia-studio.com/get-modulia-studio/#desktop \n\n~~~~~~~~~~~~~~~~~~~~~~~~\n\nAbleton\u00ae and Live\u2122 are trademarks of Ableton AG.", "short_description": "Modulia Studio is a VR MIDI controller. \n\nIt lets you wirelessly control any MIDI-compatible software and has a deep integration with Ableton Live\u2122 10 & 11. It also features a standalone mode with embedded sounds.\n\nBuild your studio using the 11 different modules:\n\n- Session\n- Circular Keyboard\n- Scale Keyboard\n- Expressive Keyboard\n- Remote\n- Pads\n- Cube Mixer\n- Cylinder Mixer\n- Knobs\n- Sliders\n- FX\n\nGet Modulia Desktop to connect Modulia Studio to your MIDI software at www.modulia-studio.com "}]}, "developer_name": "Th\u00e9r\u00e9mix Tech", "developer_privacy_policy_url": "https://www.modulia-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Th\u00e9r\u00e9mix Tech", "support_website_url": "https://www.modulia-studio.com/documentation/", "website_url": "https://www.modulia-studio.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inter
v/t64.5771-25/499318633_586202830614485_739651451817971030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCJCQZUOmwcQ7kNvwHfrDr8&_nc_oc=Adoo53FKx7iupKX7j6tH2nGdlycP4vy1ykAgn0HAntbKtWBrAcRotzK4GFuKhgxKL3w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_G9mZd2qNz2-xqQdJNycC-Gu46A1r8wYNHJqsT-XmBw&oe=69D794F8"}, {"file_name": "ss (4).png", "id": "1236970684716430", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499316656_1236970688049763_8382273468777427629_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkrNwiAGAdUQ7kNvwGQ7a6q&_nc_oc=AdoGXmPycspV0ybqb4vdHP8hXWPH6g54VYgzS3VLpRzjFlic9hxCMyrPsYHoPq0ctog&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X2PNS3kgkNo0MH00l0lFFwJmXLGi_gy-37o-2V3zbYw&oe=69D7B38B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pixelbound (1).png", "id": "708853948258349", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499333436_708853951591682_3432073265394275781_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9TkSjkggmUQ7kNvwHmXeW7&_nc_oc=AdoX85N7lsBIKRCDOEtUT79itDC3dIJ3CSUYptvD9GvX4_UyUQEkRe4L2pSyr2SFGeE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af204bG_EUDmltadG1MQeJbKMhZP9CLoT1O7EeFRSFlS_Q&oe=69D7B35D"}, "display_name": "Pixel Bound", "keywords": ["retro", "pixel", "bound", "platformer", "platform"], "long_description": "Step into the pixelated world of Pixel Bound, a thrilling VR platformer where you're more than just a player\u2014you\u2019re the prisoner of the game.\n\nTrapped inside a vibrant retro-inspired virtual world, you must run, jump, and fight your way through a series of challenging levels. Your mission? Survive the traps, outsmart deadly puzzles, collect scattered coins, and battle relentless enemy robots to unlock the path forward.\n\nEach level offers a unique blend of action, brain-teasing challenges, and fast-paced platforming, designed to keep you on your toes and immersed in the experience. Whether you're leaping over lava pits, navigating through maze-like structures, or dodging laser-shooting bots, every moment in Pixel Bound is packed with tension and excitement.\n\nUse your reflexes, solve puzzles, and explore hidden secrets as you unravel the mystery behind your digital imprisonment. Will you conquer the code and escape the system, or remain trapped in this pixelated prison forever?\n\nWith immersive VR mechanics and a nostalgic art style, Pixel Bound offers a one-of-a-kind adventure that blends classic gameplay with modern virtual reality.\n\nThe game won't let you go easily\u2014are you ready to beat it at its own game?", "short_description": "Trapped in a retro VR world, you must run, jump, and fight your way through mind-bending puzzles, deadly traps, and ruthless robot foes. Collect coins, conquer levels, and escape the cubic world in this action-packed platformer adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/d8bc5258-060e-4c0d-a192-2d6559f6be6f", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32153080240972580"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"statu
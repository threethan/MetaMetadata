1817971030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUclhnEkRF8Q7kNvwHCnG5Q&_nc_oc=AdlU69_dx2ST-fPsnwMaKh0Bab0hgwzJ8acMEG9sT4j0J6MGyX3vfHGceFfxJGYbZgA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfybEJKC2WHx7K-EHvrR7f2VURDiOIE6UBJT_vvmxKaEEg&oe=69B7F0F8"}, {"file_name": "ss (4).png", "id": "1236970684716430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499316656_1236970688049763_8382273468777427629_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Kzt2OVR5U4Q7kNvwGNZG4H&_nc_oc=AdlXo3sM8hTr4Yc7tG08yrOixISBvbKqqfsJ5-DxypLDHTLtCldsu9dnonnHaELUK1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxHYEXPxJ6KkotZ4RnujIGW8bjN_S2Jngrjxrn2bjtKw&oe=69B80F8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pixelbound (1).png", "id": "708853948258349", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499333436_708853951591682_3432073265394275781_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVh0jzA3-OgQ7kNvwGI_DAT&_nc_oc=Adl_tAJOYIzgr7StJadoe3pO2X6CiOP-51kA6aYSTK76wG4m6oylr3Pi59QtYdWb6fI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwnW0NpU2btlbK9gAnCIke0RQBKui8TM9x2uCYPRCCfUg&oe=69B80F5D"}, "display_name": "Pixel Bound", "keywords": ["retro", "pixel", "bound", "platformer", "platform"], "long_description": "Step into the pixelated world of Pixel Bound, a thrilling VR platformer where you're more than just a player\u2014you\u2019re the prisoner of the game.\n\nTrapped inside a vibrant retro-inspired virtual world, you must run, jump, and fight your way through a series of challenging levels. Your mission? Survive the traps, outsmart deadly puzzles, collect scattered coins, and battle relentless enemy robots to unlock the path forward.\n\nEach level offers a unique blend of action, brain-teasing challenges, and fast-paced platforming, designed to keep you on your toes and immersed in the experience. Whether you're leaping over lava pits, navigating through maze-like structures, or dodging laser-shooting bots, every moment in Pixel Bound is packed with tension and excitement.\n\nUse your reflexes, solve puzzles, and explore hidden secrets as you unravel the mystery behind your digital imprisonment. Will you conquer the code and escape the system, or remain trapped in this pixelated prison forever?\n\nWith immersive VR mechanics and a nostalgic art style, Pixel Bound offers a one-of-a-kind adventure that blends classic gameplay with modern virtual reality.\n\nThe game won't let you go easily\u2014are you ready to beat it at its own game?", "short_description": "Trapped in a retro VR world, you must run, jump, and fight your way through mind-bending puzzles, deadly traps, and ruthless robot foes. Collect coins, conquer levels, and escape the cubic world in this action-packed platformer adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/d8bc5258-060e-4c0d-a192-2d6559f6be6f", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32153080240972580"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2612586382438059"}, {"status": "PUBL
, {"file_name": "Untitled.png", "id": "1843750266346515", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304764_1843750269679848_6154652829589076011_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqJJR5bkwisQ7kNvwEZmZ5r&_nc_oc=Adpokc_VH1-6VsAKyfVsv4-X_XUjxn8lRY9oC9q1TKaGvwmflmJsR-wIL3oqAxJAfzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af14BQD2c9hd71V2KF43r8vTai6uZd1Am0KueNsnGXlBtQ&oe=69F0CB48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium", "keywords": ["Tag", "Taggers"], "long_description": "Opium drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
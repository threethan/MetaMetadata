&_nc_sid=6e7a0a&_nc_ohc=Ih04z9polX4Q7kNvwFkY7x1&_nc_oc=AdqYkrSLL0ectEqiiD-cRoSJ0Pz_U-oH4KJj_BhfGG3dJze9fVRFZ82phXMyk70WvVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wrh56tXadJ8EzFrxKEMicqp80lqfM8OHpJ6AHcrwe0w&oe=6A295377"}, {"file_name": "Untitled.png", "id": "1843750266346515", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304764_1843750269679848_6154652829589076011_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69SpxKFxqM0Q7kNvwEoEyvw&_nc_oc=AdryKy4c-xtQA1sc7DS5rw9HAHhVSAijwtXoe_6fWedhIjSkjI_L3qQ2-pvFdjMSwSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G9p7Bn4e4WWmajP-VXJFi3b5maXUMP2O7swondi_DNw&oe=6A297BC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium", "keywords": ["Tag", "Taggers"], "long_description": "Opium drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "pub
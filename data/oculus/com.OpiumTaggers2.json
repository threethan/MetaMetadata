jPTg&oe=6B0C6954"}, {"file_name": "Untitled.png", "id": "1363831401732773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1363831405066106_3123461630255605957_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QBXfZHMEXQQ7kNvwFIK41O&_nc_oc=Adoia2LOQzA_J5xjp4NgzZ93oPt3Ncm3pU0ri4FQKddY0t8F_kR7L6kSl5FlNZLk97U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKQIv8_fAy6Tz9qf2oXgJhMwGiN_jXAJQJCU0JxFDDxg&oe=6B0C4DB7"}, {"file_name": "Untitled.png", "id": "1843750266346515", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304764_1843750269679848_6154652829589076011_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRoHFXW9EtEQ7kNvwHe0_a7&_nc_oc=AdoPJMsB26Ihyk4KO_WXCsUc1J50csvwf0dTJJExddu2_ii80k8-pH4uPjkVq5-_M64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7KJXJGrBoIIbo3UOhyUfsM8NKs6zL47leROS4dNrsLw&oe=6B0C7608"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium", "keywords": ["Tag", "Taggers"], "long_description": "Opium drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25468862932735992"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307311_859078617042942_5050155897474863783_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27t75s05rFoQ7kNvwHdPIIW&_nc_oc=Ado3Oed4UbCCleK38pMKR5-dfTqNmSy9-7zRMJgpH4hey4tupQMnr-JKz3IR7bMA8oM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-ToxcZNWm-21M8dwIOClP17gBpYotcB41irTKLVty0A&oe=6B0C6AF9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opium", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1768954560, "lastRevision": {"nodes": [{"id": "25436628795959406", "release_t
=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyV2_zHKkWMQ7kNvwH_8Jhd&_nc_oc=Adrs31UnN3xMx6X2N_mzEeRK9-yx2suICvBvcb_8QRVm-nH_R9eMfuqNsw9AlHgEFlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToEI30L0WSnf2l-scKHwTmm2kuSTcGljD9A5GLgDnduA&oe=6AF735B7"}, {"file_name": "Untitled.png", "id": "1843750266346515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304764_1843750269679848_6154652829589076011_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc3xFvr3vFwQ7kNvwFZNzga&_nc_oc=AdpWLLiXrlsMXNMtRwTeJ6PfENwrX4PauLMK19rbiceDeSz9lMrU3xKEuAp50Ox08qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRytIXGHUAwNR_f-soF2vHqaTRRcyKXFsqy_FpXzrJGVg&oe=6AF725C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium", "keywords": ["Tag", "Taggers"], "long_description": "Opium drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url"
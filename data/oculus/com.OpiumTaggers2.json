&_nc_sid=6e7a0a&_nc_ohc=P2I-Ep_4mj8Q7kNvwEN8I1m&_nc_oc=AdqgeJ6JfA28cybMJbkhL9vftz7ZZ_-6Ub0heOGoAwoW57q3S8uyqyXPfSLnpfY_W7I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EhSxOvXWFmAe3XW1dFGIi66Y1QUBa093sMqT3johJCQ&oe=6A1716B7"}, {"file_name": "Untitled.png", "id": "1843750266346515", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304764_1843750269679848_6154652829589076011_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzjkBGhj5VwQ7kNvwFwd-V6&_nc_oc=AdpWZKYMhMYIuaMZ5kE7Ie5aiANNuewa9S3K1jBfXnEdq6slNCVPMsw1Sr8MJ79ynM0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rree1VehaoQXeamVCXdaGoCFewpVo7dxb8tSyhHGxtg&oe=6A1706C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium", "keywords": ["Tag", "Taggers"], "long_description": "Opium drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/15pF0kOy4c9qIKXgblf87xf_XHW3pEpzQ4PyrFCFMZWs/edit?usp=sharing", "developer_terms_of_service_url": null, "pub
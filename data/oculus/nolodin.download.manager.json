832262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654877283_993222120165595_3828269222249312644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GAt1z5b2HUQ7kNvwFqL3nd&_nc_oc=Adp3R2mBs1cRPhncDrkV-ZQfYSR3vz9g-pWCp_u5etGVBJA8JGXVu0W47V_Q7BZQV1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJo4uwrIby0YGkrSD6DLUhsJaJTevPjIJCW-_Dkf_WYw&oe=6AEA14BC"}, {"file_name": "Screenshot2.png", "id": "3041667836022927", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827626_3041667839356260_4727131164771522565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNvdDLrzKTQQ7kNvwEhp_A3&_nc_oc=AdqJJ2FkhX-yr__Vi2t_c8oVgS_IaAahZUqzcmCERQOvXT-Z_HcAe4wXNrWiDfQTjEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGgdpiaki4yB8vOVsomXGvSbj82lwCl1yRsA5JZDD00Q&oe=6AE9E299"}, {"file_name": "Screenshot5.png", "id": "1007583611756521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1007583618423187_4816702641170914588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9ncgzTxpG0Q7kNvwFVCa6P&_nc_oc=AdqHfuy00nBQ8BOoHxbOw5ipp55JcDYXLco7E5CcpXh4FOzN15--aRQqbOmlkEr8Rn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH-id4wk37fdT1shDTNR-gd5rDik_pOhTurrl37-dRQQ&oe=6AEA0942"}, {"file_name": "Screenshot1.png", "id": "933082209784466", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654854429_933082216451132_4347679212942506444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm1Q4o5ApIEQ7kNvwH5aqaN&_nc_oc=AdqYIJYNs3_nW1tavtZsc0QeGQC8zQWXWgDTot1mBDzKComzcAOvJLCdWG1Ag_HVD5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjSqozrnN6gCdg9U9WJFm2eFlpDecMm-y1iPNnBNGL7g&oe=6AE9FCA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nolodin Download Manager", "keywords": [], "long_description": "Nolodin Download Manager is a VR-focused download manager for Meta Quest. It combines a built-in browser, a clean download queue, and practical file management tools in one interface designed for headset use.\n\nKey features:\n- Built-in browser for logging in and accessing download pages\n- Add downloads directly from links or supported browser flows\n- Resumable downloads with background transfer support\n- Live speed, progress, and remaining time indicators\n- Search, sorting, and multi-select actions in the download list\n- File manager for browsing folders and managing downloaded files\n- Download folder selection and cookie management in settings\n- English-first interface with support for additional languages\n\nThe app is built to make large downloads easier to handle in VR, with a clear interface, stable transfers, and controls that stay usable inside the headset.", "short_description": "A VR download manager for Quest with built-in browser login, resumable downloads, file management, sorting, search, and background transfer support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nolodingames.com/quest-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nolodin Games LLC", "support_website_url": null, "website_url": "https://www.nolodingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "pt", "it", "es", "de", "fr", "tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1067149716492539"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "
_nc_ohc=WR_5weQiOzkQ7kNvwHtXZTi&_nc_oc=AdpAARN3YjDfsc8t54EKVZA8czbkxk2eMkxpPr2BeKt_SiBwaQVCo0ctb_igxC29qTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA16y0LKHh1nNy4xy_PmHu3OzwPcJy6mExQIvaAs2IV1A&oe=6A5E1202"}, {"file_name": "Screenshot1.png", "id": "933082209784466", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654854429_933082216451132_4347679212942506444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd-e1YJRZwsQ7kNvwGtMqQc&_nc_oc=AdpEsR35GUJLWaLC4cNBsJnD8lHX_OeMwjF4D22vRYwq2FvHJGpjiYCVgXa4yILP5Lk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJz5Kk_6RiOw4taCZXrJzNhQd58Ro7__Yq5eEgnbjKAg&oe=6A5E0562"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nolodin Download Manager", "keywords": ["download", "manager", "downloadmanager", "file", "browser"], "long_description": "Nolodin Download Manager is a VR-focused download manager for Meta Quest. It combines a built-in browser, a clean download queue, and practical file management tools in one interface designed for headset use.\n\nKey features:\n- Built-in browser for logging in and accessing download pages\n- Add downloads directly from links or supported browser flows\n- Resumable downloads with background transfer support\n- Live speed, progress, and remaining time indicators\n- Search, sorting, and multi-select actions in the download list\n- File manager for browsing folders and managing downloaded files\n- Download folder selection and cookie management in settings\n- English-first interface with support for additional languages\n\nThe app is built to make large downloads easier to handle in VR, with a clear interface, stable transfers, and controls that stay usable inside the headset.", "short_description": "A VR download manager for Quest with built-in browser login, resumable downloads, file management, sorting, search, and background transfer support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nolodingames.com/quest-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nolodin Games LLC", "support_website_url": null, "website_url": "https://www.nolodingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "pt", "it", "es", "de", "fr", "tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1070949672779210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585720338_1345871441063027_5394947036560801432_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nISw0VljQlwQ7kNvwEJrNgg&_nc_oc=AdpfD42MGye1USp1UrNlyxhB6EPYediA6pdrN9uxjdXALwbJ6P9kjaN0_nskj61412I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD64sY2q4nk8E34AdyHNxKL4jwN_7SYIkHngJFnBTjM6g&oe=6A5E1D48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nolodin Download Manager", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1781372220, "lastRevision": {"nodes": [{"id": "1067149729825871", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1067149703159207", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false
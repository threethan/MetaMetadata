IRTV5EZ5T3eXC_OvY3-TfLATY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV20UqG46v_ZNj0m_KPa273s18gLOnQoEQ1HZ6kbPm8w&oe=6B072657"}, {"file_name": "Screenshot5.png", "id": "1007583611756521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1007583618423187_4816702641170914588_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxEOX5JPsp4Q7kNvwFVYfPv&_nc_oc=AdpJmg_AiUZe5tDz0KX42R_IIlQybIE3ETzJNdS4y-cuVeElfM4rxmb22GAFxamQSkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmugh0uJSZDhiJIu9-O0NplFLkIDtUAKR64ioA7OaP-Q&oe=6B070A42"}, {"file_name": "Screenshot1.png", "id": "933082209784466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654854429_933082216451132_4347679212942506444_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsBQVXuY5UkQ7kNvwEVyzFe&_nc_oc=Adp9rEze0t4H752cFHJ4HeT-KxDJ5AG0xMQYQL8wZ1wVv6sx-EAiTMY0CmBAZLCYq1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6kNFo3Y22k7gfXlO4aJ-P5lp4m-PZbsIaC_neOwgAKg&oe=6B06FDA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nolodin Download Manager", "keywords": ["download", "manager", "downloadmanager", "file", "browser"], "long_description": "Nolodin Download Manager is a VR-focused download manager for Meta Quest. It combines a built-in browser, a clean download queue, and practical file management tools in one interface designed for headset use.\n\nKey features:\n- Built-in browser for logging in and accessing download pages\n- Add downloads directly from links or supported browser flows\n- Resumable downloads with background transfer support\n- Live speed, progress, and remaining time indicators\n- Search, sorting, and multi-select actions in the download list\n- File manager for browsing folders and managing downloaded files\n- Download folder selection and cookie management in settings\n- English-first interface with support for additional languages\n\nThe app is built to make large downloads easier to handle in VR, with a clear interface, stable transfers, and controls that stay usable inside the headset.", "short_description": "A VR download manager for Quest with built-in browser login, resumable downloads, file management, sorting, search, and background transfer support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nolodingames.com/quest-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nolodin Games LLC", "support_website_url": null, "website_url": "https://www.nolodingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "pt", "it", "es", "de", "fr", "tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1306102272597281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585720338_1345871441063027_5394947036560801432_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MERUHxx8rXcQ7kNvwE9U_Ju&_nc_oc=Adp-U8AKW1I-0PPF1C20qt9Wn40Erg87iCOodLkj-3B23joQPh_0BUyQG8-72m-nFx4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSywfD1H3NPgQmVhPjHl-bTpC4bAxjHuG0UZHt90GT0JQ&oe=6B071588"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nolodin Download Manager", "platform": "ANDROID_6DOF", "context_category"
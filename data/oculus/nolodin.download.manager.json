 "3041667836022927", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827626_3041667839356260_4727131164771522565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4n1y3nSyMQQ7kNvwG8cV6E&_nc_oc=AdpUYSfhOopjspTVhnFpQjJR2p2mreVtIwwDPt7-_erxfeQjXhyvlU0oXCvAusOE6So&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WCFknPMl30CAFhzlSKXKIB68aZHvl3SFhe7gy1j1u5w&oe=6A451719"}, {"file_name": "Screenshot5.png", "id": "1007583611756521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_1007583618423187_4816702641170914588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqyjJyJQ6vUQ7kNvwEMFOAY&_nc_oc=Adrsu6PnCWiL0VPgOVb8YM7K7I0CLjgZsFKv6QuKmB_HJVt0vdujykJsimsXdSbJRoM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7oHhpaY3m_vwkXADGaVE-U4j0Ms4xd2wL_Svw5eIJrg&oe=6A450582"}, {"file_name": "Screenshot1.png", "id": "933082209784466", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654854429_933082216451132_4347679212942506444_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-WSRXO-dBUQ7kNvwF4hsJi&_nc_oc=AdrQKceG8Q2mjrN2AeWkLk7ef2xKvEfCnodsvzR1i6speSvtxGx7oT8Pqam40QwA03o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ePSY_L657fzFlkdC_tAhpmQM-PvSfoPz6DtMqWH1jCg&oe=6A453122"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nolodin Download Manager", "keywords": [], "long_description": "Nolodin Download Manager is a VR-focused download manager for Meta Quest. It combines a built-in browser, a clean download queue, and practical file management tools in one interface designed for headset use.\n\nKey features:\n- Built-in browser for logging in and accessing download pages\n- Add downloads directly from links or supported browser flows\n- Resumable downloads with background transfer support\n- Live speed, progress, and remaining time indicators\n- Search, sorting, and multi-select actions in the download list\n- File manager for browsing folders and managing downloaded files\n- Download folder selection and cookie management in settings\n- English-first interface with support for additional languages\n\nThe app is built to make large downloads easier to handle in VR, with a clear interface, stable transfers, and controls that stay usable inside the headset.", "short_description": "A VR download manager for Quest with built-in browser login, resumable downloads, file management, sorting, search, and background transfer support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nolodingames.com/quest-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Nolodin Games LLC", "support_website_url": null, "website_url": "https://www.nolodingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "pt", "it", "es", "de", "fr", "tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1067149716492539"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "971725439026131"}]}, "baseline_offer": {"id": "971725439026131"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781372220, "status": "PUBLISHED", "id": "971725439026131"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1068385149702329", "version": "1.0"}, "id": "1442189141260781", "channel_name": "LIVE"}]}, "is_for_oc
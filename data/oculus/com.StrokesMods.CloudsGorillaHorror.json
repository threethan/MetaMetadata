5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFtp73s5utoQ7kNvwH7P4n6&_nc_oc=AdoM0MKisOtMd8yck3DnmfsbKYNUb3Cn4WrWdSYIvYhqFrBQ0UyAAWHT3t-FX7Kwdp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlf_-NMcJ2gfKucSWSGJUCmvWBzkdBxrfvByUOEwD63A&oe=6A510B09"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbqK7sGsEdEQ7kNvwE-G1Nn&_nc_oc=AdoKif33eIRMNzWp_9AnLfvhRARVIYkCGzE5z2Vdm2U7EAWMluaEIdixaMWMkD7IxdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpY3vqmuHjQxU16sTUWook6eqU9t323fcrYeseJR4ebw&oe=6A50E78A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey4QeIsAlfQQ7kNvwGuundw&_nc_oc=AdoZxGt3c8jzgYJKrhjZQQqexKVXXPZUK6NFO6s__AtoEJptpR0CSZSgyduQ084RzTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBEENtME2up9kVXvAM-kz4Uw3w9zG6cCFurZUljHJmuQ&oe=6A50EED1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFW2gE00W0cQ7kNvwHMo14b&_nc_oc=AdoL3ZVQMRWgbGmbOyeRsYaLMA-uVZapuRa-jojyf8FIdhz_OuzWhJPXFWiU9wKTWWM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdV1ptXQ5rTpnZgnkDYGTA99b8M_icDCty_HYW46y-_Q&oe=6A5A4589"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6CqohdzKt8Q7kNvwEqP-4-&_nc_oc=AdqXaWIR2mBCCNtxpKJpPMCIZ6EiKEQ4zfYMvYWrvFafh2MkdV5hr6EklKYMpY2joK0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA16Y09mUsn0Xn_dVDN3XBLd89NQaqHImhW2zso1FDHhQ&oe=6A5A220A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWN_cNU6XvkQ7kNvwEUf_or&_nc_oc=AdqgKZUg8IjWfFBZdr5S1wAp4kFnwTtNk8UzdlT1Ska3iTjgSgRU6VBaZlrgRZctcU0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXJdSPtSIw_nscXVi4Pg1jenb9zhQl4ISwx3E0K20bDw&oe=6A5A2951"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFtp73s5utoQ7kNvwGpcY_5&_nc_oc=AdrijyYhRv0xReNbpuEqLZJAtlb1JDGXnn0_n6NpsgtxDBjEPwCrtOuSG9GKtGlsA54&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1kV3ACxxFYvt0txbkJcUGKVy5BzKGeB2jt56JDrZLdw&oe=6A53AE09"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uAnO19HUNEQ7kNvwHzvJxP&_nc_oc=Ado5Mbh0dGipOWl-WhaY6xYuBACISmS2--Vj7XjJwufRYY0G9EhJxSEQTjD-oonEoqo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-zb_5IRgM6kDSYmxMUbb6hp7Nn4brmjMr411intzxGQ&oe=6A538A8A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey4QeIsAlfQQ7kNvwGIuiJp&_nc_oc=AdqDYDKig78yIKY7W1slaE1bLxr86Da8kqcTo4893Sx_ktbroWWaB0BxGbT0Cf4Z7d0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpx62OfwBZ_Ftf3QW58GYBF2hOTZbUzI4_DlR17-8J1A&oe=6A5391D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
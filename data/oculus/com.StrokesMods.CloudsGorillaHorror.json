5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihKxhbEcTWcQ7kNvwGl9_qI&_nc_oc=Adrb0GlvpZUdl3Gwn1WducOxczgN-H5ZJpY3gPPT7RQxmJ2qKhvMRjjMyf1R412OXUA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrIIH-7EJhQwfnd8J5vJq4iCuvN4P0MU5g2moDodVLiQ&oe=6A54FF89"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uAnO19HUNEQ7kNvwF9dLk5&_nc_oc=AdqQ7hW5zmWg5CDjGVmZjYoAnJVw_LN3zFOEPJ7nau1w2E9kWQ-fyht32FfpTbcW1Ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFPR06DJqRvZovvyHwUCL3ma525tvTC7tCzQvz64HlRw&oe=6A54DC0A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLLsySP-v1sQ7kNvwHzNtdJ&_nc_oc=AdrZZr9jci6sr4ALUxFJZjIvzp1IbastSqyhUJKhpUy9B_LciXLlO8VZEy7vVHU4WQo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlT2AWunhIO4J9InehxVmFOtMWct5BegMaTQKL4CfDVg&oe=6A54E351"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
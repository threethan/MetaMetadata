5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOS5kdGhj0kQ7kNvwH7KAo0&_nc_oc=Adq3IIBCIaLQ9a0MSjJ-ovJrFyGixoEGo6sNpBc_vWagSk9aaKthgWola-lHkE3OGag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4dXbCXTu5oSRlWplWyeidNO4a_So20hPsaPrfFOhnDg&oe=6A4A7389"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_H7Zvg49LKUQ7kNvwHkhV2o&_nc_oc=AdprVd_6LBMzhJUEUoTnjrnJJSCy-HQkchZYytmXdvV4TKYHq27po7spMwexNj0Raco&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjB7QMO-fpkgP-qy0J78BKfQPO6lKTIOuPu17547X5Pg&oe=6A4A500A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3cwpbwTybMQ7kNvwG--2QJ&_nc_oc=AdpZufpbv_JD_I--cc96nZ9GM0o05pfxg0LWtniSufNcsAMLJREwauc8CHNBA6XjRfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWFYhroNxGuMOB_gEceHEZ2HqgZO3lp7I1x9HmFA_s_w&oe=6A4A5751"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
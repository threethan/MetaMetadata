5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLabbzsbg48Q7kNvwF0JObx&_nc_oc=AdonYhqKQOcXc2ERyMjTN5uK9WJ5619OZGZj3c8QsFAto6xqUS1BIPrhep8NkF1MPVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF6uA625K27fUA_4A5D83LgIX6WxaYq_FXoiPuf_76Xw&oe=6A638009"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAz7ZeemZUgQ7kNvwE8Lh-q&_nc_oc=Adpc56AJh_8j_mSZclySIgM9B6Ms19cxbVUld2Arq0MbQcXuNZEJWWQu-uYW88bli54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbDfW1MfR9R2zfOEB4PeCydL2XMDHalIimT_bT359hEw&oe=6A635C8A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5-USJ5pPMIQ7kNvwEEvKaN&_nc_oc=Adp1YALCwMQlt3VAi10fW8izPA25Fc_5eA0pvkYPIBYvHXR68nFYaasxOBg-mL-qzds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl3Ib1PAO2i3qg6cU3dtLVovqW0MdYOkQS4Z43PN1myg&oe=6A6363D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
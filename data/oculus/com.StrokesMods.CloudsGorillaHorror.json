5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihKxhbEcTWcQ7kNvwHraSDD&_nc_oc=Adov3mY7uz6DoPDQMvWKe4BR2Afdv13ZvKX09GzS2a7SxaIUQWEeEu_ABHp0MbiIz_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUvXFzg715y19B7KJ06ftAGZQywDg0c4DWU31HUn5IQA&oe=6A576A49"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6CqohdzKt8Q7kNvwGjLZMY&_nc_oc=AdrmCih9jZBQztYwbB7Wwm1tb0AdQcw-Yb8dTwPcs9xYvVG3w_cTM8SahezYikQXkB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsJcHQT9PF_EEtjhBBAfPRrFZoFVMEMaQbGJsRfze9nQ&oe=6A577F0A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLLsySP-v1sQ7kNvwFD1Dtm&_nc_oc=AdrmdTZv4STmaD8x2TISkQGzOSUJ8iZ-tAJZh1abHycgRaEmbKZzr4ady_wLFSnEvyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFo6pB_v0gh3lh2rNeRv_eyCGx96-0u_JVEENdQLo7Pw&oe=6A578651"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
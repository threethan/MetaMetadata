5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZExlXBrqpnUQ7kNvwEIlkib&_nc_oc=Adpx53BeTFMw8D4pEMsWRcajC5QhvUs6_HwrFL4pBe2Er7Q7Dtwi8ETnJwwRg3UPdXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBamTZStm-DEliIRcctPcdrjwUSqLexVfqfbS4nP3lt-w&oe=6A5F8B89"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEVKhrV9UqcQ7kNvwEzmN7_&_nc_oc=AdrNmQxsgWVGdljT_EGqMk8l4H2O8RAX_gMsGzyXUiNB63a61MREluQKR5-8E19iL24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfpMliXEbgwV_Sp6Z-wd-2pkZ12Uj7lMhXBCatwOr4eA&oe=6A5F680A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHAmcWN8jGYQ7kNvwFcGiNn&_nc_oc=Adpb03p93BMjX9jUH886iiEyqjn1a7ohCFWujPOfw6qjQlYtkzfeN7zEhb3UGXtBT74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBefcNC575TfDyGqw44sSw11CTSVXTDY7JGYEm7EqWWxg&oe=6A5F6F51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
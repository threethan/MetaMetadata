5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trEqaYIqmn4Q7kNvwGitFLe&_nc_oc=Adrj51dE8ZSh664Mf15gN0BVqNJ0gwas5B2fDYgY72uShUN0_KDLKmeU9GJ2MqSLQNo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzpVADSuNGq70-kL7jj_E-Fe9xZ2qu118MuruWbOMBAQ&oe=6A68C609"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbmGIUI7tw8Q7kNvwF_HHAC&_nc_oc=AdrYK2rYg6PACnkfLlWrp7rh1eAK0X_6ejYVyZ0_Xtdd4z2dYvkCO2ATVPC2MZTZJXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4G38x6pG_wI0W22HeHsAt-MFHGpmC80f8L3yhTsnjuA&oe=6A68A28A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G4zAtach2gQ7kNvwEYrkD1&_nc_oc=Adr0vaB5e0CnFckgKVavPyrhI6AfL9ZOZqtaHyZC4-SyRizImyW6-UE7DyraX3ZyJos&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwClFvQL8-T1Psd0krTsVbrckMpzGllWuTMyFThPv_iA&oe=6A68A9D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
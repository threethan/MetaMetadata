5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNu0cUSpHqYQ7kNvwH4x3Aj&_nc_oc=AdpjQq4sa20DXjDkX011j6l9eDh5_Rmmmtm997RwU9f7SCYBY43h6Zpl2Um6oCcUX5g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChMI4b4gM07lcDGB4O5FidABio8MSY55Etk7z6_pnH4w&oe=6A6F5D89"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9TyGxOhgHAQ7kNvwE3_K7t&_nc_oc=AdqalxcO2myEBhSXzr8gLohv7KQZKzikJYM43IHr2HLFbhf42CbaHZwHa7-B5xfT3VU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArDMVgn3WHnGPRs1XG5Wm4PksCcowT-0rYOeH9U_Wz8g&oe=6A6F3A0A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXCQ2NnwwHcQ7kNvwGAfL6n&_nc_oc=Adr_xXSWBgMkWvvF_XtnHKDbgW6Y4RsXUMDij-skwK6LHIypENxmoyKxzAe-wRebBUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCZCJNwIo6dSpBEGLqBJ2YcN1pMO5T1sVqGBSc2f0Irw&oe=6A6F4151"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
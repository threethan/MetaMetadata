5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLabbzsbg48Q7kNvwHtRqD_&_nc_oc=AdreBDQMqwcH77GFP2Ah_-6Uz6F0lgZnHZgRc36-WA1A5pGgRQhVuh8R2HlbBISYi0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQeXQl2feHuQOYLpYLe-vnhR26FqQCdlvkamzTKEv9iw&oe=6A60A4C9"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEVKhrV9UqcQ7kNvwFAITec&_nc_oc=AdqVN97b1sVPQ-ayXI256CwxzsvQQyLJWR0-J6vkUzTwbkjvQ8V7tf8spWREyFYlwDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm0eePpNYFstR-_G-Li4kpXV66N0V5t0Ld6B6fD0jK4Q&oe=6A60B98A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5-USJ5pPMIQ7kNvwHMuWts&_nc_oc=AdocfhZwQj-WHB92VzwOiAKeGB4FV12dMdq4P5AYwMbPayuBd5T5b441eNS2xcMFxCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBCVxw4MenR2o0pq-DumUmAguDkEX0WZwW-5j1N9Ijfg&oe=6A60C0D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
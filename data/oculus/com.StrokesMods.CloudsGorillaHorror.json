5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yN1HfnApbtYQ7kNvwEO1Xpa&_nc_oc=AdpZozTTEwRbGpU79AP-OsrW0h2TGJyS3TXIEGWXw95hEWBuKXk7wAKwkQqog6y6pQI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY6y2RoWgCyle58cUB0vymCxCnaNFUr68d0HUKXDjXRQ&oe=6A65EAC9"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAz7ZeemZUgQ7kNvwELPfH4&_nc_oc=AdrLGSDqDqPhBqd5QJJ9pntbELvTvP9FFW9McS6lVLE4p7DniEtHDkrCQgfGReGm22I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1UVLz1p2sj0p5uDOgEJL88MQg63WmaaEmbfYIjETo2A&oe=6A65FF8A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33BdGP-HVFIQ7kNvwEtkBr1&_nc_oc=AdqjS3zHR_Jzo5hCZhNG3UK3AcL4FXNttC8_ZJGEabpBic6MIlq0KuIILKtnDxBxwxk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn-N1X4CB_1QWjvOTQwYY25ceOy4_6T6fsyfOEoJXhcg&oe=6A6606D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
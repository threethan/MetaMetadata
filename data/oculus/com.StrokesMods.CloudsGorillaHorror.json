5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFW2gE00W0cQ7kNvwHDH_I9&_nc_oc=Adr3vWFeFjExRoRgiPgogp_PjjYaxl-5oIjwZwymiuWxe6igWi2-H4R2IzRyUFSECHs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSg544hSOHDtpZEk-6J9gK6oZKF8uxImXFQgDG7ySj0A&oe=6A58F409"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6CqohdzKt8Q7kNvwG-_Mp1&_nc_oc=AdokLKQv9a-iJ3IoL-S1sCtRbMSmPSCFDcLw8yh_7x0TAeIA-5g8ZOzlbWFG5wPb1yA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLNppHWgpi80dTFtAH_brlg9yO8oPFiZtDWobunJIZwg&oe=6A58D08A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWN_cNU6XvkQ7kNvwFbWd7V&_nc_oc=AdoBGSL0oGtQtIEn4Wxhd9Ka_3dhP8jhRZxitqG6tKAJ3xO2O3TOzTaB3qJFNbuHTJ4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdvmumZANGzFfR8QIwtHHv-n599XmtozDE72AgKsss-Q&oe=6A58D7D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_tOOcy3zzsQ7kNvwH52De3&_nc_oc=AdoOSK6elmWT4O3FYpzMLZ1QY6PZgGnwopvf-kFkDJidpsHLvuf6czaurkc8Polc97Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSA_safs2Zr3RLfMNTrOjEQgx_02ou3gE8Nsu83uyucA&oe=6A4E6809"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g3nuMfnqQQQ7kNvwHEGTEI&_nc_oc=Adp9Sm4glbEFKGhZSxBblY4GYHFmecAK-YlextNPQn-JqTQIwUNN0FGBLG33_YGJ2CM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcQMk2RPNeMK3RIObIns_mpaqCQrjWk9mMOF636IczTw&oe=6A4E448A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2e-jxc4slAQ7kNvwFQF6gl&_nc_oc=AdqH9lh2VJKrJY2hrXjrF24tqbT8jActrIdfBSktQOPHmf_T3FkhfgJcEIYwn0B3sII&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAilRlbkTdIffkz4M4zcpskfCfO4-1Lm13iL_lhU5HJZA&oe=6A4E4BD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
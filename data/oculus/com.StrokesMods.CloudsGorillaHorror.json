5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOS5kdGhj0kQ7kNvwFBeC9G&_nc_oc=AdrCEafbHzgPe-WdYoC-fmNc37Vcc1zGHTWXkvhL5OFFtKUGNX5jV4RYMdkr2oN5lZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLSbfZerPRVEKe0PYcKigoWaoxfAfDwgcLPdxvW9TwIg&oe=6A4BC509"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g3nuMfnqQQQ7kNvwFJWy_q&_nc_oc=Ado072ju_48yf4tx45Wh2Z34idDrFry3i5-vyx0SnMkGXhvndKSLO3Vdnf_qh80KHvo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmZvx88bElRVjk1BsVWv4UpD3obhQgh2o3bj_6UC7xFA&oe=6A4BA18A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3cwpbwTybMQ7kNvwEsrsnv&_nc_oc=Adpq1fHQiJZ8_iweKtdPMnt7qGgtKEJlIOxaaCVe-PK0FMQEh8dK0X7Hv_S7UjslpmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdc0Y1lzBk3jxwkyG_bt-3zEIJ7p-0c-LleZB97Vk2ag&oe=6A4BA8D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
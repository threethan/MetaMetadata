5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trEqaYIqmn4Q7kNvwHzuwCO&_nc_oc=AdqT7HMPyGtq8Hf5GAPVL0Nwz4qQUKOxIM_HPlSU1qNcAABOS3taWUqwnYT_WqfAd9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYlria2Oz2cwTQtvtp79bbj79owb0l4aoB-utGBMq2hQ&oe=6A6B6909"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x37jf9RLPloQ7kNvwGyo2xh&_nc_oc=Adon62wNfAd1y-bf_DH5oPz4Wp59LnDN6TgyWbjdhCMBAemvHdTtbJYb3g-mGNLZ8uM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOGpEZ8TZeQz_aSYKKGG_q9X6kglC9RQ0SPJ6UHyVVeQ&oe=6A6B458A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G4zAtach2gQ7kNvwE6SEw5&_nc_oc=AdrhsJtJxt1XAgLBoLwmBec5C1EgqWU0C04whwUigxY11UNouV2_qGw1lZOTTE37kz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCorN5XhkcwLreOVODqAEzx9Sl0d4QUtIhfJWnEHpsxew&oe=6A6B4CD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
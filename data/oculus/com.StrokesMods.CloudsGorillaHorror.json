5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZExlXBrqpnUQ7kNvwFzna9Y&_nc_oc=AdpMuDFP3r7zXiJnENTZX2HnFjv12Dj3yV9EM6ScijOclr3NxnjB4bMGY_ZjH-BrrEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsAOQubaQ_aOlF0W3hXdQv447AdMDXlquXY9AQysB2Ng&oe=6A5E01C9"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npTxo2ghR6gQ7kNvwHRTipj&_nc_oc=AdpB9eIF-qphaxoj0xxYvJszcdrEkFqGGNDba5AAJJV9ALaVbVw350bTssmo9V7BklI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0GzGYcT2fXyXl0BY1vGOoBBvvvmgoSiMlu98SwFnpQw&oe=6A5E168A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHAmcWN8jGYQ7kNvwEgP6Ep&_nc_oc=AdouppN-VyE6wWg-q9i_GQzwmwTCtnDaFo35C2LmzmyHwwVFEVWsNyRacndAPEURpAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP6jOFia1d8AcAYjh83zm1Z5NzupcHe8wupPTG4uU7aQ&oe=6A5E1DD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
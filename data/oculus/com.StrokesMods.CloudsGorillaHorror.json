5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhO9LSYhhScQ7kNvwEt39Ml&_nc_oc=AdoAgyItwDaOqIeqacYXb7Jq-kxsmA2xX4YB2-NvRB_WWEDidrhdXnF536tZ2ikTK64&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBE3O746rf5-97UWMNtMo5yZfOLe8HydZMc96qVx4uRw&oe=6A720089"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9TyGxOhgHAQ7kNvwH8_dtf&_nc_oc=Adr5DRHtrM9okVWJPjUQViTAs8cUrTY3cym5uj2vT_s3EMsXbJlmsUN9kD8sJ_ZHobk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDETlwudETfQxLFgiKtH817touSLYkDjtnDh69ZB6YAw&oe=6A71DD0A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb90ckIpGFkQ7kNvwGLVLyI&_nc_oc=Adqk7Z0wbd8iE78_1tB2_K0i4DTNkIaPrjdp_llwn5hZW7Xh52juKgbXqGFaqZp6buQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEU5WaZMQ8OsEPOv3HGmy-5vlzf0ABdx6U0lGhp_Svlw&oe=6A71E451"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
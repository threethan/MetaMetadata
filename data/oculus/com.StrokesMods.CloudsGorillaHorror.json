5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNu0cUSpHqYQ7kNvwHkBgKV&_nc_oc=Ado3RpAAhM4w4WyTeDu8jsevrMbJDU6y2nUYS11m653Yg7TB4ZIp0WuQq9xnll8Todo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1qbu3CRiggA8v8tkmE6-_z3WXfcS-ukLgJfO5NZLjUA&oe=6A6CBA89"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x37jf9RLPloQ7kNvwE0fsHb&_nc_oc=Adph26TEQMhPaKqvLvfqv6-5pjf_z5f5jdYMpoerCMLJj6_eHv86TI2P0ky2Mzu2YIw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0nRelX10toSfFH4-iU89QFXmjCTSIoF_Ekg6ltpUa0g&oe=6A6C970A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXCQ2NnwwHcQ7kNvwGE8m1Y&_nc_oc=AdoRueN5c1U9t5TMfcQhBVvbKgcrC7Xd_94pzl52Bc42mlyyKxEPomnvs88PSVWfVpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWZX2iUYbTiR_uz6q8RfLq9FJKk_xBlJHZ3tNa6eylAg&oe=6A6C9E51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
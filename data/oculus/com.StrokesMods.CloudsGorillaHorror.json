5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLabbzsbg48Q7kNvwFS3Zfj&_nc_oc=AdroW1m0OHI_fTp1GEwcmXa0CIt2oi4AcZMnZfFZrx0LI7YgZA5MarFTCEjKolc5swg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXOp_-hJhF5ZDWb2HmR7VUPwBMgZwaGrfNxUkdGnLjwg&oe=6A622E89"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEVKhrV9UqcQ7kNvwEs8qid&_nc_oc=Ado4M0TAjfvlDe7kYTZ0WI0nRyjx0Xvh8sn8o5GWn5M-8VnE1CeWpnMB-VCiWqSKQVc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPLVdQxyYw41gsdUqNynUxSBC09mXkmnwoO5sy_oe2yQ&oe=6A620B0A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5-USJ5pPMIQ7kNvwGhd_Bd&_nc_oc=AdpyS0Qe39H4_kmPuz7j5NWBQY9nakKtyropil87JzU-PqwuP1CNw_XFCVNpraWYdI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6fJS6_DoZL3muKkC_G-GWcLQWKGx9W1S90At2j2rN6w&oe=6A621251"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_tOOcy3zzsQ7kNvwFiN9N6&_nc_oc=AdqJTc-Epe5_t_BNmc0mB-D6PVinY4yMLcZ9qpD3p7oeMsAT3whaSIx1xViRwe31oYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxDeAx2J5EbvbJK8cSqCFcvzPU-ONwSgxPiFExzJ8bLQ&oe=6A4D1689"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g3nuMfnqQQQ7kNvwFuNqCN&_nc_oc=AdojeGAi40_qzkT6nnZm3Xwc8EQ5SIzx8kEGzSUSUqAXFrgBF6WQ1W_26DM_WfyxIcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCybh_yh5c0AupopUIQVnvMJKGkvb7AXbEAbnA-GqwFGQ&oe=6A4CF30A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2e-jxc4slAQ7kNvwGzGYUl&_nc_oc=Adq7Qh53TqPDKFTulIWf4xD3mhViL_7jBl2IKron3pR-1KnKGhh682M71V3fRNidrqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAioo6o31nt2_Xdt6oyENh_1w38JcTx6rgaFcReDHdeAw&oe=6A4CFA51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
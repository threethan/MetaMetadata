5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihKxhbEcTWcQ7kNvwGG9FWV&_nc_oc=AdpYSrtsdTXjaOu9pp5ZzsPzjuPluMfhXpvoXWUztEZnUISFSNn8uT-lL33yrAY_fD0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-xhVhre6jsVC-HAFsK0HrmqZ-psb1mVMDqeVGXXtIfA&oe=6A565109"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uAnO19HUNEQ7kNvwFBA37I&_nc_oc=AdobjaYippBxxKNso5qGr9i8cQNoIWDSz7xZIOAEslXK_aSMsz87cKF9vYThTLDx-p0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4uvnl3yv5arpjB_CwkytERLXXMafXdIOCfMMyJr5a4g&oe=6A562D8A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLLsySP-v1sQ7kNvwFLIvDC&_nc_oc=AdpZXnTesdqjc0wUThCe5Dc72fS7__ovB-WGvS9dxD5tzuVvsheIM1JnXmOl1A6wW28&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAseLIOuK5U_Emracjgg6jGQmgogwpEoGqI_sbibWeb3g&oe=6A5634D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNu0cUSpHqYQ7kNvwG5cgQM&_nc_oc=Adr-E5SesJSWZOjHjdom2YkARstEAbIH_QaWJGAqV9bo8kzuaqFZ96p9f08wfHDSZJQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWzV7p8VlLWnIqmQsxTRPw1VrapEsczr39umTHNw16pw&oe=6A6DD3C9"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x37jf9RLPloQ7kNvwFHAym1&_nc_oc=AdrtRqlsW24fyiuC5aLcPPA8DCSrFHVTF2vM59nyllYEUaJ5O4NZj0NNESr74b8yAEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCfl1PZON8cZdrvXLibCzKokBaN3EstZYtnGa_0WxoMQ&oe=6A6DE88A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXCQ2NnwwHcQ7kNvwFTKkLx&_nc_oc=AdoayyzH4eUicNTIFk_bK_oM9x2qXaT3T-OtFBFA9qR1HlQc5AEzcECUSVuAE9GKAYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuwR9qarJGz4Lx_4YWlIkGKirufA6Ea5N7RLi35JBYNA&oe=6A6DEFD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
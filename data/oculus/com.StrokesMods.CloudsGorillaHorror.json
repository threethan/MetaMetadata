5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFtp73s5utoQ7kNvwGBdy-x&_nc_oc=AdrJJZLgHG_yNW2dtLmWgeEnMSS8UAVFDXMJS480G94ByHc0IldBVnkXo48R2tbN4_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABJhLMfqfmZSf-yBGDBnm7lelTgwGG7mMAyjfTKXfMvQ&oe=6A525C89"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbqK7sGsEdEQ7kNvwGu0cX9&_nc_oc=AdrlGME3hMRqXDql2HT_rqmm5rC9nzKgp2BwGZVZZV7j7bbuC2TR8I0Vq-UdGMoIqSk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu2uiZRFA9LPUHlbtcj76mPLEPrfUOT5SmhG0T8w8DYQ&oe=6A52390A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey4QeIsAlfQQ7kNvwF90t7L&_nc_oc=AdpB8KMyp3Ck-lvVaBK_zHMSvjTL4wwZV6yF9zhXbjLRoBzL-xuTAnC-HGzRyUXbsiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvg_x0a3TDClsA4ivwmJYo4dlvR-0AES6SKhP5TuQvbg&oe=6A524051"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6-HnnJ13WsQ7kNvwFkjI3c&_nc_oc=Adr5BawfpJR9EYqvlAQ-MMSZ0X8CGGplSMLPvbo5t6tJoe0u4y-gzWY0fVWWryWnhFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQsd7dYKmXOSv1f0P9z2p4N2DWUIZ0fq_kks5Rw2CltQ&oe=6A770E49"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxOSEkvNDAQQ7kNvwFayFTO&_nc_oc=AdrLnDhFxwWZM5yj8T7yuDrZtwpZmDamxYrypC7rSfhT2znLk3OEbHJ2fJnXgqCpfM0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMH0cy-0JUJsve51C5e42ecIzlIdxaYKVl2q2vizbyRw&oe=6A77230A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8xYtHqwnt8Q7kNvwEnlEPa&_nc_oc=AdqFkUVa2sUkNIPo6sMa3zY-80cYBMKR79RXdynWzkRGUPeN6eccPoZsTZlv6FONoeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWduhwvPMguJ51_-r62rULmg0-XDTfWmwvDJBnwaQsDg&oe=6A772A51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
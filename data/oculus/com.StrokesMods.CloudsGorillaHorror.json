5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhO9LSYhhScQ7kNvwFxbh98&_nc_oc=Adr6x6GSqQU2_D55Ubh9FP9KPbU5Bk10e-BfQ0JpJh6v-nAhgUvoK1ZdXxPCoWpltqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJkMZt6xZ2YaEK_AVxgw7Vi9DPM5B9QE1lGKJGI05PZw&oe=6A7076C9"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9TyGxOhgHAQ7kNvwEurQK6&_nc_oc=Adp8EKsB6PSpqb3CfXzcobWeWSoDlA_j0Gr-ADDREFVrMW9E3SMk13oONUSgXpttN9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvvqPCnEFGc1thW-LhcLEbYQfwr_ACduNGfPDMVQndVw&oe=6A708B8A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb90ckIpGFkQ7kNvwHKslPY&_nc_oc=AdrRp2elL8RmfHz78UHpPXiBS3gwMBAisCJDxjBRJ0tvE5ubniUuqi_yGH2GoTRo7h0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETvD62-tmEHb3IZOVdEL1FluHraxievuQzmnYQbKaD3w&oe=6A7092D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_tOOcy3zzsQ7kNvwFIJQPY&_nc_oc=AdroX9Z4Nkt9Yr6T5y1zsOuEQs6HvFOhEqAt6UMNXUK6rDuql9HDdunCztV01H8kpn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmx1wjMPLEkj_8IOAKs5tYhL2N-k8BmN8Hv_9VfPOZIQ&oe=6A4FB989"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbqK7sGsEdEQ7kNvwHt5nGR&_nc_oc=AdpphXub1Ss-3FV5cVvlvKSUpOxlLd-Q_WyfyK_n7n6d3QtI0p52T8CEWOBM6kjvdKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdcrkYrpNGf5s3M3bswlpI6KRvcB8WgGnjXJXNoRdrvg&oe=6A4F960A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2e-jxc4slAQ7kNvwELsFwp&_nc_oc=Adp8HEcFtg2T1gXmy_KxJlARRvEu9Zb4TxdBprcbQQ7RQVJly-fhhGLjirAVpDZt-aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcmmXdnCkhSfLrclWwdR7saXiQ1UqHCeNRL8-XSP2IDA&oe=6A4F9D51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
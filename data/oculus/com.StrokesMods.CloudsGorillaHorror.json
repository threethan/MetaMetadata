5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yN1HfnApbtYQ7kNvwGw-_fS&_nc_oc=Adrk8cgIYVs5Xow2Q1fP4b7JlFDBjUwrEx6MLOMpsnciq8QaF83vkFl6HMwdeh1Wijk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBplMFYNNvwA0T4VHu7X9rnVXoyRrXVsMoinKo87jB7A&oe=6A64D189"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAz7ZeemZUgQ7kNvwH4hL8S&_nc_oc=AdqiGfofZ54fsiY_vLsKs1JsOXFpTCJWylsw0o7uCpij6QtSwqAlbuNxyMjifTm6ShE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpQEeA3JKuFr1qp_E64QSpCR52-ombfGJX-VamKVGC5w&oe=6A64AE0A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33BdGP-HVFIQ7kNvwFzWsUz&_nc_oc=AdqMdBhYmAdjCYB0cEhHdAq7OM73ePw98iZlGg2ZLzyFFkQuIq0VUkcssX-mD2tCnVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaxftzKqmGiimlfcaKV-whIYB3_c3bjGhLb5grHPjH-g&oe=6A64B551"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
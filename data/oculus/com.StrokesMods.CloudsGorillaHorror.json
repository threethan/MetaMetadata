5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhO9LSYhhScQ7kNvwE-FpOn&_nc_oc=Ado60dBAUDWEkwhZY1mrZg7K3jshxyK5ebKQE6OxqCWMfzUnI52eaeYlx0cy_vtxnnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH8JHV1RLM7hLiFD3guBWJH0CbxZslQXaErqArDWz-Yg&oe=6A735209"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKnTN_rNldEQ7kNvwH0i2ay&_nc_oc=AdoQvJeRPHTcCxK-Ov5-EBpgWru5nzFiuIdJZLyCgV0FWkcYjiiDIcxSXdERRsNSi4Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFub5N8o-xI3a-taoe67o4XDj3joUU1_iudOtUTHALhqw&oe=6A732E8A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wb90ckIpGFkQ7kNvwHI3ZBv&_nc_oc=AdqiiDT8hlMn2LBmqKo4740lYRjdmZZKRAtpV9r6O5sxdsWVa6p0YdibhtX05_qhOGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMfXXES0T1xb4Wm_aiZWLvL0LLLvHSxALFmUP0Ifd2Cg&oe=6A7335D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
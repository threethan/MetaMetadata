5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZExlXBrqpnUQ7kNvwF9EB47&_nc_oc=Adq7SINcQ8mDVexRf18-Ew4iwRwF1lR5DqwgEol13vLtOG1LoWs-hNvorlO3iCsg31U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5ozPZaqhxHhQv6OjfqCfv4Bd3iMy4rxt5zC7r9njrXw&oe=6A5CB049"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npTxo2ghR6gQ7kNvwEHjVHC&_nc_oc=AdpWnSvsjfUN_i3_TpX-_F6VvV_yuHp7O2y2u4N6TQTOJxLY9tQ8yh2I2PjnN_8Qm2Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbCD4eueNxm4oOsCk-H0SVhSukt3DYiiVaIFENy1asGA&oe=6A5CC50A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHAmcWN8jGYQ7kNvwFHO1zJ&_nc_oc=AdpHRGwYc1eKVRVdj2AOjr2aqcHNDoPj7ekBFNm7CyfYHCg3sF0uZPYsn5pOQP1lR1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA86KD6mVipBrB5_H_qjEr7s46hxxjEuuQYYvm8FExnAw&oe=6A5CCC51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fz-WlQ3wDfIQ7kNvwHnVN6G&_nc_oc=AdoPeaHrEEfKl4chl3BEexqUuZyb-rhYEm_83ftluyjop_lHHze_wb46p6XSDNa92o0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMaz-VUlEJrF0tH8pqhGXhkqUZUE5Ev1n6ZFcunLF4IA&oe=6A789809"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxOSEkvNDAQQ7kNvwEb90Gx&_nc_oc=AdqL1pwe5we7CS5dsBPTlQYQCESQF2hA6aXSNdVWbly1pUxxNtsapk_wlp7HuU4j2nY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1w9IDhySw8NtahexKq7B0R4nWgAQhtZ0nwGj2M7-fqA&oe=6A78748A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L1utWnN2j8Q7kNvwHfDqNc&_nc_oc=AdoFF1cuOWjOh4xp_mT2cBISvWMe-nYoh-PfOLngaDH17OjaYfMj6OjygS6zNJMmeZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlj8p4_YU6a5V_Z892dqjXh8FUIK93LDP0AH-aHl5gKg&oe=6A787BD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
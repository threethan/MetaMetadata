5/499622276_1016517384407676_2682612645043049522_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFW2gE00W0cQ7kNvwHTT6Ua&_nc_oc=AdqcSJlYWfIPbadQ8yvquTa8Ir3gcbRhYj2g8Ms1Jd9psaP8FsmODSL-UuXG3wQtVhE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz_g8DDUwu4CosXW6Ks-mSy7ba0lwRpaFGBuzd-Qa5sg&oe=6A5B5EC9"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-25.png", "id": "4440936446180786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_4440936449514119_2922324192043603799_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npTxo2ghR6gQ7kNvwF7-d7s&_nc_oc=Adp9aFtqDzZS8U4BErsbjnCt-psXfRcL3iZ2mF2ikIQtftOntqQqmpmMPsQ0LOM5s1k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAapgjeYHdift7n_sF6i0wkejxYi3abSyeovtro_qXJYA&oe=6A5B738A"}, {"file_name": "Main_Scene_1440p_27.06.2026_17-35-47.png", "id": "1520599486135399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_1520599489468732_7356881262572912590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWN_cNU6XvkQ7kNvwFbbMKc&_nc_oc=Adotwawpkfl6kovw1f2ueknRNR88ZjU19q2muTSxMeNW8T--b92SBqrWZxheNXHQ8yA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQP_-_Qp4ZHGOULzOmGkulawXmXQNh6q2LOFb7o4Qe_A&oe=6A5B7AD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stroke Company", "keywords": ["Stroke", "Company"], "long_description": "# It\u2019s just another monkey game? No.\n\nWelcome to **Stroke Company**, run, climb, and explore while searching for scrap to buy new items, and supercharge your experience.\n\nEscape terrifying monsters, survive with friends, and hang out in the shop between runs. Whether you\u2019re collecting, customizing, or just messing around, there\u2019s always something to do.\n\nClarification: The Watcher shown in our cover art may look similar to AC\u2019s version, but ours is separate and was remodeled from scratch.\n{2050964682164718}\n{946923195045905}", "short_description": "Welcome to Str
owwRjViM-IdcSQhAw&oe=6AE89ED4"}, {"file_name": "soundwall_170_1_full.png", "id": "1610644434087924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619059_1610644437421257_8582307020243195244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdB02929xOgQ7kNvwGj4bY_&_nc_oc=Adoj5EICfNRvEVcPWhAEtuRO4tM0T8E3AK9__YC8bm3VVS4blnGWMSNtdgMuvV4HacM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuxsqTt_vVka52h1juiCgN1E7odyXkHRGgkFovXnybZA&oe=6AE8B21D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560.png", "id": "1085734960730907", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623131_1085734964064240_6895039401729948624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_VVa-88eFQQ7kNvwFKj36o&_nc_oc=AdoKhLuv5fzLF0Iim8RSNX_Cv-X1Sb-q_0O5l73kKYhDH8yV5I9jVx1i3j4ZGNMQjqU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlUbHNM1RygcJWDm0-6JO9wI7AoAxlYhW5rm6-inX75g&oe=6AE89E81"}, "display_name": "Soundwall", "keywords": ["music", "MIDI", "drums", "synthesizer", "sequencer"], "long_description": "Some music software makes you feel like an engineer. Soundwall makes you feel like a player.\n\nIt's a small studio floating around you in neon. A step sequencer you punch\npatterns into, a drum kit you reach out and hit, samplers, four tracks to\nlayer up, and a mixdown at the end. All of it in arm's reach.\n\n# WHAT'S INSIDE\n\n- Seven-voice drum sequencer, 16 steps, pattern slots\n- A drum kit arced around you, played by hand\n- Four tracks of audio recording, looping and chaining\n- Samplers, synth voices, a tempo-locked clock\n- USB MIDI keyboard support with mapping and a live MIDI log\n- Mic input \u2014 sing or record into a track or sampler\n- Save, reload, mix down to a WAV in your Music folder\n\n# WHAT IT ISN'T\n\nNot Logic or Ableton in VR, and not trying to be. There are full DAWs on Quest if that's what you need. No plugins, no waveform surgery, no MIDI import or export (yet), four tracks. This is an instrument first and a studio second.\n\n# HARDWARE\n\nIt all plays with just your controllers. A USB MIDI keyboard adds a panel with mapping and a live MIDI log \u2014 the same synth plays off the walls without one. A USB mic lets you record external instruments, which the built-in mic can't. Tested with the Akai MPK Mini, Roland A-49 and UMIK-1.\n\n# TALK TO ME\n\nThere's only one rabbit in this warren, and he reads everything. Ideas, bugs, or \"how do I do this?\"\nhello@rabbitholesolutions.ca\n\nOpen-source licenses: https://rabbitholesolutions.ca/soundwall/licenses/", "short_description": "Soundwall is a music studio you play like an instrument. Carry an idea from the first loop to a finished mixdown without leaving the room;  punch in drum patterns, play synths, record layers, mix it down to a WAV you can keep.\n\nIt isn't a full DAW and doesn't try to be. It's built for expression and speed: sit down, and you're playing something in under a minute."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rabbitholesolutions.ca/privacy/soundwall/", "developer_terms_of_service_url": null, "publisher_name": "Rabbit Hole Solutions Inc", "support_website_url": null, "website_url": "https://rabbitholesolutions.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1332233696643976"}, "review_me
_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkVIbTYMh3wZimU0BFAb-TOXMwaHNhX2c5657YGB8tlA&oe=6AE88F77"}, {"file_name": "soundwall_109_1_full.png", "id": "880578101512482", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619113_880578104845815_6146074888189291465_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrDx5jN9N-kQ7kNvwEZhIMH&_nc_oc=Adp5JLcZ7LYvc8cddoBGFFKXvwMqPuoCSMlU3WepPDCuBSrQBatuHjhk444AiHvnL9c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2c2RnSSAc4XA9EoWwizHZtCwFdWkiRKp7xFugemm5Mw&oe=6AE8B6FC"}, {"file_name": "05_midi-map-and-sample-slots.png", "id": "1379529860981985", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623345_1379529867648651_4836138374889478454_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNRim3cIZaAQ7kNvwF4snvd&_nc_oc=AdrANDfFiu1v66pRyIPYZrMv8Vutn832k5hafKKF44tO3jMQtUNCK0qp0qqa3OdTkd0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa1ISPe1p2D7iWx1vrzVA-xLSs2_3ScUMhj2jRLFpKnw&oe=6AE8BEEE"}, {"file_name": "06_mixdown-and-compression.png", "id": "1087449993796124", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620504_1087449997129457_5235956971435980002_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnvmha8s7k4Q7kNvwGi4KVP&_nc_oc=AdpcGSmjgXLDMJ2RxcTjTeJ8MJy5n8ZryZTgEbFMKeodZfEPpuqkkCzb2DY6f3xmTVk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-K597jzqYrtYAj1AFnO00QU7bMFy54le9eiglY6fZUw&oe=6AE8C10D"}, {"file_name": "07_drum-kit.png", "id": "1037651055574729", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_1037651058908062_3573813445616276920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zyo-g5CYHt8Q7kNvwEtppkA&_nc_oc=AdrrPcueYDDESN-C4d3E-S2aGJ4bccoN1oZXkVnaLVmYW_lTbWcMPTSitBDfzUcJTRM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB-lHgn5pTnyJdrh4bz7Muf5oRzemwJsznMsYXCqyYlA&oe=6AE8BC77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_sequencer-wall-loops-recording.png", "id": "1766642051177360", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622919_1766642054510693_7471524380850288265_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpcUYG2g2t8Q7kNvwFE-sLS&_nc_oc=AdoblrjAkc810LzgW38DWtcL8urVnAZP5Ncfv_i6AtzN-EQm86x5j_UdTRkkOY7biuA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyVMcous5OfxjB7E-VR5-NQkd18eRRHtMvxiMSoSEMAg&oe=6AE8C1B0"}, "display_name": "Soundwall", "keywords": ["music", "MIDI", "drums", "synthesizer", "sequencer"], "long_description": "Some music software makes you feel like an engineer. Soundwall makes you feel like a player.\n\nIt's a small studio floating around you in neon. A step sequencer you punch\npatterns into, a drum kit you reach out and hit, samplers, four tracks to\nlayer up, and a mixdown at the end. All of it in arm's reach.\n\n# WHAT'S INSIDE\n\n- Seven-voice drum sequencer, 16 steps, pattern slots\n- A drum kit arced around you, played by hand\n- Four tracks of audio recording, looping and chaining\n- Samplers, synth voices, a tempo-locked clock\n- USB MIDI keyboard support with mapping and a live MIDI log\n- Mic input \u2014 sing or record into a track or sampler\n- Save, reload, mix down to a WAV in your Music folder\n\n# WHAT IT ISN'T\n\nNot Logic or Ableton in VR, and not trying to be. There are full DAWs on Quest if that's what you need. No plugins, no waveform surgery, no MIDI import or export (yet), four tracks. This is an instrument first and a studio second.\n\n# HARDWARE\n\nIt all plays with just your controllers. A USB MIDI keyboard adds a panel with mapping and a live MIDI log \u2014 the same synth plays off the walls without one. A USB mic lets you record external instruments, which the built-in mic can't. Tested with the Akai MPK Mini, Roland A-49 and UMIK-1.\n\n# TALK TO ME\n\nThere's only one rabbit in this warren, and he reads everything. Ideas, bugs, or \"how do I do this?\"\nhello@rabbitholesolutions.ca", "short_description": "Soundwall is a music studio you play like an instrument. Carry an idea from the first loop to a finished mixdown without leaving the room \u2014 punch in drum patterns, play synths, record layers, mix it down to a WAV you can keep.\n\nIt isn't a full DAW and doesn't try to be. It's built for expression and speed: sit down, and you're playing something in under a minute."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rabbitholesolutions.ca/privacy/soundwall/", "developer_terms_of_service_url": null, "publisher_name": "Rabbit Hole Solutions Inc", "support_website_url": null, "website_url": "https://rabbitholesolutions.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1194084440458903"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1054775007103202"}]}, "baseline_offer": {"id": "1054775007103202"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786751280, "status": "PUBLISHED", "id": "1054775007103202"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1332229289977750", "version": "1.1.1"}, "id": "2625982197850348", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1194084427125571", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1332229289977750"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2625982197850348"}]}, "change_log": "Adds third-party license notices", "created_date": 1792518420, "id": "1332229289977750", "version": "1.1.1", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1194084427125571", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1332229289977750"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2625982197850348"}]}, "change_log": "Version 1.1: a calmer, deeper Soundwall.\r\n\r\n- A cleaner main view: every control on its own card, easier to aim at, with tooltips\r\n- New rooms above and below you: SYNTH for sound design, MIX for mixing\r\n- Two tempo-locked LFOs: pull a cable onto a control and it moves\r\n- A mixer strip for every sound, with shared reverb and echo sends and clip lights\r\n- Set the song's key; scales and chord moods follow it\r\n- The MIDI keyboard gets a full synth of its own, with low-pass and high-pass filters\r\n- An extra octave at the top of the walls\r\n- A master fader on the mixer\r\n- Plus a pile of fixes: loops no longer drift behind the drums in long sessions, and no more clicks when an LFO sweeps the detune\r\n\r\nTell me what you make: hello@rabbitholesolutions.ca", "created_date": 1791496261, "id": "1311732202027459", "version": "1.1", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": 
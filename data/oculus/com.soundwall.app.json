dn.com&_nc_ss=7f20f&oh=00_AQIobimSvaTFhKCKRFPY8_JCWZjvD3HeUUzzYf51KkGZVA&oe=6AB54287"}, {"file_name": "hero_3000x900.png", "id": "932560832490188", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622211_932560835823521_4178099102829731506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEkO7TxRRbgQ7kNvwGBh4a3&_nc_oc=AdqUUecCdDdxMWwTuP5cFV618NEiUlTv9CmkEq9tYN5obcUgnWDkYQnehqnE0TuQnm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4FBq1FzQNyjxnxNKZYRWzPmCtw1mjaN93dBex6286OA&oe=6AB54775"}]}, "id": "1306978324842834", "locale": "en_US", "screenshots": [{"file_name": "soundwall_65_1_full.png", "id": "1343916191240889", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604282317_1343916194574222_6905156603523931683_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U4YabSQe4QQ7kNvwFMUrbq&_nc_oc=Adq3Xs8O-566xgvsCeg3QJxR_Pq-A2G8DEMWVDSVAFabV_7NT6y82SfkVSyukq2vyPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFaMTcSGAEvgJ7HHxWRROMp-t7yq4zEzgvTjWGPc8r9Q&oe=6AB524F7"}, {"file_name": "soundwall_109_1_full.png", "id": "880578101512482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_880578104845815_6146074888189291465_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihSP8tf0zEEQ7kNvwHmSRID&_nc_oc=Ado-Wbk4p-G3hQs1SZPC2i7dsueywnayW6JJwEMJZiWicsf8VyJKPEM_K-ZdDyQgiPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIAkIAE2dc2VzDEQCXkOoHJG-4I20h6oK77ybtIOCfFw&oe=6AB54C7C"}, {"file_name": "05_midi-map-and-sample-slots.png", "id": "1379529860981985", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623345_1379529867648651_4836138374889478454_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvMLSz-ilLIQ7kNvwGhJ8Og&_nc_oc=Adr0O9yLb1ohyo5zqcJOXOjRahWcZPJSvKoByn-6zxVUToHeDP_IdqlwHi6LccM-ZXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoe8cGVM9MmI7WlEqKJdNm-V-DJMzmbTvdVcaX92dK8Q&oe=6AB51C2E"}, {"file_name": "06_mixdown-and-compression.png", "id": "1087449993796124", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_1087449997129457_5235956971435980002_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6F__TqhGhwQ7kNvwG7ABqh&_nc_oc=AdpJHnwZjXXNut2inZuURXbBbjgC48QyCWEamOWx0Hl23KSwrtfRnSifKdyrpcOJNHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtDwj8oC-mbHVBGXv9-yCLUZBBPCYy3oaazGTDNWUXrA&oe=6AB51E4D"}, {"file_name": "07_drum-kit.png", "id": "1037651055574729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1037651058908062_3573813445616276920_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foxeJi62a_UQ7kNvwG57ypf&_nc_oc=AdpxkTQTsLGQ19w7Ja4TW1RXq-Gkd6yGOgllW7YtskCsH97WzrOFAvPlv8JCfxcLbWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlrfmLOuKfY4TD5CbzTdqFwqADUyyWSIVw3beZ0__Xdw&oe=6AB519B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_sequencer-wall-loops-recording.png", "id": "1766642051177360", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622919_1766642054510693_7471524380850288265_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5RwSMPRsuYQ7kNvwG6njzP&_nc_oc=AdptjOgiZ4UscrPt15b7EIjHyrTk6Il6Y-DvIEEi4cL8BV5T_i6qeIyDFyZkelPmZsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqGqPs5tkJL_xA4i_DubEhK-MbKi6Y2ULcu7_SEypnVg&oe=6AB51EF0"}, "display_name": "Soundwall", "keywords": ["music", "MIDI", "drums", "synthesizer", "sequencer"], "long_description": "Some music software makes you feel like an engineer. Soundwall makes you feel like a player.\n\nIt's a small studio floating around you in neon. A step sequencer you punch\npatterns into, a drum kit you reach out and hit, samplers, four tracks to\nlayer up, and a mixdown at the end. All of it in arm's reach.\n\n# WHAT'S INSIDE\n\n- Seven-voice drum sequencer, 16 steps, pattern slots\n- A drum kit arced around you, played by hand\n- Four tracks of audio recording, looping and chaining\n- Samplers, synth voices, a tempo-locked clock\n- USB MIDI keyboard support with mapping and a live MIDI log\n- Mic input \u2014 sing or record into a track or sampler\n- Save, reload, mix down to a WAV in your Music folder\n\n# WHAT IT ISN'T\n\nNot Logic or Ableton in VR, and not trying to be. There are full DAWs on Quest if that's what you need. No plugins, no waveform surgery, no MIDI import or export (yet), four tracks. This is an instrument first and a studio second.\n\n# HARDWARE\n\nIt all plays with just your controllers. A USB MIDI keyboard adds a panel with mapping and a live MIDI log \u2014 the same synth plays off the walls without one. A USB mic lets you record external instruments, which the built-in mic can't. Tested with the Akai MPK Mini, Roland A-49 and UMIK-1.\n\n# TALK TO ME\n\nThere's only one rabbit in this warren, and he reads everything. Ideas, bugs, or \"how do I do this?\"\nhello@rabbitholesolutions.ca", "short_description": "Soundwall is a music studio you play like an instrument. Carry an idea from the first loop to a finished mixdown without leaving the room \u2014 punch in drum patterns, play synths, record layers, mix it down to a WAV you can keep.\n\nIt isn't a full DAW and doesn't try to be. It's built for expression and speed: sit down, and you're playing something in under a minute."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rabbitholesolutions.ca/privacy/soundwall/", "developer_terms_of_service_url": null, "publisher_name": "Rabbit Hole Solutions Inc", "support_website_url": null, "website_url": "https://rabbitholesolutions.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "reco
nc_sid=6e7a0a&_nc_ohc=V31jhVUd9SIQ7kNvwH48ZW6&_nc_oc=Ado0ZPHkHnd5SWjJooK3TYixIjEqAEGpXrB5-4MbYyZ59wjM01SJY2BSn8KZO4cOgUc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uDZ_MORac6Go8JRraXZQeOFowAYqwiLTPQWbCkPGcOQ&oe=6A3D52F7"}, {"file_name": "migrated_image.png", "id": "674079116711700", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031431_264034294278456_3042189141790949376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JwPWkxvcqkQ7kNvwGom5zm&_nc_oc=AdpOi8vgErKeLHHx9-4SK3foy4HFbiWfoRg-lC-rEuJJLVf3D4IebWf5yYlpa05MWng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88vt20zB-1nKYk0o7ezWp2aM6sIdqVcKehGGjTN5rvjw&oe=6A3D28F2"}, {"file_name": "migrated_image.png", "id": "251183879606497", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982609_274166576577195_7570789563338063872_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C73GxcQkJI4Q7kNvwF4fKKh&_nc_oc=Adrf0ftZXAT_1ldJ0bkS4FO94p3wfFaYpQB8HNZPbWiAdFmwnKYUXIddVDbuyLcSH1U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E_5w_o770W0oqjrl4YV7R6OA2rxiw7Hd2kJZjIn5moA&oe=6A3D59E4"}, {"file_name": "migrated_image.png", "id": "169783093985398", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974551_206067280337835_8233077063729283072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP461Yq3SOgQ7kNvwHUurfM&_nc_oc=AdoI4R-DCafQLjaf78if9fu-9Lq7k4xIjB3jKE9bIg8hvAWdTgq1KNFyMwOjUxkuhwE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CPlgzQoVPJdDFDix9UKVBlGf6IhqakO6iG00YV3urog&oe=6A3D3EE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Power Solitaire VR", "keywords": ["Solitaire", "Klondike", "Cards", "Cardgame", "Virtualreality"], "long_description": "Not your mother\u2019s solitaire! Power Solitaire VR is solitaire but with a twist! In its unique online social multiplayer mode (with live voice chat) place your cards onto anyone's piles, if you can beat them to it. The action escalates quickly, becoming fast and competitive. Of course, you can also play regular relaxing solitaire alone.\n\nFeatures:\n* Play single-player regular Klondike solitaire.\n* Competitive Power Solitaire mode - you versus a robot.\n* Multiplayer Power Solitaire mode - live with others on the Internet, with voice chat. \n* Can play with users on other platforms and various VR devices.\n* Easily configure play area for personal size and comfort.\n* Fun VR surprises and interactive playfulness throughout!\n* Upgrade to Premium version for additional features and disable advertising.\n* This is a seated (or standing) VR experience.\n\nA VR game the whole family already knows how to play!", "short_description": "Power Solitaire VR is a groundbreaking version of the Klondike solitaire card game that introduces unique game play only possible in Virtual Reality. Play alone, against an intelligent robot, or live multiplayer with others online. It's a social VR game the whole family already knows how to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parkerhill.com/", "developer_terms_of_service_url": "http://www.parkerhill.com/", "publisher_name": "Parkerhill Reality Labs", "support_website_url": null, "website_url": "https://www.facebook.com/powersolitairevr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "306068018209784"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.
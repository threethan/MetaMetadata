WuKedNSo58EQpksDw8Pvh0Enf4eZStDRAkCXMgzdUxXRC7IDKDUw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZpSr1GbA3YEf0Vk7Mj3ZufVjI-oLHV-hh7RNlFJVBhQ&oe=6A884037"}, {"file_name": "migrated_image.png", "id": "230196411493337", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982609_274166576577195_7570789563338063872_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAWP7b7H9-sQ7kNvwEGyGy7&_nc_oc=AdoEfAR4nwHDxLXRTe4rz4i6XYJTzaw5ZagYPzyrrbBaDMgc1gYgTvHUpsDpuwXGPEo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuuJelflDbnKWe0NPYjMIJdKwIOgPIUKekv7GxU9TBjQ&oe=6A884724"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/54rTcF", "id": "2156484307952068", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974679_2156484311285401_315404612758667264_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7DpKdCH3rIQ7kNvwF7Qfe3&_nc_oc=Adps6GlQm91r89GsTtNIP-aNeARdQe4gZNRFQsZR14VhgnrzXNGBSXKYuDeWMlEUgLg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiEr7imeP_NbxOT8MmO2EpPU9WnQFfDPI7ms3IAvKZ6Q&oe=6A885052"}, "display_name": "Power Solitaire VR", "keywords": ["Solitaire", "Klondike", "Cards", "Cardgame", "Virtualreality"], "long_description": "Standard solitaire card games are fun, relaxing and a great office time-waster. Multi-player Power Solitaire VR is not so mellow or relaxing. Players are connected over the Internet and play in a shared virtual room. Each player can see the play table with their own and everyone else\u2019s cards. Gameplay starts like normal single-person solitaire, you work your tableau piles, building columns down in alternate colors. Aces should be placed in the common foundation pile area, starting a new foundation pile, adding cards, building up to a King of that suit. In multiuser Power Solitaire VR the action escalates quickly, as any player can play their cards onto any other players' foundation pile becoming fast and competitive. Of course, you can play by yourself too, if you want.", "short_description": "Power Solitaire VR is a fast-paced multiplayer variation of the Klondike Solitaire card game where you compete to finish first. Played in virtual reality, it\u2019s fast, it\u2019s competitive, it\u2019s immersive, it\u2019s social, and it\u2019s a ton of fun! Power Solitaire VR is played by multiple players wearing virtual reality headsets."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parkerhill.com/", "developer_terms_of_service_url": "http://www.parkerhill.com/", "publisher_name": "Parkerhill Reality Labs", "support_website_url": null, "website_url": "https://www.facebook.com/powersolitairevr/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "477828853994839"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2753276258034401", "version": "2.0"}, "id": "1833320100255220", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1482943268401046", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2753276258034401"}, "release_status": "RELEASED
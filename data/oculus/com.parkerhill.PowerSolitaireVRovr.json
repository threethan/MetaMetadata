nc_sid=6e7a0a&_nc_ohc=7LuOoRu5jgsQ7kNvwHYbGm_&_nc_oc=AdomgBlasMrgrJzppVzPvqO3hpAf3NHdED0aChzAyWGakYWe7tg01JIDC6bKvSM7T2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcnnItxje4Ede09-_WsBAkQzFaphIO7X1Z7--8tOL7xw&oe=6AB93FF7"}, {"file_name": "migrated_image.png", "id": "674079116711700", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031431_264034294278456_3042189141790949376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cih0Za85MpkQ7kNvwGhec7B&_nc_oc=Adot1ZXTdSTqlCR0_2VTLHu7DpEcnibq8zVuy3IrU0lrWg_9yeNS1crGNnGHRLqsbw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyySLoQ4XPDL2fo4kELq2cDlhCwdQv1sZwjcwGQvNinQ&oe=6AB915F2"}, {"file_name": "migrated_image.png", "id": "251183879606497", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982609_274166576577195_7570789563338063872_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_8YWz8q3vsQ7kNvwHO14K_&_nc_oc=Ado939viDr60JnnISpTY2__CF29_gucPJ2QCFowO2COk3eVp2jV9YCvyUS0HG-P8bQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjPT49YHtIjY3ilBgEA9Hq4FqOSK6X_vl-S30ZuceGVg&oe=6AB90EA4"}, {"file_name": "migrated_image.png", "id": "169783093985398", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_206067280337835_8233077063729283072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go2gofemG1IQ7kNvwG6B3Lo&_nc_oc=Adqjyho9ZI3TNIQbFFELYF4M8OTP_giJrEXsDBYVjHtau4nL4zKagFyjokx71xHu-tQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcSfT8Afl0KFRV8NS1lhrLqnatUpv8Eky05j7kbv-tXQ&oe=6AB92BE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Power Solitaire VR", "keywords": ["Solitaire", "Klondike", "Cards", "Cardgame", "Virtualreality"], "long_description": "Not your mother\u2019s solitaire! Power Solitaire VR is solitaire but with a twist! In its unique online social multiplayer mode (with live voice chat) place your cards onto anyone's piles, if you can beat them to it. The action escalates quickly, becoming fast and competitive. Of course, you can also play regular relaxing solitaire alone.\n\nFeatures:\n* Play single-player regular Klondike solitaire.\n* Competitive Power Solitaire mode - you versus a robot.\n* Multiplayer Power Solitaire mode - live with others on the Internet, with voice chat. \n* Can play with users on other platforms and various VR devices.\n* Easily configure play area for personal size and comfort.\n* Fun VR surprises and interactive playfulness throughout!\n* Upgrade to Premium version for additional features and disable advertising.\n* This is a seated (or standing) VR experience.\n\nA VR game the whole family already knows how to play!", "short_description": "Power Solitaire VR is a groundbreaking version of the Klondike solitaire card game that introduces unique game play only possible in Virtual Reality. Play alone, against an intelligent robot, or live multiplayer with others online. It's a social VR game the whole family already knows how to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parkerhill.com/", "developer_terms_of_service_url": "http://www.parkerhill.com/", "publisher_name": "Parkerhill Reality Labs", "support_website_url": null, "website_url": "https://www.facebook.com/powersolitairevr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "306068018209784"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.
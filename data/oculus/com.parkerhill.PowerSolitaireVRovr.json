_264034294278456_3042189141790949376_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svZDAPtr5HMQ7kNvwFMLpLZ&_nc_oc=AdqB01JIeJNfnGoo7McpHQr7RHhiEr2vvDmTTpvsJEitDyK9WTmmgXYniCl7jtXr5lg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXRUGOtcjrW3Cjd62eNkhx-FzKX5e6SZqvTrJyZ_gZXg&oe=6B09B9B2"}, {"file_name": "migrated_image.png", "id": "509092693087897", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001715_496123337572689_724043177283026944_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbjxvXDNkfgQ7kNvwHkkW80&_nc_oc=AdqCbTu_K20lp1JT30RPDZBevRn0rcv9C3x6Kjg8Hjcn7pU30RXA7usVab_i3EjNwUE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJl1FPOvWgXkC1-Mov5P1VAS4wqzUi9X1JJSx4bpbqYw&oe=6B09AB77"}, {"file_name": "migrated_image.png", "id": "230196411493337", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982609_274166576577195_7570789563338063872_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfZTn3n112EQ7kNvwHQW-Qo&_nc_oc=AdrfEeQYPa5aDYaNvkB01pGVNeEERA-4BhocLoWA1HTH8LtlZKAwWRuX3dXN9YAo21s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLmPXsa2BNmLGcsCL4pH-PHD3w47o4HvdTEvrSmB7AUg&oe=6B09B264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/54rTcF", "id": "2156484307952068", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974679_2156484311285401_315404612758667264_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItlVyqdLq6QQ7kNvwFgID60&_nc_oc=AdoDgGjBNG71Dh_dsxb8HbQnNZ4WBmgvrrC8pPMcrJmPKehMEzCUTa-glGj43bKdWds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvfHORnc9UmVJTmIszrDcnTvw3-Mh84X7lagAtP6O_9A&oe=6B09BB92"}, "display_name": "Power Solitaire VR", "keywords": ["Solitaire", "Klondike", "Cards", "Cardgame", "Virtualreality"], "long_description": "Standard solitaire card games are fun, relaxing and a great office time-waster. Multi-player Power Solitaire VR is not so mellow or relaxing. Players are connected over the Internet and play in a shared virtual room. Each player can see the play table with their own and everyone else\u2019s cards. Gameplay starts like normal single-person solitaire, you work your tableau piles, building columns down in alternate colors. Aces should be placed in the common foundation pile area, starting a new foundation pile, adding cards, building up to a King of that suit. In multiuser Power Solitaire VR the action escalates quickly, as any player can play their cards onto any other players' foundation pile becoming fast and competitive. Of course, you can play by yourself too, if you want.", "short_description": "Power Solitaire VR is a fast-paced multiplayer variation of the Klondike Solitaire card game where you compete to finish first. Played in virtual reality, it\u2019s fast, it\u2019s competitive, it\u2019s immersive, it\u2019s social, and it\u2019s a ton of fun! Power Solitaire VR is played by multiple players wearing virtual reality headsets."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parkerhill.com/", "developer_terms_of_service_url": "http://www.parkerhill.com/", "publisher_name": "Parkerhill Reality Labs", "support_website_url": null, "website_url": "https://www.facebook.com/powersolitairevr/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "477828853994839"}}]}, "schedule
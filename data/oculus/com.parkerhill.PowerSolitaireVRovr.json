nc_sid=6e7a0a&_nc_ohc=gTQ-GdLLtAcQ7kNvwH1iqwL&_nc_oc=AdoOdHAFXyakFFCmfRB3zTv4eYReD3OUeEo4dxoeMxWguQlzb3vsDss7OnK8ApDqdOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LOKV_H9KNa4IwGn4J8yrRbBgjSNuYne6UvZTrHsIjAQ&oe=6A046A37"}, {"file_name": "migrated_image.png", "id": "674079116711700", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031431_264034294278456_3042189141790949376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHwO8hiEHgMQ7kNvwG3oOOR&_nc_oc=Adr-XLgGYg5yVFoXpPD9rj2XsV3DXpu-t8DoXVBa0s9C5jhISN0j2KAQ2WHZPjYhJmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af472LyJ3jce1qe8_4cd56QGGjUwztlj9HTU3ZFRhoD3_A&oe=6A047872"}, {"file_name": "migrated_image.png", "id": "251183879606497", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_274166576577195_7570789563338063872_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kxn5lJDXb6oQ7kNvwHO7q_l&_nc_oc=AdriJgRMUXWdDqLCMJv7NE1EoOxzsu3Z-bEm0MGIbjoTSt4r9K6HexuSmX8ELz8M67A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af611woW87UONLcyIDbP8voA_8xv35VO-dMbes9Oi2VtJQ&oe=6A047124"}, {"file_name": "migrated_image.png", "id": "169783093985398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974551_206067280337835_8233077063729283072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od2alfOqBpYQ7kNvwEIb-Kf&_nc_oc=AdqevcpkwXzR4lMSDBXZR8C387TgFz_IV6WkjRm5bPC-6IcnJg4qt7-uFqCDo8gmFeM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IkG-SW9TYiaL6WfAhh3byKUS9ytF9V46DKpxCvMngRA&oe=6A048E62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Power Solitaire VR", "keywords": ["Solitaire", "Klondike", "Cards", "Cardgame", "Virtualreality"], "long_description": "Not your mother\u2019s solitaire! Power Solitaire VR is solitaire but with a twist! In its unique online social multiplayer mode (with live voice chat) place your cards onto anyone's piles, if you can beat them to it. The action escalates quickly, becoming fast and competitive. Of course, you can also play regular relaxing solitaire alone.\n\nFeatures:\n* Play single-player regular Klondike solitaire.\n* Competitive Power Solitaire mode - you versus a robot.\n* Multiplayer Power Solitaire mode - live with others on the Internet, with voice chat. \n* Can play with users on other platforms and various VR devices.\n* Easily configure play area for personal size and comfort.\n* Fun VR surprises and interactive playfulness throughout!\n* Upgrade to Premium version for additional features and disable advertising.\n* This is a seated (or standing) VR experience.\n\nA VR game the whole family already knows how to play!", "short_description": "Power Solitaire VR is a groundbreaking version of the Klondike solitaire card game that introduces unique game play only possible in Virtual Reality. Play alone, against an intelligent robot, or live multiplayer with others online. It's a social VR game the whole family already knows how to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parkerhill.com/", "developer_terms_of_service_url": "http://www.parkerhill.com/", "publisher_name": "Parkerhill Reality Labs", "support_website_url": null, "website_url": "https://www.facebook.com/powersolitairevr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "306068018209784"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.
nc_sid=6e7a0a&_nc_ohc=WIA21LgPM_oQ7kNvwGE42wu&_nc_oc=AdrI2JMgmV-_FQ3r-LJq2189AIoDImtZglZmak6Chse7HGfJe1-q1f4DiJF4e-tRVAk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjY3NJri_UtMBOBT9AVyXUfWBbJYfiaBCj5BR5X3_kRg&oe=6A65F937"}, {"file_name": "migrated_image.png", "id": "674079116711700", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031431_264034294278456_3042189141790949376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQWW1uqnzl8Q7kNvwFlzKfX&_nc_oc=Adp5_l8AarfXzn1DdCAaJyMUINxu9rhZnmzMxADUU_RjgEbkWKoY8uR6aVL7DvPClJ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLyRzCdq98iulPALJhj8BiovsxIMF3FdvM5jMUxYhzOw&oe=6A660772"}, {"file_name": "migrated_image.png", "id": "251183879606497", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982609_274166576577195_7570789563338063872_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne9zuOJM7dMQ7kNvwEMnATS&_nc_oc=AdoVZgczwkIPM5lV8KLpeZhjTFVdpJaQEJn0wdfvO9d7iTaaKRjvFt3DEESOOYzmsn8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo8dS0zx_NYY1idVUZGZjjjtU28-QVUVs-afBvTpm5fw&oe=6A660024"}, {"file_name": "migrated_image.png", "id": "169783093985398", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974551_206067280337835_8233077063729283072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JoXuu-hQncQ7kNvwEpEisz&_nc_oc=Adrras7Sm9nJiDatvPDgTQIGmJ3YTLO1Hn4yH3fSroz07VX74HKT-flVTYOz6dfbPRg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-_d0hg-phHNnmqbA3b9H1n7cCwTBX7irFgf7NaObWEA&oe=6A661D62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Power Solitaire VR", "keywords": ["Solitaire", "Klondike", "Cards", "Cardgame", "Virtualreality"], "long_description": "Not your mother\u2019s solitaire! Power Solitaire VR is solitaire but with a twist! In its unique online social multiplayer mode (with live voice chat) place your cards onto anyone's piles, if you can beat them to it. The action escalates quickly, becoming fast and competitive. Of course, you can also play regular relaxing solitaire alone.\n\nFeatures:\n* Play single-player regular Klondike solitaire.\n* Competitive Power Solitaire mode - you versus a robot.\n* Multiplayer Power Solitaire mode - live with others on the Internet, with voice chat. \n* Can play with users on other platforms and various VR devices.\n* Easily configure play area for personal size and comfort.\n* Fun VR surprises and interactive playfulness throughout!\n* Upgrade to Premium version for additional features and disable advertising.\n* This is a seated (or standing) VR experience.\n\nA VR game the whole family already knows how to play!", "short_description": "Power Solitaire VR is a groundbreaking version of the Klondike solitaire card game that introduces unique game play only possible in Virtual Reality. Play alone, against an intelligent robot, or live multiplayer with others online. It's a social VR game the whole family already knows how to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parkerhill.com/", "developer_terms_of_service_url": "http://www.parkerhill.com/", "publisher_name": "Parkerhill Reality Labs", "support_website_url": null, "website_url": "https://www.facebook.com/powersolitairevr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "306068018209784"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.
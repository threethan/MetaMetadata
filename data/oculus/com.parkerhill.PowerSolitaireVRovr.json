nc_sid=6e7a0a&_nc_ohc=qr9SeFcD_QgQ7kNvwGUJFvi&_nc_oc=Adrl6STezqbrSaovDmHnfazoW-NHi-IRTP4PoIVc1VdRuSa7kYMzXQrQ-1o1ZgzEYjw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJOYF_Rf79iZp5lf08iDYeENtOjEUYZMpLhdstZTNMxw&oe=69C673B7"}, {"file_name": "migrated_image.png", "id": "674079116711700", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031431_264034294278456_3042189141790949376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTDY01ZwrB0Q7kNvwGaQTfw&_nc_oc=Ado1u6rdCNCGFUHu2evS9q76te4LWPqEhDOKgqtB7JVDy8oYPqTQfEEhQ32HceP7B9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGKyvLUptpOu5nbcE-PioHI81y-sp4aIlj26GMZQDrbg&oe=69C681F2"}, {"file_name": "migrated_image.png", "id": "251183879606497", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982609_274166576577195_7570789563338063872_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sdXwrnnam8Q7kNvwGHPo7Y&_nc_oc=AdpOv1rc8_P3MTewnx94xcQIa0Nsb7HA8wv__pxdEuv3tBOJAKSIZL3PWTz95lNVHcg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3uh_FSNuw2oc3mvP_lRVUYf4dGFEAT9i6IoqNhkNDLQ&oe=69C67AA4"}, {"file_name": "migrated_image.png", "id": "169783093985398", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974551_206067280337835_8233077063729283072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJSGVUmP2JYQ7kNvwFUwCSl&_nc_oc=AdpnIzqBtAitHa7cI1mwigvMY9AUAR5zB6W-IMXiCAJIOOJLZ8MKpNq0FTiOiHmOMfo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMuiuRAAnm3dR_iQlm0cxULmE9pd3-mIOF1Ip6W8GU_Q&oe=69C697E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Power Solitaire VR", "keywords": ["Solitaire", "Klondike", "Cards", "Cardgame", "Virtualreality"], "long_description": "Not your mother\u2019s solitaire! Power Solitaire VR is solitaire but with a twist! In its unique online social multiplayer mode (with live voice chat) place your cards onto anyone's piles, if you can beat them to it. The action escalates quickly, becoming fast and competitive. Of course, you can also play regular relaxing solitaire alone.\n\nFeatures:\n* Play single-player regular Klondike solitaire.\n* Competitive Power Solitaire mode - you versus a robot.\n* Multiplayer Power Solitaire mode - live with others on the Internet, with voice chat. \n* Can play with users on other platforms and various VR devices.\n* Easily configure play area for personal size and comfort.\n* Fun VR surprises and interactive playfulness throughout!\n* Upgrade to Premium version for additional features and disable advertising.\n* This is a seated (or standing) VR experience.\n\nA VR game the whole family already knows how to play!", "short_description": "Power Solitaire VR is a groundbreaking version of the Klondike solitaire card game that introduces unique game play only possible in Virtual Reality. Play alone, against an intelligent robot, or live multiplayer with others online. It's a social VR game the whole family already knows how to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parkerhill.com/", "developer_terms_of_service_url": "http://www.parkerhill.com/", "publisher_name": "Parkerhill Reality Labs", "support_website_url": null, "website_url": "https://www.facebook.com/powersolitairevr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "306068018209784"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.
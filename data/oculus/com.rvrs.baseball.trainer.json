&_nc_oc=AdoEJluEsjTWZmL4VxRYOHoZgddYAr1wFFZNjtA3IE5-xQmQa2dtpCqwj3-IZ1NxIWE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFO_x9w3xqGRrYUKEpyQ-vpHbbmnlibiG_303Kg6z-ZA&oe=6AB91007"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P-dNvfH1LgQ7kNvwEO6X0M&_nc_oc=AdrsbU91XQECt_w2uT2_XWO-D9QbnCuctQwgL2GarGshSFwL9jDfp14u67E40DZUR1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU_uB0fo57DilUFIK8lXhKmDkw2U-XwlhsIkqpWezzlA&oe=6AB93F2D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7QSlvA1MR8Q7kNvwG7WFFj&_nc_oc=AdrCYXxjvib3XsDWv8h6HiBr7HDi1Vkaw4AlBRY0mPGPXbMDLXrSS1ZCrg2V0dppG3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEHjZtE5YTWD_sf_CoWv7_hgnmrqJkf6yMr7k2XR2ffQ&oe=6AB90A33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfqmeC0bsVMQ7kNvwF-z2Wv&_nc_oc=AdqCTVyrNPr7-dp5fvckJ1C5CGeAVV5tlWYTsBUYOVnNFEvRufbYNs3N3Z74TU75t0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL95CPyfbiHQ87IzgPWOReQV7r-6uT37FUbaiCP_o3U1g&oe=6AB93583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwOZPvakA-4Q7kNvwFAM5cF&_nc_oc=AdodAaRrdxImfCqubwg6uJv19IXsfhivoIYzXjbYsiNh8Xne4GN7RjJJK_86Qy3BP7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPp4QjeX7YCoOmv67yNn2NT7Al9hiJ6ugI4sy3SzdfHQ&oe=6AB92C38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdpPthBAqAJ2GOKlq5pYI-I6r_Y_qiUlbxc2WN89NpRIEOkTTHTBsefjDGGC7Wsf0q4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgLvPivYSc2IcVrpMUbBNob4Z9PqitarqEJ3fn_mamPA&oe=6AC282C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM2WDal09ToQ7kNvwHXRsoK&_nc_oc=Adp4sekaMfDICZ_SyQf1s_wOe8II9GtvC0WhWpN2S17LSx2BEltpZEIZU-YZitMZv40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu54ZTrnHU1Lc0NHd-Uv-RSbiRhOi9jS1E1_fsSydgGQ&oe=6AC279AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYfNO1ncK6wQ7kNvwFLrZEu&_nc_oc=Adrn5Gro0XEIT0F78GVTdpWRzF73sFvEhUMU693SO_bwyvqkEXn52xyoxigQGDVL7Q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCUKM-gkyT3ZGJi2PC8no_m84V4hVhlBGtTRGPP1SOKw&oe=6AC27CF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz8ihb3r5HAQ7kNvwHBxdDT&_nc_oc=Adphr5rGicqb7KN-fy9HSpzETBlmjOcgbxgnVzaO79Pkw4stgzDEiI_fjPECT2lXzwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4yXIFvfRBp-lXTMFt1Wsg5JX16eo-nlVnj7BJjUbMhg&oe=6AC27003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDFS7uz9mZkQ7kNvwFmaXLk&_nc_oc=Ado6l6XtL-0QIL9lQxxuvU2z_tu9R99bLK8cYSHdX-X4Xp9FoxhjAtiYukspKZ9j6E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFIRfCkPXOtAs9vJvydjKCrzCtl1GbktJDcNowU-culQ&oe=6AC266B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
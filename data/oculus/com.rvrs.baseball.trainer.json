&_nc_oc=AdpkqppUb_tSRV7uNvrQkWuQ4a19PafhQWxJ_sUQrRS_t6oGkdpn6AN_ZJs5aTBWM9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn9ujYJYRkkP1nxPt3vP0ad2CDEFk1WPViNPzHksiF2Q&oe=6AA2A687"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kZ2qgomOLwQ7kNvwE6L9Hx&_nc_oc=AdqmNrSrXi_WAd0y7cm0gHW2W4fnMWLjkA7MzFDfpQHpjZOKucDCgP4chcFM6DzueBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdqmvpHT0NK8wwlknR4hZBCiVshtsFSLOhpRxlGn4uxA&oe=6AA29D6D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE3IjM69CSIQ7kNvwEoMa4S&_nc_oc=AdpGYROuKuOUCqTRddkkvj33rR3sSjsL9vB3AxgPZIWyyxsxAWiZ0Zrc2iKU-wlChIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyFMuj9QZ7hp_VTn5Rv3gN6NU69iMYwkIEOHi0DSegUA&oe=6AA2A0B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy09kefAL_8Q7kNvwGEWcc6&_nc_oc=AdpTiuYN8FqkOcqDoE7N_9S9gdaLXGhLyLyK_RSGOfmtOLEsBFO4XyA-vhJ_HZJ04F8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuJl2CqFMleKvvt21CH1Ul4lN3q-Lan5sRe9vM4eMJaA&oe=6AA2CC03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsYEUD1hlX8Q7kNvwF2_jlS&_nc_oc=AdqBV1auyR_wcLYQwirYlOBPO1sA8LVnSvOccAK9TYHjFplzoph4Ktc12pudkpq4utQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOXMSSBE3ay3RHWqtRN42IRETmNXnwyH27p2s7hf7oGg&oe=6AA2C2B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
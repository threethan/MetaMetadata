&_nc_oc=AdrHmxv6h4sRg0mbBHPpX25k4GuEpc3HdDIEwmFFxFRq09MfwyPTAXDRW5__d0cZh2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAoTAZpmBhmuL006K8hB6-pdhKO3MVJhPF80UMtKfjjg&oe=6A7B1987"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2FDX98zfyMQ7kNvwGNIO70&_nc_oc=Adrbk9ZROFPRxGoFeLVyVnsjF09k1H-_X4KaLWJwh8cMwKpVwfFV9u561lx2tgZNphA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1yRmGhNuarcMd3G0Hjio-CkZQmLXwvjZYjZlWZWBf7A&oe=6A7B106D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZinlE_TgPa4Q7kNvwFOIePB&_nc_oc=Adr_Zm7Upww6womrI-JjPQyl_5SLq__Tknxmmt6t1DO19N_8BdJw80GiYTrW9QPGmzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvHg0ez4kqo0jAt9rjRc2Hk8JXmJyMkSjzHv1dcsp5Eg&oe=6A7B13B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Xl2s1zWkoQ7kNvwFD7BOv&_nc_oc=AdqC26V80OEuiwqC1hQl3hN_jfzc8kkPF52NhzsDT2-Vhdm0UtmT1ozuVpWvfObggfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV_SjZfuQCwtt2U3PKYjB30piA4gIL8n4MUVb-qM5maA&oe=6A7B06C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyrVqe7NGbIQ7kNvwHEKPCE&_nc_oc=Ado17LQxlpAyfcL14iwFSApI_e83nNy1lgu6qCMNsvlAIQrGE-iPP8g8JzBNrJVxSrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7sXJheRmBmCtPOcyo7sU6V7IVQMZN6IerJ9MZZvH-1A&oe=6A7B35B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=Adq1A12oXUO_-qjGdNKQCaxDzTyjZ6tjWHGOTUlG9P9D1vRuAsORRR4wtSpW0cf93T4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDPeoWitZnvr3yXUvOQB-PhcCdP_hvUJRE30KePSqY6g&oe=6AF34A47"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkThQPTrnDkQ7kNvwEdhjq6&_nc_oc=AdrAkfcINeKtNHSEK0fPX1MPGwZ6Ky7ikfAQfOtE2xl5S9tzPo0R1Ev7Y1cJxZWDXns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ35ZsGHghhRZEtvnvQ0irXnLn9azaxIdNHHWXk2MbA9g&oe=6AF3412D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q74mnjv73Y8Q7kNvwFsLtgf&_nc_oc=AdopJWQvvSqQ2594GGi9xwvlGmjzitKgwofp5f3peoj-y20ROfVgYNue9Y0A1JaNcVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_fsMegVoybIUqLXXoF79U5dzwe6hL7ulSAfyzDOHlXQ&oe=6AF34473"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ngGJ-HZaaoQ7kNvwH_9Qak&_nc_oc=Adp6gNlskyW4MkwG-h0151SFp7_J5XuHlGqmMvTxgD4lzNtPW4jn3m3hOmxcGym-mC0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT11avUOSSwCD9c0wQ7TK7BdsNlNuBjmb9GQbWlTe4GYw&oe=6AF33783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD9zi-oQgt8Q7kNvwFSb9QC&_nc_oc=AdoGDPNxhVnheW2EzB3r2DlO5MwcGAaG1poZN4hsxrIhmcLXrD5Pr-Q0-7JqTzJC-bY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRedHCZ_C-D5r-swFaERW_STW2RvUv-CKVS45cVqoVjGw&oe=6AF32E38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
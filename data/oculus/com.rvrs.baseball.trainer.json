wEPiyq7&_nc_oc=AdoMDyoknkZe0fpxaCeglcao3zN9L3JTSJWBpieUfHJtw-6tTZzKPQ13u-Et8nh550A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV3SDW-04ZI2wr5gttJ5XqqI_fWAWUryUjE1M1Pwqv9A&oe=6AA3F807"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kZ2qgomOLwQ7kNvwE749hh&_nc_oc=AdpsLgfvIGf1abk4f1q9UGRU9R2Lsv_EbAHWjZW_NjUXK1jRjoVaDlF7VdzKqY1zq8c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjyInw4e8cFegB7EWo8gmcbYyK-gABe-VktqIFg6ahig&oe=6AA3EEED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ay0cX5VhNMQ7kNvwE7YsLg&_nc_oc=AdpnXJVQ8B9J3QgIfBg-HDJfDxNQ-m06X8CjgUffmgpO1whWBHDNZLB9yxkAqnF_vQc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwwv73PU0bou7jQzScr2qmKHIq-7NQunMvzk4B6MDOBA&oe=6AA3F233"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTNGwTNuWIcQ7kNvwEv1Mud&_nc_oc=AdrAcwA-MwRoT4QfLHpOTs0bk7E53LNLDlHk_nnR95PzFCrkvWP4dZqoH4yy124zjaM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhnGAzFJQY9z7zROuEBJ8pywjaKwUK4PCoFr3kOSxnaQ&oe=6AA41D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsYEUD1hlX8Q7kNvwFkBwiP&_nc_oc=AdoZ8wWJBwxs0q_umBH0zJLBH-CJbwfWBp--9XEEjj52x2uuXi15kMl9WFTM1ESITvY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCFXfbWcoQqdoMwhIHjRURhVqb4M901kT60DmJzO3oGw&oe=6AA41438"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", 
&_nc_oc=AdqFPhRd0DTULfrhQD74G0GxbMmq35u1NHQmivQ8xKNE6W2C7jc8YA4b6ysmY64OmeA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDPyKVxkhm5k9SYUY2fRVCXUrRpSDjGYcwmV-PKZQBAA&oe=6A884887"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVgFNuSsBSAQ7kNvwGxC50L&_nc_oc=AdpWSLyGbvVilmTe6ZxbLJcw9ErD7MiJTbeDiTlnW8ANIyAm2bnGStIcrgQ-XMPyvJ8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH7LWfN5I0FMU0AvGvfLaOMcgXx1xCgh9tmrNumTDOJg&oe=6A883F6D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mj-ijiJ6hxgQ7kNvwFyR9g5&_nc_oc=AdoWTJSvaPxfbFziyVpun_EYrwZKCckm44u5rKZmlHJfMw3zdkCPvruPTXmzQUhcgNs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZNwjiRSzNpwheRUj8LVfYZhRAUdyEXSwnf2ljyKRvyw&oe=6A8842B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5PYS7RBfcIQ7kNvwH-l43b&_nc_oc=AdoimNJOnNhxNHNcXvyqHDgVvSmnXMtvOTFqes7Bz4c2Yulr58jMtK-sQkubq0RyGIE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNH5bkrJ42PmOQkY1g07FJCbHjVpYD6hnXO36no6r3jw&oe=6A8835C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSBIbBwTW3IQ7kNvwEBI0qs&_nc_oc=AdpS8MRY4_KQITiTZQG6GopocweE6EyvmL0kLiOq3x3LDLSik9tZE7d9MZASegzmJrI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEICMTxseIHk7rGrqictIVn0nuKuJLApkADdq2yTmjqCA&oe=6A882C78"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
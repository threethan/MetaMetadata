&_nc_oc=AdqB8ATI4AFpncOTlj9pNCUQDpftQxYI2R0ipHyHlZKex2EKs04XWH84lPG_EHNg3VM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn2X2hRlpOF7h8HIbECVvpB-sP8d9u4A4x1ncL4abHCA&oe=6A7F0E07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkhA5wTbC4cQ7kNvwFLvcjM&_nc_oc=AdozKvIhSuznWsbZA8XhdjxdfZ5satQq-lFl0PT2bt27fJE7CYgyH0og6mr8_wm_4PU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUu-oqCBNukF42pwYq5AtEObajUgXrwZPLK85_ofc8rA&oe=6A7F04ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ97Y26YwjYQ7kNvwGoHqn3&_nc_oc=AdrZopOQ8gE9fkWTiL-8q7epk-Io8auWYQeLzFU6y75sqf4CaDb1boPUGiKpOdh_5L0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBxtJKTnhm6Zxb-7pHqcZ9l_sHp9gAgTjHIsVqZz_lWQ&oe=6A7F0833"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldLemdG2BkgQ7kNvwHHcpAf&_nc_oc=AdrTEkJDtWpiU1CoQEXz8uLvhIaDYRSQkvNDA-epaaiHaL9-XH5XoV5WRZ1Kdi_LtJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvz7-xy_WfhtKScCUxh1KTbAOmiUxBRs-_2bd3rILezg&oe=6A7EFB43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RLbDCp3jPYQ7kNvwEWanxF&_nc_oc=AdrQJ0W_InU4Jl2dyiUTmMvhMciJfjIOPf3iFMfuRqjG1aLPLoUZuXpl93IUxIXNdMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENUNN8CtIeW4XA7ltthKKXfDiHTk7zFJ6HQXvaWS2wXA&oe=6A7EF1F8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
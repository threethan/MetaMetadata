&_nc_oc=AdrakYjUdKfzuzZT96q3ulN05hz_ph3XIzx_vkOw3HdS8OFmG6O3HqbXDAI3KDJmUew&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWXXkXKat35qlLVZII1IR6UKmCl3n4kp3J_MyNX1QSvg&oe=6AD3A647"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfmyQEBwtVIQ7kNvwGmpLTa&_nc_oc=Adq2LgZhoBB5ZY_vk2nUxuQWGYhxO5bGIc0OC5dotVM1kP9-A9pGcj8yBElfDXbZa1E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzHhhdW6Nr5pASM8kBuE7P3JqiRe-4dBY4VIk1ZcWFmQ&oe=6AD39D2D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttn_Qd2qu7gQ7kNvwFCkG7Q&_nc_oc=Adr08-wCbu6Z0qi0_G3WWMrdx0fAhNVmEUg-NsJrD5MGoB3SgLZuSpPc-49oEhr-3Kw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwhlepZsTc9jn9rtcNltFy40dSp5pd0rJBPMTJgj76Tw&oe=6AD3A073"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hub4OgVuTlsQ7kNvwF-RH3D&_nc_oc=Adrz4r4vCDO-Xe_eTgL_1kYjBTO52sAdj4n0JmbK-Oz6r-aFRb01uI_ANF-VjNthBFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTsEsGBs1TPf-5PM8uMCrrUEXX83ATLAOLcT6SEv-PqA&oe=6AD39383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSgW-Dmh4l8Q7kNvwEqraYg&_nc_oc=AdpB8HcVJZWvW89v1FMauskX-y5PSnLEybadSddgZuvcEv-oXfzEef4xB_9TDGZ7FcA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp0iFS4ZQLuSwUYO1s5Ho1CIL8n2IhVqaKa7I21-HZCg&oe=6AD38A38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdpqWTBgM5CmJmqDjlBP-ffY1Tb7V5KTNQbtesNJ6Kf-OkX_QtC2jC82GfbXs9rj3xg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4A6-m1rrS2O236cZqvLMNu2Gq_Ghxu4M5Gkk_SNgcoA&oe=6A620D07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX8ZJx6cqq8Q7kNvwFP5FD4&_nc_oc=AdrKuhruJsQTtOYPFUXQ68ylYpX3aYeJzF0jmr464ZAixYaQMbz7jSRfTX5HSITIzgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLE4UZXWXjW6ZuhayA_b8PyHEora6jdawhe1_Ywtvi0A&oe=6A6203ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXZwbn9gVp8Q7kNvwFY4gJE&_nc_oc=AdqvOWyy6qypqhJJ_kWHhHshopL02RZnJeIfhkKuIWulITHnaNvZMhVWkBBs1QPFMKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2JmNLj3u3Qv21xXetLzHSq854AothRdMKsa5L2BAyLg&oe=6A620733"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0feLkc83k8Q7kNvwE2Uo9W&_nc_oc=Adp_9e3Yyc1AW8d4than5RZg2_H89eZi3ntdE7i-PmWnHsTH1QrbZU-7Y41Z7CNkPQg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo1Dq0BleiXAlolvPMWxUOW9TW6_cnTxPXIAVK2mdNhg&oe=6A61FA43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8yjj7exD2UQ7kNvwEFnKBp&_nc_oc=AdrKgEUhSrc6mjuI-slMY9lvKDzv9gLIVzho9U9-2g1w1OBT-sZUNErxXdtEP4_W1UY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN-TFdqzQp0ND7g1BNlY6gNhcbC3SAJ-P-SBsIZ9xHhA&oe=6A622938"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
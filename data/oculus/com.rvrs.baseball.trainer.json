&_nc_oc=AdpDBGw4pao9zBGFvqDYMAhFeiGGlm5B83hb2r7JXBaa-0jGpR6pP_3l43JrfYAF6TM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwWFVK81fAEOliTGd2Um_IYCkFx3MMa_C0z-je3N2YNg&oe=6A9AF5C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JBMmM8gjFEQ7kNvwHfazso&_nc_oc=Adp6FQv161bAyCFvWQTjnW-7EjD1apNwurT_2xnZK-3XN9RITgUKTk4xYy-MxAsQmX0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKelAbElCXL1PoiJ-UguandSgCz0zBhFQp_POXcjCLtCA&oe=6A9AECAD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQL-VmDaHGcQ7kNvwFXOApa&_nc_oc=AdqRDkohfcPLv8XYgPK9x5j_OQRqELGDet8bfICED4UtPe0yqCHiB20hM7Vjg7_7-dU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlGEUkOEi4i3Mgqt0c1RiZmvyQNfeSgkpK7Eo7NDpiqA&oe=6A9AEFF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nUU3lrA07sQ7kNvwGTo8w5&_nc_oc=Adqt7YMFQ4VMQ7Og5kBZnf498L00zHOE7MTmxPoY_miZOz-e7hZUZ2LJ2jCwsdj9who&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL04Z2t43qGvRxDoa4BWZwAREyo5VuuxMFYdsgY43O-nQ&oe=6A9AE303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMkPIYpAGTQQ7kNvwE_fdOX&_nc_oc=AdrmIedwTvcj3H98Ma-3h-8NKPltLiwiwYSFrtptKg6zlevtz5TCIh9OryTLTbuAEO0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt89ReTaojCSL4wzDj2k-sxh6rN-3gaKAa3Hp8stGWwQ&oe=6A9AD9B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
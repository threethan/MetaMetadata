&_nc_oc=AdoAVj9TZS_9x1wj7WOK_SbmgDmqqT1XMBQnsBkj0nt5M1N1XilrBJgiH5e-3LDCWLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM6GOPI8XpvL4sUW1afsMmM-MJbODCzP-7x9jA-TWOxQ&oe=6AB51B87"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3E49QA2qTa4Q7kNvwGTOqN3&_nc_oc=AdpFEi4RDvbIztuvOBcWwwcCq_x9WngNFJRxCYyuBBBaQrXQA4tLf9t0981RuboHcgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2PKz28Hm487u9ueqW1_TVHtTs0PrZIN9Codq3bS_YzA&oe=6AB54AAD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcZ7uFc_Ip4Q7kNvwFfpD45&_nc_oc=AdorGjoRVuSaDxHFqhEcl-7wwr0NiDz1Z0jXH5pyW9UBIxAoBBZP7_rPJibCc8FX59U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2-eS9b7_zybjmaAeesDnlEWk6YHw03fwSJV4LPc8pxw&oe=6AB515B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shxvzKyxLu0Q7kNvwE76Wgu&_nc_oc=AdooLFrao2slKpuKCIF4QNtj69pvy9hLx6CXkf58eX81eEpWo51jU5IDiZCPpR6iPLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZBLyJShv7cpxjnnzG81IkyiDzn-QE2rur4_eCSHND-w&oe=6AB54103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkZVGqzOuCsQ7kNvwEyxKA8&_nc_oc=Adr2J8wiFHgqydHqmdGKLx4MiYEVRUjWBvnzXLrFbVvfzO3BSQ83jFBGfb0LiVKREjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_3Tr1icHNEok0GSTVaA7Zb3uQS4CEaxq-CqoKk-ELPg&oe=6AB537B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
vwGWXVuO&_nc_oc=Adp2QRl5-iiB5l0B7zw--kKHLGXIismKEt5f6dDpHij3uHyc7X7i2QJGLQnA_7lLTSM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaSlDEtLT3Kgwm8OCPvz4GvKD9oJVg5zxz309ZvnIYdA&oe=6A8EE007"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hh6t6mYEIsQ7kNvwEKeqTJ&_nc_oc=AdqiOrumB4evFhfovO-Jg_4ldoa0-bgtf1MuHjmpUCuPBdMVkVN_A47FnvdAWCR6NNA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2ftEo47ycMoC6xe_vq00vvELMnaBZ7NwKDFNRun9qBQ&oe=6A8ED6ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9u-SQBi_SIQ7kNvwHY6Oqb&_nc_oc=AdrwKYCveADUKNJ5IDssTMQj0_ZHU4iRzUSsmynEVZoa9kshDiYKmNoqDgFTtLby9YI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXLGUs7YM_82HfviFyFYgioRAgYnqTDecVHApXhrCKMw&oe=6A8EDA33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaKJdR67Y1kQ7kNvwH3faDn&_nc_oc=AdoGk1ywBPPqFm5J3IdtEEg3k-yw7_0ax2DSFggA-M6LcoyjjDgvX7qLsL6G0pxt7P0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESThWWKMgZpEJicKXt4qa_5R29glI6CywYE2itY-ErqQ&oe=6A8ECD43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5TvPvMJ4QAQ7kNvwEfmUSO&_nc_oc=Ado4MoMOxGyxlo344UpApbZOoFsPLRAra9fx1VUqum-6OEtVKDk1rBfRKv7plViOaI8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwcRPQRYX4HEbjHtzJSlJkLMLb2PwqiSd5x5j2gDd0LQ&oe=6A8EC3F8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"
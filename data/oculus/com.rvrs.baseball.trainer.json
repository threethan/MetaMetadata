&_nc_oc=AdoJqWW6UYOITBfbUzNzzDvlVkl0ef-oFjnG68pHqjWoS89k1BHQHKEhEgWM7XH9C78&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeuBuGdMPlY4CIwPWmL7g34IESCqTCRh51im8wSPX4Zw&oe=6ADCA887"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYWK3jHvSqkQ7kNvwGcLyG_&_nc_oc=AdoFQ58LHFI8LmDaNvo3NubXYnVD9aRS6DJc0XKIuratgEPtN6WLHTRN8jtkvn1MbgE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4csW5iFC7URZpGkmXlqu_UBKqZnuap83EOVoCyfXByg&oe=6ADCD7AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOUvOnWVQS4Q7kNvwGpBPWF&_nc_oc=Adr56bi7AL1FUirSR0UhddMCd1GlQTKAog8FWe7-XxeFS8smgf2KD5Eoz1bg6koNqJ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwWmtrybrWCRsGeJHUCzLYW_nWcKRsesdiE-Y7TTLtWA&oe=6ADCDAF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-YLpY9WjD8Q7kNvwHKkut9&_nc_oc=AdoHWcTd1G7Fi2i5yYU4hI9lowKBss4AJQ2jFk54S-3gTT8iVqxwuFoDKrMi3n3Qj5M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQJ2m8yWNMWOj6HDp1erwkStLD0PNhYAICAQPeEBGX7A&oe=6ADCCE03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKxd3FYQhT4Q7kNvwFkd_22&_nc_oc=AdrIS7_bZ8siBf2R1BKB6y6wPq4hxunJoiHOlFCpG8YNwJuO_8Oqi8AlfQz7Huj7lG4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrH-goXqxZ8ID4GDadRyUYQqTzG4kuoy3zG1Rxlz5BZQ&oe=6ADCC4B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdolWY1Jj_x62ZmgY3kckHO-lym7SHbp83W_yODwCzea2yqdcNFKdMulpVe5FKH2PpM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsPFTE5MJWgeCspjWyk_d_bZKgcqKplER3MUtAEkkPGA&oe=6AA15507"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kZ2qgomOLwQ7kNvwGsTDHr&_nc_oc=Adof2hcCsNBGKbTL5-WSh0z_9gHkqPRowi5a6UGb7Dn0V6cynPt5MmNPxHNpYlYpkbQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqYstSkBE7QvTSR712ZMTDnOdI7t7ESRmuxnanOTD9ZA&oe=6AA14BED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE3IjM69CSIQ7kNvwHQgs4W&_nc_oc=AdrD4-KYmPG2n9YDzUKAnaHMYRTEAbBsk8a2xO-cIJg0lBhOD950m3u6y7ohR-mCRjQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1b_2cpGC5Ps_thZnBUFI2NLdcBhPnjHEV1ZhuVDUbDw&oe=6AA14F33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy09kefAL_8Q7kNvwGJ_xx5&_nc_oc=Adq_QdRJh6DZ5o1L0dru949W-Xbn4zyq0mVX42J5qX-qFJJpzjq5mrYbREBJcIuTfpU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvm6tyuSxg8DUjiJ_7VOPXftkGLUf71_do-kiL-7DGMQ&oe=6AA17A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDiTBUbWpOQQ7kNvwHT-sfJ&_nc_oc=AdpuvuKqL0D_XMEun_I5ZLv4e7u6gE8Vbrst2196pdY1CV78uuMly77PaiZ1VG1mPJs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxIPZpTR0IFHb6LPbwZuvI9D3OgM-3mFy4eXF1Mrb8pQ&oe=6AA17138"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
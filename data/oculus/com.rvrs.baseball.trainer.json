&_nc_oc=AdpdADexLgMA6NmIvax_9Yet18P7JomdORz_H_--HkkPCk6F9xjuKyYkz8En5BHXydA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDufpYBUZr_M1nJy68aiFPuFVpzrkzShVmhcMYB1B1URQ&oe=6A60BB87"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmr7QO3g9HIQ7kNvwH2tz49&_nc_oc=AdrFB2xFJ9BdEt2x5jB1khse67FmKdti0ko5qtjnwY-5y2AnLBvLpv4WppoU2iUS51M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARv29ZJUdlFUOftWLUBIUKFNHDR6obNuRFQJBGxPrAIQ&oe=6A60B26D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXZwbn9gVp8Q7kNvwEGgZYK&_nc_oc=AdpKCtniKglJBIgvP6AIaHgSs-d32Ho2i4ejpe_V1R6CyDNfdrBW6YEL4v4hcFHwzog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKWZ2RTvahKiD1ITmCwW3jWpNZBZbmikYn42jkTXKWcg&oe=6A60B5B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0feLkc83k8Q7kNvwFf9z4S&_nc_oc=Adp7_iOsLmFo2er8cPPy5j6NSfCp01a0srWrteIE99EVc6_-XXFawe1Hwo5zY--i5lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGUdPkIQfWkslMcPmXh0S-big2fjhTaNdyucS_ebBreA&oe=6A60A8C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8yjj7exD2UQ7kNvwEgZ9Ee&_nc_oc=Ado5J4wbFP6MNdcqW2Ti5s1YBUZvRvkPSCw8jTJ75dFzZeNIO134ys_ZWA0hlpfJ6s0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2FJ4QvvOXU3mfrQdsoaeRNYtWLwgbjoNr6KzcE-vEuw&oe=6A60D7B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdqY7Ba9x-Pt3MFyojvrk9-mzSmKnnqD_-wlzoscfCBDNdu9En24lJ9RaD6aA9HpPQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3FTGT0PTQcQ4OzyLQHxlfJFs80Jm0CGFOf7rDCLzbOg&oe=6AABE107"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TqmDahRwZ0Q7kNvwGIA8vP&_nc_oc=AdqwxJ3uA9E9bKOKMosvPR9yoir58xtjMZOkQiOJ8LoSvjnmba0AqsWEVv33G0Tfvds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLevE8iiEBIPIDbcHVfPLY1mcDk-gmq4uiS9n_EORD4aQ&oe=6AAC102D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cG29dLUv1sQ7kNvwG5bU3G&_nc_oc=AdrmTSx9ZSYxJsl2haLu4bryE_cT5lYJxTn_AR2PQF_Svd1ess93J_AilToiylH22oE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVGrZF5tEY5wJuujUlhzIsNwOBjJh8PbaTOiSy6KlIDw&oe=6AABDB33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ0NqKy5qWYQ7kNvwGk8uoN&_nc_oc=Adq6e-tkdOvU5kOAT8TRFCbaH6cNxFMQoXiIQZvlrShO4oCA_4O4gcUZNG8Qbnspaq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdDtTiNyLceORDunHqqHvxyC5L4lQoCdl1ARZkeh5LZw&oe=6AAC0683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt3PtShjD8AQ7kNvwGxGZk1&_nc_oc=AdowslTWm7IljxhY_-l084tQlckfHHzYEzGoghVZvtwZp-DnO8ZoIGQwHJsCVY5wom0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwe7PnjWL-pYDghgACqmzPzsh_rJd6JbxxANn0pCzIcQ&oe=6AABFD38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
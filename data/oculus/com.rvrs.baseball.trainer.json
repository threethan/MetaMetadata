&_nc_oc=AdrWdo-pUSJXkOVfOi8I4a2Z7WYjmhO_GqVbAP2UbRAlGri5pCpgcUFPaNt2HYhSI8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsnt5T3XBDLUg4-AM4c51T0ylHYJAewGZEbTsK0BCWFQ&oe=6A8C3D07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v_xoJdqOWYQ7kNvwFTKaft&_nc_oc=AdqyDQM06R3KYXXWIuDcXtG1kbxZ8jg3yQqsJlN7vwn1UzKAF0X2aCOwHn6Ac2XJaDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqr25eNU_y0dvad5uj7obRlgjtWS_hcS0Bxl2KYIN4rw&oe=6A8C33ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9u-SQBi_SIQ7kNvwGfsrzx&_nc_oc=AdpC-45ePvdTbFWbOgqrpAYPs_jHb0mcaS1l2DSC4UQv-gFO8dg9Ld4b3KW3-dYoLEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_6w6OqqlHIuQn7iD_-BnZ5VXeU1LEopx-9JDHEVraqg&oe=6A8C3733"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaKJdR67Y1kQ7kNvwHwYOuo&_nc_oc=Adry3RKb0-IazFCd9egIhGHpOFGFX9_ux-BPx6eRdDHs4ClypxI9Ph8rw7S-rDJntuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAXbtu0v1uBk3OeBVyvozMMXh9xBMDVAvfL5LqHtrz0A&oe=6A8C2A43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyattNBEaBEQ7kNvwEidBrB&_nc_oc=AdpX7U1IRErIwje7DbIglRfY_WCUWWjs9EA_d3nX4Gc81lSAYpCdeSDZwyc-Vyu_GCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpNVWM3AliYApcTK3rf1tickXovqs_6TJpkfEaxjMmNA&oe=6A8C20F8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
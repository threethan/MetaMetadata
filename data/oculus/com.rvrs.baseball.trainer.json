&_nc_oc=AdrQx0UdyVRDmQmQ8UZhVG6ZD-5z9IqMBOIHG1C271Vx3CnvkCsLDDsJ-NiNs6E7xeI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvQ-emoUdc_-vJ-QU5B6PJ_TsoHswGpCONH9jtvdurlw&oe=6AECB2C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ttn9RrlHiuMQ7kNvwGZDJPi&_nc_oc=AdppdLkg8Lm4_IlDB7dTZDNcME-SgoKjmV38aaFef8QXPYSDYBPQhPD0ZtoKuOSGEIs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLxm8IHpB-3EJtNS7Uq0bVfX2GCCLSchi08yx8q05ccA&oe=6AECA9AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngI6i5nDSVIQ7kNvwEB8ak1&_nc_oc=Ado39NRnXcHyn5P2oR-fxQEhYIcCTTeVbfAaKGLiqVu_eCvFBfPI2Ojt82M0xBymJ4o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdyjdkPT2yS6z4H2AzOhtVPJt_u8m5qKPOT1kX4DPd-g&oe=6AECACF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3utqWwGr2ioQ7kNvwGKF3IJ&_nc_oc=AdpLdBspsxxM8zpyvFlAcFjASwp7m75W6_sJQ6fWA6ybOV33yZV60ubktuzqfU0D6Wc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxGH-gMSNOG4aFQqSMm6G5h85zZqvKMUIIrEDiRFfL_w&oe=6AECA003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KU-5XdGEfEQ7kNvwHAuEkn&_nc_oc=AdpQyNcwZpVWjGfgsM7hVLxTbvmQiawfMBHd3K8kR5cwzsVp3Yt6XUeApl8XnX-balY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjnplJDQLCHCfH4ywpxNJbytPs5Y-h-9Hgbv5tvw83gA&oe=6AEC96B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
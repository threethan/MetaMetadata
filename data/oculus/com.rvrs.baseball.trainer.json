&_nc_oc=AdrTqniJ7qTiHQrsXNLpMBipjAF9xx6bscvZ7-nJNXC7TtyZBUS_rE1dKydacmDuAtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPkeuMuZXeFm7QEO4buGuzPLFjqIP6TAkydpXO06a17g&oe=6A4CF507"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pf-F9ySEmkQ7kNvwE1D2rH&_nc_oc=AdrDf6vytgiUI6eWD-2Frqd4rxb318KiWQ5TCaeRrBQ5A8c3AQvq1ySLkE4T6ofM4Uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1GGTd1qgAHLQvzwa6yIEjRk8JpouK6PLo5qzpq_jUBg&oe=6A4CEBED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0etPM9oXyRwQ7kNvwGnt5I5&_nc_oc=AdqH6dKKMzUio2y0iP43swm8BaSnH506mdsx073QL0QQfskAft6kcLpo_iBLhqDGIqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-U72ZHpvP4M5dZH5xzlxJYB50H5TfdUjmqGKw2yThSQ&oe=6A4CEF33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6odgkABvLu8Q7kNvwGecSSm&_nc_oc=Ado4CR9-ahy1EhEMMNaTk98BVmIE3yD-2SEdod3LO-o-MxBq9Y0ECXSjj6WsJxfsmzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTYEzd0LOVazhMTnhIxbTR_IiYOABkcbT_UWCJEpqCdw&oe=6A4D1A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKCMO7s85TsQ7kNvwFUdwoO&_nc_oc=AdotQSrPTrG1FFrvfgC6rlU5KqAVBLrfdfHXfh3kUQ99GnZIbXddKHjLQPh8-sEFsr0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXW1sOaDYVyHU5cE1J_tV7kAt4-yY1m79tgc1aziVxnA&oe=6A4D1138"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
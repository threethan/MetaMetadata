&_nc_oc=Adpm5A1EI90BH968FLaN2KdWJ5VHq4lxgYVbiyHSP7T6WozbtVaN-l3YoQVEueW1kN4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv6p3GB5qbWqJ2Ys2dK3MvFV5VzCUsP1ac42iGnMI4sg&oe=6AF9E1C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL8F_TIxtAsQ7kNvwHBmORW&_nc_oc=AdqfxYhfSQsMQjK9zjqSz3YH4pVl9AlHaVWJ4eI8IreuVHI03pZj4l3ig8JFlnJO0Dc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk-ec9Dy01k4WbwZxXm29dnmXROoQQtfP36aL-XI7V_w&oe=6AF9D8AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA8MEma1ItMQ7kNvwF6zZc6&_nc_oc=AdodbHzvOretmwHEKdA6NF3ECerkbC3PoWkWX3QQJ7syMnTuCd3M5fPxk9pulqP56Gg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYE4KRc5P1dF2ADZ6Zl0H8kgzhP6dnJ8CGppYo6zc_lQ&oe=6AF9DBF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjQfvkvJ0pYQ7kNvwEO9Lf9&_nc_oc=Adrle_eGr9li4Fwy5LtV9gSlptv-iRFsLLfs31LGaHIjZPP5qDr6Q8XMS8m4jDH-XoA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkRHTvGwaw_1-T0LxjfC47SXiFVEdy27RJMMnpSbCnFw&oe=6AF9CF03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0RX2v-CBJwQ7kNvwHvGi7_&_nc_oc=AdrIHwDF8DH1KGdRnsoy5lLcMclYzAVG-JRJNJE_arXnUSxE9whmBEC6Cpc_C8IGU9o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMREux9E_F4vtt8cDnzdTIyvBGnUJFrvZuor1IiynArw&oe=6AF9C5B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
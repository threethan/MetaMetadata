&_nc_oc=Adpa6kSjROSz6k_wRSb9b7ZSBwaxxorRCGtpcU8-wh22ALzjFQSH33RIIXAbYgobgJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT09pNycJYz9rPT_n8aZeeZO0YH-Ap4nfnBXXZpqxQhsQ&oe=6AE76CC7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF_K07rb7lQQ7kNvwF9Bbmo&_nc_oc=AdpL4Ox8UDfSiyXmDOD-V6zZC38ZEvAbHMSQUwf_Kc0_moJ7o6Gfol4WNJePjizpcQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQthx6ncATXzl1H7OesoZQ9PnoTRS7iHkPvjAoqtRR-Q&oe=6AE763AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYsFGJFA5xcQ7kNvwEsht2c&_nc_oc=Adr8lWkPo8y-3vou29Z515YmANCBl-y7LzIDWX5wDZjqe1jvNqFJEjv5b91OfclhM54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxxM3lQ6B4oFlRjUx1LgUmWw6O_RHgIvnifE3ekiYaOA&oe=6AE766F3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8TrRAPAqv0Q7kNvwGUvcxH&_nc_oc=AdqqbGmp3bTRDNQGfwxoB21nxR5vDbYrd0bIsFFXBsh4HfeoZm0ft8SOcADQSH1NMR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4RjpMTu8sVS95xhCzWGEfACC3PI8q-eaM1ZA7LjEtiA&oe=6AE75A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGqyrYcinJsQ7kNvwETNQHx&_nc_oc=AdpUcJuDYw6zBG6C_cdAIxuCnMnqvanxPZE4KyV4tvb9bpyEwMDpNNkcYnYpuNkEEdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfXv08Whngw7f0o4e5vWkinY9YmdYYi3WuGKL6FWiCWQ&oe=6AE750B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
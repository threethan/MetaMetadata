&_nc_oc=AdpqCiEk6nCc8-5J2h3B3b3QgGNcKH5r-iaTM2tfVG1XxNhu7up7dISZPwjl6ryaDVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyu7nW0zrHGZ8e5pAJ9lYRvmCt7uw50KPpr_a35pH1Vw&oe=6ACE6047"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kYHWQtxv5MQ7kNvwF7Zpsk&_nc_oc=AdrEEM2Dffv8ns-9k8-53Rhd9VWP_MmMjnfPclbrVM7Vm89zmmGUzJ7anOGWL_uZ8k8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrSEy3WmkRMZXocC1M-mUrrdXsWm9QE64PNjwp7OiRjg&oe=6ACE572D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNSJb-3UHrUQ7kNvwH8yZyG&_nc_oc=AdpsG9w2ouzBxIqMO1vvh_UecspERrwEUHXS1Ye0Ow_vxxlmeUdaalFeLC9EDrSPVV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnmOR68zsqhcaVtT74dC9zSIoxj6RLxNY6CUIbfqGkGw&oe=6ACE5A73"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhLoRSJ20soQ7kNvwFpDpXL&_nc_oc=AdrG3roVROdJSCg_EOSBw0zbn0y-_B0z2m9MkkQazOZa0wekRZw-gbH5R4lfY9zAIMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmgNovDZbI0Uo27Y5QmLh2x8i50_0VuaEbcj7hLUWjWg&oe=6ACE4D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDUJ3a7vwtYQ7kNvwE0GA8I&_nc_oc=AdrhYCI2CtSUlwe95q2S5Eq_GnCAasKxLyyYP-E-9Zo5GwXKiM8b0adwFwYjW6zLXIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvECVRf1tLIQYErDEm1Nueh2k8v6Qz4mTf3VqlCkPaOQ&oe=6ACE4438"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
wGr2oLS&_nc_oc=AdrNACdWowrPTBOZXqVymqqT_be_G0xAkCYW139qTWsz0Eaa2gflFhvRK2NgcMioFM4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOFxYY26gaGnI8Ac7kV2cfmnBuyoQOu6_htuGpM7bR0A&oe=6AA93E07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TqmDahRwZ0Q7kNvwFSgPTV&_nc_oc=AdrnRgI5s7GV0-oupOVeEltDI-bfFM23UnE0obIk97n2fmxlTMDgQfam2nhGx4o0wB4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7NzshMIH6Jog_tojLvpYkwHM2W_irH1PGV3vWtIzCTg&oe=6AA934ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GJihMlxoLgQ7kNvwHWVCk5&_nc_oc=AdqBiyGQwqNmo5qzhRswUBGnPEHhbaQSTLsnpxsBNELPlZIvlfX0BJybcbgZTk6A_7g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8HNptqFkmuvmSxQfv2pi1aCuTJ7X5SQpxHPFPQ6eTxQ&oe=6AA93833"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z92ePPgdtfwQ7kNvwFB8CuL&_nc_oc=Adp8NTVAXmEoVUKwNPUcbfpCkoMR1aC2BD2YCygO6z3GRFXqPal-Ei1fWdXG6MbQOWc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQMCAGDHKnPJ8VzLXKyRyoLIpdvEqEAMbTPMsP1k7-vQ&oe=6AA96383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq80mGTBoZEQ7kNvwGKeQYv&_nc_oc=Adrby_MpaajKKRIfneXRfst3Pr8YaivagXW0mx9Q1W55rV9ZI2z94Nm9LbMW4FTJyCs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItBzy0uBrN2UhbbZLN-Qo00FhkOSxy7Ksij8k8jkjyBA&oe=6AA95A38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", 
&_nc_oc=AdooQNkz5KuJQ8EB5EEOKYKA1a4-rj0nqDMBkfRGE_PTAB_RZkDuizWj8RhK15GajWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYCoy9HEv9xF9I-pzT5-nfCxU4CEdtsWoPSiLxbeaCIg&oe=6AEE0447"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ttn9RrlHiuMQ7kNvwEDdecF&_nc_oc=AdrRnK8zrZQUF55Zfvb0hTgaWEXuQKJPtm_c1nb2NXUYIgeEnOkxNEOPq0Rh2cH2iyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIBKCnh_HpD2qrspr-kI5xRE39YgdjsMZMDWeh7kv3DA&oe=6AEDFB2D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngI6i5nDSVIQ7kNvwHAYe2b&_nc_oc=AdodzLNPKAppPE--VatJg2aSFqg0t38n3CtWJLhZ_2rkVr_FW_MFMwShCUq7p8qCjkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu63uou_FDxFnhnxxOEuB7L3Q2V2mEESuPG8VTYKgY3g&oe=6AEDFE73"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3utqWwGr2ioQ7kNvwHJrHnD&_nc_oc=AdobE_ZrsJ4OXGnGiOJS_oWO6Aw2qXv9U-Q-jnwZ8ymvGtJ1aY5Yr4PCbdeIiVLMGOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSg0FFmaa73hSNV-uXuFvD2BKKUmbWt_xmeNg14cSq1Q&oe=6AEDF183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNSlHFXfboMQ7kNvwHVIeKe&_nc_oc=AdqGxlY6TCw7_HQB0k3WFks8dKz_CwJDgHs23OwHUakfYdEEF0Ne7duG1mbbcLKfU8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwxVRHi2cqR2jmLHiePX8urZqllEERnK007EGCYQJt7g&oe=6AEDE838"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
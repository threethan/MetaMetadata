&_nc_oc=AdqzgNU9zg6LOUIAjrpW3uldl69mUQHjXubMeFna-AjEiqejXjUngoKEL4Bv0xzwDbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCEoGTh_9PZJbfcTszJz_O0A7zAR6HjT9KvIxU3qOZrA&oe=6A523B07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRoBWqf1ZIQQ7kNvwEJfX_n&_nc_oc=AdqdhBBJdZYL5qeAiqsg3OQqVoXKz_MI8mWdgPMyx_iFMDxcfKRuFXMyKjID4SV5P6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMKIdREhAC1f4dzMVdsaP_M1wBwGOtBUN1GcyTzgZkjA&oe=6A5231ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1L7Dh4lVUEQ7kNvwG9HteF&_nc_oc=Adrn5lvjMzE6-xkFuIPTsdZHQhhPojzHl7tcoAjLIMVMn9AtwvfBYg-8nJMuYvuvrDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCje8GapAEEyNXk_qHKLgdVoMwHF5pLB4m3FdItxp9e-A&oe=6A523533"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uyhn4E6GDsQ7kNvwHsZSZ2&_nc_oc=AdoYdxPMrlZ7mYArqQ1d2A0a6X-6zV0etKQXLsfn_7lu7EXPO7axQh_SuETNeYeXr-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5S71JGxdLX2K9mCdIeM4BEGG68mLPiUCir-vHLWeAcQ&oe=6A526083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pJOe5MJ1h0Q7kNvwGmXWxH&_nc_oc=AdopiaD3r2-Mj7tqpXVjOs69AmIzbAeYFhbC6TAoEX2spywU9TJCmZyjqNgGVDk_F2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcno7l9EqmbGI6lPePL8VxoFnuIM0P_8a9AL-nx1uIgg&oe=6A525738"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
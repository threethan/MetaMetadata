&_nc_oc=AdpeIzyFDQznj0vjPAxagoHGLN2LXBKBx3lGL3a5G-ZXrS8HAEs3cUBVZiC7cqzeEfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKpksrEyGpb2WiaoR3MKwx7HplTXw9HCSSe7g9eRs93w&oe=6AE49187"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF_K07rb7lQQ7kNvwEk0ftC&_nc_oc=Adpua5LLsdKayt5-9dhn0qs1nbjGPKmZgLfTKoAC-No2fa0SB7-INi0jmgumcLAR9uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgQjimiIqeIaGJwdSHlSgoTL_M0Li6-9FibeRgrm9o5w&oe=6AE4C0AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIZjWZQdvYoQ7kNvwF2wje8&_nc_oc=AdpudBzXGtWfTrx4xwG6OJFdPm3bHF_hnQNX_ewtDTS_r-u4Fey2rN3G0B4JEW44Dik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqhaC46UgxdzUYLJbrwZo5jOKSj1rOrFZIpcEl9QPQ-w&oe=6AE48BB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsjVErEEMSsQ7kNvwG3HFU5&_nc_oc=Adpc8vOPSGGF0-Eh7oOuw036Spz-uY2r1ZQi0dNEsLQgCnTUvzdrqrMX67h3jZtfAZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeL5Zs1MCa_BT4ejkAeGW3MwSsApsnEtZZKCtT8kmBQQ&oe=6AE4B703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l16w3ybqG4gQ7kNvwHm2oJb&_nc_oc=AdoOQCC7r0o1MnlELDQ7m71mceh9pgUNQyUURyHtfVvHmtgGbjt_58HQVz6vrRjToB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp5fRWV0FGPbQq_rQNMFbvPJnDJJwVkmJHRpZbxbBjTw&oe=6AE4ADB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
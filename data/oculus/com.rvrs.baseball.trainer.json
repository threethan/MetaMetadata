&_nc_oc=AdocoawkQUFu0aj2bSBnImjaWI8XV41bGnKsqGYfcLxxtipotqzI65iKUdO_930UJhU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzpN9SfHC0nZXlzVi8eZgkMHqaDprKnyT5HUS055Trtg&oe=6A942607"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOxdKtnc4JsQ7kNvwFG44QP&_nc_oc=Adr572DCgD37COd40nbFMMyCTPq9hTRjM-KVjzUi5RGlcujERguUsqDC1a4ANoH-zh4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPItj4VXsPbocimXxNU_vtmHSmX6CUmPTCH9xiajXInA&oe=6A941CED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3vdIzPWMTsQ7kNvwHWpmiq&_nc_oc=Adr89vYnUEGDOol5gsUfRpbWG5YOTOL7bAlmQ67jPyno92n0DV0q5n_r1oK6ZL4Rx08&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFcX-khAkLbr262QCGar1IxgUq0ZPwslsHOlcFB22aHQ&oe=6A942033"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uHkislCawcQ7kNvwEhCsj2&_nc_oc=Adp7M8bk4StG95vjMZuFfTAdic5k-ndM2fyIrZA9s6J_86Bm9iNmEV5bnrFQViHEo0Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHETQsOQFLk-U9piVqyz6KbYXjGwDCvij8eWx5UISJyOg&oe=6A941343"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzoFaWAC6QcQ7kNvwHlkanh&_nc_oc=AdpNMP3Mz6i_S6UbSP1HnuQsWmKh-ubJGD0BmoPk8RUxoFmFkiXlF3fQfu0ZFGYyhHQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQOkpr8Aw9grYZJaoBtcmdx9yIRe1WqJhv66lZF-8Yng&oe=6A9409F8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
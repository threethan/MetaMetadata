&_nc_oc=Ado44P7eMRdFW5cY4WLIxmu99LmDHRHy8qYu77R8tYwFLLbA2G6ME3ZGGKN9HiWWkag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_abz7tfm-o40etV3_indB4VF3kyb9eo3oXUS4Mi4K_Q&oe=6A772507"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glEcZTZqQ4YQ7kNvwH2BM9W&_nc_oc=AdrskGgIEP06gcgGM1WlAL2dHIgyGvTvxOBBUVJFNSH4f9xmU44jKKfH8BaBgquih-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH85JH6EBJht2i-vvl6H4zMJUEY7lMHpPJNtpW9KW3xSw&oe=6A771BED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YU-DaDmbxlUQ7kNvwFRvEvk&_nc_oc=AdpvsCLGUDsz397m5QBUGCR8EO5iu0LHIEmYMW5UAS67PpRM09RsyihbkcdGcO2Wxzs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_m5B8vcHsxOxc5Su0g4EAujYRRR16Na5u3_Ymr-awWg&oe=6A771F33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADmUKREE-qcQ7kNvwFC7PgN&_nc_oc=Adp-BoQbPD8bPZHRh9FjWiwK3a8PEOVU0DR_HmMjRhBtsDJPEywwDUYG11QjN4fRrSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbsHXOqgBxVdm0mLFW3aSDBQoMjoRSOOthcpZW8i7A8w&oe=6A771243"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wtb18Jf-1cQ7kNvwGrobwO&_nc_oc=AdoX6AKRYuIlwuyNyqGkZYr7swbNKXm9AwZfPfzOxpG-s5A-jlOQzVnFkga_NIIzBkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFR4JsTqKPMJzFjc3fsc4syCAKMusJnqex6MudAjSeYA&oe=6A774138"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
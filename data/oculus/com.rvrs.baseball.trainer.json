wH_Sssp&_nc_oc=AdpDedxjo6K9A5TB1iEPcGO4WsLpwyQ52ilvazwUe3XsJA2x_UEii9D4EtY24Jpfv0I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwx8W7JF8_9_eBT6gqi2mvksiCZ9HAPwM7lh59L-oCRA&oe=6AAE8407"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-CPekmm7-cQ7kNvwHTPRXF&_nc_oc=Adqt8VvUWMVLUafkwpxkRhE6edHzpzRCxnk6pi6WzH_9a1evVzaOOUQWvHwl6rneiDw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoNhncYSDkCvW6gmm8wM8OrLA88tBd0pqShisniaKOJA&oe=6AAEB32D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cG29dLUv1sQ7kNvwG9tchf&_nc_oc=AdqhLV3ELv4JsuZIH9GB9GN6QBA0TiizcA--sre5IGE1B0FtwdMPEfx2QP-N0BCiqE8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-rHxAmS647W9p9ZmuBkE5LyGm-xDR1SPb7g0fdq9bRQ&oe=6AAE7E33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ0NqKy5qWYQ7kNvwEuu3XD&_nc_oc=Adp26lyHBlv0tSc7d6iDbhNPz0xn-_8lNWC-m5YZ_ZWnQOtc1JNx2XpF2LbJblzTAiQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJshlW1elx0qnz-_MLk2_wyAGbXaK3MK72naSLK5QSsTg&oe=6AAEA983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJB3P3WcL7kQ7kNvwGAmrio&_nc_oc=AdrgBdgJF5dl6GOtp1cimHRQ0WrebB5EgvYPOh-tu0X2WlGqABzYJeKh_YBNCwhHTUY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFofT5ID07x4lIFPl5pGidaVZFKpYeJTHl8VQ2-1DmKw&oe=6AAEA038"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", 
nc_ohc=ZarIq534a64Q7kNvwFIQh2R&_nc_oc=AdqMjTDox55yW3smDyc-b6ZbLWnmbmU3thXyyLdXLeB8CEX5i6NHSRkJ2Lu0YmKO1HM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQho4Zqw_QGWV2zeTFENUtU2DAXsjae_eR631RMwtpY-Q&oe=6B030983"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjNUBk8jwroQ7kNvwEBCjo7&_nc_oc=AdotDcIspS-zt-QHFzxfjCyi9qbuDm8HGCD4W7FvSVSO9YCdDu-4ivRKmy5hZnlYEo4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi2YDO1G74ejRtP3SYH8qCNn_b4yISiMd68h_cGA02Zg&oe=6B031673"}, {"file_name": "screenshot-5.png", "id": "1190561018044030", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_1190561021377363_5895612526815394834_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YxtLnS1gD8Q7kNvwEv6-Qt&_nc_oc=AdonOhPfMIA6LS3jCxGpOpbW1hLkxl_3aK5I7jIq0yHVoBhSuU9S2hiu2ZgGvfbrUCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzI90ruyoEB44znLhNLClTA218zIG9g9g7EueZKR_EXw&oe=6B0316B3"}, {"file_name": "screenshot-4.png", "id": "922875505215237", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNZ-gnIm42cQ7kNvwFOBEk3&_nc_oc=AdqQ33Bakg2h5FvjgJArXsagO3O9HITP61ii3Exf24ilzKJupTooaS6q6hAkOHKQnes&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0bN03YVhAe8ocicznvITohaGXT8Vii4s0iOuN2DAHyw&oe=6B031C47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "783288508992812", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_783288512326145_7599899629745698022_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLexDZO4SysQ7kNvwFJvfzv&_nc_oc=Adp7MWysv0_IcshEfXUzmkJoof-pnkLoTS3k8xDTCLOvE4DOmBzUEkrLD2Nwkyyb6js&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9Pc-_SmZgAtQurvTUeDB8_xBGnKvxjZnOjKVYH9HLIg&oe=6B0332A2"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
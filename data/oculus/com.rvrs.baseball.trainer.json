&_nc_oc=AdqlkOJedmTds3_s2e7Zv5g6lOhvaMxQOkeX7nkv6tONF3ml2zcQmD3ESqIh0DzyWbc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7ymZ5qL3GL1YUJ35iZd-W3jSpoUAmJUX58qVz51o7Cw&oe=6ADDFA07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYWK3jHvSqkQ7kNvwEf5LGv&_nc_oc=AdqzJtB_GKbBts9ec_uZ1mXzq0ZVGWihHvYH2sQc9Jkx3hmdB7nBqBnk-bACpUbN2Lg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwd-3KdRqCnLhIPljUH0QAZmnuZcUu2gTicxeP4Tt19g&oe=6ADE292D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOUvOnWVQS4Q7kNvwGDQRCq&_nc_oc=Adq_jiMouj6rHNN7Y2AIK8EMebrFyYAxNpYsP7kFqb4wgV-app3FpUdZ5drPfAEHY_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2-bLBgphFqsSvlIP2kXijOd2RlVqSU4W_NxvKcAuwHw&oe=6ADDF433"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-YLpY9WjD8Q7kNvwFkXsA6&_nc_oc=Ado-_OPnfO6gt9Itz0ZmdBxKYjXtKg8cy3rM4vEtFz1PoS5F9q06zGWTxjuKCfFqyLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdJSttXl0vsSitg2sGPZmgIbPrZuO1JoJQILBxAWgaXA&oe=6ADE1F83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUQ6wB9AShUQ7kNvwHu1LDU&_nc_oc=AdoqUSkCCXBSfWG3IKgixfBmGQQofVKikTPUkCXBcVGuFqK1vJVXmOKr_6PTn8nd8K4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8SkVzSpDG9ufKxZd5I_yPMhOdsxyF0S_H7EKzlMw_2A&oe=6ADE1638"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
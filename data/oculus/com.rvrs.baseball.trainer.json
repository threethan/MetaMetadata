nc_ohc=ZarIq534a64Q7kNvwG1Vp3O&_nc_oc=AdpKftw8RuGRzfs0_uExFeMQWbpvbpeGcIUWZ_coAue_Et7V0NV1W_KnZ_9drvRxLLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS7VJSyNSH3I9LTUZgf6NZipfrCvqPHHcD29V1Z6r6nA&oe=6B05AC83"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjNUBk8jwroQ7kNvwHTs8Bm&_nc_oc=AdpdJNsUWdTDbtgfNTYemZx7dlKfVNFW7ztPH0QNClolrBLYl_le8wN0VHV-tZDBVpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNOEnTkE0DdGoYGhS9Du6K23vqd70TuHRic2vSoMpKpQ&oe=6B05B973"}, {"file_name": "screenshot-5.png", "id": "1190561018044030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_1190561021377363_5895612526815394834_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyzOaLhtDMoQ7kNvwEoH4ad&_nc_oc=Adq5AX0Z2H6ucPWgkn3n2LZtHqD0PYI5_xdtFfs7ev7nvxqpLPXYPq4eQwEpVgdIUzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhU7AHOueC7TNes42naxNENnEaxAoGY037OqX46PSlGA&oe=6B05B9B3"}, {"file_name": "screenshot-4.png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNZ-gnIm42cQ7kNvwFKsAuR&_nc_oc=Adp0JeNOgUe3L2ilK9d14IyQY2qmux0hAKgxW8hfKDoBtSD7kZ7DBC136gTxQNyaqM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrg-_22VqUjVonuU1o4ZLAHn0BU-88CA_PWaXRJG-VKQ&oe=6B05BF47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "783288508992812", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974631_783288512326145_7599899629745698022_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLexDZO4SysQ7kNvwEZs8Gn&_nc_oc=AdqBgH54dPMFhZDfU_gQxHswSlWRPNRBlDeW9OXAtpZs8VUhJe_XkBIOaJMgxxD5EaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdslaYntIvzyrb4gGaHJcFTyufy1ge1JjrlOvjYjmUpw&oe=6B05D5A2"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
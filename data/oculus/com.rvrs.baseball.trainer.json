&_nc_oc=Adri6T8FfBU7swuGNkSL_ATcdu0qyPfiik76JPml_FFf13pAEMdlGITn-64O2XazjbY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeNMlcEoRP6Sbu-MMfDmtqJV40LFB_iiGSPRymHzYi2g&oe=6A4E4687"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A20IUVHZV88Q7kNvwHN3C4I&_nc_oc=AdoT3CRMlo6pA5IAQHl5cT6wbcOrK5eFMCV4D1q607B0SAxBc3ER49dq9yY4MSE-3zg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnZOAB0hE7d2KxY--gQ-xoKYpG_SY-pCQ6wcCAa391dw&oe=6A4E3D6D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0etPM9oXyRwQ7kNvwETbXbl&_nc_oc=AdqnS-7w_sEKoOy4i9oveh2LaEHjo7m9HXvFygjfaesC8HoDgsyVFkzUhx2VHQoKVZA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC27bZU0RRYNTyDYjvVm4cjTdDSplOiRyW9Q3htUUUhEQ&oe=6A4E40B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6odgkABvLu8Q7kNvwG1tgqS&_nc_oc=AdrgDt2IzjTuOzppo6f_hZ0pKb-2D09z1LwkoUq5tAVwKEropxDzXqmS9L1LCAbEjuM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYaGxLRvNQDaUh8mPrmkIcWqDFkG-JgNnpNYMojkkU9w&oe=6A4E6C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKCMO7s85TsQ7kNvwFB6Okc&_nc_oc=AdruR7QpU7WrIwIF4pQ7TxRDZ4NHKtiLnjUaSlz-yv6Vmntbj-TXwSRhU9p1-xq_tnE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmpLnuK2XaUKeBfuYr7V-TasKGKran4N4zqaHejxrwsw&oe=6A4E62B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
nc_ohc=8albLMxcW8YQ7kNvwGUA-js&_nc_oc=AdrMmMOVdqkVAp8o09lepa3UobadlkpTa5BxBCRiIvagbnVHL8e0CFI_T9Q7AduXw-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxAJPXfWuYBagqcBzKpY-7xavA3asyFcO9lSlbkOplIQ&oe=6B0F1F43"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JNPnz66vRgQ7kNvwG58t41&_nc_oc=AdpTE4qG55RVx4wO3HF_ZJjfl9H4YfkoDg5XakgA688Eg2ODvtmb6vTpIL0Ur0qNJgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUOU4lWgC7xpwKIFCSj-y_XQbi2-p_VJHORLb5tKk1n5A&oe=6B0EF3F3"}, {"file_name": "screenshot-5.png", "id": "1190561018044030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_1190561021377363_5895612526815394834_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WokhXgtxL_UQ7kNvwHMla3E&_nc_oc=AdpPH4gTOJFtuE2tAU0ZZqJve3uwaVBCnNlKS-IXWw5uoLVn2mp4FrxZCp3KM34NOKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMAC5AN-v64XTp0FoDBy5kcoAtqDqNRFrGDF_-Q2_aVw&oe=6B0EF433"}, {"file_name": "screenshot-4.png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S9gWiIyAz0Q7kNvwHFF2I3&_nc_oc=AdrV5E_T6pUsnsX5oBT6fR3YmL0nTIMUIrK7cd7Af5HNoadmMB6aS2JBzdG4p5QXSlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2sxduBxr2fC5l0qu2OAJjPzO7Sy8rio3AoR6qE-oC4w&oe=6B0EF9C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "783288508992812", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974631_783288512326145_7599899629745698022_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UXP025d1AEQ7kNvwFG1hmh&_nc_oc=AdoaVSzT8XcSarl_Ce1v2_ohAUMJ0_IzGoe566X6oMtcYTWJ_U_-JqEDc_JTglA7m0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvo6YxpmesSwtspXMUAP3je4sotnH5VvjlsaWDypx8WA&oe=6B0F1022"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
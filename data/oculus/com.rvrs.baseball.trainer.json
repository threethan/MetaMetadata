&_nc_oc=AdoL8MAJoMBWTVCFUx0Cscu3bqRteYr8oTCFzTbqkXe5euhHHWZf5Z8LzgI6Dbpfdlw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcUnzOKc86e81yerJahO7Mh4wh7RE-VdQU53tJvkngSQ&oe=6A54DE07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRoBWqf1ZIQQ7kNvwFy7Zsy&_nc_oc=Adqvn4yTGDwu_vwEAtAB-YK1Iqc86XgY25Kw-STBYSlJVb2YPRl_fcnPbG2Xyx0cdNU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpzYmrb2WmBgkRs3UdHq7gpAFHwuVk3I74j5AnrmKHSA&oe=6A54D4ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB-8I2A8wjcQ7kNvwFoyNUB&_nc_oc=AdreBdGVzWXqN4p41-U38gLUirjSe8QCMvvonlK0YegXidbO0uwfoIg5q3r9dbPzfsM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTpS1_UBjg01ii-vGj2i7ixQDKWysie9t_U8CQ2bjxBA&oe=6A54D833"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7H3k_EfOgysQ7kNvwH_Jp5H&_nc_oc=AdqBn7qnaNwdaIs4u9UEzu5cMtdfk-Jd-REhQHwFF642kW5Nv0aI9rmDcnukXQhO5K8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByW3EdtLEueMGnwNRtVF9ubejdS63J2507Fro6oMoK2Q&oe=6A550383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us0ZvJn817kQ7kNvwETk6tG&_nc_oc=Adqa3Vtq52FYWNpyFNQOCctwHgwpL3gPG6XNDUP_BmrbW5YnHKzhg2AnaK8XyrEY86k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfzMbSDY_-15NjWcjSbwgT01qu_X4842C7_eRsdMh0Vw&oe=6A54FA38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
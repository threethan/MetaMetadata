&_nc_oc=Ado0CEmNREzAuVzllTXqTIYyN9f2lxX2lAMQgHHGAcwlduc9J5Uth8lOBXMVhHk1ACo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiWjcBFtMeWZg3F-nWy6Hd4mHtI-Tm0RPsKq84jsLGQw&oe=6AF89047"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL8F_TIxtAsQ7kNvwGSrmjs&_nc_oc=AdqY0VtZNhWu-RnPM373OFUKH4fUXHV59dbNR3ovEB6aNdOAAuTcZaardr8ToCFsxDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBSS_GFvDQBu7YLHNeTahlesgZ4cyC7YRayxZyFLDwPA&oe=6AF8872D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA8MEma1ItMQ7kNvwGYXvUZ&_nc_oc=AdptmA98alwFZ5HjBNb9uIuRlC1d_Y7CChHMO2-UBpTKxDesuOIO06f3CFWpWpP-h8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuG-4n0uokUMNCxLeyrcPc6MNR60lxVquHcmZOCcIJTQ&oe=6AF88A73"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjQfvkvJ0pYQ7kNvwESGD6y&_nc_oc=AdoUxBUmaH0tJdXZuJbR2u0xmRFSwXPsc_yOOyVLyFa95pm1Q1dK4CZ2KPvqe6aQ6rk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMCmR0njl64t_GxE9lbvjdiZcqwmU2qfADao6TbWRnvA&oe=6AF87D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2op3jPTq1AUQ7kNvwG4lqYH&_nc_oc=AdoAR0hQTDH3LxieoYRkAuU4qvCNRbS8921wthmxZA0d5pLI0v7MZjESTOyRGeXI0uA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEtLtHZRGlysMgoc0ywjCTjJy-BICytvVWC5qFm8jSXg&oe=6AF87438"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
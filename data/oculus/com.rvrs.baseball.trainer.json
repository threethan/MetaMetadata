&_nc_oc=AdrTTI_FP1GrN-YtNy6oRQsMYZjUw2bFan43OiUN38k_zj2axbtuvxDVYQbA3MfMpa8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtb8-fqePnTYjx3hJtClCYAlNLsnQHDs4K6_W8ZQwYLw&oe=6A50E987"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A20IUVHZV88Q7kNvwF2RFsD&_nc_oc=AdpqCy_BU76KHGZPbTJgutr-QZ-0TW7d_Jl1G9kH1thbE8ztoRBh3ZaGR1YqUI3eG6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvmtINRqIiN1A_yIj_sip4vMJrlBkyAq7aUavjfkunAQ&oe=6A5118AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1L7Dh4lVUEQ7kNvwF39p71&_nc_oc=AdoU49Ui5MCRcMqlSVYDb3uC6fXQQsItab3VWIX7usxEMSKi0bBwmO8FZy57YDeEnJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcFJzXb18Dp2q8wY053Lm2pIH81Kz1roTJRHxKVdug_Q&oe=6A50E3B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uyhn4E6GDsQ7kNvwFqaTCf&_nc_oc=AdpetRFzuDl1g6CrG7kIvi1QmymfzE8wYIrtIrfC3oY98qYjMTxabg_htlgLRBFQmTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCVNbOsCBHW11MCs6rmqWCopGjKtA0ZA8xQCh_fUcung&oe=6A510F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pJOe5MJ1h0Q7kNvwGYgJdc&_nc_oc=Adp1MD9IXGGCCZo7py2kuAKA8vpuf5JXCsQ6HY2DvDGj2lElcs1sZPP0_vxS4_8QzDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkAcwaoUmP1y-ZdHxcGL2r38p_Y4fiGsgZRFMQynfQDA&oe=6A5105B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
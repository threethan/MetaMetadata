&_nc_oc=AdoN69o-bt3MVw6LjEFTb6EbIbUC-iWUT8XffJwq-HzeD_25-q3_EzJY5dPm0VeQooE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0TktJoEKNG6QnA7MmPCN44ivRrWuUTEaI6ke631rg_g&oe=6AB66D07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3E49QA2qTa4Q7kNvwGUMWEZ&_nc_oc=Adru85GlBFjp2_C-_2WzkodJtzweUzCQuhaFLaIMDBK7MrAyHdLicfnRdm7s7j2Fd8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjWl55Q667kVDDmneCEYT3Z_Vej2rpeRCmxstmICkPfg&oe=6AB69C2D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcZ7uFc_Ip4Q7kNvwGWwNw0&_nc_oc=Adqc_d2OMS8RO67TZa2FbNL8Xpj5FvTg9o120K0Q1AJckDxdir7AkSQ84rcF_G3Artk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_1i2xIpu1qXUzvc3EK2AoLA3hG8JMm_6d0L_L9nMFuA&oe=6AB69F73"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shxvzKyxLu0Q7kNvwHjdJHD&_nc_oc=Adr5VuCyFJ4vWkycYAdfgeHBoanTeJ2FNB3tvsfhsRmGMrLlQKXaC1whzJHUfOApvt8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRsofP0-rs8QhD5mlBUDTkk_fFk7BL7iyVPR2lGaemfA&oe=6AB69283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwOZPvakA-4Q7kNvwGXihSA&_nc_oc=Ado_s93ST9oWcPFt2BOkZmc1V1Xj8aJ20cXVvGyTuBWg-DpV7RjLHIyDvpJfriJOHrI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQb0N0fQ11RRa9JqsGZoGr_uYCvwiz2wGO4O0kfr-kFg&oe=6AB68938"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
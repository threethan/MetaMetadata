&_nc_oc=AdpBPqv5jDBy4bzXCDrncEUkqmjOSFneFDZiD2JzBBTOEIAuavy_gcOYdO0JStFe32U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtIfSbRnx3K5NEouHqbLhawkU6JbEhvJV8nX2fpITe4g&oe=6A490087"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD3bwHmp0O0Q7kNvwE1Kyv3&_nc_oc=Adq8ypUTYi66DShLawcSaPPGlkPV9V7aQZ-ZYDnJ1U18eD1IKbgLNvDumPeiiwlDyDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDABRoPv48Io17JRmbrtDmXp-4kX5-dq51QM6K9NO0RuQ&oe=6A492FAD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_HoAvg5MPQQ7kNvwH0n1Rx&_nc_oc=AdpY2muNPBVWY5c1b2xoyNK6Vqpf_RAZ-XS4O6LagHEV3PYgY34xL1UeINfumSPPbw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc3APeEYP_bGkwGlxraIKddP4pWHKzOY-F_KuPe1zKxQ&oe=6A48FAB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYNm2KPL8qQQ7kNvwENLLEw&_nc_oc=AdrZcmrxiKJSE7VAbuOgvnJlvC-y4a_gDE_EHWCKv_q-VW2qSe6s88PXUXzm4dMLbjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFB9G1QWh-qlTiL30cnwMUw5A4v5UuBa2KGHRJav8YpA&oe=6A492603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gve1IMlGNQQ7kNvwEZllb6&_nc_oc=AdrsN-eWH8eVNebK8Ch8qUJVDi91Lodn0uQ6w6mGNgrRWgN4rsAXbjPyOwCx2aGS7oY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk1NRq39NlJEQvlJR5IQJwnp5A1ydCEDlIJ4f2QRMdBA&oe=6A491CB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
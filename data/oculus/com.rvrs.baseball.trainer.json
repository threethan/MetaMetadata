&_nc_oc=AdrTo_9g4sT7dKq1FcUI-rtI5pNA9u571gs_bDVI9FOr2SlfUK7LkgE89yHcm4Uc4vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiIpVU5mB5yzrR78x708VP9mdXX5rsBLGDa0HTqY1XTg&oe=6A787687"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glEcZTZqQ4YQ7kNvwHMoCU2&_nc_oc=AdrYJNjXwm0MkrOG7HjEeH8lGfB2g3O849iX2PQzKaBstcbFDDM3OG8EU7UrCXVxwKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDwr4UuSbLG93_pP1FLZbebGRAO9sxeXNIb9KIhVUdWw&oe=6A786D6D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZinlE_TgPa4Q7kNvwHzNLI3&_nc_oc=Adpk6gyF8M6sr4O57aEFaU0D0kzXQReBgdVvqM9p1UxLwZQSouItx4OHr1PR94LXjjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTbZj1q1MZjK8QC1VozqeCdMWxgn_CASgSELdoK5Gu5Q&oe=6A7870B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Xl2s1zWkoQ7kNvwG9ZHA-&_nc_oc=Adp7o2VQIo_JEmVLf7UPZSSTDhfMNJzaZ2KVWj2P2ctXFYUxuPTGnJnvXIznWk1AzeA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWuWDN_O9DzUzF8UPRd_Jol_Cy0p8f4dz4A8UmDKQ3NA&oe=6A789C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wtb18Jf-1cQ7kNvwGj2z7-&_nc_oc=AdoPyybmsZesjYPDmmICNBZzZZ0zO0-cI2OKGel7vQ78QAnYSa58_8ZnPWGnw4tp0uI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGrSp3PpxM6mxCWAs4x9AgsBWxMGZBmBvCpoRqpgN06A&oe=6A7892B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
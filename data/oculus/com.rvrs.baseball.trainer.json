&_nc_oc=AdqOrKOSVNIkXslZC8tiolOcq8m7e6I-Dp3x8EsdzI6MwVrl7m_3nFljXJrFzFS6FG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD_vpWxW6xdIjVaLmrGbQOhzTS-H1Gy6z75T9liGFMdQ&oe=6AB7BE87"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3E49QA2qTa4Q7kNvwHDCz9e&_nc_oc=AdpVEaz-ZXuAVhXvCd_6aeO9UIvfHzvdzrISbz1ITrpd4S-8r8ev9qIk2peaMuP16nY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5K7aGb_DY1eqObxIW1tqGbCUyb22s5at2L6ICo1aTlQ&oe=6AB7EDAD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7QSlvA1MR8Q7kNvwHzDdHb&_nc_oc=AdpZoT1wsvMYcANljxeuIUDbz9GhWblYb6DG_P1NcEYXiUAZxeeJe4Z-RfENs6fT6QI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo4N4qCoYMdM5pbARhN-FTTv-hd9XyRdn2kKOJ2xlw-g&oe=6AB7B8B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfqmeC0bsVMQ7kNvwHIbH4s&_nc_oc=Adp-Y3oLxxnWOVWKwydnwHwShtndK9IdPWKfEFT2xf0MuXMV1dSqLeNf2ikS7ZOZ9Fk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF_FgvzouHGYQd4GlrGuruOfYFBOnD4M3LuC311T1Glg&oe=6AB7E403"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwOZPvakA-4Q7kNvwGYwFp5&_nc_oc=AdorCufuD7gEAqV2cvmqKHw8NjuzG1oXZyKxBIwtZozTjhM7p6OtlizbOBZ-IND4lu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf1OquPQRMXI8rgdbwmdDkeSP4-Ld3jb3RxYsznabl-g&oe=6AB7DAB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
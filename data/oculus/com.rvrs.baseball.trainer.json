nc_ohc=zVMJsoZvdzoQ7kNvwE2q9Sl&_nc_oc=AdqJSW1Rtrv2Vp6mPYNdenoTgF20Pzc9vMgxeh2v1is__Ga14BU4HnRfQxrWCJdczE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQk9aWUKdUKYy1RKC3uPxnW_mvmPaqimnIk8CZXvbVwgQ&oe=6B0DCDC3"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrpvV0xmoR8Q7kNvwHCAuDO&_nc_oc=AdrOEn0gGTXFczEqaznogBipnEv2SsKOhN-ExEdqnXdRx-iZrWoxn7Mu-85UC34m_UA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjCAE14pOZzR5sHQM-hnJMwgifgJ4wPD3G-WLb5Zt10Q&oe=6B0DA273"}, {"file_name": "screenshot-5.png", "id": "1190561018044030", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_1190561021377363_5895612526815394834_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WokhXgtxL_UQ7kNvwFJ9CLf&_nc_oc=Adq1SpEaswzNBgeJlHVdcVFXgn3v3Sr3tD0oixucAIffT8EEOkRk27YFa3QXHOwys30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXink-S6IEeHHnjl6NBTtP5sGhTGV8dnsocWVjmVBBEg&oe=6B0DA2B3"}, {"file_name": "screenshot-4.png", "id": "922875505215237", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ8n4ftP5U4Q7kNvwG6RcIE&_nc_oc=AdpGF2E68UJWBzubYzYUJ9uAGUEg1ad_J-hyh1op3bs_iqg_t9EepZUo8dL3Q65DC7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdDEtVCJSvbe_C_ylFtb_xU9bgps-Tqo9QwYypuJPz4g&oe=6B0DA847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "783288508992812", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_783288512326145_7599899629745698022_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TJSXpN2lzAQ7kNvwGUy5WI&_nc_oc=AdpB5qgkhXt8KVpFzNKxT5jssapBMMp8-H_SeQK5CbAcbm-CQ9_hqgSYih3FVx6auTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5DoajvhdWvF5022m8QGPhc-yfrTWQafinER9VtMXNug&oe=6B0DBEA2"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
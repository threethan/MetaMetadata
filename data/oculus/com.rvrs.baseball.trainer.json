&_nc_oc=AdrpPIKvAZp0eTDASUxLrNVJKhrJjUz3WWfwue5Zvk40fe0suW7On_HjzhdZGjxFEVo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmCKEYyb29_UKl4sxog6DyvZ5QD1jJQrqbrnb6YPIA1w&oe=6A71DF07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWx84HyWYu0Q7kNvwHaESmq&_nc_oc=AdoBiC99iz6SPo2R2Tl6IKbjWBXsEXkV69rlj6m9mp66V175Fzzuaa9twwsFquAqTsI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSdowhcGAOTiE8PbxDUh5ux8wL8BDjjeXmJRd33EtKfQ&oe=6A71D5ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt95XZOgdeIQ7kNvwF66s5w&_nc_oc=AdoQ5MrAsBRvzC-Hw1MoQ6agf0uNGtlrHnt885Grs0eB6xvdEBtpMwFJrRJHV5RUujc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM6rtV0D8UZjEFeOe0eRaQTDdbARH-ZKI4Yza0rMfcjA&oe=6A71D933"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpSlF82kYsgQ7kNvwHHKsLi&_nc_oc=AdpF_MCH7-wUVp07vTv_fXFbjKAJ4joL4Hcy5Dmtaie73z1geGCsYLBGXoTtRig3BMs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc9-WnZRRDAgtIkL84q5J5zYxJHzs3qmVXaAJxRQgsvA&oe=6A720483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6NkCHygf4sQ7kNvwFAZeVz&_nc_oc=Adr22_GiJhDugEmV99YrcJ9iudjXFIe1m8QNmIxXAkavVKyTZih1bJtlLHH4wb3pw3k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs3E35ybGEOu9tRTnLMoUHBLxUR8NVltT6W6DLiwnvWw&oe=6A71FB38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
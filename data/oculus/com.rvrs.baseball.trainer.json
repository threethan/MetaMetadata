&_nc_oc=AdrdRiqytapdaYVdwZCaz7hqaOPjQxwbglFr_b-PzgSSKCT0wnnMVb9DwHFIB_FjHIA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaa8wAPTDBnHaa6pJUQGeAjrdwVsjM1BTO5FkXUBryHg&oe=6A918307"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOxdKtnc4JsQ7kNvwEbsaQm&_nc_oc=AdpcSJVPmMoLWFnhDI4HjPAzrjHpq-ljYWvTCUj7moZEyJrjw-s5YqI5qU2Gv7Bp9Io&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj5cE75TZg2t9npBEZc_FBNb5v76eDf9Zh0rj7w9w7jQ&oe=6A9179ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOwHXvdTAdEQ7kNvwEczkm_&_nc_oc=Adpuu98ruAWjfiExNBbq7eg13k1zbVelMgqg1ZyplRf_NjAfRGA0-sF9qEwNBdRrfrY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiILFI9Mm9zuW8fMDJS2_EdMhSbVaLUnPG78hYuGB_Ug&oe=6A917D33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-WIQPen_ZkQ7kNvwEOVgJ2&_nc_oc=AdrFdCSq75Yc3zUdx4Unim5xYgcm6OSx4NR5V7LpVoG0ukQuuYWDyoLIz2UeYZei7Nk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFJwPeP8zFExTNXsuaU1cmHLCN8TY2Vr7eIrWJuqZQlg&oe=6A917043"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5TvPvMJ4QAQ7kNvwHt3VX_&_nc_oc=Adp7nK6p4n3ZJl-Q9EFyZuyFjKms5Cit2GBswpJ4cDw25gatUwWBwBjRjTmAeyl-48w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE2i88xSudpMLw8xSCNg8L-vA0b14iAnOArX-vgU6Pfw&oe=6A9166F8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
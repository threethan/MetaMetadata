&_nc_oc=AdrPHUTnkobT7nMRs60gHYE5sFmlgRBAueYOFs3a3OMKJ5qOvWCrkATkWsJ4RqOHvKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6WDma8LBw45pND9fhJqwrE1tvslpusqjTW93yDSS4dQ&oe=6A5E1887"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmr7QO3g9HIQ7kNvwGF_u_Y&_nc_oc=AdqF0udkjwzA0tsml0Wj2pl_ReW2N0XFxlgCNsayDD9n34pZgZdRHqI8_XyG0IRhOaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbH9rcDFc19968rp00QCtmOrE-5QxVzJrDlNSkPGWnhw&oe=6A5E0F6D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_eXGtHfaFoQ7kNvwEyqPV6&_nc_oc=AdocVQXHszT_vnTt36BKsdLOK7ivaY09n24sPkQa_LoRKSYXTI1i5A8hZEhG-qwqvWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl3iVWiRst1irB0ovu3rm6dSdegH-ibk1eStbDjf-1cw&oe=6A5E12B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDgZLsmLKAkQ7kNvwFLZzfP&_nc_oc=AdoZLv7NNBKmtIR0SckDShw-VIaO7mqY_el7GDsMfwx8X8Hz-lW01aAthIpmS1ALhuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByxwRl2uCSbl4SfOmriu9PwTgEniYNQhgj0mnETjoPZA&oe=6A5E05C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0BAxnXgyrAQ7kNvwG56sNH&_nc_oc=AdqxDA8hn_u1CEHk-FtfhW2NhYhr3CjuUTKtqufRxFV3oF5RS-P35V5AVlRre1OhK4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFUBFR9BpZ5VZIMdOf2Pm6Qqiem_KswjMh8PBCyFxZ7w&oe=6A5E34B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
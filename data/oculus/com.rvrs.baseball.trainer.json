png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNZ-gnIm42cQ7kNvwFKsAuR&_nc_oc=Adp0JeNOgUe3L2ilK9d14IyQY2qmux0hAKgxW8hfKDoBtSD7kZ7DBC136gTxQNyaqM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrg-_22VqUjVonuU1o4ZLAHn0BU-88CA_PWaXRJG-VKQ&oe=6B05BF47"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fik6_9N9J50Q7kNvwG_Dds6&_nc_oc=Adom8c9aPeZKBo097X36KxFdLrVru_nRRoaOZ-KK3nk-Zk7p8iotP9THc0XJ30bUVIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTqAxuBs9IbQip-KyTrvYgkCeLem3cgdIvM9qHI8sCGw&oe=6B05B62D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjNUBk8jwroQ7kNvwHTs8Bm&_nc_oc=AdpdJNsUWdTDbtgfNTYemZx7dlKfVNFW7ztPH0QNClolrBLYl_le8wN0VHV-tZDBVpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNOEnTkE0DdGoYGhS9Du6K23vqd70TuHRic2vSoMpKpQ&oe=6B05B973"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZarIq534a64Q7kNvwG1Vp3O&_nc_oc=AdpKftw8RuGRzfs0_uExFeMQWbpvbpeGcIUWZ_coAue_Et7V0NV1W_KnZ_9drvRxLLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS7VJSyNSH3I9LTUZgf6NZipfrCvqPHHcD29V1Z6r6nA&oe=6B05AC83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKvvuhrR9KUQ7kNvwFs5ryK&_nc_oc=AdqX5SMbGeioDwT5bqN00wPaWKwdea4Y8ckxd9QlUJO-72AVq67UortD-l69etbNoLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4ZnJMNsgFDQPxSn8d1Hl6U792eX31gHhxxUEd87ohFQ&oe=6B05A338"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
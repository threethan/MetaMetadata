&_nc_oc=Adp9bctgxIq6CnYP8Nhu4RstbFe1WhovcZeqjVV4o2JKU1IAKtgW9uRsErcpwqMyAaE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAcNsdr_EtU3-vhUtw3vC_7Sx56oLqMBaBYhWAnxIsNg&oe=6A6F3C07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akVsMgCXZlEQ7kNvwH0ymN5&_nc_oc=AdrpCplznKRJ_03byNcJbmzE33P1Q3o9YkupqPaknXOdjDm8DLQi5GOm98l-m5kaDV4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiyA_M-jNNt6SzO7sCXPjUKgOM2w-qFDH-5wyWboes_w&oe=6A6F32ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNRRGmTYKTEQ7kNvwGKOj-g&_nc_oc=AdrX85lKraCiHD8gFPgn1XLads1_QgiTh3EdvnUZwM4VLrcovHJfV7jDrLCsD3-Veh4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfJuprpqgx0VKyOlSEuvU9vCC80uHaEFtuj5hHctCkdg&oe=6A6F3633"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N42CpydrPs4Q7kNvwGb2qUp&_nc_oc=AdpA1MFCb29I7fO99TE54BU28mZbYK8-vuejzmpgyn1Q_lrFoHcCGbAQrpjX9x-SEOY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs7q9gSxWbtk4km7g5pWb6B00caSQ2V57oRz6kWNtiWA&oe=6A6F2943"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6NkCHygf4sQ7kNvwHyt38k&_nc_oc=AdrS_Wzajfl2E_p-f4CopXLPcc7ya4hGeTzoasXvkKRZWSHyVLlZhjpSzr8qkhzLe4o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx-fsLoFwTVLhds_onwT0HMw6rCLL3RUXs91KdhyIqGQ&oe=6A6F5838"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
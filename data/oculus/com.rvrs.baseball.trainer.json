png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUbHTX8CJwAQ7kNvwH-0OR8&_nc_oc=AdqO6597bB0GhER_oDBPppeN1J9VraoQnGKdsEzbdnNrqA3X8yoKT-sl_UD__7fOh4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSINlpi1UrlRjLyYPaWx5kbXUqv9jq4BeF-UrJpZhQLrQ&oe=6B007947"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kVQRugkaJQQ7kNvwGFev-r&_nc_oc=AdrHx2Bgx0iCCvrWseFxwJiwT7cb312BcJccnZxy4dygqHGmQtruILhVkld3wtSXj00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzCjhVzRp3tFa90froy0lkNpb39YYWPN3xfeKM3HSPZQ&oe=6B00702D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpmS3TQdN6UQ7kNvwGE207P&_nc_oc=AdrlLRcjtxQHa7LOfk01G7nsV1CKlCH1IQs7eCQOEVNN8tZ3TR4sKGflwox_a7-yi2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5qnaLf_MvJ6ogF1ENs67nHSGjjMC-GGCgWQfijDzcYw&oe=6B007373"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVq_haYM1QYQ7kNvwEVgNTY&_nc_oc=Ado42PszJ-mxtoKLqNZiQjaH3SZ0djGGB7jh2hZ3HPq-btyYMcywvXVcOOzNtboZQSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVvxTUBwpcFn7IuLv0K_XVO4jRv8YheQ3IAI5TAhq6aw&oe=6B006683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-1b3xzvmx8Q7kNvwFIf7ZK&_nc_oc=AdqAppj691Nqb_aLRDR6IZgvc5ogMrIiRqgd142fuhNXk46vYEWBXtVgS7DmF7HTKD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT705SAUmmZ3hsWO0xP2y7HOXm1Ctap0S70lOkLQbaLpw&oe=6B005D38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
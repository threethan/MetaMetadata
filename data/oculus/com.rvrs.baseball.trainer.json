&_nc_oc=AdoQ8_7Td2dh5_gTwPH51ZzStmr2UhUOHTdEiKmvAP6Z-jcT0FB5KscvNGyb4JsKqyg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7JPvNtDca9jo3Ng23Iz7JB5naBi8nwbkZ3YNMLOdLDg&oe=6A903187"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hh6t6mYEIsQ7kNvwFWq2Bh&_nc_oc=AdqycXP6cHxRg-5jqig8Tiw9PeJf_lZ2W5C7tyifyEGlvC_LaU-nLosNwrlXwoik0Io&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDiRK_Ep9aK-B0RHjKGdcNiIlmP8i_veElAgA9ZbX_IQ&oe=6A90286D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOwHXvdTAdEQ7kNvwGO5ShJ&_nc_oc=AdpoWorq3G2gSfcrb0E2plfh0zr7-iWixl36PczCG6tbmHkv4sgKRIdXEYP9Za60MOg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5K9uRPIwmiRAgySrCxVOV6E31HDd7sfQCpavazT3bnA&oe=6A902BB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-WIQPen_ZkQ7kNvwF4tq1b&_nc_oc=Adq0T83k2hQidYY4u4gDkHl9nT2An0zQ_JCximwzDR7Fi8Od8ITsrjfutNZYQZwVGyw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU8GST1Pm7aJAHZPX15slAcDB1qdMfe--cE6c52vhl9w&oe=6A901EC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5TvPvMJ4QAQ7kNvwEXaDPD&_nc_oc=Adp-_KZHwrm3dfc9Mvsvjrf9BOqOWjnmu3Bcg00uNSXzYZeXkEcFooc-etuQuGKCUYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQxAOJM641IJzBwZPkg5e7QkfD0drHQbw9LsiI0tkctg&oe=6A901578"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
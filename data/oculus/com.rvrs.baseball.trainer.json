nc_ohc=1qW3etUb9ToQ7kNvwHcGFm4&_nc_oc=AdpKb_IPY2CLKtzU2QoDuXv5CkOfut-wBFhRCCPP_Lfaty-tukPkgyPJePt42aqjphM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQYydeL50uKPQpiHxDAuoF4aXY-YmDL4kIqIVyZO6pcw&oe=6B09A103"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MI5WbMjwp4Q7kNvwFsqJc-&_nc_oc=Adq0X1yITlS5YC9epkBKUuFq5yIsqdbfnzywz3EkiUNHnQkXQp5vtIRtq_GkR4uNfSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcOAoYWiR-dzwG0TQKjPAF-v7HtZ1Q7c9uhLBDADW6BQ&oe=6B09ADF3"}, {"file_name": "screenshot-5.png", "id": "1190561018044030", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974653_1190561021377363_5895612526815394834_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te4G6v0C0qsQ7kNvwHBCBGm&_nc_oc=AdqUtO_o6kt3I10rkKHnRpVHZ56jlzxl0GqVUVpWYf8liRkag3gWaAVpHn3DXK_Pf2g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMxJi5-e4VKvUv-0GEDKaMGWv4ZLIRnaYMCvNGt4loOQ&oe=6B09AE33"}, {"file_name": "screenshot-4.png", "id": "922875505215237", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW_BEcjLK14Q7kNvwHApqPL&_nc_oc=AdpH-FFesqOkWCYW5meTvCpz6KPXl3CPqjYqyjPZNakpeK5Lhc2gyozkgtWrxG5kM5g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-OS_POHVeg8NwmrYc3AhbUGSY3aTE3J-eWrbo5XnHgQ&oe=6B09B3C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "783288508992812", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974631_783288512326145_7599899629745698022_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOCIA01KB5IQ7kNvwEyNRVH&_nc_oc=AdpJjl8_m5fGyFH3Nx1T5gjUdbX-VsaYsgONgzDX_qPxTjmnmKuRabj22nNHmmvp1MQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVIZVBo1n7Lmsnvqg90mabbVHcLFeEhmaLUDBKCTLLUg&oe=6B09CA22"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
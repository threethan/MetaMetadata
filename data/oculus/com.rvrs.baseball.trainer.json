&_nc_oc=Ado3h55OP61qOZ9vt_MunXbQoNJSqRVFp5ofXNPlNREZrJsi0q_L6JectvogXB9x4Es&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq89cF_ahKXHEDlI_hC301ORUInboz4NWvPRIicIpiHw&oe=6A81B107"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGqWp-83zyYQ7kNvwHWKLcQ&_nc_oc=Adrhckhs4j5X-nF-Ir5mUDHKc4FQLLhDGiUxvDaIkttTJWDBMs3Ey5JhmqpdlkCbXng&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV2-3ijPvqkJnULlOww138scPas4spS2QIZb2t4uHlng&oe=6A81A7ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goZCMB2J77sQ7kNvwHTlxak&_nc_oc=AdqIMaGuho13O4SGkpcZuWFV6LPPIbmmLl9g3XiEVrH134DeAyrVGInp1KCpILcsbDw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRxMkhu0iPnHYqBhR9VKfjCfZOabPkgnVvLF8KxrSFzw&oe=6A81AB33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCs2767knacQ7kNvwFIyGMV&_nc_oc=AdpP4SqoXraaW057KOOvRzF2OAP5_OcwV-QvmJZkZfVvIFakpW_5X25SmtyjZehl2-M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvnnzECPqp-nc5Oa20FQJ4UHJe7OmiKMZH1bOoO2j78A&oe=6A819E43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RLbDCp3jPYQ7kNvwHcrBq6&_nc_oc=AdrwnxI2nkqw6hNV01ZnLN7LxwBZTdqlSgUmIQySt-vfVdRp_bEmZfz8Mek0W4YgSbs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGblHP_jZA05NU2e6UZKONCH3GgtCeyVWXjXO1EczvYeA&oe=6A8194F8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdoHlFoVcACVM0iguvYas4ZVNW8NN3S0WezeoZwG_Vx98x0UNSS16O0lfI2BYwPr-0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPGWuEePHilTUccTbhVnPbFTN9baz8T5ouo_gX6fZhzw&oe=6A5B7587"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUnIKEKmL30Q7kNvwFoXwYH&_nc_oc=AdqzXeRqB5QxJ6ItGlY8pZMbdFPiQ5WLHbHblN9HCP6rsjYyVlk0sXOVG_PFsQ38ASg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf6a55QjP4cQFC7udEtMoMuEBPqlaRzxSVBMoWRGdRjQ&oe=6A5B6C6D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBc6-b5rL7QQ7kNvwFfNfnb&_nc_oc=AdpueQJ2Tu5bPc8kfy_M_N1BuHuisiRx_4Dz4UvVjmRpp6wzxnTJssJyCBM_PDpz4o0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJJpwNpyaMHo7pAhdLbMY6KGOm4LNJ6rqYB8_t5MJQEw&oe=6A5B6FB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zlVmja6SS4Q7kNvwFpAEKc&_nc_oc=AdqnWXG8ZpyCkKIcG4sqSdBpME6r02qukngSlZHeJb699_hjUAlra5VOj9dB6Aj2_e8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnJMGWeUwc94htdE5gVPlhnkIKauaOxPQbN9e5qsthXQ&oe=6A5B62C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0BAxnXgyrAQ7kNvwGrBox_&_nc_oc=AdpPi5ftpFmKfrjVcb9ZKmvIeQqpWxG5rpoXNBd3vR8-7bQUVPJ99eGCTHwpr9ogY9w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQvh2-DVBgVRNJMke2PXRBF40IBMJ959AvDVZ3WzlwRg&oe=6A5B91B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
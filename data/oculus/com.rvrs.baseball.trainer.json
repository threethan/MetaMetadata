png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW_BEcjLK14Q7kNvwHPXTQH&_nc_oc=AdpT8CJQbyjfsbSJ0ElxD6BS812bbflKhE_fhoiJgvB9cN9T-et2iahnGstfkd76ht8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0yeZ1_9RGREmKc34gv0poHI8tW4c-1g1GL9ROUtD1jw&oe=6B0710C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPsxcfaWYLwQ7kNvwEoK3gb&_nc_oc=AdrbMD5pMW8emsTfPpQMw53WPYLYe80rfUYLkdO6BLWcaORm8Kxq2pOuzl7qrTPezBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1rcx1LA6v0slZybCJWzkwVNJCICuG8BHjmfOlS5fYLA&oe=6B0707AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MI5WbMjwp4Q7kNvwF8ND5q&_nc_oc=AdpW0sudkWrteVoqeSOJPfiBCq3bqOA7PALqS3qNrBVEUBkf_oRlPTMutpdCHkDb7pI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc1S94eSQx2RsvzDJo2tfFle0Rr67tQLUm7EyQqNFccA&oe=6B070AF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qW3etUb9ToQ7kNvwEZsJXn&_nc_oc=Adpj3Jhtxmg8c6L2kSzER8SOFNiYneS-_UXMRAYcA4YExkUlamE7-v5V3XMddtmZuWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ9IJnits8J36FgGI1Kx9b7sDd1WevW1z9K9vVZyeXdA&oe=6B06FE03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKvvuhrR9KUQ7kNvwFCLOgQ&_nc_oc=AdqwvDOJ217H8gOcPwm-2spX2LSktlcDvMDzmdpiiaiHXczk8jeUCl8Caj6UeIYr1b8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3VlmQq8zSqB_H2nO1KisW9Yy2ReAeXvelY4YamE6IyQ&oe=6B06F4B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
&_nc_oc=AdphFtW5_MhvpaUwTWiCSVz-TwFqwwxmI-ZUhUjt62I2bOzfQnlnDnBmmNV-S-bzYLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKiYBBCHC9lnhZwatgai3CoUaacqATuYeXaSi5twqa_A&oe=6ACBBD47"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kYHWQtxv5MQ7kNvwHUfKUX&_nc_oc=AdqMqJpr8OQDxqAaMQZXrozQiEFRNlmRx-pRg0ZoT-ntMoZdTuDgYm-wvSQ6ijSE3Bs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ_dD7P8SP59RnXMA9gsF5JeXYF2rGf4UA_AcZZ2PmrQ&oe=6ACBB42D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNSJb-3UHrUQ7kNvwHzaOP8&_nc_oc=Adol9NBQjJWJS7grGmkHRc_0KoG8AeegfL6bSLyXCB2WDc-yTO3jw_0hoerZbwguddw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvARdgFmvjBm39fwiSy19_Cp0qUVSQD3R-SPK2rXTwow&oe=6ACBB773"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhLoRSJ20soQ7kNvwFmmZP2&_nc_oc=AdptVvrjXfDrgvy7NSArKU6_bSSnI0VPvcQBztdYQcbgwJ0YtZJikXXbHnLmy3Nzr1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQK82i6oA-shJDfFg8LHgLrpUi0yRoKiloTyyJpTi1fA&oe=6ACBAA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEjteS_UYscQ7kNvwGgxKrL&_nc_oc=AdqQnRkWVc-vN4p_q3kOTpGkr45ti8AoHjxE9wy4dbQs8apTzKrk--D5pHJ9RXGCWA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlGBmloHRmGwCu5NYHz_8PAR0n3A7-vW6qZTsB0AJq5Q&oe=6ACBA138"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
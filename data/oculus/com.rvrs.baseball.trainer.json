&_nc_oc=Adosh6BaZzYxcCDvrnNp6eAqEHblkgGncn9Q3QyUJtU-4GeKaqmoxE5kgVBeYiKB6Kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQN5FuLAn8KMxC4Mh27vOJonNFXNEGKGsrICoRz8omgg&oe=6AEF55C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CL7w-nKkrgQ7kNvwGuyBrz&_nc_oc=AdpdboaBqzeD5M2Do61uIRnraioY88GluUnETQv4daA0_9rIiFGkkV1Bae8JPZmh1Kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2l5KArX0MPQz-dF_Mqf3aP9dmc0d1XHe_4bESHIA9tw&oe=6AEF4CAD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-rKguQBIf8Q7kNvwE7Vjjj&_nc_oc=Adq-YgBae7wUixmvOAPd6YxM3SWrBLAYtn7WIRe0tP8HBp3Vsbpmj9ljeE1GUQNPnU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzYz729rHUOfBGh_Kl7bjoEMzuLACaxwmr6rjkaUQHGQ&oe=6AEF4FF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1ja6UHVn-IQ7kNvwFcXEys&_nc_oc=AdqQmKocucNfNrXLgHOUHjzlfXZFfZdpVpEw7q6yKvPqP8kuwwDHc3xBEabtcSpl450&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0-ZzmsXr3jlpanJYQY2zkzuHz3KqzPYF0QWl0Fq4QdQ&oe=6AEF4303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNSlHFXfboMQ7kNvwEHcmD7&_nc_oc=Adp13ejy_AB74c3w3kcAjdQ20cnxGhvyDKwxzG3wGdoFXiTkx0Bx7uS-3yxDroKplYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_LljY-SMJ9Y6G7c8oosf9D0n_P1M22geBcesuxxf5Iw&oe=6AEF39B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
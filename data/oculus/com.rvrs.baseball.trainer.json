&_nc_oc=AdqBYfJRuZGPQngy6sZiFY4vtqUnEpDYVdOT8qKLwmzn5n0t1ixldDpjgPPu5FN6nJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArHCDrkAp77Rt7HSNAMPopBcSe8e7KfzzBj6ioFp2fcg&oe=6A69F607"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DBAUYiaOIAQ7kNvwHAHxJc&_nc_oc=AdqO3d45x2o5JjhWd4SSR3XcKqI5IdUGznmFzVyCPZn0PvWKMHVGiTl7bjWkfgrQ0aE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG0i7B6Xj-sRvfVf7_xUeQ-LIho6iZKcGxPPXoC-V1kQ&oe=6A69ECED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjYw_TcxglUQ7kNvwESPCjX&_nc_oc=AdqMrRAH4Gnmu87dDqlEhl6d8KWYH-3UUJDIHHToDfzTCCcDMgLP8dU1TEuXyywu4CY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-RyRG3llT5P-HrMjVVx5l-GGOMq2AdP6xJ3PgKKmiDA&oe=6A69F033"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjWbEt_ARQcQ7kNvwEZwIFY&_nc_oc=AdrMSOiGJQ2hyaxE2wsfkPRC0bCoLr4XoUZxkgAUjKPJ0cdBAJlq4jiSqk-t6jmBPKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxEiubDJ_SnZVVakwCVbfKCt2EnTpYGrc3ekHset5SrA&oe=6A69E343"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_4pGz305k0Q7kNvwHycsQ_&_nc_oc=AdrsDm4vw4etegzfc4Ne4npfu9bHC3ZOACg27z6OreSvYmi8dNI5VvEwM8fLSZRqwhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjH72vj7qbVUBVgg9RySnwihfQTydA_owdUJGx6ynCRw&oe=6A6A1238"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
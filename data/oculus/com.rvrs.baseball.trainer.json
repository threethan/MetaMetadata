&_nc_oc=Adq8oHbdm2ydMo3Ca39hcFroXKCHT7LZw3y9SnXR6Y6i7JRH6LCU3DuRlrTuIU601YQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMrwaDiIV3bAqGMnHsShsHfdqrWVKcKxwLw3oP2hLyOw&oe=6AF73EC7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL8F_TIxtAsQ7kNvwHTiea-&_nc_oc=Adr2jbQkYLNAlpVRWuUMkCzBumMjP--LsnNp8Wrv124ToZjUFQuJHr_TyYVV3Sdsuvw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZUT9JS_tx3ueyi4TxQn93z82_B64Ngp2P2Md-lHeFfQ&oe=6AF735AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA8MEma1ItMQ7kNvwG9ACdg&_nc_oc=AdoGoGufyidpQofMCKVLGjRb1vH9wI6zVV-oZru020kwzN5X1lUZCaRms957lRp8c4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrEpq1YWj_R4YHUimqaUPCenMDIGzICfesOSfv_KwqGA&oe=6AF738F3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjQfvkvJ0pYQ7kNvwF_oCoB&_nc_oc=AdoXp9fopr0dAbzg6m9is5yGH876-5Dtb_Pv_FWBmuFtBuPaGNo7l4XPmxvUPUd2D2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxV0ZU77X-POzwRKiI5eDhX5lyZ7IDZ_8fwLjUIqpzpw&oe=6AF72C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2op3jPTq1AUQ7kNvwHNGofU&_nc_oc=AdrsV99gY21RBgTzLYPrDZKo7G6Y0OivtgdIPDKAjnjrLAdvdIM_H7HU69W-fULodoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlcF9x0OjX5o_xPC49I_A2V1gHyKqVhu_LDtQutv-Ypw&oe=6AF722B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
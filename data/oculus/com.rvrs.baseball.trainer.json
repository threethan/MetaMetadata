&_nc_oc=AdpK8Ven8S1-AlLyOn4EdPE9OXJGAjLadrfO7Di5CmvWV8VCG2M7UbXba0e7a8DKUMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwXAmkFCo8fjnB5Qc3slsCWDuXTIiaoG34EwOwB23YlA&oe=6A9852C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JBMmM8gjFEQ7kNvwHWjIxz&_nc_oc=AdouELMAwRolvjHE7govxLW0JlFvA6j4cWXg7N0fIs6Utsm44lxY8pCEuhmyLGgBV5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcNYsBT3oEFH1KvrW-u6Jd73Iaz_thDPzMd_B-Ci7nEw&oe=6A9849AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQL-VmDaHGcQ7kNvwHACaqf&_nc_oc=AdoRbei4fuIUhdmVijbAahRcvbLUJAsAM_PscOxIFT22Y8puVwj8K-pHf-J0lhIDQ-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO7X5PG5EqvGfzW31MUpwP_O1j_YvcR9xVZy-Ni-uEVQ&oe=6A984CF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nUU3lrA07sQ7kNvwFZ-DbF&_nc_oc=Adq0vxqVqh7nXks45rMlLMKVJfISGPTDlkhux_OWyNNiKWh_AEQOq2cqS4_gYs1Tf40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs_AhH2TzwKmfjyFgCSkLlE1MLzua-cc3xiQ5AdmbW5Q&oe=6A984003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wxIvIGMr6YQ7kNvwF1tqhQ&_nc_oc=AdrJ2CLLMLnc0DJ16B--1ngF5S2jrCf3O85wcgDP78isxg6RhZhf2VDhhGASRZ3J-gs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbO0rod7OKbD_QPUgRngPNgKBfXPrIWoFn1VpS89mxbw&oe=6A9836B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
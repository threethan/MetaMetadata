&_nc_oc=AdrvF-nzKOLufkOfKjuwrYMoL1MmDdryL9hcodCAXVz0Hi6ilApcSe7hr2txHX9uDk0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_HKPVhtKafikDyd_9oQjJBdOwN2NG6JOwmfQe_xQmSQ&oe=6AA00387"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIIV3sCP5GYQ7kNvwE0d_vV&_nc_oc=AdoyuBAcCg_4xv42MA_Whkq93rmDyqE8_p2rp3iNapv5iKviNOhrUgwqxGI7UUTiYl0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6bxdPTgu9dVAfwp_7XvXSXkq-WEcx4XNF9RQDo-rHiQ&oe=6A9FFA6D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE3IjM69CSIQ7kNvwE4AtGq&_nc_oc=AdrcT3RCGnyJEXqqPx-SgD3tPZMtN-JMXnn1XBvvyxOUIs_Uq-KjfECjTHVejW8mSaY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK64w-1SIVKPIBKxDvrl-YpGO10KSSrRDPLHm8Utu7gAQ&oe=6A9FFDB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy09kefAL_8Q7kNvwGPoaOl&_nc_oc=AdoBvUbFP_-tB9TExnufe2I1vxnlUpMchRgj-th91IUdpA4NXvCJN4HrnF0oYS_RSN8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcAvdtBYLShKQu86nxC5zjDF1FaMb5afFwptlWGQ6qEQ&oe=6AA02903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDiTBUbWpOQQ7kNvwFsvtEJ&_nc_oc=Ado2GNfZ7KROpS57bbnRpNu86dBuMSprQhv9Gcdcw19qWxXhWYP-jS6Nl3GB0Iou5oo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7yLLMehdYr5TTxrV3W-6NfeuBLTdLfuIR6rfjpW8LKg&oe=6AA01FB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
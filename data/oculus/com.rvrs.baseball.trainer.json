&_nc_oc=AdphK_vraJZXOycm7sOhw-qrZ1uyX_v8Kllpll2PuR1SHBKDm_VDMzNPOhrBR3aKvGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAviesLPtJrMnOo1krXqv_xgrYqf65u8LHqEOKIfKfuvQ&oe=6A5F6A07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmr7QO3g9HIQ7kNvwE9eKbq&_nc_oc=AdpZZ-oBohm_VSU_wVcEJz5YAfNkRlU-iUA0rLKElvkqQH_Frn17WBFEYpQC3qn0j6E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOAn7gMS8ZPu9rOTXHtAPGqerufQNmbwDtxi2eJomo7w&oe=6A5F60ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_eXGtHfaFoQ7kNvwFjQcpy&_nc_oc=AdpP-30pZBqJPJH4EMklwMJ5CwqF9iqOj8D1vgKzpLGpJVVOeB75YD7vGx-crxcipaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0L9FFbUpjKLGLGBk0HBxNllFHy95Vuke9ADvxY-vhcw&oe=6A5F6433"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDgZLsmLKAkQ7kNvwHxtR0O&_nc_oc=Ado6VLSDyQHAw3_C7220wBYLHlKkgMg8hqiwkDj3pXnLUTtlInL9oDk-ORJSskrV3Ro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH8g_aXlpBML-YIEvuTe8TcYaTPojSsZY4Zc65Qjbeyw&oe=6A5F5743"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8yjj7exD2UQ7kNvwFVMNAg&_nc_oc=AdrvoMbXaeWUIW-iqOndpJgxubeZdX2JSByNpAMhKREuMaPNpXBOaB-ibBkminYOu1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx9VNfd2J9PMA0fBJvv2gXi926a-SE-iGEC4zkhWsesA&oe=6A5F8638"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
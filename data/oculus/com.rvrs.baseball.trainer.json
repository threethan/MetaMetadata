&_nc_oc=Adp1VN2b1xs-6Ywvf2-S2NWKAkSOyhV-TxoJeJ9wB4w97KOT3wUocl-lVITuX6UDKno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2UmuACa1f2peIkLtwsInFVyDJ2pj2a7qqrLMhd1mVVw&oe=6ABA6187"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P-dNvfH1LgQ7kNvwE0Ubtv&_nc_oc=Adqpy-BzSElQLVDeHN4wSautKWr5VMMoc2X3qwJ4zz8255vKnXhRXL4CGWwvktZCUCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv2DHX8tFlnKcDsCf3rhFpFeij50dTfQAxkYlM6BEZgw&oe=6ABA586D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7QSlvA1MR8Q7kNvwFVdpsF&_nc_oc=AdrtxAuypYJXgxjXwsa2sES6SVkuurGlCy3HvaiYjdrTTG38LiuOwGBWqy2o9dWdiZU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyE0ge1TMrCvNGqLIpSmyeocFdkDW_0cCg9NtjInE8vw&oe=6ABA5BB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfqmeC0bsVMQ7kNvwFYs8je&_nc_oc=Adq30Q-P3O-DIbrpKdVn5Ys2giXT9hAu3FT8lb7v6jEuN1zk7r8P1wdX3aL4FNNnVZU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ7J_06l0UH5Y3PaRJ70EzpIkd8rNvIMGYpoKLEPzQeg&oe=6ABA8703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iHdhsV0dq8Q7kNvwHUAk8I&_nc_oc=AdqA4nwzeE5RXmD56G3XsYXY0J5TaQ9LQw8G7BMhdRfkO5oZyLvcwPR7sxmmP7eGjmg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG_lZe4KzJ4tLkyffvLew_M-PzN8pO_SbbQErk5km9Zg&oe=6ABA7DB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=Adpkr8uvxZc8eu6GaS__glOt0VFgcfx0j2YvdXwwTEgep8ZUXuH3JwjSYcmcf5MiVys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E7C9Kz2UMoBMub8dcBmD3r4e_K64EG6Iei_7AfSj0Hw&oe=6A450C07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO96OrPywjYQ7kNvwGkme0C&_nc_oc=AdoTBqjSakmLF81pme-mlfw6arYS74OotTKrZmCfnuHoAB_UugJD6N0Hf6d-cD-cw8Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NpkH5DX1dZGSsjqp9DsGi84FtPiET5ZgFSBKWWdLi7w&oe=6A4502ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuwBtOszUssQ7kNvwH70FG_&_nc_oc=AdqPL721WlywZVdXG7nAduv4aAPI49EeGvswhVX98xdda5R36yUWqC3NLwpmtkJDVPU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CNCxe8o93lp7DxLVchyrnt_RtE8MydSeYFK57-l1b_g&oe=6A450633"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KVJKCIBoWgQ7kNvwGgafsR&_nc_oc=AdoVsEomYHXY-vdHNnoT7JtWLEKWTFH1QaE60-XzIz9cpgQyVviEr4kPDvwZ4zWpCWA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HPAoW0ZDt9g2QK7UCS19ytTAT_hlW_UjwtlM7ZFP4yQ&oe=6A453183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TirrQBkemnUQ7kNvwGgi5rS&_nc_oc=Adoz2om5TrZZqZDoDAz5kP4PR52VEU2FQ6QRKXeT4IFNreJQRM6cRVQnA8zgFubdYp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2cSk4xFom0EzNIyk4Csr6pRyJElqd37Vrdcz2CiSlnw&oe=6A452838"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
20f&oh=00_AQBD38ICmKCgGvIozVDPNEZHyf14fDKg-F-BKy0jzVnUwQ&oe=6A5A1E33"}, {"file_name": "screenshot-5.png", "id": "1190561018044030", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974653_1190561021377363_5895612526815394834_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0fZNNZOLlsQ7kNvwFnywxa&_nc_oc=AdpVzZftuVIj16NpX1H5uAnjX4X-r9E4tHtXC8O1M_ep3Ecaz_PGe6XsosTILq7msCU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2hv_t6Sp4dmHG1qHZ0Nl8G9ak48hXMXiVWm4Rxf-VfA&oe=6A5A1E73"}, {"file_name": "screenshot-4.png", "id": "922875505215237", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYlCqyuKMt4Q7kNvwGQha6X&_nc_oc=Adok12RLu_YUBVNEe3pGBcxTxpQIQiSow75kG3koOiyqQrOEQEQe4WdbnNjxTtJoffw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM03L8rfJcmRjpuUA9EfC77EvXvATN1R7AcSSoTgpQTg&oe=6A5A2407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "783288508992812", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974631_783288512326145_7599899629745698022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gs-dBgndSgUQ7kNvwERRc5R&_nc_oc=AdpEMVe6uwrS9VTPHm_dvnI5ishAeGHdeJMayy13JQWrDu9fdd3CJHOeTAzLqvN_Amc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO4q_kN9MoUzh60B0krrkQBgdQxTF1Vx6ZT2H9Z4CEEw&oe=6A5A3A62"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1123184911760363"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "544911023171081"}]}, "baseline_offer": {"id": "544911023171081"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1623700860, "status": "PUBLISHED", "id": "544911023171081"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6864993760193118", "version": "2.1.14"}, "id": "109303126444159
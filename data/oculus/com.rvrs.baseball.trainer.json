&_nc_oc=AdowJ3koXAA9MHSbMi6Opw8NIW7TwWw3-EuZteARaOxreA4ADYUV0lkbEqYwG-TEYhk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ-Oa1EKnniiVnEPUHl2Smn1f71iyJFTJRc7lBqS56RA&oe=6ACFB1C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ46c5vY45gQ7kNvwGA2nb_&_nc_oc=Adq1fbpoVGHAbbdFrSpexa8BuUzajl4869UWMGry56zqX7BK-Mb328NTdpaZbcFxQ_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIoRJ4jpl9feSbdq6Wd95thW9T20l9Mtex715ieVodbQ&oe=6ACFA8AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RwdxsRONFsQ7kNvwG5FfJl&_nc_oc=Adru2zUg6Kod-KbQBUbWVPCW3mThd5jf5BXgjUMgAvWfE_xaASRTDUxy3p2CDbQevzk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhZNXWphj8EOXvbyrZ8HKh470hKH8HbVzoKeUlCSXsBg&oe=6ACFABF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3xXojqowH4Q7kNvwFdzM9Y&_nc_oc=AdrTnZ92kXnRmmEXo9EQTtg2JqnDmUfZZzq4ypf_ovAbmgX5Ex25dGAwCq2Z2HbGUew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOASZYmVlFXEZuu5eoAdZ2VrbXryDehYGcDT4qPLtAAA&oe=6ACF9F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDUJ3a7vwtYQ7kNvwGPdtU1&_nc_oc=AdoakHUJRbFZVbFZpt1NExRrtI6E3IZy4I7-3dkvDB9bwGDOo_k2VONu-t2LP_Vkzp8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7pIAOVjshcvPnag6_LNgrDgVxXKoNyOzvUufrNhl_tQ&oe=6ACF95B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
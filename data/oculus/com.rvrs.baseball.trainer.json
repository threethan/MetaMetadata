&_nc_oc=AdoElsVN3ERQznxDol7lEsx126ataSVzF6v_VoKQYYXZzwf60y4Mwe5oX-2usbgOASA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoDFb4WZMl0IqgekWuV1Nb68q6c6qiGnNDwNIWVO3Ytg&oe=6A9D6087"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIIV3sCP5GYQ7kNvwFY1u3D&_nc_oc=AdpZcO6mnLg0-056fEA1Wu1eRx2rndim_g_UVqOsSh71uL50MKU3sigkqaFG3YiSJLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZy7Bxr17uKVXO6X6hs4fJg6OGJk4DOkMZX8SQygqwqQ&oe=6A9D576D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNmva8zvQQQQ7kNvwGx8U-r&_nc_oc=AdqBbHiS452Dh8-TsL_DEkqDM4PNig-Cm-Lqap01FI3OPd-6hwvvHNf7TnC0JMIKeNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrGUlIO_LBVu7LUrNfdPX2zLkzKc6q4zDNNCj7IV3wVQ&oe=6A9D5AB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xzh1Qez7xIQ7kNvwGChQjR&_nc_oc=AdphpSrbqJUXd9AKng0FiF0O7I1UCzxTLCwdTbDSYvRx-JHwMoAtHS3_4bniKON3KrQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkBMdKsLgo4r7ahzpvV8D5nbS3DdIuA86a2RtAR6tO4A&oe=6A9D8603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMkPIYpAGTQQ7kNvwEzT3Wv&_nc_oc=AdqcD1pCOdMGNUP8LSBBnBKb1YIE_ddRMstwg1msyOUo4sQwnKq2Ebr6FOVe1V0nPhU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh7VxOFYnHy0XK1oKEm9s71739nEGKYmT-YF5jDw4rYw&oe=6A9D7CB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdpbRQjlGveSAZFzCeIaMhHayHJ27WoveuFDMiiVmJE2G80U7EYqhUiAGgkGCId2Irg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl6N977EQLbAeCEQZuDmkadD4de6mktBEmnrpUzjTx3Q&oe=6AC7C8C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVW7M_Z_7CQQ7kNvwFWXj6V&_nc_oc=AdpKYlZVrbSdrO15uwoZ6AYIfJ0mY9BMlWzMAuj0wpnLKaLcTiC84ae911QimIRfDp0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWVyrfG2huswo4oQelJlJeyMrpxtG96yzDyWtTO1j3lQ&oe=6AC7BFAD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJOr2tHbMB4Q7kNvwHUhkdK&_nc_oc=AdrE7VqzW2uNiXzIKumDV1wLUX44FMcCpf2Nt_3UEQ26WSJ2DEnzrUZ3ClNQJ_GVVnY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtExTEzBoXktWwcmXZ0I5K8F_dWg5kxjz3W9UNudxEIA&oe=6AC7C2F3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6GsbKJEncEQ7kNvwFGZXsm&_nc_oc=AdqgKDW2IFKvvfcQfBlxeL9ay_Y-1vcxmCJ1ZEP8E6MCnEJm3_3A9d1JrG-YMNSL4ho&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhwbZN75rm3230qMEQrJ1V_p36pBR1SEX8LftGWjdgHw&oe=6AC7B603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9x1Cj8sxNEQ7kNvwFZAcq9&_nc_oc=AdpkhDXjGkCYcDnHEqOyckDMnVLzAjZ8O4jOAz_jD4YVQSN8nvCTrInkKAbUO52JW00&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfpXZ0-01Nc0CJxd1YtsjmEMiHNTK2zAAtovIWkr-75A&oe=6AC7ACB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
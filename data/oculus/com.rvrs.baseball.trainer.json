&_nc_oc=AdrdaTEaPoF-_snRCyXzZZpBLOIBni7ELjqsNuwKS5gniZxX0TXDwKOI2XESUJ4xmvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnZUY48dwoO3b69qntrJW1vFhSMmzGmOhk3yUVfD0FQg&oe=6AF49BC7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkThQPTrnDkQ7kNvwEnE51A&_nc_oc=AdrIru4qZtnf-DsRJhOdSC8tQhZGsfRfIXvR_7fMITVHneHVPmaoTe6c5ggEutu9BJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2vZJkAdsJFJ7kZzw5yoZEAn6gyfNcNAMv_WTOn9B4Rg&oe=6AF492AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q74mnjv73Y8Q7kNvwFSmY9B&_nc_oc=AdqZ-4ycHZF7h5AlhXop8R9oQ1UuboJ4LSIg_jKHWR7W3zVRp2-Hiycbd7aqj2hbJBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbnreoJcoMeTowrvXKV0AiY8PWCl32kzJ7QL0W8-PSlg&oe=6AF495F3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ngGJ-HZaaoQ7kNvwHZZWpz&_nc_oc=Adpnh2qx5DCqTEjC1a-suqRR3ZnJO15XRjFO6RHUGImXQIw7C5wYt22dzIW1BKK-TAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT45E9pu_WZHwsJxS1_3Mj2aXcVtSbG2ixvJFi5iBTmNg&oe=6AF48903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD9zi-oQgt8Q7kNvwHsQLUL&_nc_oc=AdpjAD_JDqGaXehIAkb2mTUMmvQRuFQI9S7SKZgkJI8B5bsCrIwSWDR3H4-NNS6OwIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaZVwE7jKOecySBq8tldG6ApwSTtI7c7NAhGXmUlSZFQ&oe=6AF47FB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
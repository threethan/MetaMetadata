png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNZ-gnIm42cQ7kNvwGCDanT&_nc_oc=Adqqd_YhPt-t-xaO6ywVhAXIMAYVS8fmxjoNdKDNIbsxfIaBdGcLGXlVV6NTqFdjwB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyAX3ycH7IUviD7RD37uCgKokERmR-KlFTQtEDGqUmXQ&oe=6B046DC7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fik6_9N9J50Q7kNvwH_YDMg&_nc_oc=AdqF6iW2xJTjHjF5U9n6qmGTGYmb1Q6vzg_os81gTSe8LXz5mMJmNplYjwSOQA0zoy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Rfzw5cNQqZyL2ai0Mx_SPwKw6pBJOugo32U7TmhQcA&oe=6B0464AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjNUBk8jwroQ7kNvwEqaD9k&_nc_oc=Adrispe98kK95u6pKxw7mTcHhSKATdGUCdP1xLAR6oeoW_y2nbv152-zFrV0k4NOMT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTip65e3aXbr9xryn2v38Imd0HGzk-M1aSaLTLNDls2Jg&oe=6B0467F3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZarIq534a64Q7kNvwHGvYJA&_nc_oc=Adoq84b1DRKvwbqr3hxU2iooA6QPOt0bqMQENDUV6qZYqdm3Fm2YMLTYfw5eifKyJJw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7fkaWBq8h-DtaQ8D2uP4VaW7lk-ASK36Dn55bHI66fw&oe=6B045B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd152siEbSIQ7kNvwEPYhsS&_nc_oc=AdqxpAFxcCFqWxOnoAi6LzjQ9M3X3RhX_LBvo9dKB-sA6YAKWwYoB31IYEFhD79cvK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQu874JUlPcdSam2GFUlUX8xkow7qJJrtxpqllxjcQrQ&oe=6B0451B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
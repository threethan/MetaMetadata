&_nc_oc=AdqLvTmmnTZ1tYGSkGEkE8qglfsQtuORZaVMBoq_Z8w_cUjDG6CeosHc2TQ-_Rv7yUM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETMcfoUO2VlkYhaIGmllq73pBnJtQ2gwx_qF-L-O-I8A&oe=6A805F87"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkhA5wTbC4cQ7kNvwEnmWDQ&_nc_oc=AdqkhIkVG_ZkuALnS6zYJVglLH2gHImMLJLj2YxowRkky3-_JQVzRkpm266IkgDqL98&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq1TD3DZ5w37Xhna5TZNnc_Ebxe0dWxsWe-UQTAauBaA&oe=6A80566D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goZCMB2J77sQ7kNvwFdjyue&_nc_oc=AdohhRWP6leK3eqUtjNovHOFJxZIcWGdekvf1-U_nunUqX2yOJCFDiX2KMGjqU7vhds&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRnLYGvAGH4nKLwrNWudJjg4vJsoBat_mSUB5FjUxHhA&oe=6A8059B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCs2767knacQ7kNvwEd6IHg&_nc_oc=AdrUsbr2o-mP1WnB6ViNSD8FD1llRoTccvKQYMZ5D0kcnnv5lpVf2kpPCPR7LjCKymc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlMQJ3KYnkWRPe2v6uPUCK_dWlmv9u6VNKZywrovMkyw&oe=6A804CC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RLbDCp3jPYQ7kNvwGmdajG&_nc_oc=Adq1kVuItpn49mWOK9x690H1j5oIAzrCl8BEWARA-JosYUmf8Yd-iI9ZK--fYjPFgpc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG49WcT7F-vs_b20PenoVx4VkEyrizbcoo5ONo9E72Gfg&oe=6A804378"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=Adq4hWl1Fh0At6kDVqlOrKLVBQQKDeghCP34znJVgJEacUQUQ7WkQ4h12UL8HlnPWMk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7jX4Wa4NS-zl0fe6mvcxSsw-KTNyBNLjpDJ4ayZroiw&oe=6AE34007"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16DlOTZYAi0Q7kNvwHU-eG_&_nc_oc=AdpcBo2_vMDfJMoTv3JFTVHbav0_VEl3ySdbh7djnlyvtATb2SqUmvthO4i8_7Cv1Hw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP26_9b-uMUN7I-5YxD8B6u2HwT9qLdi2HOA0WRQYITlg&oe=6AE336ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIZjWZQdvYoQ7kNvwH0sSPF&_nc_oc=Adqbn78z_wIGJYwDc5cr2fORrzaQVWzWxECLUapiFmOqz5D1ezgRxFuzYWYua6Mg3QE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3ckM2Vke9_9S-Tq-FQ2IRc63m0u-oyszOThiZSFv9pg&oe=6AE33A33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsjVErEEMSsQ7kNvwE2x3R3&_nc_oc=AdqoIWKFpZ4Mdf-CqeJP_Dl_jP0a5MejPpfXWhhErzUC5ROjJMh_60nuPVze0y-T3Qc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxiQmkxFqbi4Oshn1BxopdTfN9edBMpMpHJC-BoBjMXA&oe=6AE36583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l16w3ybqG4gQ7kNvwH4qoGD&_nc_oc=AdpMK4H7Z4EPAKYzBXGkt8Kfu9z93r-8i0G9ZzoL0NSEbGhKZgm5_YRVvgTzyIsD9kM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtXXhsdCYivYjpoTqRA4MIsK0RqOx1VW-XvwaOVoUhig&oe=6AE35C38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
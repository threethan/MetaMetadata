&_nc_oc=AdpAJWl_X3L1ZGDpWx4V082nOQ0nEZcy6ht8V1DEaWQLme40UCTdSWnYYhfpDFVUQ_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9GtFYO7z7XpMW6gRZqLjqN8fIynBTgGM7Fv39CcsduA&oe=6AE09D07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16DlOTZYAi0Q7kNvwHM1VYy&_nc_oc=Adot_CWeQOAPnHMdWlQUpbBaDptnEKQ7nVmfDrdPafl51YPr7aVTsnpZttS-9wIyKFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRmAUrPBgHv5Y7RVd4WAqI_KNyveLJY5YxfEq2QJ58LQ&oe=6AE0CC2D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGPIXXKjEw0Q7kNvwFAMx1q&_nc_oc=Ado41nOCpRt4UljnY0bf9dxhn6ymCezB3Dc9QbUF4ly3USQYVaRQEpQkBaIUqdTZ24o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOfyDYbbczsB-5e2uoWwzgwXe-97-KasNsWv9097YBjg&oe=6AE09733"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmgrXPqk2RAQ7kNvwGKXgqQ&_nc_oc=AdoYAujDdzYc7B-FeCHeaqfIkTUmhvxY8AifLeOwTRZ39zGc6ehJOVh4Xh_AXmVEe44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjKvD8e5ULCSmm28rEcVHCJGvuINs56iIsX1e4TeZyNg&oe=6AE0C283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUQ6wB9AShUQ7kNvwEXUr9_&_nc_oc=AdpUIpteCU__YKXgD8kMkTreh9YpU_YJMvn5F6tjAyJj7nryEKVuJj1dZmSMt1N1iHo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK4eENUM9T5D27QW4z2uxGKJqzgfxoln0uILwPsHbzEA&oe=6AE0B938"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=Adr37f-SuXKqhFU09uy2rXVt42xvXZFFiAtikQ7pflolDVOWprTicK_FM1k27RlqycA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXpY--4WWGZcqILNNBWCDyxkJG_UtDweORapqZHXhe0A&oe=6A7C6B07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2FDX98zfyMQ7kNvwEb3-t2&_nc_oc=Adr_DrjPUP4urcnwE_jxn4esvBSLnfrpXuVqU9IrzH6PjRhTB-ARUG2T0Bfi0OwBFyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEw07v6lGWSzS_Rt0A3CfiAeKeWnhTschN8zQh5sjQTQ&oe=6A7C61ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ97Y26YwjYQ7kNvwGC2RPN&_nc_oc=Adq6d9ldnQdJ0S45MckNiYgSnf2Lz1h049KaXrbXiBVzQK0IXZKCmRlL6In9BIAyy1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPpBxPWoK2-UfaTgtZodxMJ4IVT8nf7SANiwBbHEtILA&oe=6A7C6533"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldLemdG2BkgQ7kNvwGbin4G&_nc_oc=AdoiBb8tP4l8hx7OUx_CB5-CWdfnepsCSpmrhKVnQwqOcw2aJ8uW7lrvjzGSQ5uOJGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf2EAQ2Myiv-MYeU17zVb16AOlXzgWjOePyIsJ1hc-mQ&oe=6A7C5843"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyrVqe7NGbIQ7kNvwG-JFef&_nc_oc=Adp9_cf6b8sWA9jlaXUVOWyqM7xt3WfmG4QH9CJtLgrzI1UhHBcL8D6OOtDiJG2ar6s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUnYceoACiINyXAHmZKh_s1oIXrvVdVSBlniLLugow0w&oe=6A7C4EF8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
vwHeYF6s&_nc_oc=AdpDna_k3KGzxvcXFI_n9gC2Tu849gWDVwTv8AJIroNc2s1Acg01DKOnNoeBw8Rk5v8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8IVAUTyFTeh2IYrZdOINgla9Q3QAtY2bcRrnHF6EFsw&oe=6A8D8E87"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hh6t6mYEIsQ7kNvwF4nynS&_nc_oc=Adq4wKTnxEMPnhndE7wnjBnYQp6A-aNK4oc-sEk6fdZdZpuk9WLN2zTsrljf-P02-a4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwBFniye09jd-srqehfEAoU7hR_cAzuoesuHH8RbsqTw&oe=6A8D856D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9u-SQBi_SIQ7kNvwEC_vzi&_nc_oc=AdpUlfOW2roD6xfZCvigZfZwzoQrQMjqUIg5e9YIXqGWdVErqYo_l09tQkpS8nCtpfo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVjyyPudcrRvOmQszSDc_w096sdUf5SuEBSmnIXDfAYw&oe=6A8D88B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaKJdR67Y1kQ7kNvwGE7peL&_nc_oc=Adr3TSIG7oegXT3BAGtOUtv7sfLQ-ASjlGdF-zJ4K3A_pYNXnvslqEcnDMEXD-zP47c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvJwKArC-vrsVA9Fbtf1iY2UM7MjsBqnOTxYbCG7HrBg&oe=6A8D7BC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyattNBEaBEQ7kNvwGEJFyC&_nc_oc=AdoKl5ZBr2T8_m37pCzf_Gm3_CzY44zuHVs0fHywSL1UYYqOopmeclgKkWREb9tv4Ic&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF9JBFB2jN85uH9pHehX25sj7Gv6nM_AmwbVItMgryZg&oe=6A8D7278"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"
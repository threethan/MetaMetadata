png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ8n4ftP5U4Q7kNvwECPoiW&_nc_oc=Adoqd8Tdu9KdOQhltj6-BsWGJXYRAj_Jzibx6bI8yaam3-L7NL91y5T9koQLMHFPJOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMEyDPYhtOeRpGwGPrb-IYxFWlG5jXQl4rxOKk_tMRMw&oe=6B0C56C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7fUK8wlJPkQ7kNvwHipC2r&_nc_oc=Ado3ABlQdrBOt3zhBHiAp1ND_j6M2PIOpkC2rCHLteTYzW2B1fc2pudu8ZJoEcuTxQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIc_D6os9s9wnqx8JmqoupE0KymPcDzD4QSD9kNOzrUg&oe=6B0C4DAD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrpvV0xmoR8Q7kNvwGi6lxR&_nc_oc=AdodzFctjEQ4wB_SOY5iEpq29wAw_thmgwmOQ5x0iWhn8pxMbnL3aYcRRJow7FgZbLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTX0Zx-Dna8dL8KjoVdhdoeXxTx8DU4jV2jn5n0PNoaaQ&oe=6B0C50F3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVMJsoZvdzoQ7kNvwHl-fYK&_nc_oc=AdpsXBXKaveGZZ1K3Y_9flXtWpGH53FDKseNjZ840UvVx8R1g_IjJxSDQx4XvfN6aR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_LqCPOdOB_QZoulNf5xDxIUc5Nda09SiIxsnRC9_s1w&oe=6B0C7C43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXg_BYlaOVwQ7kNvwHFcY0i&_nc_oc=AdpjLu9jvSunXxwImb-4gffi7HN7w9bTDaI8SvfmeXfdv3250CsmEtD0u77yefvWPQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSQ32quXIliCOpQmf2Rbfb94BYUQVShK5brRk63nGr0Q&oe=6B0C72F8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
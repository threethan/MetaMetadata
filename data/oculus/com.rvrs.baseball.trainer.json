png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S9gWiIyAz0Q7kNvwG_ccRr&_nc_oc=AdonnURi9Zn8-SYf28OhlcibYNzNwWUs3kmCN5wsiGQ236qIIvsQ8FB4UHXlrjc_C5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW3ye8HQZcIm1QXFaQFdlxBZtJR4XSmObPS3b7giSBHdg&oe=6B104B47"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Tgopvm1CukQ7kNvwHuUjST&_nc_oc=AdpEOlAHGbPF_VECDivL_o1Xfs1SKD9Le5pBpu7_oiMEI0Q5SdYA_g2wiJQXbITyGgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzXdJRscJHSTBfhwkkR4rzsJ_XhLvVulYXaIjHssElvQ&oe=6B10422D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JNPnz66vRgQ7kNvwH2_LTz&_nc_oc=AdoM6kE8_lLJL16fl2RjR0YBe7gprzKO1DJ1aC4IB2ih8TSoZMu9NxmajlJFD_z7fB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXKeEIzCqqHTGAeQmbdDwlJ3ehVUJJtfwIx9719Qhj3_w&oe=6B104573"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8albLMxcW8YQ7kNvwEob9jn&_nc_oc=AdqOTkhLfuJGaF35MZV1Iu4aYyy7xIsQmfXIZW-Ax8D5Lgu7KIhrayvgj1xSNOMT_2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBTeoGpMHAN7izHYmwgr9H2dbuXDZIjz-LTG7HvEUivg&oe=6B103883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU30GcEdXGkQ7kNvwHNTUVV&_nc_oc=Adq9Myy8tlR3e5DgFFfuKrEyoZCuAOCdUpjbgOsIjpHGiveBnGlyARx1HjZ450hFKxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXKDEl6ZMURBjMvu7YEOYETurPg_3dDldRuaQWBOoDrww&oe=6B106778"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
&_nc_oc=AdqErcx_NQ80JYLDMTx8Iml-fqJgcSkKOwXFw3RCY9tqlU-6xT06oX4ACU2NldeWVO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuKSeEy397oudrY41gInE7slKFhcz1vcg8939tEDw8-w&oe=6A635E87"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX8ZJx6cqq8Q7kNvwHxQ4Np&_nc_oc=AdoxRI6gtr5ihab3S81F8zJckKjHORXwhBl8DnN-FuOphEuVLOXNSC7-i3vW2ZDjJZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN7Y_FcRgUvPdEBpMQzDqQngwheoGp3P6ywQAdSY_0fg&oe=6A63556D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXZwbn9gVp8Q7kNvwH4n4yj&_nc_oc=AdoPlSKHaFp06ISV-naIMFhRJ3nVqJXJwdchm12Crf37XgolwD2UfgXdaGoU-8tJ0Mk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsQO1SLlG2LdhbE2HNEV0dd3ZdF4XQ5vFWzNEiIdQLig&oe=6A6358B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0feLkc83k8Q7kNvwEOGDyy&_nc_oc=AdpXXfIJcDySjf4Ss3q2wTCCqRacr4L9g6Rt2_UUvcXLTmH6hlXvvP5FivVxEGym4qE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL0Jl2W0KzcRm9qc9VF0atIQrpbNmtBeddvlQB0K_WNw&oe=6A638403"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTWD6TTKQT0Q7kNvwE9S3ej&_nc_oc=AdpoZHiLYLnjG1lW9QKdw0cPl0J2ywnARiysX6FFQJeuopMSx2-wobqwVzCD0JctjuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc6-WTydZ4R-eeFpmAGNfiFO-e8mNa0yXtu4AMYutbcA&oe=6A637AB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
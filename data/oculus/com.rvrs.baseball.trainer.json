&_nc_oc=Ado7mG3C4EZ-O32xJDDczTx4-yqJ5YbL4NSVSZsM7nD0FAeP2WMTyUYF2Dq1mkqdhfc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaksPTzf1c6lEgdD0XdZtQWKWVFHeRM4_huB-vcukP0Q&oe=6A660187"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3w5TCSPhhwQ7kNvwHdQ9C-&_nc_oc=AdqXHcX9CDADGa0NDvoDtl66PnlmXqW347E4AgRj5ZS6bj7j0SSArRmw3fQiceEOGMU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3-M3VDPLzpG8qATBtC8HMDRleV-Nx4Kb6UWfHdRYJ5g&oe=6A65F86D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL3xf4-pmMMQ7kNvwHeCXQT&_nc_oc=AdpxHABYSc30X5u0He76-G2th4YEnyAkqeDyvVuPAC7cYXbtb9aOQ3wgyT8aRIZnjg0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF9uNh6vp9PDbMj2alfKeLeXw_IksOpVlgrONWG9J1Nw&oe=6A65FBB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASwYmm5hOlQQ7kNvwE5e5aw&_nc_oc=AdraVgo1nwJutn7qX8w-sNWLeKNBnggDScH0sIoibIOr-dQth_CYjU8ocSMtEv7hgqc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVmn699kAHtbHXOhIjIRaeCFnBAIFNV0vDIXft5pfXFg&oe=6A65EEC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTWD6TTKQT0Q7kNvwHuPwzm&_nc_oc=AdqTpMNirSF1LDhR0UJe_LbZneWjFWMStt6Z3YkCvQZeoQZV_sP83f22Bf7v8FjkX6g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7wfsz_agccMx_eOv_zZqD3sRZQYjzxv9m5iZmRppjcg&oe=6A661DB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdqUc8cxEOYL4vaSDmWUw9SgUap0CKQJZaN6ecWuoeiy-B2C5CyU3CaiFQydEdv_wZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zjB5PxlAf2GqX6uHyH0v1dogrlQIPxNu4bsk19BsTlw&oe=6A43BA87"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO96OrPywjYQ7kNvwEpGlQi&_nc_oc=AdoeX7bJeHPz4rxX-dfl7GbS89Jdq-LqQi35VvfkTNuXZxGRiviDr5-9vfKIA9eP6zQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QDA9JjfYPPLdSfTQXKpP695aPmOjRKkEIXDVap1_XDw&oe=6A43E9AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWDQ7JlRkykQ7kNvwEI6dgt&_nc_oc=AdrZlwpwoFkq5zyH2CPtxN2lM_53GAYawzi_SsaAmSv1bGYMjppPTiTGvDI8gVqwYMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pHyKSY0rQSRnVyhS8izKNG_U_iphUVNjA35zwoCinBQ&oe=6A43B4B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8Qbwh8UwNgQ7kNvwFsxLGq&_nc_oc=AdoXUp1RB6Uip0f24IxAOJIhAkegcTIaOUtyQ3UoVGKPcy8QvZfqVDXaYT7xaJTrhvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I1EN7aLYkyTzsoEyl_nflhHKSidoOAgSrKIRmzhs1iQ&oe=6A43E003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TirrQBkemnUQ7kNvwEHvm5s&_nc_oc=AdqpIKaRhkVKRDE-H8_06IdR46lPnJxg7AkmZ6a42jV-Pbb0HD95TmNIqYNUADqn-Is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X6a7ys5y1XcZfynQaqVy7TLeRvP4TRxZSKAXQV1fTrw&oe=6A43D6B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
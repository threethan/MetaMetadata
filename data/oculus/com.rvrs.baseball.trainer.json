&_nc_oc=AdqqW_YWIZqQz1qDl2NoS9rChe1Pqkjo7IpzJWkQstEMMdvDJSmZer4N7Id6kb2UOzE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlzpWCbGIqxIwhyMXl4LBeftsgqOrs9eiHue_46KANGw&oe=6A562F87"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVr-pBNJCpgQ7kNvwH2z6BS&_nc_oc=AdqimqyL0euf6XpCmSPkyZicW1A34DMbZzFSzb1CewfCn2LnTIUb0oaoDwPYPqRsmWc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGqRL3NLXIyWok686tVXNHNPgEkZ98BO6IrpfuRV0g_g&oe=6A56266D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB-8I2A8wjcQ7kNvwHwxGmQ&_nc_oc=AdpkB5mOx7sD6ATZ82tfBMCYhBlrzpRHTEh3tZ7KPqXFoPrTc3ofhxM1HBsvFEFnSh4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLMtd3M8nzvIM6gAmaDigWB5FjzoKAycK87noVpw_-Rw&oe=6A5629B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7H3k_EfOgysQ7kNvwFqleM5&_nc_oc=AdofmYJn53zGziuvATUd22s2AlOLb8pAPCfdRYbV3jsfuowShhOiL7LIC6hqtNFK0a4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmqpqTF8ItLHgqNjp0Az-2LC83FpC1imhIIpp2nQ0o_Q&oe=6A565503"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us0ZvJn817kQ7kNvwG1zahd&_nc_oc=AdomhmGkCftEBIrdDF3xHmnxTpV54zsiHUyIGhDf_pvTTnnW1ojQ5_J4Yw2RXuF-HGs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKuHUEA-3c0ItZA3HcktDWFhqL7S2NIIP80NybvW2HzA&oe=6A564BB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
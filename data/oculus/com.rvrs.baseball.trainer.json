&_nc_oc=AdpaGSA5HrJdUR_U-INE3fCZs8qrIlUJyFlQGbA8jtHgDk7oyC8AzL9gRttqKK7tQT4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVre7tKEk2po8TcZcKQZaShRoiCD_4Ch6aQMzkQFV5bg&oe=6AAD3287"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-CPekmm7-cQ7kNvwHUBwiD&_nc_oc=AdpdYmX0kzj-lt_mkvIhQnBwnAtwQOFvD8WTWByvTx_F8we9RhfDbl1X24_Bp5MTLWM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5Vu2POH1eovqb7g9CTa-5RKpXcxVhQDBG4GZrc3CZYw&oe=6AAD61AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cG29dLUv1sQ7kNvwFAxDvr&_nc_oc=AdpjL3i1GPshSkTqb5-MgpAXqSc2u641hNFVN-S0uaB0yW41fW22iqSmcVTFT_FVezw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImP7_UfnR3Xq_mDSj5WhiFzmUk5bXlI1zSC5RHjKSwmg&oe=6AAD2CB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ0NqKy5qWYQ7kNvwHzRivI&_nc_oc=AdrEhKk1nK1C6SYf1l_aM-hs69c--kcNcAxr6AveddMhFf54Uayi8i71VgtT42c2ScE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-71Kf6GhxKTAStmUS1bhccbn15jcznGKaI5Ns1ckfhQ&oe=6AAD5803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt3PtShjD8AQ7kNvwEMcD_f&_nc_oc=AdqgbQmVmEGm4RUo3DWalagBWPZVft8XFwV4kbrhQpLYFyzpBK2SV98ae4IAePU8FRQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsVLg3Er-08Ty7y4eWV8MXmd5kHAqHQ_n0-AOBf_E-Fw&oe=6AAD4EB8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
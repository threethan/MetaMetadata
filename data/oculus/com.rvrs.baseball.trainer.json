nc_ohc=xVq_haYM1QYQ7kNvwFbWxt6&_nc_oc=AdqEgz34ksNflE79-wsrJgo9Cx_GrxHrTuN1a2nA6Pzo2Bf-6HRTTzv4l6v3Zi7GJ1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4kRv1-D9MBCgwgYELuWvYa1VFxn-umbxMLJIzmlHSDw&oe=6B01F043"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpmS3TQdN6UQ7kNvwFoX1Ry&_nc_oc=Adr0YfS5zju_JRPm68uMjqmse_c4aVkLNvPcVUILafs8ID-BkdTj3VT1Ydh8i-Z4-hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0ZKhjkv77bRt8tNuqVNbp0_LyfCdQTMdmvDqz0e_CHw&oe=6B01C4F3"}, {"file_name": "screenshot-5.png", "id": "1190561018044030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_1190561021377363_5895612526815394834_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YxtLnS1gD8Q7kNvwFpHCaU&_nc_oc=Adoe-xLmow4dqLo5yjEP4PzTVYY5GLoGkdRk8BRfbFuh5wvsriYS6hwIcDAX_7nyaF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYdSWFVRCkIQccFGBqzf58g13jEu2h4YbfOlU7OGgZHg&oe=6B01C533"}, {"file_name": "screenshot-4.png", "id": "922875505215237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUbHTX8CJwAQ7kNvwHcrrJ0&_nc_oc=Ado323UH9k060qrAQLvOP8EeX2jCc9hHNGa3bsLK8fKW6EXq9yJNYtatXe5Dw0M-jFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSribg6SrwhFUs-bMS-uq-X1ou_WAgfMmGCg0aRVf1C5w&oe=6B01CAC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "783288508992812", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974631_783288512326145_7599899629745698022_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp3Hafoxo0sQ7kNvwFO8olV&_nc_oc=Adrz_w5kzvbdgDsEHACE4bDcwrTzK6eYlffolnrE9ULvVwnyoOlDom5FfopNWN21xuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTowuJSGSpKr4fiC1R3wWNqZRHY56sSbBrgSzDdJ75LtQ&oe=6B01E122"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reactionvrsports.com/privacy-policy/", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
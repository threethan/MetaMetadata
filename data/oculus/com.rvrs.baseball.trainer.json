png", "id": "922875505215237", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW_BEcjLK14Q7kNvwHApqPL&_nc_oc=AdpH-FFesqOkWCYW5meTvCpz6KPXl3CPqjYqyjPZNakpeK5Lhc2gyozkgtWrxG5kM5g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-OS_POHVeg8NwmrYc3AhbUGSY3aTE3J-eWrbo5XnHgQ&oe=6B09B3C7"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPsxcfaWYLwQ7kNvwFynLZk&_nc_oc=Adp9EFipzD1FKsJUY4x1mMKBPxRkfM_m2hskD0LrCvsJFSYwmUsMGsv0JXifTBn7EWg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDdwqMLua7TqKaGFf9RMKHc4Jl1-Dy_Kn3soccYo9J2g&oe=6B09AAAD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MI5WbMjwp4Q7kNvwFsqJc-&_nc_oc=Adq0X1yITlS5YC9epkBKUuFq5yIsqdbfnzywz3EkiUNHnQkXQp5vtIRtq_GkR4uNfSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcOAoYWiR-dzwG0TQKjPAF-v7HtZ1Q7c9uhLBDADW6BQ&oe=6B09ADF3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qW3etUb9ToQ7kNvwHcGFm4&_nc_oc=AdpKb_IPY2CLKtzU2QoDuXv5CkOfut-wBFhRCCPP_Lfaty-tukPkgyPJePt42aqjphM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQYydeL50uKPQpiHxDAuoF4aXY-YmDL4kIqIVyZO6pcw&oe=6B09A103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXg_BYlaOVwQ7kNvwHSF2FW&_nc_oc=AdrWPW7H8GgBbDyco1A2vGCFJFwz1v4Icv_2lrDIJzxP6ozwYKglgKIgbioCMucQ4DU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQylJd-B6HholnKR-psw3XpJFiSI0MlL_2cSEejSiCcnw&oe=6B09CFF8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
&_nc_oc=Adpf2GIRpihbctbaLb4sshYoFSr0Nqiw0NesVfEHlIYV1-Ctqb-QG-Oy7flCxi-w-00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpOa6LXI1rNLpZS8_Yx9iUazStZiZHe2KQQTgMIVHEHA&oe=6A9EB207"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIIV3sCP5GYQ7kNvwHWMr9r&_nc_oc=Ado436hTIBz_trXMCWG6zgRdR_Pl_fW9C8-De2lKliIoPwm1dPHjHWqiK5Ms6Cw8hRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM5OSGWG8m2PYXZgFEBYvrrX3elm_yAUUdLNSDy0m0ew&oe=6A9EA8ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNmva8zvQQQQ7kNvwEilubY&_nc_oc=AdoiU9CpwPn8ryw3x6PLN-Tz7pB4Yx25TJhJ2tBOCrRxXP-LTouVxreqJpZNTsXlR5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5Q4SQrzUhBiEqmxz9FH_T-5KSJH83Ff2Ut8sndu9teg&oe=6A9EAC33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xzh1Qez7xIQ7kNvwESNjYC&_nc_oc=AdpbBtGZDSRr5fnlSgXG7Vd7iPrDP7ntL8U415uWNtxHwEEydylRTDek2bvyW9CgiOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_m6JmfsyDWoj8nFW-XGliq7KqMYMJ4DbqHS8Es_haqg&oe=6A9ED783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDiTBUbWpOQQ7kNvwHWEFj2&_nc_oc=AdpqgDWdy4eu3_9Sull1v8vzHcwmgrvG5coqpiaV2Pu5_x9KsznLmrL4pkm67fZ9cAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDgOvjxW6zuMOrGPye-nxIMMHhSWu6Ln3vGJylVKAZWg&oe=6A9ECE38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdoL-qX7FXSNh5la_SbiTEx5LT-NtZBj3yfI5-3VCZhSet2s5Msgz2x3G64cQh6h5Es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgk1evW48LrjMLoJJexG94eCaXR9hwDHggGAa7kPaKEw&oe=6A64B007"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX8ZJx6cqq8Q7kNvwG1cagp&_nc_oc=AdpnrkmGorfUWxmNlTdCTfXBuygmL1-6KiwqUNl18exTerCHLidtftIsOLbeRRgqjl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFiusycoCX2rKc5xmktN6pyoeII_XSy1t2bXis9tndPA&oe=6A64A6ED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL3xf4-pmMMQ7kNvwFSphQp&_nc_oc=AdqbJSHpnORyNGNnJ3oPrQcdVeWO2qn8j_dVY6AnhKW3O53hce1SNcjYR9nfcQqML64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUWQlf7l3ZKK1Cu-o5Gia9alzcGIWhN9WXjpjYeuMFqA&oe=6A64AA33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASwYmm5hOlQQ7kNvwHl6rXf&_nc_oc=AdqICYH6jpBFJ7fcc_OQ10gwO4rg2ZqAR6n9CLvuUxdM331jVebBh7-dk3Texvd4v4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF3pCwHRViM7EAUWtj5ek6gbNJLRMhYqsxSDdstYGOwQ&oe=6A649D43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTWD6TTKQT0Q7kNvwEZod1W&_nc_oc=AdrlXYc2kYa5ihfLqALPn1aQkngjAyBlMztKcDEZy_5EcD5UsVwRAASpdZqFvC868jo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAepzG_r9gKwGSOUCVwr-Grc-BNhfIsfS2ikOqgphdULQ&oe=6A64CC38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=Adok12RLu_YUBVNEe3pGBcxTxpQIQiSow75kG3koOiyqQrOEQEQe4WdbnNjxTtJoffw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM03L8rfJcmRjpuUA9EfC77EvXvATN1R7AcSSoTgpQTg&oe=6A5A2407"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUnIKEKmL30Q7kNvwHcXqmN&_nc_oc=AdoiOh-BAUrTwwwPtyOdnO3E642NVk_Yo1hjLr9DXWDuqFIhwqI_NhpPVzzk3GlnNYI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjvhNrnJEJJDGLjUzjp7YbAQ-DLd8gIQbkOXzRLIrGrA&oe=6A5A1AED"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBc6-b5rL7QQ7kNvwEzwmIV&_nc_oc=Ado9JApp-Rzcg9QjOf0cFSVki_pxKjiRFrhANXzOMiRFJxLP_FHDAAFBJ1bzqwfumvY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD38ICmKCgGvIozVDPNEZHyf14fDKg-F-BKy0jzVnUwQ&oe=6A5A1E33"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zlVmja6SS4Q7kNvwH0Age7&_nc_oc=AdoLSxOyoZ4R1ICnci-0YMYdVTRaartHljv5i6IL4ub2kZsFeBqMye2Ozv56PSDK2r4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvSOLwupaHe2oaHWWWpDM4kFhuQp0I-3-0nOjjWz_e5g&oe=6A5A4983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LChAdNvg71kQ7kNvwHNQ1J6&_nc_oc=AdpuEkySPhYQCk2bM3RZ48jEVm1r4b52wHgq7dLCtiYb9mJH5WvlJ0xNjEmMqnT-Nqc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_eBqqWz76l0TKHFLlfB7KIuVSzo-HFvJ9AdjejmkT-g&oe=6A5A4038"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
&_nc_oc=AdoT6WeUj2q8DX9omBaQ7-JJFQzUsQFtq5tGv2biahD94LcUaXcLSKKzzGIzP9X1Zjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_taxVsQ3pxFWQDt4_4NboLule8Ii7meoD_UIiy_qJvQ&oe=6AC63F07"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SN8GarndUQQ7kNvwFghEa1&_nc_oc=AdoqzZhihkksVIeURavXkgQ8FwJ6mu3Fv6pXwQiFiXVtFLCms5NWIyZQ6Mt0KABCLrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrLuHRj0q8XznCjawjP1LsQLdovv7hCaujdY2vm5Ziog&oe=6AC66E2D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf0V3-mayKkQ7kNvwHB3iOv&_nc_oc=AdqzI4dR7LkoZ70DtaNPNBPbymNZAKrLunJAiXsg7FAHwtj23yM-_eRMgrRt1x1EspQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeMZsNKu995ME0N217IBI0vL7S5TYpz-tI1zZ3lYSWpQ&oe=6AC67173"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8a687zy6bVsQ7kNvwGy5Z70&_nc_oc=Adrs7KH8uRLEgGOVympymk90HzPNpgOc-bjty56lCXsTZnH3Ql0-OdEcp3AFHJ_UtRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN45IPBxgTlm8V3XrYKagy70-j27OqCc3VqwjCy_3qLPQ&oe=6AC66483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9x1Cj8sxNEQ7kNvwHPSGAJ&_nc_oc=Adp7eI5ssUazKklTBg_6TucSOUwW5h2HOBaTlNw--74I02aIYirrLZlgQwhpv3kT-K0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMghtmWGHMRKjgTK8gJC1FobyVJWdzMw2VTLTtBTzrqhA&oe=6AC65B38"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
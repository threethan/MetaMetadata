&_nc_oc=Ado4K4py3vDlouWyU99VVxwivf-XNMcDlxBymDE2-N7LBtmZxoxz2tU4HIJwBHwCHTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0tw8f0NhYrFELS9UEF3vQW9wpKPiTttBFfb-nbDrTjA&oe=6AB27887"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpk6RtX8BVMQ7kNvwG75x4g&_nc_oc=AdpKXyIrFBS9GAvsHFEnyHGyrgjbfg0qX4KYF2zNCp7EwiZ2XL9H61fOAfEHuWM1yr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqF6GSIdcaqVfquXvRe0BJmFnAkU5rL1qQoajgjS7rAA&oe=6AB2A7AD"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63U6ci2o2ccQ7kNvwHsGf-o&_nc_oc=AdpKXQ-RkJ469Fmvdq27_eN9YQytF6AZSBvfnKxjbTvZrhnCqCEV1h4oH7J6PUigWus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHh9C-AoyRMDXxuGTfMqk-D_YMIEWl6epvAewYe032Dg&oe=6AB272B3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mry2dQrHMYQ7kNvwHf5eiS&_nc_oc=AdoZi-Z7BmfmjnuMWREkyX2jf_ntHEA5GtsPGK2cHAMIYcbQAr7RIRZXTLeXp3xZ5-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8S8SL38556gGjtO5hxbzHhYPlCiU7ctTG8GxUqX68fA&oe=6AB29E03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkZVGqzOuCsQ7kNvwFm8dpU&_nc_oc=AdrZDHlqfDjNO4CWURSbz9jVjqdXSA6FddVY0zpn-O_tqysUMiAHDijCcTpNe_TepBg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_UKnbEEtyrGn7suKMdBQYzyxdeA3sEri6mDEDltJLVQ&oe=6AB294B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
png", "id": "922875505215237", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031468_922875508548570_7463011832886051377_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW_BEcjLK14Q7kNvwGO83-c&_nc_oc=Adr89GodlsR00ljt7os-1RDdSPOdBTq9F-iHeAriC6w_vydSXYVpV6VCMTH6nuEMTk8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo32MIOr5xqURKhGSyXOUDTfUxeTpiPfWvmUjWIJz_GA&oe=6B086247"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPsxcfaWYLwQ7kNvwE6us6q&_nc_oc=Ado9YxjmEmnG_8V5dadgpz5yD7bxhqzlMcWVq3GAMmy8l4X_0VgHZrgNuiwtm57Nprc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2l3p4sTo1OoOxy7IQE6MvXZRc_zNmO4FfSJSFG-ICPQ&oe=6B08592D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MI5WbMjwp4Q7kNvwHcZijV&_nc_oc=AdqfbkvZ7vmN310aLrEIAF0BYxT2pEyzV8dqEiI23JY0WtxBtuZDUpj6jE7oU8MC92Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbgpe7pF0QyMue9J5mbsy41mblsidjVoADObK25N1X7w&oe=6B085C73"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qW3etUb9ToQ7kNvwFiJsw-&_nc_oc=AdoDELFUgqqhZtc-9kGortacIYdJxFMlb_CvPyUjnWoFNuxhBdRE2xQ6Bzsd6QvxYRU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyDdnAtMFQSg0PiS-6ky-hVFybDywrtoX3xlEtaP9PUg&oe=6B084F83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKvvuhrR9KUQ7kNvwGOjfA3&_nc_oc=Adp9llNsk76_H0JoyofhkxscLL_Am_pWzI25MvLRwmhhDC31_ReCacz7Q8Pqlgn0o9o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTRViUuJ2V-LpxsDcsGqlF2RHEy9QHQkzarFKNQYmfAw&oe=6B084638"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genre
&_nc_oc=AdrasAEsuyM9hcRFkpiIp1o4kVzOCF2lX9PY6a4WAfk7lwn-pB3Q5zCrTS6PK31_VOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8z7vTA-h9zzretS43DJiyQVtjRXGAfaQ_oZH9cWJt5w&oe=6A68A487"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3w5TCSPhhwQ7kNvwHv1EZm&_nc_oc=AdrUyKivlHQNVHnGZM6LOtjeAeWn2JX0e51ypeSWwcBl_BwIbd4lsmOyo8RLwPt-xg8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5T6wbaWloQtR4ONk9jPWtoXvIK4W4bMdAZfaQ5DLn3Q&oe=6A689B6D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjYw_TcxglUQ7kNvwFLp2N6&_nc_oc=AdpER-3Ajz_7EahJn8ETSawi3_FXw3rpclxKNd_9B6e9lBvfZRhc2_6LiFhRRv4_vQg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe0uYkpbqAIBWI30GudxxrSDz-DhfCfsoT_BlUDrX3qg&oe=6A689EB3"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjWbEt_ARQcQ7kNvwH8nNIN&_nc_oc=AdrzINEiPQggof2jzLjpCtYpPAIbXDU5gCzwKwJqnm5IArA01NbZcrpyUqzOeubPiz4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD94U7FYK0HImhjEtIf4JvgOXQYy9t_B5D8ZU18qC009g&oe=6A6891C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_4pGz305k0Q7kNvwEhdaKL&_nc_oc=AdqD_z8Anq7wH5h6qzE60mzR0esSWh2FDzD9kOT-Xp51o0sKluR4PCfX2ZC_5hsLKdo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzMnsVXsrA7oHrlPnu-QJooC7JDtRXLCOSezqnoA6sNQ&oe=6A68C0B8"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
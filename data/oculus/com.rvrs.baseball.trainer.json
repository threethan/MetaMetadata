&_nc_oc=AdpmCtgxVjTDjbP1dPI-8nuzZOS3wz_rvWljkR0jeyAsanP3jrW5L9BtYUzUS0a1NIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh12jDP9HJPM1o_HOInatQATW8m_cZ3XO1vvpWOE8VaQ&oe=6AC13147"}, {"file_name": "screenshot-1.png", "id": "739522113412681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_739522116746014_6293149237924671117_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM2WDal09ToQ7kNvwGF9rti&_nc_oc=Ado4S4IJrn__GKH3JPgVrjRwn3C8E_jBVEIsrM3TFppipGpyKqg347SpxTX0KrVwzPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy7dKznaphQIOdv5Kmm19CYBL5b4KQD_JMWWaIgrPpTQ&oe=6AC1282D"}, {"file_name": "screemshot-2.png", "id": "303940704438089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974631_303940707771422_47959131810563148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYfNO1ncK6wQ7kNvwGGS_tW&_nc_oc=Adr4rTMwMhF7VFN4aIz4dYCxpnTbjUt0XojSLk-OVEirBZ5O9n45R6cu2fijsXF2X6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBrQh-8Q2fQHzXGKKkiirkuW9KA4-v_VgaZM7b3SP6bQ&oe=6AC12B73"}, {"file_name": "screenshot-3.png", "id": "270348101371386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984454_270348104704719_5941816795173794037_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz8ihb3r5HAQ7kNvwEHdWLs&_nc_oc=AdrCgE6KlTzaqKz6T1cEAM2fBUheZ0_cZ7iXwIhoe3_diDY60tmTeM5h2UCau1GNOdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3hZhifXIqh0j4fhAtTsy8pBQWcJSB4D_67U6dhvf-EQ&oe=6AC11E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "266314308438577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035336_266314311771910_795945671031329437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVo3zuo_0IgQ7kNvwHeI98t&_nc_oc=Adp0mxZE5LjKdbZqI6jBfgtRviHM0_YfNHGsncIUzbwuFpkXpD8d449lk_Qv5WRw7Nc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVYQLYjl0fdGnzNekKWxqP1EaAoTuYNaUj7uYutyqAtw&oe=6AC11538"}, "display_name": "Virtual Baseball", "keywords": [], "long_description": "Players need to learn how to follow a high speed projectile in sports like baseball, tennis, lacrosse, and hockey.  This is especially true when the projectile curves or bounces.  \nWhat we have found in other sports is that players can learn to see faster projectiles by slowly increasing the speed of what they see.  The player's eyes track motion better, and their brain learns to predict where the ball is going.\nEye training for baseball is the same concept.  View more pitches and increasing speed. Learn to follow the ball and see where it is going.  Having trouble with a particular pitch motion?  See more pitches and learn to see that ball!", "short_description": "Virtual Baseball Eye Training immerses you in a virtual baseball field using Oculus Go and Gear VR. Change the type of pitch, pitch speed, and other factors. Then get to work. More reps is the only way to get better. Train your eyes to see the pitches and follow the movement. Improve your game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.reactionvrsports.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.reactionvrsports.com/vb-eula/", "publisher_name": "Reaction VR Sports, Inc.", "support_website_url": null, "website_url": "http://www.reactionvrsports.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDIN
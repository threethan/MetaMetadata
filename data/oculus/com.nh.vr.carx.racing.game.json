.com&_nc_ss=7f20f&oh=00_Af9JU-hV6yK38QO1XHAqY0r0avxdRVeIoibY0r8eXsPpsQ&oe=6A3D5B8D"}, {"file_name": "ChatGPT Image May 16, 2026, 12_19_39 AM.png", "id": "1535638601264409", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618064_1535638604597742_7270744547829583429_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKYZAgSGUaEQ7kNvwFsP5FT&_nc_oc=AdpT9-E0SsBAUN1OLKjRFjZCfebeGwTO9rk0mZFdLdzlseG7WONyl-XQ9roOIo4-VzU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NmGQVQ9MNh4IM7ctpAOYisG3uQmkgdRztKtN4KdYmtg&oe=6A3D4B82"}, {"file_name": "ChatGPT Image May 16, 2026, 12_16_41 AM.png", "id": "1526139545803602", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618432_1526139549136935_7349688047000566784_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9KVJJ70xBwQ7kNvwEPtkI1&_nc_oc=AdpfEh4baiDOAQ7CRTqgif9bmE0Ff2oVuVvYhh-x_DfI5yvvLIVZZHXVVWn2_0nt3Us&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I_4PWGXusz66wxzFIhxAuk7AI7Tcb1zFYKqBUvceJFQ&oe=6A3D569A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpeedX Car Racing Game VR", "keywords": ["cargame", "carracing", "speedxcar", "cardrift", "racinggame"], "long_description": "\ud83c\udfce\ufe0f Experience the ultimate Car Racing Game VR with high-speed racing, realistic driving physics, immersive cockpit view, and thrilling car racing game action designed for VR players!\n\nGet ready for the most exciting car racing game adventure ever! Drive powerful sports cars, race through challenging tracks, and enjoy realistic VR driving in this action-packed car racing game experience. Feel the thrill of speed as you compete in intense car racing game challenges across highways, snow roads, city streets, and dangerous racing curves.\n\nThis immersive VR car racing game delivers smooth controls, realistic environments, and addictive gameplay for all car racing game lovers. Master your driving skills, drift around corners, overtake rivals, and become the champion in the ultimate car racing game experience.\n\nFeatures:\n\nRealistic car racing game gameplay in VR\nHigh-speed sports cars and thrilling races\nSmooth and immersive cockpit driving\nExciting snow, highway, and city racing tracks\nFast-paced drift and car racing game challenges\nRealistic driving physics and controls\nAddictive offline car racing game action\nStunning environments and dynamic racing roads\nEndless fun for every car racing game fan", "short_description": "Enjoy the ultimate Car Racing Game VR with high-speed driving, realistic tracks, drifting action, and immersive car racing game gameplay in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26999244233042276"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623384_931043449934705_2347317300375172094_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHVVbDi1CMkQ7kNvwFH2rZo&_nc_oc=AdpxxVLxMmDFGr4KgvGebd5AQCQvzAt2XpKHCk6jHIqsn6i2r7dB
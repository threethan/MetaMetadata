zEB0pP8mn-0ah7nccR_qAcdKO4jiPlGsS3JU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHFv92Fk4G7Culxe6oYDAL0MZHQvnju8OQVU-NijbVsA&oe=69C6961D"}, {"file_name": "screenshot_202404230033274107.png", "id": "1111784780045415", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984440_1111784783378748_6963712676489512728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt02ZMb1-ewQ7kNvwEIGqgU&_nc_oc=AdrSATLCP3oZJ3eEBJ01ioGjtE0gOYDHqH3HZcAoPQYE-fpiFSvit-0xLpHkulEtmP4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzE68_odeOOaB95b9ahnpDOu8t1d78MLs3qDpXdzmIWKA&oe=69C67A36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIiCBexflpoQ7kNvwEBg2E2&_nc_oc=AdpU_z6PZV1A8G360h6hn_TecfirPZVtZEvOrF1aYIcKysFiAK_A4Ot2j97hWsOHeCo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWIHrlZ419R1v44Q4qan9SYNlEPgdOM8X4OPsaw4bILg&oe=69C6744E"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_des
02404230033274107.png", "id": "1111784780045415", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984440_1111784783378748_6963712676489512728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Saeoc7Jut8EQ7kNvwEJf7Xi&_nc_oc=Ado1ERcsWcdPiFfnWUat7KbReSPXHl7y-NyC4PaJ3SmfetPkbCKiipIevmZLoVeQXdk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLdVt-NI4By22rumya8cN9gEHII1l0D63a0N8mPAR6QQ&oe=6AECB0F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfipddWHAkgQ7kNvwH8vZ0j&_nc_oc=Adp2smkMej4IIxaBlO8UIE8q8n2EdNSCPRh3O9JzxP3Pe0aaupdgYcr_RmFwzrcS6hE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2tokGBNLydfLFiMZykpz--ayt6Gj7I1jHijFOa1jJ6g&oe=6AECAB0E"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. "}]}, "developer_name": null, "developer_privacy_policy_url":
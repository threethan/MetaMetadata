5JQbyWP0cN2AHQvx3WCcTXkQ&oe=69B68BDD"}, {"file_name": "screenshot_202404230033274107.png", "id": "1111784780045415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984440_1111784783378748_6963712676489512728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzIB1ndgN3QQ7kNvwFcweu0&_nc_oc=AdmQjnUB-pNFjCjoJaSDxr8AMk0ZYekC7aWgCBh6k-Np9M6XFsxEC5T2FioXBIpLPlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzItQI4-ZqgOHHiiY7eQTLnWsRSWQ1YbA3szHLpv0yBSQ&oe=69B6A836"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Bkxleyg5QkQ7kNvwF9MAMx&_nc_oc=AdlXJUr0QzOYK4oarntknfzOKezY9kOe5uza5yyFviXmfRSKP6sOkozCQcxEzQmNjn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7uXWkes2_1w0WSCeZsuy7Cu-8dxWkHxkCk_XMQuTzVQ&oe=69B6A24E"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. "}
d3-1.oculuscdn.com&oh=00_AfstPdmtKBB_DhSdvOq3SUWABZH8K9_GfavdKPoDDoI3jA&oe=69A6E3A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_049_0001.png", "id": "1225065479017157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1225065482350490_3811407694473971828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_pCBjPEQUsQ7kNvwFPqZcd&_nc_oc=Adnu9zcT29_n7WCtxLVCPDpHHhMZ4pbPqt2P2ees-wwz4opmbwyMqJ3KX4kJ5tUdpIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvy7AcOUrTT2Zn6mWYuZOQcWhJWqVrrpcwiWKBsgZLBQg&oe=69A6DC6E"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. Experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team.\n\n{9566889240078397}\n# CHALLENGING OPPONENTS\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life). We have slow-motion options so heading becomes easy for new players.\n\n# REALISTIC BALL PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n{1054558193429207}\n\n\n# FREE-KICK MODE\n\n{24502713752669059}\n\n# INSTANT-REPLAY\n\n{1441983417130503}\n\n# COMPETE ON THE LEADERBOARD\n\n{1834780490720812}\nScore as many goals as you can and climb the global leaderboard! Let\u2019s become the world\u2019s top scorer!\n\n\n\n", "short_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. With accurate physics, detailed graphics, and challenging opponent AI, you can immersively experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team."}]}, "developer_name": "TDSOFTWAREZ", "developer_privacy_policy_url": "https://goalpoachervr.wordpress.com/privacy-policy/", "developer_terms_of_service_url": "https://goalpoachervr.wordpress.com/terms-and-conditions-for-football-goal-poacher/", "publisher_name": "TDSOFTWAREZ", "support_website_url": null, "website_url": "https://goalpoachervr.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "pt_BR", "ko", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25537174919310191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622285_1259384912704400_872665921247207824_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsnWK61zlR4Q7kNvwE705pw&_nc_oc=AdmoegkPSl7DIHas1Cd50w4c9bGMrIRtdFFnnW4ErGWvR_VC0eaRhtXnNeLzeygj5uo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMpSVfMSX8mfOUgesQxYILfF02KMmQd13ki8I-vcvRXQ&oe=69A6E392"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Football: Goal Poacher (Soccer)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "conte
eenshot 2026-11-09 024916_2560x1440.png", "id": "2099199644053210", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623558_2099199647386543_3855744767972967780_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWe92Gy4B7AQ7kNvwFHDloR&_nc_oc=Adp_CcHVXgnnHx0Mxv46grPQr8lIQ0vZALZYx8I02J-SYfcIonTMN0LuC65JEBLPlf4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlgfidAfdy6eGJk_-DuEu77ipW1MKE-ro0JFYJRMnU8g&oe=6AFF1AC1"}, {"file_name": "Screenshot 2026-07-12 020917.png", "id": "1173228395005694", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604275479_1173228401672360_5262067818734771833_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJxR5AvFPLgQ7kNvwFT9UGz&_nc_oc=AdrFG8UVv2gCHjVEq0B5rSkmgw-haZEK98ucoTrQFTvJb0PkE-treIAePLG-NDDH3uI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuYYWOTSFrj3dVxpuD1yzx6YFOCbUUP16S0w7eN2my2A&oe=6AFF15D3"}, {"file_name": "2026-11-04 (4).png", "id": "1126733580110718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620655_1126733583444051_3199762911365800013_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFHVV2HXTw4Q7kNvwFpeDuI&_nc_oc=AdraonifLQa1XaAG5IY_17SJrVS4ib0r6VopT6g0GOgyAA5hRsf2XuPm5gtyk10AtFI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSHM0kttAhOHYl1FniiNztwvMAMoxvPvNnFTabcclIZQ&oe=6AFF1A44"}, {"file_name": "Screenshot3.png", "id": "837368162020162", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619078_837368165353495_8639116383032235639_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFlz-C48tHQQ7kNvwEaU7Lx&_nc_oc=AdobUsWVY4Z6vsIyn41IkLDRpOIAsudr_sQRvknN89tF6G2jbvJBsU5VvtOppsyakB0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeKyMqCN0aTZvNx0zPB9VRoTTZT0puvBnhCMFbBSB4rA&oe=6AFF18AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499620856_1704091034060376_2909133537550404890_n (1).png", "id": "1092934360311445", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624069_1092934363644778_9128174337239477357_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swRy-acmx-4Q7kNvwE45m66&_nc_oc=AdpBuNBsz3AbtbipBPu4VwZ9qGbA_i56cv9SOQB9qxmldgVxSQNnuasNFO12Rs9zF7w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyyD45ItBrKglqiLZFUp7UGP8KNCST846MADdsx_nv9A&oe=6AFF21BC"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "Football: Goal Poacher is an authentic VR header simulator. Step into stunning stadiums and score spectacular headed goals or set up your teammates. Read the cross, assess the defenders, and make the right call to score. \n\n{1054561100473339}\n\n\u26bd SCORE WITH YOUR HEAD\n\nThe ball comes to you. Stand in place, follow its flight, and use real head movements to direct it into the net\u2014no running or jumping required.\n\nRealistic ball physics make timing and placement matter. Slow-motion options also make heading easy to learn.\n\n{1054558193429207}\n\n\ud83e\udd45 BEAT THE DEFENCE\n\nRead the defenders and goalkeeper, spot the opening, and place the ball where they cannot reach it. The tougher the chance, the better the goal feels.\n\n\n\ud83c\udfaf FREE KICK MODE\n\nChoose the direction and power, then move your controller to curve the ball in mid-air. Beat the wall, outsmart the goalkeeper, and find the corner.\n\n{1741873797002828}\n\n\ud83c\udfdf\ufe0f UNLOCK MORE STADIUMS\n\nKeep playing to unlock new stadiums and score in front of thousands of cheering fans.\n\n\ud83c\udfac RELIVE YOUR BEST GOALS\n\nWatch your headers and free kicks again with instant replay from multiple camera angles.\n\n\ud83c\udfc6 CLIMB THE GLOBAL LEADERBOARD\n\nScore as many goals as you can, compete with players around the world, and push your name higher.\n\nPlay now and become the ultimate Goal Poacher!", "short_description": "Football: Goal Poacher is an authentic VR header simulator. Step into stunning stadiums and score spectacular headed goals or set up your teammates. Read the cross, assess the defenders, and make the right call to score. "}]}, "developer_name": "Tran Duc", "developer_privacy_policy_url": "https://sites.google.com/view/goalpoacher-privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/goal-poacher-terms", "publisher_name": "TDSoftwareZ", "support_website_url": "https://x.com/GoalPoacherGame", "website_url": "https://sites.google.com/view/goal-poacher-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "pt_BR", "ko", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28857223087305341"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623443_1994903054493016_8577378146603411935_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhYb-AzThysQ7kNvwHFUOL1&_nc_oc=AdqqSDWMwIrTy-pQJ1icbtYLRs2x4pYl_18xQZeeVYJSfGeCCD18sU0bZs04Pc2xWOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfyTC9HSRmFSSeqOZE5-TNqYOFMOXo6-eu0JIbLYWfMQ&oe=6AFF16F9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Football: Goal Poacher (Soccer)", "platform": "ANDRO
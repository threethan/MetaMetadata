011420_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4FUZdv1rJUQ7kNvwEhTASc&_nc_oc=AdqO-iKfS6s28PCMJgbOhhgYnHX-4GMdu-3_JBlcqZOiFGpcBUM7KM6z9Il0hJBVETI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V7VT71b-8BGR53s1GXV2hCaz07meBU_1WSt1ITFhWZA&oe=69D6460F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_nologo.png", "id": "1481206600319197", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_1481206603652530_4488381304369071550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eedVPX6BB2gQ7kNvwG6Kz9d&_nc_oc=AdrOg6jMB7f6UVHVnoppWHECeuy9t9jgI3eJk7AZezswV1NmF3vof6v0imNp_3FRju8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wLU_NcUXLyuyjzdqeuLHSiy1IdNnaxFGec1E6RS79LA&oe=69D6588F"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. Experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team.\n\n{9566889240078397}\n# CHALLENGING OPPONENTS\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life). We have slow-motion options so heading becomes easy for new players.\n\n# REALISTIC BALL PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n{1054558193429207}\n\n\n# FREE-KICK MODE\n\n{24502713752669059}\n\n# INSTANT-REPLAY\n\n{1441983417130503}\n\n# COMPETE ON THE LEADERBOARD\n\n{1834780490720812}\nScore as many goals as you can and climb the global leaderboard! Let\u2019s become the world\u2019s top scorer!\n\n\n\n", "short_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. With accurate physics, detailed graphics, and challenging opponent AI, you can immersively experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team."}]}, "developer_name": "TDSOFTWAREZ", "developer_privacy_policy_url": "https://goalpoachervr.wordpress.com/privacy-policy/", "developer_terms_of_service_url": "https://goalpoachervr.wordpress.com/terms-and-conditions-for-football-goal-poacher/", "publisher_name": "TDSOFTWAREZ", "support_website_url": null, "website_url": "https://goalpoachervr.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "pt_BR", "ko", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26033729779654700"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_979451511433691_3923216029085260827_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFsxGo6DI7UQ7kNvwG2Iy5P&_nc_oc=AdrkcQik2zGw1WwoISPas0hQ0vUBX8ajXzdEOSVaqaVG1HMeii-CyCj8VC3VTYNYMHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JZ07ct-9yZ6VjNtzzJdrSKVSx_8_J70pfRg3yddGbGA&oe=69D64AC1"}, "is_concept": fals
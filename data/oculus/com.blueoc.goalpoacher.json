_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgxcXtzYc5MQ7kNvwFrj0za&_nc_oc=AdqbHMMvVaLQiAYbUaQopPrBsZfoiiGJOYdHNLMABK6hJuHDZWQZPLo0HT3qGDmabVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTs-KDpit4hOoDDNpCeovmeuVB2SzZ9LZadbdh3vdgaA&oe=6AFDB81D"}, {"file_name": "screenshot_202404230033274107.png", "id": "1111784780045415", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984440_1111784783378748_6963712676489512728_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqCP-PtCjxYQ7kNvwGKdbL1&_nc_oc=Adq3IlSermsv-LCnSJZw_CDCHSC-bA-KxIUFcvsD9UUbzqA2W0G-pN0jMTlwLuFYD78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZNuuOOsVHhuj3jB-TuhuSM7qyez28bBOPj8LynPphVw&oe=6AFDD476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95vyDVqQB7gQ7kNvwEVAQiH&_nc_oc=Adr5PT-DaugOYBHBjeT5KM7w_wZoq8UC9jWq6n3UxPkq0R3gSg81VMJwgisxmN5pK38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYWDeoZOpOUR8qiNlWWXMgRgo66pONUdUIRlT3xKjRoQ&oe=6AFDCE8E"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blueoc.tech/en/case-study/goal-poacher/policy", "developer_terms_of_service_url": null, "publisher_name": "BlueOC studio", "support_website_url": null, "website_url": "https://blueoc.tech/en/case-study/goal-poacher", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7279132668874361"}}]}, "scheduled_offers": {"count": 33, "nodes": [{"status": "PENDING", "id": "1799483261155400"}, {"status": "PUBLISHED", "id": "1696406401820717"}, {"status": "PUBLISHED", "id": "1779936899963747"}, {"status": "PUBLISHED", "id": "1681009813588418"}, {"status": "PUBLISHED", "id": "1543550163914860"}, {"status": "PUBLISHED", "id": "2147595819441470"}, {"status": "PUBLISHED", "id": "1629500584930757"}, {"status": "PUBLISHED", "id": "892799110192167"}, {"status": "PUBLISHED", "id": "1266796688832251"}, {"status": "PUBLISHED", "id": "1215886140747045"}, {"status": "PUBLISHED", "id": "1216521687241287"}, {"status": "PUBLISHED", "id": "2279609602465685"}, {"status": "PUBLISHED", "id": "769290909416289"}
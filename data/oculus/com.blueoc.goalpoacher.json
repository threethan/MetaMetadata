8A6Mtw&oe=6AF489D3"}, {"file_name": "Screenshot3.png", "id": "837368162020162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_837368165353495_8639116383032235639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIa23As1uncQ7kNvwHatOFh&_nc_oc=AdoWtEodsKaO78DC4FxegJKW-Ek3J95DeahXHOqw0eINbdZMU9eIcj9vol-oqPqvQRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScyMSaiQmqrBiN7Ilo6zQsZ2_MT1tBeCH3Bt_6nLGW8A&oe=6AF48CAD"}, {"file_name": "Screenshot4.png", "id": "4151161721789179", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_4151161725122512_8294678093138556140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLbsrnUaKAMQ7kNvwH-Gcer&_nc_oc=Adowx9fo8kD9m-h4qud_xhGQ-GY3NGeTKDXAzjrPbCXtRMoypHDgce6vrzvCbhSq2uQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhJTPB2pDkjnAgiNhflB8D_1GXzpa4elipea70oZ0tOA&oe=6AF48C5E"}, {"file_name": "Image Sequence_032_0002 - Copy (2).png", "id": "2179628229469334", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_2179628239469333_5606025214715666203_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-Ev1F3X1yIQ7kNvwF4xIZS&_nc_oc=Adr8BgSZL39zIgjnJFUWWakKUSn6sddPQsRCYYdfSfmbnXt9C1cWPZHz__ffPmG77Vo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmBdLEeS6AKU_fUfeDCBTN1ZlTotkM_ofbxft2y3GWTw&oe=6AF49A1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499620856_1704091034060376_2909133537550404890_n (1).png", "id": "1092934360311445", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624069_1092934363644778_9128174337239477357_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzthk-Z77pMQ7kNvwH4O0BQ&_nc_oc=Adr4X4UirWoM1j5KhfQY1BfNbJzg9c0bHJEMT4H8C--JEMZcnLNt0rmB-wc-WIO2JAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK40RdiE2VxTZiUiDU_7OvHkgGzuZhU0RV_i-hzUsHIQ&oe=6AF495BC"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "Football: Goal Poacher is an authentic VR header simulator. Step into stunning stadiums and score spectacular headed goals or set up your teammates. Read the cross, assess the defenders, and make the right call to score. \n\n{1054561100473339}\n\n\u26bd SCORE WITH YOUR HEAD\n\nThe ball comes to you. Stand in place, follow its flight, and use real head movements to direct it into the net\u2014no running or jumping required.\n\nRealistic ball physics make timing and placement matter. Slow-motion options also make heading easy to learn.\n\n{1054558193429207}\n\n\ud83e\udd45 BEAT THE DEFENCE\n\nRead the defenders and goalkeeper, spot the opening, and place the ball where they cannot reach it. The tougher the chance, the better the goal feels.\n\n\n\ud83c\udfaf FREE KICK MODE\n\nChoose the direction and power, then move your controller to curve the ball in mid-air. Beat the wall, outsmart the goalkeeper, and find the corner.\n\n{1741873797002828}\n\n\ud83c\udfdf\ufe0f UNLOCK MORE STADIUMS\n\nKeep playing to unlock new stadiums and score in front of thousands of cheering fans.\n\n\ud83c\udfac RELIVE YOUR BEST GOALS\n\nWatch your headers and free kicks again with instant replay from multiple camera angles.\n\n\ud83c\udfc6 CLIMB THE GLOBAL LEADERBOARD\n\nScore as many goals as you can, compete with players around the world, and push your name higher.\n\nPlay now and become the ultimate Goal Poacher!", "short_description": "Football: Goal Poacher is an authentic VR header simulator. Step into stunning stadiums and score spectacular headed goals or set up your teammates. Read the cross, assess the defenders, and make the right call to score. "}]}, "developer_name": "Tran Duc", "developer_privacy_policy_url": "https://sites.google.com/view/goalpoacher-privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/goal-poacher-terms", "publisher_name": "TDSoftwareZ", "support_website_url": "https://x.com/GoalPoacherGame", "w
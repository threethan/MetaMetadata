tps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_33318742161058060_460021521451067233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVohC2Op1JoQ7kNvwHXQeaP&_nc_oc=AdnFYjfjP5Kf-hw6ClLcN-kOkDgh400CvIvS--EbHal04zwpYjgVXky480cQJt3IVXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsE5X7GjMbUFSyUlce6OQGKPHqtIGYynx5zxVE76cfSGw&oe=699D8274"}, {"file_name": "Screenshot3.png", "id": "837368162020162", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_837368165353495_8639116383032235639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi8MNKPwa_IQ7kNvwGaax3C&_nc_oc=AdkMuctfRlC918hZzNvRuAV3JPDWM0qtEt_AgU7wz22eVBZar3TiqnRutAhCwPxLt30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvsqrNECLkfgVV05zeGWqPxLLfMg1ko3yIANPiAXtHeQQ&oe=699D8E6D"}, {"file_name": "Screenshot4.png", "id": "4151161721789179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619518_4151161725122512_8294678093138556140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR7lll3GWyAQ7kNvwH3kmeQ&_nc_oc=AdlKKZpBykCrDDGwvfk6BRPdodxTttEAXgLTdfPfpRjCPndpae6V05OxD_8f5sVfbgM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvd6eZq47PJ_Fm2HbbOBBEg0miH0_rxzzOraB_Yxa46kQ&oe=699D8E1E"}, {"file_name": "screenshot_202510051049292487.png", "id": "1465194561445259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618432_1465194564778592_8873187676482011420_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7Ybq3lWSYgQ7kNvwHVYLOX&_nc_oc=AdkWYztrBMYsEXvCKCYpvIkZMLNay98coA7OFVh5yzR7hHMiep06LfvnGdmyilTvTeY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsY-U0ssk2XGpD1Q7_BEICnNwAMcJA1CBJN32f7V5tpCA&oe=699D958F"}, {"file_name": "Screenshot5.png", "id": "1367334478283376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618937_1367334481616709_4207229411658335627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klFJgfoMwnEQ7kNvwEIWX9e&_nc_oc=AdnZMERNeZm7eMNfwkBRHNfR3KUJMIKx7BE_gl2CUO7lEGedzfHS-ZVKGidz9At39fU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftgJDIQFXjn3u3gOypKkUAnffOS4AZ3Nd9IUZ-AFeqqDQ&oe=699DA921"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_049_0001.png", "id": "1225065479017157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1225065482350490_3811407694473971828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6dm3GsTYKQQ7kNvwHFIXhr&_nc_oc=AdkhceGfVXhBmS7IKXOUENuzY5bJebseXXnIF_V9COuGflnK25zP6wUwzJRBzuzGt_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3IcQjw-SZNjnVlAGAFuS8gTMiqlRtYILLkaUeuOB2_Q&oe=699DA1EE"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. Experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team.\n\n{9566889240078397}\n# CHALLENGING OPPONENTS\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life). We have slow-motion options so heading becomes easy for new players.\n\n# REALISTIC BALL PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n{1054558193429207}\n\n\n# FREE-KICK MODE\n\n{24502713752669059}\n\n# INSTANT-REPLAY\n\n{1441983417130503}\n\n# COMPETE ON THE LEADERBOARD\n\n{1834780490720812}\nScore as many goals as you can and climb the global leaderboard! Let\u2019s become the world\u2019s top scorer!\n\n\n\n", "short_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. With accurate physics, detailed graphics, and challenging opponent AI, you can immersively experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team."}]}, "developer_name": "TDSOFTWAREZ", "developer_privacy_policy_url": "https://goalpoachervr.wordpress.com/privacy-policy/", "developer_terms_of_service_url": "https://goalpoachervr.wordpress.com/terms-and-conditions-for-football-goal-poacher/", "publisher_name": "TDSOFTWAREZ", "support_website_url": null, "website_url": "https://goalpoachervr.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "pt_BR", "ko", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25537174919310191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622285_1259384912704400_872665921247207824_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBfghzMD1r0Q7kNvwHunLbe&_nc_oc=AdkwOE6uFU9PAXzd9aIuBQNqrTd2H_r2xbm2sJYsFkUkndX41ZwzZdkGHU6ePp-lkXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvgugy3Sk1zIN_Mi5AmgLje4255vrrBdFdTDYQwKFXZwQ&oe=699DA912"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Football: Goal Poacher (Soccer)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "conte
0"}, {"file_name": "02_Teammate_BicycleKick.png", "id": "2584598755380470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_2584598762047136_4398802171498932739_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kb2MF5giYqYQ7kNvwFXMAY8&_nc_oc=AdqRRf-wbL5k9KqDA5A6NPSBDjLGYotiT7wddc6pCGwV5bloj2OGmyvWZdypA1dck8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSozOfYX5q5kSmHQDlP6jCK3R8cFixyBtHcQeYZSQKKEQ&oe=6B0C4FDE"}, {"file_name": "04_WorldTour_Celebration.png", "id": "2341028746734751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593919959_2341028753401417_2139769560903931233_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsWJfTfHcbgQ7kNvwFJVOxc&_nc_oc=AdqRkTtyJU4RS6TYTUKL9gLOkIqNZdW1MH-Lp8DrOjnGGowCrXSmQLOo38AWenphoWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzfqgotfkzJSGIGqvl9-3xO7CwsteovjkonWftIembqQ&oe=6B0C6D21"}, {"file_name": "03_FreeKick.png", "id": "1081443281570347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623115_1081443284903680_4522568540326330810_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdXo-pEV268Q7kNvwHl0R8Q&_nc_oc=AdrlOxylefGRcpKElRV27OjR9c2Xqo03osQkcj0jXkK6_EdDIPC-Zz-uiX76vO-rX8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQScLP8mwQ8werkrbhcdzs33yzirSv6Kb0ugkFyKryqoA&oe=6B0C5FEF"}, {"file_name": "05_Trophy.png", "id": "2122734978396023", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_2122734988396022_8109808519542685915_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PHdXDf0NDsQ7kNvwElITuQ&_nc_oc=AdpioTPFeojDmZMjeeqdAj43MX5eOj2RASfWdVq4jPXU8JVPN0r99cvzNVDdmuA_eMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQj94cprrJH4aLPpa8U-uSPEPi7XvWMpXFnB2anWnIkdw&oe=6B0C57A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05_WorldTour_GoalPyro.png", "id": "1505331604761886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620655_1505331608095219_1825224252492541323_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8Jq34QOM2sQ7kNvwEkrC8o&_nc_oc=AdoBrjlWyzTWqr-ApyUuDKRTlr58LuJqYkKD8Ye04Cd8_CJVnC6-YjwDbD_1__toGFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXKrSfkDUwzI0Y91aresyc6-oBrrpRYFDEbydTgW-P8Q&oe=6B0C4C60"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "Read the cross, attack the ball and head the winner past the keeper. Football: Goal Poacher puts you in the striker's boots at the deciding moment of a soccer (football) match, with your own head, in VR.\n\n**\u26bd SCORE IT OR SET IT UP**\n\nHead it in yourself, or nod it down for an AI teammate to finish with a volley, a diving header or a bicycle kick. Keepers dive and defenders close you down, so every cross is a new decision. Earn up to 3 stars per level.\n\n**\ud83c\udfc6 NEW IN 1.0: WORLD TOUR, NOVEMBER 19**\n\n32 teams, a group stage and knockout rounds. Win it all to lift the World Tour Trophy and unlock the Champion Ball and Stadium Level 3 in every mode.\n\n**\ud83c\udfaf MORE WAYS TO PLAY**\n\n- Level Map: 48 header levels across 5 chapters\n- Free Kick mode: 20 levels to beat the wall, plus a Free Kick leaderboard run\n- Arcade Run: 15 lives, combos, multipliers and a global leaderboard\n- Comeback Challenge: start up to 3 goals down and turn it around\n\n**\ud83d\udd25 MATCHDAY ATMOSPHERE**\n\n- 3 stadiums, including a beach, under day and night skies\n- Custom ball physics: spin, drag and precise header contact\n- Goal celebrations, pyro and instant replays \ud83c\udf89", "short_description": "Read the cross, attack the ball and power a header past the keeper. Football: Goal Poacher is the authentic VR header simulator: you are the striker in the deciding moment of a soccer (football) match. Score it yourself or nod it down for an AI teammate's volley or bicycle kick. 48 header levels, Free Kick mode, Arcade Run and, new in 1.0, the 32-team World Tour, where you play through to the final and lift the trophy."}]}, "developer_name": "Tran Duc", "developer_privacy_policy_url": "https://sites.google.com/view/goalpoacher-privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/goal-poacher-terms", "publisher_name": "TDSoftwareZ", "support_website_url": "https://x.com/GoalPoacherGame", "website_url": "https://sites.google.com/view/goal-poacher-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "pt_BR", "ko", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28968647712829544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624069_4230826713716187_4970490321050684571_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cHBI4_Oj6gQ7kNvwGvHPGm&_nc_oc=AdpY1Gz8jrZ421nGZKJ1V3MdL-e4YQgVwqOm5gHIVJ38ZjGeH-zkvGuhM-S6ApGZCvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6SgGingG6oYGmbIqHrQUD0zACtXeMTU1pu0IyroyEuA&oe=6B0C681D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Football: Goal Poacher (Soccer)", "platform": "ANDROID_6DOF", "context_category": {"context_
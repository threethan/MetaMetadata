011420_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vHny_Sod-AQ7kNvwE_spBS&_nc_oc=Adqj9cwiJQDJCKnlpVJqDXXyUI-JRLaItSnx2DdUOZuvSRZdGab-u4zPSyxek54wPP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wWdYDfM6ST1cGekIaPFKt5v4puOJpeX6XhfJqHSijUQ&oe=6A0B020F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_nologo.png", "id": "1481206600319197", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_1481206603652530_4488381304369071550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT9kOL6iwasQ7kNvwEwhygZ&_nc_oc=AdqCo4SsE0AU_eQLqHJ4v5o9W0h2yD9dZ3Mmf1kO28s-gO8ZzOTiSmAXo9nctUrfMz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tct5hnzgHU6wAiXAawacYnDv4xTZ9mKqei5wksib6oA&oe=6A0B148F"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. Experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team.\n\n{9566889240078397}\n# CHALLENGING OPPONENTS\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life). We have slow-motion options so heading becomes easy for new players.\n\n# REALISTIC BALL PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n{1054558193429207}\n\n\n# FREE-KICK MODE\n\n{24502713752669059}\n\n# INSTANT-REPLAY\n\n{1441983417130503}\n\n# COMPETE ON THE LEADERBOARD\n\n{1834780490720812}\nScore as many goals as you can and climb the global leaderboard! Let\u2019s become the world\u2019s top scorer!\n\n\n\n", "short_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. With accurate physics, detailed graphics, and challenging opponent AI, you can immersively experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team."}]}, "developer_name": "TDSOFTWAREZ", "developer_privacy_policy_url": "https://goalpoachervr.wordpress.com/privacy-policy/", "developer_terms_of_service_url": "https://goalpoachervr.wordpress.com/terms-and-conditions-for-football-goal-poacher/", "publisher_name": "TDSOFTWAREZ", "support_website_url": null, "website_url": "https://goalpoachervr.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "pt_BR", "ko", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26033729779654700"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_979451511433691_3923216029085260827_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJPt4fuIs1MQ7kNvwFkesdS&_nc_oc=Adoy9AN6czrxl1LxM9yyqK0-uvzKzytvQbH-nv_BGPnsZ55dabrn7EsFIfe9uS0PhJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D0IcKMRTPZdMTKx2AvYgz-SH4_RhmJ8POIY2yNhb29Q&oe=6A0B06C1"}, "is_concept": fals
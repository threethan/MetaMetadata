02404230033274107.png", "id": "1111784780045415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984440_1111784783378748_6963712676489512728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilBorHHh148Q7kNvwF6joec&_nc_oc=AdpyjDte4UTcYxCW7_N9xbzqWalffVvlX0TAQbiVKZHUaDfRxmEbHsPt0heGopL0wfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJWLE_r_d6ktfGd9ArWrh4_K_o4zlgVgU9ztKwDhaK8g&oe=6AF5EB76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bISzfH1xBmIQ7kNvwFGrUxO&_nc_oc=AdpzMpuMjmOhvPlv9IMwQjpKKVy-WxlIKblSEWKaoeNdx4U7JSk7oI1myr5s14h0EL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyVU_Cd1EquBMs68z08iDD2wXUyFVEy36ObTyIkz0HGw&oe=6AF5E58E"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. "}]}, "developer_name": null, "developer_privacy_policy_url":
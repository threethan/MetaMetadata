M3iMQ7kNvwFFyWp-&_nc_oc=AdmFgwL2wNueB4PF6WPFy24Whm5s0wB4y3RRgMTkfRYY12WLCAe1BbVEem2jbMd5sNU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv45mRoMEXLKWFaGwuh3cIJ2ZTnMGm94kFwPJ0m4IoISQ&oe=69A43336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbsS_NX3aocQ7kNvwG-LDb3&_nc_oc=AdkqrhQNBMjuo1U6T6oJqFZvW_lZx7l48yrZNOUpIb9Dx09KNg3IjS-A3RyFkZkFzSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsY9ANvVHdzloh96QzkSQsenM7-5SwKjutIzcU18v-WFQ&oe=69A42D4E"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blueoc.tech/en/case-study/goal-poacher/policy", "developer_terms_of_service_url": null, "publisher_name": "BlueOC studio", "support_website_url": null, "website_url": "https://blueoc.tech/en/case-study/goal-poacher", "category":
nshot3.png", "id": "837368162020162", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619078_837368165353495_8639116383032235639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awwKPVQ7-vgQ7kNvwFneMaR&_nc_oc=AdprZEazj8yHMjRroCFt8TUu7HDJtIl_CzPMn7HyYKUKWG5EPAz-Eas9vkwHXKcxU8U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQoM_oF03laYCPouczwiceVP6MODXMOkJKTfja5JJqqw&oe=6A8D7F6D"}, {"file_name": "Screenshot4.png", "id": "4151161721789179", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619518_4151161725122512_8294678093138556140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNPdHvYq8LcQ7kNvwF1G43_&_nc_oc=Adq10lzrtyNe_dt18jRWwbHbAlhLXH8gLozPtKQx8-C4EfJilZkA6eUdKvOKl6MRJ8o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBoTUKu_VMGrfxqe4a2UOfNJxK4tGm2BKaDESCQWDuQA&oe=6A8D7F1E"}, {"file_name": "Image Sequence_032_0002 - Copy (2).png", "id": "2179628229469334", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825481_2179628239469333_5606025214715666203_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7vEBF7ARDsQ7kNvwF0FXDI&_nc_oc=Adq0-IV04wwuSbGIDJf5e0qkFZfXTgqL1yse0mevBzn4AkD-2GdSzhl93Zm3wUPU6_0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdUpQ_mkP6trQoIfNMGD4j7KZoXcR2xfRsyQz8ZYEntQ&oe=6A8D8CDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499619187_3699701266836243_6867974658769390219_n (1).png", "id": "2049562329287784", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620504_2049562332621117_7776202569291914953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d61Q3YbIB8QQ7kNvwGWRtq1&_nc_oc=AdoNEkk5qjrUXyVqIWfP-C1c1HqzEnC2St_0t7RCFE8Zxlx8W-pl5ZSGp2GAfUWLeY4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2umvtZcTma-Nx4waTJVNy8B-j1jx08ykdSHiLc4QfKA&oe=6A8D7F1F"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "Become the striker and experience the thrill of scoring spectacular headers and free kicks in front of thousands of cheering fans. Beat challenging defenders, outsmart the goalkeeper, and lead your team to victory.\n\n{1054561100473339}\n\n# CHALLENGING OPPONENTS\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life). We have slow-motion options so heading becomes easy for new players.\n{1056836366779179}\n# REALISTIC BALL PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n{1054558193429207}\n\n\n# FREE-KICK MODE\nChoose the direction and power of your shot, then bend the ball in mid-air by moving your controller. Master curved shots to beat the wall and goalkeeper just like the pros.\n\n\n# INSTANT-REPLAY\nRelive every great goal with instant replay and watch your best finishes from multiple camera angles.\n\n{1741873797002828}\n# COMPETE ON THE LEADERBOARD\n\n{1025405689869770}\nScore as many goals as possible and climb the global leaderboard. See how you rank against players from around the world and become the ultimate Goal Poacher.\n\n", "short_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. With accurate physics, detailed graphics, and challenging opponent AI, you can immersively experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team."}]}, "developer_name": "TDSOFTWAREZ", "developer_privacy_policy_url": "https://sites.google.com/view/goalpoacher-privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/goal-poacher-terms", "publisher_name": "TDSOFTWAREZ", "support
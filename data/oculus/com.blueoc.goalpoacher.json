sics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blueoc.tech/en/case-study/goal-poacher/policy", "developer_terms_of_service_url": null, "publisher_name": "BlueOC studio", "support_website_url": null, "website_url": "https://blueoc.tech/en/case-study/goal-poacher", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7279132668874361"}}]}, "scheduled_offers": {"count": 33, "nodes": [{"status": "PENDING", "id": "1799483261155400"}, {"status": "PUBLISHED", "id": "1696406401820717"}, {"status": "PUBLISHED", "id": "1779936899963747"}, {"status": "PUBLISHED", "id": "1681009813588418"}, {"status": "PUBLISHED", "id": "1543550163914860"}, {"status": "PUBLISHED", "id": "2147595819441470"}, {"status": "PUBLISHED", "id": "1629500584930757"}, {"status": "PUBLISHED", "id": "892799110192167"}, {"status": "PUBLISHED", "id": "1266796688832251"}, {"status": "PUBLISHED", "id": "1215886140747045"}, {"status": "PUBLISHED", "id": "1216521687241287"}, {"status": "PUBLISHED", "id": "2279609602465685"}, {"status": "PUBLISHED", "id": "769290909416289"}
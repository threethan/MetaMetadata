011420_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os8sNI3Vq3EQ7kNvwHDJbgZ&_nc_oc=AdqzimZZ3Lfsrakh3pBS22BkkWq7Mi8eau6X7BVgrl2v5qQScfZkWdZqtL84Rz_oDU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73t2xWUPdJWb710iEnEKJ1YqFtK8S2nttaO1GAFMZTkw&oe=69FC818F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_nologo.png", "id": "1481206600319197", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_1481206603652530_4488381304369071550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sduqgEabqOAQ7kNvwEMx0td&_nc_oc=Adrbmz_yDn5BNKX3gt2bZt0fG7bmQQPoZ8y4U2Fm_pvw-5x40Tnx6oIrVoiRqyr_oLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5szbYAIs5ua2QVkp4UmbIc9Q4V6cHZOSVTRFRZ7SrKRg&oe=69FC940F"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. Experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team.\n\n{9566889240078397}\n# CHALLENGING OPPONENTS\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life). We have slow-motion options so heading becomes easy for new players.\n\n# REALISTIC BALL PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n{1054558193429207}\n\n\n# FREE-KICK MODE\n\n{24502713752669059}\n\n# INSTANT-REPLAY\n\n{1441983417130503}\n\n# COMPETE ON THE LEADERBOARD\n\n{1834780490720812}\nScore as many goals as you can and climb the global leaderboard! Let\u2019s become the world\u2019s top scorer!\n\n\n\n", "short_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. With accurate physics, detailed graphics, and challenging opponent AI, you can immersively experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team."}]}, "developer_name": "TDSOFTWAREZ", "developer_privacy_policy_url": "https://goalpoachervr.wordpress.com/privacy-policy/", "developer_terms_of_service_url": "https://goalpoachervr.wordpress.com/terms-and-conditions-for-football-goal-poacher/", "publisher_name": "TDSOFTWAREZ", "support_website_url": null, "website_url": "https://goalpoachervr.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "pt_BR", "ko", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26033729779654700"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_979451511433691_3923216029085260827_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPYlSgIbGDsQ7kNvwEtYcbQ&_nc_oc=Adoe38Pk1SGXZxwm5N6Gg571rZ4s4d_U2iAxfWZH7TchI1cX4dSiEUisXpkwEkotcTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xGWteyQECMlnPodxruBPFMNTpMSV2MB2k9PNaB0r0yw&oe=69FC8641"}, "is_concept": fals
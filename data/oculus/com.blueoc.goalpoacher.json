M3iMQ7kNvwEpl9Mu&_nc_oc=AdnqJNnvQ67qX25CGEBCgbA3NvFJQGxW5F9voxeU0A27w0cZcRZXnes3oN7-PNiqe7A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvkdjLRF5_Wqge9drMFLrTrj4xh4ZUoRdepGoQUAidN1A&oe=69A584B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbsS_NX3aocQ7kNvwEcLaqF&_nc_oc=AdmSypzBSqYj5XnBjxOBJFdE01utJrYUCEN354Sus07hcwehBzTQ-YTTVj_jj_SFrCI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv4ePcANHFMzWKiAdeK0uycp-tpLSdVAhOtgxBZyrpeYw&oe=69A57ECE"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blueoc.tech/en/case-study/goal-poacher/policy", "developer_terms_of_service_url": null, "publisher_name": "BlueOC studio", "support_website_url": null, "website_url": "https://blueoc.tech/en/case-study/goal-poacher", "category":
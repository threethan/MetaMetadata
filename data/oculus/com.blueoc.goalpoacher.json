.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qzYrKG6HxKsoGeUwE5H05iFJBQncy7V-e1fHKrnqCHg&oe=6A0C759D"}, {"file_name": "screenshot_202404230033274107.png", "id": "1111784780045415", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984440_1111784783378748_6963712676489512728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KklG_B8IEtcQ7kNvwFgEuG-&_nc_oc=AdrzDQ2jxHAdtWSF1O_vEkKMKA6hmb7r-8_TmlnbXTJF5a9GvaQL8KznDqV4i39pO-Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rs4a5fOPZhRPrEFbQhmRJHoYaeklRaOgomBqk8LUpgw&oe=6A0C59B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ_CSBtQ8PYQ7kNvwEFs-Em&_nc_oc=Adr93xxnclFxk46qBQRkmRSCeQ1qRnkTfl56ZEtRqisfk87ImXtddi19DrVwV6kGVeY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qeYvO1xMJgVhC1dGuDhISbL6GWQR4qk_Y1ujStP6FMg&oe=6A0C53CE"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challengi
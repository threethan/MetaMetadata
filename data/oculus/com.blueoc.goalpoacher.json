QERcQ7kNvwFofGvT&_nc_oc=AdkBAHH0tLooaup8Y92cPhAOauMGrkY_3PXCBrLW9Zt4mR-VowEKUVq040pyJSTVlB4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvRZMCcFp0b3GxmkdCkW4IhgHbG9FMPkO6Y_UiM_H53BA&oe=699AF8B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jW9WpvW3w3UQ7kNvwH8P4IA&_nc_oc=AdkUxjuY_Guq9drYcUhogSwU2CixIC-873i6IVK-at48CICWagN7eUHyLPCbzMZ8Q_o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftiJ2kTBaTA0XMpJYC1Ad0eVJ6TTZu-u2CVCwvgmMt78g&oe=699AF2CE"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blueoc.tech/en/case-study/goal-poacher/policy", "developer_terms_of_service_url": null, "publisher_name": "BlueOC studio", "support_website_url": null, "website_url": "https://blueoc.tech/en/case-study/goal-poacher", "category":
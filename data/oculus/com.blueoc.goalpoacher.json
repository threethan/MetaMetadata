nshot3.png", "id": "837368162020162", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619078_837368165353495_8639116383032235639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln6dLkRU32EQ7kNvwFA9QYu&_nc_oc=AdrsEijUBhrz7gmvLSgd9fZpekVFE_hMAWGqbIdCKcnUxKgZAbD2ixBbblfoC_nlx8s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1gDv6_l09nOS95YD16diYyHtUzfMQVq4hNwmtcNfvug&oe=6A8ED0ED"}, {"file_name": "Screenshot4.png", "id": "4151161721789179", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619518_4151161725122512_8294678093138556140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNPdHvYq8LcQ7kNvwECoezR&_nc_oc=AdoBw3yOLZ38e01jUJLp2e0u5KIlBZBTkZZG04AS0AmKTk0lqUw4snsVLGZrD-wziMo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPHSWPv6MmX4zVWOj5EMcg5pR3EfTRg6ODENBXSYWwwg&oe=6A8ED09E"}, {"file_name": "Image Sequence_032_0002 - Copy (2).png", "id": "2179628229469334", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825481_2179628239469333_5606025214715666203_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7vEBF7ARDsQ7kNvwFX5Bxz&_nc_oc=AdqNGLTCxB9mNCAdGNrVWZxhihNwhugqWHE2EPanD_cpTxGjKHzyEo9FYY2iNMU9Vcw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECt5qWPvGhtzA6firEB-rHhfMcz4o1Of2aOXlxfbvJIg&oe=6A8EDE5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499619187_3699701266836243_6867974658769390219_n (1).png", "id": "2049562329287784", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620504_2049562332621117_7776202569291914953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d61Q3YbIB8QQ7kNvwHEUxSm&_nc_oc=AdquobVfMhLPXTX9-hiz0l5cs3rVd9QqOWyP3td4DvLLdZR8ROJrOfDVN81uwtktlBk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBWj_-s-flA-KJK4rQOdrgKeBGDlprBzYrph6c8rxlHA&oe=6A8ED09F"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "Become the striker and experience the thrill of scoring spectacular headers and free kicks in front of thousands of cheering fans. Beat challenging defenders, outsmart the goalkeeper, and lead your team to victory.\n\n{1054561100473339}\n\n# CHALLENGING OPPONENTS\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life). We have slow-motion options so heading becomes easy for new players.\n{1056836366779179}\n# REALISTIC BALL PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n{1054558193429207}\n\n\n# FREE-KICK MODE\nChoose the direction and power of your shot, then bend the ball in mid-air by moving your controller. Master curved shots to beat the wall and goalkeeper just like the pros.\n\n\n# INSTANT-REPLAY\nRelive every great goal with instant replay and watch your best finishes from multiple camera angles.\n\n{1741873797002828}\n# COMPETE ON THE LEADERBOARD\n\n{1025405689869770}\nScore as many goals as possible and climb the global leaderboard. See how you rank against players from around the world and become the ultimate Goal Poacher.\n\n", "short_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. With accurate physics, detailed graphics, and challenging opponent AI, you can immersively experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team."}]}, "developer_name": "TDSOFTWAREZ", "developer_privacy_policy_url": "https://sites.google.com/view/goalpoacher-privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/goal-poacher-terms", "publisher_name": "TDSOFTWAREZ", "support
tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_33318742161058060_460021521451067233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNu0_1HprhUQ7kNvwHd61Fx&_nc_oc=Admn9ZPTN8WDG87dnJ2GsMsW-vyT3aM9UEGlf4LNa_7fDxqMCR4MZ63lsFnsI74FXOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftoDmXWOtJ3gechmpoAjSVsdVzOlorIbW5Vidz3dmLtuA&oe=699ADF74"}, {"file_name": "Screenshot3.png", "id": "837368162020162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_837368165353495_8639116383032235639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNydcRmE1vUQ7kNvwF35oqC&_nc_oc=AdmC39BKTUAk_28wNT7QwQO_7Cw6Asiiu5QWmEJjXGivNnUL_v-Pu__RwB9I4ZZ0WwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsg4xvjRW1YJoYyCGz-K6KR5TgJ9p-rwCdrIc3slj1PPA&oe=699AEB6D"}, {"file_name": "Screenshot4.png", "id": "4151161721789179", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_4151161725122512_8294678093138556140_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhbY08XHIIkQ7kNvwHMloLR&_nc_oc=AdmKmS4Udl6_0RN0DNtZ-oRaQewt6nGSqNDwZFKI73Ve4NgCdoDXU7JAN-LP5wOCBbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft4D6IGLdfcd6U0qSP0uNuvwgMiYl1WN17yt7xUqThtZg&oe=699AEB1E"}, {"file_name": "screenshot_202510051049292487.png", "id": "1465194561445259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618432_1465194564778592_8873187676482011420_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bq4SlK0UYEQ7kNvwHdGSmm&_nc_oc=Adn7W3vslPZf0dxGXY-Sd1bGN7Yc7SyR5RkgKRO2dk3sO3XgATSo-5gHpQdNffMoqCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsDFm-azqCYkL8_DNH6x0JYGC99i9vCkv0pvxxNAvuqnQ&oe=699AF28F"}, {"file_name": "Screenshot5.png", "id": "1367334478283376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618937_1367334481616709_4207229411658335627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMWWP6c2SzEQ7kNvwFSbSHB&_nc_oc=AdlxS5lwP7RyQb2XhZ_HV-uV-4eD9TekK9zU1ZplKyBj6VZ6rCPLuPsY1oaoVxeY4bY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvl_Jl1ygh7XO622lsNHWhWukuD_BauFWsyVNrEtGjY4w&oe=699B0621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_049_0001.png", "id": "1225065479017157", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_1225065482350490_3811407694473971828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6dm3GsTYKQQ7kNvwEF0DA7&_nc_oc=AdnVTXZLhS2xbUK3Lh3FwdKoeWBe08rI8qsjMtfQwALL_F68OJwO32MqgI_isPx3bCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuK0_dIlz8xWdjCZ5AksOarZQJ9jIC8k5e4zg6e43jwmQ&oe=699AFEEE"}, "display_name": "Football: Goal Poacher (Soccer)", "keywords": ["football", "soccer", "header", "goal", "arcade"], "long_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. Experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team.\n\n{9566889240078397}\n# CHALLENGING OPPONENTS\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life). We have slow-motion options so heading becomes easy for new players.\n\n# REALISTIC BALL PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n{1054558193429207}\n\n\n# FREE-KICK MODE\n\n{24502713752669059}\n\n# INSTANT-REPLAY\n\n{1441983417130503}\n\n# COMPETE ON THE LEADERBOARD\n\n{1834780490720812}\nScore as many goals as you can and climb the global leaderboard! Let\u2019s become the world\u2019s top scorer!\n\n\n\n", "short_description": "This is a football header and freekick simulator (soccer).\nBecome a striker who scores headers and freekicks in a realistic football simulator. With accurate physics, detailed graphics, and challenging opponent AI, you can immersively experience the thrill of scoring goals as a pro in a big stadium with thousands of fans screaming and bringing victory to your team."}]}, "developer_name": "TDSOFTWAREZ", "developer_privacy_policy_url": "https://goalpoachervr.wordpress.com/privacy-policy/", "developer_terms_of_service_url": "https://goalpoachervr.wordpress.com/terms-and-conditions-for-football-goal-poacher/", "publisher_name": "TDSOFTWAREZ", "support_website_url": null, "website_url": "https://goalpoachervr.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es", "pt_BR", "ko", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25537174919310191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622285_1259384912704400_872665921247207824_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ePIjazNjY0Q7kNvwGksZfO&_nc_oc=AdkRxf8S_wRvMqsoWIRe0WnYn7oTxF2nBdmnPQTxJxs6eJmqoFFdHkeXI1_N2MOVHIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsi6ksTW99A93fvtOMs8x_7ckb9351SbEKkwSgsoAykIw&oe=699B0612"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Football: Goal Poacher (Soccer)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "conte
K7LEyoJg2OsYqdJxRF7dI-d_fHMVp9ZJimuk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4A2cAuwfi2wepgNkC3HXsqgppC5eSV8IxWV12ziWzCA&oe=69C2A19D"}, {"file_name": "screenshot_202404230033274107.png", "id": "1111784780045415", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984440_1111784783378748_6963712676489512728_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDwnAUfKyAoQ7kNvwHSw2vP&_nc_oc=AdoBwPKUAHjY1Oz8ELbD5meMOUMrfXejRnIxbw3l11Q3o60xBOZoDt5HDCvcQJJFBic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYZxi4Q_0WScY69AF6oeCaZEadtknE4PO3j6FhHImo2A&oe=69C285B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_202404230023340038.png", "id": "401395172659930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974783_401395175993263_3027170000623439756_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1P6rDiEmpoQ7kNvwF1JD82&_nc_oc=Adp-Ql17v4aCgBGu3MYTRKLUN0Ng7ivmiDTTThFxg0WwdJiUE5m6b7PX06dWOMAVxWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlQWfPcfPr-wkemOr_c-vQdok2kCAjwCaNW_yY8RmtIw&oe=69C27FCE"}, "display_name": "Goal Poacher: Soccer Header Simulator", "keywords": [], "long_description": "Become a pro football striker going up against challenging real-life defenders and goalkeepers to score header goals. \n\nCHALLENGING DEFENDERS AI\nThe defenders and goalkeepers in this game will try their best to stop you from scoring. You have to quickly assert their positions and decide where to put the ball to maximize scoring chance (as in real life).\n\nREAL-LIFE GOAL SCORING SCENARIO\nWe put together over 30 levels inspired by real-life goals that will test your header skills. Can you score like your favorite striker?\n\nREAL-LIFE ACCURATE BALL HEADING PHYSICS\nWe developed our projectile physics to correctly simulate the ball projectile with drag, Magnus effect, and collision check with your head to ensure a realistic heading experience.\n\n\n\n ", "short_des
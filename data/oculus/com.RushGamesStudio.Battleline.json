mNHqy2xY6yMEDelPEZd8Sv3R4Om_dgcSSqRh7ZMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxanOXn4VVbhFTJyFUrQN6g3Mu-Z01Ui1GfJMowG9Tu3w&oe=69BBF491"}, {"file_name": "Render 05 - Weapons.png", "id": "8947736978670599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7fj1_qhi30Q7kNvwEh66EA&_nc_oc=AdlhnNMk06rL8fxrmS1K_S-kCTs3dh7V0HZPeX1Gm3RdTLv4j66gAb6bRsPUzgMB-cI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzGweqzaOjNqJe03ksl5Mi0dWXomeFjkMWimY8RgE_K4g&oe=69BBE119"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBelMmrWiR0Q7kNvwHYyGuU&_nc_oc=Adk0aCnPF3ZvPwwXyDKC6VOUIQG20ohJ99_TCEaXka20qr0gsOUVHoOWfO1Agv1_RoQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0RyGMzFbPcAtYtmA7d_W_37tXAJiHAx2T9Ck4282Aww&oe=69BC03B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iy_qjIWKoAQ7kNvwENzisP&_nc_oc=AdllKnyBMJXI4xNwwUzJV8b2SlGRJ53dRXDr9VfTxuZ6TX5p91oq7z5yk486Ddudu8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEFlSoKr9R6S3pZ7ZgQvOCq5ZJQr7eEDzJ_SFUvae0oQ&oe=69BC1047"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9646384508739116"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1325173705332255"}]}, "baseline_offer": {"id": "1325173705332255"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743279300, "status": "PUBLISHED", "id": "1325173705332255"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9853223351388563", "version": "1.0
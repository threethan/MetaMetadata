1-7&_nc_sid=6e7a0a&_nc_ohc=YpNb-5unluYQ7kNvwHkRXtG&_nc_oc=Ado4QL4UBXbFwbKlDZMzafTJO2WSDk2w_MpO7GNZFhdqcGtLYAHqJUPZxYvY4AyM0QE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQl3POY_aHGB6sNYB87skRg0TnZD3H1jj2SgDvHhM8jg&oe=6B0C6A71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRZAZBTXU8gQ7kNvwHy5t_B&_nc_oc=Adqk5UyW0_82tRebIcHRhSq9EDxX96t3K3AXvJe8uva1RAYU7XAWDQfkzD_Xt051Dak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4RoKjEAcWnDEB4SeRJXkYMiGQXXQSVEOB4enL51L_dA&oe=6B0C7707"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "websi
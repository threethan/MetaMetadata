3393328_2043317129485960_5068005555013561570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9KT-ucUQo8Q7kNvwHZDLmq&_nc_oc=AdmoXmRC0u4G9vn_gRaXl7KPqYhtv1CC-2dNH9UdGdcIUw85n39XJKhWlnup0FfMpIc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyw6ox3r0xyhijh4nrJTsarjvcpX9h-gG4aydVH-czBSg&oe=69BD4A0A"}, {"file_name": "Render 04 - Weapons.png", "id": "937029718593198", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392309_937029721926531_5366748798056502982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3Ix9HReLG0Q7kNvwEaSaEm&_nc_oc=AdmCzHh9sHbbBpZfIpR7YKo0n_CuhgIVmRjoAmvSbmoRprWv5ZEiOJG7eX_En1czUBU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzVISBict1zbTEGcKZMNTh-LWj8dvPWUhr2Tah8xTTIw&oe=69BD4611"}, {"file_name": "Render 05 - Weapons.png", "id": "8947736978670599", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcUgXzvUBIkQ7kNvwGKXL1A&_nc_oc=Adk-BaID0TMbLoXxSVFQ2u7VmJ60GxW_gja2mJVTz67n1BCbllaTke91-bz9vRR84Ko&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx36n9lWZV2FE2535_YAXFw8heWM84o4xWOqVl3m-fgDQ&oe=69BD3299"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20uXyFYRRysQ7kNvwFPU9Dj&_nc_oc=AdmrHG86AZEVVCKhUMlzU0jisKLkQ0poHFKh8EhpD0fMaj23WAnm5r0DOfjGWzKdSYU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzqhYYkjhrOQ-ayG9KgvCSszgFhSkQyDjjPr9Sk6qLnQ&oe=69BD5531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUK5bLTEU3EQ7kNvwGiAvpq&_nc_oc=Admaex0CswpPw3ubNCDGaJ6iHnojLXg5IhK3veuKqDvRF8NoNPm9R_9w3oM8m3ybDv0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKlZO-vHaUJt-87KnbspjnQqroGl1EQf02CndD7m3bZA&oe=69BD2987"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "suppor
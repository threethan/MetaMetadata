//scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393328_2043317129485960_5068005555013561570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5XzQfnblpIQ7kNvwFbooqO&_nc_oc=AdrncpZmBOx40lQeJPC6-ga6oWPDhTsmvG6UTGjysvstAnnMMtsL7vOk1B0-WcpWpc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v_vhHC-GG3SjBLr_5Fk-eeuFS1c07EFfLAZzEYgHzSg&oe=6A3E7D0A"}, {"file_name": "Render 04 - Weapons.png", "id": "937029718593198", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_937029721926531_5366748798056502982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dU5ZUqWn8DgQ7kNvwGPQkky&_nc_oc=AdrVg7Yg3YHcw-K5Gr2MzkVJsqgqgfC6jhmwCBafOIpTpdRzFQIdjfEfIgVflVVUSOQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ChO8irsjQ09YMA3LH_MeQwdEHY_px7fi0bsSQjl-Xw&oe=6A3E7911"}, {"file_name": "Render 05 - Weapons.png", "id": "8947736978670599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B4fN1qcbeQQ7kNvwHqmmqI&_nc_oc=Adq51Un1EmMsBLSzOpJvyBrnpZlMeYp0PYtnMv32EsjXxO1aQbo8etpQnmqCgaB8Eoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80PjIyVXe6PFS4BmNkMtKDPzUFTWIn6pO7AYOfzkvTcA&oe=6A3E9DD9"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK4Ju0niUvsQ7kNvwGO6FQL&_nc_oc=AdpPdCRsbGPWbjUi_ujEn1md7PX5ULhBLpY1NSjLWUqTTAlcWmEleM7RHD3kDcprutY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P9xuRiwgN1E4II6iolGdzbGOo-Wt5e3BF3XIzT18Alg&oe=6A3E8831"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ip4q3to_BOoQ7kNvwGhLiQy&_nc_oc=AdpKSFYyHKupLyVp70Y8lq8cp8mHknS_6RtHPc79HM_qiu7uwu-sGQqWLY4oie_Kc5U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AAuAHR5EB59B8C66BBumnEuaa5S_8nrauR0QYCyPw9g&oe=6A3E94C7"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqKwBWYDV28Q7kNvwECJwxS&_nc_oc=AdnHsKVDayjW-6X3w0mb-eRmPs7Wby6ZcmHaQ8WS1lxQZnif67pYeYit3xDRTyTWmMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvHSYNkZAZt9svLaLYh_leH7S1cih99swSHY11qaE51FA&oe=69A42619"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPm0_R3QxfcQ7kNvwEbNxV0&_nc_oc=AdmPTdxOX0L5CC5zz0m6j1MgqzqJ_fdYxWTCMzY8S4hQoWEg_AKEzYC8VanjwzL5rew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuj3KpgxtGdCI3e5AllYTPrI2Km8OBbihDjmAfPbN11vQ&oe=69A448B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsxmJUSJDncQ7kNvwFVPVnt&_nc_oc=AdkZlkPeelLv5gre11UF8BWltIDuGgIB0qxZluTii7vYXDKzDQGm-KflKDMBrLkm7FU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfunFM9wnRjBdLwXPOKcPrO1QVmaHg6xnrmagjzND5JKmw&oe=69A41D07"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "shor
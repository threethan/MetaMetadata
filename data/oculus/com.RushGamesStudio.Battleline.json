5/473393328_2043317129485960_5068005555013561570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_dhl93pIi8Q7kNvwGUL7CT&_nc_oc=AdngUIw_p_TnOKdSYh0C1wSbc2l9c9LMlYyW9scpMQ9fjsMg-v1kSDXuShfIoKfAkSs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaDfM71rRrke2cehmdV5zDGe7d0hSKy84Wy157zM64Bw&oe=69AAD50A"}, {"file_name": "Render 04 - Weapons.png", "id": "937029718593198", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392309_937029721926531_5366748798056502982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJDS4uKazPMQ7kNvwE85X6t&_nc_oc=AdkGD4aTePypOxBSYUFti2t3FCYwAVgAm5oCiS5qLHHbdVHzIlZfGLNgjRT1slC8MJw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfymKCkX0IQwMQR9JY59gzGf34x-LMMXWaqceDQoQr6iSQ&oe=69AAD111"}, {"file_name": "Render 05 - Weapons.png", "id": "8947736978670599", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TnUfrYrpe0Q7kNvwEfa6Yx&_nc_oc=AdlGRa4p66RAVMnczu9YvIYCqksmqpjhHC08Ms9_jv5_z908vESglQjKroJC22ZTdwc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvMtfkdQmhSp3YDSmSlr1ZbHyyqZWnfv1IgXP6AN36dw&oe=69AABD99"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSf-kmBTkhsQ7kNvwGbnAy4&_nc_oc=Adn0VUksFYgK8BQPtLcEGiGkZDEVn6MSr9PK1Lw8yvU1KTMHHXBgUGiKmWwR9R37PjA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBMzBvAvwC4-Cv9A7WNBie_PsX-NaZ7LhF8K6PbOqHsQ&oe=69AAE031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfqV_DBFNR4Q7kNvwH9tqG7&_nc_oc=AdlAv1vTuQeXgoy8V-xTVcsxKz6ThW_A-0DJ5cKmbqV8WCCv8j36AfcM524YdZcAHmk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTast6SmwNafbqTtKgTW62ei4rSgjVqWYk2CQxyXWUug&oe=69AAB487"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"],
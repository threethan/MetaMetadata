3393328_2043317129485960_5068005555013561570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXJtgxEapiQQ7kNvwGiem99&_nc_oc=Adk2ZPH7kMjaN6taskX0m8ukqJvFAROt37eRf_iJKCMraeNHB0De6b5LxPte6xcVI4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-1uJOXTHq8cOdGoQenrCeM0qqgKdIkNTV3xLSlUuobA&oe=69B9558A"}, {"file_name": "Render 04 - Weapons.png", "id": "937029718593198", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_937029721926531_5366748798056502982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exz1vBn-rq8Q7kNvwH_r3kV&_nc_oc=Adkp_6kUbkuX1QWqRsZbnGByZJ3imeEJyXKCRkCUe0OkZhJWSRz2jg6B955wn-Yu2v8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_zxndH3kdsjZ_hzUShaZPpZaTJkLebRbywywVa0G8Zw&oe=69B95191"}, {"file_name": "Render 05 - Weapons.png", "id": "8947736978670599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7fj1_qhi30Q7kNvwH5cuNR&_nc_oc=Adm_b4xXDx6woShxVEZgOycEf-Wl3zrMh1cnPqmzOEHdjOendo6R24zZXmqgJ3-YLk0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJL159EpPZ3woPAZcCyPsc1kt2aMkSBzNqEJqQuHynuw&oe=69B93E19"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBelMmrWiR0Q7kNvwGF1eq0&_nc_oc=Adn1qvrehkYb0UJakFzYjYt6N4uNRE-n1akSE7E2yWtA3XdXLit3LIXvwgN0fMT_Kz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxll45IQ5TJhPtgJhScVHtCQ307T-aTaWiyY0HeKmmcuA&oe=69B960B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iy_qjIWKoAQ7kNvwGo5fUk&_nc_oc=AdlSsFWoVnbtK9b0Cq40NCDQWrR6Fx5o9GEFDMPqfO4t0Zd5NKsF9xmXqZAIH6oP6ms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfymV8k2DhuGIHNOfNWTTsYMKseWaOAj9AlbmqENi0ke1Q&oe=69B93507"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "suppor
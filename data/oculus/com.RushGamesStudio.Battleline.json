3393328_2043317129485960_5068005555013561570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW54leSI0LIQ7kNvwEEsx4g&_nc_oc=AdoiZ1u7FbGi_Cn_MhqFqZYIAeTEt2By1oKpdAL-q4DRGtjuVDT9AIaY9zhbmnhD7bY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkoSFtJ8fdLJh6CL4WtFWX2yfY_mVpauzaArvza4ZT6w&oe=69C13E8A"}, {"file_name": "Render 04 - Weapons.png", "id": "937029718593198", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392309_937029721926531_5366748798056502982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUmUMfs7Z1sQ7kNvwEo4l3X&_nc_oc=Adoys7v99wPbDdIkXkjKu7JNd8xHdZEb_oUTjz6AI4XPEwosT-HyFgDz4UtiCHZoY2g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy59iqBDorCjzSUOvbvNAiH0xvYdJbDTSFGNkt19l12ow&oe=69C13A91"}, {"file_name": "Render 05 - Weapons.png", "id": "8947736978670599", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDvSTAAhWzAQ7kNvwEBiVyZ&_nc_oc=AdpCwX4XhR96h4D-cWAW-n7B3aUBNDPa7kHl91NAaW_MeH2AmR2fDK_bKfOpfwDETE4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrtkG7GtFx-DjtDK3IWPWtbWC0uKkaH9Sw2LMKUN9z3Q&oe=69C12719"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYHBAozG68AQ7kNvwHvfOip&_nc_oc=AdrsHbaGP-8GbhNNT7BTB7taO8fRJV89ut8Zr1Ei8TfLXMFHjQWm4luZ3euqU5rc8e8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxLZohsnrZfhobMXbiCyx81fTtp8UaceKRfjK6OYgK9UA&oe=69C149B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7KtXfY9eIQQ7kNvwE3DvaY&_nc_oc=AdrCKjczRX5QKoqNHSar1VxIvtG2qlxx9VbDhlFZbSgz5jCHYG9oQqjTl5LO2v3tkfs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwd8-2N7Qj1Zf0I7DxBN78vrTmG8fHLJZU06UsQx9opEQ&oe=69C11E07"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "suppor
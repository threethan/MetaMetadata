//scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393328_2043317129485960_5068005555013561570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DKS4-NaamIQ7kNvwFveAIW&_nc_oc=Adrs2vcs80baX96NBAgmy5end7JFp5tfC6Zu-gtz-ocYPLILr8P1tMS5qvFD52FXbR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1356HITcw_nK5MP8y_cir89vDIgIAFJotHusi3X9rL8g&oe=69F89D8A"}, {"file_name": "Render 04 - Weapons.png", "id": "937029718593198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_937029721926531_5366748798056502982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEhzIXAa7c4Q7kNvwEJGw1M&_nc_oc=Adojgyj2nzMF50xsaiW3DPRWxrOYtYWQRpYjuf3p0Q-TgNrJkzOkaki9G4j_IpOuCJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3a15rbd0omyfaaxTr53ttujkJoMFO_0DnJJKAfKSanmA&oe=69F89991"}, {"file_name": "Render 05 - Weapons.png", "id": "8947736978670599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhGQCE243BsQ7kNvwHK7NqW&_nc_oc=AdopBnQrMlZcEaH5IJfw-PevUC1W9ZlDvKbNMJmar2GqVDa8loutGt5SBFCZ57W8Tig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PQ2PJi_DxK5EuZps4u-DwGzrSuekLeJXwqyg3Czagog&oe=69F8BE59"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFUrlOV95RMQ7kNvwHtkcC5&_nc_oc=AdoV4T_cDE6Bb7n8idR2t9WhmFxJSitH9vLys8OGwK15p3WhYqkdboznP0GIP6bkPdY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af311id9oVVpmIDwwO5t0Gs-Pcqdd14GH3rJjoIXd6r99A&oe=69F8A8B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bkIjoAh_M0Q7kNvwH0SLvm&_nc_oc=AdqTnIlnhq31omggUU1b0rEQyLyef9SPkh2jgA0G-dtWrMCwRyaV_8duo8C_8XogVkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VHsDjxyR097br6kVE1m2do6G1HXtSMTD6cjywUMxsyg&oe=69F8B547"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
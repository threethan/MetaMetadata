25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FWTLvTpU4gQ7kNvwHdVA4H&_nc_oc=Adl9aaCsDzoxoQ23tEF7lKpLYpqRRGDoAcmIKxoip_Stw1Fzb3yF5evJItMByydOdaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvrsaFY3s21JxjWizsD7oxLnHSQolP7xAl64zvD5MA-Lg&oe=69A03199"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec-rgzSUV-EQ7kNvwHEjKJ6&_nc_oc=AdmfF5llxmXoKjENMKloDmzxyMAumZhrBtNtHGZO5hVCmR6zXwE2XNt6DUJdpAS_73U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTXadsvtD_ntmbdiba_DiR7XlhnlKR_Yiqz4oJFd5LnQ&oe=69A05431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV8zgTye3W4Q7kNvwGavntI&_nc_oc=Adk_opXkyJA_v_gYNUO6NVHEt43gUDzDzFgKXhtR0gJPXNEYYc1mlm9Nb0OMdexRJBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftz0-qkYWzEKw27wt55HsTqLAqiAjJq8DupQuVUSYumJw&oe=69A02887"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9646384508739116"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1325173705332255"}]}, "baseline_offer": {"id": "1325173705332255"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743279300, "status": "PUBLISHED", "id": "1325173705332255"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9853223351388563", "version": "1.0"}, "id": "2291576014574884", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9478372138873688", "is_concept": false, "latest_released_binary": {"
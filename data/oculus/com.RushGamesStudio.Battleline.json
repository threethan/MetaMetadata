25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qopzrwt7YKgQ7kNvwEUF4bs&_nc_oc=Adkv_oQo1-0OyOxCdgdKN4x0O_UPVCwOQfn01xxz9MhmLCW8pq_vaLfFPSsHRu8G-TU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuwMYE5UyA3q4gNJY_Sv2Abux7Yyb5iodkaUXkyV6LpUQ&oe=699C3D19"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWGbjsU1-SAQ7kNvwEC7iBz&_nc_oc=Adnq3CNxafXviQzYD2Ythow0Nwfw34_vo06cvAbVJwQGuMCaP_MEWLan2UeAQnhBDS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftuabETWevVTXdy6Y3VYy3hFPhyIb934ci53kVk6FLgUQ&oe=699C5FB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lesm9MHBj_IQ7kNvwE7zWps&_nc_oc=AdmdDSOS2oVY0f5SVeLBbZqOY6Rc2D7YJzTqhnrUPZjZksDUKep6vgJJW6TC5nGltFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuAzrAF8uGMKBwtoPw5pF3LFea01HVqGB5J_ZgaIEWd6A&oe=699C3407"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "shor
3393328_2043317129485960_5068005555013561570_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiEhhLV8XdEQ7kNvwE_EZ-7&_nc_oc=AdmUK29B9PVPFg2k5VNjCEtjxUpDzjvtQ9Rr0vmhtYmhW_G2x17O1nMMJVPJTH7Ou20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzLz1tliKWvfPecffJ8QtKXzxip-QYL8xUm3KYtPbv5w&oe=69B6B28A"}, {"file_name": "Render 04 - Weapons.png", "id": "937029718593198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_937029721926531_5366748798056502982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vNn9erD0WUQ7kNvwECYNdM&_nc_oc=Adn_cMw9NOt9Ah3uR9YtQKkFH1-wla5ETxkNDPMlLrlJ6kiQTA1RlFDCNgS5QvwWmKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-RmZAEjg-Wv24UQ85XyyMmdw7tLRv-JCfrru08k_6lQ&oe=69B6AE91"}, {"file_name": "Render 05 - Weapons.png", "id": "8947736978670599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_8947736988670598_6656011523781050026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIT0teb8csUQ7kNvwHpgBRz&_nc_oc=AdnixIyd1nNtZcjVVEHCDcqkOp6qRLCI0QOH5ER7nYj4uQyja_yCh7XDfMjfVTHlOPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHZ9Bt59aA2RAtqq6I3kgwnA-3q1gNwJ3qWugQgGT1Fw&oe=69B69B19"}, {"file_name": "Render 03 - Weapons.png", "id": "654813300223127", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391934_654813303556460_4017295545781279195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54hvEZzFYhYQ7kNvwFs2wVx&_nc_oc=AdnyhhBbmyKJZOTghdi82v3rqa6gkbEc7xjCINff4S6u31iPoFX7a0BHB2B_Im1L5WM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkEcNrKs9gl9OaigeH-2SX4UosbjiO-Pv5eqkeuXBPog&oe=69B6BDB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "2089298554828649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_2089298558161982_4626490975434310229_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVDnlsxwfIAQ7kNvwF9HSxf&_nc_oc=Admx0mFvvbZ_kolFgK_4gBg5gRvCbg-iDOPYNWuQEiltGy7_MCIefXnoxl5gCt06-gc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwsmd-rUgs3OK5S1K5_0SPsWqRYZEuVp1T3U_wbt56-Zw&oe=69B69207"}, "display_name": "Battleline - The Range", "keywords": ["Battleline", "Shooter", "Gun", "Weapon", "Shooting"], "long_description": "Battleline - The Range Demo \n\nThe release of the free demo serves as both a training ground for players and a testing ground for future features, allowing the community to shape the evolution of the game. Explore the interactive training range and dynamic killhouse, where you can master weapons meticulously recreated from iconic eras  and  conflicts.\n\nAs a labor of passion, Battleline strives to push the boundaries of VR realism and storytelling, providing players with a glimpse of the full game\u2019s potential. Your feedback will help refine and expand this ambitious project into a fully-fledged historical VR experience.", "short_description": "Battleline - The Range\nIndie VR shooter created by a solo developer, offering a free and immersive first look at the groundbreaking weapon systems and mechanics at the heart of the Battleline experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rushgamestudio1.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rush Games Studio", "support_website_url": null, "website_url": "https://rushgamestudio1.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "suppor
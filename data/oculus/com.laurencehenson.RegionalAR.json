e_name": "1000002953.png", "id": "1710606677027902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623384_1710606680361235_7653702053326477339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeBOTkwHn0MQ7kNvwEv2Swr&_nc_oc=Adop7Dbct6DBzJE3SZCEpl9HtvkI7fRmgNoagcGnEI986LgRTNN_q7Ke9tIlnyOQmBU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6dqjH5WVKhr-YQDhqJYOJpBNRhscAcKqsccCt93Nsmw&oe=6A7DBF18"}, {"file_name": "1000002955.png", "id": "1497976208526485", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618274_1497976211859818_5705992330605809813_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rksVMJ8HwEQ7kNvwHJW8O_&_nc_oc=Adqx-u-L9KFp-uWKpIF1gyKxMGee_sZ7dSVYMVtW3jk25BCc5tLKYQimD7nT7CYLcU4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm7me1fqyZKOS_6X8PdgoBxqi4l8Z_u4C9Ab3kaxKVgA&oe=6A7DB786"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RegionalAR", "keywords": ["Anesthesia", "Anatomy", "Surgery", "Mapping"], "long_description": "RegionalAR brings medical imaging into augmented reality on Meta Quest 3/3s. Designed for clinicians and educators in Regional Anesthesia, it lets you interact with real DICOM CT and MRI scans as 3D holographic volumes in your physical space.\n\nGrab, rotate, and scale volumes with Quest controllers. Toggle independent tissue layers \u2014 bone, vasculature, nerves, and muscle \u2014 each rendered as a high-quality mesh using AI segmentation. Slice through anatomy with dual adjustable cut planes, fine-tune opacity to reveal deep structures, and place color-coded markers to annotate landmarks or injection sites during teaching.\n\nProcess your own DICOM scans on desktop with the companion RegionalAR Desktop app, then wirelessly transfer them to your Quest over local WiFi. Auto-discovery means no IP entry needed. A Head and Neck CTA sample volume is included so you can start exploring immediately.\n\nRegionalAR is an educational and training tool. It is not intended for clinical diagnosis or patient care.", "short_description": "Explore 3D medical imaging in AR. View CT and MRI scans with interactive tissue layers, cut planes, and anatomical annotations for Regional Anesthesia training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cyrilhenson.github.io/RegionalAR/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Laurence Henson, MD", "support_website_url": null, "website_url": "https://github.com/cyrilhenson/RegionalAR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27000364846319770"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619518_2214927112668628_4953193841667988807_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGl0lZS8TTEQ7kNvwGbOdBb&_nc_oc=AdqGNfUiJRNKToiERAaQpM1bwypjtqI8RHASX-h90gtNvrrj7D3GGeCZcvHEvQRPEUg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvCFek6f_Fu1z9uTTd4uc5vQxis5O_6XJ79Iw63kYo9Q&oe=6A7DBD76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RegionalAR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Train
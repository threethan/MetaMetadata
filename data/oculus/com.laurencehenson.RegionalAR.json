00002955.png", "id": "1272790595042287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1272790601708953_215744871068760604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZlkbZt3E0UQ7kNvwEuhV0a&_nc_oc=AdrN7aqcBXDvPIXnakNjYQThfurqkQLEifQcSXx_ePOz_eKQczuWX78sPWyP9rhV3l4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7epPilZ8_L-PJLKu1S4w1phXCF-uB2eTcDBlIUMxj9_w&oe=6A01F72D"}, {"file_name": "1000002954.png", "id": "976370218189076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626172_976370221522409_2432263065572150350_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqTgQDBGGeoQ7kNvwHf3VKY&_nc_oc=Ado_4s9_OQvLtXyxPZ-CKAQg5oAXWowGJksFLxx5tAV_pt6Xoe6C7vHWvUinFEp-7kY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Yf5u6M5lsI4vqVgtJt83yUlyc9HzBbVnTtkZZ3v0ztw&oe=6A01E753"}, {"file_name": "1000002953.png", "id": "821147294378427", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618288_821147301045093_7884737833752333405_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUOZGL-o2_kQ7kNvwE0KjQG&_nc_oc=AdovkoZ93o2b4jCZokUBzlISgcY2bQcsGk4Earvh_zO1m2QZ6ckGQKezCe2QTz5Lxqg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Eyptm_HKAq_StNc0zA2udDOsr0qFvviMSjRden5osFQ&oe=6A01D0AD"}, {"file_name": "1000002957.png", "id": "1858690644829736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619187_1858690648163069_3895302926030469239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekFQPuG6534Q7kNvwEVzUix&_nc_oc=AdqSe2dUoyRFeG7WM7SpVa__Pq-yfZyDXHF0yxpZTYY_0x4t1xm7LtlI_4WrL0IEiUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4732hR-6BJKU8WK9XsyLRdjucRaNVlagp_KKlbmxYkhA&oe=6A01E1A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RegionalAR", "keywords": ["Anesthesia", "Anatomy", "Surgery", "Mapping"], "long_description": "RegionalAR brings medical imaging into augmented reality on Meta Quest 3/3s. Designed for clinicians and educators in Regional Anesthesia, it lets you interact with real DICOM CT and MRI scans as 3D holographic volumes in your physical space.\n\nGrab, rotate, and scale volumes with Quest controllers. Toggle independent tissue layers \u2014 bone, vasculature, nerves, and muscle \u2014 each rendered as a high-quality mesh using AI segmentation. Slice through anatomy with dual adjustable cut planes, fine-tune opacity to reveal deep structures, and place color-coded markers to annotate landmarks or injection sites during teaching.\n\nProcess your own DICOM scans on desktop with the companion RegionalAR Desktop app, then wirelessly transfer them to your Quest over local WiFi. Auto-discovery means no IP entry needed. A Head and Neck CTA sample volume is included so you can start exploring immediately.\n\nRegionalAR is an educational and training tool. It is not intended for clinical diagnosis or patient care.", "short_description": "Explore 3D medical imaging in AR. View CT and MRI scans with interactive tissue layers, cut planes, and anatomical annotations for Regional Anesthesia training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cyrilhenson.github.io/RegionalAR/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Laurence Henson, MD", "support_website_url": null, "website_url": "https://cyrilhenson.github.io/RegionalAR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ST
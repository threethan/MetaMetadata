qUj9FLPPKIhhX-TsbWkFcTDLvRec6cLrf8I0peg&oe=6B047484"}, {"file_name": "screenshot-5-model-home-counter.png", "id": "1726615512392712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1726615519059378_8067569042221609340_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciYP-RKh_qsQ7kNvwE1VZ9Y&_nc_oc=AdrB05HTH8wJcfnHd4kVnqS69eZeIKiXLv3WPGhM0-HW3gXHS1AnXHLa3aY71HgB4MQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK1mRNOBFooK7mM4_1JSxw264otue4CI0opOT7JFCP4Q&oe=6B04707E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Garden Gnome Package Viewer", "keywords": [], "long_description": "Use the Garden Gnome Package Viewer to view outputs from Pano2VR using the package format (ggpkg files).\n\nThe Package Viewer supports all skin features, including pop-ups, projection changes, and videos. There is no package size limit for GGPKG files.\n\nTo transfer a package from the computer to the device, you can use any cloud drive.\n\nTo add a package using other cloud services, use the \u201cExport\u2026 \u201c or \u201cOpen with...\u201d option.\n\nOnce the package is added, you can edit the package\u2019s name and delete it by tapping on the 3 vertical dots or long pressing on the preview image to open an edit sheet.\n\nTap on the cog icon in the upper right corner to open the app\u2019s settings:\n\n* Change the grid size.\n* Keep the device awake.\n* Choose to ignore the safe area at the top and bottom of the phone so that the image fills the entire screen. Note that any skin elements in these areas may get obscured or not function properly.\n* Hide the close button. The close button will bring you back to the main screen. When it is hidden, you\u2019ll need to use the back button or gesture to return to the main screen.\n\nThe app comes with a few pre-loaded examples. You can remove these as you wish. Also note, that they are simply links to online projects, so they will need internet access to work.\n", "short_description": "View your Pano2VR - WebXR projects offline"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ggnome.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Garden Gnome Software", "support_website_url": null, "website_url": "https://ggnome.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28546812094993913"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1144883607923883_3858038675599458098_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82FO7WJdnqoQ7kNvwErj63A&_nc_oc=AdonoqTFR8iWJXfGHI2v82yV1P85Jbqnt99SvvhpPmJ2NCK8PMV5igHyw9a3yRC8F5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl62Tcw5ymwvVb3DLVcpAQz0OOh2WYCukriaRq4lpwMQ&oe=6B0457D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Garden Gnome Package Viewer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1794818580, "lastRevision": {"nodes": [{"id": "28313840931624365", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_
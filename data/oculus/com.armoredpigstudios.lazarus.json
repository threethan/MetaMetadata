1-7&_nc_sid=6e7a0a&_nc_ohc=Rl-3ZKbHnxkQ7kNvwH8ozNH&_nc_oc=AdkSs_yNa36d2L5vnXzFQs8EZZzIN6KqqVG0o2ujo4_M4y615IyYhF5VMqixSkAJfuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftkMLLtWWa8RPl4Q9rjNVabcd05oRa6eJYlwQkay8WgZA&oe=69A6DF15"}, {"file_name": "Adobe Express - file (3).png", "id": "1130090182465581", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_1130090189132247_7924562674465096681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGzWMDEZThEQ7kNvwGwj25I&_nc_oc=Adlw5dqxzB_uN9dKauaQIpatfxPLBvH_G-5iP2lYTK73WbNdhGi_l0rwamH7X8JPSZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afte0wB3GN0LzqKyb-j7iB5eaRtK9En00h1Ur7pTQi5m0A&oe=69A6D2E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled.png", "id": "1412174686873688", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391960_1412174690207021_4323379733139929590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qAx9UIiN8AQ7kNvwFv8Hsy&_nc_oc=AdnIP20rhG8s5hTHmpXqHoeJIgONxJxkqqzajf9sBlN_-WiIwt7uleVkFHTNeXuHdKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthG_ayQcZ-TFlKh8r9Bp3_aG4Sl2zHG788YmW34hoZHw&oe=69A6E1E8"}, "display_name": "Lazarus", "keywords": ["Shooter", "Action", "Multiplayer", "Fast", "Social"], "long_description": "You have died... and now you're in purgatory with one final shot to live again. You must fight. In Lazarus VR, fight against other players in short, fast-paced deathmatches in order to earn your way back to life. Utilize many different weapons, powers, and skills to murder your opposition.\n\nLazarus is a very fast paced, intense multiplayer deathmatch game. Expect to engage in fast paced combat, utilizing every one of your abilities to destroy your enemies. Find guns scattered throughout the maps, use your powers, and use hand-based locomotion to avoid your enemies. Curse your enemies out using the in-game voice chat.\n\nWith more than 15 weapons and 7 powers, you have the choice to choose how you destroy your enemies. Will you hide in the shadows and strike hard or violently eliminate all competition? The choice is yours.\n\nJoin the discord here: https://discord.gg/zBg4bsqDR5\n\nLazarus VR is currently in Early Access, so stay tuned for future updates. Many more weapons, maps, and powers are planned.", "short_description": "Lazarus VR is a fast-paced, physics-based, movement FPS, where players can choose between many guns and powers in order to kill each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lazarusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/lazarusvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9500599423291982"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1425412468445505"}]}, "baseline_offer": {"id": "1425412468445505"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744140240, "status": "PUBLISHED", "id": "1425412468445505"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23952416201017064", "version": "3.0"}, "id": "516607950719958", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename"
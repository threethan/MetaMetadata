ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTeiIA9_QL2ex77RM1zd1EwYwYYCSZsS2TN43ms97xRw&oe=6A81B4D2"}, {"file_name": "Adobe Express - file (1).png", "id": "9705185862853863", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391952_9705185872853862_9159262509423435849_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvT9ZLtbKPMQ7kNvwGYBUx9&_nc_oc=Adru0T6nCaz2XZhcd_YSstpkvJgnGKCGmh_gItT6qZlA40AC6g4ixBRM7kbnKqa4xoc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfhry2ryl56MbLynEMOt_jI5ZD3TM8xY3CpzgSKKRnQA&oe=6A81C6A9"}, {"file_name": "Adobe Express - file (2).png", "id": "1040000334652481", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394054_1040000337985814_2682161940342363007_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLq4KKFi0vcQ7kNvwGSzCuZ&_nc_oc=AdqiKl_z9py_spjEtghquZ2PcrK3Xu0B7W-CwPk8bKgBKa0QphYFSKpof8JF_WvRen0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu3eiCjEheog8DcBjNmBquKR3WALmDt2KcpherOZDkpA&oe=6A81B815"}, {"file_name": "Adobe Express - file (3).png", "id": "1130090182465581", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392016_1130090189132247_7924562674465096681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOmYpOtMa9AQ7kNvwHVakXf&_nc_oc=AdqS_9zTqOr85BW2zGJAhk58-0K-RyEDnPsRIB3iHiGEZV_5V8elBtb8PdlFDYtk-3Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzi6LEAAEbRDLb51VJQ4kmA0EQeu6rwWtW90Nn6Rze6g&oe=6A81ABE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled.png", "id": "1412174686873688", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391960_1412174690207021_4323379733139929590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrOdr8BM_esQ7kNvwH9OEN1&_nc_oc=AdoG_3NZX9jQB3kF6XEeY3RYh301Bqrzqn4VrarQne_PeMqHe8Zq7PUFoEDwKLv1KXA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtDgtItQnQEuhXm0W7TpBkuNTw-qe29arykgzfdJol9Q&oe=6A81BAE8"}, "display_name": "Lazarus", "keywords": ["Shooter", "Action", "Multiplayer", "Fast", "Social"], "long_description": "You have died... and now you're in purgatory with one final shot to live again. You must fight. In Lazarus VR, fight against other players in short, fast-paced deathmatches in order to earn your way back to life. Utilize many different weapons, powers, and skills to murder your opposition.\n\nLazarus is a very fast paced, intense multiplayer deathmatch game. Expect to engage in fast paced combat, utilizing every one of your abilities to destroy your enemies. Find guns scattered throughout the maps, use your powers, and use hand-based locomotion to avoid your enemies. Curse your enemies out using the in-game voice chat.\n\nWith more than 15 weapons and 7 powers, you have the choice to choose how you destroy your enemies. Will you hide in the shadows and strike hard or violently eliminate all competition? The choice is yours.\n\nJoin the discord here: https://discord.gg/zBg4bsqDR5\n\nLazarus VR is currently in Early Access, so stay tuned for future updates. Many more weapons, maps, and powers are planned.", "short_description": "Lazarus VR is a fast-paced, physics-based, movement FPS, where players can choose between many guns and powers in order to kill each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lazarusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/lazarusvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
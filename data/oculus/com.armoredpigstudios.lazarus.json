7a0a&_nc_ohc=75iItiIk1jEQ7kNvwHG05q0&_nc_oc=Adqv7il4n1IjSW0oAO4QfNHD9jdijjpnk61V6ZccLklVL3MPXhyK3LZmANMdZFR1Cgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOImU6IL_0_xA93cBbJVrcsc9LrL7fbgDEmCBdJXuN5Rw&oe=6AE0A0D2"}, {"file_name": "Adobe Express - file (1).png", "id": "9705185862853863", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391952_9705185872853862_9159262509423435849_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra0k71m26EUQ7kNvwFoJYbQ&_nc_oc=AdqvER3Ky9Z4t-LNW6572_eioGJefYHSx4AGHmC7NFpzjJ_cARtdejpmWBnFgK4DjCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxf9dOp57dZ_yfYJ2FGK-iri3Xacz7zzdZ8GJvmHMswg&oe=6AE0B2A9"}, {"file_name": "Adobe Express - file (2).png", "id": "1040000334652481", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394054_1040000337985814_2682161940342363007_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuCUkx4WNh8Q7kNvwE5bC3m&_nc_oc=AdqleZZJWhrxO_-kTpG1BsvAUYq95vSsKCDHMVQ6k_ehFdgfIYjkLvPMzX5xrsF1MaA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuVVCLbWWC0vfloEI5BaT3CtfMTurprqFN0KBm4Kn77A&oe=6AE0A415"}, {"file_name": "Adobe Express - file (3).png", "id": "1130090182465581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_1130090189132247_7924562674465096681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9etfnGyNMdoQ7kNvwH0k84f&_nc_oc=Adq2VRebCePCECO8UOmtQOxTvndQoX1QxBFBYkoTFumrWC_6pJ_Qtk_nhQx1yaEXhKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT9Kray--ZKKa8fsXZ1qPE3lIlX37IzZQIC07cQsxeFw&oe=6AE097E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled.png", "id": "1412174686873688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391960_1412174690207021_4323379733139929590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2OKrk98LFwQ7kNvwG0SrcH&_nc_oc=AdrnNEuGVQnJwWzjh8xV7S-e8wrif28CyMm3lKdVFDQBFJjs4TYaKM0ppFzD-9zfwqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN79dKXWrGcHpWxbzcAAiV9btDJmij1ww8kp9R0CpzGTA&oe=6AE0A6E8"}, "display_name": "Lazarus", "keywords": ["Shooter", "Action", "Multiplayer", "Fast", "Social"], "long_description": "You have died... and now you're in purgatory with one final shot to live again. You must fight. In Lazarus VR, fight against other players in short, fast-paced deathmatches in order to earn your way back to life. Utilize many different weapons, powers, and skills to murder your opposition.\n\nLazarus is a very fast paced, intense multiplayer deathmatch game. Expect to engage in fast paced combat, utilizing every one of your abilities to destroy your enemies. Find guns scattered throughout the maps, use your powers, and use hand-based locomotion to avoid your enemies. Curse your enemies out using the in-game voice chat.\n\nWith more than 15 weapons and 7 powers, you have the choice to choose how you destroy your enemies. Will you hide in the shadows and strike hard or violently eliminate all competition? The choice is yours.\n\nJoin the discord here: https://discord.gg/zBg4bsqDR5\n\nLazarus VR is currently in Early Access, so stay tuned for future updates. Many more weapons, maps, and powers are planned.", "short_description": "Lazarus VR is a fast-paced, physics-based, movement FPS, where players can choose between many guns and powers in order to kill each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lazarusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/lazarusvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_con
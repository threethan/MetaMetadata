ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvfxPw6c6BFuz84cdCs7oQX6HPBjqLaj-kTAf-lUJA_A&oe=6AD25892"}, {"file_name": "Adobe Express - file (1).png", "id": "9705185862853863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391952_9705185872853862_9159262509423435849_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzZglZ3T5aAQ7kNvwHiBOZ1&_nc_oc=Ado2BMC-wpM_r_n_w6BEckHnuo_B4f75rJtwmmYhG3FPLhppoiNqph2tyGr-9ZYLcts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVLpe-F3TS_fmm2uu_yV0gOPnGcxi3ZcANOls2VgSu3A&oe=6AD23229"}, {"file_name": "Adobe Express - file (2).png", "id": "1040000334652481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394054_1040000337985814_2682161940342363007_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNsQ1BKa0kMQ7kNvwHDD5_A&_nc_oc=AdptI2ht0QUBx4gXSG8UzaIzi0_tOb3HY19oKvvBsiLvTvVXrRlxauaVr1Y8IDFGPhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUuhTpj-Gc8DA0dWKcwcsP4TON3_FU-i1li-du-3WuzQ&oe=6AD25BD5"}, {"file_name": "Adobe Express - file (3).png", "id": "1130090182465581", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_1130090189132247_7924562674465096681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDXMRJ0TS1EQ7kNvwFE8OtM&_nc_oc=AdoEslYscMsGW6msffw5RUay8KT3NGUp0gMRWp_4N53Abbr9cjyo-5THSGr25LB1Z8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnBGLdzaZ5x4bhJl_KfV4lzkw-Bc4QWVaB74eW-p8u9A&oe=6AD24FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled.png", "id": "1412174686873688", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391960_1412174690207021_4323379733139929590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdHRe19nP5kQ7kNvwHbIX8r&_nc_oc=AdrH2CRpiOa2414w3lQci3ND5giXijCq15isvENk4Sw5nsQF0yqr8LkyQAAD1gxsvRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMamR5xUlrMchDBkxpZ8Q0u5wt9IyzD26u_6Yj9ReE3Xg&oe=6AD22668"}, "display_name": "Lazarus", "keywords": ["Shooter", "Action", "Multiplayer", "Fast", "Social"], "long_description": "You have died... and now you're in purgatory with one final shot to live again. You must fight. In Lazarus VR, fight against other players in short, fast-paced deathmatches in order to earn your way back to life. Utilize many different weapons, powers, and skills to murder your opposition.\n\nLazarus is a very fast paced, intense multiplayer deathmatch game. Expect to engage in fast paced combat, utilizing every one of your abilities to destroy your enemies. Find guns scattered throughout the maps, use your powers, and use hand-based locomotion to avoid your enemies. Curse your enemies out using the in-game voice chat.\n\nWith more than 15 weapons and 7 powers, you have the choice to choose how you destroy your enemies. Will you hide in the shadows and strike hard or violently eliminate all competition? The choice is yours.\n\nJoin the discord here: https://discord.gg/zBg4bsqDR5\n\nLazarus VR is currently in Early Access, so stay tuned for future updates. Many more weapons, maps, and powers are planned.", "short_description": "Lazarus VR is a fast-paced, physics-based, movement FPS, where players can choose between many guns and powers in order to kill each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lazarusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/lazarusvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
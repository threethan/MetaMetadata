oh=00_Af6Ui-m2NebiwnuTa6E3cP_Njxy6tcWUBzQPEq-slGmBIg&oe=6A16FD29"}, {"file_name": "Adobe Express - file (2).png", "id": "1040000334652481", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394054_1040000337985814_2682161940342363007_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVhxKIxMod4Q7kNvwFOXOS4&_nc_oc=AdpQZuL5rCOR_RBGp1JLVR2fhwB46XavO0OQNlUX9T021zDG1HNo3jQQKwn8MeNlWO0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v8vMu-k_hmVEHX2Fjto5iCrup6x3I9ZbempLdGDvlfw&oe=6A16EE95"}, {"file_name": "Adobe Express - file (3).png", "id": "1130090182465581", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392016_1130090189132247_7924562674465096681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3OrSh6GBrkQ7kNvwGuSzrW&_nc_oc=Adqm7R3jINnJtLKm3e6p008NFfRoFgNn1e4N35yKzgdAn0UUw3jCGo8rzg-DpibMt6A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xoVKU6j9_m3wYJ8Osh7uUrzPSv1EF1NdkNsnYd5RqUg&oe=6A16E268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled.png", "id": "1412174686873688", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391960_1412174690207021_4323379733139929590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a__qokA6phQQ7kNvwEg8GU_&_nc_oc=AdogBdn-7whOfJBUCebDqFSIfvSsxf9bqj8GrgPtWkhjhlwplNMPEwjNW5pAV9iCVIo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fdot2hAQNsIX_eSQGAoT2oTuz02Ms2JxZpH6O7vDUyQ&oe=6A16F168"}, "display_name": "Lazarus", "keywords": ["Shooter", "Action", "Multiplayer", "Fast", "Social"], "long_description": "You have died... and now you're in purgatory with one final shot to live again. You must fight. In Lazarus VR, fight against other players in short, fast-paced deathmatches in order to earn your way back to life. Utilize many different weapons, powers, and skills to murder your opposition.\n\nLazarus is a very fast paced, intense multiplayer deathmatch game. Expect to engage in fast paced combat, utilizing every one of your abilities to destroy your enemies. Find guns scattered throughout the maps, use your powers, and use hand-based locomotion to avoid your enemies. Curse your enemies out using the in-game voice chat.\n\nWith more than 15 weapons and 7 powers, you have the choice to choose how you destroy your enemies. Will you hide in the shadows and strike hard or violently eliminate all competition? The choice is yours.\n\nJoin the discord here: https://discord.gg/zBg4bsqDR5\n\nLazarus VR is currently in Early Access, so stay tuned for future updates. Many more weapons, maps, and powers are planned.", "short_description": "Lazarus VR is a fast-paced, physics-based, movement FPS, where players can choose between many guns and powers in order to kill each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lazarusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/lazarusvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9500599423291982"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1425412468445505"}]}, "baseline_offer": {"id": "1425412468445505"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744140240, "status": "PUBLISHED", "id": "14254124684455
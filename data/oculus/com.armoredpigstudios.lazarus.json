dpJHZkOMMXZpa3Jnpym3XJoCfTOmLg92arSATR795Nmf4vHECC4d5KP_RnIBIkifLQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90AVdHKQK4uZdsyk8n11ZncaIgAk40GifjPtycrjRNZw&oe=6A26CF29"}, {"file_name": "Adobe Express - file (2).png", "id": "1040000334652481", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394054_1040000337985814_2682161940342363007_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nr6W_jIUknsQ7kNvwFGCbDZ&_nc_oc=AdoK5RKMiqRhVVnZxf9TUhO3NnBtyxU753F-daEH7fEBOhYBGenstyeVtnfnPseAVv8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PRDN_kNU7vgKBg11EQ2Aoln3STqlBDY1mtlofjImOWA&oe=6A26C095"}, {"file_name": "Adobe Express - file (3).png", "id": "1130090182465581", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392016_1130090189132247_7924562674465096681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbgHXBwzwa4Q7kNvwERMvQ0&_nc_oc=AdrYHDbqoxB56NpbZARvwtbP9BgFsarFa_J_58W8uop0K0KuYfY40PmUM4PHsPP9psA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SInNb4iycu5suPDCVr5uc2spvJtpBYzf2dWFl5UqBAA&oe=6A26ECA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled.png", "id": "1412174686873688", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391960_1412174690207021_4323379733139929590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNPu5rqJCRQQ7kNvwHO5JMN&_nc_oc=AdqDvFmT8zeCuMJ6wZMKqZb_Irju8oi4VuwdmfQNvvXy1A9Xqiy4e_JBh6MEaIU6bYw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EF2Feg7-xzJSbP56mw8ehXA2ZITwm9v_bQG_h6zIMPQ&oe=6A26C368"}, "display_name": "Lazarus", "keywords": ["Shooter", "Action", "Multiplayer", "Fast", "Social"], "long_description": "You have died... and now you're in purgatory with one final shot to live again. You must fight. In Lazarus VR, fight against other players in short, fast-paced deathmatches in order to earn your way back to life. Utilize many different weapons, powers, and skills to murder your opposition.\n\nLazarus is a very fast paced, intense multiplayer deathmatch game. Expect to engage in fast paced combat, utilizing every one of your abilities to destroy your enemies. Find guns scattered throughout the maps, use your powers, and use hand-based locomotion to avoid your enemies. Curse your enemies out using the in-game voice chat.\n\nWith more than 15 weapons and 7 powers, you have the choice to choose how you destroy your enemies. Will you hide in the shadows and strike hard or violently eliminate all competition? The choice is yours.\n\nJoin the discord here: https://discord.gg/zBg4bsqDR5\n\nLazarus VR is currently in Early Access, so stay tuned for future updates. Many more weapons, maps, and powers are planned.", "short_description": "Lazarus VR is a fast-paced, physics-based, movement FPS, where players can choose between many guns and powers in order to kill each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lazarusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/lazarusvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9500599423291982"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1425412468445505"}]}, "baseline_offer": {"id": "14254124684
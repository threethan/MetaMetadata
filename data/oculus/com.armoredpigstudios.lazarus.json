ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJu8vzPLkTlR74nqqD054BVN7W8VcDUULsxuOiEJvJiw&oe=6A71E2D2"}, {"file_name": "Adobe Express - file (1).png", "id": "9705185862853863", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391952_9705185872853862_9159262509423435849_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywmzXJsqNjQQ7kNvwEKwlvt&_nc_oc=AdqM-2oT19_3iVJeHmBaAMZTaN2pIx4mutgPonCKPT7YVBrCk5-hFehMkmjFstq5CR4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENJO-yNQxSlhSV5tE703A7XKkkL8F4MFgDcY-zOQHV0g&oe=6A71F4A9"}, {"file_name": "Adobe Express - file (2).png", "id": "1040000334652481", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394054_1040000337985814_2682161940342363007_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNwnbIhOitQQ7kNvwEOqUkl&_nc_oc=Adq53MCxSKsdXyF1XaJUbMsqvDgIfXC5FeeGF2-3f9bspgn3NV4hSSZ21K7ZMDH1PRI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0oYJCFRi0vrn-GRiidE-94ojWKrH7_ChnV5vkbKGLgA&oe=6A71E615"}, {"file_name": "Adobe Express - file (3).png", "id": "1130090182465581", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392016_1130090189132247_7924562674465096681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2ssHcq4IGYQ7kNvwFRfEdN&_nc_oc=Adp_9lFhNp7FdbcoOuhbWLU7Gjv-9WV69NUBqNHs2wb1LftktoQUseGPXdE94TYDz1A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-QZ6vObo6G3RWs-pgh8756dI93J60dYUx6P4jCOA_3w&oe=6A71D9E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled.png", "id": "1412174686873688", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391960_1412174690207021_4323379733139929590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x-U08BUQ4EQ7kNvwFqXs-G&_nc_oc=AdohF3LqAWlBN7_OXfPbTLmigGrHp-RpkkorGfAHQWSZ25Be33UjQioG6-hocTBiS1E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3tH0d_8_O5ANHOqtsSbz1l_6MvGJpHOnkfBhlGPVC1w&oe=6A71E8E8"}, "display_name": "Lazarus", "keywords": ["Shooter", "Action", "Multiplayer", "Fast", "Social"], "long_description": "You have died... and now you're in purgatory with one final shot to live again. You must fight. In Lazarus VR, fight against other players in short, fast-paced deathmatches in order to earn your way back to life. Utilize many different weapons, powers, and skills to murder your opposition.\n\nLazarus is a very fast paced, intense multiplayer deathmatch game. Expect to engage in fast paced combat, utilizing every one of your abilities to destroy your enemies. Find guns scattered throughout the maps, use your powers, and use hand-based locomotion to avoid your enemies. Curse your enemies out using the in-game voice chat.\n\nWith more than 15 weapons and 7 powers, you have the choice to choose how you destroy your enemies. Will you hide in the shadows and strike hard or violently eliminate all competition? The choice is yours.\n\nJoin the discord here: https://discord.gg/zBg4bsqDR5\n\nLazarus VR is currently in Early Access, so stay tuned for future updates. Many more weapons, maps, and powers are planned.", "short_description": "Lazarus VR is a fast-paced, physics-based, movement FPS, where players can choose between many guns and powers in order to kill each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lazarusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/lazarusvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
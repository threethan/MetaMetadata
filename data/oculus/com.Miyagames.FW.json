rGE4jMaz4bQI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71PEO1WxMAgCL7DQwugDARxW75tQPpN35HFz5LuOO5fQ&oe=6A119C93"}, {"file_name": "A010.png", "id": "827378479253446", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031642_827378482586779_7895670322915773702_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c4HLWMnJlkQ7kNvwHKBvlT&_nc_oc=AdoMWcQUJy6-7zjgIxEb1v9C2Wbh5P4knelMrrrcnRolcneoUyc9NFFxlIgqM43_Lck&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VabwtGLm7oE-CaHFzbN1rrSu8uvcvwC65pnQLzU0uuw&oe=6A11AE57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "418487571043078", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982705_418487574376411_1497134519680794501_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hty63DsVkBsQ7kNvwFn0QlI&_nc_oc=AdrZy4WG6Wzjwuh098oAxudBSQoqdnwgP0zWA_D3uqL9oqFIZFFwklzDSwqrvC2fbfo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uQP7HKv12ROxVke96H-aIkaWFgovAjQ9kBhCuDBR9Gw&oe=6A119ABB"}, "display_name": "FloatingWorld", "keywords": ["FloatingWorld", "Raft", "Sandbox", "Survival", "Building"], "long_description": "\"Floating World\" is an ocean-themed survival building game where you must find food and resources to build a shelter and survive each day. your creativity and effort will guide you through this ocean world.\n\nThe game features numerous islands, a storyline, and puzzle elements, along with a wealth of building materials and tools. You can experiment with different architectural styles and use various tools to uncover the story of this floating world. \ud83c\udfdd\ufe0f\ud83d\udd0d\ud83d\udca1\n\nGameplay Description:\n\ud83c\udfe0\ud83e\ude91 Building System: Expand your activity area on the sea with a building gun. Construct houses, roofs, and eaves to create a comfortable home. \n\n\ud83d\udee5\ufe0f\u2699\ufe0f Navigation System: Build sails for your raft. For faster travel, construct engines and rudders to better control your journey.\n\n\ud83d\udd27\ud83d\udd29 Synthesizer: Almost everything in the floating world can be crafted with this machine. Resources can also be recycled using it.\n\n\ud83c\udf92\ud83c\udfae Backpack System: Designed for VR, the backpack system allows you to store items just like in real life. \n\n\ud83c\udf31\ud83d\udc16 Survival Farming System: Besides basic ocean activities like fishing and grilling fish, you can also build planting pots to grow your own plants and even raise pigs on your raft.\n\n\ud83d\udd28\ud83d\udd2e Item Upgrade System: In the later stages, build an upgrader, mining machine, and teleporter to enhance your ship and make exploring the world easier.\n\n\ud83c\udfae\ud83c\udfa8 Different Game Modes: The game offers Easy, Normal, Hard, Peaceful, and Creative modes. \n\ndiscord:\nhttps://discord.com/invite/KTjpGAFuGE", "short_description": "VR raft survival and building on the open sea. Gather food and materials, craft gear, and build bigger\u2014from a tiny raft to a full floating base\u2014then sail out to explore.\ud83c\udf0a\ud83d\udc1f\ud83c\udf34"}]}, "developer_name": null, "developer_privacy_policy_url": "https://miyagamesvr.mystrikingly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MiYa Games", "support_website_url": null, "website_url": "https://miyagamesvr.mystrikingly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "
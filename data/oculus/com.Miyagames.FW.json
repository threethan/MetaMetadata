7971", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035357_741721573901304_4839548019498585933_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apjxiarCOroQ7kNvwG-hxeq&_nc_oc=AdqivHxHKXTVhPTBzVJhr0-NR2RvZn4HzWbkqagnS1OWCNKjXHl_lA877Kc7_uHZszk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPuZkjereR9xRGIRjZ4Rd_fm6oF-zVryYYfou0UQp3mg&oe=6A8ED2F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "1432126240629249", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974629_1432126243962582_5352689955482993965_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQasL_Bw3VUQ7kNvwHiEtR7&_nc_oc=Adp7nSzgytQDWPWHpMdQHYtCqddyIGzvxNzMMG79VMMIrl846iG2R-umidq6GpSA4X0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrw4BwvSqXOLMOa7wWuI67Pc4E1-bicyHKqS7cvbw1Hw&oe=6A8EE364"}, "display_name": "Floating world  - Alpha", "keywords": [], "long_description": "Floating World is a marine survival, construction game.\nIn addition to perfect systems of survival, food, and planting, a DIY system has been introduced. If you like, you can even create your own Titanic.\n30 years ago a big flood destroyed here. You wake up and only find a raft and a shark around you. Your mission is Evacuation, but before that, you need to stay alive. Are you ready for your adventure?", "short_description": "A big flood hit here. Now your mission is to leave this floating world. But before that, stay alive! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://miyagames.mystrikingly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MiYa Games", "support_website_url": null, "website_url": "https://miyagames.mystrikingly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1990104
-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQv_TrOTAEL2YFujb9VZAqZWz8vWvVxI54oaNerp7zRCg&oe=6B0DA19F"}, {"file_name": "Landscape.png", "id": "317169621413380", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001704_317169624746713_1733147211846073133_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIvyDRB4Zx8Q7kNvwELGFmA&_nc_oc=AdquVOucTYrjyxD-wmPe3MisHeGsfMl_gfafShf81A2dPvmYvjXwAuzrjDqYjD9Ad5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQw_Pzrp5T9Sr4587klsE18LCN5Ior2D3_Go8YH2sNykw&oe=6B0DB282"}]}, "id": "1556988482095543", "locale": "en_US", "screenshots": [{"file_name": "A001.png", "id": "1898491600592320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75520120_1898491603925653_4198773900817121986_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6mwM7pmVPAQ7kNvwFFHdnA&_nc_oc=Adoo_YNqgmBWrLLutLDz4dXS2xf-VJb3A1-rSY13_8wAqh48vKw3TlTzx1EAL0IuG3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6Ha_j0vQnOew5Nx_eq8DJkGHLGe_ZSJsjRJwrVmpILg&oe=6B0DAEDC"}, {"file_name": "A003.png", "id": "8016135531739913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_8016135535073246_1894046956098639528_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_olsN_5Aiy4Q7kNvwEWsYLM&_nc_oc=AdrlrgIe1LA4uNUFvB4dd9-sIZwe3yiB2IRy0OJbAnGvPJPou7jtmcehW3GoA6GLZSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzxXb-M50chtMQ-D-wTRnjMJwdDM-7F-obEhJgWquYUA&oe=6B0DC906"}, {"file_name": "A004-2.png", "id": "7756235784422353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031607_7756235787755686_6186824231735353997_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfp_Hqq8Vi8Q7kNvwFZymgJ&_nc_oc=AdqD-BLhjSMpJ3lKxM3hVrLF1D1nAoHfQzeDHEuWvPZ1pLjIH2l_V94pgpxkNDeRZhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIz5U9AaQiSO1BKRpNP4aRH7k68hzWbW_7_2Ty9GB3xw&oe=6B0DB6E9"}, {"file_name": "A005.png", "id": "819581153033551", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75388619_819581156366884_3303305444869392341_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJAXaK19eOsQ7kNvwFMCo8z&_nc_oc=AdpvFH-KH7gP-5hFWxhaXXZAed0xNaSntTJDL_XUFY1zPEj4YM8W-QlAJNkPjk0BtvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSk-UPnEdPokbC0Pvn8lg_2TDveGmbpNVV60Pw6bDUO3A&oe=6B0DA353"}, {"file_name": "A010.png", "id": "827378479253446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031642_827378482586779_7895670322915773702_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HYgRI7beJ8Q7kNvwEi8Ue5&_nc_oc=AdrD7_ALuuvBFriXzR2wa3VCrfHNSEGY4XQjf_AIjokakkzfmzUOB1B3rroPv4P2ef4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRi8nTyJnMuejJP_Rqhri9NMu6p7W45BB9AOcYGyr6eMQ&oe=6B0DB517"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "418487571043078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982705_418487574376411_1497134519680794501_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6ewtaKRGJsQ7kNvwF96jjM&_nc_oc=Adrn4izp79W1CPeVuyT-iHPGt7KY3qwOrmgfw_j3UV7R6VmNpWEbxQjd7rBYIFReOFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzutLjmgL4-E9yBQ4m6LYNmyw3yYg8AzybhgpkuRvmoA&oe=6B0DA17B"}, "display_name": "FloatingWorld", "keywords": ["FloatingWorld", "Raft", "Sandbox", "Survival", "Building"], "long_description": "\"Floating World\" is an ocean-themed survival building game where you must find food and resources to build a shelter and survive each day. your creativity and effort will guide you through this ocean world.\n\nThe game features numerous islands, a storyline, and puzzle elements, along with a wealth of building materials and tools. You can experiment with different architectural styles and use various tools to uncover the story of this floating world. \ud83c\udfdd\ufe0f\ud83d\udd0d\ud83d\udca1\n\nGameplay Description:\n\ud83c\udfe0\ud83e\ude91 Building System: Expand your activity area on the sea with a building gun. Construct houses, roofs, and eaves to create a comfortable home. \n\n\ud83d\udee5\ufe0f\u2699\ufe0f Navigation System: Build sails for your raft. For faster travel, construct engines and rudders to better control your journey.\n\n\ud83d\udd27\ud83d\udd29 Synthesizer: Almost everything in the floating world can be crafted with this machine. Resources can also be recycled using it.\n\n\ud83c\udf92\ud83c\udfae Backpack System: Designed for VR, the backpack system allows you to store items just like in real life. \n\n\ud83c\udf31\ud83d\udc16 Survival Farming System: Besides basic ocean activities like fishing and grilling fish, you can also build planting pots to grow your own plants and even raise pigs on your raft.\n\n\ud83d\udd28\ud83d\udd2e Item Upgrade System: In the later stages, build an upgrader, mining machine, and teleporter to enhance your ship and make exploring the world easier.\n\n\ud83c\udfae\ud83c\udfa8 Different Game Modes: The game offers Easy, Normal, Hard, Peaceful, and Creative modes. \n\ndiscord:\nhttps://discord.com/invite/KTjpGAFuGE", "short_description": "VR raft survival and building on the open sea. Gather food and materials, craft gear, and build bigger\u2014from a tiny raft to a full floating base\u2014then sail out to explore.\ud83c\udf0a\ud83d\udc1f\ud83c\udf34"}]}, "developer_name": null, "developer_privacy_policy_url": "https://miyagamesvr.mystrikingly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MiYa Games", "support_website_url": null, "website_url": "https://miyagamesvr.mystrikingly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104
6", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_3101908000080929_4486168771632388523_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQ4kcbYK9EEQ7kNvwGRG2Y_&_nc_oc=AdqUggfODPR-Qnum5QRbS-CJKy_MnlUgcECPLacdJ5BUu78AjMEA0mKWQnaEcvABwAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsA6yFTl7kRJ-WJK12MMs3Pjl0TjDybhWrXUNUTTxfZA&oe=6AB7EEA1"}, {"file_name": "Island0_RavenIntro2.png", "id": "899497567374813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_899497570708146_4271962066900266111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVVUIN9c3LUQ7kNvwFjSREp&_nc_oc=AdrlJX4iZStLDUDDCcF9QuVH9cdch3NqUHQDvffyaEAYRrQJtyvH-oQobhvtjTz7d08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHVmEHtsDqK10PJ3naD5i0g7BVe_0iKLD-vtfWUO6itA&oe=6AB7C92F"}, {"file_name": "Island0_Butterfly.png", "id": "4611438835637595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_4611438842304261_7268438751745843296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIVrcZ1PdrEQ7kNvwGiId4H&_nc_oc=AdqY0FUyDlZrdqdOQs2Lq0Ea0NZWhbS5ynk9FxSVz5zVnSfhYAgMS-JVkkpyb8trQa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHIq2rC8_F44rD8DAC7vim6Qe-Cufx-jPkUKTKdzdOAg&oe=6AB7EEAD"}, {"file_name": "Island0_Portal.png", "id": "694955191486084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575366_694955194819417_266495860901407311_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdgBjghXE2sQ7kNvwGmOig4&_nc_oc=Adrf29LHDs0ijeLtNaKkfDPfc-nxXDTltl-jDeJeBZ8JxuXGwid14NoDZvfJ1syhkBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPVGvF97lEwWzGi60exvBc1JcuvA8FPWDkVzhhQxzxzQ&oe=6AB7C822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "281334243955398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569448_281334247288731_176181844175421742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5CgItSFCV8Q7kNvwEFvJqD&_nc_oc=Ado6Vfga8Rrsl04JG9lfCJu5vd4C1i8RavSpbRcei6CxSiVWcSvFj_NcqEOw8rA8Lgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhy8UW4lq9pjRDO5n1g8-M6dQz2KA78ZL45zA6oBECKQ&oe=6AB7EE0B"}, "display_name": "Vault of Stars - Demo", "keywords": [], "long_description": "The living constellations of the Guardians have long served as a shield against the emptiness and entropy of the Void. But the Void\u2019s corruption has seeped into the Vault of Stars, drawn by the evils of humanity, encouraged by the Voidbringer. The stars have fallen to the Island of Souls, shattering the World Tree and plunging the world into darkness. The constellations have risen again as unholy shadows. \n\nNow the Void is ascendant, threatening to doom all of creation - and only you, the Last Star, can choose: Will you bring new life to the World Tree or let its light fade forever?\n\nThe demo includes the full cinematic with movement introduction.", "short_description": "Vault of Stars is an adventure game that explores human nature and the power of choice. You are a spirit of starlight created by the Guardians of the Vault in a final desperate bid to protect reality against the pervasive influence of the Voidbringer. You must navigate the islands of the World Tree to restore the balance, culminating in a struggle for the fate of existence itself."}]}, "developer_name": null, "developer_privacy_policy_url": "http://3lbgames.com/privacy-policy/", "developer_terms_of_service_url": "http://3lbgames.com/terms-of-service/", "publisher_name": "3lbGames Inc.", "support_website_url": "http://3lbgames.com/support/", "website_url": "https://vaultofstars.3lbgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
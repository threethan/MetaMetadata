ontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036641_4611438842304261_7268438751745843296_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ge5-hpbmbEQ7kNvwFhOMek&_nc_oc=AdrnNcN4CAKkjvk8WGCWmavbYbjq7ny2QUrcxsvgX55cxGHgdc1j5-SM2B8l1UoXZeg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3Q5SJXGt4e82RvS9QhWes2Tw0vmSRLKmsXwgRkeFZyg&oe=6B0B356D"}, {"file_name": "Island0_Portal.png", "id": "694955191486084", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57575366_694955194819417_266495860901407311_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6LCYAOno5AQ7kNvwHEJm2I&_nc_oc=Adoi7gYzNQz-Mna2-1Rp5koqpUJOWCD5UF9JLrQzb-B2J8TjFygDvjlNY2YRi3kB268&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRXWkRlJKa8J78bY41U0H0I0VHa_QHcHwFCmNvhGgPAhQ&oe=6B0B0EE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "281334243955398", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569448_281334247288731_176181844175421742_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqeJP4xux4gQ7kNvwEb8jkK&_nc_oc=AdrcyQiLP4MWZ9KJSK_8swyXVj29JUbRkdzD0GLtwhVCvoY3lLHeB0LlpzGE42riGEM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHeK08_mkFtrJ15nY2bY41967NiJeXCJPA7UDL1czYnw&oe=6B0B34CB"}, "display_name": "Vault of Stars - Demo", "keywords": [], "long_description": "The living constellations of the Guardians have long served as a shield against the emptiness and entropy of the Void. But the Void\u2019s corruption has seeped into the Vault of Stars, drawn by the evils of humanity, encouraged by the Voidbringer. The stars have fallen to the Island of Souls, shattering the World Tree and plunging the world into darkness. The constellations have risen again as unholy shadows. \n\nNow the Void is ascendant, threatening to doom all of creation - and only you, the Last Star, can choose: Will you bring new life to the World Tree or let its light fade forever?\n\nThe demo includes the full cinematic with movement introduction.", "short_description": "Vault of Stars is an adventure game that explores human nature and the power of choice. You are a spirit of starlight created by the Guardians of the Vault in a final desperate bid to protect reality against the pervasive influence of the Voidbringer. You must navigate the islands of the World Tree to restore the balance, culminating in a struggle for the fate of existence itself."}]}, "developer_name": null, "developer_privacy_policy_url": "http://3lbgames.com/privacy-policy/", "developer_terms_of_service_url": "http://3lbgames.com/terms-of-service/", "publisher_name": "3lbGames Inc.", "support_website_url": "http://3lbgames.com/support/", "website_url": "https://vaultofstars.3lbgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4826378124119538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_311863830803423_6275912023826413153_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40zucOMCfcYQ7kNvwG3Nq36&_nc_oc=AdorewaGkGvsgF8YCTxpeMZVrN-2CfK4owHoBuT_7fjyLsdw6KaTZg5mASVckXmMP9w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBrgcw-AvlWu54CTPx1q3HzeMnb1koirqNFzGqP9qMKw&oe=6B0B4126"}, "is_concept": false, "is_test": false, "is_trial_of
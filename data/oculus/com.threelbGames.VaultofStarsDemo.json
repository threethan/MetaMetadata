0_Portal.png", "id": "694955191486084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575366_694955194819417_266495860901407311_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBhP522WrKcQ7kNvwHiun3D&_nc_oc=Adr9qJ7_-DInHJPU2cZ8NLzzWZ9IjIL-kP6tULLI5TsPiePXsaniazhUn02pA14wpQM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHoT3ydL7zkac0LI0NrHEMNU02pv44oBkk_NMCeH-lyQ&oe=6A79D1A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "281334243955398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569448_281334247288731_176181844175421742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cc9UVZrWg4Q7kNvwG21D9P&_nc_oc=AdoJ9CQ-jNQO5Gf3g0OKbuVXtiLW-Uhyg6G57Pt-IubQ238Ihm6_jJZeBYa4mDYZV_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHybggtgbR0EQM2R5o4l4gfaNja-CaV1weQoYnCs4INQ&oe=6A79BF4B"}, "display_name": "Vault of Stars - Demo", "keywords": [], "long_description": "The living constellations of the Guardians have long served as a shield against the emptiness and entropy of the Void. But the Void\u2019s corruption has seeped into the Vault of Stars, drawn by the evils of humanity, encouraged by the Voidbringer. The stars have fallen to the Island of Souls, shattering the World Tree and plunging the world into darkness. The constellations have risen again as unholy shadows. \n\nNow the Void is ascendant, threatening to doom all of creation - and only you, the Last Star, can choose: Will you bring new life to the World Tree or let its light fade forever?\n\nThe demo includes the full cinematic with movement introduction.", "short_description": "Vault of Stars is an adventure game that explores human nature and the power of choice. You are a spirit of starlight created by the Guardians of the Vault in a final desperate bid to protect reality against the pervasive influence of the Voidbringer. You must navigate the islands of the World Tree to restore the balance, culminating in a struggle for the fate of existence itself."}]}, "developer_name": null, "developer_privacy_policy_url": "http://3lbgames.com/privacy-policy/", "developer_terms_of_service_url": "http://3lbgames.com/terms-of-service/", "publisher_name": "3lbGames Inc.", "support_website_url": "http://3lbgames.com/support/", "website_url": "https://vaultofstars.3lbgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4826378124119538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_311863830803423_6275912023826413153_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vsMO_fjb6kQ7kNvwFeTCcw&_nc_oc=AdpS1LcDXMCvrBwlbc8SJihAiSlkajy-VzGqmCY4UExJIlJStwSHUYrEyy9aII29EY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwjdNOdsM6wybd4MXUAFkqUfuxqdTSl35-Bmcuf9vpDA&oe=6A79CBA6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vault of Stars - Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1647061200, "lastRevision": {"nodes": [{"id": "3123189211299351", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5397508733613444", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {
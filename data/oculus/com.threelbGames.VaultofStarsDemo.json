1907996747596", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031381_3101908000080929_4486168771632388523_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd8F3ztLUhIQ7kNvwEc7mSy&_nc_oc=AdrIk-hDhgEfIq5EiJzo4VQKn23_TKx_bFgkDaiI2sjx4H1TxlSSLI-QVRxz1Peh8kk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-Vvs_Wo8BUAaFzcCX0yij8DwOCLLQBQ3MXAR4IV8_ig&oe=6A11D1A1"}, {"file_name": "Island0_RavenIntro2.png", "id": "899497567374813", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982595_899497570708146_4271962066900266111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMXt-_J773kQ7kNvwGynDiS&_nc_oc=AdpokugiuBMVasnD_F4jO6xUWVyTKd9-mFU6q6eCHts2Pp5byqvcK-L5Wmposg2PSAM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-F5jiH7yLCovzV198-KUv82F_xVLfZSy5-J-i0atH3w&oe=6A11AC2F"}, {"file_name": "Island0_Butterfly.png", "id": "4611438835637595", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036641_4611438842304261_7268438751745843296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WFq3fWF6qAQ7kNvwGghA1s&_nc_oc=AdoQFkb_sbuHph230smXEh-NA62mcahf9YI5AMAK4LnrOtLmUZv5ZuMcO-bV1jUG9lg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y-9LeH4l7k6cH_yn3gAfVhsneK--Xi_1MRq8ym5DRnw&oe=6A11D1AD"}, {"file_name": "Island0_Portal.png", "id": "694955191486084", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57575366_694955194819417_266495860901407311_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zPJ7F_PdicQ7kNvwFjnKKA&_nc_oc=AdpE7RxbRvSswCyRGzaqTnuuI6gXRsqAAMNbUh-3hrJhjgszdQZCRUBvucCwBgxZVRU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QDvUooZkxOHOC-v-R2pmj9O8H_nUYB69S2umCqp2UYg&oe=6A11AB22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "281334243955398", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569448_281334247288731_176181844175421742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gRN9aFN-j8Q7kNvwFajxjF&_nc_oc=Adp1IJtKMBQKExU0xFdYx-KxUN-ntDxBmjTZ5M-47J7IfWpDda5ctZJF9ynUvrvTNdo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46IWUE2cl3OsIme4mypkUq_Cb321niv1qQKiQ3KQzdsA&oe=6A11D10B"}, "display_name": "Vault of Stars - Demo", "keywords": [], "long_description": "The living constellations of the Guardians have long served as a shield against the emptiness and entropy of the Void. But the Void\u2019s corruption has seeped into the Vault of Stars, drawn by the evils of humanity, encouraged by the Voidbringer. The stars have fallen to the Island of Souls, shattering the World Tree and plunging the world into darkness. The constellations have risen again as unholy shadows. \n\nNow the Void is ascendant, threatening to doom all of creation - and only you, the Last Star, can choose: Will you bring new life to the World Tree or let its light fade forever?\n\nThe demo includes the full cinematic with movement introduction.", "short_description": "Vault of Stars is an adventure game that explores human nature and the power of choice. You are a spirit of starlight created by the Guardians of the Vault in a final desperate bid to protect reality against the pervasive influence of the Voidbringer. You must navigate the islands of the World Tree to restore the balance, culminating in a struggle for the fate of existence itself."}]}, "developer_name": null, "developer_privacy_policy_url": "http://3lbgames.com/privacy-policy/", "developer_terms_of_service_url": "http://3lbgames.com/terms-of-service/", "publisher_name": "3lbGames Inc.", "support_website_url": "http://3lbgames.com/support/", "website_url": "https://vaultofstars.3lbgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
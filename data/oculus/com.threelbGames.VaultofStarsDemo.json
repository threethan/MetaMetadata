6", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_3101908000080929_4486168771632388523_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVq3wrAIfqoQ7kNvwFPaa9y&_nc_oc=Ado7kvqYtnKNI6_HsIJBCH0Oo8Y8f3-PUs99k7ldnV31ZOsZFOVeuLiR_SlAOxFz19E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsAWS9lB3pD62IggIoJgQfWiBS4iplmBpIkNjziuWb_w&oe=6AA7E461"}, {"file_name": "Island0_RavenIntro2.png", "id": "899497567374813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982595_899497570708146_4271962066900266111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EfLjdbKp-MQ7kNvwGNbY4W&_nc_oc=AdqH_FqV2ygKtN5WIhIzZIk4lbOSS17cuXIKJ0EugxeFph28k-Fg5hiwSisnpit1dQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-BSIKg7c8csQgUF0U3BbqqNE9CRgn-e5zW7P1ai68Jg&oe=6AA7F72F"}, {"file_name": "Island0_Butterfly.png", "id": "4611438835637595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_4611438842304261_7268438751745843296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkmvJ7yNyVsQ7kNvwFROavu&_nc_oc=AdrkYz58ibpUGagG_y2j9ytxL56Qb7KiMM5fp0mVAnCC4Q5yLYa1CbnklRmVWsHbn3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzZV2Rg-vB6ZilldXNRrUCHhSJzmIVDETcGXnrMvXfLQ&oe=6AA7E46D"}, {"file_name": "Island0_Portal.png", "id": "694955191486084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575366_694955194819417_266495860901407311_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLte29GK-Y4Q7kNvwGdQf9e&_nc_oc=AdoO8IS2cb2BfD4W3fzdYloMo7K4P50A0HFg8MMevT_i6xHGkPJcMdhvlOehfxps0ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3pEOl_NDxKOTQzDWlRCpdY8MghBaHrrrVBr-U7EWrEw&oe=6AA7F622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "281334243955398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569448_281334247288731_176181844175421742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkulM4VqWtwQ7kNvwHnJTN9&_nc_oc=AdqycmyuKkANL5GmOCY4mc59Nfw1N49Sk3YIpYM7aUGGll0j3fsi_W6D_Mhaf-y6VF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOrb25ufXDOMUZ3vHzFqYyw7DNb_F3JTvYjA1BlIX9DQ&oe=6AA7E3CB"}, "display_name": "Vault of Stars - Demo", "keywords": [], "long_description": "The living constellations of the Guardians have long served as a shield against the emptiness and entropy of the Void. But the Void\u2019s corruption has seeped into the Vault of Stars, drawn by the evils of humanity, encouraged by the Voidbringer. The stars have fallen to the Island of Souls, shattering the World Tree and plunging the world into darkness. The constellations have risen again as unholy shadows. \n\nNow the Void is ascendant, threatening to doom all of creation - and only you, the Last Star, can choose: Will you bring new life to the World Tree or let its light fade forever?\n\nThe demo includes the full cinematic with movement introduction.", "short_description": "Vault of Stars is an adventure game that explores human nature and the power of choice. You are a spirit of starlight created by the Guardians of the Vault in a final desperate bid to protect reality against the pervasive influence of the Voidbringer. You must navigate the islands of the World Tree to restore the balance, culminating in a struggle for the fate of existence itself."}]}, "developer_name": null, "developer_privacy_policy_url": "http://3lbgames.com/privacy-policy/", "developer_terms_of_service_url": "http://3lbgames.com/terms-of-service/", "publisher_name": "3lbGames Inc.", "support_website_url": "http://3lbgames.com/support/", "website_url": "https://vaultofstars.3lbgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
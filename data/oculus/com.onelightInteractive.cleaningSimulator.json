DcSkv9Wqhm1-W9sLDwLqGDrubAV-RjV0XrWw0RiBLTS-A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTHsVwnF_UatODvZUNLUgVmuylrVjiKdEOwPks9DGsQw&oe=6AFB3C8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "wmremove-transformed.png", "id": "1700508307791861", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821782_1700508311125194_508308047262333852_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkDsrqYSmI0Q7kNvwEg7XkY&_nc_oc=AdqJgBg3Z0vLSZitWiBoWvtzSiU22HV8VPC3jhCi1gK-nHMyleog6P6UbU8SXwHaRSo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjdLrP40LEHOXp5lP9bGsxpxgY8r3JdHU1MU3IUXYz-Q&oe=6AFB4947"}, "display_name": "Cleaning Simulator VR", "keywords": ["cleaning", "powerwash", "relaxing", "simulation", "simulator"], "long_description": "\n# \ud83e\uddfd The Ultimate VR Cleaning Experience\n\nStep into a deeply satisfying and immersive VR world where every mess is yours to conquer.\n\n## \ud83e\uddfc Clean Your Way\n\nUse a variety of interactive tools:\n\n* \ud83d\udca6 **Power Wash** \u2013 Blast away dirt with high-pressure precision\n* \ud83e\uddf9 **Broom** \u2013 Sweep dust and debris naturally with realistic motion\n* \ud83e\udee7 **Soap & Scrub** \u2013 Cover surfaces in foam and scrub them spotless\n* \ud83d\uddd1\ufe0f **Garbage Collection** \u2013 Collect trash and clean up the mess\n\nEvery action is designed to feel smooth, responsive, and incredibly satisfying in virtual reality.\n\n## \ud83c\udf0d Interactive Environments\n\nExplore detailed locations filled with dirt, clutter, and hidden messes waiting to be cleaned.\n\n* Fully interactive objects\n* Dynamic dirt systems\n* Progressive cleaning visuals\n* Relaxing and rewarding gameplay loop\n\nWatch environments transform in real time as you work.\n\n## \ud83d\udc65 Living World\n\nInteract with NPCs who react to your progress, give you tasks, and bring life to each location. \n\n## \ud83d\ude80 Constant Updates\n\nWe are committed to growing the game continuously.\n\n**New updates will be released every 2 weeks**, bringing:\n\n* New locations\n* New tools\n* New challenges\n* Performance improvements\n* Gameplay enhancements\n\n---\n\nWhether you want to carefully detail every corner or unleash the full power of your washer, this VR experience delivers pure satisfaction from start to finish.\n", "short_description": "Step into the ultimate cleaning VR experience! Power wash, sweep with a broom, scrub with soap, take out the garbage, and interact with lively NPCs in a fun and deeply satisfying world where every mess is yours to conquer."}]}, "developer_name": "OneLight Interactive", "developer_privacy_policy_url": "https://www.onelightinteractive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "OneLight Interactive", "support_website_url": null, "website_url": "https://www.onelightinteractive.com/cleaning-simulator", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26409028288707447"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1408397538058435"}, {"status": "PUBLISHED", "id": "1563627888456135"}]}, "baseline_offer": {"id": "1563627888456135"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1408397538058435"}]}, "liveChannel": {"nodes": [{
gh dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other."}]}, "developer_name": "Qwizx Studios", "developer_privacy_policy_url": "https://html.cafe/x81014dd8", "developer_terms_of_service_url": null, "publisher_name": "Qwizx Studios", "support_website_url": null, "website_url": "https://html.cafe/x26ddeb58", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24610837128509581"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822557_595727293516581_2759522294174463741_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmgxn3LZ8uIQ7kNvwGUHZae&_nc_oc=Adm7YcTGlkk48Bg7fRzozzNtcfo-Mi7PgPW8xHwMcryNFbial6c7riwR95HboVktkqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZhMzCe857xVr3ppCsKWNmSBis0eqLmoiTcBc1Yh-42A&oe=69B54E0C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "THUNDER TAG", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1729268520, "lastRevision": {"nodes": [{"id": "6873656909320876", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata
eadsets and download our game, we promise not to disappoint!", "short_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other."}]}, "developer_name": "Qwizx Studios", "developer_privacy_policy_url": "https://html.cafe/x81014dd8", "developer_terms_of_service_url": null, "publisher_name": "Qwizx Studios", "support_website_url": null, "website_url": "https://html.cafe/x26ddeb58", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24610837128509581"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822557_595727293516581_2759522294174463741_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icP1t5MRcgEQ7kNvwE7CgH2&_nc_oc=AdrK3Jj8hA4uC0mRdQ-lww5Q1Vhiv-8VSrcIgdGq129QRC4fU857tinKSqOL9bUsN28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuclFS27TdiR2zy0Lq4xXndUo4vYwRWhkhEWpeohk0AQ&oe=6B0311CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display
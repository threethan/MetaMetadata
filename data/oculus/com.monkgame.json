QjQLTngZg9b2craSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TiYr7780yY5dLWwyNioiy2fQaMPKZZRCI66Gl9Legsg&oe=6A0875A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Mancers", "keywords": [], "long_description": "Monkey Mancers is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"Monkey Mancers\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Monkey Mancers is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"Monkey Mancers\" delivers an exhilarating jungle experience like no other."}]}, "developer_name": "Peb Prod", "developer_privacy_policy_url": "https://html.cafe/x63e3bf4c", "developer_terms_of_service_url": null, "publisher_name": "Mancers Analytics LLC", "support_website_url": null, "website_url": "https://html.cafe/xbde8ba0d", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
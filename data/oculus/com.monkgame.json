9S0Q7kNvwFvKfZi&_nc_oc=AdpZk3ZLckscbzZC12pCJN1wxA-66v2ZN-BUMPkFHEwnjZ9uwR2AtgzGs_Rvb0Ww_1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg-kmX3CiSYZX9N9r2yGU7tJPxY8L8JIpH20ZBeJ1vMQ&oe=6A998C16"}, {"file_name": "Untitled.png", "id": "1320765962329527", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820156_1320765965662860_4990122327927230014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x67iDPc705gQ7kNvwFoba3C&_nc_oc=Adq3cv1XhzJfd_b_eyd9G_zT8TPnYte5gy1YkfAW3Ta9Q4JANLy1BIgNmJe6eMc8LHU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-dJ7UfAgEU2HDTM-1gCCQh4_xMYTPzRq4_dDIvnK6NA&oe=6A996C89"}, {"file_name": "Untitled.png", "id": "976843107765297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822583_976843111098630_8316620220230554049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtYKT45mXSIQ7kNvwEVSPYP&_nc_oc=Adprqw4gZms7j-8VBZtiYtZbZiOho_tg1Et0DIB8vTolIhaTSCtxJQwMlQhmKd_OgTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw9TaC7xzhkNp6JcTHxC1XVgthzZDoSAaVrn0_9-IbiQ&oe=6A996B60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THUNDER TAG", "keywords": ["gorilla", "tag", "thundertag", "monkey", "fun"], "long_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR expe
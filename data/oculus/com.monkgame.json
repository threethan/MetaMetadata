d2UQ7kNvwGqvLr-&_nc_oc=AdporqQWNzI7aPuyRQj7jREHJwZqj4VDV7DZKkDk9OFGWH3AaKQX9tGHyohjIOcsQ_U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OZui1CoO5s1A7sJ7XyYMG9Ix8UMvtkAcpNI_Q1G0pyQ&oe=6A26D996"}, {"file_name": "Untitled.png", "id": "1320765962329527", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820156_1320765965662860_4990122327927230014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kMAJsLYTbAQ7kNvwGQ23pY&_nc_oc=Adqr2rQtQ9B6-EMF3rFjlI0Bj-QO4YrLiEGA0v0E58CYgdOa61iRkr049Dw1jLKEj7k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zebRMMfJebjFvsRRKiPEEOlJq4OjhdsqRa7fk8O09fA&oe=6A26BA09"}, {"file_name": "Untitled.png", "id": "976843107765297", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822583_976843111098630_8316620220230554049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcdyF5C6rZEQ7kNvwFS9OyY&_nc_oc=AdpN5lJYF8sRAo4MqlmwqmlzxKji8hIzudzPvPXyOBOHQaI2MjdHF62IwnFOJ9uAQFQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98p1rKp42cNpsb03qowcMlqCk2Ir2c5ua8By47pBKUdg&oe=6A26B8E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THUNDER TAG", "keywords": ["gorilla", "tag", "thundertag", "monkey", "fun"], "long_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR expe
ygcQ7kNvwF3gDKf&_nc_oc=AdqQWBdJ3pj0OBNw-MSd5ESxK1k0_ARfXv2d2UoqYrAKVkPfCSYa5psoEXVDp1RpVeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA3uBShpaQanHwDSC5W7Cp0ZAvtDJzHyPMSixsbSeSBw&oe=6AA6BB16"}, {"file_name": "Untitled.png", "id": "1320765962329527", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820156_1320765965662860_4990122327927230014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xLSn0L_LCAQ7kNvwF-Aajk&_nc_oc=AdqsY_AlJLJcHTsMPYpDqSp93Qd7GsRYdBIKws9nX0YDYL2LqFF7HidXcuE5d-Tl10I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9H2PXtiN03bmWuv-R2_8ktLP_ooHThpRyu25M3eR06w&oe=6AA69B89"}, {"file_name": "Untitled.png", "id": "976843107765297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822583_976843111098630_8316620220230554049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxwkivdWqNcQ7kNvwFOydGZ&_nc_oc=AdrfZl1uGitmTHv5PUWus-2A5GdnKsjERfbvEAkR6tQ3hSI26UBuIN6NoveoUbPCJzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZPsPaiai66R4vg_nqLnFF2xTo07dc0eYOChitz0d3sQ&oe=6AA69A60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THUNDER TAG", "keywords": ["gorilla", "tag", "thundertag", "monkey", "fun"], "long_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR expe
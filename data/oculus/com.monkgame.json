-eoQ7kNvwEjf4Nd&_nc_oc=AdoEDrWFieD9ai4eiC5JuOFXrng-7rCrfHYnW0OZCZRBOIDde5HPH-4E6GNAs3ZnXzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KJ0QZNhr_Xd9hKG5LlfIVramL7QcSzcOIgi1bI0ZP7Q&oe=69FF4C96"}, {"file_name": "Untitled.png", "id": "1320765962329527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820156_1320765965662860_4990122327927230014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mt2fzgXEGcQ7kNvwEMq85j&_nc_oc=Adr-KzjvmqKgNDzKSWayBpg5YAye2P1TNylwXGvLQQFvc4m6hacO1buIxfM9OGBr7mg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vRKQMqNwvnzBUQZJHobHTWSekznIKJpULvDxG1TQZMg&oe=69FF2D09"}, {"file_name": "Untitled.png", "id": "976843107765297", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822583_976843111098630_8316620220230554049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQU6tb205KYQ7kNvwGCpr5_&_nc_oc=Adpzdm3We_iOEZrsJ0MW_9WYy_4hXuf8EQQMfLs1i3LbKgiv62fwLsP6EYYx8u9GDHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lNmCU20fNKC5w1Z46nRKZ0g8j6U38WrQR6ZMV5IPmgA&oe=69FF2BE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THUNDER TAG", "keywords": ["gorilla", "tag", "thundertag", "monkey", "fun"], "long_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR expe
9KUQ7kNvwHgLM_P&_nc_oc=AdrHBwMGq562w9j7zhcR--PLNhzP9QqmeYB6XB97wzXWHgjzq3crR2vkQxzH8hoNdlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVPlJJRh2v3L8eRjZvpKetccoMYa4wFM-6wQl_rQ8pHw&oe=6AC3BC16"}, {"file_name": "Untitled.png", "id": "1320765962329527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820156_1320765965662860_4990122327927230014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEiZRyBjbw0Q7kNvwHlrD96&_nc_oc=AdoacT5GmTt7y787OUWUtbhUFRHRJKhPxwN-oCAIBfPP_IKi5WQ8PmwsWAixwpCg9eE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJI3TImIGCaSVFS6M-bAQzRKEv163Saqs89j3nKqCdJA&oe=6AC3D4C9"}, {"file_name": "Untitled.png", "id": "976843107765297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822583_976843111098630_8316620220230554049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9GoPD_D7JYQ7kNvwGDhHn4&_nc_oc=Adq-AJIWWSA9IzKSRkaLXPi2eTNumclTssUrNBRkjTtcxGrgKtrF4nl_kiKKh2BlFR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmvQvXaQ5NJ_aHKO6vEwkREEb3xDBVy1oScWinZUOYYQ&oe=6AC3D3A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THUNDER TAG", "keywords": ["gorilla", "tag", "thundertag", "monkey", "fun"], "long_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR expe
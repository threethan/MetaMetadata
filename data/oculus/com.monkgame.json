gXsQ7kNvwHSdBfL&_nc_oc=AdpbU9fD6wqy0QstdFjTZfZ3K6EZjDjI0tkkzPiMB_0TAhekHeuM6KNbSbioQlqSG2E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kJnlHpZu8Yk8cnVdYyHkjH3HJidIm3QuVJWPKppELQg&oe=69EF7A96"}, {"file_name": "Untitled.png", "id": "1320765962329527", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820156_1320765965662860_4990122327927230014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lD0Y_5LoYYQ7kNvwE-VoTF&_nc_oc=Adog3XbqLe9pBGuwnEL4dsDgaMIv9w2G4p8cEwaN8lb4cCYevlsAb6hrlP8k8cAHG1A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1umx37Q4zpwdVxK3zJkE4QPgMJ7e9AU1eAmhR7DpRiLg&oe=69EF5B09"}, {"file_name": "Untitled.png", "id": "976843107765297", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822583_976843111098630_8316620220230554049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJeA_1rgL9wQ7kNvwGr36_g&_nc_oc=Adqu9QNEaxVDox9O2jD5vNrOS_O_29OhtH2G2sgoKMySwOxawWVZvqmUWxm-qio511w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TbEkLFricNwqMroUMLiRsLkJPEray-lUffQ4ygBbIzQ&oe=69EF59E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THUNDER TAG", "keywords": ["gorilla", "tag", "thundertag", "monkey", "fun"], "long_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR expe
-kIQ7kNvwHKnrfB&_nc_oc=AdrMfR3tqNA4GGe0_diXjGICBswkJrnfwJB0a_7_o8n7akVVlwkRJaSf9H1DsVqbWf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q7ijY3WgRqk87jhKywx9lVZspHV5NXe9htgA0KrYvAw&oe=6A2EC296"}, {"file_name": "Untitled.png", "id": "1320765962329527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820156_1320765965662860_4990122327927230014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCcIHQ0Fr4oQ7kNvwF_0nx3&_nc_oc=AdpvrJ5YIVpEtuFF_IXCWWP8WyT_1t8JoOtGXIAHuky4ej73Uf29gtu4L7XrGFdNMeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s0cvuASjQtK9RjjmYV8VI9sJ72Idb2-WFw4Xo-Hpd-g&oe=6A2EA309"}, {"file_name": "Untitled.png", "id": "976843107765297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822583_976843111098630_8316620220230554049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjIFv3u9DFwQ7kNvwFXrPi6&_nc_oc=AdoE2Nt0prkFLamPTRd3mNEEKREWEetxS7lpEOqetWCDKvERXZ-zZ1-P3Xb1NRThNQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PKl0Pfb4Y6GZRkG91lX_5-JjMEA7uJhhlRlfWE_uCsA&oe=6A2EA1E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THUNDER TAG", "keywords": ["gorilla", "tag", "thundertag", "monkey", "fun"], "long_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR experience, you'll swing, leap, and sprint through dense foliage as you outmaneuver opponents and race to victory. With intuitive controls and breathtaking graphics, \"THUNDER TAG\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "THUNDER TAG is a high-octane virtual reality adventure that plunges players into the heart of the jungle, where they take on the role of agile primates in an epic game of tag. In this immersive VR expe
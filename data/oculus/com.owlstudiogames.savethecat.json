tent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qc8dlikfSWDl3Malud8z7E0UHK_YlFgkTvzaq0ZUSgg&oe=69FDED1B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuERyzPpWoMQ7kNvwG3DhJV&_nc_oc=Ado4lvIxfp_d6O-d-uNsJkGrB7dSh55hGz_dS68optXTyOYSwC_CUFqc27r1xCJiWuM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78WVYs0hVS6RXOhZwuFpwiLyUxP4U5dQQQF1z-PKPt9g&oe=69FDE476"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aaw0jLrqGC4Q7kNvwERZsKq&_nc_oc=Adol6_rN8f5uWT3KtEaQqu1LGc9wCyhCMotTjLjyCPj5L09gTu26cH3F4IwziUpyfpU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kNoEIDwI08s-fGb_Hf1IXJqjiiGQX2iIv4H0r8XtCgQ&oe=69FDE8BD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM1xBl9CbJEQ7kNvwHA1KZF&_nc_oc=AdqQtwgJkJTwmskYxadzXi0LK2iZrxpMb2jwvHk91ewdz-vVibfM39iWbQnqD36mJIg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BOsbxjMKSQd3qMmI4djf-OJOEf_3tecioyXELSFaAOg&oe=69FDE728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlmERZWIO50Q7kNvwFhvn1j&_nc_oc=AdpMUjz7byNF4We6LT_z0Qg-rfIPd6wDhlBTDQKVU_LY79y0W0wxyDz_b2sqSMbJsYs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q-hHIjfdzeWP-RyaywuUIrSfBe__qcn-VfwAb-QsRZQ&oe=69FDDB0E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
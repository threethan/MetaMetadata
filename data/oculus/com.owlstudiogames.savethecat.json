nc_ohc=Usyyet78AKUQ7kNvwH0E4ch&_nc_oc=Adp_mylZ8jhRglu_5dQ5imDutMkBCBAVZZPY5izQ7qq0mHvV6-OFQhMbfsdBOQyixn0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-grSTuKJUSH1I8H5iiYDqbDTCzvRpoLbtdIBLDZPon8g&oe=6A21859B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmAgKzMDbOEQ7kNvwGq1Xq_&_nc_oc=Adr6N8wo6e4OlWBYjAhqXGfNuWrf6khiMfBpMHoH3hpSCrbgxj_aC8vPlnyDSrgGKnw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lyKdAyB2iDb2MA7rzCi7qkGyLOvMqIz4kXDxpLnHgVw&oe=6A217CF6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-e1Im3wq7AQ7kNvwHXARPH&_nc_oc=AdpDX4csQ1dUE8XhXzyFAo06yMlVU1a2z-QIG5vwHzzZ1_mgJnhcrGFo2hXRjXtqboY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b7OHjD3Nqqao8SS5tBwmq1BNezJw3KiFZ5cpMuwPqHQ&oe=6A21813D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QatejQ8xWuEQ7kNvwEi4iwq&_nc_oc=AdqvPRs1T61phPKB2BHZVfAKfI8lPcuKQYK_ThVodNAi5FfQV2_xWkKjytJTJTq9ycc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CUztfOl-u4-MWdI4vxcXrDAzYnufYj4CGrVFpl32Nuw&oe=6A217FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWrOkFeNp4kQ7kNvwGrpMGa&_nc_oc=Adpa4F21U_hqsI9Hh7fzqoCX-yda5wJEu6ovIGM_lQg8zKrctLljbqt_j8gfPlUIlHk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97CKU85LOKpEn0kstjOxcIfd8SC8P88f4jj0fUPZp7Ag&oe=6A21738E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
tent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nECFET5fZbcNRY5rOuDq-h38HWQ2urPW4Y8p7zFRDlQ&oe=6A10621B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97gcGvhOOWsQ7kNvwEKhJFZ&_nc_oc=Adprf3PjVaytqaTbHdoYQ7oQjAqKa8azkDPklj5_MXqr_X0o-laDpMIiml2u22opAoc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nqTDDvLP0iWaGrWPD8lpkGj7-9CMEqFygNJwZnXZPhg&oe=6A105976"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUKCtGC4SWoQ7kNvwGBmGbG&_nc_oc=AdplN5ziR3ivbAmp7ZWgH0Wl9q41arEewZvd4Iv41FA7RDFTA9r-iR56aGwTM2YNEIk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mHlQmx1obVdLx1SrLBKkR5ImED-2yyquYQCZrTJnpeQ&oe=6A105DBD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3reiyakccsQ7kNvwEk-ESy&_nc_oc=Adq5I_VE28avYhAxVMI2ZHSjWecwf0BuYsrhNfQzQ7Ms5FNmEXLbNk0SMoD-tmjWCsk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NIX2KQlPzEWnq131re2DDR89GHuWVesfM6SqKzoANrQ&oe=6A105C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUe2KQAAek8Q7kNvwEmlCbJ&_nc_oc=AdrIWIXHYP5yWVDQN2rFT2yMfuRXH0TVqXi4DjTMjrzlpPQKFVpc1yCCOUR0fwM9ap0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FX4YiH6XUfpkON9A1szxe4UUGXyVA1Ny2lX2rczix6w&oe=6A10500E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
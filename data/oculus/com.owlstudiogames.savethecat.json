nc_ohc=xn6YMM73bnIQ7kNvwEWVIAa&_nc_oc=AdoCuP3pNe9k78LMLqcmLvEY4SBMa33aq9TZVDatnTVczGXJnL_IunGjLuXR8Ay-1Ew&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmQLb98QHDisb2m-rMAT6NyvGI9Z3tpa4HzZqeyJfRLg&oe=6A81C31B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxJBsx9Fy9IQ7kNvwEE2bRS&_nc_oc=Adp1XkoNgk_2daCvgrTloFl1OYqbS_VzbDRjPBDxngB3hoVj-p5dFfpqGDZtuaimQOc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5QL9TH8MEiM2cig-p9cMJvYbQOLK3kgVZVB7MD0SSCw&oe=6A81BA76"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxQaTvO2IOIQ7kNvwGoVYqz&_nc_oc=AdrHeoWqRC_1TNL8Wn8LkHvBc_nY-iqNrG9xu64PnW5Xls44esDx6lssZd8a9EDUS5M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFb_oXG6FFjOxrmig6-wpLbeUC1F3xhnUS7PMMa-HHhg&oe=6A81BEBD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9MDph-xv5kQ7kNvwFWSTWt&_nc_oc=AdrJkCxqu9mxfQZx67TAQj2O2-futmFG3ELnCUq0ghW-yJGaOBiiXIrX9rOx-denmHg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEezNGpBpoIL3VERw3VObIjAq_sAkAzaaH35vhzybrjjQ&oe=6A81BD28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByxLuCklAfYQ7kNvwFhKctK&_nc_oc=AdoBECDDus5e7QvrWG7hBzMmSX9tZLcvNUaY50WXPDPee_hwydT-qlWJtentoku9bW8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9kRsXaVlQELJEA0qcGSHIiwnrBRaQVd0M5_zQU8CbQg&oe=6A81B10E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
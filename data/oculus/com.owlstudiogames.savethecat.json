tent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gV20AcRe5LBm9a2PHryPq29ZJpKrLYEftlsHW7AlDkw&oe=69F7559B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhu4Lkpr5mwQ7kNvwFwpFVW&_nc_oc=AdrFQ3JPWstoO2LdQrjhjO_uNpqNsePreeaSwKLN2pTyCGZmhVUkeMHDqCTtxYaVViQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1o0PgqqndvbmhuFxGGXhQ9_cQEZ1L_Ph6RxJl1uV8ocQ&oe=69F74CF6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxuO7XZrHowQ7kNvwHCWxrm&_nc_oc=AdrCIbRNej4pLpZF1EKnwHc2k3R53-f0ah6gMWi62Ci_WQXHK8iE-HITgKXALT3ChF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2w13relILqLZ6_loTlV7GN3DD4NQO27OxGN99u9tm3ug&oe=69F7513D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o20kUJLALDkQ7kNvwGAR8iA&_nc_oc=AdqsBPmLWPYIuc2KmSi9JGt9Ssl8LoghNDgUUm43_tNUrUZcO33JqTFcYjbFMHt1HTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Znb7G6n_lOQOlXfQ7GGEGDEe-bAOtKBKx2wXvX-0deA&oe=69F74FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1qii5Iq-PYQ7kNvwGkXs2g&_nc_oc=Ado1LxCP4W3NeBP6f9vy_RqcT6AaEH-_2WeCXogkRTTExx-B1KmStWZ85VVB74mOyBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NoPQCw2E4_ZhlJ3Oh6Th3644YxGPG7THSdCor7SNxqg&oe=69F7438E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
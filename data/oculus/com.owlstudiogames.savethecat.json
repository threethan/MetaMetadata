nc_ohc=ZrLHQYa3ZJIQ7kNvwGAhGvm&_nc_oc=Ado9YJqi-WqLvquuEbCIH6-b0EsjynQAPjDWgZ_tcLk-nqC74X6NLK8RxSYSabeshe0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4TtfeI3cvSl0RDi2o22ZcblwGurIRDUg_EtJ5fN22jg&oe=6A66139B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-47AvO8hksQ7kNvwFHolfw&_nc_oc=Ado3FAARC4dtCbEMQZi8Id8iZuuJcw4RcQ1T4J-ZYh4XTIZIegWo_ifvYNWypf2B7eY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmuI8quJ5v0T4LteiVl083FvSZmrJ0kImShihxaQ0MQg&oe=6A660AF6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUNDrzufIQIQ7kNvwE3OdRh&_nc_oc=Adqb_hh1G51N71ehB-hPSD60KWn_F30JumZhCls-Qs1-FGzZ8vyqZCoW2X5DnBxtVkE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbEOrhXO2vAwcMfDZkMgPQ2tEpTdmkuaaLSVaad-QD6w&oe=6A660F3D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDCmUVmpQboQ7kNvwFGCRWd&_nc_oc=AdqNKUoODv-b9D8pSAOKa_MnizvwM5MRufJ1z2rE8B2MzonzUCsWq39fyLA1nTAsSGE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClDtIkQi_tun79UIZDhxIdelJoH_KJ8l1mgXLwYtmK1w&oe=6A660DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsxdhpeSWuIQ7kNvwH4KJGO&_nc_oc=Ado-Utolc7NCsCCrVI8F9CWfHAO1sspvIJvK9UBVlD3HoBLiTS11k2yRQtnYpJK9qG0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCujK-NL37uA6ASPtYHW4Mj9fX7SMH9mt7ye2B3mt3Prg&oe=6A66018E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
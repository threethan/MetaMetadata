2&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reS7Mb1P5f4Q7kNvwFbwt1w&_nc_oc=AdrJN6o3GhaD0r_amm554BALFKOhWjrC4L0k2SkUo_BfTlh_WdVIbP4hwbYH-stbwhY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpkYyg3UBUuFikXvXmxuwcXuxCRwuyYMZiCUbbNkNSTg&oe=6A8EF21B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8AaXQWDxjoQ7kNvwHdKNjZ&_nc_oc=AdqNe2USlqGB6xswXkRWyR04KujeFI-Hq4DqGGGDdr-vlLv6EVnSxSGDZLSWn8uz0vw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTtqc9IQ6SmM814WLE3-kB4QsWKcs2yodkPJ0NsQjoWg&oe=6A8EE976"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAFQ-iME1bQQ7kNvwEoxSd8&_nc_oc=AdoCCWjI0jZ2pUxo4SwlJVhX4HU6poti3PVP8jM_fJR5dUd1dF3hFVcv4UTQpm_IPNA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUTqT8OU7NhXYZnOP4XqOffrkQSpDeWidGISvhhOu6Ew&oe=6A8EEDBD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vktxOjLmlf4Q7kNvwH6tB0q&_nc_oc=AdpQpNTlse2G0jKAqsKZ_5wODJk-4W61vD_Tsor5iHIQajklXwn21mEJmBOl6hu7tvY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQbC4WGgJ54toKL8uBACVZNqEMnWEbOCSKDQWG0mYosQ&oe=6A8EEC28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqZRZd1rqKsQ7kNvwFymVGS&_nc_oc=AdpsqWHMPb1RqiFKPuTqQPpiZDILNmBKEmCNIqqd4cDSXVg4M_uF1zegwBSOw7H0hpk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrgcBCr4EoKXqn4kndIIs67jPiuwFOSqBz-1SMcXK0zQ&oe=6A8EE00E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
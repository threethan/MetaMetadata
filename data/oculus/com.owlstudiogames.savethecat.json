315771440_7151294874352119258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgnq0s_IjiwQ7kNvwHkT2qx&_nc_oc=AdqqCtOVY4r_O5JjTTJEPKAeuuYUyjugzwZrualzJTv_0dlMzoDsc6ImT2nlX6f0b0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOBYo6sTI1rQuA62qcyqPaPzU0UbntiFRXs2VZZOWXJA&oe=6AF7189B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C2ZBMPKjr8Q7kNvwEDfwoI&_nc_oc=AdowFHS_nV5Gb76RFCAQdBE63936J-oxFyWsjkFsj9ighndMa88g3LhMO1UG6OoPAvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_YQT9hP5GHBuSy_ppl5o_6LNjPhMNDvdeXsM_Wq69bg&oe=6AF74836"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkEpaOM1jg8Q7kNvwGAAJH7&_nc_oc=AdqttRFiy2SZCZnTNWIPcM9EhqntNremzLGPuqnaHFv60IkiZe-qUNDuz1EMKwHP44A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShwKoQATlU6vEb5El53FvD_C7lYi_xdxFzIos_UibSlA&oe=6AF7143D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-hvLQ2Uc-0Q7kNvwEIBO43&_nc_oc=AdrD42_Ssr1IwouZ4AEiw88iEBA7i-lX5v9FiX5Z5p8WjPzGhll1Fp0dPFnJ8q5GaYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWmwTY2pmi_YnOeguqt5K15JyCz6zv2WLYU-wxGqLOhQ&oe=6AF74AE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzt0ASDyCmQQ7kNvwFZpv4G&_nc_oc=AdqLfEdwFwJ3ZuzJsb8-mcw_wGQa5wJ4C4TYURoAOz7hjDqTmTW1DTRPxVjrP8I_Hxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReFZzNSDwDUxjTiMOFL-5PlfgZflLkgvnfh6clOMULyQ&oe=6AF73ECE"}, "display_name": "Walk the Plank & Save the cat", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\n{3238951852955382}\n{799214232945661}\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n{1170703084459122}\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.\n\n{1170194548552560}", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/save-the-cat-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/save-the-cat-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
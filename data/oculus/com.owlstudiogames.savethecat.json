nc_ohc=n0oglZW5Ob8Q7kNvwG-_H9O&_nc_oc=AdqyyttI0385lmDKExBvzSqdHgPyuHKT3Yxp2ww8-YnKZF1kBHM5JDGU_ACsXdktIPM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt6HqSic-TjJVdrMHRJoKMm_3er8wU6O-F1J-0mSo4eg&oe=6A58E49B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FugbqTWnTIQQ7kNvwGj1uSR&_nc_oc=AdqMTExwMPzVgiHpL-TpOlazrx3o36u4gRrdVOUabPF9UQfmChh7YFefR8-k1WjVTk8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcl9jMc2GXbD4OFyngJoiaTtmzbAD-8dAHSafutej6CA&oe=6A58DBF6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLr4J7JcYRcQ7kNvwGKeEi-&_nc_oc=Adp_Sy2btiIKZopspvFPy_36eqadF2KmRxEbQNG0MQbQEncqsRWILsUrSW9zkMg6i_Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHa_f4lXZkgABbKQLZ6GebIM_xWhEexNDbiNjBr5ko5A&oe=6A58E03D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_LbUu7kHUMQ7kNvwH-hGTq&_nc_oc=AdrPfO3W8n7KY-PgRCTCZXZ-2s3dQsfShXqG4pZRdYSO2Y5amchCRQMMOldxg8ZFBsE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1YpbuvyjSTi3JQjN7Jxesr78xoSjMIv_Wzx7NV5naDQ&oe=6A58DEA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEVeuYx9LbwQ7kNvwE9ks9a&_nc_oc=AdoShRhT_4rezLc58hxr0cWVMsRZO-Fzvyq_RMucPT-zgCusOVcpfAE1U1K3pYxMP4k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTei1DchGrfUTHMyGY8zOFSQp5ZV5roighSeAZsh8gJA&oe=6A58D28E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
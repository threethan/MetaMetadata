nc_ohc=n0oglZW5Ob8Q7kNvwG2ffOo&_nc_oc=Adq7tFmJG0eXJj5JM97s-bMkqvnC7hsfESsaj1wbIgfBJmMayNokKbqh9FuueLDjOjw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZbcpt6chkTQo8r_AU8M77XfZ89YjyYDdKOsohat_Msw&oe=6A5A361B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYgV1KENmkwQ7kNvwFabWNA&_nc_oc=AdoxKgZvajAUoBlsUJ37-cgEB8_trTclIN3nGNoXaZB6ewXGvsY0DVmZEm4GMAVxFes&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgbLa5awCsMbFwoIflyVIM4j2zX4RVy7H_nTClfLEcHg&oe=6A5A2D76"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLr4J7JcYRcQ7kNvwEebx5w&_nc_oc=Adqnyeq6puOrJ1siERJB83cjq0nbY9kT-J-h2Uy1ANCW-TWLzesk9QkxfXQ1JenINZI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyQPNjoUaRmuxKcTQ8kdRjSigjtTn3E4tck_rp7ntzUg&oe=6A5A31BD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjgBuwNuobUQ7kNvwES3SFt&_nc_oc=AdrEs41iz5BzlmdJdge7l06wGDt412gytVrtMbCQkXJCbJ9rQc-xtQkjNsbxcqnVu1A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgofJVids-pjOuvbxzDGB4R4pubSjfUij4h-SEoHBQCg&oe=6A5A3028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEVeuYx9LbwQ7kNvwEXKMMN&_nc_oc=Adp_mv6xn8E5Z0K4kfHfnlXWtxbHFp0EtrBM8THyEPQoYwisf6cy9fCYdVzZJN7jqIs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRx5TdrhSLThFJzuI1-T8U47RCvJGjjPiWKZURhwdmxg&oe=6A5A240E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
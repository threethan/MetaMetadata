nc_ohc=V-C1llpn5WUQ7kNvwH5BvIq&_nc_oc=Adqyk39H-eMr8icB9owgw1KyvmrUTbJOPQbdqpnzBN_-BM4OnYyjL6VExr9diRKd3Ew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaCTs6ILf3e_j-F17j9sheWmVDnU-iPEPYrtZxE3zkFQ&oe=6A95C1DB"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPe9Zr4BNJAQ7kNvwGxlntl&_nc_oc=Adpgy8s-KKOOz6UkyRMphWzjEbbWnaffLaZw3Lw2zXRUK4eSVvD2x9q-hQbTXNoDnI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE06X8TS9BDY9zhRNvg1WhuT-OJIJembJaRFUnzLoSceg&oe=6A95B936"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HoBZBkw_vEQ7kNvwGEWo0T&_nc_oc=AdrglMQzZ3HtBj_wY0R9Xo8Vn50zA6cWQIT3wQ4acdMBXOcpReC8VY5eUesyw75DfWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5WwJz4SZHWoRjs6F_niQkh6-09BxrM1bXyoxvB4J_Xw&oe=6A95BD7D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOEDkxgsebQQ7kNvwH7WcEV&_nc_oc=AdpwRwvjaRxHdP_hLR4GRjB-glZIUR6XaCSnwRig4siYW310OIdOHUN8vi6ogCWiiC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH-0A109OG8AatAcv7Vq6Hlfz2BqppX8F-JtndsEBkmw&oe=6A95BBE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd2IFkRRp_cQ7kNvwFy66am&_nc_oc=AdrlYYNVm5AtVAU2Dhmb7C6Pejgoizr3TR3IidA5h6UDVx7PpWSCLscfXjdvfV8Jzfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrYwdLSDX7Duhz30RRseaq7kZK-KTFcKCjWqZqy50EJw&oe=6A95AFCE"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
315771440_7151294874352119258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WW_g2_TDf3sQ7kNvwGvXLdE&_nc_oc=AdpI-eRLYa0-HnL3lSfK_8afFXl1lutztnlsRBYAc2QLDIaT_kLXfzHGd-hdoByD_qU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRUWbGE9nwRMV5F2RLyVEzPy1g8W91b2ZGly35HfKMBg&oe=6AF9BB9B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_SvEIleUO8Q7kNvwEwWjpB&_nc_oc=AdoYHBxiSDxA0B7bVwzK2lPDYg2P2zhv-dUt7d76lOskaeg-4dvPcDorNWT2EUoi1DY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeZuvVyhi7ZmzBIBzWGYWd6sspaWPHq7mIh5blX2OawQ&oe=6AF9EB36"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DS6eN_bCk3oQ7kNvwGKBD1s&_nc_oc=Adq95Rc4hFWlrEpyydqR2wxvwBwbdb0HOpLyPl26iJmckVMnqnMXtu8YE05CUYHfMM0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9cE5HovSRWB3sFKhl8LLxX7LRPNsn9Y0_C2oG8uEfPg&oe=6AF9B73D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiP3sU0S6osQ7kNvwHXhWwG&_nc_oc=AdoUdZjfo8r1eyahrQt9enowDH93bGpjSk-7aG8g8pahDSJmYOwoxY437AF-LuRacAM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVj4yzxVzN7RDT1sjXf0tz0pQ_HubyQ97orQa7Nl9Fjw&oe=6AF9B5A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-9xI4lgmAAQ7kNvwHUW3Sv&_nc_oc=AdqTdwSJCK8hlHv6FJTGeodwh3tGPEdM1AE6jg2NLvC86Una-wSVOOgpcvyDCS_dVT0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaPtNcG3DUrS2Yxy0ybmR9t-FmZS3i4Do5BigYanwmtQ&oe=6AF9E1CE"}, "display_name": "Walk the Plank & Save the cat", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\n{3238951852955382}\n{799214232945661}\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n{1170703084459122}\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.\n\n{1170194548552560}", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/save-the-cat-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/save-the-cat-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
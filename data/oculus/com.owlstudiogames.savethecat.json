nc_ohc=5Jrq_BIEt0gQ7kNvwE6ZCbC&_nc_oc=AdrwNhjojhICASsv6BU0UNqKFXGJP5u63PgG4cDDR3TuiwT2oZYNqYj3x7li_8yLg5w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D3UCD2RB41yfoxWOHrrzMvvf1LEvmiiIgBwJC2WRtlw&oe=6A30061B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HacgpZKjPpoQ7kNvwHCbddQ&_nc_oc=AdrKyKKHj-xCKUu36T-joRNm9cmUYwxJZCYH1mfWoXiGi96EgGz8qvbb9wmlbk-7I00&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V0n7r5X0qoAjAIy6-3AFJ-u0S_y3S8MhQIgRHWQC8tQ&oe=6A2FFD76"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGXYQTDvXpIQ7kNvwHaueo7&_nc_oc=Ado2cTH_5vFnZvKha5HpsfFL-uvatoLW62DYcuCvLvImg1EpygfKuLah8PsPFXgnDgQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X52ujauS_CAi6T7rdpA3nisbr_69soSrzsMwS8z_uyQ&oe=6A3001BD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaVyvdTDnvEQ7kNvwE8nKmi&_nc_oc=AdoHppFRMcMBlYbDO5iTmJSsySVBA1QC6VoaOnwHxt8LdUbKwiO7rw8lEve__Y-WuzE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RTzbvaU8MdIrJV9LrcaySnRk8QNGwkvgY_iV3byXnDA&oe=6A300028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA_xXH6LUfoQ7kNvwHc4VEn&_nc_oc=Adp34W1PW5PUf5NzWv4HkvJEMAbEX0jufc8QosRFgbvtO5FrwGmlawosbniEspgnC_0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-go_YWl2p9q81ueoK2wiE-rGNHICnT8aPopzQ9RG2WIw&oe=6A2FF40E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
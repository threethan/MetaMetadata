nc_ohc=kbFg0c_mGr4Q7kNvwHOxFIb&_nc_oc=AdrhmMKVh6G5-_9aqTxsfXtlsMUJZzxFOWCDIscf70DfeZDpJAc-KIBSJntToVC6Q_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0_QkSDV9wMJ1TUkZmpZBUx1TyxzkQRt_XAFt3mS4pOA&oe=6A9EC41B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIkZ6vSJxrIQ7kNvwHD6nwb&_nc_oc=Adp3WGxzoZq7meq11OiNGvQxX50hnd1yr5NfiR2MI32dL0RYwWUS3Vc0ej-aJyDuAKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeGt-6AOiSLfz4GOFUWAEEdP3vXfMaKq2NNoJ0WJAR6g&oe=6A9EBB76"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmUfaPXEq7YQ7kNvwEPj-h_&_nc_oc=AdoMZBAaNYJIHCqktCkx4X8KidlWQJsPYu_U1IPZA0dbqaau5u7gUQqWkxz_msGxuIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1G8pPXC89PF7l-9u49hVUwEj4nZYa-nG0untk2Usmuw&oe=6A9EBFBD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tcpon87ftroQ7kNvwGCRPE-&_nc_oc=Adqgtl7YrQweH3OkZLx9Wq7PerMZ9fbDxZnUESOFJiDnUceme3vm6Ch-bY2Dq-YY07s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_wBhvu8TW8amx6MLmk9qp9YRDMx3DfrAFmDiGsIZSFg&oe=6A9EBE28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rAOdquM7vEQ7kNvwEG7d7E&_nc_oc=AdqmaIQitEI54_jpUpnaTFfxPTs8nZi3BuiKDziUV5dKSG3ntl-M_hFUsh3hNyj37S0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdHRm8NTiNfz574sCnK9d1uYe-mjwuP3-E0ufYnyfvIg&oe=6A9EB20E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
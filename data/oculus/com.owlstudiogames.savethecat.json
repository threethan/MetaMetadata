t-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_2180586315771440_7151294874352119258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZu1ITFtBNUQ7kNvwGMCayg&_nc_oc=AdpbZo3oCseM-1nLbx-arIwiXDJDAXpDh2z0VYBMRv12d-s-roWhVsqe0fE2ZDo1lEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzNQPjSdJrWFPYovNUXnHqCwpdTDbcpe83S0NM-FF_cA&oe=6AB9221B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb8MjofxVdUQ7kNvwGb4ZO5&_nc_oc=AdomhUmbNobLX44gtY8Ud56xC5RgmJY4p5lXu-PMbjEeHPf5A2XnWYyAl08qeCwhbi8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVbbDqOADzvUz9a_CgbhwEa655zcYLunBlx6fS3A0EGw&oe=6AB91976"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFXkQt26Y5cQ7kNvwHRqaDk&_nc_oc=AdrOlQi2qkm9T9e016tlA4hrvS-I2b29hS-AxSHmj61NdEZnrejUcf_-ofEwfLHjknA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmY7_LvB_yYx_Nf4jZRTi-xkRDdTGN121PjHc9KOmJtw&oe=6AB91DBD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoRUZMX_CWsQ7kNvwGPjS01&_nc_oc=AdqCaSKzpq-zt7dQ2hVDbISswGsDv8wb0IEvPzRklreEAu9oR0eJm1wHPVdKsH2VZBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-WdCsHnN3xfD6PrK1tRM_VrfXDdaDK-x1WH_S5_pKbQ&oe=6AB91C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lN87hMR1kIQ7kNvwGLAkPw&_nc_oc=AdqPcVSpxZyHlOm7nBtTcmYYZwFSSGSuHOVruZVGxKHYfLCb9a60B2Ki1FDFI30auAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwfXR3i2W6I9_VJghSDiZ_zVIi7SyQmm-y6r0hVLLiYw&oe=6AB9100E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
nc_ohc=y5dmYlb4tOYQ7kNvwEVZZv9&_nc_oc=Adp7ayraUuOAy9-ho3oQ8WCMfdcbSpOW-JyzV9VSUUqTk0LAmVPhQHBYmkxnsrFvrf4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-SZSkPvdoaSRxraZKAWb8_t_DS9c65F96Gu-F7lBmlg&oe=6A88225B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MP1JeQs4ccgQ7kNvwHyvsPk&_nc_oc=AdpjVbn1_P4Cvh2T6mwMWKrkhhVSZYhOMzJ9fAghLi1l2BlzqZcGlGn-AwBi-Dl3VFc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE34dKhn8fZYpHremsKb86X1vTW4ByL-A-LtxI-4Up9wQ&oe=6A8851F6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix8RUleA-LQQ7kNvwHPzhxy&_nc_oc=AdqYe8U7i7soW4Dxcbf9aFYgV_3X8R_jjp3042J27kVQqQjDsAm0AyO0XdiUUkObCpg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaXZsmfp0YerCojMrf4adtgROHo_hntJV4MXk_8zNDWQ&oe=6A881DFD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQIyLEMLoTEQ7kNvwFpAR1i&_nc_oc=Ado0prNd3YgzUo6XB_fJfGIeDfRZBvGe8GRoqYuzDYmcArwQ5oc62jqy2NNF4jg2TTc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_DzXe3uw5mPckdcwe0ILoX37NjK2kSszL_XX6-vWMNQ&oe=6A8854A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJADWMqPqhIQ7kNvwHVzbrO&_nc_oc=AdqMT59N5u6aNXu-aqFqm89Zf9hCx8ado_aOymcp0MEZOghr0l8ZaVnpsUM_1mXD0dU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmDEQWUd-6aw5aG1TNlPsa1AkfWZ4rkDbkOJ7STjrxTA&oe=6A88488E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
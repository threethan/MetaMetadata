iuaDZKCjbXWCUb1tpT-7YWS8kBVo6bA8SSkiMxKYl3JbrRut0ys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPKbsOtM5h71huQ8aMA24Rq4M4Tudf6kvEdHWAEBRmCw&oe=6AF1D29B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OO6BLIrr5MQ7kNvwEa-BKC&_nc_oc=Adp5Rf-jxJVQEA16EmHqzNLDg69vw_P9UUaJ6MreJ5HWdoHN1ygr_7Rq3DUXgHhv3WA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC2WKSu61ya4L9BMxV3nUoXwIegKaf0B1uLNDTBIrnLw&oe=6AF20236"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPwGZZN3V4wQ7kNvwE6XQsU&_nc_oc=AdpDu8JgwtNtywk_InsWS8Jcw1PJPZbaELWsuAIguN0BQVUhp3CFP-Yt_CIPV_FiY9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXpBQU3zy3FvlV9GFST1NrXVPXnjZjRXXSPCGtDBMplA&oe=6AF2067D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jUxBIGkzXoQ7kNvwFspYtO&_nc_oc=Adp80vT1KpOEHyBqrxvHN4uPEZQmKj1Z1Rrq_TMRGvUC3YbWTVNav-H9qTrssI5Iqfo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrHQup8FwdGIRwiYejTSDUiUurLHYUFWdXgnEJxcPuyw&oe=6AF204E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNYan7WypyoQ7kNvwF-Rsij&_nc_oc=AdrxIRMmMzLaeDSCNkNjmRi_bSDIz0Q4FxqYpOcI0iTgb8xC5GngT5c2EMY2BF9k3d4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHaFs6tFEAMbJO4hsabNZPLUPB064jvcqKt88abdAVDA&oe=6AF1F8CE"}, "display_name": "Walk the Plank & Save the cat", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\n{3238951852955382}\n{799214232945661}\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n{1170703084459122}\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.\n\n{1170194548552560}", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/save-the-cat-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/save-the-cat-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
nc_ohc=qLlKjKsikscQ7kNvwGH3ir0&_nc_oc=Adr0b3m19uxGP5psFW1V4BRSrqCdpPZBIu4jaCtKkQD3778EwJZHINNNkpNa1hflzs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yUjmjFFjEm-xgTVtJp8G_RUP5hDLRYBnMWBanUFrq0A&oe=6A47C11B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL5csUvpMMQQ7kNvwHXvfrm&_nc_oc=AdoVnRpFN7hDMCZYx_gAeDtqQvonZ8Untsw0YYWlU06u1Y4DiSZavGuWcNnRl2NBLtA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-alNZWCFDfDrcn2hJF8S9OiS5PA7iOUDt2_5-Omf0tg&oe=6A47B876"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpTOrrHJYCAQ7kNvwHTuW1U&_nc_oc=AdrgnWzXntS6MAu9NHddNSzi0wdGwKURqIngPDqAsngJN_1qpebtMIjEY3a1NWvaGU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XJiECSYtbIyc3oxnv9a43M5EbtGKbCjQquyuW8_FKYA&oe=6A47BCBD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8FqLe259qQQ7kNvwGDVeYd&_nc_oc=AdpoHcvv8B0YgsnZIUllOf0_C4xU4LDyTSv8a82PqNX01ECSRUpT9Vlk79amJOESsZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n-S5V0LQkN8I9-NAI0tp6fyUIj6cOBFp8vRVKefmK1w&oe=6A47BB28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qsm3wUmN1zUQ7kNvwE3xg5O&_nc_oc=Adq4Ly0j6BC4BmBP_MJRnhZay5qMxSc38HPbu4-YPWgoQ0zSsngGIpvPxB1WWGcMCfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gk_GMKpd4VBC-3iWZyn3erJSrLyhr0yD5JDnLK60c0g&oe=6A47AF0E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
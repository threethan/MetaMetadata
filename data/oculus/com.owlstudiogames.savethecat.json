tent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UVkFHgR4LDshXKXr2JK7jR7blpPdiJJghyAGWCzRr8Q&oe=69F8A71B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhu4Lkpr5mwQ7kNvwGrsPc7&_nc_oc=AdoI83lguOeRydWlPzaWMj8nLR2Xx7WHLvk3-kAB7UbcfqiRKMCrbECsK-OiX1Q-ugE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3b1taqYTUFFwhluVZ68qBoVZZbl73-fqQMf7wLu0oNwQ&oe=69F89E76"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCBUG1zawdcQ7kNvwGezdKF&_nc_oc=Adr72Pz8-7o8fW2CxRZFcTnlXZ2_oQ4-XQvHZBYLyNdEZI7llVeS-Dds_IFkp8-hWJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ruvIIWbHYdEE4h548Z7_1SjqSO-kJtCp_-ubc-KWubQ&oe=69F8A2BD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o20kUJLALDkQ7kNvwGNWd8G&_nc_oc=Adoui99V_S8kzJLblboz5cdZS_2Thqac7dFCUiaFGlsG7GVXIkFhp0mlUmxtK4QFGFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GJtFGQrK2e9yL4RyKUcoNXZ4pAnwuyAwDzsi6EkspoQ&oe=69F8A128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzUDGffeaS4Q7kNvwE598Cg&_nc_oc=AdpDmrLvMb_cndevjvtJcoSWqMccQRnVYwlOR3qJqszFTZ654GMGmZOtg-6QC-TBm8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TQR1a9lGnXcYCgLt7O5jUNTmtUCRMISx5CR6ql03_NA&oe=69F8950E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
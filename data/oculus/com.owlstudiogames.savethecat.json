nc_ohc=2_xR9rxQeoIQ7kNvwHbPca8&_nc_oc=AdonlC3scEKB5osXILyhHK61DEXSgd8NnkqKWw5gdP5_5TdaX4RbWlH-rz5IDgXt5mg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2sjiCcWmWjgdvjLax97two_76BjXPDruX0ZjNnIhPhA&oe=6A296E9B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty9zCHjBAWgQ7kNvwGrUOxk&_nc_oc=AdpzRgMuNRS1HAoqgynpEyMTFXgm_hQsYQwhBrYo1pVCcEEk3zl_xSwVNJRXPZAexvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83eABi69LfUy2O7cRGOTkm0CsTwxRHlTWtuz1VzYpV7Q&oe=6A2965F6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRteEty98T4Q7kNvwGQNogs&_nc_oc=AdrIUVDppiz1l4NNEtYu3hvojWlPJ6AkkbIokO5Sf75ZKobsVytNcteLMBALjF-pbqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89-H4L_Q4N0UrVdU-6yoetwCTlNSUZAMyHuL1jhs36mw&oe=6A296A3D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujnVO5JwkDQQ7kNvwHdnPsR&_nc_oc=AdoquN7XXvVQ2PgK7fbg10ALrgaon64iObBStwE25KE5x3En3_B2i8eXofiATJghbYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2CoiHHGP6KT-GDmqS_TF6M1OEjRjYTfq9dHJPCu2QQg&oe=6A2968A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA3XA6rzXhoQ7kNvwE66V9f&_nc_oc=AdpXMFIt1NryUTig8XVN5NysWvlHbzrX_vQn1r2igvEv7HAx_jxkO9wsiAn0nkh41a4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pX_JUDpPWXGPWV5fTkQOmcDRJpiiKQAdvVyx9HEiS2A&oe=6A295C8E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
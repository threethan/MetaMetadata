nc_ohc=CSs1kDd7vuIQ7kNvwFbpnUi&_nc_oc=AdpLdqO589UxX8B123lJupQVlv6fXbV27O9CNAGevhM4g750tb1zmj7l_UvjddTcRkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cA4u9mTwj1fsT46KBRi30qOHAInPazxFGUWVhiAU-pQ&oe=6A199C9B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icawvQdEtjkQ7kNvwFWCht4&_nc_oc=Adqx3lzKT53dX39s81No73kJNnfsb9vvVcdR9uVrM0rfEBKTGlDSuScXZ3endgrZRKo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iMV0e5tK8BenewVzw3iYM3k_CPaj0VqwMr2D38ub6iw&oe=6A1993F6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iit7fyto7JMQ7kNvwGwxtrY&_nc_oc=AdohbC2_nHprVq5TVfyfkXpMqgkl4y16tt9WdEAo99oBKKYtTrcwq9hyj9qzBMOT3Q0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52ZNlumHmW8u-heFn14nsmLGwwtC44SazIgHYUTwondA&oe=6A19983D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK4GcRmnomgQ7kNvwESSMYk&_nc_oc=Adqdl9ArFa5yxQKV8CWKghny3YbFZ4koCG0n9Dbf_pBuqueJQYxxHJMp9J7RF8Wilzw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iw18kG2ylcuHJl3BviZVTZBWbmVY80Dfjvhxd4XzhAw&oe=6A1996A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJXA58XE0_QQ7kNvwGkhloN&_nc_oc=Adq9pRTXT_JrOXwEEmrzfK2wWlVrFfRooMFxIa0RKqoXotNia81vEEtQvYkbEVuVTDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i2__wHb1xwhg5OdLHWvzsr5-qXHE9nOM8YGD9iSEgIA&oe=6A198A8E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
ontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQzIlIZpaeeAFnKKPhUzOYTuuyu1p4YWw7oupVtvN20A&oe=6A50F2F6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwtXUMkYmr0Q7kNvwENq8_Q&_nc_oc=Adp7GfalkVxROCNDMB9nOCEtte6WRjK-baOUP7_8edXf4oXLuR1CQX_C9xVM-2qAG_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoQjZxrhP1sa5ApNEUgHzsNV2fIGZ1WRwwBxhBeZvlDg&oe=6A50F73D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xryEJZ6mcLIQ7kNvwGfAPbn&_nc_oc=AdqwbUPNFALz2ODA8Y5HJr5vwyvg8-gFSS1S6wky8ys1ZwX-9YHmRVCC6Rdr8euDqUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR6kmwcEtc_rfNbBzMIX4OxPCC5zhwAFSbdQhvXdEzkw&oe=6A50F5A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkUWw7bG9k0Q7kNvwEB2d4k&_nc_oc=AdovyRCO-Ig_Rcj4HyJXH0jfTBi3o4nGs2FgL7Cu3FoHU8ZIRb17fZ4op3MWXoNOrso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRufOa6x1WMFaGze3f5LCUvU1DcgPtHpzz7uz4NWv-8g&oe=6A50E98E"}, "display_name": "Walk the Plank & Save the cat", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\n{3238951852955382}\n{799214232945661}\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n{1170703084459122}\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.\n\n{1170194548552560}", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/save-the-cat-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/save-the-cat-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25713473871658026"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_1200449775398620_8938034006613200571_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vL1jSGzuedMQ7kNvwEoIypM&_nc_oc=Adp9Qz7_zGNmXCbl3YzvhxeIfbdhLuLarIB5v42NpAFPbTiqaaUdpjBFFp7g5nVmOe0&_nc
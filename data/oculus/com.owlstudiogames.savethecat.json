t-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_2180586315771440_7151294874352119258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USPDxQb_Yt0Q7kNvwGH18LJ&_nc_oc=AdrX_6IlifHAcgiD0jezM67UHOpINR1kTRJ3SblCST2AGHu12T1-owg66Ps7_W_x-KU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPms9m6U5e50IXYKkh9FW1u4Fpmz-L4QYb6s52BUFAtRw&oe=6ACA459B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0T4z0oz4I0Q7kNvwHYeLe_&_nc_oc=Ado4Ie_UZqNv92qB2BAeJhvyGbJ1WwU3CXzV130ckRdWCy2YC9ScTf0oI0wDKj5ynQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXRc4EW6YjjAZeGQuITv59rlwd3HR4SN7BNnId7z7ZDw&oe=6ACA7536"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrAnaMWpnnoQ7kNvwGW2grR&_nc_oc=AdrfYIKNxRAnmaCjQEmcW96PuFdkDpD8luVKG2XQxd_EWyPJ6q87vIRrpyqAFykS9DQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWf6LXxtn3hoNo9wLvOEqYRNf09LXMZDFuJEj0yyvOow&oe=6ACA797D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0qqrxPl0esQ7kNvwEuMjL2&_nc_oc=AdqpupvSYSbfrwC9ajB4gAAgJ_EGCs9ofDxe9enBqAOe4VGCVBbR96Ze1-an72DM6lU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML1viUb-KxpUJ9i3pRNsjxOvDpsJHl32sU_Csn0O2R9Q&oe=6ACA77E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-YEe8nmJ7wQ7kNvwEhiH1S&_nc_oc=AdoVLWUWVlydYi6PdA0xeD8Z2ro4f9KvclCkfZyvcwjsDTRGKQDcivpjxkt2LBi3q4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxmQxuUgSPKHjAXc4u0fmDmtYeDcs8FRz5ckJSyXq2BA&oe=6ACA6BCE"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
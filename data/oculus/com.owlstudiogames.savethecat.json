t-dfw6-1.oculuscdn.com/v/t64.5771-25/491819859_2180586315771440_7151294874352119258_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ec6x81nwmP8Q7kNvwHcH9xy&_nc_oc=AdrEefGeiXjlvPBpv4StjIN1PpFU5qYaFFtlzLSmM-dIVgSizJAaDXAArbLukKJ3IBs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1zaTWVsge-bC8CIeculgOfVnac5_vy9atYH2XmM-kgQ&oe=6AD3B85B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLGP92M5CiEQ7kNvwHo0Ein&_nc_oc=AdofNer1DUet03XZosixCk08pbkRbqGZOh3hzFFGtRCDRo4StVJgWZiDGc2X1VMBycA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDkRh2CoXEBC7zrcOCrzCtBD-LCECKsJqvjZAj6yH-1g&oe=6AD3AFB6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JXsPt0exOsQ7kNvwE99R4S&_nc_oc=Adpq8yDIh0hdBYZl413KOdZaPSju1pM0rT1nr8oAbCWSGxjbMnF4o_kXfx5yS7tGWcg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM58VexWlKueEKP4YGF76iEa3pxL1_dHXK52m3r3WMrGg&oe=6AD3B3FD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGwMVTMwUkQQ7kNvwHp84BC&_nc_oc=AdqGh9BdxXZGOsIansS-EE9LS7oiyNmEahGtEFzlWTK_pFWWy3e4ov4BDUWUdMF5Uek&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaIlhtpR-Z-sWG306nNOyAyIlqxJyYqD0ym3PPwZ1h6g&oe=6AD3B268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXSpUFGfTycQ7kNvwFB5cMP&_nc_oc=AdrYhWwEInCt-tZ59T7bBZ9HQAX6pwUxg7Z-MkD1DFCUQniD0TIbbiKuF40zo_dpKyM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDrflObn7ywPWMGtwZeGsL4YChHF6xBcaxQJmYuK9T7w&oe=6AD3A64E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
tent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uGnpvAH1S5GwyhHAkcksDZhUaOvz_LU0yo74OI4ynxw&oe=6A07279B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDc8FVpTLssQ7kNvwHMbyH3&_nc_oc=AdqiFNAjd0gzs_MphVA9x2trXPPB1ljswx6Xxlgfdd4M84ELT-DhdHO8G_HH1Ya4nPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xTb8eVct_PtIs2NLNllNLh4-Sr9dZKtzQA9kBcLGyRg&oe=6A071EF6"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nORBBikmyL8Q7kNvwHFYggi&_nc_oc=Adp854Rcn641bBcXmvJrMrXH0I8gEQzaAaTVTkD_lzUObPHNafHCTUHPw5Ddnoiauqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4peokYXF0MGMau-5WoSlOUSda4E_CpOURVXUyE5YvW7w&oe=6A07233D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zs6UyFZ3ELQQ7kNvwG8xYxb&_nc_oc=AdpSDplJh5SaGSsABXF7Qi_YgoHeuIDiheq5JAcxLxUjyC5Mti1_qeSn0EYXslNP0L4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63IMSwAZaWy2dcSSHZxt5s8rxMGd44z7r0IlFh4rZL5Q&oe=6A0721A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t05WC7B1kQEQ7kNvwGNMiOM&_nc_oc=AdrwAmX0akhVJjmoW8ey0PxNJkD7VEW-LsAGWKSrD1VWZTyCBfZU-p8PgL4Woq9_RrI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mg7XdYgG2WGW5P6YqybLZ4cVJ7tlyVocevHv_Q-jGFA&oe=6A07158E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
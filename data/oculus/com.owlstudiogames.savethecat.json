nc_ohc=y5dmYlb4tOYQ7kNvwHvGqJp&_nc_oc=AdoCAMXj4Y6-qiAGGyFzAZGtJLyFS4JNxpSth7n_Mv8E-JZ6TPcY8Sj7UF6hhuVevpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBArs6RQyGR5jjgr-GzZvwkGDLQ96GfYC_H4btQKhGeg&oe=6A8973DB"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MP1JeQs4ccgQ7kNvwFP8cfM&_nc_oc=AdqKwA4JC6Wc-DkLXIYDhPRdGxUowRs1cJA8TMpIi9YcqkMJX10sVCTz6Fu27CRiSQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_yEoOZPQoL9yquNhtX1TxcD3_0nxFlqR3aAlw9tHrLA&oe=6A89A376"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix8RUleA-LQQ7kNvwF2khG0&_nc_oc=AdqTrM_hbpm39PebLW2t9t4Z19Ow5wair0QI9xO5WAshpqnCY65b_wW0N7L1ANmOmFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwbOL1OKrnju5S77R87XcgQvM8ZPDRBe_qqdxeWRV0jA&oe=6A896F7D"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZRijschhesQ7kNvwEJp-Fk&_nc_oc=AdrDlAmOqnqvPqwEGDloddeK4NZ9GgfOIdxRDQUjuyMAnu8_Mq13nYUn7mwyK8z68MQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxjouQ3cDiSCpR9cRzn0kQb41Azy9XNjFSiAEFOVkLQw&oe=6A896DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJADWMqPqhIQ7kNvwEU7JNU&_nc_oc=Adrvt5iuCnM4lYX9ZYLU6XimTFWld-sM1xDThmWMS2P1N3KzE3sZRcGq0YXMVmRhfko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwjTgcYndEFzRRq1ObtYX-SIJRQdtuEI9gMN8RO3I0UA&oe=6A899A0E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
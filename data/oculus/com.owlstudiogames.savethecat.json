tent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dR_fACBek2dJA-tFKYphHQYOlY22C_Dv2zjRyr9OZtQ&oe=69F3611B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIoXRcaZO94Q7kNvwHkbbTF&_nc_oc=Adqz7v7UX0TBqTq1yeHWBbggKkwY-V6Ghze-rn0v0vC_5i5up0sACtLG5xIytHOXFdY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-IK_ih9xIWNqBUaQptOQuE3NQq2_FFcvrQqoseLqukg&oe=69F35876"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py91YdTaLIwQ7kNvwFyhc8I&_nc_oc=AdrdxFf1DF_8ge0-ebSlBOaoaDobk13WW6dpb3uzbNG9IbPRrHt6hwUmNdI88MviqcE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25zJ-eXg4gzdH8VfAJmOxXpezpDC0ewXEXhmf-PfvhTw&oe=69F35CBD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xvZq3gZ78oQ7kNvwH8MOxt&_nc_oc=AdrncgJov13qbVDw-Px8424aC2I31TeRNvdz5aPwH2t9MEuQDgRw44w1p4cRM9T3_3o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Zxop8gknqw7hScecg8RwnWQO3x89n6A8LOo6nSC49sw&oe=69F35B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbAd52HPZugQ7kNvwEyKprT&_nc_oc=Adq4V9XCwk7641DgRKIVbKk9cwyl0kQPND5lUnbsoevO9F3Q8LV6zyHe3BIAjQUvXxw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37L2Y2lPROA-xtS76ddGL_yepcHwJtpmm9FDI9OUOeBw&oe=69F34F0E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
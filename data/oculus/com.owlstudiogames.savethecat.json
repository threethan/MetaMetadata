nc_ohc=PIQDTYW1RJkQ7kNvwGVNDQ2&_nc_oc=AdqBMer6SK--reR8hK_cbf6ntAYqYr89aulcKepixMP-6HGoA2iqTeOdlmp2nK3X2Uk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ne0mv3uzRrhpDOoTg-DOcqxoIBTVnDc_lupD5lpqo1A&oe=6A354C1B"}, {"file_name": "screen3.png", "id": "844414724695242", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_844414728028575_792787066928131982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRokftatiFAQ7kNvwF4UPeB&_nc_oc=AdqeYIxFtNv5M5ZJjnRqwcUdyMXbJHH7POk2cKZHR6zmtb3hiIyn7vTSjNPKrQtDEjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T4OF4Fk-psXt1--LDdSKMHLl7BSzHAl80iVoOl2GwOA&oe=6A354376"}, {"file_name": "screen 6.png", "id": "1222995403320231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_1222995406653564_407400237635766184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR6C5uqFfcgQ7kNvwFr5D91&_nc_oc=AdpF8oIVBnWM-9sJSAgQ7mfKU8v-qkYqwmoDJ16dC02qKh0uAQ8pq9ty6PUsMQEYiFY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qrtcLb3FooIQft41Nh286fsr6_5WlbcVetuZef7EkNQ&oe=6A3547BD"}, {"file_name": "screen7.png", "id": "1537293004282121", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822550_1537293007615454_158708366642547484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awnOQfSLWd8Q7kNvwG7fI39&_nc_oc=Adp2sPE3aTC7HWZt5TgvpnnfMTo7pPnEA3kkegQCtXhbiwIGSC5XnuFLx-bKOYhjzEk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97kPGqoH8drFYGr0Bm9UdrH5FgWrvnPQVDW5yGOE21Og&oe=6A354628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gg cover.png", "id": "761019123599137", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825563_761019126932470_3739153444697569465_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULQoLgtYZakQ7kNvwH_UB9L&_nc_oc=AdqiMrJNF7SegM1gfVdikAMWPTj1zW1x5THKjiqj7QP66HrG4kSyE-31bAwenbhbg5k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IJ30PagvYPN0P_uaQc22lPYzGwOTT3nU7rZ3TuqBXTg&oe=6A35724E"}, "display_name": "Save The Cat \u2013 Plank Rescue Experience", "keywords": ["WALK", "PLANK", "EXPERIENCE", "balance", "heights"], "long_description": "Do you have the courage to walk the plank hundreds of meters above the city\u2026 to save a helpless cat?\nSave The Cat is a heart-pounding VR adventure but with a twist: it\u2019s not just about walking on the plank, it\u2019s about saving a life.\n\nStep out from the elevator, look down at the dizzying height, and take your first shaky steps across the wooden plank. Every move counts \u2014 one wrong step and you\u2019ll fall! But if you make it to the end\u2026 you\u2019ll rescue the adorable cat waiting for you.\n\n\n- VR Mode \u2013 Full immersion with real plank support for ultimate fear of heights with many levels.\n\n- XR Mixed Reality Mode \u2013 See your real room as part of the game world.\n\n- Realistic cat behavior and cute reactions when you save it.\n\n- Dynamic city skyline, ambient sounds, and realistic depth.\n\n- Perfect for friends, family, and VR challenges.", "short_description": "Face your fears, Walk the plank\u2026 and save the cat! A thrilling VR height rescue challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/savethecatvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tamer George", "support_website_url": null, "website_url": "https://sites.google.com/view/savethecatvr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HA
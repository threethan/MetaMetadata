5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdIZFCZXkkjKXW5Khi9xf5rcCh3sS8eXnYmpi6hK_Fuw&oe=6AC6413A"}, {"file_name": "Charged fireball.png", "id": "1502092810734937", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1502092814068270_4569580092471904191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4tbeNzADZsQ7kNvwESWDVT&_nc_oc=AdrWG21rP2R7D15FFTCyDIKSdipw02aEQX-w1aF-wotmPgAUOtBWWhIyVOVVxeeEA8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB41Q_UunshK9JNDd49xNUzahLxVkhXKs9vEZrQcQY-w&oe=6AC66272"}, {"file_name": "A dungeon full of loot.png", "id": "754017930545149", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823398_754017937211815_569691763463004538_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaZeHEB7uj4Q7kNvwEDujFX&_nc_oc=AdoR32NnePqK9Kx-ZUNQZp2bVypvheC2mLAabRMKJPLyX8gJrdzcl4PCQfC2L6hJuyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMat6Z3sepNenZBe6gvpIvMpaG8bv3PBI5Yy8oq1jNz4w&oe=6AC652B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "04.png", "id": "1653387375328465", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820594_1653387378661798_5238962915601134125_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc4WGC4oWUQQ7kNvwHJbLJE&_nc_oc=AdqBNcSxHik93RPH-2OC5Pa7l7ezyhX_WQ6hQ8VzQGnVS9yXlHkHGAjO7D5RvPEGlLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4qbrbD2W82pAIgjDbPFfB6GlzCUzMntQNCm7EQdow7Q&oe=6AC67312"}, "display_name": "Tower of Titans", "keywords": [], "long_description": "Become a True Master of Magic in this **Hands-First** Action RPG with deep character customization, where casting magic feels real and every decision counts.\n\n**Cast Magic for Real**\n\nPlay directly with your hands (controller free) and feel the magic course through every finger. Cast magic just like how you imagine it. Throw a flaming fireball or shoot lightning from your fingertips.\n\nOver 30 spells are available to master and upgrade. Start with the lowly magic bolt and upgrade it to unleash devestation with effects that fill the dungeon.\n\n**Deep Character Customization**\n\nBuild an acrobatic rage-filled Fire Mage, a Necromancer commanding a legion of the undead, a Wizard of winter and patience, a Foci of death and lightning, or everything in between. The choice is yours.\n\nHundreds of skill and equipment modification options are available.\n\n**Battle Swarms of Enemies**\n\nHundreds of enemies lunge at you at the same time. Become powerful enough to decimate them with a single spell.\n\nEnemies come in different size, range and attack patterns. DIfferent spells are strong against some enemies and weak against others. Test your penchant for strategic thinking in the midst of battle while slinging iconic spells.\n\n**Face the Titans**\n\nLook these gargantuan beings the size of buildings in the eye and live to tell the tale. Defeat them to conquer the Tower of Titans!", "short_description": "Blast, conjure, loot and craft your way to becoming the ultimate master of magic in Tower of Titans. Feel the mana course through your fingertips as you conjure deadly magic using your bare hands. Grow ever more powerful on a path of your own choosing as you discover great rings and master new skills. Ready yourself for the moment when you face the Titans and uncover the secret behind your identity."}]}, "developer_name": "Chaossic", "developer_privacy_policy_url": "https://chaossic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Chaossic", "support_website_url": null, "website_url": "https://chaossic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "re
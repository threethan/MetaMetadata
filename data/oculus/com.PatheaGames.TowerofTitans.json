c_oc=Adqmhn62lUwgJl_fvIHDCZCJgoaYVw2bWP9ENx_5pha3KiQLCsPKf4KfIsSTpT8zY70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORJNQBerQalnYoDzaFDWMphkCSmo7VKMeuElptlr9BVg&oe=6AC6739C"}, {"file_name": "Item description.png", "id": "753774797247293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820619_753774800580626_305697002212467920_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daqarkbrIrsQ7kNvwGFiZc7&_nc_oc=AdoqCZy_2T1zOkjhctwhMFzFYtm9AkYKS3X6vxDiD1OZOsYEgSie5g9YwQJqx6-13YE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdIZFCZXkkjKXW5Khi9xf5rcCh3sS8eXnYmpi6hK_Fuw&oe=6AC6413A"}, {"file_name": "Basically a flamethrower.png", "id": "793869439966451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824081_793869443299784_3565790520966428589_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_Xj_5Td9NsQ7kNvwE9XqvL&_nc_oc=AdquCwccK4FdAMRMHB8P1B9SEbEdD8w3CM115xwckidTdRw8t9WdX-ExWQUi10fDXT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPak4-JT7xkUcLZu6U5K66DkEDcBpDfiw4rZeJshX7UlQ&oe=6AC66D89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "04.png", "id": "1653387375328465", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820594_1653387378661798_5238962915601134125_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc4WGC4oWUQQ7kNvwHJbLJE&_nc_oc=AdqBNcSxHik93RPH-2OC5Pa7l7ezyhX_WQ6hQ8VzQGnVS9yXlHkHGAjO7D5RvPEGlLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4qbrbD2W82pAIgjDbPFfB6GlzCUzMntQNCm7EQdow7Q&oe=6AC67312"}, "display_name": "Tower of Titans", "keywords": ["dungeon", "handtracking", "magic", "wizard", "blade"], "long_description": "# CAST REAL MAGIC WITH YOUR BARE HANDS - VR ACTION RPG\n\nFeel magic flow through your HANDS as you cast 30+ spells using natural gestures. No buttons - just you and devastating sorcery.\n\nCradle fireballs in your palms and hurl them. Shoot lightning from your fingertips. Raise zombies and walls of fire. This is ICONIC spell casting that feels visceral and real. Upgrade from magic bolts to screen-filling devastation. Master fire, lightning, ice, necromancy, and more.\n\n{1286674143472141}\n\n# A VR FIRST - OBLITERATE 200+ ENEMIES AT ONCE\n{1879125176356620}\nStand your ground as massive swarms filling your vision. Enemies vary in size, speed, and resistances. Magic and Rare monsters roll random buffs making every encounter unique.\n\nFireballs devastate orcs but miss high flyers. Lightning chains clear grunts but expose you to shamans. Hone your combat prowess and test your mental and physical abilities to the fullest.\n\n\n# BUILD YOUR ULTIMATE WIZARD\n\nBecome a Fiery Mage incinerating everything, a Necromancer commanding undead, an Ice Sorceress freezing all, or create your own Hybrid Build - YOUR CHOICE. Hundreds of upgrades in the Skillarium, Rings, and Tinker Table crafting make every build different.\n\n{2191346778024152}\n\n# DEFEAT TOWERING TITANS\n\nEpic boss battles. In Early Access, Rajel the Inferno Titan awaits. Can you vanquish him and his brethren and obtain the **Cosmic Heart**?\n\n{1064624888955002}\n", "short_description": "Action RPG meets VR spell casting! Cast 30+ spells using YOUR BARE HANDS - no controllers needed, just natural gestures. Battle 200+ enemies on screen simultaneously on your way to becoming SORCERER SUPREME. Master loot, crafting, and deep character builds to face towering Titans. Join us in Early Access to experience magic first hand!"}]}, "developer_name": "Chaossic", "developer_privacy_policy_url": "https://chaossic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Chaossic", "support_website_url": null, "website_url": "https://chaossic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "27562
GT7lQT&_nc_oc=AdpdtjnzOWomDW1Dh2h5HAvHRNdNoi1Oqf3ZsUNzENIvJS9REYdpotL75ck7hy4to_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRqZ0m-v2KwWq3gCjdWcbL57SboEOZyX_eKk2eZ4oTHg&oe=6AFF0189"}, {"file_name": "5.png", "id": "1731245657900098", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_1731245664566764_4671593085496796373_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QfIZIrI2AMQ7kNvwEFnYCe&_nc_oc=Adr2oVY38PCoO3pqbF5ZmeMXE3Zh8sR5bNEx6v25FkaThyiAt31KewGICPJxnzSgiW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPCOJZ03sE0MkSQeJfDDqGakWvvBlCtpZciXciTAnrlg&oe=6AFF02F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BI_Landscape_2560x1440.png", "id": "1762390601594031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604275479_1762390604927364_1943972809123641683_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6zqZ8VA_asQ7kNvwEqxnaQ&_nc_oc=AdqoLUaNc1_uadI8ipDDtXBiycAr_ZwnRdAIayMgRf1XRAXI0ZT9DsIoDMFGxeYkqDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiBGZqu3Tx51Z2G65s7NioTJ-AXYEUnaDfCL1NQ2v3IQ&oe=6AFF2B49"}, "display_name": "Bad Inmate", "keywords": ["Prison", "Escape", "Physics", "Survival", "Stealth"], "long_description": "**Every escape attempt is a new chance to do something smarter, funnier, or way more questionable.**\n\nGrab a spoon and start digging. Use a dumbbell like it was definitely part of the plan. Steal a key, unlock a cell, trick a guard, scan another prisoner\u2019s face, or throw lunch at someone who probably deserved it.\n\nThis is a physics-driven VR sandbox where almost everything can be picked up, used, tossed, hidden, or turned into part of your escape plan. Explore the prison, find strange items, complete weird favors for your mysterious wall buddy, and discover all the ways your \u201cperfect plan\u201d can fall apart.\n\nMaybe you sneak out like a genius.\nMaybe you start a prison-wide mess.\nMaybe a security camera spots you and sends you right back to your cell.\n\nNo big deal. Try again. Make a new plan. Make a worse plan. See what happens.\n\n**Escape, prank, fight, throw, crawl, and improvise your way through the dumbest prison break VR has ever seen.**", "short_description": "You\u2019re stuck in prison\u2026 and the guy in the wall says he can help. Bad news: his plans are weird. Sneak past guards, grab random stuff, prank inmates, throw food, steal keys, crawl through holes, and try to escape in the most ridiculous VR prison sandbox ever."}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/badinmate/", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27059251600397038"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1392919413003708"}]}, "baseline_offer": {"id": "1392919413003708"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792083600, "status": "PUBLISHED", "id": "1392919413003708"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"node
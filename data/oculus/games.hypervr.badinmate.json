tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_1413892130114078_7364828435886064787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0A6l3ztap0Q7kNvwFd1FGt&_nc_oc=AdpJ8rM8ktf2kUnMGIRtlJ5wh2GaiS98CZtq4ZR77JrE2jWKH79fTlqpM6pvOcWbarQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd1waTH_kVwHpmNc0T-H8WpAGs0LTG_Oa-tJQKVicoRg&oe=6AF885D5"}, {"file_name": "BI_screenshot_Hannibal_4.png", "id": "1706494267545244", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_1706494270878577_4746925174171756761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kjju2mADUrsQ7kNvwGh8WBk&_nc_oc=AdrvP5WALnkMJfynZjsNoJgomZUydcHo-xrT5tbPTDzrNqbzLupSfuSKKTd6HOtslJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOk4CAX6NxNQ8E5xs8Led0joFJgCBQWXsElQnI3xknJw&oe=6AF87C9B"}, {"file_name": "BI_screenshot_Lab_3.png", "id": "2156150281967863", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_2156150288634529_7381117575835195723_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vij05QNLt-4Q7kNvwFIVR4Q&_nc_oc=AdpzwzZnvpGWv_5LH4x6S84C98xa2XpUnMvkuuXMz0cUReiziTlti0y5fnN2jUIp5K8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5wRTS3KdiUtnXs1P-JOOpJC0cvlNjRuIWvH4ADvlY-w&oe=6AF8820E"}, {"file_name": "BI_screenshot_fight_2.png", "id": "1026969610404381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1026969617071047_4660140541847249058_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuJ8G5iS7g0Q7kNvwGlWS2V&_nc_oc=AdpQbwFdcUjynaV6kwmy3LsjG3BeBNvaFrO4oU0Ip2mEBR3epWQpxHnv-prsWtrDySc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3tSFZDl_nfUkEMbzBRj0oBFP3wTA6u__T94V3MBknsg&oe=6AF89297"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_BI_Landscape_2560x1440.png", "id": "2075375799769630", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/756589809_2075375803102963_7571613619424339494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qoeW2qbw68Q7kNvwE825nm&_nc_oc=Adoj0lH9fFwY6iMQF8hah9cnZjBtI9UMLY51rs8rhMRIiFtsGiDgcXKkQC0Fb3X4GQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrgHI-flE27AYIDASzvqK8YPi52AM5hFA94ROUEXw_JA&oe=6AF8A0E6"}, "display_name": "Bad Inmate", "keywords": ["Prison", "Escape", "Physics", "Survival", "Ragdoll"], "long_description": "\ud83d\udd12 **Bad Inmate** is a physics-driven VR prison sandbox where everyday life can turn into chaos at any moment. Explore the block, mess with inmates, provoke guards, and interact with almost anything around you.\n\n\ud83e\udd44 Grab, throw, hide, combine, and use everyday objects in unexpected ways. Turn prison junk into tools, weapons, or part of your next bad idea.\n\n\ud83d\udc4a Meet inmates and guards with different personalities. Make friends, start trouble, pick fights, work out, play basketball, or simply see how much chaos you can cause.\n\n\ud83d\ude08 **Born to Cause Trouble**\n\nYou\u2019re not a model prisoner. Break the rules, annoy the guards, and turn prison life into your playground.\n\n{1414726020241045}\n\n\ud83e\uddf1 **Everything Is Grabbable**\n\nGrab, throw, hide, or weaponize almost anything around you. If you can reach it, you can probably use it.\n\n{953466584009693}\n\n\ud83e\udd1d **Meet the Inmates**\n\nPrison is full of personalities. Some will help, some will hate you, and some just want trouble. Who knows who\u2019ll become your best friend?\n\n{1744371366794261}\n\n**Gameplay features:**\n\n\ud83e\uddf1 **Physics sandbox** \u2013 grab, throw, hide, and combine objects.\n\n\ud83d\udc4a **Inmates & guards** \u2013 befriend, prank, fight, or annoy them.\n\n\ud83c\udfc0 **Prison activities** \u2013 explore, exercise, play, and cause trouble.\n\n\ud83d\ude08 **Freedom to experiment** \u2013 solve situations your own way.\n", "short_description": "\ud83d\udd12 Bad Inmate is a physics-driven VR prison sandbox where everyday life can turn into chaos at any moment. Explore the block, mess with inmates, provoke guards, and interact with almost anything around you.\n\n\ud83e\udd44 Grab, throw, hide, combine, and use everyday objects in unexpected ways. Turn prison junk into tools, weapons, or part of your next bad idea.\n"}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28615651944756988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1883993432577871_2344108996438602843_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF7W5YLZI9IQ7kNvwEKqc8G&_nc_oc=AdqnDv2Va6i8Rev0MmINa6-iUcztJIbjeAOmcLjUiHpvdfURHyYLzKDhSo8w9hyIkkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNV_xGfxA8NuA2vzYsnDydXru47JoeuRsT6P7z0rSYbA&oe=6AF8ABFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bad Inmate", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Ac
s://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596061819_1413892130114078_7364828435886064787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDuekg8L6qwQ7kNvwFyMsJK&_nc_oc=AdoS9iOsNaWiNdKZr5uX5OOeyKOmQpYi3g73yf0bQR9CsNGHn7uKMQYw_onAm1YqQ64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsp4210A8L4gI8tASTYxtpT_mcSIjrLzxAtfvsIvImjw&oe=6AE0CAD5"}, {"file_name": "BI_screenshot_Hannibal_4.png", "id": "1706494267545244", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596061819_1706494270878577_4746925174171756761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vzJP6DXZ_MQ7kNvwHnXgOn&_nc_oc=AdrQ9182KJHYZoKZ9KCxqUio2qVDl5ec-kfbS0szcHJ5h8RSo2xGABxT3hm6DF5N6RA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwFJT-k7ZAOPPRZeyoKucAtOecw4Ku5-_u_zXsaoitqw&oe=6AE0C19B"}, {"file_name": "BI_screenshot_Lab_3.png", "id": "2156150281967863", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595119480_2156150288634529_7381117575835195723_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbLzAgyO7-MQ7kNvwEXinXQ&_nc_oc=AdqjGHkYpTsenwbEbgUFjuBIDTYGVCsxtajn6b09ZZj_awc6JxCRxumJHjho8xv_axQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7hLWFznlDIvj4PoGMm3AUqotRtliX1Yrg49YsBfAMZQ&oe=6AE0C70E"}, {"file_name": "BI_screenshot_fight_2.png", "id": "1026969610404381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604385997_1026969617071047_4660140541847249058_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDtZngUJp0EQ7kNvwEsFueQ&_nc_oc=Adpl3ymnPwrfFXQGlYAZ1rgfTqNf2mGuS-z-TbPWv9Y_0K7GU78j5IUS_zo5gqhnNgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk5nLYj0vlklV1bvN5K24Es1-0smxQUq0-N-qu_1ndrw&oe=6AE09F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_BI_Landscape_2560x1440.png", "id": "2075375799769630", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/756589809_2075375803102963_7571613619424339494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYauQyY0DUMQ7kNvwHoGP9Z&_nc_oc=AdoKtAsCp2KfUlAuQPrYQJyiXIxsDFfMw_W0W4LiPeLbJ66wwOHhmmR8hpc4ivu7Rw8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO79yb1VoXP6RxmyDhPIsscrLL_kiJmlFbei2sFvWt4zw&oe=6AE0ADA6"}, "display_name": "Bad Inmate", "keywords": ["Prison", "Escape", "Physics", "Survival", "Ragdoll"], "long_description": "\ud83d\udd12 **Bad Inmate** is a physics-driven VR prison sandbox where everyday life can turn into chaos at any moment. Explore the block, mess with inmates, provoke guards, and interact with almost anything around you.\n\n\ud83e\udd44 Grab, throw, hide, combine, and use everyday objects in unexpected ways. Turn prison junk into tools, weapons, or part of your next bad idea.\n\n\ud83d\udc4a Meet inmates and guards with different personalities. Make friends, start trouble, pick fights, work out, play basketball, or simply see how much chaos you can cause.\n\n\ud83d\ude08 **Born to Cause Trouble**\n\nYou\u2019re not a model prisoner. Break the rules, annoy the guards, and turn prison life into your playground.\n\n{1414726020241045}\n\n\ud83e\uddf1 **Everything Is Grabbable**\n\nGrab, throw, hide, or weaponize almost anything around you. If you can reach it, you can probably use it.\n\n{953466584009693}\n\n\ud83e\udd1d **Meet the Inmates**\n\nPrison is full of personalities. Some will help, some will hate you, and some just want trouble. Who knows who\u2019ll become your best friend?\n\n{1744371366794261}\n\n**Gameplay features:**\n\n\ud83e\uddf1 **Physics sandbox** \u2013 grab, throw, hide, and combine objects.\n\n\ud83d\udc4a **Inmates & guards** \u2013 befriend, prank, fight, or annoy them.\n\n\ud83c\udfc0 **Prison activities** \u2013 explore, exercise, play, and cause trouble.\n\n\ud83d\ude08 **Freedom to experiment** \u2013 solve situations your own way.\n", "short_description": "\ud83d\udd12 Bad Inmate is a physics-driven VR prison sandbox where everyday life can turn into chaos at any moment. Explore the block, mess with inmates, provoke guards, and interact with almost anything around you.\n\n\ud83e\udd44 Grab, throw, hide, combine, and use everyday objects in unexpected ways. Turn prison junk into tools, weapons, or part of your next bad idea.\n"}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28615651944756988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830441_1883993432577871_2344108996438602843_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Spflyfs8j0kQ7kNvwGcEe_L&_nc_oc=Ado7eA2meVv5KnIkitaXyZ4nSsLHzWEqRvIu_fjxRQbCwb7HQ0teTBv_W6oaqSFEeBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq2OQt_4HgKWyVFhWPR0WcfePjOowH_3JwQ1ww82mZQg&oe=6AE0B8BF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bad Inmate", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Acti
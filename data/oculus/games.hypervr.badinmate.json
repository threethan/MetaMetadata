tps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_1413892130114078_7364828435886064787_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AJ65T1ULbMQ7kNvwGHo4fZ&_nc_oc=AdpsWIlzLSH_K5-r4pElIGPyD6l01R6nE9vRyu2igLk07a96TWwExJQ4IjhThidbUcg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8bMsWqHTdT5ty8Nw2EVKwMF1q_sIEhHQXcqdERH7dEw&oe=6AF33FD5"}, {"file_name": "BI_screenshot_Hannibal_4.png", "id": "1706494267545244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_1706494270878577_4746925174171756761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sbYSnOiWjsQ7kNvwF1YSR7&_nc_oc=AdoUvmH6ZgT9QPmjiqxE8CHTTvdySUZNjDVFSKqWzU9iMz7eXbqTzvkjyV62FfZZ8nE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxbXSj22t01t3lfJ82Xd6qL_28-tSUms7SNpxOXMtt3A&oe=6AF3369B"}, {"file_name": "BI_screenshot_Lab_3.png", "id": "2156150281967863", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_2156150288634529_7381117575835195723_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaGNMCF7XBcQ7kNvwH6oBAX&_nc_oc=AdpL4tYMn_2W6scZ2ppbngpU7gLEZGC4DdP062Qyhqt1Gg3f1LxYHK4Ie8utYIx7fc4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFCnIWmWLgj_9DCkYwPmXSeWLXLC97kiU-IoI-nb5oGg&oe=6AF33C0E"}, {"file_name": "BI_screenshot_fight_2.png", "id": "1026969610404381", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604385997_1026969617071047_4660140541847249058_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5Waf8pRPOAQ7kNvwF7xEYm&_nc_oc=Adpvno_hsoRLztL2GFr3bwvTh5tndRI8Xf1trInvEj8oG4u-S4YDcXxmXMIs8D8hBJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhatE9MfNK4Qz4a82p40aMXOGPblwHlf1J8cbgtpfQyg&oe=6AF34C97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_BI_Landscape_2560x1440.png", "id": "2075375799769630", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/756589809_2075375803102963_7571613619424339494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_VC91uhgR8Q7kNvwGD9d16&_nc_oc=AdroPBAzn1pmTzMrYQwXttvHU5gEhfSrIBIpFTRpOG1La4ZcqukmTTpohH4MQr8rGQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr484OIr8gtFSNaBCSSAUH7yULK0jPTxP8qR1RTzT9NQ&oe=6AF35AE6"}, "display_name": "Bad Inmate", "keywords": ["Prison", "Escape", "Physics", "Survival", "Ragdoll"], "long_description": "\ud83d\udd12 **Bad Inmate** is a physics-driven VR prison sandbox where everyday life can turn into chaos at any moment. Explore the block, mess with inmates, provoke guards, and interact with almost anything around you.\n\n\ud83e\udd44 Grab, throw, hide, combine, and use everyday objects in unexpected ways. Turn prison junk into tools, weapons, or part of your next bad idea.\n\n\ud83d\udc4a Meet inmates and guards with different personalities. Make friends, start trouble, pick fights, work out, play basketball, or simply see how much chaos you can cause.\n\n\ud83d\ude08 **Born to Cause Trouble**\n\nYou\u2019re not a model prisoner. Break the rules, annoy the guards, and turn prison life into your playground.\n\n{1414726020241045}\n\n\ud83e\uddf1 **Everything Is Grabbable**\n\nGrab, throw, hide, or weaponize almost anything around you. If you can reach it, you can probably use it.\n\n{953466584009693}\n\n\ud83e\udd1d **Meet the Inmates**\n\nPrison is full of personalities. Some will help, some will hate you, and some just want trouble. Who knows who\u2019ll become your best friend?\n\n{1744371366794261}\n\n**Gameplay features:**\n\n\ud83e\uddf1 **Physics sandbox** \u2013 grab, throw, hide, and combine objects.\n\n\ud83d\udc4a **Inmates & guards** \u2013 befriend, prank, fight, or annoy them.\n\n\ud83c\udfc0 **Prison activities** \u2013 explore, exercise, play, and cause trouble.\n\n\ud83d\ude08 **Freedom to experiment** \u2013 solve situations your own way.\n", "short_description": "\ud83d\udd12 Bad Inmate is a physics-driven VR prison sandbox where everyday life can turn into chaos at any moment. Explore the block, mess with inmates, provoke guards, and interact with almost anything around you.\n\n\ud83e\udd44 Grab, throw, hide, combine, and use everyday objects in unexpected ways. Turn prison junk into tools, weapons, or part of your next bad idea.\n"}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28615651944756988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1883993432577871_2344108996438602843_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9ICkAMoZwAQ7kNvwFIKceK&_nc_oc=AdoT5WE68aaHp0vcyRugVR8FHF36KsAGfJiBUD5ZetJ2-MaBIO3R-hAz1RMtuxFtCO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEwctMevCu3t4iViUtDg4vC8VVzUJdQIA2en3-qJtQTg&oe=6AF32DBF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bad Inmate", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Ac
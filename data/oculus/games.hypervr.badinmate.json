=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8udB15aYd8Q7kNvwETsXPr&_nc_oc=AdpW-5QANAq4kB3l5XM4v7WDFTeKnzw6WpW8UvjHUKkR9R8ckUHQvLA8PfMvb7I_CnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU-an2xxsqbazsVPoQdIRjV8d0cK_7_56Dj2ORq5MruxA&oe=6B105B1F"}]}, "id": "2231559814327789", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "2544959449259140", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623370_2544959452592473_7146691829434857088_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbIbSP7w3tQQ7kNvwG6AlZh&_nc_oc=AdrcKza7mkPO-eb0LVPUeLkFv928l8MlbiGu4seQ3M8YA7GNEys6wxO1fASY-eXLNy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0RUgfRmGZvZsCHtVjA_r2j4RIL0LhJIOfwZN0L_w1sw&oe=6B105060"}, {"file_name": "2.png", "id": "1477809830494564", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620444_1477809833827897_6345584269552208259_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSyCFyfFljgQ7kNvwGVHnhB&_nc_oc=Adqtv2F4lskMKpo_bBzjW2mN7r77GpilnHjB2KP8mYNc2E3FdGPaRak2kVnZzQzlRIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVXXUlXktTRqA2o0worDvLk7oS56ph2ioTTkPHAC1_fg&oe=6B106952"}, {"file_name": "3.png", "id": "1318495850257819", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673522158_1318495856924485_1814192203449584801_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16kj2FUXPf8Q7kNvwGAq-B5&_nc_oc=Ado6b6SfJGrmMOMrqgiqVyqYn0Mvkt8fSt4hWckdpkEeGDR027chVGNFjUqXMz2Lo9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWvE5hnsImGW-ZmxNMbPIElKz6lwBBBxa8vhH_3VaRwUg&oe=6B103B82"}, {"file_name": "4.png", "id": "3427205800779142", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604302364_3427205804112475_6700278314506689219_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57yJXIVxEwQQ7kNvwGMqEA3&_nc_oc=AdpVWnBtQcJewfCPx8OqjrJs4u9FzHJq3wZiwPwzHcyoFfVofy_DSrwSJLhhR95TdOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVybUGrKKIVRbkWedFMsgWH5LLn_7Tf3KZXzFqm6UohCw&oe=6B105D49"}, {"file_name": "5.png", "id": "1731245657900098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1731245664566764_4671593085496796373_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uM59NdKqt24Q7kNvwHlR8yD&_nc_oc=AdomMXDk0tOuhHSL0Qoqha1Qqv21Vf6cy2-yl1UfJsvhQ7JbbF57nWgxADN4B2_NcbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVO6PTgeY-sv8Ii-anY3E_oUdPvF1S7gbRBkV1iXNHFhw&oe=6B105EB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BI_Landscape_2560x1440.png", "id": "1762390601594031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604275479_1762390604927364_1943972809123641683_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00ke6RAixGkQ7kNvwGnZZcK&_nc_oc=AdqMs-5gAm4YSTLlVDsDJu2tGCC0gv3gXnQ7RDm-urB5bKlaGuA8_ijnviezBleKSVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZ8sP1CWETLELotoeIQPq5cxU12XdCFOPAjHmmQd68IA&oe=6B104EC9"}, "display_name": "Bad Inmate", "keywords": ["Prison", "Escape", "Physics", "Survival", "Stealth"], "long_description": "**Every escape attempt is a new chance to do something smarter, funnier, or way more questionable.**\n\nGrab a spoon and start digging. Use a dumbbell like it was definitely part of the plan. Steal a key, unlock a cell, trick a guard, scan another prisoner\u2019s face, or throw lunch at someone who probably deserved it.\n\nThis is a physics-driven VR sandbox where almost everything can be picked up, used, tossed, hidden, or turned into part of your escape plan. Explore the prison, find strange items, complete weird favors for your mysterious wall buddy, and discover all the ways your \u201cperfect plan\u201d can fall apart.\n\nMaybe you sneak out like a genius.\nMaybe you start a prison-wide mess.\nMaybe a security camera spots you and sends you right back to your cell.\n\nNo big deal. Try again. Make a new plan. Make a worse plan. See what happens.\n\n**Escape, prank, fight, throw, crawl, and improvise your way through the dumbest prison break VR has ever seen.**", "short_description": "You\u2019re stuck in prison\u2026 and the guy in the wall says he can help. Bad news: his plans are weird. Sneak past guards, grab random stuff, prank inmates, throw food, steal keys, crawl through holes, and try to escape in the most ridiculous VR prison sandbox ever."}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/badinmate/", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27059251600397038"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1621568179182566"}, {"status": "PUBLISHED", "id": "1392919413003708"}]}, "baseline_offer": {"id": "1392919413003708"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1621568179182566"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_
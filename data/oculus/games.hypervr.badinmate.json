cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yI1HVMw-bsIQ7kNvwHKd-Fu&_nc_oc=AdpuQDIGDurO_klmaTo51UnNWZCmXmlDIDK1LiwEcoykxDFFlrpHPwL_l-jGuz-HZi4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvUsJRf2jjGQZYyrVAzhCwIXODkGYBSH4Ik9s7CEDJDw&oe=6B09B617"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_BI_Landscape_2560x1440.png", "id": "2075375799769630", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/756589809_2075375803102963_7571613619424339494_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKeAxYUf10EQ7kNvwFJaPcP&_nc_oc=AdrOyi-2BufnwJaixRT4B6lgQHErcvd9Wx6_E-H_DgqlzuHjcWtFse24wDV46wElNH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRx4B_yYHOo1aQOzjz5pCAdgzY-6CAVEQOucIr9k9lFA&oe=6B09C466"}, "display_name": "Bad Inmate", "keywords": ["Prison", "Escape", "Physics", "Survival", "Ragdoll"], "long_description": "\ud83d\udd12 **Bad Inmate** is a physics-driven VR prison sandbox where everyday life can turn into chaos at any moment. Explore the block, mess with inmates, provoke guards, and interact with almost anything around you.\n\n\ud83e\udd44 Grab, throw, hide, combine, and use everyday objects in unexpected ways. Turn prison junk into tools, weapons, or part of your next bad idea.\n\n\ud83d\udc4a Meet inmates and guards with different personalities. Make friends, start trouble, pick fights, work out, play basketball, or simply see how much chaos you can cause.\n\n\ud83d\ude08 **Born to Cause Trouble**\n\nYou\u2019re not a model prisoner. Break the rules, annoy the guards, and turn prison life into your playground.\n\n{1414726020241045}\n\n\ud83e\uddf1 **Everything Is Grabbable**\n\nGrab, throw, hide, or weaponize almost anything around you. If you can reach it, you can probably use it.\n\n{953466584009693}\n\n\ud83e\udd1d **Meet the Inmates**\n\nPrison is full of personalities. Some will help, some will hate you, and some just want trouble. Who knows who\u2019ll become your best friend?\n\n{1744371366794261}\n\n**Gameplay features:**\n\n\ud83e\uddf1 **Physics sandbox** \u2013 grab, throw, hide, and combine objects.\n\n\ud83d\udc4a **Inmates & guards** \u2013 befriend, prank, fight, or annoy them.\n\n\ud83c\udfc0 **Prison activities** \u2013 explore, exercise, play, and cause trouble.\n\n\ud83d\ude08 **Freedom to experiment** \u2013 solve situations your own way.\n", "short_description": "\ud83d\udd12 Bad Inmate is a physics-driven VR prison sandbox where everyday life can turn into chaos at any moment. Explore the block, mess with inmates, provoke guards, and interact with almost anything around you.\n\n\ud83e\udd44 Grab, throw, hide, combine, and use everyday objects in unexpected ways. Turn prison junk into tools, weapons, or part of your next bad idea.\n"}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28615651944756988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830441_1883993432577871_2344108996438602843_
0HeroArt.png", "id": "507038832250273", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392170_507038835583606_4637086770027637821_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvblCTPksz8Q7kNvwH9Josm&_nc_oc=AdnKKDRTZ04yi27sG7XUNfk0JhmBPjKVpWyDSemt1LHXr8RD96bBD8KSa4eAs44pXh8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQ35gKja6F4ANhC4qwDBfZAIQ8C5U2_9HTj2s0r4u6GA&oe=69BD4492"}]}, "id": "1170004141484710", "locale": "en_US", "screenshots": [{"file_name": "ScreenshotCupboardSized.png", "id": "1349703192702854", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393372_1349703196036187_8028840107221953632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUgwsyLBl0UQ7kNvwHwn5YG&_nc_oc=AdmXZuYgck2t-S-I7pMaBbePy2gr9uP6pyhMeDVishnt8SCRQIHF4LQOmZw-WCZTHiI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjvG7JIP-4Iok8SWnYFzDw4ooq3vC6ynsY9WCZ0-rbiw&oe=69BD47D0"}, {"file_name": "ScreenshotClueSized.png", "id": "984725870393261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391964_984725873726594_4504422850638796549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIGQmTfoZ0EQ7kNvwFH4wfV&_nc_oc=Adm3sUggIpwHewo-iXa79i4GxaZ707xHoW6_KWUIurRk-YXQveo78y7ZYawI0PXkJyE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxY4KUTvwCrz4Ns4DIvgoqBZuUPn4SizP7-CyyxdM3rCQ&oe=69BD36AE"}, {"file_name": "ScreenshotKeypadSized.png", "id": "999502001588840", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392129_999502004922173_2749134177103022935_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dC8CFNHUBwMQ7kNvwGNhB88&_nc_oc=Adlp73_FmFUyBmnD9qgBWIGckZK2ahXvzzXyrL5AyOR8gpyn7KKpY0_TL1lG1Fvcd40&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpWcxQxZfTLYCTWomyo4OKrjxpILoHEECF1_XBvM4BXA&oe=69BD4073"}, {"file_name": "ScreenshotElevatorSized.png", "id": "1173894400317186", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391950_1173894403650519_4001765275338216533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrUdQxIsNvgQ7kNvwEUM2g4&_nc_oc=AdniE2W7lC9s0d5LPU-EGnOP8nkVQankZZvFI7_olKvf73BPi80Ab2VUHDHn2AF6MvI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzSpViryT8dbLtvzAUr9bugzP7MUIKSqYOtd5cNxj0-A&oe=69BD4E6F"}, {"file_name": "ScreenshotTVSized.png", "id": "630991776467915", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393822_630991779801248_4032608716738056846_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ui4xFRBZoYQ7kNvwFujuPt&_nc_oc=AdktQkZUVkbtfVDeUaBEOVJBOu_qeXJCBfwUAgeYe7gKLWC-WZKJy0dWpSg0WTOEZN4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy6q0h4aMUI8uj7VX-mDW4FUO4Ndm0gkuAydtJuMRghnw&oe=69BD460C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2650x1440HeroArt.png", "id": "627736273371577", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393406_627736276704910_8332545983004368152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsfyzP-LXJ8Q7kNvwEg_CtO&_nc_oc=AdlgWJ_59Bn8dGzY_ykPaRRTYIhlFESP_u6Mxnsp9qMENXbZdwd5u2QledjDM1Pj5X0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1iEiLcRnQfKdMpIol96ck-J_tkhZvL8_mk2UdFmp6LQ&oe=69BD4E3D"}, "display_name": "The Doctors Room", "keywords": ["Escape", "Horror", "Experience", "Room", "demo"], "long_description": "The Ultimate Mixed Reality Demo for Quest 2 and above. The Doctors Room is the perfect spooky but not-too-spooky puzzle game where you must search The Doctors Room for the passcode to return to the ground floor! Your space will be transformed as a mysterious elevator appears in your room, taking you down to The Doctors Office.\n\nVenture down an elevator to find the mysterious abandoned Doctors Room, where you will be equipped only with a flashlight in this eerie environment.\n\nNext Gen Mixed Reality Technology - Utilising Mixed Reality with hand and gesture tracking technology to create the perfect first time user experience.\n\nEarly Access - The Doctors Room is in early access with this singular room experience. We plan to build out and refine these experiences in addition to adding more based on community feedback! Thank you for the support!\n\nHealth and Safety Warning - The Doctors Office MR contains content which some users may find frightening or intense. Users should refer to Safety Guidelines to limit the risk of serious injury or harm.", "short_description": "Uncover an eerie doctors room in your basement and hunt for the passcode to restart the elevator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFxqhzIESNGlQTC7mfK-44SrYmv-B1Qo76RfIwetFtQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://sites.google.com/view/dylanvanbeekportfolio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9509611189084464"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "607718249030353"}, {"status": "PUBLISHED", "id": "1985262588989331"}, {"status": "PUBLISHED", "id": "1061891169092708"}, {"status": "PENDING", "id": "1812315499711615"}]}, "baseline_offer": {"id": "1061891169092708"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISH
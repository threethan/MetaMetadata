gi7sU-5u5tsyXBhEEPILtaoP265bxVDCVHmdppb2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWFrtT9AF9oFnMoUz-n3-m9fIePAISPWS3T3pPswH4Ng&oe=6AE4BEEE"}, {"file_name": "ScreenshotElevatorSized.png", "id": "1173894400317186", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391950_1173894403650519_4001765275338216533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw_Pinhq8hUQ7kNvwG3SwMJ&_nc_oc=AdpDyJ_JfZku6JjShkNM5G9-jnBAIHa1TYy42_IGobbumugeWm8gCfMzJ82cJBDkuVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN77MxbGqkJdFoFjjNcM4XEDDC8I0fMMTphjY4eGSjilA&oe=6AE49E6F"}, {"file_name": "ScreenshotTVSized.png", "id": "630991776467915", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393822_630991779801248_4032608716738056846_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PGSnZ7orr8Q7kNvwG_iq8i&_nc_oc=Adrzun55wfD4an_lVSLtBTTfKxDL01HALQodGyMK3RVeDRMbgbEwXmLjSx0ql3Cv7ag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPDFPZFaxXCJCLLhn3jYBwwx6Rqytbp-tNQXEfsco26g&oe=6AE4960C"}, {"file_name": "ScreenshotKeypadSized.png", "id": "999502001588840", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392129_999502004922173_2749134177103022935_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmBt_FEIpkYQ7kNvwF_2EW5&_nc_oc=AdpuHyDbU4phAPo_WJU97KOvIHdCFzGhAIIecABDn5ty2V1ecm3INReVmumDhJCsh28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8oW3XY4uqVC3kgr3e2JYpPNud1FPIHM5dFhCPQqHdkg&oe=6AE49073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2650x1440HeroArt.png", "id": "627736273371577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393406_627736276704910_8332545983004368152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1rJdv5j338Q7kNvwHusBaO&_nc_oc=AdqIHLfw7972hUJukQZXbDgeL8bz-tPicK5nQkJRh4F3kuWuL8XAuoavAQ9a9N7aTDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMozxBR5imTtGQbYiuguRW2GeL85sqMiMpLNmt7f8xwMw&oe=6AE49E3D"}, "display_name": "The Doctor's Room", "keywords": ["Escape", "Horror", "Experience", "Room", "demo"], "long_description": "**The Ultimate Mixed Reality Demo for Quest 2 and above.** The Doctors Room is the perfect spooky but not-too-spooky puzzle game where you must search The Doctors Room for the passcode to return to the ground floor! Your space will be transformed as a mysterious elevator appears in your room, taking you down to The Doctors Office.\n\n{1034648342098437}\n\n\ud83d\udc7bVenture down an elevator to find the mysterious abandoned Doctors Room, where you will be equipped only with a flashlight in this eerie environment.\ud83d\udc7b\n\n\n\n# \ud83e\udd16Next Gen Mixed Reality Technology\ud83e\udd16\nUtilising Mixed Reality with hand and gesture tracking technology to create the perfect first time user experience.\n\n{1417822122899102}\n\n# \ud83e\uddeaEarly Access \ud83e\uddea\nThe Doctors Room is in early access with this singular room experience. We plan to build out and refine these experiences in addition to adding more based on community feedback! Thank you for the support!\n\n{654867464081422}\n\n# \u26a0Health and Safety Warning\u26a0\nThe Doctors Office MR contains content which some users may find frightening or intense. Users should refer to Safety Guidelines to limit the risk of serious injury or harm.\n\n\n", "short_description": "Uncover an eerie doctors room in your basement and hunt for the passcode to restart the elevator.  Mixed reality, hand tracking and controller support!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFxqhzIESNGlQTC7mfK-44SrYmv-B1Qo76RfIwetFtQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://sites.google.com/view/dylanvanbeekportfolio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359
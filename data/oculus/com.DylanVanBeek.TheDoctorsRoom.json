8DOSzC0GtqReDPD0zU50Lpq42eFg&oe=6AC66C6E"}, {"file_name": "ScreenshotElevatorSized.png", "id": "1173894400317186", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_1173894403650519_4001765275338216533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InlFvMS0MqIQ7kNvwEYolJm&_nc_oc=Adqh1r2-pSllFOkp5a0FZYe_85pCiMkeiV4qGpew4e-Wo0nr0ncinqDWFkEGvt5Zw4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJMuSlFS-4MbPuFi3Jmil3Y2U_jW-5md2BRBXCAADGUg&oe=6AC64BEF"}, {"file_name": "ScreenshotTVSized.png", "id": "630991776467915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393822_630991779801248_4032608716738056846_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSphB1GxtScQ7kNvwEUEkLY&_nc_oc=AdoFrwqjiLqVUTyYiHol0tVs8iyCG2eiokQTP0EhiX8krxHNgi_T6GQV6CD8LUXioQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd8sektVtXyaFDWDjy9YVbzjpCUEFwOjMt3QA6DRfG3w&oe=6AC6438C"}, {"file_name": "ScreenshotKeypadSized.png", "id": "999502001588840", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392129_999502004922173_2749134177103022935_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogX4VDqNKGYQ7kNvwEW-kp6&_nc_oc=Adr5VMpSFEA8iazqUb5z23CV-FVecDr-wrKSr4CLu7zC2AIWx4uLm1_0sLeX-j05QgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh7hPGSajloBjhfevZoxfo8wI0QHg889h9ImhVWrfXWQ&oe=6AC67633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2650x1440HeroArt.png", "id": "627736273371577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393406_627736276704910_8332545983004368152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpPjE2MNkj4Q7kNvwEeX9rF&_nc_oc=Adqhmg4p081V2lD7f0cdsa8FVeuPqurWXRizUy7CQXUxkZRyPJr-4NYgPxWNX0k6hlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUV5G20mZQHPSCwfWP7mfnXyFEdDDBbM278QyXBffgdg&oe=6AC64BBD"}, "display_name": "The Doctor's Room", "keywords": ["Escape", "Horror", "Experience", "Room", "demo"], "long_description": "**The Ultimate Mixed Reality Demo for Quest 2 and above.** The Doctors Room is the perfect spooky but not-too-spooky puzzle game where you must search The Doctors Room for the passcode to return to the ground floor! Your space will be transformed as a mysterious elevator appears in your room, taking you down to The Doctors Office.\n\n{1034648342098437}\n\n\ud83d\udc7bVenture down an elevator to find the mysterious abandoned Doctors Room, where you will be equipped only with a flashlight in this eerie environment.\ud83d\udc7b\n\n\n\n# \ud83e\udd16Next Gen Mixed Reality Technology\ud83e\udd16\nUtilising Mixed Reality with hand and gesture tracking technology to create the perfect first time user experience.\n\n{1417822122899102}\n\n# \ud83e\uddeaEarly Access \ud83e\uddea\nThe Doctors Room is in early access with this singular room experience. We plan to build out and refine these experiences in addition to adding more based on community feedback! Thank you for the support!\n\n{654867464081422}\n\n# \u26a0Health and Safety Warning\u26a0\nThe Doctors Office MR contains content which some users may find frightening or intense. Users should refer to Safety Guidelines to limit the risk of serious injury or harm.\n\n\n", "short_description": "Uncover an eerie doctors room in your basement and hunt for the passcode to restart the elevator.  Mixed reality, hand tracking and controller support!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFxqhzIESNGlQTC7mfK-44SrYmv-B1Qo76RfIwetFtQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://sites.google.com/view/dylanvanbeekportfolio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUI
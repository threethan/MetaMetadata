NvwFuKcAR&_nc_oc=AdmgJ2T5oKE15CjAP3pu6GSnAuYtnepqHCuMzR7YdRBQaLuxFfN7NcM0xqUQJp8eulM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft7RaUdgfsqZMbmXGzjmvjEA8GBm9W9JopaqnW8Qde9hQ&oe=69A19EEF"}, {"file_name": "ScreenshotTVSized.png", "id": "630991776467915", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393822_630991779801248_4032608716738056846_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tY1xe1yUFp4Q7kNvwGckew4&_nc_oc=Adlj-_cit9eByY0KofyUIhrHDcX-UkGlL6pGSlzmcV_DD73Ayr8wszFzoaVMCJPExjM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuUXdxaGCyAQGOg0sE5VKAxzWY0Plg7ehmTei5GddDcvw&oe=69A1968C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2650x1440HeroArt.png", "id": "627736273371577", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393406_627736276704910_8332545983004368152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qbyklOwClAQ7kNvwEH1Dos&_nc_oc=Adn8KmDKNRiRq04t1oLQae2y2a0NDEKSrAagf-cy6weS4q6CBlCrBWinDPbvr-uH7GY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afuj94_YMT0Fym0AExjrq7neckCb1aUzsnuv_gfl-iiXaw&oe=69A19EBD"}, "display_name": "The Doctors Room", "keywords": ["Escape", "Horror", "Experience", "Room", "demo"], "long_description": "The Ultimate Mixed Reality Demo for Quest 2 and above. The Doctors Room is the perfect spooky but not-too-spooky puzzle game where you must search The Doctors Room for the passcode to return to the ground floor! Your space will be transformed as a mysterious elevator appears in your room, taking you down to The Doctors Office.\n\nVenture down an elevator to find the mysterious abandoned Doctors Room, where you will be equipped only with a flashlight in this eerie environment.\n\nNext Gen Mixed Reality Technology - Utilising Mixed Reality with hand and gesture tracking technology to create the perfect first time user experience.\n\nEarly Access - The Doctors Room is in early access with this singular room experience. We plan to build out and refine these experiences in addition to adding more based on community feedback! Thank you for the support!\n\nHealth and Safety Warning - The Doctors Office MR contains content which some users may find frightening or intense. Users should refer to Safety Guidelines to limit the risk of serious injury or harm.", "short_description": "Uncover an eerie doctors room in your basement and hunt for the passcode to restart the elevator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFxqhzIESNGlQTC7mfK-44SrYmv-B1Qo76RfIwetFtQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://sites.google.com/view/dylanvanbeekportfolio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9509611189084464"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "607718249030353"}, {"status": "PUBLISHED", "id": "1985262588989331"}, {"status": "PUBLISHED", "id": "1061891169092708"}, {"status": "PENDING", "id": "1812315499711615"}]}, "baseline_offer": {"id": "1061891169092708"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "607718249030353"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary
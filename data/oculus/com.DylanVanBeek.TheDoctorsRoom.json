h0sxNnObzRWHNE9akeDPwS0Xv5Qg&oe=6AC51AEE"}, {"file_name": "ScreenshotElevatorSized.png", "id": "1173894400317186", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391950_1173894403650519_4001765275338216533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCK4AkE2EW8Q7kNvwF1emVv&_nc_oc=AdpH37oR8acZnPch3pK2alayo9fCw2anuEjQ36O9JDUZZban1luwC2eI_t-THja3bCM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVi9gOC-g8J8oUdRxCZ6qiMDetphHvqQuS3MdDTI4WEQ&oe=6AC4FA6F"}, {"file_name": "ScreenshotTVSized.png", "id": "630991776467915", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393822_630991779801248_4032608716738056846_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q79dChQEAEQQ7kNvwEHFbyi&_nc_oc=AdoGnFaTYV0AaNH60V7Zw5iyadQR_JoksG8AUHpuYqUgfpFsqLin6WiGPh0pvB2UrvI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9GffhGrwVjWrk9_7zy43Dd3vRCz_tUw5VzM9941wNpQ&oe=6AC4F20C"}, {"file_name": "ScreenshotKeypadSized.png", "id": "999502001588840", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392129_999502004922173_2749134177103022935_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogX4VDqNKGYQ7kNvwGaaaU4&_nc_oc=Adry2jj4youcmlmyT29GtxcJqahSRfiIb1sTutaa7utJoI7xquxO7L36xAoN7MFhDbA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPghn001M76yThQnULJHp-SXXblliTwbqXjJLCUVZuLOg&oe=6AC524B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2650x1440HeroArt.png", "id": "627736273371577", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393406_627736276704910_8332545983004368152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpPjE2MNkj4Q7kNvwFvEM6A&_nc_oc=AdoOvczj24v3_FWq0pahF6BXJDFPX0lSRvMQNgStSm4NJw2CEXEouFMXu1Is1HRI1mE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP27Atajxy05Zll5hp86YNioq63lUl6lyTBQOZ0-1SlbQ&oe=6AC4FA3D"}, "display_name": "The Doctor's Room", "keywords": ["Escape", "Horror", "Experience", "Room", "demo"], "long_description": "**The Ultimate Mixed Reality Demo for Quest 2 and above.** The Doctors Room is the perfect spooky but not-too-spooky puzzle game where you must search The Doctors Room for the passcode to return to the ground floor! Your space will be transformed as a mysterious elevator appears in your room, taking you down to The Doctors Office.\n\n{1034648342098437}\n\n\ud83d\udc7bVenture down an elevator to find the mysterious abandoned Doctors Room, where you will be equipped only with a flashlight in this eerie environment.\ud83d\udc7b\n\n\n\n# \ud83e\udd16Next Gen Mixed Reality Technology\ud83e\udd16\nUtilising Mixed Reality with hand and gesture tracking technology to create the perfect first time user experience.\n\n{1417822122899102}\n\n# \ud83e\uddeaEarly Access \ud83e\uddea\nThe Doctors Room is in early access with this singular room experience. We plan to build out and refine these experiences in addition to adding more based on community feedback! Thank you for the support!\n\n{654867464081422}\n\n# \u26a0Health and Safety Warning\u26a0\nThe Doctors Office MR contains content which some users may find frightening or intense. Users should refer to Safety Guidelines to limit the risk of serious injury or harm.\n\n\n", "short_description": "Uncover an eerie doctors room in your basement and hunt for the passcode to restart the elevator.  Mixed reality, hand tracking and controller support!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFxqhzIESNGlQTC7mfK-44SrYmv-B1Qo76RfIwetFtQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://sites.google.com/view/dylanvanbeekportfolio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUI
1.oculuscdn.com/v/t64.5771-25/473391964_984725873726594_4504422850638796549_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X3iZvC_EKUQ7kNvwGuvEt0&_nc_oc=Adpl5VzQBq8P0m2_XfBfQMI5fyTazChl4ZFA-a89w71EqyJCrT5clU__RZ4RuXQQEzg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRct58DRb1boDu-TIuEuNZOGNMGbFDMqYgi2k2j8Rxajw&oe=6AFC79EE"}, {"file_name": "ScreenshotElevatorSized.png", "id": "1173894400317186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391950_1173894403650519_4001765275338216533_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGu4vKH14jEQ7kNvwHkWR4I&_nc_oc=AdrM-74YiRlCGExVv0F6Yx40lita25EFUTldgR7GywOI1yakMxzkiJNMaDRzoPMXp6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhpzKXjO2V88xrV-W-vgqYwr9dpGHnkHL8VBePSI-tnA&oe=6AFC91AF"}, {"file_name": "ScreenshotTVSized.png", "id": "630991776467915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393822_630991779801248_4032608716738056846_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CojeNn-ClQQ7kNvwFTuIQ1&_nc_oc=AdpI_DDnxBJ9RbrKgrstT62pFcPTEj2oWWRB4FZ7p4FjlKrjoTCozM6U-W_f6K9eZ0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr4KY75Aze1IQ71GesXa8iM7vyf8P1k_2KjpzISnPBRw&oe=6AFC894C"}, {"file_name": "ScreenshotKeypadSized.png", "id": "999502001588840", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392129_999502004922173_2749134177103022935_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVJjBGTydf8Q7kNvwFKd3Nb&_nc_oc=AdpJUNgfW_9RaN27WFxEggP7uAWpDOaLxGZJRDZQ4l2a5Ousy6TIeKlhNNQg9lsi9wE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQUff4Ps4nEbP7flSfXjKwj6SVarReuvSRwOUnuEcbEA&oe=6AFC83B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2650x1440HeroArt.png", "id": "627736273371577", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393406_627736276704910_8332545983004368152_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7R-xCTL_oIQ7kNvwFA3BPl&_nc_oc=AdpKYDfD-TgQOz7Hx-wlCdkW4FGyCUQb9Ln6cMZ6IBn_07P3RFQl1B1aMGSxOceZbOU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQIwvthRhydrz7UjM4WtZZilE8NgOnlIhnqeox9IBBFA&oe=6AFC917D"}, "display_name": "The Doctor's Room", "keywords": ["Escape", "Horror", "Experience", "Room", "demo"], "long_description": "**The Ultimate Mixed Reality Demo for Quest 2 and above.** The Doctors Room is the perfect spooky but not-too-spooky puzzle game where you must search The Doctors Room for the passcode to return to the ground floor! Your space will be transformed as a mysterious elevator appears in your room, taking you down to The Doctors Office.\n\n{1034648342098437}\n\n\ud83d\udc7bVenture down an elevator to find the mysterious abandoned Doctors Room, where you will be equipped only with a flashlight in this eerie environment.\ud83d\udc7b\n\n\n\n# \ud83e\udd16Next Gen Mixed Reality Technology\ud83e\udd16\nUtilising Mixed Reality with hand and gesture tracking technology to create the perfect first time user experience.\n\n{1417822122899102}\n\n# \ud83e\uddeaEarly Access \ud83e\uddea\nThe Doctors Room is in early access with this singular room experience. We plan to build out and refine these experiences in addition to adding more based on community feedback! Thank you for the support!\n\n{654867464081422}\n\n# \u26a0Health and Safety Warning\u26a0\nThe Doctors Office MR contains content which some users may find frightening or intense. Users should refer to Safety Guidelines to limit the risk of serious injury or harm.\n\n\n", "short_description": "Uncover an eerie doctors room in your basement and hunt for the passcode to restart the elevator.  Mixed reality, hand tracking and controller support!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFxqhzIESNGlQTC7mfK-44SrYmv-B1Qo76RfIwetFtQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://sites.google.com/view/dylanvanbeekportfolio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26050948824524106"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392301_935819991958680_2292686508072998707_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s2z76iRc74Q7kNvwFNnIWM&_nc_oc=AdqMCoP3AsUhCAzlQ-rUe26FMkR2PC1muJDgTiF-s-wlBzXbcvCXA5g5NZu2jzEq9bU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTuE84j5RH5drRwiR81gaa2QmTEa1o2H7CrVLtI_lE5w&oe=6AFC621B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Doctor's Room", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1756400400, "lastRevision": {"nodes": [{"id": "9505354002843516", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9505353972843519", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": 
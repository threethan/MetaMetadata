d6-1.oculuscdn.com/v/t64.5771-25/473391950_1173894403650519_4001765275338216533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul5_O2ZALTwQ7kNvwGu9w9D&_nc_oc=AdqoBF1YgAW1j0XYGLDshP-7k7YqQSGz205tn1BZh0mqyXWPbVqoDPSzKxq8MW67hfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TOZYUy1FyKP-LqZGQx6Pk-V9vUHhbaFhQKxdc_al73A&oe=69ECC46F"}, {"file_name": "ScreenshotTVSized.png", "id": "630991776467915", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393822_630991779801248_4032608716738056846_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wofetEk-tAwQ7kNvwEPjX1t&_nc_oc=AdrHZceBLJb3PutP5qULasAI8sBKbSUq1IPF3r2ZmuPatZd2ngr42ppkHOI4fsG6Etk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZgaCWhj7l1Ekgb3IFP9PXTVwbmr6y3Fjog7ZNVMMYtw&oe=69ECBC0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2650x1440HeroArt.png", "id": "627736273371577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393406_627736276704910_8332545983004368152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5EavNpBh40Q7kNvwHu3uuI&_nc_oc=Adp8UuPxGSgdcWRIpRCUHJMnKTE1uw0QjEjcRd5FHB8B786Ey-zLKpZVJBDKh5ypzoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jnnve2EQ4z4xw9r8EM049rcwAUNBaR-mKuVJpUsdDAg&oe=69ECC43D"}, "display_name": "The Doctors Room", "keywords": ["Escape", "Horror", "Experience", "Room", "demo"], "long_description": "The Ultimate Mixed Reality Demo for Quest 2 and above. The Doctors Room is the perfect spooky but not-too-spooky puzzle game where you must search The Doctors Room for the passcode to return to the ground floor! Your space will be transformed as a mysterious elevator appears in your room, taking you down to The Doctors Office.\n\nVenture down an elevator to find the mysterious abandoned Doctors Room, where you will be equipped only with a flashlight in this eerie environment.\n\nNext Gen Mixed Reality Technology - Utilising Mixed Reality with hand and gesture tracking technology to create the perfect first time user experience.\n\nEarly Access - The Doctors Room is in early access with this singular room experience. We plan to build out and refine these experiences in addition to adding more based on community feedback! Thank you for the support!\n\nHealth and Safety Warning - The Doctors Office MR contains content which some users may find frightening or intense. Users should refer to Safety Guidelines to limit the risk of serious injury or harm.", "short_description": "Uncover an eerie doctors room in your basement and hunt for the passcode to restart the elevator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFxqhzIESNGlQTC7mfK-44SrYmv-B1Qo76RfIwetFtQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://sites.google.com/view/dylanvanbeekportfolio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9509611189084464"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "607718249030353"}, {"status": "PUBLISHED", "id": "1985262588989331"}, {"status": "PUBLISHED", "id": "1061891169092708"}, {"status": "PENDING", "id": "1812315499711615"}]}, "baseline_offer": {"id": "1061891169092708"}, "is_approved": true, "firstOffer": 
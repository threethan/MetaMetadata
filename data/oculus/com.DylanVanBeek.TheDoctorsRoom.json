2LRG1OToHW9BzaFe6VC60WQf3SEJa3EbM6Sr9vOlc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCXheOQtVhD35ESpKwc8DScxlVwgbFZNbypyN02646bg&oe=6AE36D6E"}, {"file_name": "ScreenshotElevatorSized.png", "id": "1173894400317186", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391950_1173894403650519_4001765275338216533_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw_Pinhq8hUQ7kNvwH_YDCQ&_nc_oc=AdojrU8Y3apmvrtyIPfm3S4IHbxCnkMQiTxkTAeA1xJu6nq-u0nyNk79gNdI5DXxAzg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr54Misw7jnL4a6V4povXdCts5T3-SD4fLgJo3X6m_Rg&oe=6AE34CEF"}, {"file_name": "ScreenshotTVSized.png", "id": "630991776467915", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393822_630991779801248_4032608716738056846_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PGSnZ7orr8Q7kNvwFt8Hio&_nc_oc=AdoP90BO5oU77hl6BQJfe8hdIdfXQ7DnNNXBEGnQydj6apxHGqNIJ-lFvvKat3n9BKI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObqtCLzu47v9rW7Y86MTi6Th9JcMkdnixSSaeZS_i5gQ&oe=6AE3448C"}, {"file_name": "ScreenshotKeypadSized.png", "id": "999502001588840", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392129_999502004922173_2749134177103022935_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmBt_FEIpkYQ7kNvwH7tdwF&_nc_oc=AdqMalx5OF3gJ_mTWj0EJaRZbzNbrPNTgskEXl-7QfHcgaM_6fkPYLBcBzYYynRJ8bw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNowDqvjnkc7golpERnbdULCtY-CV2x5uDT8FJgIE8_-A&oe=6AE33EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2650x1440HeroArt.png", "id": "627736273371577", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393406_627736276704910_8332545983004368152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1rJdv5j338Q7kNvwFw9l5j&_nc_oc=Adp3XX7z8ZxzLTZF3thY03Vo8bHLx860xnW3lM598Yf3AUoKGdr-iqKGYW1gdav5jS0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBrVGj5YWOVjYFk979TkNll--Xwd2C3WKYJ-76cfCRgw&oe=6AE34CBD"}, "display_name": "The Doctor's Room", "keywords": ["Escape", "Horror", "Experience", "Room", "demo"], "long_description": "**The Ultimate Mixed Reality Demo for Quest 2 and above.** The Doctors Room is the perfect spooky but not-too-spooky puzzle game where you must search The Doctors Room for the passcode to return to the ground floor! Your space will be transformed as a mysterious elevator appears in your room, taking you down to The Doctors Office.\n\n{1034648342098437}\n\n\ud83d\udc7bVenture down an elevator to find the mysterious abandoned Doctors Room, where you will be equipped only with a flashlight in this eerie environment.\ud83d\udc7b\n\n\n\n# \ud83e\udd16Next Gen Mixed Reality Technology\ud83e\udd16\nUtilising Mixed Reality with hand and gesture tracking technology to create the perfect first time user experience.\n\n{1417822122899102}\n\n# \ud83e\uddeaEarly Access \ud83e\uddea\nThe Doctors Room is in early access with this singular room experience. We plan to build out and refine these experiences in addition to adding more based on community feedback! Thank you for the support!\n\n{654867464081422}\n\n# \u26a0Health and Safety Warning\u26a0\nThe Doctors Office MR contains content which some users may find frightening or intense. Users should refer to Safety Guidelines to limit the risk of serious injury or harm.\n\n\n", "short_description": "Uncover an eerie doctors room in your basement and hunt for the passcode to restart the elevator.  Mixed reality, hand tracking and controller support!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFxqhzIESNGlQTC7mfK-44SrYmv-B1Qo76RfIwetFtQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Dylan Van Beek", "support_website_url": null, "website_url": "https://sites.google.com/view/dylanvanbeekportfolio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359
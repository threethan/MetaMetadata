.oculuscdn.com/v/t64.5771-25/499619668_1893745071324700_2718042085684657666_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL8-p21vKowQ7kNvwGNMSq8&_nc_oc=AdpLgTwVQa75wLfVxhhzNmNypP07aFkNm0XONuiGo_Vwuv3pz5HSQ_NzugebRjtcgnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp3Aa6ZNarrIRpthpM4XleOJXXb6afoTWVFu4aCWaEvg&oe=6AC2632F"}, {"file_name": "3 Vr.png", "id": "1632252597831699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618910_1632252601165032_8152252459859324832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR7DyyVkfAUQ7kNvwH8elgo&_nc_oc=Adqdb_n17YrAo2Uw95sjzbitcSbEjKq7piI68xwk_mSVzfIoGGKza0BnCN_K_cyNgFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJoD9NeWl7q5Kx8riWuk2B_qG0Lfd4lTX1QdvvfOyxmw&oe=6AC260CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Happy Animal Shelter VR: Rescue Pets", "keywords": ["animal", "rescue", "shelter", "pet", "cozy"], "long_description": "Welcome to Happy Animal Shelter VR: Rescue Pets, a cozy and heartwarming VR animal rescue experience where every pet deserves a second chance.\n\nRescue abandoned and injured animals as they arrive at your shelter looking for care, comfort, and love. Wash muddy paws, clean dirty fur, feed hungry pets, and help sick or injured animals recover with immersive, hands-on VR interactions.\n\nMeet adorable dogs, playful cats, and other lovable animals with unique personalities. Comfort nervous pets, watch them become happy again, and grow your shelter into the ultimate safe haven for animals in need.\n\nFeatures\n\n\ud83d\udc3e Rescue and care for adorable animals\n\ud83d\udec1 Wash, groom, and clean messy pets\n\ud83c\udf56 Feed hungry animals and keep them healthy\n\ud83e\ude7a Treat injuries and medical conditions\n\ud83c\udfe1 Upgrade and decorate your cozy shelter\n\ud83c\udfae Enjoy immersive VR interactions\n\u2728 Watch rescued pets recover and play happily\n\ud83c\udf08 Relax in a wholesome and comforting world\n\nWhether you love cozy games, pet simulators, or relaxing VR experiences, Happy Animals Shelter VR is the perfect place to rescue, heal, and care for furry friends.", "short_description": "Rescue, heal, feed, and care for adorable animals in an immersive VR shelter simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26666357303049896"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1568154967999850"}]}, "baseline_offer": {"id": "1568154967999850"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778785200, "status": "PUBLISHED", "id": "1568154967999850"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26680179271667699", "version": "1.0"}, "id": "925870057080938", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26666357279716565", "is_concept"
tps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210397_1072903527493510_5045144309693896953_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usDWkmYhJvwQ7kNvwGkUj9l&_nc_oc=AdrPPiNdfyvWd6b_sLNrhlBj6ZBj3OvxD201KsZgQc-3x8zXWbRNdvJ0vLN5Cot5LT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJo_UWYdxYH3RsH4vAEeBc4zznefon6MRkfnBLTrZeiA&oe=6A50F41E"}, {"file_name": "JingleStrike_4.png", "id": "2388868291459740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974841_2388868294793073_8513203668845750497_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_21kUwh9bvIQ7kNvwGUCRia&_nc_oc=AdqLqcq5auDxT-Wdvv1m5RNxFCSRG4AkkCerKsq0JvvbuY35X3EBOgu2Ao5UHasZRNM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB54tsz567i3fB_UBLjVu20KuuvY-aIykM7KbcA8is-fg&oe=6A5115CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoTHM.png", "id": "496212603574180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003280_496212613574179_4107228056433930272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZgOqRwTFgMQ7kNvwEF8WGY&_nc_oc=AdozXRog_RTP5RC0tQL921Zw9BpXRivFdRSJte1tQSqLA132up9yz0Y1L9zg86_O-K4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrnqwRuDE8aVUBW3H2kqw8Y4yTYiUxjmvfAfHb2Znksw&oe=6A50ED62"}, "display_name": "Jingle Strike", "keywords": [], "long_description": "Step into the magical world of Jingle Strike VR \u2013 the ultimate holiday-themed VR bowling experience that\u2019s perfect for friends and family alike! Immerse yourself in a festive wonderland where the lanes come alive with Christmas cheer, gingerbread decorations, and the playful antics of mischievous elves. Whether you\u2019re striking pins under the glow of twinkling fairy lights or laughing as your ball rolls through the enchanting oil-slick lanes, Jingle Strike VR delivers fun, charm, and excitement for players of all ages.", "short_description": "Jingle Strike VR is a festive holiday-themed bowling game that brings the magic of Christmas to life in VR! Roll through charming, immersive lanes, interact with mischievous elves, and compete in couch co-op multiplayer for up to 5 players. With dynamic physics, customizable gameplay, and a jolly festive atmosphere, it's perfect for creating holiday memories with friends and family."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spookypictures.co.nz/VirtualReality/VirtualReality.html", "developer_terms_of_service_url": null, "publisher_name": "Spooky Pictures", "support_website_url": null, "website_url": "http://www.SpookyPictures.co.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8165085736930811"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "954377100649758"}, {"status": "PUBLISHED", "id": "1773548236635728"}, {"status": "PUBLISHED", "id": "1115473803464458"}, {"status": "PUBLISHED", "id": "1823204065746073"}]}, "baseline_offer": {"id": "954377100649758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776745560, "status": "PUBLISHED", "id": "954377100649758"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26009515958727848", "version": "1.0"}, "id": "1601217280474639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8135988243173894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26009515958727848"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601217280474639"}]}, "change_log": "Jingle Strike VR is now in its year-round \nlook. Seasonal themes removed, bowling \nchaos remains.\n\nLeave us a review if you're enjoying it! \ufffd", "created_date": 1777960107, "id": "26009515958727848", "version": "1.0", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8135988243173894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26009515958727848"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601217280474639"}]}, "change_log": "Small but mighty update today - Fast Ball mode now activates the moment you step up to the lane. No need to grab a ball from the machine first, just reach out and go.\nGreat if you like to get straight into the action, or if picking up from the machine isn't your preferred way to bowl.\nAs always, if you're enjoying Jingle Strike - a review means the world to an indie dev.\n\nThanks for playing! \ufffd", "created_date": 1777335700, "id": "25930137206665724", "version": "1.0", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8135988243173894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26009515958727848"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601217280474639"}]}, "change_log": "Performance and visual improvements across all levels. Fixed a rare bug where the bowling ball could retain velocity from a previous throw. Improved lighting, shadows and visual quality throughout. Smoother scene transitions. Various stability improvements.", "created_date": 1776741053, "id": "25848065464872899", "version": "1.0", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8135988243173894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26009515958727848"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601217280474639"}]}, "change_log": "Big spring update, play against elves who want to beat you and will roast your throws!", "created_date": 1775456539, "id": "25697326109946836", "version": "1.0", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8135988243173894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "
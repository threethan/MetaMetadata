2B56"}, {"file_name": "Jinglestrike Screenshot 2025.12.18 - 13.18.43.84.png", "id": "929045336410004", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619465_929045339743337_7140892554065324168_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiWEQ4Ce8woQ7kNvwGs27ue&_nc_oc=Adrl8aI_XLy9ShBE1b7D325qzVpugwESOraSMSDbI3Vl1vU3ZR3dDuWn_CcnvqiCSNo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nMLIUcgDeAwD06zAfOE822y_ew3Wl194BJdhzuo3QMw&oe=69E21BC4"}, {"file_name": "Jinglestrike Screenshot 2026.04.01 - 23.47.05.67.png", "id": "977730911583015", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822779_977730914916348_3123641769974382453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5vwIQiogt4Q7kNvwHiuEQI&_nc_oc=Adpo1eTsR_SWMIVx46uIWd3tfsY3veDjCaRgETA998oCg7Td6SpeQzY0rI0GLYUoiX0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FU-z_s2Ah6-tZrzJKiidcCrIeMvF9tYTS_dK_TK7xSg&oe=69E220D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JingleStrikeSpring_CTA_16x9.png", "id": "1562151991513988", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618293_1562151994847321_2454625312020178727_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKxsALqIwdUQ7kNvwGZXX9K&_nc_oc=AdqK-7u15vBrpmF1ZiCgs8ZfRePZL7tNH0Qc_P_EggKpNMAS14v6_lhZ2EwTCduHcd0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q62ut4NFipcC0K1aqDbZRMgRCv_KnRl8uPSWCQJMTHA&oe=69E2338D"}, "display_name": "Jingle Strike VR Bowling", "keywords": ["vrbowling", "bowling", "arcade", "party", "funny"], "long_description": "# Jingle Strike VR Bowling\n\nBowling is easy. Bowling while someone watches, judges, and comments on every throw is not.\n\nWelcome to Jingle Strike VR Bowling.\nTake your shot.  Line it up. Release the ball. Try not to get roasted for it.\n\n{933209679431071}\n\n**BOWL UNDER PRESSURE**\n\nEvery game is shared with a fully animated elf who reacts to everything you do. Good shots, bad shots, complete disasters \u2014 nothing goes unnoticed.\n\n{759053843809168}\n\n**FEELS RIGHT IN VR**  \nNatural motion-based throwing\nEasy to pick up, satisfying to master. Built for quick play and repeat sessions\n\n{926240543337181}\n\n**VS ELF MODE** \nTake on an opponent who wants to win. Turn-based, competitive, and surprisingly tense.\n\n{3928790910755116}\n\n\n**LOCAL PARTY MODE**  Pass the headset and play together. Up to 5 players. Fast, fun, and perfect for groups.\n\n{759206727128182}\n\n\n\n**ALWAYS CHANGING**  Seasonal updates bring new looks and moods to the lanes throughout the year.\n\n{787977094034975}\n\n\n\n{912024035077272}\n\n\n", "short_description": " Hilarious VR bowling game where the elves roast every shot you miss. Crush strikes with real-physics bowling across festive lanes, throw objects at elves and play with friends in party mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.SpookyPicturesGames.co.nz/", "developer_terms_of_service_url": null, "publisher_name": "Spooky Pictures", "support_website_url": null, "website_url": "http://www.SpookyPicturesGames.co.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25664519979894116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491818900_
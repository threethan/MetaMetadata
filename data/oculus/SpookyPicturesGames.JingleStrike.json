, "change_log": "Jingle Strike VR \u2013 Build 20 Update Notes\nImprovements\n\nImproved Smooth Move locomotion with better origin management and more stable strafe behavior.\n\nAdded Auto-Align to Alley for faster bowling.\nPress the right thumbstick click to quickly snap into position at the lane.\nThis feature can be disabled in Comfort Settings.\n\nSettings now save to headset, allowing players to jump straight into gameplay without reconfiguring options each session.", "created_date": 1768797781, "id": "24967403429605778", "version": "1.0", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8135988243173894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25697326109946836"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601217280474639"}]}, "change_log": "New\n\nBall Feel options added: Arcade, Standard, and Sim\n\nImprovements\n\nImproved ball handling reliability\n\nImproved smooth movement positioning near the ball return\n\nGeneral physics and stability improvements", "created_date": 1767687946, "id": "24860863043593151", "version": "1.0", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8135988243173894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25697326109946836"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601217280474639"}]}, "change_log": "Improved player comfort and movement stability.\nSmooth locomotion has been refined to better respect the world and terrain, with reduced unintended movement and more consistent positioning.\nAdditional comfort improvements and polish throughout.", "created_date": 1766918728, "id": "24793646643648125", "version": "1.0", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
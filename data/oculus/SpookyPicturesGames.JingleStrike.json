7a0a&_nc_ohc=3J6YQgTUvTMQ7kNvwEaJucl&_nc_oc=AdpN8R5s3B0P_1lnwGA0okHI2bFNFFpNC-fDaU89pW-eTYdcxH_2g3ZKG6dTF1lIHfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WoUfsm4pvUZOMZ0i-_fhc3uAZ15pG-bCzhqIYKjAIUQ&oe=69D8E50D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoTHM.png", "id": "496212603574180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003280_496212613574179_4107228056433930272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Usn_kIXGt1IQ7kNvwFovsw-&_nc_oc=AdrB9RPqXql_RQ6CGxigvv30HlJu33Xyiy8rCkk4dVcO7tSWglTstSUfvB_G_qN4VjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09sr12FSRGRd6RJvE6Lh0hDKwnluIV_4yFdfk4XU3UZA&oe=69D8F4E2"}, "display_name": "Jingle Strike", "keywords": [], "long_description": "Step into the magical world of Jingle Strike VR \u2013 the ultimate holiday-themed VR bowling experience that\u2019s perfect for friends and family alike! Immerse yourself in a festive wonderland where the lanes come alive with Christmas cheer, gingerbread decorations, and the playful antics of mischievous elves. Whether you\u2019re striking pins under the glow of twinkling fairy lights or laughing as your ball rolls through the enchanting oil-slick lanes, Jingle Strike VR delivers fun, charm, and excitement for players of all ages.", "short_description": "Jingle Strike VR is a festive holiday-themed bowling game that brings the magic of Christmas to life in VR! Roll through charming, immersive lanes, interact with mischievous elves, and compete in couch co-op multiplayer for up to 5 players. With dynamic physics, customizable gameplay, and a jolly festive atmosphere, it's perfect for creating holiday memories with friends and family."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spookypictures.co.nz/VirtualReality/VirtualReality.html", "developer_terms_of_service_url": null, "publisher_name": "Spooky Pictures", "support_website_url": null, "website_url": "ht
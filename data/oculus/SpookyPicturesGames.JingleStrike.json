e_3.png", "id": "1072903524160177", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75210397_1072903527493510_5045144309693896953_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RovOM_I2s9kQ7kNvwEwCteo&_nc_oc=Adp2HMP9q3efcTnI1muNUZ_8q3Gn6D-WxsMUCv2ctCTi-PiwmOuUn80ESw3Ev5OHb_w&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CG8ucvW9WGhdwU8A4eQihl3NzQeJdTK0QOXUjHiaBBw&oe=69E2361E"}, {"file_name": "JingleStrike_4.png", "id": "2388868291459740", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974841_2388868294793073_8513203668845750497_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OHLfpCZYZ4Q7kNvwFk6gLd&_nc_oc=AdplwyN6CG0efHn4eM-8xMAfJIgCBnsZcXSKO5XkSSSZEbHK8-cqLGb-vw2_PVd6cxg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fJCriv8K-6jDdTHdzTrxSSh7b5458ex8HbLvQF7vPMg&oe=69E21F8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoTHM.png", "id": "496212603574180", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003280_496212613574179_4107228056433930272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2ixZMNK0PkQ7kNvwGodzpJ&_nc_oc=Adp_M8K1D4P_DVHctZs_BGLFSdZqV71HcSlrwty7yUK5Npy_O1UGBlNzBstzILe_J5Q&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KVFkuYKEUZoONN0--W2IspzquqPuID4EkWOiM8PZHrg&oe=69E22F62"}, "display_name": "Jingle Strike", "keywords": [], "long_description": "Step into the magical world of Jingle Strike VR \u2013 the ultimate holiday-themed VR bowling experience that\u2019s perfect for friends and family alike! Immerse yourself in a festive wonderland where the lanes come alive with Christmas cheer, gingerbread decorations, and the playful antics of mischievous elves. Whether you\u2019re striking pins under the glow of twinkling fairy lights or laughing as your ball rolls through the enchanting oil-slick lanes, Jingle Strike VR delivers fun, charm, and excitement for players of all ages.", "short_description": "Jingle Strike VR is a festive holiday-themed bowling game that brings the magic of Christmas to life in VR! Roll through charming, immersive lanes, interact with mischievous elves, and compete in couch co-op multiplayer for up to 5 players. With dynamic physics, customizable gameplay, and a jolly festive atmosphere, it's perfect for creating holiday memories with friends and family."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spookypictures.co.nz/VirtualReality/VirtualReality.html", "developer_terms_of_service_url": null, "publisher_name": "Spooky Pictures", "support_website_url": null, "website_url": "http://www.SpookyPictures.co.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8165085736930811"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1773548236635728"}, {"status": "PUBLISHED", "id": "1115473803464458"}, {"status": "PUBLISHED", "id": "1823204065746073"}]}, "baseline_offer": {"id": "1773548236635728"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764869580, "status": "PUBLISHED", "id": "1773548236635728"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25697326109946836", "version": "1.0"}, "id": "1601217280474639", "channel_name": "LIVE"}]}, "
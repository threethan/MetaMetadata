ynK_H2RYvp4dmoRPrDS6E_brmtvPo1d--Or7LlXOgEjSP81iE3fvW4vMOGjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuMITpIqIVhxwo0leNRUj4iKclW-RybqD8ugI3YZUadQ&oe=6AF1FF61"}, {"file_name": "ss03.png", "id": "1029268765615498", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1029268768948831_5343536572703375760_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXpEIFeu1NwQ7kNvwG5tH0O&_nc_oc=Adp-AdFpgzGxd_1bP5DFd98L67J4pYPVHU1Y-HngZCxu39csILntpqPnOsb2g3Bmqs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4h8jgc6M_xVzz2vqyVfy71brOrCrOmcnw_0niZ2VemQ&oe=6AF1F1A8"}, {"file_name": "ss02.png", "id": "607460011979894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_607460015313227_7918550293745292404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVRIBy8yy_QQ7kNvwHeW7RI&_nc_oc=AdrX8lTgjwvn_1qe1wRT64MF2Pi0Ot2Ix-fUep40-qHt7sE96Etm5SqRggsW1UjI_Fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHEWnzn9ATgOIjFhN_1l_-ltG_ed1W_KfHUWaOXIe1nA&oe=6AF1E581"}, {"file_name": "ss01.png", "id": "1130644385469997", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391890_1130644388803330_4550062241992050591_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iylpl5wtdIQ7kNvwEwDfpm&_nc_oc=AdpI8iwxc7pkcvnXwi3tqGN4NENx8DuLZ1TuS527AV4a2BLZQXk_xfzZiUaoh_CzQj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGC3IZMiPemPtygllTnmwraNJt4seH9fNNEh67gqYd1A&oe=6AF1F03D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1598827708222917", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_1598827711556250_6909837597929110776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Te0u_CsJ8BEQ7kNvwH_loh7&_nc_oc=Adq5qoBLsyEYykEIy_LSR2vmv74fWnXcIyLlrpUebSRF3zb73yubYrJiMN8ZaJNsDNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc94jBcJRsWlXAXppCOUovz1La4Q1UvJcHsdGGUQQN1w&oe=6AF1E95F"}, "display_name": "DrawBlox", "keywords": ["voxel", "creative", "multiplayer", "draw", "drawing"], "long_description": "# \ud83c\udf1f Welcome to Drawblox \u2013 A New Spatial Creative Playground! \ud83c\udfa8\n\nJoin a massive 3D voxel canvas where **everyone** can contribute to a shared artwork. Whether you're a dreamer, a storyteller, or just someone who loves to cause **a bit of chaos**, this is your space to shape!\n{575126062104981}\n# \ud83e\uddf1 What is Drawblox?\n-  Imagine a boundless 3D world made of voxels where you can draw, erase, and build alongside other players.\n- Each day, you\u2019ll get a limited number of voxels to use\u2014choose wisely! Will you create, collaborate, or disrupt?\n-  At the end of the month, the entire canvas is frozen in the clouds and reset, preserving your efforts for eternity.\n\n# \ud83c\udf0c A Living, Breathing Canvas\n\nWith hundreds of players, the canvas evolves in real-time. From chaotic scribbles to breathtaking landscapes, every cube matters.\n- Will you tell a story or contribute to an epic monthly narrative?\n- Maybe you'll just doodle and have fun\u2014that\u2019s okay too!\n\n# \ud83d\udd79\ufe0f Why Join Early Access?\n\n- Shape the future of Drawblox!\n- Share feedback and help us fine-tune the app\n\n# \ud83d\udd8c\ufe0f Your Creativity, Your Rules\n- Use your voxels to create anything you imagine: pixel art to a piece of a larger masterpiece.\n- Collaborate\u2014or compete\u2014with others to leave a legacy.\n\n# \ud83c\udf1f Key Features\n\n    Dynamic 3D canvas shared by players worldwide \ud83c\udf0d\n    Monthly resets to keep the creativity fresh \ud83d\udd04\n    Daily voxel limits for strategy and balance \ud83c\udfaf\n    A community-driven space for art, storytelling, and experimentation \ud83d\uddbc\ufe0f", "short_description": "\ud83c\udf1f Welcome to Drawblox \u2013 A New Spatial Creative Playground! \ud83c\udfa8\n\nJoin a massive 3D voxel canvas where everyone can contribute to a shared masterpiece. Whether you're a dreamer, a storyteller, or just someone who loves to cause a bit of chaos, this is your space to shape!\n\nYou\u2019ll have a daily limit of voxels to keep things fun and challenging, and a countdown until the canvas gets wiped for a fresh start. Every round is a chance to create a new masterpiece together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unfoldvr.com/privacy/privacyPolicy_drawblox.html", "developer_terms_of_service_url": null, "publisher_name": "DrawBlox", "support_website_url": null, "website_url": "https://www.unfoldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "8745975328860936"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391990_1649282389331503_6104268361902759616_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O55w0r4pmggQ7kNvwHR9RaA&_nc_oc=Ado6IvHPgnKw6cPElEgmCxmTZm9ttZT2mM_sGFxD8YcpZHrhdWA-BTMkDXpTE3Nc7rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxiSF5Lkpg29jcIE2Yde2s_mhbgJ1gBlLWrBwG6YV-PA&oe=6AF20520"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DrawBlox", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647
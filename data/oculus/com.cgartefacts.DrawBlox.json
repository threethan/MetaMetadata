hNjnGPieyydGDntsDagQBgYSaTdK2itwD9P1ex44Yj_2q7qseko8d0G7MWy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYuIfmzqA8i4pQqjNtxcEjMhvnB6QXFaS5cDWSY_41PA&oe=6AF5F3E1"}, {"file_name": "ss03.png", "id": "1029268765615498", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1029268768948831_5343536572703375760_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnvkwn1GQYgQ7kNvwEIncOQ&_nc_oc=AdqKwGfIkrMG3h2uzQlbROAUIqOyyb5t-lo1AGCR-dUgmm8AH5ZICzpjm6XGRGjzCvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTXIKU8F3lU-wYTJ49THEyUkJcU1CaVmvD59KMsTvwyg&oe=6AF5E628"}, {"file_name": "ss02.png", "id": "607460011979894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_607460015313227_7918550293745292404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHMYQ7uHVqwQ7kNvwFfb1hS&_nc_oc=AdoI2fSO12FHQln_Z_Ww4vZUcxZCBBl4ry2td1GaUB5sg7_0kQR7ji-f9OcPnNZlDPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiS52jdsQJwCZIKmR_9L3qEAOcRQLnaK-jNs4c2OuFsw&oe=6AF5DA01"}, {"file_name": "ss01.png", "id": "1130644385469997", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391890_1130644388803330_4550062241992050591_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk2fD5vKnrkQ7kNvwEqgPyk&_nc_oc=AdpcQSHdWaA2h5dC7l_LE73_-WiJgEMFLE4CFq9Nb8I60K-V18psKXDchSb2evnZimY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkMC_EXw8qz16-RVjVVqF4NQesZAc-Xj6O-ta6QN9fSg&oe=6AF5E4BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1598827708222917", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_1598827711556250_6909837597929110776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bflD19h6aXsQ7kNvwHW6ZZE&_nc_oc=Ado8M1AphNwlGU3cFV85xiHfVQ47Ncjff0WHHusc4tCvK3R0ZTPZ6KNIlfJVW3nsARQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpdzTGyQj45KhA-_FbforJo5leZ0_vGDqLWkvPsDjuHw&oe=6AF5DDDF"}, "display_name": "DrawBlox", "keywords": ["voxel", "creative", "multiplayer", "draw", "drawing"], "long_description": "# \ud83c\udf1f Welcome to Drawblox \u2013 A New Spatial Creative Playground! \ud83c\udfa8\n\nJoin a massive 3D voxel canvas where **everyone** can contribute to a shared artwork. Whether you're a dreamer, a storyteller, or just someone who loves to cause **a bit of chaos**, this is your space to shape!\n{575126062104981}\n# \ud83e\uddf1 What is Drawblox?\n-  Imagine a boundless 3D world made of voxels where you can draw, erase, and build alongside other players.\n- Each day, you\u2019ll get a limited number of voxels to use\u2014choose wisely! Will you create, collaborate, or disrupt?\n-  At the end of the month, the entire canvas is frozen in the clouds and reset, preserving your efforts for eternity.\n\n# \ud83c\udf0c A Living, Breathing Canvas\n\nWith hundreds of players, the canvas evolves in real-time. From chaotic scribbles to breathtaking landscapes, every cube matters.\n- Will you tell a story or contribute to an epic monthly narrative?\n- Maybe you'll just doodle and have fun\u2014that\u2019s okay too!\n\n# \ud83d\udd79\ufe0f Why Join Early Access?\n\n- Shape the future of Drawblox!\n- Share feedback and help us fine-tune the app\n\n# \ud83d\udd8c\ufe0f Your Creativity, Your Rules\n- Use your voxels to create anything you imagine: pixel art to a piece of a larger masterpiece.\n- Collaborate\u2014or compete\u2014with others to leave a legacy.\n\n# \ud83c\udf1f Key Features\n\n    Dynamic 3D canvas shared by players worldwide \ud83c\udf0d\n    Monthly resets to keep the creativity fresh \ud83d\udd04\n    Daily voxel limits for strategy and balance \ud83c\udfaf\n    A community-driven space for art, storytelling, and experimentation \ud83d\uddbc\ufe0f", "short_description": "\ud83c\udf1f Welcome to Drawblox \u2013 A New Spatial Creative Playground! \ud83c\udfa8\n\nJoin a massive 3D voxel canvas where everyone can contribute to a shared masterpiece. Whether you're a dreamer, a storyteller, or just someone who loves to cause a bit of chaos, this is your space to shape!\n\nYou\u2019ll have a daily limit of voxels to keep things fun and challenging, and a countdown until the canvas gets wiped for a fresh start. Every round is a chance to create a new masterpiece together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unfoldvr.com/privacy/privacyPolicy_drawblox.html", "developer_terms_of_service_url": null, "publisher_name": "DrawBlox", "support_website_url": null, "website_url": "https://www.unfoldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "8745975328860936"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391990_1649282389331503_6104268361902759616_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2F78KC76wkQ7kNvwHgUmtv&_nc_oc=AdrfjM_98eNs0pQZLx6G3nMPt0OhII_NJtkkld1lHM1QdL80pGefm4q5eW2AbPwaW08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYsTYIj0p7JiJWVjHbx0TV0L0UPHDTV6DncMLiWqzM5Q&oe=6AF5C160"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DrawBlox", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647
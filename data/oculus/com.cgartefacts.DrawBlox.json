jwO4qbCaZHgQppnsM8y4MGT023SAiEAsTdYKjvC3xgDdaHqzblyKoGdUKm44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7ucSRtbCxd4GY184iLq6gpOM78zoG6Ldw_AOmLiB4yw&oe=6AEA1661"}, {"file_name": "ss03.png", "id": "1029268765615498", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1029268768948831_5343536572703375760_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPyxgV3ozDYQ7kNvwH-2mn1&_nc_oc=AdoJccz0ZbnFLgwSzyzNS48PtptV_XiB2EVSAJl5eoHUI8C04hx-SEGPr1vfqKF0sCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBUCgozOxoNOe1pLX-jPrMNv_Jk3-GVHfD8bjzh0Jzrg&oe=6AEA08A8"}, {"file_name": "ss02.png", "id": "607460011979894", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393507_607460015313227_7918550293745292404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEh68apYtikQ7kNvwGuINJW&_nc_oc=AdolBa7kRfpKtz04ITj8rRAm8FOtkQPse7SzCxmGl_V9hnGyDV58iwtphExOptbYYUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQyEnvmH_tErWKYgvHn5q2_iftHEgXE7ZUv5OF6yjCOw&oe=6AE9FC81"}, {"file_name": "ss01.png", "id": "1130644385469997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391890_1130644388803330_4550062241992050591_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZLYdbizIRoQ7kNvwEzruid&_nc_oc=Ado0COBLLHoG4kSGOrx2YqCbeU-WKC3LUg5DP5MzU9PLrvh4HE-ZIfk0X3ShtlokVDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZQRMyDiG7-QKsQtlQjjLMy2omrRUKcxpuF1NgGleyKw&oe=6AEA073D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1598827708222917", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391974_1598827711556250_6909837597929110776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkElWmCcpkcQ7kNvwE6TOrn&_nc_oc=AdqF99N_kDC_ElOpYR5g4ibIQYCSFDKwLa11bj8lWEmLMyyjm2i95yBxkwyDNYACb6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoKUWmufsLJQj0f3TLXcnKbjzjqBkGGDDNUEPDLoz99A&oe=6AEA005F"}, "display_name": "DrawBlox", "keywords": ["voxel", "creative", "multiplayer", "draw", "drawing"], "long_description": "# \ud83c\udf1f Welcome to Drawblox \u2013 A New Spatial Creative Playground! \ud83c\udfa8\n\nJoin a massive 3D voxel canvas where **everyone** can contribute to a shared artwork. Whether you're a dreamer, a storyteller, or just someone who loves to cause **a bit of chaos**, this is your space to shape!\n{575126062104981}\n# \ud83e\uddf1 What is Drawblox?\n-  Imagine a boundless 3D world made of voxels where you can draw, erase, and build alongside other players.\n- Each day, you\u2019ll get a limited number of voxels to use\u2014choose wisely! Will you create, collaborate, or disrupt?\n-  At the end of the month, the entire canvas is frozen in the clouds and reset, preserving your efforts for eternity.\n\n# \ud83c\udf0c A Living, Breathing Canvas\n\nWith hundreds of players, the canvas evolves in real-time. From chaotic scribbles to breathtaking landscapes, every cube matters.\n- Will you tell a story or contribute to an epic monthly narrative?\n- Maybe you'll just doodle and have fun\u2014that\u2019s okay too!\n\n# \ud83d\udd79\ufe0f Why Join Early Access?\n\n- Shape the future of Drawblox!\n- Share feedback and help us fine-tune the app\n\n# \ud83d\udd8c\ufe0f Your Creativity, Your Rules\n- Use your voxels to create anything you imagine: pixel art to a piece of a larger masterpiece.\n- Collaborate\u2014or compete\u2014with others to leave a legacy.\n\n# \ud83c\udf1f Key Features\n\n    Dynamic 3D canvas shared by players worldwide \ud83c\udf0d\n    Monthly resets to keep the creativity fresh \ud83d\udd04\n    Daily voxel limits for strategy and balance \ud83c\udfaf\n    A community-driven space for art, storytelling, and experimentation \ud83d\uddbc\ufe0f", "short_description": "\ud83c\udf1f Welcome to Drawblox \u2013 A New Spatial Creative Playground! \ud83c\udfa8\n\nJoin a massive 3D voxel canvas where everyone can contribute to a shared masterpiece. Whether you're a dreamer, a storyteller, or just someone who loves to cause a bit of chaos, this is your space to shape!\n\nYou\u2019ll have a daily limit of voxels to keep things fun and challenging, and a countdown until the canvas gets wiped for a fresh start. Every round is a chance to create a new masterpiece together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cgartefacts.com/unfoldvr.com/privacy/privacyPolicy_drawblox.html", "developer_terms_of_service_url": null, "publisher_name": "DrawBlox", "support_website_url": null, "website_url": "https://www.unfoldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "8745975328860936"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391990_1649282389331503_6104268361902759616_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seUZ58JBWzAQ7kNvwFvUZ_r&_nc_oc=AdqRIFUgsD5XOs6DcCVPnQ2h6dMVIObZOokXXPj8MDd6Yg7qi9mWUXhhIBaRQ_7Ge20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf3Kmu6eSKRoF9DLrkie5qbs0kV8ljyeWASAp_Fj6XzQ&oe=6AE9E3E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DrawBlox", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647
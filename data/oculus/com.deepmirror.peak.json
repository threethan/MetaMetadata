9cSJRyetP_IhSIsiEJL-rBvYderbg&oe=6ADF47D1"}, {"file_name": "\u6e38\u620f\u622a\u56fe (4).png", "id": "1883148615532405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622315_1883148618865738_8323742675437706901_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cTsRQL-FUkQ7kNvwHYwBRW&_nc_oc=AdqQkMC0GySs6A4kzU1cxQVLD9z-0W0rznhMzux8PI0LZJw_FcoSCXHEMhyXrKmdHug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx4hMhkA6W6V_s8Hv9JqTF-zMOa-UXZYdWVtCoDY-b2A&oe=6ADF5A38"}, {"file_name": "\u6e38\u620f\u622a\u56fe (5).png", "id": "952296007422078", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_952296010755411_2498703131389083589_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_84F3rAjY9AQ7kNvwHpEOD4&_nc_oc=AdqlUsZ2pB9hpTrIw12FR1t4AqtZYIBvGF7iQRPO-5rSf99UZmmM55Hu4eSaJRz6o88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxyhYn6xW1h7T-KAcluiQA2ZgZ60j7CvI2dZofyyiAIg&oe=6ADF5CDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mountain", "keywords": ["Monke", "Monkey", "Climbing", "Free", "Multiplayer"], "long_description": "\ud83d\udcd6 About the Game\nMonke Mountain is a VR climbing adventure built for both solo players and 2-player co-op. Take on the role of  a nimble ape and conquer three distinct realms \u2014 Ground, Sky, and Space \u2014 with nothing but your own two hands.Climb, leap, and survive your way to the legendary Golden Banana, and complete an interstellar pilgrimage    only an ape could dream of.\n\n  \ud83c\udfae Key Features\n  - \ud83e\uddd7 True Hands-On Climbing \u2014 Immersive VR hand-tracking\nwith no stick locomotion. Every grip is decided by     your own hands.\n  - \ud83c\udf0d A Three-Act Journey \u2014 Ground \u2192 Sky \u2192 Space. Environments and challenges escalate as you climb higher.    \n  - \ud83d\udc64 Solo or Co-op \u2014 Take on the climb alone, or join online to explore the stars\n  - \ud83d\udc7e Alien Threats \u2014 Dodge UFO lasers and incoming stones from Slime creatures in the final act.\n  - \ud83c\udf4c The Golden Banana \u2014 A clear, myth-driven goal that guides your pilgrimage from start to finish.\n  - \u26a1 Physics-Driven Feedback \u2014 Real hand collisions, weighty falls, and tense stamina management.", "short_description": "Monke Mountain is a VR climbing adventure for solo players and co-op duos alike. Scale the mountains, board  a starship in the skies, and venture into space to reach the legendary Golden Banana \u2014 climb it alone, or bring a friend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chummi.sg/monke-mountain", "developer_terms_of_service_url": null, "publisher_name": "CHUMMI PTE. LTD", "support_website_url": null, "website_url": "https://www.chummi.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "26098281669849852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618277_26815138348116519_1679433124387175104_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtys6tZr1YEQ7kNvwFlQPWo&_nc_oc=AdqXxQUWmAJnIBEr_B99hjUhoJxw4Z3iYZwqzpHzzV-1U546HKp9ZUGs4ksYCOJIY1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNouR3JnxVVsw0777E68W_0VriDca99JS8X9V4TQ9wnyw&oe=6ADF4AFC"}, "is_concept": false, "is_t
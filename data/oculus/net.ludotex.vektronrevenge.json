1361_178614981_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPkGgBpjUhYQ7kNvwEltLwT&_nc_oc=Adqt8psp3zBGnxHW3BIvXDXhAiXWRWbiz9QUyUU5DBcRrAzHS5okkTUiiScLW9QGMqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrAuy6VUzTOHoZ2DzkQk1m8NxUa10ySdOy8AkVlMeNKQ&oe=6ADF5BB7"}, {"file_name": "migrated_image.png", "id": "577727529802641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138812_849470321835283_1901550966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urDZ08xqx2cQ7kNvwEsZBdy&_nc_oc=AdrvoA0KUxl7DGGZd3UILik3j5kkWwu-8o6bt0wKD-dQhd1QXD3Xev6gTXm6PrRi8g8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLsPOvzR3ZsQt9Pzhfsah3vu1EPTlfxJu9XibNU1p55A&oe=6ADF5F5D"}, {"file_name": "migrated_image.png", "id": "2819678198111512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162739_1520752278218088_1871427277_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc0c8R_EJf4Q7kNvwHf5ZSi&_nc_oc=AdpDrRTZkHYtDLaQf9AIPedQfplOG5qDhYjr3INRQ72pxjrDfYl_l4HSX18XCCjCq74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXHM803XSJiXNOoT4-1OdYEGOr4wlE-zkbvXjxWE8tBQ&oe=6ADF61E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": ["arcade"], "long_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!\n\nVektron Revenge is an old-school style shooter done exclusively for VR. The playfield has no limits as you avoid and destroy waves of enemies in a 360 degree environment. Watch out for obstacles and use the Revenge power-up to wipe out the toughest baddies.\n\nThe faster you can clear a wave, the bigger the wave bonus. Concentrate on grabbing the blue pills coming from enemies to score extra - but don\u2019t be too greedy or you might end up trapped in a difficult position.\n\nKeep track of your highscore and try to beat it as you become a true Vektron Revenger!", "short_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ludotex.net/", "developer_terms_of_service_url": "http://www.ludotex.net/", "publisher_name": "Ludovic Texier", "support_website_url": null, "website_url": "http://www.ludotex.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "279652464256159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138838_142524596110348_1678867768_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9BHA2Q1ci8Q7kNvwFvu2eI&_nc_oc=AdpxrGF9e0UwJ1goKT6VGgEQEenhL6mkUV1fAKmVPJWIDriDuOtbm_pwI8RXygVApcI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3agAsFTgfYBFtdBoSJtJw7hC36TABNYYNqsmFrCzr4g&oe=6ADF51AA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vektron Revenge", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "893648430670591", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "982771795100769", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "29
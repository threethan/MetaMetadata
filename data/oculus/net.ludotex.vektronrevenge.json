1361_178614981_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIWyC-jT2FoQ7kNvwEqt3xk&_nc_oc=AdouXuP2csbyYhKuqRvD5KdP_B6chYKlDmsYuBFR7Q1mlrBQIzBu-hz3smODkMp6Mak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iBtHNPs48gra6NUK1KfWFAqnPLivf36REGtkzt73NmQ&oe=6A47BF37"}, {"file_name": "migrated_image.png", "id": "577727529802641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138812_849470321835283_1901550966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPBQfBmazfEQ7kNvwEg3GCo&_nc_oc=Adqf3PqtaFW4veAT0q-01jaYa2nCNRSKta6QM3b-OK_45vPljLNTHfaCSMijVAbgu6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SQ19nVXkKmAb5dxDWbtPFVoC3R2WDWeokEcvyCGZa0g&oe=6A47C2DD"}, {"file_name": "migrated_image.png", "id": "2819678198111512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162739_1520752278218088_1871427277_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmD41V0ZH7MQ7kNvwGM6Ua3&_nc_oc=Adq-qoiawpUJQvyW8Lay1JaH0HUBhJJh8TTnQiIIZkvu1hbhVCQutoIq8bCCsrrAbSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rCx2cfwlI2QPvYJ8ZoQ9A9aiBSJ1PVYl5D3OARrQMsw&oe=6A47C562"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": ["arcade"], "long_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!\n\nVektron Revenge is an old-school style shooter done exclusively for VR. The playfield has no limits as you avoid and destroy waves of enemies in a 360 degree environment. Watch out for obstacles and use the Revenge power-up to wipe out the toughest baddies.\n\nThe faster you can clear a wave, the bigger the wave bonus. Concentrate on grabbing the blue pills coming from enemies to score extra - but don\u2019t be too greedy or you might end up trapped in a difficult position.\n\nKeep track of your highscore and try to beat it as you become a true Vektron Revenger!", "short_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ludotex.net/", "developer_terms_of_service_url": "http://www.ludotex.net/", "publisher_name": "Ludovic Texier", "support_website_url": null, "website_url": "http://www.ludotex.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "279652464256159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138838_142524596110348_1678867768_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Y-xHejIxD4Q7kNvwHlq3b4&_nc_oc=AdoWZix71GreeW6r70sHcXqI6qOoJZUWrIZdyaMJKiG5_Ow04k3gcaasB3D_nY2tjUY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aHNRQPxnfY0zUQ04AaUajF3cMvOx6VPSJmBt62lAFQA&oe=6A47B52A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vektron Revenge", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "893648430670591", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "982771795100769", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "29
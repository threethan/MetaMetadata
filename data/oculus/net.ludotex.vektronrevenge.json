1361_178614981_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9jOXf1ViXEQ7kNvwGDcwo7&_nc_oc=AdrZBAk6tpU-p1jZR07_mZ-WKv8yJWbctNiDP0qeO7n7RXaZ6pOncfMdw9qZ7SFDj_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG87RMOJ6wOG-mCF09Ao9WywRfVYE67H3Fr9-6ayl0wwQ&oe=6A71EF37"}, {"file_name": "migrated_image.png", "id": "577727529802641", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138812_849470321835283_1901550966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KhN_lOFYBQQ7kNvwEA0Vvq&_nc_oc=AdpWJrESMsP5HSxuMJVRi2mVHKCgPrYMge7T-a28JGML_VDa9yHqsE3go3Bl1qDQc_Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKvJkn4JNdnkC5BUS02jchhE7XxdqcPUBNxLBiLJbDwg&oe=6A71F2DD"}, {"file_name": "migrated_image.png", "id": "2819678198111512", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162739_1520752278218088_1871427277_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG7vw5PmaK4Q7kNvwE6CVsZ&_nc_oc=AdrqcKnqdOcuhNBRIqq6ez-ezpAL_Rg4a2cKWG_tMSz4Nc8AD8dO-xCkcL-4BiNCor8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAlfQt1RiJapk0wsPTtaSNEJL257w3gHxKEdpRJ8_8cw&oe=6A71F562"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": ["arcade"], "long_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!\n\nVektron Revenge is an old-school style shooter done exclusively for VR. The playfield has no limits as you avoid and destroy waves of enemies in a 360 degree environment. Watch out for obstacles and use the Revenge power-up to wipe out the toughest baddies.\n\nThe faster you can clear a wave, the bigger the wave bonus. Concentrate on grabbing the blue pills coming from enemies to score extra - but don\u2019t be too greedy or you might end up trapped in a difficult position.\n\nKeep track of your highscore and try to beat it as you become a true Vektron Revenger!", "short_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ludotex.net/", "developer_terms_of_service_url": "http://www.ludotex.net/", "publisher_name": "Ludovic Texier", "support_website_url": null, "website_url": "http://www.ludotex.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "279652464256159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138838_142524596110348_1678867768_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbjlo8Ck6KEQ7kNvwHOpNp-&_nc_oc=AdpFR96-xGPnLoIBKJdazmjS3cYpmTVJQwYAbcEPTuCzcH1HYo2_F9iO9v6vHDM1JjE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECYgKFTYAwP4pM6FVjJS6O4t6zMwP22fiLA5O0YcQu9Q&oe=6A71E52A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vektron Revenge", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "893648430670591", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "982771795100769", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "29
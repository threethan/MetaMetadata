luscdn.com&_nc_ss=7f20f&oh=00_AQTqwCOwP_0r7I_JkhOUV0QS4tEcF7SnmUTZHsHp7f0uXg&oe=6B0063F9"}, {"file_name": "migrated_image.png", "id": "955024041561780", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138837_1527002014291361_178614981_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owCsvpNk4rsQ7kNvwGiOkSy&_nc_oc=AdrPn2aeNxQ0g3jLPvfPREVig4H3kLwudICRgJ_09JNqSryv-hBRmYqVdPlfrkj3C0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOGRLBS3D7mLigJcqsITrrnfx1p8bSRw7mZ9yHjgT1PQ&oe=6B005137"}, {"file_name": "migrated_image.png", "id": "577727529802641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138812_849470321835283_1901550966_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X035LEymJN0Q7kNvwGZ-5jP&_nc_oc=AdppGH3vnriEsxWu-Tz8IypNDYcqTI7wBMHUPvZUaEZy2vV47toVo0LGSDgu48z1ko8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNs1iurXU_69zmroqSnf5EoQEtCbUbE8ptN-smY8FBbg&oe=6B0054DD"}, {"file_name": "migrated_image.png", "id": "2819678198111512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162739_1520752278218088_1871427277_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCe7U6ai2akQ7kNvwHGvKBN&_nc_oc=AdoQ9Tbjlx1oHCaBJQ-30jQKnC-_DIZM31W-f3g9_R1R0ZyuIJfUirnq87iD3qKgCcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5KOSh0ebJ1mR1AVs3aAIE6Hdg6rRocIJYF0ABkBTGVA&oe=6B005762"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": ["arcade"], "long_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!\n\nVektron Revenge is an old-school style shooter done exclusively for VR. The playfield has no limits as you avoid and destroy waves of enemies in a 360 degree environment. Watch out for obstacles and use the Revenge power-up to wipe out the toughest baddies.\n\nThe faster you can clear a wave, the bigger the wave bonus. Concentrate on grabbing the blue pills coming from enemies to score extra - but don\u2019t be too greedy or you might end up trapped in a difficult position.\n\nKeep track of your highscore and try to beat it as you become a true Vektron Revenger!", "short_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ludotex.net/", "developer_terms_of_service_url": "http://www.ludotex.net/", "publisher_name": "Ludovic Texier", "support_website_url": null, "website_url": "http://www.ludotex.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "279652464256159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138838_142524596110348_1678867768_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaaX4Hw8MtUQ7kNvwFtaB45&_nc_oc=Adoa_vEvw7Oltd9K1qC9xSOY6KPlBG9_r-5GEN8AWnLqr0xXRpqe7dxUx69e-AS3Iv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb49QPVuf0P2cIpkGfrVQc2hUSXZI4ppARdY9qkR9qWQ&oe=6B007F6A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vektron Revenge", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "893648430670591", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "982771795100769", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2954925484569208", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162790_828904950511299_1465307977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fIFzsTEE4UQ7kNvwEx3zm3&_nc_oc=AdpgUHcmWVwzcyrLX_JN3uF6IH17oacoLWH-QfkxAyf2WdPzHpzQ-KpdjXK9n-_2ABQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd4r0qtmwt0IKhaXgoGhkot_-RJ18qWBy9m8ggpDzZsg&oe=6B008372"}, {"file_name": "migrated_image.png", "id": "2751392138314138", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162790_828904950511299_1465307977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fIFzsTEE4UQ7kNvwEx3zm3&_nc_oc=AdpgUHcmWVwzcyrLX_JN3uF6IH17oacoLWH-QfkxAyf2WdPzHpzQ-KpdjXK9n-_2ABQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd4r0qtmwt0IKhaXgoGhkot_-RJ18qWBy9m8ggpDzZsg&oe=6B008372"}]}, "id": "501824943845414", "locale": "en_US", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": [], "long_description": "Inside an old arcade shooter, use your gaze to defeat waves of geometric enemies all in full VR glory!\nVektron Revenge is an old school style shooter done exclusively for VR. The playfield has not limits as you will be avoiding and destroying waves of enemies in a 360 environment. But beware of 3D obstacles that come in your way and use the devastating shooting spray of the Revenge power up wisely to clean up the levels from the toughest baddies.\nThe fastest you clean a wave the bigger the wave bonus. Concentrate on g
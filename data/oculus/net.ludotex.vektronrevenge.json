1361_178614981_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rbs9MGIZBEAQ7kNvwFdOUZl&_nc_oc=Adp6rmz_tT1k-ZxU9hZGmtg074dJRvtTYbz7cKQBwjKfNCNQMisxEWOv-m6LhkJXu54&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwbS52985WSlIXBhQhej9-vWeYeWgegYxqEo9VAw9eHA&oe=6AE89637"}, {"file_name": "migrated_image.png", "id": "577727529802641", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138812_849470321835283_1901550966_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9Z-BZJRIjkQ7kNvwGpL2B1&_nc_oc=AdrGLaeZ6NzzEk6b6Jkb_Dqv9Yl8AcYOY4SIQloLL4AM9IjhTh5gb3_P_E74HzwhxTM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_P_ODZEuY9rwWoAgfBIG-e1K0X6LMG1gcLm1SOuW88Q&oe=6AE899DD"}, {"file_name": "migrated_image.png", "id": "2819678198111512", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162739_1520752278218088_1871427277_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BFIWAOnUXMQ7kNvwEusTnk&_nc_oc=Adra67DnLrg1WZPri9eXFfq0rZ73GcLDBb3_Uhcd2Kmg9-Kts0JLSUy-7hhEaeYF70s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKswNn7bncOu9dKckEX6WUeUh-k_lisA5-IApvy7DyfA&oe=6AE89C62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": ["arcade"], "long_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!\n\nVektron Revenge is an old-school style shooter done exclusively for VR. The playfield has no limits as you avoid and destroy waves of enemies in a 360 degree environment. Watch out for obstacles and use the Revenge power-up to wipe out the toughest baddies.\n\nThe faster you can clear a wave, the bigger the wave bonus. Concentrate on grabbing the blue pills coming from enemies to score extra - but don\u2019t be too greedy or you might end up trapped in a difficult position.\n\nKeep track of your highscore and try to beat it as you become a true Vektron Revenger!", "short_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ludotex.net/", "developer_terms_of_service_url": "http://www.ludotex.net/", "publisher_name": "Ludovic Texier", "support_website_url": null, "website_url": "http://www.ludotex.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "279652464256159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138838_142524596110348_1678867768_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwS1Uic9XkMQ7kNvwFZ-kFs&_nc_oc=AdpKFtwo4Dzto979UTlzo2gYojcMjS9zuQogs4_PxoUdCHaJplRop3Psq4bfyNQrSXw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzTeRvh4uRkyiX9g0_gPDq2yqwKOxMufD5wV-BW5gB2w&oe=6AE88C2A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vektron Revenge", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "893648430670591", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "982771795100769", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "29
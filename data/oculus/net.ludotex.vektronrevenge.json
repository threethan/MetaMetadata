luscdn.com&_nc_ss=7f20f&oh=00_AQRfu_7zE1SVy76tS-Chj6fFrNcmQg_bnDREIbW5n7B8rw&oe=6B06FB79"}, {"file_name": "migrated_image.png", "id": "955024041561780", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138837_1527002014291361_178614981_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9uK-Mk-GuQQ7kNvwG5jic3&_nc_oc=AdreCEKOszfUg25eB7U9oHYkqj5dS2Dyf90Ya43OP0ndjPtr8PepmpJ8f_MK7tGwFdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTULsRhRAHy85hBWSX6tauWrPLn8L3L0nNYmjuSI6hKhw&oe=6B0720F7"}, {"file_name": "migrated_image.png", "id": "577727529802641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138812_849470321835283_1901550966_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x2R4a0p_p8Q7kNvwHnsbnt&_nc_oc=AdoAxRNZJgRaLvhz8APofhEPceHvVv1miAQnoEyB0wFm0RhEdHssHLXjynmNxqx2gPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFEjjBXFZtk-SlmoLL8DdSbSyeGiiaUQCcLmHxB-unnw&oe=6B07249D"}, {"file_name": "migrated_image.png", "id": "2819678198111512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162739_1520752278218088_1871427277_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIxW7kmTL9sQ7kNvwFjaFTG&_nc_oc=AdoF4feIYKz_t9Iiw68vSbkB3z8CEJLQmteUKFKf8K_C-nbtAUskhN0Rjb9_58Y24iY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmDEP0dH6HkZ6oKYeaAAeTufkadhT8jjXNuBj23hT2sA&oe=6B072722"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": ["arcade"], "long_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!\n\nVektron Revenge is an old-school style shooter done exclusively for VR. The playfield has no limits as you avoid and destroy waves of enemies in a 360 degree environment. Watch out for obstacles and use the Revenge power-up to wipe out the toughest baddies.\n\nThe faster you can clear a wave, the bigger the wave bonus. Concentrate on grabbing the blue pills coming from enemies to score extra - but don\u2019t be too greedy or you might end up trapped in a difficult position.\n\nKeep track of your highscore and try to beat it as you become a true Vektron Revenger!", "short_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ludotex.net/", "developer_terms_of_service_url": "http://www.ludotex.net/", "publisher_name": "Ludovic Texier", "support_website_url": null, "website_url": "http://www.ludotex.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "279652464256159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138838_142524596110348_1678867768_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwRppy9fIi4Q7kNvwH7es9d&_nc_oc=AdoHNAZu4o_D2OnR3T_TLcLmIR3zh8SzMc84zZDW9VGo_z9-wjw2Em8DjD3hDg2mHqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtTBtGFW31upE-sO8JA5XhSR7R7yMgn80Pawp8tSBEjg&oe=6B0716EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vektron Revenge", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "893648430670591", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "982771795100769", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2954925484569208", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162790_828904950511299_1465307977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W-I1tKgmwcQ7kNvwFIukLO&_nc_oc=Ado4RMw_Ylv0v-CWzOGNu-GU4P6t2n3u9Z5GPDYIxDtBBwFKw9rntRUGDz7m68pbfKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfWZUECpW61H2I9l1iMpFRYKqiPB6Y1Ps177OfBx_qZQ&oe=6B071AF2"}, {"file_name": "migrated_image.png", "id": "2751392138314138", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162790_828904950511299_1465307977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W-I1tKgmwcQ7kNvwFIukLO&_nc_oc=Ado4RMw_Ylv0v-CWzOGNu-GU4P6t2n3u9Z5GPDYIxDtBBwFKw9rntRUGDz7m68pbfKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfWZUECpW61H2I9l1iMpFRYKqiPB6Y1Ps177OfBx_qZQ&oe=6B071AF2"}]}, "id": "501824943845414", "locale": "en_US", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": [], "long_description": "Inside an old arcade shooter, use your gaze to defeat waves of geometric enemies all in full VR glory!\nVektron Revenge is an old school style shooter done exclusively for VR. The playfield has not limits as you will be avoiding and destroying waves of enemies in a 360 environment. But beware of 3D obstacles that come in your way and use the devastating shooting spray of the Revenge power up wisely to clean up the levels from the toughest baddies.\nThe fastest you clean a wave the bigger the wave bonus. Concentrate on g
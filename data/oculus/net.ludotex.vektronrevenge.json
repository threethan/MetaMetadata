luscdn.com&_nc_ss=7f20f&oh=00_AQRpUURQ4KaRpqA7cqoPIvfyt-ViXGP8KHSk2Ip4uwjCZQ&oe=6B045879"}, {"file_name": "migrated_image.png", "id": "955024041561780", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138837_1527002014291361_178614981_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9uK-Mk-GuQQ7kNvwEsmSLV&_nc_oc=Adq3w6peSveExZqZfAbmDrBj4Gd6nsGschjuthfus8BarnyahD6jKwJim0ECwc6Pwec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFQfeMJLAWs5tbXkMiKK2b6IhdTrnX981GFBA1eFnJqQ&oe=6B047DF7"}, {"file_name": "migrated_image.png", "id": "577727529802641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138812_849470321835283_1901550966_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4o2yLDeO1oQ7kNvwFp_uQt&_nc_oc=AdoZ3chAJ18EV-7CG8nGQtNUiqi3AhQsLCArwSbXpALn0aJGgpPgcov2AnpItgW3PwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPat4fIpqJCfuFS5c3EcD3tW6MQto4iVF5uODXsfB3Uw&oe=6B04819D"}, {"file_name": "migrated_image.png", "id": "2819678198111512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162739_1520752278218088_1871427277_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVpAxHDxZCwQ7kNvwE7R9eP&_nc_oc=AdqVMa4UPU9NF7CJqq8Tgyr5_wMAMyJLOwxHf3037WOFzUO0fgHypbJZyUNdeZJJeVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdbWz86KBR2mAlIrxX-ivrBch59VGXOsAFoCL310Vfag&oe=6B048422"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": ["arcade"], "long_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!\n\nVektron Revenge is an old-school style shooter done exclusively for VR. The playfield has no limits as you avoid and destroy waves of enemies in a 360 degree environment. Watch out for obstacles and use the Revenge power-up to wipe out the toughest baddies.\n\nThe faster you can clear a wave, the bigger the wave bonus. Concentrate on grabbing the blue pills coming from enemies to score extra - but don\u2019t be too greedy or you might end up trapped in a difficult position.\n\nKeep track of your highscore and try to beat it as you become a true Vektron Revenger!", "short_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ludotex.net/", "developer_terms_of_service_url": "http://www.ludotex.net/", "publisher_name": "Ludovic Texier", "support_website_url": null, "website_url": "http://www.ludotex.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "279652464256159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138838_142524596110348_1678867768_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwRppy9fIi4Q7kNvwGBmxtp&_nc_oc=Adot8ocxobZE5kDjbvmd8Xuyqxh2zxLd9RQbcX6cvGkizO4S8XD5wJyGiYEn7n69qAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGiicymsJClohvbIerWNdyI_ZHd-4bHO3dEkj5VoRxpQ&oe=6B0473EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vektron Revenge", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "893648430670591", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "982771795100769", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2954925484569208", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162790_828904950511299_1465307977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdoQqFZnMD8Q7kNvwE8698_&_nc_oc=AdrYLSbSA-jIo4IimwsF2Pq3ad-kY5LV3IAMXLUBKD65kj9fMwCGJD60iqrtx_DwC58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiDM1tmDuaOMXqDOOqekd91y-paTt1mcpePkmMCijV9A&oe=6B0477F2"}, {"file_name": "migrated_image.png", "id": "2751392138314138", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162790_828904950511299_1465307977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdoQqFZnMD8Q7kNvwE8698_&_nc_oc=AdrYLSbSA-jIo4IimwsF2Pq3ad-kY5LV3IAMXLUBKD65kj9fMwCGJD60iqrtx_DwC58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiDM1tmDuaOMXqDOOqekd91y-paTt1mcpePkmMCijV9A&oe=6B0477F2"}]}, "id": "501824943845414", "locale": "en_US", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": [], "long_description": "Inside an old arcade shooter, use your gaze to defeat waves of geometric enemies all in full VR glory!\nVektron Revenge is an old school style shooter done exclusively for VR. The playfield has not limits as you will be avoiding and destroying waves of enemies in a 360 environment. But beware of 3D obstacles that come in your way and use the devastating shooting spray of the Revenge power up wisely to clean up the levels from the toughest baddies.\nThe fastest you clean a wave the bigger the wave bonus. Concentrate on g
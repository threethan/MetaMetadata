luscdn.com&_nc_ss=7f30f&oh=00_AQVtj_CpF3f3kTmBbMb7MT_65KGTsAcZ09EtMK2gpGLfXg&oe=6B1035F9"}, {"file_name": "migrated_image.png", "id": "955024041561780", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138837_1527002014291361_178614981_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS9VGOtJ1UMQ7kNvwFuip1n&_nc_oc=Adqa4dSxXPW3GhtojWIRK68OysCQc4JRZzzk7hI8YbxgOyUIwGDMz6UDvz3NH0hZX9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPN-ibYvoooVb0svVd8-zddQ3DmL3pelvSgytPSfl8-g&oe=6B105B77"}, {"file_name": "migrated_image.png", "id": "577727529802641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138812_849470321835283_1901550966_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEuFrVELM7wQ7kNvwH1iJNu&_nc_oc=Adoj8JUaFybTmwdtFSZUkeFx8eC1_wZ1KxR4Hq0ZF6BahSMIuHEB-wmz-NGv6r83LhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXw2xFedK1Baq3U4p8cC4LUjIL2888_adsBH1gwBXC7Nw&oe=6B105F1D"}, {"file_name": "migrated_image.png", "id": "2819678198111512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162739_1520752278218088_1871427277_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeqZFeUsQxAQ7kNvwFkeGDY&_nc_oc=AdqUFO4FPae_AKlaX8wHIz_yEeHfUp9LtaBr61hDUtEwVasyFVmAiiU1XUy17Gxb5Y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAm_9YNptVbEI_aWkp0TMxTde3oYN5RuM95oFRyG4sZw&oe=6B1061A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": ["arcade"], "long_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!\n\nVektron Revenge is an old-school style shooter done exclusively for VR. The playfield has no limits as you avoid and destroy waves of enemies in a 360 degree environment. Watch out for obstacles and use the Revenge power-up to wipe out the toughest baddies.\n\nThe faster you can clear a wave, the bigger the wave bonus. Concentrate on grabbing the blue pills coming from enemies to score extra - but don\u2019t be too greedy or you might end up trapped in a difficult position.\n\nKeep track of your highscore and try to beat it as you become a true Vektron Revenger!", "short_description": "Go inside an old arcade shooter and defeat waves of geometric enemies in full VR glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ludotex.net/", "developer_terms_of_service_url": "http://www.ludotex.net/", "publisher_name": "Ludovic Texier", "support_website_url": null, "website_url": "http://www.ludotex.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "279652464256159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138838_142524596110348_1678867768_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d0yh70rxs8Q7kNvwGaLpPT&_nc_oc=AdpNXU4N0DQQw1WgUrfRkfcg5sEBvQt3_zrW7xCFpzTV52-km6Dj6waWyPZ-DD7uwc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8rtDVvxUaXx-2kHhHxCljRsaCXYU3RZYR-Q_U94KyfA&oe=6B10516A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vektron Revenge", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "893648430670591", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "982771795100769", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2954925484569208", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162790_828904950511299_1465307977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KUc4Vvu-n4Q7kNvwFrFLHn&_nc_oc=AdoGLLPvXQyiRyemcgUOU0rEhvJT0Ak9uBfZtEc8C-_OyPYv4sus9ucB-S4YZ5DPJxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvJKYWR1ee8xzIxO6AAMGRhOc1Vd4OT4iARInF0QdsgA&oe=6B105572"}, {"file_name": "migrated_image.png", "id": "2751392138314138", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162790_828904950511299_1465307977_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KUc4Vvu-n4Q7kNvwFrFLHn&_nc_oc=AdoGLLPvXQyiRyemcgUOU0rEhvJT0Ak9uBfZtEc8C-_OyPYv4sus9ucB-S4YZ5DPJxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvJKYWR1ee8xzIxO6AAMGRhOc1Vd4OT4iARInF0QdsgA&oe=6B105572"}]}, "id": "501824943845414", "locale": "en_US", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vektron Revenge", "keywords": [], "long_description": "Inside an old arcade shooter, use your gaze to defeat waves of geometric enemies all in full VR glory!\nVektron Revenge is an old school style shooter done exclusively for VR. The playfield has not limits as you will be avoiding and destroying waves of enemies in a 360 environment. But beware of 3D obstacles that come in your way and use the devastating shooting spray of the Revenge power up wisely to clean up the levels from the toughest baddies.\nThe fastest you clean a wave the bigger the wave bonus. Concentrate on g
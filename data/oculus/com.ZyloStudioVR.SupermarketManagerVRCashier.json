/491824665_1487792089309714_5583784594401219185_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYMqBsu8Ms0Q7kNvwGCL0Aw&_nc_oc=AdrfzqTs8v6c4pYPp4-y7JqIKR6TTeic4lpZ7_1vAmV6CznpIb9DLiY12ZN7jvvdsTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3osqGBMEx_TcfUdBgjztqafsz5J7M2NZHwbjDz8bKyg&oe=6A95D62A"}, {"file_name": "3.png", "id": "4390889624466168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_4390889627799501_7916536329985661565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s47cOLFzQSkQ7kNvwF5QxNH&_nc_oc=Adp0hD1dVTrmqmHaxt4woJEoKDP-QGMlMrBS-xOFnYIPXMe0LRHy6i7ZXNWrR-moR_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWWiw3VppD-Wj6SHJbP2nLpgwY4srBgO5bCJ7r7rReKA&oe=6A95B9D8"}, {"file_name": "4.png", "id": "2092274378331528", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_2092274381664861_8432258229360240863_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuyXU06-LlUQ7kNvwEtzjMJ&_nc_oc=AdozMGZeAfhbKqID4u9qFPZZz_d6U0IJ_CB4w4nOxelApLrF_9NnwMJiHnlGOx1tSaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuxLo6IyVw8qf1lOfwkl_NnH3_VeyfzxLaRfOVWwtu_A&oe=6A95BEBE"}, {"file_name": "5.png", "id": "1158984636448569", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825345_1158984639781902_3709984766345639048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnM2mDZOMkkQ7kNvwHC9CV0&_nc_oc=AdpRDeYVFcTXCfCH1ANiGBEz6B1EdvRHfQuhXDvvcFmoiyiF2bnztd6OdodQrOkmSbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-szIQzsWmDbP1_RolpUmpRJ-WP8ZOxAJOI5Tgetntag&oe=6A95B711"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Manager: VR Cashier", "keywords": ["supermarketsimulator", "vrcashiergame", "supermarketstoregame", "cashiersimulator", "superstoremanager"], "long_description": "Step behind the checkout counter and build your own successful supermarket in Supermarket Manager: VR Cashier. Experience the daily operations of running a busy grocery store in virtual reality, where speed, accuracy, and customer satisfaction are the keys to success.\n\nScan groceries, process payments, organize shelves, restock products, and keep your store running smoothly as customer traffic increases. Every shift brings new challenges that test your management and cashier skills.\n\nFeatures:\n\nOperate a realistic VR cashier checkout system.\nScan products and complete customer purchases.\nAccept multiple payment methods.\nRestock shelves and organize inventory.\nManage a growing supermarket with increasing customer flow.\nUnlock new products and expand your store.\nSmooth VR interactions designed for immersive gameplay.\nComplete daily tasks and improve store efficiency.\n\nWhether you enjoy management games, cashier simulators, or supermarket experiences, Supermarket Manager: VR Cashier offers an engaging VR simulation where every customer counts.", "short_description": "Run your own VR supermarket! Scan products, manage checkout, serve customers, restock shelves, and grow your store in this immersive cashier and supermarket management simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr
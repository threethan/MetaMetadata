at=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkqhZaMP1h0Q7kNvwHAS_of&_nc_oc=AdqdpOTbvR-JC8Krg1nLzKGi8OcUDVzD2COC3epedcq7fzacFySYJr2ZNQyvFAmFM90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8Z0fJO-OMiyJmWNwdatBPTPSjzyFR-tT1abktULcOAQ&oe=6AABE160"}, {"file_name": "5.png", "id": "28698647926392161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_28698647929725494_3654937686002425740_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxUn3dwQQg0Q7kNvwGcDoqa&_nc_oc=Adr6_X52-93fwr3QJALGrzZoAooBousILXGUtTv40nphlHG9MnnqDb9-VtzHsMBWFtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfq8AUDi7NmDQnjUX66HgsIQy2X4VLrXfaTqE-HN8n1g&oe=6AAC0301"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Manager: VR Cashier", "keywords": ["supermarketsimulator", "vrcashiergame", "supermarketstoregame", "cashiersimulator", "superstoremanager"], "long_description": "Step behind the checkout counter and build your own successful supermarket in Supermarket Manager: VR Cashier. Experience the daily operations of running a busy grocery store in virtual reality, where speed, accuracy, and customer satisfaction are the keys to success.\n\nScan groceries, process payments, organize shelves, restock products, and keep your store running smoothly as customer traffic increases. Every shift brings new challenges that test your management and cashier skills.\n\nFeatures:\n\nOperate a realistic VR cashier checkout system.\nScan products and complete customer purchases.\nAccept multiple payment methods.\nRestock shelves and organize inventory.\nManage a growing supermarket with increasing customer flow.\nUnlock new products and expand your store.\nSmooth VR interactions designed for immersive gameplay.\nComplete daily tasks and improve store efficiency.\n\nWhether you enjoy management games, cashier simulators, or supermarket experiences, Supermarket Manager: VR Cashier offers an engaging VR simulation where every customer counts.", "short_description": "Run your own VR supermarket! Scan products, manage checkout, serve customers, restock shelves, and grow your store in this immersive cashier and supermarket management simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1215419404992218"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617813_1356499932705515_2746374968417497703_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHRzSiEJo2cQ7kNvwH-s9K3&_nc_oc=AdpLFPnBqWSr7rvjthn0EQpON_dFF6SaXUHY0CGQYVGGzArVVEdr-h4DePS2gb-mLjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILuG2FOFzxnWK2EVonNOy0V_xlvtLacAWw8ip15fYeag&oe=6AABF914"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Supermarket Manager: VR Cashier", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
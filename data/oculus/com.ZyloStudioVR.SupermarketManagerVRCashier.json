/491824665_1487792089309714_5583784594401219185_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB8uJ7FNfr8Q7kNvwGwO95U&_nc_oc=AdrmmgymsY0vrM_nCw86-JXVHFJhe_bMJKAeftuqWMyw-u6RuRTol47rJVS35Maphzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTQ7kZQKWS-rlHZNCc-jEpUqXPxS6lfBwrg7hVwrvGgw&oe=6A901FAA"}, {"file_name": "3.png", "id": "4390889624466168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823901_4390889627799501_7916536329985661565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Vb0HI5Af_EQ7kNvwHfRikd&_nc_oc=AdqWayeyEu6pr_NimWIBRu4e29Oi4UkV41U28gS4gzi2TB3bjISpPmQNw9mNabsSgvU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA4991e-9NeoQk-s2FTHabUA3t1ytnQFHEkLT0O9pahg&oe=6A903B98"}, {"file_name": "4.png", "id": "2092274378331528", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_2092274381664861_8432258229360240863_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Unch-wLORw0Q7kNvwEWkVFl&_nc_oc=AdqxKxLNTuUh-qaUx94kyffHE8ovRNokeBNgtFOIgNXxMOZUzbvDHx9EpFm1oEV5tkY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoJINEci6IbsP4pwpU-uTyobPM7ud9wgxgzj8QEzxTxg&oe=6A90083E"}, {"file_name": "5.png", "id": "1158984636448569", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_1158984639781902_3709984766345639048_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xN6tJ9EMfwQ7kNvwEVDKJD&_nc_oc=AdqLWNGyZI3-jHQk05bo8Pqk_j17UTCddzncGT9hvw-yLNXEbDfID-CmK-pVS8AiPbs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpeyAZIW1yBVTiez4k3_Vt16ICk6d0_6u0IDPq6oJXGg&oe=6A9038D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Manager: VR Cashier", "keywords": ["supermarketsimulator", "vrcashiergame", "supermarketstoregame", "cashiersimulator", "superstoremanager"], "long_description": "Step behind the checkout counter and build your own successful supermarket in Supermarket Manager: VR Cashier. Experience the daily operations of running a busy grocery store in virtual reality, where speed, accuracy, and customer satisfaction are the keys to success.\n\nScan groceries, process payments, organize shelves, restock products, and keep your store running smoothly as customer traffic increases. Every shift brings new challenges that test your management and cashier skills.\n\nFeatures:\n\nOperate a realistic VR cashier checkout system.\nScan products and complete customer purchases.\nAccept multiple payment methods.\nRestock shelves and organize inventory.\nManage a growing supermarket with increasing customer flow.\nUnlock new products and expand your store.\nSmooth VR interactions designed for immersive gameplay.\nComplete daily tasks and improve store efficiency.\n\nWhether you enjoy management games, cashier simulators, or supermarket experiences, Supermarket Manager: VR Cashier offers an engaging VR simulation where every customer counts.", "short_description": "Run your own VR supermarket! Scan products, manage checkout, serve customers, restock shelves, and grow your store in this immersive cashier and supermarket management simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/javairiabibi/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Zylo Studio VR", "support_website_url": null, "website_url": "https://sites.google.com/view/javairiabibi/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "th", "es", "tr
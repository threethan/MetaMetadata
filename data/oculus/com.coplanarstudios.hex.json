ile_name": "migrated_image.png", "id": "754339908637690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162710_719524808202043_5934526127300149248_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JagFqib0YrgQ7kNvwHPjqor&_nc_oc=AdnQU8ZT0YYvCt4W6AvuUHESR57EePoFNq1x4-rXZDFVV5ptm6YwEzHZJygLkulv0Bg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzeJDiapY0S4N9LfoHQFqneeFpPEOQR0bKakOZo8F2Efw&oe=69B55381"}, {"file_name": "migrated_image.png", "id": "212031286742032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138844_236493870113164_4829244756422819840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuDXXvJqgUQQ7kNvwE43qlX&_nc_oc=AdnBqBBAn5Tzp8GgpU5IsdV2J0mbPD0nMifuw0byOl8pvSIDnxD39k5JwEaoSU3BpVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNM49gbQvtNIqLULxxlRGKl24Q8WyNBk79cio5Q-3eZw&oe=69B5497C"}, {"file_name": "migrated_image.png", "id": "2744497009106411", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138842_1878218465740668_2415480360205811712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIqVHYXDu_gQ7kNvwH0XjZp&_nc_oc=Adk2RdBTI2cB0nw3XCzVgscPMvlzhe45-QAelDsIn8EB-viLuKDKx2Ghui6rLX_9ZiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxY--PNA533wIiKan8NzSiytxwuxeOthkn_s5vFvRrV2g&oe=69B5465D"}, {"file_name": "migrated_image.png", "id": "2623279807895343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386302_474741726053650_6090542583853875200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRO0Rx225QkQ7kNvwGdzIkQ&_nc_oc=AdkEHYHRLplbpxURyg4dhUq-ZSW-xaYtdwtlFzd_lRef7ToFECKr988cxLp8MZmjP2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzO9b_aVH9NXvQbZiNYt5TQwVN7jrW6SnsFlSgoC92_zg&oe=69B55CBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hex", "keywords": ["hex", "puzzle", "arcade"], "long_description": "\"\u2018Hex\u2019 Is The \u2018Tetris\u2019 Style VR Puzzle Game You\u2019ve Been Waiting For\" -Upload VR\n\nSimple but fast and challenging.\n\nTake on wave after wave of ever faster gameplay in this addictive and challenging puzzler. \n\n- Unlock power-ups \n- Manage resources\n- Discover new tactics\n- Unlock game modes\n- Rack up highscores\n- Keep calm as things get frantic\n\nThe goal is simple: make a line from top to bottom; but as time and space become scarce you'll need to think and act quickly.\n\nPlay seated or standing to make use of the full 360\u00b0 puzzle grid. (You can win either way)\n\nThe cylindrical puzzle grid means the action is always on all sides.\n \nCompete against your friends!!!\n- Discover infinite play mode to challenge your friends for the highest score.", "short_description": "\"\u2018Hex\u2019 Is The \u2018Tetris\u2019 Style VR Puzzle Game You\u2019ve Been Waiting For\" -Upload VR\n\nTake on wave after wave of ever faster gameplay in this addictive and challenging puzzler. \n\n- Unlock power-ups \n- Discover new tactics\n- Unlock game modes\n- Rack up highscores\n- Keep calm as things get frantic\n\nThe goal is simple: make a line from top to bottom; but as time and space become scarce you'll need to think and act quickly.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://coplanargames.com/hex/privacypolicy.html", "developer_terms_of_service_url": "http://coplanargames.com/hex/tos.html", "publisher_name": "Coplanar Games", "support_website_url": null, "website_url": "http://coplanargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking
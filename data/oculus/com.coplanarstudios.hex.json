tent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138842_1878218465740668_2415480360205811712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhanx3JRQA0Q7kNvwGvBHyO&_nc_oc=AdpxUEBv-VC2mZt2DeL2EVkc7Er_Ea6qLkCsj9BqEMadey-DopXwZLrC7zu0XDDkirc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkLecWQpFhsmJJaRoVQw3kltdNZGINSSN-MIqJtMnXOw&oe=6ABA879D"}, {"file_name": "migrated_image.png", "id": "672441403577460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386302_474741726053650_6090542583853875200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFd4hTz1PFcQ7kNvwFmuIf5&_nc_oc=AdqUYMciA9n9JbCauF2DbsDe3D0CY2lnsaXEw1U8NY5_MQaiWOXZuUhWCVJ9uhYDl5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmik5FEP0rY_AsNGqLTUC6IV41_jfJpTeUUbWZR_S85g&oe=6ABA65BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "355265658172105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386444_355265661505438_2967188404233568256_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLxQ8yFLwv4Q7kNvwFaOqT9&_nc_oc=AdqatiaFTyZl7DsGFzEE6v16aPMzuL4dTQ5UncOsFodx4I4q_1ijUF15NeTiJ6kpujA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvvv1Eu8w8Cu69YUWSwirsV1dS7wtYfpKiyW2WXUX7Lg&oe=6ABA814A"}, "display_name": "Hex", "keywords": ["hex", "puzzle", "arcade"], "long_description": "\"\u2018Hex\u2019 Is The \u2018Tetris\u2019 Style VR Puzzle Game You\u2019ve Been Waiting For\" -Upload VR\n\nSimple but fast and challenging.\n\nTake on wave after wave of ever faster gameplay in this addictive and challenging puzzler. \n\n- Unlock power-ups \n- Manage resources\n- Discover new tactics\n- Unlock game modes\n- Rack up highscores\n- Keep calm as things get frantic\n\nThe goal is simple: make a line from top to bottom; but as time and space become scarce you'll need to think and act quickly.\n\nPlay seated or standing to make use of the full 360\u00b0 puzzle grid. (You can win either way)\n\nThe cylindrical puzzle grid means the action is always on all sides.\n \nCompete against your friends!!!\n- Discover infinite play mode to challenge your friends for the highest score.", "short_description": "\"\u2018Hex\u2019 Is The \u2018Tetris\u2019 Style VR Puzzle Game You\u2019ve Been Waiting For\" -Upload VR\n\nTake on wave after wave of ever faster gameplay in this addictive and challenging puzzler. \n\n- Unlock power-ups \n- Discover new tactics\n- Unlock game modes\n- Rack up highscores\n- Keep calm as things get frantic\n\nThe goal is simple: make a line from top to bottom; but as time and space become scarce you'll need to think and act quickly.\n\nPlay seated or standing to make use of the 360\u00b0 grid. (You can win either way)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://coplanargames.com/hex/privacypolicy.html", "developer_terms_of_service_url": "http://coplanargames.com/hex/tos.html", "publisher_name": "Coplanar Games", "support_website_url": null, "website_url": "http://coplanargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2031486287022729"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1229785097217907"}, {"status": "PUBLISHED", "id": "759283550939313"}, {"status": "PUBLISHED", "id": "469491553390665"}, {"status": "PUBLISHED", "id": "344364036394048"}, {"status": "PUBLISHED", "id": "1422003954583209"}, {"status": "PUBLISHED", "id": "456859661779961"}, {"status": "PUBLISHED"
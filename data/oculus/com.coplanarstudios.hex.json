ile_name": "migrated_image.png", "id": "754339908637690", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162710_719524808202043_5934526127300149248_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JagFqib0YrgQ7kNvwF-B_8G&_nc_oc=Adkil1DpM6pHWKmK5j2qPEEQ-m6EGQrGOLi4W-MDN_XD4GwF7dhRp7oGE3Keuu9zuGk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyoaa9Fg6gpuHGInIG2-lP9B4IM-f-UDd4R9AvKAH2s8Q&oe=69B40201"}, {"file_name": "migrated_image.png", "id": "212031286742032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138844_236493870113164_4829244756422819840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkQthvHDAjMQ7kNvwHneweL&_nc_oc=AdlEWKUleYM25Xnc-4_JhuJ6R5fZ1auIhKzO2kMVCwpfRd3jZG4OnIGRf05UW1JUv-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmrtB0ebujjFxpf8FOXhy0FvB1SXB6CotROjRW8vxPpQ&oe=69B3F7FC"}, {"file_name": "migrated_image.png", "id": "2744497009106411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138842_1878218465740668_2415480360205811712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIqVHYXDu_gQ7kNvwGuRTRB&_nc_oc=Adkf7rdLlSz1Sx-VINCD44etE0xVyqg7Z1DZZfGBvN5pR_R60x1L8D0IcbtQgh_CTeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRH4X_CKlDmSVxqHHQWW1o-6x22MAOKpSLpNxdllT6WA&oe=69B3F4DD"}, {"file_name": "migrated_image.png", "id": "2623279807895343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_474741726053650_6090542583853875200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRO0Rx225QkQ7kNvwHe0L2p&_nc_oc=AdmOKfZwoQ2UV8CGPHNe3P9heVrjLK9aSP0fsRkyzEViCbj-U5hIcqVIAhXBSeheMTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwE2ltr8HWt87j5mqCuJVuOXAKculzsHdrjEgctf_K8Q&oe=69B40B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hex", "keywords": ["hex", "puzzle", "arcade"], "long_description": "\"\u2018Hex\u2019 Is The \u2018Tetris\u2019 Style VR Puzzle Game You\u2019ve Been Waiting For\" -Upload VR\n\nSimple but fast and challenging.\n\nTake on wave after wave of ever faster gameplay in this addictive and challenging puzzler. \n\n- Unlock power-ups \n- Manage resources\n- Discover new tactics\n- Unlock game modes\n- Rack up highscores\n- Keep calm as things get frantic\n\nThe goal is simple: make a line from top to bottom; but as time and space become scarce you'll need to think and act quickly.\n\nPlay seated or standing to make use of the full 360\u00b0 puzzle grid. (You can win either way)\n\nThe cylindrical puzzle grid means the action is always on all sides.\n \nCompete against your friends!!!\n- Discover infinite play mode to challenge your friends for the highest score.", "short_description": "\"\u2018Hex\u2019 Is The \u2018Tetris\u2019 Style VR Puzzle Game You\u2019ve Been Waiting For\" -Upload VR\n\nTake on wave after wave of ever faster gameplay in this addictive and challenging puzzler. \n\n- Unlock power-ups \n- Discover new tactics\n- Unlock game modes\n- Rack up highscores\n- Keep calm as things get frantic\n\nThe goal is simple: make a line from top to bottom; but as time and space become scarce you'll need to think and act quickly.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://coplanargames.com/hex/privacypolicy.html", "developer_terms_of_service_url": "http://coplanargames.com/hex/tos.html", "publisher_name": "Coplanar Games", "support_website_url": null, "website_url": "http://coplanargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking
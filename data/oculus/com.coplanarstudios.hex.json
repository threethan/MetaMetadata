ile_name": "migrated_image.png", "id": "754339908637690", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162710_719524808202043_5934526127300149248_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiXYB5pE3Z0Q7kNvwGeeJhP&_nc_oc=AdmRRna2ZR3oNUcrSUQauAs4D8iBgL6oPdWCiaC9HltrI628EUHl5KwRSvxdJ-3ddKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5HCE7trBXlRYI97MERJ75EEYHOCbmAJv-x_PNRTJrDA&oe=69A82481"}, {"file_name": "migrated_image.png", "id": "212031286742032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138844_236493870113164_4829244756422819840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNc6abff_DQQ7kNvwE3Ynqm&_nc_oc=AdkcUkWRcDnzniAEaoK7VChAttbs7Am-q988ClNgiU5i7BoeesKqxqrc9jK84f5J3vw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfswTTcZyP8fu0QqXD5ooizI-v-RvDZM6ynNaFrv3iKf0A&oe=69A81A7C"}, {"file_name": "migrated_image.png", "id": "2744497009106411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138842_1878218465740668_2415480360205811712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7hc0LgNasgQ7kNvwG4OOUC&_nc_oc=AdlNaeUgCLTK7LIXuXxiTPnycEsLPgDIOHjxs_HP_Nz-Bw_NR8raK8eNDRb0iLFSBd0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFkQCAh2fN9XPXHjLsYMXtIU5VlxrfI7J5xZ5LOok3ZA&oe=69A8175D"}, {"file_name": "migrated_image.png", "id": "2623279807895343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386302_474741726053650_6090542583853875200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqHjfu986PkQ7kNvwFO3NTi&_nc_oc=AdkrMGxVbxXQrFxCTLPsIzWfrIDFiDTv3bzgqhiIY4l71G90FW1N4QQlm6Xzv4rNEdk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftmufFmv75h2zCrBYPqYWTl_mcrT6r2aEvgHU1ynYJW9A&oe=69A82DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hex", "keywords": ["hex", "puzzle", "arcade"], "long_description": "\"\u2018Hex\u2019 Is The \u2018Tetris\u2019 Style VR Puzzle Game You\u2019ve Been Waiting For\" -Upload VR\n\nSimple but fast and challenging.\n\nTake on wave after wave of ever faster gameplay in this addictive and challenging puzzler. \n\n- Unlock power-ups \n- Manage resources\n- Discover new tactics\n- Unlock game modes\n- Rack up highscores\n- Keep calm as things get frantic\n\nThe goal is simple: make a line from top to bottom; but as time and space become scarce you'll need to think and act quickly.\n\nPlay seated or standing to make use of the full 360\u00b0 puzzle grid. (You can win either way)\n\nThe cylindrical puzzle grid means the action is always on all sides.\n \nCompete against your friends!!!\n- Discover infinite play mode to challenge your friends for the highest score.", "short_description": "\"\u2018Hex\u2019 Is The \u2018Tetris\u2019 Style VR Puzzle Game You\u2019ve Been Waiting For\" -Upload VR\n\nTake on wave after wave of ever faster gameplay in this addictive and challenging puzzler. \n\n- Unlock power-ups \n- Discover new tactics\n- Unlock game modes\n- Rack up highscores\n- Keep calm as things get frantic\n\nThe goal is simple: make a line from top to bottom; but as time and space become scarce you'll need to think and act quickly.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://coplanargames.com/hex/privacypolicy.html", "developer_terms_of_service_url": "http://coplanargames.com/hex/tos.html", "publisher_name": "Coplanar Games", "support_website_url": null, "website_url": "http://coplanargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking
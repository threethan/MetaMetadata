25/499620403_1130967936052567_5332974209195786322_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8zhm8aNl_oQ7kNvwGMwdua&_nc_oc=AdpkFMfr6hEuIlMx8ekYJnk_pTLyokeXeaxhoOaaDagU2jtgkU5Wl9vLogwj_YFePFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSi862hD3XCJGbN8pxWadZzTcFPdh6T2X2IHNqGYKHMg&oe=6AFC9284"}, {"file_name": "04.png", "id": "1596017661841340", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499626808_1596017665174673_3073097309504869325_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Af4UsHPYCIQ7kNvwFMMDB7&_nc_oc=Adpjy67s2xVFNe4G8owoKLykwXTKKMSZrm-ivwm5QHtugBC9dHlCUo4qnRaA15KnvuY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi68MLELQpNcW-WNcSJcvbgkF0GT-wr7vv8OrVZVgoYA&oe=6AFC7F98"}, {"file_name": "05.png", "id": "1105568052340970", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622186_1105568055674303_8896580561252290150_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TROoYU_Gip8Q7kNvwEpUBOa&_nc_oc=AdpXBA1vEjtaY_hD_SVWhPBxNFPxDLCBcsKH5ZBQZo6hN9vQYqbJA4s_HNV3pgovpu0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVsmhhUMAnlqpUkp6gxog6GYaKCcqOEGn17vGeAj8C6g&oe=6AFC8BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1666012254894613", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825497_1666012258227946_4385662696549007163_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTjVRBpKA7QQ7kNvwG5TWua&_nc_oc=AdqTCTFq5q2rP7gyvqnBlrwfz7QDkSizme6NL7gL05R8KQ9J4o2TY338I-2QB8x8Gj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrARSp50gG1jNOtbi1Y6EKbH0nVC1PpCZMxZ62M2Bg9Q&oe=6AFC8324"}, "display_name": "Conveyor Cars: Color Sort Puzzle", "keywords": ["cars", "sorting", "color", "puzzle", "conveyor"], "long_description": "# Tiny cars. Clever choices. A satisfying finish\n\n**Conveyor Cars: Color Sort Puzzle** brings colorful car sorting to a miniature tabletop world in VR. Cars travel around a moving conveyor, and you decide which color goes next. Match colors, manage the space on the belt, and find the order that clears the puzzle.\n\n**COLOR MATCHING WITH A TWIST**\n\nThe right color is only part of the solution. Look ahead before sending more cars onto the conveyor. A useful move makes room for what comes next; the wrong order can leave the belt crowded.\n\n**THINK A FEW CARS AHEAD**\n\nRead the waiting colors, weigh your options, and turn a busy conveyor into a clean finish. Every choice changes what you can do next.\n\n**A LITTLE WORLD IN FRONT OF YOU**\n\nEnjoy the charm of miniature cars and a moving conveyor in a tabletop VR setting. Watch your plan unfold in 3D as the cars move around the loop and the board clears.\n\nFor fans of color sorting, car puzzles, and satisfying logic challenges.\n\nChoose the color. Plan the order. Clear the conveyor.\n", "short_description": "Tiny cars. Limited conveyor space. Which color goes next? Sort colorful cars on a moving belt in a tabletop VR puzzle where the order matters. Match colors, plan ahead, and keep the conveyor flowing until every car is sorted."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
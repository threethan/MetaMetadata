25/499620403_1130967936052567_5332974209195786322_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1ZeGqGc4AMQ7kNvwFp5nWq&_nc_oc=AdpTvxyTrb2Hrtwwt9pXParNQGONkqORpyALkYQAXpFZzNy0X1LJBHEn1D5dx86UUes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2BA7q_UGLc8eF8MddaFYc3yx2wu7N5iTsSppvYFgORw&oe=6B047B84"}, {"file_name": "04.png", "id": "1596017661841340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626808_1596017665174673_3073097309504869325_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbF5EgdwubAQ7kNvwEB3BHm&_nc_oc=AdrZDBv0DvR2hPFs73T7Sd3lSho8mODwWLdipgTWgBK4k0Jf9z7dQSUA3vkrbqMDKOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFSk6QxVQFnvCmtLtxgEwHO_L_gxFEpp0yO_5KdpGUPg&oe=6B046898"}, {"file_name": "05.png", "id": "1105568052340970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622186_1105568055674303_8896580561252290150_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0nubTsgK8EQ7kNvwEGPVl4&_nc_oc=Ado3HtWauRUXH2vyGcc936uSIG4SDDg-FB8qu0bIF1ZmvrmydCN7YTx1lt0ztrJ64DI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSistHzvRjUfEOBB3PrMhFE0cal8-exC5WQxE95-f737Q&oe=6B0474CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1666012254894613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_1666012258227946_4385662696549007163_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjdeVnRPzv8Q7kNvwHhlo8M&_nc_oc=Adp5uBpCF24B6DFQ3BOUZV8ZV76RXCyJcP5xMFBgrrh8mMPRpXVGrwVXmcZ5z19zHJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv36ae1LKvtnj5I71BHHq7OYX70jz7v2iUvdKuc-Wj-g&oe=6B046C24"}, "display_name": "Conveyor Cars: Color Sort Puzzle", "keywords": ["cars", "sorting", "color", "puzzle", "conveyor"], "long_description": "# Tiny cars. Clever choices. A satisfying finish\n\n**Conveyor Cars: Color Sort Puzzle** brings colorful car sorting to a miniature tabletop world in VR. Cars travel around a moving conveyor, and you decide which color goes next. Match colors, manage the space on the belt, and find the order that clears the puzzle.\n\n**COLOR MATCHING WITH A TWIST**\n\nThe right color is only part of the solution. Look ahead before sending more cars onto the conveyor. A useful move makes room for what comes next; the wrong order can leave the belt crowded.\n\n**THINK A FEW CARS AHEAD**\n\nRead the waiting colors, weigh your options, and turn a busy conveyor into a clean finish. Every choice changes what you can do next.\n\n**A LITTLE WORLD IN FRONT OF YOU**\n\nEnjoy the charm of miniature cars and a moving conveyor in a tabletop VR setting. Watch your plan unfold in 3D as the cars move around the loop and the board clears.\n\nFor fans of color sorting, car puzzles, and satisfying logic challenges.\n\nChoose the color. Plan the order. Clear the conveyor.\n", "short_description": "Tiny cars. Limited conveyor space. Which color goes next? Sort colorful cars on a moving belt in a tabletop VR puzzle where the order matters. Match colors, plan ahead, and keep the conveyor flowing until every car is sorted."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
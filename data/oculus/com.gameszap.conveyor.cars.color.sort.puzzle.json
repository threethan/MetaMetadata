Oc_NaW2D2GbjquJiD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS42KF_ySn8pCwqzKPG5ZagrYTlQSVFOfsBZLbKc3_gpQ&oe=6AFDD118"}, {"file_name": "05.png", "id": "1105568052340970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622186_1105568055674303_8896580561252290150_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TROoYU_Gip8Q7kNvwE2cVLG&_nc_oc=Ado4gDobzT4CJVWL8Ux4KC7kSAm2mfuN4cZmVnWwwfaUUAhwQUuWc0Z8R_YDbujMo2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_dszCRE6M10JHzuaSIORHiIs31nxWjBF_c02oOMghlQ&oe=6AFDDD4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1666012254894613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825497_1666012258227946_4385662696549007163_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjAjH8bw6rMQ7kNvwH0jWt5&_nc_oc=Adp3O2UqAIEH2vr0cmsnRLznjhB0W0w-Yh_JJEiUbCT23tkwfWGU7jXytLs6L4Zw0d0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrr6VYVnO6ySG7OVdjAomFwAN-mvBx92wPt8rY4yhM2g&oe=6AFDD4A4"}, "display_name": "Conveyor Cars: Color Sort Puzzle", "keywords": ["cars", "sorting", "color", "puzzle", "conveyor"], "long_description": "# Tiny cars. Clever choices. A satisfying finish\n\n**Conveyor Cars: Color Sort Puzzle** brings colorful car sorting to a miniature tabletop world in VR. Cars travel around a moving conveyor, and you decide which color goes next. Match colors, manage the space on the belt, and find the order that clears the puzzle.\n\n**COLOR MATCHING WITH A TWIST**\n\nThe right color is only part of the solution. Look ahead before sending more cars onto the conveyor. A useful move makes room for what comes next; the wrong order can leave the belt crowded.\n\n**THINK A FEW CARS AHEAD**\n\nRead the waiting colors, weigh your options, and turn a busy conveyor into a clean finish. Every choice changes what you can do next.\n\n**A LITTLE WORLD IN FRONT OF YOU**\n\nEnjoy the charm of miniature cars and a moving conveyor in a tabletop VR setting. Watch your plan unfold in 3D as the cars move around the loop and the board clears.\n\nFor fans of color sorting, car puzzles, and satisfying logic challenges.\n\nChoose the color. Plan the order. Clear the conveyor.\n", "short_description": "Tiny cars. Limited conveyor space. Which color goes next? Sort colorful cars on a moving belt in a tabletop VR puzzle where the order matters. Match colors, plan ahead, and keep the conveyor flowing until every car is sorted."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy_zap.htm", "developer_terms_of_service_url": null, "publisher_name": "Games Zap", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1377184205479527"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1991030994919153"}]}, "baseline_offer": {"id": "1991030994919153"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793296800, "status": "PUBLISHED", "id": "1991030994919153"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "14076610
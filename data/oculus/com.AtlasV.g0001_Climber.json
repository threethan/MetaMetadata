kVkSHodg&oe=6ACA585C"}, {"file_name": "Still 4.png", "id": "1502663214152308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1502663217485641_1303957636592666148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDM-d_nznxkQ7kNvwGbCr0u&_nc_oc=AdqTql-oXFDY_GmNjKIqgRyRIeSafOq1kdpUbb82PSlBRgDWTLg6IF7DYn6S1e8uU7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyLII5Dz6dQ_P3Y45H4R5jMM5mcb0648oAR5yfN9Vgcg&oe=6ACA6FEC"}, {"file_name": "Still 5.png", "id": "25313603304928594", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_25313603321595259_2606772158423642131_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED3BLJG9fZcQ7kNvwFxKkkW&_nc_oc=AdrGW6A1HEj1QLUU2TgS_oL6_0jI0PaTjUYoEkl-FY34UXJrABhK1ZrFfm9_R7g_cjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1fCSOJ1X23Tl0C4Eblmv9p7-XmnqYQpreZj1BJSSZbw&oe=6ACA59BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Climbing Game", "keywords": ["crowbar", "climb", "mountain", "simulator"], "long_description": "# What will you find on top of the tower? \ud83e\uddd7\ud83c\udfff\u200d\u2640\ufe0f\n\nClimb climb climb! Get your pick axes and use them to climb as fast as possible on top of the mountain. How fast can you go?\n\nStick to the rocks, stick to the windmill, ride the ropes, and be the first to climb as high as possible.\ud83d\udd14\n\n{880297601360090}\n\n**Replay as much as you want:** the map is always refreshing!\n\n# Choose your climbing tool \ud83d\udee0\ufe0f\n\nYou've got the choice:\n- Pick axes \u26cf\ufe0f\n- Swords \u2694\ufe0f\n- Axes \ud83e\ude93\n\nFor now, they're all the same, but soon, they'll have special abilities.\n\n# Throw your weapon \ud83c\udfaf\n\nAim the targets, throw your weapon and gather gems!\ud83d\udc8e\n\n**WE'RE STILL A EARLY ACCESS GAME AND IT'S OUR FIRST GAME**\n\nBuy the game to support us! \ud83d\ude4f  ", "short_description": "Climb climb climb! Get your pick axes and use them to climb as fast as possible on top of the mountain. How fast can you go?!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1pPrfZ5laXFvFp7GRb2hVCki3BTI7vtvFEWvZWvnpeUM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26687679057566356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_2048152649304344_8975613659151717106_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cubUB_1o_L0Q7kNvwHWodBj&_nc_oc=AdoYB9WdKNt4i_kEUONDmSVXOEkgEwregW6HmNiDjIbCAxNTHb9F8HFsXUb7TvNsF1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMarE593u3irjL26Q2yIcZGgEw3af78Uiyfe4DZU1ahCg&oe=6ACA6D03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "A Climbing Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1766155320, "lastRevision": {"nodes": [{"id": "25207885965545680", "release_type": "S
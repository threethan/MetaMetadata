ord5-2.oculuscdn.com/v/t64.5771-25/491820208_894859832971571_3912143356685192795_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nqNWwXJUuwQ7kNvwF2AKcL&_nc_oc=AdoiKqTG_NxH1w791dSiCgHh_3_pxHXOQntP8eIUSacsGxCMnSZkCNIUvu36aQ5tViU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSspNVo5CxWxumwY3X_o3Fb4hankjV9HFLW5hjkjfErUA&oe=6B0DCD1C"}, {"file_name": "Still 4.png", "id": "1502663214152308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1502663217485641_1303957636592666148_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DC1ZN0WAsJwQ7kNvwHdBRBW&_nc_oc=AdrJvLj_OYjanLHw5Cxy2nT9wzKZUag-ptpsN72enWryKmV3Liz06WvyYWSHKTxFUMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6V6LfZ3Y1vOv0Gir5K24HgzgG7m7KvciMyzXlndluUQ&oe=6B0DAC6C"}, {"file_name": "Still 5.png", "id": "25313603304928594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_25313603321595259_2606772158423642131_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMEGJ32qSagQ7kNvwG1WUCz&_nc_oc=Adog80zcBn0N0VZCE7aiTqaeC09ZiRqtGW2vCoeoo8fMgr4KLw9hs1nlzBWziJO_4Kk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwLw_giSk5TqkbMuAqqPG1Xq8stXPVSxssxLBMizjZ-Q&oe=6B0DCE7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Climbing Game", "keywords": ["crowbar", "climb", "mountain", "simulator"], "long_description": "# What will you find on top of the tower? \ud83e\uddd7\ud83c\udfff\u200d\u2640\ufe0f\n\nClimb climb climb! Get your pick axes and use them to climb as fast as possible on top of the mountain. How fast can you go?\n\nStick to the rocks, stick to the windmill, ride the ropes, and be the first to climb as high as possible.\ud83d\udd14\n\n{880297601360090}\n\n**Replay as much as you want:** the map is always refreshing!\n\n# Choose your climbing tool \ud83d\udee0\ufe0f\n\nYou've got the choice:\n- Pick axes \u26cf\ufe0f\n- Swords \u2694\ufe0f\n- Axes \ud83e\ude93\n\nFor now, they're all the same, but soon, they'll have special abilities.\n\n# Throw your weapon \ud83c\udfaf\n\nAim the targets, throw your weapon and gather gems!\ud83d\udc8e\n\n**WE'RE STILL A EARLY ACCESS GAME AND IT'S OUR FIRST GAME**\n\nBuy the game to support us! \ud83d\ude4f  ", "short_description": "Climb climb climb! Get your pick axes and use them to climb as fast as possible on top of the mountain. How fast can you go?!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1pPrfZ5laXFvFp7GRb2hVCki3BTI7vtvFEWvZWvnpeUM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26687679057566356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_2048152649304344_8975613659151717106_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YAxyY4z2NMQ7kNvwGOZgwm&_nc_oc=Adpz3O3dJPuuj7g-KY7e8X2Wnw0YdcMAmG7jrHD4uZHBQXVuAJAalkQsJ7s9Y4qTLAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmdwhNjaVUzLN8-Fkqv_l1QjFSES3slKElfBNY6FcWPA&oe=6B0DA983"}, "
6A2189BB"}, {"file_name": "Still 3.png", "id": "894859826304905", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820208_894859832971571_3912143356685192795_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pytVh7nF6cQ7kNvwFEXKRo&_nc_oc=Adp5wmelFOi8Q86Ax6t42HBPpiv0FfZckuOMkpYAkRBWZfRSQ7-UCe7HMl7iOPJ1aoU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fdlEOTG6mRtFirBB_qNEn8c8DwhlgADfn796JrEQDaA&oe=6A21985C"}, {"file_name": "Still 4.png", "id": "1502663214152308", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_1502663217485641_1303957636592666148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-GLCxhua-AQ7kNvwGvmcRs&_nc_oc=Ado0wtME6iIZW0aZ-L75qHPV9CS0ugOVqML7TmNEQBp8YfYmmYOOD8eZ9MSkJHeDh6g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ii4v-3FPA6COoaBhp-wI0QQOy2vUQzSZg_dBAZvhQoA&oe=6A2177AC"}, {"file_name": "Still 5.png", "id": "25313603304928594", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_25313603321595259_2606772158423642131_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q03j0ZpA2wgQ7kNvwGWXEit&_nc_oc=AdpjMSmz5dyQowt7G4lGAlpjVNPQ6bCzvNeFOCnyIt6hbLQprvquWkyiDmrJUcUr9rc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F8LwHRiRz_eUnO_Bkv8Iw3vruQe-sFXZgWIq1uWXI-g&oe=6A2199BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Climbing Game", "keywords": ["crowbar", "climb", "mountain", "simulator"], "long_description": "# What will you find on top of the tower? \ud83e\uddd7\ud83c\udfff\u200d\u2640\ufe0f\n\nClimb climb climb! Get your pick axes and use them to climb as fast as possible on top of the mountain. How fast can you go?\n\nStick to the rocks, stick to the windmill, ride the ropes, and be the first to climb as high as possible.\ud83d\udd14\n\n{880297601360090}\n\n**Replay as much as you want:** the map is always refreshing!\n\n# Choose your climbing tool \ud83d\udee0\ufe0f\n\nYou've got the choice:\n- Pick axes \u26cf\ufe0f\n- Swords \u2694\ufe0f\n- Axes \ud83e\ude93\n\nFor now, they're all the same, but soon, they'll have special abilities.\n\n# Throw your weapon \ud83c\udfaf\n\nAim the targets, throw your weapon and gather gems!\ud83d\udc8e\n\n**WE'RE STILL A EARLY ACCESS GAME AND IT'S OUR FIRST GAME**\n\nBuy the game to support us! \ud83d\ude4f  ", "short_description": "Climb climb climb! Get your pick axes and use them to climb as fast as possible on top of the mountain. How fast can you go?"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1pPrfZ5laXFvFp7GRb2hVCki3BTI7vtvFEWvZWvnpeUM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://albyon.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25207885882212355"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2469980230123531"}, {"status": "PUBLISHED", "id": "1478459110521641"}, {"status": "PUBLISHED", "id": "660119950523570"}, {"status": "PUBLISHED", "id": "25550201077998009"}, {"status": "PUBLISHED", "id": "1976795129719081"}]}, "baseline_offer": {"id": "2469980230123531"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777300620, "status": "PUBLISHED", "id": "2469980230123531"}]}, "live
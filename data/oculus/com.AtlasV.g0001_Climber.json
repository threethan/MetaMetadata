wf5jTqt2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoKW6e1H1vFGIRoNBA_Qv3CCP8SWn53KabsupxED2nRA&oe=6AF3283B"}, {"file_name": "Still 3.png", "id": "894859826304905", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820208_894859832971571_3912143356685192795_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-0skkmDSG4Q7kNvwENJ-Pe&_nc_oc=AdpaBuaqI4VR2jAXBoJ9Myqtebd1UTsEp_Jq5fj-EEESllckFkrsbe-svYrMAnACbLk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYghy9nbNlNCa7Tog6Ao9v_uQ1ZfyUS5qE7ev7zEW3og&oe=6AF336DC"}, {"file_name": "Still 4.png", "id": "1502663214152308", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822307_1502663217485641_1303957636592666148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJkywvbDOWYQ7kNvwEI8Gza&_nc_oc=AdpW3FheCgIYAYwULSXI_VYILs1osqiVF9c-3ww3iHeCPAagbqkI2nG-XqmeaXuTOUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaPSATJfqkgqDj4z_Z-iKU0tnhl9bAvfON6M0gg1soCw&oe=6AF34E6C"}, {"file_name": "Still 5.png", "id": "25313603304928594", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_25313603321595259_2606772158423642131_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq6LKXHRN1IQ7kNvwHy2s9U&_nc_oc=AdpIWDi-OqIYL7n82c9fOrAon--iVlhN--XrGYirsvax84mXhMuoVKJsi-KvNMWzBOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3SR3u_6eA5rUqjsLNL38e_c24Q3iGWSfjA6KUIG2gGQ&oe=6AF3383A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Climbing Game", "keywords": ["crowbar", "climb", "mountain", "simulator"], "long_description": "# What will you find on top of the tower? \ud83e\uddd7\ud83c\udfff\u200d\u2640\ufe0f\n\nClimb climb climb! Get your pick axes and use them to climb as fast as possible on top of the mountain. How fast can you go?\n\nStick to the rocks, stick to the windmill, ride the ropes, and be the first to climb as high as possible.\ud83d\udd14\n\n{880297601360090}\n\n**Replay as much as you want:** the map is always refreshing!\n\n# Choose your climbing tool \ud83d\udee0\ufe0f\n\nYou've got the choice:\n- Pick axes \u26cf\ufe0f\n- Swords \u2694\ufe0f\n- Axes \ud83e\ude93\n\nFor now, they're all the same, but soon, they'll have special abilities.\n\n# Throw your weapon \ud83c\udfaf\n\nAim the targets, throw your weapon and gather gems!\ud83d\udc8e\n\n**WE'RE STILL A EARLY ACCESS GAME AND IT'S OUR FIRST GAME**\n\nBuy the game to support us! \ud83d\ude4f  ", "short_description": "Climb climb climb! Get your pick axes and use them to climb as fast as possible on top of the mountain. How fast can you go?"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1pPrfZ5laXFvFp7GRb2hVCki3BTI7vtvFEWvZWvnpeUM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://albyon.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25207885882212355"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1614251310382592"}, {"status": "PUBLISHED", "id": "2520174065130176"}, {"status": "PUBLISHED", "id": "910776298024802"}, {"status": "PUBLISHED", "id": "2469980230123531"}, {"status": "PUBLISHED", "id": "1478459110521641"}, {"status": "PUBLISHED", "id": "660119950523570"}, {"st
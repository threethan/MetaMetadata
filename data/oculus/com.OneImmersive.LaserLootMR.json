142_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJKiFF3gpFgQ7kNvwEtwPCu&_nc_oc=Adpp3ZY_RRojOlybpRdfS43t-iCYbJGQF4r3uS5hIQFh9m0N6ToCH9nhXgpGvca7mgs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIRrn9pFkbLuoPPIK3d8Juc5GBI55g8LUl2ne5j0bowA&oe=6B1036A5"}, {"file_name": "Laser_Gameplay_26_2560x1440 2.png", "id": "2824669137918637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628446_2824669141251970_5524847859077873757_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnxpDl2VD-sQ7kNvwGV_CgA&_nc_oc=AdqeTjKoe8Lj7FOBalhjJ68ds7C2lxUuyy5zTWNeMnvMmJIXlX9-CyTw6LPBZZ2aOx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdFC_x-Uv8NLJ_4Sw8waz5Okx1xDlcQOuz7rOek2IQTg&oe=6B103608"}, {"file_name": "Laser_Gameplay_23_2560x1440 2.png", "id": "1770722240842509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620532_1770722244175842_7536657590794162319_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXq2qRfU1OEQ7kNvwEdYWE3&_nc_oc=Adqsfa9qPT0eeykQq_1KUw7XAJCVykV5iDA06j1N7KzVGbmRzAb5tEqK-QuBSZoYT7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4Knm-pbkF0QhoaBM2_LRauOMtUzsHzuNC16_zDemK5A&oe=6B1051EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2560x1440 2.png", "id": "1980094796002798", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1980094799336131_3408320219491815945_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQltOue8QakQ7kNvwEhrNm1&_nc_oc=AdrpOydkuigPMs8-lSG274F7yw44iwN1a9TZohyR6doz5Nxn2BBblI0Q-sgtkmwi52Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWfrZgiv_8H2pQkFBHFvW3bVC17uQA91eoZSddME0VQg&oe=6B103603"}, "display_name": "Laser Loot MR", "keywords": ["action", "fun"], "long_description": "\nGet ready for a fast-paced mixed-reality action experience where deadly lasers turn your real-world space into an exciting challenge!\nStep into the game and prepare to move, dodge, and react. Lasers appear around you, forcing you to stay alert and carefully navigate the space around you. Your goal is simple: avoid the lasers and collect the targets while surviving as long as possible.\n\nAction-Packed MR Gameplay\nThe game brings the action directly into your environment. Instead of simply watching the action on a screen, you become part of the challenge. Move your body, change your position, react quickly, and find the safest way through the laser obstacles.\n\nCollect & Survive\nKeep moving through the challenge while collecting targets. Every successful collection keeps the action going, but one wrong move can bring you closer to game over.\n 10 Hits. Then Restart.\n\nYou can take up to 10 laser hits. Reach 10 hits and the game ends. Restart the game and challenge yourself to survive longer, collect more targets, and improve your performance.\n Made for Mixed Reality\n\nMixed reality makes the gameplay more physical and interactive by combining the virtual laser challenge with your real surroundings. Look around, move naturally, and experience the action from within your own space.\n\nJump Back Into the Action\nThere is always another run to try. Restart, improve your reflexes, avoid more lasers, collect more targets, and see how far you can go.\nAre you ready to step into the laser zone", "short_description": "Step into an action-packed mixed-reality laser challenge where the game comes into your real space! Move, dodge, and react around your environment as you escape deadly lasers and collect targets. Test your reflexes, stay active, and enjoy an immersive MR experience where every move matters. Get hit 10 times, then restart and jump back into the action!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://laserloot.noodlzxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "One Immersive", "support_website_url": null, 
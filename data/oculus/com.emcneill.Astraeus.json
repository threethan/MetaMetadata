083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWVfwFK2h6YQ7kNvwHZpsQI&_nc_oc=AdpUdUpC6hi4XKC_qvF6SYNyUSlbfQj8wctTexsdVCmjZ7gtTF8P78vjTkaFpPU06Pw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUQfS8YCvqg-tYnfga4vR_MDrVm8ULO0trICe4Y0YsRw&oe=6AC90829"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHKXEn4ZB1gQ7kNvwGL9fXx&_nc_oc=Adr7neis4Wzxu5y0e5r_2KYhYvtrQl3K5tvWBCYYoO1jYwcM5S6rSTf_0K_cToRtNyI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYu_y5oW9aL3bm1_BiCpMS2JCu9BiDDHuVfdpgYVSVnQ&oe=6AC91ABA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d81NiCx9xvgQ7kNvwHkwGJi&_nc_oc=Adp0VWR3uPy4NCElchW2KY-HsDnha7JlAlOlT2eSCzxt8ZWmDEweQBkRWAUbYXew1NE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkW19OnDoU22WDXOCpHkfCSXbsqnUoqqL35e3OGACSlQ&oe=6AC90D6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKTX8hp9pB8Q7kNvwGj0_pW&_nc_oc=AdqZ8X4FX5htqxGFGgLpW486KHAY2ByO82iHLQKy18dFykZzio4uae2hxYdp_1nR8BE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTEmvuZpl6wmUSxp_GzDlJjYxw5nzEopB6QibjDJ7J9Q&oe=6AC8E4F3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3
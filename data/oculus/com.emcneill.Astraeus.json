083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuJS4bWqOWYQ7kNvwFgxtsB&_nc_oc=Adr7YM26LzuhR_VrXNpAf12Gy98NnetvTCy96SS05qtQlhDIbtnswshLj-sry5pn4-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b1obOtF4MSAS5xU5I6haBAbJEKPmsOZ07mdHqwhE6SQ&oe=6A15BC29"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wds-Y8FnxsQ7kNvwEqVmJI&_nc_oc=AdqgprHb5Z-_3x86x6RbkAgVbfszmnfjAL_XLevTMd4iYN-tTwZYj27u_uPpy81zU84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LtD88XwM6dV1u4ATLmPxg5wVeWSgFn_3pRBW9tk0UGQ&oe=6A15967A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIA_9yqQA0IQ7kNvwFCrqRK&_nc_oc=AdoIrf-SO5lYavwEt-zUuUgot-FT0gkdaMJ0R7Q6q3OKhDRDJTARDXxJqSlS4ofKUGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Gr798Yzl6X05T3p7q-liHGH6jhu0sV0zBJCguD6IFdw&oe=6A15C16C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhYjPloERYEQ7kNvwFz3y7h&_nc_oc=AdrfKUhX8J_X27OV12s8Z8lQR913rzlw1Mjm5HFktQeENgFIVw7envHL7j-TviaYPwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OMpd0UCq1YQhKh5IfbKmyoV1BfQoWbHeWP0oDeWDE5Q&oe=6A1598F3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1
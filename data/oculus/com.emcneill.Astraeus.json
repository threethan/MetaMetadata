ng?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GGYhJI070YQ7kNvwHJw5xS&_nc_oc=Adkg4XINWa7ktVaUBz5D8CXjgVt6EUrJl4fV9sxc-My8zvsjihTly_TFBve0D1u7Sok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyR-oYk0Od72FINjD9nmCSBNBLh70ZshX22s6sIpBH7MA&oe=69B2A369"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rS4Czr9VIAQ7kNvwHtZPkB&_nc_oc=AdncxFWnoADlM7wnojl1dGVyEETFwQFEDCI6mxsdvaFJI_LU4JxB4bzBvGqTGyu8c-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzU-XIQvGTdtuTSrvcbo7U8wBoZnZCzf7zB5GfgKSnAhQ&oe=69B2B5FA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWzgt_IpcHwQ7kNvwHcvpIi&_nc_oc=AdnCEsohh0FREonAjMZ2fzzGfgCtgVkqazafzINeBAqVTi3Zfo0AzzLXtp7aeARGqFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy37Jy-JtPVI54gq8-nrmJ5o00kX1-N9oPy9Yb_sXXDaA&oe=69B2A8AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfO8rrNOjVIQ7kNvwEp_kSt&_nc_oc=AdlHxunXJPAqmzKljFbtz2zWULoD8JLY6bF4jz-B0JFkfeFu9IaqzFeRz0nI_88M8Bc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwf4CNo9ZR0MYVo4mm4xedcfdgCc1KMLdKQmjDdaIq9Yg&oe=69B2B873"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449084_16969202690776
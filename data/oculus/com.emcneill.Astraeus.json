083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGd0QBgJVmoQ7kNvwFgjtMo&_nc_oc=AdpEtWj2FLt8iM4EVtfDIHCeNcDL4Eega1q3OaAqoUbybfDHpvZYMjj113M5kJfRVwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSgCdocpYJ6zCt5M3tXomcuDnuhw8uP9HhttPPFTPYFA&oe=6A5F57E9"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JL4PDRuaI8sQ7kNvwGl-vd6&_nc_oc=AdrQFggtIR8yfF2zoU75oNq4v59BeSmzGZ_kGdxPtOQPcmTdtE1lcd9A5COkTT3Fgpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKcteK_Y8PkO28FO7_c1JMjptvL4EMXr4iX-i2vx2a3A&oe=6A5F6A7A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkXuRD-dunoQ7kNvwGoh03d&_nc_oc=AdruedtjxSnjlerj2NcN9s86hGp5_y8MSWcP3hhjEdTMuRyNf5r_jDOGcO9RvO4Ppp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-l9cxIy8xjS9VC260ATTqcYi3ItIbH0zu3DWdXL5JiQ&oe=6A5F5D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVlYhTlczzwQ7kNvwE6KUfg&_nc_oc=AdoEaLwvlOL-EVp2YBDCGSRV5ev4-VTx1XNjpGjQ5F2nsiff_xDeNi2vkz09GiKf1P4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ7hJ33Ktsh3zTJSLNyqM2FhVA8icV_9uqK5xiH7VIsg&oe=6A5F6CF3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2
&_nc_ss=8&oh=00_AfxcIQglj8DY7q6yVTn_uPuP8nTa7yXkT0m_nBif3EShPA&oe=69B012FA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buts8OMiBl4Q7kNvwFHHGl1&_nc_oc=AdkA1BgEDBzcTtjUF90hISEBy-RrkVGs-K8kyvDkYBV0NHaGT3D1AK24Ru2FXajkj9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ1DPlTAEnx3HmJu2FkklLGPsMHNjZAza-kgf1ulEBrg&oe=69B005AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfO8rrNOjVIQ7kNvwFVg8xD&_nc_oc=Adlv8rh2JlvPYB1wCuhsQF8c-tSrm8i3sykzqdBqbd71xpqgDy-p1ApE2jgWKqJtjWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2QL_OvWc9GX_LLZz-5yMyaKnsuI4etb-8fiuqlJqGrQ&oe=69B01573"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "370762153444897"}, {"status": "PUBLISHED", "id": "2078366582292477"}, {"status": "PUBLISHED", "id": "718804898552267"}, {"status": "PUBLISHED", "id": "449382882621399"}, {"status": "PUBLISHED", "id": "1857819477681004"}, {"status": "PUBLISHED", "id": "1101134976736668"}, {"status": "PUBLISHED", "id": "857903467734484"}, {"status": "PUBLISHED", "id": "1232057503586263"}, {"status": "PUBLISHED", "id": "565634907301947"}]}, "baseline_offer": {"id": "857903467734484"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1528995600, "status": "PUBLISHED", "id": "370762153444897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "b
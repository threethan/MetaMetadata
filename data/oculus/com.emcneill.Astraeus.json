083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5wpLz6gqEsQ7kNvwFyca66&_nc_oc=AdrfVI01dFsOAT6Fxchhjm-669Y7o5QiVC2TEd9L5Ld5ct4p27Lw2L6e5FdeUhDhWqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXARfyVnUaLcvq2yYpl7fDzwUbUARWI-0QTDK0Sh7OOg&oe=6AB3F029"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuBCBlKoi-kQ7kNvwHeSYl7&_nc_oc=Adr7-tcq4EGKG6k-4XGhV9TPa_r87JhBPx8_tSoqSVvt7igmdRezrZBxgzMS5bFvKnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZh1cAcy-ufFTu15_q7ZkyKk7_gRdFYn4dHIjBWRjUXA&oe=6AB3CA7A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEnNd0piEDQQ7kNvwFMMaW4&_nc_oc=AdpXqiNUwO9uDoah136hEYLOeYcGyYrELoLPgDzfND2_bEF2Aw2kBUtI199E-kcjZAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlHAPPBygzcOcQ-NyIfMxG6RFlIIR12c7IbMdBNxt7JA&oe=6AB3F56C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XI66IHrlCI4Q7kNvwGDkLxt&_nc_oc=AdodaPQ4Hp7rDQiXgDB4qELONPX-0P9_klW9nVvDGqYMw33KAmM7vD_TC_-9d7oNeLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL48Qeqen1PGQ7FKFEkU1lObUlYo0vJc3sYQcAqHv4DwQ&oe=6AB3CCF3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2
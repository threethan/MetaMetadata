083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOzpGg0AF7cQ7kNvwGag0fu&_nc_oc=Adp8K2_s2S9dsaEmW9AFKTVTAjAFrrJiMYKRozO3hige1PXxhJ1gssb1y9MA4xnX6Sc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--Yb4VrxSoY8MXwEY5c2pk_8yREV086NFd8wgISBpjIg&oe=6A2C25A9"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNVr4VqC2BEQ7kNvwHzydDy&_nc_oc=AdpDGlqsb7cP3tM6eZUj4fnr63YFToZ1pLugFDE-CAwjdxVqX2g1HCTMFP4iI85MpV0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7DGRJqStUlXqk6wXLQ_KPmS0yNKwBkSgwuYXYKBn_GA&oe=6A2BFFFA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIDGNB1llYQQ7kNvwGQg9DK&_nc_oc=AdoNa633Qw94dWi5-Q_4mDTc8jLBPdIZfGHHrSl9XTb5Wrqoi8pdXYX50MNg-ZL3s3E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ObFVbLTT7nBbmm5y_4nG5vWjBqSNQVRYk83XayxAKJA&oe=6A2C2AEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTxZEiANmxAQ7kNvwGwkX0x&_nc_oc=Adov5gKyc8gQcFNl7Js-gjUrdwTK5GoTmRVQwItxfcCRpLm2Uvhvf-4vpP9OczWVhm4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cAorFsLl4yO1T9nH6YetioCnsF_HKTvsN2Emsc_Ewgg&oe=6A2C0273"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2
083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQfLgi00DmMQ7kNvwGEkyFB&_nc_oc=AdpSA_kUIT8WpUEY157cFHsdBKWJ2NU6UeiGWEOmKLf2Z-sp7a15LsoXA8rrp_tr4HM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAyn_MtS3Pw6bvR5E55a0WXD_aPE69pls2B-_Zn404YQ&oe=6A972769"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXTAk8MNyjIQ7kNvwF2o9MB&_nc_oc=AdplLRbQWQ-fWn2Sr9kqtQGmWf53icFTu6XgVKw8TE_xjsW10djdnK7ZaARbNGVQicE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFux5wE104iSqUFtJvPNXpFrn93da7b58bIvq8tZM4nUQ&oe=6A9739FA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G45iNp3x3PEQ7kNvwHwdjm3&_nc_oc=AdoI9fgikBQ8iFYixqYXcy_uYXS9vZb2P_yJfW0IpaDk3MeMHDPqGJuF2RlzlaImgaI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEji6Q_dWwpcVJHaJq8c5Js5tc0Wo7gn5a70rsJ-Hbodg&oe=6A972CAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvq9W1r7gj8Q7kNvwHK4MjC&_nc_oc=AdoL5ev7E4sSDqVEAtA9eWdJMhDCuafxjYU3QrDWC4J_qMyu_v7HJV68xVbn4dm-1sE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELSuWR483nI91mViL2wjAvcmWTgU4NBpuqwKLg1ejezg&oe=6A973C73"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1
083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ys1ZST1V2U4Q7kNvwFbDBEs&_nc_oc=Adrp1bH4Ijapc7HBzfrCwLoRKeMLncIRCIkuOkZec2mG1aPd0zOs_6OPri88RR5AM9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WZUi8gsvrnffbvBAiCulwu-C6OvzYB7igLFkZZXEsbw&oe=69EB8C29"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG1uP_Tu66sQ7kNvwGvIOWN&_nc_oc=Adof27bngCiQIMi8oS9HVZwfN6OiAHk06BQF3vbhc4Dwp9YmE2WPGsawif4Oi8CbPlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1opN5eMzlY0Gw4sRr4Lj0TAvBINNKcm6VU9ttnLWIxyA&oe=69EB667A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-2_gVnAIfoQ7kNvwFEFDz9&_nc_oc=Adq6Ggfs5F3accjOpgvWEUmo7LxNFHTs34k8UZnY1czVAAweoqRnkE1DuCL8E2uTIl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08pbAm9GL3uJ4B08XyaK1mbvzEEIGMLszdwg3XC3axVw&oe=69EB592C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhgHnUsjP34Q7kNvwFmpDtI&_nc_oc=Ado7-hebtGqJtgAJ96cavw0OcolIValCMzJWQ0KuV1dKqiwO9Xx6MD_Ax9XbKZcXhms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ALOnHoD5rZwvIAj9mvrMqym_fyRwID2fqgO-gn4MstA&oe=69EB68F3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2
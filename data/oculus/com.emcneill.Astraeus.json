083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4MZj3WE64sQ7kNvwEt3k-s&_nc_oc=Adr2q2JbIxCghq_3icWfYMUwOBylFg1y9mMk-2a52SjDggBVGkfTY_BGIj3pmNndeVs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnJRI_obV0HTNowfNCUX0oLTOGLNW1qdqbsNwfDluA_w&oe=6A65EF69"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKHXCd9IR2IQ7kNvwGBEiUw&_nc_oc=AdprlX3DaN-A3teqYNCy5NqLheZf5cQAGU2iy0ezGUtDllkGwyu5_14VaRUy4RUAgoQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZy0-syoxiXcetod0UYuKXkUIU_raP08T7RI8Qx-5LVg&oe=6A6601FA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pYX3r3w3l0Q7kNvwGgmvVM&_nc_oc=AdpzRdwAaV2AtcpY2h_cHlVpFEwdN1c4_NWC8WPjPeLlkfdU_vB1-ZuUeWvmvqZ1w_M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADIAeFMVhygeKLrH72bGZ5SExTxdtfp5Z5I_qLOuxwQg&oe=6A65F4AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LrbjN0jBZQQ7kNvwH7sQH6&_nc_oc=AdoOjFwiWr70a0g24QTqk7Dd8aaSFltfnNCGd2dJGf7u7GgxTvjjK8bjickRCRLifgY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxQ_iG5YvwGkPuJRVicWQvFXJ3xWj9WKNgkh2tCZ4F2w&oe=6A660473"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2
083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGd0QBgJVmoQ7kNvwEk09Ys&_nc_oc=AdpOjxxJV0QTkTF-WhR_UG1rRXM4q-N4P7RCdXMYKpON1xDPeBc6r-Ak5FkCz9dKNvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ3O2iCnq-NGsV0HHTHMVz4hgbLBUvdDmbDqs2RtbqYw&oe=6A5E0669"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JL4PDRuaI8sQ7kNvwEX5j5_&_nc_oc=Ado_Qy-XNUV9o0NhL5SoyuokmG2Fe39T39-Dx9wPOJ9qw9w5XUnzF7AZJqlvRMfuhVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5pBOvL1-RH3o8N3iaON-iPf8_V7a_zyLPuW-zfjvSYg&oe=6A5E18FA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQbGHbmERzgQ7kNvwGoJguU&_nc_oc=AdoPW4DchDxjCg6UPBd2Q99Uhpr6z0viM6_jD1Bvo3d83dt906UgM6sH8nt-N4xMHrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjmuRznznJhv9zKEh65ARVEcXSZ_q9ZJugP0SX-cUStg&oe=6A5E0BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVlYhTlczzwQ7kNvwEVXBju&_nc_oc=Adp1D73-KRyhh3VI5iVwUIHbUc-Z030vLoBXbDnYlVk2sIq_zt9fe5NWjJ9OGt3E0oI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtdLevDb8M5xplXkUJa2XFEiHXvEAHVO_7OG2M9jk3Rw&oe=6A5E1B73"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1
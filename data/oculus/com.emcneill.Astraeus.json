083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbwONNSiU8sQ7kNvwFtXl_p&_nc_oc=Adq_-_HxmUiHQlPotvbmo-Kre0i9Fqllu0t0GY3-PHoNZpyAaQ5NngmvIAKdF22n6Gc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28hkn9hdtHO68nmzumuWlhEtViOTizK3wZyFiVlBG2zA&oe=69D78D69"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zNY8AQKRSIQ7kNvwFBq-NX&_nc_oc=AdqDzk-U5M7hU4GIVNsLJLMdR4A28X6CJvWWiVyyLHehn3sk8aRtwZRvzFYneC_lc7Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H2k9jzH_OGszX0RJzTZexC56aIVvyyEkafSvlFIz4lw&oe=69D79FFA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoCkdl3_okoQ7kNvwEwgbI-&_nc_oc=Adpb9UucYhxIW_IMZ91_AyYojZBd2M1ug2C91eMv9WHNXeabt1Lyaq_aCIcGDkHDXsA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LME2Ry04VtzK-QR6jYH_jEkuRg60gfy_t9iF7B-t-zg&oe=69D792AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KBy-ZjMo6IQ7kNvwGLwj3E&_nc_oc=Ado7QjprecscVrZe58bV1W731hhOcLn9a70c27YXR1RI3nfS_BPydN6GaICHJ-qbDzM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2t31Vq_TGtvlcGS04_RZxslauOhMWIiCgpOajvHvzQIQ&oe=69D7A273"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2
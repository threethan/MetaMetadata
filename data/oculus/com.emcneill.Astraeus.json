ng?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNJvuR8ADiwQ7kNvwGSaB40&_nc_oc=AdkRBs8O5RRTeIjhZe__1J3dRPFJEieh_L1-6qZO5CBUWLgDosTV9ULKeHrMAN-Nlso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFwDKjDfA9ry9sjKjCbXFP_PrVeTshfbgINbUpSoVRuw&oe=69AD5D69"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GLf_Tox_XMQ7kNvwFqLh9j&_nc_oc=AdkgSq7LOU5nRd9UJTGjjFdwJjxbehL50J9WFPBrjhjuYthVxF3OXy3AYXjftBTumTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8nL72HGCoe7D0ML8GnrTR-HbCqomMhNZhBGA2NKAQfA&oe=69AD6FFA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buts8OMiBl4Q7kNvwFhXZd_&_nc_oc=Admou9j-bDOqAJWFCHZDj5z07Ji3ng7uh_RH2q-YW8dXQ3kx8-i2hD3LYlvOEqPZ2pU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSAX2M9_hqYnCciubey8YW8R_8qNzkDrfsOWXOL63_-A&oe=69AD62AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h5MDWW6VUYQ7kNvwF0_M71&_nc_oc=Adl4len5R9faqzuOvYi1FOqiX8ZPYhEp2MsIXfbXHtGxNqFO8ceQLA-Hq35ujdQ10ec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1KZPFutXN9CVKFCXMWcTQMzsj2k3v1mfffpuf8BkdAg&oe=69AD7273"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449084_16969202690776
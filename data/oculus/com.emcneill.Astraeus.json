083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlHmgnlQGQoQ7kNvwGMnf3e&_nc_oc=AdrB2hIxTU-6O64IAdHKI6CvcN6kds2YIa44axn56RxoxQ-1o5PBup7PsJdk2el20XA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9081TL7IsgVscqHZ0OnczOXjpfLARuigRBNy9jcz0jig&oe=6A301A29"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1aAZQLUtIsQ7kNvwHfVOsR&_nc_oc=AdrDQTK89Orcdy7AYQtN5AR0rpe5B4lbTz58Eg4_A0GBQ7xhjveaPefgr6VvZUGFnjA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K3nH-d01cRbYz5v2BGfFOL9QTdR709Xkbj3o3wB9_sA&oe=6A2FF47A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGZT5bCjWQcQ7kNvwH_h1Ip&_nc_oc=Adry4KBoG9qGIGemfqbt9-qk_voe_wkrWJwzk6MZBVs_IewLBlVan17j13-LGSBsEnw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wnxb1UlOzzjPpeKlj2qIaMYjS70l-AkWX9KtkH4EVIQ&oe=6A301F6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsfUIsWopasQ7kNvwF2N1Qm&_nc_oc=AdrCC6YRf7TgeQawjm_Kl6VkbfBodpdsgW8FXLGkEk4TaW_yCkTI5E87ZkyYpdqXgiM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gc3a3LlThfCRv9OZDX4qfP3m6x2fcInccemlDHHYY0Q&oe=6A2FF6F3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2
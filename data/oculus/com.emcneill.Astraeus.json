083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C70TSCVbr64Q7kNvwFSWXcr&_nc_oc=AdopF0SQC2qZ_weINe23N2t3VKgNoc4SPWq93LxJvvWnG4GYTZ7PCt7DOpMUzpigHuk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWcKFL3pHKZ6SDaU0RvsFs10tml11O1rRw9vy-rgzNdA&oe=6AA17B29"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YeOM0lW4d0Q7kNvwHCrr_I&_nc_oc=AdpS2HgRJhT3Ml3UCGtAelzPbk81jGHEM12mrnqO2Q5rS7HBTks97Y_sJ6Y9M4j7acg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOf3VhtrmXeS6RyPvypBq3o4pcGCCGzzIOQ-32M2SnKw&oe=6AA1557A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nwTL2nN5MUQ7kNvwFGlRsp&_nc_oc=Adow1wQazR6DFup47FawMJ-8SxIM20B1kCxLZ8gT1sfy-AtXtoQ0EaKeeeDNpWXEpgc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI61t13Grj2xBlU9wW5ABg8YrC_SG6hfxC6NFzghPsTGA&oe=6AA1806C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq03Ru2ifYUQ7kNvwHdQUSN&_nc_oc=AdpCCMF3kHg2SjDkvx6hzud3BwjOGX-5U3wSWbmuBXvTZ1Z5z9COaxFRRPbBgZXp52c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-Y1loZeAQw51j6wtXh77c0M8WHULOviUtxJYxIIovtg&oe=6AA157F3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3
083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQfLgi00DmMQ7kNvwEfRKvg&_nc_oc=AdoUKsAHZ7esatsdQcoh3fulejr6rYQPdN-gMxK9KlU67Cz4cjEmqn5ESnLVYXBIb3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMELplMYOLRWnRkxNoS-F6Z-FOSVQniRicPE1QSYs8sg&oe=6A95D5E9"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXTAk8MNyjIQ7kNvwH7o0Zl&_nc_oc=AdpoWZSwnRcmkgXqFnoSJsyY09xsFqVm1TVSeWUhgHCbJHVWQ3hPV-HqlP0nkbKzOhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXVr1NNXcJLU2rvXmPp4IRu6BHnFDNmzaWnu0Jh_WR5w&oe=6A95B03A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cBbpRBLuggQ7kNvwFWI9Oq&_nc_oc=AdoDXNeSwCcPLek7DFL7_d-yW0qsnuYP24XJ-A9lgPIlXer3b5VVDl-gdHsw_wYOntY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeMts8zR6M0zVH58ERh-Jxta4OPcnaLnqdCNpFATl8Ew&oe=6A95DB2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvq9W1r7gj8Q7kNvwGWaVUM&_nc_oc=AdptyRxdaWVe5dXYJQB9ZhZUt_QkIKCqE6QLdLZYTQ7UuAg0-UtEnw9N38MziVyhNQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8AFgPcWwz0tuq3tpeIZBa37A3CXwcDyaZNj5gzoH0uA&oe=6A95B2B3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2
083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jN9Vh2dnyP8Q7kNvwGKPnlZ&_nc_oc=AdqHT5WsNMASUaK-zEpmedsW-eTP_bbhaP5No7jxfozZzjsMGpmGu0AFFC43G9lu3kQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LRLflv_pLgSMBVZ7DqPNG-3TxWXqR6bJu9dBLkVsz4w&oe=69FF52A9"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WiqGUa7pdkQ7kNvwEWuf1G&_nc_oc=Adoy1rXPqCbu24n6mZOMQgHDoCV1VkrfAP6BLY_O_OHwFQqtc5cOktsHQYo1vmAD4P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o3HFlLLU92ZHA8qZJ9pLZLcsh9YFrGrtqzPAOZNwonQ&oe=69FF2CFA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58sI_SCVDl0Q7kNvwFtdvNa&_nc_oc=AdqvdbGfrxxe8Y6i34Y7Bx0VdDZUsdRe32IfUt9tsUn2orsGInn3wiO7s2sy6czjRyg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72H1myXWgnySfps9zpjj0n2twH-PN4WNLPBA6Vb45yhA&oe=69FF1FAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xL2xKLtntYQ7kNvwGSYYMX&_nc_oc=AdrsvYQypsJJnPHXOlZyZ414U7SC9RM9KsbYDRi8Y2KcDECP9G-9rBT7oAxT_fGP3ik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54YSUl10Jfr-ns6RuPLTw-G_hHIsNz7kbsfRVygozicA&oe=69FF2F73"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1
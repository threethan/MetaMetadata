083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tAYr7Dp0DEQ7kNvwEMg202&_nc_oc=AdqMZt8_CRPBCyEgE8D7QyYTKH0Pbwl1fqts24yQ80xL1lkQq5Lq7ZrZ-iQcVO2imZU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78Zj5i7iSi6oq_Y43OC_H9w-44__KlFS16Rad0DhEIlA&oe=6A131929"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iHt7mFfhC4Q7kNvwEoYMuL&_nc_oc=AdobXzFM1Jqj53X55pL6gM1pB8OGL0D1Zg-9vT5pNwSEoPs0pKdJ7rw6YFXT3BrW8rw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NUbR-eqPqrY-b4Ml0sT2GegKfPpsjFjcpinw8a2M-rQ&oe=6A12F37A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg-qMutRNzcQ7kNvwGKM3oq&_nc_oc=AdpOkWB_O5zpb7dXHUJfyaskYvW-0b5ZYGqeN_LMia8lUDF7mM6oPB4kRQuIDsXfjeU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iZiCE5MHispPWYWKfMVYrjionD2N6JzhWXTHPz_YK7w&oe=6A131E6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roK440g8e3UQ7kNvwEJdlwC&_nc_oc=AdqUTp1nOuxhdlphXxw3t3axkf9THqnzS270n5H8s0wPx4VvhdtmG2F447X7GqecygU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y5hPW-DlXCde8sATARTv7ZTBdsfKNlnpfcjMdXBTgnw&oe=6A12F5F3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3
083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wl2Kp-loOIQ7kNvwF8ZSnU&_nc_oc=AdqxljQ2k7qkQi-_f86aKFnqEPfgZ5IKnZmVMzYBeg0VuzFpV_3WfiAFuUK08qQ3Hag&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aT4WZhZFU1gUTwMqd_uYtscQWG05QNjNdAP9QBbuopw&oe=69F4C6A9"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w42L0Xj4WYUQ7kNvwFePyUn&_nc_oc=AdozXoIwaxYSvGQg6zqmg2TZ3W70ya4vR51IalcW8EAlnzSLOngtAKsryBmmPffKggQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30SqQAiJioA3SYqt83ZS3iAzkBsi5GVnfsANpZ_HZbUA&oe=69F4A0FA"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgW2nBoGhiQQ7kNvwG3p1fi&_nc_oc=AdrshC787tXmHhPaXUl79wNnaAABwfWewlKsiRXgh2OKkCovMSHKct9sbbllXzZQcgQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AaD0vIzZPQBDZ0bFT3J8npuJbtEinnQAD_c08P8Ov0g&oe=69F493AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxeOPkAy7BcQ7kNvwFAZjqn&_nc_oc=AdpSpz5oOhriZ9qVndeGxHqntJ2jt0hqJ7OhASG_E4CVU9ItdjXC5TeVDPVyiCTfxNQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rMF7lrxLcMFxDXGy5v3mozJP_QLn0iKyEap1tL0VHsA&oe=69F4A373"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2
083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jN9Vh2dnyP8Q7kNvwELbrIz&_nc_oc=AdqP8j6_03eVMDbvtIg3hxCs6pFUbuikUS3-T7hSha2uuIeTcP7DWLI0AWnrkBLmGzE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FxsRPepnKXuCHMJkNjlXxUcdTo-djfosGHZiVDFk_Nw&oe=69FE0129"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WiqGUa7pdkQ7kNvwFpJqqj&_nc_oc=Ado9-gppLJXp5J8pkLqLXnQQ9eo0pmFUZKN5OOyF2GTFid_UbIlEzsvRBGkLRHCHKvE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43FNIRAyd6sWe_grnk_eoftCXcpdMO2lLKctgzoQOSKg&oe=69FDDB7A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58sI_SCVDl0Q7kNvwEPbSXN&_nc_oc=Adqi8WyQoFF7LA0kWYcpn4wB_p8lo82LsPND3C_8ZcQ_WmSICZN8BJDq05Hj1VhAz4Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y-JBFKfQphQzXRtgXQQdtdJYgrqw3DWCbtB1OMHqBhw&oe=69FDCE2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_XmqbDMtnQQ7kNvwHE3HRd&_nc_oc=AdrdFH9NI5QP1DgvhfIf9-U-j39KpNPTtXeqBFFReuC7H7A-MPF1tPM6VjeIPVcar48&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UTdDK5BjyAsBVN-DjkGPmgvcto1_yH3h6x6KUNRf3nA&oe=69FDDDF3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2
083566393557_2948236684946309120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKwfnTQR31YQ7kNvwHVLW1v&_nc_oc=AdomeqEpzxp9JcDhtXyr770LAjxQ7lkV8nZyJqdOF-2IXOh_SXMBqlmZ4ZLBnUsxFX8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af279ieXw0zPINVQYtpPZeDRCUadpgRs2O0K267RoQ_xmw&oe=69E8B0E9"}, {"file_name": "migrated_image.png", "id": "244188119949615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331252_1312521828850188_613462191911206912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CW4Ou7F9xKUQ7kNvwEwj4rL&_nc_oc=AdpmJIYK4Yxa-wZEzL9vkeJ2F22lSmC92eeVDEupfNIEybi2nukun3SpV0iSwqraej0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h0yXh7EnzqsCwjoPfsitXjeJlX6fCSZ3QnEWGag7Tsg&oe=69E8C37A"}, {"file_name": "migrated_image.png", "id": "211987926715014", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12331252_169016667132523_719055586381004800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-2_gVnAIfoQ7kNvwF9RNjq&_nc_oc=Adphonbql_F92FTqXS_KBaXUXvJkWzWEtjjX2MKQNTD_0_3N8ajTMcgtO9eWcMz3ZFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QsnnN_1y-Vm2fmi18xlWkA_2b4PmZjsltB6Lrax4IfA&oe=69E8B62C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AstraeusTitle1440.png", "id": "1597279317015953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427574_1597279320349286_1450077402620231680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12uKYjutBjkQ7kNvwE52Lcg&_nc_oc=AdpTCfpmBeRz1Eyjcetpx7OwM5pVLVUBNG9dAa-a_2hfZKWoPelgS4wI43Cbl8LsTUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Tzt4i1h8OTvNfJUIPDn4qEtspmnGUt0TZJGKfOj87Pg&oe=69E8C5F3"}, "display_name": "Astraeus", "keywords": ["space", "rts", "strategy", "real", "game"], "long_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build a mining network from dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them.\n\nAstraeus was created as the winning entry in the Qualcomm VR Developer Challenge, an online reality show for VR development. It is the fourth VR strategy game from E McNeill, along with Darknet, Tactera, and Skylight.", "short_description": "Astraeus is a VR asteroid mining RTS game that's quick to play, easy to learn, and enormous in scope. Build dozens of bases, and watch as hundreds of ships swarm around you in a dazzling web of light.\n\nIn the near future, dozens of companies are operating in the asteroid belt, fighting for their share of the biggest gold rush in history. Your job is to use your advanced holographic interface to control swarms of mining drones, build a network of bases, and outpace the competition. Or crush them."}]}, "developer_name": "E McNeill", "developer_privacy_policy_url": "http://www.emcneill.com/privacypolicy/", "developer_terms_of_service_url": "https://www.astraeusgame.com/", "publisher_name": "E McNeill", "support_website_url": null, "website_url": "https://www.astraeusgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6932275580178961"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1
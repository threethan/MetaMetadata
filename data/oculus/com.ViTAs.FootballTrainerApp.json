c_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttWRaXNbXKYQ7kNvwGqCen4&_nc_oc=AdrZPXQBUmuGuyRICnPCD2eQaNeD9DVX7PmNCS_sDzJ--vbOZQcj1ihfFToZ-_p91BA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKNhE1F-VapRdhXJG-PdSdhJmgOUVNmN1G5DSywdV6gw&oe=6AB7E38D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ViTAs", "keywords": [], "long_description": "Elevate your sports training with ViTAs VR, a groundbreaking app for athletes and coaches seeking advanced cognitive development. Immerse yourself in dynamic 3D scenarios, bridging tactical ideas and real-life situations. ViTAs VR converts 2D data seamlessly into immersive VR scenes, offering unparalleled realism for a unique approach to spatial awareness training.\n\nCoaches can unleash creativity, crafting customized drills that suit their team's needs. No more predefined scenarios\u2014ViTAs VR empowers coaches to create their own, fostering innovation and strategic brilliance. Players benefit from a first-of-its-kind VR simulator, enhancing cognitive skills, and refining decision-making, timing, and game awareness.\n\nViTAs VR, initially tailored for football, extends its utility to various sports. The app is a transformative tool for athletes and coaches. Join innovative coaches and athletes benefiting from ViTAs VR. Download the app, and embark on a journey transcending traditional training. Maximize training potential, and boost cognitive performance. ViTAs VR\u2014where innovation meets immersion, and excellence becomes a habit.", "short_description": "Immerse yourself in the next frontier of training with ViTAs VR app. Elevate your cognitive skills by experiencing real-life scenarios in immersive 3D. Designed for athletes and sports enthusiasts, this app allows you to view personalized training scenarios from your perspective. Whether you're a coach refining tactical drills or a player honing decision-making skills, ViTAs VR brings training to life. Maximize your training potential with a user-friendly interface!"}]}, "developer_name": "ViTAs Labs", "developer_privacy_policy_url": "https://www.vitas-labs.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ViTAs Labs", "support_website_url": null, "website_url": "https://www.vitas-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1074146549948989"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "678604027613703"}]}, "baseline_offer": {"id": "678604027613703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771857720, "status": "PUBLISHED", "id": "678604027613703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24781706138179277", "version": "1.4.7"}, "id": "729029415555873", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5309145845861930", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24781706138179277"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782829468, "id": "26843780855305118", "version": "1.4.8", "version_code": 148, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": n
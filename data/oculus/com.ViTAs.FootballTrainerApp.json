8485727598047_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lGgN_poarkQ7kNvwFav6fB&_nc_oc=Adqti58-WMjhnrW5unr-NNEPjgzRE0J5s4CrYr1TaT_6fjO4IftShqW47-RKl5AsfO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEMAex2NWMR1p6xpmSr4-6PwA-s1lob-frgCUC6lNP8Q&oe=6AB7C545"}, {"file_name": "IMG_0363.png", "id": "919065449944672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974682_919065456611338_1933716556010522390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttWRaXNbXKYQ7kNvwGqCen4&_nc_oc=AdrZPXQBUmuGuyRICnPCD2eQaNeD9DVX7PmNCS_sDzJ--vbOZQcj1ihfFToZ-_p91BA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKNhE1F-VapRdhXJG-PdSdhJmgOUVNmN1G5DSywdV6gw&oe=6AB7E38D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ViTAs", "keywords": [], "long_description": "Elevate your sports training with ViTAs VR, a groundbreaking app for athletes and coaches seeking advanced cognitive development. Immerse yourself in dynamic 3D scenarios, bridging tactical ideas and real-life situations. ViTAs VR converts 2D data seamlessly into immersive VR scenes, offering unparalleled realism for a unique approach to spatial awareness training.\n\nCoaches can unleash creativity, crafting customized drills that suit their team's needs. No more predefined scenarios\u2014ViTAs VR empowers coaches to create their own, fostering innovation and strategic brilliance. Players benefit from a first-of-its-kind VR simulator, enhancing cognitive skills, and refining decision-making, timing, and game awareness.\n\nViTAs VR, initially tailored for football, extends its utility to various sports. The app is a transformative tool for athletes and coaches. Join innovative coaches and athletes benefiting from ViTAs VR. Download the app, and embark on a journey transcending traditional training. Maximize training potential, and boost cognitive performance. ViTAs VR\u2014where innovation meets immersion, and excellence becomes a habit.", "short_description": "Immerse yourself in the next frontier of training with ViTAs VR app. Elevate your cognitive skills by experiencing real-life scenarios in immersive 3D. Designed for athletes and sports enthusiasts, this app allows you to view personalized training scenarios from your perspective. Whether you're a coach refining tactical drills or a player honing decision-making skills, ViTAs VR brings training to life. Maximize your training potential with a user-friendly interface!"}]}, "developer_name": "ViTAs Labs", "developer_privacy_policy_url": "https://www.vitas-labs.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ViTAs Labs", "support_website_url": null, "website_url": "https://www.vitas-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25431827713167113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982706_651689666448436_1306365603459329303_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xofb6lLM8sQ7kNvwFvlutA&_nc_oc=AdpjtT4OQ-Mlfpd8AnmUeH4NvTNrCerDIgckhCvTShwancf-ZUgrPUjjBtDeMczZd_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB0ohqdi5ZlJPwxI6Zpr_5e3LRL8KOPcsdack-YdP2JQ&oe=6AB7CCC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ViTAs", "platform": "ANDROI
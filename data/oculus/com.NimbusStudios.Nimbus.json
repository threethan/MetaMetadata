a0a&_nc_ohc=EvyDowGGBfwQ7kNvwG6QoJI&_nc_oc=AdpP1pzrMmk9XeENEgcyFQMuw_8d1D-aCpVjF_nkTnzJJ181M_S0eCkgHv7gGpfOHdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFIouuuJaoKTZjoBqdtDSfMj9kPeWrwfYAr1ZTj5Cb5g&oe=6AA2A5F6"}, {"file_name": "1scree_resized.png", "id": "2135550414044188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310726_2135550424044187_3520448258525297118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVsVK22aqAkQ7kNvwGBYlvp&_nc_oc=AdrXQYGU0JSuVphT1DpmhkqwCB-1h09PNpznxMpsMk4qeCwfWnX8nHQo7havdRW13AU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1eU4-Gfmi96d4OTV6cQJe1u54JfS6q1Q0PtPWXoBSJQ&oe=6AA2CF36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nimbus", "keywords": ["handmovement", "scary", "fun"], "long_description": "Nimbus is a thrilling Gorilla Tag fan game that combines fast-paced movement, horror, exploration, and exciting multiplayer gameplay into one unforgettable experience. Whether you're looking for intense scares or just want to hang out with friends, Nimbus offers something for everyone.\n\nExplore a large free-roam map filled with mysterious locations, hidden paths, and eerie environments where danger could be waiting around every corner. As you travel through the world, you'll encounter terrifying monsters that relentlessly hunt players, creating heart-pounding chases and suspenseful moments. Every match is different, keeping the experience fresh and unpredictable.\n\nNimbus also features a variety of fun and unique **game modes**, allowing players to switch between casual gameplay, competitive challenges, and horror-focused experiences. Team up with friends, test your movement skills, or survive against powerful monsters as you explore everything the game has to offer.\n\nWith smooth movement inspired by Gorilla Tag, immersive environments, exciting monster encounters, and plenty of opportunities to explore and play with others, Nimbus delivers a fun mix of adventure, horror, and social gameplay. Whether you're escaping terrifying creatures, discovering secrets throughout the map, or simply free-roaming with friends, every session in Nimbus is packed with excitement and memorable moments.\n\nEnter the world of Nimbus... but remember\u2014you're never truly alone.\n", "short_description": "Nimbus is a Gorilla Tag Fan-Game, In Nimbus it is a horror game where there is fun game modes coming soon and even more!, and scary monsters. Nimbus has a free-roam map where you and monster can run around and have fun!"}]}, "developer_name": "Nimbus Studios", "developer_privacy_policy_url": "https://sites.google.com/view/nimbusweb/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "ggshop156", "support_website_url": null, "website_url": "https://sites.google.com/view/nimbusweb?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1203574879506157"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507829689_1363338905722114_3756268185140450888_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xN75oT3BaEQ7kNvwEYe0aH&_nc_oc=Adq8FK5yAqcAhTf0LY-6hb7bWwaXHOPME5StyG8mcJKRkKFn_36e8nX3IruiV5rIcas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_n
etworking"], "long_description": "Displays WiFi strength as spatial tiles on the floor where the user walks. Each tile represents WiFi strength with a color code: green for excellent, yellow for good, orange for poor, and red for terrible or no WiFi. The tiles also indicate the number of the access point, which is helpful when multiple access points are present.", "short_description": "Displays WiFi strength as spatial tiles on the floor where the user walks. Each tile represents WiFi strength with a color code: green for excellent, yellow for good, orange for poor, and red for terrible or no WiFi. The tiles also indicate the number of the access point, which is helpful when multiple access points are present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/11H5pK6NKWVjkjpGIwfr6QQsctktYzAzE/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Infinixense", "support_website_url": null, "website_url": "https://www.linkedin.com/company/infinixense/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26352691064376850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75557061_396583806776910_7660027576098269367_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBqpREUNYjcQ7kNvwFhk7Bt&_nc_oc=Ad
v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrV5oGys87QQ7kNvwH1hC9-&_nc_oc=Adpy-ewvsd5E3ti1UM1cjQFWSZ-v8ZqbtgolVjNCoLDJBlV6m4NQqd6N34z6ZcG3o5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m6ZsR-QYKsz29ivnaZu2pzsDfh6VO0lMl2XSLF4DQFQ&oe=6A1D921B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITsLYRXnY_UQ7kNvwF4k71C&_nc_oc=AdoP4mJaT4FnzcJZv0Lq6jqxft9ftwqqYC-KCHy5R0P9vd1azvtoikPfojaUBrWEcUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tCGtT0m7HgWTCGhJqRuhOB-mbPmgu7OkFnWB1qcPsgA&oe=6A1D7F92"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kh3dmutxLk0Q7kNvwG9ETxa&_nc_oc=AdqaFEeCpaX-1kj-rn_6CsOqX7BH-maxduwWnpRlyKJIpMRaXGttk-utx51znaaczXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d6-Z-kYePxAVg1Lr2jQBwf9_XGjw4ZMP3e2OYgqHDYw&oe=6A1DA59B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vky0vV9BEnQQ7kNvwGn-t52&_nc_oc=AdqMz2VskRnF9gaVsc_MpL6oFVV7ZU2MzjXw-1pXUUbjloGe4Xxqx7jnGK3CQ7zD3Yk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nMIKgINMQLS5ipN4ANVCgTdF2g00y2p6NxtV6Ffjp6Q&oe=6A1D9230"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH1mfm9RZeQQ7kNvwHf0XFM&_nc_oc=Adqr7Q7jMOxuO7ygv3dmCOOX84_F
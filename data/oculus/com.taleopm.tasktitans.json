n.com/v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0jkqgXXKDwQ7kNvwFKtQF9&_nc_oc=Adote1aQ2EfMYfgUszuoZ12xv0X5Eh5PXYvFc7G_g4JTfzM2I2oIVKGWb9WEZ7vavKU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7x6ube0KK6NeZJOwYn-_WmXQRmteM1YNebCQY8FOEmA&oe=6AAE971B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVxik2UKUp4Q7kNvwE0kEFy&_nc_oc=AdqxjHfGEIOTyTIL-IlX4AeCAGNgu8NwgqMGjHrR4FKPoIgQLifBOepK13WJegcToO0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM7ShJTzKusgb16jcpJV_by5_RJ9g82Ja5XzDPkf047Q&oe=6AAE8492"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdBIHIThExoQ7kNvwH3Ol8K&_nc_oc=AdqOyLIzA9wVefe4RxgNMGdPbe5An8idxMx67npR1BxtCPTN-A2O02Yq-021heQw-xE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIXUpIpSaKdHDly_xhZvPbS9A-ihOVLbWz3f8Z8xvdbw&oe=6AAEAA9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEBFonRSxpQQ7kNvwF4PWj5&_nc_oc=AdrLy5dR9TQDDONpbXzAGhl4pjKqlUKFrMhsuHdo6r2iTl6JwC6KnFEYVK5oWmywYxc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbs8MwAmrRTklbVL3AVR4q3nHTHTLjwBUqIiwcaPI1yQ&oe=6AAE9730"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYlqLdpqGd4Q7kNvwH6SE2G&_nc_oc=AdpKw7mWMKhAAb-GtQa2Hg
v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F_m_bsK-J4Q7kNvwFKZmEr&_nc_oc=AdoWn8MxAXT476SeWds9E_tW_xpe16cBpa8aRGJoB90lcey548wD0YQh5lKsF1Dy5Tc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rtScD1hgnjwy3u0xojU8tm3MpOWrJfpjqV6UfRKeDvA&oe=6A26CC9B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJJQUoCmieYQ7kNvwGTugEv&_nc_oc=Adp3iToJKTBNJ8QyWNoqWoXa0uTxUAxV1sGegdICwOvBqX-HjI1FHtM1c7Vi246c34Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0-Dz1GsGJiJ6y9XyEHO8Kya_Wq7lyxiCkg1ql6OzpOA&oe=6A26BA12"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW6JVvwENV0Q7kNvwEnhRML&_nc_oc=AdpsB_5dpEPkBs21Y95aZw-y1Nj7LcpmXIT08o_-NzIt96pPwQDHB9LRIKn3DQ8pCTA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89m3D1ieWqYcqLSqEOf7FQeAvIQAAoGybL00ZkwA2Q_A&oe=6A26E01B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob10P-QeL5wQ7kNvwEy3uLD&_nc_oc=Adp56G3-kw4Zff3FXEJCYVh9InQeJ8h0ad_1fj7n9CgMxCjYAxJyjv9_PwWwty8q2cM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mItyI8PFhu1UwW61V-NNHFxjIVL-SwxEsuL97Lr2_Pg&oe=6A26CCB0"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UNfmGvK_eYQ7kNvwHtaYdT&_nc_oc=AdrWxg20mV7lQHViRiF42K7KFGjQ
v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUHFquN9OI8Q7kNvwFg6gH_&_nc_oc=AdoZ-lW0Dw2CFFIcz7T4MplHc7e6WbPJbohcZj3_BqnLICYOKfCMupRTcy36VNNMXtc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX9lU7x_eDwUq6CJ5tXgN3NxgBJHSDy0eo87_sGVcfpw&oe=6A68B79B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9vXvtWYWgUQ7kNvwGJfVCa&_nc_oc=AdqYke2y8bmNNqidXzJKkAinrodZ3z2kBNCf9qbXiSKcrFk0TjXGsn2I56Yxunu8FQw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR5FGz4YQnfgq2QY-j8TAiKtn9qPpAoN3zuOIhMbHIxw&oe=6A68A512"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_wSgF0qgEIQ7kNvwE72bxb&_nc_oc=Ado6EREmw6nmQ2ayLYVp8nhOvmA64_EU9FR3DdC4BwuulMm-DyWjB26Q3xt4ZHUzvdg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDajtn3XqlA9JEJzHXjlZowmDWGNMfWEkHhdQKM-YGQ8A&oe=6A6892DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foiupwrUzsUQ7kNvwGr8DHO&_nc_oc=Adov6ZUZwpa-cLwiuiEEIF7NUtEWIbT2IpgAJrEus_nT2PVEuh9nGC-SGJLZIXEhQVw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxhbnm4ApO-fG4IMDA8Qhcz82dP13ftSg0QQWX6u4-ew&oe=6A68B7B0"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOnbymAb-VMQ7kNvwHr0tnG&_nc_oc=Adq9ARYKjqLw5a0ldaGMSoKEfd4S
.com&_nc_ss=8&oh=00_AfvLo5zm2yK959LnCH7hxoQyMJnHQY4TSh7lesEKBvJ4pg&oe=69A82A12"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdIB01QMk_MQ7kNvwGhvOqh&_nc_oc=AdnOG2OmAVAEpI0Hr6W-dHLiGr8wXfa4_JJfF5U00DYLU2-TXoBSH-KIDZz5BbkMu2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftflP9Zdhun9nmWHbP8N533Up9NLqSQ5SvL5xpJl5YLRA&oe=69A817DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPXcZNUd0w8Q7kNvwHUAqhb&_nc_oc=AdmndcUV6yRqEMATQ5UkoeFxS6kInDts5hVe7kIjeeGPsIQMn-4vNaVHnMi2dMtP0-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvn0rt1O-Si5RO552hsMKUSoMORDFNt-JdHnGoSsRfxGA&oe=69A83CB0"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7486606131429064"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1925809157982153"}, {"status": "PUBLISHED", "id": "901164614877254"}, {"status": "PUBLISHED", "id": "406446488852729"}]}, "baseline_offer": {"id": "1925809157982153"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763409900, "status": "PUBLISHED", "id": "1925809157982153"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24213208128342268", "version": "7"}, "id": "25287766510838265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7486606128095731", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24213208128342268"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LI
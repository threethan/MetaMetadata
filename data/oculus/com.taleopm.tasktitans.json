QQ7kNvwHcPUFj&_nc_oc=AdoE88OuJrl2gp5Fyt_blBbi-BElMdcDRFnrZrLDX1EZ7vLgfVRDSBpNaJWa4oZDJeU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWbGzTU14dtD7ajK9HG8mPyskGsKkI6LhBzCP7EphWjg&oe=6A85A612"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=255Xdcr9nK4Q7kNvwERp-E3&_nc_oc=Adpsf5xnvWZXCHhewCyzpB6QTOdQlkWYyB4SlyjBB3uwYIFXVcaEN2EeH9NUc7oEzUI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbSsuP3Fod3xeQwSG7xFdhT31rqp677kBkZsEvgqmw8w&oe=6A8593DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh3gdln8nHcQ7kNvwGC3jQm&_nc_oc=AdoiBcuTfO3SYaeJ2FXFwk4ns7VjKfyzGK2KHwKBLqBoqW3rtQ7RgbLSwcS0H-BtN9E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEOiygOX_B3EvhLEHhEmF6jl-gwWBY7JDR04GPyg2PMQ&oe=6A858070"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7486606131429064"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1925809157982153"}, {"status": "PUBLISHED", "id": "901164614877254"}, {"status": "PUBLISHED", "id": "406446488852729"}]}, "baseline_offer": {"id": "1925809157982153"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763409900, "status": "PUBLISHED", "id": "1925809157982153"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24213208128342268", "version": "7"}, "id": "25287766510838265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7486606128095731", "is_concept": false, "latest_released_binary": {"_
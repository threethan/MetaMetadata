oRoQ7kNvwEkosmi&_nc_oc=AdmrBxzrBDbdT58eS3Hg97uQOL7PPKfvjuLTcQyhZzgHpnoXIF7dxxTOpcIz5vxekCQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftYB57pTIMMIhYVxpJFGzaHPxJMJ3hNKBA6htdm6T9Y6Q&oe=69A5999B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5_kbbLopcgQ7kNvwExTRYH&_nc_oc=AdnXOz5lrulvYENIGtFGnbm1eubIg_721P5affsgL3VIuKLebgs9slMFZ8z4-asnH3c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuA8kQAqA2bTUJefVmvw1X7H4E6ir_l3MwyJcOgOPkJiA&oe=69A58712"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdIB01QMk_MQ7kNvwG3fqpH&_nc_oc=AdkK3UBP7EltLXFdisosreLsiBDX2de4UBlAcFObkbloAuMtZl_XvG286KZhDXUdNe0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvO53Mk9fNpxQvM06XiOgfDpty2ID4CANkhuPT66evFdA&oe=69A574DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCtWj46dV6YQ7kNvwEWCCXh&_nc_oc=Adl2dKNixzjNDPE9iG1x6RzuWmcA2n0GjiMeUMawScWCi9s3C9WC_WWiWiPrAosWCU8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv7ozo831qUej_SX5lX2DVs_Ly2QJj4BU3L7t-iOMybcQ&oe=69A599B0"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsYlRmpSvWwQ7kNvwH-bt-2&_nc_oc=AdkujnIQULuJTDvh3Vc_dm8nBvDRxSu6s-8cFfCaXMQWk3KjbKuiOrWwNXODXdT3RdU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvHQSINW6rYt8YXnCLA-lhIMYpPeNVMw6pnaGAZA75kbw&oe=69A577D5"}, "is_concept": f
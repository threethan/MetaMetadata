fVgQ7kNvwE7ApIF&_nc_oc=AdmPhy5DRVJFfN_H1cezQMMuv4E5foOHRLZ_W4DINFk3SbMj4AKxrWGEmOIb5XjTDis&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuzNsruBQByMml_0gCil_8v7C2hirCICbj_WKqBrtcIww&oe=699F021B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXzwMLwP8EAQ7kNvwGVtNl4&_nc_oc=AdnD37NL0srgcxOd05Z0uP4442r2k3RlyZTi4hl9iNq_K6-MWUUqGXTglEfLDGrZd20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvM4HjaDWsIVtJijncDi1n-pMVd4KwnXFP8VYh0TxFTRg&oe=699EEF92"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBCLncuhpdAQ7kNvwHUBoyD&_nc_oc=AdnN6qP2I4Y_gzR1pk_FAdmzKip3kjoMcjhee7ISltjvkOqGYtX8VRIdtDVCK0RdKoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuXPYfg4ymU7bSGPGxoC19FZSKwLeYab020Cvvzke7FTA&oe=699EDD5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMbwX-FsxRAQ7kNvwEFLIgl&_nc_oc=Adm6Xv9ziA0aGZcAafe27YzPKlgZeUg-UzmlECk6yY9POu44G9iyb21rEVoQ2Ft52Ns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvkG1dgr2ynSmPM6qa771mBqoHH_lltNEGaPYOy--Ke7g&oe=699F0230"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suU_WmQPtygQ7kNvwH75Cg6&_nc_oc=AdlJKeFFM500lF6oQIJCjDNvtoo8e7ir8cEPLy2jJN8DH7nlwHYySichnrV3P7SypO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs4_m17NuTaXZ2BjYwsgWyLag5As_bntVLg0qd3zp60-Q&oe=699EE055"}, "is_concept": f
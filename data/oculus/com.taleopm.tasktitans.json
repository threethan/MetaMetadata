v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqdTcl30GFUQ7kNvwFUeo-u&_nc_oc=Adp4sy1BTi62BKlBgGsz2Q4cTIy3jUndr0DiYNe39L_d6SolKJsldalikj0Nm56XtdI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_JJGrx1dD6zRbkk_1JYufS4gen1ApSsw7F95t4e_DiA&oe=6A900C5B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BpWDOS6ME0Q7kNvwHjK507&_nc_oc=AdrofUImOGcQFUR7JNy3mKa41xiUtmAdCUjHUYx4ZJ3PA_hVoMqf1PlpS6_sU_gOwTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWkeIXDRRLXbfnWyNJ_OQXjabt2iiA_6w8SHvvukK7Tw&oe=6A903212"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UeOvN4kP1cQ7kNvwHTa6iW&_nc_oc=Adr1PXOqJKQfwZ5aAG3kNG2HCsiTRicN5DtnGXYBhX71kNT5KPJR-xB6kNQC0Wo6lyc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoIDfJ6SK1CcY1mK-6Wu_M8R5XFyA7I0WrFrKz6IWvCQ&oe=6A901FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSFPSdcDfGUQ7kNvwEJrRZQ&_nc_oc=AdoffyZmVVFhVHI0pUAZhWTM2Vv7Bx9yppH3m_9R_YWzNAKmc13kcO5RjcM1UB9tjtI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-7-W6EC-n2KlLNl9CCuSli-MKyTGQkXouxLhJ_rsYtQ&oe=6A900C70"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOM9FM74dPoQ7kNvwGn5Rix&_nc_oc=Adq4tSLoiiYeSqBnYRl4ZEfQWsdh
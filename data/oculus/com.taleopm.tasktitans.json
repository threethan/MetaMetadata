-AAQ7kNvwGqxHCQ&_nc_oc=AdmRqPgYJI29i7bqWEJVo21BuHUilsOhGM6CVQH3-H0CUlKqGmmOfi3xGrsWxX1Rt58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft6uJakfjvSnMzaw5Ick03Bq_IbiUt1JBnKsDBRpMlr9Q&oe=6999BC1B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXeSVGL4wxgQ7kNvwGBTJSC&_nc_oc=AdlYyBTaY13V9rWieF45VpG-jP6gEaydwWRE8EFaig8D19GON8kVoI3ku1LDYKHM6Bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-qz_jrT9QRxJqhtbJO_f4VHX1KIePzjknkjm2kayX3w&oe=6999A992"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBe5nMOa1VYQ7kNvwHO4st6&_nc_oc=AdkISZAP9d3_qlAqum1tbkemRKTonBRiB4oac_aopqIpGYAz4pyEtEbCgchqRtT_Wts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsx5cYhFifebsiqwxII6fEalvk5yTQJSs8aSb0jqsSJlA&oe=6999975B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r7q1ihPcXgQ7kNvwGVb-m5&_nc_oc=Adk0LmrAADQR2m24gMz9gG8lukuFIOXjMXWvaAUxE0d1GBC-u2W6tpiSMVlWrKlm3wY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsV1WWBTThWS6BEwGyWcGkoXIKgGqtWPj-QC05VpMLMUg&oe=6999BC30"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmhF4ocsB6sQ7kNvwEyVDLP&_nc_oc=AdnpaVM8xZXN6S6P5MyLqOyb4SPdewIuV_JaHv3t6CYx81aUHd5Z7epn4miXOhbf6XA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrKXDcRlk5xjW1-QOtbQUuYd6FdWcRhrA8_mugoA9lKQ&oe=69999A55"}, "is_concept": f
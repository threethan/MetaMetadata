v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kuc52Q5B-BcQ7kNvwFq07rk&_nc_oc=AdpzsJNyLOT2iFXny8no7XpuPkz735-HtT4S0f93j0T84ChG4Gh-vIq1mc8ZkzDouyo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TQhUoCfyvwDlGyIYhdFqtd2JWYDPqVDBXuODiLWiAtg&oe=6A412A9B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4HpaYvtqdIQ7kNvwEOmQwA&_nc_oc=AdpFG35LPO07aE0tXuZ9tRwpzws7754zRKZaE5JRu_mxm3MfAUdgUkkcHXODsRcCKNo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_--SWKvu7o2M4YrgKLL4FK5Xo9iisPJbawVm5dEbuHpQ&oe=6A411812"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQeu1FcxUC8Q7kNvwGwTk_1&_nc_oc=AdqzRaBOWpWNKUdeyRzjkyvQ1SRrVg6o8mjQnI0gH0d4-s1FGsnBoVviidTbNHJEo1c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9XFv0PiAWGgby_N-Zvo5bnH1hY-AiaOb3JArNDZGZ3A&oe=6A413E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLJaKXLRwWMQ7kNvwELx-sH&_nc_oc=AdqLDNLwGalrcB6b7zNe9P-2yqZFNb885oZ8uSw-S_8mn3HyLUTcZ5CecRuEQr78SKs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gluDuFCcMWDgXwuj6wTnkQ9zwRHji7PUJJ5yX4U0AzA&oe=6A412AB0"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQIXnQG26jgQ7kNvwHVryg5&_nc_oc=AdrLM5-HResP15RJDhXb4DvnRk8V
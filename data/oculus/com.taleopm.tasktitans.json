v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=390QJ8Mcl0IQ7kNvwGYUmac&_nc_oc=AdqzQIwaFmM8zubxbkyPCbWLik7bp4batR7A85vNN6DyU_4671DX4IZ6x7IclA_c7OI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj_qc5GQSucvbMu4fcokk5NCv5aGCZBRETlrS3cy0ycg&oe=6AE7479B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXPo_10hmt0Q7kNvwG-6N3G&_nc_oc=AdqLKBEv_X2MryeK-EjlObJ7KAKjh3wCdhDa19licSycA5aTCC_f-SabaUPqQkYUcq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsN0e-lnjFFNnAYtMKtO2nnfDtCWH9VeMgnfUaRWt4vg&oe=6AE76D52"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnHII9GE1zkQ7kNvwH9jOVm&_nc_oc=AdrYq7Yn8z28fkqzLsJ4l91Qqfxm1-Us-eeRL6f5uNgjhfY5ktqt4H9r_5xZ2RSwEL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO3uWhGGY4Tdgbtd5Sgw6tnMyoTyeG7H6gy5NL_Fvjhw&oe=6AE75B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGZe6XLwQgoQ7kNvwHOfe6o&_nc_oc=AdqiMa4F6TKVgp3-ySMkJ6VxK7vRG2wNgolvc3vYWBpVwL0QZVEl49w90cUYRCSxQJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxo6TDSuCAND3rfesCL7WkUMJtbsr7k_gySbar9msLnA&oe=6AE747B0"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RG1Vfp-Nb7QQ7kNvwEUcIKU&_nc_oc=AdoOSF4PVNu0e2PwZ4dp6U_byGfW
fVgQ7kNvwEaZFmA&_nc_oc=AdkC7j3CIocqJoZGJZp62cNbeDBfLvSz_bo02JMdxas1uPAZnU6u5s9xYNjjEvZXALU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsCptZbNCAmhjagqGPVNQeWq3D64wYStCkRZs0Cu3LM0Q&oe=69A1A51B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXzwMLwP8EAQ7kNvwHHL2bE&_nc_oc=AdlB8_c0lp7EyWZtJgGY0EHPLGeRHIAnBR6niVz58VV4ncr3nqmOTVWkwvwkStiMlQ0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftrvrQlxc1jW62VBrmdRHGOwoCkj8_YcfCIzOKN2K0xFA&oe=69A19292"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nlbq1VThElUQ7kNvwGpufcU&_nc_oc=AdmDSSDU4w-YvEAXYH5HYSbLS8KOVBtiFf1gsYWNRcYzgdtkRTBIucQPHRhZsnMmj3o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvpM9cPPjIU6xhJfkBiA8DI-hWKVNzNyRilfIVXa5IfsQ&oe=69A1805B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzQB2K6OM4kQ7kNvwHCQ8-1&_nc_oc=AdmIXNGIV9_8wvTRIKUaZ0V1Yh74hp_gNvItUt1rYMPyMGZBBU6kn40LfdSM6yRBmdU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftydvXINyV5KtCoPqDWr8dTx27sPZLrZW124llUa4qTbg&oe=69A1A530"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABYH0CzDVusQ7kNvwG5WddN&_nc_oc=Adlz44gZmG3gs7GgTYyKTfJQQWO17pYo8Gx09l995nv9esN-qJWo0A7anPQ-_Cf3lgo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvvcEC0acD2y-Gsq2sXyBGzTfN0AKICGe3F8NFPyh_94Q&oe=69A18355"}, "is_concept": f
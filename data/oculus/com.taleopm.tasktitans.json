pzYQ7kNvwFw2jos&_nc_oc=Adncet3FZAuyxad4UkSRl7E_ZqTBk6mOX1AB2k2eIJWivPCo_r6_yqEIIgGVpSBjmgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsWWq5hhdALYFmLt-_z01bC8XQ3uRq4Efvj9KxMmK6KeQ&oe=69A6EB1B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byEyq8HyT5EQ7kNvwHEaWMm&_nc_oc=Adnn0v7x1HHfNhzxvrhiaAhq8Gqi9xtFkLcFW3rr67Nz2fTs709o8bFmqJ6I7EuRd2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOyHdwJliIf_QBsS6pYQdXcR05V1Mi4QC0LoVSVrE8dw&oe=69A6D892"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdIB01QMk_MQ7kNvwF65E0n&_nc_oc=Adn6dbwPk9t3-5Yly4MYbjT97VKU8GxD0j_FV_pR5sfG5jgOwqmxxgi_IC9N5AZDigo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftaIN5xbWY6BBDCEKSTih-CWokBv-18dHj0t_nlzwL3YQ&oe=69A6C65B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCtWj46dV6YQ7kNvwH-ZdPp&_nc_oc=AdlB6rmV--ZHpeOMMhoB5A2QiPYJC_HhQMbaKoe05XaNhxuD1ZMr9f342ajYuKZasH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu06cdKbmJKp1x2QvrLFNkwjw4IOY1vlWoND3cajel1HA&oe=69A6EB30"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsYlRmpSvWwQ7kNvwEQ3j8r&_nc_oc=Adkl1PO5Q0Lgwe7YJXl4DPweQZyKxHm9WFPIi6pCiEjlfhPGz-VJhdwvVTcmAyhINTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftMTbKR-SGprFvmxgFbhmdFq0d8r_l8DOtPSloIXQ03-w&oe=69A6C955"}, "is_concept": f
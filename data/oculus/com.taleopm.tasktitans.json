-AAQ7kNvwFlRpxI&_nc_oc=Adn1LIdbzW8fpPnjWfa-XDlEx2pNJwHgqWXWs5WO57GLwlYjPUL2VX1A6d-_Tfcwp0I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvyh1cWeBr3_7kI2slZC9IuD75i88LEHEVuk-hsoRhbGA&oe=69986A9B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXeSVGL4wxgQ7kNvwG3KPQd&_nc_oc=Adld_NmrrPk7LXCWW22WrLEYEGnBgQui_3gQuL9r-guf3LKmSomBxLspWnrBuIbmKXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsLIGEj99GRCIvFIaOJgikgEd-RZNtGrEqVneG_9BKdyw&oe=69985812"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWT5nLrZCk0Q7kNvwGW5DEY&_nc_oc=Adl7Yy1EKybk5f2MZ_Pwt08beGZpjxdv9N0aTouMVfAA22LyOR4LBrZFBlioCtwcXG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft4k4yyuKqLNzln-6f_PJWJd6_DCUZZVMz18Eaa44T5yg&oe=699845DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r7q1ihPcXgQ7kNvwEDJYxQ&_nc_oc=AdkR1ZmHVCI8dOBtoYduGK_0otpFYPjDoijyDDKXY8T8yF_PnvRFzJDE6Xww0hLDb3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv5hVGM-Zx3guDUyOs8Z-klYsr7xGofDaXqVnkGsQbXhg&oe=69986AB0"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmhF4ocsB6sQ7kNvwFDLn05&_nc_oc=AdkyCB8ri7BwCjRJS18App4TCOYAezGrr0Kk_kXNTshHheulRLeADJcuWxaktrp41xc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft_ceZYVwRM0AyqgZUdYA9aV_mA-5RlQ2UBGPgerjbDqA&oe=699848D5"}, "is_concept": f
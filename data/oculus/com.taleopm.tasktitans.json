8yUQ7kNvwFrTZR8&_nc_oc=AdlNnbweYcJmvJDrONoiRgUHa0dFi4e53l2jLJUY-7gXWyMQxlEBj2tLDMVuAyeKJYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu7dabPdQeUPf6ApUq0y3hYGxEDU2tMSnceqkdB87J7tg&oe=699B0D9B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pwy5W20lOtoQ7kNvwEyYcjW&_nc_oc=AdlVFgSn4TO4arUZFgvHD_0r43uDcreVrkxJCLtIK1fqD144GaYjINKiOMEOx6sUCmw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuMKgbvz9X5DcY8uRmk0vP84-8RnewlSbH1oT5VP-7Mrg&oe=699AFB12"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBe5nMOa1VYQ7kNvwE4R9Q4&_nc_oc=Admvj7don9ff6-nYZT20hwkTuCg-DE4t9gofQ0RNCEXTerJ5qpcDnF-LqDiyl_5c3TM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuo3QC-LW3ombtQxZYFFDPE_lard3fsIhFLZkPgSCUalw&oe=699AE8DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r7q1ihPcXgQ7kNvwHZMSpq&_nc_oc=Adn7M4DEnJ1R-kJfaq6hmb71KNf1LvCPgD9Vrtn08GQkfXP8hXjxVMrMbWAA-mKth00&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftGhBKnr61iHnEvyHu6hIEB8PchlXJeFCYi_jMCzEBVtg&oe=699B0DB0"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmhF4ocsB6sQ7kNvwG-gBom&_nc_oc=AdmvFZS0GJhmOunduTOMxBYDCYS-tzOEtcDjQpoGW0D-Oi4CVr9AtzwYR3UMBBZmvRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuPS3SD2USfwAkBy8-wLzXj7eYxXCxolZ8HuARLPFRxOQ&oe=699AEBD5"}, "is_concept": f
v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-otoH1Yu8QQ7kNvwF9E3qA&_nc_oc=Ado-CLykwDycOl4q48SglAk_4vwWgqNYqj6pdGNFp2q7CFtj22BhfF0KuabyYB-QsXA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt_-CLHdY3lrBSE4TN0IdMhu-5MvqWUUANyZDc6eFeUg&oe=6A8AC65B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9itv9FQcbUQ7kNvwFVS6bV&_nc_oc=AdqJbWne-dd9WHkuzACO2vc8pfGmtpb_DunYq34QVaPPcebVWubAJq3q_Dx6_iAjFNs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJs_Hdalb9Tms915Y9qyBluyGejbIaDxUJXzINkfDoOg&oe=6A8AEC12"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBegxjmvwQYQ7kNvwH8q5Dt&_nc_oc=Ado4-yB93A-We6YgZ1yX0N6zwZGdk0v2zzv-OHL7FhpcBcAqoaan4Gu1ActSLLyqA5w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEViURyeYLofn_4MH2LAtz1vrlv2rB9VGc2mXTCr96kYg&oe=6A8AD9DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-OKO71JZEkQ7kNvwHyCWs-&_nc_oc=Adr3qRo3k_QB_sC-8816UkPXRGoOiFM2ooAB5QR9BK69McNrqwZY8EyaDBkECvTvgdY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMmb8MSaa_Aw3yLT3VL96gB58BJWCrkcPoVkTNE2CSKA&oe=6A8AC670"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRyRaQzZFlcQ7kNvwHKm1YB&_nc_oc=AdqG0c0LeW02XC3F3T6L1_aLouE6
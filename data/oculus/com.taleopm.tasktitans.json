v/t64.5771-25/38974680_1144492910215403_5009829909492554600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbgP11mIKDAQ7kNvwGbP9o2&_nc_oc=AdqCeNTltkuxcz3ubyltygW-lXJ_rN6o97YpprDJ9H6tliImrfDMgLNuhPIL9oSMUKw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzPLzXHsSWBzWsS24xlVJ_mDUG15bDPh6Dlr1UZwdW6g&oe=6A6F4F1B"}, {"file_name": "scShot_4.png", "id": "833582741980216", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982486_833582745313549_2836316774016621410_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVLkkXrVA3MQ7kNvwGzdAUu&_nc_oc=AdoFdc67MraOOXAZs-T3KDM2Z7N2TM8qZz7_9sugHay_XAfBD6uFFNvjCOmPuoX8118&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVQQIuTz7hYB-zRfrcsrVRbiJ1t9c46dQShqA9g9yR_g&oe=6A6F3C92"}, {"file_name": "scShot_2.png", "id": "7383528298412888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982620_7383528311746220_2178009886707352184_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSITWSOZh-YQ7kNvwE3UwGS&_nc_oc=Adq1hMCN9P2Y86Fwt7VlxZDVyKAbnbAEV2uM10HQHjHFKmvXnuWxTA0H8nZqNaxUz3g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8ysZUOulZ9x9zw1IWRAGTduJalWMumcL2NzCbTl5BLg&oe=6A6F2A5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaskTitan_2560x1440.png", "id": "318678027752199", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982572_318678031085532_2872445775829117351_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA42iuXCLZUQ7kNvwEPJtRN&_nc_oc=Ado-MLnNsx8W1rWOOpWpXiEOwAdpCnAfQ2-Pa83IwYVtI0qiAUfaJYsxZapemKH579E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjmZ75TYCrwIqQDkp-ro4o2frehLIWpp7TZWF2qFoRsg&oe=6A6F4F30"}, "display_name": "Task Titans", "keywords": [], "long_description": "Task Titans is a series of 3 virtual reality mini games intended to teach the player project management concepts. \n\nDefeat Gremlins:\nOvercome risks and issues by battling gremlins, enhancing your problem-solving skills.\n\nBridge Building: \nConstruct one of multiples bridges types,  applying project management principles to ensure success.\n\nResource Management & Team Coordination:\nManage resources wisely and work with a team to bring your bridge project to completion.\n\nLearn Valuable Life Skills:\nGain insights into leadership, teamwork, strategic planning, and adaptability through real-life project scenarios.\n \nExperience:\nWhether a beginner or a seasoned pro, \"The Task Titans\" offers a fun and educational way to sharpen your project management skills.", "short_description": "Jump into the role of a project manager in \"The Task Titans,\" where you'll tackle various challenges from saving spaceships to constructing bridges and solving treasure maps."}]}, "developer_name": "START", "developer_privacy_policy_url": "https://taleoconnects.com/privacypolicy-tasktitans", "developer_terms_of_service_url": null, "publisher_name": "Taleo", "support_website_url": null, "website_url": "https://taleoconnects.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8648149061941426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982665_957506029499330_7935029406456349610_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CpjcBr8t0AQ7kNvwHbhIoI&_nc_oc=AdoTWvNWw_UqyigJRpC_j0zn-HBR
t.png", "id": "1639485714030071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296119_1639485720696737_1785548957935822602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ETTnDYQ50sQ7kNvwHt85gG&_nc_oc=AdqN7VhJ5wDQxbycYiLL1higY2Xh4v1j7uD7aKGyWn6Xb7P8WZ4ABUUsnWRB4hA1GaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvB4VoEW-5tTrUkrmpzry6mrltyJ-U1HK3gh9tXOJ6Ew&oe=6A622193"}, {"file_name": "Flag_Text.png", "id": "1189314706445342", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1189314709778675_3074967991687706250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ld-h8waFYcQ7kNvwE1Iwfq&_nc_oc=AdqQ4pbInViQ4WVKHFpb3JOrSfzBpbtudvq5VRGrldOnJE3blecFUKDCwJIhV_Pf_Kg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGdA1nQ1yROy7RbGCJsRbvAYqBBDFofOwnCYuUI63GYQ&oe=6A62259A"}, {"file_name": "Finish_Text.png", "id": "4780966468797233", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303140_4780966472130566_4632961161834191451_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9g0aXahaLWkQ7kNvwEq0rtA&_nc_oc=AdrRf7n2Bl2KERcRbD_G9KCkdReXBmCbaJfUMVLVzSZ2fJSLmGIexN4cdKJHTf4OIM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVKtai4gOP2lOoNk5H-eBI9ITzM805v9mBjky8wSIRJA&oe=6A62319E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orientr", "keywords": ["Orienteering", "Maps", "Compass", "Navigation", "SportsTraining"], "long_description": "**Orientr is an Early Access VR sports training simulator for orienteers who want to improve core skills used in the sport.**  Built for deliberate practice, it focuses on map reading, route choice, reorientation, and navigation accuracy using an orienteering map and compass, without highlighted paths, arrows, or step-by-step coaching.\n\nYou navigate terrain independently using the same kind of thinking and decision-making that orienteering demands. The challenge comes from interpreting terrain, planning efficient routes, and executing them accurately.\n\nOrientr is designed for practice, skill development, and performance improvement\u2014not casual exploration.\n\n**Who This Is For**\n- Current or former orienteers\n- Orienteers who want focused navigation practice\n\n**In Orientr, you can:**\n- Navigate using an orienteering map and compass\n- Practice route choice, reorientation, and independent navigation\n- Re-run courses to improve accuracy, efficiency, and consistency\n- Access 13 orienteering courses across four terrains\n\n**Important:** Orientr is designed for orienteering practice and skill development. It is not a guided exploration or tourism experience, and it does not provide tutorials or highlighted routes. Familiarity with orienteering maps, rules, and compass-based navigation is recommended.\n\n**Who Should Wait:**\n- If you want tutorials, hints, guided learning, or casual exploration, this version likely isn\u2019t a fit. Beginners may prefer to wait for a future release with instruction and progression.", "short_description": "Orientr is an Early Access VR sports training simulator for orienteers focused on map reading, route choice, reorientation, and navigation accuracy. Built for deliberate practice, it uses an orienteering map and compass without highlighted paths, arrows, or step-by-step coaching.  Designed for current or former orienteers, familiarity with orienteering maps, rules, and compass-based navigation is recommended."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ventrout.com/privacy-policy", "developer_terms_of_service_url": "https://www.ventrout.com/terms-of-use", "publisher_name": "VentR-out", "support_website_url": null, "website_url": "https://www.ventrout.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25297448236598262"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1256221325842840"}]}, "baseline_offer": {"id": "1256221325842840"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775051160, "status": "PUBLISHED", "id": "1256221325842840"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26489524184057322", "version": "0.8.0"}, "id": "686602384478613", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24967959562880466", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26489524184057322"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "686602384478613"}]}, "change_log": "Added a compass-based magnifying glass to improve map readability while navigating.\nSimplified map interaction by removing the map-snapped magnifying glass.\nAdded a new scene for expanded course variety.\nAddressed miscellaneous fixes and refinements based on testing and feedback.", "created_date": 1783875107, "id": "26489524184057322", "version": "0.8.0", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24967959562880466", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26489524184057322"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "686602384478613"}]}, "change_log": "\u201cImproved vegetation density across the terrain for a more realistic orienteering experience.\nAdjusted terrain visibility based on user feedback to reduce overly open sightlines and long-distance control visibility.\nAdded Omni One for Quest support, allowing players to physically walk and run in-game for enhanced immersion and active gameplay.\u201d", "created_date": 1782237416, "id": "26285101657832910", "version": "0.7.0", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24967959562880466", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26489524184057322"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "686602384478613"}]}, "change_log": "Orbo App Assistant\n\nAdded the first implementation of Orbo, the in-world assistant for Orientr.\n\nOrbo is currently focused on answering questions specifically about the Orientr app experience, including how to use features, controls, modes, and general in-app guidance.\n\nCurrent interaction flow:\n- Hold Y for 2 seconds to activate Orbo.\n- Press Y once to ask a new app-related question.\n- Hold Y for 2 seconds to dismiss Orbo.\n\nVirtuix Omni Input Support\n\nAdded support for Virtuix Omni movement input for treadmill-based locomotion.\n\nMap Reading Improvements\n\nAdded a magnifying glass feature to the map to make map reading easier when needed.\n\nMovement and Terrain Fixes\n\nResolved a movement issue where the player could become stuck when a specific thumbstick behavior was encountered.\n\nAdded a terrain collision patch to address cases where specific steep terrain conditions could cause the player to fall through the ground.", "created_date": 1781214106, "id": "26143333378676406", "version": "0.6.0", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24967959562880466", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26489524184057322"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781205971, "id": "26142186272124450", "version": "0.6.0", "version_code": 15, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24967959562880466", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26489524184057322"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781099670, "id": "26125915990418145", "version": "0.6.0", "version_code": 14, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
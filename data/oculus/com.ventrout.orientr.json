sjc3-1.oculuscdn.com/v/t64.5771-25/499304162_1266262204975116_966679328298963273_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsHkndZDZ-kQ7kNvwE3qs8B&_nc_oc=Adrf58YKMp-0E_MVFaLCKWYl4zyVQbmxtl4wCrRfBKiBIV-Y-HjryRv9YRZtT8XDH5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIDayf9oXBPuTbdjgS6_PSl-slfxHMdfo9D5UDbqagBg&oe=6ACFA62A"}, {"file_name": "Start_Text.png", "id": "1639485714030071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296119_1639485720696737_1785548957935822602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD6jpt0Ak4UQ7kNvwEBC0yJ&_nc_oc=AdoOAQAVqlXuBzUW_3Eun4tflIc4WLRudv7Wo-K6LmG3TGgJwaVErNdzyelQpsdTYL0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV7bcKpCiPAjR11gXWJRcp7Ww3ed9I7KSkYQzoQsr4CQ&oe=6ACF8E13"}, {"file_name": "Finish_Text.png", "id": "4780966468797233", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303140_4780966472130566_4632961161834191451_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoB7iqGQH_4Q7kNvwHlPvTI&_nc_oc=AdqbqMlr9d37EOoufNQjhieeAb7W21vSRQMdL4dOdR_3abEiiB0ji-VQPOGZFNtVV5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR0Q9DWBNwOHB6FjNdw6ZRFwTtAm9rHMEg5Tc2DXy_hw&oe=6ACF9E1E"}, {"file_name": "Learning Paths.png", "id": "1378286393776379", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622186_1378286397109712_3110944602798160395_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd08Ln7wDzIQ7kNvwFG2SfE&_nc_oc=AdqFa285XMpS1qSWE3ySpxvt7s502nKaTiuywhVWc3MNqdXYGYRa4Y0hqL-by-F_xUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNpu_-NhmQ4z9i-iCaqzB8cSAwySj1GVsGM8-mVyBVpA&oe=6ACFAD11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orientr", "keywords": ["Orienteering", "Maps", "Compass", "Navigation", "SportsTraining"], "long_description": "**Orientr is an Early Access VR sports training simulator for orienteers.\" Built for deliberate practice, it focuses on map reading, route choice, reorientation, and navigation accuracy using an orienteering map and compass, without highlighted paths, arrows, or step-by-step coaching. You navigate independently: the challenge is reading terrain, planning efficient routes, and executing them accurately.\n\n**Who This Is For**\n- Current or former orienteers\n- Orienteers who want focused navigation practice\n- Individuals who want to get familiar with ISOM symbols and orienteering fundamentals\n\n**In Orientr, you can:**\n- Navigate using an orienteering map and compass\n- Practice route choice, reorientation, and independent navigation\n- Access 19 orienteering courses across five terrains\n- Study map symbols, do quizzes and drills\n\n**Training scene (experimental)**\nISOM symbol study and symbol matching tents, and various informational kiosks plus quizzes and drills. Courses remain unassisted. Beginners can try the Training scene, but full instruction and progression are still to come.\n\n**Important:** Orientr is for practice and skill development, not for casual exploration or tourism. Courses give no tutorials or highlighted routes. Familiarity with orienteering maps and compass navigation is recommended.\n\n**Who Should Wait:**\n- Orienteering beginners may prefer to wait for a future release with instruction and progression. ", "short_description": "Orientr is an Early Access VR sports training simulator for orienteers focused on map reading, route choice, reorientation, and navigation accuracy. Built for deliberate practice, it uses an orienteering map and compass without highlighted paths, arrows, or step-by-step coaching.  Designed for current or former orienteers, familiarity with orienteering maps, rules, and compass-based navigation is recommended."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ventrout.com/privacy-policy", "developer_terms_of_service_url": "https://www.ventrout.com/terms-of-use", "publisher_name": "VentR-out", "support_website_url": nul
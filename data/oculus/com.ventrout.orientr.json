28298963273_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNso2EHnElcQ7kNvwEI5Rcq&_nc_oc=Adr5z_uv3H8_bs0J3gTb1tcgirMweWFEj03mp_sALy-VJ58GyTGEi_NLT39qZZcP3n4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3mQckLgrBMIyoyKnmFAgdO9F2WnwAwr5cewWTqkgt9A&oe=6AF1ED2A"}, {"file_name": "Start_Text.png", "id": "1639485714030071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296119_1639485720696737_1785548957935822602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3nGjAhzuaYQ7kNvwEaMQwF&_nc_oc=AdpzhYnnbkiAt3Sv5B87MP_i7HXSx7p7TxDXxNLnT2a-uAvG_6BgjKCtibuGBTsK1HQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRrwlufxqyo5D9YRxV66WdiJgE9CTMnWp7SuU6cPWpQA&oe=6AF1D513"}, {"file_name": "Flag_Text.png", "id": "1189314706445342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302770_1189314709778675_3074967991687706250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xUu4zmSSn0Q7kNvwF6Pzi-&_nc_oc=AdoSiFZzUWSEg4ZqbLnPw67_dI5HaH46PXTMcfcwDnlx38JJ5H8h_JKEDkZKHcoK3FE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkPaosQPYW8crh_nhW-3HeXue7OTS1PS28ADP2hxWKcQ&oe=6AF1D91A"}, {"file_name": "Finish_Text.png", "id": "4780966468797233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_4780966472130566_4632961161834191451_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tn4fPlQ5YVEQ7kNvwHn8RjR&_nc_oc=Adory7Kfz39loOqA3Sl9vRdazGau3j54IwJcbjs45ZVNsFw10sje5npmhTTZKbkirfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt_Th3tb3f0PbAlGrV2EldvFHbx5kZiJ_QiIWcAsmq0g&oe=6AF1E51E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orientr", "keywords": ["Orienteering", "Maps", "Compass", "Navigation", "SportsTraining"], "long_description": "**Orientr is an Early Access VR sports training simulator for orienteers who want to improve core skills used in the sport.**  Built for deliberate practice, it focuses on map reading, route choice, reorientation, and navigation accuracy using an orienteering map and compass, without highlighted paths, arrows, or step-by-step coaching.\n\nYou navigate terrain independently using the same kind of thinking and decision-making that orienteering demands. The challenge comes from interpreting terrain, planning efficient routes, and executing them accurately.\n\nOrientr is designed for practice, skill development, and performance improvement\u2014not casual exploration.\n\n**Who This Is For**\n- Current or former orienteers\n- Orienteers who want focused navigation practice\n\n**In Orientr, you can:**\n- Navigate using an orienteering map and compass\n- Practice route choice, reorientation, and independent navigation\n- Re-run courses to improve accuracy, efficiency, and consistency\n- Access 13 orienteering courses across four terrains\n\n**Important:** Orientr is designed for orienteering practice and skill development. It is not a guided exploration or tourism experience, and it does not provide tutorials or highlighted routes. Familiarity with orienteering maps, rules, and compass-based navigation is recommended.\n\n**Who Should Wait:**\n- If you want tutorials, hints, guided learning, or casual exploration, this version likely isn\u2019t a fit. Beginners may prefer to wait for a future release with instruction and progression.", "short_description": "Orientr is an Early Access VR sports training simulator for orienteers focused on map reading, route choice, reorientation, and navigation accuracy. Built for deliberate practice, it uses an orienteering map and compass without highlighted paths, arrows, or step-by-step coaching.  Designed for current or former orienteers, familiarity with orienteering maps, rules, and compass-based navigation is recommended."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ventrout.com/privacy-policy", "developer_terms_of_service_url": "https://www.ventrout.com/terms-of-use", "publisher_name": "VentR-out", "support_website_url": null, "website_url": "https://www.ventrout.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25297448236598262"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1256221325842840"}]}, "baseline_offer": {"id": "1256221325842840"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775051160, "status": "PUBLISHED", "id": "1256221325842840"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27783878454621882", "version": "0.17.0"}, "id": "686602384478613", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24967959562880466", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27783878454621882"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "686602384478613"}]}, "change_log": "Expanded movement controls with three new steering options\u2014Head 2D, Controller, and Set on Push\u2014alongside the existing Head and Chest modes for greater flexibility and control.\nAdded tutorials for each movement mode and contextual guidance in Settings to make controls easier to unders
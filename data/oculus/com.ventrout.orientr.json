iad3-2.oculuscdn.com/v/t64.5771-25/499304162_1266262204975116_966679328298963273_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ7cDQHAcDMQ7kNvwFSzj9N&_nc_oc=AdrlFcFCjYJlby2HwswnJQF5Nx_McCuvd3CDWvlzZ8juahTEbiVbu5dmCULcMOFr3BQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU6QfYprqgmyej6MpxpVcoNTeg4gwXjn75yLl3EccNqA&oe=6A9EDEAA"}, {"file_name": "Start_Text.png", "id": "1639485714030071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296119_1639485720696737_1785548957935822602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYUcJtKIZ90Q7kNvwEff592&_nc_oc=AdqPcg1oIZTtJR2RwJP4QGNiyBtmXLiIMmG4H2qlJyFMu73cX0lcaCzWXnl4MXqA3xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiVwOMP0U6b9UOBvy9xIfNFFaNlUrQJTWJYeasWbdt3A&oe=6A9EC693"}, {"file_name": "Finish_Text.png", "id": "4780966468797233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_4780966472130566_4632961161834191451_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FZZo7-HkrMQ7kNvwGLyiS5&_nc_oc=Ado1ZbqKqKw214zKlHKTyxH3I1sqk_m7m-su6N7z-p2j_SDm_rlUJGCZMujfcQ6FOk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ66_GaIIn_rHgNhw3hkURXpjmZ7lvpdjxbgww_lpZVkQ&oe=6A9ED69E"}, {"file_name": "Learning Paths.png", "id": "1378286393776379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622186_1378286397109712_3110944602798160395_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIn-D424ExQQ7kNvwFjAb4e&_nc_oc=AdpuCE2PLSuzDpiVFqQH9Xhy3KSBLIj9ZXsCSFZ7JG-07HRQ5_T46erB2Y6V8BKAnyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG28oGj3aLe9BCq0VLIbwf_m8e2U2bxRRbjTBF2QSVxA&oe=6A9EE591"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orientr", "keywords": ["Orienteering", "Maps", "Compass", "Navigation", "SportsTraining"], "long_description": "**Orientr is an Early Access VR sports training simulator for orienteers.\" Built for deliberate practice, it focuses on map reading, route choice, reorientation, and navigation accuracy using an orienteering map and compass, without highlighted paths, arrows, or step-by-step coaching. You navigate independently: the challenge is reading terrain, planning efficient routes, and executing them accurately.\n\n**Who This Is For**\n- Current or former orienteers\n- Orienteers who want focused navigation practice\n- Individuals who want to get familiar with ISOM symbols and orienteering fundamentals\n\n**In Orientr, you can:**\n- Navigate using an orienteering map and compass\n- Practice route choice, reorientation, and independent navigation\n- Access 19 orienteering courses across five terrains\n- Study map symbols, do quizzes and drills\n\n**Training scene (experimental)**\nISOM symbol study and symbol matching tents, and various informational kiosks plus quizzes and drills. Courses remain unassisted. Beginners can try the Training scene, but full instruction and progression are still to come.\n\n**Important:** Orientr is for practice and skill development, not for casual exploration or tourism. Courses give no tutorials or highlighted routes. Familiarity with orienteering maps and compass navigation is recommended.\n\n**Who Should Wait:**\n- Orienteering beginners may prefer to wait for a future release with instruction and progression. ", "short_description": "Orientr is an Early Access VR sports training simulator for orienteers focused on map reading, route choice, reorientation, and navigation accuracy. Built for deliberate practice, it uses an orienteering map and compass without highlighted paths, arrows, or step-by-step coaching.  Designed for current or former orienteers, familiarity with orienteering maps, rules, and compass-based navigation is recommended."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ventrout.com/privacy-policy", "developer_terms_of_service_url": "https://www.ventrout.com/terms-of-use", "publisher_name": "VentR-out", "support_website_url": nul
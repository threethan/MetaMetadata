iad3-2.oculuscdn.com/v/t64.5771-25/499304162_1266262204975116_966679328298963273_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNso2EHnElcQ7kNvwEI5Rcq&_nc_oc=Adr5z_uv3H8_bs0J3gTb1tcgirMweWFEj03mp_sALy-VJ58GyTGEi_NLT39qZZcP3n4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3mQckLgrBMIyoyKnmFAgdO9F2WnwAwr5cewWTqkgt9A&oe=6AF1ED2A"}, {"file_name": "Start_Text.png", "id": "1639485714030071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296119_1639485720696737_1785548957935822602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3nGjAhzuaYQ7kNvwEaMQwF&_nc_oc=AdpzhYnnbkiAt3Sv5B87MP_i7HXSx7p7TxDXxNLnT2a-uAvG_6BgjKCtibuGBTsK1HQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRrwlufxqyo5D9YRxV66WdiJgE9CTMnWp7SuU6cPWpQA&oe=6AF1D513"}, {"file_name": "Finish_Text.png", "id": "4780966468797233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_4780966472130566_4632961161834191451_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tn4fPlQ5YVEQ7kNvwHn8RjR&_nc_oc=Adory7Kfz39loOqA3Sl9vRdazGau3j54IwJcbjs45ZVNsFw10sje5npmhTTZKbkirfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt_Th3tb3f0PbAlGrV2EldvFHbx5kZiJ_QiIWcAsmq0g&oe=6AF1E51E"}, {"file_name": "Learning Paths.png", "id": "1378286393776379", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622186_1378286397109712_3110944602798160395_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ5WHRFy8GsQ7kNvwFRP4gg&_nc_oc=AdpZadB6bYrqHUPg2naRtW80AXPftwX_haomXM_8UCya9YUz-Uh8o_lgyin27tLnDDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoRWLrkdEHWBu_Boti-Y0ckRF3aYTlMQscG7i6DUNEIg&oe=6AF1F411"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orientr", "keywords": ["Orienteering", "Maps", "Compass", "Navigation", "SportsTraining"], "long_description": "**Orientr is an Early Access VR sports training simulator for orienteers.\" Built for deliberate practice, it focuses on map reading, route choice, reorientation, and navigation accuracy using an orienteering map and compass, without highlighted paths, arrows, or step-by-step coaching. You navigate independently: the challenge is reading terrain, planning efficient routes, and executing them accurately.\n\n**Who This Is For**\n- Current or former orienteers\n- Orienteers who want focused navigation practice\n- Individuals who want to get familiar with ISOM symbols and orienteering fundamentals\n\n**In Orientr, you can:**\n- Navigate using an orienteering map and compass\n- Practice route choice, reorientation, and independent navigation\n- Access 19 orienteering courses across five terrains\n- Study map symbols, do quizzes and drills\n\n**Training scene (experimental)**\nISOM symbol study and symbol matching tents, and various informational kiosks plus quizzes and drills. Courses remain unassisted. Beginners can try the Training scene, but full instruction and progression are still to come.\n\n**Important:** Orientr is for practice and skill development, not for casual exploration or tourism. Courses give no tutorials or highlighted routes. Familiarity with orienteering maps and compass navigation is recommended.\n\n**Who Should Wait:**\n- Orienteering beginners may prefer to wait for a future release with instruction and progression. ", "short_description": "Orientr is an Early Access VR sports training simulator for orienteers focused on map reading, route choice, reorientation, and navigation accuracy. Built for deliberate practice, it uses an orienteering map and compass without highlighted paths, arrows, or step-by-step coaching.  Designed for current or former orienteers, familiarity with orienteering maps, rules, and compass-based navigation is recommended."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ventrout.com/privacy-policy", "developer_terms_of_service_url": "https://www.ventrout.com/terms-of-use", "publisher_name": "VentR-out", "support_website_url": nul
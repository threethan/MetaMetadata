c_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw21h-jLct8Q7kNvwGKSgYP&_nc_oc=AdpBVbqDl3ve__NC0-6V5ba81_NOJYgVV-AvAm8fV71u8vUYmyoQDMgf4tYhYk8wAAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8rBStysqYF2TDP1uMkzI1VC9eV6XxI5l8fIG55AMxZA&oe=6A3EA015"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cafe Simulator VR - Manage Your Cafe", "keywords": ["cafesimulator", "cafegames", "mixedreality", "simulationgames", "managergames"], "long_description": "Experience caf\u00e9 management like never before with Cafe Simulator VR \u2013 Manage Your Cafe, a top-down VR caf\u00e9 simulator featuring an immersive Mixed Reality passthrough experience on Meta Quest.\n\nTurn your real room into a virtual caf\u00e9 using passthrough mixed reality, where your caf\u00e9 appears right in your physical space. View everything from a top-down perspective, giving you full control over operations while staying aware of your surroundings.\n\n\u2615 Top-Down Cafe Management in VR\nOversee your caf\u00e9 from above, manage customer flow, prepare orders, and keep operations running smoothly.\n\n\ud83e\udde0 Mixed Reality Passthrough Experience\nPlay using MR passthrough and see your caf\u00e9 blend seamlessly into your real environment for a unique and comfortable VR experience.\n\n\ud83d\udc65 Serve Customers & Complete Orders\nHandle incoming customers, prepare food and drinks, and deliver orders efficiently to keep everyone happy.\n\n\ud83d\udd79\ufe0f Easy & Intuitive Controls\nDesigned for Meta Quest, the game is accessible for both casual and experienced VR players.\n\n\ud83d\ude0c Relaxing Yet Engaging Simulation\nPerfect for fans of management games, simulation experiences, and cozy VR gameplay.\n\nWhether you\u2019re new to VR or a simulation enthusiast, Cafe Simulator VR offers a fresh take on caf\u00e9 management with top-down gameplay and Mixed Reality immersion.\n\n\ud83d\udc49 Build, manage, and enjoy your caf\u00e9\u2014right in your own room!", "short_description": "Manage your own caf\u00e9 in top-down VR with Mixed Reality passthrough \u2615 Serve customers, handle orders, and run your caf\u00e9 in your real space."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25885873904386269"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820864_1185023623614100_3072271111968465793_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_cOlzSppfEQ7kNvwEJz1DZ&_nc_oc=Adr05ZwcEcjUF-8e6D3Ag96f3JRbmDuqtvYXE1mzHwy98x4yy-JPgBZ7R6v9ThJDmkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TCPJHn8vOVJwPBnpQ3mPXgGwLxutS30VQz7VzlMduHg&oe=6A3EA523"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cafe Simulator VR - Manage Your Cafe", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 17
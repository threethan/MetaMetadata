Q7kNvwGrX6qT&_nc_oc=AdrzRzHUS08La741kJ5xzWQj_y8_MkrlVfmb7fzeRNrIMQV2SwdsRTI3Ok-AAJKYYg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f260woaiGSLBv17t8JlPtU_3ZhN0bF0416Q0iDADSKQ&oe=69D517CF"}, {"file_name": "migrated_image.png", "id": "881811615591948", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727962_846628025467494_3784358283653939200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfp7XRtr750Q7kNvwFvsUYU&_nc_oc=Adr_VYZhdXnh-9OBMzR6FpiAlVmUNTDGH0OIUyNwp2is1ULdQePO2bkqZ-sXFOhT4o0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BRme3eOpvxheRA0V3O9M0RQlitUYMbbIv46GkF9r5mg&oe=69D503D6"}, {"file_name": "migrated_image.png", "id": "216586072791716", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727966_1337866449587382_8386001465952436224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCEY-aMcaD8Q7kNvwGPUbVz&_nc_oc=AdqcgzQfR86DHyP-M__Ap5ZWY-INYRPCc6Nh2w9O3hlH06oJFofvwEXFLj7mWddratg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36hdgdvRui78hDNQCRieKRv2VtRjAf4aqwjKh0dpBmWQ&oe=69D4FA2C"}, {"file_name": "migrated_image.png", "id": "521681468547117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386393_1922418697985747_4761419294309351424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZBFpmpCQiIQ7kNvwGl5qcu&_nc_oc=AdpPvqMfdHvV76W7Rr1FTTIeNeKsd1miD11PSBbnK1aPpgN83PN7PtZ7LTIg_KGYobA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_TCdGUIXHEOPT0egpqZeQLkyhC9SnOZuYlnocd1Nd8A&oe=69D4FF51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CBC VR", "keywords": ["native", "documentary", "canada", "aboriginal", "currentaffairs"], "long_description": "Ramona Wilson was 16 years old when she left her home in Smithers, British Columbia on June 11th, 1994. Her body was discovered eight months later, but her killer has never been found. In September, the Canadian government officially launched an inquiry into Canada's missing and murdered indigenous women. In this immersive documentary, Ramona\u2019s mother, Matilda, shares her story of personal loss and ongoing search for answers.", "short_description": "Since the 1970s, at least eighteen predominantly indigenous women have been murdered or have disappeared along Highway 16. This immersive documentary transports viewers to Northern B.C. and the area known as the Highway of Tears."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://cbc.ca/radio/thecurrent", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253572866925611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410318_287456858307386_5704596552052375552_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjCT9mt3rWQQ7kNvwH-jNpw&_nc_oc=Adq53J0KCGIoGSvGzIClmJDbmhW_u4PUkDmCwKw95pr8iPeRFvlZS7Ui31tGJGPpQKY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QH9aCARZs2W2STCQwWyjCFuJv6PXnzPXZvYs0rvKw1Q&oe=69D50A28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CBC VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1476428400, "lastRevision": {"nodes": [{"id": "1112896152110303", "release_type": "SCH
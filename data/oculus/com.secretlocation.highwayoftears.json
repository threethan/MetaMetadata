Q7kNvwHf__ZM&_nc_oc=Adq9SN4hbqyVoWXRma6rSFS9ylSsts1TKdq8qrHC2mt59nQkQW-jrclOJKRhQn007SQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFJmX-pthUvXR0Us6McZ1yZXMFdkGQpOFbD5q4GN43iA&oe=6AC65A4F"}, {"file_name": "migrated_image.png", "id": "881811615591948", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727962_846628025467494_3784358283653939200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB-7fyxRRV8Q7kNvwHyxIrU&_nc_oc=Adp38XjeHniLWXrETeZuSj8swHdvUfwnu7zmIZDREVrRl91yRai_eGRUd5DdWjBHCAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB9IhouAFrDvf9bBUW_0CxnKGoo2N6ISGJrPgHNjEBhw&oe=6AC64656"}, {"file_name": "migrated_image.png", "id": "216586072791716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727966_1337866449587382_8386001465952436224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbhe5YYn42UQ7kNvwEVqVtf&_nc_oc=Ado0QIzVSObs3Ctx4hXLzNgXyDlAhEswn8ai4g-T3pzubOmrVO9UN3b5eo8pkYEHMyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEKcXF__K87aX3Qb5LnhmLoUw_H4mmxtLQ8oVyFEcUuQ&oe=6AC674EC"}, {"file_name": "migrated_image.png", "id": "521681468547117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386393_1922418697985747_4761419294309351424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vsI7zk8I7MQ7kNvwHBJzTj&_nc_oc=AdpSu_L4XUo4BX2Dv9cG2ex6Qmn02OHVq2AcdeaYHa0yt8qAKvmpRPoJheCB_vjR5VM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh2G1Pp34odkAGc-dktOBOOuP-pEfijOmc7RmrWzDemg&oe=6AC641D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CBC VR", "keywords": ["native", "documentary", "canada", "aboriginal", "currentaffairs"], "long_description": "Ramona Wilson was 16 years old when she left her home in Smithers, British Columbia on June 11th, 1994. Her body was discovered eight months later, but her killer has never been found. In September, the Canadian government officially launched an inquiry into Canada's missing and murdered indigenous women. In this immersive documentary, Ramona\u2019s mother, Matilda, shares her story of personal loss and ongoing search for answers.", "short_description": "Since the 1970s, at least eighteen predominantly indigenous women have been murdered or have disappeared along Highway 16. This immersive documentary transports viewers to Northern B.C. and the area known as the Highway of Tears."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://cbc.ca/radio/thecurrent", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253572866925611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410318_287456858307386_5704596552052375552_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaOULRh4I28Q7kNvwHBaytM&_nc_oc=Adp-ywn4gQxma-1XMlJ33TEOWM2OlruuN8irKutfchaLwWYmMGMwOqJtieE-_YSUpQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF3SxhjrLBqmIEy_dt9GEFfAQhNzH9cBFgM8l0-RItLA&oe=6AC64CA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CBC VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1476428400, "lastRevision": {"nodes": [{"id": "1112896152110303", "release_type": "SCH
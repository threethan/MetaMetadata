Q7kNvwEoUObK&_nc_oc=AdqwDBhG2-_zk2U5eFzTA07JDqHk3MWUp9bhlDXZz-UJhy5OrgZ_S41Id4G2B5Lpn-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UKGl3mi4aCiGG5NuanI-JBeO2OhisxQvKRpY0Sq4Lvw&oe=69FA01CF"}, {"file_name": "migrated_image.png", "id": "881811615591948", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727962_846628025467494_3784358283653939200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4UlwbM2pSMQ7kNvwFlTfhV&_nc_oc=Adpy505VZzQLpfDiA8onp8zipnPSUdOYO8fpDjkV8Uzi2-DNJ3nQZnorqPcZiMPoY64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aEE8JHF2ZmVy5VtuuvaRBhb2F610pNuixeOB0PG6vNw&oe=69F9EDD6"}, {"file_name": "migrated_image.png", "id": "216586072791716", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727966_1337866449587382_8386001465952436224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMIP48cAddAQ7kNvwFczIFL&_nc_oc=AdruYaK_bYJYo85LoLZd1WqJPPcoFst_R1Gyp8AWkYk4WKuthptqDSeusWY2R2ufG1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IiwlgQfSDpnmsfFt1pFDM_mwyCG24f7XPcmF-FEde0w&oe=69F9E42C"}, {"file_name": "migrated_image.png", "id": "521681468547117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386393_1922418697985747_4761419294309351424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5T9vF7dvnEQ7kNvwHLWBtG&_nc_oc=AdqLFkpLrRnxv0lTNAtZ0I6Mxeo1RoGYu6DdvOo5v_61fVUkVJugJAEzn9DOIdLTX6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H5wgdKSvMpLl0uB7lMmk2xn-nILky7fiyjoDiQmypRA&oe=69F9E951"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CBC VR", "keywords": ["native", "documentary", "canada", "aboriginal", "currentaffairs"], "long_description": "Ramona Wilson was 16 years old when she left her home in Smithers, British Columbia on June 11th, 1994. Her body was discovered eight months later, but her killer has never been found. In September, the Canadian government officially launched an inquiry into Canada's missing and murdered indigenous women. In this immersive documentary, Ramona\u2019s mother, Matilda, shares her story of personal loss and ongoing search for answers.", "short_description": "Since the 1970s, at least eighteen predominantly indigenous women have been murdered or have disappeared along Highway 16. This immersive documentary transports viewers to Northern B.C. and the area known as the Highway of Tears."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://cbc.ca/radio/thecurrent", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253572866925611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410318_287456858307386_5704596552052375552_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdvxLOqK77QQ7kNvwFdb045&_nc_oc=AdoD5BS9nygIOHFabhQtrriA2HPrEjbj7tVecwB1XDDq4uFarmqfUaC0_Mz9LozeDvw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fHNwfQ4cIyWhF2eU8-_FxjkGcRayW95M7j_MBFM41JA&oe=69F9F428"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CBC VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1476428400, "lastRevision": {"nodes": [{"id": "1112896152110303", "release_type": "SCH
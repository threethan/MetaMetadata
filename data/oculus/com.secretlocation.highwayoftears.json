rrentaffairs"], "long_description": "Ramona Wilson was 16 years old when she left her home in Smithers, British Columbia on June 11th, 1994. Her body was discovered eight months later, but her killer has never been found. In September, the Canadian government officially launched an inquiry into Canada's missing and murdered indigenous women. In this immersive documentary, Ramona\u2019s mother, Matilda, shares her story of personal loss and ongoing search for answers.", "short_description": "Since the 1970s, at least eighteen predominantly indigenous women have been murdered or have disappeared along Highway 16. This immersive documentary transports viewers to Northern B.C. and the area known as the Highway of Tears."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://cbc.ca/radio/thecurrent", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253572866925611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410318_287456858307386_5704596552052375552_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5po5KfCf4wAQ7kNvwGLepLA&_nc_oc=AdokUZiNxDkYYDv6mP2so52rwm4SzyvK5NlG4Hf-8-l2AXgHGm0kOKjBT4nJt3xzCV4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f
other, Matilda, shares her story of personal loss and ongoing search for answers.", "short_description": "Since the 1970s, at least eighteen predominantly indigenous women have been murdered or have disappeared along Highway 16. This immersive documentary transports viewers to Northern B.C. and the area known as the Highway of Tears."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://cbc.ca/radio/thecurrent", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253572866925611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410318_287456858307386_5704596552052375552_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_VD0r8_W1kQ7kNvwHbF4Xp&_nc_oc=AdpQEtHKyZlgY2teUdpISNK5EbZc7k9lk5i_jflHpuMYDhlPz-zADucYi77Q6lkRoyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14PvG2mQMw5d2TErGU_mpDg5H723MTIBg_HF7Y2AiKqQ&oe=69F20B28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CBC VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1476428400, "lastRevision": {"nodes": [{"id": "1112896152110303", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": 
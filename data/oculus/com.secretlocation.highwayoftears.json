QVHHMz7ruCGGAG4ip9PAncYCwaTjD25PQ34xejSOpmR3GB9Ipy7XDsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPaqzaV-NM8as7PIYMr8pRU3hsfdmWps2-72OlR_03BA&oe=69AEDC4F"}, {"file_name": "migrated_image.png", "id": "881811615591948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727962_846628025467494_3784358283653939200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X8g7ZcbPP0Q7kNvwFj7CIW&_nc_oc=AdmYnKgHYvqY_FxYMHGHpr4UQjLKpgcuRGmuYrHn2FedIcAsn7xvklzy4QBXFHPx73E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxadxWgzVomVVyWRbZAoXNDhz2Yaw8iStSA9VsL2MFMYA&oe=69AEC856"}, {"file_name": "migrated_image.png", "id": "216586072791716", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727966_1337866449587382_8386001465952436224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g19yzpxouHUQ7kNvwG7j52B&_nc_oc=AdmXO_6tPNzRjjg57LpuGpaDY7CNJZU7NiQXMInqtgcOC6FQ3OJaA1Q5bVGSyGDPID0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLJYXe4ntW2TvuxP2ht57YQiREYplgW2mMYx5voGvvgg&oe=69AEBEAC"}, {"file_name": "migrated_image.png", "id": "521681468547117", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386393_1922418697985747_4761419294309351424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQNdFRbgUZkQ7kNvwFVelDY&_nc_oc=AdnHmBLHCgAUaGLkPqxhPSE01FH1YZ-xXiV_qJUQG1HyiH3V6cgMhheVLSb-8tXzUes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5ofiGzu_RkLfs_uWavB7D_FtgntcgaVoUMCvhhU5kPg&oe=69AEC3D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CBC VR", "keywords": ["native", "documentary", "canada", "aboriginal", "currentaffairs"], "long_description": "Ramona Wilson was 16 years old when she left her home in Smithers, British Columbia on June 11th, 1994. Her body was discovered eight months later, but her killer has never been found. In September, the Canadian government officially launched an inquiry into Canada's missing and murdered indigenous women. In this immersive documentary, Ramona\u2019s mother, Matilda, shares her story of personal loss and ongoing search for answers.", "short_description": "Since the 1970s, at least eighteen predominantly indigenous women have been murdered or have disappeared along Highway 16. This immersive documentary transports viewers to Northern B.C. and the area known as the Highway of Tears."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://cbc.ca/radio/thecurrent", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253572866925611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410318_287456858307386_5704596552052375552_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3E1Oj0uqEcQ7kNvwEvjzCW&_nc_oc=AdltywaldYMyFjSnHD5cJ9Z9zvl3eWGskZuicXm3PJBjEVC5IHllxF24aFoP1inVb7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxw4Woxo9MOdsBXXAR-KjAlEND3m6VsBLaRVGBizHj82g&oe=69AECEA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CBC VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1476428400, "lastRevision": {"nodes": [{"id": "1112896152110303", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_m
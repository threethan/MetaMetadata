Q7kNvwG2eqTV&_nc_oc=AdpAo71LYt78LAU4ihPkw2wRu7-PeiYLg_svVFdflwg27NJmps0a8cKwN6-_G_06uy4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCWHmTQ1Jzr1y3K4SgL3MLVRwhbckkF0HDjS7YJ3LXFw&oe=6AD3894F"}, {"file_name": "migrated_image.png", "id": "881811615591948", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727962_846628025467494_3784358283653939200_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRtPpPnyA2QQ7kNvwH-HPNz&_nc_oc=AdoiYC4k1CGAebW9iK2LGxE-b9QqVqw1GE3JBHOAGvlRxtIAlCQH_HqV229twZPq5qA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFM0tGStOEh32N-CohizQH0BSamcC-03CLK_Zm3mt63g&oe=6AD3AD96"}, {"file_name": "migrated_image.png", "id": "216586072791716", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727966_1337866449587382_8386001465952436224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgRmiRp-nX8Q7kNvwHpRsj0&_nc_oc=AdpyOZc9cN8UTNkkmytvcPCEnwX5uYZuTVOPL9ZTvTUoq8f8yKnd3R3dl_owN5HQh7o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmv5tPPs1VZDRIh14P8BftK3HXYgbSwpJVhqihAxBUxg&oe=6AD3A3EC"}, {"file_name": "migrated_image.png", "id": "521681468547117", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12386393_1922418697985747_4761419294309351424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d4tqnCq4MgQ7kNvwG38la2&_nc_oc=AdrlsX-3btHPZjx9PRn8jLYQ0ZeyxaKvvBslgu0IfacGJXN91CqTFVRkcO4a2P7zVnU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD3Wq9gISwEGd5_hoxgKaZDs24cudfGzaNuKv35YQAKQ&oe=6AD3A911"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CBC VR", "keywords": ["native", "documentary", "canada", "aboriginal", "currentaffairs"], "long_description": "Ramona Wilson was 16 years old when she left her home in Smithers, British Columbia on June 11th, 1994. Her body was discovered eight months later, but her killer has never been found. In September, the Canadian government officially launched an inquiry into Canada's missing and murdered indigenous women. In this immersive documentary, Ramona\u2019s mother, Matilda, shares her story of personal loss and ongoing search for answers.", "short_description": "Since the 1970s, at least eighteen predominantly indigenous women have been murdered or have disappeared along Highway 16. This immersive documentary transports viewers to Northern B.C. and the area known as the Highway of Tears."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://cbc.ca/radio/thecurrent", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253572866925611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410318_287456858307386_5704596552052375552_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h38FxNafkPUQ7kNvwHs7-Ud&_nc_oc=AdoG5P3Sp4w9UFtSdV9qR2P-MyrcYPVK7PhRDqRaxO5hXSREG8lAcPFDHRRtSmpC1sA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEjZP6hlBPXaC59w75jwCWQ1XnbZzXgkoNB43yebyeHQ&oe=6AD3B3E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CBC VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1476428400, "lastRevision": {"nodes": [{"id": "1112896152110303", "release_type": "SCH
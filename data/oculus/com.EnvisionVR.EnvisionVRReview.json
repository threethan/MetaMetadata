kEf41sX0BDl8RRd_Rs733RjLyHjWxm4bxJTJUUwdOAG3SLTtSgwPCsM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuKjHiEqpvLDpnF6IdnIuvE8nlXzv9yGmQgb_G8ccvEYg&oe=69984342"}, {"file_name": "Screenshot 3.png", "id": "1157866061680077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462961_1157866065013410_3667732065667207354_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBVsdp57RuwQ7kNvwG7rrHP&_nc_oc=AdmkSryHPgLs54VaFirgXH8pED-86aimU-R08KCOnRDQIszwYxRaCYBq1_yenXsLqqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuyP766rHCrQVQIVGnwPvNDbsT3ETq7ePn33jqqs6jc_A&oe=6998445C"}, {"file_name": "Screenshot 4.png", "id": "661325385063516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569428_661325388396849_2053254615192966391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWZYUwTBVncQ7kNvwG2loeU&_nc_oc=Adn-NuU_Z6yeo2mgN87lA2EZwUOZY8VV_ROv70i2I8t8k8DReI6sHgsPxS5UiL7dmF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftW8-qqsHPKz7fdg245aZnGD6_XFyO64-LL8OIshM8Xgg&oe=69984E72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "480940980080059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031423_480940983413392_1285073711481211677_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nFuQ2qzS80Q7kNvwER26PH&_nc_oc=AdlMQuoduvOoJP189EqIQ4HuOxrIiRCGAVogiB1MfSP11G1MPRUEZ8H0zew1OAtpPa8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfslowsnuYILUc7QWkSBwglMzicEIfi8CfvGCfKDeWZAuA&oe=69984EAE"}, "display_name": "EnvisionVR Design", "keywords": [], "long_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property.\n\nOff-the-plan properties have been sold in the same way for years with brochures, high-quality photo renders, and stylish display suites. Whilst they do the trick, here at EnvisionVR we like to take things to the next level. That's why we created our world-first EnvisionVR app which allows you to view your future project in high-fidelity Virtual Reality and Augmented Reality using a VR headset or smart device. Our VR experiences are completely mobile, multi-person and collaborative coupled with an easy- to-use interface that will enhance your sales process.", "short_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionvr.net/app-privacy-policy/", "developer_terms_of_service_url": "https://envisionvr.net/app-terms-of-use/", "publisher_name": "Envision VR Pty Ltd", "support_website_url": null, "website_url": "https://envisionvr.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "4973300049405525"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "670969137567912"}]}, "baseline_offer": {"id": "670969137567912"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649290020, "status": "PUBLISHED", "id": "670969137567912"}]}, "liveChannel": {"nodes": [{"lates
0f&oh=00_AQKEOf19NXrqLUQNUiopADprNxpEjniOyACjy1viMcIKSA&oe=6AA7E711"}, {"file_name": "Screenshot 1.png", "id": "4823166671105949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481472_4823166674439282_7442781174556112986_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-25YnlGqa8Q7kNvwE-NDu1&_nc_oc=AdruPw6CocAruSAzgHiUmwwdFD1w8yry7Ob4_2Q86P9x7xJbUiUChrYhpvrpoMBh5YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7gRSY94o5AcPwK_JRsrx58xf4npa6zCAf0Yjq3SLE2A&oe=6AA80347"}, {"file_name": "Screenshot 2.png", "id": "690945472083309", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75278187_690945475416642_9106832557535065375_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipquZMzpXNoQ7kNvwFXPte4&_nc_oc=AdphVjHL76m-TihTMkWlrlxmN-5NIWW6kmmCxr5zG8u8MQbMgXRpXel-8ug6gab0ECU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgwYNXFqO5pPhiLXNuwhjykT03-5feRovHob4mLkt4Cg&oe=6AA81082"}, {"file_name": "Screenshot 3.png", "id": "1157866061680077", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462961_1157866065013410_3667732065667207354_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4ei4Uu-oyEQ7kNvwEmq_gc&_nc_oc=AdqssriKDKokVO29hjPJJofoT0FjHIpcVXYgI0NwiveyvFFk2XYtlDSsK3_GD-7FFms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf_JTE99LNWP6MB5-VV8F89JfbGOcljiUgdjsBV4Df1A&oe=6AA8119C"}, {"file_name": "Screenshot 4.png", "id": "661325385063516", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569428_661325388396849_2053254615192966391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RE7dtEbfEOcQ7kNvwHEYPsT&_nc_oc=Adp1iyPklDIdBeemlIc9IizKk0g7pjqdnrQQsqlOkvIBAWXtUg4kmtEbnqks4N4QJlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEmNo_ye7IsF6Mf90bZzOCyaZ9K8Pk1Lr96AT0M2bZIg&oe=6AA7E372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "480940980080059", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031423_480940983413392_1285073711481211677_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I53PtCUKhB4Q7kNvwFkA0aE&_nc_oc=Adr1AX2uVf-ma4MnkZPKIZupRYgoMDm1Qmlsl-iACI7ylbhsKENPGazK9Re468sAiPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQgkzST7GzpiZBC1VYd3whJi5wsgz8xP85dsq2zoIfaA&oe=6AA7E3AE"}, "display_name": "EnvisionVR Design", "keywords": [], "long_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property.\n\nOff-the-plan properties have been sold in the same way for years with brochures, high-quality photo renders, and stylish display suites. Whilst they do the trick, here at EnvisionVR we like to take things to the next level. That's why we created our world-first EnvisionVR app which allows you to view your future project in high-fidelity Virtual Reality and Augmented Reality using a VR headset or smart device. Our VR experiences are completely mobile, multi-person and collaborative coupled with an easy- to-use interface that will enhance your sales process.", "short_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionvr.net/app-privacy-policy/", "developer_terms_of_service_url": "https://envisionvr.net/app-terms-of-use/", "publisher_name": "Envision VR Pty Ltd", "support_website_url": null, "website_url": "https://envisionvr.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
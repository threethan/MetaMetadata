.com/v/t64.5771-25/75278187_690945475416642_9106832557535065375_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zoz0hXmigWEQ7kNvwFkhOlQ&_nc_oc=AdrgKet2g4fSd2_soqLYv2aVwjM4bZSPL9QH4hUY3tjukgQ8u1kUpzNWVrYDAQoIC2c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1uApjN5GoPxbQla6stpboJb9j5EX-RFnOa6SMJmq0tOw&oe=69F1E942"}, {"file_name": "Screenshot 3.png", "id": "1157866061680077", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75462961_1157866065013410_3667732065667207354_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou3LZbp20-kQ7kNvwFoyDCs&_nc_oc=Adq2mv8dMH4JHqzPfA0o1pTzNRZHiA3qWPiiTCYjkDMyRzFOyICF16R0M3o7vrtbBGY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UG6tST_J5oEvSfUAo21x4Xcz1saUlPf04ueeqiuTZNQ&oe=69F1EA5C"}, {"file_name": "Screenshot 4.png", "id": "661325385063516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569428_661325388396849_2053254615192966391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mjCFEaFSx0Q7kNvwFBALhr&_nc_oc=Ador8oyuhVzr6NjrVyvLv_b45YnG1EDS63hg7HIOIeSPtBJxWL6VE6JOqKjB8EC8N0w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2ZaZa7upzbstQ7nIKzJhs8hWpgDcHzOEKOz2Wr4JYYYw&oe=69F1F472"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "480940980080059", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031423_480940983413392_1285073711481211677_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH1ACkwN-HkQ7kNvwFJhosO&_nc_oc=AdpnyRxOROS6SneBcmJq3ttx-9bbTYlwcjA2uhXF_uTkuXML44HTnZ7iJeg6S5SK-RM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Lre8tGO_AGPzxS3LBW4dqUFQDjgsnOM9Ns7a5KrqapQ&oe=69F1F4AE"}, "display_name": "EnvisionVR Design", "keywords": [], "long_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property.\n\nOff-the-plan properties have been sold in the same way for years with brochures, high-quality photo renders, and stylish display suites. Whilst they do the trick, here at EnvisionVR we like to take things to the next level. That's why we created our world-first EnvisionVR app which allows you to view your future project in high-fidelity Virtual Reality and Augmented Reality using a VR headset or smart device. Our VR experiences are completely mobile, multi-person and collaborative coupled with an easy- to-use interface that will enhance your sales process.", "short_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionvr.net/app-privacy-policy/", "developer_terms_of_service_url": "https://envisionvr.net/app-terms-of-use/", "publisher_name": "Envision VR Pty Ltd", "support_website_url": null, "website_url": "https://envisionvr.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "4973300049405525"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "670969137567912"}]}, "baseline_offer": {"
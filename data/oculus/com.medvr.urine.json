tion is an immersive VR training simulation designed to teach and assess the correct technique for collecting a midstream urine sample. This interactive experience guides learners through each step of the procedure\u2014from preparation and patient guidance to sample handling and labeling\u2014within a realistic clinical setting.\n\nDeveloped for healthcare students and professionals, this simulation promotes safe practice, reinforces infection control principles, and enhances procedural accuracy in a risk-free virtual environment. Perfect for building confidence and competency before applying skills in real-world clinical scenarios.", "short_description": "Learn the correct procedure for urine midstream collection through an interactive VR simulation. Practice each step in a realistic clinical environment, understand best practices for sample handling, and build confidence in performing the procedure safely and accurately."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25117933904466855"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
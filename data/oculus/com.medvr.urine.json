e": "com.medvr.urine-20251014-164050-1.00_00_25_23.Still007.png", "id": "777351328802760", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618102_777351332136093_865671952753012563_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sn045Pm8vMMQ7kNvwFQp0k1&_nc_oc=AdltLEpfh8xRM0iPQnaeq9WW8ey84SwfEsxjVmPXKSY7F2IrsLTjVxRON5fjcM7Ipzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvZS79uY0GbvzZorS36yPWsThVNERxoG2QKGQazgApJsg&oe=699D7F50"}, {"file_name": "com.medvr.urine-20251014-164050-1.00_00_05_16.Still002.png", "id": "1339142241074878", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819417_1339142244408211_3880815082763147902_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8Q_iExcP2QQ7kNvwGGR3fx&_nc_oc=Adnr1TxJkmv1hlqfrGPpoMOJN7k5b7Vo000r3pDv0azxioTEAUn_DcWuTndT1Yw5bqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv7iSCIXm8wJtdQLX4AMXqW0s3ve7y9N7YrhbVgICaJoA&oe=699D97DB"}, {"file_name": "com.medvr.urine-20251014-164050-1.00_00_23_00.Still006.png", "id": "1798700101012923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824534_1798700104346256_5824087066573565822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfeiQAC1FLgQ7kNvwFDk6zC&_nc_oc=Adnjwef_zNfESdc-cKwh7C1LcKHA3t80ev2LbdHYcr2xa_5ueU10RDT0l55Xzx2nBOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftZZ37wxQJtOYqYbc7XUW3RCO2piALT3l17aKFT5xRL7Q&oe=699D8890"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Urine Midstream Collection", "keywords": ["Medvr", "NBME", "VR", "Urine", "Midstream"], "long_description": "Urine Midstream Collection is an immersive VR training simulation designed to teach and assess the correct technique for collecting a midstream urine sample. This interactive experience guides learners through each step of the procedure\u2014from preparation and patient guidance to sample handling and labeling\u2014within a realistic clinical setting.\n\nDeveloped for healthcare students and professionals, this si
e": "com.medvr.urine-20251014-164050-1.00_00_25_23.Still007.png", "id": "777351328802760", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618102_777351332136093_865671952753012563_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spIK8569zHMQ7kNvwHH3Ova&_nc_oc=AdlyD2_BC5EB1rTor3T8WtyoeEG2OdNuA0eWC5Qy7aXtozO90TRAnwndaBaeFebqCVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvIBuFvfTY88iIAPezw8YCUXmnffVwjvVwDAJBmU1ba5w&oe=69987190"}, {"file_name": "com.medvr.urine-20251014-164050-1.00_00_05_16.Still002.png", "id": "1339142241074878", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819417_1339142244408211_3880815082763147902_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdzAm1vRSvYQ7kNvwFABuSG&_nc_oc=AdmgKFE-HGflrlMwvKmArZq8ipvBSvXMfrHmpI8E0YT-6MJifh3eINC8fFwqBOwo__E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvKmFIN_ZHKnqQoLY4CDx97go38z3iE8lJLxlLQ-4pBjQ&oe=699851DB"}, {"file_name": "com.medvr.urine-20251014-164050-1.00_00_23_00.Still006.png", "id": "1798700101012923", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824534_1798700104346256_5824087066573565822_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEenijdWD9wQ7kNvwF98ePg&_nc_oc=AdnGhIlsZsCBeRCREy98d4QIopwL77OMJySCaovgcIps5CGBubOtTErgU4eJlLN-4xE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft0NVWnTjMnyOsYqf1LYbolUCpR-7xFzjCTl5bczZ9fUQ&oe=69984290"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Urine Midstream Collection", "keywords": ["Medvr", "NBME", "VR", "Urine", "Midstream"], "long_description": "Urine Midstream Collection is an immersive VR training simulation designed to teach and assess the correct technique for collecting a midstream urine sample. This interactive experience guides learners through each step of the procedure\u2014from preparation and patient guidance to sample handling and labeling\u2014within a realistic clinical setting.\n\nDeveloped for healthcare students and professionals, this si
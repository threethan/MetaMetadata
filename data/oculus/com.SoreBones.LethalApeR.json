{"data": {"node": {"__typename": "Application", "id": "28891150583866181", "organization": {"id": "1284821286099049", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "10064554593554573"}]}, "id": "691701246714196"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "28891150583866181"}]}, "id": "1021084119887935"}]}}, "firstRevision": {"nodes": [{"application": {"id": "28891150583866181", "release_date": 1743102060, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38417209697926841"}, "id": "9364058540341661"}]}}, "binary": null, "live_binary": null, "created_date": 1782044089, "id": "36514487351532428", "is_initial_release": false, "name_with_fallback": "v18", "pdp_metadata_with_fallback": {"version": 17, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "36514510041530159"}, "release_status": "RELEASED", "id": "28891150583866181"}, "id": "36514510041530159", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28891150583866181", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3519907784812467"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Untitled design(5).png", "id": "2773196523035915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_2773196526369248_3007333435344347398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_Dh5kn9e-UQ7kNvwGOtK59&_nc_oc=AdqsRrn_9rvMY0YJ5-owtDVYI1l4mO2c50U_k2NS2uT0tVzOYYsyUFs8zv6toeH8XAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx2jAGLdxkFkB6zDX_A5I-L-vUJVe9-QGQXrEotTknFQ&oe=6AAFF2CD"}, {"file_name": "Untitled design(4).png", "id": "2633376140371284", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_2633376147037950_9021083931787965241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MVdMmacgJMQ7kNvwHKOxT1&_nc_oc=AdoengBlLvyi3oj3bXCN13WS3-NwFwExoLPfmcgizqU-IKcy6ECi7F7nhLpi3Mu3lsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQCTkXSD3n8sETv_XlXlnsKY_ainxueYQzvVKcZ-wuHQ&oe=6AAFD2EA"}, {"file_name": "layered_icon_composited.png", "id": "2057758335093097", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507819001_2057758338426430_3778400163347139226_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7D1A8VELzAQ7kNvwEtbFez&_nc_oc=AdoSLTsIGSUFvgUnTrYMN69OAfN7fT0enP24Z1kOUM12ErrdH7p1FF5OuLMkK8Sq3J0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxhCvpVWHotSp2zNpxfk5iCYrOcM1q2jx_VLByu9YaRw&oe=6AAFE23B"}, {"file_name": "summr (2).png", "id": "1953015152012350", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1953015155345683_6903890362262099924_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQgICfOdWXAQ7kNvwGvC1Bw&_nc_oc=AdqepzMHZC7KDprZ8Zzy4PPzuCGt3YeCtH11af8OhBCf7XSgJTXfI0ze8rTtCqbTDEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiGR0YJ4x_N8SWBP8A03W2VgiXvMaqHA2ccFsWWuu1rg&oe=6AAFE7A7"}, {"file_name": "summr.png", "id": "1706746327123349", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1706746333790015_9056481674514701871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL-swvFHPN8Q7kNvwExQB9D&_nc_oc=AdrIz4YSiDU1vRxUjinwZlpSV2YbZLguaJ5hhh-Z5LWl36RMxSIgfGIeYcxL3KcUKYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGilhk3iRFCiWgE5AMOJx83myN7NUIfcMgzB6SnPXwWA&oe=6AAFF6DC"}, {"file_name": "New Project (12).png", "id": "1694004941538468", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312422_1694004944871801_6708589132577568464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uihdSTxkfXcQ7kNvwFAFnrB&_nc_oc=Adq8xtlXf8XVMesh65wP68URgeVz1_CXdVym09DXoAneTLLwU9RwUnDVW5fJ3foxoUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-t8BrVZGv5g1lrPB7-hdMPMIMvsjn0ZZHWFNlgeg9Gw&oe=6AAFD558"}, {"file_name": "Untitled design(7).png", "id": "1592243822124719", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618440_1592243825458052_551067810807615550_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFxfl1VXVi0Q7kNvwFlpnPp&_nc_oc=AdqFu3F4XaV3zXWZWwzpraz4WC8a8wDXjfZ6JHi8bmJB9nN5128MFYiVuA4ybWwCMnw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpE5BjMeCb_W9aeaXqqw5-7yasf_ZZJRHg4v13hfYz-g&oe=6AAFD8CE"}, {"file_name": "summr (6).png", "id": "1563248332176669", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310667_1563248335510002_6117416389071644956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1Vo3mtEMn0Q7kNvwFh5mEr&_nc_oc=AdraXKIZLdAXFIV3_BPJbsTvwDwExCfmvT6qR2_BJxqL24pE9mPzbKNZHVyf7H2TUFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX7H3W2T5Sxg-Z9klcbAhbkFp9Aam__7dlrJYdAh11Bg&oe=6AAFFEBC"}, {"file_name": "Untitled design(1).png", "id": "1425042699070570", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_1425042705737236_852641228456797692_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Yd5QLPIym4Q7kNvwEKW8dI&_nc_oc=AdohhTz-eSbCh6qkE3zyEZ81IPxi-cWqhJQ5XPnOjTM20wvVMUorN_PZMVX7WexdmLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL77Xuul0Niln3
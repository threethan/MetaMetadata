": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619805_896325256101462_1099249827692192135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUj6bIDhpzkQ7kNvwFCKwyR&_nc_oc=AdnBFksFMh_6EBpJIZW0mGNipjJ7-Tfh_jA2mvju-SthXHFw1Pj6FitswngGvS3TSfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfteQbS_GrQcetirfVqAX__qKI_dezm_reU7qys2Ua2Rrg&oe=6999A2A5"}]}, "id": "1370689425072892", "locale": "en_US", "screenshots": [{"file_name": "Untitled design(9).png", "id": "1400212991749289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308349_1400212995082622_8750121675667735763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3xpHUxwW70Q7kNvwEZiy_r&_nc_oc=AdkFmKKUHzenFIF4QcFC8Hd-xNQ-755motyvmylVxAWRAXixiEfcHAcBZ19tUGziEX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftis9ij_zyVGt_wdkH-fbUTehhvogla94ykW4Kx1GlAlQ&oe=6999A28B"}, {"file_name": "Untitled design(11).png", "id": "1306480454837876", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822968_1306480458171209_1791064979817361839_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZltlj-qOeUQ7kNvwFxPbPM&_nc_oc=AdkTJw6dHmlUL6XocdxkhJ2PVsd3535MD3jD7OSB9Qu0tnyRh7pXsimJpGzfmvp3Ogw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvHEsvVlusmcPndR__Nlp8fNC5m0CYbSY-oLXLSf8srQA&oe=69999372"}, {"file_name": "Untitled design(10).png", "id": "1294977795796346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831276_1294977799129679_5253007277876583788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPqvArXcCsYQ7kNvwGF9tur&_nc_oc=AdkzSoxRr4cksSmYeocE9YcjUHmKrmXYG_lmWmBjbRgkYmgXThRU-pARRMK-2Nf1h04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlfGU-7W74lk0lohE9wG95WfRG060ZwOY-FYT7oQ5__g&oe=6999B102"}, {"file_name": "Untitled design(8).png", "id": "1225011279055510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303679_1225011282388843_8153276572414552677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6dB4znASAwQ7kNvwGo5gp6&_nc_oc=Admy9GhjIOgEHfLEvViPE_Xo99Fn_Oa43MYtN0KhpcbWy5yVtn34TYXg6ftpXYP-zdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGIIYlvVg3ScENt_dtiOa9Nm1FQG096dqKodgk5-XOtw&oe=69998E55"}, {"file_name": "Screenshot_2026-01-28_235851.png", "id": "879193338224444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830599_879193341557777_1107610908296453374_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF_HJrC3nRMQ7kNvwF26Z4b&_nc_oc=AdkP1NdwOYxAlIGMe7d3XPb9x7Vyo5IGzoEYu6y_xE5TbsrBJP56Pi_7RIgixWYYJtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_g1JxvNzATqo2Zk187dMhTFpzttAxRfv9EhU0MewGPQ&oe=6999B72A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Redux", "keywords": ["LethalApe", "LethalApeR", "LethalApeRedux", "lethalape", "LAR"], "long_description": "# Lethal Ape Redux\n\n*A fast-paced, actively developed physics-based horror experience.*\n\n## Overview\nLethal Ape Redux is a **rebuilt, modern take** on movement-driven survival horror. Explore abandoned, atmospheric environments while being hunted by relentless Apes that react instantly, adapt to your behavior, and never stop once they\u2019ve found you.\n\nYou run.  \nYou climb.  \nYou hide.\n\nBut once an Ape locks onto you, escape turns into a **full-speed panic run** where every movement decision matters.\n{1592243822124719}\n\nRedux is built around tighter mechanics, smarter enemies, and frequent improvements driven by an active player community.\n\n## Core Gameplay\n\n### Physics-Based Movement\nInspired by Gorilla Tag.  \nClimb walls, vault obstacles, and swing through each environment using momentum, timing, and pure movement skill. Mastery means survival.\n{1425042699070570}\n\n### Stealth and Survival\nStay quiet. Stay alert.  \nThe Apes track sound, motion, and line of sight. One mistake is all it takes to start a chase.\n\n### Unpredictable Enemies\nApes don\u2019t follow scripted patterns.  \nThey search, flank, investigate noise, and adapt to how you play, keeping every encounter tense and unpredictable.\n\n## Why Play\n- Fast, expressive movement  \n- Intense, high-speed chase sequences  \n- Dark, unsettling environments  \n- Smart, aggressive enemies that keep pressure on you  \n\n*Run. Climb. Survive. And whatever you do \u2014 don\u2019t get spotted.*\n\n{2633376140371284}", "short_description": "Lethal Ape Redux combines the intense, physics-based movement of Gorilla Tag with horror survival gameplay. Players must navigate eerie, abandoned environments while evading one thing: scary baboons. They\u2019re fast, relentless, and smarter than you'd like. Run, climb, and scream, because once a scary baboon locks eyes on you, it\u2019s already too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalape?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Sore Bones", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33850845207896669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1429548018752663_6264328523011264294_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcl2_VcLd_0Q7kNvwFw2poD&_nc_oc=AdlxDEKcalnqUp
AlJaFzmNmMI9WD3jKx847o_gYJGQf3N51triulh7fcctP2ZSUrG7qMJVkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuS025gMGAhfujuCJYXUq-TiaUlibbFkLaV06wSaAQ30Q&oe=699C3155"}, {"file_name": "Screenshot_2026-01-28_235851.png", "id": "879193338224444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_879193341557777_1107610908296453374_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8qElGMTJ2YQ7kNvwEs7-Zw&_nc_oc=AdlmKWHyHRX9Wdj14qIcEYKwzq66OqXu4zdwa6NxUnk6u__Bx27cMbAdBQcJOD7CUKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvqT0tCAmpYjrTXo2vK9nvrloUzVEvVREh4E3qQobD0TQ&oe=699C5A2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Redux", "keywords": ["LethalApe", "LethalApeR", "LethalApeRedux", "lethalape", "LAR"], "long_description": "# Lethal Ape Redux\n\n*A fast-paced, actively developed physics-based horror experience.*\n\n## Overview\nLethal Ape Redux is a **rebuilt, modern take** on movement-driven survival horror. Explore abandoned, atmospheric environments while being hunted by relentless Apes that react instantly, adapt to your behavior, and never stop once they\u2019ve found you.\n\nYou run.  \nYou climb.  \nYou hide.\n\nBut once an Ape locks onto you, escape turns into a **full-speed panic run** where every movement decision matters.\n{1592243822124719}\n\nRedux is built around tighter mechanics, smarter enemies, and frequent improvements driven by an active player community.\n\n## Core Gameplay\n\n### Physics-Based Movement\nInspired by Gorilla Tag.  \nClimb walls, vault obstacles, and swing through each environment using momentum, timing, and pure movement skill. Mastery means survival.\n{1425042699070570}\n\n### Stealth and Survival\nStay quiet. Stay alert.  \nThe Apes track sound, motion, and line of sight. One mistake is all it takes to start a chase.\n\n### Unpredictable Enemies\nApes don\u2019t follow scripted patterns.  \nThey search, flank, investigate noise, and adapt to how you play, keeping every encounter tense and unpredictable.\n\n## Why Play\n- Fast, expressive movement  \n- Intense, high-speed chase sequences  \n- Dark, unsettling environments  \n- Smart, aggressive enemies that keep pressure on you  \n\n*Run. Climb. Survive. And whatever you do \u2014 don\u2019t get spotted.*\n\n{2633376140371284}", "short_description": "Lethal Ape Redux combines the intense, physics-based movement of Gorilla Tag with horror survival gameplay. Players must navigate eerie, abandoned environments while evading one thing: scary baboons. They\u2019re fast, relentless, and smarter than you'd like. Run, climb, and scream, because once a scary baboon locks eyes on you, it\u2019s already too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalape?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Sore Bones", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33850845207896669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823790_1429548018752663_6264328523011264294_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYrTeGYHp9wQ7kNvwEjqmUW&_nc_oc=AdnrLRAf
hots": [{"file_name": "Untitled design(9).png", "id": "1400212991749289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308349_1400212995082622_8750121675667735763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsxw8NVJ2lwQ7kNvwFSGMRS&_nc_oc=Adp-E0QZZYLtpa1zyhzDkTGsGvUaFD3nvUFfe8mS_M0gZOfmLwRdu2D43xvi5uz7J-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUS-HVN-w0GLEt3l5fNSocB_bPWGsM1lz_ymnUUJZ16Q&oe=6AAFCF0B"}, {"file_name": "Untitled design(11).png", "id": "1306480454837876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_1306480458171209_1791064979817361839_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qrGl-h4VGMQ7kNvwFYTZQ4&_nc_oc=AdraQuQzCvSdgmH2YQBZymLtX6wBwLpMb8ZaF2LK-zYaP57J8La3hTvrvANuR3xyfQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHyFRhOId78MeYrYA_EMEMFos-e_HmxwgeAuQqlt1eMw&oe=6AAFF832"}, {"file_name": "Untitled design(10).png", "id": "1294977795796346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831276_1294977799129679_5253007277876583788_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5mNU7W82bcQ7kNvwExQoTc&_nc_oc=AdorgV1k8DM-6yAc4UTke_nF-oFXVrJEz_iA-BFcNqEjJ1SZxd_XIab3mk2B9aoly00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUYbvOY_2xlWRlnBbGq8TEHb4IgyH4DGCrDmYPODhw_w&oe=6AAFDD82"}, {"file_name": "Untitled design(8).png", "id": "1225011279055510", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303679_1225011282388843_8153276572414552677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzB3dxoJPwIQ7kNvwGwF9Sp&_nc_oc=AdoHmQ2UTNaMlgd4O3OZefrCwkwvDU72R9W9nBo8aLKYFbe4a5HMZdYgXzSqI3YDLk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc6BqIFe9wM8u483AjvmzGe0Jmfqa4z8zXyu6GSrxIbw&oe=6AAFF315"}, {"file_name": "Screenshot_2026-01-28_235851.png", "id": "879193338224444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_879193341557777_1107610908296453374_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f1_kG0GkWMQ7kNvwEckJBj&_nc_oc=AdpQHQjq1ADS8WUmK-RsWbr5hmwMGSzwQW6y3al4NeOOsklRFCcLTie7RaPI6k0xaog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb2ZG2vX__8tKoOILlnGNxHwUr-CeuPlciRTNVBs6jlQ&oe=6AAFE3AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Redux", "keywords": ["LethalApe", "LethalApeR", "LethalApeRedux", "lethalape", "lethalaperedux"], "long_description": "# Lethal Ape Redux\n\n*A fast-paced, actively developed physics-based horror experience.*\n\n## Overview\nLethal Ape Redux is a **rebuilt, modern take** on movement-driven survival horror. Explore abandoned, atmospheric environments while being hunted by relentless Apes that react instantly, adapt to your behavior, and never stop once they\u2019ve found you.\n\nYou run.  \nYou climb.  \nYou hide.\n\nBut once an Ape locks onto you, escape turns into a **full-speed panic run** where every movement decision matters.\n{1592243822124719}\n\nRedux is built around tighter mechanics, smarter enemies, and frequent improvements driven by an active player community.\n\n## Core Gameplay\n\n### Physics-Based Movement\nInspired by Gorilla Tag.  \nClimb walls, vault obstacles, and swing through each environment using momentum, timing, and pure movement skill. Mastery means survival.\n{1425042699070570}\n\n### Stealth and Survival\nStay quiet. Stay alert.  \nThe Apes track sound, motion, and line of sight. One mistake is all it takes to start a chase.\n\n### Unpredictable Enemies\nApes don\u2019t follow scripted patterns.  \nThey search, flank, investigate noise, and adapt to how you play, keeping every encounter tense and unpredictable.\n\n## Why Play\n- Fast, expressive movement  \n- Intense, high-speed chase sequences  \n- Dark, unsettling environments  \n- Smart, aggressive enemies that keep pressure on you  \n\n*Run. Climb. Survive. And whatever you do \u2014 don\u2019t get spotted.*\n\n{2633376140371284}", "short_description": "Lethal Ape Redux combines the intense, physics-based movement of Gorilla Tag with horror survival gameplay. Players must navigate eerie, abandoned environments while evading one thing: scary baboons. They\u2019re fast, relentless, and smarter than you'd like. Run, climb, and scream, because once a scary baboon locks eyes on you, it\u2019s already too late."}, {"images": {"nodes": [{"file_name": "499618274_2633376147037950_9021083931787965241_n.png", "id": "2733309653716900", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_2733309657050233_8320751033712796996_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2zk8Kcu8cAQ7kNvwFbTOAL&_nc_oc=Adpl0rI4GTQ_hw7TsPm_pPdr6B4BirXJSBpwLEJQxHhgec6PQs1iPpoIxBiuVWtbkeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDdVJpB9n4AfCzF_WgbsRNgFO08M6IXmpMQFcnMDlWAw&oe=6AAFFD57"}, {"file_name": "499618515_1425042705737236_852641228456797692_n.png", "id": "2307245763105441", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_2307245773105440_415482862352154286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emiHuhvUIxoQ7kNvwEFPbaO&_nc_oc=AdoEuZuKuaQXDixwuv4v5ZGSqaLVCaJBwJsKmL8yb0ZMFnr5LJbYYNZveHshyxp8ahM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9jcfEqGh9ZEsXjUeXNyyB8XVDZNRexPnSb7boZhOFSw&oe=6AAFFCBD"}, {"file_name": "499618440_1592243825458052_551067810807615550_n.png", "id": "930611426333199", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_930611429666532_7354393545753760641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNfauKsUnRYQ7kNvwHa2QEw&_nc_oc=AdprFZRpvXxLNcB_1zxWk9GMSH-8OUrg8-8taxIIMUruNKKkzNW03c-YC9QuBD-ycRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiRBePxSnjyP_IQENcNi9Fd2z716FAY7F7lJuKxF0oYQ&oe=6AAFE6B7"}]}, "id": "1683320149569872", "locale": "nb_NO", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Redux", "keywords": ["LethalApe", "LethalApeR", "LethalApeRedux", "lethalaperedux", "lethalape"], "long_description": "# Lethal Ape Redux\n\n*En intens, fysikkbasert skrekkopplevelse i stadig utvikling.*\n\n## Overview\nLethal Ape Redux er **en moderne og gjenoppbygd versjon** av et bevegelsesbasert survival horror-spill. Utforsk forlatte og stemningsfulle omgivelser mens du blir jaktet p\u00e5 av n\u00e5del\u00f8se aper som reagerer umiddelbart, tilpasser seg hvordan du spiller og aldri gir seg n\u00e5r de f\u00f8rst har funnet deg.\n{930611426333199}\n\n- Du l\u00f8per.\n- Du klatrer.\n- Du gjemmer deg.\n\nMen i det en ape f\u00e5r \u00f8ye p\u00e5 deg, blir flukten til en desperat spurt i full fart der hver eneste bevegelse kan avgj\u00f8re om du overlever.\n\n\nRedux er bygget rundt strammere gameplay, smartere fiender og jevnlige oppdateringer drevet av et aktivt spillerfellesskap.\n\n\n## Kjernegameplay\n\n### Fysikkbasert bevegelse\nInspirert av Gorilla Tag.\nKlatre opp vegger, hopp over hindringer og sving deg gjennom hvert omr\u00e5de ved hjelp av fart, timing og ren bevegelseskontroll. Jo bedre du mestrer bevegelsen, desto st\u00f8rre er sjansen for \u00e5 overleve.\n{2307245763105441}\n\n### Sniking og overlevelse\nV\u00e6r stille. V\u00e6r p\u00e5 vakt.\nApene f\u00f8lger med p\u00e5 lyd, bevegelser og synslinje. Ett feiltrinn er alt som skal til f\u00f8r jakten starter.\n\n\n### Uforutsigbare fiender\nApene f\u00f8lger ikke faste m\u00f8nstre.\nDe leter, omringer, unders\u00f8ker lyder og tilpasser seg m\u00e5ten du spiller p\u00e5, noe som gj\u00f8r hvert m\u00f8te intenst og uforutsigbart.\n{2733309653716900}\n\n## Hvorfor spille\n- Rask og responsiv bevegelse\n- Intense jaktscener i h\u00f8y fart\n- M\u00f8rke og urovekkende omgivelser\n- Smarte og aggressive fiender som hele tiden holder presset oppe\n\n*L\u00f8p. Klatre. Overlev. Og uansett hva du gj\u00f8r \u2013 ikke bli oppdaget.*\n\n\n\n\n", "short_description": "Lethal Ape Redux kombinerer den intense, fysikkbaserte bevegelsen fra Gorilla Tag med skrekkfylt overlevelsesspill. Spillerne m\u00e5 ta seg gjennom m\u00f8rke og forlatte omr\u00e5der mens de pr\u00f8ver \u00e5 unng\u00e5 \u00e9n ting: skremmende bavianer. De er raske, n\u00e5del\u00f8se og smartere enn du skulle tro. L\u00f8p, klatre og skrik \u2013 for med en gang en skummel bavian f\u00e5r \u00f8ye p\u00e5 deg, er det allerede for sent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalape?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Sore Bones", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "36514510041530159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1953015155345683_6903890362262099924_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQgICfOdWXAQ7kNvwGvC1Bw&_nc_oc=AdqepzMHZC7KDprZ8Zzy4PPzuCGt3YeCtH11af8OhBCf7XSgJTXfI0ze8rTtCqbTDEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk9zaZKdvXHJxnfbbPx1NzOgt9v_F7-Zc1nD35pg0dnw&oe=6AAFE7A7"}, "is_concept": false
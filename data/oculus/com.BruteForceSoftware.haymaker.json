ad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd27PpYZhplnI4LW9Dsw8qCOECHIQNPTmnJ3E1hnrJoQ&oe=6A984F0E"}, {"file_name": "shoulderlockstutorialscaled.png", "id": "832494085998762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295566_832494089332095_8381227911400867887_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lLLKx09EhkQ7kNvwHXq2Xf&_nc_oc=AdprEu6WfDZkB0howWGoIa9Scd0E66XESQezMAzrPoGBK7zomFqk9TpCsNbuiY8d5Sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL16LIu-J1KF5Qh9-oB0GUsFFoVhv8E5YDWZpITxln6xg&oe=6A986175"}, {"file_name": "kickingGuyOutWindowScaled.png", "id": "1382969260115406", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303746_1382969263448739_4122414148289199652_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFJDkbpSQGcQ7kNvwGSE2Rd&_nc_oc=Adop36r7kPgWZyXqM8jfWknPrkQ2917H_u9tRQEQVMDclhu-Cp6WNCA54MaRLXEcp2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnKNIM3-MIMydgwkCsnQBs086LabQjvtRO2a1MEIb5Aw&oe=6A98663C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtMETAScaled.png", "id": "1691323965158139", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305071_1691323968491472_2104537873987917501_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47c4OJLPNwAQ7kNvwEn6rEH&_nc_oc=Adp0fq0EpTgn5FqqwhStQngkzMOADuD3EKfZOusKgpdutb3RWOTNRkQysCDUkxoXsqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-HNc6xKFIEfm33WIef-c3SsWXy-7LbbcostRJn5VJcA&oe=6A986A1B"}, "display_name": "Haymaker", "keywords": ["ragdoll", "brawler", "brutal", "fighting", "boxing"], "long_description": "**Early Access Notice**\n\nHaymaker is in active development and launching in Early Access (EA) to refine its combat systems, expand its content, and experiment with a variety of gameplay modes. The core melee foundation is solid and fully playable \u2013 with physics-driven hand-to-hand combat, dynamic AI, and sandbox-style encounters \u2013 but some environments and progression systems are still in early prototype form. These will continue to evolve throughout EA as player feedback shapes the game\u2019s development.\n\n**Pricing**\n\nThe current EA price reflects the game\u2019s in-progress state and will likely increase as more content and polish are added. \n\n{716437574196414}\n\n**The Game**\n\nHaymaker is a physics-first VR combat brawler focused on authentic body mechanics and replayability.\n\n\u2022 Physics-driven hand system \u2013 grab, grapple, block, and strike through physics-based interactions.\n\n\u2022 Gesture-based kicks \u2013 engage shoulders and back muscles to kick and knee opponents for damage and crowd control.\n\n\u2022 Incoming-attack indicators \u2013 read opponent strike intent in real time to counter, block, or intercept, creating fast, cinematic fight flow.\n\n\u2022 Active ragdoll characters \u2013 every fighter reacts dynamically to impact, gravity, and environment props.\n\n\u2022 Adaptive AI \u2013 teammates and enemies predict target positions, choose optimal attacks, and improvise with nearby objects.\n\nBuilt on a 120 Hz simulation for high-fidelity collisions and smooth gameplay, Haymaker delivers fluid, reactive combat that feels hand-crafted yet unscripted. \n\n", "short_description": "Haymaker is a fast, physics-driven brawler built around brutal hand-to-hand combat. Block, grab, and counter with natural motion\u2014then throw real punches and gesture-triggered kicks that land with weight. Enemy attacks are indicated before they throw their combos, leading to fast-paced action. Every fight plays out differently thanks to an advanced active ragdoll system and smart AI that attacks, blocks, and reacts dynamically in fully physical environments."}]}, "developer_name": "Console Studios", "developer_privacy_policy_url": "https://www.haymakervr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "GTDevice LLC", "support_website_url": null, "website_url": "https://www.haymakervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32329401560040046"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1169712739568480"}, {"status": "PUBLISHED", "id": "890591304101302"}, {"status": "PUBLISHED", "id": "1617872232611703"}, {"status": "PUBLISHED", "id": "803612069067400"}]}, "baseline_offer": {"id": "803612069067400"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1169712739568480"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "37595362633443886", "version": ".300"}, "id": "485712130569152", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27755215420792039", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "37595362633443886"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787956983, "id": "38091784857134992", "version": ".300", "version_code": 472, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": 
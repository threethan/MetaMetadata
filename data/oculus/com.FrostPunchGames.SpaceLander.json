8hZAr0Q7kNvwE-8WlG&_nc_oc=AdnA7QYCBYOrjRr2WAKQo2s6ZGhZfyfW2Y4Yt_iHCbF6Nv67LlWxKw_aQoMRhNqB8w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afydpz0QMY87REjXpCVnvXoZli7-e6SrLGXfLAhYjcLIzw&oe=69AC32F3"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZyrv_XW48AQ7kNvwHuu9nt&_nc_oc=Adn680iYOIHyg1Y2jhbu4JsnfSJIBGE3Ve-yBvs64_GPNeYGNwBCr3UnuAm-zXMjQ4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyCRzg6RUK3AW9vepPpWm9pFPZw81nJYf9BK9OdelTQg&oe=69AC3480"}, {"file_name": "7.png", "id": "682203651434927", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827720_682203654768260_1451577516060763779_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpLaZXMBpB0Q7kNvwFrVJlq&_nc_oc=Adlg4f61aTfZ9Lh3XlnAWa0ksnnbq5SQMWwA3qbSYsTHtYYtgQK2lutLpPQtLmF5rbU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxc55jTvPSZC2p0z8wquKmzWyknhOwKukzYh296TgT4Ig&oe=69AC3199"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Lander", "keywords": ["Space", "Lunar", "Rocket", "scifi", "Landing"], "long_description": "Space Lander is a mixed reality landing game built where your real-world space becomes a landing site.\n\nYou\u2019ll start with a rocket booster that needs to land upright on a tower\u2014classic, clean, and surprisingly tough. Then there\u2019s the smaller spacecraft: quick, nimble, and built for weaving through tight spots and dodging floating debris before touching down.\n\nEach mission has a higher difficulty; every surface becomes part of the challenge. And with limited fuel, every second counts.\n\nIt\u2019s not about flashy explosions or over-the-top graphics. It\u2019s about control. Precision. The quiet tension of sticking the landing when it really counts.", "short_description": "Space Lander drops you into the pilot seat of rockets and ships, each with their own physics and challenges. It\u2019s you, gravity, and just enough fuel to make a safe landing."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24068999869363936"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1400703608207470"}, {"status": "PUBLISHED", "id": "776033705459514"}, {"status": "PUBLISHED", "id": "1073805824822004"}, {"status": "PUBLISHED", "id": "768403322278025"}, {"status": "PUBLISHED", "id": "718593067196819"}, {"status": "CANCELLED", "id": "2380665652333838"}, {"status": "PUBLISHED", "id": "1592771835014605"}]}, "baseline_offer": {"id": "718593067196819"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772827200, "status": "PUBLISHED", "id": "1400703608207470"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24180824978181424", "version": "0.2.1"}, "id": "979577377240833", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename"
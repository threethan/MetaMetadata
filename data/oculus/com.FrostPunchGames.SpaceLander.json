3-1.oculuscdn.com/v/t64.5771-25/491820219_681242074647213_7553219210034023362_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK0-HPR1lJMQ7kNvwH0GZ4v&_nc_oc=AdoEK3lL4K9Txlwjf-VA1KDdGtq-o6toH0ul3jMvMTLdh2EIID32KPU8FuNDC0BPwJQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSSWJmmMiWNcaPuGntDF2WonRCJ0fBnLHTqUcbd7zVqQ&oe=69CFCB73"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CN6u6ka6mskQ7kNvwEvFwbo&_nc_oc=AdpDqHj2IJ0MiJ2DVok2KC1PsHPLnwvg549HLlvt_-pXqL04BEYi3LPe0ML6Gm4sx9o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqbUYShf4YaIG-jx1PA8Fm_ZEY7Je9e0QgXGw4WCqyow&oe=69CFCBC2"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8VYPGP53_wQ7kNvwGzeDCG&_nc_oc=Adp2mzh2o6Ma33CnUm55PrKprGe_RUHw72VPlPOznYpxzdEt5FS4Xhv71TYoTwgbn6M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpS20KXTX76ukM_SJ7KF-K8jKrvZQl0Oy0Aqtwe_rXpA&oe=69CFCD00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473391883_696428426308414_445808803660987887_n (1).png", "id": "4422092391453939", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822581_4422092394787272_6986771118671084080_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-l1gSy7HSEQ7kNvwH9FZhN&_nc_oc=Adqn7fj112j0U-hBNRYM76cbspSwDtc4lCXFxMfglynRrm0-B-tqh78YmtSK71MjEJA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM0WfNGnyEN2FcoFMRvC0bc4Sc0Y4m9GFhFUqPBPAVDg&oe=69CFBC04"}, "display_name": "Space Lander", "keywords": ["Space", "Astronaut", "gravity", "rocket", "Asteroid"], "long_description": "# \ud83d\ude80Welcome to Space Lander!\n\nA spaceflight challenge grounded in your real-world environment.\n\nTake control of rockets, lunar landers, and a zero-gravity astronaut in this precision-based space game for the Meta Quest 3 and 3s. Using mixed reality, your actual room becomes the terrain \u2014 with real furniture and walls acting as collision obstacles that shape every mission.\n\n{2658572141012784}\n\n\ud83c\udf11 **What to Expect**\n\n- Land towering rocket boosters upright with limited fuel and fine-tuned thrusters.\n\n- Navigate agile spacecraft through tight spaces and drifting hazards.\n\n- Float as an astronaut in zero gravity, steering with hand thrusters around your real environment.\n- A level editor with a web browser for you to stream you own music or shows while you create your own level\n- Each surface \u2014 real or virtual \u2014 becomes part of the challenge.\n\n\ud83c\udfaf **Precision Over Flash**\n\nThis isn\u2019t about flashy explosions or cinematic flair \u2014 it\u2019s about:\n\n- Realistic space physics\n\n- Tense, calculated maneuvers\n\n- The thrill of sticking a perfect landing when every second and drop of fuel counts\n\n**Are you ready to master spaceflight, one landing at a time?**\n", "short_description": "In Space Lander, you\u2019ll pilot rockets and lunar ships across zero-gravity environments with limited fuel, real space physics, and high-stakes landings while dodging asteroids, black holes, and beyond. or step out as a free-floating astronaut!"}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
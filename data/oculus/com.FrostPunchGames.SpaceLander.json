 "en_US", "screenshots": [{"file_name": "1b.png", "id": "2514341978919700", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491830394_2514341982253033_3494318717667654985_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6igTre5lxAQQ7kNvwGqLgnz&_nc_oc=AdoznBvv92OSgNr3_l5owTx9uJe5oNgGdl0RljQCdYhAaxtUVxBlA7kPoPZsj4coof4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y9CHafJ8c0IhR70HHe2z3oNr9XzQV4D21dPkonSpmmQ&oe=6A22CBB5"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAStmYMMXIsQ7kNvwEP4nSV&_nc_oc=AdqkeTPwfrcC-bSgE4hDJYkdY-E8ln4MsrHbW98MeSE8R6rX-0TdBl9cfQ19fb9ZUkc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kKra8C_lmi5VPQDJAmwyrnhPdKVHnoqZ3RKyXOTUS8A&oe=6A22DA42"}, {"file_name": "3.png", "id": "681242071313880", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820219_681242074647213_7553219210034023362_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bM2aZfX9-pUQ7kNvwHWc1R5&_nc_oc=Adr7kgs1VsdE7Fm2JVWOJ_VHW6OiOhecetkqQdAbKFxtwIJrXJi9BmKBEUu0kc1ahGE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EwfXFrGunUjMW11US4b7S5wJQY4qbycNvm2h969UYRQ&oe=6A22D9F3"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYgB3BQ2bAQQ7kNvwHsbAlk&_nc_oc=AdqheQoAl7iclEmLzcTwqCl2TC-K1QjqiUrWELFDP3gmvB-_jbyLM_F-9dLKjcnKvpU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lv1fmggT5PF0JRY08MjhZwwBIzCtRwcKze26NZB90Cw&oe=6A22DB80"}, {"file_name": "7.png", "id": "682203651434927", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491827720_682203654768260_1451577516060763779_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKoLf5cF-FkQ7kNvwFvz56O&_nc_oc=AdqFb5fmN0zEFI8GdKnOvWuUh_fKWjuhLQ-3L4fxfa0ODa8iCRGqj-eU9IVID2NBREk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-E9S4mTAVyDN860uPhs0f63EsJiJU0_Rv0hEKI-adMg&oe=6A22D899"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Lander", "keywords": ["Space", "Lunar", "Rocket", "scifi", "Landing"], "long_description": "Space Lander is a mixed reality landing game built where your real-world space becomes a landing site.\n\nYou\u2019ll start with a rocket booster that needs to land upright on a tower\u2014classic, clean, and surprisingly tough. Then there\u2019s the smaller spacecraft: quick, nimble, and built for weaving through tight spots and dodging floating debris before touching down.\n\nEach mission has a higher difficulty; every surface becomes part of the challenge. And with limited fuel, every second counts.\n\nIt\u2019s not about flashy explosions or over-the-top graphics. It\u2019s about control. Precision. The quiet tension of sticking the landing when it really counts.", "short_description": "Space Lander drops you into the pilot seat of rockets and ships, each with their own physics and challenges. It\u2019s you, gravity, and just enough fuel to make a safe landing."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
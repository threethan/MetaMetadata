20219_681242074647213_7553219210034023362_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tOID8hZAr0Q7kNvwE-8WlG&_nc_oc=AdnA7QYCBYOrjRr2WAKQo2s6ZGhZfyfW2Y4Yt_iHCbF6Nv67LlWxKw_aQoMRhNqB8w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afydpz0QMY87REjXpCVnvXoZli7-e6SrLGXfLAhYjcLIzw&oe=69AC32F3"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP3b24LRl58Q7kNvwGf-E--&_nc_oc=Adn4jd3QOWpwfo_5fj0xzupaxZGlfW9nXhxlIT9T_Ctiwd9treNQfO3PXQABSdvv4W4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfykG2pPSw2OeTbnCzHw9r1OXcjjOzlaDyqTb-9r8RylKA&oe=69AC3342"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZyrv_XW48AQ7kNvwHuu9nt&_nc_oc=Adn680iYOIHyg1Y2jhbu4JsnfSJIBGE3Ve-yBvs64_GPNeYGNwBCr3UnuAm-zXMjQ4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyCRzg6RUK3AW9vepPpWm9pFPZw81nJYf9BK9OdelTQg&oe=69AC3480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473391883_696428426308414_445808803660987887_n (1).png", "id": "4422092391453939", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_4422092394787272_6986771118671084080_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaZ09N10hSQQ7kNvwELUhJ2&_nc_oc=Adk6flPsed-2218TG-m1tOr9I3dOVvsRbqrHD_bZYt1vmENM_nnOD5YSt0_ZiE8y7UM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiooRzTG-7FOSM_sqjU63seUulVViCW1767PJuBjcKcw&oe=69AC2384"}, "display_name": "Space Lander", "keywords": ["Space", "Astronaut", "gravity", "rocket", "Asteroid"], "long_description": "# \ud83d\ude80Welcome to Space Lander!\n\nA spaceflight challenge grounded in your real-world environment.\n\nTake control of rockets, lunar landers, and a zero-gravity astronaut in this precision-based space game for the Meta Quest 3 and 3s. Using mixed reality, your actual room becomes the terrain \u2014 with real furniture and walls acting as collision obstacles that shape every mission.\n\n{2658572141012784}\n\n\ud83c\udf11 **What to Expect**\n\n- Land towering rocket boosters upright with limited fuel and fine-tuned thrusters.\n\n- Navigate agile spacecraft through tight spaces and drifting hazards.\n\n- Float as an astronaut in zero gravity, steering with hand thrusters around your real environment.\n- A level editor with a web browser for you to stream you own music or shows while you create your own level\n- Each surface \u2014 real or virtual \u2014 becomes part of the challenge.\n\n\ud83c\udfaf **Precision Over Flash**\n\nThis isn\u2019t about flashy explosions or cinematic flair \u2014 it\u2019s about:\n\n- Realistic space physics\n\n- Tense, calculated maneuvers\n\n- The thrill of sticking a perfect landing when every second and drop of fuel counts\n\n**Are you ready to master spaceflight, one landing at a time?**\n", "short_description": "In Space Lander, you\u2019ll pilot rockets and lunar ships across zero-gravity environments with limited fuel, real space physics, and high-stakes landings while dodging asteroids, black holes, and beyond. or step out as a free-floating astronaut!"}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24353877714209482"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824611_1012382447692555_773093400539493049_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3RvLxLfQmQQ7kNvwGbbWZy&_nc_oc=AdkqbmT1I9NpIShN_JoUxmfhDCgxHIbxlkWil04j6Tat6vqhF1Axmbyy2RfdgoofhRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxuu-Cv84QomOHmXg6svDTx-bTiRHExhc5JAp3GTl-CPQ&oe=69AC0414"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Lander", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1747154100, "lastRevision": {"nodes": [{"id": "9999770286713464", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9999770260046800", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2186436348457039"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Logo.png", "id": "2442111756172733", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830888_2442111759506066_5769429053889551908_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4HPqclH898Q7kNvwG1ShZf&_nc_oc=Admclpbh2GuodFJDHe_eHmMpInxt07xAoN20_eb5-3qAXF_srEJK_RAv9NPUuJQOKc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxtIJ6K
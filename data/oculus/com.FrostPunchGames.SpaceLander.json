screenshots": [{"file_name": "1b.png", "id": "2514341978919700", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830394_2514341982253033_3494318717667654985_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OC6qK_6Q2IQ7kNvwERFX2g&_nc_oc=AdrhpavZ11Dn1Tq1-HJnwHG_4nxDxuoCrITcgWtA8U7YZQesIO577IZM0F4JxeOHlxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVHMOs81xHxYEmd2NXx6eBT3G8rOk3rDFdWLaKQoY3Sw&oe=6AE49835"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq4cN217spkQ7kNvwE0BUrF&_nc_oc=Adpu2c8vm04-Rel1ArJIhtPfTZ07GRMR-FL46exvluOat9IFybdE1eGlxfY5wKMm3RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNylrGMcSUYFu2sLOeWs55PBhPWoh9bEPEkSOkKKDncA&oe=6AE4A6C2"}, {"file_name": "3.png", "id": "681242071313880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820219_681242074647213_7553219210034023362_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0oH6EXdUDYQ7kNvwF6Mqv_&_nc_oc=Ado9-uQq9yUPR5PRTISPVqJj72Yg4b7lEYCUae6Y1-y5Bvmj760I93uB66QxeEptfeE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeRrGp2oj8CrK2JLIY1yWHAwR5fUPKEOW4v4m8neYY7g&oe=6AE4A673"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV__MtAM2WYQ7kNvwHSrhuz&_nc_oc=Adq8KH7ST8KmAioA9_qfpiHzH96P89eP6mJ2gR6sfva5cStlZ39wkkc1fOGvbaXgnF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJy_IfzfQQIonM7UouuZFKT6MRxRvvie9ui5pWfyoqMg&oe=6AE4A800"}, {"file_name": "7.png", "id": "682203651434927", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827720_682203654768260_1451577516060763779_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0nAyQSovEEQ7kNvwH7JNjX&_nc_oc=Adr7v_e-e2OQIxAV3jVVdUBHHie7YFvFgdJxSxQsKMATWWtbSH_V0CXTvpf6EwRXodM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf0kiKsGpi3DCb47MYFiZtr1rnip9sxz8gwaxXAOJr7w&oe=6AE4A519"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Lander", "keywords": ["Space", "Lunar", "Rocket", "scifi", "Landing"], "long_description": "Space Lander is a mixed reality landing game built where your real-world space becomes a landing site.\n\nYou\u2019ll start with a rocket booster that needs to land upright on a tower\u2014classic, clean, and surprisingly tough. Then there\u2019s the smaller spacecraft: quick, nimble, and built for weaving through tight spots and dodging floating debris before touching down.\n\nEach mission has a higher difficulty; every surface becomes part of the challenge. And with limited fuel, every second counts.\n\nIt\u2019s not about flashy explosions or over-the-top graphics. It\u2019s about control. Precision. The quiet tension of sticking the landing when it really counts.", "short_description": "Space Lander drops you into the pilot seat of rockets and ships, each with their own physics and challenges. It\u2019s you, gravity, and just enough fuel to make a safe landing."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
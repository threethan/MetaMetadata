a&_nc_ohc=U579YdvgaPsQ7kNvwFtGUB3&_nc_oc=AdnvNgyyXuHuxKRpdu_Bn85Qc2-6N3Bbhk2mMxDwet7RBHOjiIQi5VOnknch9ornao4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv-44TaW8yjPBJ_ZyyKi0XAtCuIc5pGpSa2nb9IONAu9w&oe=69A449F3"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erTY_py8LOIQ7kNvwG1qrWW&_nc_oc=AdlYs-B7CDATUNW1Rbtqm9_zTja8lxTyykn3aDG7B60HXHfcRfpvPUKFg0i_rMrH1GM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuCIh3G53OsdghrF4viFXt6tA5Cn9bDIC4t5Z36gjIAgQ&oe=69A44A42"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAPT6WIH9ywQ7kNvwEzkXZ-&_nc_oc=Adlr1AelFINMe1GcyP2d3eJStpm5UEYzep1wJjmXJ4BXvSH36s_uxrzLn1cya4KgCtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQWWpmJqcDYIngo0K5H84TizB4gaEEXUfbWVk9qv91QQ&oe=69A44B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473391883_696428426308414_445808803660987887_n (1).png", "id": "4422092391453939", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_4422092394787272_6986771118671084080_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID7ISkZqzPMQ7kNvwEji2ko&_nc_oc=AdnSAjsATpPUAg7yRy43KQnrSrlaH7sXbez-1LDDG6jll6YvoK2xBNleNuQfI7U5t38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs5qTj5tWkdWOh6rbWLPc-_urVoV8J-bUCzOvxCLq8UHQ&oe=69A43A84"}, "display_name": "Space Lander", "keywords": ["Space", "Astronaut", "gravity", "rocket", "Asteroid"], "long_description": "# \ud83d\ude80Welcome to Space Lander!\n\nA spaceflight challenge grounded in your real-world environment.\n\nTake control of rockets, lunar landers, and a zero-gravity astronaut in this precision-based space game for the Meta Quest 3 and 3s. Using mixed reality, your actual room becomes the terrain \u2014 with real furniture and walls acting as collision obstacles that shape every mission.\n\n{2658572141012784}\n\n\ud83c\udf11 **What to Expect**\n\n- Land towering rocket boosters upright with limited fuel and fine-tuned thrusters.\n\n- Navigate agile spacecraft through tight spaces and drifting hazards.\n\n- Float as an astronaut in zero gravity, steering with hand thrusters around your real environment.\n- A level editor with a web browser for you to stream you own music or shows while you create your own level\n- Each surface \u2014 real or virtual \u2014 becomes part of the challenge.\n\n\ud83c\udfaf **Precision Over Flash**\n\nThis isn\u2019t about flashy explosions or cinematic flair \u2014 it\u2019s about:\n\n- Realistic space physics\n\n- Tense, calculated maneuvers\n\n- The thrill of sticking a perfect landing when every second and drop of fuel counts\n\n**Are you ready to master spaceflight, one landing at a time?**\n", "short_description": "In Space Lander, you\u2019ll pilot rockets and lunar ships across zero-gravity environments with limited fuel, real space physics, and high-stakes landings while dodging asteroids, black holes, and beyond. or step out as a free-floating astronaut!"}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
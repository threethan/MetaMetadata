oldQ8XfOszkirs_TYqKaKH3Aqc14X-L1f1ITDI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp86jhtIg8765uXtUPOafDuPVGQTnqmo815GeuX9YrjQ&oe=6AAD4619"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Lander", "keywords": ["Space", "Lunar", "Rocket", "scifi", "Landing"], "long_description": "Space Lander is a mixed reality landing game built where your real-world space becomes a landing site.\n\nYou\u2019ll start with a rocket booster that needs to land upright on a tower\u2014classic, clean, and surprisingly tough. Then there\u2019s the smaller spacecraft: quick, nimble, and built for weaving through tight spots and dodging floating debris before touching down.\n\nEach mission has a higher difficulty; every surface becomes part of the challenge. And with limited fuel, every second counts.\n\nIt\u2019s not about flashy explosions or over-the-top graphics. It\u2019s about control. Precision. The quiet tension of sticking the landing when it really counts.", "short_description": "Space Lander drops you into the pilot seat of rockets and ships, each with their own physics and challenges. It\u2019s you, gravity, and just enough fuel to make a safe landing."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
 "en_US", "screenshots": [{"file_name": "1b.png", "id": "2514341978919700", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491830394_2514341982253033_3494318717667654985_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NphB_HqjK0UQ7kNvwF0_GSl&_nc_oc=AdpTd85xInY__h0rwZ5I8KzCtWV8IgNhw6_KGqOtP8T9rY1XMKA2zhu2oCXu91GrXSI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q_UErgjzB7eera6gv1Z3JnPNgQ8PHXdATjRU18kQhhQ&oe=6A393535"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re6Q2nceSGUQ7kNvwHkDDxA&_nc_oc=AdrrSn5tp74KNnSqsFA5erce2gGFjuDzIbLvpwEtRCJSUaFrwVChkZQhMrNMMBLvsog&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k8fQ3rev1M0WGcowRQayJo-zCfyWrKYBjO1oRH-RwpQ&oe=6A3943C2"}, {"file_name": "3.png", "id": "681242071313880", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820219_681242074647213_7553219210034023362_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSNGBYChIU0Q7kNvwGcjsXj&_nc_oc=Adocif-2Z8X2NbtxTlrzYENfnYlAtblmahA5suCVGw0ofPTj4hTVhZB_jB784QHhNjs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-17FitvyDIyqNyfIQshd4XogQyWBS2S8HOuWqyyEG2A&oe=6A394373"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dwc1JuxKDy0Q7kNvwHGIaCR&_nc_oc=Ado1lfvP2Qukzng0tjRDARKo1ICEjKHL18kfzZ-JwvSwahZcU-pv8CEfRFoQJLs5c3U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xrSnDg5v1J-aIDG9B6xRRKzoDjdJbsDWAtsf0pKannA&oe=6A394500"}, {"file_name": "7.png", "id": "682203651434927", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491827720_682203654768260_1451577516060763779_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2GSTAA-gy4Q7kNvwH1b1UD&_nc_oc=AdrzQxtA88dT66CeUWdTmHDqJWETORr2HK73ElnnJToOJN0j9sOaokmwZMLwtapc0oI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VhWvXZWQUf4Tag6H5MGT0A0TWuqB0mPj8zoKlfnEIJA&oe=6A394219"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Lander", "keywords": ["Space", "Lunar", "Rocket", "scifi", "Landing"], "long_description": "Space Lander is a mixed reality landing game built where your real-world space becomes a landing site.\n\nYou\u2019ll start with a rocket booster that needs to land upright on a tower\u2014classic, clean, and surprisingly tough. Then there\u2019s the smaller spacecraft: quick, nimble, and built for weaving through tight spots and dodging floating debris before touching down.\n\nEach mission has a higher difficulty; every surface becomes part of the challenge. And with limited fuel, every second counts.\n\nIt\u2019s not about flashy explosions or over-the-top graphics. It\u2019s about control. Precision. The quiet tension of sticking the landing when it really counts.", "short_description": "Space Lander drops you into the pilot seat of rockets and ships, each with their own physics and challenges. It\u2019s you, gravity, and just enough fuel to make a safe landing."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
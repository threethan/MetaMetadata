a&_nc_ohc=p48yQBuzbTcQ7kNvwFI_1lg&_nc_oc=Adlb17nnJF4whrPiWvV8Rk87bowuuizDNL5jEHJIoNlF6M1wOVFROxru3wVnsbpfIvA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftWRavffSffhNoMH1HCqwWg6yXH-Zm9mzWvSAyIKUo0Gg&oe=69A1A6F3"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erTY_py8LOIQ7kNvwGf9DMV&_nc_oc=AdlcGiZKeboouVQYet9eYLyiYbkPYbSit3NsSJ0cI1b8wo5PxEi1sEc2XS_HBHWe0W8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfunCyuA3umiF2jmIx6rW3P3g09fMYMyztbSlMWmtCpQVg&oe=69A1A742"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0UvYjvGovEQ7kNvwGkLI17&_nc_oc=AdlvqtFYGPyXJZmYDHOn-42El5l0ABikRIilysrZQSSrQj5DEivfZuGzoMtBrJaGA28&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs6PDYwxdvChhegSZXqs87IU8MCZp-Ctcc61OoD371TrA&oe=69A1A880"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473391883_696428426308414_445808803660987887_n (1).png", "id": "4422092391453939", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491822581_4422092394787272_6986771118671084080_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hByBRUk2CFwQ7kNvwGg-T69&_nc_oc=AdmNi8TnlKuQ7WT3uvmPVAEunuSUMnrrQg7gzqhHJcc_s7C2VAr0NF1ij-6K-_YqhVI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftJ-KDsg1kiVYQjA1v1d89sT0Mxdue_-lXo538nDCuw3w&oe=69A19784"}, "display_name": "Space Lander", "keywords": ["Space", "Astronaut", "gravity", "rocket", "Asteroid"], "long_description": "# \ud83d\ude80Welcome to Space Lander!\n\nA spaceflight challenge grounded in your real-world environment.\n\nTake control of rockets, lunar landers, and a zero-gravity astronaut in this precision-based space game for the Meta Quest 3 and 3s. Using mixed reality, your actual room becomes the terrain \u2014 with real furniture and walls acting as collision obstacles that shape every mission.\n\n{2658572141012784}\n\n\ud83c\udf11 **What to Expect**\n\n- Land towering rocket boosters upright with limited fuel and fine-tuned thrusters.\n\n- Navigate agile spacecraft through tight spaces and drifting hazards.\n\n- Float as an astronaut in zero gravity, steering with hand thrusters around your real environment.\n- A level editor with a web browser for you to stream you own music or shows while you create your own level\n- Each surface \u2014 real or virtual \u2014 becomes part of the challenge.\n\n\ud83c\udfaf **Precision Over Flash**\n\nThis isn\u2019t about flashy explosions or cinematic flair \u2014 it\u2019s about:\n\n- Realistic space physics\n\n- Tense, calculated maneuvers\n\n- The thrill of sticking a perfect landing when every second and drop of fuel counts\n\n**Are you ready to master spaceflight, one landing at a time?**\n", "short_description": "In Space Lander, you\u2019ll pilot rockets and lunar ships across zero-gravity environments with limited fuel, real space physics, and high-stakes landings while dodging asteroids, black holes, and beyond. or step out as a free-floating astronaut!"}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
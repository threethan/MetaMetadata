 "en_US", "screenshots": [{"file_name": "1b.png", "id": "2514341978919700", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491830394_2514341982253033_3494318717667654985_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmuZJw4Ej74Q7kNvwErK9bh&_nc_oc=Adpg-nuta2Jxo9odfWJnsuVc1xaxUZs4ZE5PV8Z4Aeyd7x-1IiWprzEed0NhelolmQ8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81NsqRjSmWzB0YPgZXt3mWStvos3itEx046d2jwgIvMA&oe=6A466435"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjw-GCrEcmoQ7kNvwGwITsT&_nc_oc=Adrn0tDBR9ssa0q13fy7RyRnMzt0rz2_lMj10p1RTyAqskY-t-4_6kGrGq-7Gi3XltQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CVkJqlZQ5_mx0bn3zJFG5wBL0bKol5aHyv75FCXObag&oe=6A4672C2"}, {"file_name": "3.png", "id": "681242071313880", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820219_681242074647213_7553219210034023362_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pbnX9ifzR4Q7kNvwGsyeXO&_nc_oc=Adr-B1--EIGW9gI8aPCzWbTVp9q2aK7ktIZvVUW54qSGPbuFX_Cidhk5b7HPBkIcmyA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2746_U81n42n_OJ-NfAiz6cLhNLE-zaHxvnQ714uPUw&oe=6A467273"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrNP0hyi-x4Q7kNvwGpseiA&_nc_oc=Adp6xHCj12PrIE-vBDta1vk6y7TdadQc9Dhe47kPe_ILrJF6MmXxN0T4lrJ9i-hACIs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dMkwM4ju4F5trqjAFxRm_GgGVGUMuNlp0cb5Z1pkhlw&oe=6A467400"}, {"file_name": "7.png", "id": "682203651434927", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491827720_682203654768260_1451577516060763779_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eay8kEd_LboQ7kNvwHp1vWz&_nc_oc=AdqLG7i5WuRAaxNpQHD_d2KcIf86_V7lCsMOtxCUqAx5NxoIr4kd0lCnxlPOITdAEwc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83olNfLVOFpdo8jN-Flcx_RFO4BsnRKHRgtbla-m8Bbw&oe=6A467119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Lander", "keywords": ["Space", "Lunar", "Rocket", "scifi", "Landing"], "long_description": "Space Lander is a mixed reality landing game built where your real-world space becomes a landing site.\n\nYou\u2019ll start with a rocket booster that needs to land upright on a tower\u2014classic, clean, and surprisingly tough. Then there\u2019s the smaller spacecraft: quick, nimble, and built for weaving through tight spots and dodging floating debris before touching down.\n\nEach mission has a higher difficulty; every surface becomes part of the challenge. And with limited fuel, every second counts.\n\nIt\u2019s not about flashy explosions or over-the-top graphics. It\u2019s about control. Precision. The quiet tension of sticking the landing when it really counts.", "short_description": "Space Lander drops you into the pilot seat of rockets and ships, each with their own physics and challenges. It\u2019s you, gravity, and just enough fuel to make a safe landing."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
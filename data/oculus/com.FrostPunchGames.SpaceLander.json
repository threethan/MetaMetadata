: "en_US", "screenshots": [{"file_name": "1b.png", "id": "2514341978919700", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491830394_2514341982253033_3494318717667654985_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFMrxO2qcJQQ7kNvwFkb_zE&_nc_oc=AdrTb7O6AhgVlHaWOk291ziHcFi3pVwPdJCAEpUd_ApTl0wziZha-8W2DgmQfU_CCj8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNZThL8_5S_L5IJzTM3cXGBaMDGU0gd3v4rrUAWg4ZzQ&oe=6AA944B5"}, {"file_name": "2b.png", "id": "669097149080586", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818916_669097152413919_3059721482891052277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQXD3eAFAosQ7kNvwGwsggt&_nc_oc=AdrlBLTJDC_Z0cXbxcMArBc-_8RtJArwUH8Od4Xl_rFpex6-3Cnqoho4R-Du2QBAgGA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnRm0g6eryrwkE3mErR0x5y6kNvJi7vcyIoBD7ybyAkA&oe=6AA95342"}, {"file_name": "3.png", "id": "681242071313880", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820219_681242074647213_7553219210034023362_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcqyTXlSiBEQ7kNvwHvVaDt&_nc_oc=Adr7IfOOJPv7UxGbQm4GMODSntmjfhu6Y8Wdh3yZ2fbdng8eMZoI0LyP6SqX_Xi79SE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOOOcKfXaa54xJxo7fNT7kBW8h1NAnkkz6O_mvPzW6Eg&oe=6AA952F3"}, {"file_name": "4.png", "id": "2089898914845162", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827286_2089898918178495_4497274503325493520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylmR8w_-fOMQ7kNvwF6jRk4&_nc_oc=Ado7lLjk9DRmeNBF2yriuhLUOJMkfsTq3zAEFsYWLa8FD3Y8dJb85d5z_khqj8tPXzE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnnUzf3Mga2ULIJykUojb1i_1zEqHxkKDeYmZNpIj_rA&oe=6AA95480"}, {"file_name": "7.png", "id": "682203651434927", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491827720_682203654768260_1451577516060763779_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFexI4DVB0IQ7kNvwGo25wg&_nc_oc=Ado34dkr0z2BzpyOx3C4o52-PeTri2hRTRwX492nbbCTcJ0IgJgxYX9bw7jEgjDQWFU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_L0Y0JUnKsa39cQVLcEH4cLb6lnVxLE9pDCxBOqmmDA&oe=6AA95199"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Lander", "keywords": ["Space", "Lunar", "Rocket", "scifi", "Landing"], "long_description": "Space Lander is a mixed reality landing game built where your real-world space becomes a landing site.\n\nYou\u2019ll start with a rocket booster that needs to land upright on a tower\u2014classic, clean, and surprisingly tough. Then there\u2019s the smaller spacecraft: quick, nimble, and built for weaving through tight spots and dodging floating debris before touching down.\n\nEach mission has a higher difficulty; every surface becomes part of the challenge. And with limited fuel, every second counts.\n\nIt\u2019s not about flashy explosions or over-the-top graphics. It\u2019s about control. Precision. The quiet tension of sticking the landing when it really counts.", "short_description": "Space Lander drops you into the pilot seat of rockets and ships, each with their own physics and challenges. It\u2019s you, gravity, and just enough fuel to make a safe landing."}]}, "developer_name": "RudyAA", "developer_privacy_policy_url": "https://sites.google.com/view/spacelandervr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FrostPunchGames", "support_website_url": null, "website_url": "https://sites.google.com/view/spacelandervr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
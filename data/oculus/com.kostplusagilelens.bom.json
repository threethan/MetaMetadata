8"}, {"file_name": "Still3.png", "id": "382865400850824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982629_382865407517490_2396227719532684139_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEAjghC7C7wQ7kNvwGx3rWR&_nc_oc=AdkdK2cKSVQq4yOE-0BvArwbOS6yGJ5zEbXCEdp_fcM8pdln4a3LpgnjSI74ituNiys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvJuXad0oUwf-HFnsjkbUYngLkvcWwajA19FI6fLcRJZA&oe=699C343E"}, {"file_name": "Still1.png", "id": "365713679425346", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_365713682758679_3613768244701738450_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RypirJq2iZcQ7kNvwETyxE6&_nc_oc=Adm_p3OkJdadJXv157aRTb1UiJH6Q5-we90vxUKGge8IsLXhYQQMYdA-BmoHX-ScBHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuWJYVJyDvKD9yiODSARR8rJB7sBfrNj-4XMgmpt-yhnQ&oe=699C52D2"}, {"file_name": "Still4.png", "id": "300022469870024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75299164_300022473203357_5177818308064844233_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOF7Mbs7FX0Q7kNvwEEr02n&_nc_oc=AdlPF5EyTrz5a0-SnD-1PjtTknEH2p4jOqdqD9-2NUTf_DXVwSC-vcRkXDJeUMnhwG4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afth9Y5yZGgcok0WF8N8W5uDDioFx2XN3PKCWt1_rnRa9g&oe=699C3BBE"}, {"file_name": "Still5.png", "id": "1851016308697394", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334065_1851016315364060_8866555514133823335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd3rvy8oW48Q7kNvwGBkws0&_nc_oc=Adkzoel_TOAfDWtMN_15TSS2qLvlKzUw_H7EZS3kAklQnRFS-7ggtdhy7ipPepUy29g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfugSykLkF8oJJSKPi6AUFL4cX2xpodDKs2fY_a4O5DH-g&oe=699C42F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Horizontal.png", "id": "422699117329509", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282168_422699120662842_4732102299172740306_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSaaFCL_1_QQ7kNvwE_gdP_&_nc_oc=Adk8ahlM2P_0Cp8SbpK3es_6PNEp9UZQ6BWp1jQceQw4oUOCF1bMLw18jYGcpmzJ_M0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftJASQcAibBe9edFEesMS-F9OoZ4Wd-gpVLXeaXuXxolg&oe=699C3190"}, "display_name": "Body of Mine", "keywords": ["Body", "Gender", "Trans", "LGBT", "Queer"], "long_description": "Body of Mine is an award-winning, full-body VR experience that invites you to inhabit the body of another gender and discover stories from transgender individuals.\n\nCombining body, face, and eye tracking with personal interviews of transgender individuals, the experimental storytelling experience allows you to hear, discover, and experience stories of gender dysphoria and euphoria.\n\nWinner of the Producers Guild Innovation Award, and with accolades from BAFTA, SXSW, and Games for Change, Body of Mine \u201cbreaks through a psychological barrier that few pieces of media ever have\u201d (WIRED), taking you on a profound journey of what it means to be a human being.\n\n\n\n{475108011677489}", "short_description": "Body of Mine invites you to step into the body of another gender and discover stories from transgender individuals.\n\n"}]}, "developer_name": "Kost, Inc. & Agile Lens", "developer_privacy_policy_url": "https://kost.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kost, Inc.", "support_website_url": "https://www.bodyofminevr.com/help", "website_url": "https://www.bodyofminevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["
8"}, {"file_name": "Still3.png", "id": "382865400850824", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982629_382865407517490_2396227719532684139_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gxqCrspFrEQ7kNvwHPCv-C&_nc_oc=AdlOSISe5UYQbPPSwuM7GjiqM-HXQkhkWx4-FtuSGKQjZRZzRMk76_SJIY2ZJ4Bh4ms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftogjG9GEPORZS7y-qH7ZUgrrlaSE7CQtkkO451qUA_dQ&oe=69983FBE"}, {"file_name": "Still1.png", "id": "365713679425346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031318_365713682758679_3613768244701738450_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNT112IQvsoQ7kNvwGHZY5c&_nc_oc=Adnn3ZjW1AqQldY3jCMFZqS0JN95BTyehEEP7-mzCJUOIqy7YqPJqEHz67ge3Cu0xEo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvIXBYoDTvxPSqm4Oe8dLNkgsRJ1p57fgurb9KL_FSNjA&oe=69985E52"}, {"file_name": "Still4.png", "id": "300022469870024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299164_300022473203357_5177818308064844233_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTCUZmH5PZ0Q7kNvwFtTNhs&_nc_oc=AdmY8mkHTiBdHiAh1qDolDdGoU-SY6KhA2HEMzsoELchllFtdHfcMsviCIbdP_mDP7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsmqCUGmAP8hRT8gu4VT2S-MCOAYnW5OszE6HrVZqW0BQ&oe=6998473E"}, {"file_name": "Still5.png", "id": "1851016308697394", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334065_1851016315364060_8866555514133823335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N606sgvvVzIQ7kNvwFb6A2J&_nc_oc=Adm52Y-Gwh_6IkH66cGFYnnsmvdce_V0eObNuCKacJ3g4E9vgZW_dHD2w6zoYLUhMX4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftHL1fnikxa1XltDsWjgLDA-mV4nXtr-S7nFOal8Wi9Dw&oe=69984E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Horizontal.png", "id": "422699117329509", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75282168_422699120662842_4732102299172740306_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvvHKomeOz0Q7kNvwEceP8C&_nc_oc=AdnTUsz2dVzDKfhopn9dg7ehl7cav9uUFAiPuk3c4kfXiQcodWVvaL7dplmfWaO4Ys0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuNRSrq-k9D_7HXPvbcCuCESx3XLGbddGlz_WfY9ZDwiw&oe=69983D10"}, "display_name": "Body of Mine", "keywords": ["Body", "Gender", "Trans", "LGBT", "Queer"], "long_description": "Body of Mine is an award-winning, full-body VR experience that invites you to inhabit the body of another gender and discover stories from transgender individuals.\n\nCombining body, face, and eye tracking with personal interviews of transgender individuals, the experimental storytelling experience allows you to hear, discover, and experience stories of gender dysphoria and euphoria.\n\nWinner of the Producers Guild Innovation Award, and with accolades from BAFTA, SXSW, and Games for Change, Body of Mine \u201cbreaks through a psychological barrier that few pieces of media ever have\u201d (WIRED), taking you on a profound journey of what it means to be a human being.\n\n\n\n{475108011677489}", "short_description": "Body of Mine invites you to step into the body of another gender and discover stories from transgender individuals.\n\n"}]}, "developer_name": "Kost, Inc. & Agile Lens", "developer_privacy_policy_url": "https://kost.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kost, Inc.", "support_website_url": "https://www.bodyofminevr.com/help", "website_url": "https://www.bodyofminevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["
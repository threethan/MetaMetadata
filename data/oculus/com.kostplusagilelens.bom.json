8"}, {"file_name": "Still3.png", "id": "382865400850824", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982629_382865407517490_2396227719532684139_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPBPmXvkwgAQ7kNvwHASEhB&_nc_oc=AdmCZZrKnmbzPuyxfslg3o2lJ1-ulhmQC2y_rDTVu0Rh0FTJ2FjcCMFnSPSXgz-loCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsW-y6q2E9vPkjaELs7ahSnHaDFOK5vPUcOaPPqYGrh7w&oe=69A41D3E"}, {"file_name": "Still1.png", "id": "365713679425346", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031318_365713682758679_3613768244701738450_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btx87YGeWykQ7kNvwF6z0v6&_nc_oc=AdlYnNwTjWxSeUVngY3c3xg3ix_Y9GhfMdE1xndsrkvD58NYPOQA18bN2B-Ki6_zwRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsNI008tTj0FDM8l3B3VIaIbDDZu8mumB4tjDIPWk0Uag&oe=69A43BD2"}, {"file_name": "Still4.png", "id": "300022469870024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75299164_300022473203357_5177818308064844233_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frn2TMX4s0kQ7kNvwFdjlCj&_nc_oc=AdkuMotoODHibdrRWTTMFTHoRiCguO_CcZkVhHZmp4Rb300-a84FwFE4ZMFqRW4MdLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuyXJxljnvwSW-YDaVzEq4-J2K5LZeCg9v_DfnBuDQZCg&oe=69A424BE"}, {"file_name": "Still5.png", "id": "1851016308697394", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334065_1851016315364060_8866555514133823335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0wR1vZjshYQ7kNvwHBR2Dv&_nc_oc=Adn1xDm2HhWGZ_yIE7yNoi4RavZpjg9x1bsfz4R7OhX3XHvGrxrja-h9mty4y78ZC4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu-aOipPp54rS4OY_mORmROz4u57TiuFRCrSTZVIv2CJA&oe=69A42BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Horizontal.png", "id": "422699117329509", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282168_422699120662842_4732102299172740306_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lI5G-M6k24YQ7kNvwEZmLf4&_nc_oc=Adnn_49Bj3nwFHgiCasXvwWmHlcnhblJs6mKj_Qm2Cs4hNv4nu6GpYqC3FtchWlKD5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftHmq8thHfGLjRxLluwEQBci6cps4HAoUhgYvypXgcPig&oe=69A452D0"}, "display_name": "Body of Mine", "keywords": ["Body", "Gender", "Trans", "LGBT", "Queer"], "long_description": "Body of Mine is an award-winning, full-body VR experience that invites you to inhabit the body of another gender and discover stories from transgender individuals.\n\nCombining body, face, and eye tracking with personal interviews of transgender individuals, the experimental storytelling experience allows you to hear, discover, and experience stories of gender dysphoria and euphoria.\n\nWinner of the Producers Guild Innovation Award, and with accolades from BAFTA, SXSW, and Games for Change, Body of Mine \u201cbreaks through a psychological barrier that few pieces of media ever have\u201d (WIRED), taking you on a profound journey of what it means to be a human being.\n\n\n\n{475108011677489}", "short_description": "Body of Mine invites you to step into the body of another gender and discover stories from transgender individuals.\n\n"}]}, "developer_name": "Kost, Inc. & Agile Lens", "developer_privacy_policy_url": "https://kost.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kost, Inc.", "support_website_url": "https://www.bodyofminevr.com/help", "website_url": "https://www.bodyofminevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["
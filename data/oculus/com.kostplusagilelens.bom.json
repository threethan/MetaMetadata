8"}, {"file_name": "Still3.png", "id": "382865400850824", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_382865407517490_2396227719532684139_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gxqCrspFrEQ7kNvwGhSuYw&_nc_oc=Adl0VKQAFKuxwXbqEPd1CWbEqpsmRvyTKldJvuikVwa5zvx85rEtod9wAjWqPv0VEzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLRNuYUdyRE7TueOAnwxs7_8IgvR13ejrCMFBPb7W0wQ&oe=6999913E"}, {"file_name": "Still1.png", "id": "365713679425346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031318_365713682758679_3613768244701738450_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNT112IQvsoQ7kNvwF3XzeC&_nc_oc=AdnpsjALIBTovgw3wYfg2JdK87-RqVmaYADWyl8-A3yMfzm8tYs7NhgVr2bzQd1p4No&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7luEzPj5e4LWA24WTDXGWFaKcv2uaX_O6Bh38-Ia3gw&oe=6999AFD2"}, {"file_name": "Still4.png", "id": "300022469870024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75299164_300022473203357_5177818308064844233_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTCUZmH5PZ0Q7kNvwGTXLIa&_nc_oc=AdlTG026qT0LL4no_y3Q9pvvhwPLFcAQqwq9uiL9am_Pa3_qu6oGnj25EFkWfPer4dw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFGIR6_TW0jOTveHGMq_rR-HRSdg8moYalXm-UGqCgNA&oe=699998BE"}, {"file_name": "Still5.png", "id": "1851016308697394", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334065_1851016315364060_8866555514133823335_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd3rvy8oW48Q7kNvwFZn8HW&_nc_oc=AdnQe16f8df07_fIvUl5pthIp_BkImtdj-R5X30sLQ6BZ1GP3MdKYqBr2K8fyOd8eyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsaHimv90ieTgBjCRvbPZGDJLImxvpe3xtgwsFo80pVEA&oe=69999FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Horizontal.png", "id": "422699117329509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282168_422699120662842_4732102299172740306_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvvHKomeOz0Q7kNvwGSZWb-&_nc_oc=AdmeeuUugKuQPdZihE4EZA71yAcXWpmgidc1VQHs-HDXPjcnagtha76ZggdxVAhhhjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuLKAhv-LLMhV919BOO5gkzSl5E9F9Xn6Jg6ie3Ttv3A&oe=69998E90"}, "display_name": "Body of Mine", "keywords": ["Body", "Gender", "Trans", "LGBT", "Queer"], "long_description": "Body of Mine is an award-winning, full-body VR experience that invites you to inhabit the body of another gender and discover stories from transgender individuals.\n\nCombining body, face, and eye tracking with personal interviews of transgender individuals, the experimental storytelling experience allows you to hear, discover, and experience stories of gender dysphoria and euphoria.\n\nWinner of the Producers Guild Innovation Award, and with accolades from BAFTA, SXSW, and Games for Change, Body of Mine \u201cbreaks through a psychological barrier that few pieces of media ever have\u201d (WIRED), taking you on a profound journey of what it means to be a human being.\n\n\n\n{475108011677489}", "short_description": "Body of Mine invites you to step into the body of another gender and discover stories from transgender individuals.\n\n"}]}, "developer_name": "Kost, Inc. & Agile Lens", "developer_privacy_policy_url": "https://kost.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kost, Inc.", "support_website_url": "https://www.bodyofminevr.com/help", "website_url": "https://www.bodyofminevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["
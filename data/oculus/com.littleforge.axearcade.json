oQXYOA&oe=6AB69476"}]}, "id": "1366940048941585", "locale": "en_US", "screenshots": [{"file_name": "axe-arcade-shot1-hero.png", "id": "1163447326729178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628893_1163447330062511_8989197803431640859_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhCfnqSQUPIQ7kNvwEuSQ_G&_nc_oc=AdqRfFnQHA0G2bIRK7xCKQch-HDxdUQ_LIfl_7g516Koikh-v8hJ5gpbl9cFybGmYrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUp6Eor4foUgbAXx6U1fciyU2J6bh1yvo7jsjbJi3Spw&oe=6AB66B8C"}, {"file_name": "axe-arcade-shot2-crack.png", "id": "28086649111029418", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622192_28086649121029417_5437282509902378159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pItv7p18JxcQ7kNvwGkl0Kl&_nc_oc=AdrSzCN3Pnjs5ST3IVOPYErdGDgddntwZkb6hiyTYsHMFvubSpPVONbxsFZX5K64nHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqmU1B2Xu1OszB7vgvg13nN4_RgwHjQWBJwapT-8BTpg&oe=6AB69A29"}, {"file_name": "axe-arcade-shot3-holmganga.png", "id": "1592386091803548", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499628909_1592386095136881_7491312281703280760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqqAoprXEUQQ7kNvwFHuT4W&_nc_oc=Adp72bsY5t8F5pyjDg4pftNURdJKre7Hs12iJqzYfPc9XNwpvxHYHN4WKgFX8VO9eZE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIklhHaSAFlKfUgjMxPapZUqCVEOiNjDf9ru4ZxdFJvsg&oe=6AB66D66"}, {"file_name": "axe-arcade-shot4-fjord.png", "id": "1724378155323202", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593919959_1724378158656535_1449830462000487333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRAecX8mQ0cQ7kNvwFbgk8X&_nc_oc=AdpSEbjymvnEp0Eh9K3Y2Y-IVWUIsy5xg9LBDviapB0f0kTfK9UDdFAozfTaLn26s3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhhv-BW1WhDSpD8r4g4aB2RETwlPUzaO8E7MZIkJ3hHg&oe=6AB67432"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hib6WcnxslgQ7kNvwEtWWAc&_nc_oc=Adr_ZbBUOeNT7LQ1_kaZmUDkPsmlD-1N0aWJ82C-u6v9LvqGa06MSo5lfCEWYCydbUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG91PHG6X41OMACTFM7ql2IYe0VC5ClJ3emoYjgLPEhA&oe=6AB698AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLonM7uBDc0Q7kNvwET5KZN&_nc_oc=AdqkVDkAyl0cjbgClB4Dfo-QiKxyOHA2OGFhjkzaZncGIYU6XIBr4DEVb94AeFnN5qU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb_BPwsX4e5E2dIQQdxKBpve0QzvHGnwX5ad7nxyfjlQ&oe=6AB69E53"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Two venues to throw in \u2014 the Training Field and Fjord Lane.\n- Fjord Lane adds a distance ladder: land a scoring hit and the board steps farther away.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310210368842978"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604275479_2262305381275121_2908255081075092594_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd9bA3ALzEIQ7kNvwGgIePK&_nc_oc=Adqd7P0GlhlZjXWJw8cziUS_TiWrCXPvMYK5ckkN151ffwPKe7QeoT0MU9qOSUt0rWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMRqYjbCQvlKFzpMX7hd_VIbmAfqZyG-abJ157Wfze9w&oe=6AB66B2C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Axe Arcade", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1784693940,
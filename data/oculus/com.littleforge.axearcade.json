a&_nc_ohc=G8UawmMKlSkQ7kNvwEMFB12&_nc_oc=Adoq2dQLM5SOcOxv-rEYcPKasEufhUwHmaSIE6eWXcYoUjXXA_eq8Fg3Rk6FpoC2cR4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9G124mvfTaLnae5e6oUwT7nhU8jh2DUkQPO9B1SiiRw&oe=6AFB3A72"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8cQI1L1AOMQ7kNvwEzPwfv&_nc_oc=AdojzBgrzZJfmI5u3zrSnHw98WaXYbtKgGv8T5ApNWyoHlkAVC2RCed3xe3FgQEZ-h4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfNR-EVr6dqhusNOZBOTNRzDu-HIkhIp_jeYgLcfJWBg&oe=6AFB26AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty9Vu9QwQCwQ7kNvwH8bBS9&_nc_oc=AdqEFCa8RxUwjRU-r4sxZYO0RfHHdMph9zs5G2QPtwmrmVcOThNN16nEFysWRBm3TxY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMtUlAc4LC8vKcFRVGgaMWWCkj0_AinBL7hO3lIdiizw&oe=6AFB2C53"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "viking"], "long_description": "**Axe throwing in VR \u2014 how good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Three places to throw\n- Training Field \u2014 the classic axe-throwing range to learn your throw.\n- Fjord Lane \u2014 a distance ladder: land a scoring hit and the board steps farther away.\n- H\u00f3lmganga \u2014 a Viking duel ground: crack the planks of your rival's shield until it breaks.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Timed Blitz: race a 60-second clock on Fjord Lane with unlimited throws.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.", "short_description": "Real-physics VR axe throwing: grab an axe, wind up and let it fly. Sink bullseyes, race the clock, and split a Viking's shield."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1405466675984013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604275479_226
PF0ByQ&oe=6AB542F6"}]}, "id": "1366940048941585", "locale": "en_US", "screenshots": [{"file_name": "axe-arcade-shot1-hero.png", "id": "1163447326729178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1163447330062511_8989197803431640859_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhCfnqSQUPIQ7kNvwEtpTci&_nc_oc=Adpx28ppgx5edRnKSWy9_YLh6_epQSwT_Pqs-Qm-Mc9xspucoVfXk3-9kSZICRVbFDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0Z_Til82MjwOJasI2acsUP3GF7-y7zj5VnMvuxneQhg&oe=6AB51A0C"}, {"file_name": "axe-arcade-shot2-crack.png", "id": "28086649111029418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622192_28086649121029417_5437282509902378159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yj3NtMGxk0Q7kNvwE9zC5T&_nc_oc=AdqObiXAyQ__-c04fBTBJ4Wx3UiLIizsCb9CE4jZ-lUqH5JUBO3J9hl09DyvxP_aKw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9mkDI_aIgRUXujs2TLZpw1fVlg7C2gZKN4wguSoWjDA&oe=6AB548A9"}, {"file_name": "axe-arcade-shot3-holmganga.png", "id": "1592386091803548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628909_1592386095136881_7491312281703280760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqqAoprXEUQQ7kNvwGw8ZyE&_nc_oc=AdrpJHYPlOo5367YRJVdjd6N0LmEOmtmlpBl7SxO3_vyscn6XL2TQMJgd1WC2xZf0RM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhJhRdpYZqX6RtUu7Twwf6e9dvcc8ZC88Q2RsD66ydFQ&oe=6AB51BE6"}, {"file_name": "axe-arcade-shot4-fjord.png", "id": "1724378155323202", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593919959_1724378158656535_1449830462000487333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyf3HmiPC8QQ7kNvwHM370x&_nc_oc=AdriZwh-z38CqT6h9EZ2aYf-qLyK66NknGYbxeA0EUWukhbTXi4RPMZ8kqyvqnB6B98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd7nUoI2MT1PqNO-ZQKbmsv7AI0SIWc6SQ8WGP71I5jA&oe=6AB522B2"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHF0p6wYJkQQ7kNvwHvLlyg&_nc_oc=AdobT3V8ZuI4rP8LP85pVueIBnpw18RRmVj2nJRJfUMAvNsx2XaJTXLmCzeUkomS5ik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfj3GZ2hxUvHE01pUMoEzvKXqdqGeswyNkULTg0LOzMA&oe=6AB5472F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLonM7uBDc0Q7kNvwG6Fl2h&_nc_oc=AdrM5GPN4rC_J8JDOhJoalbzJe21IID89ZZ9-8M2LtwArpPLrYX7G9-owSRZrE1Lvok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZlTrivDM4g0i_-rSDNSSYwCSb-kgNTCcYw9QInOi1Jg&oe=6AB54CD3"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Two venues to throw in \u2014 the Training Field and Fjord Lane.\n- Fjord Lane adds a distance ladder: land a scoring hit and the board steps farther away.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310210368842978"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604275479_2262305381275121_2908255081075092594_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKgET_wzN-gQ7kNvwFkOpvI&_nc_oc=AdrHbN_hepKzw40N0z3U5eCabuFivEXbc4PX2REuS1stBI6MKFDHH4MMIYdseXXvXN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyDg1NqP6uGI3Mjkztxben9tHtja-t9lK2_4T-kvewnQ&oe=6AB519AC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Axe Arcade", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1784693940,
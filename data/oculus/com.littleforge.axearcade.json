oc=Adp-ZgbUTHfwk3AI180j2w-HTUOb09Erf2kQDXe2gaOQ8dC74Ktfbj33wvxOLkPBsb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdwm87NGrxK8vNiPV3nQBgZ7c15ckfXKE7uSLa3wQiWg&oe=6AE0C30B"}, {"file_name": "cap_shot3-depth-alt_1.png", "id": "1040915801870464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623400_1040915808537130_4781429846582066514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugTNmpIifAMQ7kNvwGeOSDb&_nc_oc=AdpfbmY_rWY1GaNq84erq8iQlgTan35NWBVjBzMEkJh4xV5khtfcZyEu9xdFAvyBdlM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Wp5yqSvGl8nMpsGR2kTavTo_2e6Qs0i2NR9k82v8iQ&oe=6AE0C40E"}, {"file_name": "cap_shot4-score_1.png", "id": "27554383440855653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_27554383447522319_1875656870862086556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaqx2BcVqugQ7kNvwFe7qQ6&_nc_oc=AdpP7ERTpuXAbEOTF64xYo_eeTZxLMoRvbetCdta8xQzpDz5IeFVIMwrV3baX4Qgf1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb1pMtc8L14JLAQzCrynXA7zTJ3OPy2Z-uv3ra_mDcrQ&oe=6AE0AD36"}, {"file_name": "cap_shot5-rest_1.png", "id": "1706333930584924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622211_1706333933918257_8714833817623575886_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yt2dj7zqBkQ7kNvwFC0SIB&_nc_oc=AdpwPFPGkGNgPP-RebvShfejDwuoN6tacYFmqjPyfv1I3olgP9woniU93FRilHggZ8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZGfQlYGLtUFfwAsyUb8PVoxcdwdnt_KA0oubkWYvFDw&oe=6AE0B914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdNfJRXlDWQQ7kNvwHVSgwU&_nc_oc=Adp-InqXGSswIL0w-nR6RxNUFydkV5iiJHXN4kBj4DW6GfFLCJwJIpLcCqA7eywZfl8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTIniFXj2HQwIBz2H2QEyg9SvyoGjXI4UDDUz-p5mGfw&oe=6AE0CE53"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Snap-fast pick-up-and-play: one scene, instant start.\n\n_Simple to learn, satisfying to master._", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
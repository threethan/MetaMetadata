KMyPHA&oe=6AE0C476"}]}, "id": "1335199605249269", "locale": "en_US", "screenshots": [{"file_name": "axe-arcade-shot1-hero.png", "id": "1163447326729178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628893_1163447330062511_8989197803431640859_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUw5OMOzkm0Q7kNvwHYMW2E&_nc_oc=Adrgnb1-flwyGRDbDM9b_zD6ovNWV5uAOk-i3thDyvlcj3FMU5SmJHudy7KJr2IE4yA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcfVE7B0s1h450UYWWCAlW7vtQzRaTDQO4OaLsIztG2A&oe=6AE09B8C"}, {"file_name": "axe-arcade-shot2-crack.png", "id": "28086649111029418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622192_28086649121029417_5437282509902378159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLngCqFHEt4Q7kNvwFaNtWQ&_nc_oc=AdrzunY9bABWYE_rXfc-onYRSYrRMzsMh26xUcpFHu8r00pIOZOOytDEGxmPwPvXw_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO0NMxWqBqvGj7jqmmBcPdnSwuqFBCgNyhcutfYq3B3w&oe=6AE0CA29"}, {"file_name": "axe-arcade-shot3-holmganga.png", "id": "1592386091803548", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628909_1592386095136881_7491312281703280760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2nhvLtPUrYQ7kNvwEtzHzh&_nc_oc=AdrwI-70bk-Tm5k6r-aMfA4N3lYNc5yzE7nNwQzlczyc5MaVpm-GueT_5ALTs7jXQGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFm93a23uFQfDKhPDHXFLlq5rxSW_d0qBujUsy9kYmbA&oe=6AE09D66"}, {"file_name": "axe-arcade-shot4-fjord.png", "id": "1724378155323202", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593919959_1724378158656535_1449830462000487333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGQbsQd6a6sQ7kNvwFP1pAo&_nc_oc=AdrYnFH0rjakB41d5ZCgrlRTdQlWyLWDzKJvefo-8E1Am_c_pw4d9dvvoOIk-4QfWgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY7XNewsx9neVlIONh00n6Qr0OC3kHO6a7sGmGSANVGw&oe=6AE0A432"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kuwq47DHycQ7kNvwF5petr&_nc_oc=AdrBVyFbxvGliWagpyyLczVB6uhPIAL9ACczexkduCcneq67L1rPFigNxeGdJHHfF84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvjXa27nyuf6wE8tgKFPgUYo6qyM7rCH9OSL94tNJs1A&oe=6AE0C8AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdNfJRXlDWQQ7kNvwHVSgwU&_nc_oc=Adp-InqXGSswIL0w-nR6RxNUFydkV5iiJHXN4kBj4DW6GfFLCJwJIpLcCqA7eywZfl8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTIniFXj2HQwIBz2H2QEyg9SvyoGjXI4UDDUz-p5mGfw&oe=6AE0CE53"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Two venues to throw in \u2014 the Training Field and Fjord Lane.\n- Fjord Lane adds a distance ladder: land a scoring hit and the board steps farther away.\n- Timed Blitz: race a 60-second clock on Fjord Lane.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.\n\n## New: Timed Blitz\n- Switch BLITZ on from the main menu; the clock starts the moment you grab the axe.\n- No throw limit: 60 seconds, as many throws as you can land.\n- Blitz keeps its own high score, separate from your classic rounds.", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374356749095006"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604275479_2262305381275121_2908255081075092594_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rguzFKrckcQ7kNvwH4ulTj&_nc_oc=Adp25MePk8d5Rgnp0Q_qz7fz2QFeT1Yao9wRWpKzFijofDiOypVLg8a8G-fIxqhIdEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh0PX-10Al5K4Ygs0zDf4XIyd5TOi6RuLsLufrz_jNZQ&oe=6AE09B2C"}, "is_c
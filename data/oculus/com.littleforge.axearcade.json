oc=AdqCzW0zGM-wNqM4b52DczDfVdwpKbBoB2yGNbYT0Zj06lsQJhdE3GJcRkxf9lol_Rc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjLO11QZNG2bqVpJtwoxPoHQdh6CZpdIfBLPJk4HcpXg&oe=6AE3660B"}, {"file_name": "cap_shot3-depth-alt_1.png", "id": "1040915801870464", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623400_1040915808537130_4781429846582066514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adK-Otm5KSkQ7kNvwGUYl4l&_nc_oc=AdqeP4v9yo_DQ02vmZZ-m1mYzwf8ytdmVjvvZpcL5QuhkK-o5v2vtQFcdozp2BTuJN0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuBK3ThoGLqIhnX7dcYSM87RkOTEzW66iPjynedZdQEw&oe=6AE3670E"}, {"file_name": "cap_shot4-score_1.png", "id": "27554383440855653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624983_27554383447522319_1875656870862086556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cmTUrH4gAIQ7kNvwGFtrkW&_nc_oc=Ado2q9tlC24TbfV4q8E8G9GDYdATxE-s6Nkg0NC37Nd6EFQXggfRDdOFhmYKglIIkHI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQnG93PRNoHgM-pX1LqEeBHBAU8_bu3oAxuGpX9KjfYQ&oe=6AE35036"}, {"file_name": "cap_shot5-rest_1.png", "id": "1706333930584924", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622211_1706333933918257_8714833817623575886_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKBSHiKJIQoQ7kNvwE9I-tm&_nc_oc=AdrUnk8yWPoMZpTP2nKSz9uIKU8LmCOxSUtvJIi_BpRkZ9jts4hAXijjEHpUtZu84Tk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv6h-jYx8cOiITli5bpjgA9TA6v5CiU2sdBNQj04x7Dg&oe=6AE35C14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdNfJRXlDWQQ7kNvwEfUYTI&_nc_oc=AdpPkGqNlce7mXrL_FwulzthoJTWgc7NHXAzAdJra7BTGEbl3UEPW8-Hov92NCHfQZk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJNp-bvdhBhp80eE9EzFpRIJ2R-clJKESiBA0QJUdldA&oe=6AE33913"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Snap-fast pick-up-and-play: one scene, instant start.\n\n_Simple to learn, satisfying to master._", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
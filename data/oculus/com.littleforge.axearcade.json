5ldN&_nc_oc=AdrshRUMmIIgf-3VTbyWD9HYTypFl5E6tW0F8CrnkYvj3lD9XjwPc0WIFt85XHKMd3s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJALhCXZ6Fd5ls9hlwpe-Ka7qeB7Z6PIADHuHbDX5Kn6g&oe=6AAEAB0E"}, {"file_name": "cap_shot4-score_1.png", "id": "27554383440855653", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499624983_27554383447522319_1875656870862086556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhl2HmUlsdAQ7kNvwEYNBRv&_nc_oc=AdoiRlvRzbVpKfxrF7Fk3XfFRG98tqlDatcopvGxGRI1zuFuAE3qmo2s4p-JatXfyBQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrb8tBqilJhTq4RXK58i7YMMLKZWmsraOhfiSlJpiZAA&oe=6AAE9436"}, {"file_name": "cap_shot5-rest_1.png", "id": "1706333930584924", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499622211_1706333933918257_8714833817623575886_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M_53fpv6b0Q7kNvwFJfJUh&_nc_oc=AdrUHrzjFi8mit3LDiA0LkoA7oMHRez8565-VxG30hn9hijpNPLiLiDkPBWuA15wvQc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCmz12zq35wiZPuwBC6EtqGVO7RgTGF_OkoraH0rOESA&oe=6AAEA014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZhrS50lBPkQ7kNvwFTWFjs&_nc_oc=AdqB_U4uvkYPIrLoVEA4GHfoehh88oV1FtItZB9yLuFKmcZZxf2-H-MdQzZtJJSCU8k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhhPo1aVnDcMIG5Ed8PIW--1CL8DO2bHXmZ0vHGZqVoQ&oe=6AAEB553"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Snap-fast pick-up-and-play: one scene, instant start.\n\n_Simple to learn, satisfying to master._", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1184265278104155"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2255323051930191"}, {"status": "PUBLISHED", "id": "1364701899148314"}, {"status": "PUBLISHED", "id": "2067963204115398"}]}, "baseline_offer": {"id": "2255323051930191"}, "is_approved": true, "firstOffer
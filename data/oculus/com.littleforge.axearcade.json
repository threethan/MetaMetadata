a&_nc_ohc=Nn98OJclikgQ7kNvwG9i11D&_nc_oc=AdoPrW_gZP4KvqsxYNmVM77YFMPQ0bnGNjn8DKH1Bz8tktIPNnAmB-xekeeHUcrlAVg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-jqv7j26lJAXmejitTenoL8P9FmAkcZ4B44Q26UyPDw&oe=6B0B44B2"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmsMsoI6auYQ7kNvwHnooX-&_nc_oc=AdpOjzdL5ReWKrNFxtLJSJmAa0YKWIk5vKLyfy4FpfhfSrvnbPe9F4chutA67RPXKh0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNDJLDTyOpDSNLVFy1hZLJpDrM6hqCUUFNkQhdNPlBhQ&oe=6B0B30EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDrRkYgIHbIQ7kNvwGxbS41&_nc_oc=Adqedlbp6WaVYOCaLRlNdnlznrhlANpxWtBV_i5-VfCRUSHfquMeibARcWcucd_ID9M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6D7FQGFug7cTL7csDsLt5kcajD5GPmMNGp8mNt4sa1Q&oe=6B0B3693"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "viking"], "long_description": "**Axe throwing in VR \u2014 how good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Three places to throw\n- Training Field \u2014 the classic axe-throwing range to learn your throw.\n- Fjord Lane \u2014 a distance ladder: land a scoring hit and the board steps farther away.\n- H\u00f3lmganga \u2014 a Viking duel ground: crack the planks of your rival's shield until it breaks.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Timed Blitz: race a 60-second clock on Fjord Lane with unlimited throws.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.", "short_description": "Real-physics VR axe throwing: grab an axe, wind up and let it fly. Sink bullseyes, race the clock, and split a Viking's shield."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1405466675984013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604275479_226
_Gxp_w&oe=6AE36776"}]}, "id": "1335199605249269", "locale": "en_US", "screenshots": [{"file_name": "axe-arcade-shot1-hero.png", "id": "1163447326729178", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499628893_1163447330062511_8989197803431640859_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUw5OMOzkm0Q7kNvwG_HD1V&_nc_oc=Ado7RoDdB4fJAdk9ZNsXb-53_3eDlTSzHFACQ9IX5i3b9OLae_yL2obm9QfjutO07no&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3VxjhF-dkEyWZf-ECDxj9ck0L3-QmNQu_B3JS4uG-Cg&oe=6AE33E8C"}, {"file_name": "axe-arcade-shot2-crack.png", "id": "28086649111029418", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622192_28086649121029417_5437282509902378159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVdLdd8xON4Q7kNvwH_yOpn&_nc_oc=AdonVISEFSMkzWX8LLUGk5uocsrgSPd6kD8QUAxsZ-ISWjPDcC7em4mCXzEpyWNinhE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1hVJzHNq2Bq77eAon2aFvWV38lCdnryn0yVp7_7nKPA&oe=6AE36D29"}, {"file_name": "axe-arcade-shot3-holmganga.png", "id": "1592386091803548", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499628909_1592386095136881_7491312281703280760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD6O5pAj0UIQ7kNvwEr_jDX&_nc_oc=AdocDMtwh_7XOXCUnHHi7hZbQHr7cGQ6_BlLWr2st6x4H2853juhZW8KxwZ3xIgrmf4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc2tYaKRm-qp153mnYa_O-tdQ0Qv23OcXnsKtM1m2T1g&oe=6AE34066"}, {"file_name": "axe-arcade-shot4-fjord.png", "id": "1724378155323202", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593919959_1724378158656535_1449830462000487333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kkz407mOGlkQ7kNvwEPYcMj&_nc_oc=AdpC9NRa7TWENNoVdmhdexz4_-yq2Vv5Zqpo7j7o1pFBywtkDYsLglBuJEWHOM0WYwE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL4yyFj-RszEdU4wScwBakhkSMk4S6fmgKLrUnR62dBg&oe=6AE34732"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hFz8W99B_4Q7kNvwEBtbiX&_nc_oc=Adrumbk2Ow7fuYMHmeAqYLBes4yf3wV7IIC4UTwmOiWUNNAwIa1T5vPLsOftEP3YwP8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT635xznvNf8OKemCRNc6OPdr4tPxn9YaGIrgv5VOFsg&oe=6AE36BAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdNfJRXlDWQQ7kNvwEfUYTI&_nc_oc=AdpPkGqNlce7mXrL_FwulzthoJTWgc7NHXAzAdJra7BTGEbl3UEPW8-Hov92NCHfQZk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJNp-bvdhBhp80eE9EzFpRIJ2R-clJKESiBA0QJUdldA&oe=6AE33913"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Two venues to throw in \u2014 the Training Field and Fjord Lane.\n- Fjord Lane adds a distance ladder: land a scoring hit and the board steps farther away.\n- Timed Blitz: race a 60-second clock on Fjord Lane.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.\n\n## New: Timed Blitz\n- Switch BLITZ on from the main menu; the clock starts the moment you grab the axe.\n- No throw limit: 60 seconds, as many throws as you can land.\n- Blitz keeps its own high score, separate from your classic rounds.", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374356749095006"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604275479_2262305381275121_2908255081075092594_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bfT6vP1sxAQ7kNvwFucvNE&_nc_oc=AdpwN0TkiDo-xppH_TXm7Dso8RPCf2-HUOzuaaXEzlLh8RVBqR70KW50JY3sx3uhxd8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMyVdAcgwQDbbmFuN5-XMCZx9WpkWdMP34XyKvcx8U2A&oe=6AE33E2C"}, "is_c
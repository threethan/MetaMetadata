DeCQYA&oe=6AEF44F6"}]}, "id": "1660556209022145", "locale": "en_US", "screenshots": [{"file_name": "axe-arcade-shot1-hero.png", "id": "1163447326729178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628893_1163447330062511_8989197803431640859_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_7OkaKMpvUQ7kNvwEBfm90&_nc_oc=AdrncQoeb9dBC0ZqS7cUggXeCRB_3CmGAKYon1w4Em320NJCpTAAtX9LvfhzeeqeU54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0nJo2yz8gORipOTQuLCdWdEW5PQQEYibgLm5zuz0zLw&oe=6AEF544C"}, {"file_name": "axe-arcade-shot2-crack.png", "id": "28086649111029418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_28086649121029417_5437282509902378159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRfFunQp1z4Q7kNvwFPbXUI&_nc_oc=AdpBtZJYt3HMdgVNyDzpHBntPcCCzjxBmvplexRLnX7afokjffS13kDsI-ywDIqP0Ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO3EZXy7eQs6UwrKIuR0sxOkDA6J8gHMcylmr5UHPCRQ&oe=6AEF4AA9"}, {"file_name": "axe-arcade-shot3-holmganga.png", "id": "1592386091803548", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628909_1592386095136881_7491312281703280760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k93yG-67ZxkQ7kNvwGOVFpp&_nc_oc=Adq7VR3Bu0yvGvO2cpkAdz3FWWBfFS7VG5fvVY3XW_bLP-LgjytXUnN6VIEl2FwisD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoKrOYGBQw4oxUximtpH7OpBrKwcR-vaKMk3MgNULh7A&oe=6AEF5626"}, {"file_name": "axe-arcade-shot4-fjord.png", "id": "1724378155323202", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593919959_1724378158656535_1449830462000487333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvRbBbmUzvAQ7kNvwEOE6tB&_nc_oc=AdppUT6QhAdKHNXKoc3E-_fgEF5gnrdEQSJcih3lingK2GuZYCZRRSq9CeuQpnRXLqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRICan8od_OoQTfcpAuBJTeT65dc0BeiWx65y5tRbZdAQ&oe=6AEF5CF2"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaaxtdYayZ0Q7kNvwFf7vDY&_nc_oc=AdrPgR809AlmdYEf8ia6xb8tXIzoZqGrHjjPW-BeYI9TPfAd4G-XpnaJR-hs1GEgqZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTApDmASKUMDR5qmETF5CpQSqVZwqu3bh_Nr6DRgkCekA&oe=6AEF492F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYYYy1B9zOQQ7kNvwFoF452&_nc_oc=AdrCO9gz0PLfwjEQImqKMXmhK_aLMU7SOVUOV4HRLxgHQh_S_r77QfHDqQEJbSlL-MM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcN2K1tNzUKHpZvMEHPjdfK0DHdnj40Jsyr0EgQ3hvJg&oe=6AEF4ED3"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "viking"], "long_description": "**Axe throwing in VR \u2014 how good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Three places to throw\n- Training Field \u2014 the classic axe-throwing range to learn your throw.\n- Fjord Lane \u2014 a distance ladder: land a scoring hit and the board steps farther away.\n- H\u00f3lmganga \u2014 a Viking duel ground: crack the planks of your rival's shield until it breaks.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Timed Blitz: race a 60-second clock on Fjord Lane with unlimited throws.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.", "short_description": "Real-physics VR axe throwing: grab an axe, wind up and let it fly. Sink bullseyes, race the clock, and split a Viking's shield."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1405466675984013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604275479_2262305381275121_2908255081075092594_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-Gvfw5Rp9cQ7kNvwE3VSlt&_nc_oc=Adq6jBOykp6Gw1fuZwpeYHim_ab65SGqrjRfB5eDuKNJekEuvFeQ2yliSfDD5YCBguc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu96kudSXHIOUTzEMhG5rloexPW3Vb5Kg0wq_gNSC5ow&oe=6AEF53EC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIG92dFYoJwQ7kNvwFjVfNn&_nc_oc=AdoW0Nv-9NHAQTI7IclI5bM6_xm9A_wvPmdN1nvVDQrZ_M2I0gM2dl8fQEbze1e3FqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-8VaObpGOjB2pbUkdD9XNw2fDRfgQBwP0rj_atxeOKQ&oe=6B045CF6"}]}, "id": "1660556209022145", "locale": "en_US", "screenshots": [{"file_name": "axe-arcade-shot1-hero.png", "id": "1163447326729178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1163447330062511_8989197803431640859_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrtbK8O7B7wQ7kNvwGmwNag&_nc_oc=Adr7sj_5ZIJ7wV8LPJTz8xEHy2n8tThotNT9ICtsczRf8gWcMfIz1zYKP6Q-rTrcWso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWv3PcsDlp2EvBEI5HSpEiqjSXov6CA7OW0Cm5wG9DHw&oe=6B046C4C"}, {"file_name": "axe-arcade-shot2-crack.png", "id": "28086649111029418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622192_28086649121029417_5437282509902378159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbq1aiCyYlcQ7kNvwGmJS-H&_nc_oc=AdrwN27FPXAs4sHFiS_MX9BK8FXIOFA_9bWWipHWzebcWODvkX21O1dBod6qmn7eXTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5aztrVlx6FmSq__kOQ2foxBbqosk4LzcYArhpvUwLkw&oe=6B0462A9"}, {"file_name": "axe-arcade-shot3-holmganga.png", "id": "1592386091803548", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628909_1592386095136881_7491312281703280760_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQlHClB_e2wQ7kNvwEdLcA5&_nc_oc=AdqRjpJnz7VynfEuWleycPxIXf8JB9LP8AKgUaa8wrlGt46-4xZ6GcvEpp8RPtTlkI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIsQf-HalXAGwfYHXChuKtJNx50UPMrhytfg1GHqQUig&oe=6B046E26"}, {"file_name": "axe-arcade-shot4-fjord.png", "id": "1724378155323202", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593919959_1724378158656535_1449830462000487333_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiHH0zxF7PkQ7kNvwHmzDUI&_nc_oc=AdqFnqLI0kmRC3-xCckI9KI9_mz9zRLmn2JVwBgFoUzj9LDc3XdRRU_Hg3SYP29NhaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJE9o_eo0YVmUjNr4nbGAs-wXZ8QxZDf5L3w5szArD0w&oe=6B0474F2"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eo2zpB6piEQ7kNvwELfr2a&_nc_oc=AdqNSRUD0r6GcVtV2AzxSmCQVscKRiOhnCbFmhSpf2TK_ZZRsh8vChLSXT9PmodTQF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlCkfr2V_LpWH-T-abNY5we11QkDYoMrK8jB7SZYHNwg&oe=6B04612F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhvDGWBE2KkQ7kNvwGV6ZXF&_nc_oc=AdrUZrgHzEUxWVMY5Y4xXh2uNcdvR_9eD_5xinNz7VSYUs_fLqoQNpW2o6aCvG30X3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR51tcxupjkJIYiKDEQcyujNsgz77HDEk0frha90jLD4w&oe=6B0466D3"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "viking"], "long_description": "**Axe throwing in VR \u2014 how good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Three places to throw\n- Training Field \u2014 the classic axe-throwing range to learn your throw.\n- Fjord Lane \u2014 a distance ladder: land a scoring hit and the board steps farther away.\n- H\u00f3lmganga \u2014 a Viking duel ground: crack the planks of your rival's shield until it breaks.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Timed Blitz: race a 60-second clock on Fjord Lane with unlimited throws.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.", "short_description": "Real-physics VR axe throwing: grab an axe, wind up and let it fly. Sink bullseyes, race the clock, and split a Viking's shield."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1405466675984013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604275479_226
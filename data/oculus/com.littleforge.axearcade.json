", "id": "1163447326729178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1163447330062511_8989197803431640859_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUW8vRXRJAQQ7kNvwErR7J6&_nc_oc=AdoA_8Nhkg-nEFM74JVAOVoRCahoX2KfiCNdWBwBE9cFQ3uUt-iytbTrhKkuDPIvcPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsOQKysQ-CSnpviNwRM11Nj4KJTAjHGDmQbDrGJYl06Q&oe=6AA7EB0C"}, {"file_name": "axe-arcade-shot2-crack.png", "id": "28086649111029418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622192_28086649121029417_5437282509902378159_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NboXjCkmZ0Q7kNvwGBNpnb&_nc_oc=Adp1ZEjAxVDFIGf0E4DFknARgdMmHHgNs-7B9xAxFalbH1iTC2WGUMqYBPGWKfcV_Y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXIsio8ZKi83QYTSw0EVWaEdK945HWQrAbUDtrVRkAJA&oe=6AA819A9"}, {"file_name": "axe-arcade-shot3-holmganga.png", "id": "1592386091803548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628909_1592386095136881_7491312281703280760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POOZ6erSsF8Q7kNvwH83Bxp&_nc_oc=AdqywgzQRQZBGRzU1TxwlVgoqjOWZX5xXjpYKmZdTSQSV869Th_qWrFXLLUqQql7Ilg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTOLeWPkT2hSfoXrInOc4Elm4qN_eeMHns_aLtnFXlWA&oe=6AA7ECE6"}, {"file_name": "axe-arcade-shot4-fjord.png", "id": "1724378155323202", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593919959_1724378158656535_1449830462000487333_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VT1QCFiVTQQ7kNvwHWeHp8&_nc_oc=AdraIblmXmE4dX4utW6AhfrfGBIWpf_ZGGGGLk-l9P0wVuyeGrd2pd740-R8Fgxq8aY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLRpRKVUegOBvfluu6RkTp0GXcOYa19eQptiUTIcYZmQ&oe=6AA7F3B2"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vgpfx1Hok5kQ7kNvwG-4n_8&_nc_oc=AdpMMJhdqQgNQ_9zdEHvBdkjCD3x4uemWhGsQVdR-4LzlTZKrW--c7o9ZJQ269MIVH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzmCUcz9LLX8fcvmAe7r-kU6PELpyodQCw5uzc5hGl6A&oe=6AA8182F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USb8tm9vIIkQ7kNvwF354Lg&_nc_oc=AdpcppjFB8onvsqkPgBWARORhlKrU3I7KyzfupryyD1NFIrbd5Y1bzVhzoFydjxgyNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHf8fk8Ln6v2zd0u0YOqKES8RliOv-bUWPQ1anlnclqQ&oe=6AA7E593"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Two venues to throw in \u2014 the Training Field and Fjord Lane.\n- Fjord Lane adds a distance ladder: land a scoring hit and the board steps farther away.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310210368842978"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604275479_2262305381275121_2908255081075092594_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5kQAx60Ok8Q7kNvwHCV0WQ&_nc_oc=AdqeRNnVNq56uYBSkZNK1dlRTU_AfGBQiS9amDe89a3yXqvhWlGWpQZcw7eydZhXDZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH3Swjt43ijX2nzGG9mXWwOLlU_85ctuFj37lfsjkgKQ&oe=6AA7EAAC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Axe Arcade", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1784693940, "lastRevision": {"nodes": [{"id": "1184265284770821", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp
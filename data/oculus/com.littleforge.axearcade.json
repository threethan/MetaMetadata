.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELYF-Lr1LH0Q7kNvwGpzziT&_nc_oc=AdoPAFSbe1JkcfNwV8HrY4QEgBf3Y_6Zw31VGJGDwSP6tI6E1iEEpnFqHFIT4Rch6Is&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO21b7C-rSTlH9AIo4uGB280kiBUYVCeF-J1Y2zbzer3g&oe=6ADCD42F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_4epM_aJOgQ7kNvwF3zptV&_nc_oc=AdpJQDHyFufvOvqbn659MzStfQZg1Jh3UllIFzgzj_2OGOjYNilgpRYae5Co8pfXA1Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1-CNP_DCT-in-bOhMrywowIJqoVH7QPFj748MuvXbEQ&oe=6ADCD9D3"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Two venues to throw in \u2014 the Training Field and Fjord Lane.\n- Fjord Lane adds a distance ladder: land a scoring hit and the board steps farther away.\n- Timed Blitz: race a 60-second clock on Fjord Lane.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.\n\n## New: Timed Blitz\n- Switch BLITZ on from the main menu; the clock starts the moment you grab the axe.\n- No throw limit: 60 seconds, as many throws as you can land.\n- Blitz keeps its own high score, separate from your classic rounds.", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374356749095006"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604275479_2262305381275121_2908255081075092594_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn0xw2iwl7oQ7kNvwFrLMZt&_nc_oc=AdrP5sLhY-Cd3-URqd0QY7JXEsInTPXrACuN3O177TcIta5PZ-jsCD9q1cBIVyy2Mow&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKlrKM7u9ff4v8BPILoMRR3OZbobMD_w4pPjU943NA4w&oe=6ADCA6AC"}, "is_c
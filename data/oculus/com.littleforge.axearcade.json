oc=AdqfmC0BvPE3tUU1RPW5C8LzaLPxVH81NBn7qcO9lGhdh5F5GIpdw4cEslpRS78Q5qM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLRL9rJRhDC7twGsIXgpAADVqSPVb-Id5he6n71safpw&oe=6ADE200B"}, {"file_name": "cap_shot3-depth-alt_1.png", "id": "1040915801870464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623400_1040915808537130_4781429846582066514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugTNmpIifAMQ7kNvwF303Ls&_nc_oc=Ado1FvHQ2Sx9qPxl7ilgLpa6R0SlhJzA5bP20BWVHTIqA41KmTHe7gs6L5tfBZJbx1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjyGqjr6V7UukYS5qP7vuuso1BBlIqHW7kmj8mKl-bHQ&oe=6ADE210E"}, {"file_name": "cap_shot4-score_1.png", "id": "27554383440855653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_27554383447522319_1875656870862086556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUt2YnEqmOoQ7kNvwEsg8Y2&_nc_oc=Adonikje5Yuju3csz1qV3ab7Ymf9rpXOCcZoFy4yWbaRR9SfRDYTjs3ZSwB1vLIIJWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP89MklqG-tV9hSBKfz7-biohBZeR7DcFUOrvPBalWVqg&oe=6ADE0A36"}, {"file_name": "cap_shot5-rest_1.png", "id": "1706333930584924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622211_1706333933918257_8714833817623575886_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mhdHUGs9aQQ7kNvwEwGpdS&_nc_oc=Ado7WJqp-XbOjzgj3gHEuQpMjz3Sou-92120kifdSDGmuiGoxx3S1CWZjsRG094RlFs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgq3Hy8d73nSOQHI8uXILSRK4JUqj6R_IvuLb1P3a04w&oe=6ADE1614"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_4epM_aJOgQ7kNvwHm_B_q&_nc_oc=Adq95hbZxNFbqB_Z4WMAuCLM8LecliU2Sjj2iNF0XlAk1mEJBTfC8ES0CPEsUYP3kC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNiT22SEqVbEf3rYBcJ0C7JEEfILlU0KMkQa6PIWqA-w&oe=6ADDF313"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Snap-fast pick-up-and-play: one scene, instant start.\n\n_Simple to learn, satisfying to master._", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
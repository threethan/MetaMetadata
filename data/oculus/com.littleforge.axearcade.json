cb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPOY1XThaKYQ7kNvwFjIKUZ&_nc_oc=AdrxEzoPvhatNSxTW9sfC6FJGIO210OPA1mE5pZ1-eFjKnvjGyBQVZQ8f6ZfoqSGjFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTykehBcyRaw1Emschm8YHThDNieD7IkJTTUgrIHYIfQA&oe=6B01B9F6"}]}, "id": "1660556209022145", "locale": "en_US", "screenshots": [{"file_name": "axe-arcade-shot1-hero.png", "id": "1163447326729178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1163447330062511_8989197803431640859_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tcbu-y6T0DUQ7kNvwEO3Tcr&_nc_oc=AdrWWV6A1QrafgVf4OB6Bts0q0pn6j24DZqPpAgFs_9d8dozNBlgBYBr6ubOUjiSDVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTycJD2eCH1YTIyt9qWGBUbOJ1Hl_RxYaMKgDB-iuRvgw&oe=6B01C94C"}, {"file_name": "axe-arcade-shot2-crack.png", "id": "28086649111029418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622192_28086649121029417_5437282509902378159_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbq1aiCyYlcQ7kNvwETZ09H&_nc_oc=Adr3uewKAtkYrp_7F1TyS3_5Fs8GeafUf0To9RAtZt9h6IKhhtogHv46T3AZQdCAY7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToj8dEDVDX_pHb_Gf3HJ7yHhRN3jkPL0Y1yTZ7dG3R_A&oe=6B01BFA9"}, {"file_name": "axe-arcade-shot3-holmganga.png", "id": "1592386091803548", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628909_1592386095136881_7491312281703280760_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxz7j_5C2hgQ7kNvwH1Aif-&_nc_oc=AdoifYrSDqMbDcPYvFa6iXPVnk-z4FMlsLnteRxFguj967bFTYHWnzBW7aBUp8j4GbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD-pATJ5PiKpwkW41taqaotzQgvU-NmKsLZ-jz01Wygg&oe=6B01CB26"}, {"file_name": "axe-arcade-shot4-fjord.png", "id": "1724378155323202", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593919959_1724378158656535_1449830462000487333_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiHH0zxF7PkQ7kNvwEoHa5i&_nc_oc=Adrsu89VW5mT2mi0htyf02lHUbCxWf706xMX7JmlWvjIGb-aZazTDc9pIBVn_kzuewA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7QQC9zPEfQ1ReZLsToICwnfmm4TzOF5nhR1L1E98Qcw&oe=6B01D1F2"}, {"file_name": "axe-arcade-shot5-valley.png", "id": "1607551704104069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622184_1607551707437402_4148346033697722451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eo2zpB6piEQ7kNvwFCAK-x&_nc_oc=AdoGK3yxTJtrpXjzpN23lk74jTWEr5vm6CLJzJQ0TeQY5zmfbO8WPzWihcCIWsPsNyQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRilhhl-tuBx1vV9i7U9SHHOvGQJ9XdQby92D-ITwPdiQ&oe=6B01BE2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaMA3hQ-1GMQ7kNvwFZIEjE&_nc_oc=AdovQlhE0wUh0Bx2WddjGq-7N4tM3AiiARvTC-3WQvX1tQZznHAYWcTbvDwJgAy3YSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-LU6C2cmIB6L1HQKiPZp_fwLi4BTCbMfhEsgbDXFj8Q&oe=6B01C3D3"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "viking"], "long_description": "**Axe throwing in VR \u2014 how good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Three places to throw\n- Training Field \u2014 the classic axe-throwing range to learn your throw.\n- Fjord Lane \u2014 a distance ladder: land a scoring hit and the board steps farther away.\n- H\u00f3lmganga \u2014 a Viking duel ground: crack the planks of your rival's shield until it breaks.\n\n## Pick your challenge\n- Four difficulty tiers: EASY, NORMAL, VIKING and BERSERKER.\n- Timed Blitz: race a 60-second clock on Fjord Lane with unlimited throws.\n- Leaderboards for your best rounds.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Simple to learn, satisfying to master.", "short_description": "Real-physics VR axe throwing: grab an axe, wind up and let it fly. Sink bullseyes, race the clock, and split a Viking's shield."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1405466675984013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604275479_226
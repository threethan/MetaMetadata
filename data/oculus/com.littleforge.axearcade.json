oc=AdotPQOMmcbfSvtWvCBnFIQSJCJs9aC5KGrTcJ7xgHStMSngWJ1EfFJxfIu-ENjDYyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN59oK2NbYRgG7J7pMR5MiEbHbmm3sg-yEUw5wwFmpSfw&oe=6ADF718B"}, {"file_name": "cap_shot3-depth-alt_1.png", "id": "1040915801870464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623400_1040915808537130_4781429846582066514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugTNmpIifAMQ7kNvwEuRXLz&_nc_oc=Ado8FeORSItyp1_hAFnYooT3mXnOpVWPZuAeMhWXUCC63uRPgdfJBGIR2kBlWsi1H8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpKYc3ZD8U-oAEmp216qqikr1xyZ3oOGVTgmQ-u2QDXg&oe=6ADF728E"}, {"file_name": "cap_shot4-score_1.png", "id": "27554383440855653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624983_27554383447522319_1875656870862086556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaqx2BcVqugQ7kNvwG0aZ2E&_nc_oc=AdqT9WKTzBmGsEDL5XuffxSvPn4b7QKJ4QISA2ZaEP02WC2O4HwJNw5S_szs7A4I4h8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt_Oeb8aEF3mvjEZ8SOjZwRsQeDv_4fg3yR7tGi-WhAw&oe=6ADF5BB6"}, {"file_name": "cap_shot5-rest_1.png", "id": "1706333930584924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_1706333933918257_8714833817623575886_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yt2dj7zqBkQ7kNvwHwwuVC&_nc_oc=AdqQVctt9P7blcunfiGydUJDrOzzRkeqkyhhWLhy0viDvo74erYcxuAew8McoXYpCCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS8C85QP7po05tveBg46dSnkdWLEP8dO_Lz8Pd7vYgzA&oe=6ADF6794"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_4epM_aJOgQ7kNvwFRPKW5&_nc_oc=AdpPIKW2gAbkJ0LOSdNk2qMu-16OOPv8aIJDNm_gSqp9POWVGn3_aGAz1PV8qHhTwso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5pSnuRwGmc5Dmj0SYjxGWF2Sm6FMsA6iLx1n2UNZu5w&oe=6ADF4493"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Snap-fast pick-up-and-play: one scene, instant start.\n\n_Simple to learn, satisfying to master._", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1184265278104155"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2255323051930191"}, {"status": "PUBLISHED", "id": "1364701899148314"}, {"status": "PUBLISHED", "id": "2067963204115398"}]}, "baseline_offer": {"id": "2255323051930191"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788846000, "status": "PUBLISHED", "id": "2255323051930191"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1374371312426883", "version": "1.7.0"}, "id": "2458091594617554", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1184265264770823", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1374371312426883"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2458091594617554"}]}, "change_log": "New: Timed Blitz. Switch BLITZ on from the main menu and race a 60-second clock on Fjord Lane with unlimited throws. Blitz keeps its own high score and its own leaderboard.\nFixed: a throw that lands right on the rim of the board now always scores.", "created_date": 1791537047, "id": "1374371312426883", "version": "1.7.0", "version_code": 405104, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1184265264770823", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "
zGb90fdZkVrvKRw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbGDp0MSmDLKtO-fdtudGw8x6GnOH-hhwWHKrj8gyTSg&oe=6AF9CF8B"}, {"file_name": "cap_shot3-depth-alt_1.png", "id": "1040915801870464", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623400_1040915808537130_4781429846582066514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gc6WUq0fCmIQ7kNvwHTZU9o&_nc_oc=AdqYcBUzo_-tQe8xJeOstVq0zsUz2A9pnHNL3my4TwSKXsWf0hemVKEOWnF2-BQoYuI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeRZY3h_i00JBj-odG8NmZaG_AHl7QnOQ-tBXoHsghJA&oe=6AF9D08E"}, {"file_name": "cap_shot4-score_1.png", "id": "27554383440855653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624983_27554383447522319_1875656870862086556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WExiYvD1t5QQ7kNvwHVX1-x&_nc_oc=AdqhcCL4CxXmUvEjqeeCRMeXQJe1SDjCGf075nZ8vt4Q7FgWbVadQYAavCUbr_BKW44&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2zI9zXyvG9YOaFnBAjghk-c-D6wYWZ243bL6nnlMByw&oe=6AF9B9B6"}, {"file_name": "cap_shot5-rest_1.png", "id": "1706333930584924", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622211_1706333933918257_8714833817623575886_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJHl3w6GvGQQ7kNvwGmSxP6&_nc_oc=AdrO9Sl2M999wQuVEuX4embEahQB_xHn-RQnxDtl8Gi4ypfNoArgpL2bP9ll3BlKzRQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTohAPcrWjNhPx3tU3xoDKc8yWEV9wdH5sNfDtJK7V4CA&oe=6AF9C594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AxeArcade_trailer_cover.png", "id": "1061070172992027", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604282317_1061070176325360_7984314788343204879_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty9Vu9QwQCwQ7kNvwEsJGrz&_nc_oc=AdpvbagTFjnrDjUaDcC0riyq2BtnnAryP6RSH0sn3xVzDKZ1GIAvo5hAVvHFuyibLKQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3_EscPCJ6pJ9KcMthvnxQFB742VTSw1-IdgzVRCBsPg&oe=6AF9DAD3"}, "display_name": "Axe Arcade", "keywords": ["axe", "throwing", "arcade", "bullseye", "casual"], "long_description": "**How good is your throw?**\n\nPick up an axe with a natural grip, feel its weight as you wind up, and send it spinning end-over-end into the board. Every throw is pure physics and timing \u2014 nail the bullseye for the big score and chase a higher total round after round.\n\n## What you do\n- Grab the axe anywhere on the handle \u2014 grip button, either hand.\n- Wind up and release with a real throwing motion; the axe flies the way you throw it.\n- Hit the target board \u2014 the closer to the bullseye, the bigger the score.\n- Ten throws a round. Beat your high score.\n\n## Built for comfort\n- Play seated or standing \u2014 everything is within arm's reach.\n- No artificial movement, no smooth turning, no vection. Comfortable rating.\n- Snap-fast pick-up-and-play: one scene, instant start.\n\n_Simple to learn, satisfying to master._", "short_description": "Grab an axe, wind up, and let it fly \u2014 sink bullseyes and climb the high-score board in this pick-up-and-play VR throwing game."}]}, "developer_name": "Little Forge Studio", "developer_privacy_policy_url": "https://littleforge.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Little Forge Studio", "support_website_url": null, "website_url": "https://littleforge.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
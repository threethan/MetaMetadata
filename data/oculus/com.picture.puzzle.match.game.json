png", "id": "1559755788920975", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619704_1559755792254308_6412318405058622098_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TKWoHqFOlEQ7kNvwHUWWuE&_nc_oc=Adr9JXFl0ShzOGvL9UaHQMTiuqq_4AlJElu9vRj2ogntvSHSgiQnZ6JZo1xljG-9nkw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqES06yqlDw__V4QIq6XgRyviNDD3NkefTQ7aG7VrXgg&oe=6AA17EC4"}, {"file_name": "PP_SS_2.png", "id": "947016265028451", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593915647_947016268361784_2569150052390483944_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64GNSrn5HvcQ7kNvwH6cPhI&_nc_oc=Adrq04uDwcULDy8xPd4j54Be0s2TVtLdz-1lVnerypi92P6Uw0FzxjXPbFGI6pT3zTI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3TQzwxeJMvs1bgYedeuJLITa5xRDDB7UcCtZx2f1Qsw&oe=6AA17D10"}, {"file_name": "can_you_give_me_same_202605061759.png", "id": "945712645163626", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620444_945712648496959_7407210854718174264_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9K6i_RgurMQ7kNvwHNlmIt&_nc_oc=Adq0YksbLGIOzpe0bApJfAhPUeXEuNJjBt3nwAu3djaWcMe_unJxrY0r68ulV6GH0rk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT85Chz0HsiPrwjYrJb6u3UuUBn_uaYZcInBUhcnoJqA&oe=6AA1687A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "match-puzzle-landscape.png", "id": "1188330056639176", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307962_1188330059972509_2199205947217430985_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbyAyuU02B4Q7kNvwHpilhe&_nc_oc=AdpKygzfq4QnVZcPIIpAc-AHXqSw5H6ZWbmqgeQEpJPexJ2aYICTzk_FolG1I578PlI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnuzPH0G_ZP1SH8k41lZHnaNLpwrx_o8P2oiCTJ3feFg&oe=6AA14883"}, "display_name": "Match It: Picture Merge Puzzle VR", "keywords": ["Puzzle", "Merge", "Brain", "Sort", "Relax"], "long_description": "Step into a relaxing yet engaging immersive VR puzzle experience designed to challenge your mind & sharpen your thinking skills. Match  It: Picture Puzzle Merge blends satisfying gameplay with smart level design, creating the perfect balance between relaxation & brain challenge\n{1458951995609337}\n{841026712367798}\n\n\ud83c\udfae DRAG, SORT & MERGE GAMEPLAY\n\nDrag, place, sort, & merge puzzle pieces to complete beautiful images across a variety of carefully crafted levels. Each puzzle presents a unique challenge that requires logic, planning, & focus. With intuitive, hands-on VR controls, every interaction feels smooth, responsive, & deeply satisfying\n\n\ud83e\udde0 TRAIN YOUR BRAIN & IMPROVE IQ\n\nThis is more than just a puzzle game \u2014 it\u2019s a brain training experience. Improve your IQ, memory, focus, & problem-solving skills as you progress through increasingly complex layouts. Perfect for both relaxing gameplay & mental challenges\n\n\u26a1 POWERUPS & SMART PROGRESSION\n\nUse helpful powerups to overcome tricky puzzles & unlock new possibilities. As you advance, levels become more engaging, offering rewarding progression & keeping gameplay fresh & exciting\n\n\ud83c\udf3f RELAXING & SATISFYING EXPERIENCE\n\nEnjoy calming visuals, smooth controls, & satisfying puzzle mechanics. Whether you play for a few minutes or longer sessions, Match It offers a relaxing yet stimulating experience that keeps your mind active\n\n\ud83c\udfaf PERFECT FOR PUZZLE LOVERS\n\nIdeal for fans of puzzle games, brain challenges, logic games, IQ tests, & relaxing VR experiences. Sort, merge, solve\n", "short_description": "Relax and challenge your mind in an immersive VR puzzle experience. Drag, sort, and merge pieces to complete beautiful images across smart and engaging levels. This relaxing puzzle game improves focus, logic, IQ, and problem-solving skills while delivering satisfying gameplay. Enjoy smooth, hands-on controls, brain challenges, and rewarding progression. Use helpful powerups to solve tricky puzzles and master each level. Perfect for fans of casual, logic, and brain training games in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/gammayinteractive/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "de", "pt", "fr", "ja", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27166205486384550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619697_1498655075068686_131665219264653888_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0P3c-B4iLaMQ7kNvwGBOMIt&_nc_oc=AdotOC8Im37vRmlLU-rlPiXDSOZyA2AyQs7cV9EoRuk7o7ISV7EvBWTc5CgxKolzUAM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ4h_WzkP1WwryBWTbDLv-0gVXx2dyrqId4AZn87NkcA&oe=6AA15895"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Match It: Picture Merge Puzzle VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1775222880, "lastRevision": {"nodes": [{"id": "26074382425566867", "release_type": "SCHEDULED", "administration_status
=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK72k2hHMSm3_pfHh8jL1TKSZuvadtfWe_9uY2NA-9Mxg&oe=6AA16864"}, {"file_name": "PP_SS_2.png", "id": "1600654364538941", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624983_1600654367872274_7550705358737927764_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8aYnV9IFvQQ7kNvwEPkiwk&_nc_oc=AdrIEDI1lAd7x2Vllr5SW5R9iDM62x9x0o1oTP5gj-0VeEbLolDMsPHPgNu-0E_Up5Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDQ3im4vfMucN8HoJAzRSXHNDoYOknlIHMkwBI6hi-UA&oe=6AA16C1C"}, {"file_name": "PP_SS_1.png", "id": "1700418324728192", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830003_1700418331394858_2099788363324663901_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7XRrzMyHWQQ7kNvwGIlOyE&_nc_oc=Adoclsk68otjD8xBuZUJ46o283EmhTANWcx0qbuqxoErx0xCj-Ec4R-dvLz26Aj8sK4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsGP1XS8pJllSOmeGkVAGKRlagGeeoNkA1z39iw9aEAw&oe=6AA172A5"}, {"file_name": "PP_SS_3.png", "id": "1273459378236428", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623295_1273459381569761_4840517964869142705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxBlGjX_yOkQ7kNvwEpDqq_&_nc_oc=Adrhbmo5D8RO4wEpHeN9wmNbCN9paC663VHpeD7JGINA5KtFfrNAS6h4QpDsFVYMymk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuYc4zW2ZjG3NTCHDcw2X0lhoXPUaMrof5sVdwoQwpjA&oe=6AA15051"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Match It: Picture Merge Puzzle VR", "keywords": ["Puzzle", "Merge", "Brain", "Sort", "Relax"], "long_description": "Step into a relaxing yet engaging immersive VR puzzle experience designed to challenge your mind & sharpen your thinking skills. Match  It: Picture Puzzle Merge blends satisfying gameplay with smart level design, creating the perfect balance between relaxation & brain challenge\n\n\ud83c\udfae DRAG, SORT & MERGE GAMEPLAY\n\nDrag, place, sort, & merge puzzle pieces to complete beautiful images across a variety of carefully crafted levels. Each puzzle presents a unique challenge that requires logic, planning, & focus. With intuitive, hands-on VR controls, every interaction feels smooth, responsive, & deeply satisfying\n\n\ud83e\udde0 TRAIN YOUR BRAIN & IMPROVE IQ\n\nThis is more than just a puzzle game \u2014 it\u2019s a brain training experience. Improve your IQ, memory, focus, & problem-solving skills as you progress through increasingly complex layouts. Perfect for both relaxing gameplay & mental challenges\n\n\u26a1 POWERUPS & SMART PROGRESSION\n\nUse helpful powerups to overcome tricky puzzles & unlock new possibilities. As you advance, levels become more engaging, offering rewarding progression & keeping gameplay fresh & exciting\n\n\ud83c\udf3f RELAXING & SATISFYING EXPERIENCE\n\nEnjoy calming visuals, smooth controls, & satisfying puzzle mechanics. Whether you play for a few minutes or longer sessions, Match It offers a relaxing yet stimulating experience that keeps your mind active\n\n\ud83c\udfaf PERFECT FOR PUZZLE LOVERS\n\nIdeal for fans of puzzle games, brain challenges, logic games, IQ tests, & relaxing VR experiences. Sort, merge, solve", "short_description": "Relax and challenge your mind in an immersive VR puzzle experience. Drag, sort, and merge pieces to complete beautiful images across smart and engaging levels. This relaxing puzzle game improves focus, logic, IQ, and problem-solving skills while delivering satisfying gameplay. Enjoy smooth, hands-on controls, brain challenges, and rewarding progression. Use helpful powerups to solve tricky puzzles and master each level. Perfect for fans of casual, logic, and brain training games in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gammayinteractive/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gammay Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/
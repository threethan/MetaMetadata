, nous avons cach\u00e9 quelques surprises !", "short_description": "Invite est une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle visuelle et sonore librement inspir\u00e9e par le c\u00e9l\u00e8bre Lac des cygnes du compositeur russe Tcha\u00efkovski."}]}, "developer_name": null, "developer_privacy_policy_url": "http://homido.com/a-propos/", "developer_terms_of_service_url": "http://homido.com/a-propos/", "publisher_name": "Homido", "support_website_url": null, "website_url": "http://homido.com/vr-invit/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "NARRATIVE", "EXPLORATION", "EDUCATIONAL", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641266067144511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "104134710328461"}]}, "baseline_offer": {"id": "104134710328461"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1504717200, "status": "PUBLISHED", "id": "104134710328461"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1574624269286611", "version": "1.0"}, "id": "363695034050625", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1568455976570107", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1574624269286611"}, "release_status": "RELEASED"}, "binary_release
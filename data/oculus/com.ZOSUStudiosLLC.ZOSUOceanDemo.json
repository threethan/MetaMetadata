VyUex&_nc_oc=AdorB7CXFfQJ_k5AYQWGsvRGsMCKrGlT_C14wDv4Dz-izK05GYRkb1bGnQ4WzTtQTfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkI0TouUQM2LiQ50MBaNQalqik3yFraa0QAgaGgMGOzQ&oe=6A9C3799"}, {"file_name": "s1.png", "id": "401400435212405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75330721_401400438545738_8546374817151911886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKCQsuyC_EcQ7kNvwG_j37J&_nc_oc=AdpwOqL0x1uMQDRlvXLw_J3nuDoQCOsh--c1gC2mDcEdEsu8Spd1Yi8nx4V8QjO85io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHGJHLD8yRFxoYzCiZ5WpgfGGGsfaFjcZT14cbMYe17w&oe=6A9C23BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape w demo.png", "id": "4924781397620720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_4924781400954053_2328698939837293482_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXLH3H6YXY4Q7kNvwEtRTfY&_nc_oc=AdqFJGD9nsAQva5X54Yc41MMLHo0RrjvUFzZYrjmHSUsGW8HcQyIjGU30mrdjweOeB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj-Z-hH3zYYFFjTFQwzJbvBSASalSWsg5IGB6zLFbYPg&oe=6A9C1894"}, "display_name": "ZOSU Ocean Demo", "keywords": [], "long_description": "Free Demo of \"ZOSU Ocean\"\n- 5 ocean levels to explore (compare to 30 in full game) & 2 lobbies\n- Over 100 sea animals to save, the majority are randomly spawned\n- 10 min timed scoring in demo (60 in full)\n- This is a relaxing game where you are ZOSU the explorer and you are collecting sea creatures to save them from extinction and to score points\n\nControls:\n- Builtin right hand jetpack for movement. Jetpack body movement is set to the direction of your hand.\n- Additional classic movements\n- Score points by collecting fish and finding randomly spawned treasure.\n\nGameplay:\n- Timed scoring mode, 2 minutes per level with over 10 minutes of gameplay in the demo (compare to 60 min in full game)\n- Freeplay mode, no timer and no scoring\n- This is intended to be a relaxing game and there is no way to take damage or die\n- Sea creatures include starfish, dinosaurs, sharks, squid, many common and exotic fish, and large sea mammals\n- Bonus island land lobby with climbing and level selection lobby", "short_description": "Free Demo of \"ZOSU Ocean\" (full game on App)\n- featuring 5 full levels, water lobby, and dry land island lobby\n- (vs 30 levels in full game)\n- Over 100 animals  to save, the majority are randomly spawned\n- 2 min scoring mode per level, or freeplay no timer or scoring mode\n- This is a relaxing game where you are ZOSU the explorer and you are collecting sea creatures to save them from extinction and to score points\n- Controls: built in right hand jetpack for movement"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DINOSAURS", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1172787296596428"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "802045832123316"}, {"status": "PUBLISHED", "id": "674497736927775"}]}, "baseline_offer": {"id": "802045832123316"}, "is_approve
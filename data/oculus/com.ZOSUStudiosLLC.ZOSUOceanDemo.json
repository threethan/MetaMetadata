2.png", "id": "1660069461017939", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031471_1660069464351272_872566540704407787_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpVIFNSOltUQ7kNvwHxQ9IX&_nc_oc=AdrgkXwoeygvVQNmiyQB5eg6Tkk3BY6XTGzbf54Xz3bPzEqoelkIrITtGnyDuyJ8omY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkZdlKVb9G_LxpvSqZJCizgfp1nuuI8olelDUHx7Ur0Q&oe=6B030C88"}, {"file_name": "s5.png", "id": "347670857470506", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974584_347670860803839_6994569893931953062_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Y3cR5P2NcQ7kNvwEptBC2&_nc_oc=Ado1kAMdUJZnAzoYIiT1esa1nziJPSEgjgfEN1tk9N89mAthaw6Be1bi97IKp3LDx0M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJGTcYpkN9aSYuwiF0lCa_JKw0S-SBHpy4oXiOQeUR8g&oe=6B030C99"}, {"file_name": "s1.png", "id": "401400435212405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330721_401400438545738_8546374817151911886_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elkh-zloK8EQ7kNvwFP8EOe&_nc_oc=AdqPOxSA-s1LBpCJN792J3vkDWjnAhQrzc6B70QKWaT91MQPCyDBW7UrsyuD9OmVSKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr3TIZlTj6hDWkDynBsKWoUeXGsIZNdalnG1BalWQGwg&oe=6B0330FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape w demo.png", "id": "4924781397620720", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_4924781400954053_2328698939837293482_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svNaBM9qS6cQ7kNvwH7qDAc&_nc_oc=Adq84Of0MY8H5Zg6OT2k6nlthhASrrgozMc8NdjXBY8J9Fvh_gnrM04zn_1rZT4eucQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYtuec5GrPq108SJDZtg3AISW25Pzz1LnTcvs1IqFy2w&oe=6B0325D4"}, "display_name": "ZOSU Ocean Demo", "keywords": [], "long_description": "Free Demo of \"ZOSU Ocean\"\n- 5 ocean levels to explore (compare to 30 in full game) & 2 lobbies\n- Over 100 sea animals to save, the majority are randomly spawned\n- 10 min timed scoring in demo (60 in full)\n- This is a relaxing game where you are ZOSU the explorer and you are collecting sea creatures to save them from extinction and to score points\n\nControls:\n- Builtin right hand jetpack for movement. Jetpack body movement is set to the direction of your hand.\n- Additional classic movements\n- Score points by collecting fish and finding randomly spawned treasure.\n\nGameplay:\n- Timed scoring mode, 2 minutes per level with over 10 minutes of gameplay in the demo (compare to 60 min in full game)\n- Freeplay mode, no timer and no scoring\n- This is intended to be a relaxing game and there is no way to take damage or die\n- Sea creatures include starfish, dinosaurs, sharks, squid, many common and exotic fish, and large sea mammals\n- Bonus island land lobby with climbing and level selection lobby", "short_description": "Free Demo of \"ZOSU Ocean\" (full game on App)\n- featuring 5 full levels, water lobby, and dry land island lobby\n- (vs 30 levels in full game)\n- Over 100 animals  to save, the majority are randomly spawned\n- 2 min scoring mode per level, or freeplay no timer or scoring mode\n- This is a relaxing game where you are ZOSU the explorer and you are collecting sea creatures to save them from extinction and to score points\n- Controls: built in right hand jetpack for movement"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zosustudios.wixsite.com/website/about", "developer_terms_of_service_url": "https://zosustudios.wixsite.com/website/about", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "http://www.zosustudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2
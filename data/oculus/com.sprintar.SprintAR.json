culuscdn.com/v/t64.5771-25/75221329_485567581202966_7216966660408626414_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcFEYNIIkqAQ7kNvwFLy6KH&_nc_oc=Adr19h2aOsdjSL36GM-gMY6paBqo7VncCP1RErNpdORzrlszhperBo-8op6sTNc_wbU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83wwasM7xSRORFASn-_emjT4656QFcUOmBonmUI1DHGw&oe=6A395168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1116681196788883", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982477_1116681200122216_6236613464184975156_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9vTgjxohXQQ7kNvwFooErP&_nc_oc=Adq9_FQ1X5txcqLTHzquGVS7GpkE8zNGbw_7SLaqQy6f6Gvkarh9VUKdNKrziAhGe6s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tHdoRNZ_NR-Fy8xFrMwQVb8JQcNtAE5U03HUnpk3EEQ&oe=6A393596"}, "display_name": "SprintAR", "keywords": [], "long_description": "SprintAR is an Augmented Reality training app.\n\nIt lays out different patterns of training cones for sprinting, football, soccer or basketball. Automatically records lap times and shows a **ghost replay for you to chase!**\n\n- Never measure out training cones (witches hats) ever again!\n- Never have to collect them back up again, either :)\n- Includes many different cone patterns (no need to research them)\n\n# For personal trainers and coaches\n\n- Impress students with the latest technology\n- When running, students see a guide where to go next\n- Forces students to go round cones properly\n- Optionally use soccer balls or basketballs\n- Designed to quickly hand off the headset from one student to the next\n\n# For students\n\n- Chase a ghost of the best time!\n- See your time instantly\n- Practice multiple patterns, in the same space, with no setup time\n\n**SAFETY WARNING: never expose the inside of your VR headset (where the lenses are) to direct sunlight**\n", "short_description": "Layout different patterns of training cones in Augmented Reality. Automatically record lap times and show a ghost replay for you to chase!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kennardconsulting.com/sprintar/privacy-policy.html", "developer_terms_of_service_url": "https://kennardconsulting.com/sprintar/terms-and-conditions.html", "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "http://www.kennardconsulting.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9269348223129463"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1547321422990338"}, {"status": "PUBLISHED", "id": "742320561832870"}, {"status": "PUBLISHED", "id": "1507060988091102"}, {"status": "PUBLISHED", "id": "1873373340019660"}, {"status": "PUBLISHED", "id": "1067317915593530"}, {"status": "PUBLISHED", "id": "2952639801550410"}]}, "baseline_offer": {"id": "742320561832870"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1547321422990338"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25236084506029246", "version": "1.2.4"}, "id": "872849961670915", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_a
arning journey into nature.", "short_description": " Learn and explore animals  in an interactive VR learning adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/2b3c73fa-bb74-420c-b864-a76c1e75148b", "developer_terms_of_service_url": null, "publisher_name": "Arabtesting", "support_website_url": null, "website_url": "https://arabtestingai.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24235433952749827"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312263_1416555029454132_4326099438247608704_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLqUdf8KXkoQ7kNvwHMeBTA&_nc_oc=AdnGOSjRJKTBtq-faQptjpzcFck79N6P_A3jyi8iRbubEHgf0c8L0W8S4Rf4F5_65bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afse2yO-Cjxe7TCYFfxBgDMQuyfkFIWZxD1wf2OvDTojtQ&oe=699F0066"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Animal Park", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 175
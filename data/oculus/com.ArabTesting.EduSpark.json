"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825050_1472755027408909_8708473875881156920_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcT9UWWkb4QQ7kNvwEgZj5Y&_nc_oc=Adros1e7xxJAZCXwhdyjlAHFL4E_eH1-HBtnV_cFw8uGWpOtaOa2rXb6TKVFwRwVTwk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW1AiiYSDBuY3dk9K3fWUWtPCnVsD59iR8PsaLgxaByw&oe=6A85875C"}, {"file_name": "screenshot_16x9_2560x1440.png", "id": "1303500541491048", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507829689_1303500544824381_7059597048519738671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KUvQHgNxB4Q7kNvwEAY0JU&_nc_oc=AdofwhkTFYPa0t38_lVC0n3luYJPIZy_iU0d2RVQ7oeBvlUE_6_N3Q9KDf2gH3qjbD4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIIjhrFtcMIFxVHrFJvoLpffb9h-ThjNKhP-4EYHOvHA&oe=6A858856"}, {"file_name": "Screenshot 2025-08-20 153643_2560x1440.png", "id": "768308805602633", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828806_768308808935966_6471773822674033814_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0gIaWHfg-wQ7kNvwHV8FAM&_nc_oc=AdphmK6HnCHUTKPcSLVH-NNvES_4GCg4eJBQyytTErHJmnA6ozQC5hPs5qIhNVosYhs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXKgyak6Ob-Tv5hdP5rEnd_TBeIMI7CrC4oyz5jPG5Ig&oe=6A85A76E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Animal Park", "keywords": ["Zoo", "Animals", "learning"], "long_description": "Step into a virtual zoo and discover the amazing world of animals! \ud83d\udc12\ud83e\udd81\ud83d\udc27\nThis immersive VR experience makes learning fun and interactive. Walk through different environments, meet animals up close, and learn about their sounds, behaviors, and natural habitats.\n\nDesigned for learners of all ages, the app combines education and exploration, helping you understand animals in a way that feels like a real-life zoo visit. Whether you want to explore freely or follow guided lessons, you\u2019ll gain knowledge while having fun in VR.\n\nPerfect for classrooms, families, or anyone curious about the animal kingdom \u2014 this is not just a game, it\u2019s a learning journey into nature.", "short_description": " Learn and explore animals  in an interactive VR learning adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/2b3c73fa-bb74-420c-b864-a76c1e75148b", "developer_terms_of_service_url": null, "publisher_name": "Arabtesting", "support_website_url": null, "website_url": "https://arabtestingai.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24235433952749827"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499312263_1416555029454132_4326099438247608704_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyWDsFpwBawQ7kNvwF6cdnF&_nc_oc=Adp3_ULIvvAK4NoY4fy1JTD-rxm6lYcTf5tBEjL7drxhf2hkuWOoxgc91O17-OhtBOc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETXsS6SAWW0idf4rgF0dAoeGLJ2mKBMh-WmUFHzGYgYQ&oe=6A857EA6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Animal Park", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name
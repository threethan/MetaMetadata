_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSoYkww239E_Dam5WU5lCbJxmQ_yqgP2lojAPzbhiGGg&oe=6AA01E46"}, {"file_name": "_1.png", "id": "1489553553201786", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623370_1489553556535119_7708937185418211224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoFNabrhpa4Q7kNvwEiLHWY&_nc_oc=AdoZYtsD5ytSkMGiRIeMvgTgT1izpmZQYLChavy5FH7723NymrptFbHjaahurj2xCD0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwwjSys6ZRXDWsxObvtcZYEouR-n1iis2vyL5P-OhcFg&oe=6AA013A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "_lanscape.png", "id": "4464194967182828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623443_4464194970516161_1147042548569381921_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSfvQvVp9p4Q7kNvwFtrGxf&_nc_oc=Adpd9YIudOpaNhN0nWdAd3mr0WGjCLq-V_ZywgVxjIt004WPBoZzHxelXfEiTx2DZBY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuhzZmvjon61yEMT2cDUf_2E211VC_A09nA5MG-xHb4Q&oe=6AA010E4"}, "display_name": "Tempoblade", "keywords": ["Rhythm", "Cyberpunk", "BossFight", "Synthwave", "Sword"], "long_description": "STEP INTO THE NEON GRID. FEEL THE BEAT. DESTROY THE BOSS.\n\nTempoBlade is a high-octane VR rhythm-action game that combines precision sword slasher gameplay with epic boss battles set in a 100% Retro Synthwave universe.\n\nEquip your dual energy blades, slice through waves of incoming crystal shards synced to pulsating electronica, and face off against colossal cyber bosses waiting at the end of the track!\n\n\u2694\ufe0f KEY FEATURES\nEPIC RHYTHM BOSS BATTLES: Don't just slice notes\u2014fight back! Every track leads to a massive Boss who attacks with dense crystal barrages and energetic patterns.\n\nPRECISION CRYSTAL SLASHING: Master directional cuts (Up, Down, Left, Right) to shatter incoming crystal cores in perfect sync with the music.\n\n80s RETRO CYBERPUNK VIBE: Immerse yourself in a glowing synthwave aesthetic featuring iconic neon grids, wireframe landscapes, and pulsing synth tracks.\n\nUPGRADE & CUSTOMIZE: Collect energy shards from defeated bosses to upgrade your weapons and unlock new level tracks.\n\nTAILOR YOUR CHALLENGE:\n\nMultiple Difficulty Levels (including HARD mode).\n\nCustom Modifiers: Toggle No Wall or No Bomb to hone your skills or maximize your score multipliers!\n\n\ud83c\udfae VR ACCESSIBILITY & COMFORT\nDesigned for Meta Quest with smooth performance, crisp visual feedback, and intuitive Touch Controller mechanics for zero motion sickness.\n\n\ud83d\udc49 WISHLIST & PLAY NOW TO CONQUER THE CYBER GRID!", "short_description": "Slash beat-synced crystal shards, dodge neon hazards, and conquer colossal bosses in an intense Retro Cyberpunk VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "914586098375749"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "977881705325169"}, {"status": "PUBLISHED", "id": "1936911140340391"}]}, "baseline_offer": {"id": "1936911140340391"}, "is_approved": true
10479206495275_5669032110070149230_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zalTijKIlzoQ7kNvwFPWqwz&_nc_oc=AdrgiG50vUctwdBTHNrJ045L3kJWHWQ8ejnMYHKwsGgmWrQ5lRW3hN8f2FpZwrLdx5A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1H919hJL1pvZQH4_uyg0Rc7t1ud5u7s7LjlsEXtyJvgw&oe=69F2089B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RS_D_coverImage_re.png", "id": "1220931218884627", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974895_1220931222217960_7548341215206180664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kVi1OO4oYYQ7kNvwHhEsK9&_nc_oc=AdpDpKA6x5ThB0COK8D6ZHOSXvnFMcmtTtqLIs55Jac5FItic4_kvbQ4cvICI3VaRSY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cXT3MQbAXYkPW9YwV8ZkUhtOanwZj5puitmWrY5zvRw&oe=69F20315"}, "display_name": "RS-Dental", "keywords": [], "long_description": "Important: More content is available by registering an institution.\n\nRS_Dental is a VR-based intraoral/extraoral radiography simulator.\nWe provide an environment where you can freely practice radiography without exposure to radiation.\nThrough independently developed medical imaging processing algorithm that generates radiographic results based on CT image data students are able to view not just predetermined images based on the shooting method, but actively generated radiographic results depending on the precise placement and angle of the camera, film, and patient.", "short_description": "This software is an oral radiography simulator. "}, {"images": {"nodes": [{"file_name": "RS_D_randscape_re.png", "id": "3610588972490015", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035320_3610588975823348_987957562554367315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCtg74S4rbkQ7kNvwEBuUSi&_nc_oc=AdqHsoHXerDuHSqwe7cymAyXO9KowO46L8yPNaV-JEq3f4shkcE0FIR5WFD8B6mGhAs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3JH4kRBoIQ6uVrbrLVrMLIkqbQOubxuea2KetGA
69032110070149230_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUYpMfHLNKUQ7kNvwF3kOd_&_nc_oc=AdmPICRtGMGmDlv-To2_oCbxIdQfdzDI__3kUNKHjL4hUf6n0hegSB1FGjeQhpkotLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsbCDhSgX5bK5KGzG7nShIQiAhs8krzZsNcxjVDTS20pw&oe=69A6E31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RS_D_coverImage_re.png", "id": "1220931218884627", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974895_1220931222217960_7548341215206180664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A9U3eVOfl4Q7kNvwFQEaw5&_nc_oc=AdmOQ3Zdqq6bgpv3BnGsrvdKbxscqbhhpbi8sHTOd1qpARxB8zJDM-zKQUJ873VVznM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqFKAgJFKhT_ZFvS2Y_NDcv4Z0vXsiehhRHXGep1ly7w&oe=69A6DD95"}, "display_name": "RS-Dental", "keywords": [], "long_description": "Important: More content is available by registering an institution.\n\nRS_Dental is a VR-based intraoral/extraoral radiography simulator.\nWe provide an environment where you can freely practice radiography without exposure to radiation.\nThrough independently developed medical imaging processing algorithm that generates radiographic results based on CT image data students are able to view not just predetermined images based on the shooting method, but actively generated radiographic results depending on the precise placement and angle of the camera, film, and patient.", "short_description": "This software is an oral radiography simulator. "}, {"images": {"nodes": [{"file_name": "RS_D_randscape_re.png", "id": "3610588972490015", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_3610588975823348_987957562554367315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9Rnj4qQZAcQ7kNvwGlxPBr&_nc_oc=Admq8ttejo-mhQTTluREoUr6brirg_UPxISfDGsdQPfkn6MExSgus2BFua05D-ET4O0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftbrwjn8WHwZfFghrWVt3j7XmNwDvXCXD0SKrll04n3-g&oe=69A6D431"}, {"file_name": "RS_D_Ba
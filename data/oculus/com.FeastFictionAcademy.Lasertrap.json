at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlN5OdKDZi8Q7kNvwFKqnZt&_nc_oc=AdomiSSvga6vSP6JFl57G2au63Byo72DfBNuFqnJP8VkjaFcqkorgaXPo0CXfZ_km48&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiudpQ2nDR7oD4QEwEGae7Yjp128K_x6dS81zgasm--w&oe=6AFF10A7"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-U5hcPhkcAQ7kNvwGznq2-&_nc_oc=AdqICn9csRImF-qdaAtr83sZ_MaiaSi-Qm3RUckmXVrUzFCLBhJ38aZ0Mk6Ger6lcBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYFH8MJUC_qlSxg28PbrpwGpXgx3D4NchIIYeI3bZ5lw&oe=6AFF12E9"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RfFiM56wxIQ7kNvwGslph2&_nc_oc=AdpgYBS9lAdmkKmoKEBGELGavR71E3gAUXBkCp3Coy43fQQJoAT5WHusPX9Nk9tAL8E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiK8Bz-6p5K-2-1bclXxwZpuDYcm4MEXQvff4ZH-XGbg&oe=6AFEFF88"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5SQsoxQaGIQ7kNvwG3rITi&_nc_oc=Adolxl-46ZMRltsZ5DMXFG1ykXuV-ejgAKdsclSKBYd7ru8y18PZwy4E9ZVCQTXe_po&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDqbMDlpVhRJQaLftBdgsgmj9eS6lyJgIDW6Ey_2EuvA&oe=6AFF0351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqaCSaKehnQQ7kNvwGgN0l-&_nc_oc=Adq9NVMSWedo81KGjkcGfOsCDknZobUjA8Da7jpQQTr5mlcvbpwuAeSmxZN9BK19_RQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwWkkaFFk-SAF6NgAwT5KAA1G0eaqdL3kz1td7_Wunxg&oe=6AFF0710"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
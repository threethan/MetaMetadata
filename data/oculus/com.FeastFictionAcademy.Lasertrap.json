m/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=426WAw86KXoQ7kNvwHDQYz_&_nc_oc=AdqtW3yLR85J-MU5k3qG2F427XRpXhi-mwA_emWArxBzM2Vgh3dm6r4Banmd3RAyJNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_yFWs03m-0aOfKe1IZoawfXSiTTcYaffbAeaert206g&oe=69F75388"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4ORutXgo6wQ7kNvwFLKvbc&_nc_oc=Adpxim6l1ovpVaxCEOaPn1-5BxXdWCOkwtHcHiE3yU0xSRMBNq8A-OV7d9pdOLP42zw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1G7yv6DGJs9m2fZ3ZE6NqN6Qcb0iY4YCAgQUH_AbGr2g&oe=69F75751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOb6sPhXP4oQ7kNvwEJYOki&_nc_oc=AdqdgJjA1obF1MwRV0t-xI2vYl5bE-1Thx1Bw-LMR5mifeNAoeZVD4yJOgKTSs-yqYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Njmy-qqD8TXqJ4RmMTCnrlRU_H3N7x3oMchr6uZRVjA&oe=69F75B10"}, "display_name": "Laser Evader VR", "keywords": ["Laser", "Puzzle", "Trap", "LaserTrap", "VRLaserTrapGameChallenge"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a 
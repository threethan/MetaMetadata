, "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDSnNcDGAjAQ7kNvwHflkBf&_nc_oc=AdrVEQnjPypxHswqb8Js2ka7yeZseVuX6OYUQMIdcnBw1-ZZ8euPD-OEP0JtJpuhSbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqyEDjTPx3rzolaancqcs7XM_d-YXnZALhU3QQjErToA&oe=6AE4B4E9"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wi01W9jgcoQ7kNvwEHjWMn&_nc_oc=AdqVFgI7UoX5coJhuqcajac0ufzeACyyPSk4wUF1a4JIHEaEgZIXWutpcB3MKTzo8t0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMoy4gO1RdaS9kp43dDF6QETy2VPvK4wPjSGJ35OHcJw&oe=6AE4A188"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giLBu9QN5GMQ7kNvwH6wKr8&_nc_oc=Adq24rauyvvmT8HHGfTVIkbm7jY0Zfh7rn5_YbDecdvb3WNZdztdivySbGoTDwyMneM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsfqc3NIX96FUllVL8wBcVYkRksMFFdy93XAfRDW-2oA&oe=6AE4A551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQzaWu1m29IQ7kNvwH1b8tG&_nc_oc=AdoEMSj_Y2r4zGco2Lg-PQV_fD6a25KfL5WOcLjT59rYmxe088SjERIWi4z3cEU5ehI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK6Mq2xmB5cUB8s6-IUpj1OAi4rKXSXawURZdAwIV1BA&oe=6AE4A910"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ST
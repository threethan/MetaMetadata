at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeYcZkhOAYkQ7kNvwEH00EO&_nc_oc=AdqZ0p2kHEybeju8XS7oSDt74VPmDWMAM5OmmvVjsd1dZQRbKHcwKaSQ9ZjqBv78Gyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIJ837Uw7wRo5LTkNb5a0nOv4bkQ6TBoZsfDqymiVhEQ&oe=6B106C67"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmUcJ_dw3bUQ7kNvwFyNln2&_nc_oc=AdqldaLxYsWn-0fOcIXTO66dn2ac5ZjD9ymL7bcScyxNpoN38QoPp0517XtVYn4IJI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJCFGez7APTXIInX2-ThGkFYPRidNvyJzAFLWvIZeNBg&oe=6B103669"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sft3gkoaOn4Q7kNvwFuSBAI&_nc_oc=AdqdjUiQLwokYxj8LqsGoJEm2_h1X8TlVXcMHQTzNZa_2e77U_BIB4lOpXDUXcBihTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVw5f5uOA3g48HcUmHrguU9tkYdWIdO1pWLpWyBfPFbuQ&oe=6B105B48"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIyJnF2kZMUQ7kNvwHL-Upw&_nc_oc=AdpkthBqhNOiSeRP20I1dEzVgKwGBAicGqObaLK7eC2xI03Hk0U87ZmoUQXeGBw7viQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV3PpimLL2JLxvnr9y3SUR5SkyLJqCN936YlwqWzZ1kBg&oe=6B105F11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iscGXnB1uIQ7kNvwFs66-N&_nc_oc=AdqcBTfajq5k4-fULJF-AqGrmvvoQobHAe_ovVG4H9fW9xK7iyi_oFpMcVnX0hoHWh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvdjrpuEShTjrfRD6kX-SND_tp9fYZ8dPkaDPMg2J7Qw&oe=6B1062D0"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
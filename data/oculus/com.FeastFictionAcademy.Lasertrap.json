at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwKXKHsVhvoQ7kNvwHiTr3Y&_nc_oc=AdpRyrZccNDCI-og80RqPVxjqIs2460eWbDkqXiSl2NEb_vwSVDl3TiV3jN8KmkCHU4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCEbLq6lvajtUNhBR92dE9VJV0Uq_ZDMYMC30wazyaBw&oe=6B099CA7"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwFwzdlDvaMQ7kNvwGXTUJ3&_nc_oc=AdpUb8epexOwvb2sG4rdaVCmxnylDutxAEyFvDTHJ6P2nQpOTCdRULBdVOjIUuF5SnI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrcQJ16ttaEzm3o5aEK_KGAx_1x5NtNgKG1JWc_BGypA&oe=6B099EE9"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0j78EaF_NQQ7kNvwHlU-oR&_nc_oc=Adrydj39ir4fG9wvaO22nb90P2wlASvVDc_REZQlyaeKxA9wIymp3CvPwUVwSKKwsmw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNz4tUAlqCBkdGf84gOOM_CUc-hvO2Tw23bk4vuAAi1w&oe=6B09C3C8"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F4VmEPpMQ0Q7kNvwElNyKQ&_nc_oc=AdoesUc3StVwappdBDn64ICZgZPFyKGw5A3-0W8a14aML8ncQmLNI43hC8IcUnn5xbA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN7WFaX_idrVCjQj1nKAVAMl0QKcgmT6_B_kAYTyAYNw&oe=6B09C791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CU5CzHtlyYQ7kNvwH2HzMU&_nc_oc=AdrhvOK1b2i3FxIcNp2nsW8xAl7LS3O67JsMtVE6T-JW6RDvlJbSqvewaxqN_rxS66U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTocm00fDEM7tgVtRVyGxT5ioc9tvNKGFMY5MzjjYQ2Eg&oe=6B09CB50"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0VTIE0W6f4Q7kNvwHDK3KU&_nc_oc=Adpy704vnnm_FlUWmnPlW8CeexCA6xztHP8psgpFszJPZruKpOgnnHRgbuQxCNGSoXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfHHCHOVVcw1ZEUPXcgiivwKh1a054f7rWW_BuYrhRiQ&oe=6B030527"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgC8gFKjy4QQ7kNvwEEb4Gb&_nc_oc=Ado0BVLVPZT3E9XyJ7DorXkZisti6Xf6ZPSCFqHpK87DTyY0GBUfmazMcVLZ6RapoGE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpFhLXF10idqJv2OorQaguiVQbnDJ_ktfqAnhciY0GKA&oe=6B030769"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djEUFx518UEQ7kNvwGY2X--&_nc_oc=AdpCHUnuuQdaa4gq5LWNIV2JLA50-gQhGoikimwYe6g8iv8YoNCgYKR2AW_EL3iuiEU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwAaMkpiE7c_9CdbqPHwmeBSvIXfTni14PwuT3txmOaQ&oe=6B032C48"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gv5Od7dfaIQ7kNvwFIIXl5&_nc_oc=AdrboZyzJ5tsy3kYiiLsb-Pq5V2pXkbE7xCKmetmqct1A3HLI23od1mS4bXqOFpuo5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFbd2MOPiXALIthVGYZKF7VKRNhanfo4JaQmaq6VoAjg&oe=6B033011"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJt7zSu1d8IQ7kNvwGuMJWM&_nc_oc=Adrq41dFEgggMnnYPdupJ3FUhO1GYI9-tvfzO4j2-6CH7rbBtsOjB9rWsDmY0kjHS20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI91aSpUHxtlRCQqD5GD8K1gxacvrLdnvxlSdtsJVsYg&oe=6B0333D0"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
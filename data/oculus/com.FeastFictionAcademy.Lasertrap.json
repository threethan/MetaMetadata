at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlN5OdKDZi8Q7kNvwEFhLDq&_nc_oc=Adp2QEVwhK0Th_k0ey0gusG00_541X_WTkhmFohh4nEd7LUSg2oa-NRnkzWc3gbKx68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTygqc6DWk_DfBpGNPcKtidOnJHBDY9khAiwD7Ql7gVuA&oe=6AFDBF27"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-U5hcPhkcAQ7kNvwFGUlwD&_nc_oc=AdqHPwX2gHMRH316GH6ROq57m7qUMUXoDTQ6b_7PedbBTP1F9LeD2MeTuGZjkYM7Tx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF2iwehFGPJmPIDB2w2_Q98PdGnLSR8ESxoYm7bVF_mA&oe=6AFDC169"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmpDIdV_-lAQ7kNvwF8XIMs&_nc_oc=AdqOGQ5EaKpdA_qgZrTeAwZ34reDLE6pjauAJiVLZ0NRQQvuCFsJ1ZAFAUy-mDPf1Lk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqYRP_qFowzpJyldYXMyqjBYvDOU7VgCFec4WzawAn5Q&oe=6AFDAE08"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5SQsoxQaGIQ7kNvwG_K0q2&_nc_oc=Ado3wKwy-ejET8f0WdzWPZnWrThvN1jeRJxhVWh2gxf7RQZ59l7RhpzteMaClH40qKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiZZnbMaRH43Ky37KPJ1H89vSjODuawx5ZtgtmoF91eg&oe=6AFDB1D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqaCSaKehnQQ7kNvwFkKAXh&_nc_oc=Adp43kLiitm4_RRbUWmhyRtmVXoH2g3Y_06-MzG99jM5PqiPvYxEQsMD7MJZGPulY4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb1b2ULXLz4BRfD8ey7gFhcZiQhvrvkCWF_eqGQJaoqw&oe=6AFDB590"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
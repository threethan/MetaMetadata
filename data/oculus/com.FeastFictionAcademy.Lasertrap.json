at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb1bPz6A4BsQ7kNvwFaiWtK&_nc_oc=Adoqc5cjzMlonzBeZxodw3JTtxBCUbCkEFD5JGTKQu8jcCnqMXubPwVrIZ4pdzrP_ik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3xaexaIXYc6VUbQ__QAA6yBKW_cC2AOjbubXbSTT1yA&oe=6B05A827"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1avywnSVOsQ7kNvwGw6VXi&_nc_oc=Adq9cV9N3FbkwW5YtcYsl4LVYf0UBP678Hs4FrsrEdVwNF9-wHJCEOMzsQhw3VpBn9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOAze1cX1dqnM214yW7Fpf826dvUP5Grrywdo--R4fSA&oe=6B05AA69"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djEUFx518UEQ7kNvwGJs1Cz&_nc_oc=AdqwYJxHZ2aBQYmiWCCDNytOUZs8AA9JlwAJW4H-dvx9EmZJKLJyHg2gpm7p6lyf8Ko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiuGUrrob8FUu7F_DJZchqvMPMHhJk0oLPI5AG39HswQ&oe=6B05CF48"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV3mK1stQIUQ7kNvwECac0U&_nc_oc=Ado9dJaUNylOORmf5oUGYYFz6wC-5ut8lnhvldJRnt63HFZcI9wvKLQUp9eSbBxaxiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7uNyDpavOgZ9RJOeKXdNdt2TPZC_PJ9Co5YHU6X8hHQ&oe=6B05D311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYkoVmoDDxQQ7kNvwGrkrdh&_nc_oc=AdpN2zv98cx2PT3yvTnFid4xcf8THiR262kybF6i-eIeDbfefkDGO3LitxuOk-sC51o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd8BHk3g-RCLMvs36G8lxG9qmFND-8hyoHu99yQk6ZjA&oe=6B05D6D0"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
m/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQcIuvzT1lMQ7kNvwFaDEiY&_nc_oc=AdrXCpGjTxWQNoufCkdlC3jHyjQfP6yu-JuAaJCCh25tuVYet6GlLARBKE_gqRKeYPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jYOPTLl8NlI3trmPhg83GlSurTfBI9QkBR37FYtblaw&oe=69ECC788"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ya0rPDnnzjcQ7kNvwEtVlwC&_nc_oc=AdpzV-4kk-1in4qL2u3mDl-QXqwrMWQXmO3ZQIHWeY7bdxalFI2ni5uD-Yt1TpTsO-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VpmDhtQCHyLg8o5OVyDalEr-G9XBO_RgxPsBEwZPeRQ&oe=69ECCB51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euWoJ6iFiIoQ7kNvwFU5dPH&_nc_oc=AdrVjxD8LiEo0LNI8KjhYJM6enJtEGcPQU-LM5G3orvvZAQomCaDgpX4Hcd4EBx9cB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yFbX-JDz4pS9o4Q7zftDBfioBFtF_L8hn2CiXMR-nJw&oe=69ECCF10"}, "display_name": "Laser Evader VR", "keywords": ["Laser", "Puzzle", "Trap", "LaserTrap", "VRLaserTrapGameChallenge"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a 
m/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dyYU7kyTcQQ7kNvwE6tmsf&_nc_oc=AdqvFGC52efrpHmJy6o44_oJKu9viDuDDp-ahxizaZW0XklANbufqxdpzCL5VsIurV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Nhpr39fJZUL1EraYA_dJ9aH8lU6gp-TqZabPYf2nL5A&oe=6A0DBD08"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDdZRiu7NH8Q7kNvwFOuy5U&_nc_oc=AdqtOvcsdBfurM-zHpIPJphGsx1bNkD0iORMSvCpH5zAqdBp1TR8aMWlxC6mz8IsoHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IzclxEoImSon0K71Mv0IxKb9z0LxHuiBcJ5z2yg0wKg&oe=6A0DC0D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPr8LSdo210Q7kNvwE1Zz-s&_nc_oc=AdpUuwgDYPhQhqKGlGgnXt3kQTexEpv6qEzyxjZDu_RXUiWoBQ1v60zv8UK5AeFfKGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x9OIARsVKoMVhL7M8GAlZgbNyHXCG1kExJQhsOr44wg&oe=6A0DC490"}, "display_name": "Laser Evader VR", "keywords": ["Laser", "Puzzle", "Trap", "LaserTrap", "VRLaserTrapGameChallenge"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a 
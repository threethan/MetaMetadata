at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSuf0t9Y3MMQ7kNvwFdYte9&_nc_oc=Adq1YqBV1VTWfl9kT3uhkCqAR0oDszP86ut_HvxQYKccOilX9rcJhNIxOhPOdrcu8Nk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxLstptPhl2C6stbzecS7QiKcXbKXotk9r_h2fzwAzeg&oe=6AFB1C27"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXs_JujrVFoQ7kNvwFqdiFh&_nc_oc=AdoquJJ4wJHvz-vTWiKmC-R3KVDgeACBXnJftp-aBchrZ931pUHhI4WqLrIbE_NRFPI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjHwLaYvrxdYI8kCGleE1yRtr36RsuE4fXqXenAk024g&oe=6AFB1E69"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmpDIdV_-lAQ7kNvwE3nyZN&_nc_oc=Adp0C4E3x8eVNiTxRgdd-byiCzgC377tQP8fmJQqOTibiN9-3G4DQ3l44Pz9G2cQp80&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN6sMyDhgvovkPmut_PBWOkdxJgvl0MNH9NcnsVJ6KzA&oe=6AFB4348"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk2s1FANSl4Q7kNvwHdDbh2&_nc_oc=AdodQN_1CHZSWFXtOoQJHc4gh-ruo7octWHdbWlnjcLL_aGcw41IUmi8D2MTvCmj04U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNAhCn_CTA0vXvIk5Uoxi-TraHKvBlJSHYaq7LOdNVHA&oe=6AFB4711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEd306wXhLkQ7kNvwGst9BH&_nc_oc=AdqX4RTqZkg-OQ2wGyOuwaluj_vlGBEVoEZs6skNKK-IbhBQzyk6Tu_qh3ExJS4WrSA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS52lixF0Qsnu95l3p7TdM_bSe7Rm285QVEhfesWMIig&oe=6AFB4AD0"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwKXKHsVhvoQ7kNvwEc5Zeu&_nc_oc=AdpgFGlAZDUYOy3bHf6Qi-MupwnUUQRrqoaEhzr2G8sAhIKF0VjLkHPaCU49ZQCPr0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRW151_DQBTEDFuAoYrFB66_TQHXTQF-bFhDFRZtMBfpw&oe=6B0C77E7"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwFwzdlDvaMQ7kNvwERw5Wf&_nc_oc=AdogCcIPmiiTxuBGNXl3R1yWowoOVSqxP61wWPSzYFHK9FRmbGWq1WzCQLDwpWGk558&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDMhGB5LYZF_17Eg3EoqR8zOESeDT6Es3WV7XCUgtHjw&oe=6B0C7A29"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgWEz2RK9W0Q7kNvwFcQxHx&_nc_oc=Adr9cuSINvmySNGw7PHnF1fxsf9WPrmgq1lP-1oHoe88XN_zor2sOjd6aclLe32vn0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKvQG68UBdbk1wOFdYmz5_XZ-2cxhR2Om923sHvTuANQ&oe=6B0C66C8"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F4VmEPpMQ0Q7kNvwHIQSBw&_nc_oc=AdoG0s3SFtwr2_jNLTByekezOMkW407DaVP9WtCr5Tqg9bgXJDpgpUIcPwHF519OPcE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0QCKToE0z3Sow-TTi2YuN5gBhOaeBGxZFtm_8sOumXg&oe=6B0C6A91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CU5CzHtlyYQ7kNvwEGxtaU&_nc_oc=AdruAG_oRA5rsB8dLciUoYMOMwv9M6cNyrtvbMib61GpqMq-9Gh2tngTfMb23TOus8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTwO00Kma53gVbalc530pnrKFh1a1KGwHZXvZ4a1cwHKg&oe=6B0C6E50"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
m/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awNWTH8u57AQ7kNvwGH3y9J&_nc_oc=Adoh95ufmxkXk9G1Ixcb5CAimIT_BpbBx-K5plEBat1doWYugWnKCCo1Y4e7gjjnylI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dlNMQEX13sSZoSFyD8PdiB4Xe5GwpfSz-zGf30Bz6kg&oe=69F4B088"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4ORutXgo6wQ7kNvwGIQ9R1&_nc_oc=AdrA6PkZkbh19mNMwhF0xo9LMl01GzPxx827daGuzPHVAeXcMGLcYEOk-4SALoAoeLQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3aZktIlwMRNCJYl1mg82PUBZwW8yRCcwc4eper3Ug6Pw&oe=69F4B451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOb6sPhXP4oQ7kNvwF5mzlw&_nc_oc=AdofoBmV7HEUYFZPUq68Do8et4lhVPAu5hFcbV5JVpgDr8TmqavOb5hZxlzix_t1u_A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07zK8WBu0KDoT-00jOpLR06Q2oX_G6jqx0HpUy_SXXgQ&oe=69F4B810"}, "display_name": "Laser Evader VR", "keywords": ["Laser", "Puzzle", "Trap", "LaserTrap", "VRLaserTrapGameChallenge"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a 
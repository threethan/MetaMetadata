at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlN5OdKDZi8Q7kNvwG_jcK3&_nc_oc=AdpVP6nBXU02aowmuSEoqPWjygUs8WB-ynaXBV5wl3eXrGOLK9Qq8rhxUG9fXL44Po4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMztZWDJXnrXL6uDu1hvCLIFlwlxJcMTW3ZICMkxKB9w&oe=6B006227"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-U5hcPhkcAQ7kNvwHzjT1J&_nc_oc=AdreBAgiNmeFyz01cgP2YQhNnUyqu56WsyejUKqCHSsWRx0V5m0TgZECYLLPD0T2INE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjsxGYOQoMzXS5GeiGzDd5BeMQgwBnw17BQ1-Soc2R2Q&oe=6B006469"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RfFiM56wxIQ7kNvwHdL-xz&_nc_oc=AdokoHJ2Jl7xlZeqXNy2F7hGhgZcFcIQBV0BNEoVfHG745xzV-rCUcKovqpOJInygAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLR7yMKyRodtNdKaVUZozC2tUUptzpS835SDvbRZc3UQ&oe=6B005108"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5SQsoxQaGIQ7kNvwFSfAeR&_nc_oc=AdqwLcZxbgIReaAMTfL5acffCUQzVhYxcUoAE3wz5k3JnUbqVAUmUitH_SAGYDvjGnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn15UvvGpTHXUrlR_HrG1rPxBP2TBwLfEOETWwey4mSg&oe=6B0054D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqaCSaKehnQQ7kNvwEQYzCy&_nc_oc=Ado1jHKTx3aSUcVsXXaPawySb17zV2K9nOhyvdCqG3AujcM-jhTxjhrxg8smRudsKeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScolsiUqZsdNIjbC21BBTf9PLcKrNhPkNrK_H6nuydWw&oe=6B005890"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
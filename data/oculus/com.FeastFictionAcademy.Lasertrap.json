uscdn.com&oh=00_Af3YhKC3tBrImN-VwMcwABvNEBHTRj2aIbYEOhBL1VlUzA&oe=69F20D88"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0F35RBsuUoQ7kNvwGJPQdu&_nc_oc=AdqxXEFSjCT-tay6nuF9hbblh6ZPHJt3THVF1mS0yl8zWVyaAZBaI4w-64d6PMvC2Rs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oXWpkXUzPeXZ1wNuaZ4dExj160EF6so9pjNT7ZsycEw&oe=69F21151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3wQcYhQBZEQ7kNvwE4xVgO&_nc_oc=Adqf8H_TheBYt3HbbYS4X55CcMM38dcmyIUmqXWuDgUnxeMJ6WXeDJEqXla2cjqC-nk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ny3G0bmnGBApxOni4KSkJCkmDqQBLQagMhYSN_HaB3Q&oe=69F21510"}, "display_name": "Laser Evader VR", "keywords": ["Laser", "Puzzle", "Trap", "LaserTrap", "VRLaserTrapGameChallenge"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9804474136242910"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "871258532508769"}, {"status": "PUBLISHED", "id": "1500515444566959"}, {"status": "PUBLISHED", "id": "770780029172924"}, {"status": "PUBLISHED", "id": "1282399559886579"}, {"status": "PENDING", "id": "1310444333573963"}, {"status": "PUBLISHED", "id": "671697201868842"}, {"status": "PUBLISHED", "id": "979809427434799"}, {"status": "PUBLISHED", "id": "1350370396136546"}]}, "baseline_offer": {"id": "1350370396136546"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PU
m/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dyYU7kyTcQQ7kNvwHZqnr3&_nc_oc=Adr94IhFz_YXZMMG1PxlJ3Z6ZNrRnHg9vZ6AWrVfTFIE07W-e_QBeY95WeyFUXVdMgI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gQlFniDJk4uiE5Z8lZpV2KBhz5iYfuT4_X-ljJnWFww&oe=6A106008"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05rc17_UPKwQ7kNvwESY9i6&_nc_oc=AdoJ4QIa57NvOi8VAQVZm0RW1VtXI5BkfqUJ9JS_x9IWUOVppbo0GAJ9vVUBjTguw4Q&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uozp0v7lD9CJ4MHQ_eVdYV4EQXIHdHXbWw7xCLa7TjA&oe=6A1063D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ty75NsCJq8Q7kNvwFFhUL_&_nc_oc=AdrUKgu6ysNCYiXf_66O48m4-Om3NI3ZRFnCuPKdtYTT_V712qgZWkJ6i4UwenM2AKY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CpK66xfclZXNg_O4STpTNzsb4_NkjFxzTGkbynEyHMw&oe=6A106790"}, "display_name": "Laser Evader VR", "keywords": ["Laser", "Puzzle", "Trap", "LaserTrap", "VRLaserTrapGameChallenge"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a 
at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwKXKHsVhvoQ7kNvwFKhytQ&_nc_oc=AdpUvbGqQ5cAkbu7i2JHQ3QE_fjjiKhooghSRuat5-TVh3p9bON5_0qXTe1-xEfVOVI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRy1Om5KB60_hKeLEfptACFV28U_ZzhaaZLfANyp6hHBA&oe=6B0B2667"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwFwzdlDvaMQ7kNvwEXXqWW&_nc_oc=Adqm8BJ83pyj92Ov1gRJ_lbDwcUCC-rYYENr-b2oGOxYQvbd1Hf_ChzTs_O7Xcb-82k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSujG1wUspnZTuePDf64TWo1u-Lwu3dtLvUaYhD5kyL3w&oe=6B0B28A9"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgWEz2RK9W0Q7kNvwHeCjOs&_nc_oc=AdrMc6rKwu4bkfQHN-prxaAHVFQSLceB5Ed6a4390yAQGJd9X2EfcJvBY_lxQOru37s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4Nfj82D30KfRbqopXSRqIrymnK-5qxVNZGxD2384SAQ&oe=6B0B1548"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F4VmEPpMQ0Q7kNvwGQ-GJD&_nc_oc=AdrKWA_GCbEUe756Z-jocjIOXPyfsJWiwb3j7LvXNA128U97EGUvthkRkxlmhVGhkKk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYYV3gloToXQ5ENuiLUcKX12EmrSjvXBSu4znLzolMVw&oe=6B0B1911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CU5CzHtlyYQ7kNvwE6GwA-&_nc_oc=AdqnWRNMalY71sKrqezCBgNBmZasOw_qjX2vjdYVA3WUMt7wfCoussuilaEXB9N93Js&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFfLRqdlI_u8V9VJGSi5H2WZVBAXWdAtFbd56WviY4Mw&oe=6B0B1CD0"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
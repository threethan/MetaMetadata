56998", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHbh9jOAO4MQ7kNvwFV7CDP&_nc_oc=AdrM2OpQvJnibDelJqrG2iLfreGzvLY81KKI7SjXckqWbgUsyhIg3ox4hWzsANf37oA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHny8YJYmtHIbn8GWPpE1gfban7hIl4C8MK9nMi3mXbhw&oe=6A7DA7A9"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maqvJjazgc8Q7kNvwFVxLJ1&_nc_oc=AdpHoQWne44OCD8N9f87cPS9m4fkY2n-7-ClirqEX8N7JfC1MeixWpAp4yXl5q2Xwt0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1Fu1s0HSnt1jVYXDp4udHFd1CPTN3DKNXoRP1Hp4Biw&oe=6A7DCC88"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgcQUIhfw64Q7kNvwG212Z1&_nc_oc=AdrzkblXmEbHpQQahgE7eGDE7ysF2nfos5M8PWe00sgOiFgVW2Xho-WTX5cTmX5HALg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-J5jLNhObKgZtdrCVv-9JaorUwFRlQ7Vja_HakFqrRg&oe=6A7DD051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5_22oL--ccQ7kNvwEfLr7n&_nc_oc=AdoOO6jbcf1HqbZB5HoTxi4hPYsaK5l9j-loIlzZqD6t-gNWBbeRq3ED47jUrG3hPcg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmSf7q5f3qDVaA_TM1lU-A0xwS1XnFCbYU2dFWDn4osw&oe=6A7D9BD0"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTI
, "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pUUyBLwSEIQ7kNvwHWmhS1&_nc_oc=AdqxzOTS1QBnTHYNdcLpE-CwjkvVFa6ZmAXsLhL3WowNS77rDVypvCR3tfZQpqFBf5Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBYQv1CpFykKs91TBonM89sP3w_NCHuTEKxDkxTf3Ogg&oe=6A5652E9"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byc_TfH0lUAQ7kNvwHfoLGs&_nc_oc=Adq_VHHIxt9IyeeuQZuT5NxxV0QLqueEc3RQmZab5JX3RqeXfimS1T_HAJnXkRWHRlE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4J0LuLILMJIOQG7JiP8py-QooYopHyc0Dnoz9GPNl9Q&oe=6A563F88"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUdtClGnJu8Q7kNvwFZVFz_&_nc_oc=AdpPcJHmiw5GwpEhyg9BFBeGBUtGSNWaC3VlUgId4YjxQ0M_eV4XhUMMv4FMbWU1K1Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpKS9r51MNMzf0zXioL4m2UfolzWlclFjyTWP7LrR0eQ&oe=6A564351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gWoZnTxFt8Q7kNvwGFqct1&_nc_oc=AdrDwpOmJBwswACL0mZfNNSL9asg9u10BgM8gFO_-r4Zzfv6mBgPgChte3bYsuPwfR4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdQjUcEuJNZ9rcJY-NMmTXVd3PaUpGETXBfUurKuO8EQ&oe=6A564710"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ST
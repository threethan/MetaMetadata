at=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb1bPz6A4BsQ7kNvwGZE08A&_nc_oc=AdoeLEzhoCEmKc7_XCVmxux6RuzBLpwHYxPP9r8ra5o11GMhIhtCP1hlMn_lw43UnKk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKtCzzU9mxIsIlwIh6n1qMPB0ckB0buFoN_ejyAv5JhA&oe=6B084B27"}, {"file_name": "44.png", "id": "1146025420256998", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393713_1146025423590331_1380330554330987627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1avywnSVOsQ7kNvwHflcYI&_nc_oc=AdoD-VJYsJUOdYzOIIJa8uosw3PGoJAGyKnZKZaVrX3PRjb_517UoHgd8xFmjLEQl-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1TCCJbBnTZD6mKnS0k1uab-hAZoej5-8vt9oAbICJvA&oe=6B084D69"}, {"file_name": "44.png", "id": "1630364987571690", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391904_1630364990905023_3392320177542516986_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0j78EaF_NQQ7kNvwFClBhq&_nc_oc=AdrGkLcCnVKG_ckZvWtqzST6-Mdo0ENuSknruLpou6zuzm-1c_ClcVd7aRTvsehGTOU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIRX-fy4i0NIqdywoQflCnvQiJyAwGBmJZzyGD6vDDLA&oe=6B087248"}, {"file_name": "5.png", "id": "1171474398040593", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473394043_1171474401373926_1682905367431896577_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV3mK1stQIUQ7kNvwE_0X9T&_nc_oc=Adq9MC20jzuUyrAViw_ZkR_y5Bp76VFW9Q8IYdUExkjaAktiDEecMyfgwtJ5SNnmCnM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjbh5d1S0ZIE08yq4I0EzE1VBjwRxn5Jy7kk4AQq8UYw&oe=6B083DD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1020045549954033", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393718_1020045553287366_4698837536121935541_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYkoVmoDDxQQ7kNvwHlmkrM&_nc_oc=AdpDwivcMFBm6TyyQQrxfNAaEHYcQMojYMaBYj_53fsktYtgHIBf4WiNP3e59uO9jeo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ84Tx1pD9MtYMecsEmRS1UbPY-2r9jM2Pb2SN3baFpSQ&oe=6B084190"}, "display_name": "Laser Evader", "keywords": ["Puzzle", "Trap", "VR", "Game", "laser"], "long_description": "Laser Evader VR: A Unique VR Challenge!\n\nStep into the thrilling world of Laser Evader XR, where your agility and timing are put to the ultimate test. Navigate through a maze of laser traps, dodging and weaving your way to the final destination point. But beware\u2014time is ticking! You have just 10 minutes to reach your goal, or your position will reset. And if a laser touches you, it's game over.\n\nExperience the excitement of walking, jumping, sliding, and even slowing down time to outsmart the lasers. Each time you close and re-open the game, the laser traps randomly change layout, ensuring a fresh and challenging experience every time. \nWith no long loading times or complicated options, Laser Evader XR is simple, direct, and challenging but fun.\n\nAre you ready to prove your skills and become the Laser Evader? Dive into the action and conquer the right timing!", "short_description": "Laser Evader VR/XR: A Unique VR Challenge!\n\nDodge lasers and navigate through traps to reach the final destination in 10 minutes. If you fail or get hit by a laser, your position resets. Walk, jump, slide, and slow time to outsmart the lasers. Each game features a new layout, ensuring a fresh challenge every time. Simple, direct, and fun. Prove your skills and become the ultimate Laser Evader! Dive into the action and conquer the right timing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
AJJL8g&oe=6AF1D5F3"}, {"file_name": "Screen 4.png", "id": "1215793947398679", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1215793950732012_9120486344966383195_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aoh65MMdZZkQ7kNvwFt-8Rl&_nc_oc=AdrnTrSyPE-THfv9bxW0CFfsDKBEoFDV9-p35sipVFDB9dmfJHCBB_kbT8twEbXfbf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl-gzQ9796CuBEXXWzCBSdEi7FvkRiWEvcvZbREMx80A&oe=6AF1F8B0"}, {"file_name": "Screen 5.png", "id": "968616538929693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_968616542263026_7335201929242844387_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YmBvGJ9n-0Q7kNvwEGrkcE&_nc_oc=Adq51HaN-b0DoOuHOruKHcYZTd0rXzefaQ_-af3qvyyc0kFgh4ZFaxdmy9JM5UlAY40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOkvqQiswGevgTmB3--yOOeyvkqVWFioM-UOw4fsNGIg&oe=6AF1DA8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pack It: A Packing Nightmare Simulator", "keywords": ["job", "packing", "warehouse", "delivery", "simulator"], "long_description": "Your dream job has finally arrived: carefully packing random, weird objects into the exact right cardboard box making everything fit just right while the clock ticks and the pressure builds.\n\n# WELCOME TO PACK IT : A PACKING NIGHTMARE SIMULATOR \ud83d\ude08\n\n{1488865746092185}\n\nFind the correct box and gently place the item inside.\n\nFold with precision and tape like you mean it.\n\n{1469652128208737}\n\nPrint the RIGHT label and stick it on straight.\n\n{1497233538593563}\n\nThen send your masterpiece gliding down the majestic conveyor belt.\n\n# Be fast. Be precise. Be worthy of the parcel. Every delivery has to be perfect or it's GAME OVER.\n\nReady to earn Employee of the Month in a warehouse that has no windows? \ud83d\udce6", "short_description": "Pack random items into the perfect box, fold and tape with precision, print the correct label, and send each flawless parcel down the conveyor belt. Be fast, be accurate, and don\u2019t mess up... One mistake and it\u2019s game over in this packing simulator! \ud83d\udce6"}]}, "developer_name": "Atlab5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Nz3pv0ECggzYi6_Bgz633_DLl2tkBkrwwk-p_V-3w5I/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26676637448689204"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_3003708953161463_2575925296930082274_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZPie41_aFkQ7kNvwHUYLai&_nc_oc=Adr8A_FM8AXERQremss_nlGxsdHBhpGCZ7Y2SGxumn9sDhMSIFiU61xAkCsaFnUwhVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaDy04qtGM0ouapKMbdyEouCWZvV-mVmy73I87jlnrTw&oe=6AF1EEE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pack It: A Packing Nightmare Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1772182260, "lastRevision": {"nodes": [{"id": "25689215650764727", "release_type": "SCH
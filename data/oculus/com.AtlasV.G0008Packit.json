33456296644761786_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqS5FqcJtVsQ7kNvwGHGXQi&_nc_oc=AdoOEILCaHK5YDT5G9mGcnWuvhHlmCGrbe82nhQd-jNmkf_Aq7H7bjDZsGuLbhZB81E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0iDCvw2fQieygXr77TJZppp4vWp1Gv8_fKzegzEnikA&oe=6A8D8F36"}, {"file_name": "Screen 3.png", "id": "2751336441885076", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821782_2751336445218409_3642015881046329501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHkLqLjQnVoQ7kNvwHB9YgR&_nc_oc=AdqwfZag9YYfdv1ow4j_A4Unc5aBpXDCkYHyFnh174rzoxWk_VBHUpnsHe7z6NeWLv4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH894CM3HfMgL7TOSFj1nmUUZMIoqPo1aTMHBOJQl_2cA&oe=6A8D6BB3"}, {"file_name": "Screen 4.png", "id": "1215793947398679", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819854_1215793950732012_9120486344966383195_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng89TaBjn94Q7kNvwFu_HDf&_nc_oc=AdoFSJ0IYnl8Z6OTwYIYyhXIQpz8AjVS46ZJGYzE1Im4Z3c22bYKNhrcrbGh4tW2_SU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYf9F51HUsHpGgSA8JdlYexNlx0dmE4a_qD_pUVteTVA&oe=6A8D8E70"}, {"file_name": "Screen 5.png", "id": "968616538929693", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823802_968616542263026_7335201929242844387_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV7eiF-L6W8Q7kNvwEdNzsu&_nc_oc=Adq0VaKH_5yuZ5WccDhUOFLT6UsnhHl5EfPdNrxMZ_bPI6Plkh48R-7UfT1kynCeXZ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfCONcr2UCOQDzR2IPbDl5Ko_83Th5kvO66BRzYYeN7A&oe=6A8D704E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pack It: A Packing Nightmare Simulator", "keywords": ["job", "packing", "warehouse", "delivery", "simulator"], "long_description": "Your dream job has finally arrived: carefully packing random, weird objects into the exact right cardboard box making everything fit just right while the clock ticks and the pressure builds.\n\n# WELCOME TO PACK IT : A PACKING NIGHTMARE SIMULATOR \ud83d\ude08\n\n{1488865746092185}\n\nFind the correct box and gently place the item inside.\n\nFold with precision and tape like you mean it.\n\n{1469652128208737}\n\nPrint the RIGHT label and stick it on straight.\n\n{1497233538593563}\n\nThen send your masterpiece gliding down the majestic conveyor belt.\n\n# Be fast. Be precise. Be worthy of the parcel. Every delivery has to be perfect or it's GAME OVER.\n\nReady to earn Employee of the Month in a warehouse that has no windows? \ud83d\udce6", "short_description": "Pack random items into the perfect box, fold and tape with precision, print the correct label, and send each flawless parcel down the conveyor belt. Be fast, be accurate, and don\u2019t mess up... One mistake and it\u2019s game over in this packing simulator. \ud83d\udce6"}]}, "developer_name": "Atlab5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Nz3pv0ECggzYi6_Bgz633_DLl2tkBkrwwk-p_V-3w5I/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25689215624098063"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "928829509933572"}
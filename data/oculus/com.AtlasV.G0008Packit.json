1821782_2751336445218409_3642015881046329501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD_gMgj0Z84Q7kNvwEGxAnL&_nc_oc=AdoeIIhGp9N3n_E6Mnc2FEqR_bNA_9tVfqmc2IhSERxdQjBrhSERc8On1h_SzIFDoQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-SgKqKqT9kPBNi3kzNzop2YWpiqqjlTKmBFPIdR3euw&oe=6A4D0A73"}, {"file_name": "Screen 4.png", "id": "1215793947398679", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1215793950732012_9120486344966383195_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpViOuAg3AQQ7kNvwEn6IuO&_nc_oc=Ados8UVbFzmsTXi9UsH3iMvjREhNwu276ePaJJ5dvTGfzDXqvBvQZQSjOVWQxurbJVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWKo1fWVFhzRCmZtaod8owV8J8VwbDHxSq3WHTokOSdg&oe=6A4CF4F0"}, {"file_name": "Screen 5.png", "id": "968616538929693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_968616542263026_7335201929242844387_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzuzJMFt9twQ7kNvwEo9ZF5&_nc_oc=Adob-9IIV9RaC-iZFym5VRoBijieBCWaZqY9tGZlkx3VAJh-N47RLVd3xlIJ144ICXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC97Ufph6U58koFKx5lbSAUjtMAO7WycfIuP59KFA5d0w&oe=6A4D0F0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pack It: A Packing Nightmare Simulator", "keywords": ["job", "packing", "warehouse", "delivery", "simulator"], "long_description": "Your dream job has finally arrived: carefully packing random, weird objects into the exact right cardboard box making everything fit just right while the clock ticks and the pressure builds.\n\n# WELCOME TO PACK IT : A PACKING NIGHTMARE SIMULATOR \ud83d\ude08\n\n{1488865746092185}\n\nFind the correct box and gently place the item inside.\n\nFold with precision and tape like you mean it.\n\n{1469652128208737}\n\nPrint the RIGHT label and stick it on straight.\n\n{1497233538593563}\n\nThen send your masterpiece gliding down the majestic conveyor belt.\n\n# Be fast. Be precise. Be worthy of the parcel. Every delivery has to be perfect or it's GAME OVER.\n\nReady to earn Employee of the Month in a warehouse that has no windows? \ud83d\udce6", "short_description": "Pack random items into the perfect box, fold and tape with precision, print the correct label, and send each flawless parcel down the conveyor belt. Be fast, be accurate, and don\u2019t mess up... One mistake and it\u2019s game over in this packing simulator. \ud83d\udce6"}]}, "developer_name": "Atlab5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Nz3pv0ECggzYi6_Bgz633_DLl2tkBkrwwk-p_V-3w5I/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25689215624098063"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "928829509933572"}]}, "baseline_offer": {"id": "928829509933572"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772182260, "status": "PUBLISHED", "id": "928829509933572"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25967602742926015", "version": "1.0.0.34"}, "id": "1588124042513155", "channel_name": "LIVE"}]}, "is_for_oculus_
bFvx_0DUaPQ&oe=6B01CA65"}, {"file_name": "ScreenShot (3).png", "id": "4089579764652058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618235_4089579771318724_7804827251884478265_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrv94Erg9DcQ7kNvwHsB8f6&_nc_oc=AdoosT_-9TgsXaumkvXEr8M3jRfSZpDexFwCNfLs3s68ThZxgpxMFS5JnCb3cT2M2hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcIbe0H8GU_mEZjgcsBj6Z_gjMBTaMYm185o_WLidlZA&oe=6B01D5A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot (6).png", "id": "2270122396817324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303769_2270122400150657_5865646958067953797_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySrf2mL0izQQ7kNvwGhYzKC&_nc_oc=AdpMhfGb4zK6yCzNVPBBqaU33oTuiod7Rreg4VJQ2MXqqHXAP4r0t9xBLk3dmvxZddE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShRCApYXTiXpukfRf41E_rUwJsQoGdH2zMa8-6GOUSQA&oe=6B01C68C"}, "display_name": "Raccoon Party", "keywords": ["Party", "Raccoon", "Social"], "long_description": "Raccoon Party is a thrilling VR social game where chaos, fun, and creativity collide. Inspired by Gorilla Tag but packed with its own wild twist, you take on the role of a raccoon running, climbing, and swinging with nothing but your arms no legs required! Explore vibrant maps, challenge friends, and dive into unique game modes like Laser Maze, Glass Bridge, Rock Climb, Parkour, and the daring Only Up. Or try Dump Tycoon, where you collect and sell trash for money to climb the raccoon ranks. Every game mode offers fresh ways to test your skill, movement, and speed while keeping the party vibes alive.\n\nBut the fun doesn\u2019t stop with just the games Raccoon Party is all about expression and customization. Show off your personality with an ever growing collection of cosmetics, from funny hats and glowing masks to stylish outfits and goofy accessories. Whether you want to look like the coolest raccoon in the lobby or stand out with wacky gear, the shop has something for everyone.\n\nOn top of that, the game supports cool mods and custom content, letting the community expand the fun even further. Imagine new maps, wild game modes, or raccoon inspired skins made by players just like you keeping the party fresh and unpredictable. With regular updates, events, and rotating cosmetics, there\u2019s always something new to discover.\n\nWhether you\u2019re climbing to victory, dodging lasers, or just chilling and chatting with friends, Raccoon Party delivers nonstop energy, laughs, and unforgettable VR ", "short_description": "Raccoon Party is a fast-paced VR social game inspired by Gorilla Tag, where you play as a raccoon and dive into chaotic, fun filled worlds. Hang out with friends or meet new players while competing in unique game modes like Laser Maze, Glass Bridge, Dump Tycoon where you sell trash for cash, Rock Climb, Parkour, and Only Up challenges. Run, climb, and swing using your arms no legs needed bringing non stop action, laughs, and unforgettable moments in VR."}]}, "developer_name": "Villan At VillanStudios", "developer_privacy_policy_url": "https://villanstudios.com/pages/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VillanStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/villanstudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
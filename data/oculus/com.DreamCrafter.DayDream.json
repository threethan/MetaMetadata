c_sid=6e7a0a&_nc_ohc=VJeApdBgJKEQ7kNvwERQtoo&_nc_oc=AdkbbTr1gB2Kr9qTfJH8DAqX0pStB2H6ztSvPtcFu9ChK9ng_R_zl3jmGHSqb3vPjz0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afypo1Guo_jiCUZs9cccpo-7zU8-D3PZwlZ5hbsgKzMHSg&oe=69BAA307"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DayDream - AI Companion", "keywords": ["AI", "girlfriend", "social", "simulator", "anime"], "long_description": "Immersive Interactions: Meet a virtual friend who\u2019s always ready to surprise you with shining clothes, dances, dinners, and delightful conversations, making every interaction unique.\n\nPersonalized Experiences: Customize everything from clothing to stories. Watch her come to life with realistic expressions, movements, and dialogues.\n\nDynamic Events: Participate in diverse scenarios, from a walk near your home to watching a TV show together. Your companion adapts to your actions in both VR and MR settings.\n\nUser-Driven Content: Explore a rich narrative or create your own experiences with our user-friendly behavior editor.\n\nSeamless Integration: Enjoy shared activities like watching videos together and playing mini-games.\n\nPlease go to our website to join Discord!", "short_description": "Experience a new life with your virtual partner in VR/MR. You shape the story and she brings it to reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EpwQQB_m_0wc6iKRdQ0D3uORIWg0IPyn6xPs0Xmf_2E/edit?usp=drive_link", "developer_terms_of_service_url": "https://docs.google.com/document/d/16vaC28kiJkPrNhUbov7Q6ETltp8545Jp2MBOvDKk9iM/edit?usp=sharing", "publisher_name": "DreamCrafter", "support_website_url": null, "website_url": "https://daydreamvr.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "REQUIRE
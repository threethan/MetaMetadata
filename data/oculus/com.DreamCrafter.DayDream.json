YNMFeKs6xRhRGTbK4ZdWyLu-5vIesB3SSSia4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkr9S6b-EPG18f_onsRuKjNv3GgVAcoYc0En4lR8F9Xg&oe=6AFDD980"}, {"file_name": "Cover Landscape.png", "id": "552032730621818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974891_552032733955151_6191242292346125468_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcHBGgZU-7oQ7kNvwEMD9DR&_nc_oc=AdqijaThWFOffGHHi7b6Lc5lv7sOeQFxQGZPoZgECmhsOD7wC9d_fXrxNH5buIqZmpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx6TybjysBgohMmZH7XJDONIFcHV8nt2EQ8PXjCqcLEw&oe=6AFDDAC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DayDream - AI Companion", "keywords": ["AI", "girlfriend", "social", "simulator", "anime"], "long_description": "Immersive Interactions: Meet a virtual friend who\u2019s always ready to surprise you with shining clothes, dances, dinners, and delightful conversations, making every interaction unique.\n\nPersonalized Experiences: Customize everything from clothing to stories. Watch her come to life with realistic expressions, movements, and dialogues.\n\nDynamic Events: Participate in diverse scenarios, from a walk near your home to watching a TV show together. Your companion adapts to your actions in both VR and MR settings.\n\nUser-Driven Content: Explore a rich narrative or create your own experiences with our user-friendly behavior editor.\n\nSeamless Integration: Enjoy shared activities like watching videos together and playing mini-games.\n\nPlease go to our website to join Discord!", "short_description": "Experience a new life with your virtual partner in VR/MR. You shape the story and she brings it to reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1EpwQQB_m_0wc6iKRdQ0D3uORIWg0IPyn6xPs0Xmf_2E/edit?usp=drive_link", "developer_terms_of_service_url": "https://docs.google.com/document/d/16vaC28kiJkPrNhUbov7Q6ETltp
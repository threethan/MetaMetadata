EQxFq3&_nc_oc=AdppVYx3a1ddD3B04JGYGBh5doLC7OfXSyq08Yy9SqepgAeijRS3JvV0bcjie8iwUHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUHtMG7Ky0LzW_L6o070ccGb3b8ZSCE5HPn_a1rG1jqg&oe=6AC10158"}, {"file_name": "05 1.png", "id": "2465257137233734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618288_2465257140567067_8645868481059167730_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq1nC7VczCwQ7kNvwGSTAJB&_nc_oc=AdqNgrmZtzlvbvtnO6VFESc1vb1BvJz9f3pOmdaN4TnsHegc_aQNUT-VpZeJ5LPBSUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdEhI02NQbzVX2K9zqzdm0g3agdA546uy2reQBCFOmDw&oe=6AC12047"}, {"file_name": "02 4.png", "id": "1214681410589965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1214681413923298_4378667154362559946_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yDOz_SoLU0Q7kNvwGbk-hm&_nc_oc=AdofhmUy3K4AWwo5B9NBNA32vI-DqPk1aQPdi05RHqoCfdHNTuXVGTWct8OrqpwxIiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc8x1jtqocpMGn4Z-lfhEcmTi-lDqtBMTnEpYFn_n7zQ&oe=6AC10328"}, {"file_name": "04 2.png", "id": "1481922806961886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617847_1481922810295219_4081516054364954657_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2M-IHUBbakQ7kNvwEnE2tH&_nc_oc=AdpMTaUydvRrlN8F1NyN-pdzuOm4r8jydrL23n4RdITyd5hid3EB_GlFpoeedmtYRN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIlAoCGrp414Xk7EAAWKLFEVJc7lmDTQss3Sctzdg7Hw&oe=6AC1220D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RETTERVR", "keywords": ["Simulation", "Training"], "long_description": "RETTERVR is a virtual reality training solution for fire departments and emergency services. The application enables realistic training of operational scenarios \u2013 especially in the field of technical rescue \u2013 within an immersive and controlled environment.\nUsers train typical incident situations such as traffic accidents, assess scenes, carry out measures, and make decisions under time pressure. In addition to technical procedures, communication and team coordination are a key focus.\nThe scenarios follow a structured didactic approach and can be flexibly integrated into training and exercises. Variable parameters and scenario variations ensure repeatable yet diverse training experiences.\nRETTERVR supports instructors in presenting complex situations without high logistical effort or risks associated with live training. At the same time, it provides participants with a safe way to gain experience and build operational confidence.\nSuitable for training, advanced education, and independent practice in emergency response and rescue services.", "short_description": "RETTERVR is a VR training platform for emergency services. Realistic scenarios from technical rescue enable hands-on practice of procedures, communication, and decision-making \u2013 flexible, safe, and available anytime."}, {"images": {"nodes": [{"file_name": "Hochformat.png", "id": "4804233993137057", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_4804233996470390_6677939233623676824_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQ7vZenIYHEQ7kNvwEFkYUM&_nc_oc=AdrpILVLX1gk-wjZA7lvf6o_YNPypGoiRWMJv9ByjbGLWJ8y7brHUAxqN-JIdcAm__g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz46AIoD874yiYiv5db7WvGMNL4Aq6sYwrAQ1FYCVbfg&oe=6AC10E82"}, {"file_name": "Symbol.png", "id": "1308797974716623", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_1308797978049956_185352618628718929_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJGARVTEK8gQ7kNvwG7LFe7&_nc_oc=AdqfHxSrz3h7wxHlrLNfHEb_4RnUMnxnnd4jQ2b_biQ7dpnhrR-zbqb6SkfTLQNWBTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwUHC0vrM0_n-RcuCR3wgOGjcC69YU63l0RQepLvvQCw&oe=6AC10426"}, {"file_name": "Hero-Cover.png", "id": "974133678693506", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_974133682026839_5228432821005116807_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icnLIF-hbaYQ7kNvwEmzYca&_nc_oc=AdphSFBHM0kTDtCsavlbntop_yLe5JbgOUyTcqWUYEFrpWtt3j-9PiqMujwQVksRJzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH3g6xMs9bhwThEnwGE1LhK_IS0gsifnJhBHwg98IPDA&oe=6AC120A4"}, {"file_name": "Querformat.png", "id": "959680426873309", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_959680433539975_3543397248264607363_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opCYcEqWVaYQ7kNvwGStAUL&_nc_oc=Adr1h0wKR7lpDAqjOy25g9hDQDotr5K_hVG5eI5bZPLtVUoZReACAnT5BOHCl1V-0is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHGEa56jcGAvnBHnVYgSiiRFz5RYSkx6grA4sMeunKqg&oe=6AC1176A"}, {"file_name": "Quadrat.png", "id": "855719543623386", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310726_855719546956719_1254660568186193239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_C0JqMsdD8Q7kNvwGxnIg5&_nc_oc=AdroH_msqSGb9mTHlO3ARCHkE-0MNjqeBPqDX6JwAaJJ_96kNnLYZh_G-J2uzL-qc3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmFzSvJvHhnaa7rpjnVjT8HpDfdXHFgMwTlW1RqT6YHQ&oe=6AC109BA"}]}, "id": "956617137218642", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RETTERVR", "keywords": ["Feuerwehr", "Simulation", "Training", "\u00dcbung"], "long_description": "RETTERVR ist eine Virtual-Reality-Trainingsl\u00f6sung f\u00fcr Einsatzkr\u00e4fte. Die Anwendung erm\u00f6glicht das realit\u00e4tsnahe \u00dcben von Einsatzszenarien \u2013 insbesondere aus der technischen Hilfeleistung \u2013 in einer immersiven, kontrollierten Umgebung.\nNutzer trainieren typische Einsatzlagen wie Verkehrsunf\u00e4lle, erkunden Einsatzstellen, f\u00fchren Ma\u00dfnahmen durch und treffen Entscheidungen unter Zeitdruck. Dabei stehen sowohl fachliche Abl\u00e4ufe als auch Kommunikation und Teamkoordination im Fokus.\nDie Szenarien sind didaktisch aufgebaut und lassen sich flexibel in Ausbildung und \u00dcbung integrieren. Unterschiedliche Parameter und Varianten sorgen f\u00fcr wiederholbares, aber abwechslungsreiches Training.\nRETTERVR unterst\u00fctzt Ausbilder dabei, komplexe Lagen darzustellen, ohne hohen logistischen Aufwand oder Risiken im Realtraining. Gleichzeitig bietet es den Teilnehmenden eine sichere M\u00f6glichkeit, Erfahrungen zu sammeln und Handlungssicherheit zu entwickeln.\nGeeignet f\u00fcr Ausbildung, Fortbildung und eigenst\u00e4ndiges Training im Bereich Einsatz- und Rettungswesen.", "short_description": "RETTERVR ist eine VR-Trainingsplattform f\u00fcr Einsatzkr\u00e4fte. Realit\u00e4tsnahe Szenarien aus der technischen Hilfeleistung erm\u00f6glichen praxisnahes \u00dcben von Abl\u00e4ufen, Kommunikation und Entscheidungsfindung \u2013 flexibel, sicher und jederzeit verf\u00fcgbar."}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.weberrescueworld.com/rettervr/data-security.html", "developer_terms_of_service_url": null, "publisher_name": "Rescue Digital Systems GmbH", "support_website_url": null, "website_url": "https://www.rescue-digital.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction
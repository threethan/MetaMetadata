": [{"file_name": "\ud504\ub791\ucf04\uc2a4\uc0f71.png", "id": "745627750489978", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001702_745627753823311_4200196768306457627_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FK1VDB11gUQ7kNvwHQ7A7F&_nc_oc=AdrKElyIWyu8i70tRkdFpu0Pc-LA3RcDaq112l_v1OKos_i3J9ZzZR6khTPIwyaPuJg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Wtfa68tGHTmwjE0Ir2PNKgohUP0PzBtteFY6Yt6Ihw&oe=6AFB2C0B"}, {"file_name": "\ud504\ub791\ucf04\uc2a4\uc0f72.png", "id": "264862585869192", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001656_264862589202525_7088262936436838022_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_33astV8dYwQ7kNvwGkPMGZ&_nc_oc=AdpNUtV48yEeGZspEk2CE_8y23DzCzIvYVSbnKLNFhPuW6cJaEsZtCwGCUFLLfgBkd0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT6O5_1Qwu6RnmMUmQzFb-i9lkQ2pylFXSlhqo2iFibA&oe=6AFB2854"}, {"file_name": "\ud504\ub791\ucf04\uc2a4\uc0f73.png", "id": "1013432572954311", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974671_1013432576287644_5640480876764407899_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGuS4cg_Y5gQ7kNvwGXlTEU&_nc_oc=AdqA0sPslXlfHJ-lsqeYsV_FZbCqLkinSaBz_SYGimNEpYQR5ESu2MN8XQ0eS6ToxUs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUmB88F2y9-1fqG0nqk_2twO49Kao1co98sWagbRhyJg&oe=6AFB403F"}, {"file_name": "\ud504\ub791\ucf04\uc2a4\uc0f74.png", "id": "5981031315306641", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001702_5981031318639974_3187480141622685422_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7gFtRnG5WwQ7kNvwFJ7Zoi&_nc_oc=AdqVGFTb7E-ZglQebWcN1u3PJbgM0vKi9GJZmJbUAoV2vDf9y2EPAiMvwFVfSvg3sk0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZvjIIUPP8rVsh08ptDhvdvqXtE0wAqPWvp0s0xgCKag&oe=6AFB411A"}, {"file_name": "\ud504\ub791\ucf04\uc2a4\uc0f75.png", "id": "753513993018209", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575363_753513996351542_8942371900388921478_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8llEuqR0FIQ7kNvwGuTwXL&_nc_oc=AdpE0d7O2AyewBala4wx6qtakjHDhb-cQACfn47Lt8LziwYs9ZAfW6fMyETu8BqDVIE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShBzW9saztECv5SKrZOAjjdJFbTtB7g__PKbyvMobOyA&oe=6AFB480A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud504\ub791\ucf04\uba54\uc778\uc774\ubbf8\uc9c0.png", "id": "770113317757171", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031376_770113321090504_806391589483705585_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZRHlRKOKS4Q7kNvwF8ht9W&_nc_oc=AdqD1-tN8yma5gu2Mn3s_PpOTSbdfe0Vlu_kcnAOJjIvBY_XU_0YWvylNLapiNbZBtE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsC4yqYXslCsGMtrpGZcwp6CkqAVrZjqItik4yMVZWzw&oe=6AFB2BE9"}, "display_name": "NLCY Debate Club Part2", "keywords": [], "long_description": "\n\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740, \uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00\uc774 2022\ub144 \uac1c\ubc1c\ud55c VR \uae30\ubc18 \ub3c5\uc11c\ud1a0\ub860 \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4.\n\uccad\uc18c\ub144\ub4e4\uc758 \uc758\uc0ac\uc18c\ud1b5\ub2a5\ub825 \ubc0f \ub17c\ub9ac\ub825 \ud568\uc591, \uc62c\ubc14\ub978 \uac00\uce58\uad00 \uc815\ub9bd\uc744 \uc704\ud574,\n\ud765\ubbf8\ub85c\uc6b4 VR \uccb4\ud5d8\uacfc \ub3c5\uc11c\ud1a0\ub860\uc744 \uacb0\ud569\ud55c \ud504\ub85c\uadf8\ub7a8\uc73c\ub85c \uac1c\ubc1c\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\ubcf8 VR\uc740 \ud658\uacbd \ubd84\uc57c 3\uac1c \uc8fc\uc81c, \uacfc\ud559 \ubd84\uc57c 3\uac1c \uc8fc\uc81c\ub97c \ub2e4\ub8e8\uba70, \ub3c5\uc11c\ud1a0\ub860\uc758 \ud654\ub450\ub97c \uc5ec\ub294 \ub3c4\uc785 \ucf58\ud150\uce20\ub85c \uc4f0\uc784 \ud569\ub2c8\ub2e4.\n\ubbf8\uc158\ub2f9 5~10\ubd84 \ub0b4\uc678\uc758 \ubab0\uc785\uc801\uc778 \uacbd\ud5d8\uc740, \uccad\uc18c\ub144\ub4e4\uc774 \uc8fc\ub3c4\uc801\uc73c\ub85c \ud1a0\ub860\uc5d0 \uc784\ud558\ub294 \ub370 \uae30\uc5ec\ud560 \uac83\uc774\ub77c \ubbff\uc2b5\ub2c8\ub2e4.\n\n\ud604\uc2dc\ub300\ub97c \uc0b4\uc544\uac00\ub294 \uccad\uc18c\ub144\ub4e4\uc774 \uace0\ubbfc\ud558\uace0 \ud1a0\ub860\ud574\ubd04 \uc9c1\ud55c \uc8fc\uc81c\ub4e4\uc5d0 \ub300\ud574, \nVR\uc758 \ub9e4\ub825\uc801\uc778 \ub3c4\uc785\uc744 \uccb4\ud5d8\ud558\uc138\uc694.\n \n\ub2e4\ub8e8\ub294 \ub0b4\uc6a9\uacfc \uc8fc\uc81c\ub294 \uc544\ub798\uc640 \uac19\uc2b5\ub2c8\ub2e4.\n\nEP1: \ud658\uacbd\uc0dd\ud0dc\ud559\uc790 \ubbf8\uc158 (\uc624\ub791\uc6b0\ud0c4 \uad6c\uc870) - \uacf5\uc0dd\nEP2: \ud658\uacbd\ud53c\ud574\uc5ed\ud559\uc870\uc0ac\uad00 \ubbf8\uc158 (\uc568\ubc84\ud2b8\ub85c\uc2a4 \uc8fd\uc74c\uc758 \uc6d0\uc778\uc870\uc0ac) - \ud574\uc591\uc624\uc5fc\nEP3: \ud658\uacbd\ud65c\ub3d9\uac00 \ubbf8\uc158 (\ubd88\ubc95 \uc0c1\uc5b4 \ud3ec\ud68d \uac10\uc2dc) - \uc0dd\uba85\uc874\uc5c4\uc131\nEP4: \ud504\ub791\ucf04\uc288\ud0c0\uc7781 (\uad34\ubb3c \ud0c4\uc0dd) - \uacfc\ud559\uc790\uc758 \uc724\ub9ac\uc640 \ucc45\uc784\nEP5: \ud504\ub791\ucf04\uc288\ud0c0\uc7782 (\uc5d8\ub9ac\uc790\ubca0\uc2a4\uc758 \ubd80\ud0c1) - \uc548\ub77d\uc0ac\nEP6: \ud504\ub791\ucf04\uc288\ud0c0\uc7783 (\uc774\uace0\ub974\uc758 \uc704\ud5d8\ud55c \uc2e4\ud5d8) - \uc720\uc804\uc790 \ud3b8\uc9d1 \uae30\uc220\n\n* VR\uc774 \ub9e4\ub825\uc801\uc774\uc5c8\ub2e4\uba74, \uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00\uc5d0 \ubb38\uc758\ud558\uc138\uc694. \n\uc2e4\uc81c \ud1a0\ub860\uc218\uc5c5\uae4c\uc9c0 \uacb0\ud569\ub41c, <VR \ub3c5\uc11c\ud1a0\ub860 \ud504\ub85c\uadf8\ub7a8>\uc774 \ub2f9\uc2e0\uc744, \ub2f9\uc2e0\uc758 \uccad\uc18c\ub144\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \n", "short_description": "VR\ub85c \ub5a0\ub098\ub294 \ud1a0\ub860\ucea0\ud504 - \uc785\ubb38\uacfc\uc815 '\uacfc\ud559 \uc724\ub9ac'\nDiscussion Camp in VR for Advenced 'Scientific Ethics'"}]}, "developer_name": null, "developer_privacy_policy_url": "http://coin7.co.kr/privacy/NLCY/personalInfo.html", "developer_terms_of_service_url": null, "publisher_name": "\uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00(National Library for Children and Young Adults) ", "support_website_url": null, "website_url": "https://www.nlcy.go.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272013595399064"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "782903129855304"}]}, "baseline_offer": {"id": "782903129855304"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1686942779, "status": "PUBLISHED", "id": "782903129855304"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9711272675586021", "version": "1.16"}, "id": "748448639994033", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9433563726690252", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9711272675586021"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "748448639994033"}]}, "change_log": null, "created_date": 1686905642, "id": "9711272675586021", "
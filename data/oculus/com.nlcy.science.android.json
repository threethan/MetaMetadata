luscdn.com&_nc_ss=7f20f&oh=00_AQQIE7n2gEa0FG6HHN3t0xtBHlxhnBLJfcIfhKwST2xe8Q&oe=6AF490D4"}, {"file_name": "\ud504\ub791\ucf04\uc2a4\uc0f73.png", "id": "1013432572954311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_1013432576287644_5640480876764407899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x69Zz0ow7lMQ7kNvwFiMAnv&_nc_oc=AdrwV8uOaHSQsCk3tVHZylrsUDEpv_pV6z5j36CtlfsBMq28eHlqIoD_f0ezIucpU38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWCvCFQo--tV2_M7C5hcEy02FO9QHX6BiRnhOyniUGXw&oe=6AF4707F"}, {"file_name": "\ud504\ub791\ucf04\uc2a4\uc0f74.png", "id": "5981031315306641", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001702_5981031318639974_3187480141622685422_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW-LmREH3lcQ7kNvwEeTyxU&_nc_oc=AdrjcmUxty6r3lRHESWypcAU8CqF4NzPcownBfwiXv8ALcq-IdjdAXi3FThg99bi4KA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWrUUGf9RzcXzM10Zf51YUd8bp4Nvd-GnBo0T41OE97w&oe=6AF4715A"}, {"file_name": "\ud504\ub791\ucf04\uc2a4\uc0f75.png", "id": "753513993018209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575363_753513996351542_8942371900388921478_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnn__Sx-zV0Q7kNvwE2mF23&_nc_oc=Adrai8iFFaooEyMgELVxm0XHhnYQCQCUpBS3mhBwVOL0AC0eYYQ_bZfO5kAzVM01mZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMd7El0SVykEfeMZAMvFsxCAOOO62H4MrQ6Oy40qfnJQ&oe=6AF4784A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud504\ub791\ucf04\uba54\uc778\uc774\ubbf8\uc9c0.png", "id": "770113317757171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031376_770113321090504_806391589483705585_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4mEvg7gGg4Q7kNvwHVY1fp&_nc_oc=AdrkgW7FpvIuQ2JBV4Y0z2QSZX2VN_PgCez_htpZ1EJCTmpEwDCKaqmTBZ-RluzGgwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnVjL6MZM2SnyXc1GPx0vry8vKTsAONNoLrySKudQCAA&oe=6AF49469"}, "display_name": "NLCY Debate Club Part2", "keywords": [], "long_description": "\n\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740, \uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00\uc774 2022\ub144 \uac1c\ubc1c\ud55c VR \uae30\ubc18 \ub3c5\uc11c\ud1a0\ub860 \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4.\n\uccad\uc18c\ub144\ub4e4\uc758 \uc758\uc0ac\uc18c\ud1b5\ub2a5\ub825 \ubc0f \ub17c\ub9ac\ub825 \ud568\uc591, \uc62c\ubc14\ub978 \uac00\uce58\uad00 \uc815\ub9bd\uc744 \uc704\ud574,\n\ud765\ubbf8\ub85c\uc6b4 VR \uccb4\ud5d8\uacfc \ub3c5\uc11c\ud1a0\ub860\uc744 \uacb0\ud569\ud55c \ud504\ub85c\uadf8\ub7a8\uc73c\ub85c \uac1c\ubc1c\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\ubcf8 VR\uc740 \ud658\uacbd \ubd84\uc57c 3\uac1c \uc8fc\uc81c, \uacfc\ud559 \ubd84\uc57c 3\uac1c \uc8fc\uc81c\ub97c \ub2e4\ub8e8\uba70, \ub3c5\uc11c\ud1a0\ub860\uc758 \ud654\ub450\ub97c \uc5ec\ub294 \ub3c4\uc785 \ucf58\ud150\uce20\ub85c \uc4f0\uc784 \ud569\ub2c8\ub2e4.\n\ubbf8\uc158\ub2f9 5~10\ubd84 \ub0b4\uc678\uc758 \ubab0\uc785\uc801\uc778 \uacbd\ud5d8\uc740, \uccad\uc18c\ub144\ub4e4\uc774 \uc8fc\ub3c4\uc801\uc73c\ub85c \ud1a0\ub860\uc5d0 \uc784\ud558\ub294 \ub370 \uae30\uc5ec\ud560 \uac83\uc774\ub77c \ubbff\uc2b5\ub2c8\ub2e4.\n\n\ud604\uc2dc\ub300\ub97c \uc0b4\uc544\uac00\ub294 \uccad\uc18c\ub144\ub4e4\uc774 \uace0\ubbfc\ud558\uace0 \ud1a0\ub860\ud574\ubd04 \uc9c1\ud55c \uc8fc\uc81c\ub4e4\uc5d0 \ub300\ud574, \nVR\uc758 \ub9e4\ub825\uc801\uc778 \ub3c4\uc785\uc744 \uccb4\ud5d8\ud558\uc138\uc694.\n \n\ub2e4\ub8e8\ub294 \ub0b4\uc6a9\uacfc \uc8fc\uc81c\ub294 \uc544\ub798\uc640 \uac19\uc2b5\ub2c8\ub2e4.\n\nEP1: \ud658\uacbd\uc0dd\ud0dc\ud559\uc790 \ubbf8\uc158 (\uc624\ub791\uc6b0\ud0c4 \uad6c\uc870) - \uacf5\uc0dd\nEP2: \ud658\uacbd\ud53c\ud574\uc5ed\ud559\uc870\uc0ac\uad00 \ubbf8\uc158 (\uc568\ubc84\ud2b8\ub85c\uc2a4 \uc8fd\uc74c\uc758 \uc6d0\uc778\uc870\uc0ac) - \ud574\uc591\uc624\uc5fc\nEP3: \ud658\uacbd\ud65c\ub3d9\uac00 \ubbf8\uc158 (\ubd88\ubc95 \uc0c1\uc5b4 \ud3ec\ud68d \uac10\uc2dc) - \uc0dd\uba85\uc874\uc5c4\uc131\nEP4: \ud504\ub791\ucf04\uc288\ud0c0\uc7781 (\uad34\ubb3c \ud0c4\uc0dd) - \uacfc\ud559\uc790\uc758 \uc724\ub9ac\uc640 \ucc45\uc784\nEP5: \ud504\ub791\ucf04\uc288\ud0c0\uc7782 (\uc5d8\ub9ac\uc790\ubca0\uc2a4\uc758 \ubd80\ud0c1) - \uc548\ub77d\uc0ac\nEP6: \ud504\ub791\ucf04\uc288\ud0c0\uc7783 (\uc774\uace0\ub974\uc758 \uc704\ud5d8\ud55c \uc2e4\ud5d8) - \uc720\uc804\uc790 \ud3b8\uc9d1 \uae30\uc220\n\n* VR\uc774 \ub9e4\ub825\uc801\uc774\uc5c8\ub2e4\uba74, \uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00\uc5d0 \ubb38\uc758\ud558\uc138\uc694. \n\uc2e4\uc81c \ud1a0\ub860\uc218\uc5c5\uae4c\uc9c0 \uacb0\ud569\ub41c, <VR \ub3c5\uc11c\ud1a0\ub860 \ud504\ub85c\uadf8\ub7a8>\uc774 \ub2f9\uc2e0\uc744, \ub2f9\uc2e0\uc758 \uccad\uc18c\ub144\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \n\n* \ubcf8 \ucf58\ud150\uce20\ub294 \uacf5\uc775\uc801 \ubaa9\uc801\uc73c\ub85c \uc81c\uc791\ub41c \uc790\ub8cc\ub85c\uc11c, \ud65c\uc6a9 \uc2dc \ucd9c\ucc98\ub97c \ubc18\ub4dc\uc2dc \uba85\uc2dc\ud558\uc5ec\uc57c \ud569\ub2c8\ub2e4.\n\n* \uc0c1\uc5c5\uc801 \ubaa9\uc801(\uc720\ub8cc \uac15\uc758 \ub4f1)\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc0ac\uc804 \uc0ac\uc6a9 \ud5c8\ub77d\uc744 \ubc1b\uc544\uc57c \ud558\uba70, \ubb34\ub2e8 \ud65c\uc6a9\uc744 \uae08\ud569\ub2c8\ub2e4. ", "short_description": "VR\ub85c \ub5a0\ub098\ub294 \ud1a0\ub860\ucea0\ud504 - \uc785\ubb38\uacfc\uc815 '\uacfc\ud559 \uc724\ub9ac'\nDiscussion Camp in VR for Advenced 'Scientific Ethics'"}]}, "developer_name": null, "developer_privacy_policy_url": "http://coin7.co.kr/privacy/NLCY/personalInfo.html", "developer_terms_of_service_url": null, "publisher_name": "\uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00(National Library for Children and Young Adults) ", "support_website_url": null, "website_url": "https://www.nlcy.go.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", 
12tn2CSJBYmA32bXcjTomvN1GrYQ_bM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmI9CWSNjaxSmNo5eG7BN04rIs-Qxuvi3CIRXwaLhvIA&oe=6B105D55"}, {"file_name": "SceenShot3.png", "id": "684177463249620", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974918_684177466582953_6973669859544944043_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRtXKUecqTMQ7kNvwH9r0hK&_nc_oc=AdpsAy0Dz2RaHWI9VpFOb8Xr8GOXtQBMLWCpvlYE_kDja7UVVWIzZaLYnc0_psaVDyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVP9V5WLFI1A8HP86jkDE7YYWJePxE2He8Scf4eysZxIQ&oe=6B104B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1950457258630720", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982688_1950457261964053_3591401404786363413_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhnksgISpPkQ7kNvwEOCvuQ&_nc_oc=AdoQcsehh9G-Y4hDVz1KeptuD0MmIsE08qzUvZbS801dcr-qWQ60Hr9mYErK1g70N7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgeoIEjBNccU-5Zmxj6EDuhGBbK9H-zkcg7PO0Q8xmhg&oe=6B104854"}, "display_name": "Blocks", "keywords": [], "long_description": "This experience has a colliding points system. Use it if you want or ignore it. When two blocks collide, a point is given. Challenge a friend to see who can get the longest domino effect or chain reaction.  It can be as challenging or as simple as you like. This is a very casual experience allowing the user to play and enjoy as they desire.\n\nControllers-\n\nClean up or reset map: Press Y or B on your Oculus controllers\nTeleportation: Hold down on Left or Right joystick on on either of your Oculus controllers .X or A  will also work \nGrab Blocks: Left or Right grasp buttons on your Oculus controller", "short_description": "Blocks! Domino effect or chain reaction experience. Blocks is an experience that allows full use of ones imagination to create your very own block experience. Many people enjoy the domino effect or chain reaction of stacking and knocking over blocks.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://beeevolved.com/ppblocks.html", "developer_terms_of_service_url": "https://beeevolved.com/tos.html", "publisher_name": "Bee Evolved", "support_website_url": null, "website_url": "https://beeevolved.com/blocks.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1138190583508623"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1188425599568793"}, {"status": "PUBLISHED", "id": "1168879644874794"}, {"status": "PUBLISHED", "id": "726157119126508"}]}, "baseline_offer": {"id": "1168879644874794"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743534000, "status": "PUBLISHED", "id": "1188425599568793"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6070849406267837", "version": "1.0"}, "id": "479488827414741", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6070476512971793", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6070849406267837"}, "release_status": "RELEASED"}, "binary_release_c
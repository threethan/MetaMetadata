nuUYadHaJVWlw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0W9sRqYOV0mdyu4vaTt7NZd1qcD9nR-2I8ygy-yYzewg&oe=69F1FD8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1950457258630720", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1950457261964053_3591401404786363413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-IjZaGZmTQQ7kNvwFPiOVV&_nc_oc=AdoRaf2fLMJOcyxjOpLFJQya8NEO7B3QCHSan3g5apt2NGseIoePIQHduvCotlKw1dw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2YvQXYcXLYMysYT_bMqcztGu_kPbcUfqOMGoXcxzbEug&oe=69F1FA94"}, "display_name": "Blocks", "keywords": [], "long_description": "This experience has a colliding points system. Use it if you want or ignore it. When two blocks collide, a point is given. Challenge a friend to see who can get the longest domino effect or chain reaction.  It can be as challenging or as simple as you like. This is a very casual experience allowing the user to play and enjoy as they desire.\n\nControllers-\n\nClean up or reset map: Press Y or B on your Oculus controllers\nTeleportation: Hold down on Left or Right joystick on on either of your Oculus controllers .X or A  will also work \nGrab Blocks: Left or Right grasp buttons on your Oculus controller", "short_description": "Blocks! Domino effect or chain reaction experience. Blocks is an experience that allows full use of ones imagination to create your very own block experience. Many people enjoy the domino effect or chain reaction of stacking and knocking over blocks.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://beeevolved.com/ppblocks.html", "developer_terms_of_service_url": "https://beeevolved.com/tos.html", "publisher_name": "Bee Evolved", "support_website_url": null, "website_url": "https://beeevolved.com/blocks.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
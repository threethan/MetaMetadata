3d1Czu4HMC69emoQ&oe=6AF88A00"}, {"file_name": "Untitled design (10).png", "id": "798974032085277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974879_798974035418610_7965200548686806307_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evhhWIGrAQ0Q7kNvwEAS42x&_nc_oc=AdpPqvq6BtqlZ2sm8AfaS1HQc5eN3zQvm3rQjKm_5WVyl3PWteRHn4u5i0lrf7V_MNM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmoFiPwqYIHxfZnxjvX3Fs8-EsBexusgnxr1R5b9Mvfw&oe=6AF89036"}, {"file_name": "Untitled design (11).png", "id": "798090161679362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75556807_798090165012695_1006035555450730742_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV0_me2keGoQ7kNvwGhriDB&_nc_oc=Adrkpc2JB86JEBE9ofwmaB_d9PEzWe542XybCe2qJP4jxIiWADd-FWAWzbTFULx-Ye4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuxs4KMoa76fClDYNWPNaavquFbJv11ftJMG-1s7qiMA&oe=6AF89E6D"}, {"file_name": "Untitled design (12).png", "id": "7274495839324312", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003274_7274495845990978_1886240353934629070_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkDNAJFWnXoQ7kNvwHGlbNP&_nc_oc=AdpuJJX0lWvxOsIcxLal9eUpeMYbkpullbDB5mWkoZPe4eWNacE7QYEbDIPjbKQcnyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdxDs4aYTIucnRiEe64u_1Co4QOn0Ago62fJJwG_mtdQ&oe=6AF89A64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (13).png", "id": "1571421826749679", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/428945069_1571421830083012_5094945654421291381_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NVYm1L3s4YQ7kNvwEMD4_Y&_nc_oc=AdojtayCB12zXf7HtK9VVtKsm1RxZgOnScUbX_A2916sqTXE_xDquje-tTfx0Lp_M0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuoRX2SAESDSkZ4w5__fHO3aFc3Sbn1HoO4_UIUZegdA&oe=6AF8AC08"}, "display_name": "Facilitate", "keywords": ["training", "workplace"], "long_description": "Facilitate is a cutting-edge, no-code VR Training Creation Platform that empowers you to design custom VR training modules with ease and efficiency. Facilitate is a game-changer for businesses looking to streamline onboarding, compliance training, hazard identification, site induction, and procedural training.\n\nWith Facilitate, you can import a wide array of file types, including popular 2D formats like PDF, PNG, JPG, MP4, and MP3, as well as immersive 3D formats such as OBJ and FBX files. The platform\u2019s 360 Scenario Creator allows you to enhance your 360 Media, create immersive scenes. Alternatively, turn your 3D models into Micro-simulations to provide your trainees with scalable hands-on practical training experiences.\n\nThe platform\u2019s experience creator is a powerful tool that lets you structure your immersive assets into a comprehensive lesson. Once your lesson is ready, you can publish it to multiple devices with ease, or export it as a SCORM package or URL link.\n\nFacilitate supports enterprise-wide VR adoption, enabling organizations to deliver engaging, interactive training modules as the norm in workplace training. By prioritizing user-friendliness and accessibility, Facilitate is the platform of choice for organizations that aim to future-proof their training programs, ensuring that they can easily transition to immersive learning environments.", "short_description": "Facilitate is a cutting-edge, no-code VR Training Creation Platform that empowers you to design custom VR training modules with ease and efficiency. Facilitate is a game-changer for businesses looking to streamline onboarding, compliance training, hazard identification, site induction, and procedural training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facilitate.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Unleashed PTY LTD", "support_website_url": "https://www.facilitate.tech/contact-us", "website_url": "https://www.facilitate.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "PRODUCTIVITY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8628970570523112"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295751_338923375404264_1864362784534554708_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_E2EQ5DJr0Q7kNvwELnDiD&_nc_oc=AdrnCgvKTg4J7_qyGpp05lZRVh8oGrWEl3XT4eLrHAvqIC1Rg2cGx6fB3a1ZVn5rt9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVvD8OH8ma9V6BpO_h1EX-vo0utOw6BWeFi9hKIf-T8Q&oe=6AF8944F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Facilitate", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1645563322, "lastRevision": {"nodes": [{"id": "1969059786610264", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4738794706207404", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id
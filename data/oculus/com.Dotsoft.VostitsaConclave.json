 "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24092681430431475", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "772114439117763"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Vostitsa Cover Art Landscape - Greek.png", "id": "1488933442233820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823783_1488933448900486_8029438626575271267_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itkhxNMvclcQ7kNvwHSTbQz&_nc_oc=Adod3dNSPwyKUOb6raNwuTPjAxqFxWA6Nz9d6IR_2ELEgJkSccMlbSRNh7r4TIWdgUc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0Am0j1B8tqp0Pb9n70a1Ma7b90a0w8IoRJKREQjBfHg&oe=69CFBEB7"}, {"file_name": "Vostitsa Cover Art Squarer - Greek.png", "id": "1069846718467898", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823746_1069846721801231_7727343300474117467_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxSmSg0G0o4Q7kNvwHkNxfk&_nc_oc=AdrrugwGGMCj0eXyB4zKnXV5RhE5_xZT_v1Tmg6NnfA8JqnLOlBbpYn8IhNg5AOXotw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afznub3W3iYKu0Cxf6sMkYRYcJ3_JtjEk6WN4XjuqGiiaQ&oe=69CFA91B"}, {"file_name": "Vostitsa Cover Art Portrait - Greek.png", "id": "958448863122764", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823783_958448866456097_5770132656379996170_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-cgCWrgSHAQ7kNvwHDnmrx&_nc_oc=AdpAoTRg9DANtYFSaLhuLTnny3nhFtPPQr-nasREh8eqkXAHXpCjJeJaGaVTJc-5ljo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY9Jtsn-RwGQaxI2MwI2dG0t3InL8DNZJf_JrXqsUFbA&oe=69CFCB96"}]}, "id": "1141248801282869", "locale": "el_GR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u0397 \u03a3\u03c5\u03bd\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u0392\u03bf\u03c3\u03c4\u03af\u03c4\u03c3\u03b1\u03c2", "keywords": ["\u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1", "\u03b5\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7", "1821", "\u03b5\u03bb\u03bb\u03ac\u03b4\u03b1", "\u03b4\u03bf\u03ba\u03b9\u03bc\u03b1\u03c3\u03af\u03b5\u03c2"], "long_description": "\u0397 \u03a3\u03c5\u03bd\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u0392\u03bf\u03c3\u03c4\u03af\u03c4\u03c3\u03b1\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bd\u03b1 VR \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9  \u03c0\u03bf\u03c5 \u03c3\u03b5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c3\u03c4\u03b9\u03c2 \u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c5\u03bd\u03b5\u03bb\u03b5\u03cd\u03c3\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03b5\u03c4\u03bf\u03af\u03bc\u03b1\u03c3\u03b1\u03bd \u03c4\u03b7\u03bd \u0395\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ae \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03bf\u03c5 1821. \u03a3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03bf\u03bd\u03c4\u03b1\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7, \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf\u03bd \u03c1\u03cc\u03bb\u03bf \u03c4\u03bf\u03c5 \u039b\u03ad\u03bf\u03bd\u03c4\u03b1 \u039c\u03b5\u03c3\u03c3\u03b7\u03bd\u03ad\u03b6\u03b7, \u03b5\u03bd\u03cc\u03c2 \u03b5\u03bc\u03c0\u03cc\u03c1\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03bc\u03c5\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7 \u03a6\u03b9\u03bb\u03b9\u03ba\u03ae \u0395\u03c4\u03b1\u03b9\u03c1\u03b5\u03af\u03b1.\n\n\u03a3\u03c5\u03bd\u03b1\u03bd\u03c4\u03ac\u03c2 \u03b5\u03bc\u03b2\u03bb\u03b7\u03bc\u03b1\u03c4\u03b9\u03ba\u03ad\u03c2 \u03bc\u03bf\u03c1\u03c6\u03ad\u03c2 \u03cc\u03c0\u03c9\u03c2 \u03c4\u03bf\u03bd \u03a0\u03b1\u03c0\u03b1\u03c6\u03bb\u03ad\u03c3\u03c3\u03b1, \u03c4\u03bf\u03bd \u0391\u03bd\u03b4\u03c1\u03ad\u03b1 \u039b\u03cc\u03bd\u03c4\u03bf \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5\u03c2 \u0396\u03b1\u0390\u03bc\u03b7\u03b4\u03b5\u03c2, \u03ba\u03b1\u03b8\u03ce\u03c2 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03b5\u03b9\u03c2 \u03c3\u03b5 \u03ba\u03c1\u03af\u03c3\u03b9\u03bc\u03b5\u03c2 \u03c3\u03c5\u03b6\u03b7\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2, \u03b1\u03bd\u03b1\u03ba\u03b1\u03bb\u03cd\u03c0\u03c4\u03b5\u03b9\u03c2 \u03ba\u03c1\u03c5\u03bc\u03bc\u03ad\u03bd\u03b1 \u03bc\u03b7\u03bd\u03cd\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03c4\u03b9\u03bc\u03b5\u03c4\u03c9\u03c0\u03af\u03b6\u03b5\u03b9\u03c2 \u03b7\u03b8\u03b9\u03ba\u03ac \u03b4\u03b9\u03bb\u03ae\u03bc\u03bc\u03b1\u03c4\u03b1. \u039f\u03b9 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ad\u03c2 \u03c3\u03bf\u03c5 \u03ba\u03b1\u03b8\u03bf\u03c1\u03af\u03b6\u03bf\u03c5\u03bd \u03c4\u03bf\u03bd \u03c4\u03cc\u03bd\u03bf \u03c4\u03b7\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03c2 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03c4\u03c1\u03af\u03b1 \u03b1\u03c1\u03c7\u03ad\u03c4\u03c5\u03c0\u03b1 \u03c1\u03cc\u03bb\u03c9\u03bd, \u03bc\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03ae\u03c1\u03b5\u03c2 \u03bd\u03b1 \u03b1\u03bd\u03c4\u03b9\u03b4\u03c1\u03bf\u03cd\u03bd \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ac \u03c3\u03c4\u03b9\u03c2 \u03b1\u03c0\u03b1\u03bd\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c3\u03bf\u03c5.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03b5\u03b9 \u03b1\u03c6\u03b7\u03b3\u03b7\u03bc\u03b1\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2, \u03b5\u03c1\u03c9\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c4\u03cd\u03c0\u03bf\u03c5 quiz \u03ba\u03b1\u03b9 \u03b1\u03c0\u03c4\u03b9\u03ba\u03ac VR puzzles \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03c0\u03b1\u03c1\u03b9\u03c3\u03c4\u03bf\u03cd\u03bd \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ad\u03c2 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b5\u03bb\u03b5\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2. \n\n\u039c\u03b5 \u03c0\u03bb\u03ae\u03c1\u03b7 \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ce\u03bd \u03ba\u03b1\u03b9 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ce\u03bd, \u03b7 \u03a3\u03c5\u03bd\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u0392\u03bf\u03c3\u03c4\u03af\u03c4\u03c3\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03b5\u03b9 \u03bc\u03b9\u03b1 \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b3\u03b9\u03b1 \u03bc\u03b1\u03b8\u03b7\u03c4\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03c0\u03bb\u03bf\u03cd\u03c3\u03b9\u03bf \u03b1\u03c6\u03b7\u03b3\u03b7\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c4\u03b1\u03be\u03af\u03b4\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b1\u03be\u03b9\u03b4\u03b9\u03ce\u03c4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03bb\u03ac\u03c4\u03c1\u03b5\u03b9\u03c2 \u03c4\u03b7\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03c2. \u0395\u03af\u03c4\u03b5 \u03bc\u03cc\u03bd\u03bf\u03c2 \u03b5\u03af\u03c4\u03b5 \u03c0\u03b1\u03c1\u03ac\u03bb\u03bb\u03b7\u03bb\u03b1 \u03bc\u03b5 \u03ac\u03bb\u03bb\u03bf\u03c5\u03c2, \u03b8\u03b1 \u03b2\u03c1\u03b5\u03b8\u03b5\u03af\u03c2 \u03c3\u03c4\u03b7\u03bd \u03ba\u03b1\u03c1\u03b4\u03b9\u03ac \u03c4\u03c9\u03bd \u03b3\u03b5\u03b3\u03bf\u03bd\u03cc\u03c4\u03c9\u03bd \u03c0\u03bf\u03c5 \u03ac\u03bd\u03b1\u03c8\u03b1\u03bd \u03c4\u03b7 \u03c6\u03bb\u03cc\u03b3\u03b1 \u03c4\u03b7\u03c2 \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2.", "short_description": "\u0396\u03ae\u03c3\u03b5 \u03c4\u03bf 1821 \u03c3\u03b5 VR. \u039c\u03c5\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c5\u03bd\u03b5\u03bb\u03b5\u03cd\u03c3\u03b5\u03b9\u03c2, \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7."}, {"images": {"nodes": [{"file_name": "filiki_etairia_logo_transparent.png", "id": "24531043596526022", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819323_24531043603192688_4327758919651316059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8L-NfxHQpVwQ7kNvwH0mki4&_nc_oc=AdrVZTHvCJaW1aTWdIG_5CFam5Ajivg02XXoj2k024-66SsA0jpdyl_tdZy8emeM-W8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFNCifB805NYZBeZwHbBJljfivKzf4otgQv0GKJeUHlw&oe=69CF9F94"}, {"file_name": "Vostitsa Cover Art Landscape - English.png", "id": "2488558314862002", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823279_2488558318195335_1949768472220244287_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8f3VbEaARIQ7kNvwEvQ_R0&_nc_oc=AdqkJxKV5pLZIGYsToYpwMTj6QtX0NFmpHK_UWxLMNjAW7hwSIxFioO4II0slZmNfQA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQ8LneGTwX5pjtIUkzPGRBWFf-mEMJECwDucIlOlt90A&oe=69CFD2BF"}, {"file_name": "filiki_etairia_logo-512.png", "id": "1519122625762190", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819323_1519122629095523_3478311123842203899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCCTlJeuk68Q7kNvwGLwO_1&_nc_oc=Adq3JXLDZlvhPLJUbP1mwZ-BlQIPg4si4e1ccAOdNYnBJtcNJ3HF3ijqH49xIZcW9NE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwc42GfyFNNj-iYs6M_Y861WwwPPtOyFVRZ-cbdd-HbCw&oe=69CFAFE0"}, {"file_name": "Vostitsa Cover Art Portrait - English.png", "id": "1222143403289494", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820923_1222143406622827_5219972000319860111_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkd5LB
_7025819202275101218_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VJfM9DSAcEQ7kNvwHpocXZ&_nc_oc=Adqo0xx86eWq1u4Zjs4HXtF7LfyINLTCP6nLEYDIGLN76LboGBzwZHdJ4b0403n2yHc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ORRwcntU2IhKDTZv5n5VIM82YCq4Vqc1A54K67-Uelw&oe=6A46600E"}, {"file_name": "image sequence_011_0000.png", "id": "796658643116422", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820887_796658649783088_2426701804236810431_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL6jzNf24egQ7kNvwGgv2U7&_nc_oc=Adq0BGXxi4pJ4NQ6uYnCeMGrof_lxQiKxnZ0OTRC-EsUH8sKvZholaNkoskIAPH33PA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p_ruA0iBdZGp4re6eLkdUwJBtGrGn4LSRqDysSIV7VA&oe=6A465E2D"}, {"file_name": "image sequence_005_0000.png", "id": "1525883345508210", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820887_1525883352174876_935639810313410934_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bS_6gVYm0gQ7kNvwEBUyYR&_nc_oc=Adps-3QlbjfFAIm4LItvGWlk5mhfB55NHlmDkB-N3qTnqClKJH9UYfUEJ18l82x0YEs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1hWOylWINNpNjLaXTo3ddE4xySgQYBhelIVnkCNyLzw&oe=6A468D33"}, {"file_name": "image sequence_013_0000.png", "id": "1334476211584439", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823259_1334476214917772_1892714030025945428_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAvOIALKVkoQ7kNvwHwmVeq&_nc_oc=Adq1jGMkrMZiw4jTmZXDjmXZ8Tzbxx-0kc_ZTb5kjJYEQyG7SbJGz5Y0ITFOWD1k_gA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83BAOa2fCvrZ8GbzB_bNn21J73UcIwwbDPz45Wx1Q8YQ&oe=6A467A56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Vostitsa Conclave", "keywords": ["puzzle", "history", "story", "1821", "revolution"], "long_description": "Vostitsa Conclave is a first-person VR narrative adventure that immerses you in the clandestine gatherings that sparked the Greek Revolution of 1821. Blending history with interactive storytelling, the game lets you take the role of Leon Messen\u00e9zis, a wealthy merchant drawn into the secretive Filiki Eteria.\n\nEngage with iconic figures such as Papaflessas, Andreas Londos, and the Zaimis brothers as you navigate tense councils, uncover hidden messages, and face moral dilemmas. Your choices shape the tone of the story through branching roleplay archetypes,  each reflected in dynamic NPC reactions.\n\nThe experience combines narrative dialogues, quiz-style challenges, and tactile VR puzzles that bring historical rituals and secret proceedings to life. \n\nWith full English and Greek support, Vostitsa Conclave offers both an educational journey for younger players and a rich, story-driven experience for cultural explorers. Whether alone or in quiet parallel with others, you will step into the shadows of history, where every word and action could tip the balance toward revolution.", "short_description": "Step into 1821. A VR story of secret councils, choices, and uprising."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/en/privacy-policy-vostitsa-conclave", "developer_terms_of_service_url": null, "publisher_name": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b9\u03b3\u03b9\u03b1\u03bb\u03b5\u03af\u03b1\u03c2", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STA
null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Vostitsa Cover Art Landscape - Greek.png", "id": "1488933442233820", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1488933448900486_8029438626575271267_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK0dxK6nYtgQ7kNvwHUJ7ii&_nc_oc=Adoi554VOOmcFAAOzXCiCvpFHCnm8SzGfYWYYo6FYxEnkvmCbY7j4VJbTTISPMoPvU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOKsEUs1fokNbTVkq0KGPZYGTBUFZPyyWTI5I4eJACzg&oe=6A60C3B7"}, {"file_name": "Vostitsa Cover Art Squarer - Greek.png", "id": "1069846718467898", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823746_1069846721801231_7727343300474117467_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qEqtRwVlVEQ7kNvwF0T60m&_nc_oc=AdqVl0RxsC8gYopaWs7pNsitIW69Wc5ptuPOCNbCPPmzSlO6S60qHwo-L_XXJoQY97Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbSBVruqXfMcaYYoNai5IZCZtRdi-cinDp7EFe2XNI3Q&oe=6A60AE1B"}, {"file_name": "Vostitsa Cover Art Portrait - Greek.png", "id": "958448863122764", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_958448866456097_5770132656379996170_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdk9cGgPdhYQ7kNvwGIkAfj&_nc_oc=Adq9sv5_E6bJ70Dw5ayWWmOONG_BERqabUgBRdTd8m0ClXxfhiFOkWsOGVLnZGQpneM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ7_KB1BALn7HWhbQJVnnhhf6weVib_6Kgg-zxxN0vFA&oe=6A60D096"}]}, "id": "1562701802166841", "locale": "el_GR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u0397 \u03a3\u03c5\u03bd\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u0392\u03bf\u03c3\u03c4\u03af\u03c4\u03c3\u03b1\u03c2", "keywords": ["\u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1", "\u03b5\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7", "1821", "\u03b5\u03bb\u03bb\u03ac\u03b4\u03b1", "\u03b4\u03bf\u03ba\u03b9\u03bc\u03b1\u03c3\u03af\u03b5\u03c2"], "long_description": "\u0397 \u03a3\u03c5\u03bd\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u0392\u03bf\u03c3\u03c4\u03af\u03c4\u03c3\u03b1\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03bd\u03b1 VR \u03c0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9  \u03c0\u03bf\u03c5 \u03c3\u03b5 \u03bc\u03b5\u03c4\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c3\u03c4\u03b9\u03c2 \u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c5\u03bd\u03b5\u03bb\u03b5\u03cd\u03c3\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03b5\u03c4\u03bf\u03af\u03bc\u03b1\u03c3\u03b1\u03bd \u03c4\u03b7\u03bd \u0395\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ae \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03bf\u03c5 1821. \u03a3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03bf\u03bd\u03c4\u03b1\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7, \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf\u03bd \u03c1\u03cc\u03bb\u03bf \u03c4\u03bf\u03c5 \u039b\u03ad\u03bf\u03bd\u03c4\u03b1 \u039c\u03b5\u03c3\u03c3\u03b7\u03bd\u03ad\u03b6\u03b7, \u03b5\u03bd\u03cc\u03c2 \u03b5\u03bc\u03c0\u03cc\u03c1\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03bc\u03c5\u03b5\u03af\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7 \u03a6\u03b9\u03bb\u03b9\u03ba\u03ae \u0395\u03c4\u03b1\u03b9\u03c1\u03b5\u03af\u03b1.\n\n\u03a3\u03c5\u03bd\u03b1\u03bd\u03c4\u03ac\u03c2 \u03b5\u03bc\u03b2\u03bb\u03b7\u03bc\u03b1\u03c4\u03b9\u03ba\u03ad\u03c2 \u03bc\u03bf\u03c1\u03c6\u03ad\u03c2 \u03cc\u03c0\u03c9\u03c2 \u03c4\u03bf\u03bd \u03a0\u03b1\u03c0\u03b1\u03c6\u03bb\u03ad\u03c3\u03c3\u03b1, \u03c4\u03bf\u03bd \u0391\u03bd\u03b4\u03c1\u03ad\u03b1 \u039b\u03cc\u03bd\u03c4\u03bf \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5\u03c2 \u0396\u03b1\u0390\u03bc\u03b7\u03b4\u03b5\u03c2, \u03ba\u03b1\u03b8\u03ce\u03c2 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03b5\u03b9\u03c2 \u03c3\u03b5 \u03ba\u03c1\u03af\u03c3\u03b9\u03bc\u03b5\u03c2 \u03c3\u03c5\u03b6\u03b7\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2, \u03b1\u03bd\u03b1\u03ba\u03b1\u03bb\u03cd\u03c0\u03c4\u03b5\u03b9\u03c2 \u03ba\u03c1\u03c5\u03bc\u03bc\u03ad\u03bd\u03b1 \u03bc\u03b7\u03bd\u03cd\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03c4\u03b9\u03bc\u03b5\u03c4\u03c9\u03c0\u03af\u03b6\u03b5\u03b9\u03c2 \u03b7\u03b8\u03b9\u03ba\u03ac \u03b4\u03b9\u03bb\u03ae\u03bc\u03bc\u03b1\u03c4\u03b1. \u039f\u03b9 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ad\u03c2 \u03c3\u03bf\u03c5 \u03ba\u03b1\u03b8\u03bf\u03c1\u03af\u03b6\u03bf\u03c5\u03bd \u03c4\u03bf\u03bd \u03c4\u03cc\u03bd\u03bf \u03c4\u03b7\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03c2 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03c4\u03c1\u03af\u03b1 \u03b1\u03c1\u03c7\u03ad\u03c4\u03c5\u03c0\u03b1 \u03c1\u03cc\u03bb\u03c9\u03bd, \u03bc\u03b5 \u03c4\u03bf\u03c5\u03c2 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03ae\u03c1\u03b5\u03c2 \u03bd\u03b1 \u03b1\u03bd\u03c4\u03b9\u03b4\u03c1\u03bf\u03cd\u03bd \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ac \u03c3\u03c4\u03b9\u03c2 \u03b1\u03c0\u03b1\u03bd\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c3\u03bf\u03c5.\n\n\u0397 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03b5\u03b9 \u03b1\u03c6\u03b7\u03b3\u03b7\u03bc\u03b1\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2, \u03b5\u03c1\u03c9\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c4\u03cd\u03c0\u03bf\u03c5 quiz \u03ba\u03b1\u03b9 \u03b1\u03c0\u03c4\u03b9\u03ba\u03ac VR puzzles \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03c0\u03b1\u03c1\u03b9\u03c3\u03c4\u03bf\u03cd\u03bd \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ad\u03c2 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b5\u03bb\u03b5\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b5\u03c2. \n\n\u039c\u03b5 \u03c0\u03bb\u03ae\u03c1\u03b7 \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ce\u03bd \u03ba\u03b1\u03b9 \u03b1\u03b3\u03b3\u03bb\u03b9\u03ba\u03ce\u03bd, \u03b7 \u03a3\u03c5\u03bd\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u0392\u03bf\u03c3\u03c4\u03af\u03c4\u03c3\u03b1\u03c2 \u03c0\u03c1\u03bf\u03c3\u03c6\u03ad\u03c1\u03b5\u03b9 \u03bc\u03b9\u03b1 \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03b3\u03b9\u03b1 \u03bc\u03b1\u03b8\u03b7\u03c4\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03c0\u03bb\u03bf\u03cd\u03c3\u03b9\u03bf \u03b1\u03c6\u03b7\u03b3\u03b7\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc \u03c4\u03b1\u03be\u03af\u03b4\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b1\u03be\u03b9\u03b4\u03b9\u03ce\u03c4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03bb\u03ac\u03c4\u03c1\u03b5\u03b9\u03c2 \u03c4\u03b7\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03c2. \u0395\u03af\u03c4\u03b5 \u03bc\u03cc\u03bd\u03bf\u03c2 \u03b5\u03af\u03c4\u03b5 \u03c0\u03b1\u03c1\u03ac\u03bb\u03bb\u03b7\u03bb\u03b1 \u03bc\u03b5 \u03ac\u03bb\u03bb\u03bf\u03c5\u03c2, \u03b8\u03b1 \u03b2\u03c1\u03b5\u03b8\u03b5\u03af\u03c2 \u03c3\u03c4\u03b7\u03bd \u03ba\u03b1\u03c1\u03b4\u03b9\u03ac \u03c4\u03c9\u03bd \u03b3\u03b5\u03b3\u03bf\u03bd\u03cc\u03c4\u03c9\u03bd \u03c0\u03bf\u03c5 \u03ac\u03bd\u03b1\u03c8\u03b1\u03bd \u03c4\u03b7 \u03c6\u03bb\u03cc\u03b3\u03b1 \u03c4\u03b7\u03c2 \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2.", "short_description": "\u0396\u03ae\u03c3\u03b5 \u03c4\u03bf 1821 \u03c3\u03b5 VR. \u039c\u03c5\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c5\u03bd\u03b5\u03bb\u03b5\u03cd\u03c3\u03b5\u03b9\u03c2, \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7."}, {"images": {"nodes": [{"file_name": "filiki_etairia_logo_transparent.png", "id"
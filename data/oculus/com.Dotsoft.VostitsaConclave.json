19202275101218_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHqiNDW_y4YQ7kNvwFSYI5c&_nc_oc=AdryeIKw4Rvk5IkJRoEWhAq-NBJW9rkQW3mYPFMXAwSR2gmrVZAlZjzeveuVYg8ZHws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af929wCh1xKRSDU0qbf7ZC8hdaPd-_r7pA77Yre0bPIAvg&oe=6A37DF8E"}, {"file_name": "image sequence_011_0000.png", "id": "796658643116422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_796658649783088_2426701804236810431_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PI5atTjno5YQ7kNvwHoJr55&_nc_oc=Adobd5T_a0Ral7gihf0z-tbXVGYoiIyA7sHjxc2z8Qpg6R0OXXCgjE8ZT4BOTL_IyXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ON2NnL9Y2tUSKMXzpRS_80zNsYgxIBnYKVUX1VgqsNw&oe=6A37DDAD"}, {"file_name": "image sequence_005_0000.png", "id": "1525883345508210", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_1525883352174876_935639810313410934_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2DOlJzcDn0Q7kNvwH4n5kV&_nc_oc=Adr7AlfyLrQm5WsELxL5U_laBFNO1juU81hYuQOzJzHugtA7yltvDfK2dUor0Pvr4yc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2VTC4H8hs_PYT7HvVXwraEwRcjXa8IOsfjld5Bv8Yqg&oe=6A380CB3"}, {"file_name": "image sequence_013_0000.png", "id": "1334476211584439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1334476214917772_1892714030025945428_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRV7XmL2QEgQ7kNvwHPmAYG&_nc_oc=AdqJpXSt8C1IxndzySi-nNybb3d_BWZoE5SfAr4iSNTIMCjKoBNE7xCK9bxiiPSbfkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YJMU8puXDFDd35ROzBOmSNLoV5B-r3Dvuz4h4OKg07A&oe=6A37F9D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Vostitsa Conclave", "keywords": ["puzzle", "history", "story", "1821", "revolution"], "long_description": "Vostitsa Conclave is a first-person VR narrative adventure that immerses you in the clandestine gatherings that sparked the Greek Revolution of 1821. Blending history with interactive storytelling, the game lets you take the role of Leon Messen\u00e9zis, a wealthy merchant drawn into the secretive Filiki Eteria.\n\nEngage with iconic figures such as Papaflessas, Andreas Londos, and the Zaimis brothers as you navigate tense councils, uncover hidden messages, and face moral dilemmas. Your choices shape the tone of the story through branching roleplay archetypes,  each reflected in dynamic NPC reactions.\n\nThe experience combines narrative dialogues, quiz-style challenges, and tactile VR puzzles that bring historical rituals and secret proceedings to life. \n\nWith full English and Greek support, Vostitsa Conclave offers both an educational journey for younger players and a rich, story-driven experience for cultural explorers. Whether alone or in quiet parallel with others, you will step into the shadows of history, where every word and action could tip the balance toward revolution.", "short_description": "Step into 1821. A VR story of secret councils, choices, and uprising."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/en/privacy-policy-vostitsa-conclave", "developer_terms_of_service_url": null, "publisher_name": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b9\u03b3\u03b9\u03b1\u03bb\u03b5\u03af\u03b1\u03c2", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
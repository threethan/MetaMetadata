19202275101218_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w58hf7hK54gQ7kNvwHs3gTu&_nc_oc=AdqJoOVn5Xo0jebSy0jVjisgTn1_clw2JFn1AVrrxgVFUd7mGuKGANhZ2iXf9Z4PsKg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e17bk9BSe2T0MHsTTrRL0RLvBjFiaRcn-nZxJ55uIRQ&oe=6A1C300E"}, {"file_name": "image sequence_011_0000.png", "id": "796658643116422", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820887_796658649783088_2426701804236810431_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15yGeMO_zjYQ7kNvwEvjJ1k&_nc_oc=AdpN1VfEpxATQtgxWQV1azQVGEv3lPuVXzLrlplgh8OBL4l1VwOdiot8wCUpOBTA1Og&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ydbic0w6vTLkODMHtHv4kK5B-1ctjYyxdojW8cxgZIg&oe=6A1C2E2D"}, {"file_name": "image sequence_005_0000.png", "id": "1525883345508210", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820887_1525883352174876_935639810313410934_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTqdm5TuljsQ7kNvwGtiGZb&_nc_oc=Adovz7UwvxQA7B2R6JyUfDMi1C3ZwmW2N2ruBOygX1HSZCV8BlsLfaT5OdIy5dw0uQI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68yg5pyPfgEL6szOEMMCFxRzF-qhcTahY0S1wHbZKidA&oe=6A1C5D33"}, {"file_name": "image sequence_013_0000.png", "id": "1334476211584439", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823259_1334476214917772_1892714030025945428_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa_pe8ysP6oQ7kNvwGA_rIQ&_nc_oc=AdpqmyZGUs6J4NUyVvzAabQzrVo0a5Hw7eIMiwDNj0vgU2Ic7xaDwheaua_dbJo6ZN8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pmm3AiKqs8evbWQVQQktCOPN1SwjgFGnWhImPKOMrCQ&oe=6A1C4A56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Vostitsa Conclave", "keywords": ["puzzle", "history", "story", "1821", "revolution"], "long_description": "Vostitsa Conclave is a first-person VR narrative adventure that immerses you in the clandestine gatherings that sparked the Greek Revolution of 1821. Blending history with interactive storytelling, the game lets you take the role of Leon Messen\u00e9zis, a wealthy merchant drawn into the secretive Filiki Eteria.\n\nEngage with iconic figures such as Papaflessas, Andreas Londos, and the Zaimis brothers as you navigate tense councils, uncover hidden messages, and face moral dilemmas. Your choices shape the tone of the story through branching roleplay archetypes,  each reflected in dynamic NPC reactions.\n\nThe experience combines narrative dialogues, quiz-style challenges, and tactile VR puzzles that bring historical rituals and secret proceedings to life. \n\nWith full English and Greek support, Vostitsa Conclave offers both an educational journey for younger players and a rich, story-driven experience for cultural explorers. Whether alone or in quiet parallel with others, you will step into the shadows of history, where every word and action could tip the balance toward revolution.", "short_description": "Step into 1821. A VR story of secret councils, choices, and uprising."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/en/privacy-policy-vostitsa-conclave", "developer_terms_of_service_url": null, "publisher_name": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b9\u03b3\u03b9\u03b1\u03bb\u03b5\u03af\u03b1\u03c2", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"
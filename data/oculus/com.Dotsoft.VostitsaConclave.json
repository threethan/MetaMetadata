qi_BHwAajvMi_f5uVM4Z5GkZDom4ha7NWB3mIXroem4yDjzTcI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7HFT4gH6bNO8MFgZ89OE2dET3EOhCxr7S7zdiKwymrw&oe=6B09B64E"}, {"file_name": "image sequence_011_0000.png", "id": "796658643116422", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820887_796658649783088_2426701804236810431_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3TVSwhX0e0Q7kNvwF7prep&_nc_oc=AdrsF8ur3s6QFGq50DYmU6CRTrnrtC1DL6frrKXCpCYYSLTy4Y8ghE7IWj8ul0-39bg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR87nSadE7GlalOjHYkKb1brbegx7vlxAOTZWSGBCN0bQ&oe=6B09B46D"}, {"file_name": "image sequence_005_0000.png", "id": "1525883345508210", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491820887_1525883352174876_935639810313410934_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAxF2OjPP-sQ7kNvwFHaxmj&_nc_oc=AdrPU6y1XVm58Fhojm_BB5PlQEe6hK8ne-dL_9enT1gEuSe8Xr9BoUWJLD68JSBPM-Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8z0MuOc5RhQMmkqJvJ-PVWptMlYto_bpy2nN5ym-n6A&oe=6B09AB33"}, {"file_name": "image sequence_013_0000.png", "id": "1334476211584439", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1334476214917772_1892714030025945428_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8yaiFEmi88Q7kNvwGnAa_t&_nc_oc=AdqybOy6ozty9cBmzLlnjkfwMFum1NT1WQQGyVpTmUs47lknF2RQX5307p5rylKchWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ45-JGS6uNkAKVeMqLUBONoBQ_ppVgaOIR-ZytHIDdKA&oe=6B09D096"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Vostitsa Conclave", "keywords": ["puzzle", "history", "story", "1821", "revolution"], "long_description": "Vostitsa Conclave is a first-person VR narrative adventure that immerses you in the clandestine gatherings that sparked the Greek Revolution of 1821. Blending history with interactive storytelling, the game lets you take the role of Leon Messen\u00e9zis, a wealthy merchant drawn into the secretive Filiki Eteria.\n\nEngage with iconic figures such as Papaflessas, Andreas Londos, and the Zaimis brothers as you navigate tense councils, uncover hidden messages, and face moral dilemmas. Your choices shape the tone of the story through branching roleplay archetypes,  each reflected in dynamic NPC reactions.\n\nThe experience combines narrative dialogues, quiz-style challenges, and tactile VR puzzles that bring historical rituals and secret proceedings to life. \n\nWith full English and Greek support, Vostitsa Conclave offers both an educational journey for younger players and a rich, story-driven experience for cultural explorers. Whether alone or in quiet parallel with others, you will step into the shadows of history, where every word and action could tip the balance toward revolution.", "short_description": "Step into 1821. A VR story of secret councils, choices, and uprising."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/cookies-policy-sponge-conclave/", "developer_terms_of_service_url": null, "publisher_name": "\u0394\u03ae\u03bc\u03bf\u03c2 \u0391\u03b9\u03b3\u03b9\u03b1\u03bb\u03b5\u03af\u03b1\u03c2", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "us
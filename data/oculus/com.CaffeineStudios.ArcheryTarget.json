_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSumiddX5Hk2EyXD5DpVWjOVFP6Aw9GBFy7QUTuSzfag&oe=6B045853"}, {"file_name": "Archery Target - Screenshot 02 - Arrow in Flight.png", "id": "2005544943459186", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593995458_2005544946792519_3092568793668575343_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25GIr4zEE9YQ7kNvwF43Tub&_nc_oc=AdrJUbf5ZAI2JuGl0W4AApwi6M5UhdGw-EaHeWf0qeZAz1dnXOGJx--kYod7LCR9iEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYhmINGwF_2_wJv6GFRxXYG3KSEWJBY6625KV009ipRQ&oe=6B047D75"}, {"file_name": "Archery Target - Screenshot 05 - Outdoor Range.png", "id": "2215839932300844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622195_2215839935634177_4316148955616331008_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNKGI-xlNtEQ7kNvwEC7IMd&_nc_oc=AdpUswHawnyPzszb2ZsVhhGHmU0SCuDhjTtM4iy4YzaulShOOvIJL8jTcPdJtJ3EGv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0R1zRtyNx3pRYiMGVC1EY8g22SIaAT4hpdJUDFHRopg&oe=6B047543"}, {"file_name": "Archery Target - Screenshot 03 - Elevated Target.png", "id": "2021002325257274", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499621314_2021002328590607_5301586943030902640_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s78BaMDU1cQQ7kNvwEZbhSr&_nc_oc=AdpBXDruTlXDSmtU7i4VQmcwKplLGcLQVTaul61XOxmDpHN4whiv3nzpFvGOMgBWiYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpl-sAC36etnsnLgZUae6a2vHfqAUXvqgjyyNbpdGp3A&oe=6B045595"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archery Target - Trailer Cover.png", "id": "1506672017987662", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299876_1506672021320995_5358876636941181271_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDKyiXzDQlYQ7kNvwGr9Ttl&_nc_oc=AdqLzdnXoln_m-ncvvok1IUAS3WwVbOiKubOvKdBPpq58iSDV_3spA7KTl7vGym4-04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrOnbO0CgUM36zaeZJjqLlFi7r0ps_XTPHCAIQY6QxaQ&oe=6B048078"}, "display_name": "Archery Target", "keywords": ["archery", "bow", "shooting", "practice", "bullseye"], "long_description": "Step onto the outdoor range in Archery Target, a VR target shooting game for Meta Quest. Nock an arrow, draw the bowstring, and aim for the center. The closer you land to the bullseye, the more points you earn.\n\n\u2022 Time Attack \u2014 How high can you score in 30 seconds? Follow the target as it changes position and make the most of double-point opportunities.\n\u2022 Perfect Ten \u2014 You have 10 arrows to make your best score. Each bullseye is worth 100 points. Land all 10 for a perfect 1,000.\n\u2022 Infinite \u2014 Practice at your own pace with no timer. The target shifts positions and starts moving as you land more hits. Build your score with multipliers up to 16x. Your run saves as you go, so you can pick up where you left off.\n\nEach mode saves your personal best, so there's always a score to beat.", "short_description": "Draw your bow and aim for the bullseye in Archery Target, a VR archery game for Meta Quest.\n\nRace a 30-second clock in Time Attack, see how high you can score with 10 arrows in Perfect Ten, or take your time with target practice in Infinite.\n\nTrack the moving target and chase a new personal best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscript
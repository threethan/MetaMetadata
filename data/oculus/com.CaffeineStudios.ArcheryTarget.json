71-25/499618297_2063953017669964_3503991273840011981_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8ExbFxWpjgQ7kNvwFVOV93&_nc_oc=AdohCb0IhEa3zp3PrsZX67tdwXP_evzkLjVdo11lgqmar6ENCrZMYKkpw0quk7JttXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bQg9m7zWI8emoQ-aPMLkZuSx3xcfxDvs37zZKMpoqgA&oe=6A37F29B"}, "display_name": "Archery Target", "keywords": ["VRArchery", "BowandArrow", "TargetShooting", "ArcherySimulator", "SportsGame"], "long_description": "Archery\u2019s Target is a fast-paced VR archery game built for Meta Quest.\n\nTest your precision, reflexes, and focus across multiple competitive game modes including Time Mode, Hit Mode, and Infinite Mode. \n\nCompete for high scores, challenge yourself with increasingly difficult targets, and experience immersive bow and arrow gameplay in realistic outdoor environments designed specifically for virtual reality players and VR sports fans.\n\n{1003743998887705}", "short_description": "Step into a fast-paced VR archery challenge built for Meta Quest! \n\nTest your aim in Time Mode, Hit Mode, and Infinite Mode as targets become faster and more difficult. \n\nCompete on leaderboards, improve your high score, and enjoy immersive bow and arrow gameplay designed for VR archery fans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
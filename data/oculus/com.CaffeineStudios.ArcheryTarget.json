b=1-7&_nc_sid=6e7a0a&_nc_ohc=JLHtF3serTkQ7kNvwFWthOw&_nc_oc=AdptS7GC0q_cpiY4vRaT7kdeLy9Hod2zA0b4sy5Uo1LAMVRCuCu9Hv77U74H3zHp6wI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRPmWt6lh5Smf7I1XDUTPDlKCsG60obPyWLyNuJLQU-g&oe=6AB53C45"}, {"file_name": "ChatGPT Image May 8, 2026, 05_49_41 PM (1).png", "id": "1884684368916281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_1884684372249614_8427665361711529308_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUsDgfr7jYQQ7kNvwFzfw_g&_nc_oc=Ado5kAHKiqxtNtGuBLDas8lZdh_TdEE4OaXizD8yqY_AIquV_eb9tpnsdfpV4sGktFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGwPCugagW2_iB090ACmYc139hw1BckGQhpxQGlenLyQ&oe=6AB54282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image May 15, 2026, 05_42_25 PM.png", "id": "2063953014336631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_2063953017669964_3503991273840011981_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1LkSv-uhpMQ7kNvwE706PD&_nc_oc=Adr4OISSejJM2C8oektQHMPksijo7zWYpvil7k5lcZH4dt1Qgt_agIDlM0AmiJrh9hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1yvYqQO4Kx3qPM3V9YwreXEsZd44qVafd4PHOi9fSGQ&oe=6AB5311B"}, "display_name": "Archery Target", "keywords": ["VRArchery", "BowandArrow", "TargetShooting", "ArcherySimulator", "SportsGame"], "long_description": "Step into Archery Target, a fast-paced VR archery game built for Meta Quest. Pick up your bow, aim with precision, release the arrow, and test your focus in an immersive target shooting experience designed for VR sports fans.\n\nChallenge yourself across multiple game modes including Time Mode, Hit Mode, and Infinite Mode. Race against the clock, hit the required targets, or keep shooting as long as you can while improving your accuracy, reflexes, and high score.\n\nArchery Target combines simple controls with satisfying bow and arrow gameplay, making it easy to start but rewarding to master. Whether you want a quick arcade session, a focused aiming challenge, or a relaxing archery simulator, this game gives you a clean and comfortable VR experience in realistic outdoor environments.\n\nFeatures:\n\u2022 Immersive VR bow and arrow gameplay\n\u2022 Time Mode, Hit Mode, and Infinite Mode\n\u2022 Precision target shooting challenges\n\u2022 High-score focused replayability\n\u2022 Comfortable gameplay for sitting, standing, or room-scale play\n\u2022 Works offline with no internet required\n\u2022 Designed for Meta Quest 2, Quest 3, Quest 3S, and Quest Pro\n\nIf you enjoy VR shooting games, archery games, sports games, target practice, aim training, bow games, arcade challenges, or realistic virtual reality experiences, Archery Target is made for you.\n\nTake aim, steady your hand, and become a better VR archer with every shot.", "short_description": "Step into a fast-paced VR archery challenge built for Meta Quest! \n\nTest your aim in Time Mode, Hit Mode, and Infinite Mode as targets become faster and more difficult. \n\nCompete on leaderboards, improve your high score, and enjoy immersive bow and arrow gameplay designed for VR archery fans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
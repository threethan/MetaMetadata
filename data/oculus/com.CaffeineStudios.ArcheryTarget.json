ep into a fast-paced VR archery challenge built for Meta Quest! \n\nTest your aim in Time Mode, Hit Mode, and Infinite Mode as targets become faster and more difficult. \n\nCompete on leaderboards, improve your high score, and enjoy immersive bow and arrow gameplay designed for VR archery fans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35531211089857816"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619465_5100905656717349_4638111524285790647_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMF-4n_o2rYQ7kNvwH1iMWU&_nc_oc=Adqw4WjXGgnLQhfPbEXKzXnwo-kBe5pO6F1bkrTLUJPzO5fqtwtvQERCUzYSmYUexvU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a8-JRrw0vJPiOZcOLi-XRNhyrU9gEfsXpGQ8ob8taEg&oe=6A19B03A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Archery Target", "platform": "ANDROID_6DOF"
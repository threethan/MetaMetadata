_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp4bklWz1j35tbdkT9CXaxF2Yru4SEzErMe-u1h1eMHg&oe=6B0306D3"}, {"file_name": "Archery Target - Screenshot 02 - Arrow in Flight.png", "id": "2005544943459186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593995458_2005544946792519_3092568793668575343_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=924IGIzLl8cQ7kNvwFpTN7c&_nc_oc=AdpzYfECA0cIYQOx8ZBTN8JcsKeK4GnE-6sV-6N1vfSakA1Xzhd1XLcUVtzh_X_dmPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtrocYifuK2o7OyT1u0fvMRi7PSMkHgrJcdxyUuAumLQ&oe=6B032BF5"}, {"file_name": "Archery Target - Screenshot 05 - Outdoor Range.png", "id": "2215839932300844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622195_2215839935634177_4316148955616331008_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNKGI-xlNtEQ7kNvwGm8DhN&_nc_oc=AdqvlQdCoOg2ZqxiKRK9oNd8VTU4rZRGuM2v-GBQFsb-G-4s9lqcJEgBtuELNUcklhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvYo94HHrcgp5BkPggk9GrLNMxsKFQRaEC3_j3ntOZYA&oe=6B0323C3"}, {"file_name": "Archery Target - Screenshot 03 - Elevated Target.png", "id": "2021002325257274", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499621314_2021002328590607_5301586943030902640_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s78BaMDU1cQQ7kNvwHCmpGA&_nc_oc=AdoiwPv0KwIjSPrfvs3uROV3-e8qtS1gIK-LPppogo2JYqWC_qdpL-yBHpcqCSaqbb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlubBSu_sG1nAq1V75pVcfO8FJbTtj-7Cu06i59VGuyw&oe=6B030415"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Archery Target - Trailer Cover.png", "id": "1506672017987662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299876_1506672021320995_5358876636941181271_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDKyiXzDQlYQ7kNvwGz8FQi&_nc_oc=AdpLKbzG0GJwKa3GUb_--NbKBcdDpylitO34GUzOwcnnMNs8ANPOVZ4_YcfhyyolXO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW5_gfG7POyxZ5WCTDa2MmFeS4H9QMwLjFJYLBVHVcSg&oe=6B032EF8"}, "display_name": "Archery Target", "keywords": ["archery", "bow", "shooting", "practice", "bullseye"], "long_description": "Step onto the outdoor range in Archery Target, a VR target shooting game for Meta Quest. Nock an arrow, draw the bowstring, and aim for the center. The closer you land to the bullseye, the more points you earn.\n\n\u2022 Time Attack \u2014 How high can you score in 30 seconds? Follow the target as it changes position and make the most of double-point opportunities.\n\u2022 Perfect Ten \u2014 You have 10 arrows to make your best score. Each bullseye is worth 100 points. Land all 10 for a perfect 1,000.\n\u2022 Infinite \u2014 Practice at your own pace with no timer. The target shifts positions and starts moving as you land more hits. Build your score with multipliers up to 16x. Your run saves as you go, so you can pick up where you left off.\n\nEach mode saves your personal best, so there's always a score to beat.", "short_description": "Draw your bow and aim for the bullseye in Archery Target, a VR archery game for Meta Quest.\n\nRace a 30-second clock in Time Attack, see how high you can score with 10 arrows in Perfect Ten, or take your time with target practice in Infinite.\n\nTrack the moving target and chase a new personal best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscript
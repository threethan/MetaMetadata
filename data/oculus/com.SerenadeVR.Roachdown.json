0a&_nc_ohc=au_FaCE2VMgQ7kNvwF9mr_y&_nc_oc=AdqgsATC72OtJcW-g4XVmdzP9ZELyvqMWnxj8bvQ0dYtgRAoknk-47lrIQFRfTvp7oI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhT7W_ey7Cc2900VtIfgH1oFbvD0qpgAKemMKhRBCe4Q&oe=6AA1683D"}, {"file_name": "scrnsht_05_2560x1440.png", "id": "891441947307235", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823296_891441950640568_5031791941271028128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3-6wawuLpoQ7kNvwHbenvS&_nc_oc=AdpE-JxcVo1lJp8hTH0uigfy1V1Z_lVR1gvYKva2DutUOoUAtQEc4P8ptCNeeinVoy0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZUcI8udupywtxG63yM0nrGtN6iTu4HM6Nrub064J8uA&oe=6AA16244"}, {"file_name": "scrnsht_01_2560x1440.png", "id": "1545702723568873", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821704_1545702730235539_4266719639968738931_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeQHFlm3AAYQ7kNvwHBYAqq&_nc_oc=AdpQ2j_yrVOFcdj2FfriUcw6pGkyYbCCVojdFdQ4wwMz-vhJpuvOYup1uam8dkhErII&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKstaqyeuLvKjYgUthS-y2V2-jmeYoJoTCkkawsQsBa6g&oe=6AA171A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt2560x1440.png", "id": "1279376110635637", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_1279376113968970_1607241551596222668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84kghSQ9_2UQ7kNvwHSQpFd&_nc_oc=Adr1FEkHQyJarjSp67V3y9XprT5FtnLFbluNgsAeW4WSHX6PmLoAy_3SMRVGyJdl-Pw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmku7Qk3Q2ow9H3uQZrpkFoeGysuKQP5L69zpzrFNCOQ&oe=6AA15BD7"}, "display_name": "Roachdown", "keywords": [], "long_description": "Roachdown is a casual VR shooter set in a grimy abandoned kitchen at night, where the roaches have taken over and you're the last line of defense.\nGrab two pistols, blast anything that crawls or flies, and shake your gun in the air to reload,  no clip management, no menus, no fumbling. Just point, squeeze, and shake when empty.\nYou start slow. A few harmless roaches wander across the floor while you get your bearings. Then the attackers come \u2014 scuttling toward you, leaping up, taking flight, hovering around your head, and lunging at your face. The longer you survive, the more come, and their movements shift from predictable patterns into full chaos. Get bitten too many times and it's game over. Shoot the REPLAY button to dive back in.\nNo campaigns. No menus to fight through. No boring tutorials. Just immediate arcade action with a satisfying click-and-splatter loop you can pick up for five minutes between meetings, or chase a high score for an hour.\nFeatures:\n\u2022 Casual gameplay, no aim-training required\n\u2022 Endless waves with gradually ramping difficulty\n\u2022 Dual-wield pistol combat\n\u2022 Shake-to-reload mechanic\n\u2022 Atmospheric horror soundscape and gore VFX\n\u2022 Quick play sessions, endless replayability\nBuilt for Meta Quest 2 and 3.\nHow long can you hold them off?", "short_description": "Roachdown is a casual VR shooter where you defend an abandoned kitchen from waves of crawling, jumping, flying cockroaches. Grab two pistols, blast anything that moves, and shake your gun to reload,  no fumbling with magazines. Start slow, then watch the roaches turn faster and meaner over time. Get bitten too many times and it's game over. Easy to pick up, satisfying to play in short sessions. Built for Meta Quest 2 and 3. How long can you survive the infestation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/Roachdown/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/Roachdown/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}
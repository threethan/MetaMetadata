E49555"}, {"file_name": "Mad Reflex Mixed Reality Still 1.png", "id": "406499402217736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpsuzcXzHhkQ7kNvwGe-jdv&_nc_oc=AdohsbXh_wWuPzJfmqOH8rPsLaCFWKx-aRgpEJlzBcTucb9ONZKJ_IFlUOSMLEKM1kQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdSGXxl7lQTxQN7rIxt0BB6NJGWaywqXG1f8pAGQR1Og&oe=6AE4C0CE"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_-j-YwrRmwQ7kNvwGQMtcC&_nc_oc=AdqxGKo5CMUm9NDWQyanF5Sz2LU3Y2od1YEnGePsW0O8AtAI3GxdvXDX5FgUJHM_2T8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDLbpEKuEq7jWcv5Qug51xqtMIiMtOynXLUNHim-OE9A&oe=6AE4A3D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rguDRZN9rdkQ7kNvwE7bSur&_nc_oc=Adq-XVKJuDQ_AZ2_mVqYC9mlfP7EBKW-QuFl7zkssODGrk6ZqSWmswJNanZoAZKmpRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtBg1l6M_aBVQkTNq-Gkwd5O1-zDCfRpoVzDupR_MOVw&oe=6AE49DBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhyTtvxEpe8Q7kNvwG2cq12&_nc_oc=Ado7pwjuayGvGtM88K7sRhgKb9DzyhpHnTAoSUnkwPSytSQTK4YlM6izZTZsfSE0uPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu5ra1H1oKDShyLyh1ba9VsZzSZVuIlD2eva_PLFr52g&oe=6AE4BC13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-3titrbNckQ7kNvwH8v-07&_nc_oc=AdrM23gOZD5V4SeIbiQKH-w00wiEubmObACPpobtihimw5ykHkEbnqZdrU-uLHsunGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsQCk-y-L6eyriREG414ptkp5CH4QIEqEOQObHRlGG7Q&oe=6AE4B99C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category
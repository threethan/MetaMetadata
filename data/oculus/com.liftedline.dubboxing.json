e7a0a&_nc_ohc=3zZcxuOn6boQ7kNvwGU2ndU&_nc_oc=AdlHD8xQGF2G0Jh25bahge9HgNbBIlVDdpSzX19NMDxKNi-fBwkqDRncW5nMtiOQ3dg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvSENhwDMZZYR0f_aqHEFYa5gGAmqYuV_bUHfc-gB-OwQ&oe=699EE60E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHMn71BLkPMQ7kNvwEvPdYT&_nc_oc=AdkKNrTD8YdbUuKpSRSIWnWc-1NLGnHY_rFrC4iflfKFLATeCHVESFDjIIzAmdD_QhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu24dTuMXCHh7bJ0NjVTDd5NSSPV5xlbPFDnV0x_6wJGA&oe=699F0154"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGVi37PyJiMQ7kNvwE-QHez&_nc_oc=AdnMNQtXJKbChca4iQL1SwfcL6eywdZE2EL-3QnvWj8h1ZeUwOA0WY8sG4uBaJp7VvU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvzv7WB-VoPL8PMRP96UZtES1kh7bFis8KXv0WnKO_v4Q&oe=699EFB3D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=678hO-N6QBUQ7kNvwEDIn2-&_nc_oc=AdnBR3ZF5-n4bWRDuRJDgArMslsQHMua8eVxihD9ib-M2p48EkE2XN7oNH_Cfui6BQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsaVZsYw8O4R7xwBVxInOQTcamFgyuqcO8MP8qQ63aVgg&oe=699EE153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oziUIVf8qNQQ7kNvwEottaN&_nc_oc=Adm5ER5qXX51Ep-W1t4gpGb4U-zjVdxyDqjz0fWciyrR7-7F26aaQWrOqKTD2STMZMI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsrel3RGzRExz41PDCn0QT6qvASCRihovu3-vc686spfQ&oe=699EDEDC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
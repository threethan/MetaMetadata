e7a0a&_nc_ohc=6xjf4g14ClgQ7kNvwE1fWzO&_nc_oc=Adk8GLLphNZ0OMlRQOz2p8cZUadoxKK8ydSFID-UWAcjUNJtwGlZYTLRwDaHS4uUeKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvTJus06d1TRiflUo1JnicU922FPZyDx8JP0JUozLrRyA&oe=69A57D8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlQqYwrcRk4Q7kNvwFlWii5&_nc_oc=AdnwujrRdFaTM0tyE8b8JUQ9k0ZVJKG-KdYJRCVQPsC4Dl0qpO2eUeLNIf1g3LM8NXI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftHa3pYxjpID789oQWTIXf6clkHAV7UIleUYpY3FueeDg&oe=69A598D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7UVSgTbTYMQ7kNvwGec3zk&_nc_oc=AdmKMGnMyAdLXDeDwWoqxhpLZZTrz8AMjngM9zt0oplKPHgQTRhYDmOgPHQalT-yLxY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftz72P1zuuhxQ6K8loBTI91J9yU7ydOvTbGLiI0MBH4IQ&oe=69A592BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA-mabweSTMQ7kNvwH51lup&_nc_oc=Adl4AoznubaXHxUYMZSu6GedrWL_o9VFJrLu-cgK6JSKgl40XZkuvpoV77Ffl9Yn_Bg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs7ekjbSb00LZ8T11YCAe6nHHlUfNmtOzHSmCqS6OAC5Q&oe=69A578D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mesPMv-W2r0Q7kNvwG9khbn&_nc_oc=AdkjBMpOtzSKT5vYjZHEuDiaaL0BAPGU-biOVcXFkXarH_vf734NdficCIgv_iUN-l4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftkJo0QJ92kXtO7yyDyXNHhmovnIj73RSZ5nO4MdJgHxg&oe=69A5765C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
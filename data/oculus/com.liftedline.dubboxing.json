e7a0a&_nc_ohc=xdy49Q17iMAQ7kNvwGRto7k&_nc_oc=AdlxY4IJ8iuiOll2po9LW-TG5DCTxit_yWu12xuBiOXahd_Cn9N2gHGCPgwUSZd-Vdc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuoKEXnjsdtcY8yAT_Qggzw2DEP-kf1DzW4Ihz9QJUMrA&oe=69A42C0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlQqYwrcRk4Q7kNvwGoB3-g&_nc_oc=Adm-KXRbcTQF6hdssF6-hxuVMEKwwJC2tHs5_lpfNUstKRsVu9tqRcdfPQcD7tUCedQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftXtntfa4YiAXKYP0rDAfIGCtqXjVzrsSRNIcj4m5UvDw&oe=69A44754"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5LYaEerVIYQ7kNvwFGost0&_nc_oc=Adnii7MIC9F8t8fjtN-IWW13NXEeBA9QtWj2VQgL4LLaG3BOfM49RVt487m-yDY7aII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvLVWOYoPc3Mip8n2wPbn0KoVhmWL-cq51j3-KMtmiGHA&oe=69A4413D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA-mabweSTMQ7kNvwEjSnQs&_nc_oc=AdnzpWmPNDFT694EK3ykISzM_xFFvDo-JzQF2Y75wPCH4hCl4Flfo1hu5sSR1-dR1z0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuH6GREJJIEgKVBslypW6vCj1WF-foE8NpSL8XUuUOw4Q&oe=69A42753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mesPMv-W2r0Q7kNvwH4bPIZ&_nc_oc=AdlCxyyQ9JNcdNOo_jtDKO85eKI3Opju7iZ5OvoUgpHmqSaW7YKqrF6m1BRqr7_mrz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsHKBU5VoZxKSXcIGh-_bPtt5ZWrtabBG4kjOwjt3PStw&oe=69A424DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
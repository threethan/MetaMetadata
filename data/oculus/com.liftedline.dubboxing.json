e7a0a&_nc_ohc=QenVdNq5OvYQ7kNvwGrSp_T&_nc_oc=AdkvcQAf6HSruuky9EHLQvb9jkKXf2uVktfGTE_7e-IFwkwQCQTjjHM3HTC918cpBQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZPgPki6W3FFvoG7PemCB7gJDvu5p3lVC0CEjNC16X5A&oe=6999A00E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJH5DovHeYwQ7kNvwEei9l1&_nc_oc=AdmOsUFi2_vKVXOsdwADa6FTzOR9O_IgnX8SXFr4OJ9Mz3Fl_ujt4Rao7VXhFCrOVCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuGW6w8ncknsEUoqqBd4BZtnJjVwguoA7JHySSMThFwsw&oe=6999BB54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJUW4YxjBgQQ7kNvwFj6xpT&_nc_oc=Adnb0r8ndIESvtYYOEkpeRSbUFDIhn2ri3Evv_I1euDWZXA4pU9r_cPOftZ3LKvCjGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhvoHSoOkTQB6sqj4lwr7Beh9vGX_hv580-qGNSmlGPA&oe=6999B53D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_E9lQ6gnvoQ7kNvwFwrRW7&_nc_oc=Adm4IDPtXC87tH52lQz33TfZuO_fnuQw6iU9aSyaz7IgUiHn5gAUiHGsV7VRhJL2eic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPmft0a2G6gVEVOf3ETscnyQBFEQJCe0FqxaXJLZWDaQ&oe=69999B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZK6kbjqvYgQ7kNvwEl4F2a&_nc_oc=Adlcp7QPMNipKeF-dnJ5rGGEaV78HXIpQNw0SgQKzruJgdHTeM46xkwQ7xxk1sUTn5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthT1ZE_5a4nl0EALtyollvTrchadM8LKxGXjwlLrgC6A&oe=699998DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
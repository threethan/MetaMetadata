_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc1H9SQUofAQ7kNvwFMy_vi&_nc_oc=AdkWy2wPZjMARHualpW7ELwE69UQUZmOR9JdqbT9CDy5FT93AdVPT1wYpOX1RRN1rZc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1_cm4NX5Lem69MlqEc2tY43ferYKUbGeg9ioZFtQbbg&oe=69BD388E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLHdeE63UKcQ7kNvwGzKoMd&_nc_oc=Adny_SWUIqjipdfHtL0CW5sdoh1i_6zrsTQtbD8yh1PrunXWfcN5zFGPvsnR0PY1f0Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeIqFTpbIvlMQ9Nf8D5YKfRNoIwtfWCbgWPmWIJyYGEg&oe=69BD53D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czJbzytNur8Q7kNvwH59C1f&_nc_oc=AdlOK0jSrsvuxK8H9eqifQoAYtfzPmVDWsm2msOTbxfOJ8CMDRevS-n_I_qQllWtWUw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIPzTRVQ_2gj0om7FHlQi2OOtohqj6tIIC-bc9REBnvA&oe=69BD4DBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msKQuRI0SpYQ7kNvwFd7ez1&_nc_oc=Adl1uOkBqCfvy0TLVQbRp7Yrmn54mx6SKPJV6Bsfvw_SKWvflCZ-RMynalTvDg2e0mE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYB39pHV-O6RoladpPujLqa1loWmDpPiE_xN95j_cLZA&oe=69BD33D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uexQRgvsjcQ7kNvwFW6M7R&_nc_oc=Adn1M-RzGjVloazsYgsYZ14Jx-9wTyAFu5d7BvD1F_fufJu1yVFwDemzRz_lVvIs_QA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afye8wod_wGIaBQTgkJC_5jodagIzw2i4RlBX0-MBBFE-A&oe=69BD315C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049
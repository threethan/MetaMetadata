uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbmKo6EzjtAQ7kNvwF7FW5N&_nc_oc=AdrKwz76sDij-koC61FzvERNKSfExZhqwLnZW5xcHzTdebQC48BA1FiWhb8A_Zyq4K8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuTjLzityu5GwEEM6P1Yrs8_Uq96V_ApC9heVVcQF5XA&oe=69C7C48E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_y8YTuQASYQ7kNvwE2w5U0&_nc_oc=AdqGJrhMv0-E0Yxe5sqsotD9xszTzDZcx_ZoNbhGBr50HXC1POWxHjy3Kw28gNL0k3o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIlK7Q1PRTJR152rNaut9m1cxQ_gHzAvdhW6Y_fZlsqw&oe=69C7DFD4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSrrxNO7f_kQ7kNvwF-btNV&_nc_oc=AdqT_CXNtzK0FpgElGejC66N30seDJBGvRyKWKlJkiXQCYK_yljyRxIPr9gNlOUbiCM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiJTJyiRpzARgFyjfcKsRknZteFCTXeym2oikKX8DF0g&oe=69C7D9BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-swOL9dbTV4Q7kNvwGkvjnS&_nc_oc=AdpY-DpyE3rlYKnzptYfW15Ywv0CmexMO7Cuah995-OH5ZLXK2JToRY5onM-dQZkI5Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAplYbD8g5Fch_G6CXvkgbAHPB9EhILEZDPHZOuXvsmQ&oe=69C7BFD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgTllK953PMQ7kNvwHWXkTW&_nc_oc=Adokvj4c9474j9o81gY7_JIB66QZAzBRTbHZi0zCOB7i8sa5jgB3Bf5eFoBqUpNPmpo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9G4Z6MPh1M14YhrSAPoVgdMv8_c6z8zfahCtmUC716w&oe=69C7BD5C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
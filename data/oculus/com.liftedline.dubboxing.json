uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBjobmxnBDkQ7kNvwFyjMPY&_nc_oc=AdrXVvNJIVvH7qxxD_heg_d3x9DZ9kF29Z1ZKsDAKT5mafCBwgOvOZvNKJbTx5X8Bso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XuX0qReiUEbrb6wng4ye7oVs-66sZ2UBDO0ATcSX1vw&oe=69E3740E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djF0oMwMtk8Q7kNvwGDO_dT&_nc_oc=AdpkRkkQ1Y7_1nrZotiDKP1e8hxOWAUXOWe7rSD2HQVxtfPnzT0E5sHBWWarp6GNCQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fCJ6OJvhd-eZoQQt_U0vu9EnvxV3ZIwaYj7UsGxVjbA&oe=69E38F54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIgkFqwYFRsQ7kNvwEPhb__&_nc_oc=Adobuy2_HbJU-cZ9wU-iu0svhk6PoeRWxkdVPT3lHEsTFv8XnsckQV0RPB258odws38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xsIlrsJVkPiPGSIJNlIqdtM9s0jKr50RjeKk9bsbeDw&oe=69E3893D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPxrDRkedAcQ7kNvwFKYn1-&_nc_oc=AdoBSDqoQ1petxdL44oOsDd9r4Z_pbwok8IF8kPfA9m5utNlWOe4P5MuDwVFsY1tKVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DgXXYcI3QQXSYJTx5Ufr3g0YJX8kMHP0lZfNRlyEHQA&oe=69E36F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIvHcMeKDWIQ7kNvwERTx0p&_nc_oc=AdrcrsOY49kepj9pKmPpv3CE3iIBmJYTnkhuQua0UDxfydXzjC1uSn5Pzhdgdnp1bA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af023Wa-6-RM4ZQK-1kYMtaXwi54wF8TdtQpEQhphqCI3Q&oe=69E36CDC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
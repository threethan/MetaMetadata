uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXfhZH3P7TEQ7kNvwF1mzk9&_nc_oc=AdoAYiq62SMTvEkhQ1hCEbgPmcXiI2kiUnP46FkVFypZSFOELkhAue8dpGegIauY5R0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Txl14WltupZmnWCDyx5mnqIznozRIO8FtVLZaCofiNQ&oe=69E7688E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnHAjJyjr70Q7kNvwEZ5m6H&_nc_oc=AdqUnw7aUiFW9grVj88Oo1Sfkj0a69PCiwwIeUF2qx3lVqddg0zapFIPgwgnig4-G2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FTKBPcX6X9Ea6zIRWUUGniakylQdONvYe09F0CsZRMQ&oe=69E783D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc_EcruDpCwQ7kNvwFsBK-5&_nc_oc=Adr7JclO-M0TTb_0V_L8nHSP1VFPHT_mf5DEMFWF0Rf5emOWz9_QovDu3CVV-ZflntY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GlMPpexAzI-yedGTlJff_BfmaxSzdyg55AIosKfFoqw&oe=69E77DBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu_AnAMM5IUQ7kNvwHtvb7k&_nc_oc=AdrizQZmAEsMccGJv-IVSWbtlSP2yH2FFNj14w_WiUWl_RfhUaxC3gNH_byHzCdV48c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iqcvuSewK_nxjlgj7tQy_fNrHG1Z_YZsq9hDYsmstTg&oe=69E763D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDcajzIe2C0Q7kNvwGc4N-H&_nc_oc=AdoVVGw7CmE3gfd9XD7gf1seeD9e7srCp2FwCYdBSMfBHDy2RS4JiqyfRkckzoTKqGk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i_qeWrxZZ0vPJe6byMcmbWsP9JfiHKf_HkBmBDspbqQ&oe=69E7615C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbxbxJIzz0MQ7kNvwFRlvZz&_nc_oc=AdoEdw8TLilEB5fN-D3JPgYxpH5gGBBMd0IS-vRw4qutxtZfVEpFT6j0ehUJ6tJtbYw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2NRCAwZgp0q-rbHicDIjNqDYKaHNBogL5DZCHdUcTBA&oe=69CBB90E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtsDmsiazl8Q7kNvwHAiCMU&_nc_oc=AdrwlVJsoQhnhtF9C43VgM2REHzYLSqvA5G4MU7NLesEBrflLL-HqxgBqqBsUgq3cnM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZ3vHxpcE74kciGRUoHbcOMTyJ-pcZTfm9YaGVWsCB0Q&oe=69CBD454"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3lZIVAOlwgQ7kNvwFyXFA0&_nc_oc=Adow7BKuwZd_ScXAYGANokWC38krN9w-sMv0bRTiX0HLmJBQuK_7b5Y24OwgQZjpejo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxby3ngc1J0-XUKNkszVnurzDxDQzT5vzIhqc0JTNQtDw&oe=69CBCE3D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFEyegAo7R0Q7kNvwHyuKrC&_nc_oc=AdoMJl8cIkBZjgYiODTF6ZKn0Nk9yIpIWQwvu2HgT50B8cab6-PXsh58QoW3vdFuHrg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDDFTnrEB-PrXMyrn2pSWTwLWsUMJ9F4R4kF_0Ss4Ffg&oe=69CBB453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGyJR0YMjbkQ7kNvwEf10Wf&_nc_oc=Adp06JEvGINE8yrcpIupJbcUX473YEYKg_uuF3GlFSYgnd3MkYq6qWgeZLuYORhufBU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxZWYX01Ssoiq4ioGxX8rXlElaJ0rjdri4S5DvY6PnCg&oe=69CBB1DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
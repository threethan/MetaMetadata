e7a0a&_nc_ohc=3zZcxuOn6boQ7kNvwGDYn7i&_nc_oc=Adlz_axlySQEQ84wEV-Ubn1PS26-mgHyNBSYKlBB6ePt1PB8j7k9H7hFFapT_B6SXa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfukNKftwarbGNF-yc3QpQg5KBGzOin5JW7uVprGnLQ2xQ&oe=699D948E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHMn71BLkPMQ7kNvwElq97T&_nc_oc=AdlRGmYHKFTwOymZ4qV8zhtlF7oor0BubymgJuYxQM3ocKrc4f969dz4cI0Vc-kgbgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsfbtq7NwqxzGD2o8iMZza79edlNBYE58AhhunjAVMVow&oe=699DAFD4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGVi37PyJiMQ7kNvwHbWRSM&_nc_oc=Adkxc848_Rj0gRZI9temhrFYjcrAHtekRRAVHtse66FCrS4be_EIdz0LG9eYidJWI4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvfZXNvwG1yicC2-OJKGjmt2b_yafCz0gKlMVgPeCzRWw&oe=699DA9BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=678hO-N6QBUQ7kNvwGPbWfa&_nc_oc=AdmT6gurvyHnFwISPJZUOpvPRvSLzhszCofXo9hqmJfUUPhTO5vImZK9TKK8L4OlS2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1AhnMObi8U01yximY1V4X8xv9Vxac-pfRUXNOE1wgsQ&oe=699D8FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJRFAEPAr04Q7kNvwE1bk1e&_nc_oc=AdnOiyk5azuUKOHDwiUFStWN9maVI9fc5EuwE2ZsTeoHaVXbbAYBK9Wazd8O7cbLIIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZu1F9jh5kx5p61tXd4erCDFr9Pqhr0_OCh4YDXl0FEQ&oe=699D8D5C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
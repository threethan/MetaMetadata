e7a0a&_nc_ohc=xdy49Q17iMAQ7kNvwH1lFBG&_nc_oc=Adm72lIrNDIiWBTaw3sfnMJMpMnkkex4lz-8kp0cQ9uAB51ctA6Wm1-kXCjVPrbJ5Sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsioDXnLEleOu4qRtCpz0iOJa3WFHb1m2U5Kg8AgEyVpA&oe=69A2DA8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1GQV6dojbkQ7kNvwEN4IHV&_nc_oc=AdnzRR0MWnnFLf7fqYwA-w_40PdVDTNiTBFcsBL3SZn2e_cROpAPRJtXeoBbu7Fah3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFzRs83f1cMhoVHTAmx8RkHs7SVM2IaoWSiQoqAgJvPg&oe=69A2F5D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5LYaEerVIYQ7kNvwHxBu2N&_nc_oc=Adk9czY7gKlVTiREpbfyhMQGMpktSSprxnPjf4PwKjJ0E6z0wKtYG8DwR2HGgmvyvsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmYlguaEK--dP705UbPltwzjQlGki_3XVsQTfbvcxaFA&oe=69A2EFBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuKVaigwZD8Q7kNvwEAhQow&_nc_oc=Adnsysc0V4v-0XMg35bdh62qs8WqCo717v430XbBfsL5LYBNnPcaFQhnu7yjUfQ9C-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteVO-lF7i1Grk9yGQ0WMn0OU9ucsz-aIq_9BvGB2vR6Q&oe=69A2D5D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mesPMv-W2r0Q7kNvwGKNbWy&_nc_oc=AdluNHZkV0w6n3lfon0BKkhEX_EtK5wRTd0QhGq5xk0Hp5orji91EpJ3NlLWv4u0G9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-1KeoUxMDD_r_wBFCRr3-u8yoj6uXwnmiP3aEgvPcRw&oe=69A2D35C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
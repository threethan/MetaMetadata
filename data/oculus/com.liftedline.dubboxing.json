_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFymAC44nZAQ7kNvwFA0O8V&_nc_oc=AdlhvC2LNjPBEWINeT--TmyBz2M1_0_TFm-chijsx5ht5JpPI9Ybj8kILwl8P7nzUJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7zK9wlrgqX9ieGpqb3tBwLeHxm4IeVpUEQaI_bh7BFQ&oe=69AD668E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pszofChuhYQ7kNvwF-l5rL&_nc_oc=Adl4FgcCr0hDtHw_ZWAyLbGA2jY2vmJgBSGDbnQNtsI4YAeXZZ-3WpAqVtTE0bCDPg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLL1aJwyymjaT1QrLpFcsBrxwTdX7SnK5-Q3pm1hEcVA&oe=69AD81D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1VFe539VZwQ7kNvwGhRlGh&_nc_oc=AdlcwwSC038yfe0rQk0E_D7VgBcC5EHI5Y2yAxzNjHeou6WFwj1rvzHUV1kATJoBLxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7ELUW2j9PcaSWP5rOic3NkYJqn5rLvSrjJnJ6U7JbfA&oe=69AD7BBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUpH9aJPFJ4Q7kNvwFTght0&_nc_oc=AdkLJwOMQdk7TRgKnW1S1CuPub79dWUglkNzvp0bkZOTNRqQFcBgNBsrCJM8WtAi5C8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyA9eoX4pGDbOuigIGKa2mg-5mG4LaMmZ-F_y8WRDZcuQ&oe=69AD61D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPb4JfDakwwQ7kNvwFVsoy8&_nc_oc=AdmITWe-l3NrVrRH-426dwywvlpOLLaWG1_VZ96PDhQPmmuKP8CPjFp9_S3YPbv4Rko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxWygY_K3W1Qw6gGhWoQzFYGR_fAsawWRQ0xMjjp1B7Q&oe=69AD5F5C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049
uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9mgb9xcRMgQ7kNvwECd-Dc&_nc_oc=AdpgNW2DV0d5G7YcoPst3ALSiSaADE2mQrP0gPgur7TaR5tM0X3W3t6o_Fz78_Dfccs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NsXZel0NgK831hFPR32Mge_LWxxQM1d1ufc4GsnuUDw&oe=69FB2F0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxeoZjpgUjAQ7kNvwG20NYK&_nc_oc=AdrGCdFmn29CslIAGNveA8XrtENZITz4V6lqLXoTAnlW1bVOXfrbdxUYr_gkyQgDBoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Nkd32tl3gv5mVO-2tY88_5ZrZwFxqv1qIvb1fMQAUxQ&oe=69FB4A54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQT4FbA5N4YQ7kNvwEM5Kz9&_nc_oc=AdpIh4Pfkes-YRQB8xWG0eH-4EA3J8GunaZh7nAaY3wD93JSnWQqb7ZBvA5QYwml054&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6haJTiX-GHeWLzv12dE-GX0hC-NYv4deRC1lFMJWRXRg&oe=69FB443D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uL_eLKPLNYQ7kNvwFX1E53&_nc_oc=Adozy_44DtsJXXOnpRLWEv4Y_cLHKkStkxFEbeShP5F9KfYi3t4QpB9EjHr4zvrzJvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zFyY2nkpIeG4eo2pY7-D2VVrPP3bW2Hu6-73rENKEVA&oe=69FB2A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTsTOTdNT6MQ7kNvwEhYED1&_nc_oc=AdptlypK9xXcDYKpHXUuDaCMyp8iqaV4sPI0LYcBswhrmzd4mL5GMazB95VY9uTI24Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oPDVSbuVtgOzmbgusUUqhhHCcnVKmVcaOcLtgsoKeQg&oe=69FB601C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEa31J7MgfAQ7kNvwGMRfIK&_nc_oc=Adp_InxjN3882L4IrBDdVH6COQkvKXoVV41q9RZkTmUIdmrdztkbaroTVH1YRtPyRaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jGQ0HKkuQAw0jszbBnrVJhpHpmWNxAOvCfPiTtDSLbw&oe=69D3A20E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gGaIYWiOsQQ7kNvwExpBW2&_nc_oc=Adq0v60tGGwF73GdfTJ9dFXgGEYO8xqptRaY1DT3N3oYFoDKuUtLEHVrjRZu8o3-1AQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TiUGbh4qKMB_Ys_4yvMwmJct4OG2wDIb5kFt2ecRTaA&oe=69D3BD54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7XeEvnVaHMQ7kNvwG-9bef&_nc_oc=AdpnRQK0Oa28WRGM2M06DLWsl9qZT8jQ8BAL3QBvhDsIaCUIAXp8kVvf5tAgQQetBJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RW8Vbq0qEWKqrPAJ_MVX3mJAXm9Oj3u97UGkbj1yvhQ&oe=69D3B73D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1aB1xCiV4EQ7kNvwHaT71R&_nc_oc=AdpHrAaT9RtooQ1xB0SefRv-D3TN14jZ7zgP4xbkfUtw8AlS7pynDXGOBNUbqk9PZtg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27l2b2poBf_ewev85v6Xkr0EmJ__dJbVzSyd35i93aVg&oe=69D39D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHyKePH_WMwQ7kNvwHrOvGC&_nc_oc=Adojlk3VBUWOCF9eVYwe5ZXLPNnRtGZM4OhCxm_cV8Hy3xGQQfSDTSIrsRisUtQR3i8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZTHtKKUhy2ebZS3j1-P_EIt9Ia5oKDrPPi9zv7s89mQ&oe=69D39ADC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
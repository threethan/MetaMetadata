uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QPIXRU64ZcQ7kNvwHJtRvj&_nc_oc=Adqd-1LNtI-ti1Ws7IUW2ucUpr8fEYl3IvjRxe0RNQeDNgRIREQ0sxCISPFW80RZuRI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HPTFjpYgQRa7gs3WwQoPB72JHm7KqL29Pz4hP4nnLRw&oe=69F4978E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_8GDXEYBvUQ7kNvwEte26Q&_nc_oc=Adrvh2Hha0AJpyXiZ7nDqB0BgCBgFhqOrIFD9_xvbuvwCrWywtpqGEtBguw4WFh9u38&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04aoOAfLTNxljwGmMExAnIrksTGczmX9ae43GyD9C2dg&oe=69F4B2D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkjMf0Wl_MsQ7kNvwHsjyHm&_nc_oc=AdoWJX_Ygl4e8b5WvN9q5X6BCVBEKWk2MN14qnaC_7ijjrvVE96C0eZKLHozP07VW1w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2be6JsLLBvHOam1orCoSGGpKELmIMbCZpk1Rm0U2SuPw&oe=69F4ACBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIAGb_ovVwYQ7kNvwH59lG0&_nc_oc=AdoCL4IR8ZwJzyaNsEtphbFB5b3beTXsC-ntc1J52C7W5GZ4H1SALNy1DXF9apMRD2Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af241BHEZfeeBE6QqUByV-5wuGYHGrQkvDObBpjEgorFfw&oe=69F492D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t23IX6606AQ7kNvwFmUa5h&_nc_oc=Adpm2cBGUsZNjAJ__Kl_5xo8XAxRqrdBGWxb-wChOPeCPKAkzKc8sDrWuSGk-hMmbOc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iHv4UuDOmtLDOR8i8Tmx0XxeHnyn6whvXUZz9gUgZ1g&oe=69F4C89C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
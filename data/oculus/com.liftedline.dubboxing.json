e7a0a&_nc_ohc=r3QvoavwVM4Q7kNvwGWew1m&_nc_oc=AdqgnjYswpobxWSyTS7pvJoHKicJ01Xs90hfXoiRm3pplYq0cULQc3gQMDFnKhadgFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2ufoGeNkmlIwH7cvEeWTgzAPzBjxYtz43U_1V3BcSFpg&oe=69F0A30E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXvgF9rttz0Q7kNvwGkHmfr&_nc_oc=Ado3caoAecxeaUYyIJB3xDNT7kGge0vOG-HWLDMG0paL7RT9WSudccP3Sk50w8gLG_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2TNM_1aGtMchiNr17LswMo37S0Xn28urqnWtu905NDqw&oe=69F0BE54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-zbGF5XUWgQ7kNvwEInXay&_nc_oc=AdoOLIbqm21736wXLagaZY4NDY5Y2aSuMjiCCdc__eSecb5ltfX0k53j95I7jxeZFZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Sa9_PeFHpnSfI79apOCUsJn6Fqq00FKgFvV9QE-jdfw&oe=69F0B83D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxAraV_aHrQQ7kNvwETvLNa&_nc_oc=Adr4vLpBKahRdRROaDawsLEwoqqLI-KWQFFa0XNnFFaXjtGjeBTJkc4F9m3nSteV-rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af25PW35ytMiAF4gxkq8ADO_z1WxKJMtcQHesheWWvxjpg&oe=69F09E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CsQ3bwNAd4Q7kNvwEbUnek&_nc_oc=AdpW3tgkoXA7Y7onJ98ETThamIE0JbW7uHDtoqCWS_L9lt6LwoI__ItdiDnWF1yoRZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2y8VvOO1RZ_CvUkfXn-AY7jq5_xd_O-brbEDvp5lMXug&oe=69F09BDC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
CE6415"}, {"file_name": "Mad Reflex Mixed Reality Still 1.png", "id": "406499402217736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBeizAAICGEQ7kNvwG2izON&_nc_oc=AdrmhEkjYaSfdzZq1vUrVRItnDtLKZE6FXdWQ6EvseafkGNIxloLpu13VyHCjORosDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUpz8Zgspg1cYtLd6gQZTbMYX16sEhoR_ulbeiQR3xGw&oe=6ACE574E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axcIQaKvJdEQ7kNvwGDNjmB&_nc_oc=AdrxcMJ1fmUMBbzHejGb5YW7j4pCAGrehsXjcv1g7RT0CRyx_wygs95GofVQyC1SGIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz2TiP1YQUnqSVxIQ4gxf4y4XNxezcRU-Wttn0pb_BBg&oe=6ACE3A54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0WrCY-4EXcQ7kNvwGN8Vh3&_nc_oc=AdptCvR7Rk-mQRiEEXzP6Bsu8wVAvvJLqFPL0zWg7gahGzHaAXiuufwaJJ1IAhF567E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcLdEAg_UGaF6O8Q-1g-xtgV-f44_tJ8vbZEUw6uXQpQ&oe=6ACE343D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGAl13FC6rIQ7kNvwHDlg-Y&_nc_oc=Adq_Kh-7LCASov0tf9D8neEihBgGYFG-qLAoj4RaPSuDz6UIY-ari75BjGftsw2KLz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBUMvNEhfZJrDYoUgpkLVCccsli9iLDcA9-zR0-DNb8g&oe=6ACE5293"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eObGQ78Q_gQ7kNvwGN9G8X&_nc_oc=Adr_c4kN62suOdAfh7BDF5FY2QLHu1vJFBkH7cYWnNtlt5RURMj1IaWxAvyj0_sGQM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtJgYZHbmMajBlSvV7mAv92JR4fYOHrBCmfk9lJN_AFw&oe=6ACE501C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category
uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9mgb9xcRMgQ7kNvwGabn1b&_nc_oc=AdqNw-m-rvLltXCqzMZq7Lx-6EpcNYQ6G1_gVHR9yyi_5vHQYiw2zGjjEc6Ln6YZwLI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2cLaY6J7clIdoYtDG3WuDqrJc7n9HJd4QmqrMfdmmsWA&oe=69F88C0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F222Jy9gK0Q7kNvwF2Uos1&_nc_oc=Adrmup9QE3NK38iKAIdJTZS4Gq7M7Uv469a0Q_xsEIlpGyw8Aza6h0XB2e80UE9IMRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lV18yM79venlJHi5AD-tE0wR1Kz2k0pNw6_eECvKvow&oe=69F8A754"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQT4FbA5N4YQ7kNvwHlorAy&_nc_oc=AdqVhnK1uAfK2oX218vzP2yShDIeyIEuFb_bYrRztx_YUYuNQ-NZD7mdYJaq-HcXfWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2y-Y2L1Q_kb_TBbz21oUceF2DQrYnNGu5NkSDabrwR7w&oe=69F8A13D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xejGAW7zjUcQ7kNvwFpmNdH&_nc_oc=AdqyzwKYy35Qyl0ZxnTP2WqAoapn6S4K-M2Jg0ZN06CJJ8RITbozHYDeLDE4qhaf9Kw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EGVoQL5NhqI6nF9gS-viSmUBGHAZJKAPy3V7In5jGNw&oe=69F8BF93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXZ2EXeQAT4Q7kNvwGCVcca&_nc_oc=Adq04kHg16Cqsokr4n0lRbQ60ikb6BL3W19pT2Vahnl2368PG3KcLsMfoNYEbo_wmGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02ToVliNvd8bGDaZlNbLoSCQt9TTL3kChDA16RP7FUHQ&oe=69F8BD1C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
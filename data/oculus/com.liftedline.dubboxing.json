uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JNIUrGLShcQ7kNvwHpmAq8&_nc_oc=AdpFGG0D006GRlDYkhg7aRy7Lyt1lpurwSeCuRTfx7IR0J31Q2FTZmPknbJHYaQWKWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O9AAclec_0KAuNkaTH_eB1i2Wsd9-mkh_ERBHmBOW-A&oe=69EE000E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNhvnf-4PMUQ7kNvwEE_WqU&_nc_oc=AdqMiuYZ_-gtzMmTONVovH2VR6rTgCl5J5VetWZcgJGyaU4bE5laJm_T1L5ECQAbu6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PqIMXZFj-90yqHOkfRL4vH5XzQVOZnKCVP2G4aOsFew&oe=69EE1B54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbWjRa3RqIIQ7kNvwHw-NuZ&_nc_oc=AdoAZn-0AAPmj2vS5ejfYsSMthHRlydIffZe0znyQyrAfp_iIzfuVmf_eajcEJF_Rnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kajKk8xt9PJKEq8KZfC4R9E8m2iRO0WXxRBbQCLif1g&oe=69EE153D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWC7WjSlR8gQ7kNvwF_D-Z5&_nc_oc=AdrAXLb9FMiQxDZ89v88WhLhJ2r10XGdmr1uEIsBn7GrbREOUTjtlF7Xe_0DGj2CnGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fB9MFFEVYrk67fvqkeJDf9Ee6lfzZ0kianmSsG6R8UQ&oe=69EDFB53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CsQ3bwNAd4Q7kNvwFEqgwN&_nc_oc=Adp5N0Vhe3k6SbYFJXkKFtXl3_96t8k4Euv0m-_GWS39ExFIY57BJsZxxw3pjqKqIOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-RBX7bFLCWFXaaiuiqqdo8R1tXDdY2NdoLmhHWxQHqA&oe=69EDF8DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
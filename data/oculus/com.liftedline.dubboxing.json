uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QPIXRU64ZcQ7kNvwGouVy4&_nc_oc=AdrFgfUXyZjxgEUi5BMc1zE-yKqETdIySCuMN4gtJ7wojje-zRgwkmmXfG9zl8vPzUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y_oV8fYhIZGcHMp95ph3qg3xhpTCIBEfJZrp5CiT0yg&oe=69F73A8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F222Jy9gK0Q7kNvwE2dSv3&_nc_oc=AdouUZDY-Vt4gNYVdXsrHmjnSyDMg7vVHVbQ3DPJwmF3u2cq_D0myUGSr8ZIG9OQ3Lc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tIbrr-Pp8GXTCutR5Z268pvScOFrLbRvYikS9Alnorw&oe=69F755D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkjMf0Wl_MsQ7kNvwHdbMmo&_nc_oc=AdrnmiU24nqsVnPg-mzIoRHxZrmnHWmwavBoB1AHY7xSxP-E2Vp0-AHO6HDJaJU9F5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Zcm2gduKI4A8BEtPNgj3hoDLsMWCFHFy42KhEgCA3AQ&oe=69F74FBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xejGAW7zjUcQ7kNvwE7lE2Y&_nc_oc=AdpjF2oh8KhvM3tGE6LyfdTHAkgb50o0kSlJnfg0Gl8Pt2raODP4tjCjVSF58Rx8KS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ErZoVOykhNytAXxcbpU9oWpfb9_DRNhhuSRKP9F5AAg&oe=69F735D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXZ2EXeQAT4Q7kNvwH6fQ6E&_nc_oc=AdoRQnqxZevXQrMTPJQKEtg5UNoupcaMeqG9m1U_HRcwrhvxuK2NOftTDZff7TLrMxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rQnyBCaisTFvveeI_JhYF6Xg-fJZ8Oihy8cZZZh0uSQ&oe=69F76B9C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jACaH9ZIEqEQ7kNvwFQp12R&_nc_oc=Adnlwt6-NcitHJNbrAd3_gKBu6Jw24OTz1DQZ-cpGX5Egdn8rurcouVPpIbruixBVsU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwyES9Bw5jaqPtEKYAprk-S1oV6wMekE0vnRVz_ocrI_A&oe=69B3FE0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R74VgujWQ0Q7kNvwH6HsN4&_nc_oc=AdkXLlkujZMtnYeE9JyZpXrTJc4iSgFQrQKUEIlQaPDlOqFVCXt6nxN7zX5VsVr-VvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzusxH0VTghGBP54nuJNlF6l-2a6xUYaUq8P5Sxf3jPLQ&oe=69B41954"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncDPQJ7H0_YQ7kNvwGnv4No&_nc_oc=AdndBTtGkwwP0xwfqhfF3mDT2qYeQDzItcpo68Cd-mqMhdeIf69BCan4Zqd5um1mFoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTwr3_tp7vYJfmwo2jZqgxS7ENE5tZ-7m8WzTyq6L5ew&oe=69B4133D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BayGa7V_B5gQ7kNvwF9WIWF&_nc_oc=AdlE17iMEY3WkIIAIaEx1N866WOlGtg8r9IkePVJafiKMx7wnw-BWmTdHMg-XOFGpyg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxITrhPgE8yoMZLmsuiHzS3chRYHqUXAN5ETsiCRrGDug&oe=69B3F953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEGkZGhjKPUQ7kNvwH6LbDa&_nc_oc=AdmZUnx-Zr6bbjgnT9ani-rW_d1OJ1d-73YQrZAbPBZBfLP8uh4Z0rQq3wx8wUfm4SU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkPTQMaoJ3XABL8WxIvCstZSQTrPo-UtbtpGp4RSgjrA&oe=69B3F6DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049
uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JNIUrGLShcQ7kNvwHoFkTW&_nc_oc=AdqgTxNsrC2E06yfXkG93HYzqxArfjZN40QDYIpfv7VWb_4qT4O9jDUYSayaabM2Mzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EsX3ddklfJIBfU9Xf_ZOwZQ5pYJh4-2ZmWEeL_b9RvA&oe=69ECAE8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNhvnf-4PMUQ7kNvwGZC3NC&_nc_oc=AdpvGNQ1NHKKzs09eqq0UL_h5J3qKHZ6-UeOr0qa2jYlwVj-inAo5bm91CSRy9Whjr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cNGwQYxYftJpvYwMVERSONH4x7q_aNGIfgyDR0N8OXA&oe=69ECC9D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbWjRa3RqIIQ7kNvwEDKUqF&_nc_oc=Adpc6BSn45i4NNqUCNe5e-xXGmhLwl3JIKgmsZ2b9pUZAnjcNKZ6rqA9pZ86IiM_Qzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mDekChanM5NUp8O2IUrUTl6HCCMoWeaWfP3oJ5gXD7A&oe=69ECC3BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWC7WjSlR8gQ7kNvwGgwcPA&_nc_oc=Ado7r4uHldaicJwf_ydTohM-aw6Qf3gRGmig4vcQvIVsO7CC8NTHxP7D1tN4n-CFws8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kfCRYh51_0vjkGL-3ydKid54YPjizyNW3nmWoGzF8kA&oe=69ECA9D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEBSygfa-TsQ7kNvwF6WQIv&_nc_oc=Adprr4Otxdh2qt0Bw9lqkqwX4YIDUmUoz2jH8MUKOyd5v6FFpIv-dq95vwNhEiNtxPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vQwDyYx8WySXIf2Lv1qJx4jEpqj6klM-vpC5lygkQ3g&oe=69ECA75C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
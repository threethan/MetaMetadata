A2AA55"}, {"file_name": "Mad Reflex Mixed Reality Still 1.png", "id": "406499402217736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF2Sr7UvyOEQ7kNvwEDu-tX&_nc_oc=AdrwjRNzVN_9U5GhjmY9isBxtzJV0fgSI4iGis0fILZFb3owx-pHkgRsL1wHojM0tEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5i7EK-Kr8pO9m0gWuiBz486eWb476IpaUnEMhJ1kY7g&oe=6AA29D8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuxuMoy-MOkQ7kNvwEmFuNJ&_nc_oc=AdpaB6c-Itji1KPxGnL7RNDBwO3rBYvns0h3RYJ93I-oRv7D7pCRXgRl9PabnN3HVUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRWMUoUoTV9rsU7WTKPbkpULMYYBANNwpD5Mk3qdUBlw&oe=6AA2B8D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TO-9hKgiTNoQ7kNvwEVW6_Y&_nc_oc=AdoNpmMHHanhOx9wIj4w-218fDCKsVN_d-Ct-_D2LNKAijA2YSFAzsebqzIdAbwukGM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL57gCLUfxcSYRyD1B3BURaRCHw-Immh0VInkGvaVprtg&oe=6AA2B2BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOtKhITcOw8Q7kNvwErIUpX&_nc_oc=Adpr3Zjv3c9V27SkGrTJn9FYDJZBpMhO2vLyUG0yq2mcVS0cdOq5O25j4TA17cj_r74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv33QShwbCZ5GD7KqwyXeReD3qT0eRylcLYXFYOiOl5A&oe=6AA2D113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NalRdgK3fRAQ7kNvwGiHiyc&_nc_oc=AdokSN8LHF1HrCWJtC2VyWxS0mggfsj79nm7xwbxgh2Pndiss7QMuHtuG_MFqNOY_uM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIklpkZeesySAowxs3v6BaIvs_i6ljWiqIfehFy1CjPdg&oe=6AA2CE9C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category
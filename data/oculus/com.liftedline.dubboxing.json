e7a0a&_nc_ohc=7SZFJTln1GgQ7kNvwFV2NOe&_nc_oc=AdkKWefX_KDp3ctZKdU2VR6GD7C38L2maig6owU7OO-Vj_9YUnTagu4o_Mj4MrfaOEo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftTOaRudDSXtoLDHjcNNoA6QV15QpaVWAoOMO6_JKR5SQ&oe=69984E8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJH5DovHeYwQ7kNvwGt_xfx&_nc_oc=Admu1yNmPUCt0YdOQcX8DyaIEQCMlDUBR1Wzwg2NTmreweQJVQDFeKHK9H3X75pHLlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftXjei9QqjpxdUafKdSR2UaEwxQzm-bonDTAlgE1QIsqQ&oe=699869D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDg45HH8kPYQ7kNvwGXUCQX&_nc_oc=AdmNkjg_gjX67M5CmiXTrLwktYrsP1yDQW7_-DPblTqRo04sH6Co0PC8ueYV4niz7Gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsFS_XnwB971eImv_G9_I0EFGNKtlU0kUq_d1R_nhW5UA&oe=699863BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_E9lQ6gnvoQ7kNvwFv-SuC&_nc_oc=Adndk0WCP3dcVkwMf8EdvcRdPM0ANfQR8lc3uAIiFYgkO_2j70YKKrmU2h1UnMZ-n3k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsEpzN4ZIvQniipPU6f9W9Sbr1M1I6lPTAAGmdS3kjCEw&oe=699849D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZK6kbjqvYgQ7kNvwFdjf_4&_nc_oc=AdmnFhwvTRGhlJauRQJnXcUfaGhiV4cEQl7cG-Y_WuaD0cubK75IHpfzkeBG_v2IF5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftKPdYG-Ar23neUVUefmCzVZh-mbVuhTY5iNIWBFAzl2w&oe=6998475C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
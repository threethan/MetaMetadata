_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc1H9SQUofAQ7kNvwG_3RjZ&_nc_oc=AdljUwDC9qSr-AgBvwtBEEpwjIUUi6X0KiQKs3j9X58oq_yFXkikfBRZ5LxOqBwPvRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzciRpuQN3zgNSpJHPPayOCM0zlRWW10qPinId-zRkuYQ&oe=69BFDB8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSdi3pK3w_wQ7kNvwHAdQcP&_nc_oc=AdnVr27nYJCo4EtX7UeOS4haoSpOQsl22auaf87tcKg11ZperrDrPEJSLT3A9n1QRMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_gaHxUH8nL5JCvjLYfaPjhatDfqfktv2ebc7ignA5uQ&oe=69BFF6D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czJbzytNur8Q7kNvwFvq0QX&_nc_oc=Adles-HIkRzBCd8Xp5zDUbpJDTE7ZaoZsLNk4OEC2xVGPeZ8zA8nTt3V-6-WG1qK_UA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpUI4lfwpdgT5qIn-7XHdCBkHUBkvf2QIFPqhCYJvPEQ&oe=69BFF0BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0AsrukMXigQ7kNvwFeq4yz&_nc_oc=AdmSDMhrfojZT7O2UOh78GwviRCiKOGHsfvB34d5Pv2yhFdLqpc7FZF16jEn3L5bbA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8VhpPh8ceM2altpCxAtHMRxjkJZWR8s35hk12cXvxSw&oe=69BFD6D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN2wsrIBpRkQ7kNvwFbAO48&_nc_oc=AdnQhpDaRx7qSzeRwXLm51I-8O5E_DsbQyS30GGGF-PVhXlgqwvlJdCEaF3JDrWJ69k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKsO1sIofmB592Ht-UdtAg_xcPVfyz0l67DDqRTqs5CA&oe=69BFD45C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049
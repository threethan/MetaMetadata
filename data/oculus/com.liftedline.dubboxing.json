uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mjPY64w7csQ7kNvwFW_A6M&_nc_oc=AdolJDDVNCBP6WGCeM6Of9ZI8QhOfPJJY0Xg-8hSCeGtUokr0gy_jnXKJWwdVc3wPtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k2EhXeBDWhVfoGTTbtpviDxMypLtEZm9KNdqvK1hR8g&oe=69EA0B8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnHAjJyjr70Q7kNvwGNkxOk&_nc_oc=AdpUtyP_N8nfV_i7fT1yfUjbZ5yhayxFXI4Eh14kwFmPrbX_uFpTMTZ2BNYvLKmqQ64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zJ5qEiIQ1JqJF98SZo5uH6LXjpEhWjIWSPJrUy0xtNQ&oe=69EA26D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-jxviRXgggQ7kNvwFgrblb&_nc_oc=AdowPATtfzlNSSGSTSsbSJVfeaVLDMQeP1ezCwRp3WTt-LYBJldhmv1Qc4MDO-T3_xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fv1xpY-0AsIi3SSrCu4rPqOBtaPPthicQ-nkQ9gHZ0Q&oe=69EA20BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu_AnAMM5IUQ7kNvwFdVVsR&_nc_oc=AdomoG2Ug9S9344gZg6vpRiveixgV6bcTz5fOUr3Xw_I0PjL_QNpiIb8y94yvPWCZ84&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3guw2FckepbduaM-JHgUs0R8WVl0qTcOcIpyiQjpfedQ&oe=69EA06D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEBSygfa-TsQ7kNvwFB2e03&_nc_oc=AdoD30JwytTvw2bTN1li_D86HlSPGOTyXW_chm0gH-twjC2dSXipp314KF9PSu9xFtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_agDqpESeNSZQRd9zrdfbNF9tdnmLLKS3MkeBfjguQg&oe=69EA045C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
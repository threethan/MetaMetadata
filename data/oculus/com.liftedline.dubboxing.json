uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4hAk7Y5aNYQ7kNvwFKDkXg&_nc_oc=AdplPw9-AVmoifFr1HL2WLtnopoisXIAbiTlZDFuaARvE66DBKPbA5M_NXhAGCEkeg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDT0AMH6GkQj5cSyzxuSXNJyyPlDqaKp5jJL4J-7WLHg&oe=69CD0A8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtsDmsiazl8Q7kNvwEusDAp&_nc_oc=Adqny9gle1gUW1d2ZoVzLr52X6vR2IoOg0XY69NgCzsgsiZLhCkHAprkzlsiKAG6U2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZY8y88YcLDuueP63-V-v5zEBzsNsBCWLnd2rl4d7eUA&oe=69CD25D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNFAojLidAcQ7kNvwHcRVnt&_nc_oc=Adq0m5BgRUpU3_end1aYIPUsmtG4G5WQS0LI-H0YJpzVLdvlJuRq9bZOmgN0adfOtRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtIYqvyQejP8Eg-xxJv4UfK0C4M4nuGW0eE9HLpV_7kg&oe=69CD1FBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFEyegAo7R0Q7kNvwEdm1kh&_nc_oc=AdoKAkOUarEXMkzF3tgE1uzggTCcn6GFO0g8tkscEI_DAsAvsZoT2hZplB7Vw9fmNME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbwQvlpWzPaU5Zl8TpRbibyxj1VQbA-_t2ey3Z-kEXaw&oe=69CD05D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGyJR0YMjbkQ7kNvwHwy4Nc&_nc_oc=Adp5_8AP-1Vm9z62B5aPO6ZOt1gu9GdT3ITpapkZl86cHWceVhWoI481Lcq9SBOx0WM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPbWDnndjlsXZZfsoQHROn651_Ww1P8tlnyWv4s939Qg&oe=69CD035C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
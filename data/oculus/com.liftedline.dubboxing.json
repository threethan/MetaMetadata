_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFymAC44nZAQ7kNvwHa33bW&_nc_oc=Adnh7dx2RJI36qTps0lZWtviw6a4XtUnIFmuRvvlJcgDVo7aPLkxD6QQLVzBYKSiMsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzupPxh19TXGc42vJAxq0lH5eWOPKpTwFdzkV10NmkLeQ&oe=69B0098E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi23xkyQxAwQ7kNvwHrPzIk&_nc_oc=Adnf2YVABZLkAyRA7WIkzv-jzh9siCDF74lf7OxbtOPRC9z2YNsNIVNkrrt8Hjm7BWY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw67jFKOhDKmDKJ7m09DdKIcFh9luURZ1YASkIZw9zi_A&oe=69B024D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1VFe539VZwQ7kNvwEC4_ko&_nc_oc=AdnarvXOy-viVVnRhu6LoJakBQhCCfgzX1ZIfe02iWgvCUSj4dcVGJ35BaUn-2Do9bQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzveOOoV581v4WiLj80AfDrQzsDwPO-qVHxuJaRwCSVQ&oe=69B01EBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITCrz0-pg1IQ7kNvwGAgwb9&_nc_oc=AdnK3yxeV5ZssLdwUtqr17Q1nDt8LCGnDY8_lYDcZCYvpjKXwUzwgioPJK0NgU4Rs5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBFXeB159IY23lHiHEJHqXFds5jGXGL87X5pH52T2b9w&oe=69B004D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMHHwrNFZxAQ7kNvwHvgQ1V&_nc_oc=Adl7yj2icx5FKbifNAk6O637UYuD6Vx-J4FY7f4v88jvcEwalM7qE_dO9Tx-7R2Fo1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfymC2Ve7NAPvx_2TId6cNKKuDLZbpho2roEyrbTqSyEpg&oe=69B0025C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049
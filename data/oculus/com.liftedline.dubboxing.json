uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiNIYffJLN0Q7kNvwF3yTPR&_nc_oc=AdoDvXAJ7OzeLoJe3J6GTtj_0SP0H3Fx_fRgggXK5SJhB3Krugx9HnWdicPQSABemuQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jTxxm_PzNL9H_eawIc_GlW7NuLMrBecG9oURfMoIZMQ&oe=69DA398E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FD1bI4Yrj8Q7kNvwEkM_KQ&_nc_oc=AdoWWMF4sc6DGcP4zKwcvuDsR5o4o0hKReXYCtNmaHhZg1JUDdireBGTrJzH19tnFN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1olFeEdxV1aoaGM14lmDZiHnwAB26y45HdJPEk4Ctskg&oe=69DA54D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKaZN02--XsQ7kNvwEcFqot&_nc_oc=AdoqIrP2axWoQZndDB19BDHZVDphaDfWND2JBX2L3ZV5i9AW7KQDbA_bSgxifU5BTJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2trhTTbaNGq5yhfEmAc63f_GZGj0KMKHx7O_54SyJbgQ&oe=69DA4EBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pp9DrotDvlQQ7kNvwEIep87&_nc_oc=AdrSLupc3-Wa1Qd4X6dbKxm4JGSKV7QamGnuwgHZw__iIJSqhOlSlxZadjt1hkCdjO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GChMfktwoGxkVb4fcaaqqkrOoBgwQphTFk8ieUPfX5w&oe=69DA34D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVHD1sXSQfMQ7kNvwEJo3dr&_nc_oc=Adqgg_WA55BjanpJQelQDij6JIoboIBYOqyfrswc8tbIjydyaPni2YoI24q7tq150SY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1idIrZGxfzVyEQHzWFQRRba2QuE5kJ3SA5ywBxPRNMiA&oe=69DA325C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
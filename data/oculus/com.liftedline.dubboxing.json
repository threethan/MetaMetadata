uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBjobmxnBDkQ7kNvwHqewsf&_nc_oc=AdoicxJ17cnynxyhi2p7vqcLtHIUEX_TbSz2AmtngSjcqAHvOcpZrBpvF-uBq0uvP4U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RU-h5YjOLkqw4ea66UbjXR6gLBRNr12AR1V0g_yStaQ&oe=69E2228E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlRJNoM-q0oQ7kNvwHHrL2H&_nc_oc=AdrbkReGdDC3tQLIcdwAIW8QbhIO5AL2kBoSJUyDBO-WE6aMZfKZC0mjm80FTaeQKeA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CI_EHr7LyE4g2pVooUus6iMKyNwF-VuBjb0pD0EUFdw&oe=69E23DD4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIgkFqwYFRsQ7kNvwGpMewe&_nc_oc=AdpAupOMDO46P1g6CI7c4R4ZmG02Zc6B6Zi_VZOSFUTmv6oUDyJb_ag9AGpkrpsLDak&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CdosRR14q6opI7BZV5ZN5gtx3poacyV8XRPYb-M214g&oe=69E237BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOIv__SQRPoQ7kNvwHfazPj&_nc_oc=Adqud_SfFts81ACCaOg2by2byQOF2vE64xLIpp0zud4-XntbzJJngWmTpSfMqcQ3P0M&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BGY7EoPCteunjJK_gUO2oDKOt64r7IY5NVA0GDw_8Ag&oe=69E21DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIvHcMeKDWIQ7kNvwFZ2Qvz&_nc_oc=AdqexXl6MHmhp5_BwSR0brJPkmqeu2jSIQTrgquHuMbnm1D957yVsTFZQ-W50NMxiiE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V6_ckuojXZbRdtTBTG0wIo8-FPAk8HqbsDDM24uzT9Q&oe=69E21B5C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
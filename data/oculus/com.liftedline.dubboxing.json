uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbmKo6EzjtAQ7kNvwHbUix2&_nc_oc=Adri5fms1Rdnp3wj3P3_eFfXU_YQBCg_TELx27Qo0456nGlauQLE8xd2CFEyxAIeuCg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxqQSwD1hNfsucaUyl5XRad6t7qCU4Ib45I4GOCzEjqw&oe=69C5218E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM-lk8xiOf0Q7kNvwGJhaeE&_nc_oc=Adr5YYg0pns311iJcnhU3pHr4B083s9li_W9vU63wQHBl4xziJJ7o9ToVnMpI5XSamk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzwu-Tj7Pgd12KHkZG5xIoY-vP-MpnUyqb_HQ5dPyqRxw&oe=69C53CD4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSrrxNO7f_kQ7kNvwHiVLsA&_nc_oc=AdpWPg8lbqpwQZN46JCq4_AivCfEAUcMcZRTqSfR-fND1l6NlYbmkQBmrloyX6GDq08&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuSjjrFpQ_z11uMGWpnqf723HjFcH2EJcVUL0kwxw2uQ&oe=69C536BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW9fdsCx6VUQ7kNvwHcVdPJ&_nc_oc=AdoO5-fSt6J5QJNJChbng6pW8vc-6FBxxawiw2nbaI_i1mHJhoMTKYPZwD91JS5OFMM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxRmERl-hhclMr7fBpgMe6OmWWJBC5dz4A1fVWJQDTQA&oe=69C51CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBCJLlmSG3cQ7kNvwElwCPa&_nc_oc=AdpRYGP-cU085uJ0g4mN9qmhicOlb3zabIjk4zrjZQeZE6GSy0MwxV83uvc1ONnTZRA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLcWUDCf0gZnYXbm9QeXFOUJBJ08t9XKismuqKOx8aag&oe=69C51A5C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
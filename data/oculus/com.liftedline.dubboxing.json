uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-lIEey8SqIQ7kNvwFt7Wgm&_nc_oc=Adp9odwzZYmzhMooi1eelaNBr7eHQI1z-Ub3Hy_bCyBOwJ22y0VThUYXGMBlWxVBVLc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R2YuOZj53SrIAm9NvRWueCiP6qk_j26F_SgUwPxY1SQ&oe=69FDD20E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxeoZjpgUjAQ7kNvwHHbnHR&_nc_oc=AdpmbZGMPSiZgVZkjRDSXCc6jtKLbGTgKIgN7xwhFLNtCtHAOhVSrFVbTO46JDJG_wk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BTc_OZRGyTUoOmLdp1Zg-RoJhQhG2aDwKpdGQdEYlUA&oe=69FDED54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y8PLvPj1rYQ7kNvwHrzGyu&_nc_oc=AdocBy6y5pYi6C8ERjEMAspP9N-V6mjHr8USI-GdYRB5KjT7PZFS4Zmwf9cmceW0itA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v53esbyt9EoHC7umg8a6CjknZ1JX7pi0hyQcMjS7Svw&oe=69FDE73D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcHqOayRGwUQ7kNvwEQysUz&_nc_oc=AdqBQHIwCWSarm-rzbj5K0sxVNcm0_EB7QdYxx1INRYwjA9NADCHE7znU2pzeWZ_Pw8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49dIhrTe4byIAEiVGpgCwXls58bEF0aMqulOd43mjVKA&oe=69FDCD53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWKh_rHg96gQ7kNvwHp5MsW&_nc_oc=Adpa5lc5fAKllkYRl0iBqL__6fMU9NFpWGaTApZT3wA6_X3paUfqCxPMih_NPFQxyWw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qB9hCTIwdGp8uBIn-2BGXwihJaHtu_W5zVYWku8iHtw&oe=69FE031C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
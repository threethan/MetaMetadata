uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBjobmxnBDkQ7kNvwEGAlPN&_nc_oc=AdpJZ0BGA_gvmqCl8hw1snPPgyw0RUy-lfp5zgkr26UJ7hrShzHXUPqdoup0ci1OEdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PJP0cUexhjxGCBwe_u0DqarxKWstRkviHqF-hKL8MJA&oe=69E0D10E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlRJNoM-q0oQ7kNvwFurF8t&_nc_oc=AdrO2yMdgxAvZ6DjAYOUgkS1w7y8hm5fHD3324C16JhjKAv8MPW2Ty2-FcMOeSuAC2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OxN1eXgs6GYEkO7Iybfp-gzfBrLEbqz_bVEjUQ7s27g&oe=69E0EC54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIgkFqwYFRsQ7kNvwGwQ0AL&_nc_oc=AdqIfUtPV9Gxpufh13abw7QHYjw_mK6AjwCQCxeISmsIyFg4wOw3rs41iaPPDIHZ9Mw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HLuOuPkDA6Od58H8rvVUWaLsCw1aovj1_gYb2dy4_iw&oe=69E0E63D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOIv__SQRPoQ7kNvwE2IXpK&_nc_oc=AdoxUb2yuxANzbKBBl_tu_idB71x0ROsLHjFt1UOWfhT0CTAu-G6h67bK8CeVaFTqHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ko9PP9IkFK6PkWF3H0r75MlhwkbQVjq92mKgh-Du-Gg&oe=69E0CC53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZewRmiDxqgQ7kNvwElAjEB&_nc_oc=AdqFImKcyDvkQbl0S4M16I-eB-T3AsSfztpknknHB32RgNr8krwfjdGRUb1fgnR7MQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wB1J02RCBdUU1QftHnxpYVUzbIrvyvUYbxRl4y1Prlg&oe=69E0C9DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
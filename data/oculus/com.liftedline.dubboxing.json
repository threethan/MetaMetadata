BD0855"}, {"file_name": "Mad Reflex Mixed Reality Still 1.png", "id": "406499402217736", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxyQd6hdRRcQ7kNvwFgAgxp&_nc_oc=Adpb2rZxa9I2Fwr_nDCTixq3_bc12uLW2Wpx4tQHGCsD11dL0lngJlNezATZg1c1ViY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQaikUCGj5EiSB2qoZdgVyCdbZI07Qj1Zi2LeZzYFL4A&oe=6ABD33CE"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1-8OjrXQ_YQ7kNvwGicuPH&_nc_oc=AdqMob_yvHRuz0aGrGmxBhdQi-5RdudYuWS9SGpDqsTSiaGhWpxzPiefcnLGDK72wPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf3EE5YKIWUZoNQ0at7hbEdwboMkTnAR_6VLDF0qwpFQ&oe=6ABD16D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiIPOJI7vroQ7kNvwHR3VsR&_nc_oc=AdqWFxxckR6fSCBSjPt8DxZvejbQW1Gg3hDpaKBVur_bH5JuGNew04wYjXM6-F-5PVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrEJXwh6WokalyuXe0vdsm5NGYlaEuhd7yCVF5Uf1MnQ&oe=6ABD10BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMfFF8qCnGUQ7kNvwFOrkOn&_nc_oc=AdrWhlevyFSgSbNFaxoz8Glw7IMQrPEXUsQsD_kyhs7e3NbtC9SZ6VKhv1QK1idoUHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1ZQ1rCciFjqfSa5TlbQ1655eL71A4FbcxUGaVlxKeOg&oe=6ABD2F13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zpHCvBji3MQ7kNvwHWJi0J&_nc_oc=Adp6e0Oe-cwSd_YHeca3d1PVJIU5N9759e44zedzAhuUeYXbXjdLAV_1bODGQeQaJr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4kHWD6Tbf4C6f6Yl8U9oikN33sbKRGaQW9j_1EPM9Aw&oe=6ABD2C9C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category
uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwfgOFc7oHAQ7kNvwHDd66C&_nc_oc=AdrvXclp-Isnc1l4237LhReB7iMRD44XmiRHGWdiH0BQc75Spbw-6sTcxfeMPUDk4WU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09kAFDAf51bYBoBRlL1nexfKfo2OLUTwDX_JQoWgaxfQ&oe=69DE2E0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBq84K3j4eQQ7kNvwFmsByL&_nc_oc=Adr9JDiq479gziLCYzHxT-Iz7RNIKpMSCj1UeOy0s3YYYJgnHF6tgF6i1sNPyUW9h2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FnyPVvzAI0WCZeK8mXHs39BIO3ywm2hgM2idm9SD0VQ&oe=69DE4954"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZf50lAVeQ4Q7kNvwHy-e2g&_nc_oc=AdrpIjJzcc7eGQ2lNeZVTAUBrD7PQ1qSP5VoMVb4BXC8uwL3k8ZnN3jClfXnf1ozh-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10eyaV6GSPnk6V_BQgodawVfsAB8SV9InhC5hk1TpWTQ&oe=69DE433D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDAd1bCWAusQ7kNvwFGn6XY&_nc_oc=Adqbdid_z5Qwt7JCm8p28OomgOsFzPNKJPp9eyFEUe0Wl60U5JHVPOp4H-UF9r3HoDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JGajvf_R5n4LqwMDpTyDqggvHapYlEyPtH5ukXL73vw&oe=69DE2953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZewRmiDxqgQ7kNvwHL5PMq&_nc_oc=AdqGDWzHUi_o4xBmwBiVjfcZ8SdV4Pv4s2G9L_yrJjGpwEa6rRPG49C7px1HLw6WOK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OxNX3mmIN3wsDGgZlD7zfRgAHnTcLZuBK0tEuSkhoHw&oe=69DE26DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
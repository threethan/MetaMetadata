uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1kxNoqbLPUQ7kNvwE4IOSR&_nc_oc=Adqo60TV7k55LsbUxtSZkPz6KOwdypgJJfDo2dNSvAnea2Sh4lr5pvlwodphWT1PLy0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAUbTKIejo7yS98jYJ4gUga-Ps3JUhUs7HX78H6brE5A&oe=69C3D00E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM-lk8xiOf0Q7kNvwFtMKDX&_nc_oc=Adq4rl6Iq6wVvjC-FJV9mqDELu-rP7058FjeU9Hw6JwTnOeYZ2czvAapBUnv1wxcuMo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzvy8670Ahe8Ng40c00pLEldC5pmCssVNh33WBk-8CFiw&oe=69C3EB54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kn0o1GmqywEQ7kNvwHvEi_w&_nc_oc=Adom0vPXYKR9_WpjxigQD97bfGXoUkO0uu1PdRGtWNGBeaZNhGivwyMpUK5HcAsRro4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afznmp7sHTy10VOgqO4WjKq7wvn3OolZm0L-0sF3mCX3yg&oe=69C3E53D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW9fdsCx6VUQ7kNvwEkb0VS&_nc_oc=AdqsxUgaPvtuCba-y9S6OCJ8PYuhc1aqxrjfwcpd8P9hP5HFPyJTWRgovAzGt7jZqQk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCYvMSxjkoYpOX0b5vvPK6EeZDKfi_EXIm9kEBD1iL1Q&oe=69C3CB53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBCJLlmSG3cQ7kNvwHhcZN7&_nc_oc=AdrYd7-uzwr9js_jBqHyu-aypH1CQVn0dsEj_pwUxGrBt3KQC_ELhYytaaDO31zp_OY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvXLoU_gMCr0wWBQ9h8iCZ7dyFzjYxk49reUrgUnVn8w&oe=69C3C8DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
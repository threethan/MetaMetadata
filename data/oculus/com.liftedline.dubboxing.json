uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXfhZH3P7TEQ7kNvwEE51WX&_nc_oc=AdpL9JlOsQLSj-wr26iY0paECCpoaiIEHIYwCf_AdD1wCtjuuz61lv-Fgk4BGbMTw5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tO4FioijlO8cGVPzK40QGn-4Wh-ILKRiiZMF7ogNNEw&oe=69E4C58E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djF0oMwMtk8Q7kNvwHikrE1&_nc_oc=Ado2nH6s_b9qL8Bbz6pTZ8Zlnyvlpkxf8gh5qtJNRYSJo0Sed9OhcGPkA9OnpxADEhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j-BHidlgcWkinqTNlwk_W5yQy5CLKSJXm2MaITs9uSQ&oe=69E4E0D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc_EcruDpCwQ7kNvwFjPBve&_nc_oc=AdqvT6SWsFhJGSDPGfLZRamxJamqKk8cqXBqOniPxf7hFTg4pFHIsJJETFEPDcM31Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03JO4p65b-IPKli_nbZnUt2XxfZF3CQDrNMGPpr3LXVA&oe=69E4DABD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPxrDRkedAcQ7kNvwEkUuvi&_nc_oc=AdpgzmD9fS26IxDdSKz6dEaz3ZCwPlgwkAO-B5-FubpD1DALp28_5uy75jMip-VIbSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Kn2ldhcV9AtR1u_LT27NUdOevZQP517VC7uQyrXUHgg&oe=69E4C0D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIvHcMeKDWIQ7kNvwFHC2Cq&_nc_oc=Adrzx7V3ienRhIhvCM7fRs4MWYSUOtXvy_V9KJQa4XMw5blFchV2uk639Mne7bX42lI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HTlITzyWfKpebMjJO7KpQJtZ0kxf61BZNh_i6cGcnUQ&oe=69E4BE5C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
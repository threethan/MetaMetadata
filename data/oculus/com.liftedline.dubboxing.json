_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc1H9SQUofAQ7kNvwHLFyIN&_nc_oc=AdmetZu6PJ6Sx9lpPlN6q0WPXMfHF_bFTIUzelocIvlBqueUJSX_femyl3JHVZb3UJk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-xSR2pVBMRL6AZaEtir3ojYQTmAZ_d8Rpat8luntzYQ&oe=69BE8A0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLHdeE63UKcQ7kNvwFJIaFJ&_nc_oc=AdkHvUbJXy_U5XSF2hJBcuWwWysniIHuDI0o3EspdtVMpCVPugAz7K3ZAEQZeQ3TYUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyhp5oyfjK72KWLI4uPCWiDb5c3hSrJtgvUEIG96WKFHg&oe=69BEA554"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czJbzytNur8Q7kNvwHF_Qif&_nc_oc=Adm3DTEF2125_26Ut2u5wp3whZXamAhcIDxO6GmaQ8BwzdAid3ulNc-M9UiQkRP7ywg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwg3-IpE0uH83WDwP13rI3fiBj26Os91VnSwrZJwZrSyQ&oe=69BE9F3D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msKQuRI0SpYQ7kNvwHBiqGx&_nc_oc=AdlLrmnoIONRGIwCIpKxzy3gPcJDMCoSTcRXz51wtr7zX9tAxXW4IINxiIxJpr3aU3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-sDASyKnq2UUHI6PfHymlsSxJ2knjfOXIW6LwONktZg&oe=69BE8553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN2wsrIBpRkQ7kNvwFyChdn&_nc_oc=AdnaKU3cocxR_NeXS0TbGw0Q01-KsfsQx2JsCUr7zXh_Y0PBdHalUbmhur_8gQpITqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkbTPu5IojcvE345bw2SIB-f4iRkPd0Qic5QUbO_k9cA&oe=69BE82DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049
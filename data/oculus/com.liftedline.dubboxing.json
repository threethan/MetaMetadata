_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFymAC44nZAQ7kNvwGOK8JP&_nc_oc=AdkYZEd5dez62lodd3tQ2cQ-s4uqfALS8aKlMRojaySf7lcEDBg9kQFyFvDPimG4wag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsvIn44s4Z4PWgMP1JaEOeCeZK9Q1-mmyBsjISq8istQ&oe=69AEB80E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pszofChuhYQ7kNvwFqkcNM&_nc_oc=AdmpiqEYtO3-se8knzDVYoKGIGB8oQxMbsgrl1lMsWi58IG4dhuFvv9RdTtyTsSJeXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEkpVVfLL_21yHExjIOD2vkG5hhQOzVRDz0ruE4-nzLQ&oe=69AED354"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1VFe539VZwQ7kNvwF0vXZC&_nc_oc=Adn_e1wDdMbkNGUppz4hoUbMGBgbGNO7mAAbSX_VeP2cPKAE7WpxysD91U67zCjw6GA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaO7UoNvfCBdbDgOP-GMloUL5GP0v3XSOGZbW-OaLl4w&oe=69AECD3D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUpH9aJPFJ4Q7kNvwFyHAts&_nc_oc=Adm0NS20qNn815yzNSCNGcqd6J0s9YP-unWcrwA7nvYMx5aYHc1IhwKclLvkJz4pXo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYP3ijaC8f8t-0eFSxWwly3d_F7HA7DhZ5UvnnfhUwzA&oe=69AEB353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMHHwrNFZxAQ7kNvwFXGfY1&_nc_oc=Adm9c9iqIReNpIgdw92A4AFBrd3kwzs88Q1Zz4_nk4QA5nNru9yW_IO1qKCHfpGw54w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEFFVDESjAHQ5yefD3M3jsV349DPW51MenAhkIVAmegg&oe=69AEB0DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049
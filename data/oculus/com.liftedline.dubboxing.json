uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiNIYffJLN0Q7kNvwG7-aVy&_nc_oc=Adpu7H_YXQIFz3Y_GIdOXYwdsNUVoPaDl74sjPsU5tKraQdqKuM3DtRLtS5DOBIsGiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FydU92lKRaaH8QuSD2BuBhnfkB0riCoQI80JG8wuHzg&oe=69DB8B0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBq84K3j4eQQ7kNvwHwSOt_&_nc_oc=AdpE3EoaL6x3lPT5beXZXewKkRPHtfQ3YbfJF-rwJxtg3JCE4ufzymLEwus_2qypTBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xJ7au3ypB9ZLv9-Jd2RelwPvhs0veouPPEZLFDq2gaQ&oe=69DBA654"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKaZN02--XsQ7kNvwFymhvP&_nc_oc=AdraFsyItvhh5zC0IRPoSHklretinN9MrWexc1iioW0yhplL6CB_eYdbf1SF3TveWL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q24Y3RJCM93Kstay0zZkffZEYHQLfvYcTRSaZm9AICQ&oe=69DBA03D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDAd1bCWAusQ7kNvwERJpkO&_nc_oc=Adqt9HrVE-fSpNidYsTezlt2H_2JXTF4ajGKLV_vpMBp1RjsBEfb595p2wuu4v9Q3rY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08B_dN4_wAm6qeEkId0ZGTpMsdOMYAAKNwRl4EQrSRXg&oe=69DB8653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVHD1sXSQfMQ7kNvwGjKhyP&_nc_oc=AdpgBafqMa3yd26nhvCmirqp0TZuyX_BTLkMO-xtJEX3EirfgTx7-movMTiq53pZaQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R16dpPJw-0od_zWr1El3iPThtJIG_Ty7RZg7EXOBKIQ&oe=69DB83DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
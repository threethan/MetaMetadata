uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-lIEey8SqIQ7kNvwGKpEh9&_nc_oc=Adq00866amMjPrqis8__greRPALwhQeMxtvcXoABIVauNX3MioNLJle2d5Te78b3dtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FHloHeuV8GgS2qlisrr75bov2IhedYfakTY2_GjeGJw&oe=69FC808E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxeoZjpgUjAQ7kNvwEtnsxc&_nc_oc=AdrNyikz-p6dIBYX5JY34TxJuHZ4JeKFQ37GWsSsI1zlMou6SuY8SsCP4NANRBgUekA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ct_P_CwHd6Poeq8rc3pX8bKUQOuGdGMmN7lex7ndwSw&oe=69FC9BD4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y8PLvPj1rYQ7kNvwGWw8aF&_nc_oc=Adp72Lzom_blaUuxyu9hnRjbLp35MxJGcjM2FYpxpuhPqpvXZEssnb1FAF28LdakUiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55fLCV9ZmnZnG7rkhqIzP2rntwP8P4rv12Pgk2iHR56Q&oe=69FC95BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uL_eLKPLNYQ7kNvwHkL6cw&_nc_oc=AdqwHqErQWiw9XnhqD73c37Lq4Gp6X-7lmg62T9Wj8zSXzuMtdktaVTHVWE075rSocU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5invnr_yNd1Ra2Rg4FpNJEFIbs5UMMzLNUWuEWGD5T8w&oe=69FC7BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTsTOTdNT6MQ7kNvwHg9o_j&_nc_oc=Adps_0d-TVdZL1kOf9gfcN_bi7AgqvOM6sO1o484YynTS7yTA8Q3JIkYnkypgvEPDwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EPS5dJPuY0SRpdkyqHMvJWkS1BxzamXtWR4T2bjqWlg&oe=69FCB19C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
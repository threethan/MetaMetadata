uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4hAk7Y5aNYQ7kNvwH9BB_x&_nc_oc=Adp5DmdjsH7uVOpyCS8mZ5vefCWXYpRA5pbtJMSj8h0EAZO1VtPtWkyv7mGV07UDEOw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4uB2pmNCPow8-D1jKffbdW-GrJ8SQ9DKU6OCjxB3U2A&oe=69CFAD8E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHT--bQeIRAQ7kNvwEm2Bdz&_nc_oc=AdpBjHsDL2IDiaWWduqACeQz36G6vPAYdPxthHfbTPXLN-okzuA71OKqW3yefsNnw9U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0flgsyxU3mc3Po9IAcwuEvNiWVWecghi-ZqjAoPjpDg&oe=69CFC8D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNFAojLidAcQ7kNvwHVqI7q&_nc_oc=AdqPcq6JZBMBR8dGqSGR7gMaP6bf9os0Y0w28jbjsySAx1IKrqmi981zI2DVm0U0qDY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMaH5-uulsUq4z_QlSse2rZh6er3iKQVDEC8qxVzo8Lw&oe=69CFC2BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkC-45MP8hsQ7kNvwHUEAow&_nc_oc=Adozc6pgREHqzWS7kFf1KgqwhcY2dZWi1yVOUNa6-_esKxUGoPEAeGjQShDsTKp8J4s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-EgrwWou4VXWidH86z2kga5JKddCrQZi57dhI9GF_VQ&oe=69CFA8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTRYIPlYT9cQ7kNvwEdTE_5&_nc_oc=AdoZW4SzZhB6dawiO88EgeMH2_UT0NRgDBLjd_GVckwUvgcU9yzX56lnCM8_xjSAuG4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZsyZ-Sn2A-nSYg8OAMAytxI8GE2DgKnAyCrlp6mXpDA&oe=69CFA65C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
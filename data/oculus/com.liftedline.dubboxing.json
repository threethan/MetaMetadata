uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-lIEey8SqIQ7kNvwGWhF3Q&_nc_oc=AdoegK_fvi8W11fvkaUkq-kqoWLMfL1rzF7VVrD4HXJ-zNo_OPj11qSsBXe_PwE4lAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tW5zD4tFxbngNjgN_wa1hbrkGLaczH-KijodbSVfn9A&oe=69FF238E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB7G6DU3o8MQ7kNvwHXUVCW&_nc_oc=AdpBXia9GykCbgAlE3t959skOJf8sT5JNmQqdqviaDMxLVYlfWUu3sCKH-kaIrtw7t4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H48fkUCf3ZrYzis-VAiDAvXI7H-aIfCpaxI6hIeIdPA&oe=69FF3ED4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y8PLvPj1rYQ7kNvwGrzeke&_nc_oc=AdqGjHWf3GeHW0imjaMoiJyFmamWYJ93CvkaUn7mqnr4uCaC4Lclmmwo9yWc1m3mvR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48BCbAUyES-qt7t0QFNkClA4gaZ6wl0Y59-aV-drEpNg&oe=69FF38BD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcHqOayRGwUQ7kNvwFjMA4a&_nc_oc=Adp75vF5ykVfDy7aKmHpRzzWr69OV3ln1_NlSFUei0YX-YRl2YrCnG5jqX9Fb_pInx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gV9dEADuJIKASHtdySQwiDP1HXs3BsysqcOv2ptLuSA&oe=69FF1ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWKh_rHg96gQ7kNvwF0GMuE&_nc_oc=Adr8gy1KP76GI8Hk5K_XaOSBmLiTWEwUkitm2RfnjZjTvgKl3AgkiEW71f47jBbegf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M7w3GSYg9dzF4dM-Gppm7D3pz_mWoJB4WOfpvlZkHzw&oe=69FF1C5C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
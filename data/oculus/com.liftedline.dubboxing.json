uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiNIYffJLN0Q7kNvwEyJdcd&_nc_oc=Adoy8Qp9Ct-GLWrviI5ongd13B70fMQfZPtV5Gugf_lRgtZ4ljgbEcYGduGUww-VbwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kQ0qUIM1G_LArJEMqFLmEPRO_TGWPgjAffa2mylIGcA&oe=69D8E80E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FD1bI4Yrj8Q7kNvwGkFu3E&_nc_oc=AdoX3i8gzu0xqssa-1JfaXY8NjF8HylW4T_MQmcswVqSNTj_YtSwh5v2z4oaPB-Gmg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31Cy5boWCZrMSQq-lTmvEij_RfjaEy7JmVXTdt7hCRHQ&oe=69D90354"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKaZN02--XsQ7kNvwHPvgnf&_nc_oc=AdrnL4o8Gie9zdM58tLI9q-Hz465vlWiC1MdW9hO4hQcpCmT6q0kDCSO3Z8I9VvAVQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l_6CivAVl8jlcVl5ROGNhyfyHl5uBi76v6qOyAwWQdw&oe=69D8FD3D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pp9DrotDvlQQ7kNvwFq7q-C&_nc_oc=AdoPSQSyQCmDjf5J086IKKgEm9QN35NX8m1WUlpC9n5bDNETtz-YJby1ViRwkiNzvtA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eFniT3a6XN3yKA4YVa1zKn1Ac7KLCmbiAeG6ay-bFBg&oe=69D8E353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2GEzJGciPIQ7kNvwE1-BTd&_nc_oc=Adp2ZUkcBpZPSYqAuaZLt4REDImXVDybeKrcL0WlunpiqvZR7-hpWH9P5QlIUzkSYZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qxrenF229f_oH6D_wQsFw8aJfePDM2YGbbHzsimBGNA&oe=69D8E0DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
733455"}, {"file_name": "Mad Reflex Mixed Reality Still 1.png", "id": "406499402217736", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYZmQUigBEwQ7kNvwGTq3hf&_nc_oc=AdraoSAtXttPXSCUIAIcYRbNxnnNDRDx7Bridwvez6RRWNaKzDBs4j6oWrMa4HNc8UA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJy1QNpxPPg5-XzJJzMK7bfinVzRYnYBfbyB32roIbdg&oe=6A73278E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCgZjmfIN44Q7kNvwFadEL0&_nc_oc=Adp3gX0I4HQLETPRLcO-U_8Tt16L4opHGmev36hlDfX5ofhwCLy5yiKbdqxuTlliH5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ3mKHnWS1ALlrMTmyHbMNEioibnyyEyKd_ZLN3gje-Q&oe=6A7342D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfFarI0ulOAQ7kNvwEQOKDR&_nc_oc=AdpkWKbYyAu1RWyK6u-mjal19ItpKo8gxAftuAXRSJK2Da0BpxCzsX2K9bk5jhaYLHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHc3ukG2GADjE47lZdo3xLYall4ML2COxbeXcFef86rbw&oe=6A733CBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X1xDcFV40kQ7kNvwF3OiQf&_nc_oc=AdqrmNCQtm-6ITEDq2ledc3pQ-BehtcXUYbt2xbozeRbYwN3Y4LTUnAWvSHtzLU6SYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvhmYQ5J3FpkyOBUw-ssf4gEglSETrA9sCqkDavyXhhQ&oe=6A7322D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW9Dx0fNNwIQ7kNvwEAYP5a&_nc_oc=AdozO95C4Y_CCa5A8TycJssdwAU8EYbrpTy1Sl1E7LL3vwdTHDJkDTSgUV2sIeuGAms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH9NYZRm6vIOIad_3j1YvigRTWlZ7ifkTY7D8rP0XbSw&oe=6A73205C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category
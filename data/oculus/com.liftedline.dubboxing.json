uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3QvoavwVM4Q7kNvwG1puPH&_nc_oc=AdqfEUVTAEBbJUiL5dxQgH1BceZhbZhDN1lAK_0hXy6VT7cuVnyXtek7fCxYewKLv6M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08dGBPnNXI9WRRHDcioIr8uEM3dceC2hI6Fgg_V5jwDg&oe=69F3460E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_8GDXEYBvUQ7kNvwEY5HpD&_nc_oc=Adq5B81O2oyN5eCJ-fZsUZZT6Ga7aDFnciqYrF4xdO8Ut8SoaM4QwfaWokwnMS3w4wo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0maWgr54KBdw929xW6z_7IUrsnVLOakS7KxZMoYrgzHg&oe=69F36154"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-zbGF5XUWgQ7kNvwFNBmfv&_nc_oc=AdouZCmOfMh4D4A1Kv984Ab9Qk961QlyzjqMT_xl74Do2fa-blaPVKjsJ9RSAqGFWTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2s3e4WLSZYqzupliL20QKn3Cx5LCOdhDeeXnirbB0A5g&oe=69F35B3D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIAGb_ovVwYQ7kNvwE3qhmZ&_nc_oc=AdovuOFn2zIpUPBWQSaZGoY9Ad6ZqR2hBWoIytNE1iNP4oHXr1lmTg4TLeuill08B-k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0d6u9R2xhpy-Qj72LQD0o6YjNY4nZcYtokvCuHob4N5A&oe=69F34153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t23IX6606AQ7kNvwEUxuQH&_nc_oc=AdoYm-nxeiW5noE2Bs-NO9l_Gvao0pY_nB8C8phZQ7rRR_ceLAjb5nM44BNwBN8FjHM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BDP6WiSIhHbLoFexA-ihB85Vcw5v9ODGVTxLJvmwNKg&oe=69F3771C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
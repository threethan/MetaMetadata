GA&oe=6AA941D5"}, {"file_name": "Mad Reflex Mixed Reality Still 1.png", "id": "406499402217736", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzuyDYMZGUsQ7kNvwGLqrpp&_nc_oc=Adr72FJ_7QmiP126PNf0sTBm-9AXFW8v42K0y0h7TgbOscw9Fpep-rNhz5xjdsl4XuE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIb3V1DbNRRP0a2mIFW96xLufFiop0O9KQagewFD9MnQ&oe=6AA9350E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyIw_IcAz_cQ7kNvwGW86SP&_nc_oc=AdoGm4r17bttIXbgtyUTQlgeJ0NScooa9Rgqt0bbvsKyBYSHgeGPGv61-8dcH4YLFzE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr9bvDbYE9yh6PZcA-z_zaekuJv2qcVvF-73vuebmgKQ&oe=6AA95054"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wJsj4ZgK1cQ7kNvwELJSx2&_nc_oc=AdpooMG41Da46y2ME8pfeFhGRoUzorCEmhEWDne5xl6tRbCC2f3rzfWJE7HAvfY6ecE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0gh4ZKrqR_wc_BpSKsLeLStx3OKbsiVOm3rcROoDy7g&oe=6AA94A3D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaoNZoOwGUwQ7kNvwHAvivw&_nc_oc=Adody5GNrWH5EaDlkP2PpAK4bNcz3yjYTKqOkPSIlI8D_bkQEPRJEUJQsLcC1zonIyo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImAle2HZuE1Ph3IpejVMdru_LMTxHHIm6hUdRUc3VsIg&oe=6AA96893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TSd7pIHqQIQ7kNvwGWjPCm&_nc_oc=Adqq-15nYok_Ejp8-F1bEHgVLuZYVXwqBc6qw5-BoZcfZIBz3U8_gEJaV9etyUHIAVY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvofeE8M_0sltjAM7k8Rmw0MdmNTnY4uAXdgXm_zsfsQ&oe=6AA9661C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.co
uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEa31J7MgfAQ7kNvwEouTOj&_nc_oc=AdrC_CJ5QJd3xuoukSVarjoIQZQQgh2KmQ1TbozTTFub636XYhZDBINhHFOH1Y_HiW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyS1-TVRkc1m1NbtnpdE3og4mBbqwueF1BZO76SSwK_hw&oe=69D0FF0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHT--bQeIRAQ7kNvwFVD6v3&_nc_oc=AdpySb2wBs9wVZaF5NPksT2yARVqjTAd_J3lM6q4ZNGjs6ucwYQadw7w0cBBoLeYELg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylppUHL8WlkTo-Lz-bnMbG1C3Ybb8rvd7-BgzeFRHI6Q&oe=69D11A54"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7XeEvnVaHMQ7kNvwFNpWK9&_nc_oc=AdpTW2J7B_hPXoCHhrX72iU5ZVVnk3V4X9oIRqJC-NeTKNMBrDDzdmlCrhBIxcLHLKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIbtNxXX2y03lOpsymPObdnrijuMs5WMwFunZBoU8EHg&oe=69D1143D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkC-45MP8hsQ7kNvwEGVj5k&_nc_oc=AdpqbVXz-Vy6oCsmG6Sb6sv2DeGnO9PiUOrLRk4i6-VCsEuP9c1dYozruoRqNMQHIn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYy54lL6fvS8WWFRvko_b_A4cXRCd2hcpqP3B9HYT6Zg&oe=69D0FA53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTRYIPlYT9cQ7kNvwEPVvn6&_nc_oc=AdpC8UOaOLlKDTtbJENjYE6uyzxz_agYu2ED0XfXXrNgmElP2WImV6H2nNJKYpfzAcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFrd-yQ2E4vSHB09QZ6kJVRZc88xa18Otr62O9Z_pNbA&oe=69D0F7DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
e7a0a&_nc_ohc=3zZcxuOn6boQ7kNvwHK2Bgb&_nc_oc=AdmGLqxEPQwEEw64MjSy0Bti_01pytvE4PTLahk6dKF1wOG57N_ye1S9XDPuGhi94ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsu0YzfKWbOH71YuVwAaRWuK5LEz0yOGKmN583iYOQ8VA&oe=69A0378E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1GQV6dojbkQ7kNvwGi7dTT&_nc_oc=AdkMMuGLX4T_6K3SxOeWelit7liZLBsJOM57zZKlzMFDwt80EIvjQMcBVNU8klZnpEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsC9WaM9c8HDAynkwOBA9cqS4iSPc3np6Rsq9xo50VV5Q&oe=69A052D4"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGVi37PyJiMQ7kNvwHLjali&_nc_oc=AdmR3z9Ick07wYdmw6tEnu35OP4pWYusoEMYmU9Ie6KcuqYm7Hn9G3Mdi_5vY-EMYPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsHF1hYzTz0rQvdfgM4wGFHN4AaTS-V_jyumlH7XeDMfA&oe=69A04CBD"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuKVaigwZD8Q7kNvwH7aSAk&_nc_oc=AdlKycChMiG190ZojMTM4cFTKQXIasddYGs2aDnaewHfu_APwgnzQt3Cxtj3fN13uTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuzx1pH8e7ZqrJUAC6kSC-rCnMZwU1JWPR1adb-w3hf9Q&oe=69A032D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oziUIVf8qNQQ7kNvwFp_iIY&_nc_oc=Adl-e6rDXIlXQKHzShOuU4MQZB5LcbZO_5VCtGX19JsVtQu0m4ZnAbE1qkAV33QX2xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-oo2d9DO3-Z2rVQ-H1b7QMjgo4-OdROobntGgQ_4MOA&oe=69A0305C"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app
_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jACaH9ZIEqEQ7kNvwEtte8l&_nc_oc=Adm7bcVml6KfAl1u5PyfVYs2W7G3-lgbnKPO0lOO1Hk8utZ864KUAqW-OHbeNkodOoY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfythO03BSbq1iX9uLk9IT8bDk2TAtHjVBbbXy9cm0-f2A&oe=69B15B0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wi23xkyQxAwQ7kNvwHnb_qS&_nc_oc=AdkJ_E5qyLpwECzMlFZAaHw0bCZg-ZdzQfpA3wOe9SzNeSSvhYvLSyefVT-9I7NIX70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJnm0UttyHKUZnKcbvln1-JIeQ4qjCYy5Lt-JnR8KvSw&oe=69B17654"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncDPQJ7H0_YQ7kNvwG-P1br&_nc_oc=AdmbP_PsYb3cfN0T9_VJRBGIlZOYEc9raKKd0mGyNTwNzJb51tJzing3dF1HqLhNO9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpEHkAk9ZOu-AMN7cnNC7mi0mrX4cB3OPwsgXVy1uRvw&oe=69B1703D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITCrz0-pg1IQ7kNvwH0GxmH&_nc_oc=Adlov1b2Gcfjr8L2g0jrs87ij7CgTbWpfZ3UZUqrpzO6ou2L3rhJq6X90o5U7LwT2Ms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzLJFaiQbm40JVqTSPF4D1Z4CXhQ38qBqMnZ_6T7WmvA&oe=69B15653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMHHwrNFZxAQ7kNvwEH-XOm&_nc_oc=Adm95ovyRVNff9sY0zirczvoBL7Wv7t5Sva1b0CDwQs7ZcVPSF8zoQxmPoaP_PjdTi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEed8FIFjnXruO4CPj9gDLLYlAawA0a7nYAqus9o141w&oe=69B153DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049
uscdn.com/v/t64.5771-25/38974512_406499405551069_5110302358913969244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4hAk7Y5aNYQ7kNvwG_HIt5&_nc_oc=AdrTGrs72cJbXMh0gXSogwqZHzo1-ygW7Dg5IfCt-DiGQ0n0J2AtQqYw8LB2BzStdcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5HyrhAuNY3WngTPlE76XDbSFpauG3CFWGntXikmIpLg&oe=69CE5C0E"}, {"file_name": "Mad Reflex Mixed Reality Still 3.png", "id": "734756302070853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974924_734756305404186_6923290934958339527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtsDmsiazl8Q7kNvwFiAROk&_nc_oc=AdqhgFlBHF9FuS2tRhYJ3JlS_HYu3Ys8PJjG9lZAzH66H9kCv6TyPA4QVaKZnbgvTws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwC-IC0bPB7OVU4WO5PvzXW7e01iDT8xKdJrbdsSFljlA&oe=69CE7754"}, {"file_name": "Champion Reflex Still 1.png", "id": "1181292146413634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035471_1181292149746967_5217355252292440293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNFAojLidAcQ7kNvwE0wpP1&_nc_oc=Adq5AZLLwl0ymO-dO_6GqrPB1gEzrDXzWpQSwqXj7-j0nrh3IW1EA9ZkQYYeL6EmDgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-A7f2fQgDL7ZcSeihq23emopQbLll2o9_I4dnNVF1mw&oe=69CE713D"}, {"file_name": "Mad Reflex Game Play Still 3.png", "id": "533471049017236", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_533471052350569_4760719742838017701_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFEyegAo7R0Q7kNvwGHpR3U&_nc_oc=AdrE0IqJ0sMy46XKsRzgNMFNUgLHCal5mHgGfKWyOXoQRYfBlvNU-SKD6dok2RffCkY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwx9i7ykZpdpttz9n5fyfd3sYg-rG0phb0GVxsIWtB29A&oe=69CE5753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Champion Reflex_2560x1440.png", "id": "1184244736025036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569458_1184244739358369_111066120156910815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTRYIPlYT9cQ7kNvwEs-xhL&_nc_oc=AdroDIwqvOF2WhqwiVhn91fncSp0hYSBvguNA4CMl-hCo-XHeXQ6NjZ-isvZqv9Ns0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw67ewvEST53bdVuoJGY_RwK-sGxOJ5T3i_3vkEcArJbw&oe=69CE54DC"}, "display_name": "Reflex Punk", "keywords": [], "long_description": "\ud83d\udcaa With every dodge and weave, you'll feel your reflexes sharpening while you work up a sweat and burn calories. Track your progress, challenge friends, and dominate the leaderboards as you become the ultimate reflex champion.\n\n\ud83d\udcca With real-time stat tracking and competitive leaderboards, Reflex Punk keeps you motivated to push yourself further and achieve new fitness heights.\n\n\ud83c\udfa7 Turn your workout into an intergalactic dance party with Reflex Punk, the immersive mixed reality fitness game that pits you against alien invaders while pumping upbeat music fuels your every move.  With each beat, you'll be one step closer to defeating those edgy alien thugs and achieving your fitness goals in style.\n\n\ud83e\ude93\ud83d\udd2a Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more.", "short_description": "\ud83d\udcaa Experience the adrenaline rush of Reflex Punk, the groundbreaking mixed reality fitness game designed to supercharge your reaction time while delivering an exhilarating cardio workout. Dodge axes, knives, and other perilous obstacles as you immerse yourself in a heart-pounding adventure that will push your limits and leave you craving more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liftedline.tumblr.com/reflexpunkprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Scrimage Entertainment", "support_website_url": null, "website_url": "https://liftedline.tumblr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
VjqDT77OQUegoxL5Gwh37mQ828qQVenP1ZPEg8V91lAWndIzVuOnz2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFvsorrtdt7VlGWDNOfTUbPZl_N6J3aqyvdCqlde0Ztw&oe=6AAA8F99"}, {"file_name": "WPT_StoreScreen03.png", "id": "985772241841119", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974912_985772245174452_1228483669160280753_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBu4i_rKrWoQ7kNvwFabSl4&_nc_oc=AdrAWsZRaAK3jkSTzWMWp_EsDCGcekEZjJHWxzqwkZOgJrZ-yhvusuQO756OaOlzzQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmaChRKIc_X7h_kzzaPwSjFC6AukpMwYFqujhcvIhDrw&oe=6AAAB6F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PNNL Water Power Tour", "keywords": ["Tour", "Education", "360", "Hydropower", "Marine"], "long_description": "This app provides a virtual reality tour of PNNL\u2019s facilities that support water power research. Users will navigate two different labs and interact with 360 videos to learn more about what goes on at each facility. Research at PNNL\u2019s Aquatic Research Laboratory and Marine Sciences Laboratory informs decisions for marine energy and hydropower. As you tour our facilities located in Richland, WA and Sequim, WA, you will get a behind-the-scenes look at some of the research currently being conducted to change the future of water power technologies.", "short_description": "This app provides a virtual reality tour of PNNL\u2019s facilities that support water power research. Users will navigate two different labs located in Richland and Sequim, Washington, and interact with 360 videos to learn more about what goes on at each facility."}]}, "developer_name": "Pacific Northwest National Laboratory", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Pacific Northwest National Laboratory", "support_website_url": null, "website_url": "https://marine.pnnl.gov/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "co
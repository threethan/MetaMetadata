912_985772245174452_1228483669160280753_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ_ERy046D8Q7kNvwGey9Dg&_nc_oc=AdlnIDUt8nFE_Q0zYr96RDqPpMiMmNLjmRwZfHJYIsbVycf24S6lwWvZF0DLlxZYiCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvxEN6SLMSEHLx5W2MZWKTn3Dar0Rzvgn_p9feB2nHrLA&oe=69999832"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PNNL Water Power Tour", "keywords": ["Tour", "Education", "360", "Hydropower", "Marine"], "long_description": "This app provides a virtual reality tour of PNNL\u2019s facilities that support water power research. Users will navigate two different labs and interact with 360 videos to learn more about what goes on at each facility. Research at PNNL\u2019s Aquatic Research Laboratory and Marine Sciences Laboratory informs decisions for marine energy and hydropower. As you tour our facilities located in Richland, WA and Sequim, WA, you will get a behind-the-scenes look at some of the research currently being conducted to change the future of water power technologies.", "short_description": "This app provides a virtual reality tour of PNNL\u2019s facilities that support water power research. Users will navigate two different labs located in Richland and Sequim, Washington, and interact with 360 videos to learn more about what goes on at each facility."}]}, "developer_name": "Pacific Northwest National Laboratory", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Pacific Northwest National Laboratory", "support_website_url": null, "website_url": "https://marine.pnnl.gov/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
uscdn.com&_nc_ss=8&oh=00_AfvIHRkSeWTuiIumJzzhcZx_ed1nYs7v6Lss14m7cFgVLQ&oe=69A82999"}, {"file_name": "WPT_StoreScreen03.png", "id": "985772241841119", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974912_985772245174452_1228483669160280753_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZPG_gqZ_UgQ7kNvwFlN1fO&_nc_oc=AdkCy7qw2LL4RpHAwzJlkxPQ_CoKGNEdA215I37zJsMdhU1bpLuBrYxa2A96XW2QaVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftwZegfIeYpLLIrOJYP6wImplbnGsH2CBu_II24iQK4QQ&oe=69A818B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PNNL Water Power Tour", "keywords": ["Tour", "Education", "360", "Hydropower", "Marine"], "long_description": "This app provides a virtual reality tour of PNNL\u2019s facilities that support water power research. Users will navigate two different labs and interact with 360 videos to learn more about what goes on at each facility. Research at PNNL\u2019s Aquatic Research Laboratory and Marine Sciences Laboratory informs decisions for marine energy and hydropower. As you tour our facilities located in Richland, WA and Sequim, WA, you will get a behind-the-scenes look at some of the research currently being conducted to change the future of water power technologies.", "short_description": "This app provides a virtual reality tour of PNNL\u2019s facilities that support water power research. Users will navigate two different labs located in Richland and Sequim, Washington, and interact with 360 videos to learn more about what goes on at each facility."}]}, "developer_name": "Pacific Northwest National Laboratory", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Pacific Northwest National Laboratory", "support_website_url": null, "website_url": "https://marine.pnnl.gov/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_
QGe2uNefYjrLBar4g-qaeTZd4OreD4jkBE98fKSFt7edErgNCkZ4f0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPITvJR6KmU4u7eX_WM-97cLd9vulD02oQtqSj1-s93g&oe=6A7B1999"}, {"file_name": "WPT_StoreScreen03.png", "id": "985772241841119", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974912_985772245174452_1228483669160280753_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoAYHVaFNaYQ7kNvwHKbL0g&_nc_oc=AdpQnY07fJ6D4eXdl_9TcEoxEXTJWHJUKx1JqH_w34qZcpo85Q1XjbeIPsXFUIvncEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoJpWKPfvp0-U7DNfCWIbdjZF37TAX9CNZgkHNwIBJTQ&oe=6A7B08B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PNNL Water Power Tour", "keywords": ["Tour", "Education", "360", "Hydropower", "Marine"], "long_description": "This app provides a virtual reality tour of PNNL\u2019s facilities that support water power research. Users will navigate two different labs and interact with 360 videos to learn more about what goes on at each facility. Research at PNNL\u2019s Aquatic Research Laboratory and Marine Sciences Laboratory informs decisions for marine energy and hydropower. As you tour our facilities located in Richland, WA and Sequim, WA, you will get a behind-the-scenes look at some of the research currently being conducted to change the future of water power technologies.", "short_description": "This app provides a virtual reality tour of PNNL\u2019s facilities that support water power research. Users will navigate two different labs located in Richland and Sequim, Washington, and interact with 360 videos to learn more about what goes on at each facility."}]}, "developer_name": "Pacific Northwest National Laboratory", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Pacific Northwest National Laboratory", "support_website_url": null, "website_url": "https://marine.pnnl.gov/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "co
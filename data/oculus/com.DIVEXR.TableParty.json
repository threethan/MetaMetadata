1&_nc_oc=AdoYw0adbP9sTAT4XV9eOb0xwfxw8utwD7V1_up02hT0-tJc77lXGRpeJDq-SMNpKVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtmwCVqVBFEA1HBAsR6y24yivOM5OWxVRco1RZ09Ilzw&oe=6AFC8355"}, {"file_name": "202508_2.png", "id": "1534176644295753", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618910_1534176647629086_1337658286744620453_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZECN0za_3AQ7kNvwHro7s6&_nc_oc=AdoQccCmBTNLt4ZnBpBm4EyO9OxBQNEExd7JrdTLHOgtRgnbXQ7TZ_S5wvsMgcGpAPk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMHDJ4NuKPjkMMjznAtVbg6E4OItxPUlps8_BxBC1B3Q&oe=6AFC84AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TABLE_PARTY_Halloween_BeerPong_v3_2560x1440.png", "id": "2079623716016661", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627502_2079623719349994_7358531953865273838_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAnmKa5i9y4Q7kNvwEyhze-&_nc_oc=AdoZ-kGv_WQCyyNR6embexzHyLWlsTsglergxFTlyIOhCzGuupaYWBP61o3aWxMDhUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUg3Li-glbqniUkpAIT0HtM0hvsQC8g7mRMOVAUI-_6g&oe=6AFC5FD3"}, "display_name": "Table Party", "keywords": ["table", "party", "tabletop", "board", "card"], "long_description": "\n **Join our Discord Community:** discord.gg/FguwhrGpuf\n\n# \ud83c\udf83 TABLE PARTY's Halloween Update is here!\n\nCelebrate Halloween in TABLE PARTY\u2019s spooky new lobby, featuring festive decorations, Halloween-themed board games, and fun avatar accessories!\n{4443897979203791}\n# Bring game night to life \u2014 now in Mixed Reality.\n\nTABLE PARTY is a lively collection of **17 board and party games** made for playing together.\n\nNow with Mixed Reality, you can place the game table in your own room, stay connected to your surroundings, and play naturally using **Hand Tracking**. Pick up cards, roll dice, move tokens, and interact with game pieces with your hands \u2014 no controllers required.\n\nWith **Shared Anchors**, friends in the same physical space can gather around the same virtual table and enjoy the game together.\n{1070044139102327}\n# 17 base games included.\n\nFrom familiar classics to quick party games and strategic head-to-head challenges, choose whatever fits the mood.\n\nPlay a relaxed round with friends, test your strategy against another player, or turn the table into a little friendly competition.\n\nThere\u2019s always something different to play.\n{716370154895928}\n\n# A growing lineup of licensed board game DLC.\n\nDiscover licensed board game DLC that brings even more tabletop favorites into TABLE PARTY, with immersive experiences across VR and MR.\n{2406448233189347}\n\n \ud83d\udce2 Gather your friends for a fully immersive tabletop experience. It\u2019s time to Table Party!\n \n**We\u2019ll continue improving Table Party** with regular updates and refinements. Feel free to let us know your thoughts!\n\n\n\n", "short_description": "Bring game night into your own space with TABLE PARTY. Play 17 board and party games in Mixed Reality or fully immersive VR, and enjoy game night with friends whether you're together in the same room or connecting from afar. From quick party games to strategic board games,there\u2019s always something fun to bring to the table, with cross-platform play so more friends can join in.\n**Join our Discord Community:** discord.gg/FguwhrGpuf"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/tableparty-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DIVE XR", "support_website_url": "https://discord.com/invite/FguwhrGpuf", "website_url": "https://tableparty.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}, {"id"
ots": [{"file_name": "MH_ScreenShots.png", "id": "1325940095614699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617801_1325940098948032_7591348105158001098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKj8TsB7IzIQ7kNvwGeniD0&_nc_oc=AdnYpgWq7Vzkp6P7Zjxx9457bgYxMnp1MmGNd9ExzUj87HjMwf8iV-5zAW5v5GpuHic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyp5bpN69jRX90w72OdsIXWfa6ssqq_tKgG1R8hDK_xCw&oe=69B566E7"}, {"file_name": "MH_ScreenShot2.png", "id": "1708270973207842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824012_1708270976541175_3926357181435024012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B4SgXLMPx0Q7kNvwEUkOJl&_nc_oc=AdmMrM9ngXJ2e0VTBju55rNVh2Idedmya9diHoBBrGDDlIIuw5I9vtBLV254lXCQHmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUNclS-PJcDdVpqtaqGglsmKda01b3X_GyPh0A8RpTjg&oe=69B5558E"}, {"file_name": "MH_ScreenShot3-4.png", "id": "783397657658044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820596_783397660991377_317636591946661496_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1UYg4ZNa08Q7kNvwEWyaC1&_nc_oc=AdlHF6G9-REoBE3_imRb9upZpfDs4hkQcfvbRlaGKREBJY-Egy55zr4KUnimdnUdkQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWX11rDS0AWpz68PWOQNE5wGobHny4O7msRr3rbktenw&oe=69B55C62"}, {"file_name": "MH_ScreenShot4.png", "id": "1780932902515987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820382_1780932905849320_5411927204444824583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWg0UnG5TYEQ7kNvwG5duTx&_nc_oc=AdkCwbZuD81-eKWV9VBdnXwbuIFHTR2kVam6lqJn_IjOzgYL-6b1KUwCLzTobCEUHr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzICjQJDlRlrT5NQ0pbIrAOPR74j0gtAmCTUwCM7pfQbQ&oe=69B553B5"}, {"file_name": "MH_ScreenShotPlaceholder5.png", "id": "1497965034677287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831393_1497965038010620_4550730679722043692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b9h4FGsS1kQ7kNvwH9wK4S&_nc_oc=AdkGU-C-4jhX7ZxdUu5sBMJdRDnEgyuSxnASo6kYP_wmEc7GvH4LQT7jPL2lV0N8xlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRq9cAIl2m9MCW5cYup-nWhQx7YAwiYD133ya5Ydm2gA&oe=69B565F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked Horrors", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
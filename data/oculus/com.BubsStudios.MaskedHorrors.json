ots": [{"file_name": "MH_ScreenShots.png", "id": "1325940095614699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617801_1325940098948032_7591348105158001098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJAFUBmAWa8Q7kNvwEzmQkL&_nc_oc=Adln67V2QUy8mY-IE5D-VDoYyr7zRd7MGWq-f_2J9uvaIO7Y1mtgrHbQgCT2ld8-moQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBYfimnFF51jZ_IdzJeZ6wa2p0YeRGHpMgBt_8VFob3w&oe=69AC2C67"}, {"file_name": "MH_ScreenShot2.png", "id": "1708270973207842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824012_1708270976541175_3926357181435024012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoJ1uguh1B0Q7kNvwGhHTYl&_nc_oc=Adm5CU75rMzkRi6-4nNFgx3w4AY4PurH7YAQC4PODBCSsVGpz0WZTMZ_6FKKKRPDTkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTn4-qZ83czTHFYj-zne_gFkuPHKVJRL3RWl_igplepw&oe=69AC1B0E"}, {"file_name": "MH_ScreenShot3-4.png", "id": "783397657658044", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820596_783397660991377_317636591946661496_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQvP2l5ltGwQ7kNvwGW_WTM&_nc_oc=AdmOwp9oEKkYjOfnntYBVPmzoItQAq8W_eTxrJoRb4fMGn0pVi2Y9AQATB7mcICf4w4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxEddpRNaHX0scaVWexEjVi2Fa6T25-BUn8IhzQJQBBgA&oe=69AC21E2"}, {"file_name": "MH_ScreenShot4.png", "id": "1780932902515987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820382_1780932905849320_5411927204444824583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H7rgRJN9b0Q7kNvwEXf1WM&_nc_oc=Adn8I7qMyOg78CrBjVxxu1YJ9BYXK159hzUA4CEDZazyTp76SzkiAiiBoO2X3CwA3C0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3Xnm3pGze-029DB-jLIa7rl8jNRybE1YOI9cS4JKBeA&oe=69AC1935"}, {"file_name": "MH_ScreenShotPlaceholder5.png", "id": "1497965034677287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1497965038010620_4550730679722043692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEufInA_nRYQ7kNvwElG9Rn&_nc_oc=Adk5OQB5xY9IkkuWrBk4474BfHsTOYU5LnWYWscYUD9eugvfyUcc3IXWRiZFHo3GJWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQXVZJVuo3Ll2aiAUan0MOuk2W79DLCkWKCG1AEnca1w&oe=69AC2B78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked Horrors", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
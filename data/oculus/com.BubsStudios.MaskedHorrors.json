tps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824012_1708270976541175_3926357181435024012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw0lOnp8WQAQ7kNvwHZoRWt&_nc_oc=AdonbgIJH9aOSmXirfA6PZwE5fFBiO7TaLLlSwbsyQOfhmIaxAMzmZMsSElmA-s-jWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4DrhC7b_pOuEQvI7HTV7SvprT1ndJZexvEe81S5Ym3A&oe=6AF1F5CE"}, {"file_name": "MH_ScreenShot3-4.png", "id": "783397657658044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820596_783397660991377_317636591946661496_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWBCfo3poDoQ7kNvwEs_5ZQ&_nc_oc=AdrveD7uneRIGQ2EykQDPEZbgNiaafNrETpRF8rXAAKOb9JWm1y-_VwmxsdTFEt05nQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLIBWU-eVur5Kh8o8jjaWjasIJc_Lcp1BUKKbMp35KgQ&oe=6AF1FCA2"}, {"file_name": "MH_ScreenShot4.png", "id": "1780932902515987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820382_1780932905849320_5411927204444824583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTJjiBxVYbQQ7kNvwFs9wml&_nc_oc=AdoxgBFa2Ezl00LH2HsblTazuk2EesjNplRorvnesb90OmlTdW31Bk4vVxHLA1RF7_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPB-qRSlEWOd-KY06t1rngouIG3Sj-tbGUZ_3eQzCO6g&oe=6AF1F3F5"}, {"file_name": "MH_ScreenShotPlaceholder5.png", "id": "1497965034677287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831393_1497965038010620_4550730679722043692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBtuRy8PvfUQ7kNvwHb64VR&_nc_oc=AdogQrNytJrS2tbrHbUtyn_fbOHC5OOoJoMrpt8jT9OfNwlDlIsQmab2KyCB1tiX9Bo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIrinucNz8Glxkm8PhXiVyEWwvB0TlkRd2ZXmQhRghew&oe=6AF20638"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked Horrors", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_t
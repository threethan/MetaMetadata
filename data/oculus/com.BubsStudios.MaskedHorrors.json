c_oc=AdoNmKoeYhAmv5BkS2FFQxI9LIcNvZ1n3Id_jkd1sWZNMU7TrEbFdzJk2uApIYdeXkg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af05p9yPrRxkcRL5hmDro4KkFhGQaOdCV33kPItZgCKC-w&oe=69F20AF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked Horrors", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
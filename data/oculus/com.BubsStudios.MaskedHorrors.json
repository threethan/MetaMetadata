qX8P8rGbFteOqt_snOyZ-0ngiwaqSPOrwdGzoAcG5PjeegtJaT6fB_clE--jFSdLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsyDJ-_V14nh1dJ7S0N0x9zz855Xodk2LZx6JibUPGGg&oe=6B032022"}, {"file_name": "MH_ScreenShot4.png", "id": "1780932902515987", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820382_1780932905849320_5411927204444824583_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISJePQfUSAwQ7kNvwGeEEze&_nc_oc=AdoLPuA5tCZHhzPXcWQ0Lp_4WKojIfR_WdUckxsSTYGoTurDNJw0QU9C_dUKMIRYfz4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLP5OxA57qANviLYSQ2whPldLmy7vb6hKbJRLSBO5HBA&oe=6B031775"}, {"file_name": "MH_ScreenShotPlaceholder5.png", "id": "1497965034677287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831393_1497965038010620_4550730679722043692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4ZyGpzjhoIQ7kNvwHBpzuw&_nc_oc=Adp0jFZffV1Q19gZpqBOtbb6LlYxfLBKIHIxWEs52V16tFye1qhsXtEe1fsApSXfO14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0ZjIqSu5n6_7goEIWV-DRGPuVZUF892ZdzASlQWn8MA&oe=6B0329B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked (OLD)", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29286705067591843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1127515708736831_3041475879491166807_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue1SD0FRJakQ7kNvwE4nuup&_nc_oc=Adoj9NP3l3uxJVzYab3ytzcvTeeENbijNQfdIOEty-9uIFowrCL4-Ehvl8iPkDAxMnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXj1qpjQgK4lGfPqOvIxJL7CXp9dxW_mk04P2d8fVL0Q&oe=6B03188F"}, "is_
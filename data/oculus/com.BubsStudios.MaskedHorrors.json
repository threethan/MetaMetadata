ots": [{"file_name": "MH_ScreenShots.png", "id": "1325940095614699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617801_1325940098948032_7591348105158001098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-IZSLeGRWsQ7kNvwH5hSsw&_nc_oc=AdqaUNiNu8RplFdyBiVGGVBAh7JcMywun9AwkTP6w_9RdaZ1KGZ9sMuWQ9wmmkjwcGw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzgl9Vt5qY-LnRvD4YtHB5OiB40ab7uu0dHBiA9UaQlSA&oe=69C14467"}, {"file_name": "MH_ScreenShot2.png", "id": "1708270973207842", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824012_1708270976541175_3926357181435024012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkuopCux4-8Q7kNvwESVzdA&_nc_oc=Adp73cKNXaAcl0GOZWpL9QZcNubS3EKm180zp0EX5KonDFFzsKUw-NNMPsOo8iY-c9s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPI4dAuyyYhATbsKw_DNSbptaCowNurEpTXpjbgUgNoA&oe=69C1330E"}, {"file_name": "MH_ScreenShot3-4.png", "id": "783397657658044", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820596_783397660991377_317636591946661496_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IrJltz_UGkQ7kNvwGMQB2b&_nc_oc=Adq-XXSAjLrZvCqo8VLY7Vgi5KbnU0OpGFhfi1AiMRXbNa3KJbJ1VRHJqEmgo4upJmo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRXR5OfWa_GOIh6OGFWkAEj9ZIRpCs-JHCFGyAZWYh4g&oe=69C139E2"}, {"file_name": "MH_ScreenShot4.png", "id": "1780932902515987", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820382_1780932905849320_5411927204444824583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2fRNFAmblcQ7kNvwH-sFsY&_nc_oc=AdoGo1UgYS4IAvTemHMglfzkLUfIXVd6RvINkfYBJuSpbrKycIWzmPkI2VXbF8MS9CU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcAsDEGFh9G8udosU897j9ludLL9CudbPtDsI0odPnOg&oe=69C13135"}, {"file_name": "MH_ScreenShotPlaceholder5.png", "id": "1497965034677287", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831393_1497965038010620_4550730679722043692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubzH03wQmcsQ7kNvwH2scWZ&_nc_oc=AdpT4X7SOrkukxAlRKciSyRAFR7YBMJtZo35CMmmOXgvkHxWQNf_PBTwgSZFYaPVi9E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4bOdKdQyf-2D0eaGl1LkBiWJymnrQyxKQbobOGJPENg&oe=69C14378"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked Horrors", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
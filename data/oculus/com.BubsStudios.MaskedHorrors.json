ots": [{"file_name": "MH_ScreenShots.png", "id": "1325940095614699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617801_1325940098948032_7591348105158001098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsN8cuwHdccQ7kNvwG2n3jj&_nc_oc=Adn45jrqgP7bloJlklvpDm8lWhouhQiQ7TeH5tdh8GRO4RoIW2Z_4-QcKv-961ef06U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjLmp614qmLiV-tAD6W9JfhdLCLFcXDXqJZeOemJxWvQ&oe=69B020E7"}, {"file_name": "MH_ScreenShot2.png", "id": "1708270973207842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824012_1708270976541175_3926357181435024012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJeYl6mDvlAQ7kNvwFQ2aJe&_nc_oc=AdlHLmTpITLrcLujmBhlMs5aDjESrPOadLbdpHL54XkBwBf3XBdEAh5Al2qQpyWXpe4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuGYPW8YHWhjuxgqz37MSROQOgVeRw9nUw7ACLV2UHSA&oe=69B00F8E"}, {"file_name": "MH_ScreenShot3-4.png", "id": "783397657658044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820596_783397660991377_317636591946661496_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hh5N1KCjXmQQ7kNvwGAzesB&_nc_oc=AdltzzDfiuPnzVwj3clwGHdwLFKf2-i-zhsbfRdYctoKrjDYzezK-9-Jlr9n3cv0z7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8frkLWSuMu1y8C9NAuSGd7i0iz08TgomBIbla-TY9Cw&oe=69B01662"}, {"file_name": "MH_ScreenShot4.png", "id": "1780932902515987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820382_1780932905849320_5411927204444824583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vpMbpjINJYQ7kNvwHrkQAK&_nc_oc=AdlMaTLnEz6NKbQhrW4nOexEBWvrSPPaePk8g1Mh0cn-QJBgqBjYMMwLAEsCrDUauPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyC0pNbZnXftFbFgQvegpqwFu6FEHqMTyIV2n7B4PUq4w&oe=69B00DB5"}, {"file_name": "MH_ScreenShotPlaceholder5.png", "id": "1497965034677287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831393_1497965038010620_4550730679722043692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtFrsBCo1-8Q7kNvwEJvt-e&_nc_oc=AdlTajPpFPIAe8hqhl1hP3v_HzCB5h9zBQLvi9N_HXu6WXGAokjY8ppBalCOavtm-Jo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_z9R1IYpzVmDA-WdFXHBCDRbTyLeEtKyi4XkM9wXVtg&oe=69B01FF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked Horrors", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
ppnzZDncS5m6okbYtKyTTmY0lAy_CKDfG1swUGZ1LMg5zxclWr-oYOfU50W4kaAi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD5s1RdJVq6O3ulU6uuwn5ZclzHY8YL-0AkUMQLfGQeQ&oe=6B01CEA2"}, {"file_name": "MH_ScreenShot4.png", "id": "1780932902515987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820382_1780932905849320_5411927204444824583_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISJePQfUSAwQ7kNvwGIDom3&_nc_oc=AdqZk_PfAWLgkXPZa6rvO3CV9FEubbWlofoRq6wP77s5xGsOQ7FMha_xuvM2Af80jbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdMWex9kSrPRDoGvcx2fX_kS-LfvgII5H00D8vN1xwpg&oe=6B01C5F5"}, {"file_name": "MH_ScreenShotPlaceholder5.png", "id": "1497965034677287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831393_1497965038010620_4550730679722043692_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4ZyGpzjhoIQ7kNvwG4JRpM&_nc_oc=AdpIgcmwKNOroElJ6THd7_uhyIGJkQs8525ZYb1EMKfDg9N65lgTQi4NnA3jdjlWTjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-nQvyXa-TStPr6PkIlOKwQRKxa9yhJxssdwNu8U3agQ&oe=6B01D838"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked (OLD)", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29286705067591843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302770_1127515708736831_3041475879491166807_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue1SD0FRJakQ7kNvwEnka4b&_nc_oc=Adr0bZdMGwb2dXDLs8t43dFGRemRlromtkOfeRfc7oo7F5YB1xTF-5ahZol0D2WN2ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8eiB0tuXri1RUwAP5iQjcylJl6lU_qSE1FiURkP7dbg&oe=6B01C70F"}, "is_
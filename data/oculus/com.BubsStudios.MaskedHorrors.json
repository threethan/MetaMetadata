ots": [{"file_name": "MH_ScreenShots.png", "id": "1325940095614699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617801_1325940098948032_7591348105158001098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-IZSLeGRWsQ7kNvwFO48Fn&_nc_oc=Adlasfl0l3RXHLlvXD9k7S8hWfBJ49cAdm5cdZE3r6MpQkJaJ6KStbrRgOwDjiVIAC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyncqKaaXl5xlIqZNzCcIkN18roHDjyG0QhgR11TwR5YQ&oe=69BEA167"}, {"file_name": "MH_ScreenShot2.png", "id": "1708270973207842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824012_1708270976541175_3926357181435024012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCSEIHIN8QMQ7kNvwG6TlYd&_nc_oc=Adnl1pvZE1y6tTW0cJqcMAw322-Pb6Pw8XOTIj84RMOiTAa01NkU4r55R7H-aRdcnjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoJbc6Dtqtg8yx2TtImktYcrDXzIVWMRDc_QxE51h_DA&oe=69BE900E"}, {"file_name": "MH_ScreenShot3-4.png", "id": "783397657658044", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820596_783397660991377_317636591946661496_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG-JsALJVBUQ7kNvwGYbDgi&_nc_oc=AdmDoSevpaEdDoHjgy9ySCa_Kl8QQe08bPdbCtzoyvbGT5ixtrWX-1yltLnexZc-gTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxoSlhgzligiUaIQ1bdF1brb6XYLA8UYYOD9VKncPbWA&oe=69BE96E2"}, {"file_name": "MH_ScreenShot4.png", "id": "1780932902515987", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820382_1780932905849320_5411927204444824583_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcubWF-nfUoQ7kNvwEiOsxQ&_nc_oc=Adl27oURG3aqEPiFeNBj5bIxpVTZ01Ypz3gth6yok12NZ7FXdMyDM-LeJdLbG3kQmag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvY1xd3Ke0BgpecywvM7DuwcTXFaGyzGGEIz02zF9XLQ&oe=69BE8E35"}, {"file_name": "MH_ScreenShotPlaceholder5.png", "id": "1497965034677287", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831393_1497965038010620_4550730679722043692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubzH03wQmcsQ7kNvwEGO6nr&_nc_oc=AdlC9GV0GlwMjR6vk7cwn8ajDsNCkapyX7TkCYrfn9D1TKaKqp1hKgY_9nw9I2-7iAE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmtmK5fsl0yFYmhTW4Uq3kunDavI_kLYZfdZtdYFkn8A&oe=69BEA078"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Masked Horrors", "keywords": ["Horror"], "long_description": "Masked Horrors \u2013 A Terrifyingly Silly VR Experience\nRun. Climb. Scream. Laugh. Repeat.\nMasked Horrors throws you headfirst into a chaotic VR nightmare where the scares are real, but so is the fun.\nInspired by the fast-paced movement of Gorilla Tag and the unpredictable frights of Big Scary, this is a multiplayer horror experience where laughter and terror go hand in hand. Whether you're being chased by monstrous masked creatures or hiding in pitch-black corners with your friends, Masked Horrors delivers adrenaline-pumping horror with a chaotic, meme-fueled twist.\n\nNo buttons, no joysticks\u2014use your hands and arms to climb, run, and escape in full VR.\nScream with friends (or at them) as you work together\u2014or betray each other\u2014in nightmarish environments.\nTerrifying chases one second, dumb shenanigans the next. Expect the unexpected Face off against creepy masked horrors that hunt, stalk, and sometimes... dance?\nExplore eerie, liminal spaces that twist and shift each round.\nWhether you're in it for the thrills, the screams, or the laughs, Masked Horrors is a uniquely wild ride through the absurd side of VR horror.", "short_description": "Masked Horrors \u2013 A Terrifyingly But Silly VR Experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooga38824.wixsite.com/bubsstudios/masked-horrors-1", "developer_terms_of_service_url": null, "publisher_name": "Bubs", "support_website_url": null, "website_url": "https://ooga38824.wixsite.com/bubsstudios", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
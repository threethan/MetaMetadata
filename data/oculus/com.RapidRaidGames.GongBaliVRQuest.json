-7&_nc_sid=6e7a0a&_nc_ohc=R-3ghZhIG9cQ7kNvwElX2tw&_nc_oc=AdrBqVL3GU3UimWvXnae2g0wGsbNo2oPHlKRH6r948rQsG-bu5qjQ8uRT2cBu-ze7Gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3iHLRy6cnVn143dHEv6Qvzymg1ORXG9i1_beAotzQ-vw&oe=69F0B6A2"}, "display_name": "Gong Bali VR", "keywords": ["gong", "music"], "long_description": "Bali Music Experience in VR, Playing traditional music(Bali Music Instrumental) must be fun and feel excited. But have you ever feel playing traditional music in virtual reality (VR)? Introducing our games \"Gong Bali VR\" from our studio Rapid Raid Games that gives an experience playing Bali traditional music in VR. In Gong Bali VR(include Names of gamelan Gong, Tawa-tawa, and kempli) you will provided our video and tutorial about how to play for beginner. feel free to create your own traditional song or you can learn a Gong song from it!", "short_description": "Bali Music Experience in VR, Playing traditional music(Bali Music Instrumental) must be fun and feel excited. But have you ever feel playing traditional music in virtual reality (VR)? Introducing our games \"Gong Bali VR\" from our studio Rapid Raid Games that gives an experience playing Bali traditional music in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/rapidraidgames/Privacy-Policy-Rapid-Raid-Games", "developer_terms_of_service_url": null, "publisher_name": "Rapid Raid Games", "support_website_url": null, "website_url": "https://rapidraidgames.github.io/rapidraidgamer-vrpage/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
me": "update.png", "id": "501472867523908", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974575_501472870857241_2438520207434212616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewF9TKw0twMQ7kNvwEGXC20&_nc_oc=AdpLfYojnfWGo17xs0ggNBLxkTP5MktMrKB65DQ_SZmCwUbMQ4nVSbmIPQ6nb0Ahl80&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XyMa6UgAc0BrjGoyq7a9LfJDKPrd0pv0Je8bZgNZ2tw&oe=6A466822"}, "display_name": "Gong Bali VR", "keywords": ["gong", "music"], "long_description": "Bali Music Experience in VR, Playing traditional music(Bali Music Instrumental) must be fun and feel excited. But have you ever feel playing traditional music in virtual reality (VR)? Introducing our games \"Gong Bali VR\" from our studio Rapid Raid Games that gives an experience playing Bali traditional music in VR. In Gong Bali VR(include Names of gamelan Gong, Tawa-tawa, and kempli) you will provided our video and tutorial about how to play for beginner. feel free to create your own traditional song or you can learn a Gong song from it!", "short_description": "Bali Music Experience in VR, Playing traditional music(Bali Music Instrumental) must be fun and feel excited. But have you ever feel playing traditional music in virtual reality (VR)? Introducing our games \"Gong Bali VR\" from our studio Rapid Raid Games that gives an experience playing Bali traditional music in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/rapidraidgames/Privacy-Policy-Rapid-Raid-Games", "developer_terms_of_service_url": null, "publisher_name": "Rapid Raid Games", "support_website_url": null, "website_url": "https://rapidraidgames.github.io/rapidraidgamer-vrpage/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "MUSIC"], "has
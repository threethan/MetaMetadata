 watching 3D and 360 photos and videos, and also browse the Internet like never before. Search over one million videos and play over 500 games in our VR Market. Our content is exponentially growing! All of Fulldive\u2019s content is from approved sources such as Youtube, Youku, and Facebook which prohibits adult/mature content shown publicly.", "short_description": "A Social All-in-One Virtual Reality (VR) Platform for GearVR"}]}, "developer_name": "Fulldive corp.", "developer_privacy_policy_url": "http://fulldive.com/privacy-policy.html", "developer_terms_of_service_url": "http://fulldive.com/terms-condition.html", "publisher_name": "Fulldive corp.", "support_website_url": null, "website_url": "http://www.fulldive.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "MEDIA_PLAYER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "663975214793953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410323_1817955161593377_7584337024061014016_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwRc6KjTx1AQ7kNvwHhdX-y&_nc_oc=AdnPa76um4RgKNANh7x3FdJfANv1yWxSc1_4AZp6okh65pB_BJheCXTs5vSifnEd05M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9PUyOevO60_fikB6Yrcv75bUCKNq-Jvj_TbVY_01r0Q&oe=69BD4571"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fulldive", "platform": "ANDROID", "context_category": null, "context_topics": [], "rel
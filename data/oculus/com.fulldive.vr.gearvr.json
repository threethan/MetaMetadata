ion videos and play over 500 games in our VR Market. Our content is exponentially growing! All of Fulldive\u2019s content is from approved sources such as Youtube, Youku, and Facebook which prohibits adult/mature content shown publicly.", "short_description": "A Social All-in-One Virtual Reality (VR) Platform for GearVR"}]}, "developer_name": "Fulldive corp.", "developer_privacy_policy_url": "http://fulldive.com/privacy-policy.html", "developer_terms_of_service_url": "http://fulldive.com/terms-condition.html", "publisher_name": "Fulldive corp.", "support_website_url": null, "website_url": "http://www.fulldive.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "MEDIA_PLAYER", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "663975214793953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410323_1817955161593377_7584337024061014016_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQl534jewxIQ7kNvwEwGjkO&_nc_oc=AdlJ5VDrjLHqNbaQyCPC98h2Y30FzoumgWvct9UCWQCIw5S4WQqab9zYwQQMyjtSwDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvWP20pJnYCNY2XgtdcZpsYKDXZnoXCHXxtd4E6_rp4zQ&oe=69A58A71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fulldive", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1551978000, "lastRevision": {"nodes": [{"id": "1053223358186982", "release_type": "SCHEDULED", "administr
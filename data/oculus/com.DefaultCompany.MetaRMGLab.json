07775092130", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391911_1790407778425463_4557607004508567420_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om3fcGLMXgcQ7kNvwFlSFzY&_nc_oc=AdrfVsbhuOWwnvFBYraN_PIoFtgwTUGQ1mFDnhGPPGNg8wT2rWLcXWOonveYY4ykAiA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LOvaDDYJwbHWIl2IVmxQ0fu-68T8lOAsw4i-tMH8-pw&oe=6A1452CA"}, {"file_name": "vlcsnap-2025-02-08-23h06m03s879.png", "id": "597825129708139", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391934_597825133041472_4616616814148757786_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZR8a6UMTjcQ7kNvwFRqS-g&_nc_oc=Adq62S9NIPqmWINbnDghil3-PQ4jiXpCap5rNzgm7s0eCcsi2IUHSswbj34EkZyfifg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YLF5ESFxarBzz4-3adwlOvMiIubFEIS-sK6vNuzLPPw&oe=6A144733"}, {"file_name": "vlcsnap-2025-02-08-23h06m22s421.png", "id": "1139947471249498", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1139947474582831_2705467035973956596_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32F1gvzmD18Q7kNvwE371GV&_nc_oc=AdpyyQXztSU5cn4nypKY_m2ien-1TmiWwd5mgRf9JbshluIKuCjwNtUzE1UDQqDzJqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R0sn958rh3K_lvyJwn47FthsEbX2HaMfURDhcBbPOJw&oe=6A144DB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Innovation Lab_Trailer Cover Image.png", "id": "628162106400844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393320_628162109734177_2372831943391549973_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hEyKZtiwEwQ7kNvwF1fAha&_nc_oc=Adruz9py7XCiLn_s7Ato5VsUf6V_NP4yZKZg-X1o1OviDQMQ3uU3Oy1qwd54Ehc4qbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af547yQFB0oztKJKoLHXNtpeCsg_bdMQykeE3KJxbe002g&oe=6A145546"}, "display_name": "RMG Lab", "keywords": ["Innovation", "Simulation", "InnovationLab", "BusinessTools"], "long_description": "Welcome to the RMG Simulation App, your gateway to innovation and cutting-edge solutions! Designed specifically for RMG's Innovation Lab, this application leverages the power of immersive technologies to revolutionize the way we simulate, analyze, and solve real-world challenges.\n\nKey Features\nRealistic Simulations: Experience highly detailed and interactive simulations tailored to your business needs.\nInnovative Solutions Testing: Experiment with new ideas and strategies in a controlled virtual environment.\nCollaboration Tools: Seamlessly collaborate with your team to bring ideas to life.\nCustomizable Scenarios: Adjust and optimize scenarios to fit your unique requirements.\nUse Cases\nTrain and educate your workforce using realistic, hands-on simulations.\nPrototype and test innovative solutions before real-world implementation.\nConduct in-depth analysis and gain actionable insights for decision-making.\nAt RMG, we\u2019re dedicated to driving innovation forward. The RMG Simulation App is your platform to explore, innovate, and achieve!", "short_description": "A cutting-edge simulation app designed for RMG Innovation Lab to explore and test future-ready solutions. Unlock new possibilities with immersive experiences!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/6009e897-7b9f-49a2-9870-2d8074fb047b", "developer_terms_of_service_url": null, "publisher_name": "RMG Innovation Lab", "support_website_url": null, "website_url": "https://www.rmg-sa.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
_4753723908000714_4602619164484269951_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=n2zQD_ZWh_kQ7kNvwEaO8e6&_nc_oc=AdrMwy4wuorxI6qGX07THAfbrqJHnBdHw0AFz7AE_qjWKntZwS8HyxQfPIhTub8AMNk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8KThI5R4DvDrBJYudXWYROmzOkjmUPUdPQbd_FR893A&oe=6AEF371A"}, {"file_name": "HS_Authoring.png", "id": "431903364935029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294243_431903368268362_1953552129792677616_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERdRoTY3jwwQ7kNvwGY3bTp&_nc_oc=AdpehWEs4M1SIDExifrVjQXkFvewPT5ygpluqsoONl7KXDoAm8m6wfi7fAmBKwAIP3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1KtTYAIv16enNatxA2kOuyeJ5SSEQ8oo3G3FaFCrtpQ&oe=6AEF35B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HyperSkill", "keywords": [], "long_description": "HyperSkill is a no-code, cross platform 3D simulation software for training in the enterprise and higher education. HyperSkill VR is designed for both authoring and experiencing the 3D simulations. \nIn the experience mode, you can either try out the emerging demo simulations created by our trusted content creator, or the simulations created by yourself through HyperSkill Studio app.\nIn the authoring mode, you can modify the virtual simulations with our build-in repository of assets. You can also create a brand new account and add new simulations from the HyperSkill Studio app on Windows & Mac, or shared simulations from other content creators (learn more at siminsights.com). \n", "short_description": "HyperSkill enables users to author, publish and evaluate 3D, immersive, interactive and intelligent content without coding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://siminsights.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimInsights, Inc.", "support_website_url": "https://docs.google.com/document/d/1PxWQkawZMkyrRzPKZzX2dXpbew8PlwoF_6
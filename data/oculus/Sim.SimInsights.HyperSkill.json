tent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo3MxBjr58wHb0h5jothxyJmXSQtHDIDjDNDUtYZi-Og&oe=6B0076DD"}, {"file_name": "HS_DataHall.png", "id": "4753723904667381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001673_4753723908000714_4602619164484269951_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=czgPKpsqBjUQ7kNvwHMa_tm&_nc_oc=Adr3UUGedf0ZJQIoUFZW-TFmg38IP8TXPglFN8uQa00CZFA5qD36uyn7uEPr1nBJBEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBP5PdiBHMMLEyiHkPklqVdg_1wUut3FpnPGrFWcNrUg&oe=6B005A9A"}, {"file_name": "HS_Authoring.png", "id": "431903364935029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294243_431903368268362_1953552129792677616_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS53t4dv8yMQ7kNvwG7i5Ra&_nc_oc=AdoF28KsKgfHmJu57oEbrTqq2Uqv8e2aT0AoLaVPaAxaz3HrbRqRw49ruu8vHnpTPZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOiAR_-jBafTDmYFuR7ZDHQkmOKgROE_-rfqK1EXsZiQ&oe=6B005933"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HyperSkill", "keywords": [], "long_description": "HyperSkill is a no-code, cross platform 3D simulation software for training in the enterprise and higher education. HyperSkill VR is designed for both authoring and experiencing the 3D simulations. \nIn the experience mode, you can either try out the emerging demo simulations created by our trusted content creator, or the simulations created by yourself through HyperSkill Studio app.\nIn the authoring mode, you can modify the virtual simulations with our build-in repository of assets. You can also create a brand new account and add new simulations from the HyperSkill Studio app on Windows & Mac, or shared simulations from other content creators (learn more at siminsights.com). \n", "short_description": "HyperSkill enables users to author, publish and evaluate 3D, immersive, interactive and intelligent content without coding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://siminsights.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimInsights, Inc.", "support_website_url": "https://docs.google.com/document/d/1PxWQkawZMkyrRzPKZzX2dXpbew8PlwoF_61yJ4e7BGk/edit#heading=h.tw4rqnaxv9n", "website_url": "https://siminsights.com/hyperskill/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26170797395930102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001673_1134633473735600_8588561686029522939_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncX4Hkgj084Q7kNvwEjNxnK&_nc_oc=Adq9d_IXlLdCRIvB-XbfghidHm7tag_AHK1NDG0mqZmODDdL6cv7KOdVkEIhKegU0o4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyT6PEdxb09DH7oNZiS-ogUmsuMith37dYAGgf18Rxlg&oe=6B008154"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HyperSkill", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date"
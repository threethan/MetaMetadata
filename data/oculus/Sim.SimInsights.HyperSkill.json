_4753723908000714_4602619164484269951_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=S-oR5YnwrmAQ7kNvwHgthxm&_nc_oc=AdojEjIDKOBDsGhoywMOULlwjoMndvXy6Ryl-uKbQAbqD9KPuqbF_jL6hQ3sNGuEA7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYQ1U3DtvDRr5O7SSg7GcQ__mWaybeskPajwUHkBloRQ&oe=6AE89F9A"}, {"file_name": "HS_Authoring.png", "id": "431903364935029", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75294243_431903368268362_1953552129792677616_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo2IZeq9F64Q7kNvwGD1CsR&_nc_oc=AdqF9LxiyLE-2_IC1Xss5pCAFat1KNdx9JS3DexZrVxIkf2Jwfam4LRMhzV1n33FByI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrmHlEqMuyIj_BiFT41Yb7p5G4Nq1DFDigN_iZa3ulkA&oe=6AE89E33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HyperSkill", "keywords": [], "long_description": "HyperSkill is a no-code, cross platform 3D simulation software for training in the enterprise and higher education. HyperSkill VR is designed for both authoring and experiencing the 3D simulations. \nIn the experience mode, you can either try out the emerging demo simulations created by our trusted content creator, or the simulations created by yourself through HyperSkill Studio app.\nIn the authoring mode, you can modify the virtual simulations with our build-in repository of assets. You can also create a brand new account and add new simulations from the HyperSkill Studio app on Windows & Mac, or shared simulations from other content creators (learn more at siminsights.com). \n", "short_description": "HyperSkill enables users to author, publish and evaluate 3D, immersive, interactive and intelligent content without coding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://siminsights.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimInsights, Inc.", "support_website_url": "https://docs.google.com/document/d/1PxWQkawZMkyrRzPKZzX2dXpbew8PlwoF_6
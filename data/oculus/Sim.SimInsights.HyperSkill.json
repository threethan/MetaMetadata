_4753723908000714_4602619164484269951_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=cm-6m4Y_QWkQ7kNvwFmVpOh&_nc_oc=AdpOxy_j_DxuvtKX-5ZX9_gP17Pi5VMAzA3PCMXE3o6ig4T5BmSML8H3736zC5CU6ms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNFHfniN3S1utifpJXO826PNKBOdS3w4xiBV8iiCYoiA&oe=6ACCF01A"}, {"file_name": "HS_Authoring.png", "id": "431903364935029", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75294243_431903368268362_1953552129792677616_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVBh_LDMAlgQ7kNvwFWZJhB&_nc_oc=AdoiW-NgZqM1La1PvC8CFOZxvEqNb31o1lKOWB5ksHuR7Y7VpRYxLD4QL4lIhP-MXLY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjSxcXgb6u2l2DHia0vEf7ifN1Pf84wNRuGX_DldAQQQ&oe=6ACCEEB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HyperSkill", "keywords": [], "long_description": "HyperSkill is a no-code, cross platform 3D simulation software for training in the enterprise and higher education. HyperSkill VR is designed for both authoring and experiencing the 3D simulations. \nIn the experience mode, you can either try out the emerging demo simulations created by our trusted content creator, or the simulations created by yourself through HyperSkill Studio app.\nIn the authoring mode, you can modify the virtual simulations with our build-in repository of assets. You can also create a brand new account and add new simulations from the HyperSkill Studio app on Windows & Mac, or shared simulations from other content creators (learn more at siminsights.com). \n", "short_description": "HyperSkill enables users to author, publish and evaluate 3D, immersive, interactive and intelligent content without coding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://siminsights.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimInsights, Inc.", "support_website_url": "https://docs.google.com/document/d/1PxWQkawZMkyrRzPKZzX2dXpbew8PlwoF_6
igrated_image.png", "id": "198663501420010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138836_1524850844507659_1586381467_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M86wHcMGa5YQ7kNvwFRmXV0&_nc_oc=Adr4m8ohoZH0SHhMYLNQDYLNeRxuye8NNAue3l4KaCt48V7s33HdoQ95bhjMotzoOIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFfjTM5ifN_r2Zsyu7uqF7uGZsACf5eZtmGLhikDyhug&oe=6B0C55EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neverout", "keywords": [], "long_description": "It will lock you down in a room and won't let you escape. Will you survive or ever get out? Your only choice is to find your way to the next room, but watch out, many traps lie ahead.\n\nNeverout is a brand new kind of puzzle game. It puts the you in a small, claustrophobic room, that has only one way out and its unique mechanics lets every wall become the floor. \n\nEnjoy over 60 beautifully crafted levels and fresh, exciting mechanics.\n\nEnjoy changing the state of each room -- they have no limits -- whether you are standing on the floor, wall or the ceiling. Just be careful, and don't die by being crushed by something heavy, getting electrocuted or being pierced by a giant spike.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": "http://setapp.pl/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Setapp Sp. z o.o.", "support_website_url": null, "website_url": "http://setapp.pl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes"
u7KG1uPUm9XFMUAYE2NynYrHRR0UVoeOnZawTlQ&oe=69B55816"}, {"file_name": "migrated_image.png", "id": "584867935443286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138832_925195390862801_1814114864_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlletgSub3wQ7kNvwFxX_W3&_nc_oc=Adk-qiQc9919vXftPTe5BOUDWlP2ryTUfgHv7HExzNtqBofJ5uAIHvyzr6vWnAiT4RY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDvdmgs3n1pWOJTCjlUNS7IFm6XyW2hkL73M12putHMA&oe=69B53CB5"}, {"file_name": "migrated_image.png", "id": "651930972210018", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162751_719911721443169_61954588_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNHCPUqdMA0Q7kNvwGErTn2&_nc_oc=AdniQKGTpYi4os53Byhl4-jHlZOGY7_x4uFoNo2G4d_fl34kxDWvFNRRybdudvnUCUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzkt-3_O8D_ihpguN7QhXEmXHjnUd30jSzNYaSyREN58A&oe=69B56E43"}, {"file_name": "migrated_image.png", "id": "2946843058710953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138838_630493493720345_1676510594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A7RaFDuRFUQ7kNvwHj8CcA&_nc_oc=Adn0vVZU-EMvYBVYCCfSli2JxAXF6ZNRplOrMKFmgh8pGhf2GyXIxIEA2JYhzf_lR0g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwIG7WgvD1iVlrcSKpENkCcpKG_IOVGk1Ri-BovwQB77w&oe=69B56C73"}, {"file_name": "migrated_image.png", "id": "2240798369548317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138836_1524850844507659_1586381467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOoPfqXFBfQQ7kNvwGCSUx7&_nc_oc=AdmD1iA6WS-2ZKy7UOZvlPD7zSdPZK6F2u4KWKX_B0LWYBqUi07IZbleS48Lo-jV8z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCjiBRKQKrUGRhkxwfgLbIy2RRXmipYhK0i5aCO-EGUA&oe=69B557AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neverout", "keywords": ["cube", "room", "maze", "puzzle", "riddle"], "long_description": "\"Neverout succeeds in every area. In VR, it is one of the most immersive games I\u2019ve played,...\"\n8.5/10 VRGiant.com\n\n\"Neverout is like being inside a Rubik's Cube ...\"\nAmberVR\n\nIt will lock you down in a room and won't let you escape. Will you survive or ever get out? Your only choice is to find your way to the next room, but watch out, many traps lie ahead. Wander around for hours solving over 60 beautifully crafted levels.\n\nNeverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a small, claustrophobic room, that has only one way out and its unique mechanics lets every wall become the floor. Watch out for something heavy, getting electrocuted or giant spikes.", "short_description": "Neverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a claustrophobic room, that has only one way out and allows every wall to become the floor. Try not to die by being crushed, pierced or electrocuted."}]}, "developer_name": "Gamedust Sp. z o.o.", "developer_privacy_policy_url": "https://gamedust.co/news/privacy", "developer_terms_of_service_url": "https://gamedust.co/news/privacy", "publisher_name": "Gamedust Sp. z o.o.", "support_website_url": null, "website_url": "https://gamedust.co/neverout", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3813404225550791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162739_506790509505583_458019371_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6
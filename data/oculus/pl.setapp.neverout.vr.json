id": "584867935443286", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_925195390862801_1814114864_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTXl51F5VDgQ7kNvwGoSaZR&_nc_oc=Adrs42CVYQEC3LPq-Z39wJ92smJpmD1w25-W7P2A-lkgZYlB8b9-G4nM0z6TugChh6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AVcfnjcKstBDPcrnl5szyBYjVp77YxDxMJ5IX4O7xVw&oe=6A185575"}, {"file_name": "migrated_image.png", "id": "651930972210018", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162751_719911721443169_61954588_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ttsgcr5GU2YQ7kNvwHics3J&_nc_oc=Adr7DyEZZiYWN5FvBDAygIvvPc7zOosnanHsX6pbcG5EPla816f4zsb67WRyQoHfrRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZjC5vbSC172SSehqmWqZBejPPEjcac9kfUAdXUjTbgA&oe=6A184EC3"}, {"file_name": "migrated_image.png", "id": "2946843058710953", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138838_630493493720345_1676510594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_RP7PYPwgMQ7kNvwFcE8S0&_nc_oc=Ado8p2ijaf1j34lu0ihPlYVE3a28Jl_3m6du6zzXVoOFD7XJ1WLczca7sLnvjePYFWw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LJ-XZjMTyBV6cmJMFrgIARiwtpg8Hfw_DQfGQ4XuJMA&oe=6A184CF3"}, {"file_name": "migrated_image.png", "id": "2240798369548317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138836_1524850844507659_1586381467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpnaGHvSa_gQ7kNvwGI0lTV&_nc_oc=Adry--EVRp1YfzZB72mXDScO18jLDvCr3Jn6J_cN8UGhvktVLrvGUkdmhh6ssd52y8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gMDBpxmLl1D5MpUC_c6M8lRopRATqbYjRSVD_BpH6Hg&oe=6A18382F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neverout", "keywords": ["cube", "room", "maze", "puzzle", "riddle"], "long_description": "\"Neverout succeeds in every area. In VR, it is one of the most immersive games I\u2019ve played,...\"\n8.5/10 VRGiant.com\n\n\"Neverout is like being inside a Rubik's Cube ...\"\nAmberVR\n\nIt will lock you down in a room and won't let you escape. Will you survive or ever get out? Your only choice is to find your way to the next room, but watch out, many traps lie ahead. Wander around for hours solving over 60 beautifully crafted levels.\n\nNeverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a small, claustrophobic room, that has only one way out and its unique mechanics lets every wall become the floor. Watch out for something heavy, getting electrocuted or giant spikes.", "short_description": "Neverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a claustrophobic room, that has only one way out and allows every wall to become the floor. Try not to die by being crushed, pierced or electrocuted."}]}, "developer_name": "Gamedust Sp. z o.o.", "developer_privacy_policy_url": "https://gamedust.co/news/privacy", "developer_terms_of_service_url": "https://gamedust.co/news/privacy", "publisher_name": "Gamedust Sp. z o.o.", "support_website_url": null, "website_url": "https://gamedust.co/neverout", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3813404225550791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162739_506790509505583_458019371_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzlnCCdiRP4Q7kNvwEl9wkx&_nc_oc=AdrTqE2ReiaJwHsJt8LNyKk3UCmTDfh
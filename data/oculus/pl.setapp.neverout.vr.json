erout", "keywords": [], "long_description": "It will lock you down in a room and won't let you escape. Will you survive or ever get out? Your only choice is to find your way to the next room, but watch out, many traps lie ahead.\n\nNeverout is a brand new kind of puzzle game. It puts the you in a small, claustrophobic room, that has only one way out and its unique mechanics lets every wall become the floor. \n\nEnjoy over 60 beautifully crafted levels and fresh, exciting mechanics.\n\nEnjoy changing the state of each room -- they have no limits -- whether you are standing on the floor, wall or the ceiling. Just be careful, and don't die by being crushed by something heavy, getting electrocuted or being pierced by a giant spike.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": "http://setapp.pl/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Setapp Sp. z o.o.", "support_website_url": null, "website_url": "http://setapp.pl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979793429333527"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1684339781619079", "version": "1.1.3"}, "id": "1920441647978885", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [
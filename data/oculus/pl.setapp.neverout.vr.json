XFXjY_IBPf2RXGcfE8o21UWlWJFw7ZIosqmMREw&oe=69B01216"}, {"file_name": "migrated_image.png", "id": "584867935443286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138832_925195390862801_1814114864_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfgMgqeGrssQ7kNvwEjdAhI&_nc_oc=Adkqhjb9DISO5SQCuHyH44TeHL9YsLkI-5v89Ci_arm2Re45MLsAMLDEX_msB1rX3vU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2wICw48qjoY_R2L2PVEV_KnDic8c8lk17FFDK0Wjruw&oe=69AFF6B5"}, {"file_name": "migrated_image.png", "id": "651930972210018", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162751_719911721443169_61954588_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4uI_-OOgqsQ7kNvwFisKki&_nc_oc=AdmxAog5wTtLSN-uAh9oPa66G4XG18dTGx8U1l1CxKxI-KUNxPCf6I999gXn5cyMxZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxNZ7vYQQz3xK5_BRyL2WZscN9e-pgzM3nBKCfASDnDg&oe=69B02843"}, {"file_name": "migrated_image.png", "id": "2946843058710953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138838_630493493720345_1676510594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt0EEFgVxD8Q7kNvwFJItQK&_nc_oc=AdkvAVjPP7hZe_199l9AVUOHUHLvJgG-3lE64Akxxv6ZlEiCwOiEdTvm--rd5IDL79E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzakZ95bhBaL4BfwAx9S59OVTj5KeiMd_yNACg7-S2JTg&oe=69B02673"}, {"file_name": "migrated_image.png", "id": "2240798369548317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_1524850844507659_1586381467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hxLbBeqnPYQ7kNvwHweiGR&_nc_oc=AdmXxhzHk_zF-tNPo_WZ7W622PvUQv6YPK_Cycqp6AKUa_pfl6PcIocQyKNcYBeMV9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrYGVyaMMvO4cHIkp23WzamEK0By25MnoLtpg2BZ-qYw&oe=69B011AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neverout", "keywords": ["cube", "room", "maze", "puzzle", "riddle"], "long_description": "\"Neverout succeeds in every area. In VR, it is one of the most immersive games I\u2019ve played,...\"\n8.5/10 VRGiant.com\n\n\"Neverout is like being inside a Rubik's Cube ...\"\nAmberVR\n\nIt will lock you down in a room and won't let you escape. Will you survive or ever get out? Your only choice is to find your way to the next room, but watch out, many traps lie ahead. Wander around for hours solving over 60 beautifully crafted levels.\n\nNeverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a small, claustrophobic room, that has only one way out and its unique mechanics lets every wall become the floor. Watch out for something heavy, getting electrocuted or giant spikes.", "short_description": "Neverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a claustrophobic room, that has only one way out and allows every wall to become the floor. Try not to die by being crushed, pierced or electrocuted."}]}, "developer_name": "Gamedust Sp. z o.o.", "developer_privacy_policy_url": "https://gamedust.co/news/privacy", "developer_terms_of_service_url": "https://gamedust.co/news/privacy", "publisher_name": "Gamedust Sp. z o.o.", "support_website_url": null, "website_url": "https://gamedust.co/neverout", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3813404225550791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162739_506790509505583_458019371_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6
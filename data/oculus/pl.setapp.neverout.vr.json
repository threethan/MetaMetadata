id": "584867935443286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138832_925195390862801_1814114864_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLFSqfDTPtwQ7kNvwGUzsGf&_nc_oc=AdoCvC1VvYn8XzNLUbvO293_m4CLxvdGRWTKn8qIPszvaGgom_fwmDhMGGchXBbSr0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVi_uDiz1HNz4atNyRtfETRSDYklsfQLMfNmZPU2x_Qg&oe=6A64CC75"}, {"file_name": "migrated_image.png", "id": "651930972210018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162751_719911721443169_61954588_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFLDFGIp_RkQ7kNvwGM_zz4&_nc_oc=AdrO0bORD7RaqCGxTKujhjXl5AZ3WPF1s7kQ4wky_iKy6QrODgVr6tkOk6CDkuy11Wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH2XgZLAffXJBxYPio2vExgFDf1cKojZk-BQwE8rqCyg&oe=6A64C5C3"}, {"file_name": "migrated_image.png", "id": "2946843058710953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138838_630493493720345_1676510594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbK4bumAR7YQ7kNvwE_az7K&_nc_oc=AdoT_J64boxcm56umSV0BqC3DOks7QspPvH5T6JXoMFrIE2uNCbk2dv_Iy5Vd10PGkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3Ojm0FAvQzPxy035BqS8tVbNF1wz1BYPxlzwywgC4AA&oe=6A64C3F3"}, {"file_name": "migrated_image.png", "id": "2240798369548317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138836_1524850844507659_1586381467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpKpryFEmcIQ7kNvwFPoH-s&_nc_oc=Adqk6umzMhe3k5kiHog7tWpDNLx_h0S4p90sQNiZgvZRYBLxBHADL1pgunMphUfyrVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSpEWhhFA2-ogltfjRaxDpQuM4o6jNcvLVVn0OWANQXg&oe=6A64AF2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neverout", "keywords": ["cube", "room", "maze", "puzzle", "riddle"], "long_description": "\"Neverout succeeds in every area. In VR, it is one of the most immersive games I\u2019ve played,...\"\n8.5/10 VRGiant.com\n\n\"Neverout is like being inside a Rubik's Cube ...\"\nAmberVR\n\nIt will lock you down in a room and won't let you escape. Will you survive or ever get out? Your only choice is to find your way to the next room, but watch out, many traps lie ahead. Wander around for hours solving over 60 beautifully crafted levels.\n\nNeverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a small, claustrophobic room, that has only one way out and its unique mechanics lets every wall become the floor. Watch out for something heavy, getting electrocuted or giant spikes.", "short_description": "Neverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a claustrophobic room, that has only one way out and allows every wall to become the floor. Try not to die by being crushed, pierced or electrocuted."}]}, "developer_name": "Gamedust Sp. z o.o.", "developer_privacy_policy_url": "https://gamedust.co/news/privacy", "developer_terms_of_service_url": "https://gamedust.co/news/privacy", "publisher_name": "Gamedust Sp. z o.o.", "support_website_url": null, "website_url": "https://gamedust.co/neverout", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3813404225550791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162739_506790509505583_458019371_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ojFIOTSZPsQ7kNvwH1ubmr&_nc_oc=Adq7RmWxLVHc1iRJpdoww5s9Fzk21bK
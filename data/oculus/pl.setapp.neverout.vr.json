grated_image.png", "id": "584867935443286", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138832_925195390862801_1814114864_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxCbrWckaiAQ7kNvwEqJWaI&_nc_oc=Adn2FHpsCwf2XWwuKdGkz7djIBLwN6T6hoV9ouhDGKs8g3zDyIMEECnliMN8Ypd0d5o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsDqR33wetSUq6ZZy33rps2T65x0Ib7abldroXKYCpCLQ&oe=69A56AB5"}, {"file_name": "migrated_image.png", "id": "651930972210018", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162751_719911721443169_61954588_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kew4rFtE6ZEQ7kNvwHdD_kq&_nc_oc=AdmfI2-3iIb3UhqxCy0s6KJ0FsTnGtrFRdSA6dmoeLCNQ2z87XmXu0g5jMo5r0iai4E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv49oPZjcAx_c9QFx6lzYxO3GuzUJ0kqVGq9oxafYka9Q&oe=69A59C43"}, {"file_name": "migrated_image.png", "id": "2946843058710953", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138838_630493493720345_1676510594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bJR-rS5gRQQ7kNvwFOXxUH&_nc_oc=Adnw0rNjyN0xlSG7FA1U8efIu7XR1TZlRZa015YIZAzg7ef_feGWxRkggS2O6Ety5II&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afvo4gX0qITQJPXV8ckwxYjcVxozu1-wvP5jkAWpNpw2Lg&oe=69A59A73"}, {"file_name": "migrated_image.png", "id": "2240798369548317", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138836_1524850844507659_1586381467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaBCDAh63nwQ7kNvwGKp9j1&_nc_oc=AdlWhOLQrnlr1lrUnhcm0jc5BmdJ3nZQ7SOV9kI0ISkCiN5eTtV-LS5w09dGWHOiNBQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu9CgNSXdckrsrQ4OF0-DOJy0dYisv8GmILQ1VCDTI2Hw&oe=69A585AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neverout", "keywords": ["cube", "room", "maze", "puzzle", "riddle"], "long_description": "\"Neverout succeeds in every area. In VR, it is one of the most immersive games I\u2019ve played,...\"\n8.5/10 VRGiant.com\n\n\"Neverout is like being inside a Rubik's Cube ...\"\nAmberVR\n\nIt will lock you down in a room and won't let you escape. Will you survive or ever get out? Your only choice is to find your way to the next room, but watch out, many traps lie ahead. Wander around for hours solving over 60 beautifully crafted levels.\n\nNeverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a small, claustrophobic room, that has only one way out and its unique mechanics lets every wall become the floor. Watch out for something heavy, getting electrocuted or giant spikes.", "short_description": "Neverout is a mysterious puzzle game for Gear VR and Oculus Go. It puts you in a claustrophobic room, that has only one way out and allows every wall to become the floor. Try not to die by being crushed, pierced or electrocuted."}]}, "developer_name": "Gamedust Sp. z o.o.", "developer_privacy_policy_url": "https://gamedust.co/news/privacy", "developer_terms_of_service_url": "https://gamedust.co/news/privacy", "publisher_name": "Gamedust Sp. z o.o.", "support_website_url": null, "website_url": "https://gamedust.co/neverout", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "CASUAL", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3813404225550791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162739_506790509505583_458019371_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4BiymrUNKEQ7kNvwFe3iJQ&_nc_oc=AdnrmBD1kUI9d0I7dQaM6G_JJ8vrLMyEIuALtmH8fI3TJZ8FsaGRWQhgd9g9KaB
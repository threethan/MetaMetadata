dqioT4YtaOEfADwnQNfpKIESd2I1J1f3zWdAfBIoMOU_sDh1RVHUraXk3eGG5PJZsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1zusD1f_9ogOBKBL9UfngNlh7GgXemTd0XFmx742_Tw&oe=6B06F4E0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsTzHpRwbmoQ7kNvwGYcQ_s&_nc_oc=AdoRqgeaEBn3h0MXJydbJQivgOpW7JTivHNNnfMFnNaJ-d6WID2R9ejhHRQDD7owy_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRThE9iQswWxMQTeRpRk_pajfi0tIODv84wjsElLckm3Q&oe=6B06F779"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaGpD3P6IxMQ7kNvwG4MpZR&_nc_oc=Adq7amOPMN_U4g6YZQjYKETsqprWfEmqvIGuw0XuUYW4LJfnBnUXtWHTsnpwv685S08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh7majXU_WqO1cIka-S80Hp_XP1m-XPW8QDjOGUw6hvg&oe=6B06F89E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eta-lPSuo8AQ7kNvwHz7pep&_nc_oc=AdrDhin9g21Vsg6a52HdJ5a9fw0r0LSRz4jCjbJMYzMDtbveIL9g7U6njf3a0mbGz0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT27qMN7Af3YWcd94DXsC0R2ra1VSqW5y3rCPDkVhIng&oe=6B06F3A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMrySEbUm-MQ7kNvwGmgbat&_nc_oc=AdoUk1xoXh1PgTvWS59B7Ub9bIf5p6v4zDviJlB8JiTEyVYYTnNGGNRt9zjZrcam3l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS6G-L9_K94iV9kvE7NyLU0ToagAA-h67IxbZQrb8Aow&oe=6B070D03"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}],
phNx3KQ&oe=69F35137"}, {"file_name": "screenshot2.png", "id": "1044504530903970", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391860_1044504537570636_2642105994609689681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUSTn1fxoUMQ7kNvwGXcYI2&_nc_oc=Adqh4CrynGnFBX4pm1_K0U_sajkRymJKhM7l1IWH4w1EuzQGMD-0iimau5bmXNDBKcc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CFvncDLa7GW0NWVa6AxP8-3fhv73xNjMIXNzbgNURpA&oe=69F36B60"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbdmaqKiz6kQ7kNvwHVB_U_&_nc_oc=AdoiOkZnrNQ8uRO9XlhaLlGpPxqD54paSlxoWGt41UPkcSVlfLQKbzTDfXQDDII1bm4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0he021PD1z-qWjhQuFSKAAkg44a_o5I84o-Sv4gAPdsQ&oe=69F36DF9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfsNVzy246AQ7kNvwHPWF07&_nc_oc=Adp7oyo5xM2VcJFaOqf9f7G3XxTf7d675P4dezc8dVBpP05vwCXOvJyYY0VKW42GUsA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Y6UmuJLZvMtIQ6k2F22K3MrkpTen6XGJI-wqC1YvtMQ&oe=69F36F1E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u_s5jpo_BYQ7kNvwF45E8f&_nc_oc=AdqwM88sdHsfYnqhLZ96-B4HnL1aMFV4vnb4Xvg-Fs4XRKVzKnoWeu9_ukkU2HaMd8o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kjGKaew6g9Lc9ajUv5EJDg-0S_9B10TrbGw92P2d9TA&oe=69F36A25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwPQtKmYDQMQ7kNvwGBUzge&_nc_oc=AdrwVqTA8g9IRoJZ5S_8ZozFibnHaS1YwJY6x5ylmfQ20x8_GqvyjBzYG8blhvn1G9M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NVFCgwqR-LT9mym5A3AFdKiM-ctHlJMa5HRhrBEzuEQ&oe=69F37104"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABL
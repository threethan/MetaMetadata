ame": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKk6X8Bdi14Q7kNvwEJ_OQU&_nc_oc=Adolz78IS24sDhhtqb4o8_g9kKlejnttbh_LNl2lpxOu9wT4Oo2pduCHo8Ftm35yjxc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLW8W3CfO4VZ-MiySEH9UrZjdnirhUoShnokvLLWOY4w&oe=6AAEA2F9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtyJ5I7yuyEQ7kNvwEl9ADf&_nc_oc=AdosNeOldMtf0UG_-bkzvPH5wDUg2mPxIudH4qyuhSmfvNcnVm7bqeFWd1-2jhVCv4Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFh31Wjyy3_f1bM1gnbq1FiVU9_nAvTMmAje5QTWHekQ&oe=6AAEA41E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yz5bt25t4XgQ7kNvwGkF5CO&_nc_oc=AdpNXvjFE_iLHpMB-8XjIn0Wg_hOc6vzx9mWXxDw9fhd-FWfU18tnTSECpMZhoH2tyk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0b0Zz6PAUT0gOUPeM1K9fxM2QhPO___SMUznQIlfBEA&oe=6AAE9F25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V3.png", "id": "1405699081531742", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620414_1405699084865075_1031945158046864170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAuo-10BgZUQ7kNvwEKKYEo&_nc_oc=AdpNpOieS7p5brjqexQmxF6kS45ocBFQrM6gA5H0PIL8t75Q3jt-T_wg7TkocOhtnVA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLssblxIriZweHlRbnCniUuGgjxpeq4wDCKbqBf803hRQ&oe=6AAE963D"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4xTpfhmwvQQ7kNvwH_tkEm&_nc_oc=AdndU3djNKVgNHacXHHFvwV7-H1KwwiYvWCUaq0AQAadOGWlHKoCb30Q6qh0WrClSfM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuoNlSDDVgHo1zDTT9pcyCT0NqtRTHHFZT4YVQUDhDGFQ&oe=69A56E5E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMPi2O200l8Q7kNvwHGHlV3&_nc_oc=AdkZ-WVaLqDDFk5V4TlclG6FtCRPc7zY5wT3c7YZuDHZqfVelzPHxcALblI7HzZ-xAc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftYPwFIetebiCvlbyM1rI8p4xbpxRnBAqskBRzwaax_NQ&oe=69A56965"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXWATSM9DlIQ7kNvwEmtFZp&_nc_oc=AdkzFpzSjqFuhdgLP0tjCxLTGZA60mn8TuXhih0tYcvr25vvo5RY6RFDqfAeHb0TG5A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv1FwQtQctv11e0OKMaqLZmg4u8szlt40k0iAtlw3rFKw&oe=69A57044"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28986605497653988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822795_1065004935676157_6362794401999958110_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg7UrVE9dGUQ7kNvwHdp1yC&_nc_oc=AdkzqWvUL1Dys_nfKFjnfzUR8pLmaTT_GZ9ysw7gGqwpVf5WRXKd7EEijfrP-nV4oYE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftjC6nh8VZsA7zrSVrj1KaBq4_huhAGFs2Z8P1D-ji_7g&oe=69A57B92"}, 
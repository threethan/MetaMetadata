3.png", "id": "3851588775080836", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBZtTi-rZEEQ7kNvwE6ECGM&_nc_oc=Adr3KLZWtJC9OilI8bpE8nOpKSDOLjhln1OpgNXL570PiPR9uEAdxUms6X0rBs5m14Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJbQ4dif-1kqY3RAd2TIDnwU9vX3YIlr1UUOOkGJjAhg&oe=6AB29779"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VMULA5NIBYQ7kNvwHETLd3&_nc_oc=AdpxXH2oz6W_RR3A7r0K6ksW4-iF3lW1qbwzvbpugryAlZpTmiyMcmgGB8X2YyeoXBU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwNDij3kzvSqg_AR4iXnF_W6oQUA9bxzBcBO-GUYvskA&oe=6AB2989E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdIiaEBbyboQ7kNvwExUW7p&_nc_oc=AdqL4GqCurdzbxbh9bNnlDAYvhu8fRulharNXowLexCGHlMSIlaPDTv36Q9KTBzbrp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs90nsL3JtOvrYmXifqQQb_GUqucvuLdbytQL9vMz6hA&oe=6AB293A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1583690583494388", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620532_1583690586827721_3185259740769754510_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbDrP--1l0gQ7kNvwERGogp&_nc_oc=Adplcfo-cFcEgYcm8eUlLjbYJ5bgmxa_lxWk46EqyQI1b0UoK_2IGN7353Id3GO2Vu0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaEPGdknnvVEWA47clgsy8i_M2YUCrfun2VeXRqlaZ0Q&oe=6AB29385"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH
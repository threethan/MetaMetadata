_bEPv4w&oe=69ECB9B7"}, {"file_name": "screenshot2.png", "id": "1044504530903970", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391860_1044504537570636_2642105994609689681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg7aYlrojkEQ7kNvwHN2VC4&_nc_oc=AdpIyuufRLyKfrTAd36yqHNDOWVqZ9aDkwENQiIvSzbXutWmWC0pLbIpHJ2iAgjaJj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RQuuvWUJuC6YPpfWjuQubRnBc58gMYI6gfwfvjKeaEQ&oe=69ECD3E0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZjRlLRrNt4Q7kNvwGX_LTe&_nc_oc=AdoQY7yGAznGTuTMJP09jorbeeWS23lyaISp1cdQtJu7q75uGs-NfWMFMLWNflEKbxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cUdF6OxgDIEno_F84Pao-Nkr-oPzXRKXsznu3RFeAIA&oe=69ECD679"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Bj3uRTK5tcQ7kNvwE3E2Hz&_nc_oc=AdosucnHs11lVEvAGNSfxHoyzd1Du_jQ1EyCdRRWL-xiGYm0BPeZODY-sTHCuONNZRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e8dLUyPQ6SgprItBAs2ucjoKsfpu9OCaeWDAfaPkvpQ&oe=69ECD79E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnPa5yUs33AQ7kNvwGMV_C2&_nc_oc=Adq6ZUtzuhdvPmkRsBtFEerrf3_yRiqw6NaDPhP3-mwfNiWuS2H5_Q-agWRHo35C0a4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jPH9gSpjc13ThfSOyNCtmP6zxjJWaIb-SSiOYt-rCZw&oe=69ECD2A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-08ladKOE-UQ7kNvwEeZmgg&_nc_oc=Ado82UU2HTJC2HRmbtl7BkVHwP6HslaOYjcdwUeXplaNVvTM93TxG52FLFUYvsIybaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Pd52lIPdG4eP_ub1I9lT3FgtgccHSufGAobIkWBIt3w&oe=69ECA144"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABL
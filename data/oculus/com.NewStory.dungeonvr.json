dpC-Tqj-Nc73yFgTO7DcYQ6tEH-3lgF4jAgUTIYSZi9HjbLErJkE4bHVEDX0ZHBGxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-TvUMFFEvEr5MxzXYHa-BrHIt2FZQE4OBciyhiJzOrA&oe=6B0338A0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HP2cHw2kJB8Q7kNvwE1rIYq&_nc_oc=Ado4Tnm84t5YzCsQ15w_DuXn8TlG13yDxtMRZSFIMJx1dAzHX0S0IV6plDcgNJm1zO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWUgJc7TQtwKQtVYGly76wwpQtxN3_UrfnGP8xX3g3fw&oe=6B0302F9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz7dmhi-DIQQ7kNvwGJumlo&_nc_oc=Adp8QXVuj3rr8zDKEiztHBzDDQRKOsnNtBU_ahFZ5Bc-a5wHFmJ7JMnYmfl_LEIddLk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzzrhG_XObwfi8s3am9W5oG9U8_vk9lM653k6dppx1GQ&oe=6B03041E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8YJKTLI48EQ7kNvwHknTX4&_nc_oc=AdrmoLwfNOUtjO-tZbPJqLBmEiE1vBS5giKlgPdzbHtge9I8r2BnRvb1V0vGKeUwJLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRbCs469zURoymwE5bBXpAG2PCvUdXtwmDfKEgg_OxhA&oe=6B033765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbRQ2vfxPrkQ7kNvwHFUnzL&_nc_oc=Adp1ijjYP9dnDnP7pYKTCq41NXwqxqmos7SgyMgYaAt11ybBj5QYNabW5skujGg118s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcboHFpex0zOIlo5U_1kRDtYICnlHF5kfccsh69NE-Aw&oe=6B031883"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}],
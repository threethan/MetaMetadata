dqZ73MCFEASDA-HDKER78DVKBghwY7aff6DvZjvNmMcNN0bfHG1wwak597f6Bsj-fA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKWFZ42njdGXFonEIDD9Jlp5k7AAExqOEtnvN-UZXN8Q&oe=6AFB1760"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5RUAlbQfiUQ7kNvwFLqGhN&_nc_oc=Adr_IxIdlaH-ZvFCJLb2kMYxJnhJ3HDh8vc-5X_9M-7JHE3T-EuyWpxwKY1F5ama1q4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc0I9lxAhp_X_5AGgqmGQAm8dCvom8jipNTvLt97u5SA&oe=6AFB19F9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGb9xdok0I8Q7kNvwGJDiMT&_nc_oc=Adrfy2rZPxNn2oxOy5eud8iI8NmEXA8qMhHYSPfaWluNR9KAnZxe0mduH4AZUyR82hA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVQFn2nAdscbKLz5QTuwqgFtUkeY3-E7wWNYP6W5nltw&oe=6AFB1B1E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_45KCIKm-gQ7kNvwFtmMN-&_nc_oc=AdoFGBwfyqTYK0b6s5iTjr2nVn4h328yh2vC3HcCow-HppF8MxwOWf0gxaFP_WTG5vg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEbeytnLnZpvKzsGwZXPWusJKcQs8qnr44ITyPLrfl5g&oe=6AFB1625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zJVSaQKWdoQ7kNvwH9AEOo&_nc_oc=AdqZWgUDj7fs1bn0oMb5acHKGlYAV2Po91mAgV4FJRpk-IMk6dQ1Z84o8joSqBlJnME&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO4t5fD1KyVhJMEaV0XPkTsqxD-zIlZHnMC2rHNN3tbg&oe=6AFB2F83"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}],
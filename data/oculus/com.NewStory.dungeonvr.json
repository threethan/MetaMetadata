dqe7V9XR5HQ0T8AWyQQz4ntM-H7vfkghfmEcfwLmBtYU9R-XlvlNTpDxO3rvR2F2w0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHd6U_zgXxGOFIRhUo7VKCwXVwq68PZCRwa1-JGs0KYA&oe=6B048A20"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HP2cHw2kJB8Q7kNvwHfMhzR&_nc_oc=AdqsHP4JiUaMATDntUrferB2wmZRLz5tCx-1cMO9OvDq_zOrMikDMysoEFub82f60gg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1O5olXwpytte4CTL-Fw56Eb7mkXE_NSuDAJUzDN26ig&oe=6B045479"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaGpD3P6IxMQ7kNvwEe8pXu&_nc_oc=AdpYqx4YWvyzI5p9RCs3MQsFgKY5ir_PYT1JxGnFGjp7mg2EpQKedKTxgQS6LDJK4AM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbEzyThEMzi2zztpTJUzQLb8shCIHUC2WvYqtMqO5cwA&oe=6B04559E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8YJKTLI48EQ7kNvwG-QZMe&_nc_oc=AdrGxKFPs8ud-EVVwCxGzbdTdNbM_t6GQDgOblu_hLyVbL0dD0Wbsj6HJ3AUboo4xPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsLRzmPkNAITP236l6uVg4Y2dzMEdK4flwpWp9zyX3Pw&oe=6B0488E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMrySEbUm-MQ7kNvwEBBaTY&_nc_oc=Adr7uXcvnAjNoDiN-OrcLwQKKTjOA7khtlWdxxbXoH45DzOhGkYOUXH63NoHuPSchUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9wGW8CLDbTM7EIz7-6mYXYvgVonCsDYp25wZTGlcRdg&oe=6B046A03"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}],
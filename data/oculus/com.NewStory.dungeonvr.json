screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJbKBdgFCYYQ7kNvwFkyleH&_nc_oc=AdqDP9AAieNR_CjhtHqOB9xp6G8lX7-OKQ9dOLVEXN6zOMI8dciBuPFls3mzU4NJhsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEWMFHzx5mB0UM3mhCsgm9Oq8hIYRjOVkxxr_kHwLTXQ&oe=6AB92EF9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1NalqU_92QQ7kNvwHwMiwx&_nc_oc=Adpt8wG-wM6OXIpNum1WT52KySloTuS0Gx9-LnpDutc7wZq1TK0W2atr8Jrc-_TqVHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoI9SlNSxW6O4oEJfvcWobuCeXD67J_kaZNnAQx6DFiQ&oe=6AB9301E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_RKL_k_PMkQ7kNvwE-QAWs&_nc_oc=AdoL_l4q6MIxjdwTe-JplcEx-zWvjZ2GwJnJk4CCk5MbKg4dffAOoZWtHQhINYUIMrQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2h_-jcqgwRHfzivUWQK-KHdReKhZsicIAzFfljx_meg&oe=6AB92B25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4 (1).png", "id": "928625176987476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623585_928625180320809_6951583204544815956_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiqI9cSOOgkQ7kNvwGHU_SU&_nc_oc=AdoUB3ItLO_5rQB-yX1fV_nWzZIuJRaQ3YTDAx8Vm9tkvwjHziROvBQXy_HOhtNJy64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIo35mb9jkJJy9mq-9-S3CSP-lqrMeaBOJXSXXuLo8Ug&oe=6AB91C34"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
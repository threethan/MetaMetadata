draJgenKBTWSoKIMF1VTmdjO051Pjf6kHrF9_Vn3TGL3UaT9K7tuOOftRnWhZLbqzI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_epuDM-01Ue2CWwbJCD7J9qyJLxGjqTAelreg1k8_-A&oe=6AFC68E0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5RUAlbQfiUQ7kNvwFYUfAl&_nc_oc=Adq1uLqlyEzKRerGx4NoX4QZQDXpKqW2eptt6-hDp-WdGoHOeIoZD5Io6B94iNdESt8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoo8XMhXRfR6Jm3S1I0cezMiHILQNr0qQvc_xypn5img&oe=6AFC6B79"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeYquJU6rgUQ7kNvwFyZuFD&_nc_oc=Adq3GsBKOYjbOJVGAdsgUeTNO-Q5mbNd7xuIdbY6TBnhUzux22V4gewFk6AGIbFQ6js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrhNGTAHOP1ZSSj4oG78m5BoWioFB09E2hntqhZ5oOJA&oe=6AFC6C9E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_45KCIKm-gQ7kNvwG1MKdE&_nc_oc=AdpAQvvyOn95FJa0oRyKaKRSxjUJEE2KMMhl4pljpxzqA1tIlbrOMukLndN3ulL-9Uc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq_i2R9Eko4e2OLTrUBHpH_IiCDG26j1JmOsE7_ry7PA&oe=6AFC67A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kw6pNGkogsQ7kNvwF935rI&_nc_oc=AdpkttohC3Ualt1amwmLA6o86AeEhlPlRi8uWCQivwz0FM6DAfiklvsfV7VQouOk9tU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvLTANQnWmoHtuO4FfMTLpypGIVEX4azqdwGgylduw1Q&oe=6AFC8103"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}],
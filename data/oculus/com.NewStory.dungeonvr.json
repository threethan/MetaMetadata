XzWHGSw&oe=69D7A1B7"}, {"file_name": "screenshot2.png", "id": "1044504530903970", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391860_1044504537570636_2642105994609689681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP8F4mih6kMQ7kNvwEkyd0H&_nc_oc=AdorwalWSSGnwJS8efRxc86NxIO6yP3AGzp2zdEwBibQqdJmN32TCQ8ceHCLZfXLRbw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pRFICxlPDpMlBkSpr3nSPzKQ2f5g2JrqbKLN7jyEPUw&oe=69D7BBE0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjcvT05ss60Q7kNvwGMFgB5&_nc_oc=AdqLYqCFxMTLC8z3QGwUdYGY4pHEoZHIzkfdRkQewiJvuiWtjOypYv0SWs06fwgp8mU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jRnmq9QaY1VFn3weJzYq3f1xs0KGT7uPF7Q6kkeSkwQ&oe=69D78639"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REqPVET7_aEQ7kNvwGUmkh9&_nc_oc=AdoU4ZYDTS130C9UpALjmDZJxNyhpXd_5qJ2Gnyf2kz2-8PvezpW8rVvaUn4gS3Wvlk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s1-qSkPY_Y4y-hahSwLRt_KkV6BxD-GUCl5aPPL2dDw&oe=69D7875E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h87oTLL6ufAQ7kNvwGTEZZR&_nc_oc=AdoqeXIg5rlldsO-7aKKoOThM9V-0is0_bIy9xpBvYJKX8poOPsvYFYd1-raDSnYSJs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A0kFOKyqhChqtU4YGozl7hhe00lt8rUO3BDPcH8fi_w&oe=69D7BAA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gacl3I86UcQ7kNvwHAPO87&_nc_oc=Adq4-wV1xxuvW9g1fJthB1P1spij67LvQtBTAiO5by2rssRLSbx0FelABTdq5qjbefI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tc9xN5XpL39qCG0Rgf47kTIcy5_gVYMn7prcRfkqSJQ&oe=69D78944"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABL
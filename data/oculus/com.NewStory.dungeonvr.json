e_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-nvl4EcZAEQ7kNvwEA2nwP&_nc_oc=Adp8jdU3t1NpV1c-VThbPvmEA5hAkedDLpKeax5lnJ-L3ryB0qSyybHUfWe1HeLPRH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQG0pVO0eZH5ADc51Kah5mkEIRvB2H5yzUMAedu3-hXQ&oe=6AA6B9F9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E830gG5qx3QQ7kNvwHmF_NS&_nc_oc=AdoJo4Hdn6wEob1wnZr4E6Ve31ZBb8wwQSKs8kSiTGGYj1SdYeMIC3YMyhiby9KU_zY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3O5n18uBF8pdO8qoASvfkmb-Eaid6kCjrCurlFKL4Qg&oe=6AA6BB1E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vHFamSyWO4Q7kNvwGfQKj8&_nc_oc=AdqRgFWwpnOPcXRaU-4Ichmp0eKipuNu_VE_S_8ZTU5lGPCWnckIo_-wPGVjAVsMPh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWrmiFrxhTFaq4VvIPEg1T8YTY5q98pTbbmL2-RJEbyw&oe=6AA6B625"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo BWR.png", "id": "1594435205547660", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620599_1594435208880993_6359753213070512679_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqHiBfwpdUkQ7kNvwHPnW8R&_nc_oc=AdoQ6mCFP62Fx76ckaLkjgFHYPqv9B_nHvYupSiY2TBWRnOFT562kzrB-bNfQmhbQik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoAakLfLz0wxxEuzFwOVSvRbJ89hvQsbIgElmOzYXf_Q&oe=6AA69D54"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
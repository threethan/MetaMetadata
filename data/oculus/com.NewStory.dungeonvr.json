642105994609689681_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9s3H8e0yGsQ7kNvwHuT9zM&_nc_oc=AdrPtpK95sH_o1dXqlOa1wniOtVFuvN_xKvYwuqYjtQK7wh-OKk3d3YwSgoijlQrAxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSh7PB6fJYx3sVxLNnxnCMiLHh0lwruWmcx54eC9WNxg&oe=6B0F1620"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-asnR9GxtMQ7kNvwG_1VE-&_nc_oc=Adrll94heXbiyzzyXA5MqfNsWuRAQ-VjaGTHyyYrLezfIJ4i0zAu3RgJXt8fyaBfT64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUljeqhp8UwUT8dJCG00-iDKMOFP_f4y6Ntv88sAwFTrg&oe=6B0F18B9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8g7c8v9wgx8Q7kNvwECzPDg&_nc_oc=AdqtMlqiI3D3yvpV07v-bH04-oZ90jgDb_ms6XDbVPcAM7FtZRaPVF4zXGiGolafaK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJDuiJXTFhKyxdK2436mx5CQ5U1316Y3dRPc8SkJ-isA&oe=6B0F19DE"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxO1TQotgSwQ7kNvwGsrlQf&_nc_oc=AdqeKojaniU65p-S_1h43KaAN9B3rv2ThgGJROeqazNgagrQsQykpdVeog0KIPw2G-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVlbKgplC3WG5a6SfpvJPuZPZttzxhs0RaFcpC1Sbdfzg&oe=6B0F14E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJnMj0AgY4EQ7kNvwEWbdSp&_nc_oc=Adqg4u8o3StQewAYjuhxicvL4aIj2qxMlVaSFAiyvH2sRHDTu0CNVSmvjVjLRhkNZEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFzRP6PwoKdSB--8Eld8dF8UTBONgDlH1N11nDDKPJdg&oe=6B0EF603"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
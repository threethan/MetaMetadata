79_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17iRfEcb-J0Q7kNvwGo_Dp_&_nc_oc=Ado9mA_d33AjQ-dmWeNE0ApxV9vnmWcXSnJ4v3L6YymNuWaNhOFEz9CH66FNBFaJdyU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FMkxPgocMRVMydxALRXozD21gsbYAI7qHMHt0RBU1Ug&oe=6A465FB7"}, {"file_name": "screenshot2.png", "id": "1044504530903970", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391860_1044504537570636_2642105994609689681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuQgBK2pmFcQ7kNvwFHSVyD&_nc_oc=AdrDvxrlE_Wx3gNT30UHLTj3pEteCAwyUa0FhWpojmSf7afGLgfVmzi-cjXuuQRe3lM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1n4zmcZqe0XyU-tfaTGUTiSRHv7FdanEMr8TOtTIl7w&oe=6A4679E0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMKhvx4UpJEQ7kNvwHcc2c3&_nc_oc=Adp5BW6hTonHpxNIRVrd07UIGnilHD6FUeHS3sbdDyP20J5oLDHi7BE-EwepNgcKlI8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EyQwNxtRdtnNDWiV5vTX_Yr8QkYOGEv7MlgAvMjqhmA&oe=6A467C79"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJlumVvJHQUQ7kNvwFYnSOQ&_nc_oc=AdqcGdVouergNv5CwbfwMSnNmiOUpS8s5TA3wqVh8eTihTrojsVbo9qKwvW1_PRyGLk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-diVXKZl2vJpteXJGR-RRdTCOPWm6yrQKz8aCGQBsvBA&oe=6A467D9E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8jm9a36y74Q7kNvwErDZ4N&_nc_oc=Adqkx4EvOxfS2Cg8e0M9hLvS5BqbE3qYi6_L_yNZ3q41fbKlvF6g4vqfTQnOrmzbes8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KuOYa5_HYZihSsiGwse9t4cbZphtmPe-JUGpRLHagUg&oe=6A4678A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm3aaBBRkQoQ7kNvwGsimTL&_nc_oc=AdrxtML1b3vpkEo8R-9scmGt5Hyol-2xqmH8dSj1wlPPB4UUfu9matIhZU_GJcSoxs0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yl5RbP9fD-VPGaZvm5c9DR-Iw0str-JR7Ydzf8lWOzQ&oe=6A467F84"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_
-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2xwFC96O3kQ7kNvwECuyjH&_nc_oc=Adqi_Be9Wq4SnBN_7kvm7rrkDe9Cgyup5UVZ7Nqqaly5nJg2okiTg1hl1DOzbMAR9s4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqTh-155uc0nrG3UfbefXzz9jvqNZ-gqM_JnTdcl0vRg&oe=6A79AFDE"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6V1prcy-fEQ7kNvwFC2FfE&_nc_oc=AdoD59-U7xAVa4nZnhIDMJ08rGaP1s1_byq3QSoUuR4CkYYdDD7lTPB5pBJ5FAJel1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-6rN2LndzP9svKOW-x4Yt9h5CSIPEX78fKkYjNcZo7g&oe=6A79E325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VChAZ6fJX_YQ7kNvwGIOmR1&_nc_oc=AdofjmFv5-dZEp7jprblXW_ebofpdF7hbeQwf2i28dqJjL8jDZ7mA2wULy8jUfRTWm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQRFq45eZveruRpbyz7lpGw2G0CJEkv3fM5aRAvgt42w&oe=6A79B1C4"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28986605497653988"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "534437823046823"}]}, "baseline_offer": {"id": "534437823046823"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745294820, "status": "PUBLISHED", "id": "534437823046823"}]}, "liveChannel": {"nodes": [{"latest_su
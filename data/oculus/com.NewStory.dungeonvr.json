 "989124283306778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393977_989124286640111_4815138710480421379_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo4KwE8lTisQ7kNvwGhZJ62&_nc_oc=Ado0_dOQHKU8n9intzBOxKunr1GHCxN1ZXmIzGAss8cBRoy45VLw7jr0f9uGIm2dYK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5nOnVamSlzseg3mF8Pnyy7ANoOrzYHAnf4uTrQ9MfrA&oe=6A4A5437"}, {"file_name": "screenshot2.png", "id": "1044504530903970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391860_1044504537570636_2642105994609689681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_63P2Zflvx8Q7kNvwFrsCTE&_nc_oc=AdoavQDD_KE4jPxnDebhl2M62gDGPNy3NqDJg2Ewzy5zMWiCfgEYIDkSqBkCj8pPSag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7E5Bc2Uvhv99te-x81XNEjC70aEDsWs35gOhYqSMWBg&oe=6A4A6E60"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDAGmM3omFoQ7kNvwEgr-PF&_nc_oc=Adoi_FBULL-TJ0FSL11Qgr9YXJqdWFVi-G13ndpuUUFzJqyj0fYlxhWoj4gwjfdI0qA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1foDCBOn7wsHM4ljoyzHqtlJ6yH28ZM5hDNx1pNdmvA&oe=6A4A70F9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yd0-MuRvdgQ7kNvwFFgkMV&_nc_oc=AdqwilQK6tuhdqnm6o75nDvTC4ylFXDn3Lf-0-UzOC_ft6PRhczHYwD1xFNs_okdBGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBD441ldZRU3U0A8nwN8n5AiHrzU5HrD_ipNNhVAXUVA&oe=6A4A721E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8yfRS9NV98Q7kNvwFvDtkX&_nc_oc=AdqV1Hz7Heq8cG2cruixMIqSSSiFudCXqWvUtP7jiZOWGihw-Zs835Yn4DhhKsqa-IA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_XFmMgSNb83pGVsGibrFicyy2DfRkzP6kizMIIyyPAw&oe=6A4A6D25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbN8HZZ3_9wQ7kNvwGDbvA1&_nc_oc=AdqC1dA8jqn2r8YEhvZdSgbVsGUlmJ3aSAC4ig3VTAyCF4xTMOHjnGCgLxlr1UEmIKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbYuRyFdmCZzw1lPspZTGYhxCqB11d7cEAnJwJ-1MnFQ&oe=6A4A7404"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28986605497653988"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "534437823046823"}]}, "baseline_offer": {"id": "534437823046823"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745294820, "status": "PUBLISHED", "id": "534437823046823"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33888441087470380", "version": "0.0.3"}, "id": "637460975854293", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28813459328301940", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33888441087470380"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "637460975854293"}]}, "cha
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kLHlWhBA04Q7kNvwGMsfOi&_nc_oc=AdlwgcqcXPamPMC3wDrWYmahXJ6s2urDjF67m1GwIuPkgAlOV89bq5ttQvbmachE-b8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrB-Y94q89sYLckaQON013TrlKicVgYv7wlWZT1yIz3A&oe=699D855E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiwW2vS67QEQ7kNvwFRbknB&_nc_oc=AdlxpWQehY795-gp8ZOdSg9ysljV73Hix7t5lkVWYL21L-wIkVtczBJH_ONYB5464nA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsRXxC6XXtHcX4rawB9p1KpeZDYUOaNir_2V92cV44Qnw&oe=699D8065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttCcayyZg6YQ7kNvwGzd-O2&_nc_oc=AdkIMkR-7azQ9-BXiesuCfAJ0pgEmBUO6jG1c9rZu4cZ5puUTKO9Dnv4-k1IcfZ55sM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHhU1IsRIVYg9gBJngojCT2W-WIqgayz_Nyvg0lGWb3A&oe=699D8744"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28986605497653988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822795_1065004935676157_6362794401999958110_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUUI9jAWToIQ7kNvwHMG_0V&_nc_oc=Adkexp__YHJoH49sSHBvgNwUV8QWNbd2w4W6n8Bb_HIY94ZSOVIdbwvwLy_Y5GWX5Ec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBaRQ2rkoJB00FbcH2i9xf5ZSrR_if-TEM1Cs2DUqIlg&oe=699D9292"}, 
screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlOKvJdOR9QQ7kNvwHDp4pl&_nc_oc=AdoVobhGNlYuRJ83xrUSwSbCH8qd327Y99dOvYnsPn6S7ouNkBC-qt6u0KWpXejnDtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWF6II9apvhFw-RdH5E7vCT36pJumGF4dQUGA0hjP5mw&oe=6ABBD1F9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1NalqU_92QQ7kNvwHyzCm1&_nc_oc=AdoGFKtqlVaLK-LCOKX_1fgyirhk54WZ5PI2XuYe9ihQOkeyUM-nOuJ88QmskfpQYgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpRkrL5tNJla8neqCk1NrWaqsS_sWNhHHVZM-Ktfz0Fw&oe=6ABBD31E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZmYEfnChQ0Q7kNvwFsY-ZP&_nc_oc=Adro5XR5VALTFjuGvMdcjdjOJ8yQr1g_aHfCkRI7LnlWujDeqHgxqii0RuRqt2B1qVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoIRl7614UVaphov27Z6EhVopPJK0ha2f-Vdql9TM1bw&oe=6ABBCE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4 (1).png", "id": "928625176987476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623585_928625180320809_6951583204544815956_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51vpkVlNEEEQ7kNvwEjnJaV&_nc_oc=AdrTqvfsz7GAW9GgJBhIclCzaYg8M5f9lPitSq2SvVBULKts-vj6zE0pCsX3gsVd9jc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgIP2jrnQE0g3DWZ7BzPvJur86_579I9SI1EdsbOYq2g&oe=6ABBBF34"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
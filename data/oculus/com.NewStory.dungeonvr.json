dpElTiWSpM_qC31iscKjNz8si8ZxiLxW8KoK0m1Io62CbXMwKNgQCWFLs711OUyLWg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdDmyT0rq2mru-WPc2ajHH4jaCeW8rRsTGfTm2D8RhPw&oe=6B0B21A0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL7nGcYHP1IQ7kNvwEWdu6H&_nc_oc=AdodoFFcHJQg8CVxxVGZ9bzRILWMOPI9KoPb9E7hDLoE6K0r2iPrcqUlMXdiSo3H96w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRXyn_-PpM3S7pCrsUOCI88ADw-28BDPRjoSKOAOufgtg&oe=6B0B2439"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxAFiUh94d0Q7kNvwEr-x9M&_nc_oc=AdpgCPVpbXTMmBcS3q5alsPEJQSNZSsUhnyCj8apWIiEAPbJd4vr_csVf3OlEF0E0rs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8tTNjjBYKVl-brH1SPHMtH5wJEDXvbnw26XYJFHwe7g&oe=6B0B255E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylUboE6CeuIQ7kNvwH-YTti&_nc_oc=Adrn-UKpAuPQCL9blnm8MekRkVNw8txCC3tzBCfvyrG4KYQtTslC7O0vXoAvm8U0XEs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQX2W-poS5uCNSePO7Xns2edGh4qlfqGlbctZkxmb1_7w&oe=6B0B2065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydgBOFHbE3QQ7kNvwGC1lUF&_nc_oc=Adp4ww5K31ntBlHs3L8WBZUgX_03ME0OwpygKb6YXyosf-9D-wtRPh13_N2tKswsfmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSt_6DQeePtJrvCR5DlPVN6678wplNSntiJxPd0wvekw&oe=6B0B39C3"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}],
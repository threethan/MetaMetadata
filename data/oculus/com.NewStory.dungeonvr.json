OcAfRqQ&oe=69EA16B7"}, {"file_name": "screenshot2.png", "id": "1044504530903970", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391860_1044504537570636_2642105994609689681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRGBA-5osXkQ7kNvwF02KEf&_nc_oc=AdoBbXp_B7GTJCm95yXT1uVLELWk3Rrkp-W-7qf_O4KXGcJe9-ahbTUuu4DAyvu45PY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lJWqDqwC0qykqMX4Y7G3Kfj3yOArgRhuv20QVrkHkdg&oe=69EA30E0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZjRlLRrNt4Q7kNvwEgwGeO&_nc_oc=AdomD0CKi795O4nXsknhQIHYX8tvExCK6EdcWBhD6yw4qYKSp3CDR0TMGeb143RxKno&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07On8L6Mi4AjaJsxae63UeMgFQzviDEWBVwQw6qOMBYQ&oe=69EA3379"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s08xkydU1pMQ7kNvwF74Snq&_nc_oc=AdqJb52zsZSKIEgXJQ7QYmAdGprOY8aRVKTgRhs1QcoovUz2wts3oocgbWOcfIS1kak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30nRBhsDeEJ0XP7W5aciuYbZo8FKw0VBd9lBLFKcKbqA&oe=69EA349E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnPa5yUs33AQ7kNvwE-iUNQ&_nc_oc=AdpTs1pK5AmH4ZVqI89nsp7rhlUn61WUbrP22OfLdn0MBfHfTqRpUaIBkSUf_bPA9Mo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BxpFcujzxYMxz-uURqKEn5vuxj8DA8vwU0t6nUc6XzA&oe=69EA2FA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "1030416448999878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391921_1030416452333211_1658634763125926847_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HHJhFO16IcQ7kNvwH7Eef_&_nc_oc=AdpBqS_7wGeDZGUTArFXjiXvJ2UICstqYPghXXpy6jY5DFGi6Uzg0L4qOH3B4wkX3r0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0drmqb-D3jpgIv9Atcg9ax688rRfWKbVzCXSwtYYEIbA&oe=69EA3684"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABL
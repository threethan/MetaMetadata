drj5nrWlD-tzHkw4iz2Hr-YAarnLcebOvJEq9FBIMjjhd-Nc_RqtAhaYBLspUEk52w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5bqfAveGcX0DEPH1rCD7L5hruX4bm8o80XLX2ghqwdg&oe=6B0997E0"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsTzHpRwbmoQ7kNvwFLwzAN&_nc_oc=AdpL1Xbrdjw-VhiexpshjDW_y3BP6qb38oOnTcXzRgb4kvhnP8_7UcFtuUt9C4TymDI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6QMYibDGX8d72mfIA6ludAPSgDWmfLpGhLNDgIJZt2Q&oe=6B099A79"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxAFiUh94d0Q7kNvwGt7JsU&_nc_oc=AdpbdMdAoqzutE_g7KsoP9DFur680UkwUEs_mL3DTFnlVJmzASPK9yeyRbGjH3gN3xk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_CdzjdHga5NSHljna1ynCMbgH3AgRut7Vd27D0FrE2g&oe=6B099B9E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylUboE6CeuIQ7kNvwH-82K3&_nc_oc=AdoydDNfiy1Afn6k6IZO6n6hgQbYPEG5MdqXKcndcepZXJRtq1g8bQgaV7u-WGiQFo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQboHhudluEMXo9GO2XqPN6HX1jNHVmAWyiq1n3eStN4A&oe=6B09CEE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydgBOFHbE3QQ7kNvwG5iKSV&_nc_oc=AdpzpcQ3hhk5hITgY2Xr6894ZQyb18ORWV1zBei8snjE5DxdObUrq2AmJviHdBEH2RA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrktgOmFkaeL7I06NKSWpBnfIp6Hiew23sfp5HHpHwgg&oe=6B09B003"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}],
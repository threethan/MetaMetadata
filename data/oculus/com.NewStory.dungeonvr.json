doYrXWrBsRTnhUK3QBE74BtkUvtVj9hVgAeGRGtgsje9fPq6JMgI6Qppd8fCriDthk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdthlJxggaDRpd3a1Aqhys_4T1H5WOKCXFJk5u0KZlxA&oe=6B005D60"}, {"file_name": "screenshot3.png", "id": "3851588775080836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822790_3851588778414169_208103079704389125_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q8omhavfJ4Q7kNvwEBTLBv&_nc_oc=Ado-6ZkJbB1yQjBcRnJkZRGlZRcSc4d1040Y2EyJ2br69B3KJJIkBVd-B0xqc_jIxgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH-MGbLV6kB6jP_99fLhF4Nm4q5Od3gvtOeu9Tdy--OQ&oe=6B005FF9"}, {"file_name": "screenshot1.png", "id": "1127579675838465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820093_1127579679171798_2677043666339594417_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz7dmhi-DIQQ7kNvwGlaU8t&_nc_oc=AdrS5ebXjCGdw-T37kkNBz9Ul0_1gCC8HSFIi7O4GyVcB1jR6VVMOYZJhQLLoTXiDUg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwT-0V-dkemKJVSlsKL5bI0ZTgH49Iq3eUrVplrJx0Ew&oe=6B00611E"}, {"file_name": "screenshot4.png", "id": "1212304633804613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394082_1212304640471279_5131118070059765112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9P41dracgMQ7kNvwGwHnBQ&_nc_oc=AdryI6BIE9vEkY4zyk2OJ3czDxa30aVb6pMfKEj1HMxXfDHgqErAledzrSWqOPVyhF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkmng1pUiEw8GDIQdWbrsvOMv6Fyp59oOLwd7mPDs87g&oe=6B005C25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V6.png", "id": "1501181965365136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622202_1501181968698469_438919485841732628_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbRQ2vfxPrkQ7kNvwF-78Mr&_nc_oc=Adp1r4-5PT_xY8dt6nF97h7E26JfRqGb-3BmqVjAj6p1_nMJLRZxN9N0KBID3KPvT0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuJnzCFNZ_UjeKbWgjFkZTsXDSTxadpA3AE97d7q_tHQ&oe=6B007583"}, "display_name": "Big White Room", "keywords": ["room", "physics", "action"], "long_description": "Welcome to Big White Room. A place with no color... just endless white space and a whole lot of satisfyingly realistic physics objects. Your goal? Experiment, build, interact, and maybe find a way out.\n\nThis isn't about complex riddles; it's a hands-on VR physics playground. Get creative with our awesome physics engine \u2013 stack crates impossibly high, build wobbly towers, send spheres flying, and see how things satisfyingly tumble and crash. Feel the realistic weight and motion as you manipulate objects in immersive VR.\n\nAnd yeah, you're not entirely alone. Odd figures watch your every move. Feel free to give 'em a good smack if they're creeping you out \u2013 the physics makes it surprisingly fun!\n\nUnleash your creativity and just have fun messing around with physics in Big White Room. See what you can build, what you can break!\n\nFeatures:\n\nEngaging VR physics sandbox set in a stark, minimalist white world.\nHighly realistic and fun physics engine \u2013 perfect for experimenting and creative play.\nBuild, stack, toss, and manipulate objects with intuitive VR controls.\nEncounter strange, smackable watchers.\nDiscover emergent ways to play and interact within the environment.\n", "short_description": "Mess around with awesome physics in a strange white VR world. Build, toss, smack!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}],
bite, and reel in your catch. Enjoy the simple excitement of fishing while experiencing it in VR.\n\nWhether you're a fishing enthusiast or just looking for a relaxing VR game, How to Fish VR offers an easy-to-play experience focused on fun, exploration, and catching fish.\n\n\ud83d\udc1f Cast your fishing line\n\ud83c\udfa3 Catch fish and improve your skills\n\ud83e\udd7d Enjoy an immersive VR fishing experience\n\ud83c\udf0a Explore a relaxing fishing environment\n\ud83c\udfc6 Challenge yourself to catch more fish\n\ud83d\ude0c Relax and enjoy a fun fishing adventure\n\nGet ready to grab your fishing rod and start your virtual fishing journey!\n\n**How to Fish VR: Fun Fishing \u2014 Cast. Catch. Enjoy!**\n", "short_description": "Dive into a fun VR fishing adventure! Cast your line, catch fish, and enjoy an immersive and relaxing fishing experience in How to Fish VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/skyloft-3d-studios/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skyloft 3D Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/skyloft-3d-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1328358113701889"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4618834138354153"}, {"status": "PUBLISHED
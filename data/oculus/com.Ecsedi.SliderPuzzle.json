c=XiaCHBmzqucQ7kNvwEnUL9Y&_nc_oc=AdqAcS8HtjFg_KuHQDHTrfDvWJjazBvwfnZ7z1MN0RfW7DkBgKngPdW4DwPshItTEo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EclKqc7XHkzj2K3NTQdoX_ZwrJpjJiYm7kWKOsc6Uyw&oe=69E0C77C"}, {"file_name": "screenshot_02.png", "id": "2445270109205113", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831774_2445270112538446_7428821968919022456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjhR-fLPJN8Q7kNvwFuvL16&_nc_oc=Adqw_6VhIRhhzFpI2vD7aB3X02v93MUoent7idKjxXdPbqyabws0niAgoWXBq6vYG0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J7uoO15_euUYY17DzknUAR-yQxoHZmGpWZ1Y36jbEuA&oe=69E0DDB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slider Puzzle", "keywords": ["puzzle", "casual", "relaxing", "slider", "logic"], "long_description": "Slider Puzzle transforms the beloved sliding tile challenge into an immersive VR experience like no other. It\u2019s more than just solving puzzles\u2014it\u2019s about building your world one move at a time.\n\nStart with a quiet, minimal space. Solve a puzzle\u2014and watch as your environment begins to unfold. Every level you complete reveals a new piece of the stylized low-poly world around you, turning each success into a moment of visual discovery.\n\nThis is the classic puzzle, reimagined for virtual reality\u2014designed for focus, calm, and flow. No distractions. No pressure. Just you, the tiles, and a beautifully crafted space that evolves as you do.\n\nWhether you\u2019re a puzzle pro or just need a break from the noise\u2014Slider Puzzle is your perfect VR escape.", "short_description": "The classic puzzle you know\u2014now in VR!\nSolve, reveal, and immerse yourself in a relaxing world that comes to life one tile at a time."}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_
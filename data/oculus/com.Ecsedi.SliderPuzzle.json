c=yk0-8ZMCp3oQ7kNvwFhIrko&_nc_oc=AdofPJsyhU4_8xtE0OI0SVWXrJ8oSJyioVkj-mDDIv--8d9GAojbQgnpEezQnR2-r1M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHxsmptMEj7vWsn5H6lKtoWVuOFbOlDDHii0aF5AbEGA&oe=6A65EEFC"}, {"file_name": "screenshot_02.png", "id": "2445270109205113", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831774_2445270112538446_7428821968919022456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTqn6IbiIigQ7kNvwFrltaT&_nc_oc=Adq2Zek_TLqQ2F3D9R9WJbynKa9P7oMsp138Z0qFosgjIOG3dl0w3LcqWNcV0oCLIsk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7epCle-vDCJPnMFAMt_HYWaMp-74ku9UC5Q7rm5wHpQ&oe=6A660531"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slider Puzzle", "keywords": ["puzzle", "casual", "relaxing", "slider", "logic"], "long_description": "Slider Puzzle transforms the beloved sliding tile challenge into an immersive VR experience like no other. It\u2019s more than just solving puzzles\u2014it\u2019s about building your world one move at a time.\n\nStart with a quiet, minimal space. Solve a puzzle\u2014and watch as your environment begins to unfold. Every level you complete reveals a new piece of the stylized low-poly world around you, turning each success into a moment of visual discovery.\n\nThis is the classic puzzle, reimagined for virtual reality\u2014designed for focus, calm, and flow. No distractions. No pressure. Just you, the tiles, and a beautifully crafted space that evolves as you do.\n\nWhether you\u2019re a puzzle pro or just need a break from the noise\u2014Slider Puzzle is your perfect VR escape.", "short_description": "The classic puzzle you know\u2014now in VR!\nSolve, reveal, and immerse yourself in a relaxing world that comes to life one tile at a time."}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_
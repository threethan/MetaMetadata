c=UkF3LSzJnSgQ7kNvwE6-OE0&_nc_oc=AdqxaxInapYg67fMUPDq5I0vEdRJXzGuH2A317f3vTz-JyTn3A_N0k91tdugUBXDp3c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t96oZOueIp9njD6rktIolWHCQ-IJciJXhrLWgDOuVew&oe=69E645BC"}, {"file_name": "screenshot_02.png", "id": "2445270109205113", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831774_2445270112538446_7428821968919022456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTGjN_3V8tkQ7kNvwEREf9e&_nc_oc=AdqN-Eqborch6KU-yz7AYzuGbW8ZNjXB0dz2-CWQ70bZVs7GGjTWnBxpA6arjYYFOlM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16xydl3g0oxjwABjfkdu082XHQNi9htIJJAF59CQcv6g&oe=69E623B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slider Puzzle", "keywords": ["puzzle", "casual", "relaxing", "slider", "logic"], "long_description": "Slider Puzzle transforms the beloved sliding tile challenge into an immersive VR experience like no other. It\u2019s more than just solving puzzles\u2014it\u2019s about building your world one move at a time.\n\nStart with a quiet, minimal space. Solve a puzzle\u2014and watch as your environment begins to unfold. Every level you complete reveals a new piece of the stylized low-poly world around you, turning each success into a moment of visual discovery.\n\nThis is the classic puzzle, reimagined for virtual reality\u2014designed for focus, calm, and flow. No distractions. No pressure. Just you, the tiles, and a beautifully crafted space that evolves as you do.\n\nWhether you\u2019re a puzzle pro or just need a break from the noise\u2014Slider Puzzle is your perfect VR escape.", "short_description": "The classic puzzle you know\u2014now in VR!\nSolve, reveal, and immerse yourself in a relaxing world that comes to life one tile at a time."}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_
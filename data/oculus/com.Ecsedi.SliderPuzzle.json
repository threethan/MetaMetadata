c=mdhfiK-UNEEQ7kNvwFhQ7yi&_nc_oc=Adp8PYOQYhhMKuAvQ3oke4JSRaEE64gAzY4uMgvLJvdk0SDAtOpxx2rmoZwtkJ7ngd4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FB6LZzOYYr4IW948neCXYC-DEc_vpM3qJGR1hmrfkAA&oe=6A3D48BC"}, {"file_name": "screenshot_02.png", "id": "2445270109205113", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831774_2445270112538446_7428821968919022456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eShIUIvEo58Q7kNvwE5t_kE&_nc_oc=AdrTCsmxDhilfQ7z4Wt2LBUj4K5V4Igtd0tmCx5ojqTSeDsmtj5qoe_gxsm9l9AP_go&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gxWgSupSUp8ypfeK2FjnLbt-tkVppyXCRhGv8GS-Aww&oe=6A3D26B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slider Puzzle", "keywords": ["puzzle", "casual", "relaxing", "slider", "logic"], "long_description": "Slider Puzzle transforms the beloved sliding tile challenge into an immersive VR experience like no other. It\u2019s more than just solving puzzles\u2014it\u2019s about building your world one move at a time.\n\nStart with a quiet, minimal space. Solve a puzzle\u2014and watch as your environment begins to unfold. Every level you complete reveals a new piece of the stylized low-poly world around you, turning each success into a moment of visual discovery.\n\nThis is the classic puzzle, reimagined for virtual reality\u2014designed for focus, calm, and flow. No distractions. No pressure. Just you, the tiles, and a beautifully crafted space that evolves as you do.\n\nWhether you\u2019re a puzzle pro or just need a break from the noise\u2014Slider Puzzle is your perfect VR escape.", "short_description": "The classic puzzle you know\u2014now in VR!\nSolve, reveal, and immerse yourself in a relaxing world that comes to life one tile at a time."}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_
a&_nc_ohc=0P6cO3E-rr8Q7kNvwEVxydX&_nc_oc=AdqLRPSO9iGdfeGSCwbCQ1NK0qwpFNnr6r8EoEM8A0tD-kyhkv_-6mbIQnsi2rBSfqQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0baec7YGvQjVocuFDot2n-qYXnAj_TYM6AuswokrxKw&oe=6A36B13C"}, {"file_name": "screenshot_02.png", "id": "2445270109205113", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491831774_2445270112538446_7428821968919022456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg6gEE-JYPYQ7kNvwFAc_cz&_nc_oc=AdrXr-g-tJAIS2YMhui23jcvKsQWEOBz7It_6Nld4ovOXHFNf03R_EnzUKZnYv8MVgM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lOsH9KUaUJgQ2zwluIV1cF-JOWYIz3rh5dHzOzVifng&oe=6A368F31"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slider Puzzle", "keywords": ["puzzle", "casual", "relaxing", "slider", "logic"], "long_description": "Slider Puzzle transforms the beloved sliding tile challenge into an immersive VR experience like no other. It\u2019s more than just solving puzzles\u2014it\u2019s about building your world one move at a time.\n\nStart with a quiet, minimal space. Solve a puzzle\u2014and watch as your environment begins to unfold. Every level you complete reveals a new piece of the stylized low-poly world around you, turning each success into a moment of visual discovery.\n\nThis is the classic puzzle, reimagined for virtual reality\u2014designed for focus, calm, and flow. No distractions. No pressure. Just you, the tiles, and a beautifully crafted space that evolves as you do.\n\nWhether you\u2019re a puzzle pro or just need a break from the noise\u2014Slider Puzzle is your perfect VR escape.", "short_description": "The classic puzzle you know\u2014now in VR!\nSolve, reveal, and immerse yourself in a relaxing world that comes to life one tile at a time."}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "
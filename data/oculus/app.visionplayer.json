901_1395860452491411_1980459824889599129_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BscA8uHAKTEQ7kNvwEH56uJ&_nc_oc=AdqvZpbHwairvC_Yv-qPoscwdXdrX1KORai5v9mJRQw7tYkQzv5M7L3u5wzyNsd-fZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOssMEE_hQz1GfpYtn7MColK6nHWzDbEUSo-kNrcbRutQ&oe=6ACBB496"}, {"file_name": "com.oculus.vrshell-20260725-135711.png", "id": "1021766860633370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1021766867300036_5602412938494363700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC6E2yErxA4Q7kNvwHEv87G&_nc_oc=AdoOsuyX343hgWet_ZhtERQpcuBGUln3VvPK2a0mjuzFmqBTxIIpR9Hq6YLrPjxPWAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5uN7LHraidcapOFisMC9OWxHddkWiA4pYuIIzP1OjkA&oe=6ACB9877"}, {"file_name": "app.visionplayer-20260725-135620.png", "id": "1410824680932952", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_1410824690932951_643382391049603805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uv5pssCX10IQ7kNvwHktSNx&_nc_oc=AdqkUujeSXvI8ZEBOD2BEvDUwCsssi-bh34xGw5Oz-wxLosjoLCsAhy28U5aRQmfDJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd3i-GFPLgZqrp-nvJavbS0K-NL3B3mUQszB9cYvMMVg&oe=6ACB9963"}, {"file_name": "com.oculus.vrshell-20260725-135424.png", "id": "1537776878377527", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_1537776881710860_4585617118030407811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmxnvDc5TooQ7kNvwHjQLNC&_nc_oc=AdrhNy2cP50VWBS9wRB1HbJHtd8zSi4RBIeVWyHtB_ok_7f4Lf1CQ9W34qlF81yT34Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYiVq2GH_fD0th2TA50BOWROimUTUiHahoBbpcJ830hA&oe=6ACBC1E3"}, {"file_name": "app.visionplayer-20260725-135647.png", "id": "1489991453156830", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1489991456490163_2799930074387900538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luv8UhNu-a4Q7kNvwH_7xtj&_nc_oc=AdqJFazSwCdiSfz5jfKzXEhAHRvAFKpYQl0FaAqvfBiizda7mZlA-pZhHmX3txThn3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRQ0md-an0a6QCHov3hG_v5B2FWHOGqpFaEFXt2eoizA&oe=6ACB9BC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro: VR Video Player", "keywords": ["SMB", "DLNA", "VR180", "cinema", "3D"], "long_description": "**Your films. Your screen. Any size you want.**\n\nPlay videos on your headset, or stream them from a Mac, PC or NAS on your Wi-Fi. No companion app, no converting, no account.\n\n**Free trial: up to 5 hours.**\n\n### Stream over SMB and DLNA\nMacs and many NAS drives appear on their own; add a Windows PC by name or IP. Sign in once, browse your shares (external drives too) and play at full quality.\n\n### Every format, detected for you\n2D, 3D side-by-side and over-under, VR180, 360, fisheye (190/200/220) and cubemap, recognized automatically. If a file fools it, fix it once in Format and it's remembered.\n\n### A cinema that fits your room\nA big flat screen in a dark void, or in your room with Passthrough on. Set its size, distance and angle; 180\u00b0 and 360\u00b0 wrap around you. Packed-alpha videos play cut out over your real room with AR passthrough.\n\n### Run it from one controller\n- Thumbstick left/right: skip; hold to go faster\n- Up/down: screen nearer or further\n- Grip + thumbstick: previous or next video\n- Click the stick: pause\n\nEither hand alone, or hand tracking.\n\n### Built for real libraries\n- Continue Watching, Most Watched and Favorites\n- Moved or renamed files keep their progress, favorite and format\n- Audio tracks, SRT/VTT subtitles with sync and size, speed, shuffle and loop\n- MP4, MOV, MKV, WebM, AVI, WMV, TS, VOB and MPEG-2, with AC-3, E-AC-3, DTS, TrueHD, WMA and MP3 audio\n\n**Your videos never leave your home network. No ads, no analytics.**", "short_description": "Your own films on a big VR cinema screen, or in 3D, VR180 and 360. Stream from a Mac, PC or NAS over SMB or DLNA. Free trial. No ads, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2022787578433144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_4471821476424266_6336288614861947311_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlI8ifosFQ8Q7kNvwGX-WUS&_nc_oc=AdpqeFJ5Xp93CuHr837FvKD1oi9tI2ywV3oBaCaOMD818jb-xbWHD9Z2ppkK66ecBuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBio23b2wf9xSj6WfJ_faUiqRHxFZFh__oNe5VUstYxQ&oe=6ACBAACB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vision Player Pro: VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1787073120, "lastRevision": {"no
Fa__tYuAn4S-AHrKZynAOfHaDwIfJBbs22IVYLUw&oe=6A8C349E"}]}, "id": "1051232274470174", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.vrshell-20260725-135752.png", "id": "1395860449158078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_1395860452491411_1980459824889599129_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJImGjdshScQ7kNvwHujxJm&_nc_oc=AdqODrh6mdknzLhsTKGDx3CEXC4RPc0RMNN74k199tQuooHWjufAX7XhlMQAB8S9xV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQPK_6c3M2_dlkjMppl477R2SQo0T-E2f0bW7DTDjajA&oe=6A8C3456"}, {"file_name": "com.oculus.vrshell-20260725-135711.png", "id": "1021766860633370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1021766867300036_5602412938494363700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfUxL_U-tsIQ7kNvwHzMm_1&_nc_oc=Adohb5dxhdlrV-yiO_VA3f5tDV3nWpBI_8Xf7hBKT513CBCaFlG7-co30CqZ-MZaB6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMZfnad7jjMVOF_ks9_43d_n-T976RGD3H6FDEcYc82Q&oe=6A8C1837"}, {"file_name": "app.visionplayer-20260725-135620.png", "id": "1410824680932952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1410824690932951_643382391049603805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mG3GgizqqxMQ7kNvwGZGrlb&_nc_oc=AdqGUaO37ZqQ1MoRsy2K4KRI6nhqBqDXOX2AXANIMsSpngrnmkd0J6jK2YGc4vOOH_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIsspXmVw-IGoArf1xfc1EIHSNc4MwA2IZNUsF_znJ1w&oe=6A8C1923"}, {"file_name": "com.oculus.vrshell-20260725-135424.png", "id": "1537776878377527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1537776881710860_4585617118030407811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNSe3Rdf_akQ7kNvwFQPOI0&_nc_oc=AdqG3e2Z4gTV9Y3Auxco2GKOCsszxY25k0nT8trG_NDx75KozrTYSxwmrP9XWPqKypA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDGZAqo2U4jmLRZpxWGAvsvQfySd7s71zhvMnv7MZHbQ&oe=6A8C41A3"}, {"file_name": "app.visionplayer-20260725-135647.png", "id": "1489991453156830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1489991456490163_2799930074387900538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxjIlRP3A6UQ7kNvwH6T5on&_nc_oc=AdrJLcw8VwrSnMFT1ZNV25mbhNk8km1d25D3m8GMv8EgJxH0PkD4F6OZfbzv-YJrDio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtM8GmLLZY4ZvMoDaEuXHuUFze1DOMxOcv-tVwOrIspA&oe=6A8C1B85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro", "keywords": ["video", "movies", "cinema", "3D", "streaming"], "long_description": "Your movies. Your screen. Any size you want.\n\nVision Player Pro turns your Quest into the best seat in the house \u2014 a floating cinema screen in your room, or full 180\u00b0/360\u00b0 immersion. Play videos stored on your headset, or stream straight from any Mac, PC, or NAS on your Wi-Fi. No companion app, no conversion, no setup.\n\nSTREAM FROM ANY COMPUTER\nTurn on the file sharing built into macOS, Windows, or your NAS, and your computer appears automatically. Log in once, browse your drives \u2014 including external SSDs \u2014 and tap to play. Everything streams at full original quality with instant scrubbing.\n\nEVERY FORMAT, DETECTED FOR YOU\n2D, 3D side-by-side and over-under, VR180, 360\u00b0, and fisheye \u2014 the right projection and stereo layout are picked automatically from each file's name and metadata. Wrong guess on an oddball file? Override it once, per video, and it's remembered.\n\nA CINEMA THAT FITS YOUR ROOM\nWatch flat films on a huge curved screen \u2014 resize it, pull it closer \u2014 in a dark void or right in your own room via passthrough. Immersive videos wrap around you at up to 360\u00b0.\n\nBUILT FOR REAL LIBRARIES\nContinue Watching with resume, Favorites, Recents, audio and subtitle track selection, SRT subtitles with styling and sync, playback speed, and A-B loop. Fully usable with controllers or hands.\n\nYour files never leave your network. No accounts, no uploads, no tracking.\n\nSupports MP4, MKV, and WebM on Quest 2, Quest Pro, Quest 3, and Quest 3S.", "short_description": "Play your own movies in a private cinema. Stream from any Mac, PC, or NAS \u2014 no apps to install. 2D, 3D, 180\u00b0 & 360\u00b0 formats detected automatically."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1979272449451324"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_4471821476424266_6336288614861947311_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRB6CT1t-vgQ7kNvwFIorTa&_nc_oc=Adqp1gPYJ2_EmEJyBJrBpyTOMcQryF6krCDIq18MXwEYXCElk8n1fEY902vGOrGmC4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2yPMXZZ7NpPwfyuGu26VoIlfrP7CSUnTLlb30RprN4A&oe=6A8C2A8B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vision Player Pro", "platform": "ANDROID_6DOF", "
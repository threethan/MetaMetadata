e_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_931178213327598_7606578965337674055_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TFk9VXbo8gQ7kNvwF43yUP&_nc_oc=Adq9mjBQDO3UL90nm65khDHIto6MFLeB78x_MX83RYmkfIptqYP9V-2VyIjVPeJzV2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShaTcu7GB5YMUPFH4fKuU57zxE4dxjoDracnZHqyyxcw&oe=6AF1F05E"}]}, "id": "1051232274470174", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.vrshell-20260725-135752.png", "id": "1395860449158078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_1395860452491411_1980459824889599129_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrWZMEe3U_YQ7kNvwF9sbbu&_nc_oc=AdrSecnZyf_Uz6HUrak0ykwmpRZKNDl6sMHsm6tF8UeqM3ELD3CmqctBPTwEDWaHRJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFDbEq4fcFDFdCBikFfe_8bOVtgbZqq5vxx-Jq9h996w&oe=6AF1F016"}, {"file_name": "com.oculus.vrshell-20260725-135711.png", "id": "1021766860633370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1021766867300036_5602412938494363700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjYQWWyzJaIQ7kNvwGY1JGP&_nc_oc=AdrOmObT5EEbdgKUx4RT85t_o1_VcnCVQFtl6D4r0EgFA44qNxsCNhvsq4rr1D5GKxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuBRH9fYugJoykMu5xfku0CbpmN8lqbUW__5YFrNShbQ&oe=6AF1D3F7"}, {"file_name": "app.visionplayer-20260725-135620.png", "id": "1410824680932952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1410824690932951_643382391049603805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwpDgQalZgUQ7kNvwFdt0QJ&_nc_oc=AdpxJYAmqJ01mxdwowK54ujDb9LEwKZq1-XF5hLV4xPQZb1tOQ4zrk3lHxQNi6WrAMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJz4ygcg96ppcyTN0MqKfhcOf_ORNcfQ1SL6RPozf6Lg&oe=6AF1D4E3"}, {"file_name": "com.oculus.vrshell-20260725-135424.png", "id": "1537776878377527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1537776881710860_4585617118030407811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGLu1JctrkIQ7kNvwEvAXOr&_nc_oc=AdoUtFkq2i9fCs3L8bnrCq53S4_kRStKr9Ou-FWqD6XADCZ-nmT_1XZzvo1PLedItM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVBLC3ynI82MTmdsH58QXi6eE-1auetdEb0BrheJl8sQ&oe=6AF1FD63"}, {"file_name": "app.visionplayer-20260725-135647.png", "id": "1489991453156830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1489991456490163_2799930074387900538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXkbN9eMFFcQ7kNvwHF4BaS&_nc_oc=AdpZVGkE9tRwXEQK_5iFnA6QydwFDXRNCRK0E5x22dxiSvwqLps9aADu3vIE9oICAXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIgFROyUn2Z3Yax6QF0usZKa8nbvmvfzqOK0pSaLHu1w&oe=6AF1D745"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro", "keywords": ["video", "movies", "cinema", "3D", "streaming"], "long_description": "Your movies. Your screen. Any size you want.\n\nVision Player Pro turns your Quest into the best seat in the house \u2014 a floating cinema screen in your room, or full 180\u00b0/360\u00b0 immersion. Play videos stored on your headset, or stream straight from any Mac, PC, or NAS on your Wi-Fi. No companion app, no conversion, no setup.\n\nSTREAM FROM ANY COMPUTER\nTurn on the file sharing built into macOS, Windows, or your NAS, and your computer appears automatically. Log in once, browse your drives \u2014 including external SSDs \u2014 and tap to play. Everything streams at full original quality with instant scrubbing.\n\nEVERY FORMAT, DETECTED FOR YOU\n2D, 3D side-by-side and over-under, VR180, 360\u00b0, and fisheye \u2014 the right projection and stereo layout are picked automatically from each file's name and metadata. Wrong guess on an oddball file? Override it once, per video, and it's remembered.\n\nA CINEMA THAT FITS YOUR ROOM\nWatch flat films on a huge curved screen \u2014 resize it, pull it closer \u2014 in a dark void or right in your own room via passthrough. Immersive videos wrap around you at up to 360\u00b0.\n\nBUILT FOR REAL LIBRARIES\nContinue Watching with resume, Favorites, Recents, audio and subtitle track selection, SRT subtitles with styling and sync, playback speed, and A-B loop. Fully usable with controllers or hands.\n\nYour files never leave your network. No accounts, no uploads, no tracking.\n\nSupports MP4, MKV, and WebM on Quest 2, Quest Pro, Quest 3, and Quest 3S.", "short_description": "Play your own movies in a private cinema. Stream from any Mac, PC, or NAS \u2014 no apps to install. 2D, 3D, 180\u00b0 & 360\u00b0 formats detected automatically."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1979272449451324"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1762492441492482"}, {"status": "PUBLISHED", "id": "2013718312675137"}, {"status": "PUBLISHED", "id": "1949072299070203"}, {"status": "PUBLISHED", "id": "23522146
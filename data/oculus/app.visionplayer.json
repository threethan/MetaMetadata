901_1395860452491411_1980459824889599129_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrWZMEe3U_YQ7kNvwF9sbbu&_nc_oc=AdrSecnZyf_Uz6HUrak0ykwmpRZKNDl6sMHsm6tF8UeqM3ELD3CmqctBPTwEDWaHRJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFDbEq4fcFDFdCBikFfe_8bOVtgbZqq5vxx-Jq9h996w&oe=6AF1F016"}, {"file_name": "com.oculus.vrshell-20260725-135711.png", "id": "1021766860633370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1021766867300036_5602412938494363700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjYQWWyzJaIQ7kNvwGY1JGP&_nc_oc=AdrOmObT5EEbdgKUx4RT85t_o1_VcnCVQFtl6D4r0EgFA44qNxsCNhvsq4rr1D5GKxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuBRH9fYugJoykMu5xfku0CbpmN8lqbUW__5YFrNShbQ&oe=6AF1D3F7"}, {"file_name": "app.visionplayer-20260725-135620.png", "id": "1410824680932952", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1410824690932951_643382391049603805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwpDgQalZgUQ7kNvwFdt0QJ&_nc_oc=AdpxJYAmqJ01mxdwowK54ujDb9LEwKZq1-XF5hLV4xPQZb1tOQ4zrk3lHxQNi6WrAMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJz4ygcg96ppcyTN0MqKfhcOf_ORNcfQ1SL6RPozf6Lg&oe=6AF1D4E3"}, {"file_name": "com.oculus.vrshell-20260725-135424.png", "id": "1537776878377527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1537776881710860_4585617118030407811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGLu1JctrkIQ7kNvwEvAXOr&_nc_oc=AdoUtFkq2i9fCs3L8bnrCq53S4_kRStKr9Ou-FWqD6XADCZ-nmT_1XZzvo1PLedItM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVBLC3ynI82MTmdsH58QXi6eE-1auetdEb0BrheJl8sQ&oe=6AF1FD63"}, {"file_name": "app.visionplayer-20260725-135647.png", "id": "1489991453156830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1489991456490163_2799930074387900538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXkbN9eMFFcQ7kNvwHF4BaS&_nc_oc=AdpZVGkE9tRwXEQK_5iFnA6QydwFDXRNCRK0E5x22dxiSvwqLps9aADu3vIE9oICAXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIgFROyUn2Z3Yax6QF0usZKa8nbvmvfzqOK0pSaLHu1w&oe=6AF1D745"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro: VR Video Player", "keywords": ["SMB", "DLNA", "VR180", "cinema", "3D"], "long_description": "**Your films. Your screen. Any size you want.**\n\nPlay videos on your headset, or stream them from a Mac, PC or NAS on your Wi-Fi. No companion app, no converting, no account.\n\n**Free trial: up to 5 hours.**\n\n### Stream over SMB and DLNA\nMacs and many NAS drives appear on their own; add a Windows PC by name or IP. Sign in once, browse your shares (external drives too) and play at full quality.\n\n### Every format, detected for you\n2D, 3D side-by-side and over-under, VR180, 360, fisheye (190/200/220) and cubemap, recognized automatically. If a file fools it, fix it once in Format and it's remembered.\n\n### A cinema that fits your room\nA big flat screen in a dark void, or in your room with Passthrough on. Set its size, distance and angle; 180\u00b0 and 360\u00b0 wrap around you. Packed-alpha videos play cut out over your real room with AR passthrough.\n\n### Run it from one controller\n- Thumbstick left/right: skip; hold to go faster\n- Up/down: screen nearer or further\n- Grip + thumbstick: previous or next video\n- Click the stick: pause\n\nEither hand alone, or hand tracking.\n\n### Built for real libraries\n- Continue Watching, Most Watched and Favorites\n- Moved or renamed files keep their progress, favorite and format\n- Audio tracks, SRT/VTT subtitles with sync and size, speed, shuffle and loop\n- MP4, MOV, MKV, WebM, AVI, WMV, TS, VOB and MPEG-2, with AC-3, E-AC-3, DTS, TrueHD, WMA and MP3 audio\n\n**Your videos never leave your home network. No ads, no analytics.**", "short_description": "Your own films on a big VR cinema screen, or in 3D, VR180 and 360. Stream from a Mac, PC or NAS over SMB or DLNA. Free trial. No ads, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2022787578433144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_4471821476424266_6336288614861947311_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm2LmI7iUicQ7kNvwH5jy72&_nc_oc=AdokqulXQyw8eOb_NdxQNovMD_lsVJR6p72VkuoS2bA5sF8S_Z0B-8d3fncy2YmT4bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnfmqB_qnrN9Zo_Q-CmrWpNW3MGL8gHPKszvBIoK5EdA&oe=6AF1E64B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vision Player Pro: VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1787073120, "lastRevision": {"no
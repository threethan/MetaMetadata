araTJw4yeSp4R6aIdw&oe=6A8D6AA3"}, {"file_name": "com.oculus.vrshell-20260725-135424.png", "id": "1537776878377527", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823812_1537776881710860_4585617118030407811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNSe3Rdf_akQ7kNvwGOgZL3&_nc_oc=AdqiuB3u_6sw2GlC2cJGyqB4WAkRNJ5-FytY09ol9LuZn34srHMWeaZ8MDn2Vc7zi4M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkLB4tdscQbls0Wxa8GP6FcQfSTRcsAmDiOHiTEd4MbA&oe=6A8D9323"}, {"file_name": "app.visionplayer-20260725-135647.png", "id": "1489991453156830", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821796_1489991456490163_2799930074387900538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxjIlRP3A6UQ7kNvwEhMZUp&_nc_oc=Adq0WLxs40q0_K2hhg3WDxndOfyhB5pG0vMpIpgAcOcqzPBTGyl8WDf-2bAl4sOYmM0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAUVX3fTIzRNLT4jdwnqKaVh63cnzaPpS9mQdnpSGzrg&oe=6A8D6D05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro", "keywords": ["video", "movies", "cinema", "3D", "streaming"], "long_description": "Your movies. Your screen. Any size you want.\n\nVision Player Pro turns your Quest into the best seat in the house \u2014 a floating cinema screen in your room, or full 180\u00b0/360\u00b0 immersion. Play videos stored on your headset, or stream straight from any Mac, PC, or NAS on your Wi-Fi. No companion app, no conversion, no setup.\n\nSTREAM FROM ANY COMPUTER\nTurn on the file sharing built into macOS, Windows, or your NAS, and your computer appears automatically. Log in once, browse your drives \u2014 including external SSDs \u2014 and tap to play. Everything streams at full original quality with instant scrubbing.\n\nEVERY FORMAT, DETECTED FOR YOU\n2D, 3D side-by-side and over-under, VR180, 360\u00b0, and fisheye \u2014 the right projection and stereo layout are picked automatically from each file's name and metadata. Wrong guess on an oddball file? Override it once, per video, and it's remembered.\n\nA CINEMA THAT FITS YOUR ROOM\nWatch flat films on a huge curved screen \u2014 resize it, pull it closer \u2014 in a dark void or right in your own room via passthrough. Immersive videos wrap around you at up to 360\u00b0.\n\nBUILT FOR REAL LIBRARIES\nContinue Watching with resume, Favorites, Recents, audio and subtitle track selection, SRT subtitles with styling and sync, playback speed, and A-B loop. Fully usable with controllers or hands.\n\nYour files never leave your network. No accounts, no uploads, no tracking.\n\nSupports MP4, MKV, and WebM on Quest 2, Quest Pro, Quest 3, and Quest 3S.", "short_description": "Play your own movies in a private cinema. Stream from any Mac, PC, or NAS \u2014 no apps to install. 2D, 3D, 180\u00b0 & 360\u00b0 formats detected automatically."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1979272449451324"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBL
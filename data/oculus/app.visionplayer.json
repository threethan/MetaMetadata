le_name": "glasses-icon-full.png", "id": "931178206660932", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_931178213327598_7606578965337674055_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fzaz5Zym3Q0Q7kNvwGKai5Q&_nc_oc=AdoqvNC1qseqBPeTfcCVkgI4-HnmVHFhkXrHzsT-shECWdfnyrzVPx1Vg3DKe8pP6v4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTId6KWYndgBlEvIlaOiKrPQ2LMJMvkr0YwRb4lmnXs0A&oe=6B07085E"}]}, "id": "2106097573360861", "locale": "en_US", "screenshots": [{"file_name": "01-cinema.png", "id": "4733945183591629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_4733945186924962_8488560812572730001_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDSW16rKw7UQ7kNvwHDBfmF&_nc_oc=Adqu9KV1w7vOPEFUGmlPuXSFzw-B4BGg4Rqm5sg_YiKnZNdvy2nJRRO8VdnMRiTnhdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9YL0RnzmEPqeQMd--07IfmSFBDOwe6uz5ypQdYx__kQ&oe=6B06FE96"}, {"file_name": "02-360-milky-way.png", "id": "1561785372372347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1561785375705680_7576355555239804480_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeN9BWMq6QwQ7kNvwEEIIyT&_nc_oc=Adqeiv8i4YZpx7B3xUWCkEiMu33N50AB97knOq8XVUsE-BVJhVR3CZTlRNOAfJ5g8XE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkseVpteSKouJdKYnyFKOrU-LcarZl7KrrMPh2FwYRqA&oe=6B06FBA5"}, {"file_name": "04-library.png", "id": "2310571769733457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_2310571773066790_690910936065566739_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxqaTlpi_6kQ7kNvwFdhbP1&_nc_oc=AdoWRkN8RWMDn7ZiAtu8UmZ6cvHBmvFy0xNlwgusgivtjTYBtSiAHIZv6EQetezVeSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT54x2RaGDkvXfYr7P1EHQp-j4vIBfE6WrwBeIfEC-tEA&oe=6B06FDE0"}, {"file_name": "03-vr180-beach.png", "id": "1162398129559677", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1162398142893009_4223193281229024233_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVIzuEOpV1QQ7kNvwG6W_bg&_nc_oc=Adpgc5OpLYPiSNlWgVcHMUrVrqkd-oY2hZeW_bt7DPAkzIyjJv93KbIOgwj4wtmdzig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9pAxLPExFG7Ln65zqHflAEyNm4BRlh506QLiIdPPWqw&oe=6B06FA6C"}, {"file_name": "06-vr180-snow.png", "id": "1643215547545098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1643215550878431_3857944903864015628_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syqv5fFg2KEQ7kNvwFBZzUB&_nc_oc=AdqioYXSLa2J9GcWUNUHQjJvwsn23rmbG4wjGsdrGOBwkzv6Uwtw6E-4DKjEL8Fp7us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQzqOVBo_pT1fsQw6gdOQ9SIyhv5X1ocISz9ubKgyg3Q&oe=6B072192"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro: VR Video Player", "keywords": ["SMB", "DLNA", "VR180", "cinema", "3D"], "long_description": "**Your films. Your screen. Any size you want.**\n\nPlay videos on your headset, or stream them from a Mac, PC or NAS on your Wi-Fi. No companion app, no converting, no account.\n\n**Free trial: up to 5 hours.**\n\n### Stream over SMB and DLNA\nMacs and many NAS drives appear on their own; add a Windows PC by name or IP. Sign in once, browse your shares (external drives too) and play at full quality.\n\n### Every format, detected for you\n2D, 3D side-by-side and over-under, VR180, 360, fisheye (190/200/220) and cubemap, recognized automatically. If a file fools it, fix it once in Format and it's remembered.\n\n### A cinema that fits your room\nA big flat screen in a dark void, or in your room with Passthrough on. Set its size, distance and angle; 180\u00b0 and 360\u00b0 wrap around you. Packed-alpha videos play cut out over your real room with AR passthrough.\n\n### Run it from one controller\n- Thumbstick left/right: skip; hold to go faster\n- Up/down: screen nearer or further\n- Grip + thumbstick: previous or next video\n- Click the stick: pause\n\nEither hand alone, or hand tracking.\n\n### Built for real libraries\n- Continue Watching, Most Watched and Favorites\n- Moved or renamed files keep their progress, favorite and format\n- Audio tracks, SRT/VTT subtitles with sync and size, speed, shuffle and loop\n- MP4, MOV, MKV, WebM, AVI, WMV, TS, VOB and MPEG-2, with AC-3, E-AC-3, DTS, TrueHD, WMA and MP3 audio\n\n**Your videos never leave your home network. No ads, no analytics.**", "short_description": "Your own films on a big VR cinema screen, or in 3D, VR180 and 360. Stream from a Mac, PC or NAS over SMB or DLNA. Free trial. No ads, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2051227018922533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/49182546
e_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_931178213327598_7606578965337674055_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLW-c9s0z_0Q7kNvwFAd5ER&_nc_oc=AdqyO-6mvGgy5OHxr5lq7s4Ji1Dwjsvp9ssPKAg4tAvUHlQ7IxqyxVRJF92wVTOQ9QI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2GCHYQsyAUPFrbVsOWL0Gr5u2c3fhL0x-DGTbo6ag2A&oe=6ACBB4DE"}]}, "id": "1051232274470174", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.vrshell-20260725-135752.png", "id": "1395860449158078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1395860452491411_1980459824889599129_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BscA8uHAKTEQ7kNvwEH56uJ&_nc_oc=AdqvZpbHwairvC_Yv-qPoscwdXdrX1KORai5v9mJRQw7tYkQzv5M7L3u5wzyNsd-fZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOssMEE_hQz1GfpYtn7MColK6nHWzDbEUSo-kNrcbRutQ&oe=6ACBB496"}, {"file_name": "com.oculus.vrshell-20260725-135711.png", "id": "1021766860633370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1021766867300036_5602412938494363700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC6E2yErxA4Q7kNvwHEv87G&_nc_oc=AdoOsuyX343hgWet_ZhtERQpcuBGUln3VvPK2a0mjuzFmqBTxIIpR9Hq6YLrPjxPWAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5uN7LHraidcapOFisMC9OWxHddkWiA4pYuIIzP1OjkA&oe=6ACB9877"}, {"file_name": "app.visionplayer-20260725-135620.png", "id": "1410824680932952", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_1410824690932951_643382391049603805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uv5pssCX10IQ7kNvwHktSNx&_nc_oc=AdqkUujeSXvI8ZEBOD2BEvDUwCsssi-bh34xGw5Oz-wxLosjoLCsAhy28U5aRQmfDJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd3i-GFPLgZqrp-nvJavbS0K-NL3B3mUQszB9cYvMMVg&oe=6ACB9963"}, {"file_name": "com.oculus.vrshell-20260725-135424.png", "id": "1537776878377527", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_1537776881710860_4585617118030407811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmxnvDc5TooQ7kNvwHjQLNC&_nc_oc=AdrhNy2cP50VWBS9wRB1HbJHtd8zSi4RBIeVWyHtB_ok_7f4Lf1CQ9W34qlF81yT34Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYiVq2GH_fD0th2TA50BOWROimUTUiHahoBbpcJ830hA&oe=6ACBC1E3"}, {"file_name": "app.visionplayer-20260725-135647.png", "id": "1489991453156830", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1489991456490163_2799930074387900538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luv8UhNu-a4Q7kNvwH_7xtj&_nc_oc=AdqJFazSwCdiSfz5jfKzXEhAHRvAFKpYQl0FaAqvfBiizda7mZlA-pZhHmX3txThn3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRQ0md-an0a6QCHov3hG_v5B2FWHOGqpFaEFXt2eoizA&oe=6ACB9BC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro", "keywords": ["video", "movies", "cinema", "3D", "streaming"], "long_description": "Your movies. Your screen. Any size you want.\n\nVision Player Pro turns your Quest into the best seat in the house \u2014 a floating cinema screen in your room, or full 180\u00b0/360\u00b0 immersion. Play videos stored on your headset, or stream straight from any Mac, PC, or NAS on your Wi-Fi. No companion app, no conversion, no setup.\n\nSTREAM FROM ANY COMPUTER\nTurn on the file sharing built into macOS, Windows, or your NAS, and your computer appears automatically. Log in once, browse your drives \u2014 including external SSDs \u2014 and tap to play. Everything streams at full original quality with instant scrubbing.\n\nEVERY FORMAT, DETECTED FOR YOU\n2D, 3D side-by-side and over-under, VR180, 360\u00b0, and fisheye \u2014 the right projection and stereo layout are picked automatically from each file's name and metadata. Wrong guess on an oddball file? Override it once, per video, and it's remembered.\n\nA CINEMA THAT FITS YOUR ROOM\nWatch flat films on a huge curved screen \u2014 resize it, pull it closer \u2014 in a dark void or right in your own room via passthrough. Immersive videos wrap around you at up to 360\u00b0.\n\nBUILT FOR REAL LIBRARIES\nContinue Watching with resume, Favorites, Recents, audio and subtitle track selection, SRT subtitles with styling and sync, playback speed, and A-B loop. Fully usable with controllers or hands.\n\nYour files never leave your network. No accounts, no uploads, no tracking.\n\nSupports MP4, MKV, and WebM on Quest 2, Quest Pro, Quest 3, and Quest 3S.", "short_description": "Play your own movies in a private cinema. Stream from any Mac, PC, or NAS \u2014 no apps to install. 2D, 3D, 180\u00b0 & 360\u00b0 formats detected automatically."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1979272449451324"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2013718312675137"}, {"status": "PUBLISHED", "id": "1949072299070203"}, {"status": "PUBLISHED", "id": "2352214678854015"}, {"status": "PUBLISHED", "id": "10340686
901_1395860452491411_1980459824889599129_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu9EAWolloIQ7kNvwFyk8Ho&_nc_oc=Adrr6dVVWyhLESAtPcJgvHlIhKIJhhRE3sRxjuyLZY40P9XzcR7I8drFHlddmmZD1co&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDRO_aj7zIejYT62DbMBlOGwGCcURumrHIdigxktLNhQ&oe=6A9D57D6"}, {"file_name": "com.oculus.vrshell-20260725-135711.png", "id": "1021766860633370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1021766867300036_5602412938494363700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6resE7fZfwQ7kNvwE0Th2a&_nc_oc=Adppi4xiRyTHKbaf7AQNjlNHXjXzCjP1XQ9W2qS-YVAzpDWUOvnkFJRlfxH0esbxBes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJpt96p_c9I41HjgekJZVXwvSEWu09D-6OOwu-VATKEw&oe=6A9D73F7"}, {"file_name": "app.visionplayer-20260725-135620.png", "id": "1410824680932952", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823812_1410824690932951_643382391049603805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qABtGvVPDoQQ7kNvwFQBWN7&_nc_oc=AdqIh_V33TtDfC-E4amzVeoYPkZEqedfsLXqC4aCZdC-d8osm4u2sA0aH1WRbUgfgHo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKragcSoz25eWeqK1meKb5k4PZCh8jBoOoaeWLiCGytVg&oe=6A9D74E3"}, {"file_name": "com.oculus.vrshell-20260725-135424.png", "id": "1537776878377527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_1537776881710860_4585617118030407811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU9a-JRomsQQ7kNvwHKiRRj&_nc_oc=AdoDj560T2bCmK3JQVFicFvI0CWM1HtnWG7zGXViXasIdDGOsv59o1zhWPPFHRCLklo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoCwWvS6HNZ-Ez8F31uN2DW_zJ6BjQ1Xsriq4lGnxcww&oe=6A9D6523"}, {"file_name": "app.visionplayer-20260725-135647.png", "id": "1489991453156830", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_1489991456490163_2799930074387900538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxbr5kRc_R0Q7kNvwGiOjXn&_nc_oc=Adpm-r_3GeP45RLVasWoDjbwE9N4J3cyaeaxAGTBYfmMbd9DX_eeQQJHDzTrcE7E5xY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMD_qrZYuofZ_I-Je17JnGt5W_jCGAPtCXtx0NtuOMPA&oe=6A9D7745"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro: VR Video Player", "keywords": ["SMB", "DLNA", "VR180", "cinema", "3D"], "long_description": "Your films. Your screen. Any size you want.\n\nPlay what is on your headset, or stream from any Mac, PC or NAS on your Wi-Fi. No companion app, no conversion, no account.\n\nSTREAM OVER SMB AND DLNA\nTurn on the file sharing built into macOS, Windows or your NAS and it appears by itself. Log in once, browse your drives - external SSDs included - and play. Full quality, instant scrubbing.\n\nEVERY FORMAT, DETECTED FOR YOU\n2D, 3D side-by-side and over-under, VR180, 360, fisheye (190/200/220), cubemap and MV-HEVC spatial video. Projection and stereo layout are picked automatically; an override sticks to that file.\n\nAR PASSTHROUGH\nPacked-alpha releases play cut out over your real room - the performer is on your floor, not on a screen. Toggle it from the transport bar.\n\nA CINEMA THAT FITS YOUR ROOM\nWatch flat films on a huge  screen in a dark void, or turn Passthrough on to keep your room around it. Resize, roll and move it. Immersive video wraps you up to 360.\n\nRUN IT FROM ONE CONTROLLER\nThumbstick left/right scrubs; up/down pushes the screen nearer or further. Grip plus thumbstick jumps to the previous or next film. Click the stick to pause. Either hand alone, or bare hands.\n\nBUILT FOR REAL LIBRARIES\nContinue Watching, Favourites, Recents, audio and subtitle tracks, styled SRT with sync, speed, A-B loop. Plays MP4, MKV, MOV, WebM, AVI, WMV, TS, M2TS, MPEG and VOB, with Dolby, DTS, TrueHD and WMA audio.\n\nYour files never leave your network. No accounts, no uploads, no tracking.", "short_description": "Play your own films on a huge cinema screen or in full VR180/360. Stream from any Mac, PC or NAS over SMB and DLNA. No account, no uploads, no tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1985572772154625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_4471821476424266_6336288614861947311_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pynq-FP_8uoQ7kNvwGgD1xb&_nc_oc=AdqPgZ_8rxQaYfk77Xcn7ehxJY2Cjx08jJk-XDGUadkkMCtxgN_Qsb-3B2M4VIomr4A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi51rHDbkdM6I0jFjWmPvYLeI_16lHJTxm1RshwFb1Ug&oe=6A9D864B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vision Player Pro: VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1787073120, "last
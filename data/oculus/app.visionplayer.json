n.com&_nc_ss=7f20f&oh=00_AQS9vyiCyXkvdFUwnFy58pDTRdHTQmAhtVk2BcTJu6fSeQ&oe=6B084F60"}, {"file_name": "03-vr180-beach.png", "id": "1162398129559677", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825305_1162398142893009_4223193281229024233_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVIzuEOpV1QQ7kNvwG2jSD-&_nc_oc=Adr3iNe6R91uEARivlPqzeZHuvfyv8yzed-cMBH5oWwXRg3O73CLVKQE-JX2ust10PY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThDB3nc7urd786ea7S7TkBFHRGHcNZpcXMv_DVesKJEw&oe=6B084BEC"}, {"file_name": "06-vr180-snow.png", "id": "1643215547545098", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824307_1643215550878431_3857944903864015628_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syqv5fFg2KEQ7kNvwFcu6l5&_nc_oc=Adq4hHzOz8QxoiDEdoxta5y1NUDu1kaGrPxGHRxrgBgNsJXBjNSTU1zG-SOEzhYJVLM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBpMoDsZPIZhy2JG3qFaKIjwVUpz43i7t7rV8TX8iKJg&oe=6B087312"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Player Pro: VR Video Player", "keywords": ["SMB", "DLNA", "VR180", "cinema", "3D"], "long_description": "**Your films. Your screen. Any size you want.**\n\nPlay videos on your headset, or stream them from a Mac, PC or NAS on your Wi-Fi. No companion app, no converting, no account.\n\n**Free trial: up to 5 hours.**\n\n### Stream over SMB and DLNA\nMacs and many NAS drives appear on their own; add a Windows PC by name or IP. Sign in once, browse your shares (external drives too) and play at full quality.\n\n### Every format, detected for you\n2D, 3D side-by-side and over-under, VR180, 360, fisheye (190/200/220) and cubemap, recognized automatically. If a file fools it, fix it once in Format and it's remembered.\n\n### A cinema that fits your room\nA big flat screen in a dark void, or in your room with Passthrough on. Set its size, distance and angle; 180\u00b0 and 360\u00b0 wrap around you. Packed-alpha videos play cut out over your real room with AR passthrough.\n\n### Run it from one controller\n- Thumbstick left/right: skip; hold to go faster\n- Up/down: screen nearer or further\n- Grip + thumbstick: previous or next video\n- Click the stick: pause\n\nEither hand alone, or hand tracking.\n\n### Built for real libraries\n- Continue Watching, Most Watched and Favorites\n- Moved or renamed files keep their progress, favorite and format\n- Audio tracks, SRT/VTT subtitles with sync and size, speed, shuffle and loop\n- MP4, MOV, MKV, WebM, AVI, WMV, TS, VOB and MPEG-2, with AC-3, E-AC-3, DTS, TrueHD, WMA and MP3 audio\n\n**Your videos never leave your home network. No ads, no analytics.**", "short_description": "Your own films on a big VR cinema screen, or in 3D, VR180 and 360. Stream from a Mac, PC or NAS over SMB or DLNA. Free trial. No ads, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/VisionPlayer/blob/main/Android/SUPPORT.md", "website_url": "https://github.com/Meshy-SC/VisionPlayer/tree/main/Android", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "205122701892
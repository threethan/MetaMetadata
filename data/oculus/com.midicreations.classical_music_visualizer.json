42_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zk7UEYaGHNkQ7kNvwHFOLek&_nc_oc=AdpayA9thHJ-bAe784zoEJ3DvhHrUecxc967bjkZHRQaVw9owo49dcsP4cVP6_zEQ8k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XgFqFAEXC7C3rPZue3tegROkR42nebVqX24O3VF48SQ&oe=69E8B5E4"}, {"file_name": "Screenshot 2025-07-29 093220.png", "id": "1548287999483350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308575_1548288002816683_525555552900238122_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeIspA4ULV0Q7kNvwEm-afA&_nc_oc=Adqv8fdlxeS90zVE6kLPzEndfkhR1ELc-QeNFXFmQrrba4acLRe2CCsH6L4D59B8RUQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VR4a4hrKI_6ZPFlq3hkQ1mcLX2HY8tg_gc9JmbMCPpQ&oe=69E8B9BF"}, {"file_name": "Screenshot 2025-07-29 092126.png", "id": "1269052654920894", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_1269052658254227_6375524367941614664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cA-YhSq2KgQ7kNvwEFz10T&_nc_oc=Ado-ahUq0IyatNyvFdcyh5Jqvx3KYSRCqhkj6VomSJrP5_vyhhgfnxC8GN1jDsgoQkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a8SMl-RMctSFKO2n0DUxly5skUKD8LIqX46mRje71uw&oe=69E8B9B7"}, {"file_name": "Screenshot 2025-07-29 092048.png", "id": "612019864937748", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819396_612019868271081_3858475702049769363_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7Lab9sDOI0Q7kNvwGqbH8B&_nc_oc=AdqfbDxqiS3G88A6a74KwbMbW6Lgt4fMs1ZJUNm75KUZhhUWW3GR_QqdbHCHtV0O3DE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32zrpp32J1HSZaVKuZ0DNZdEEMioDEptGgvWBFDX99EQ&oe=69E8BFB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "721671690843673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821178_721671694177006_8211975588233095971_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XGPzIh7jpYQ7kNvwGuRjNk&_nc_oc=Adoknu6XcUnUDRasnSf1srCJ30m7GRROJodLmUsZ7Kprgjuh2xXLRXdJ_AQ-bfGw7Ns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3szMWzPSfbj5fq1m30Rtw93mGwvYEucWGjuqGvH8c6RQ&oe=69E8DDBC"}, "display_name": "Classical Music Visualizer", "keywords": ["Classical", "Music", "Visualizer", "Player", "Classic"], "long_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively.\n\nHere some of the compositions included:\n\n\"1. Tchaikovsky - 1812 Overture\",\n\"2. Tomaso Albinoni - Adagio in G Minor\",\n\"3. Johann Sebastian Bach - Air on G String\",\n\"4. F. W. Meacham - American Patrol\",\n\"5. Johann Sebastian Bach - Badinerie\",\n\"6. Offenbach - Can Can\",\n\"7. Pachelbel - Canon In D Major\",\n\"8. Niccol\u00f2 Paganini - Caprice 24\",\n\"9. Johann Sebastian Bach - Cello Suite No. 1\",\n\"10. Tchaikovsky - Dance of the Sugar Plum Fairy\",\n\"11. Mozart - Dies irae\",\n\"12. Mozart - Eine Kleine Nachtmusik\",\n\"13. Scott Joplin - The Entertainer\",\n\"14. Julius Fucik - Entry of the Gladiators\",\n\"15. Chopin - Fantaisie-Impromptu\",\n\"16. Georges Bizet - Farandole\",\n\"17. Chopin - Marche Fun\u00e8bre\",\n\"18. Beethoven - F\u00fcr Elise\",\n\"19. Erik Satie - Gnossienne No. 1\",\n\"20. Erik Satie - Gymnop\u00e9die No. 1\",\n\"21. Georges Bizet - Habanera\",\n\"22. H\u00e4ndel Messiah - Hallelujah\",\n\"23. Patty and Mildred J. Hill - Happy Birthday to You\",\n\"24. Mozart - Horn Concerto No. 4\",\n\"25. Johannes Brahms - Hungarian Dance No.5\",\n.... and more", "short_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.
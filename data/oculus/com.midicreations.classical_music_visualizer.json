f&oh=00_AQLeHd5KmKsiqmGmo0Z5uMzDh1jAZ4xeM8g0uV7dTBrgDw&oe=6AA29D37"}, {"file_name": "Screenshot 2025-07-29 092048.png", "id": "612019864937748", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819396_612019868271081_3858475702049769363_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgafJz6t2vUQ7kNvwGb9jy8&_nc_oc=AdqFZrP-CE0bghmnoJnRJDkjeQOf6mo8MzaintD1uj5cowT4nl-WzJqbUJwiroCUT7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbuNydRNsSX16WUoT2fJmmrw1LtlwDCMS_YzqkpXw3TA&oe=6AA2A335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "721671690843673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_721671694177006_8211975588233095971_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=834Y6MKv6UsQ7kNvwFdKHfp&_nc_oc=AdoQ_enfvrIzPTa97mn6dpZ3JkRQ2WjveXo-e43gQKT4zCILsAB-mZ5g3fWZKD4fsxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM4AO-YxkEV9818_ZXsuSp87q1KdOQwK-9HuaIRL8DAg&oe=6AA2C13C"}, "display_name": "Classical Music Visualizer", "keywords": ["Classical", "Music", "Visualizer", "Player", "Classic"], "long_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively.\n\nHere some of the compositions included:\n\n\"1. Tchaikovsky - 1812 Overture\",\n\"2. Tomaso Albinoni - Adagio in G Minor\",\n\"3. Johann Sebastian Bach - Air on G String\",\n\"4. F. W. Meacham - American Patrol\",\n\"5. Johann Sebastian Bach - Badinerie\",\n\"6. Offenbach - Can Can\",\n\"7. Pachelbel - Canon In D Major\",\n\"8. Niccol\u00f2 Paganini - Caprice 24\",\n\"9. Johann Sebastian Bach - Cello Suite No. 1\",\n\"10. Tchaikovsky - Dance of the Sugar Plum Fairy\",\n\"11. Mozart - Dies irae\",\n\"12. Mozart - Eine Kleine Nachtmusik\",\n\"13. Scott Joplin - The Entertainer\",\n\"14. Julius 
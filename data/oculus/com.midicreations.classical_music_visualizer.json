apbqX9UHmA&oe=69D39DE4"}, {"file_name": "Screenshot 2025-07-29 093220.png", "id": "1548287999483350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308575_1548288002816683_525555552900238122_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xk_r01QMskQ7kNvwHJCWRU&_nc_oc=AdqUFUXPwTmdM10FcEaqeO7pQDfacjM4psqcaI1UUuBhpQsuh1c5uuhRtIIxx2ybEsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LOGjD5bT340sNojOGJ4VDM8Lb5bFKdoP0MTpDMchkHw&oe=69D3A1BF"}, {"file_name": "Screenshot 2025-07-29 092126.png", "id": "1269052654920894", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819934_1269052658254227_6375524367941614664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVBWoZZ3NLgQ7kNvwHKs3Pl&_nc_oc=Ado2GWFlpqGNE3vs_iI-Z17KhJ937eL6xHOR3VMbc0whrRPI-MUagp_kGqNANp6WwTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h8-i9n4Wl5SgJtHMsXh1OEF23CTsK7EQc43qG3OZxgA&oe=69D3A1B7"}, {"file_name": "Screenshot 2025-07-29 092048.png", "id": "612019864937748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_612019868271081_3858475702049769363_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySdxLEpXDDQQ7kNvwFIID9V&_nc_oc=AdqBY_y3O78o9Nl6VPL3fSzsQnNSQD3Nlw6dm6vW9ZjzA-k8cAutXUTVIvOVXuKdSds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SfDCYIM13UtMj02cu2naCB0vmfZ2PqNfrXUOPBbMKag&oe=69D3A7B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "721671690843673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821178_721671694177006_8211975588233095971_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blSuMDkjLXoQ7kNvwEOfpsa&_nc_oc=AdpV6SA_2f4p_GMzDgwkYBv1zsf8xIQblhOSBNM1lXekEq72BgT_IpncbeeGgYzWF50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fObHjA1HFrBtYFKsHsvD5Pb8OB5OycAVI87nh_PiSYg&oe=69D3C5BC"}, "display_name": "Classical Music Visualizer", "keywords": ["Classical", "Music", "Visualizer", "Player", "Classic"], "long_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively.\n\nHere some of the compositions included:\n\n\"1. Tchaikovsky - 1812 Overture\",\n\"2. Tomaso Albinoni - Adagio in G Minor\",\n\"3. Johann Sebastian Bach - Air on G String\",\n\"4. F. W. Meacham - American Patrol\",\n\"5. Johann Sebastian Bach - Badinerie\",\n\"6. Offenbach - Can Can\",\n\"7. Pachelbel - Canon In D Major\",\n\"8. Niccol\u00f2 Paganini - Caprice 24\",\n\"9. Johann Sebastian Bach - Cello Suite No. 1\",\n\"10. Tchaikovsky - Dance of the Sugar Plum Fairy\",\n\"11. Mozart - Dies irae\",\n\"12. Mozart - Eine Kleine Nachtmusik\",\n\"13. Scott Joplin - The Entertainer\",\n\"14. Julius Fucik - Entry of the Gladiators\",\n\"15. Chopin - Fantaisie-Impromptu\",\n\"16. Georges Bizet - Farandole\",\n\"17. Chopin - Marche Fun\u00e8bre\",\n\"18. Beethoven - F\u00fcr Elise\",\n\"19. Erik Satie - Gnossienne No. 1\",\n\"20. Erik Satie - Gymnop\u00e9die No. 1\",\n\"21. Georges Bizet - Habanera\",\n\"22. H\u00e4ndel Messiah - Hallelujah\",\n\"23. Patty and Mildred J. Hill - Happy Birthday to You\",\n\"24. Mozart - Horn Concerto No. 4\",\n\"25. Johannes Brahms - Hungarian Dance No.5\",\n.... and more", "short_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.htm
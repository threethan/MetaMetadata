5_1548288002816683_525555552900238122_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7rHvmHm1OkQ7kNvwEULoSm&_nc_oc=Ado1tQ-TLHatb7Qe_WhF-BeU2A4OdmwZykJ9MJBZJwIDXs54bliXEldk0bG857sPlTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YsxkbS7jXO9_yr2JlVwJdrfhNuw2lN2y4xh_bDW7SOQ&oe=69DF7F3F"}, {"file_name": "Screenshot 2025-07-29 092126.png", "id": "1269052654920894", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819934_1269052658254227_6375524367941614664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuSIdg9yxuUQ7kNvwHOSj1i&_nc_oc=Adq_fJdd8HisNOM2Y9IegmCxu-hGiZjxKLAUFSvWWdnk3vSsnZeNi9JGGthgGpzaN6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o3NGg-DZJaxtD46diyfDvIbUGUrG-Lt8-wak3Ko7pTw&oe=69DF7F37"}, {"file_name": "Screenshot 2025-07-29 092048.png", "id": "612019864937748", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_612019868271081_3858475702049769363_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD0Qpdh7TdYQ7kNvwGZUeCb&_nc_oc=Adryvam0ZTsdmu7i-CSjDQnOgXr8vdEj63EfHazD2r4yF-nkiAbpR0zfAVPbhDuDD1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-tWJ8jer7JoVPvhyGK37q_UIzdWWAIdTz2gzgutxaUQ&oe=69DF8535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "721671690843673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821178_721671694177006_8211975588233095971_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9k8ZZg-d8yIQ7kNvwFRkGZU&_nc_oc=Adr_kw8rwGy4ESr0dK5eywnyBp2HPylySfOZEp7MiJkP7WoZqVqgz_yZpnH-yT71RnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0anfTLypLMppiY_o4vTh5UjkR64uA2yPPXKpzyd1owqw&oe=69DFA33C"}, "display_name": "Classical Music Visualizer", "keywords": ["Classical", "Music", "Visualizer", "Player", "Classic"], "long_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively.\n\nHere some of the compositions included:\n\n\"1. Tchaikovsky - 1812 Overture\",\n\"2. Tomaso Albinoni - Adagio in G Minor\",\n\"3. Johann Sebastian Bach - Air on G String\",\n\"4. F. W. Meacham - American Patrol\",\n\"5. Johann Sebastian Bach - Badinerie\",\n\"6. Offenbach - Can Can\",\n\"7. Pachelbel - Canon In D Major\",\n\"8. Niccol\u00f2 Paganini - Caprice 24\",\n\"9. Johann Sebastian Bach - Cello Suite No. 1\",\n\"10. Tchaikovsky - Dance of the Sugar Plum Fairy\",\n\"11. Mozart - Dies irae\",\n\"12. Mozart - Eine Kleine Nachtmusik\",\n\"13. Scott Joplin - The Entertainer\",\n\"14. Julius Fucik - Entry of the Gladiators\",\n\"15. Chopin - Fantaisie-Impromptu\",\n\"16. Georges Bizet - Farandole\",\n\"17. Chopin - Marche Fun\u00e8bre\",\n\"18. Beethoven - F\u00fcr Elise\",\n\"19. Erik Satie - Gnossienne No. 1\",\n\"20. Erik Satie - Gymnop\u00e9die No. 1\",\n\"21. Georges Bizet - Habanera\",\n\"22. H\u00e4ndel Messiah - Hallelujah\",\n\"23. Patty and Mildred J. Hill - Happy Birthday to You\",\n\"24. Mozart - Horn Concerto No. 4\",\n\"25. Johannes Brahms - Hungarian Dance No.5\",\n.... and more", "short_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
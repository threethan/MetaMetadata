_1022933810045552_4505843216576322642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iL4q0QzxekQ7kNvwE3Gdzn&_nc_oc=AdrNr3uwhbC34IlExVomYgRGv88wiTJZ7m3Lg6c8ugHN5npJqFV7l5lsxVeXLMuW0h8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1u3Wyhc5nAATN-KfawLN3FplYX8E-5-iCa2r6nupLHbA&oe=69F09EE4"}, {"file_name": "Screenshot 2025-07-29 093220.png", "id": "1548287999483350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308575_1548288002816683_525555552900238122_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E27AgKKa-m8Q7kNvwFG9qOt&_nc_oc=Adq4nkYUwNYthoMnQIq89gd6wA0u6gsW9Aibq0W2LVswrWFVVH1XiIf2NX454_KbvGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2zybL-A-im6VN2xfkBHUfN6c59MGWh7kGX8bMMqWI1Jw&oe=69F0A2BF"}, {"file_name": "Screenshot 2025-07-29 092126.png", "id": "1269052654920894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_1269052658254227_6375524367941614664_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXkgwd0WFP8Q7kNvwFZsB77&_nc_oc=AdqKKifKRpLU-ITTElIYQCPsotUP1OtSp_2SWBGh2-QdQ1MMkIhqz0y9F0UOoxLGYls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0IlLlpQwtt10aCaFY_bTqOV-2sG7dDgsb1Fhq02MOalw&oe=69F0A2B7"}, {"file_name": "Screenshot 2025-07-29 092048.png", "id": "612019864937748", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819396_612019868271081_3858475702049769363_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVeIQ4UftxcQ7kNvwHf5NF4&_nc_oc=AdpciHqae0qr7XRj60AHH9KN4cxKD0rJj6YRZ0J0FqzXq7DixewJdFRUrA_iOJ_Ui_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3bs61dpHrhNVw20Uxk30z6WS0zzFWcy5-5D8MCJCvwvg&oe=69F0A8B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "721671690843673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_721671694177006_8211975588233095971_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RGlmc9fpYMQ7kNvwGy_0tq&_nc_oc=AdoKUK_uYtoMP8YKmzmvboIGRIqCvpsW98CbmwlG0ue5Sq939ALtO3ECIAge_yKpGxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3keNhrRXMirmrdNbCil4joYh04EVgqAxRCWtuabV2fCQ&oe=69F0C6BC"}, "display_name": "Classical Music Visualizer", "keywords": ["Classical", "Music", "Visualizer", "Player", "Classic"], "long_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively.\n\nHere some of the compositions included:\n\n\"1. Tchaikovsky - 1812 Overture\",\n\"2. Tomaso Albinoni - Adagio in G Minor\",\n\"3. Johann Sebastian Bach - Air on G String\",\n\"4. F. W. Meacham - American Patrol\",\n\"5. Johann Sebastian Bach - Badinerie\",\n\"6. Offenbach - Can Can\",\n\"7. Pachelbel - Canon In D Major\",\n\"8. Niccol\u00f2 Paganini - Caprice 24\",\n\"9. Johann Sebastian Bach - Cello Suite No. 1\",\n\"10. Tchaikovsky - Dance of the Sugar Plum Fairy\",\n\"11. Mozart - Dies irae\",\n\"12. Mozart - Eine Kleine Nachtmusik\",\n\"13. Scott Joplin - The Entertainer\",\n\"14. Julius Fucik - Entry of the Gladiators\",\n\"15. Chopin - Fantaisie-Impromptu\",\n\"16. Georges Bizet - Farandole\",\n\"17. Chopin - Marche Fun\u00e8bre\",\n\"18. Beethoven - F\u00fcr Elise\",\n\"19. Erik Satie - Gnossienne No. 1\",\n\"20. Erik Satie - Gymnop\u00e9die No. 1\",\n\"21. Georges Bizet - Habanera\",\n\"22. H\u00e4ndel Messiah - Hallelujah\",\n\"23. Patty and Mildred J. Hill - Happy Birthday to You\",\n\"24. Mozart - Horn Concerto No. 4\",\n\"25. Johannes Brahms - Hungarian Dance No.5\",\n.... and more", "short_description": "Classical Music Visualizer is a VR experience that let you watch elegant virtual animations while you listen to electronic music versions of classical music compositions, 67 original remixes included, the scenario change the color progressively."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-a
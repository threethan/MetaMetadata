s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wj69fDGZFm0Q7kNvwGVUd1z&_nc_oc=AdqWqTZypR_nJ5JrJtGfoKo1FKkcpZucyArCk9Rpl0zIvU8ZV6JsRXkAXHveJxVKOns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS85T2KcQkY63W7xjV2AshXbg7FXPKYwbB9qMs-9TBZqw&oe=6B04778C"}, {"file_name": "04_Flexer_Action_2560x1440.png", "id": "2184872072072152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831299_2184872075405485_4008272742366392584_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peEBPVU31pgQ7kNvwHnn1uL&_nc_oc=AdorfW0k6vczF4ZSTdHa1ajfvpWN5uIPR1IEl2T6g1s_gtpsaH-RKU-rX6DT5qc-9A4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQbOJvnHNXi6oO-CnY3pk7ofD79qAHSQtMYjyO43H4ZQ&oe=6B046893"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Punchable Face", "keywords": ["boxing", "punching", "arcade", "stress", "fitness"], "long_description": "Sometimes you just want to punch a face.\n\n**Punchable Face** is a simple VR stress toy built around one idea: choose an irritating character, step into their world, and go to town.\n\n## Choose Your Face\n\n### The Barker\nA grinning carnival loudmouth waiting for you under the lights.\n\n### The Flexer\nA smug car-meet regular surrounded by modified cars and nighttime parking-lot lights.\n\n## Hit Harder\n\nEvery valid punch is measured using your controller speed and converted into an **Impact Score from 100 to 999**.\n\nChase your Session Best and watch each character react with movement, haptics, impact audio, facial reactions, and accumulating redness that slowly fades when you stop.\n\n## Features\n\n- Two characters with unique environments\n- Physics-based punch detection\n- Impact Score and Session Best\n- Hand-specific haptics\n- Reactive faces and visual feedback\n- Standing or seated play\n- No locomotion, rounds, health bars, or complicated progression\n\n**Pick a face. Punch it.**", "short_description": "Pick an annoying face, put on your gloves, and start swinging. Punchable Face is a simple VR stress toy with satisfying impacts, haptics, scoring, and two ridiculous characters to pummel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stormxr.tech/privacy-policy/punchable-face", "developer_terms_of_service_url": null, "publisher_name": "StormXR LLC", "support_website_url": "https://www.stormxr.tech/contact", "website_url": "https://www.stormxr.tech/development", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1484557043510984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_988904794217909_8806368317790782196_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rU6i8GdhH20Q7kNvwG46plO&_nc_oc=AdovcZXEdJJSR2zjtKJNn3KtiKsrhQOzWvo73J-lC260yM6X4qwX4VzGNcALQFp7nEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGttOeAiHZVDvxEzFccwMrfoHgPLjznE0ADycthClbIQ&oe=6B04672D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Punchable Face", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game"
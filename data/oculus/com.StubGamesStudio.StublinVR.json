_oc=Adq9o_NoSL-2FJ0GYX9tpZqTypwmF2mkHWRbKBQSAq5r6Wu0Ad4YQTQTzSe4lrlSOyo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDPb9tvU3ahp3Imn-T5xYhJf_hgMRmkTmK9uxNNOFh4g&oe=6AA17869"}, "display_name": "Stub-linVR", "keywords": [], "long_description": "Stub-linVR is a gorilla tag fan game I made so people can hang out with there friends, the game has loads of activities you can do such as buy cosmetics with the in-game currency (Stubs) and run around a forest jumping to tree to tree. +more.\n", "short_description": "Stub-linVR is a Gorilla Tag fan game where you hang out with friends, earn Stubs, buy cosmetics, and explore a forest full of movement and fun."}]}, "developer_name": "StubGamesStudio", "developer_privacy_policy_url": "https://sites.google.com/view/stub-linvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "StubGamesStudio", "support_website_url": "https://sites.google.com/view/stub-linvr/main", "website_url": "https://sites.google.com/view/stub-linvr/main", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35270733979191575"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1225911982242468"}]}, "baseline_offer": {"id": "1225911982242468"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775430000, "status": "PUBLISHED", "id": "1225911982242468"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38183924491205828", "version": "2.3"}, "id": "1918434545734263", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33366639516267707", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38183924491205828"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1918434545734263"}]}, "change_log": "\ufffd STUB-LINVR \u2014 UPDATE 2.3\nTHE HORROR EXPANSION\n\nThe horror gets worse.\n\nStub-linVR 2.3 is here, bringing an upgraded horror experience, a brand-new tree, and several annoying bugs finally fixed.\n\n\ufffd UPGRADED HORROR\n\nThe horror experience has been improved and upgraded.\n\nWe've made changes to make the horror side of Stub-linVR feel more intense, creepy, and polished.\n\nThis is only the beginning of what we have planned for the horror experience...\n\n\ufffd NEW TREE\n\nA brand-new tree has been added to Stub-linVR!\n\nA small addition, but one that helps bring more life and detail to the environment.\n\n\ufffd BUG FIXES\n\nWe've fixed several bugs in this update, including:\n\nFixed tree-related bugs\nFixed wall bugs\nImproved overall stability\nVarious small fixes and improvements\n\ufffd WHAT'S NEXT?\n\nWe're continuing to work on Stub-linVR and have more updates planned.\n\nThe horror is only getting started.\n\nThank you for playing and supporting Stub-linVR!\n\n\u2014 Mr Tay & the Stub-linVR Team\n\n\ufffd STUB-LINVR 2.3\n\nTHE HORROR CONTINUES.", "created_date": 1786472397, "id": "38183924491205828", "version": "2.3", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33366639516267707", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38183924491205828"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1918434545734263"}]}, "change_log": "Wall Bug Fixed", "created_date": 1786318206, "id": "38141768382088106", "version": "2.2.5", "version_code": 225, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33366639516267707", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38183924491205828"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1918434545734263"}]}, "change_log": "\ufffd Stub-linVR \u2014 UPDATE 2.2\nTHE HORROR UPDATE\n\nAfter many attempts, delays, and a LOT of work\u2026 it\u2019s finally here.\n\nWelcome to Stub-linVR 2.2 \u2014 one of the biggest updates yet.\n\nHorror has officially arrived in Stub-linVR. After trying to get this feature working multiple times, it\u2019s finally been added to the game.\n\n\ufffd NEW: HORROR MODE\n\nThe long-awaited Horror Mode is finally here.\n\nExplore, survive, and try not to get caught.\n\nThis is only the beginning of the horror side of Stub-linVR, with more scary content planned for future updates.\n\n\ufffd NEW: DESERT MAP\n\nThe Desert Map has finally been added!\n\nAfter multiple delays and development problems, the desert is now available to explore.\n\nGet ready for a completely different environment from the usual Stub-linVR maps.\n\n\ufffd SHOP \u2014 STILL UNDER CONSTRUCTION\n\nThe Stub-linVR Shop is not finished yet.\n\nWe know you've been waiting for it, but we'd rather take our time and make it properly instead of releasing something unfinished.\n\nThe shop is coming soon.\n\n\ufffd DEVELOPMENT & FIXES\n\nAlongside the new content, we've continued working on the game's systems and fixing issues behind the scenes.\n\nMore improvements will continue to arrive in future updates.\n\n\ufffd A MESSAGE FROM THE DEVELOPER\n\nThank you for being patient.\n\n2.2 took much longer than expected. Horror was attempted multiple times, the desert was delayed, and development didn't always go according to plan.\n\nBut after all the delays...\n\nStub-linVR 2.2 is finally here.\n\nThis update is only the beginning.\n\nThank you for playing Stub-linVR.\n\n\u2014 Mr Tay & the Stub-linVR Team\n\n\ufffd STUB-LINVR 2.2\n\nHORROR HAS ARRIVED.", "created_date": 1786305362, "id": "38139015965696681", "version": "2.2", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33366639516267707", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38183924491205828"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1918434545734263"}]}, "change_log": "New Update!!!\nNew Desert Map..\nAnd maybe something else now, you'll have to find out.\n\nFixed a few bugs, like Cave map... And added echo to Caves.", "created_date": 1783305130, "id": "37389151210683164", "version": "2.1", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33366639516267707", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38183924491205828"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1918434545734263"}]}, "change_log": "Nothing Big...\n\n- Shop is under construction.\n- New Cave map..\n\nSorry no horror, these some trouble with things. Maybe next update.", "created_date": 1782762164, "id": "37254378264160460", "version": "2.0", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
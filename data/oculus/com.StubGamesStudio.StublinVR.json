{"data": {"node": {"__typename": "Application", "id": "33366639516267707", "organization": {"id": "467363675419275", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "33366639516267707"}]}, "id": "862059802893237"}]}}, "firstRevision": {"nodes": [{"application": {"id": "33366639516267707", "release_date": 1775430000, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40783212577943660"}, "id": "1918434545734263"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33366639516267707", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40783212577943660"}, "release_status": "RELEASED"}, "id": "35452606161004355", "version": "1.4", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1775994655, "id": "35452662600998711", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "35270733979191575"}, "release_status": "RELEASED", "id": "33366639516267707"}, "id": "35270733979191575", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308349_3969375706693716_8516926385543312721_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMt4ZazuWt0Q7kNvwGLJwko&_nc_oc=AdqLj231IzXwWEfAQ68LYR7kHXCS0lUvLZ0YrK1LkIfV9Vna_qqpVuSMsVsbw
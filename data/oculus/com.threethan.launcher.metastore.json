2241889637422275_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2CRFVUJ0OkQ7kNvwECgqJc&_nc_oc=AdrulOBVKifympRemzbk_x_0y8VhkXSOoq5-9noRhlDm0t-MOtTMUagtmQk6xiKX9Xs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHij5xEdHhulqNVr5WZxLXtgVfFzUuVhc6H32ztKt21jw&oe=6A7F245A"}, {"file_name": "ll_rnm.png", "id": "1373923397728536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820548_1373923401061869_3991556325281811630_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYgQL0HAUSIQ7kNvwHuHC1i&_nc_oc=AdrKGI5uUVsTcRjW96nplGUD9zULig_KQVLiyqCOpl6V_TXKKNQoOmWi4rMHk-s9LSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXN3nEn8K60g5upsAEbh0Q4NO2t69D-VOa1KeVJwkRDQ&oe=6A7EFA95"}, {"file_name": "ll_screen_0 (Custom).png", "id": "676714685414462", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_676714688747795_8046625622296889740_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e0bGydEpIYQ7kNvwGoNhpX&_nc_oc=Adr46VJmE8uITkivPI5jyqtWzdBuop2MrXqkmZ1jdZB9f2qSg2dAxTuqdVQyvY6hNH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxcAz8iXICcBDeDTj_SGPy23tGRB4Vv8dkXic1FPVgvQ&oe=6A7F17F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lightning Launcher", "keywords": ["Launcher", "Apps", "Lightning", "Unknown", "Search"], "long_description": "# Sort, Search, and Launch Anything\nLightning Launcher is a launcher designed for Oculus Quest that supports both official and sideloaded apps and games.\n\nIt has been built with a focus on speed, flexiblity, and convenience.\n\nIt can run on any Android device, but has been tailored for the lastest updates to the Oculus/Meta Quest OS.\n\n### \ud83c\udfa8 **Simple but Powerful Interface**\n- Flexible UI with a focus on ease-of-use\n- Manually hide, rename, or replace the icon of any app\n- Constantly updated HD banner images, icons, and labels for all Quest apps\n- Change apps to display as icons or banners - individually, or by type.\n- Change the size or spacing of apps to show more apps at once\n- Choose from 10 preset styles, or import your own custom wallpaper\n\n### \ud83c\udf10 **Websites in the Launcher**\n- Enter edit mode and then select \"Add Website\" on the bottom right\n- You can also set website to open in the Meta Quest Browser or default browser on supported systems\n- Websites will be automatically given labels and high-res icons; both can be customized as you wish\n\n### \ud83d\udce6 **App Groups**\n- Automatic grouping of apps by platform\n- Easily sort apps into up to 20 custom groups\n\n### \u2b50 **Star Apps**\n- Apps you've starred will be moved to the front of the list for easier access\n\n### \ud83d\udd0d **Search**\n- Search all your apps at once!", "short_description": "Sort, search, and launch all your apps.\n\nLightning Launcher combines sideloaded apps, official apps, and even websites in an intuitive interface, and gives you powerful customization well beyond the Quest's default app library. "}]}, "developer_name": "Ethan M.", "developer_privacy_policy_url": "https://threethan.github.io/launcher/quest/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ethan M.", "support_website_url": "https://discord.gg/xG8EG2VxeS", "website_url": "https://threethan.github.io/launcher/quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pt", "ru", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "suppor
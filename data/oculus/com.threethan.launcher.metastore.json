com&_nc_ss=7f30f&oh=00_AQRW-j7Xa_aew5tv0bG8ZgXIJ4uILwos90E7Wmr9TkAqYw&oe=6B0DCD15"}, {"file_name": "ll_screen_0 (Custom).png", "id": "676714685414462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312332_676714688747795_8046625622296889740_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1i2k9BNI_QQ7kNvwH5Bu0a&_nc_oc=Adrk3lmLN9-w4J0klG-tkHzS5pGSH9DOZxoGZSnCtUQ2DGsR2nDBD60vZqgfhvgVOrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5kj5jG7u3xvRMnoCMCh1Ck9oXlE5aTxjbpTAhGHky2A&oe=6B0DB237"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lightning Launcher", "keywords": ["Launcher", "Apps", "Lightning", "Search"], "long_description": "# Sort, Search, and Launch Anything\nLightning Launcher is a launcher designed for Oculus Quest that supports **all** your apps and games.\n\nIt has been built with a focus on speed, flexiblity, and convenience.\n\nIt can run on any Android device, but has been tailored for the lastest updates to the Oculus/Meta Quest OS.\n\n### \ud83c\udfa8 **Simple but Powerful Interface**\n- Flexible UI with a focus on ease-of-use\n- Manually hide, rename, or replace the icon of any app\n- Constantly updated HD banner images, icons, and labels for all Quest apps\n- Change apps to display as icons or banners - individually, or by type.\n- Change the size or spacing of apps to show more apps at once\n- Choose from 10 preset styles, or import your own custom wallpaper\n\n### \ud83c\udf10 **Websites in the Launcher**\n- Enter edit mode and then select \"Add Website\" on the bottom right\n- You can also set website to open in the Meta Quest Browser or default browser on supported systems\n- Websites will be automatically given labels and high-res icons; both can be customized as you wish\n\n### \ud83d\udce6 **App Groups**\n- Automatic grouping of apps by platform\n- Easily sort apps into up to 20 custom groups\n\n### \u2b50 **Star Apps**\n- Apps you've starred will be moved to the front of the list for easier access\n\n### \ud83d\udd0d **Search**\n- Search all your apps at once!", "short_description": "Sort, search, and launch all your apps.\n\nLightning Launcher combines all your apps and websites in an intuitive interface, and gives you powerful customization well beyond the Quest's default app library. "}]}, "developer_name": "Ethan M.", "developer_privacy_policy_url": "https://threethan.github.io/launcher/quest/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ethan M.", "support_website_url": "https://discord.gg/xG8EG2VxeS", "website_url": "https://threethan.github.io/launcher/quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pt", "ru", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25598669473147528"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820648_1375933767392429_2536398165374174449_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXxxIa4Nrw4Q7kNvwHh2noB&_nc_oc=AdrEg9Sm7PZEh0OS_n41KfwN-lojeQW0o-OdxYzXSUfGFhQbB-7fB4tXEz9r1vYpaF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQX-vWL-6F_kvx3IAZpP9J9BZQNvDWW_KoalpLw_jwbew&oe=6B0DA852"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lightn
7qc7UQ7kNvwHetuhb&_nc_oc=Adk48SmnxlejHPm63XSHoNTjgaEQQJ9IK8pbzvLrmIKL_EO7yT1FcdrjG7SR_Ef4wBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAbacY9JAW0aaMaTYAw2cOfBb4Fa0zqRtqmhz3AspfTw&oe=69B2CBDA"}, {"file_name": "ll_rnm.png", "id": "1373923397728536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820548_1373923401061869_3991556325281811630_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GCeUo1IqbwQ7kNvwEQyKOt&_nc_oc=AdmfVKK5RSj-EpNuzcJlgNccrlXWR0PPS5gB95oW0mRgEl5G5cEnw3hTUaA-KcVDFtw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRAcRXJU0Df4_Ge2xcgMepKebYxBdqXPeHagY_EOGQDg&oe=69B2A215"}, {"file_name": "ll_screen_0 (Custom).png", "id": "676714685414462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312332_676714688747795_8046625622296889740_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymFZAuXcboQQ7kNvwFvbcLt&_nc_oc=Adm9Ipff9LkgwrUGT19j4d5R6KO3knZ2KMZxEc0JFCPA4ILFV2XuG-0CLqAcEoY5vd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzTNMCfKRk5g11mY6DF53Gl9OrYhZjnglItCt2lZe6kg&oe=69B2BF77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lightning Launcher", "keywords": ["Launcher", "Apps", "Lightning", "Unknown", "Search"], "long_description": "# Sort, Search, and Launch Anything\nLightning Launcher is a launcher designed for Oculus Quest that supports both official and sideloaded apps and games.\n\nIt has been built with a focus on speed, flexiblity, and convenience.\n\nIt can run on any Android device, but has been tailored for the lastest updates to the Oculus/Meta Quest OS.\n\n### \ud83c\udfa8 **Simple but Powerful Interface**\n- Flexible UI with a focus on ease-of-use\n- Manually hide, rename, or replace the icon of any app\n- Constantly updated HD banner images, icons, and labels for all Quest apps\n- Change apps to display as icons or banners - individually, or by type.\n- Change the size or spacing of apps to show more apps at once\n- Choose from 10 preset styles, or import your own custom wallpaper\n\n### \ud83c\udf10 **Websites in the Launcher**\n- Enter edit mode and then select \"Add Website\" on the bottom right\n- You can also set website to open in the Meta Quest Browser or default browser on supported systems\n- Websites will be automatically given labels and high-res icons; both can be customized as you wish\n\n### \ud83d\udce6 **App Groups**\n- Automatic grouping of apps by platform\n- Easily sort apps into up to 20 custom groups\n\n### \u2b50 **Star Apps**\n- Apps you've starred will be moved to the front of the list for easier access\n\n### \ud83d\udd0d **Search**\n- Search all your apps at once!", "short_description": "Sort, search, and launch all your apps.\n\nLightning Launcher combines sideloaded apps, official apps, and even websites in an intuitive interface, and gives you powerful customization well beyond the Quest's default app library. "}]}, "developer_name": "Ethan M.", "developer_privacy_policy_url": "https://threethan.github.io/launcher/quest/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ethan M.", "support_website_url": "https://discord.gg/xG8EG2VxeS", "website_url": "https://threethan.github.io/launcher/quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "pt", "ru", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "251618933
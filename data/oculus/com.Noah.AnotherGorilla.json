mVgaWtsjPiXMXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3TNEjir6uyTFsjet7Hpj9ap-I9UwhbZO0FTaTD7t7uA&oe=6A786BE7"}, {"file_name": "2bff5e952e794805bf389361cfd79687 (2) (1).png", "id": "9616104025162176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618894_9616104048495507_5651631169023769775_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5XeC0FGX7gQ7kNvwFBmpwW&_nc_oc=Adr4vY-hnBWT4QaVVKSKxiUYXEUtmCUZoIDDn_9SUAGWyEcQ-PclLsc99nu_G7VLdVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuIIuzYZ9K344dfQGzujQESCmvQS1gaQMgbRnw-rruTw&oe=6A789821"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Another Gorilla", "keywords": [], "long_description": "Another Gorilla is a thrilling VR experience that drops you into the oversized knuckles of a gorilla on the run. Set in a stylized city where humanity watches your every move, you must climb, swing, smash, and survive in a world that doesn\u2019t understand you. Whether you\u2019re scaling skyscrapers, throwing cars, or dodging tranquilizers, every moment is physical, chaotic, and fun. The intuitive locomotion system uses your real-world arms for movement, letting you feel every leap and punch. But you\u2019re not alone\u2014other gorillas, drones, and strange tech stand in your way. Will you escape, fight, or find a new kind of freedom? Packed with humor, action, and primal power, Another Gorilla redefines what it means to go bananas in VR. It\u2019s more than a game\u2014it\u2019s a wild journey through instinct, rebellion, and bananas. Lots of bananas.", "short_description": "Another Gorilla is a very fun game where you are a Gorilla and you will have a blast"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/another-gorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noah", "support_website_url": null, "website_url": "https://sites.google.com/view/another-gorilla/
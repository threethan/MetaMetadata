cie4hIhH48Q&oe=6A4BC735"}, {"file_name": "47c4a7e6e6974de585b05ce9f967da48 (2) (1).png", "id": "1615303345832865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824594_1615303349166198_664041616935848413_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPDdaEXK4zkQ7kNvwHdw-fW&_nc_oc=AdpAS4FUfu0a6ipA3j5MPgqqeMkAIGXAIi5wW4xJ9B9YtxQTtW2JTzbOtHsdKqhmSsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTgS4VxkUsO1aJ8h5HqvDozSSujFrWdOaai7_HWXLnOw&oe=6A4B9BA1"}, {"file_name": "31f9d786d9054ebe987d8de52f4fad5c (2) (1).png", "id": "699718022842425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619127_699718026175758_7230833041550056953_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_wmGVtzfaEQ7kNvwGtH7ay&_nc_oc=AdqSi8uUMUQimtj5ViHfVwAyaUIYiiSMu9xeH7WpTk1XSsJYh6FVNwUSq5B_MMXYuJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeAHGvcbrsu5hvUiTLbeM1DvuI6A_lEIg9pyrZR7ZNWg&oe=6A4BC964"}, {"file_name": "8ac57d8a76854f7f898cfbf86d0eb3b0 (1).png", "id": "1260451818790816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824012_1260451822124149_3969356052079845229_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngtHTBX7D78Q7kNvwF_ouf9&_nc_oc=AdpCrC4Uzr7LV3GHTLMif-9uAOpctBpRG7dySsLqbhLYvbL3NwgzBGxW8-xyJUzIWVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4xGTVNDrRsBalHlHiujVbRuQKiZWCji_fpqeoLRjc_g&oe=6A4BD127"}, {"file_name": "2bff5e952e794805bf389361cfd79687 (2) (1).png", "id": "9616104025162176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618894_9616104048495507_5651631169023769775_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPy0CqC_odMQ7kNvwFbHdzx&_nc_oc=Adqxtvpxk9c5ZMxk6lfkNwydKc5-HbXezQilHpfj3O9XDDLmhRF_IPYHaCu7-QP2O6s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoM-jhg7DlU79ZRpWxgRE5njHPZmfrtcABWW3FMrtdkg&oe=6A4BC521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Another Gorilla", "keywords": [], "long_description": "Another Gorilla is a thrilling VR experience that drops you into the oversized knuckles of a gorilla on the run. Set in a stylized city where humanity watches your every move, you must climb, swing, smash, and survive in a world that doesn\u2019t understand you. Whether you\u2019re scaling skyscrapers, throwing cars, or dodging tranquilizers, every moment is physical, chaotic, and fun. The intuitive locomotion system uses your real-world arms for movement, letting you feel every leap and punch. But you\u2019re not alone\u2014other gorillas, drones, and strange tech stand in your way. Will you escape, fight, or find a new kind of freedom? Packed with humor, action, and primal power, Another Gorilla redefines what it means to go bananas in VR. It\u2019s more than a game\u2014it\u2019s a wild journey through instinct, rebellion, and bananas. Lots of bananas.", "short_description": "Another Gorilla is a very fun game where you are a Gorilla and you will have a blast"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/another-gorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noah", "support_website_url": null, "website_url": "https://sites.google.com/view/another-gorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23890627850600239"}, "review_messages": []}]}, "cover_squa
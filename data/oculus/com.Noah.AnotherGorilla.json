UgL-fze5d4A&oe=6AC26E35"}, {"file_name": "47c4a7e6e6974de585b05ce9f967da48 (2) (1).png", "id": "1615303345832865", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824594_1615303349166198_664041616935848413_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsO2J1x2rZ4Q7kNvwE9BxAJ&_nc_oc=AdrExHy7n5oGQ7AHBWIKv_-wSwCmVqCgpVcnVwUMkNcZYNjN9UsFSH_ZoNmM5gXtb6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3-7TpXJfT1OrWoGubxXLapBznlFDD38vHtkm24i-zXg&oe=6AC27AE1"}, {"file_name": "31f9d786d9054ebe987d8de52f4fad5c (2) (1).png", "id": "699718022842425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619127_699718026175758_7230833041550056953_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUv34kDY74kQ7kNvwERSWHO&_nc_oc=Ado2UgMthYFRK9pHCc_12khoH5oBdtQHo6Y6aDrBHZNAxXC3bbLBAkU-ZowHnyTZlzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj1sbPkMzqbhM2tEKDhySe6TEawmtOLuGZeNhsxtZmbA&oe=6AC27064"}, {"file_name": "8ac57d8a76854f7f898cfbf86d0eb3b0 (1).png", "id": "1260451818790816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824012_1260451822124149_3969356052079845229_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIEawxrGb8UQ7kNvwEVCFW0&_nc_oc=Adory3pGpn2wNhiUp5kI76JlKOSH7r4Ocxk6vLMnpbrL08i87IAH2N1N8LVrMhqyjV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBsIrwvHqIeggtexwRTqcpNzuv4JLvKG5NJ8rJmRRG5A&oe=6AC27827"}, {"file_name": "2bff5e952e794805bf389361cfd79687 (2) (1).png", "id": "9616104025162176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618894_9616104048495507_5651631169023769775_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UygLTLcK-sQ7kNvwHNZhjR&_nc_oc=AdqeqqLFcoJByni3zUKCRjFMPV3xQYT7pKpEU2aUnrlNNWNq9jiG7oeBE3Oh10Zs6c0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuBDlPnWE5C_Pt4vkKmu_dIFbAnrFfHzc__tOjytT-oA&oe=6AC26C21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Another Gorilla", "keywords": [], "long_description": "Another Gorilla is a thrilling VR experience that drops you into the oversized knuckles of a gorilla on the run. Set in a stylized city where humanity watches your every move, you must climb, swing, smash, and survive in a world that doesn\u2019t understand you. Whether you\u2019re scaling skyscrapers, throwing cars, or dodging tranquilizers, every moment is physical, chaotic, and fun. The intuitive locomotion system uses your real-world arms for movement, letting you feel every leap and punch. But you\u2019re not alone\u2014other gorillas, drones, and strange tech stand in your way. Will you escape, fight, or find a new kind of freedom? Packed with humor, action, and primal power, Another Gorilla redefines what it means to go bananas in VR. It\u2019s more than a game\u2014it\u2019s a wild journey through instinct, rebellion, and bananas. Lots of bananas.", "short_description": "Another Gorilla is a very fun game where you are a Gorilla and you will have a blast"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/another-gorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noah", "support_website_url": null, "website_url": "https://sites.google.com/view/another-gorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23890627850600239"}, "review_messages": []}]}, "cover_squa
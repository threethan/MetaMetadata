MzdNmjQQ7kNvwF8gf4c&_nc_oc=AdqFFkvsOEPdzpNe7SdbZ8vmhSbng60z4bVtbJUmYxJ2aEcWPdoMSmDBBQ4TtgQ8OuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOc3tbmUutaOVpT7L1UyEgM3KcnkrZNMnYfIitZubsxQ&oe=6B0C7CA4"}, {"file_name": "8ac57d8a76854f7f898cfbf86d0eb3b0 (1).png", "id": "1260451818790816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824012_1260451822124149_3969356052079845229_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_e65_zvmssQ7kNvwHtb11q&_nc_oc=AdokRKEwqBsDs6icF25-HGVplXEUFiXmZZOSyJM0u87DfNa-6o8lY6uH-Kl_PL_DPSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAARRNt0G5_oxLDTnfz5u_b6WMEB9b4w7jBN74huwuoQ&oe=6B0C4C27"}, {"file_name": "2bff5e952e794805bf389361cfd79687 (2) (1).png", "id": "9616104025162176", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618894_9616104048495507_5651631169023769775_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FikJjS_-FHYQ7kNvwHkzC3t&_nc_oc=Adrze2r3VYQMjoMKJiqvFLexrQSYqZRN1wQOe97Fr3dHaxz9DXCLbg0TyJ30PXuVF-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWdB_mdsWsmBPI3a9RqCHmavirTblSnxocAEy15YcKQA&oe=6B0C7861"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Another Gorilla", "keywords": [], "long_description": "Another Gorilla is a thrilling VR experience that drops you into the oversized knuckles of a gorilla on the run. Set in a stylized city where humanity watches your every move, you must climb, swing, smash, and survive in a world that doesn\u2019t understand you. Whether you\u2019re scaling skyscrapers, throwing cars, or dodging tranquilizers, every moment is physical, chaotic, and fun. The intuitive locomotion system uses your real-world arms for movement, letting you feel every leap and punch. But you\u2019re not alone\u2014other gorillas, drones, and strange tech stand in your way. Will you escape, fight, or find a new kind of freedom? Packed with humor, action, and primal power, Another Gorilla redefines what it means to go bananas in VR. It\u2019s more than a game\u2014it\u2019s a wild journey through instinct, rebellion, and bananas. Lots of bananas.", "short_description": "Another Gorilla is a very fun game where you are a Gorilla and you will have a blast"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/another-gorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noah", "support_website_url": null, "website_url": "https://sites.google.com/view/another-gorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23890627850600239"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24182617974734557", "version": "1.0.8"}, "id": "735124156125828", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23882699161393108", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24182617974734557"}, "release_status": "RELEASED"}, "binary_release_channels": {"no
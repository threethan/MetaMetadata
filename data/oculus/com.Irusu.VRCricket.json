ame": "azs3ew5r4hyasej5h643.png", "id": "1332264352432019", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620429_1332264359098685_553935287580885461_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvNDGtBHLeYQ7kNvwF8iJmQ&_nc_oc=Adpixm-FWpxUSDNjgD2A63Ns1wvK2sFmUy8puAd7tEDKKA0Fds4lJwtTxE483Q-DntE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-m0AQ4-3RZ2WM3RKRFX0sMtAhPtqzXNB85sgRUnvsOw&oe=6AE9F60F"}, {"file_name": "Gully ss2.png", "id": "4266091306937083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507829686_4266091310270416_7292895027317509779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYxjFkTiJJMQ7kNvwFtkQyW&_nc_oc=Adp07ZKU2c_EJp3xuO8_PWMJJT8-UO1DeYQboUb1Owkr7o5el8axfKPZt_17yiISrI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScVVquovBRoChk8GMZF2QYeLVrVi3MvZCbp8Z1ikw1jA&oe=6AE9F159"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560 x 1440.png", "id": "1185396463569354", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1185396466902687_3485502356355162100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UolGu8IaYwEQ7kNvwFUKLl9&_nc_oc=AdrBfnbOYK54c6Z2js6k3R4KrHocH5tT5e-pGlMx5i8yYju5L9a-NusgM5tuk_mWh3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU7qRGz-MMSHRT2Br2yYzmk_L7isvwjZFOILkmhAeqOg&oe=6AE9E272"}, "display_name": "Irusu Cricket VR", "keywords": ["Cricket", "Sports", "Batting", "T20", "Physics"], "long_description": "IRUSU CRICKET VR: THE ULTIMATE QUEST 3 EXPERIENCE\n\nStep onto the pitch with a true-to-life, physics-driven VR cricket simulation built exclusively for Meta Quest 3 and 3s.\n\nREAL BATTING PHYSICS\nExperience 1:1 VR bat tracking. The game calculates sweet spots and power directly from your actual swing. Controller haptics let you physically feel a clean drive versus a thick edge.\n\nSMART AI & REAL MATCHES\nFace 150 km/h bouncers and sharp spin from adaptive AI bowlers. Watch fielders dive for catches in real-time. Play 3, 5, 10, or 20-over matches complete with Power Plays and Super Overs.\n\nTV-STYLE DRS SYSTEM\nChallenge the umpire! Watch cinematic Hawk-Eye, Ultra-Edge (Snicko), and HotSpot reviews unfold on the stadium Jumbotron.\n\nGLOBAL STADIUMS & PROGRESSION\nMaster your swing in Net Practice, then conquer unique pitches in Mumbai, Melbourne, and London. Unlock premium gear, track your stats, and immerse yourself in dynamic crowd roars.\n\nKEY FEATURES:\n- 1:1 physics-based batting\n- Adaptive AI bowling & active fielding\n- 3rd Umpire DRS (Hawk-Eye, Snicko, HotSpot)\n- Quick matches to full T20 formats\n- 3 iconic stadiums & Net Practice mode\n- Bat skins, career stats & haptic feedback\n- Feel every ball. Own every shot.", "short_description": "Step onto the crease. Face AI bowlers. Play VR cricket like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.irusu.co.in/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusustudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37286872850926075"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_1591320658597078_8803077908121181133_n.png?stp=dst-png_s360x360&_nc_cat=1
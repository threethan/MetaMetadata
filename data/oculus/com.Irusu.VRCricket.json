e_name": "Hero cover.png", "id": "1276910630760636", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499622919_1276910634093969_2282701905800084917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1auvx_un24sQ7kNvwFGn2Uq&_nc_oc=AdpvXExb14zQS37jXqU-V21AYxCasebxIQW5stswisZ-nmoAuiL4v8thrFdmKPbKNo0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSdlVt13muMA2K8-6R9Wb4jEenjtNASGtdrRh-VEgE2w&oe=6AA96036"}]}, "id": "1337205984689036", "locale": "en_US", "screenshots": [{"file_name": "Gully showcase.png", "id": "27384114711245851", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823910_27384114727912516_7730236045392660496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFG0SCzT2IgQ7kNvwFK5RBD&_nc_oc=AdqhANx9uqQE9p52mPFlQybbb6xsnkB6daz3VZn-TcWOf5mIWPZNpt8Bg38VQ0QPTdI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIopUhKi8RgPusTfd6xi1BcAhmLDjj1Y8YtuTsfh8q2rQ&oe=6AA9363A"}, {"file_name": "Screenshot 2026-07-06 122249.png", "id": "1288407619811536", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/604338899_1288407623144869_3802859540236843009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSeM3cmgxmgQ7kNvwGKrYjo&_nc_oc=AdoPfpOtvkehUJy6LEiGm-xXrfpZPq21i2HMEkasTAPc007VP14WETzG6uQcH4eOnkg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0hvKQYXFA6RPhzev3mIYf2EDqvIucrKdI_UPGWBM2gQ&oe=6AA96223"}, {"file_name": "ss2341.png", "id": "1005319145698593", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311597_1005319149031926_6552692543414371312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWCtGBOnAZ0Q7kNvwGvoe6s&_nc_oc=AdqjYeZ208-KuTtUPJYXdM-UCYertbzNUGReBHIH47HfUlpWZ4oPvxLtJil3uE_HqBU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDaazWIHOCLiE1aoscWCNCOm1iIPoU-INJH73cuX0K3w&oe=6AA95396"}, {"file_name": "azs3ew5r4hyasej5h643.png", "id": "1332264352432019", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620429_1332264359098685_553935287580885461_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_fGhI_SrOcQ7kNvwEXQSfg&_nc_oc=AdpjEakTjy-ADg1JQQdXQr_LQBzEAIde0gtC6bVN8JvhpGIZAfHvmXA8tgVJ4Qdxayk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6dez9ttTjFVOeopb91Mvm1CQVJueKcdlxYQghMwQg6A&oe=6AA95C8F"}, {"file_name": "Gully ss2.png", "id": "4266091306937083", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/507829686_4266091310270416_7292895027317509779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4CzlTgRCDMQ7kNvwEhBoeq&_nc_oc=AdrA6AueFfLn-dduGERVdoA0IOFFW2NQZKKvvZVi6E0tDvITf2QOG3u0NWVxLZCxCgg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8sYwutFBdlaFhLowTzL_SsvLTrKr5pWNSa3vznY-unA&oe=6AA957D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560 x 1440.png", "id": "1185396463569354", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818890_1185396466902687_3485502356355162100_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cvwaa05ksVkQ7kNvwH82C8h&_nc_oc=AdqURXqYs-tW7Ah-ymbMeEq7XCr33ui6AI-m_GocwGMwbXQ_Sjsh3F52a_9Go5Y9hiI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrv7FyMttJ7RwEaifd4rnfh6_DnSBl-0bbEV8vAURKww&oe=6AA948F2"}, "display_name": "Irusu Cricket VR", "keywords": ["Cricket", "Sports", "Batting", "T20", "Physics"], "long_description": "IRUSU CRICKET VR: THE ULTIMATE QUEST 3 EXPERIENCE\n\nStep onto the pitch with a true-to-life, physics-driven VR cricket simulation built exclusively for Meta Quest 3 and 3s.\n\nREAL BATTING PHYSICS\nExperience 1:1 VR bat tracking. The game calculates sweet spots and power directly from your actual swing. Controller haptics let you physically feel a clean drive versus a thick edge.\n\nSMART AI & REAL MATCHES\nFace 150 km/h bouncers and sharp spin from adaptive AI bowlers. Watch fielders dive for catches in real-time. Play 3, 5, 10, or 20-over matches complete with Power Plays and Super Overs.\n\nTV-STYLE DRS SYSTEM\nChallenge the umpire! Watch cinematic Hawk-Eye, Ultra-Edge (Snicko), and HotSpot reviews unfold on the stadium Jumbotron.\n\nGLOBAL STADIUMS & PROGRESSION\nMaster your swing in Net Practice, then conquer unique pitches in Mumbai, Melbourne, and London. Unlock premium gear, track your stats, and immerse yourself in dynamic crowd roars.\n\nKEY FEATURES:\n- 1:1 physics-based batting\n- Adaptive AI bowling & active fielding\n- 3rd Umpire DRS (Hawk-Eye, Snicko, HotSpot)\n- Quick matches to full T20 formats\n- 3 iconic stadiums & Net Practice mode\n- Bat skins, career stats & haptic feedback\n- Feel every ball. Own every shot.", "short_description": "Step onto the crease. Face AI bowlers. Play VR cricket like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.irusu.co.in/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Irusu Studios", "support_website_url": null, "website_url": "https://irusustudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37286872850926075"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821115_1591320658597078_8803077908121181133_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQJrWcBbPQcQ7kNvwFz2cU3&_nc_oc=AdpAcUFLjIulXRujt_ohkPvyEbsIE1PUaRHENtJsap5qkzhaNw
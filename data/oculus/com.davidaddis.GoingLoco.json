0x900.png", "id": "477504658318918", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75210896_477504661652251_3564749497542943158_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEKVtZkZ9o8Q7kNvwHAIn3_&_nc_oc=AdnKaXq6kDTozFcjx8SnYRExNlFfJQ7BLt0IPIWm94o8CDL7CMwNkqHRtExlrEZBdqo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu0HsmiKb26YbMphnn8yXiyiFrTTkuoO5ofM5QOPMnj8g&oe=69A19BFD"}]}, "id": "9503075863050459", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-01-03-19h12m07s768.png", "id": "1858101914997833", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974613_1858101918331166_729692114654231065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB_Yo-0ZhCQQ7kNvwGgQomG&_nc_oc=Adk5oQUYXunO0miq09e_B_rJqIYkamGB77DGZ544CgMF1Jv9oU6kE7ReWICA8RPmj-I&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs9StO1Zg-XPkpibzH75iSZzzUrAqrS3ekPdBmYg6_2uw&oe=69A198C8"}, {"file_name": "vlcsnap-2025-01-03-19h10m15s070.png", "id": "9421565401187515", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75485578_9421565404520848_4562929803999556861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owvkETMpYKEQ7kNvwFR2kEl&_nc_oc=AdnrPD2CNiHSyAScOYgUY2_3JeTg9URDwdgjhnVL0kp24JOA17ukyuDj260h0GWa29Y&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs6Oi03iGI5uTMW5fzyHBOpoahTYqqjsw_0940NF6jCxQ&oe=69A19245"}, {"file_name": "vlcsnap-2025-01-03-18h22m32s334.png", "id": "1973285023181243", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982593_1973285026514576_5060394326862599411_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6U8Hl1NkAMQ7kNvwHJqMF3&_nc_oc=AdkN5MfWWOdyhY_UGuJ7dWPRpGQ1_czYmgfAMeX7vXl1pPrkqX5Ksn8JoqYZZyrYdqw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvoEIIY6okQLKaQ0X7LSqw_S4KCgWre9QtR7IS2-rsAMQ&oe=69A1A44E"}, {"file_name": "vlcsnap-2025-01-03-18h24m43s958.png", "id": "908904098023381", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031430_908904101356714_432498181729218178_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3jmJea-G9MQ7kNvwHVv-7-&_nc_oc=AdnbJwBOfKhO1iMPY6ia7S6d_v-uozDI8utpBnsPQcwi0xG-VqUVshTJl8Gz9HjayHM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftz49qlN4ylzgzSgQF7UuP73xXeJn0PNwpmj-qfIwLnzg&oe=69A1ABD5"}, {"file_name": "vlcsnap-2025-01-03-19h10m49s550.png", "id": "594618446518426", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974647_594618449851759_8551514465278418675_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ej68bi7bNwQ7kNvwEkyDsE&_nc_oc=Adnw8WXba1yh27rVRqIBEo9qpXzceCmb-pt_uCtLj-vGkX_d_WlI3AMizOh86F_L8iI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsYf2ndcCX5dkS5Sqin93aqgYyRLlk--cvlFv2IDfmFRw&oe=69A1A0C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-01-03-19h59m04s026.png", "id": "1034948138456558", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75196216_1034948141789891_1681670717283253087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUGgIHTbuY4Q7kNvwFHNiih&_nc_oc=AdkYt405cHSBz7Vbjza1kAAZvpG3_QYZpVxFWKiZFrPAbg6qGBVUiVpZ1lh2jqQ9_RA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuyUWOWHFQixtRKqj-QWB_kdkGn8rxxe0OXU59DErbFRw&oe=69A1A4D6"}, "display_name": "Going Loco", "keywords": ["Loco", "LowPoly", "City", "Puzzle", "Autohand"], "long_description": "Armed with spare bits of road, railway, and anything else to hand, take on the role of a city planner as you repair the routes for vehicles on your charming, low-poly city map.\n\nYour targets will travel at different speeds, and they may travel on custom routes, so you will need to get creative and build around their various requirements. You may need to block access one way in order to free up another, or send cars in a loop to let a bullet train pass through.\n\nThis charming puzzle game should be easy to learn, but hard to master in order to attain all the 3-star scores. Can you perfect every level??", "short_description": "Plug the gaps in the miniature city before the vehicles crash! In this charming puzzle game, you take the role of a city planner and must perform some last-minute engineering work on a low-poly street to keep the planes, trains and automobiles on track and on time."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.davidaddis.com/?page_id=61616", "developer_terms_of_service_url": null, "publisher_name": "David Addis", "support_website_url": null, "website_url": "http://www.davidaddis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "es", "uk", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8830267167091781"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1405663724431020"}, {"status": "PUBLISHED", "id": "894213716885184"}, {"status": "PUBLISHED", "id": "2057016198399719"}, {"status": "PUBLISHED", "id": "1353668919585144"}, {"status": "PUBLISHED", "id": "780774380985730"}, {"status": "PUBLISHED", "id": "642295451489751"}, {"status": "PUBLISHED", "id": "1794630658128542"}, {"status": "PUBLISHED", "id": "3952249618365809"}, {"status": "PUBLISHED", "id": "1898226403916697"}, {"status": "PUBLISHED", "id": "569249372671509"}]}, "baseline_offer": {"id": "3952249618365809"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1405663724431020"}]}, "liveChannel": {"nodes": [
0x900.png", "id": "477504658318918", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_477504661652251_3564749497542943158_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFGJhdMraSwQ7kNvwHvaYVl&_nc_oc=AdlbxcXRQ5J7AWUWHGlguYLf0x3D1njJ2YiWuqNOIejQeefdw9VxOCnamv18LXauwxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5n2Wo7k4llZQtuw9KM_txlUUKCbZE6yzb_hu0QrL1zQ&oe=699DA77D"}]}, "id": "9503075863050459", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-01-03-19h12m07s768.png", "id": "1858101914997833", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974613_1858101918331166_729692114654231065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pnaTcKpXXkQ7kNvwGcyGtP&_nc_oc=AdmztiEjwNU7lt9492c7DMuF_sJSPyQdiQ3CB_4HYTaUx1iS51UAm4PcMXp_KclMTeI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVICD8qj2YUteBiSoslsZJjj3QxY0GtqODMbJ2Brvffg&oe=699DA448"}, {"file_name": "vlcsnap-2025-01-03-19h10m15s070.png", "id": "9421565401187515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485578_9421565404520848_4562929803999556861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9l-3A9jsg8Q7kNvwFKqdqG&_nc_oc=AdlI1JYe2jDltdpJuzhGhqOB3vBAPFhaGllMhbwOD2zJwy0ECggQGz5xJT_xLB6TY6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuOUAe05o-gX0fILc0u02TPXE3i8cG8pBQcCte3Qm2mxg&oe=699D9DC5"}, {"file_name": "vlcsnap-2025-01-03-18h22m32s334.png", "id": "1973285023181243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982593_1973285026514576_5060394326862599411_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9IuR64SDdAQ7kNvwFVpV9E&_nc_oc=AdlOdSFmR7BraOPYyN5vp35DCZxhEaL4fhzdzv-qy3iOQ7Oo-mNr4swVLc7oZuOzcjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqOeM4TYvab8h8MVJ5b3q-1BAa-t9GjleTx8QOp7zcoQ&oe=699DAFCE"}, {"file_name": "vlcsnap-2025-01-03-18h24m43s958.png", "id": "908904098023381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031430_908904101356714_432498181729218178_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i69hyOYmWoQ7kNvwGf2aES&_nc_oc=Adns1y8b4Ch41wVc3JuEfLId7y2vTA2PM9G8sT5WNqEPy2DOEANHl5wKmUz0a_yIIv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBCalVlyRBLF_1Jc4zfy0-HtL_Aqb-EsBGYNFoOEUXrw&oe=699DB755"}, {"file_name": "vlcsnap-2025-01-03-19h10m49s550.png", "id": "594618446518426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974647_594618449851759_8551514465278418675_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9a7ECQLjkoQ7kNvwGxmbMO&_nc_oc=AdmGyc_to32acZq9rdImLI5j0pGe2S9twxDnt4kh0O1E6JZTxR8cK2K6ibY_mw9IeK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJozE2KcUN0GqMT9hUfIisX0OjPPT88T1itQ-Cg5J2MA&oe=699DAC46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-01-03-19h59m04s026.png", "id": "1034948138456558", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196216_1034948141789891_1681670717283253087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYDmsNhUizcQ7kNvwE0rD7S&_nc_oc=Adm1fIv7w7qYFE9bDr1H6uULCKcmcNq0DKUm0TJQJxIrgjc0OfaJBysgUIjsYXqh9pA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afto9HcaeTIQiLFmSF3Env5PcyCPdTvu8G1K_ugyGuH9mQ&oe=699DB056"}, "display_name": "Going Loco", "keywords": ["Loco", "LowPoly", "City", "Puzzle", "Autohand"], "long_description": "Armed with spare bits of road, railway, and anything else to hand, take on the role of a city planner as you repair the routes for vehicles on your charming, low-poly city map.\n\nYour targets will travel at different speeds, and they may travel on custom routes, so you will need to get creative and build around their various requirements. You may need to block access one way in order to free up another, or send cars in a loop to let a bullet train pass through.\n\nThis charming puzzle game should be easy to learn, but hard to master in order to attain all the 3-star scores. Can you perfect every level??", "short_description": "Plug the gaps in the miniature city before the vehicles crash! In this charming puzzle game, you take the role of a city planner and must perform some last-minute engineering work on a low-poly street to keep the planes, trains and automobiles on track and on time."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.davidaddis.com/?page_id=61616", "developer_terms_of_service_url": null, "publisher_name": "David Addis", "support_website_url": null, "website_url": "http://www.davidaddis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "es", "uk", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8830267167091781"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1405663724431020"}, {"status": "PUBLISHED", "id": "894213716885184"}, {"status": "PUBLISHED", "id": "2057016198399719"}, {"status": "PUBLISHED", "id": "1353668919585144"}, {"status": "PUBLISHED", "id": "780774380985730"}, {"status": "PUBLISHED", "id": "642295451489751"}, {"status": "PUBLISHED", "id": "1794630658128542"}, {"status": "PUBLISHED", "id": "3952249618365809"}, {"status": "PUBLISHED", "id": "1898226403916697"}, {"status": "PUBLISHED", "id": "569249372671509"}]}, "baseline_offer": {"id": "3952249618365809"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1405663724431020"}]}, "liveChannel": {"nodes": [
aFDg7OmrZipCk9W98P-JwIzOWyBQ&oe=69B80DCE"}, {"file_name": "vlcsnap-2025-01-03-18h24m43s958.png", "id": "908904098023381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_908904101356714_432498181729218178_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQCcxqD8L3EQ7kNvwFl1AhA&_nc_oc=AdkJLzI11ana9IDhdGW9D1pPD9hCrKxCVFB6B7sfBESPDEE_jnCQdjFFBVIcFLZ07Lw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGxuG7aDORcLYG7y8JehxSkB0zjD3jGIe_amamh7Zdbw&oe=69B81555"}, {"file_name": "vlcsnap-2025-01-03-19h10m49s550.png", "id": "594618446518426", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974647_594618449851759_8551514465278418675_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2JlLyrf7FAQ7kNvwFW2pkZ&_nc_oc=Admx9vHamcDhvlvhY1jKWFQOmnauv8s5Q7IRJZzrVza-nV6JsnPDlONaiG-akNlvu50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwY79i127sw16_KbWnyYXXEjIumX8AyY4LWkKE-NlyfZA&oe=69B80A46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-01-03-19h59m04s026.png", "id": "1034948138456558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196216_1034948141789891_1681670717283253087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0hWEQ51PPAQ7kNvwGJUqwJ&_nc_oc=AdkMafYmRDa9-2e4zoNxJl3OGktvQwdGmXJaxnnj5k7gv_e9R8b8URdfxmcr4lgqfRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjO99Phhl1a6O4WFExPlCuBxsSE6dECIc0WslNb9sfzQ&oe=69B80E56"}, "display_name": "Going Loco", "keywords": ["Loco", "LowPoly", "City", "Puzzle", "Autohand"], "long_description": "Armed with spare bits of road, railway, and anything else to hand, take on the role of a city planner as you repair the routes for vehicles on your charming, low-poly city map.\n\nYour targets will travel at different speeds, and they may travel on custom routes, so you will need to get creative and build around their various requirements. You may need to block access one way in order to free up another, or send cars in a loop to let a bullet train pass through.\n\nThis charming puzzle game should be easy to learn, but hard to master in order to attain all the 3-star scores. Can you perfect every level??", "short_description": "Plug the gaps in the miniature city before the vehicles crash! In this charming puzzle game, you take the role of a city planner and must perform some last-minute engineering work on a low-poly street to keep the planes, trains and automobiles on track and on time."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.davidaddis.com/?page_id=61616", "developer_terms_of_service_url": null, "publisher_name": "David Addis", "support_website_url": null, "website_url": "http://www.davidaddis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "es", "uk", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8830267167091781"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2139852780085938"}, {"status": "PUBLISHED", "id": "1405663724431020"}, {"status": "PUBLISHED", "id": "894213716885184"}, {"status": "PUBLISHED", "id": "2057016198399719"}, {"status": "PUBLISHED", "id": "1353668919585144"}, {"status": "PUBLISHED", "id": "780774380985730"}, {"status": "PUBLISHED", "id": "642295451489751"}, {"status": "PUBLISHED", "id": "1794630658128542"}, {"status": "PUBLISHED", "id": "3952249618365809"}, {"status": "PUB
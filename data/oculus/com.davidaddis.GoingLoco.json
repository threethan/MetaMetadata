0x900.png", "id": "477504658318918", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210896_477504661652251_3564749497542943158_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFGJhdMraSwQ7kNvwF5KDb6&_nc_oc=AdmSgoSu4uRsUBe7CCfL5bORLMwsqW_Pt9Yj2U9AIxZ8qKGnI8mqBkL1XMJ3D8dgizo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsX595sxnIF1s42X7YhqkhfDOGsC9LThQ0oe_jfV_O4zQ&oe=699C55FD"}]}, "id": "9503075863050459", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-01-03-19h12m07s768.png", "id": "1858101914997833", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974613_1858101918331166_729692114654231065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pnaTcKpXXkQ7kNvwE1Po1i&_nc_oc=AdlkpfwFx2jxNGTzdc4cdiRY_CJOCHsTvfPoEUxWVQwSrrrYGr_nIytDbR34Lys2Sjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftYGlgfDjwjtG7qTj4cmCT3GpDaVkH2WemMKy5B-YnYpg&oe=699C52C8"}, {"file_name": "vlcsnap-2025-01-03-19h10m15s070.png", "id": "9421565401187515", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485578_9421565404520848_4562929803999556861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9l-3A9jsg8Q7kNvwFujSOW&_nc_oc=AdlAdSzgauJAF1udR9ioaPrlE1SqilP97HOfGOIyI_nLIhHUcJulSIF6Qi1kGu-ZND8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvTe2VlEW-k6tEdYZEcoUWd3xNm5shP8IgT5crVz8pEDQ&oe=699C4C45"}, {"file_name": "vlcsnap-2025-01-03-18h22m32s334.png", "id": "1973285023181243", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982593_1973285026514576_5060394326862599411_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9IuR64SDdAQ7kNvwFZqAVL&_nc_oc=AdmhZ5gqXyiJ_VhhwYUh1YhAndSJmiseWW4G7Wr_hFx_6tmuPLu7_N4r1d1Hfycd448&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu5apvh2cD66K1TsQf1RKiCG7hrlW0dfzQ5UZmI-xOTXA&oe=699C5E4E"}, {"file_name": "vlcsnap-2025-01-03-18h24m43s958.png", "id": "908904098023381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031430_908904101356714_432498181729218178_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i69hyOYmWoQ7kNvwFSRSuS&_nc_oc=AdleB95x43zFKj9z82o0QR9EX_X7Qezbwe3dGJ-lxF3phi7LezYtBJrFO5M1kVs-odY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftNKvdItopYDrLY72_eUH2XwciZ0Ty2-T1baIls6nbizg&oe=699C65D5"}, {"file_name": "vlcsnap-2025-01-03-19h10m49s550.png", "id": "594618446518426", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974647_594618449851759_8551514465278418675_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXGhBMhie0sQ7kNvwHIdunZ&_nc_oc=AdmBljrr3WSKs8lH_fe4241cZqO7cVjOBKVBXtIfBggIPiACRGEN8bkCOQMgknpFSA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvIg3oYH--rWfPfTJyfUT4RnjtW6fu-WnQrYAY1O-AWVA&oe=699C5AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-01-03-19h59m04s026.png", "id": "1034948138456558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196216_1034948141789891_1681670717283253087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYDmsNhUizcQ7kNvwEIAbTL&_nc_oc=AdmZSK5RatWqSHkKvIoA5v-USuaEvn-T8LJPxOC_7jF88c-KnflZA5cSN2z9ydtT5gA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuJkTupWM1zS_m2tSzbSCpNmEQjF1xcDzOTjpnxc0to0A&oe=699C5ED6"}, "display_name": "Going Loco", "keywords": ["Loco", "LowPoly", "City", "Puzzle", "Autohand"], "long_description": "Armed with spare bits of road, railway, and anything else to hand, take on the role of a city planner as you repair the routes for vehicles on your charming, low-poly city map.\n\nYour targets will travel at different speeds, and they may travel on custom routes, so you will need to get creative and build around their various requirements. You may need to block access one way in order to free up another, or send cars in a loop to let a bullet train pass through.\n\nThis charming puzzle game should be easy to learn, but hard to master in order to attain all the 3-star scores. Can you perfect every level??", "short_description": "Plug the gaps in the miniature city before the vehicles crash! In this charming puzzle game, you take the role of a city planner and must perform some last-minute engineering work on a low-poly street to keep the planes, trains and automobiles on track and on time."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.davidaddis.com/?page_id=61616", "developer_terms_of_service_url": null, "publisher_name": "David Addis", "support_website_url": null, "website_url": "http://www.davidaddis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "es", "uk", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8830267167091781"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1405663724431020"}, {"status": "PUBLISHED", "id": "894213716885184"}, {"status": "PUBLISHED", "id": "2057016198399719"}, {"status": "PUBLISHED", "id": "1353668919585144"}, {"status": "PUBLISHED", "id": "780774380985730"}, {"status": "PUBLISHED", "id": "642295451489751"}, {"status": "PUBLISHED", "id": "1794630658128542"}, {"status": "PUBLISHED", "id": "3952249618365809"}, {"status": "PUBLISHED", "id": "1898226403916697"}, {"status": "PUBLISHED", "id": "569249372671509"}]}, "baseline_offer": {"id": "3952249618365809"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1405663724431020"}]}, "liveChannel": {"nodes": [
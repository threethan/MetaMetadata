CE"}, {"file_name": "vlcsnap-2025-01-03-18h24m43s958.png", "id": "908904098023381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_908904101356714_432498181729218178_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43T5AayCOnAQ7kNvwFLj7PC&_nc_oc=AdqTMSsfo0jvELsC6eDZTYPTGrZDYC0dG_Spk19g1Fvmjmo-crOK4dW_QVZWBu11URM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEHY84WjlXDPRi_Ed4c0xG7PtFI079VoBiZJH_k7H0tQ&oe=6A7B3355"}, {"file_name": "vlcsnap-2025-01-03-19h10m49s550.png", "id": "594618446518426", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_594618449851759_8551514465278418675_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i4avQYZvUcQ7kNvwFj9MQa&_nc_oc=AdrSrQUdQtuu7dwFp4nLvJwtZe9xUxos4I9B9wotystgR3UyGhRKtgKsIJlmTOB8hoc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtOXe4sCLfXi3DsLso35kwB_sKlTRZ5xzjlPF9BtUZ4A&oe=6A7B2846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-01-03-19h59m04s026.png", "id": "1034948138456558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196216_1034948141789891_1681670717283253087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IcKf1umyoQQ7kNvwHeDL-k&_nc_oc=AdqYPWgu0WHV8IurpxiVcLMwkd7Uov523clSKbh8c4aB1w1kfCJdbg2JXvNl3-Ra7Dk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUJYHytrJ-tUcV4n3q5VO7sJQcYm0x2Sr_zuxet_d0sg&oe=6A7B2C56"}, "display_name": "Going Loco", "keywords": ["Loco", "LowPoly", "City", "Puzzle", "Autohand"], "long_description": "Armed with spare bits of road, railway, and anything else to hand, take on the role of a city planner as you repair the routes for vehicles on your charming, low-poly city map.\n\nYour targets will travel at different speeds, and they may travel on custom routes, so you will need to get creative and build around their various requirements. You may need to block access one way in order to free up another, or send cars in a loop to let a bullet train pass through.\n\nThis charming puzzle game should be easy to learn, but hard to master in order to attain all the 3-star scores. Can you perfect every level??", "short_description": "Plug the gaps in the miniature city before the vehicles crash! In this charming puzzle game, you take the role of a city planner and must perform some last-minute engineering work on a low-poly street to keep the planes, trains and automobiles on track and on time."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.davidaddis.com/?page_id=61616", "developer_terms_of_service_url": null, "publisher_name": "David Addis", "support_website_url": null, "website_url": "http://www.davidaddis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "es", "uk", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8830267167091781"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1485238440283026"}, {"status": "PUBLISHED", "id": "1328442742546849"}, {"status": "PUBLISHED", "id": "26790937377234961"}, {"status": "PUBLISHED", "id": "1285016053779133"}, {"status": "PUBLISHED", "id": "2139852780085938"}, {"status": "PUBLISHED", "id": "1405663724431020"}, {"status": "PUBLISHED", "id": "894213716885184"}, {"status": "PUBLISHED", "id": "2057016198399719"}, {"status": "PUBLISHED", "id": "1353668919585144"}, {"status": "PUBLISHED", "id": "7807743
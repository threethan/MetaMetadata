6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CSlmIKbhFqzzZzFcI7flVjDeB1rZNOtKIX8WkDJc2Bg&oe=6A25954B"}, {"file_name": "3000x900.png", "id": "477504658318918", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_477504661652251_3564749497542943158_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSufyaOti6cQ7kNvwHPZrh1&_nc_oc=AdqYL17Sn8co9tx-ThSVF0hyclnUT_XEKpMpP2xjKyc-y5RAvAhtaRayEaEb548QRFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EFUkiuai2h9sfxfw_D8oiuBjVOMukxc-HtFg53i2qsw&oe=6A2571FD"}]}, "id": "9503075863050459", "locale": "en_US", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-01-03-19h59m04s026.png", "id": "1034948138456558", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196216_1034948141789891_1681670717283253087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fT3dsOxA_cQ7kNvwEHe9dv&_nc_oc=AdobfCZeiUW3-BDiPIUlJjSKiFK6t-yKHFAJ7TgI7RS6wtD4byFCyk7V8TXF19jXgeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MI77f4ZWXWgdlkrI1u1OVR6CtQM9LEgcdf-hzMFjUAQ&oe=6A257AD6"}, "display_name": "Going Loco", "keywords": ["Loco", "LowPoly", "City", "Puzzle", "Autohand"], "long_description": "Armed with spare bits of road, railway, and anything else to hand, take on the role of a city planner as you repair the routes for vehicles on your charming, low-poly city map.\n\nYour targets will travel at different speeds, and they may travel on custom routes, so you will need to get creative and build around their various requirements. You may need to block access one way in order to free up another, or send cars in a loop to let a bullet train pass through.\n\nThis charming puzzle game should be easy to learn, but hard to master in order to attain all the 3-star scores. Can you perfect every level??", "short_description": "Plug the gaps in the miniature city before the vehicles crash! In this charming puzzle game, you take the role of a city planner and must perform some last-minute engineering work on a low-poly street to keep the planes, trains and automobiles on track and on time."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.davidaddis.com/?page_id=61616", "developer_terms_of_service_url": null, "publisher_name": "David Addis", "support_website_url": null, "website_url": "http://www.davidaddis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "es", "uk", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8830267167091781"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "26790937377234961"}, {"status": "PUBLISHED", "id": "1285016053779133"}, {"status": "PUBLISHED", "id": "2139852780085938"}, {"status": "PUBLISHED", "id": "1405663724431020"}, {"status": "PUBLISHED", "id": "894213716885184"}, {"status": "PUBLISHED", "id": "2057016198399719"}, {"status": "PUBLISHED", "id": "1353668919585144"}, {"status": "PUBLISHED", "id": "780774380985730"}, {"status": "PUBLISHED", "id": "642295451489751"}, {"status": "PUBLISHED", "id": "1794630658128542"}, {"status": "PUBLISHED", "id": "3952249618365809"}, {"status": "PUBLISHED", "id": "1898226403916697"}, {"status": "PUBLISHED", "id": "569249372671509"}]}, "baseline_offer": {"id": "3952249618365809"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status"
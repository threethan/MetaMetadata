771-25/604360590_2328954787640348_2382489687690566479_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyHRcLlkYd8Q7kNvwF_pJmj&_nc_oc=AdourT8DlstsjTnzvZGPXRYVSNLM2z8K7_2WzutG1owveZgR0skWGicdqrQFBHxPBME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjmGzhqUyS7Pj0KOswovwwJvnbbeEvMfZ9bRxM2_YscA&oe=6AF7134B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-2560x1440.png", "id": "2122624168657565", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673780696_2122624171990898_8069549209339665297_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuT623jLN3sQ7kNvwE-lQZL&_nc_oc=AdqsS7lNaeF1rYDhz9A69R2fwl2BaYN7SC0McjMSwnEcU39NrDqcgwVq-MYLClhxJWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC1AeeV3z0T76Ugmhg9zvFUNAK3KdZEo_fXmLZtqq_sQ&oe=6AF7450B"}, "display_name": "Untamed Horizons: Where The Monsters Are", "keywords": ["mmo", "mmorpg", "rpg", "creature", "taming"], "long_description": "VR Monster Taming MMORPG with a focus on pvp. go through all the portals, tame all the creatures, and then try your might against either the asynchronous pvp ladder, or try your might against the Endless Tower and see how far you can climb. heavily inspired by dragon quest monsters games. if you enjoy those games try out untamed horizons! \n\nmake friends in the social hub or duel them in casual pvp and see whos team is stronger.\n\nmin - max your monsters stats, abilities, damage output and resistances to make the best pvp team out there.\n\ntake your team online in asynchronous pvp, meaning even if other players are offline you can still battle them and their teams!\n\ntry your mettle at the Endless Tower and climb as many floors as you can for tons of gold.\n\nlevel up your players skills too such as mining or woodcutting, or do some casual fishing and cooking in the hub area and chat with friends.\n\n50+ monsters at early access launch with many more planned to come.\n\nlink to the discord if you want to join our community https://discord.gg/bCm8sE5pk3", "short_description": "VR Monster Taming MMORPG with a focus on pvp. go through all the portals, tame all the creatures, and then try your might against either the asynchronous pvp ladder, or try your might against the Endless Tower and see how far you can climb. heavily inspired by dragon quest monsters games."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1XuwfWDXWnZJoGt7eR5dR0_jtY3OZdHTDwuC6f0hbpLU/edit?tab=t.0#heading=h.p4glo93vazby", "developer_terms_of_service_url": null, "publisher_name": "propandaplays", "support_website_url": null, "website_url": "https://sites.google.com/view/untamedhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "2671062433348408"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604293968_1574269927777622_7087902503463121045_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahgZJIOAjmgQ7kNvwFwsxae&_nc_oc=AdplgxqF_rTAg69-sVthf7_uJztxi4ikNEZkrRFVlpt1dN-5rFhiOSh15ckapJITGfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYZ9d6jV2HmVKGxBmpuIJLLkCG7M6GI4C61MA9cA0Z_Q&oe=6AF72FDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "di
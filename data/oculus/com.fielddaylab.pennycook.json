tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP6PtAY3puUQ7kNvwEE1LK8&_nc_oc=AdoO6ZCU4bZJ8wtNlTIh7o5RWB7ItlyWhCHVVPXwtppH1rvCgsJ5xP1wJQJr_PxX2S0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOwtUQtrAMUbJNJBAzpzdhKkoztDjmgwfA1RoBzDzLlg&oe=6AFF26B2"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fzUXHpuZU4Q7kNvwGE1RST&_nc_oc=AdoUH0gqSHPoRnY_SClTSMY_pyBLjH2pZEQwZRbr-3F4tHW4i_WPMTor4HKGrmbBFBk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJF4FAE16KtLN2pcPGyAIvFynEspuF1oIAjGPwbFIj9w&oe=6AFF1778"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTA
339776310903673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307409_1339776314237006_8632260362703146994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKSUkfgv9O4Q7kNvwGAovQd&_nc_oc=AdrD77KJ3aXSrA6PVNTRkAvnKSupSrpVe8Xzxw0rr6PL2DcUM-_U9wCYgXsmcynXj84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81IWTIyiau1waRODDktD9WAeWghhWiQ4_T2DuIIvfSZA&oe=6A426962"}, {"file_name": "Hatched_03.png", "id": "24484639461122862", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301429_24484639464456195_7631946141578210305_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEBGgGxNm90Q7kNvwHBN7AR&_nc_oc=Ado5T9DhWX8OLJrVWqFFpvM0A_10c_auX9zZaPToiqz9R6Q9ZFbINeMgYU0UoaATsmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80QLTI1LbIrqCXBbKZU6JaC5wxJxComGGDl8QZ3qzSHg&oe=6A426F46"}, {"file_name": "Hatched_04.png", "id": "1881029276031320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830027_1881029279364653_3964510216392100534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndqfl7c_T5oQ7kNvwFv7Tts&_nc_oc=AdqPC3-Ov_6V2w3RxxZn7rIdL5jGdyZ9StKzZYBnwz32S-KXx8FWyb3GxUqqt6LXKYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pBjB2Bxw2iqVooBqfsxesdb8HXhbvlqOSZs4N9sGv5Q&oe=6A4267F2"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INq1L2VxBgsQ7kNvwGftUKc&_nc_oc=Adpq3WqYLHeabHte9eecxdntdFo06_HqdQxLwsJ5-wJa6ulxZ2b8sX8eeb8ETRs-LAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KP5SnVwoa0YRD87rRz-k7NPLUcWUnCNIx-Ht-jsNmvA&oe=6A4290F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24050239071239235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307426_684822167512363_1348678908411647040_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhkvtHMEC9oQ7kNvwGdKQ-Z&_nc_oc=Adphr7Fr9oDCrmedYLgSF6igZD0dWUzd-2IyUDUfN34_jNnnFaEP4ZWtAzQPdoEuRF4&_nc_zt=3&_nc_ht=
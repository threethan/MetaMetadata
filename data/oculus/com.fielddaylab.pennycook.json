339776310903673", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307409_1339776314237006_8632260362703146994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpAKZhI7ON0Q7kNvwHKSM3y&_nc_oc=AdrcJIStqvlqbtHvz-Y_kjFp0Bl6BbRo1LXCOABQQjm7ohQWX086dEkKs1kGJao3Ot8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10llQviTb8Yovet6TyABILc5WB4KyQvLAPq03V9Rsn7A&oe=69E62062"}, {"file_name": "Hatched_03.png", "id": "24484639461122862", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499301429_24484639464456195_7631946141578210305_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn4_WAxEHJsQ7kNvwF7Qfhb&_nc_oc=AdrUGYztfKprHwbG4hKVeqOfa9EMNSTdmv_iKRr6lSZZtcccIoUKhotu0TfhJIl1ZK8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QVw44nJvU-3JPO-0a7H3nu--yF728bp0jE9o9m3sDew&oe=69E62646"}, {"file_name": "Hatched_04.png", "id": "1881029276031320", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830027_1881029279364653_3964510216392100534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXDIK9SuNAUQ7kNvwHtCXuG&_nc_oc=Ado6O4XqsFGVaZGq01N8gmaKkYb1MZV0ywzNUPVXv2uM5C3YT9NKHV9-EIYOQn9NsLI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DNqRjgYTvXkm7wEtILFxGLG7Hz1AA_tYOYgvxW5egcQ&oe=69E61EF2"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBQkKtbIrH8Q7kNvwHAjupI&_nc_oc=Adr35_JtK3kCbUoVe3fD0Lau5Cm1SsTMFRr_x5AXHOVVWSORChD0Mu7NHsj8jGpup9w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kP94pbyRI5-i7CtYAWDxlJR5OjVXiETsEy3mxGQGVWg&oe=69E647F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24050239071239235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307426_684822167512363_1348678908411647040_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWDeRMhDPmwQ7kNvwGmvTHJ&_nc_oc=AdpcayU38VtHNfFROcLx5dUXp-4UzEM0FRHuuDTplat6rHTF_rpFJ3fFFVuG9yVjiAw&_nc_zt=3&_nc_ht=
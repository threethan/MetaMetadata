339776310903673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307409_1339776314237006_8632260362703146994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAjTg3Xm1qEQ7kNvwEtey4D&_nc_oc=Adpp6iIfXL7idFSdPBfCVZFtC_c8ge23svDEyV5gN-Voz-gpCjPSSoehIKxNjPl11Q8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92SVymQig1bqSlynT3QC6XP_er8D7vWFtZsVJevKWCoQ&oe=6A3572A2"}, {"file_name": "Hatched_03.png", "id": "24484639461122862", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301429_24484639464456195_7631946141578210305_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_3P2dX1uYUQ7kNvwGA2APN&_nc_oc=Adp0cSklCFw6uBLLk8pA7CGrtVs5W1aGQ6K8IcakEwJ0M3s19rbOaHWFhifERpeOZ3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cgzwPGWbFgPFagOHyCI_MlYwQmNvlt1NeTUuv-g5tjQ&oe=6A354046"}, {"file_name": "Hatched_04.png", "id": "1881029276031320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830027_1881029279364653_3964510216392100534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3oGD_0MCN4Q7kNvwGStrwW&_nc_oc=AdoHmVqup0uYsVu9yBKp4cRh8zGEbfcu_xG7EKenemlPyNttjiPcZ2nUbmmSdzeH9Qo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SuiyfyqotqQ33-jFQhgcH6gAFJkN80bHl5HImf2Bi3Q&oe=6A357132"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBHgs_fIqDgQ7kNvwGgfXHy&_nc_oc=AdrR9_HawP6Bkb90AQdDd69IqyC994KBd53_jLGkQfnF-3ujvjpkghv5M3nu-KAZsm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6lSKEqWHLCITvRw9c32UKSVjAOmgrNtVeTMg22C4a0A&oe=6A3561F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24050239071239235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307426_684822167512363_1348678908411647040_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXgSaIptubUQ7kNvwGZIKZx&_nc_oc=AdpqUXKIvhGac-AmnhPfg2JZIhLsVYHk9SVIg0sionLgyPjw9X9aNkqyEV-3h4i9o2w&_nc_zt=3&_nc_ht=
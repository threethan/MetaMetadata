": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307409_1339776314237006_8632260362703146994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOQH85-13EMQ7kNvwHo0IAc&_nc_oc=AdlOYON7JNVfK6XeYszDe3PDE_3KCfbXsFbC1V83Z9MGFZriOIA0MW8jh10sMYm7_1g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjW6j5VzdBiL8bcGJDOvKrStQh4mDXcrEyaOdpQQEsPg&oe=69AACCE2"}, {"file_name": "Hatched_03.png", "id": "24484639461122862", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499301429_24484639464456195_7631946141578210305_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUKQ4KUccIsQ7kNvwEv5LUj&_nc_oc=AdkhNYFbn2IynSkmE0zF3Y7NzKt4O2cIYIjU--r9-TURTFHrbZmlJJNG-_MSNKiDKxA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxL6ZewrMFkRAJIBRA_moCgpKt9gL8xf66dTiXNuZswKQ&oe=69AAD2C6"}, {"file_name": "Hatched_04.png", "id": "1881029276031320", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830027_1881029279364653_3964510216392100534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5gHa0iTJjUQ7kNvwEchdlL&_nc_oc=AdnSFfQJkyqR160glwiGTogwdl8Tmmwxs0cun_dnHfmx-YK2bLKwc94268Gk8YvD-a8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZxT4dJKggzi6Dd9H7s2S-qww2ow4JZOkoVbjPKnah_A&oe=69AACB72"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKmz3y37LagQ7kNvwHcXpSz&_nc_oc=AdngkUt8YXU0auWUCHVNGittoMbUteR6GsfqiWm_-3KCQqaDSYkciO8jRXP_5UNMH5o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC5tgC768JekSTboZKMRixgrF2j9j5OD3pK7ub4MfGOQ&oe=69AABC38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24050239071239235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307426_684822167512363_1348678908411647040_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUQ3B_qm4H8Q7kNvwFsyDQ9&_nc_oc=AdkFGD8LSGfsuM-Wf8jap0b_y_sMTQicUuM0W7bMyw_4I5CWO-0mh507hLM-0l9_Wrw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_n
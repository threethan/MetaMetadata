339776310903673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307409_1339776314237006_8632260362703146994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CewzH6R3C5cQ7kNvwFjl80B&_nc_oc=AdrmGcBZ7OfgZ43vBwWJNfZ0ZMiJFvePkWg2I6LKEzCrSd4Nr_rz4aFtVvr0U0KagTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FLaPloEhnRoc0Wu3fWS_T5ZcVj0nynwXLtWGIPfnkPQ&oe=69E4CEE2"}, {"file_name": "Hatched_03.png", "id": "24484639461122862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301429_24484639464456195_7631946141578210305_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYsHifUh-sUQ7kNvwHC4Vpb&_nc_oc=AdpShwF3MJwU2UFJ5zL7Vyv4K0R-BWWb94Q3vf6zVnOm_yXJ9fobG6WqUDKfQhgVw_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vY60GkafwGWlSdZe_K7dzUocx2Tdx9PfGXhUZC__apg&oe=69E4D4C6"}, {"file_name": "Hatched_04.png", "id": "1881029276031320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830027_1881029279364653_3964510216392100534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXDIK9SuNAUQ7kNvwE0acyq&_nc_oc=AdrPvWG-1dMyCBjYDHn9zFQaq7p2oDAOtXKBkzTbSt6EQmvyzwU_2NRnYXhcHDXC1H0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZgK6ZaaTUAzui3-rDiI5QQ7a79RXKxNrDkw_RAW298w&oe=69E4CD72"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBQkKtbIrH8Q7kNvwH6Dada&_nc_oc=AdoQpaOaVgMs9E0MMKDJgD1bE5DzNvptCbBzsUtyyOd-bxmxKJZfc6gj2jvkMuWU-c8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13ldJii4F5GQY9tYPNHSc59DpqxkQZ9fWCH1jFGaln0g&oe=69E4BE38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24050239071239235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307426_684822167512363_1348678908411647040_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWDeRMhDPmwQ7kNvwFdy_xX&_nc_oc=AdpXXBsNNOZiV66o2sL1mOI-ol7-7C9RpqoOVXyDMUIaNbaeHMBn4I9XQXeVGrUfLlg&_nc_zt=3&_nc_ht=
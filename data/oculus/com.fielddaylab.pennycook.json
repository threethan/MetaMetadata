tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnkftbfXBF8Q7kNvwFt4BYe&_nc_oc=AdooVd4rOKrcrvUHX9frsoAgtdbCVWW4ouAiq59_5DhH-RA-NM8BtC92u1DLjOPC9eQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGASCyLUZPXfo8DkWvMsD7vF5Ji5ZJYJMbm6zX7CoW4A&oe=6B09B2B2"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOg9nLmTcqQQ7kNvwELu55O&_nc_oc=AdqHNVIK1JVHCBKArm2BWrTQVroqDPOwkYXhUV-PNTs6kxu7tBI3uLUHyGLRmAgNcLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr-v8rCW82o8zfxmXJK2hYmQ4YHEviLY1MQqMnIrpQxw&oe=6B09A378"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTA
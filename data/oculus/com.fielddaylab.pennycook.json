339776310903673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307409_1339776314237006_8632260362703146994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKLdr3JjjMwQ7kNvwEYNaSC&_nc_oc=AdpOwQdVODevUI55c7w677jtjKoh8Tbr4cFDPtauOEDEwgxrT7skrslKHO0r8LkiasU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cMYrgCA19A0URdvo3eE_krNzlmPNeycmdtjdv-Wq9AA&oe=6A47AF62"}, {"file_name": "Hatched_03.png", "id": "24484639461122862", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301429_24484639464456195_7631946141578210305_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3bcMvRpvV0Q7kNvwEj5JIK&_nc_oc=AdrkaYx5SnCE7N2d3GPFOg1hntgvrVpWeaBXEjuZmIMNVwDhhdVRx_feu2X7e-Um0YU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YXO0EjEQBlVYruyj3fCN8vHviK5B9NxYcPigdJzPUCg&oe=6A47B546"}, {"file_name": "Hatched_04.png", "id": "1881029276031320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830027_1881029279364653_3964510216392100534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6LdG1QgDkQQ7kNvwFvaKjD&_nc_oc=Adog02Tm7c-7FWnv8MJeSE2zqyNm4OV2YVR4Fe-vEOEMh6Wp9-9KPto88DNUMUHVjr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RiLy2g6jNvFYGERFoCeaZuUqJMS4s4i7ME0XBky8-gA&oe=6A47ADF2"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOkQ0SZtqCQQ7kNvwEleO_N&_nc_oc=AdqUs3Yzc7wPocp_0IzowMyAGQX_4jL__8Q-Lne3QTmWTiGIXWzkN_Xhxk-z1_PG-NI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4GyLVxXaXa-utNwYFvmrtxMknQ4N2IbVZ49SKd7h5Gg&oe=6A47D6F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24050239071239235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307426_684822167512363_1348678908411647040_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU8hYIpG8HcQ7kNvwHFaWXC&_nc_oc=Ado4yzMP8p1KDPLU99MJpY1Ene-7bOujVlV_CIUIIe_5QeKVLEIkLx1iOMVmiMb2CcQ&_nc_zt=3&_nc_ht=
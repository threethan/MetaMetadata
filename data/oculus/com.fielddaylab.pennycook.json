tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB5rzXzG-yQQ7kNvwEPvP5V&_nc_oc=Adr4OD_1wwkuBm6HfWUsPlG5qs98Ac1QSi8oPxTP3sK7fwt69hHI6sNU997D2byfj0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE5KjjaFUSIYrFk7x8R_BZwbQDVL0g8tg99iYy5jTNtA&oe=6B007832"}, {"file_name": "Hatched_05.png", "id": "1162370465902535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827282_1162370469235868_8002999096476321569_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35dk7QZ788AQ7kNvwE3e_5p&_nc_oc=AdrdczY5B1jVvIK1-yI6m6-EzIi2O8NQOINjsUeD0ZFv6IvWh5ToXmJC17hOoH_VrrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaLrMRIqrkokwRHgkMHEYNEUp6leRmgep9I8VbSPnynw&oe=6B0068F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ice: Hatched", "keywords": [], "long_description": "In On the Ice: Hatched, you play as a novice wildlife biologist making your first visit to Ross Island in Antarctica to study Ad\u00e9lie penguins. Your daily research tasks, such as conducting population counts, placing identification bands, and removing GPS trackers can be challenging - especially when the penguins don\u2019t cooperate. But don\u2019t worry, you\u2019ll have Margo, your trusted digital assistant to guide you. The game takes place across a single research season and mirrors the tasks that real scientists do as they study how Ad\u00e9lie penguins behave and interact with each other. ", "short_description": "On the Ice: Hatched: Experience what it\u2019s like to be a wildlife biologist as you spend a season in Antarctica studying Ad\u00e9lie Penguins. "}]}, "developer_name": "Field Day Lab and WID Virtual Environments", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Field Day Lab", "support_website_url": null, "website_url": "https://fielddaylab.org/", "category": null, "comfort_rating": "COMFORTA
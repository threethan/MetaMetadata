tent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Q282OGzwKHFYxNrAZzpHU5yZdUIqtnX1e0cglB9Oyg&oe=6AFDB983"}, {"file_name": "09 Screenshot 4 _ 2560 x 1440.png", "id": "1149830847568371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620655_1149830850901704_2389408819261446081_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPUiygw9gUQQ7kNvwEBGV-w&_nc_oc=AdqGkVivLzzrGYQPSkFvRSZ_Fue70vKD_5EtNcee7TYpiL01Ep2DoyzFrozjSeOpG78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTniGA5cx8M4NlHr7pj7QoS9xyfxHQ864rM86uvcVMflw&oe=6AFDD94F"}, {"file_name": "06 Screenshot 1 _ 2560 x 1440.png", "id": "29471249952500008", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628456_29471249955833341_8639096856181296482_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApVyJPd4IBYQ7kNvwF7zIp8&_nc_oc=AdpucUJ1GBarHSxHRxtw8ohZ-6Z3V0FFWeErwnV8eWfOjesVrvPFj2edx2VrpYil55Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj_R_05To-zlBDsw7DBhayIpYB4s5SHnxBv_nbAqO9HQ&oe=6AFDB3F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "3774173732714777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624990_3774173736048110_693389813634129345_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyfsjdNcd9oQ7kNvwFAFo7F&_nc_oc=AdrK4iCVLo9zdNQJV8cpV_EewGaFaXjHzqUofUdAhPA5CXNtfYoo6Xnrs_O5P5WI8Xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_F1AocHm4kknDh0tYhjzRkZKY0JeGHjrw1qA6iJAhwg&oe=6AFDC19D"}, "display_name": "Work At Height - Safety Training", "keywords": ["Height", "Training", "Safety", "Work", "AutoVRse"], "long_description": "Falls from height remain one of the leading causes of serious workplace injury. Work at Height lets your team build the right habits in VR, where a wrong step teaches a lesson instead of causing harm.\n\nTrainees step onto a realistic elevated worksite and work through the task the way they would on the job. Inspect the harness and lanyard, check the work area for hazards, select a safe anchor point and clip on before moving to the edge. Each step follows the standard operating procedure, and every action is tracked so trainers can see exactly where someone hesitated or skipped a check.\n\nWHAT TRAINEES PRACTISE\n\u2022 Pre-use inspection of harness, lanyard and connectors\n\u2022 Hazard identification around edges, openings and access points\n\u2022 Correct anchor point selection and tie-off\n\u2022 Step-by-step safe work procedure for elevated tasks\n\u2022 Consequences of unsafe choices, shown safely in VR\n\nWHY IT WORKS\n\u2022 Hands-on practice that builds muscle memory, not just awareness\n\u2022 Consistent training every time, across every site and shift\n\u2022 Clear performance feedback for trainees and supervisors\n\nWork at Height is part of the AutoVRse library of industrial safety training, trusted by teams that need training to translate into safer behaviour on site.", "short_description": "Practice working at height without the risk. Work at Height puts you on elevated platforms in full VR to inspect your harness, pick the right anchor point and follow each step of the safe work procedure. Make a mistake and see the consequence, not the injury. Built by AutoVRse for industrial teams that need safety training that sticks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs-vrsebuilder.autovrse.app/privacy/work-at-height-safety-training", "developer_terms_of_service_url": null, "publisher_name": "AutoVRse", "support_website_url": null, "website_url": "https://autovrse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet
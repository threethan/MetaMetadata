piwKPnrOr46rCMY0OPAYfuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzLXOaGkd9sAo_yVao286aCAAj4w7WzAYLGUghgo4FxQ&oe=6A8C2A83"}, {"file_name": "8.png", "id": "1535131467590915", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1535131470924248_7326328303395485978_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8NCvICI6m0Q7kNvwEynyvF&_nc_oc=AdpQLZ1N65-6AkAIFUwUAvTzV9UDOokQloHL1iNkN2vshriJZtTgQu5799bdT4lQpmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZW2pEFjmd5O4rVQ_qRdfDcaclqZKTbE48gshRtfrqVQ&oe=6A8C158C"}, {"file_name": "10.png", "id": "930560302981583", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_930560306314916_4651222137203722591_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJGShepHB_4Q7kNvwEkiMN-&_nc_oc=Adpvd2hwNGLWundjL3KqugIZB2YpBgTzhXl_O5dYzTcwcQFJDlfIfvGO5_N98uO3pp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeqv4q8Zz45u219sd5rPkrcSChmIunp0Ia_YIjnPwkXg&oe=6A8C14B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20260210_ukyo_2560x1440.png", "id": "2267930563734158", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_2267930567067491_8863090605884709555_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tLlKJg9TcEQ7kNvwH_mmIM&_nc_oc=AdqlSClj2KP_1aHu8Mkt4JAXSVJ9KnBM-OLqg5xrJqLYBM0N77LTfDOYEP2-l7reKJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwYRY3wAw3IHNhL4I6UnEMgWkxIcvs8LHZqoJumLi0jQ&oe=6A8C15EE"}, "display_name": "Fit River XR : Rowing Cardio Meditation", "keywords": ["Rowing", "Workout", "Cardio", "Fitness", "Nature"], "long_description": "# Embrace the Flow. Fit River XR.\n\nTrade the gym for a serene river. Fit River XR is a mindful rowing experience with no rhythms\u2014just you, the water, and your paddle.\n\n**Your Workout, Your Time**\n\nSet your timer to fit your day:\n\n* **3 Mins :** Quick mental reset.\n* **5 Mins :** Relaxing flow.\n* **7 Mins :** Deep immersion.\n\n**Choose Your Atmosphere**\n\nPick scenery to match your mood:\n\n* **Morning:** Fresh mist.\n* **Evening:** Peaceful sunset.\n* **Night:** Moonlit stillness.\n\n**Real Results**\n\nEngage your core and arms with real rowing. Track distance and calories in real-time. Low-impact cardio that is rewarding for your soul.\n\n**Key Features:**\n\n* **Scenic Focus:** Pure nature.\n* **Flexible Timers:** 3, 5, or 7 mins.\n* **Atmospheric Modes:** Morning, Evening, and Night.\n* **Stats:** Real-time distance and calorie tracking.\n\n**Find your flow today with Fit River XR .**\n", "short_description": "Fit River XR: Mindful VR Rowing Escape to serene rivers. A peaceful rowing experience with no forced rhythms\u2014just you and the water.\n\nFitness on Your Terms Set your timer and pick a session for your day:\n\n\u30fb3, 5, or 7 Minutes: Pick your duration.\n\u30fbAtmospheric Modes: Morning mist, Evening, or Night.\n\nReal Results Engage your core and arms with real rowing. Track distance and calories in real-time. Low impact, high reward.\n\nFind your flow with Fit River XR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes"
t-iad6-1.oculuscdn.com/v/t64.5771-25/491821941_902177592227438_9011808140208913437_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adKPSP0UqW4Q7kNvwF3msD9&_nc_oc=AdoUHwv-iJYQ-YGTegzHFuj4w7dGkoqtJwfkhVcNwjSRQdnec0QZp4fuVL1gBEXezc4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFmUqa7U51EjQ37dbPrxnvnu6P-hroiUHXYzBn5q89fQ&oe=6AEB4EC3"}, {"file_name": "8.png", "id": "1535131467590915", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1535131470924248_7326328303395485978_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QgMom3mn6MQ7kNvwGa7dsL&_nc_oc=AdpBElb3yyz_t1UkTUpV0TsK7fOyue1i3uurlTA47AKhudramSqibwOp_bSBSvNhzZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHRvyDAAquEzzJeVxsUt8Tj62K7F4DZtMxDBawtN3BAw&oe=6AEB39CC"}, {"file_name": "10.png", "id": "930560302981583", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_930560306314916_4651222137203722591_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip6J2i8FOfUQ7kNvwHGaro8&_nc_oc=AdoWnLr_vtXFDUZ3Smh5kQ4qmM5GNhfFDwDlz4CQ-O61joNY4aJH1sOTbT7hParRLKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpKVW2UD46rvOeu-qaBztks3RskVIr1K1_4kQuahmKYg&oe=6AEB38F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "2151024272292159", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628108_2151024275625492_2405732582427966217_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2ICR1J-ZOsQ7kNvwGUu6La&_nc_oc=Adq4DIuXIiwqnN8hp4q-Tm8XvBCMfULHzIpD-wSCGfAPQl-HVrawEGi8T30qo4Q5oLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8UAbeem3Opu1uqzLU9Qkc4QWJ20zwx3Boy-FjQAMlDw&oe=6AEB52A9"}, "display_name": "Fit River XR : Rowing Cardio Meditation", "keywords": ["Rowing", "Workout", "Cardio", "Fitness", "Nature"], "long_description": "# Embrace the Flow. Fit River XR.\n\nTrade the gym for a serene river. Fit River XR is a mindful rowing experience with no rhythms\u2014just you, the water, and your paddle.\n\n**Your Workout, Your Time**\n\nSet your timer to fit your day:\n\n* **3 Mins :** Quick mental reset.\n* **5 Mins :** Relaxing flow.\n* **7 Mins :** Deep immersion.\n\n**Choose Your Atmosphere**\n\nPick scenery to match your mood:\n\n* **Morning:** Fresh mist.\n* **Evening:** Peaceful sunset.\n* **Night:** Moonlit stillness.\n\n**Real Results**\n\nEngage your core and arms with real rowing. Track distance and calories in real-time. Low-impact cardio that is rewarding for your soul.\n\n**Key Features:**\n\n* **Scenic Focus:** Pure nature.\n* **Flexible Timers:** 3, 5, or 7 mins.\n* **Atmospheric Modes:** Morning, Evening, and Night.\n* **Stats:** Real-time distance and calorie tracking.\n\n**Find your flow today with Fit River XR .**\n", "short_description": "Fit River XR: Mindful VR Rowing Escape to serene rivers. A peaceful rowing experience with no forced rhythms\u2014just you and the water.\n\nFitness on Your Terms Set your timer and pick a session for your day:\n\n\u30fb3, 5, or 7 Minutes: Pick your duration.\n\u30fbAtmospheric Modes: Morning mist, Evening, or Night.\n\nReal Results Engage your core and arms with real rowing. Track distance and calories in real-time. Low impact, high reward.\n\nFind your flow with Fit River XR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
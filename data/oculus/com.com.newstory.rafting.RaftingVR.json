5771-25/499618297_1535131470924248_7326328303395485978_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4FLsVStMVoQ7kNvwF7eS5U&_nc_oc=AdqI9PR0w5akz51olunjnJpsQe9NmkMoTg_NoN3KhW_NVZwnnzOZx8kRqwYmWchFB_s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzn4PBiF6CK7IwGEo8x9qzQ4KKE6hMryz7825Ia5GnSw&oe=6A71EFCC"}, {"file_name": "10.png", "id": "930560302981583", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618102_930560306314916_4651222137203722591_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HesSYdE27tEQ7kNvwFUcg30&_nc_oc=AdqTjEaj41GbflB6vh0HyVI4dFyeVb5GXlORIgX_gG_q_nrtZaSJ0Gq41c3Rl0B6mCU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKI6PbaTom8r2aZqTx_8nQXa19FluPXE12TcgkfLHrVg&oe=6A71EEF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20260210_ukyo_2560x1440.png", "id": "2267930563734158", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619704_2267930567067491_8863090605884709555_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55Ds5gk848QQ7kNvwEWZMXS&_nc_oc=AdqG7PJwKYDwVcbXBATq5-A_P6M1gFuUgwbPQIOavx88bZ1Yfw78ZM4g1nxg-vzfD4Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8q2B_xsQXvx9xEsvDyGCGAKEw37GZzUZZUChARyhFOQ&oe=6A71F02E"}, "display_name": "Fit River XR : Rowing Cardio Meditation", "keywords": ["Rowing", "Workout", "Cardio", "Fitness", "Nature"], "long_description": "# Embrace the Flow. Fit River XR.\n\nTrade the gym for a serene river. Fit River XR is a mindful rowing experience with no rhythms\u2014just you, the water, and your paddle.\n\n**Your Workout, Your Time**\n\nSet your timer to fit your day:\n\n* **3 Mins :** Quick mental reset.\n* **5 Mins :** Relaxing flow.\n* **7 Mins :** Deep immersion.\n\n**Choose Your Atmosphere**\n\nPick scenery to match your mood:\n\n* **Morning:** Fresh mist.\n* **Evening:** Peaceful sunset.\n* **Night:** Moonlit stillness.\n\n**Real Results**\n\nEngage your core and arms with real rowing. Track distance and calories in real-time. Low-impact cardio that is rewarding for your soul.\n\n**Key Features:**\n\n* **Scenic Focus:** Pure nature.\n* **Flexible Timers:** 3, 5, or 7 mins.\n* **Atmospheric Modes:** Morning, Evening, and Night.\n* **Stats:** Real-time distance and calorie tracking.\n\n**Find your flow today with Fit River XR .**\n", "short_description": "Fit River XR: Mindful VR Rowing Escape to serene rivers. A peaceful rowing experience with no forced rhythms\u2014just you and the water.\n\nFitness on Your Terms Set your timer and pick a session for your day:\n\n\u30fb3, 5, or 7 Minutes: Pick your duration.\n\u30fbAtmospheric Modes: Morning mist, Evening, or Night.\n\nReal Results Engage your core and arms with real rowing. Track distance and calories in real-time. Low impact, high reward.\n\nFind your flow with Fit River XR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33783123801330944"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617831_2278803185941529_1738410714035997194_n.png?stp=dst-png_s
id": "902177588894105", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821941_902177592227438_9011808140208913437_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBAmUHbuYq4Q7kNvwGEprU1&_nc_oc=AdoFer-Vw5FLNLHCrOXytj5NVwNK5Mu1tF3wiolBn6qNJRCRrGw-SBG6wkWuvIRfS5I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKun3HW5joe1XmCAkrbSubsbdHTXQqNwubuHcn1Sajdyw&oe=6AAEA9C3"}, {"file_name": "8.png", "id": "1535131467590915", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618297_1535131470924248_7326328303395485978_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xomweo3kvL4Q7kNvwEezxia&_nc_oc=Adrz6Lr_mk3h3aR8ZrwPj9c8LW5myzYgkCuFShjvSH15qN7kZO7eYj9SzkGxr_YePNg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHkhnaknr_MS4Rrqakppl63MSVtl_ubisVh3Bj-ouniw&oe=6AAE94CC"}, {"file_name": "10.png", "id": "930560302981583", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618102_930560306314916_4651222137203722591_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcKfROB79l0Q7kNvwFKtYZS&_nc_oc=AdozioPJgpI-kpWhxsYTa4fVNB8kEiycYPlfXmrRxUDf2XduLb6XCR5vb0MkclX1T14&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-lPjx5LbgTLeM8RzLAGJMMzgFm2bzO9B-00zrft4Ytg&oe=6AAE93F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20260210_ukyo_2560x1440.png", "id": "2267930563734158", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619704_2267930567067491_8863090605884709555_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdNUPmTOmRsQ7kNvwH4hgMp&_nc_oc=AdrS2JSv24s_DwEgp4fKauKyHrN2CKfohoVWHktaw3HSt22jWkfLqgU5nEVZpt3AdFg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRD16j2vR5CFSOWJQDPrPzV4BIZ0OXqM1LYqqYV7c4Og&oe=6AAE952E"}, "display_name": "Fit River XR : Rowing Cardio Meditation", "keywords": ["Rowing", "Workout", "Cardio", "Fitness", "Nature"], "long_description": "# Embrace the Flow. Fit River XR.\n\nTrade the gym for a serene river. Fit River XR is a mindful rowing experience with no rhythms\u2014just you, the water, and your paddle.\n\n**Your Workout, Your Time**\n\nSet your timer to fit your day:\n\n* **3 Mins :** Quick mental reset.\n* **5 Mins :** Relaxing flow.\n* **7 Mins :** Deep immersion.\n\n**Choose Your Atmosphere**\n\nPick scenery to match your mood:\n\n* **Morning:** Fresh mist.\n* **Evening:** Peaceful sunset.\n* **Night:** Moonlit stillness.\n\n**Real Results**\n\nEngage your core and arms with real rowing. Track distance and calories in real-time. Low-impact cardio that is rewarding for your soul.\n\n**Key Features:**\n\n* **Scenic Focus:** Pure nature.\n* **Flexible Timers:** 3, 5, or 7 mins.\n* **Atmospheric Modes:** Morning, Evening, and Night.\n* **Stats:** Real-time distance and calorie tracking.\n\n**Find your flow today with Fit River XR .**\n", "short_description": "Fit River XR: Mindful VR Rowing Escape to serene rivers. A peaceful rowing experience with no forced rhythms\u2014just you and the water.\n\nFitness on Your Terms Set your timer and pick a session for your day:\n\n\u30fb3, 5, or 7 Minutes: Pick your duration.\n\u30fbAtmospheric Modes: Morning mist, Evening, or Night.\n\nReal Results Engage your core and arms with real rowing. Track distance and calories in real-time. Low impact, high reward.\n\nFind your flow with Fit River XR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
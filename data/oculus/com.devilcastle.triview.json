9"}, {"file_name": "TRIVIEW_Screenshot_01_2560x1440.png", "id": "1104515365491754", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593983210_1104515368825087_7529639079388194765_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymUQMEGWz0oQ7kNvwFVgT8S&_nc_oc=Adp0lKp5Gr7qvyOA_BzDnZJn7jkbDLzzfFL5ntLGCNQ84aje1RYHx9OpitejaiUWx9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRerLfO7zjMKhMZuqg0mATt7EenlX4BENb8gy0TEyAYOw&oe=6B047DD2"}, {"file_name": "TRIVIEW_Screenshot_05_2560x1440.png", "id": "1803540707344745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622186_1803540710678078_5439726958705785655_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XkE7cSZNEUQ7kNvwG6z18g&_nc_oc=AdpyR1u2POOuzuG_-uuakcnlZ5G0PLqEFwgigmJ_bs4r97E8vxvLVKGWz96M9W2Lx1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS24Pw150popyipOPWVTzS3-9yZMThlhUq7Wj0xrV04kw&oe=6B046BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRIVIEW_Cover_2560x1440 (1).png", "id": "1150526130988442", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619404_1150526134321775_6791574060501203380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqOdGhMcIwIQ7kNvwE24vtO&_nc_oc=AdoNJp0msWdqWXOIPbJW_DrfAW69gClwVE4U_j7b48WBdyn2ujsSoGd74mjhHAKoO5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZl-iuOvb8_5dF-5Haa4lhEc07Ze8DjjUW4c0oKD9n7g&oe=6B04829C"}, "display_name": "TRIVIEW", "keywords": ["mixedreality", "spatialpuzzle", "puzzlegame", "3dpuzzle", "relaxing"], "long_description": "TRIVIEW is a relaxing mixed reality spatial puzzle game built around one simple challenge: make three views match at the same time.\n\nBuild a 3D structure from puzzle pieces and match its front, side, and top projections to the target patterns. Every piece affects multiple views, so a move that fixes one projection may change another. Observe carefully, experiment with different arrangements, and think in three dimensions to find the solution.\n\nDesigned for mixed reality, TRIVIEW brings the puzzle into your physical space. Pick up and place pieces, examine the structure from different angles, and solve each puzzle at your own pace.\n\nThere are no timers and no need to rush. TRIVIEW is designed to be a quiet and thoughtful experience \u2014 something you can sit down with when you want to slow down, focus, and relax after a more intense VR experience.\n\nObserve the projections. Build the structure. Make all three views match.", "short_description": "Build 3D structures in mixed reality and make their front, side, and top projections match the target patterns."}]}, "developer_name": "Mage", "developer_privacy_policy_url": "https://triview-bcp.pages.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mage", "support_website_url": null, "website_url": "https://triview-bcp.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "ko", "fr", "de", "es", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1376045608921481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593862973_2550015722165639_31381940006434600_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_v0u5whsTYQ7kNvwGwEc
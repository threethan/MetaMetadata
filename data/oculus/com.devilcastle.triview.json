9"}, {"file_name": "TRIVIEW_Screenshot_01_2560x1440.png", "id": "1104515365491754", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593983210_1104515368825087_7529639079388194765_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPe1d3E5e4gQ7kNvwF7zxgG&_nc_oc=AdpsPK9AY_lLonoqtZnTAsWmKzSM9g18OMPXemP0hgomM05EeRzDQDavJKY0aOEY8h4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5f9iixt6cYHfxw8OJB0le19UYFSa4_Fx8z8wUnWUrWA&oe=6B0720D2"}, {"file_name": "TRIVIEW_Screenshot_05_2560x1440.png", "id": "1803540707344745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622186_1803540710678078_5439726958705785655_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFaVomkSbuYQ7kNvwHZ8D01&_nc_oc=AdoWSuzQeoeSAxyUI18pAr8XmNfd4uJEFeYDe5mTOqPsqP0ZbeWPZgG-62LVBKAksIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuKiHT8e8gBrj3dT21ahNglqwU093NeA2CzToC3Ue7hg&oe=6B070EA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRIVIEW_Cover_2560x1440 (1).png", "id": "1150526130988442", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619404_1150526134321775_6791574060501203380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asRyc-AZOBQQ7kNvwGZfrYF&_nc_oc=AdqghSFWoYb61Nj7P-ZmdMi-Se6QXW95p2pw6NlQPttBydvJCboJNLQlLJGzzKI34I4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBJkvjA_m7xMEGUt0XGxOZbMIf6DEKi-rFDGE7P7jc2Q&oe=6B07259C"}, "display_name": "TRIVIEW", "keywords": ["mixedreality", "spatialpuzzle", "puzzlegame", "3dpuzzle", "relaxing"], "long_description": "TRIVIEW is a relaxing mixed reality spatial puzzle game built around one simple challenge: make three views match at the same time.\n\nBuild a 3D structure from puzzle pieces and match its front, side, and top projections to the target patterns. Every piece affects multiple views, so a move that fixes one projection may change another. Observe carefully, experiment with different arrangements, and think in three dimensions to find the solution.\n\nDesigned for mixed reality, TRIVIEW brings the puzzle into your physical space. Pick up and place pieces, examine the structure from different angles, and solve each puzzle at your own pace.\n\nThere are no timers and no need to rush. TRIVIEW is designed to be a quiet and thoughtful experience \u2014 something you can sit down with when you want to slow down, focus, and relax after a more intense VR experience.\n\nObserve the projections. Build the structure. Make all three views match.", "short_description": "Build 3D structures in mixed reality and make their front, side, and top projections match the target patterns."}]}, "developer_name": "Mage", "developer_privacy_policy_url": "https://triview-bcp.pages.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mage", "support_website_url": null, "website_url": "https://triview-bcp.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "ko", "fr", "de", "es", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1376045608921481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593862973_2550015722165639_31381940006434600_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quLEkCkUk98Q7kNvwEQJf
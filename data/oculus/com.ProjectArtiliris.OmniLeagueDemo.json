uluscdn.com&_nc_ss=7f20f&oh=00_AQLePM7-ZxHdqdF4QIWEhdh1CgydF4SfJ_dYabhOOgvugA&oe=6ABBDC60"}, {"file_name": "img 5.png", "id": "6622167871219325", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_6622167874552658_3944120277002151882_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LYvuVPOV8MQ7kNvwEBOVPo&_nc_oc=AdooSyAK6sA_1GFuUEH--MUagVC2fpfZ59SnpoxoK4lrMaYY-iCjCh9YPxo40eAVZBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITmSw6BcKQqUpcWUqFSwlZ1Pi54qEN3Y0DkwueXI-UpA&oe=6ABBCEDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Omni League Demo", "keywords": [], "long_description": "Omni League is a VR Element Bending game where the players work together as a team of 2 or 3 against other players or go 1v1 with the goal of getting the most points on different game modes.\n\nCombine different elements to produce more powerful attacks and establish synergy with your teammates!\n\n[Demo] Game Modes:\n\nPillar Attack Play as a team of 2 or 3 and defend your team's Pillar while attacking the opposing team's Pillar to win the match.\n\nElements:\nEarth\nFire\n\nGame Modes:\nPillar Attack\nCapture the Flag Play as a team of 3 to get the opposing team's flag, while defending yours.\n\nDecide on how you and your team will work together to get the most points and win the match.", "short_description": "Omni League is an Element Bending game where you play as a team of 2 or 3 against another team or play in a 1v1 to win the match!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.projectartiliris.com/omni-league/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Project Artiliris", "support_website_url": null, "website_url": "https://ProjectArtiliris.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}
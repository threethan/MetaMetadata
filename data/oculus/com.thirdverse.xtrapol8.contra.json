-2.oculuscdn.com/v/t64.5771-25/57569475_631782495840706_1805589523499274930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-RpBWIAiXoQ7kNvwENTP6_&_nc_oc=AdkZqf4LsEskW3TlshqEtBck0chYqzPoiDCPhK6iAxMagPACbLKW28kJr3bqdf4Ct7M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuFx2AZd5h9kzmcUU_TMuFCw6_idlrxLbhlrVLwZqX8ew&oe=69A570BD"}, {"file_name": "5_Superwall fighting 2560 x 1440 (1).png", "id": "2223483651387624", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982458_2223483654720957_5962593182127291533_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohALsEWhAlcQ7kNvwEKQtpL&_nc_oc=AdnZYg0ZkskIiB-Q8qUbqOZKj920utmOQWHqrCu1Hv4reXPqmpjGDcuy65_HrGXVJ6I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuZcApeocGlRCaeEY2Bj-0KEfE76MU8jV9eSHZNXgllUA&oe=69A58D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9 Thumbnail (1).png", "id": "1006495394835827", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035332_1006495398169160_8105837685039858045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjWgB5kmXToQ7kNvwHT808W&_nc_oc=AdkoKPLasgqZDny8G4DfYJTWZMORK9M2f-saNLbODwQELANyNviTY_S2kJudezDmGog&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuX_SZn68k5kFJbuacBaGOoYBHMgrLZhfmZdzagfHFByQ&oe=69A59DD5"}, "display_name": "X8 Contra: Super Wall Storm", "keywords": ["contra", "shooter", "hero", "fps", "coop"], "long_description": "Bill and Lance, from the legendary run-and-gun Contra series, join the roster of heroes fighting the AI \"Index\"! Contra co-op survival game mode, Bill and Lance Supreme skins, exclusive goodies & X8 app **30% off** for just **$19.99!**\n\n{8685772538209711}\n\nX8 Contra: Super Wall Storm includes:\n- Bill Supreme skin\n- Lance Supreme skin\n- Contra Game mode\n- X8 main game package\n- Exclusive character voice lines\n- 5 collaboration-exclusive splats\n- $9.99 X8 Coins\n\nContra's legendary heroes, Bill and Lance, are now fully playable in VR, and ready to bring the **action to a whole new level!**\n\n- Team up with friends, unleash devastating powers and **survive** the relentless onslaught of Red Falcon's forces!\n- Face **iconic enemies** like the Bird Human Garth or the Armadillo Bomb, leading to the terrifying final boss: Super Wall!\n\n{616664627377655}\n\nX8 is a highly tactical 5v5 Hero Shooter in which you take turns to Attack and Defend by planting or defusing the Syphon across maps designed to test your creative strategies.\n\n{1219544142451394}\n\nNote to the users\nX8 Contra: Super Wall Storm is a paid app that contains adds-on to the original X8.", "short_description": "5v5 VR Hero Shooter X8 joins forces with Contra, the iconic run-and-gun side-scrolling game series, to bring you all the adrenaline of the original game, in VR! Get the exclusive Supreme skins of Bill and Lance, complete with voice lines and new skins for hero items, and join a whole new experience as you assault Red Falcon\u2019s military base!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thirdverse.io/en/privacy-policy.html", "developer_terms_of_service_url": "https://thirdverse.io/en/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://playx8vr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "fr", "de", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["
8\u30b2\u30fc\u30e0\u3067\u3042\u308a\u3001\u540c\u3058\u30b5\u30fc\u30d0\u30fc\u3092\u5171\u6709\u3057\u3066\u3044\u307e\u3059\u304c\u3001Meta\u3067\u306f\u7570\u306a\u308b\u30da\u30fc\u30b8\u3067\u7d39\u4ecb\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u300eX8 Contra: Super Wall Storm\u300f\u306f\u3001\u30aa\u30ea\u30b8\u30ca\u30eb\u306eX8\u306b\u30a2\u30c9\u30aa\u30f3\u3092\u52a0\u3048\u305f\u6709\u6599\u30a2\u30d7\u30ea\u3067\u3059\u3002\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u8cfc\u5165\u3057\u305f\u304f\u306a\u3044\u5834\u5408\u306f\u3001\u7121\u6599\u7248\u30da\u30fc\u30b8\u304b\u3089X8\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n**X8 Contra: Super Wall Storm\u306b\u542b\u307e\u308c\u308b\u5185\u5bb9**\n- \u30d3\u30eb \u30b7\u30b9\u30ad\u30f3\n- \u30e9\u30f3\u30b9\u30b9\u30ad\u30f3\n- \u9b42\u6597\u7f85\u30b3\u30e9\u30dc\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\n- \u5c02\u7528\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30dc\u30a4\u30b9\n- \u30b3\u30e9\u30dc\u5c02\u7528\u30b9\u30d7\u30e9\u30c3\u30c8 5\u3064\n- X8\u30b3\u30a4\u30f3\n- \u30d7\u30ea\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u305fX8\u30a2\u30d7\u30ea", "short_description": "5v5 VR\u30d2\u30fc\u30ed\u30fc\u30b7\u30e5\u30fc\u30bf\u30fc X8\u304c\u3001\u30e9\u30f3\uff06\u30ac\u30f3\u30b2\u30fc\u30e0\u306e\u4ee3\u8868\u4f5c\u300e\u9b42\u6597\u7f85\u300f\u30b7\u30ea\u30fc\u30ba\u3068\u30bf\u30c3\u30b0\u3092\u7d44\u307f\u3001\u30aa\u30ea\u30b8\u30ca\u30eb\u30b2\u30fc\u30e0\u306e\u30a2\u30c9\u30ec\u30ca\u30ea\u30f3\u5168\u958b\u306eVR\u30b2\u30fc\u30e0\u3092\u304a\u5c4a\u3051\u3057\u307e\u3059\uff01\u30d3\u30eb\u3068\u30e9\u30f3\u30b9\u306e\u9650\u5b9a\u30b9\u30ad\u30f3\u3092\u624b\u306b\u5165\u308c\u3001\u30dc\u30a4\u30b9\u30e9\u30a4\u30f3\u3068\u30d2\u30fc\u30ed\u30fc\u30a2\u30a4\u30c6\u30e0\u306e\u65b0\u30b9\u30ad\u30f3\u3092\u88c5\u5099\u3057\u3066\u3001\u30ec\u30c3\u30c9\u30d5\u30a1\u30eb\u30b3\u30f3\u306e\u8ecd\u4e8b\u57fa\u5730\u3092\u8972\u6483\u3059\u308b\u5168\u304f\u65b0\u30
cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5GaSPsJdW8Q7kNvwFsqoav&_nc_oc=AdqlIEbl9YpfHk9u01BgVaXbWkg5nC5xxqEPpe0ixxjaqa_pK190AUw4doDDCmcfvAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy5lB-u6_BMNbO0IyGtRqyG_1n42YNI3uH3aXvTREoXw&oe=6AFDE43A"}, {"file_name": "4_Armadillo 2560 x 1440 (1).png", "id": "425466043953630", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_425466047286963_7378149995770162832_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJaEY7PoQnYQ7kNvwFQ2fK4&_nc_oc=Adq430DEfpOm8in-sX1QB2SukIgyKWZ4pjOaCAkYdoOlbrc77uh-9KttzjUq92e2B6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgRHnQFpYzVRZ3-SzEnzkTMgpxvvrIM6tha9o-NL9dQA&oe=6AFDC95F"}, {"file_name": "5_Superwall fighting 2560 x 1440 (1).png", "id": "2223483651387624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982458_2223483654720957_5962593182127291533_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBQhX8itPMoQ7kNvwFS9Mp5&_nc_oc=Adq5z0RMFdAEcStlBreZ5WfeqJSMzOtipl-58rJY2rtfdUlZzNuAdnoQqYe8wH2P1lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLMxrnWKSrBlmWh_4ZE2GdZX8qTqiPGQMsZubOXH_EYQ&oe=6AFDDD52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pressrelease_En.png", "id": "437233775934396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622006_437233779267729_2383331392795317876_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dkv_77c6VGgQ7kNvwF_lcz8&_nc_oc=AdrYsb8SU7eaGGljFXLBywp7Xqq3HkQF3nI8xHwN4LpW4pHCmxY6GDvV-JMzyXcgahw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4D5Ui2tXft8TCL9MLI4acpNVhPWVU8-FZzUCmHRwSjA&oe=6AFDE4BD"}, "display_name": "X8 Contra: Super Wall Storm", "keywords": ["contra", "shooter", "hero", "fps", "coop"], "long_description": "The omnipotent AI Index rules over X8, and aims to expand its dominion outside its digital boundaries. In order to acquire more power, it self-trains absorbing other digital worlds \u2013 this time it was **Contra: Operation Galuga**.\n- Play as Contra\u2019s legendary heroes, Bill and Lance, with exclusive Supreme skins! These iconic side-scrolling heroes are now fully playable in VR, bringing the action to a whole new level!\n- Team up with friends to assault the Red Falcon military base in this exciting new Co-op survival game mode. Unleash devastating new powers and survive the relentless onslaught of Red Falcon's forces!\n- Face **iconic enemies** like the **Bird Human Garth**, a deadly flying foe, or the Armadillo Bomb, which is far more dangerous up close. The **Super Wall**, the terrifying final boss that promises to make your mission hell on Earth!\n\n**Note to the users**\n\nX8 Contra: Super Wall Storm and X8 are the same game and share the same server, but are featured on Meta on two different pages. X8 Contra: Super Wall Storm is a paid app that contains adds-on to the original X8. If you do not wish to purchase its contents, you can still enjoy X8 on the free-to-play page app.\n\n**X8 Contra: Super Wall Storm contains**\n- Bill Supreme Skin\n- Lance Supreme Skin\n- X8 Contra: Super Wall Storm Game Mode\n- Exclusive Character Voice Lines\n- Exclusive Splats\n- X8 Coins \n- Pre-installed X8 app", "short_description": "5v5 VR Hero Shooter X8 joins forces with Contra, the iconic run-and-gun side-scrolling game series, to bring you all the adrenaline of the original game, in VR! Get the exclusive Supreme skins of Bill and Lance, complete with voice lines and new skins for hero items, and join a whole new experience as you assault Red Falcon\u2019s military base!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thirdverse.io/en/privacy-policy.html", "developer_terms_of_service_url": "https://thirdverse.io/en/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://playx8vr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "fr", "de", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8751464358264974"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1141201077522411"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734026400, "status": "PUBLISHED", "id": "1141201077522411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9303008713110533", "version": "0.1.23645"}, "id": "865647885698576", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8638026942942050", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9303008713110533"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "865647885698576"}]}, "change_log": "CL #23645", "created_date": 1741781660, "id": "9303008713110533", "version": "0.1.23645", "version_code": 32466, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "9303007083110696"}, "asset_files": {"count": 0}, "debu
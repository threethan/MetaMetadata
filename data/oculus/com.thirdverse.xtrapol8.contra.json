3nKryyoLLSiJUqlBpqDger3lxup0RCP7XajmAyaMaDgss2yE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_vG5rNmOXbAitFlUzb-Q3u6FxOaG5Iba-Rxj66bs4UQ&oe=69E8D0FA"}, {"file_name": "75443235_1685131328981593_7121581085702710915_n.png", "id": "631782492507373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569475_631782495840706_1805589523499274930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlOcEv-2Ff4Q7kNvwGdpJgp&_nc_oc=Adokctw1a537aoEYDlyheFKpn3NDze5I0-rNeKY0Uqyw4-lk4B-gPwqmkbMFvv-HI6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37ZSzB3FcHfiIy2NTd46DiEmYF0IBfMIDtfAsl8jM6Dg&oe=69E8AD3D"}, {"file_name": "5_Superwall fighting 2560 x 1440 (1).png", "id": "2223483651387624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_2223483654720957_5962593182127291533_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq-NJycDFxsQ7kNvwHJm5jS&_nc_oc=AdpLxi_nat5wvMQmCXe_ePv5YPFPw5GLxowDJoD5-wPAKpcZEJsUQoKQzj1GadFbpM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EO0xdHVOwdx7rTPffYvOrCF1UFKwp3vdTdcgkr5eXXA&oe=69E8CA12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9 Thumbnail (1).png", "id": "1006495394835827", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035332_1006495398169160_8105837685039858045_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OQ22awN3FgQ7kNvwHR2oNQ&_nc_oc=AdqbfpzExZX7xSrtiJYiN7ysntEViry5zbG7RYsU0GQxV4SfwNK6akMAQaDT50ZogI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Jrpx0FuI21a3EMVbOkknjHbybUeMDBCsXfLOW86skGw&oe=69E8DA55"}, "display_name": "X8 Contra: Super Wall Storm", "keywords": ["contra", "shooter", "hero", "fps", "coop"], "long_description": "Bill and Lance, from the legendary run-and-gun Contra series, join the roster of heroes fighting the AI \"Index\"! Contra co-op survival game mode, Bill and Lance Supreme skins, exclusive goodies & X8 app **30% off** for just **$19.99!**\n\n{8685772538209711}\n\nX8 Contra: Super Wall Storm includes:\n- Bill Supreme skin\n- Lance Supreme skin\n- Contra Game mode\n- X8 main game package\n- Exclusive character voice lines\n- 5 collaboration-exclusive splats\n- $9.99 X8 Coins\n\nContra's legendary heroes, Bill and Lance, are now fully playable in VR, and ready to bring the **action to a whole new level!**\n\n- Team up with friends, unleash devastating powers and **survive** the relentless onslaught of Red Falcon's forces!\n- Face **iconic enemies** like the Bird Human Garth or the Armadillo Bomb, leading to the terrifying final boss: Super Wall!\n\n{616664627377655}\n\nX8 is a highly tactical 5v5 Hero Shooter in which you take turns to Attack and Defend by planting or defusing the Syphon across maps designed to test your creative strategies.\n\n{1219544142451394}\n\nNote to the users\nX8 Contra: Super Wall Storm is a paid app that contains adds-on to the original X8.", "short_description": "5v5 VR Hero Shooter X8 joins forces with Contra, the iconic run-and-gun side-scrolling game series, to bring you all the adrenaline of the original game, in VR! Get the exclusive Supreme skins of Bill and Lance, complete with voice lines and new skins for hero items, and join a whole new experience as you assault Red Falcon\u2019s military base!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thirdverse.io/en/privacy-policy.html", "developer_terms_of_service_url": "https://thirdverse.io/en/terms-of-service.html", "publisher_name": "Thirdverse, Co., Ltd.", "support_website_url": null, "website_url": "https://playx8vr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMEN
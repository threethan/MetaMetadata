UCFOzUQ7kNvwGTDV6u&_nc_oc=AdoHj5fPq6uxEG8Z88dFS1oVwLylv75Kgu7X7aYpNXDONuj_SoJxDzKLhi6kQQ2oINc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThU8E-a623vHUXwWJJlOhyFHa7WOqEk3XuGXIXfRfdUw&oe=6AFB23BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot Meta Store cover.png", "id": "1187813193404613", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307962_1187813196737946_437891316642872429_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p52O5zMvi1UQ7kNvwEk7BF6&_nc_oc=Adr15Le8Wexz1BpqmI24gwbOW9emB6zFqT1GFUW7-WbCqOExpOBlRe2RH56LYbjKoR0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnoNGAzLIO3aHQDTfc_NO3sEKv768hM8-Cik9snEycqA&oe=6AFB1712"}, "display_name": "Neon Overdrive", "keywords": ["Roguelike", "VR", "Shooter", "Retro", "Action"], "long_description": "**Neon Overdrive is a procedurally generated, rogue-like, VR shooter set in an 80s-inspired Retro Futuristic Sci-Fi world. Fight your way through hordes of Exo Bots utilizing four unique character classes, special abilities, and a variety of perk combinations.**\n\n{847681057597516}\n{1420202056331688}\n\n**Play to unlock 7 Unique Classes, each with their own Weapons and set of abilities. Master each class, complete class-specific challenges for cosmetic rewards. Each class provides a new playstyle and an opportunity to craft new builds.**\n\n{2343655379386904}\n{816299678025066}\n\n**Stack, mix, and match over 50 perks! Providing you with the tools to make every run unique. From common stat buffs to major ability and gameplay shake-ups, strategically stack your perks to craft your most devastating build.**\n\n{671526499056569}\n{1353681196155975}\n\n**The Overdrive Mechanic is a dynamic difficulty modifier that gives enemies new abilities, boosted stats, and a brand new look!**\n\n{709317305519093}\n{817267227457435}\n\n**Procedurally Generated Levels, Dynamic Difficulty Scaling, Challenges, and Cosmetic Reward Systems all keep you playing and replaying. Test your skills and craft your perfect build to complete challenges, unlock difficulty modifiers, and unlock new classes or cosmetics!**\n\n{1187168663374162}\n{1513842392977849}\n\n**A Variety of Boss Battles to Test Your Skill and Perks! Each with its own unique attacks and mechanics.**", "short_description": "Neon Overdrive is a procedurally generated, rogue-like, VR shooter set in an 80s-inspired Retro Futuristic Sci-Fi world. Fight your way through hordes of Exo Bots utilizing four unique character classes, special abilities, and a variety of perk combinations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coffeemothgames.com/projects/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coffee Moth Games", "support_website_url": null, "website_url": "https://coffeemothgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24647595094923361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1212444900949361"}]}, "baseline_offer": {"id": "1212444900949361"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765912200, "status": "PUBLISHED", "id": "1212444900949361"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"_
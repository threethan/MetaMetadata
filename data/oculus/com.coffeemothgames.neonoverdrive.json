oRb1EYQ7kNvwG1G3NU&_nc_oc=AdppzWrZ8kSxY4V30ZJtsDEt9wfowpaG-rk1wpBFiTMx7WBGqu2IrVI-IHyKX0cet8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT941-ZG0gN8lxOtqcqlU4JqQZZuLZ3Zc77uvtHsv12cw&oe=6B0C7F7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot Meta Store cover.png", "id": "1187813193404613", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307962_1187813196737946_437891316642872429_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5-_VR0VMh0Q7kNvwHgTBMs&_nc_oc=AdpqLZLy53E_3oCol6zrkwwRLGQ-05LvImygfbbs4mq5GFPYXytYrxHiMtDTtQCp3pE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ75SI0nkR___rHC5-50yyfmnWjzeCuVMaED1NyymOSzQ&oe=6B0C72D2"}, "display_name": "Neon Overdrive", "keywords": ["Roguelike", "VR", "Shooter", "Retro", "Action"], "long_description": "**Neon Overdrive is a procedurally generated, rogue-like, VR shooter set in an 80s-inspired Retro Futuristic Sci-Fi world. Fight your way through hordes of Exo Bots utilizing four unique character classes, special abilities, and a variety of perk combinations.**\n\n{847681057597516}\n{1420202056331688}\n\n**Play to unlock 7 Unique Classes, each with their own Weapons and set of abilities. Master each class, complete class-specific challenges for cosmetic rewards. Each class provides a new playstyle and an opportunity to craft new builds.**\n\n{2343655379386904}\n{816299678025066}\n\n**Stack, mix, and match over 50 perks! Providing you with the tools to make every run unique. From common stat buffs to major ability and gameplay shake-ups, strategically stack your perks to craft your most devastating build.**\n\n{671526499056569}\n{1353681196155975}\n\n**The Overdrive Mechanic is a dynamic difficulty modifier that gives enemies new abilities, boosted stats, and a brand new look!**\n\n{709317305519093}\n{817267227457435}\n\n**Procedurally Generated Levels, Dynamic Difficulty Scaling, Challenges, and Cosmetic Reward Systems all keep you playing and replaying. Test your skills and craft your perfect build to complete challenges, unlock difficulty modifiers, and unlock new classes or cosmetics!**\n\n{1187168663374162}\n{1513842392977849}\n\n**A Variety of Boss Battles to Test Your Skill and Perks! Each with its own unique attacks and mechanics.**", "short_description": "Neon Overdrive is a procedurally generated, rogue-like, VR shooter set in an 80s-inspired Retro Futuristic Sci-Fi world. Fight your way through hordes of Exo Bots utilizing four unique character classes, special abilities, and a variety of perk combinations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coffeemothgames.com/projects/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coffee Moth Games", "support_website_url": null, "website_url": "https://coffeemothgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24647595094923361"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25031701543179379", "version": "1.0"}, "id": "653010434205670", "channel
5P1iQ&oe=6AFDC071"}, {"file_name": "Pieces_screenshot_03.png", "id": "4595782370658666", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_4595782373991999_670343081587608530_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiJT1z6KImMQ7kNvwHiscw8&_nc_oc=Adp2xByTNFzaSkRnXqNAcLWMYK8xoxsn84JinHyrFi2xHVW5f-bgzKSUtnAmrldMrXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVMPiimipSL1K3h3Q4CuaeCqU_-rcGzRh_o22vg6-cug&oe=6AFDBB09"}, {"file_name": "Pieces_screenshot_01.png", "id": "1159220957043957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604310912_1159220960377290_8129734667934063682_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCb4JG4SItwQ7kNvwFLSzLI&_nc_oc=Ado6coe0ZzusTc0ym3z488WvzVA63VCcBekgXJ-Ydg_OoNB0qWGYVpcSzmbzpwdMeiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNdwX-IaikT_dPDW3AE065eAhAFribVsTSV24puju8AQ&oe=6AFDC760"}, {"file_name": "Pieces_screenshot_02.png", "id": "2315196932658165", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_2315196935991498_4842502357232016075_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSGWiojCzIoQ7kNvwFeYtq_&_nc_oc=Adp-J6IblAUiYSiLc5NmCPVX1CQhut3t3L6FpV6dzZnnIvZDkVgZGzk6lFLyRzg2PKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrCqo3OvWca8nLWY7HCvxegmp6h7FtjMb9Qq9BhKFdIw&oe=6AFDCA93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pieces_cover_B_night.png", "id": "1664822755041882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1664822758375215_7040513773083442913_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-cebzeZCqUQ7kNvwEeZUNI&_nc_oc=AdoC1Fue1Mx7luv1qmB3EKkIVP08F9K38XM4zniMR0keEnrQ59wYnu97uS52znU9toQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf1VF7dlO0LPgBDgfuQ0qXRqV3F4DkJTcxwDR1W41e9Q&oe=6AFDC2AD"}, "display_name": "Pieces", "keywords": ["documentary", "narrative", "memory", "trauma", "interactive"], "long_description": "Pieces is an interactive VR documentary about memory, family, and unspoken grief.\n\nA mother and daughter journey through the kibbutz where the mother grew up. As memories resurface, the mother recalls her most traumatic experience\u2014the sudden death of her own mother when she was only 10 years old. Exposed to emotions that were never given space before, the daughter accompanies her mother to the kibbutz cemetery, where a revelation leads her to confront gaps in her own family history.\n\n\u2022 Winner of the 2025 BAFTA Student Award (Immersive)\n\n\u2022 Audio Options: Available in Original Hebrew or English Dubbing (with optional subtitles)\n\n\u2022 Controls: Gaze-based interaction (no controllers required)", "short_description": "An interactive VR documentary following a mother and daughter through the kibbutz of the mother\u2019s childhood. As hidden memories resurface, a daughter uncovers long-buried family truths."}]}, "developer_name": "Noam Karutchi", "developer_privacy_policy_url": "https://docs.google.com/document/d/16V9C9AgfzzE0foege7NHF4f0RM78Ms-Qgc4uZGe5tv4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Noam Karutchi", "support_website_url": null, "website_url": "https://noamkarutchi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "he"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1
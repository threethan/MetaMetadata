=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NyhnFCfnnAQ7kNvwHx4sdE&_nc_oc=AdqHntYtUKN1Wwf9NAoq_BDNd5rw178Gh5KbngAW5ly4JmVmea86vizaiWHlvvqTndQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzvusc18-RD3U0zpAKsj9JvlZiHkDN004uwMB3-cmOpA&oe=6AF9C689"}, {"file_name": "Pieces_screenshot_01.png", "id": "1159220957043957", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604310912_1159220960377290_8129734667934063682_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFpvbK_BM5sQ7kNvwHN5ljK&_nc_oc=AdqF_yntdpxUN5zMeEImKs2rxt9PB-rAbQohyYrB8PvshMGVDawOOiM_qEgGJr7oSG4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA8fPkRa13YkK0KQfS5AYPBOQtrJihb9kfBUna0XDHcw&oe=6AF9D2E0"}, {"file_name": "Pieces_screenshot_02.png", "id": "2315196932658165", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596149727_2315196935991498_4842502357232016075_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzoxf1woW1YQ7kNvwEcHuSL&_nc_oc=AdpOQMh63l0caStDL3I2Li5I6ac8q14Qj3OY2yoDPxSTV-8lHim9ppQPIDasboAInWg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjIk_UK8XiuBoCdLXXaoOL2LUtVCFVS9WxxgXGrZ_MMg&oe=6AF9D613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pieces_cover_B_night.png", "id": "1664822755041882", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604360590_1664822758375215_7040513773083442913_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T51sJgkSb8cQ7kNvwEcieWf&_nc_oc=AdpK2_pQo3Ktz6OUD7ZKf1N3fgVa6qLUyW8RSdiGJ7CLfrLGdTRItkJa4v9Je-qIR_k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Az5bE9jduouQFLM0gGXEAT8Zh7DYpiTZwd0jwMWMBA&oe=6AF9CE2D"}, "display_name": "Pieces", "keywords": ["documentary", "narrative", "memory", "trauma", "interactive"], "long_description": "Pieces is an interactive VR documentary about memory, family, and unspoken grief.\n\nA mother and daughter journey through the kibbutz where the mother grew up. As memories resurface, the mother recalls her most traumatic experience\u2014the sudden death of her own mother when she was only 10 years old. Exposed to emotions that were never given space before, the daughter accompanies her mother to the kibbutz cemetery, where a revelation leads her to confront gaps in her own family history.\n\n\u2022 Winner of the 2025 BAFTA Student Award (Immersive)\n\n\u2022 Audio Options: Available in Original Hebrew or English Dubbing (with optional subtitles)\n\n\u2022 Controls: Gaze-based interaction (no controllers required)", "short_description": "An interactive VR documentary following a mother and daughter through the kibbutz of the mother\u2019s childhood. As hidden memories resurface, a daughter uncovers long-buried family truths."}]}, "developer_name": "Noam Karutchi", "developer_privacy_policy_url": "https://docs.google.com/document/d/16V9C9AgfzzE0foege7NHF4f0RM78Ms-Qgc4uZGe5tv4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Noam Karutchi", "support_website_url": null, "website_url": "https://noamkarutchi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "he"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139593512095065"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673652249_29271472225812613_2821086768762611879_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wx87M2n3OMQ7kNvwFo5kIe&_nc_oc=AdpgUsAESUtZXXzgKYTYK70i7hctzDrVmQH
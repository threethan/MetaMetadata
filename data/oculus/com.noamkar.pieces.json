9Sz8Q&oe=6B0C7931"}, {"file_name": "Pieces_screenshot_03.png", "id": "4595782370658666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_4595782373991999_670343081587608530_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7gdA-pWfF4Q7kNvwEwAWih&_nc_oc=AdpdZimA2iXZY6rzTqcUbgYZ1584xjYXTK6rhgy0Ba2zZfqmcmJoeWj-wzHZ7pw7-zw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8LMvUB7-yzPJKFBdWiKwzogO5yIzoNsHu_8Fy4I8-vg&oe=6B0C73C9"}, {"file_name": "Pieces_screenshot_01.png", "id": "1159220957043957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604310912_1159220960377290_8129734667934063682_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-Y004a5_WcQ7kNvwH5MU0i&_nc_oc=AdpvNxqcTfXvghoHu7KjSd0o9l4T3rlXADVLeOY_nHgElEORExJ505bkl9FVNCpTOpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCiRaAG1_zkW79pdXLvlNM8s1XrfS_4jaqVvDdv2XgIw&oe=6B0C8020"}, {"file_name": "Pieces_screenshot_02.png", "id": "2315196932658165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_2315196935991498_4842502357232016075_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNAHRcy94vwQ7kNvwGkIpkc&_nc_oc=AdpKOWqGSt4pLW_ZR4FEu_Bdna7VuzdU-k7hF6hdlUvETIeF_wPUBatjOAXBRbWG2OA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKiIDQ1MjUStHnjeCvPLk314tvaNeBuF0COfYPLk3cwg&oe=6B0C8353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pieces_cover_B_night.png", "id": "1664822755041882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1664822758375215_7040513773083442913_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3JZm28oG9kQ7kNvwEsSU4m&_nc_oc=Ador61K9HmWyl3KYDuOsR44ks6AepVG4kOw3NlNJdfHR3_DvRfgG6GN2ptaMJ-ED-Ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2P64hWnt3rVMgy7jGREARL52SMy0IF5zsyacbKObJqg&oe=6B0C7B6D"}, "display_name": "Pieces", "keywords": ["documentary", "narrative", "memory", "trauma", "interactive"], "long_description": "Pieces is an interactive VR documentary about memory, family, and unspoken grief.\n\nA mother and daughter journey through the kibbutz where the mother grew up. As memories resurface, the mother recalls her most traumatic experience\u2014the sudden death of her own mother when she was only 10 years old. Exposed to emotions that were never given space before, the daughter accompanies her mother to the kibbutz cemetery, where a revelation leads her to confront gaps in her own family history.\n\n\u2022 Winner of the 2025 BAFTA Student Award (Immersive)\n\n\u2022 Audio Options: Available in Original Hebrew or English Dubbing (with optional subtitles)\n\n\u2022 Controls: Gaze-based interaction (no controllers required)", "short_description": "An interactive VR documentary following a mother and daughter through the kibbutz of the mother\u2019s childhood. As hidden memories resurface, a daughter uncovers long-buried family truths."}]}, "developer_name": "Noam Karutchi", "developer_privacy_policy_url": "https://docs.google.com/document/d/16V9C9AgfzzE0foege7NHF4f0RM78Ms-Qgc4uZGe5tv4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Noam Karutchi", "support_website_url": null, "website_url": "https://noamkarutchi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "he"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1
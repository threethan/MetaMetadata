ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFpvbK_BM5sQ7kNvwENMA4w&_nc_oc=Adovwcd8tfjbfgg1fCEifEUNT4wU7YHsiefI4qfP_MSaJdFlHsH_ZCJUI3mkkhlf5iQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlqTI4XsurV65Wh9u49Qvs-kVOmcgF4O-OLxsxMWscjw&oe=6AFC75E0"}, {"file_name": "Pieces_screenshot_02.png", "id": "2315196932658165", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596149727_2315196935991498_4842502357232016075_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzoxf1woW1YQ7kNvwEBkTLf&_nc_oc=Adr8n3UooLOZVA3KM-XAFLJXOLl0vUfVaWU6_v_4AIEmofCQWe3azpd1dVDk2p6lIyE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjNprWoK158FhQ9MOQNqLNnuogQzGpqzboZvS1-SHl5Q&oe=6AFC7913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pieces_cover_B_night.png", "id": "1664822755041882", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1664822758375215_7040513773083442913_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-cebzeZCqUQ7kNvwFLvm55&_nc_oc=AdrM7mA8QIDelC3wUw2yZyvhHQz2ff5h5Ry8CH86W93exGMcRPUXTk4fmoaR4yJuQK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi8eVx0ulr7PCK3BcpPGbmlHU18JgIlp_g2JlgToiH9Q&oe=6AFC712D"}, "display_name": "Pieces", "keywords": ["documentary", "narrative", "memory", "trauma", "interactive"], "long_description": "Pieces is an interactive VR documentary about memory, family, and unspoken grief.\n\nA mother and daughter journey through the kibbutz where the mother grew up. As memories resurface, the mother recalls her most traumatic experience\u2014the sudden death of her own mother when she was only 10 years old. Exposed to emotions that were never given space before, the daughter accompanies her mother to the kibbutz cemetery, where a revelation leads her to confront gaps in her own family history.\n\n\u2022 Winner of the 2025 BAFTA Student Award (Immersive)\n\n\u2022 Audio Options: Available in Original Hebrew or English Dubbing (with optional subtitles)\n\n\u2022 Controls: Gaze-based interaction (no controllers required)", "short_description": "An interactive VR documentary following a mother and daughter through the kibbutz of the mother\u2019s childhood. As hidden memories resurface, a daughter uncovers long-buried family truths."}]}, "developer_name": "Noam Karutchi", "developer_privacy_policy_url": "https://docs.google.com/document/d/16V9C9AgfzzE0foege7NHF4f0RM78Ms-Qgc4uZGe5tv4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Noam Karutchi", "support_website_url": null, "website_url": "https://noamkarutchi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "he"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139593512095065"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3715898571920846"}]}, "baseline_offer": {"id": "3715898571920846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794209160, "status": "PUBLISHED", "id": "3715898571920846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1139840752070341", "version": "1.0"}, "id": "900643293038345", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "11395
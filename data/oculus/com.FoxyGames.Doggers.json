aced VR climbing game with smooth movement, unique maps, and exciting game modes. Swing through the world, challenge your friends, and master your movement in a fun multiplayer adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/muha-tag-privacy-policy/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Foxy", "support_website_url": null, "website_url": "https://sites.google.com/view/muha-tag-privacy-policy/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1043095078134451"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299093_4137647653036096_8876686565947291134_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jxBV3klCnAQ7kNvwGv3XKc&_nc_oc=Adon_NC2-Yagm3HagET95b79wN3Jj9VUqHg1lOj0Gopymy-1LOeNtpmm15UsbW8WY9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqwGb5eIh_fw8n2Z_6qJMe8gOfmNt_e4z51FkexF1T4A&oe=6AB90954"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Muha Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name":
nned as development continues, giving players even more ways to play and experience the game.\n\nJump in, master your movement, and see how far your skills can take you in the world of **Muha Tag**.\n", "short_description": "Muha Tag is a fast-paced VR climbing game with smooth movement, unique maps, and exciting game modes. Swing through the world, challenge your friends, and master your movement in a fun multiplayer adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/muha-tag-privacy-policy/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Foxy", "support_website_url": null, "website_url": "https://sites.google.com/view/muha-tag-privacy-policy/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1043095078134451"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549779340188215"}]}, "baseline_offer": {"id": "1549779340188215"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785035220, "status": "PUBLISHED", "id": "1549779340188215"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1043131624797463", "version": "0.1.0"}, "id": "1689429115446388", "channel_name": "LIVE"}]}, 
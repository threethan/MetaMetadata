", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771248_1807350037670770_1462049295794420860_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWfBObHVb_4Q7kNvwHo_Y1f&_nc_oc=Adop-MkW4rydfr5NfYTKrm-TAg1nU1K64f6la0dYVveTbrUwwC_8zABbqcRA1acydBk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUg8ulLZklMRHsL4ahKNQeY5Hbyb42gTx9M0FV9SCQ8SQ&oe=6B1038D4"}, {"file_name": "shot5_omnibox.png", "id": "2056781785022299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771289_2056781788355632_8735053617526625351_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIn7_CEq7TQQ7kNvwFoPYPu&_nc_oc=AdrFqn28twRGlRnHAf8V_Wpr5IgODjUhw131hFcCPaQp4JWYCUGJUoCDjFnkuF5OrVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjhJKI4MZcSOBAQZWqSU497bo42ol_1t4lgosCCB6qDw&oe=6B10671B"}, {"file_name": "shot2_settings.png", "id": "4610147405892282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771290_4610147409225615_8913526527842120101_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEo9CCdkmU8Q7kNvwE3GPQX&_nc_oc=AdpU8zeUb0ZpxJsh9X0bycLSY0SyU4dSDAbGO4gr9I4Mssgz56mm84GKZo7dLmM37VE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDSYlYHvQoRmYc4nKrNLY3iZqXuS0tt2-fgttRGiaVmw&oe=6B104A90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Browser 2D", "keywords": ["browser", "web", "vr", "2d", "quest"], "long_description": "Browser 2D is a fast, lightweight, pure-2D web browser for Meta Quest Horizon OS. No 3D space, no floating windows \u2014 just a fixed desktop-style monitor in front of you that you can read at a comfortable distance.\n\n- Desktop chrome: tab bar, address bar, back/forward/reload/home, and a menu.\n- Multiple tabs with smooth switching, fluid even with 20+ tabs open.\n- Ad-blocking (EasyList-based) for a cleaner, faster web.\n- Secret (private) mode that skips writing to history.\n- History, bookmarks, and tab restore \u2014 all stored locally on your device.\n- Offline-first: no telemetry, no analytics, no third-party tracking.\n- Controller (laser + trigger) or hand-tracking (pinch/swipe) input, plus detachable physical keyboard support.\n\nBuilt to be fast and light: cold start under 5 seconds, low memory, and readable at 2 meters.", "short_description": "Fast, flat 2D web browser for Quest. Simple desktop view, tabs, ad-blocking, and offline-first design."}]}, "developer_name": null, "developer_privacy_policy_url": "https://savvazaicev.github.io/browser-legal/privacy.html", "developer_terms_of_service_url": "https://savvazaicev.github.io/browser-legal/terms.html", "publisher_name": "Savva", "support_website_url": null, "website_url": "https://savvazaicev.github.io/browser-legal/landing.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1528181860370197"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "933284973083718"}]}, "baseline_offer": {"id": "933284973083718"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795691520, "status": "PUBLISHED", "id": "933284973083718"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1536763512845365", "version": "1.1.0"}, "id": "1
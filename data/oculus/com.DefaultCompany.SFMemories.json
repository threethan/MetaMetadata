_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfXHl1UQ5gqbHd84DE5r-2f7hiKH32M0JNp2zATQgioQ&oe=6A997618"}, {"file_name": "SC3.png", "id": "492741000009113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974589_492741003342446_2708023473517559589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZzBC62jEHkQ7kNvwHLwI0x&_nc_oc=AdpX4AHWt1e2-rpz0bceepRioMCw62pm-RKE9O2z-u8JWsZoW_uYWKHpzyZ5Mr-AEOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8msVfmim-tqIA-IatZFM_B75obDejS9pLXmRsAx_SMg&oe=6A99944B"}, {"file_name": "SC4.png", "id": "1013160283737908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974494_1013160287071241_7168145155065253880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Di5rvryw4MkQ7kNvwEzIOgH&_nc_oc=Ado-jzJFZgb1Zl_sUCBMdvNw9wDd5K1hzDqWfkwipl7AScJs24Gm8fSclbX_NOoWMFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXdGgAurXz2wQtsb0reO2uez8A_IFc2_n2yWsC5o-FeA&oe=6A9977CD"}, {"file_name": "SC5.png", "id": "1186809445688012", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035325_1186809449021345_2090033985786114600_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xc3AARzxqGoQ7kNvwGFN55I&_nc_oc=AdrvNfZ9fpCa66J8A2eFwDR83JMBOgtDZD2c81QJK1rMf6VEy3dk5Q8SAeqSpkjeujE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFmNTEXkGIFJwMr8Cna3eal-3pWW0mRmLYimgVByDVew&oe=6A99A569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "466807829448147", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75340714_466807832781480_615626249476828268_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lozRnl5wQM8Q7kNvwF1c14l&_nc_oc=Ado3sBJmTL2JSz5E3va32VRL_u1BI7AnrgUeVBXhIZMUu9xwIWgiiAhByWzRBVk6Ufo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIScwJlKp0YcF2U7RCw_AEVqCz9xpi70_hu5RuFntHr_g&oe=6A99A5E9"}, "display_name": "SchoolFriendMemories", "keywords": ["ADV", "Quiz", "story", "LoveStory", "school"], "long_description": "SchoolFriendMemories is a romantic adventure game where you can experience the fleeting moments of youth within the school, through heartwarming conversations with the heroine, Kanon Amane.\n\nYou will take on the role of the protagonist and navigate various scenarios in the school, gradually deepening your relationship with the heroine through everyday conversations.\n\nImmerse yourself in a VR space that vividly captures the school atmosphere. Relive the seemingly mundane yet irreplaceable romance of your teenage years and enjoy a love story that feels both familiar and unique.\n\nAdditionally, the game features a quiz game segment focused on four categories: academics, sports, entertainment, and music/art. The skills you develop in these quizzes will influence slight changes in the ending.\n\nFinally, the game includes an auto-save feature based on your progress. Please note that there is no data reset function within the game.\n\nJust as your youth was a one-time experience, the experiences of \"Seishun\" you can savor in this game are also unique. Cherish every moment and enjoy the present.\n", "short_description": "SchoolFriendMemories is a romantic adventure game where you can experience the fleeting moments of youth within the school environment, all through heartwarming conversations with the heroine, Kanon Amane.\n\nAs the protagonist, you will navigate various scenarios in the school, gradually deepening your bond with the heroine through everyday dialogues.\n\nImmerse yourself in a VR space that vividly captures the essence of school life. Relive the seemingly mundane yet irreplaceable romance of your te"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2024/07/privacy-policyschoolfriendmemories.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2024/07/about-schoolfriendmemories.html", "category
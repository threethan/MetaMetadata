com/v/t64.5771-25/38974840_486575775700913_3781458670282844239_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s08Zo0N3cNkQ7kNvwFagTr2&_nc_oc=AdnvQG2RK8OSFqbkNbhnudatc0e3Os-lGKRCJe6E3thkEFEE_FyDgZr8bWdm9HEGmWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyfj0J64kc27oAebc8kQxSQ3cEQGQ3LzEmsVV93nY9iqg&oe=69B5707A"}, "display_name": "VZfit", "keywords": ["bike", "fitness", "health", "workout", "travel"], "long_description": "Ride to every corner of the world while getting a full-body cardio workout!\n\nEXPLORE\nFrom the snow capped Italian Alps to the sun kissed coast of Oahu, experience our planet\u2019s beauty over 10 million miles of roads through Google Street View**.\n\nMAKE IT YOURS\nCreate your own rides and share them with the community! Earn coins while riding to customize your rider.\n\nKEEP CONNECTED\nRide with a friend or training partner wherever they are in the world. \n\nFAMILY FRIENDLY\nFree profiles allow everyone using your Quest to track their own stats and progress. One subscription covers the entire family.\n\nOptionally use your bike or elliptical with the addition of a cadence sensor.\n\nStart your journey today with a 7-day free premium trial* to begin your ride around the world.\n\nWhere will you ride first?\n\n*$0 for duration of free trial, $9.99/month thereafter. Cancel at any time. Terms apply. Go to vzfit.com for more detail.\n**Uses Google Street View data but is not an official Google product.", "short_description": "Have Fun. Explore the World. Get Fit.\n\nFull-body cardio workouts you will actually enjoy!\n\nFrom the snow capped Italian Alps to the coast of Oahu, workout virtually anywhere.\n\nOptionally use a bike or an elliptical with the addition of a cadence sensor.\n\nStart your journey today with a 7 day free trial!*\n\n*$0 for duration of free trial, $9.99/month thereafter. Cancel any time. Terms apply. Go to vzfit.com for more detail.\nVZfit uses Google Street View data but is not an official Google product."}]}, "developer_name": "VirZOOM, Inc.", "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751", "developer_terms_of_service_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056435331", "publisher_name": "VirZOOM, Inc.", "support_website_url": "https://vzfit.com/help", "website_url": "https://vzfit.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["EXPLORATION", "SPORTS", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "465521885178788"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "458404185380353"}, {"status": "PUBLISHED", "id": "1216132765925571"}]}, "baseline_offer": {"id": "458404185380353"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1618506000, "status": "PUBLISHED", "id": "458404185380353"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25992124200384404", "version": "3.3.32"}, "id": "654328514987554", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2088366894520136", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25992124200384404"}, "release_status": "RELEASED"}, "binary_release_channels": {"n
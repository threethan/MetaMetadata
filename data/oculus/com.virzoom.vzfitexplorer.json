3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJD0PlMYMezOF4oyYi9J9o7AOjfoKEGW12na2EX0x6ZA&oe=69B54A4C"}, {"file_name": "Map Menu.png", "id": "190880900735625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622017_190880904068958_2014045255175408710_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LPwL0oZ_VgQ7kNvwFMTF0u&_nc_oc=AdnpuW0H0R96-nvEfbbw20dJjUVGk1qv4QL7JxBu9l-SRzE4wK7WCqqsV56TFVXYHRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHLXXsH3oDQxo2puiL_z-3nwVOGrHfLAupFYQTBnKZcg&oe=69B546DA"}, {"file_name": "Bike.png", "id": "1680122562794336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982538_1680122566127669_1472593559754909886_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwcJ5fJLA2IQ7kNvwFMIQh3&_nc_oc=AdnF7UJKDLyzP8xxgu3Cute9cT6UUcnZw4eDARFQ8Vbhxwfh5BcNqZLa1eOizQaYNNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7OW9V4QjVWozSmHnc-1kU6AfAFmQz1mSvQlDfv-EXnA&oe=69B5665A"}, {"file_name": "MR window.png", "id": "320990224029982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982579_320990227363315_228355221193238434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weeq9ekM6ooQ7kNvwF6rF1N&_nc_oc=AdkoAMhHy1RVGk5rO06zQw4NQn94LZMNzkmzp4bcophGPZokarndaD6XB9UCEwjhGvE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxP05Ru8MuUZQPG4yw39TrSryLw2RGT0lJdyi3KsAYMhg&oe=69B54042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CycleHeroTest1.png", "id": "1206442511002709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_1206442514336042_4388026138984761965_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdQ3JliSpRkQ7kNvwGJByMU&_nc_oc=AdnzqdiiSwDQTlOgZ-UaBXI4d8NHDlDs3Mx6Nc22jGWMLEEvJGF1MtwsQjRqoLxqTVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqFNo5gl8BEBC3iwxFniftw-XTXSY4TwqjqTqyag4ScA&oe=69B54CDF"}, "display_name": "VZfit: Explore. Cycle. Get Fit!", "keywords": ["fitness", "workout", "travel", "Cycling", "Google"], "long_description": "Time will melt away as you move your body and explore the globe. Cycle through real world locations, work out with a trainer, or even test your geography knowledge all while working towards a healthier you. Powered by Google Street View, the options are limitless.\n\nWe believe that fitness should be fun. So we have designed VZfit to keep you excited and coming back for more.\n\n# CHOOSE HOW YOU PLAY\n\nChoose to work out with one of our trainers or turn on some music we and get your dance on. Either way, your motion in the real world keeps you moving.\n\nConnect a bike to really kick up your experience. Attach a cadence sensor to the pedal of a stationary bike and off you go! Every ride is now a tour of your favorite destinations, as you visit the snow capped Italian alps or pedal along the sun kissed coast of Oahu.\n\n\n# SO MUCH TO TRY\n\n\ud83e\udd47 Challenges: timed events with fun themed character outfits\n\n\ud83c\udfafPinpoint!:  location guessing game\n\n\ud83d\udc6fMultiplayer \n\n\ud83d\udeb5 Virtual rides \n\n\ud83d\udc53Mixed reality Support \n\n\ud83d\udcab and so much more . . .\n\nWith 10 million miles of road out there, there is something new waiting around every corner.\n\nReady to ride?\n\nStart your free trial today, or take advantage of our seasonal introductory offer.", "short_description": "Time will melt away as you move your body and explore the globe. Cycle through real world locations, work out with a trainer, surf through city streets, or even test your geography knowledge all while working towards a healthier you. \n\nWe believe that fitness should be fun. So we have designed VZfit to keep you excited and coming back for more.\n\nDance, Workout, Cycle, Hoverboard there are so many ways to enjoy VZfit. Be sure to explore them all!"}]}, "developer_name": "VirZOOM, Inc.", "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751", "developer_terms_of_service_url": "https://virzoom.zendesk.c
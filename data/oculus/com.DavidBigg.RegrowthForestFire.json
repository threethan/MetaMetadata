4162_901453109331778_5258543421936599837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yqlYfokzPkQ7kNvwEmSDV4&_nc_oc=AdpGEJUfr0dZzPNetK-CAcEFxiYlPhwFfKpEYnlDzdWa8-nyaRi-EW0dpfx8Q3Kr8n0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VCk-rZnOTSC86xOneJtibvWWmjMN6M1DeAWz4Ha30MQ&oe=6A342068"}]}, "id": "991918369918059", "locale": "en_US", "screenshots": [{"file_name": "screenshot 2.png", "id": "812502175060701", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303864_812502178394034_618696921979685120_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijZnaKDHtr8Q7kNvwEoxiyd&_nc_oc=AdqLk29R8FH9Gqf_WtD4wathcwM1oDa-_bSikw22ok4rg2cuMepapyENveKUbrcyxds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mS5LYdnLWrJz9UGnOdz2tVDoTH96oyw4foLDcDGsBZw&oe=6A340AD6"}, {"file_name": "screenshot 4.png", "id": "1870260016991388", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304162_1870260020324721_7386457754692836791_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPNeqSTemZEQ7kNvwEx3kQ5&_nc_oc=AdqHh8oXhBDEvGj2Vjfx8__vk0VHbrOlnIw5qjGsNbbALFztCNMO7Ghd5qiSk8-WhGI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_KK1WVU2JhiSxu1Hcqvci71JrPDHEkpa5k05ggbh4UQ&oe=6A33FBEF"}, {"file_name": "screenshot 3.png", "id": "1468136074605564", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310726_1468136077938897_1505690586346890196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEYoQDqPzp0Q7kNvwEMTgeZ&_nc_oc=Ado-wcrHmi1xX3qRbi1_mSmMAQDDikDVFo9cTIbyoeRb6KxXG7KaTa-5DzeIxqyjxrs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A0guJcn96R6vVhPj2vQS8RPLhaxR_rW_hRokK7hQ7XQ&oe=6A33F5A6"}, {"file_name": "screenshot 1.png", "id": "2086941192260906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308699_2086941195594239_2426274760987248690_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=funoadUoloAQ7kNvwE5TLKo&_nc_oc=Adqap6_QYoSluBAnv8d14Mbj2X9VWNz9r9ui3zkZ-Z8ICA8Uhasobkchmw37dp8vvHg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eITJmwoUCoaeh6EBq_qIl3c7eSuuQCC51jHReL7Ma5Q&oe=6A3411EE"}, {"file_name": "screenshot 5.png", "id": "996196172910037", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304938_996196176243370_5326003195381322172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nI-GwrPgAoQ7kNvwHB9OJ2&_nc_oc=Adohgnvl2XQ8h7t3M8Ol4qktzRJXcB5rK33qgjzFbxHZCoT3Wz2yecnr3AGvLjKGmJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yBv4REU_RjdQssRNNaEhloyfXekCCu4AlkkZVJAwWsA&oe=6A33F727"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forest Fire Regrowth", "keywords": ["art", "nature"], "long_description": "Forest Fire: Regrowth is an art experience without goals or objectives. It is a digital work that lets you step inside a hand-painted landscape and look at the natural cycle of regrowth after a forest fire in an Ontario forest. \n\nThis is a roomscale experience, you stand in the centre and physically walk around the world, no controllers needed. Every two minutes, the scene will change, moving from the burnt ashes of the fire to the sprouting of seedlings, transitioning into a lush regrown meadow in the third scene. From there, the cycle will restart.  \n\nThe initial idea for this work came out of the record-breaking forest fires across Canada in the summer of 2023. Over the course of my research for the work, I learned that forest fires are an important part of the natural cycle that has been exacerbated by global warming and a forest management regime that prevents the natural fire cycle. All of the plants and animals depicted in the work are native to Ontario and grow in areas that have recovered from forest fires. \n\n300 individual paintings, made by hand on paper over one year, make up everything you see inside.\n\nWe acknowledge the support of the Canada Council for the Arts.", "short_description": "Forest Fire: Regrowth is an art experience without goals or objectives. Step inside a hand-painted landscape and look at the natural cycle of regrowth after a forest fire. \n\nThis is a room-scale experience. Every two minutes, the scene will change, moving from the burnt ashes of the fire to the sprouting of seedlings, to a lush regrown meadow in the third scene. From there, the cycle will restart.  300 individual paintings, made by hand on paper over one year, make up everything you see inside."}]}, "developer_name": null, "developer_privacy_policy_url": "https://regrowth.cargo.site/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "David Bigg", "support_website_url": null, "website_url": "https://regrowth.cargo.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35847842868164147"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304162_901453109331778_5258543421936599837_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yqlYfokzPkQ7kNvwEmSDV4&_nc_oc=AdpGEJUfr0dZzPNetK-CAcEFxiYlPhwFfKpEYnlDzdWa8-nyaRi-EW0dpfx8Q3Kr8n0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UscnNIu6qBDtFCnngtYyMljZKcf-Vd4-kj2QWhrkP2Q&oe=6A342068"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Forest Fire Regrowth", "platform": 
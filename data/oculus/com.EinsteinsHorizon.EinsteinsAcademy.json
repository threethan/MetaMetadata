amNXxCUCdipP0cxfvuNeKSAL5hf1Duh3Zy9ae9L2WqpVOsXLg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJd-onL_aKB5ZSF07FQ4YMioFRyUgTHVs0cbLSsixjrg&oe=6AFB2CE6"}, {"file_name": "sc5.png", "id": "1975120033333179", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619685_1975120036666512_7209363429382635652_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BD7g0AgfcsQ7kNvwFMURN_&_nc_oc=AdrN4iq4PAnCUv71FXy3Z9p_8pond79ZZKfn9CKtR5dR6kAqZoIuTDAct3dEahlrCoU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_6M8he9qtuuI8QKY2okDQajw61PrlDCPqI6wiahh3hw&oe=6AFB450F"}, {"file_name": "sc2.png", "id": "1889045338655777", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617762_1889045341989110_1124400291452802269_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpNdMyQBNCQQ7kNvwHVPUz0&_nc_oc=AdpmQdS8ZayaWxf54RZ-3ngTwlBX7s1FYPX_LEIbrcSmbZQrC0OOtgB_YIbDkd862FM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWdP3Ml6SjuCkBdbV-zKqPnG4vHK4Iz5JAnOBoDZfrsw&oe=6AFB41EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc3.png", "id": "1940205483205317", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302483_1940205486538650_8676971464544067295_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpKNQPBTCzIQ7kNvwH_D4lc&_nc_oc=AdoxRU4M02BGyOC7d57QgbmYOomEWW1dX2h0QiKbTiIU6MJ17DcmwfYV6bPFJ1rhVZY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCxfCU-wUNxLQyFJ3G5YzGiYjvTKJFAIODxWPFy5RdWg&oe=6AFB3D64"}, "display_name": "Einstein's Academy", "keywords": [], "long_description": "Step inside an interactive VR anatomy lab experience that brings science to life for elementary, middle, and high school students. Explore the human body at organ, tissue, and cellular levels through vivid, animated 3D simulations that make learning hands-on, intuitive, and fun.\n\nReach out and use natural hand-grab interactions to pick up, rotate, and examine organs in stunning detail \u2014 hold a beating heart as it pumps, watch a lung expand and contract with each breath, or activate a neuron to fire electrical impulses across synapses. These lifelike moments turn abstract textbook biology into unforgettable, tangible learning experiences.\n\nChoose from eight immersive anatomy labs \u2014 Muscular, Skeletal, Neural, Cardiovascular, Digestive, Respiratory, Vision, and Hearing \u2014 each filled with challenges, interactive tasks, and achievements that gamify learning. Students can select their education level in-app, ensuring content is age-appropriate and aligned with classroom curriculum and the U.S. Next Generation Science Standards.\n\nEach experience includes guided audio narration, where a virtual instructor \u2014 like a doctor teaching in a real lab \u2014 explains structures, functions, and relationships within the body. Students explore, listen, and learn through play, gaining curiosity, confidence, and a lasting love for science through immersive, hands-on discovery.", "short_description": "Engage with interactive VR anatomy labs that bring the human body to life at organ, tissue, and cellular levels. Explore vivid, animated 3D simulations, complete challenges, and earn achievements in a gamified learning environment aligned with NGSS standards. Each lab transforms complex biology into intuitive, hands-on understanding that builds curiosity, confidence, and a lasting love for science \u2014 all in an engaging world where you learn through play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"},
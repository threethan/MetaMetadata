oculuscdn.com/v/t64.5771-25/499619685_1975120036666512_7209363429382635652_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJUgAMzEODEQ7kNvwEhn2xk&_nc_oc=AdqTwbrVKlLwv5Xg29mNVfOycSnkrPjOrYHVJwCebYMw5d6kA-m-zGJe17J5aMyFVLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLjCZITknCXK-TZveN9mXOtePxKzw8NXg4rQhBocR_0A&oe=6ADF5D4F"}, {"file_name": "sc2.png", "id": "1889045338655777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1889045341989110_1124400291452802269_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFdPUBpD-SUQ7kNvwGm8RRc&_nc_oc=Adoc2P5oNxSP1QGVARnHgdc5_KB94EvkLNOfnhDCQud9TpoUhgsdEVeraeHDVLUuMZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIfkxqxQK7BC7sybeixeCwFNkZfIfFu3LB2_e_oH8YPg&oe=6ADF5A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc3.png", "id": "1940205483205317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302483_1940205486538650_8676971464544067295_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnlyGdwfTiQQ7kNvwF4Zra6&_nc_oc=Adq4v7zH5iUtvEBFAnP87I69uXaSdB05zzpoKmb5ZizQ-oM-vtrZjUB1dfoFghyVNf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqJkL3Jl9KQCe4pfFTCsX4OWYsuZ5rMgWf48ZAtyHxqg&oe=6ADF55A4"}, "display_name": "Einstein's Academy", "keywords": [], "long_description": "Step inside an interactive VR anatomy lab experience that brings science to life for elementary, middle, and high school students. Explore the human body at organ, tissue, and cellular levels through vivid, animated 3D simulations that make learning hands-on, intuitive, and fun.\n\nReach out and use natural hand-grab interactions to pick up, rotate, and examine organs in stunning detail \u2014 hold a beating heart as it pumps, watch a lung expand and contract with each breath, or activate a neuron to fire electrical impulses across synapses. These lifelike moments turn abstract textbook biology into unforgettable, tangible learning experiences.\n\nChoose from eight immersive anatomy labs \u2014 Muscular, Skeletal, Neural, Cardiovascular, Digestive, Respiratory, Vision, and Hearing \u2014 each filled with challenges, interactive tasks, and achievements that gamify learning. Students can select their education level in-app, ensuring content is age-appropriate and aligned with classroom curriculum and the U.S. Next Generation Science Standards.\n\nEach experience includes guided audio narration, where a virtual instructor \u2014 like a doctor teaching in a real lab \u2014 explains structures, functions, and relationships within the body. Students explore, listen, and learn through play, gaining curiosity, confidence, and a lasting love for science through immersive, hands-on discovery.", "short_description": "Engage with interactive VR anatomy labs that bring the human body to life at organ, tissue, and cellular levels. Explore vivid, animated 3D simulations, complete challenges, and earn achievements in a gamified learning environment aligned with NGSS standards. Each lab transforms complex biology into intuitive, hands-on understanding that builds curiosity, confidence, and a lasting love for science \u2014 all in an engaging world where you learn through play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
.com&_nc_ss=7f20f&oh=00_AQNXLaCIAcpcjhQjDlHwnvKCXTFL7NNkv1c5JRcy2HCx7g&oe=6AE60A5B"}, {"file_name": "g54.png", "id": "678510745068977", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620856_678510748402310_2464973708439274412_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2JGxn6d4t0Q7kNvwHJ_Mpy&_nc_oc=AdrY4t7W7ret0ipthqF3o0uCz324mqCxKjzJFVld8u8-fjVhVZDJ0GUk44fgvCxUCM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPceVq3ElVx4tp1EPFZnrOJYEY-aRMlHqfA4nvfz8rGrA&oe=6AE5F7D7"}]}, "id": "1169298305172032", "locale": "en_US", "screenshots": [{"file_name": "sc3.png", "id": "798596216277756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619773_798596219611089_2832993035740796060_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEiK-ms_7a4Q7kNvwEvqvZh&_nc_oc=AdrR-YERZt3-20N4aVORbCvhPd1zWtVjBaPR6O-B3Ra6SHvPKGI3m-z5ocJLFtncGrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjWa1SVsQ4ARhNasUCaSZCRkFfu6bUPgcwV0_y0k0F6w&oe=6AE60869"}, {"file_name": "sc4.png", "id": "1321334135924879", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622095_1321334139258212_1115425861135790650_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXy1WPRLFXIQ7kNvwHAeuod&_nc_oc=AdqqTxGiqmSJjknMmfMpn8R-aIG63hotamqhJWPQlWJcO9r4WbGVDwBb1stKJi2-y-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHiZMo8-lfMeR94sGZqgZvSLEuDjRFeon0lpUGPhYVOA&oe=6AE6130B"}, {"file_name": "sc1.png", "id": "869709088788405", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620504_869709092121738_6070798327497675736_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLZm2l0SomQQ7kNvwFt1uU0&_nc_oc=Adqq525XHCs6wVHNYbqYyNUZAeF_d4pc88nPDDDOe1wYqwSidnxHoBu_BFWuR5sRS9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOog6R29GxqAsr6MOgNndffRH-kdKrpVlrThYSM_qLXcg&oe=6AE614E6"}, {"file_name": "sc5.png", "id": "1975120033333179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_1975120036666512_7209363429382635652_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8nOFvXHdzYQ7kNvwFkEu4E&_nc_oc=AdolvayYEr3dvKEg0gKBAsiP6gPTJWmycpLnhESsI7LFg2iMmpawf3GSmrFzJO6f2bs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh5SLVFiyJTpgPhDCLkn0NyYUcUDl-xNDCi-BliI89jA&oe=6AE5F4CF"}, {"file_name": "sc2.png", "id": "1889045338655777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1889045341989110_1124400291452802269_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYUdCYuBB_sQ7kNvwEggrfw&_nc_oc=AdqwhsZuoFObPg9cXf5Kmcf6jNxQP_BQ8f2D1mYfFVqg7H4jPJ3L7F3XD1EGD2jwqy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-cjoFKCIfv-gSFc63ccOro06SbwsY9vS3zYRRBx5BTA&oe=6AE5F1AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc3.png", "id": "1940205483205317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302483_1940205486538650_8676971464544067295_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtYMXANQGf8Q7kNvwEwyhry&_nc_oc=AdqdwsRj4Ek1Ty3WEfmqB6Nl5R1jibdJyz1tJhG8X9PZ-jUjbsu1LOIh3CGXC1pqlBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoDI5iQ5A7nwEG2_4zdpw0o3elKxOfVCoanDzIw5t2Uw&oe=6AE5ED24"}, "display_name": "Einstein's Academy", "keywords": [], "long_description": "Step inside an interactive VR anatomy lab experience that brings science to life for elementary, middle, and high school students. Explore the human body at organ, tissue, and cellular levels through vivid, animated 3D simulations that make learning hands-on, intuitive, and fun.\n\nReach out and use natural hand-grab interactions to pick up, rotate, and examine organs in stunning detail \u2014 hold a beating heart as it pumps, watch a lung expand and contract with each breath, or activate a neuron to fire electrical impulses across synapses. These lifelike moments turn abstract textbook biology into unforgettable, tangible learning experiences.\n\nChoose from eight immersive anatomy labs \u2014 Muscular, Skeletal, Neural, Cardiovascular, Digestive, Respiratory, Vision, and Hearing \u2014 each filled with challenges, interactive tasks, and achievements that gamify learning. Students can select their education level in-app, ensuring content is age-appropriate and aligned with classroom curriculum and the U.S. Next Generation Science Standards.\n\nEach experience includes guided audio narration, where a virtual instructor \u2014 like a doctor teaching in a real lab \u2014 explains structures, functions, and relationships within the body. Students explore, listen, and learn through play, gaining curiosity, confidence, and a lasting love for science through immersive, hands-on discovery.", "short_description": "Engage with interactive VR anatomy labs that bring the human body to life at organ, tissue, and cellular levels. Explore vivid, animated 3D simulations, complete challenges, and earn achievements in a gamified learning environment aligned with NGSS standards. Each lab transforms complex biology into intuitive, hands-on understanding that builds curiosity, confidence, and a lasting love for science \u2014 all in an engaging world where you learn through play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
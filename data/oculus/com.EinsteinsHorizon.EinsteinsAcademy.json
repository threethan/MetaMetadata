xISIHAhFrde7iLWAaOTg4RA9o1az8LMU4KkMZzGwSOjq6y5tfdqryyUfkGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFrLuGtqQK1BGThA-tgegBZd9tDo3P3ozuBggsgfMc4Q&oe=6A8993A6"}, {"file_name": "sc5.png", "id": "1975120033333179", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619685_1975120036666512_7209363429382635652_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_0DRhDV6x0Q7kNvwHwzBZR&_nc_oc=AdqCzWttvI_FOWBS4msTlTIQ6nTg0OTgNIt7sG5qNNaH2O7kAH10pe3dF9Hbf3KcLPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFahe0JEL3RkhkajqAt5WemWcGgF2Mx5MvKKQCK4roWgw&oe=6A89738F"}, {"file_name": "sc2.png", "id": "1889045338655777", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617762_1889045341989110_1124400291452802269_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYcfaowHovAQ7kNvwH3EM2w&_nc_oc=Adr9G8rzvmMo-rKmNUVv5iwMBQz4VU15xuiE-U74DqeJa3dhWllpzEayI6SY8b0yu9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu9fOaTyy0j4NeBgwKPD_giEoFbLmUpf4nHzDeFMHIaw&oe=6A89706B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc3.png", "id": "1940205483205317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302483_1940205486538650_8676971464544067295_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PUZLyoSoe4Q7kNvwEVtLFI&_nc_oc=Adow2M6vS3uhe8pjbuRUp0GcBgpW44cuJ22alRB1tcDLqoiYUM36rHS6TiM-jqV9hjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVT3t2aqdG3gPr8p0xAOzUP58IqY1IAEdZ2Gd1q0_kDw&oe=6A89A424"}, "display_name": "Einstein's Academy", "keywords": [], "long_description": "Step inside an interactive VR anatomy lab experience that brings science to life for elementary, middle, and high school students. Explore the human body at organ, tissue, and cellular levels through vivid, animated 3D simulations that make learning hands-on, intuitive, and fun.\n\nReach out and use natural hand-grab interactions to pick up, rotate, and examine organs in stunning detail \u2014 hold a beating heart as it pumps, watch a lung expand and contract with each breath, or activate a neuron to fire electrical impulses across synapses. These lifelike moments turn abstract textbook biology into unforgettable, tangible learning experiences.\n\nChoose from eight immersive anatomy labs \u2014 Muscular, Skeletal, Neural, Cardiovascular, Digestive, Respiratory, Vision, and Hearing \u2014 each filled with challenges, interactive tasks, and achievements that gamify learning. Students can select their education level in-app, ensuring content is age-appropriate and aligned with classroom curriculum and the U.S. Next Generation Science Standards.\n\nEach experience includes guided audio narration, where a virtual instructor \u2014 like a doctor teaching in a real lab \u2014 explains structures, functions, and relationships within the body. Students explore, listen, and learn through play, gaining curiosity, confidence, and a lasting love for science through immersive, hands-on discovery.", "short_description": "Engage with interactive VR anatomy labs that bring the human body to life at organ, tissue, and cellular levels. Explore vivid, animated 3D simulations, complete challenges, and earn achievements in a gamified learning environment aligned with NGSS standards. Each lab transforms complex biology into intuitive, hands-on understanding that builds curiosity, confidence, and a lasting love for science \u2014 all in an engaging world where you learn through play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscript
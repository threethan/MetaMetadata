ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_1975120036666512_7209363429382635652_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZfEV_7A_SoQ7kNvwF2lPLF&_nc_oc=AdpJ3WTJcrjGIKt2pIGxhaPTHV5DzpU_qS18QUj5AhbSjdt6xrKhcl0--Q7ZDpy1uoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeoA2_3w5E7CxG6ikd7JX2m1KmpHUsYsfXpBB6DzOE1g&oe=6A49124F"}, {"file_name": "sc2.png", "id": "1889045338655777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1889045341989110_1124400291452802269_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pkW2PzIHesQ7kNvwE7xvHp&_nc_oc=AdoOpiGhTJtH6jsZ-R1OTwP22PFjCzuTITCs7H01WS8k4oV9Z69C3fBo-1sQ8XIpbao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3ytkiwxj_xCMUtAYBZYVwlwbLjsagLTgdpEvBSHY7Bg&oe=6A490F2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc3.png", "id": "1940205483205317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302483_1940205486538650_8676971464544067295_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au7PEnSFTWgQ7kNvwGYMNyx&_nc_oc=Adq3qj1C3PSJgEn1ym5uswxP2EPqlZfKaPsa9Dq_l7W4IftkHw7j3cpSUJGvjtxGWKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7AnkKNxIDBRvUl3E28xQTdOgYm3eXbj4A5NbvprHR7w&oe=6A490AA4"}, "display_name": "Einstein's Academy", "keywords": [], "long_description": "Step inside an interactive VR anatomy lab experience that brings science to life for elementary, middle, and high school students. Explore the human body at organ, tissue, and cellular levels through vivid, animated 3D simulations that make learning hands-on, intuitive, and fun.\n\nReach out and use natural hand-grab interactions to pick up, rotate, and examine organs in stunning detail \u2014 hold a beating heart as it pumps, watch a lung expand and contract with each breath, or activate a neuron to fire electrical impulses across synapses. These lifelike moments turn abstract textbook biology into unforgettable, tangible learning experiences.\n\nChoose from eight immersive anatomy labs \u2014 Muscular, Skeletal, Neural, Cardiovascular, Digestive, Respiratory, Vision, and Hearing \u2014 each filled with challenges, interactive tasks, and achievements that gamify learning. Students can select their education level in-app, ensuring content is age-appropriate and aligned with classroom curriculum and the U.S. Next Generation Science Standards.\n\nEach experience includes guided audio narration, where a virtual instructor \u2014 like a doctor teaching in a real lab \u2014 explains structures, functions, and relationships within the body. Students explore, listen, and learn through play, gaining curiosity, confidence, and a lasting love for science through immersive, hands-on discovery.", "short_description": "Engage with interactive VR anatomy labs that bring the human body to life at organ, tissue, and cellular levels. Explore vivid, animated 3D simulations, complete challenges, and earn achievements in a gamified learning environment aligned with NGSS standards. Each lab transforms complex biology into intuitive, hands-on understanding that builds curiosity, confidence, and a lasting love for science \u2014 all in an engaging world where you learn through play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
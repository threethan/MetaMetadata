eality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "Monke Hangout, A Gorilla Tag inspried game using their locomotion"}]}, "developer_name": "Fays & BT", "developer_privacy_policy_url": "https://sites.google.com/view/monkehangout/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fays & BT", "support_website_url": null, "website_url": "https://sites.google.com/view/monkehangout/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8743639805763157"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393466_942577304652402_2454111339792237005_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSxkjhf8zzcQ7kNvwHYEdBT&_nc_oc=Adqbpf8w6eQhFd8d9LvpUOo_H6dgcWn3j--Py4CsfO4VfFekNIemQrXLm2oGenVtNy8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mAEaL1TajaT9m5qU-CcY7iAOccW0XzUrTahwQe73Dnw&oe=6A073F17"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monke Hangout", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Ad
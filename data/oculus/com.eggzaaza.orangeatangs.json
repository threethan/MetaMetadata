name": "room2.png", "id": "774212518735174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304764_774212522068507_589960894545644132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ7E6hom3csQ7kNvwG3N5xW&_nc_oc=AdqtZpBLyXxlv-74iCSTVbpjqcfwOMle-vJm1Za5icqtti_dShaUxisyE3-ixU721iA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af641RU-2dBh6e2hgXIw-jL6jcDi3oN-MTt7kxjJ0h7Krg&oe=6A1836BC"}, {"file_name": "room3.png", "id": "1195421992358854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618442_1195421995692187_2557295644486395277_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htO65byLpUYQ7kNvwH74Hwy&_nc_oc=AdodNQd9EM4s1u2rq8PnqoOHcZ7SeYFOjyEJmqHfyTDv2k1Uv3_dWz0P7Y9T7MXN5PQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75tBDIvH77od_5g2Lz8shTyh1jo06W3cKQUpOkuMU-FA&oe=6A184A68"}, {"file_name": "Store.png", "id": "1535464067531919", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303198_1535464070865252_2010311606058688293_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2S5pTqzeK4Q7kNvwGUeVoA&_nc_oc=AdrGltVymsk51ts67bItGmhNrFblVwlxOR8O6bu4eZWMApxK75DjSa8L2zmCyAmoSvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CWjrbfN8XMuuD76WsWBs9Z-rfobehrZ6YsCqw5_8Hqg&oe=6A1857C9"}, {"file_name": "hi.png", "id": "752532267932227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307505_752532271265560_3784612403071659799_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTofXnX1zmUQ7kNvwEag3FJ&_nc_oc=Adrsl8mpzKlh5rqcNQURXV1PT5LSDdVFdylIP3dbEilEk6LPT7kMxzcod_NzS3dkRKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OFPaMnIgC2_d3Dfptm19ZMg-0nFLqFhvM6xUhRKCWMg&oe=6A1843B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OrangeaTangVR", "keywords": ["Orangeatang", "Horror"], "long_description": "\ud83e\ude78 Core Features:\n\n\ud83e\udd8d Advanced Movement Horror\n\nRetains The Signature Gorilla Tag Locomotion System.\n\nVertical Chases Through Elevator Shafts And Crumbling Towers.\n\nNo Stamina Limit \u2014 Your Skill Is Your Only Escape.\n\n\ud83d\udc41 Adaptive AI Entity\n\nA Towering, Distorted Primate-Like Creature Stalks Players.\n\nIt Learns Your Climbing Habits And Predicts Escape Routes.\n\nIt Can Climb Faster Than You If You Panic.\n\n\ud83d\udd0a Proximity Voice Chat Terror\n\nYour Voice Can Alert The Creature.\n\nWhisper To Teammates\u2026 Or Scream And Give Away Your Position.\n\nWhen Someone Is Caught, You\u2019ll Hear It.\n\n\ud83c\udf2b Psychological Effects\n\nHallucinations That Mimic Teammates.\n\nFake Footsteps.\n\nLights Flickering When The Entity Is Near.\n\nRandom Map Changes Each Round.\n\n\ud83e\udde9 Multiplayer Survival Mode\n\n4\u20138 Players Per Session.\n\nCollect Key Fragments To Unlock The Surface Exit.\n\nIf You're Caught, You Don\u2019t Just Spectate\u2026 You Become Part Of The Hunt.\n\n\ud83c\udfae Tone & Experience", "short_description": "Orangeatang Is A Horror Experience Inspired By A Terrifying Fight For Survival."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1psaKrFoJoFFMrn2iACUGAyMyb7FGO4w4CNYCBULbUsY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "DEX", "support_website_url": null, "website_url": "https://www.youtube.com/@Orangeatangvr/shorts", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SC
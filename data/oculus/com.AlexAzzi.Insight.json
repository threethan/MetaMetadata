e7a0a&_nc_ohc=xxwoIb0eh6UQ7kNvwHvgjUa&_nc_oc=AdkNWvxf-rHe2jTuBXoN7KCf8GQ_SbyoagBCFqGEllELFyidn0Yk5hKGRuzVyXboyjM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft7bMYE0SoAnTO8YMxpsvghe39MJukqF4g40vV-3lrgwQ&oe=699C5468"}, {"file_name": "Screenshot4.png", "id": "9221959167917020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391911_9221959171250353_8521195896238967551_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFvMtIoTio4Q7kNvwEg2LM9&_nc_oc=AdnmL3mnWPmlL4XPgiEnZyrac_yICB0tf9b4H2h5oHVpBIDgejf7J1R6klqxQimiOnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv1nSAJuJMr_Vu-YlYGhSpNaKyDM2ZOhOY79LQ097M_DA&oe=699C570B"}, {"file_name": "Screenshot5.png", "id": "634513029513945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393328_634513032847278_1733563584377907820_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol6VhwkxoEwQ7kNvwHzJo3I&_nc_oc=AdliPfHR72ejSwdmARawfFUtkUucxyPv_JP32dhrNJ4wJo1cFqViV6X8YAC2c6uYOYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft_gZBTk3lzLmL5WlQKgkXeh83SkEgIPRQChYIDXvsEOw&oe=699C49FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Insight Meditation", "keywords": ["meditation", "mindfulness", "vr", "yoga", "insight"], "long_description": "Discover the power of mindfulness with Insight Meditation VR, your gateway to deep relaxation and inner peace. Designed for both beginners and experienced meditators, this app offers a fully immersive meditation experience in breathtaking virtual environments.\n\nKey Features:\n\u2705 Immersive VR Meditation: Escape into serene nature, space, and artistic landscapes.\n\u2705 Guided & Silent Sessions: Choose from expert-led meditations or enjoy quiet contemplation.\n\u2705 Breath Visualization: Enhance your mindfulness with interactive breathwork.\n\u2705 Soothing Soundscapes: Relax with calming music and natural ambiance.\n\u2705 Free & Pro Content: Access 15 free meditations or unlock 50+ premium sessions with regular updates.\n\nStep into a world of tranquility and transform your meditation practice with Insight Meditation VR. Download now and begin your journey to mindfulness.", "short_description": "Immerse yourself in deep relaxation with Insight Meditation VR. Explore stunning virtual landscapes, guided meditations, breath visualizations, and soothing music. Enjoy a free selection of meditative experiences, or unlock the Pro version for an ever-growing library of immersive sessions. Elevate your mindfulness journey with VR-powered serenity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/cd85b7ef-d2e3-4561-bd87-9daa694c7eb7", "developer_terms_of_service_url": null, "publisher_name": "Alex Azzi", "support_website_url": null, "website_url": "https://www.facebook.com/share/1FbGzpcXzU/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9537605176285550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_982394823468190_2784962302440160334_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Un5ol7y3KlcQ7kNvwGzwaQt&_nc_oc=AdlkugKQ7bi14J1lVnDrUaNszxPNVTqjszeOdQumxoNGq6DfeTXKXwdKr_MK9o71Bw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsKrD5NC943M86hZ-ZQrSBQ4pH6_QFkoX7oo_YhYuRIkA&oe=699C3CBE"}, "is_concept": false, "is_test": false, "is_tri
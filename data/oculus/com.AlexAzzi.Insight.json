kscg5qIHy_y2XVkQ5Ii3ArnuXYgUAiu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_X6o2rhzQSNvkh-RuSnnOhSbhbZP9Qia85Kfc_v7gMA&oe=6AFDADA5"}, {"file_name": "Screenshot2.png", "id": "1364105488111172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1364105491444505_8817341982083637610_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3ncpHoWg9sQ7kNvwHBVKwv&_nc_oc=Ado3lQ7Nsnw90PwIljnqGZ5TbzAhErSjEPVqXrtvxJBBT24fL4OHBYvMFdqGcRWevKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBSANOb0W8HnD-iy4wXg3u4IFdTQzWTkDap6U_5042yA&oe=6AFDE021"}, {"file_name": "Screenshot4.png", "id": "1010146731030828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391815_1010146734364161_1108268336051029752_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yco25gVytEIQ7kNvwHCGoft&_nc_oc=Ado5uwpRvX-Y7R_MNOGZtgpNnMsy2NdC3mugzSULemtrvxs5tH2J5qgXSLAcr4sjAvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKkVi1sA4V7wdL249kZse2vFYAU1HEoof2oy-ZeGbirA&oe=6AFDAF7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Insight Meditation", "keywords": ["meditation", "mindfulness", "vr", "yoga", "insight"], "long_description": "Discover the power of mindfulness with Insight Meditation VR, your gateway to deep relaxation and inner peace. Designed for both beginners and experienced meditators, this app offers a fully immersive meditation experience in breathtaking virtual environments.\n\nKey Features:\n\u2705 Immersive VR Meditation: Escape into serene nature, space, and artistic landscapes.\n\u2705 Guided & Silent Sessions: Choose from expert-led meditations or enjoy quiet contemplation.\n\u2705 Breath Visualization: Enhance your mindfulness with interactive breathwork.\n\u2705 Soothing Soundscapes: Relax with calming music and natural ambiance.\n\u2705 Free & Pro Content: Access 15 free meditations or unlock 50+ premium sessions with regular updates.\n\nStep into a world of tranquility and transform your meditation practice with Insight Meditation VR. Download now and begin your journey to mindfulness.", "short_description": "Immerse yourself in deep relaxation with Insight Meditation VR. Explore stunning virtual landscapes, guided meditations, breath visualizations, and soothing music. Enjoy a free selection of meditative experiences, or unlock the Pro version for an ever-growing library of immersive sessions. Elevate your mindfulness journey with VR-powered serenity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/cd85b7ef-d2e3-4561-bd87-9daa694c7eb7", "developer_terms_of_service_url": null, "publisher_name": "Alex Azzi", "support_website_url": null, "website_url": "https://www.facebook.com/share/1FbGzpcXzU/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9511735382205863"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4290792031148468"}, {"status": "PUBLISHED", "id": "947817607334075"}]}, "baseline_offer": {"id": "947817607334075"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744995600, "status": "PUBLISHED", "id": "4290792031148468"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9555759044470163", "v
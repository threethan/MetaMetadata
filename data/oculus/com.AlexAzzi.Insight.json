-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_3633000606843894_540059476753558586_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7a4X8__VzsQ7kNvwGq1k6x&_nc_oc=AdrzvS-ALvpIaP3_QwHmRdyKJtvk2PjdH1FHXACfjHUQGm6jtGHcIzem85Qr54qxjtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IDNy8l7FFDp__rCXFYJCIK2v00iyMPl5H1SXoQcX-Eg&oe=69EE1168"}, {"file_name": "Screenshot4.png", "id": "9221959167917020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391911_9221959171250353_8521195896238967551_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mccKCSpTw6cQ7kNvwFkUew5&_nc_oc=AdrisPcO8BzFKfppH270h-SXhDxvL3-Pf3eva1VsQiuACYEOSkyiSdbiGBxXADbQfjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dLMThtZFpFLqV45F1TQ8-ToeiTpATvKDiYdGv3FZkMg&oe=69EE140B"}, {"file_name": "Screenshot5.png", "id": "634513029513945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_634513032847278_1733563584377907820_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=388yDUVF4d0Q7kNvwFWIMR1&_nc_oc=AdpVGOB_DZ8au-6AzWJU2qFGKoeMM2BYylh5IdNBhnkg6K9Ut8zXigdyzIcEgeR2Bfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XbZ4C2DFl5j_WwsvkHW8aOb9PJ04l0L4b37dXL7owHg&oe=69EE06FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Insight Meditation", "keywords": ["meditation", "mindfulness", "vr", "yoga", "insight"], "long_description": "Discover the power of mindfulness with Insight Meditation VR, your gateway to deep relaxation and inner peace. Designed for both beginners and experienced meditators, this app offers a fully immersive meditation experience in breathtaking virtual environments.\n\nKey Features:\n\u2705 Immersive VR Meditation: Escape into serene nature, space, and artistic landscapes.\n\u2705 Guided & Silent Sessions: Choose from expert-led meditations or enjoy quiet contemplation.\n\u2705 Breath Visualization: Enhance your mindfulness with interactive breathwork.\n\u2705 Soothing Soundscapes: Relax with calming music and natural ambiance.\n\u2705 Free & Pro Content: Access 15 free meditations or unlock 50+ premium sessions with regular updates.\n\nStep into a world of tranquility and transform your meditation practice with Insight Meditation VR. Download now and begin your journey to mindfulness.", "short_description": "Immerse yourself in deep relaxation with Insight Meditation VR. Explore stunning virtual landscapes, guided meditations, breath visualizations, and soothing music. Enjoy a free selection of meditative experiences, or unlock the Pro version for an ever-growing library of immersive sessions. Elevate your mindfulness journey with VR-powered serenity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/cd85b7ef-d2e3-4561-bd87-9daa694c7eb7", "developer_terms_of_service_url": null, "publisher_name": "Alex Azzi", "support_website_url": null, "website_url": "https://www.facebook.com/share/1FbGzpcXzU/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9537605176285550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_982394823468190_2784962302440160334_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY8R5pwDtckQ7kNvwGR4tas&_nc_oc=Adqe38M0vIr7Xwz5QsJS5haPn5c0QaAkShEa0KlSzkL8WjMHt9x2w_o8b-BbBP6YvF8&_nc_
e7a0a&_nc_ohc=KNsXnYRzKuAQ7kNvwGh6Q9P&_nc_oc=AdmUEpWEhCwcSSkPZISi_BCqM8WH1pXc0trDrHPJK0vEs33P7qmyNv6KD6gOngeKG9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_L-UxiiFuHI-Wd92nDLibA4KxxGXEQ72j1WqtJphg0w&oe=69A6E068"}, {"file_name": "Screenshot4.png", "id": "9221959167917020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_9221959171250353_8521195896238967551_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q8XwnhBEqsQ7kNvwHCYFEv&_nc_oc=Adnu4KcIpjPHxUvFH7R3m_emOtHZ5H-bz4U6hfKiy7msjoNrnVpJe8dGQlSezxWMSEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvz_-muVy238SCphOlcS0hyFEw94PQoOe76ocSO1p42EA&oe=69A6E30B"}, {"file_name": "Screenshot5.png", "id": "634513029513945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_634513032847278_1733563584377907820_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47jd81J696MQ7kNvwG9RxbW&_nc_oc=AdkH5BUslmtT6xMvXo66Gpnb9fk4sFxqrMhQ9oPV4-GGX0rrkPs_oZKDpTX0kX92tIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftxs12C7PXWykkQHswZKmfVggQo750BVp1c4Lt8HUOvkA&oe=69A6D5FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Insight Meditation", "keywords": ["meditation", "mindfulness", "vr", "yoga", "insight"], "long_description": "Discover the power of mindfulness with Insight Meditation VR, your gateway to deep relaxation and inner peace. Designed for both beginners and experienced meditators, this app offers a fully immersive meditation experience in breathtaking virtual environments.\n\nKey Features:\n\u2705 Immersive VR Meditation: Escape into serene nature, space, and artistic landscapes.\n\u2705 Guided & Silent Sessions: Choose from expert-led meditations or enjoy quiet contemplation.\n\u2705 Breath Visualization: Enhance your mindfulness with interactive breathwork.\n\u2705 Soothing Soundscapes: Relax with calming music and natural ambiance.\n\u2705 Free & Pro Content: Access 15 free meditations or unlock 50+ premium sessions with regular updates.\n\nStep into a world of tranquility and transform your meditation practice with Insight Meditation VR. Download now and begin your journey to mindfulness.", "short_description": "Immerse yourself in deep relaxation with Insight Meditation VR. Explore stunning virtual landscapes, guided meditations, breath visualizations, and soothing music. Enjoy a free selection of meditative experiences, or unlock the Pro version for an ever-growing library of immersive sessions. Elevate your mindfulness journey with VR-powered serenity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/cd85b7ef-d2e3-4561-bd87-9daa694c7eb7", "developer_terms_of_service_url": null, "publisher_name": "Alex Azzi", "support_website_url": null, "website_url": "https://www.facebook.com/share/1FbGzpcXzU/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9537605176285550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_982394823468190_2784962302440160334_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EhmaMMXxhcQ7kNvwHQiAJj&_nc_oc=AdkPXZXG1reX-T47T9evnDIX7Q5Q_UtWZ2knLs7xIrzfmbc6SEszcFZMP3NOcAApuvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvb2xU6ccZZF-6tjwhcs1BOZIFThMWrS_dWpnLbQakU3w&oe=69A6C8BE"}, "is_concept": false, "is_test": false, "is_tri
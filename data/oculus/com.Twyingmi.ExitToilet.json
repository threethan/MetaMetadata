_ohc=g7yYYk2MUvsQ7kNvwE8tLWu&_nc_oc=AdoAGef544RTNiScsIDjaSIFRhbe2GjsS1cqtvmkkpBNkNFRIYe71Can2DJ55jLNfa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ5JL6O9GdlyalNBCyb9QS3yk_wd2zjS2yNPNosS_l_w&oe=6ABA60EF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-KfQjbSlgYQ7kNvwGtpX_-&_nc_oc=AdqqWfvWAEe4LZFKtXRGhuwJzPR2SuTQqOvvdjsQR3OJQKK7m-X21mQ8w-TgDoMrkss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3IBViCqIcdLijHa09JxQ1_hh2MnWBUNz5kcs8h3vbbA&oe=6ABA7D27"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VXuxheo2GkQ7kNvwEq2dQg&_nc_oc=AdoHvuUUL5o5ctOYY5LVwfHW96KzHvGlYJdNfbKtbHWnknggTWp2dAsBHb4fu_N2uN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSwkVW40QH_u_VIj1cFBjXAPnp4xB5yHaR7EIZhwDCaQ&oe=6ABA5C51"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mmv5b_hPLQQ7kNvwGa7kXV&_nc_oc=AdoAj1cHEdK07NrEH8J7-9ALGs06pk-3TD2wq5aAaGZ78lpQIZa4W2388L4R-axREew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOJtq2bu1yik8Kxoz3d9d76nyx07NL_sTP069rfDZ8MQ&oe=6ABA7EE7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Pn-Tgfl-AQ7kNvwEJuLPt&_nc_oc=AdofsC5Sa1wXzBNAGeY24qEyzTHKZXhrQbAMYrG3DQ6P5hPhynfW9f1QCS1abgCv6Go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbW8UK8w1sTogQQ6n3uKur7K_WeL_bDsK6ihavOp-t2w&oe=6ABA6DC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkI1EUVkqFgQ7kNvwGEbA1G&_nc_oc=AdqfViOE5PrTIxjztM4d5IraK-IFJVNYkcL5Rn48DqtDNYLYtKXulni65pFbzm8O8Ls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzWqmgdl7eHZvyqHzqcUryIndMLvKIi_DZ0gumSLwsnA&oe=6ABA7BC4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veA28_r5eskQ7kNvwGa5rjR&_nc_oc=Adqb5zMhpyfcFvK5ZHxxzVwKCN1j6ZQ97dCAW3kL6O-gz0DwNgrWTNiH_8qVRB-CFfQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_YPecuTrgJRj-MXqQV0KohN0yWFAa0bPsPrP9fn9ufw&oe=6ABA89B6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaMGVET0oxYQ7kNvwFZFrVM&_nc_oc=Ador8wB1lrfSINaJUn1PbO0ZaRPQYBoblSDPYTTMS3b32jvw5x7U2hpwQCAQWcVMlpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAeCn6gd4k81ujdYqZeSNSZ97C1fa4NGPGzh6zw3IkIw&oe=6ABA8D0D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06ErNR9xPqQQ7kNvwE1x2MV&_nc_oc=Adpf9FqvAtLvltI0JsxEhXpgS0iIlw8fnA17zoYvUZiUGmQIV06m6C85coGsiJnu_9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqseLGXrIfnThddNeTzDL-5ByqqGva3yFswQFuMa6ZAg&oe=6ABA5981"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
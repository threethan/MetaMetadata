_ohc=swByg8skI90Q7kNvwEyaBSI&_nc_oc=Adp4pWI8ric48m1eOGdB9tgczTwpwA1ED7eXgma4ihdF0BHQQ7GwU39qDkct2SorHrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVKtmyV14k4bEPK4_6nM7SPeLmDTdblejnfihNfQTNwg&oe=6A6DE9EF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pfvGm_j7yEQ7kNvwGXhGRa&_nc_oc=AdoOKVejQI3Lw5BQdYWkhpYbbW2chtsa8X5iaWfCe_ym8q0T7Ycopz6OC_KknJ1Zagw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjTE0MRi1U8-C6c9-TtgSSBtVLCtXcYK7cAuTKKXBYhQ&oe=6A6E0627"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDj29v8cL4IQ7kNvwFchvMT&_nc_oc=Adq3584_8b0IAfXQlfs1cGnZF5Ps1B_JYpg0f-DyfqbkxSptc7Mx5CCxFJgED5sJmfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQtAnXqH6rQ8F23zYH-BZ56DnWeJQDvT4CnWnywCnPPw&oe=6A6DE551"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6V2g4f2xBUQ7kNvwGC2Ecf&_nc_oc=AdqEcwHjpA9kFFyPU7eRV0l7K9rfvoHx201z3V4Cq29hs2ZfDhrh62OEnHptY8J9BMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXf4zxnpz1_vyx1CAcIG_j8cBh-vSbXxxwFb5HaRmL5w&oe=6A6E07E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1I3LzbkGiQQ7kNvwGwtSJp&_nc_oc=AdrZyNPrb6VBRH0m8VlTQO1kDnyHKVoUzOH1EWfNMH3XVeg7wkW45QzjjhHK_A8j8dk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJJ_GJ7pXTWY7jfaHULVwz1nqBcmaREuxxUklu40Ir-A&oe=6A6DF6C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yBcYdS65_sQ7kNvwEReZ8F&_nc_oc=Adr1EHAEb_xVoKnX_e8DbB9T6PoFQXxl4wJK-J3iy7AjG7Dc9dXWGR35xQS1CRHvyEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXOIqMvZCdjUlp17VifMUGEdSKpBESZWlQWzX73ytBHg&oe=6A6E04C4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vVhwEkAmxcQ7kNvwEfJ8UD&_nc_oc=Adr-U5KJQCFLaMt715e_4WejSPZ6QzeBUPmuQG8YXtYbfA47YarZDsopGqoD_3SotxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWMoZ6b_3cf7sALmXU3pipah6dVxTRUw5ON5wg_eKONQ&oe=6A6DDA76"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkvzgXN7STcQ7kNvwG9R3pt&_nc_oc=AdrxpRXHYSVlpwlHYf6EkTRl7hP_OS21OTXrwpLr9p6iJXOtR1k64OoeOruUf6eXDpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANIT_2bTuFtQ4FTpkKNqf94_YUY0NMseNlUaqKtEON5w&oe=6A6DDDCD"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04cxJXVtuMIQ7kNvwHtKcP0&_nc_oc=AdrZsRbU6w28GAWAsLMxjb1cFPREnkELesI_Xhypchsmbx1NLC9N-3vNhI_Gqlhc5uk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFvfaDly0pvJpDr66GaEy5W8N8XjPx6ZHVDqSE0N_WFw&oe=6A6DE281"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
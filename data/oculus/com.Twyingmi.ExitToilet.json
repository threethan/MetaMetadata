_ohc=HZonOfUJ7hYQ7kNvwHk4Ore&_nc_oc=Adp5DKnOivLCNCLE3FMa5Hc5gF4qbZTR3xu8BFCn2oQCtsPnlas7D2x5M4wSKDeGJ_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXlIaxDquOiOaFKQ1W-RyqJ744d6prGxA0YwuBez_nJg&oe=6A523A6F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw5_Cp40pMgQ7kNvwEKuXUc&_nc_oc=AdrlTlDjAzwmjZE3SyFfxJVwtmD-BDF0Nglkz5heEv57cz4EyCQiqYcFoKSOjyRsIBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpPKdKDXkPGs1ObY-YoJD2d9WkKReY_MGh-TqD-irA2Q&oe=6A5256A7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgvWrsO6l-QQ7kNvwFYWhmb&_nc_oc=AdoCsi-13HTyifZae4VX7dTWTpZNAnv_UrYYT3Dgb6dABIbBieSLIs0a7fJD1MtpBnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHvguzeKpuP4-rEIFeOES4AXwFyNKU80h0ocmKbrs6PQ&oe=6A5235D1"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VT_zafHGFkQ7kNvwGdGb2y&_nc_oc=Adq31B_6S_NPLBa8akO0p_sZ20T3l-sAca4mfU_W3_XApILAxSR-KEgd0NMmKE4LWIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPF4Yz5zlTBUUzpjCbYdXjca6mzcgXIIksb0vZXbR6Rw&oe=6A525867"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKQJ_p_retIQ7kNvwHDLiV5&_nc_oc=AdoW_RjDL2k4gI3tfQjZbDH7cVfwzYBu42iV-gH8e67SOfn35vwpfrVOBDH2FqkcOOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBccigNjMFXVlB4-hdD6lUI8Z2hLLA-RRRVmQMY2DtddQ&oe=6A524747"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4xOYa44FLcQ7kNvwFUr22F&_nc_oc=Adrk94GJsTbQXzP_WfygH2Lz3ELb40m9WSXd6QkR3y8IjxabVLZ_DD8hxJlqzY_uVhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuULnQUzC6QLLCm9NnAsgZQz2s0hRjfpQ5wLfPeTqZHg&oe=6A525544"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_legLqCBq2UQ7kNvwHpc8To&_nc_oc=AdpjuFJCuYk6HjLzYFEttm2TRarPFevIWPzv_SvaerogHXN0bK3jk3MOTaBVGG8LaBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPuWAnryv5PitrDOwmzWV7UpCcfgloa47ovOE0VLgPHg&oe=6A526336"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH7Cazt203IQ7kNvwGs0a6r&_nc_oc=AdomzY8bhmHs2qMMp_2OpBuxZs-rFIBd8FOZ9w70-ksmzO2CCiqdZuQDk-WVXQwrJ8M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT4hFnFdvlzmDUeU2pVwjDdf9S_1HS7ph3btOkhsIQJw&oe=6A52668D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlet3QuR1C0Q7kNvwE2D_51&_nc_oc=Adobi_jdTTeUQaWpDNRdCMXjusaHYhDdskny_4C6sJgZS--rq4Bj99oNzekt_FOhtiY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWBXIGqEXQlduSvpBUoZg0nFbIR4JBhjV2woUbAJ1HeA&oe=6A523301"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
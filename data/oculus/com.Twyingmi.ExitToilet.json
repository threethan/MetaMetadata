_ohc=CokKpAPTyM0Q7kNvwG3uHuH&_nc_oc=Adqs9QENUWpZemAOaSCNJvOESNwerpDxcP2-fPi9QrJVbaPf9Sc1M1EaeKuIdrxJ_k4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bQ23-HjqsLwSl1atvDxoIBNkEXt63QpORAfcz20nOKw&oe=69ECB6EF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoQrdqciyFEQ7kNvwGybwhN&_nc_oc=AdrDghy-2yIuK09S892dX7kgZyP-4bESw0xHVwV8T4dfKawga7Gxk5Otw15ojI5VDY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZG0KYuPMRb9v6D87zmqUp8Kc742JAGN4NqrMJEbJ3Sw&oe=69ECD327"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbX76giZtysQ7kNvwGWAdDX&_nc_oc=Adq3zuikycxqgecUb2nFPvn3cRPjn3UflZm3bdRJKBHqxuvgmSUvp6gVOM0VtSAVvxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31VrAyfsa8nH9JKjWwlb8ZUl7kyNY_r3TmFsMYokfcFw&oe=69ECB251"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USZu6urcIxgQ7kNvwEFPLzf&_nc_oc=AdrQaYg2pZqsrJpcVhuniWkm4vwGsSu90Q9DKumCdNysqtxHDNaantC8EwxrXv1aihY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MifB3PJYzaPm0nJQ9PAL8DMZCK_1TJGx_e1xPVGozmw&oe=69ECD4E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCO4obaSBisQ7kNvwGPhb70&_nc_oc=AdrCEZdKnmAPKRGJzQihSyaPlTTUn_mCswJMw0EgL0LVL60HZNgFmfag6Y9hTf2UlJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s8THg9vMJty7u08r6doqVicBfK7Ua4kYi-inmsVRSHg&oe=69ECC3C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EdIXHPFJz4Q7kNvwEDKkZg&_nc_oc=Adrpk6mKj5Iql4fHKiAWp_P1Jb9VMjeTJxMgqF_eWULiXi1Seve1wO8W6-oc6ZQOr9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3damgVdAg0zV8HVp95ULS9tVI8PiQXhL1ay6_jEW3FDA&oe=69ECD1C4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a2adFPCmtkQ7kNvwG6iHSd&_nc_oc=Ado01m3LqcyeYtZ8G5nrnDnqWCSHvktjVP1BvhdJk5MWDkP1JjOK1WOxvkaPcSTY3cI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xsGnM9e_kZRl3BUIYB6kj0R8FbguBI40he23gi_WG8w&oe=69ECA776"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66aam8_3jQwQ7kNvwGu0EgY&_nc_oc=Adp8AbIug0ptpeIeX6Cbmww7Xmk7BYRntxSJt3DDUezfw_X0s59IOGQDTuqw8kpT__Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lJXfaFdU9y0QeGfY7fatA-Sb3oPqOfMo-Wqsv_M4q5w&oe=69ECAACD"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KSWRdoFRSUQ7kNvwETNmJL&_nc_oc=Adr-ktDF-GCNwujwr6Huhl7pSVn3dCTfLfQ2WsX_hfsaVd_7t_ZVBhArV8jQgADsoT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LDF58zhgSNeQWDgE_URdSyw7WHXvjQlBBbCmuTWcQ3A&oe=69ECAF81"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
_ohc=misGu5sAUfgQ7kNvwF8Ghz2&_nc_oc=AdpNq03XmM2k4E4AsBtYsUsUzPWXWwjFzTDTtDYeE1f8R-0uqWbFjR16IeNd5m7-Wxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfS3Js5EFOmLNot1ZOpR1Y7rDCvV-mqZuqfPDIhq26pQ&oe=6AE76C2F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEoc3bQxM1kQ7kNvwGvo67U&_nc_oc=AdrYOdiU4BTxJ-VglJpdseeTaNL_mowwIR-fSyHnM0j1dEX6HRSRLy-6kU-TJHoNC1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdq6OzbVc0DJjLGU4zNawg2TlheyPbbdzz8cDJZJ4xDg&oe=6AE75027"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQcb6eUNBP8Q7kNvwH2MjdG&_nc_oc=AdqNKTJdYekBFUqTICDHHPsEiYJ-bzU2izqkDKYIDaDlVq-e9LxUIxz2xkap3mx9v00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrwOS8Wr8hr3Y6Xp1VFcRBb9QSjKAzPZVAShnrQwluvw&oe=6AE76791"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v833gO-FjRkQ7kNvwHgPj2N&_nc_oc=AdrwFGuKNjVGZODXIlIPEkcqmOt0EzPo0OdoTRHgGJRYwgmZLpV2rBZMH8fwHLvXdHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkLD9qPtrGx5kHOSU5VQdCQj95ovh2xc3Uib_SEWJApA&oe=6AE751E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44brg3er8yEQ7kNvwETS9yi&_nc_oc=Adr_T2KStE9g3hGFSVu_cMt9WBBryqTXAnxt79JA4g1MCRrEWrhMyd0zeDTpXhu8jsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTotF_ucRiVK041777vPqHEytkrMJVemXNA1V0TlP5t8A&oe=6AE740C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG325DqlnvEQ7kNvwHrfPW3&_nc_oc=Adq-SfYbQtufyFFJoJcsY7B2an1bg5_Pnog58YY6tvXlW2GxhICSL9G6EfsYzHcEfeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa5nWKoVvvxi27UlYNIYzK-DJXfSkrbUylMt-r_rxhVA&oe=6AE74EC4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWaRW3wCClYQ7kNvwERpwTC&_nc_oc=Adpgut1Tg1BR_bnJdSAlh6FLnt3TpakXKxqVj7LXsAMT27Jrq1xiy8JrRwTlBvN1sHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNuarFXKAHlrfm4I9pboEjwLmwUDkg9yXsxAVs7LWVpw&oe=6AE75CB6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xymICJuS5zoQ7kNvwHUCVmc&_nc_oc=Adr7mBy_49ZrGRiDNGCCMPtjFv40zrvuT8__z3AzO9ji-86JenyE1pSFrW2q8gEbrN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhKlZnM7UK_4Mk5LhUma33mX2tzMPPNoFKavkV6te1Cg&oe=6AE7600D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmRfP2zKN0wQ7kNvwF8bPM3&_nc_oc=AdrKz9XFtDDGTjng_c1fjX1GVML8dMWpywCbRDw9wZnrUJQ2X0MZVOwCtEDtViGNDD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5-64hZ8zceO-RlD3LRuiYk4H7Jq-AyHh7CGc2SCUvEQ&oe=6AE764C1"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
_ohc=LEFvEhUVqrQQ7kNvwH-E0Xh&_nc_oc=Adr34lj5B5O1gOD9-VAYFB3XzrvxXyrA2QAZ5PbBpTdf_M_3YaZFB_DqqhKOcH6epGg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXQl13M70azVnGFyP34GNNCK24-xXUlQOl1oGt5tN99Q&oe=6A91826F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5xPZvsxMLAQ7kNvwEyXGjx&_nc_oc=AdqlnbmIjhgpdePJQe1oWXln7UeSvy04OHz58T91Gd0Ye4B7iT1FkEDPsxJ8xWVMJ4Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZGrKsDfKGWzigYO122Dd5ulHmmujiPB_hOAjsoG233w&oe=6A916667"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVarmbAV5CIQ7kNvwE9C_H9&_nc_oc=AdryCtHFyf-trMp-atHyWw6mEHIRApZ8C5q0u5_921sZiiHU7H49vhL2NAyAHiNnpbI&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBFE2SDrcFTrBCsIWrEYOHkQ4bAMk8r-B6RsONCB3AVw&oe=6A917DD1"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwLEna3gwuwQ7kNvwEbWb3Q&_nc_oc=Ado5GTU-fpc4jaYuzvEBb3dkK_0gYI8Xhqg4I6URaRV0v1q1EigAs04BOv_GqLVKKPg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqkzMb4mVCvI3h-1zFU6BPCVTarsQwuddRCxoWspW4Dw&oe=6A916827"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NFP4SQyCdUQ7kNvwF4LcMv&_nc_oc=AdpdyX1sQZb6WtPvU0ISQi_u1XEq0tXKU5_16Je5bz2VDB9GkNhqcLk-rwRbUFSIxdw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoYygXdJP1owrUpYNcrCXVzzhemtL1TSE4fC2fKHliHQ&oe=6A918F47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oUQ9Anh0AEQ7kNvwF108dI&_nc_oc=AdqcF5AHGaR3DRFRzzzBLvbvjo17e7jYA_f58eIR0cdLey_h5s0h2ptgruQ20zGTNwg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6PH0J2P9kab7nDdhXl8o1NnUz1GfKeeVF8S8ITX599A&oe=6A916504"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgCp4_08whEQ7kNvwGNFJZG&_nc_oc=AdqAfMomh-H91RpuDpbEy5-SzeoU8F0RV5fXMJ4xbYftaiYnqB_g5YX4G6DQ48PzIMM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd_NtB4M9fGZf8KeSCP_P2hzDDTkoxXeQ2ZzmounUr0g&oe=6A9172F6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4Ie0b2CDR0Q7kNvwFm2vP_&_nc_oc=AdqxvlJ9B-LRcqNdzclJbn03cSVFnnFB5EVUNr_M5ytAxiMkyc_3HPwkaJZ6kCQWyIs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhHOFJtPbyHk8XVDwr72C9wdSB8jA2jukPyHedZJT4Ug&oe=6A91764D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3VmFzHhk6oQ7kNvwFNbJFH&_nc_oc=Ado0PMxE3tdRZ6GLc_aR78yTQCtdeHDRNEmx6XFLtPLmlqf9sFbEa2Ja3RAycGKUc2g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqfKI4gg3UyR1s-XwnhPS8WaULs6a3LLDn6T2UcjXI6w&oe=6A917B01"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
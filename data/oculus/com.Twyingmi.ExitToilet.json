_555215454156453_8210228459532286213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJmeCLBK7YcQ7kNvwFBpm-1&_nc_oc=AdrmxiS6QC1v_BEi0z4E0LfPa8kbjD5Ex7rK-3KVVeFvkwf269wZN-zBxk-dCCMc1wE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1KKiU_3pk6MAYUMXJDhnvh4mIPKdKYbdvc82MPppCBA&oe=6A412935"}, {"file_name": "LOGO.png", "id": "546224041743355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254872_546224045076688_929302427766597094_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9rCCaVTU7IQ7kNvwHIRLYl&_nc_oc=AdqmS4PMbHtq0CD3lzxqQYzWPwzHnZVTTBbZ8chWdY3AffJw7SDMAS-8h2MLAOzY8Gc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81ujQ-leJgYKJ_rypup_o5-2tPA3ctfl7jrp-dZjFSVg&oe=6A4137EF"}, {"file_name": "LOGO.png", "id": "481353054986933", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982571_481353058320266_8323553705772118782_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OodIfRHONXIQ7kNvwFbE_Za&_nc_oc=AdrAfxQ8UGLTIuMIhkF9-8mY1kRkDLfSpPurUL-pj07LaLvxn2SeG4monX_5MY0BslA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yfdZYGeBK9yaZMKV5oAHredOULdrCzYcYcR0uZGoEVA&oe=6A411C4E"}]}, "id": "1653106295643620", "locale": "en_US", "screenshots": [{"file_name": "\u622a\u57161.png", "id": "1263597101604830", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75593946_1263597104938163_7676510348918364446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKowYcT2JpUQ7kNvwFmVWo_&_nc_oc=AdqZXD4gAm2VHLByOwfIG-X23NNRWxSJbGylOMi-0kMbkvnVGayIBAKTo9ANDUhILtg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kFLHZko-6XOwjA8guTZ-lbJ54FTcaKTuId4YrJsLsxA&oe=6A4116EF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CVzsmFhnW8Q7kNvwHU-_xi&_nc_oc=AdpdaXC_16GUetXVRvjaZt1_3cmvPXfonLKzvt2vGEe21Ch0k9KVXRDKxe5K4B53A2g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gNu0Y6vJlnRFOgr_bj4bAyGyNWKZSTKFA5qxNdQ_nLQ&oe=6A413327"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oadPlMxEsYQ7kNvwEG-Taj&_nc_oc=AdroCJK_3uP5vZoNBbGjeCtPGKuZVURdKJHV0a-nbqTB2DtXQV-xuJd4H8ndVVOgWmo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VgX09cNTduz3IMT6xukiZcW_-7G4EaRurTOEy9RXLiQ&oe=6A411251"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NNWvBtSGSAQ7kNvwFTboth&_nc_oc=Adplh1cF5xUjjHiFqAXz1eVhLrq25XQV987KsEh_bBNZSxiIYscv3oUKl29Jp9-OVAk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ym5N8OOtGn5SmGGiI2cUOpZaJiamBeIFMfCSbCP6JhA&oe=6A4134E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oilHvwazyRoQ7kNvwHTpzHS&_nc_oc=Adrkf8GwD8lhVShvssksIkkHvsCNjZJWMcUR-jPSIWXX7eI2SVz8gYD6AvKPe11ZMz4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99ZHc1su37bgSTe_ggza90FwbQFnmjjDs7SW9b7HP89w&oe=6A4123C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPH0Jk9kJxYQ7kNvwGYgDF7&_nc_oc=AdqxG8iQXEpS7GYtwGsmd-hfEzsvbpZLWeFT1txJ95ajphFLCtpy7U5hrOBL8ACld6o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ts_v-fZUYBMyIg6F7IbicsXPd56Z_LQMi8
_555215454156453_8210228459532286213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXLzXLtIZ7UQ7kNvwH9wuHe&_nc_oc=AdozTuQ2E4kbVGcO3PE-eJgjMBgPqC6I-OK4dWuaPydbnK_ULlmzdB20O8pAtrEBpm0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDraI2jLmdD8sFanBnhjgHUgXzg_E1o44R1cRyFsd8s1A&oe=6A637035"}, {"file_name": "LOGO.png", "id": "546224041743355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254872_546224045076688_929302427766597094_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dslFPZuRNZIQ7kNvwG8gfOY&_nc_oc=AdrOgVLaacB5wyEh4fXzeKguYX6TctjvLHjZ5y-Gt1Z7Z2V_e5T6Y3eIei9a8EShMN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyGeO_BvX8PctDNeYpSXvo_0FVIOc3PLFLWioa61XEpQ&oe=6A637EEF"}, {"file_name": "LOGO.png", "id": "481353054986933", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_481353058320266_8323553705772118782_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTJ3BbPsDNMQ7kNvwERiyKl&_nc_oc=AdqpV_JHybXn9tM6KW9oyUyhsolU674B8lkhUS1L1Hf1UAbUa-3qIXOUcHC6on36KMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl_tEK9CQB_rdsLOIO7TldDih9cw8LUwjQpajNzgWK3w&oe=6A63634E"}]}, "id": "1653106295643620", "locale": "en_US", "screenshots": [{"file_name": "\u622a\u57161.png", "id": "1263597101604830", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593946_1263597104938163_7676510348918364446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSDC9MlFKx0Q7kNvwEJzabn&_nc_oc=AdpStIp9QJMJ-TuwdiCBQHiCygFb1FP3-ZivYiY0j48wjOUcDCD0xL6Lidp4Enxzx6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuPZVmQkC7PPJ84ugDHzBwSAAocNuRD8PQNS8ejl-5EA&oe=6A635DEF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3FY8dq6pPUQ7kNvwEND-9z&_nc_oc=AdprWcbn71gyUh0o5317WzXHmpVTVXU8uBdqz4PiW6wceeNHIkctEUmkY5ICSkXlfp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8ud1ETor2c3-TfFD1iaKYAaF4bqLitRaBg_z6kkRlJQ&oe=6A637A27"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BIEQzPoDukQ7kNvwHl32Zg&_nc_oc=AdovgzH2zDAYp_3he52aQRLFlAzrgw0ce2r9cVA56qSxoTWZ5jFUNVEso61dm_a_y6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrCGpqApYJTvhjBEiklL3eIQQHsSecXbnHjoI5PCyX9Q&oe=6A635951"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKEtvwVY-qQQ7kNvwG67OkE&_nc_oc=AdrcN8Y52sHt4fNS3q_rzeo1lhDHb83Pw0luO_EmCJ0PDsMvWTpp9WB0_XKnE23bq90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBSaZAocv0dQzy4IXyh6KHWnxhc_Q7KKYRSaNYXeZYww&oe=6A637BE7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7HBt5nheDMQ7kNvwHhrrCF&_nc_oc=AdpYiwjvoB1yMKOQJF1dXCn53Sz9YL_h6Y8kzXOpd24Pfl5J_c660mW1oX6zXhHlXgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUNIyTUtz_ynE3OYJS3moaickYe1SNBepfPUZRwEmHsA&oe=6A636AC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySTnVFqBagcQ7kNvwE-rZ6t&_nc_oc=Adp1orQ35UxXwQtQQ0ZKeeuGuCXinWEjViMezzzKib90ltxSVJxuENnr8NXBIonFArI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfMzSVcbg6BhxMrnOKGRNAyqNazUVLLtq67
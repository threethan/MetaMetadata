_ohc=zgesuZkvvmEQ7kNvwGaZa8W&_nc_oc=Adpj2HIlD4yQM8_7BCg5tqhhbGXRbD7YSSpEkSpfONnoEgaeA5aaNCYSm8ZTY3lUamA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-DLtClWK9jaE1YYaq9O-gGL1pWwY_6WHSvELd44zEmg&oe=6A71DE6F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60xYA6x92WAQ7kNvwFZjWi3&_nc_oc=AdpM67BizGsaQSTnHkibuz-LBMEO9s_B4k12BCs5Q9SEMunCy56BfnF_-YB-K_nVL74&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb4Y3UbRezyRQerIe_k9kZYycABon934TGZlT2ppCXow&oe=6A71FAA7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gyr4q6hjGo0Q7kNvwHeFHla&_nc_oc=Adpglrghl2e_33pI8r1vYRy3V7bFfb1RergG-awLVgX3vDZdX7op4lOHopIEz4DqMJ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB7n3ozQVofEY6_33bprA8KRTidP1s5E6S5MRfiQOJqg&oe=6A71D9D1"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qYFNIlTsRkQ7kNvwEg6wwM&_nc_oc=AdqTCpTFHKakg-BKpPSQvFD4gM63AhBmxCvICICDA3wVZEqa2y5dZSJuN3y1tbbCulU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUanoSzSY49cNKlDrJHYeQST5Y7OyWl5RUNV7Lgq1gzQ&oe=6A71FC67"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARXadi7P5CsQ7kNvwFOKj7q&_nc_oc=AdrFL0fbulMpGpcMSpfSB94opl6prG-r67PV-pzkAqHUA5Ecy143wK2DqgtZbmaDcy0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhbiBlre7jyDoltZdiXOkacXgTThAYmXpQtEat2NP1lw&oe=6A71EB47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8e1XJFlOtEQ7kNvwEFJ454&_nc_oc=AdqWcf5xfxN9jVRTp__qq7OQPTFOMNjupN0dI9ED0n2EHqcmSvVpZvwPZxMoAoQSAwk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM9zT-oB8SpA0h7ufJgGBWGmQHKGgcx_Ja9NExVqaleA&oe=6A71F944"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAuPc4yVdOMQ7kNvwGNxnMI&_nc_oc=Adoo-c2aGXw8tBkRasuScrodRfAk882PDYZs6C1H7sHTyO8gtA5zh9ZW7mF4MAjhsso&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtDfHN7_QbRcKSK_MxVlKHRO0UVUocmBIAAXRBvqgwxw&oe=6A71CEF6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZEsusO3giMQ7kNvwGgXVHp&_nc_oc=Adovi2U-gUAc7saLXoWv1V5tw-5qslTDgBlwjh0mPC_NI5EymdWBsWKx0ptT-bXkSl4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzzjzhJNLS2orpuRhWWPUraX004YJPfuJUDhW-fX-F-Q&oe=6A71D24D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNGdzmJWMfAQ7kNvwFPglAB&_nc_oc=AdoH77XxbjVjNoAvOUVIZ0HjWQpb6QH1tF4lKR_fAXNifcr_nxJT4ZNIpYCwWNmz9zk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu0zp6Mzfoj2R4JLdA0K250fOtdhHiRfdSLxZlkkRUQQ&oe=6A71D701"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
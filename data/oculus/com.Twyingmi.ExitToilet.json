_ohc=fxy9xtjI6ncQ7kNvwHudz8m&_nc_oc=AdrYtUuMZEIKvxk4JFSpG2gygDsI6wAfL8GT9yfFwgG4IcSq8mQb0Pw_n_KBL1yp_ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ANzqSSs3xHx5J4gO7w-rt1-tB2fMtSejXPWOVWpLgUA&oe=69EA13EF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiXXkEbvH64Q7kNvwHdDR2R&_nc_oc=AdrM2YT9oj9AlaKdYNG9dcwLoCmqcpTWmxYtdyIfgc2SUbew77E-RbIQq8YPZnogJCs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jCcbcN3ppE2NrPxtwB9x5DmJqcYkNo-f-1uVMJhSCog&oe=69EA3027"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbX76giZtysQ7kNvwHjcrio&_nc_oc=AdqoOyZ8y6h9dSQmbNZEmQiU5_5pi7q2l8vGaY5Jnl-GJJJHUMPOC3VUMCgWihTo29I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oCBSzH_eUtf8REmGkNoX-NMlwyPTLoCOsRf9l5P0nFQ&oe=69EA0F51"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtNcuPsdXbIQ7kNvwHaipwZ&_nc_oc=AdpnHXK2WxjVGxYgLArNoleAJM1ae5YH0jlgdPWxbVfBfawTAfoN28YZKr7Phz8k4ZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jW789PQ4sZmCLJHzSGoFMlxw5SJHR4F4Sk5yTb4YouQ&oe=69EA31E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AcfbpGv0UUQ7kNvwEJW1k8&_nc_oc=AdpDFYryy2m6Tr9Gjbc_bEULX77uxYvHCfgrxlaQASJO0p-3TKU3EtpXzaTyJTctNKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UA7F-WHYTeOXLkGDMvqyE1BkQlNCMfXlYHJqjkXqTXQ&oe=69EA20C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSkHOOTPG64Q7kNvwFq-Ak7&_nc_oc=AdrxWw2aqv0vXV6KuJ6TUzXU6B6h7BK4xyWtpTaqrJz--47kdF8SQB3f7FRNAgr-zKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04TiSseDndu5tkRigWOUgDvOam6ob_m46uV5wS9Mv3vQ&oe=69EA2EC4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a2adFPCmtkQ7kNvwHZsQzK&_nc_oc=Adr3DEd84etjG_IObKi4rde12zZssLhEHxc_Pdbks34XvSe9y2WPpf6qvqDm4yXccog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af191rQGifkA3wXF_r9zu3JZur25OX3XxY2Sw0gR7XBKTg&oe=69EA0476"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UsuU2v4hiIQ7kNvwE3jz-P&_nc_oc=Adq3pcrwEJFoDHT25lyQn4VsvOZWGFLoMubR3OyCCyftllLnwupBx-M_lsMsa5Yuxuk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ae9tC6O_zZxZORvMYnccYY5C3KbTlVO1y7uy0yUaXaA&oe=69EA07CD"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XP16o8JEQ_oQ7kNvwEJeblj&_nc_oc=AdpI6Qw3ZC75iCG7E31MXPZkN5RWCIt081dh4QBEeGGg6lGb4sMt8fBA5WMmj7VvOpQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G9IZDUK3kRdZbqCr7edsh5pmjs4JG_MOmS0hgUYh8Qw&oe=69EA0C81"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
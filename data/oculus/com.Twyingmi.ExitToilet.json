_555215454156453_8210228459532286213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfPTX19fCpAQ7kNvwFfKcdv&_nc_oc=AdqBJwaOaQhcXPr8O6RrWAW8Zte3_zR-DE99dgjNtJ8-SgwyRxPTztboMxNfBV-HRWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTx2vk8TiKEf3jSyFrLJcJMB6-JajCV5taoI3p1yyVJw&oe=6ACB96B5"}, {"file_name": "LOGO.png", "id": "546224041743355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254872_546224045076688_929302427766597094_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uk6ZaXCPlQQ7kNvwHAOGAs&_nc_oc=AdohayPzkRP65IsiMNScn4FyqwNBrYajMBQEXc-yCKJhx4QeHoO90C0Qdg1Y_BqVYak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYBSuFjRiZ9jUhODX5ufybJTKmtil7wRtruPgIMDZoWw&oe=6ACBA56F"}, {"file_name": "LOGO.png", "id": "481353054986933", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982571_481353058320266_8323553705772118782_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYqldauvCzYQ7kNvwFJCJRf&_nc_oc=AdpbkjLUwNBx--Jvg9utxkCSHoleYftwSuGvD4RGws6Lt-wzRBfx0QvzWDKmw7OJ18Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBd0Lhx27gyNWbxzBGg9xA2E5AEvnEuEBmDPd27Of2mg&oe=6ACBC20E"}]}, "id": "1653106295643620", "locale": "en_US", "screenshots": [{"file_name": "\u622a\u57161.png", "id": "1263597101604830", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593946_1263597104938163_7676510348918364446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9ufLdjxCMAQ7kNvwF_AWYj&_nc_oc=Adq-8HeAO_fK6eOJ5nFtyPJ0HxrJVZMF5406idef5FaT9k15jZClifSLDRJ01TnUZqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtDxXc1EFkdfUXp7cb53SBHfwvvzBV_L-rNW71yOzV2Q&oe=6ACBBCAF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfyuMQMCgp0Q7kNvwHLTE26&_nc_oc=AdrdF6FhaClUO0qcFGw_ZzVDoPGtzi2Y6oW7H0y4oFRCVLfq_3bNG3C1zibaQaAGevk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM113azkv_98rULl671QJJbarQffnTFNGYMjWC0XFyIJw&oe=6ACBA0A7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbA_90svpboQ7kNvwE-7wny&_nc_oc=Ado5S0UbMzQBgMEm3UYzoNvq9NV94hFFBI83LBzwlDbEwAT_PGrKnTOAMFe6T7bC_5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCAMYt9e5H_95rccgGf0_Up-nEW9x6zq_1tEBSTSqk0A&oe=6ACBB811"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKdg6y9NqR0Q7kNvwFaiM8H&_nc_oc=AdoBD57x3K2TOvz4O879EfJcpLaL6U1mU0o4_9se05sO71QGN5l7w3nDGUpfEJrb6H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpG1dyRpnWAALHxOzppmSykDQWx0gD0MSr_EFTceEjUw&oe=6ACBA267"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giaLj1pyqkgQ7kNvwEtCsj5&_nc_oc=AdrhbZrH_O_5rGisKvyLXxKvZa716QrRM4VssxjLtKpVeUWhEf41Q9hZrJ4eCHU6mSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRvuUIqyZP4lGR4wWYKlbjj5cdzpPTHiq2SzVv4CATCw&oe=6ACB9147"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puBf5EFsB4IQ7kNvwEp2wf5&_nc_oc=Adr2uirIbVMNHABHBdsMEA4Yt-CFg_ZpAB3Jhwv0DN5gG5EYm5vj5WN-q7IOvGq7vhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFy-gtLHqK-dLue6gOhbDgyzBNsGD83ytxJ
_ohc=HKVvPMtgv6AQ7kNvwGFGTFW&_nc_oc=AdoIA00voMWD2pn5BN1pbty9TDeE_wtCtgjDVD57ulP9O6yUCy5rVPBcAWgUGmtOX0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kAproM8Mc68alipWhN4aA586BfI1aemCje05WNb_X3w&oe=6A3AB7AF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFOvD4GiXU0Q7kNvwGZlOu9&_nc_oc=AdovG-tOCLpV5wpfz1xCbiKkS2JmIrELq1qbjIj0wwYbW-1xZtkadGOMed9sz_QAHvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FxZKLlRzjOkweSEMQa1u2c_IMONKJWZv_L3ab52p_Pg&oe=6A3A9BA7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69hWJw0qTZoQ7kNvwHW9LNe&_nc_oc=AdqlLVH3e5h2WH6i6jPTD5Q43eDr7RsmKJQ5UELoicpFyB68cIC2oJEIk0RzlfQwT0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XapaSYkJ6pnn9boRSNS_3fujE7f2s3eXfnttSciatMw&oe=6A3AB311"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qmNlyWrNrQQ7kNvwGLF2qs&_nc_oc=AdpjuUAcywZjiHY0cP_Cw42WEqzHPTRfieA4prD2B_xOZczPgfdtb5ozSXNTTMERql8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DdZKQmqWR7UTuN3AZEsBdYPBkkz3EwP6GpIWsTe2vMw&oe=6A3A9D67"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBgLYwt_UT4Q7kNvwHAP5Oj&_nc_oc=AdrTt7UWFxPQQZy-pItN51MziLlNPBdmnAaMg7Y5SXQBxCykmSWl16L43CB7PgL8LpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b_MmBIFUEnFRxod8uHadrgPBaBnl1AjMkYgNB82sIFg&oe=6A3A8C47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lm6U-VbYeYQ7kNvwFJgsc6&_nc_oc=Ado50mGe-bcw8hxbAQLL9KIM1OFCsR_iuXbV-wpKvKFjea6BW3W_2fv_R24StvMpZgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_75coSI7DaD5lA540QLP4V5UhXpOWXeX9Uqqq0t6bVkQ&oe=6A3A9A44"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hjiw_4tdcEQ7kNvwGQPukt&_nc_oc=AdrPmtaS6qksBbM0mtnzI4svn69eKJSfFizQ63TrunW2euLKFQFZy22P_oPdUvPph_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92mB3eegW2p7vwZkRJYMOdZLaHipJG8PMGvnXrZEAbuQ&oe=6A3AA836"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pD63DTMxeAQ7kNvwHSP3H1&_nc_oc=AdqisStaPRtEnoWZyeFMimPduxNHnanc4l-xQSKt0Ryrkt5sNWsk75pROc8hEdNHnKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E4wU7Y7EljtTXd_vpT1ZfMPmlfozCR9os-pfNPVkfmQ&oe=6A3AAB8D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9DRQcd0D8kQ7kNvwHAlYx4&_nc_oc=Adr9zw1z-yZsX-7ljNqgBFy2Vi48zAowfk_Gcpb_HsVnMioxuEJq9AHMnCu1nSzU3UA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1NCKkJeyJM_jevlGj9ZCCLj52vwcwfOsSoxjFcJo0Sw&oe=6A3AB041"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
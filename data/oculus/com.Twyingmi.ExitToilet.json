-7&_nc_sid=6e7a0a&_nc_ohc=9ilQLqHdGCMQ7kNvwF0XT1w&_nc_oc=Adqiv5TTiTIlLRbwxz0dVRV4if7F8h4VLaOlKFkfikvrpcMQRTed5EVLO7XHE3Qebzw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9ehAMoZumvQgSP925wzj4MmkRs_rnLvGiFgXeIBHIfw&oe=6A7DBBEF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHcX5cTLyyoQ7kNvwF4sQY4&_nc_oc=AdrvSJiixhlGzu3t2q38xHWWJJB4ViGOzaMWWHHl5MKOOF_LgsmUO_154ndAENofuzw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESaC-rhoJOtAaQE8IMHNY9uEuL5FCZ8kEnC9MCGDDcsQ&oe=6A7D9FE7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl8bG2BfMDMQ7kNvwHIYJ_v&_nc_oc=AdowdDq7FCE4n8pgt9ehjK2KdrX7Pxt8C-rxqRleor52cxnpxLgJJCiMOvt79ur4eq0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3jD90Z7m0zev6l9iU8ivoHit3ft2TPPV5m943_XmYZQ&oe=6A7DB751"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KICLq5tEK1UQ7kNvwFmr6JA&_nc_oc=AdoBEPdxlOFcTM-DhNTZaDXHlgARuwtYNQy2CnvRONSFRTQUKzomaMpEPXTotzI4Vic&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkJC_1y8SJYOorxdXphuNXcdH2nlSK4kNZaL-sHrqpIw&oe=6A7DA1A7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VrghEXerAgQ7kNvwH26oTN&_nc_oc=AdqcdvlSusRIXT3wc-eEDU-HPMIqJZ58PJSyNqougsnnAEr6E-tVSnGi8bs-uSAg26A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXsG04m2P6-W6Fs5fCubeqhoMclydftg5iIXdO6C_4SQ&oe=6A7DC8C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj4MGfcBreAQ7kNvwHMFXBm&_nc_oc=Adp8UO-rCZ-7xMAhWn77UlrWNKhBO3G9-reRf48Q8RLpuopUaZdm9qJRMx-b8OGn3vA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIfPBRacZfIzGxrDtWWcSf2VtwHSsgdoE4eKkYEGUthA&oe=6A7D9E84"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPbKLckUHvcQ7kNvwFZmDyk&_nc_oc=AdovB91eM7x6qqXkfxA93Tcg-R4k7TAwHpxZrMX4Y-PkrCDlr-8QFDo2fg4M01cfKiA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJEfvTlsGhZ5vABk6fGhaTvwtat5aahAxPSjT0mtqnGw&oe=6A7DAC76"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiQ41K7tWVQQ7kNvwFURV1b&_nc_oc=AdqWIVbg6WO0qptisStzyJy2wRXF9cIIYn8w6WjU3vV8W9UwANM3xQLi6mwkmqias5o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6Lpl0AxEHqms-tvraGTmS7I5o4dmtOeDcQ9YPuEtlaw&oe=6A7DAFCD"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmt-pqZOIS8Q7kNvwGRKEKx&_nc_oc=AdqYmqlw338wV9lErwvqtR977hF4-yJ3LTucpSBf4mnT8nWX8scG60KfOXfjjEMWx0g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQoZgqLR5cATL7I0HGemsRZa19fj0Hbu4u0eZrBZG12Q&oe=6A7DB481"}, {"file_name": "3000x900.png", "id": "930390195865
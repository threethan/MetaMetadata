_ohc=yHiYZrXcZFIQ7kNvwHk23eH&_nc_oc=Ado0eVUaDCyPG3WG2Ff4vtP2YHuE5-wRiP6azuy41FXmLCvRF9jsGwFnzwPwGvTpLvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf5yBNqfmK9E0RAjik6xzQ0Pr3i5D4VSV5jOMdBFBF9Q&oe=6A89996F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkxluuL1tSIQ7kNvwHYzPqf&_nc_oc=Adr7z6lKQmAjk7PnA8LCCLxasXf2n28-wtaQEJoePlzWt526vCHrQ1JTG2JxpxSFfr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiSJ5MSGl1xZ4QHnv-5F_a4v0ubh4bJyIrU6lymsGVaA&oe=6A897D67"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIch_bOl71cQ7kNvwEHYOmd&_nc_oc=Adrzjs6VUhaHN6fdZr34ZWQ0FJ97GaeAGCk_QKCzE21lu60HJm71HvEh_KKJSchHMCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKm_yD-VVKlsKbnCSq_MKNJB0A2BPrIp1yokW9u800Ww&oe=6A8994D1"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCCXKvfK3OQQ7kNvwG5IfIo&_nc_oc=AdqiFIN1omEpsaTzkrSk8PYwP_WkZi3M1aeiIouZRX0kRHMy0fBxWTaXlyknAWsEPDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNFX4pAKf7h0CyBTSExNuxjGu83cFnkZOoaiU-LycUyg&oe=6A897F27"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaxR-rGaRxcQ7kNvwFQ3j-S&_nc_oc=AdrW4kpcNDiSgDvcVZ1jgIYmRm2BspfJuwx6SF360hy0JaT_p6-sdfW4nZeGVERe4dU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxEXgW0mQPBKMQX5c0Y7ZVzA6SlNjHaEWTLxl20QSNFg&oe=6A896E07"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSXGrQgQC9EQ7kNvwFoeaT9&_nc_oc=Adphqan3fta0GSaG13RsByMDJdVLWWObYuoIzAukbKl9ZQvhLUN-67mJ9ou0NhsO6P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8sts82kvzP292-nsJqzZ50Ahu7QDEM1qCOo0mL3DrKg&oe=6A897C04"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TPqpDYJDXgQ7kNvwF9qqTx&_nc_oc=AdqL_OJ7-O0ovPcmSpiocNbPXgxGlnJYdZt_o-ytliZSE2RJpUb-GHIZHAgF198i9AM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE854Js1T98F78XFHgqM7t35ZiCrV7exnKJWWCPfD0Pug&oe=6A8989F6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heDLwnyUsykQ7kNvwHIbSBF&_nc_oc=AdpzdVHpvSYUNyJhSxvYDmSz3SwezKMzubSrBUKTG447xVbgQ_WF0TBkBC3QEOOeg6Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxwnVpCKa64U8hGotKUvhJRQgje3hYFPWh-vf-y3VTYQ&oe=6A898D4D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3jtGiIIgYIQ7kNvwGca-zF&_nc_oc=AdqbJmSMJURRd_KqRI_PtU4AjnN_VnhZvyzbxVmtUqQC6G-j3CXLcIV2LgoOBKBbBac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl8mFhD8Xnm3eqwqeyD_TZmfbq2ASJNOGqbnaqV-h0tQ&oe=6A899201"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
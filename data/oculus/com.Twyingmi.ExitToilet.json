_ohc=20U6B1BrirwQ7kNvwGg3DsS&_nc_oc=AdoxVr0hMPcOvTPB_bRhzvATf7Bu86oQEED17xGeKaTanreJfX4_KzNQ0QD9Qs3noxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Iam-MyTPGt45KVhEeMIPaCAeTvSZ3qRXp5y23hcJvSg&oe=6A3EAC2F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMY5qBx9C3oQ7kNvwFExM7q&_nc_oc=AdoauiSLGjMLkgf2FC76Qb3UPTwqePJHxKOr9oo9WVBcGET-5sw0VDYD1_y-0-M7E9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bsm7SNOUakVWuidD4_2b-X5zQgrRuLddAAPwMHv3-0g&oe=6A3E9027"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peBip3GQcB0Q7kNvwEto1qa&_nc_oc=AdoWjaweNsqDKPGa42RpbZqZQZDEimWYwb8rc6UuUqz-892dI_mWS2eR_8PhBWR2Osc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TpbYFWV63yAfBjPQLT5u_0hU9yaeufcOAvddU8wtaaA&oe=6A3EA791"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NNWvBtSGSAQ7kNvwEimamK&_nc_oc=AdpouYXQ6of0zG5FFxQZ1I-c1x5yaOkVgCCP-7BKYz9cu3XPdrBLOjkPyl2Bz7wKysU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YuWkIaBzModcjLfewI3Moe-CUVK4UuRwD7aY_FDuOJw&oe=6A3E91E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oilHvwazyRoQ7kNvwH9iCUf&_nc_oc=AdorsrxX1IjiyKVCVyNqhtQm6nnkJZXfrZUg8LWzuPwg5v8NQovrcrxGA__PYxAK_z8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pp3Q8FDng1INc2aYEs2sC6lBzB2YqGnb42PnvCuKxqw&oe=6A3E80C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPH0Jk9kJxYQ7kNvwEnVyNj&_nc_oc=Adq7mkrUvZUCNtl2NF6Rmqw0INC5N80z0ULEBwc3hx0RfQdcTISKWjh8EcTLq1xBpzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JIa65LDm6SDXHMpnvjfV40aW3a28KQhbxn364xzwpYQ&oe=6A3E8EC4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jVTZnAhQqIQ7kNvwEuoETR&_nc_oc=AdqY-Y1FG_jf2MKzF4u477_0Jd1sbPqosTu3tk407X-TMsJWBl9Ce33Ir0PWf5VPG7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rJTI2t_6myq2kr4IP0aI6YA7Rf18TDaD0Hvq5jyN5Tg&oe=6A3E9CB6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdeCflRe7XMQ7kNvwGFmZ0C&_nc_oc=AdqDX6MO-_j_jvks4oUIOhi9pnTy8JT_3lp3bnVJOi-rxgHG4L11688YaE31ZMASYP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hQp5ve1SET933LAiCg5ZPhmrKG_uFcrcrFMz3EmJOJg&oe=6A3EA00D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFBXHMRtQeMQ7kNvwGYVHVS&_nc_oc=Adr3gNOXwBQ8vMN2pHSc_j9L8YfgIsEQ1TWCBqtnN-gHUlWSG04stAFbWkoMZmdzKfs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VrwbzGmo0PoLQpnemKgfyeD79Iy7YPj6qSunKgAOYPw&oe=6A3EA4C1"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
_ohc=IkDceFAYw84Q7kNvwEShQFP&_nc_oc=AdrQlVu0kRnJEigBd6Dv53RCXG6E6F6sI6W6Nz2fy1kCPlNRLj56ey0Cu-SOIRKRZnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwiuOn5W8BynSXcZcTnA3kj7OnNd3QQkhRdJCLbNrfkg&oe=6A5CC66F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPSBcgDEPUAQ7kNvwECakCz&_nc_oc=AdodZdjIIIPtapJSo_fuIPteQcHBpjvgxG7UhGeB257z4yOaYgvi0ENpVRONz4GmQp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPEJgJWAxb3PqAaXootgQxdr7dvq0UdOk7PNkZG9t7xw&oe=6A5CE2A7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awLgW3ZqO-IQ7kNvwEadhcF&_nc_oc=AdqibhP_urYaS6Lil0Yw5vxOXPLuBOR8Sll5w3yQPZYdONJhu7iqLCjI-4NAodp7tBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACQpUfkQLs_y3InVu1gAUWFe-ms_EyEm1fo2YDDeMcYA&oe=6A5CC1D1"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvL5ve6SKwcQ7kNvwFQHLLq&_nc_oc=Adr6MAqHxbc9bAxIHa0UKTgvMqb-WPwS4ef5x-iMAAIn_TWOADe9lxEb8v0himzvrv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPLuDAJV-WqSaM3-jmvNSsZYfNfDPWM3yVNd52pRk0aQ&oe=6A5CAC27"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-pA6PLYJPEQ7kNvwFc5WpJ&_nc_oc=AdpWAUCLg03plXYAF8HOXtMKu2z_Pe8TXpoNQpl7Ufi0hL_rRb06GodjI2WfsdbqYA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq6ma2Tajtxa8-nr_e2rUP3-2EbEsZ468Y3uEohFuxlQ&oe=6A5CD347"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFzr7eR4FT8Q7kNvwFjb79Z&_nc_oc=AdrA6UYBgc-xV0EoWdJd3Hs4xYh-w1qVivmhOgtH5_Udprkzhq8PByUNqHeWQom5-Tk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPlicfMmCNzptO0YZ8EnA25Gi7hV0NJVHS9QNITiF47w&oe=6A5CE144"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPNfJwJo8WMQ7kNvwHu3Nxp&_nc_oc=AdrIfckz8YEA8V1rMXvalXmRCwnLXoI3COVJYeXi-qFkO9ns6UnoNevSNwqR8gYvsmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-pKSroqymNNOki5WA-ay6kDM-rKjTrce9yVbcCHNPbQ&oe=6A5CB6F6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTs05CnY-ooQ7kNvwHrJoxB&_nc_oc=AdoyUvcJzow9YhQbmo84u4SNV2gN0hZkxamqV1GpMsHRb852rqXbNxG1DQEgaJ7dUl8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuCkqeH5CWkgZg7ASoDoFn8QSg3ddnA9QPflOMd82vTw&oe=6A5CBA4D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW8s7rZrkxUQ7kNvwEBCtuk&_nc_oc=Adr0g_3EY8QQeZORFbPspY5k1VeXClRcN-SlkZCJzabuBGXwYxz8sHC2KXJDCDRE0ok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2roolCF_bW0Kj14KblvkG5SF6ICVpRXKXgC21d3p2sQ&oe=6A5CBF01"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
_ohc=yHiYZrXcZFIQ7kNvwEA1k4S&_nc_oc=AdqhuqjfVsEt9aotWJVVvTOmw_Oiuv6fk-Tbvd6extMaxdObNEZKlkWkHvMSIxjdcI4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgCPQYdhoLI_bO-EavwvJ3F6JtbDuSagWsiv5lHb0LJQ&oe=6A86F66F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97awqdSMsF8Q7kNvwHWzTDG&_nc_oc=AdqPf49gLQPchSBd8-iQJmI9rpxcoCE63OoTAcCreUem3I-aFknemohs25G_3ltn8bM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKPlV1XpxS7eUS_CMFwg5zv5dAJY2d35AdmaPS6enR3g&oe=6A86DA67"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvEyeVjQRgcQ7kNvwEuYmaE&_nc_oc=Ado5kCo7Lgo3aeHbrQu6EljyrmC-hba210yuA7bqO2hZAU_Jgz0Tr0My97An1QPyN5I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5b_k-Ni3Y1P3VyWkKlWniFLTysGiOHx1_aXwA_iaVDw&oe=6A86F1D1"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjXO7ImtCDcQ7kNvwGgVo03&_nc_oc=Adpvh_Ib4HnoAFnBjIS4I_zHtF9SEHYzVmh121l8KKi1HA9-bKiViowPS2p1Qw_WWmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm7X0dpSKRgvztHAVV9FckFTCCmGpmScsaAtxDeHDx0g&oe=6A86DC27"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kylmTsDGDt0Q7kNvwF0Ee73&_nc_oc=AdpidGY6RrFm_zLOLXejtP7Cm5Dwk1TlGxCsi4OKlVnENTs5Xip-0cQkdX4-9_uEY5k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw4B3FeNhmoV93H766n6VIBdcPeyqdmSA4EiURv_nYhQ&oe=6A870347"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r8S0ui9Ri4Q7kNvwFV66ty&_nc_oc=AdrN8Qd0zlxGneCSXipXOmhqg0onRk_0WLPLkbvQ9LHXqs3onZgr4KxZdlnQ3x57RBU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvGn3tU2xUNyZhvt7e70hP_QyqM2q53WAkfz-HPh-sTg&oe=6A86D904"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAPa-Q4pNoAQ7kNvwFWkwJd&_nc_oc=AdqZq_QmdsXj7L3lE8aw9jsVA7KquCVKfZhbztGcm8NV58AmbzUxw51tlm2EaFesVv4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhoX4BCFSYlH-xjDy6U3fojZ-nxpAq9vGjJJG73RNPdQ&oe=6A86E6F6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heDLwnyUsykQ7kNvwHdO_Vt&_nc_oc=AdrOfEH3o8GfWoktcACO_0ms0f1zb2chZY6d-CyLm_jpnvZR5X63GhFOX8M21r3Y1DA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI6NWEZnoNbL2-Wj2JUQ_iunWPHOSLJpv2a97QNtgbzQ&oe=6A86EA4D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3jtGiIIgYIQ7kNvwFAFX95&_nc_oc=AdooaSN6-ZPWa8M5Gm_IdYa_4_r_WWtGSHQrAScUT1sKcx2ecb8VRfSXP2Nx4ITLPGc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnQp7EcLQyZvZF886_7zRlnpzGeAgR0hVfZGVQrnfBmQ&oe=6A86EF01"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
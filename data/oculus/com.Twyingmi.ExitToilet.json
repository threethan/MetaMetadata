8918364446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEFvEhUVqrQQ7kNvwFz92V2&_nc_oc=AdqEaofKHcRuA7NWf7l1zTiVJxVUHA644cyw4RW2VKt1UcM9Wu9Kd9izX-OR3FRC_7A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Oo_qdaLI5NaThxv6U_WTG7oiZUDGtJyukEwn2kSR7Q&oe=6A8EDF6F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5xPZvsxMLAQ7kNvwHJan9H&_nc_oc=AdpuyLSk8oW3fqm4wrjMAgrVYToPrizJPLKFEdo4gpfd5clzaGtfR1g_P0IIVmJcWHQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI3z1lZ0Vjfznn9QCo0wEzjA98KoU-RZW19wn-l0QvbQ&oe=6A8EC367"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qWENIAWelYQ7kNvwGETBfF&_nc_oc=Adq-tjdpeI3ygr7MivzEZrQKaS_bVQxgUu_IFjTiNDvamnEhZJEIZ_0ppv-gpcjdzHc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuHKvhUID2NxnL3hr-2nXtv_bboDe3bMb76O4EG7hvGQ&oe=6A8EDAD1"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvuOb8XRQUwQ7kNvwHxlo4Z&_nc_oc=AdoKyXx6XIfBoRQd3HP4Y4sR7fR2hCNRYy0divX6P_rO7Rvq42UwrfqTj2ZezOtgB5k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJouStrB803KAAuoHyz5mtkQcFH3ud05psTxXpmIl7lQ&oe=6A8EC527"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikbSDBolXzsQ7kNvwEEBbDO&_nc_oc=AdoG51TT1ad35DfcDW1MBYno6TOVIGYA_IgBaJSMVZ_Fqh91yGBzRB9GM-unjjXKecU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKhjzqGkUksWiwiF0_J6_ASCrVuCixSTt__QEY72aZig&oe=6A8EEC47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1E5ljUN43oQ7kNvwFqP9qs&_nc_oc=Adr5Xak8JEgxpqjLKxm4vYsqfb1qAKdI3FYqTa9x5Rwpyp2tVH8dSZfhD8KzXUz90V0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2KhJ7fkw-RTNVLgjXzTCAV_NKLsdgUKi_8ZNKpCSQPA&oe=6A8EFA44"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_P9rDzas_0Q7kNvwG4Vw9o&_nc_oc=Adr92_ILXu7ObalWsI74FYtjDjV65XNKaKcWBr3QXho_11q2J0IfTDRIpCaXCtf6cOY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7xKm65WpsCMt8-A4G4Onfh4WweK538-0Vsr1Xa5LS3A&oe=6A8ECFF6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4Ie0b2CDR0Q7kNvwFlbbV0&_nc_oc=Adr0Vl5ENyz3lhJD9L0dMT2O9ORk3OwW4wma9_P6LfDmP8cXs_Z1jfifA5G04bcCCho&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-ZA8ppMwCSbgWuW58zT_etytCM2_aoPmiBYetoxsMtw&oe=6A8ED34D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3VmFzHhk6oQ7kNvwFbcidj&_nc_oc=AdrpbvhETTs5194qA4UBUqqh3oqZrmIux64YrIkGcyAVGU-J88ZjUjQrMyWVaD0t8is&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGokj5BgkK-xN5JeH1R4xnxfptyYFDJyi_npW3vUxfy1A&oe=6A8ED801"}, {"file_
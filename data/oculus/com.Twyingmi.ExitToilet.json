_ohc=n0zh_bB2L34Q7kNvwHG6gb-&_nc_oc=AdoNsX7FaLqq5CPfJvW7EVOJ3ilX_cquT0s0GuC_iyb34wdal9gy-sv-Y0g4GEoCNYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIHWhFlmqXFP0DblKEKwMqkJEPS0gEVvJJYEgTASn_Sg&oe=6AEF552F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qrqnrYuKwkQ7kNvwEk1Yn9&_nc_oc=Adop4FxraNwc5VWteiwLo87jPdvvXm3BeuANVa5x6cqHLJRAtSBe6B63Txtu6uh5WOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwX50EFFMjljzKqKeqkwp0ewWVSPY7DspeJhnr8eOAqw&oe=6AEF3927"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWT72Ev4ACMQ7kNvwGYGH2X&_nc_oc=AdqA-O6v4fSR4ckde5CplKXUEZZG87WIO3bY0cljJ1idqRkRfPGfSy9MAJA6FB4lfAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWUoJg9KFOIJ9tmiusV_6bCpIQlpwsfu0YXEqAb72xwg&oe=6AEF5091"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWI7_oKNLx4Q7kNvwHRVmu4&_nc_oc=AdqOpk8QoqqBRgYv1mnlT2p1xk35DqofIQ7wwzaUBvm7hXYb8dZ_CCbafhWq3MUGEvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiYvZGTmpooUSbfCXW3R_L_xar7Gj3TjyEnPPak3MVWA&oe=6AEF3AE7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo8GYOOeuxYQ7kNvwFQdd0y&_nc_oc=Adr4w08OZSIeiZ7WnFTDvoKTmQYOkadXfKKyG101isAl-OBkeMC98hRqMWJG-SJZIGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNyfK71Y4j5kJ5Ltte8LCUhC_8tkqzf4SIQoB1jkpr7Q&oe=6AEF6207"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxoheVpeBj4Q7kNvwGHXv1E&_nc_oc=Adq4SI-p8b0exgd2BXdEFPYPhdarwyIBx2K4x3mdPUrjy-s0vF5zWU6l_hRP-MRlSX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXJsUxmCri4kwM8A2HmB1hlgkop_CFepzd3pDmbDw0Sg&oe=6AEF37C4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRrC8gSIQ6AQ7kNvwGO2WYg&_nc_oc=AdpYpfuWtZSwA34gWlVl_w_3cOxsyaxY0iUE9sgqfBj_k7BCI5HKHFRTjQq3LfcPNEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjup-VxCK-JKH7l6W96McNmTgp2i6TPUfDzBcDptMAyA&oe=6AEF45B6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGh6t9H1SPAQ7kNvwFF6OiV&_nc_oc=AdrPxjfBH8297XWUCPUMy5liRtVP5xYF7s-h2XIynUweoL-nk-w_xaHai3SsOPbSjGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0lBednNDa7V-HRZDueqx84KuQ3idj3T3cTNveCJAD3Q&oe=6AEF490D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WRD_KK3BBgQ7kNvwFLIDSW&_nc_oc=AdqtdvEoQn7LKU380kIa90tDTEDSaWPykaKXp_IxxljdRKCybSQl0R9FPlsuG7jPfe4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS14kHqKREF1qgAKxmqs1ph5UgzZpDPsM83CWLwGgFjqg&oe=6AEF4DC1"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
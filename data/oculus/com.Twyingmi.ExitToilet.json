_ohc=3LSb2c3VO74Q7kNvwFz-BmN&_nc_oc=AdrzH78791UVDvVmOKloz-tf3eb4WHlkFfHM-ulHSs_eSLH7IA_uFHSPzLgHHfbtVhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-18QbOWAoq-rur1ZCESGIOVPdoF94nYuFSs_faPcN2A&oe=6A7875EF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nebsp_Nv18MQ7kNvwFVxsZZ&_nc_oc=AdrbMyY_HVptQn_qI0UY0uFMV7aaCVXLj9Yu4m5Y_6ThZFH25711G3kTCiOBlAkTNr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAsp-9cWrqX-AA8i2jjtiOOFd4jExPTg_UtK8XmTMVig&oe=6A789227"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIl1Qj9PmvcQ7kNvwEk1s2o&_nc_oc=AdpZthdywac7ggrMfk6k91Xs9q-oAgQSaKcWe_JABmUK4RwpjrQPaDP3-CIDaQ9N6vw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX8I9CA1V4U2BJWbfxsu9mZ4mCR6imaFKF1Ue5QXym2w&oe=6A787151"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ua-q8wfLy0QQ7kNvwFwtMoz&_nc_oc=AdqO2-DVSJD3a9lQV0mZWhL0kLWLVvaBlrfi7aBfpIH-guG21CitY01U8oaAvSc805Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjh28FdOSu4gOMd8J6a4osMjTo4nd8B1HGunNdNvhrrQ&oe=6A7893E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUEfkGQatRUQ7kNvwEWsLB9&_nc_oc=AdoLaUZPwt8cLGPJp5to2I4GHGJ2Dqq10LHXTqGIrcrW67wvDkZWWlhIdmFdk3QyfyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG7ckXgLOx8SROqdcmplNfvAdSxHulQFZMMFdO9BY9WA&oe=6A7882C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtKf88FPSPkQ7kNvwEE5p-8&_nc_oc=AdriwujF1k17wZ4HMH2yIW2ntqM-MflAjmzJwXoNarzHqgtghsNbDAyACawp_PRqbUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcYZzqjUILgrQUHEBzjm9xNI0aYJWUC628NsK6nzLcIg&oe=6A7890C4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2XuBBoPGm4Q7kNvwGxqTSG&_nc_oc=AdpAime_pXRvUe1LR3_EQ66FCWGAqOjENAKXVQjkfFV4uHirGzM8I_ek1rFGYIYP-6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3xJ325IUDKTB4BaN8iukFeHOkgZYOJ5tQ_1pfImwcVw&oe=6A786676"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FXw6qBAFjYQ7kNvwGjQgTY&_nc_oc=AdqY9_CymrF8q_rPu5N7AwJ342T3lOiwSXOO9uO5eSGHwflXiHZ5OaMjqOvOtDZMsxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExTYXJ6VUkmWskF8Pax03Z7JnOAG7i6WbSGavE8oIJZA&oe=6A7869CD"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCNhvdIpu5IQ7kNvwGVVeHn&_nc_oc=AdpsAgoGN1kIvWwSKjsst_qiqB7wPadwiKKCJHsNGNEFn9fMduNMIEByxuClBhSamhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDdnBcQRFSBd9znTtwMR-8Ftj3jycIjaeNtyVzJIGr3A&oe=6A786E81"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
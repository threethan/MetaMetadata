_ohc=f9ufLdjxCMAQ7kNvwF_AWYj&_nc_oc=Adq-8HeAO_fK6eOJ5nFtyPJ0HxrJVZMF5406idef5FaT9k15jZClifSLDRJ01TnUZqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtDxXc1EFkdfUXp7cb53SBHfwvvzBV_L-rNW71yOzV2Q&oe=6ACBBCAF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfyuMQMCgp0Q7kNvwHLTE26&_nc_oc=AdrdF6FhaClUO0qcFGw_ZzVDoPGtzi2Y6oW7H0y4oFRCVLfq_3bNG3C1zibaQaAGevk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM113azkv_98rULl671QJJbarQffnTFNGYMjWC0XFyIJw&oe=6ACBA0A7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbA_90svpboQ7kNvwE-7wny&_nc_oc=Ado5S0UbMzQBgMEm3UYzoNvq9NV94hFFBI83LBzwlDbEwAT_PGrKnTOAMFe6T7bC_5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCAMYt9e5H_95rccgGf0_Up-nEW9x6zq_1tEBSTSqk0A&oe=6ACBB811"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKdg6y9NqR0Q7kNvwFaiM8H&_nc_oc=AdoBD57x3K2TOvz4O879EfJcpLaL6U1mU0o4_9se05sO71QGN5l7w3nDGUpfEJrb6H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpG1dyRpnWAALHxOzppmSykDQWx0gD0MSr_EFTceEjUw&oe=6ACBA267"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giaLj1pyqkgQ7kNvwEtCsj5&_nc_oc=AdrhbZrH_O_5rGisKvyLXxKvZa716QrRM4VssxjLtKpVeUWhEf41Q9hZrJ4eCHU6mSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRvuUIqyZP4lGR4wWYKlbjj5cdzpPTHiq2SzVv4CATCw&oe=6ACB9147"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puBf5EFsB4IQ7kNvwEp2wf5&_nc_oc=Adr2uirIbVMNHABHBdsMEA4Yt-CFg_ZpAB3Jhwv0DN5gG5EYm5vj5WN-q7IOvGq7vhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFy-gtLHqK-dLue6gOhbDgyzBNsGD83ytxJDd3nHTm0g&oe=6ACB9F44"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFv_tFSIXYoQ7kNvwFYpncC&_nc_oc=AdrGAVmOF2UHhxKb6bvq6x6bHdZWUplZBFZTiQkwYId9EI9tVLl_ixXkRYBrAnAIku4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiOuWz30q66_EoK6_Acv8mnZPw3prYH6_HzW0bjuF__g&oe=6ACBAD36"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja_fbrMvsRoQ7kNvwHva0X0&_nc_oc=AdoshirXiYjWojhK3n4ohPbPkoowPXVPCpI-pklU6k-zWjkLJT_ANx69AFh1iMBWGAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1xlH5mj35xQdhZNYvK2CWQoocwmCJuFi8Hq1kwKexsg&oe=6ACBB08D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoAvvlbr-poQ7kNvwFP6x2E&_nc_oc=AdoPsISOC1TWPu9QpE5-hlDJyzDEYXbXQov35iCa_FH3S7PkUPMlPYKj6yHsBK1EIO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR38wR9VKz36-SkP6g_3b5_TSuuRNV5c-aB1DO6CBHJw&oe=6ACBB541"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
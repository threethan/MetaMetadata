_ohc=j0_Q61AO7rQQ7kNvwH8oowZ&_nc_oc=AdpVerJNo2E5fbMpZhNlGTNmYEXDl5rXPNmRLF1y_EPOMKBUPlb993rGafOGNPyWoLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLndr6Av-uobj9XkinHQeqNDFTTy7f1W3Xx0e3hCFy-Zw&oe=6A9EB16F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckotb2WnWe8Q7kNvwHuzHaW&_nc_oc=Adr_ZzyVxAfjTfIjCN9X44qcBqCdAuWV-S5dVE7sNe7D31hJFFbalAkn9SmDrf_SKgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNM_hVRGSnbnr7rt28WG6M_GDAL-sWPbvxC7KvYrIcIw&oe=6A9ECDA7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCXiT348xD8Q7kNvwHxiLLa&_nc_oc=AdpgBaleacklF2X2jkKm1T6UP0PYr2UtPZjoooSPL9e63oJa5uXb9oUnoRKPCewI0lE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8SXOFwLml6d8EqPcgTnmbQdQ17F9Esj6mNUUH1ma2FA&oe=6A9EE511"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkYZ8GAmrQUQ7kNvwFYQNbP&_nc_oc=AdojVXVt_h6sswuHvwW90J63l3n9jrH4u1lyC95ece1NZ5ab-TiZtxx35eoubmR1fts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaMfrjYfh5rkOtYo2wTCAJYF3oxzI8RtsEZBXOceIVQQ&oe=6A9ECF67"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hQVlhg10KEQ7kNvwEWEEpR&_nc_oc=Adq1YirGjvib5bUm9z6s_8JOzA3vyq5B0JoR_Wiafe6avvIkaTqGzq5aYxOndEiEapg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRHmFSpIztpz_hRzPepwBHFNw-mMHDEPKZmr3CeZj2oQ&oe=6A9EBE47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeZzNEV4m3wQ7kNvwHSYc8X&_nc_oc=AdrKUE_-zmG9y1QPKW4ZpN9b1CWH8E_RZEiF8lANJwOjT3I779QqrpQqZJCqoqhlIXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdamdLUeUsrRw7TDhmsnAlRBa2Lw5-gvs3SQwTTe2rdA&oe=6A9ECC44"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX58oVs11UIQ7kNvwHBAYR6&_nc_oc=AdpDEBLDOoRDEpG2te1IdG19XGMK_zmUTy8P7Z36p8ne9LGQc8dyw1rFrKQNagPodCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIbPBR2pgivx9SzurUkaCAHOQrve77ZMN87X-_a0nxIQ&oe=6A9EDA36"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghKgchV8K1YQ7kNvwGQtqvu&_nc_oc=AdriB5D2xzPvHEYSAYxSoVysdalrfqR54rtfEkhrPxMvSEJfC2PBiLHOePlOA2AImUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyXv3J6ocOv_RxzI2WqJOYOt4gzZHKZCQVQhH4YAEf5w&oe=6A9EDD8D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c56vFyVH5PcQ7kNvwE7L9co&_nc_oc=AdqrMrJ2y646fihb2O2efBZpiL3H_5jSLUy6z_kwUye3Z6l2qYwzdAcEG2mimM5Ttco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmikAjQqtnYG6W3oHPiVNi_wBsEgdoramaZIQDWZ53kA&oe=6A9EE241"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
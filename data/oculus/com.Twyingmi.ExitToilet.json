_ohc=HSDC9MlFKx0Q7kNvwEJzabn&_nc_oc=AdpStIp9QJMJ-TuwdiCBQHiCygFb1FP3-ZivYiY0j48wjOUcDCD0xL6Lidp4Enxzx6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuPZVmQkC7PPJ84ugDHzBwSAAocNuRD8PQNS8ejl-5EA&oe=6A635DEF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3FY8dq6pPUQ7kNvwEND-9z&_nc_oc=AdprWcbn71gyUh0o5317WzXHmpVTVXU8uBdqz4PiW6wceeNHIkctEUmkY5ICSkXlfp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8ud1ETor2c3-TfFD1iaKYAaF4bqLitRaBg_z6kkRlJQ&oe=6A637A27"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BIEQzPoDukQ7kNvwHl32Zg&_nc_oc=AdovgzH2zDAYp_3he52aQRLFlAzrgw0ce2r9cVA56qSxoTWZ5jFUNVEso61dm_a_y6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrCGpqApYJTvhjBEiklL3eIQQHsSecXbnHjoI5PCyX9Q&oe=6A635951"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKEtvwVY-qQQ7kNvwG67OkE&_nc_oc=AdrcN8Y52sHt4fNS3q_rzeo1lhDHb83Pw0luO_EmCJ0PDsMvWTpp9WB0_XKnE23bq90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBSaZAocv0dQzy4IXyh6KHWnxhc_Q7KKYRSaNYXeZYww&oe=6A637BE7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7HBt5nheDMQ7kNvwHhrrCF&_nc_oc=AdpYiwjvoB1yMKOQJF1dXCn53Sz9YL_h6Y8kzXOpd24Pfl5J_c660mW1oX6zXhHlXgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUNIyTUtz_ynE3OYJS3moaickYe1SNBepfPUZRwEmHsA&oe=6A636AC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySTnVFqBagcQ7kNvwE-rZ6t&_nc_oc=Adp1orQ35UxXwQtQQ0ZKeeuGuCXinWEjViMezzzKib90ltxSVJxuENnr8NXBIonFArI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfMzSVcbg6BhxMrnOKGRNAyqNazUVLLtq67YjoxzPMcQ&oe=6A6378C4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jD4wcTQjuioQ7kNvwGchc2a&_nc_oc=AdoFYQ2DtvT7XaMfG23tsrHzhYP_IbdpyQZVgPRovyZGuB-BjD3oe7Xty_rKvNGyHsU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGHh2vviIB62V3yT_wBXhyg6Vm4Et6Yz9Z25w4jjzlcQ&oe=6A6386B6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=linxKifGI8UQ7kNvwFWQ1nZ&_nc_oc=AdomBkierRZIBzN6ZhoAH7nM1iUG5GlvwsH29bx3ExYNZ3jADfSF0RiBfPE5fqEerkw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzyrOqzKJfoS9M73OsZ8MnJI9GEuTGNzePWiASb6OXWA&oe=6A6351CD"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tqeyzx73C1IQ7kNvwEoior3&_nc_oc=Adr7AYn5WXfiCz3RAM6X_dUwpfna3PuJzqOz2pIoxkFlCdjGzwRkeeN11PF9vq6vlU8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW4NBvGylny_zFyIk49uGNcQXwKC4QKn0Zj4NuL6nruw&oe=6A635681"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
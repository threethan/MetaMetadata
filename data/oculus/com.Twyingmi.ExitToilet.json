_ohc=ahXPaUbqZ74Q7kNvwEUPLYU&_nc_oc=Ado0R28cxwJe0_Waz7Zl1HB0HmZhwyPp43m1ZWWL_I3UTK9XJecSVSvZmg0hjv9NACE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22FzcSU-UXUDyoGwe7QVNCcLEUcWYKqQEemYIimdSL_g&oe=69D4FBEF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Goq-aXdIacMQ7kNvwGh8bI5&_nc_oc=AdrrdFdyXB-8hN5opbFXZq7NnryJhqrUledV82eTNXmBKuNIm7a7KRqM8lGS_B3x6HQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FIPWLvMGLsfNZ7Wfmp_kH7gMl2HzupNw-6_wecQYr4w&oe=69D51827"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X9LnArFHoIQ7kNvwGQgD7x&_nc_oc=AdoyZIBSN9f9cWvD7Q21r8fQxEih_KbLtZIvbv1l7AX6DAAup1k_jhFgGoA9TdWlfqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rq1OQnPsYDj111X311ThHZWZu2_Abqq6ZSzmZO6Xvdg&oe=69D4F751"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDamb4irR6QQ7kNvwHKj1TV&_nc_oc=AdrLRLkiA1hBhrhdfpUg2YP3fCapvEGfZUFknYv3obBwPA6bcs9q3v1ZjWbtDTByCAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QniRsEfJ9Wdh_oUrmv8CQQGKAJQwH2PfCGSV4qz0YEw&oe=69D519E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wALdSUv1NcMQ7kNvwGc_SL-&_nc_oc=AdpHVFRXLh0bB4lT71AFKwyNLIYeHTIGKoDHn-gGjmiKsfArjidJ7ExROPyY3O2Ua4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gD9GcwfRFJXSTTO1x0ZbMKBoHj1wgHDUzDj5X4FFQKA&oe=69D508C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYjmI3gxDWkQ7kNvwH0e_Ip&_nc_oc=Adr_itiVaJMUOREELP4cXMnqJPyRp6WkmsUR3xSfQgOLfXJcarkiNsizxaozjU-e0a8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fIGnJB0YloX8e03dgZFVdXi7w9L2PjP8x4iZkOASKrQ&oe=69D516C4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x-5zi4rbysQ7kNvwG9ME8b&_nc_oc=AdrczbHpPrp1uwCLESVd1DgamPrZP86XmPCLTtYh4jmr8qG4kgrP4HtbWR15Tor_F70&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oeIND1NB-TR1aXgrLc_zaxzkHLC6fxfC8S29bJ1UrOw&oe=69D4EC76"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ7gN_vDRGQQ7kNvwEdjfcl&_nc_oc=AdoVPa2UUwzAcoDFRhYJB8P9mtoJnUekMPA-JfQnjn0I03m9rFD_gt8GRpBA5rApEiU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J5EHFfGvwxbOb6jXNl0kFLMBxtahJ-hvA4YS3hID8Pw&oe=69D4EFCD"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42XStvT1ZDoQ7kNvwHQmENl&_nc_oc=AdpR24u7ej8PLAp0JcKW_ns1V6DlgYeVGRh3CE886B8FF-P9CoN518phbqlGwfE2lgk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eClAfp8F8yfhzOdnSRHaobx5w84BoGKfiCz9r--2_jQ&oe=69D4F481"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
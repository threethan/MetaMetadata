_ohc=eGBpCgmO5aoQ7kNvwGR1iPl&_nc_oc=Adr1OWktUKjL7a7Ssbqv19KqENaA9MeFuk64AlQGOl9Pxv-s0YWG8oeQByeqVZx7DI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOngWLe4xIx0Ok_fHnqrad9Z-qZkkqkC6Ojb1tyZyg0Cg&oe=6AD2542F"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQIDB661yN8Q7kNvwHcm_3K&_nc_oc=AdoLlJ1ccKpXKCgOU8MY5yFBpl0etGrU3MYKaN0_y0UcsADcFxgz0C1S0d-USSe0Sck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOI3pyvJPV_u8AomdASktzE8M5UYUmIFYEDjpleauJXg&oe=6AD23827"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYOrZ_p04gsQ7kNvwGspD3B&_nc_oc=Adpgzg3kKIw2t38E5_vxksEyj5RWLzZWh4BtUT5PvL-FwS4x16Q9a6n0uC2qHy9EBRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN7j4o1fjfTZwz9lenuEP0Y50wSj-P_TelHQ9dNopXPA&oe=6AD24F91"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7knHupXfkCwQ7kNvwEJystw&_nc_oc=Adpvaldpswr1dELSxeKVdHGZRahj90E89v0L_4wU1nIFJjD5rKQiFB1HzrpLdDU7ggw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPokEIFgD8_ExpcGLNbdj0k0PJCUHHzipIkKoCrhasrng&oe=6AD239E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhdzNwNkUjUQ7kNvwEqCos8&_nc_oc=Adp8qAGlfqFL-RfzzxacSNHLEcBxMPDgwBt6ZavccXBFwVgR6CVWAkEkD5SuEkG6LQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6R7iqGjGrlm_bACOfjgWQZuSuw5YJRD76qr8hBIwZFw&oe=6AD228C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bkaf7QXoJZ0Q7kNvwGQKZr6&_nc_oc=AdpWvz9pjDegl0sLnl0k7eHVg5YgfoQAdk7WLw0bsNdmk5y2KzLY5tb5VSTlWz74wGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg2JCIpmBNOCzjgZ4j1D_P3qBDp7-VOuFwx1rU7rhXiQ&oe=6AD236C4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXZvvkptZiIQ7kNvwH24Z21&_nc_oc=Ado9W0uJQ0O47qfQ1IDBj1SoNSOK_oA0CeKzX9CyPaqzaap4s8YKpgrXYfpUD6BQ1o0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj4YkufS_wtD7oguQz_9HvYrEX6uM38sGuhstrKRHp6w&oe=6AD244B6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj45B0HKuVYQ7kNvwFsAhfz&_nc_oc=AdrHeAwB3J93rkFjlEcq6JViBBR2GjJPZ445CpdGK2pnrd-HlXsTefLMs7dExw10vuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtesF4kWeU5rVbIC5wlE32q3W8be3oIVk9dGjOdiDz1g&oe=6AD2480D"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcDP5MjkOx4Q7kNvwHeddFs&_nc_oc=AdphbSIPeYTPy33jjFYdZNm_eOPSQOSkAwv1daVTI7Rlz9RvNM70njVau4t0kQptIiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTym4nciIqthxplpVrfda82s_S8hC6Egg3SZCOvBt9XA&oe=6AD24CC1"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
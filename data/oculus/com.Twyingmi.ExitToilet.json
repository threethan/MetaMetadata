_ohc=GOdPYtDBrzQQ7kNvwEcAPNC&_nc_oc=AdoMKloYUpo6wb5EiU7zHO_3u1b0goCKlSWbib980zZOHWozb3TWb-goTc-ImfM-DNc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ6a6A10UROhAHk-PqZU-iKIOoweu6lDclRb25jNJrWA&oe=6A4E45EF"}, {"file_name": "\u622a\u57162.png", "id": "2087193361730451", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462203_2087193365063784_862658085619166334_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQjZPicGDtQQ7kNvwHkEKNU&_nc_oc=AdpcjHvopimrz_SZr3vvHnrow0qlfKM58E1X_K1MHeICom7hCQxA1l0QBlp5njPamS4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMaOMDs5t1H2WnrOMqfaKWrD4Dtfe-_pKrBkIPey8cNQ&oe=6A4E6227"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TK_ZC_w38wEQ7kNvwETiB_l&_nc_oc=Adpp6ldyNvxqGwBsBFb0miWhK8aoTkHr5DvXY8Tx1x00bQ0Bhg8r7aMr2jhtSkaCeiY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY0VZhq5Ycd9V8ja6pj2N-tfXZT8umtSnCaBdVpLvAzA&oe=6A4E4151"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlqO6qhsQLQQ7kNvwFg0Tzl&_nc_oc=AdqXMM_dAhk1iyb-cjQNXp0Ynau5mlrUIyX4aWv_BqC4cnd0Yndq9hMVAPQ9xav-EVg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAfyj7agNcJQtpHbbChiRXZ4iMPB_RI-pirz086dTnfQ&oe=6A4E63E7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fZmQCJ90-8Q7kNvwGKnPXz&_nc_oc=AdoyyfMUMQDUqu9W0IKy2wP5wxBM8FsC60Nzh6rlJ09FEmCix-Xxh-IpmTIEDX2BldE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT6TuejV_oCEJfcry1GCNC4cPnkheXY0jLKx4gtqBfRA&oe=6A4E52C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJEGE51hrEcQ7kNvwFwuXQ4&_nc_oc=AdpehXOI7S56VKamqbQ0pH9XfqcGwfFdZCZtRFAr6qPTtaO4NfE9m6z6c1JArQJQc1A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd29mIeYgOBAXk-VWdFDs-FVPc1QrNA5HTxlouO1h8Xg&oe=6A4E60C4"}, {"file_name": "1008x1440.png", "id": "1182949610072593", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75392232_1182949613405926_2898506178213785049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ceYkoEhCS0Q7kNvwFgfHQH&_nc_oc=Ado-PfmhdoaHp3pofWgx433Oxm2LxWBnhxU1mXSfbdAPefWRF6x0sfZm0Bh8GJKHld4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFMu9sjO4dOYyjnyhfo9Pc4M3-fkuieu3h09tOCJF8zA&oe=6A4E6EB6"}, {"file_name": "1080x360.png", "id": "1144873710614671", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031548_1144873713948004_7837426084537891215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0buEmbUcqoQ7kNvwHBO6rK&_nc_oc=AdqkSPidl2n6z7VVADlJYedPEDdvPDp9vdMtv2Kp2_9FLPN7jMZTIp1bukxtlvlghmw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-DXSO-1QV685IMGB51U5jOq-CAy9Xo_wRn02WPOgJ0A&oe=6A4E39CD"}, {"file_name": "LOGO.png", "id": "1133433471817081", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75375772_1133433475150414_1715205268410684577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4FKd5oAzBMQ7kNvwHHBY4v&_nc_oc=AdpyZmfvd0wY_jz0XwXj43pO5973yALQhm13O-6ynM28To_Lzn_sff9kClU4NMW38D4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhUtUQTe-o_8H-6Jo_vya2R7BwZifen2GtwiPLJz2Q5g&oe=6A4E3E81"}, {"file_name": "3000x900.png", "id": "930390195865438", "image_type": "APP_I
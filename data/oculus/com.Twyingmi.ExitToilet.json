nHWEW6rEj_ewtbmdn8OC3C9xNyQBKvOua7X6I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRExT1EVdp7BaHrhgN9i45SgZzHbOTvzmcrOea9P-SvA&oe=69AAAFE7"}, {"file_name": "\u622a\u57163.png", "id": "565742826430110", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031337_565742829763443_2348743012161439434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whJCVGb0n0AQ7kNvwGW2P33&_nc_oc=Admg9WZBo78flZrJfSJjypxsgKBwPpgJ8yjE8sdUcDIt_SBEFq8bVwbRETcyS1bIYZs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_fivMS232HIj83pq100crGG7iXWYhyAFA32TvnSW81Q&oe=69AAC751"}, {"file_name": "\u622a\u57164.png", "id": "457325230760902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75485575_457325234094235_6559372112880837045_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czD_vVUtR4MQ7kNvwGxiij3&_nc_oc=AdnJT5m9Wv8TQRSNR9IboUSVbhZpSKu50IykGWQ2pAp5J0tkB367gCpbyc30tp5vynI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwinUSEnb_vn4K8ZMEOoVgMLnes1VJ7yzAHWJNetLdtVw&oe=69AAB1A7"}, {"file_name": "\u622a\u57165.png", "id": "2043351619496913", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031437_2043351622830246_8775906402630274259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYN9w9CTEtEQ7kNvwEfgFsI&_nc_oc=Admbx6LKtdgYn5BVsSaojDGgnGEvNR2_KoSEHIc-RqKhe5ymkuqJ6FIB6tAeT39QTBY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afxykz6M_6xSiRASrMSRIXmfLJ5r8O5Rk8yO0uSDr3LtOw&oe=69AAD8C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExitToilet", "keywords": ["escape", "puzzles", "inference"], "long_description": "Game Description\nThe CEO of a biotech company mysteriously vanishes one morning. As a determined journalist, you sneak into his mansion to investigate, only to find yourself trapped in a creepy bathroom. Each clue and puzzle brings you closer to uncovering the truth\u2014but the deeper you go, the darker the secrets become.\n\nThis escape room is a test of wit, courage, and observation. Solve puzzles, uncover a sinister conspiracy, and escape before time runs out.\n\nGame Features\nGripping Narrative: A story full of twists and hidden secrets.\nImmersive Environment: Tense atmosphere with detailed designs and sound.\nChallenging Puzzles: Solve intricate puzzles with keen observation.\nPsychological Tension: Every revelation brings more danger.\nComplete VR Experience: Intense first-person perspective.\n\nGameplay\nExplore and Observe: Examine the environment for clues.\nSolve Puzzles: Unlock barriers and piece together the mystery.\nUncover the Truth: Discover the secrets behind the CEO\u2019s disappearance.\nSurvive and Escape: Stay calm and find the way out.\n\nIdeal Players\nFans of mystery and puzzles.\nThrill-seekers looking for a chilling experience.\nThose who enjoy story-driven gameplay.\nReady to face your fears and uncover the truth? The challenge awaits!\n\nControls\nHold the A button to move.\nPress the grab button to interact with objects.", "short_description": "The CEO of a biotech giant vanishes mysteriously during his commute, shocking the world. As a journalist, you sneak into his mansion for answers but become trapped in a chilling bathroom full of secrets.\n\nThis isn\u2019t just an escape room\u2014it\u2019s a test of wit and courage. Solve puzzles, uncover clues, and reveal the dark truth behind the CEO\u2019s disappearance. Face your fears, escape, and expose a conspiracy that will shake the world.\n"}, {"images": {"nodes": [{"file_name": "LOGO.png", "id": "2597103487166681", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86625129_2597103490500014_3922643013080904156_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNsWSvd8VK4Q7kNvwG5rqjA&_nc_oc=Adkwt7XW9ac8JktN5LLvQyg7VOH5boQ5GwOmPaGpZ_6W_xYVWyZKHB7H4_M9s3oBnzg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4CRX-s2sxE6cDzu3Rq6yly2bzr0ocJKZW32aK2sfA_g&oe=69AAE6C4"}, {"file_name": "10
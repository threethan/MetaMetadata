"https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624069_2384001469109057_315422807874123986_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5HeNMpcqEsQ7kNvwEu9iXn&_nc_oc=AdrSMwh7VPL8Vcfc149a91cZ75Y87Syty-mRUVaguAHquN73u0yeEqKejkwSnnNpD_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjSLjm7drnKYk-A6AB1mYd7LM2yCDVx97GlCtAlW649Q&oe=6B01C4D1"}, {"file_name": "boss must die (15).png", "id": "2452335391966549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620341_2452335398633215_3791904907580169580_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qlZG3kCfYIQ7kNvwFRmiGm&_nc_oc=AdqNcUqnyA9jUdFf72PAIYZGjuBPILBbRot5ilCA5oIwOFpMsRC3RHInAcq39Lhl4wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3lSiBc7rUEw5jmFxRIHY1k2DOxk6aukrKnUqyUTD6-g&oe=6B01C224"}, {"file_name": "boss must die (17).png", "id": "2153673868553221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593832569_2153673871886554_2731276665757713042_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL4oc9GmNC0Q7kNvwHCH41H&_nc_oc=AdpNlmLD-HbYa7AB26wPQ4GAN_yN-i-HHPtEo0fUa3C_tCz_WIhhFgofsADJ38KGs8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR12lTBfT0hxi9kFd9r4u1eFU52YRV7FRzptRPbBFBT1w&oe=6B01C384"}, {"file_name": "boss must die (16).png", "id": "1112513051742007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623179_1112513055075340_2861796810304398336_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMg3rSd0UHgQ7kNvwEqGP6e&_nc_oc=AdpRL1LUU5aKljE7zPo1SjeqslxtfDqFziSeEQ-zBU_UEawJRCg6KCL4qnb5x_evnZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbMYboRbAOMUJR9g8ZheFR-Fs5wGoyImnQcte6RD6JTg&oe=6B01B983"}, {"file_name": "boss must die (14).png", "id": "1437563618334377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627502_1437563621667710_1808242683708600954_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMSTAwItXcUQ7kNvwE3Kl0N&_nc_oc=Adq8sUO0MTcVN4Y-Oyl7J8PrzENOipcIwZNqFnxicdrzG4z1YKk_t6f5CVNaz-3p9l8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNvWCcztBks97WmmcM8DKE45f_M32CUkum7QtNCIgd7g&oe=6B01BF68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boss must die (1).png", "id": "1444589307622444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620316_1444589310955777_4936033017264709315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exGzdNEHFHQQ7kNvwHzJdNk&_nc_oc=Adqo-913O0YA4X1WkUXL2ue7XSmnDyi1tXBpNUzRsbVFZYNoYOLWil8ne9xNSJ2rxtA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1_MRgKBTDSYYTqIQG_gvfmYwLUCgI14ijyM9bpomL9w&oe=6B01CA3A"}, "display_name": "Boss Must Die", "keywords": ["Physics", "sandbox", "Destruction", "Action", "Comedy"], "long_description": "They fired you. Now it\u2019s time to break company policy\u2014and the furniture!\n\nBoss Must Die is a colorful VR action game where office revenge meets physics-based sandbox chaos. After an unfair termination, return to your former workplace and fight your way from reception to the executive suite across 10 office levels.\n\n**SMASH, THROW, DESTROY**\n\nSwing a baseball bat, shatter glass, smash furniture, and send office equipment flying. Grab props, throw enemies, and watch physics-driven characters react to every hit.\n\n**CHOOSE YOUR TOOLS**\n\nUnleash melee weapons, firearms, a bow, grenades, and a flamethrower. Select your loadout with the weapon wheel, grab weapons from your holsters, and set up explosive barrel chaos.\n\n**MAKE EVERY DEPARTMENT REGRET IT**\n\nComplete destruction challenges, pull outrageous pranks, send embarrassing emails, and confront department bosses. Explore everything from HR and Finance to development studios and executive offices.\n\n**SECURITY IS ON THE WAY**\n\nFace guards and recurring reinforcements, including armed security on later floors. Keep moving and turn the office into your playground.\n\n**KEEP THE CHAOS GOING**\n\nReplay unlocked levels, experiment with different weapons, and discover new ways to make a spectacular mess.\n\nBright low-poly visuals. Ridiculous office humor. Hands-on VR destruction.\n\nTheir office. Your rules.", "short_description": "Turn your last day at work into total chaos! Smash offices, wield wild weapons, battle security, and pull outrageous pranks across 10 levels. Boss Must Die is a colorful VR physics sandbox where corporate revenge meets destructive fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fVCFHCSs2q-jfCkhLxteeTYRhwPRLfp0BY-pCsxmxOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1638623718048131"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593887116_1090745690534130_3280903555339893411_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bd_hAXrIhncQ7kNvwGWJJn_&_nc_oc=Adpi7OI2giFLq47DMxxQpSQ0gGUCRbLT7oLRZFYKr3tHDTxD3jh
30f&oh=00_AQQyVNrdRKrYzg6zRcjsKTs9xIiFjeeAgcH9nc2syAeRJA&oe=6B0B2C43"}, {"file_name": "boss must die (14).png", "id": "1437563618334377", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499627502_1437563621667710_1808242683708600954_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bx9bKzBO14Q7kNvwG8i8mh&_nc_oc=Adq9TD8JOBC_YZEw80HHhdoadoazt7LQQKEGK0-6CFrZWs96Ta2IkGdlRbOQpC9Aby0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPYWE7m1cE82tkjHVt8qz8TV7-AvOcwpALaD_H0z3r0g&oe=6B0B3228"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "boss must die (1).png", "id": "1444589307622444", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620316_1444589310955777_4936033017264709315_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEp1Fo75KWoQ7kNvwEcDHvf&_nc_oc=AdoPin13kmIMF4Um1RjtpMGVwpBin3DkpDbM1iqw1STltpBdggO8RNLT0NqpNQgMAn0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQOm1BGgrum6NCw9r_2eZDqxpPMKlyQOzQQr63z6_vAA&oe=6B0B3CFA"}, "display_name": "Boss Must Die", "keywords": ["Physics", "sandbox", "Destruction", "Action", "Comedy"], "long_description": "They fired you. Now it\u2019s time to break company policy\u2014and the furniture!\n\nBoss Must Die is a colorful VR action game where office revenge meets physics-based sandbox chaos. After an unfair termination, return to your former workplace and fight your way from reception to the executive suite across 10 office levels.\n\n**SMASH, THROW, DESTROY**\n\nSwing a baseball bat, shatter glass, smash furniture, and send office equipment flying. Grab props, throw enemies, and watch physics-driven characters react to every hit.\n\n**CHOOSE YOUR TOOLS**\n\nUnleash melee weapons, firearms, a bow, grenades, and a flamethrower. Select your loadout with the weapon wheel, grab weapons from your holsters, and set up explosive barrel chaos.\n\n**MAKE EVERY DEPARTMENT REGRET IT**\n\nComplete destruction challenges, pull outrageous pranks, send embarrassing emails, and confront department bosses. Explore everything from HR and Finance to development studios and executive offices.\n\n**SECURITY IS ON THE WAY**\n\nFace guards and recurring reinforcements, including armed security on later floors. Keep moving and turn the office into your playground.\n\n**KEEP THE CHAOS GOING**\n\nReplay unlocked levels, experiment with different weapons, and discover new ways to make a spectacular mess.\n\nBright low-poly visuals. Ridiculous office humor. Hands-on VR destruction.\n\nTheir office. Your rules.", "short_description": "Turn your last day at work into total chaos! Smash offices, wield wild weapons, battle security, and pull outrageous pranks across 10 levels. Boss Must Die is a colorful VR physics sandbox where corporate revenge meets destructive fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fVCFHCSs2q-jfCkhLxteeTYRhwPRLfp0BY-pCsxmxOs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1638623718048131"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.ocu
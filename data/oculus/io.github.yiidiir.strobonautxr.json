vJreBofY4UeMHWPirkg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMtsZHe5skqqOr8A4iEzy1iZTJvRoS4_nQ_LbcM8Y_9g&oe=6B084B85"}, {"file_name": "5_afterglow.png", "id": "3052909225041944", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823341_3052909228375277_2984659537694059370_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNGy-IdMlLgQ7kNvwFp1AmX&_nc_oc=Adpi5G5G6Tgs_b9DL69LyzQ6cYaaO0FOuBRoUUYjaoCxSwpo0VAMRg1LQXCmE738Pa8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP03eIb3kEKCVpXVaSUDUogSfLvj25wnuPgKi6pbAb9A&oe=6B0866A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lumina Drift: Light Journeys VR", "keywords": ["meditation", "relaxation", "light", "flicker", "handtracking"], "long_description": "Lumina Drift is a set of light journeys for Meta Quest. Sit back, choose a colour and a rhythm, and let a field of soft flicker fill your view. Many people begin to see patterns, colours and movement that are not in the image at all.\n\n# JOURNEY\nFollow a path of short levels, from a gentle first light to deep space. Earn stars as you go, or open any level straight away.\n\n# LIBRARY\n- Photic: full-field flicker in red, amber, green and more, with slow sweeps.\n- Worlds: sit inside a spinning Lantern, fly the Tunnel, spin through the Spiral, drift in Afterglow, or watch a Mandala unfold.\n- Essence: thousands of particles of living light. Close your hand to gather them, open it to let them go, and watch light stream between your fingertips.\n- Resonance: grab a glowing orb to tune it, touch it to play, tilt your head to bend the sound.\n- Lab: Rhythm Lab, Gamma 40 and Colour Word, a quick word game you answer with a pinch or a fist.\n\n# MADE FOR QUEST\nHand tracking with full 3D hands, or Touch controllers. Runs at up to 120 Hz, with flicker timed to stay steady at any refresh rate.\n\n# PHOTOSENSITIVITY WARNING\nThis app contains intense flashing and flickering light. Do not use it if you have epilepsy, a history of seizures, or sensitivity to flashing light. Stop immediately if you feel dizzy, unwell or disoriented, or notice any change in vision. Play seated in a clear space.\n\nLumina Drift is for relaxation and entertainment. It is not a medical device and makes no health claims.", "short_description": "Drift through flickering light, slow tunnels and glowing particle worlds made for Meta Quest. Pick a colour and a rhythm, settle in, and watch the shapes and colours your own eyes start to add to the light. Reach out with your hands to gather drifting light in Essence, follow a guided Journey of short levels, or open the full library and play freely. Contains intense flashing light."}]}, "developer_name": "OgygiaXR", "developer_privacy_policy_url": "https://strobonaut-xr.yader-dev.workers.dev/privacy/", "developer_terms_of_service_url": "https://strobonaut-xr.yader-dev.workers.dev/terms/", "publisher_name": "Ogygia Studios", "support_website_url": "https://strobonaut-xr.yader-dev.workers.dev/support/", "website_url": "https://strobonaut-xr.yader-dev.workers.dev/ogygia/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1900488371394680"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1671677351281986"}]}, "baseline_offer": {"id": "1671677351281986"}, "is_approved": tr
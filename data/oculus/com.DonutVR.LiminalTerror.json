illa", "scary"], "long_description": "Liminal Terror is a game where you can explore numerous levels of The Backrooms, and try to escape each one. You can have fun with friends, or play alone and be terrified of what may be lurking inside.  This game has a lot of active staff that will play along and take care of the game.", "short_description": "Liminal Terror is a game where you can explore numerous levels of The Backrooms, and try to escape each one. You can have fun with friends, or play alone and be terrified of what may be lurking inside.  This game has a lot of active staff that will play along and take care of the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/liminalterror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Donut VR", "support_website_url": null, "website_url": "https://sites.google.com/view/liminalterror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1372507805935212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_1379246260853492_344943181194573320_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dA6l-Oc57xAQ7kNvwHabV6n&_nc_oc=AdoPBVOQeSoYyUrlMVqOW0vE1G8Dwr5j1b8mhoXJaAySmquI9h5qDzOHMYfbOhhW-YU&_nc_zt
ent-iad3-1.oculuscdn.com/v/t64.5771-25/491822446_1174558974446117_1517584013730391571_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVdp9EAs4xEQ7kNvwGVkcGO&_nc_oc=AdqoU6o8Kd_EQeijgb0-TFRtFu2qp3qVDUImaa4M_mlsOtzRHcL8oBbVWnsNc-jgkRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ939QHScrJwdq2oo-uLbkmdQSv5qeVyg8Eb2DgvR5ZGg&oe=6A984703"}, {"file_name": "Meta Quest screenshot 6.png", "id": "2246959909040299", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819923_2246959912373632_5073221176859083974_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU_GpO0WGGcQ7kNvwHGDlTj&_nc_oc=AdoOsw71p1BAMFITcuzJOs11EvG0bRbBac_POhtQKlYzUXaYXVHartEiCpR2S-rwr9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz2ejDV3PFLTu_6hy2CKoAohdhzep4Dd7Z6RaTJPvCcQ&oe=6A984611"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoom Workplace", "keywords": ["meetings", "video", "conferencing", "calls", "communication"], "long_description": "Reimagine how you work with Zoom Workplace in VR. Leverage the power of Zoom Meetings on Meta Quest devices with any free or paid Zoom license.\n\nWith the Zoom Workplace app, you can:\n\u2022 Schedule or join video meetings\n\u2022 Share content during meetings\n\u2022 Chat with colleagues and external contacts\n\n40 minutes not enough? With a paid Zoom Workplace Pro account, you can:\n\u2022 Host unlimited meetings, up to 30 hours each\n\u2022 Use AI Companion, your AI assistant\n\u2022 Assign hosts, co-hosts, and schedulers\n\u2022 Record meetings to the cloud (up to 5GB)\n\nWe\u2019d love to hear from you! Join the Zoom community: https://community.zoom.com/\n\nFollow us on social media @zoom\n\nTerms of Service: https://explore.zoom.us/terms/ \nPrivacy Statement: https://explore.zoom.us/privacy/ \n\nHave a question? Contact us at https://support.zoom.com/hc ", "short_description": "Connect, collaborate, and get more done together with Zoom VR video meetings."}]}, "developer_nam
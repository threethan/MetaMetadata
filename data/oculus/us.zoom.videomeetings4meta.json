id=6e7a0a&_nc_ohc=y0m2-m_1LkoQ7kNvwGnEncH&_nc_oc=AdloJEEXoW44vKmtOvA6pzSB2wJiIm-8Xd7tOONoZD-MqTjP3wg0r_lFPkvqD3oG_hA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftKcBYttdKdtPwLci527nEyZcqdIEPTEdX1_gxfXMs4fg&oe=69984BC3"}, {"file_name": "Meta Quest screenshot 6.png", "id": "2246959909040299", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819923_2246959912373632_5073221176859083974_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RglCqfLkyIQ7kNvwGRgbP2&_nc_oc=AdmHKsGpXslqE30kIXbcbCGddOciJmL-u8RbzHbu2NpVe0OBgKkB_hHagybTHuLtqIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuYvipiDGZrFSRvOhT7fMARyv5w4t4ahCBFOhHvtoiLJg&oe=69984AD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoom Workplace", "keywords": ["meetings", "video", "conferencing", "calls", "communication"], "long_description": "Reimagine how you work with Zoom Workplace in VR. Leverage the power of Zoom Meetings on Meta Quest devices with any free or paid Zoom license.\n\nWith the Zoom Workplace app, you can:\n\u2022 Schedule or join video meetings\n\u2022 Share content during meetings\n\u2022 Chat with colleagues and external contacts\n\n40 minutes not enough? With a paid Zoom Workplace Pro account, you can:\n\u2022 Host unlimited meetings, up to 30 hours each\n\u2022 Use AI Companion, your AI assistant\n\u2022 Assign hosts, co-hosts, and schedulers\n\u2022 Record meetings to the cloud (up to 5GB)\n\nWe\u2019d love to hear from you! Join the Zoom community: https://community.zoom.com/\n\nFollow us on social media @zoom\n\nTerms of Service: https://explore.zoom.us/terms/ \nPrivacy Statement: https://explore.zoom.us/privacy/ \n\nHave a question? Contact us at https://support.zoom.com/hc ", "short_description": "Connect, collaborate, and get more done together with Zoom VR video meetings."}]}, "developer_name": "Zoom Communications, Inc.", "developer_privacy_policy_url": "https://explore.zoom.us/privacy/", "developer_terms_of_service_url": "https:/
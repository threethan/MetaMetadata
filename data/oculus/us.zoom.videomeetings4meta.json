id=6e7a0a&_nc_ohc=k--Z_q851UQQ7kNvwGiDdP1&_nc_oc=AdnrmYmDWfSgNmSs32nIZODRyzzkwyIgc7A-zMbwX8fGsSND9uhN9Ir2c1dt78vdexY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftva9RGrFZjIDBFdaJu5Iw0RA2eHjVoeUldsR4qdqsPAw&oe=69A6CC43"}, {"file_name": "Meta Quest screenshot 6.png", "id": "2246959909040299", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819923_2246959912373632_5073221176859083974_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70YzlCbWWrUQ7kNvwFuWz2c&_nc_oc=AdmyPE0JQEPLw-OUb8EE9fgB-6WlHOQnJ4aExOrifnt0IrRQ-_7Qng9LnMR0GbheaQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsTDQxeu25L8bEHrw9E06Cb8OFzg2hygcCJyeBFk9P3mA&oe=69A6CB51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoom Workplace", "keywords": ["meetings", "video", "conferencing", "calls", "communication"], "long_description": "Reimagine how you work with Zoom Workplace in VR. Leverage the power of Zoom Meetings on Meta Quest devices with any free or paid Zoom license.\n\nWith the Zoom Workplace app, you can:\n\u2022 Schedule or join video meetings\n\u2022 Share content during meetings\n\u2022 Chat with colleagues and external contacts\n\n40 minutes not enough? With a paid Zoom Workplace Pro account, you can:\n\u2022 Host unlimited meetings, up to 30 hours each\n\u2022 Use AI Companion, your AI assistant\n\u2022 Assign hosts, co-hosts, and schedulers\n\u2022 Record meetings to the cloud (up to 5GB)\n\nWe\u2019d love to hear from you! Join the Zoom community: https://community.zoom.com/\n\nFollow us on social media @zoom\n\nTerms of Service: https://explore.zoom.us/terms/ \nPrivacy Statement: https://explore.zoom.us/privacy/ \n\nHave a question? Contact us at https://support.zoom.com/hc ", "short_description": "Connect, collaborate, and get more done together with Zoom VR video meetings."}]}, "developer_name": "Zoom Communications, Inc.", "developer_privacy_policy_url": "https://explore.zoom.us/privacy/", "developer_terms_of_service_url": "https:/
ent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822446_1174558974446117_1517584013730391571_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5LN_PFGgEoQ7kNvwE5ecCT&_nc_oc=Adot3n8OMWJp6aaqpOTs7HTL2aUdyVQ4CI17YFnn-CbvwNoxZkLWqavZd3xZF01Pp6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhoQlOAImfJYGOnXoWL_BVT9Gyu1EEnR-iBKjOFy-qDQ&oe=6A5CBB43"}, {"file_name": "Meta Quest screenshot 6.png", "id": "2246959909040299", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819923_2246959912373632_5073221176859083974_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6Ca9rv9bHcQ7kNvwFYISFg&_nc_oc=Adoq_ZGTOdl88ABDXbSgEqiDcYZdTiXuZWcVAFOhToevFmGDBM9CPbAr2OE1kMR9Zv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ0pHOdotPR7kn0L_itljz_fB4N66swwJNCBVisGC_1Q&oe=6A5CBA51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoom Workplace", "keywords": ["meetings", "video", "conferencing", "calls", "communication"], "long_description": "Reimagine how you work with Zoom Workplace in VR. Leverage the power of Zoom Meetings on Meta Quest devices with any free or paid Zoom license.\n\nWith the Zoom Workplace app, you can:\n\u2022 Schedule or join video meetings\n\u2022 Share content during meetings\n\u2022 Chat with colleagues and external contacts\n\n40 minutes not enough? With a paid Zoom Workplace Pro account, you can:\n\u2022 Host unlimited meetings, up to 30 hours each\n\u2022 Use AI Companion, your AI assistant\n\u2022 Assign hosts, co-hosts, and schedulers\n\u2022 Record meetings to the cloud (up to 5GB)\n\nWe\u2019d love to hear from you! Join the Zoom community: https://community.zoom.com/\n\nFollow us on social media @zoom\n\nTerms of Service: https://explore.zoom.us/terms/ \nPrivacy Statement: https://explore.zoom.us/privacy/ \n\nHave a question? Contact us at https://support.zoom.com/hc ", "short_description": "Connect, collaborate, and get more done together with Zoom VR video meetings."}]}, "developer_nam
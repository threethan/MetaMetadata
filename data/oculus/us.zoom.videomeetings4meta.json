rms of Service: https://explore.zoom.us/terms/ \nPrivacy Statement: https://explore.zoom.us/privacy/ \n\nHave a question? Contact us at https://support.zoom.com/hc ", "short_description": "Connect, collaborate, and get more done together with Zoom VR video meetings."}]}, "developer_name": "Zoom Communications, Inc.", "developer_privacy_policy_url": "https://explore.zoom.us/privacy/", "developer_terms_of_service_url": "https://explore.zoom.us/terms/", "publisher_name": "Zoom Communications, Inc.", "support_website_url": "https://support.zoom.com/hc", "website_url": "https://www.zoom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24926286573628552"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819980_2262144460907456_5813438657567181382_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-xzVh5NxHwQ7kNvwEtFiaT&_nc_oc=Adpie4DCtysWasHec61F-SCyoNrRZry9PVW7y_yqNtzTX5E-BVuKXbR4pRZtP45Ysjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRw3xKb9PVkta-oQjF3T9T6novjmCc3l2K4DLnyHShBtw&oe=6B0C7250"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zoom Workplace", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Prod
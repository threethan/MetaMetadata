2jIfUZj-qRWGLE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDj1xudfVnrNvc5dOd5lRDR-otmQrmKO2c8_lE7C32tw&oe=6AFB30AC"}, {"file_name": "Meta Quest screenshot 3.png", "id": "1174558971112784", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822446_1174558974446117_1517584013730391571_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKX04uQYtSMQ7kNvwHJTguT&_nc_oc=Adq9k1YaARLf0CHrf_5KqC44E-Yf_fsD66Q7IO1Jg0_Is68Xt8Pbg_KVFKEGlJ3Ops0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo5CxHMzvk2cwDso5dGKX8oz7HQ3J5Vc0BoaIQWfSwIA&oe=6AFB2783"}, {"file_name": "Meta Quest screenshot 6.png", "id": "2246959909040299", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819923_2246959912373632_5073221176859083974_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO2x_aXDuYMQ7kNvwHtP2av&_nc_oc=Adoxqseoni8WQRjqmOm4Q08NfAJTXEha0u7uD7SnBrgp-dqJzigwCIPa0RrQSbTbJh8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQExdVCDTQ-G8a17hJkcWk1jZrvCqT7yO1iUA6rDf9B7A&oe=6AFB2691"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoom Workplace", "keywords": ["meetings", "video", "conferencing", "calls", "communication"], "long_description": "Reimagine how you work with Zoom Workplace in VR. Leverage the power of Zoom Meetings on Meta Quest devices with any free or paid Zoom license.\n\nWith the Zoom Workplace app, you can:\n\u2022 Schedule or join video meetings\n\u2022 Share content during meetings\n\u2022 Chat with colleagues and external contacts\n\n40 minutes not enough? With a paid Zoom Workplace Pro account, you can:\n\u2022 Host unlimited meetings, up to 30 hours each\n\u2022 Use AI Companion, your AI assistant\n\u2022 Assign hosts, co-hosts, and schedulers\n\u2022 Record meetings to the cloud (up to 5GB)\n\nWe\u2019d love to hear from you! Join the Zoom community: https://community.zoom.com/\n\nFollow us on social media @zoom\n\nTerms of Service: https://explore.zoom.us/terms/ \nPrivacy Statement: https://explore.zoom.us/privacy/ \n\nHave a question? Contact us at https://support.zoom.com/hc ", "short_description": "Connect, collaborate, and get more done together with Zoom VR video meetings."}]}, "developer_name": "Zoom Communications, Inc.", "developer_privacy_policy_url": "https://explore.zoom.us/privacy/", "developer_terms_of_service_url": "https://explore.zoom.us/terms/", "publisher_name": "Zoom Communications, Inc.", "support_website_url": "https://support.zoom.com/hc", "website_url": "https://www.zoom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24926286573628552"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819980_2262144460907456_5813438657567181382_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJGspBFyvsQQ7kNvwEMDvXd&_nc_oc=AdoqYBOsihHsKvTQsmSVq5Y8VjH2M1cJ5MszhtFJ7EaN9yam0deMDqd5wfNUrRKtTDc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu3F4g_kfQBL-5HTA3UEyhdYfbv9HXh5R5Ez98pWgoEQ&oe=6AFB1690"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zoom Workplace", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Prod
106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-9mhqtcp9sQ7kNvwGw9BTP&_nc_oc=AdoNlA2qE9tEw6eObL5PS1OfH85OEDaHTZTom92UirHt4R07bI_Z2NYGCWP7z7HmVj8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3NQAu01nTvY4XNHz_Hc6cQUy5brMuhDh2LNOwvY-aVg&oe=6A80624E"}, {"file_name": "SS_6.png", "id": "2546698245750562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825415_2546698249083895_7275017092245657925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUh3rrRIkskQ7kNvwGwTwRt&_nc_oc=AdrHk8XOwXPoBKw7ULW-rYw-HnahBqhxsCtQoP0dN3SiUnJBGwmDFHtQAEMT-AUWo2E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLZdxb0yW65kuLeVvEohKbLYAkmHVflbEze_GQtFAFEQ&oe=6A804F5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Duck: Bird Simulator", "keywords": ["duck", "bird", "simualtor", "vr", "animal"], "long_description": "Enter the playful world of I Am Duck Bird Simulator, a fun and immersive duck bird simulator VR game built for Meta Quest. Become a mischievous duck bird and explore colorful interactive environments filled with exciting activities, collectibles, and lighthearted challenges. Fly like a bird, swim like a duck, waddle through lively locations, and enjoy a relaxing yet entertaining animal simulator VR experience designed for all ages.\n\nExplore open sandbox style levels where you can freely move, interact with objects, and complete engaging duck missions. Discover hidden rewards, explore vibrant areas, and experience smooth, physics based gameplay that makes every movement enjoyable. Whether you enjoy duck games, bird simulator games, or casual fun VR games, this experience offers a unique blend of adventure and exploration.\n\nI Am Duck Bird Simulator is optimized for smooth performance and comfort on Meta Quest, delivering immersive gameplay with responsive controls and colorful visuals. Perfect for fans of duck  bird simulator VR, animal simulator VR,  sandbox games, and relaxing VR experiences, this is a must-play Quest VR game for players who love fun, exploration, and charming duck adventures in virtual reality.", "short_description": "Waddle into I Am Duck Bird Simulator, the ultimate bird simulator and fun animal simulator VR game on Meta Quest. Explore colorful open levels, complete duck challenges, and enjoy interactive sandbox gameplay with smooth controls and physics-based fun. Fly, swim, collect rewards, and discover hidden surprises. Optimized for Meta Quest, this is a top VR sandbox game, open world VR experience, and must play Quest game for duck game fans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26587092930895414"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2075693016636317"}, {"status": "PUBLISHED", "id": "1456800866081891"}, {"status": "PUBLISHED", "id": "26411792775094489"}]}, "baseline_offer": {"id": "26411792775094489"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "2075693016636317"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
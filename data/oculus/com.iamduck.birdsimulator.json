YeFoQ7kNvwHbGrn5&_nc_oc=AdrnIZ8gbNbPsPbg1-EJkSWtZ-NqpDiUPyg-oavfZ_8jfqxOT2OQN9zQsGOjpqs1RMw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhUuQfoLVo5NYJW3XkQtSEhmAzOo1gUTD1DgccHi4wlA&oe=6A8064FF"}, {"file_name": "1.png", "id": "2015584696019868", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618440_2015584699353201_2871973561294841341_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_I-aJ4rYkYQ7kNvwFiqTM5&_nc_oc=AdpDe_EQN8td9NWfDAwcvJENXKd3B890gEHZBxRPxjCe_Bm03BmTg2kTU47eUrnLfnk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbpE2O5yBh4a6ntxndvbU6q2qkK7xZH0Zs6bD0mlPrqA&oe=6A8042D9"}, {"file_name": "5.png", "id": "942569592069597", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620429_942569595402930_3826715638120471674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9BPidNICa8Q7kNvwFbnbBI&_nc_oc=AdqmK8fPbVaWytIpm7VC9Xgzo4yrQwKzCsmWnCmnmpgu21Hked99688xAkkrVa7B0jo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZDiFI2KdvLCS0vcvmFcFF_4CT7nPw0xaPdon8uc3Exw&oe=6A806898"}, {"file_name": "4.png", "id": "2130953461016418", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617729_2130953464349751_8827972804956759576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8uKR2E-xg4Q7kNvwHIW2L0&_nc_oc=AdqzLcw4iTRUFFSdIL6EJbgkhvZDWDraZhlnGSL1-KeX1JXCYKgt79ckEyiST2mxPWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1Zqv9obQmoFAIbKV6aQtZGOab4xiy8FZliiyYzhszYQ&oe=6A80400F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "1494917429031861", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823270_1494917432365194_1280805766138695768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GvDZ2PXQUgQ7kNvwEAvJF8&_nc_oc=AdpvpoqE0N0BLQ4PHCbC4SmXe8giGuLxPbkdJUBgipd7JIQalI4fOnv-XKfGbrumkqI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYuw1It1Z3PLZ3VlQr4yes-xdl9fJZ3XBTVG_KMxzkIA&oe=6A80659B"}, "display_name": "I Am Duck: Bird Simulator", "keywords": ["duck", "bird", "simualtor", "vr", "animal"], "long_description": "Enter the playful world of I Am Duck Bird Simulator, a fun and immersive duck bird simulator VR game built for Meta Quest. Become a mischievous duck bird and explore colorful interactive environments filled with exciting activities, collectibles, and lighthearted challenges. Fly like a bird, swim like a duck, waddle through lively locations, and enjoy a relaxing yet entertaining animal simulator VR experience designed for all ages.\n\nExplore open sandbox style levels where you can freely move, interact with objects, and complete engaging duck missions. Discover hidden rewards, explore vibrant areas, and experience smooth, physics based gameplay that makes every movement enjoyable. Whether you enjoy duck games, bird simulator games, or casual fun VR games, this experience offers a unique blend of adventure and exploration.\n\nI Am Duck Bird Simulator is optimized for smooth performance and comfort on Meta Quest, delivering immersive gameplay with responsive controls and colorful visuals. Perfect for fans of duck  bird simulator VR, animal simulator VR,  sandbox games, and relaxing VR experiences, this is a must-play Quest VR game for players who love fun, exploration, and charming duck adventures in virtual reality.\n{923209630104501}", "short_description": "Waddle into I Am Duck Bird Simulator, the ultimate bird simulator and fun animal simulator VR game on Meta Quest. Explore colorful open levels, complete duck challenges, and enjoy interactive sandbox gameplay with smooth controls and physics-based fun. Fly, swim, collect rewards, and discover hidden surprises. Optimized for Meta Quest, this is a top VR sandbox game, open world VR experience, and must play Quest game for duck game fans."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null
content-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHs0_FgtqxskzPHU74cWlYuHi5UXRx337zTvsjiVsvqg&oe=6AFB1B20"}, {"file_name": "com.mirrormac.quest-20260905-231544.png", "id": "1670784644702507", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623131_1670784651369173_75770255626112921_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkrRN-inpxAQ7kNvwEu7hjZ&_nc_oc=Ado8tsUTWhgFUqdYX7oZjvY00GSDXJUQElRclY-FnesgIxCiIv9u-PHAtum8662ye3E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUdRFHC2fjwE7EKarPInZkfEEeXa9Yl3okaDu0378ZGA&oe=6AFB44CC"}, {"file_name": "com.mirrormac.quest-20260905-231637.png", "id": "1495499909262886", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623179_1495499912596219_4366356276734656168_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQrfh7kWi-YQ7kNvwFhIKTJ&_nc_oc=AdqitnYQYMxnUsVrnhRvKIGeQ8ZxRwevEDNCOfAruPbFM7l1dauQfBs-PbOkQLs_SxU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPb9rZhfcrfs_1VJNQF10-E0_-98qc7wfZJ0yRVlIGNg&oe=6AFB3442"}, {"file_name": "com.mirrormac.quest-20260905-231514.png", "id": "1373386274986043", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620414_1373386278319376_696891017332174306_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScNddO_fBOsQ7kNvwEfm4l8&_nc_oc=Ado-QwI2qJKZtDOY4iJLCm_GbKaa2Ntx9MEVpaoOYNnQzvxyGMWTl90PrnprJJquQcM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwnOb7xloh9lDTvsZDXvT8tpnv9lio1k5Vg8CT7vfG2g&oe=6AFB45B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Screen Mirroring", "keywords": ["Mirroring", "Mac", "3D", "Cinema", "Streaming"], "long_description": "Give your Mac screen room to grow.\n3D Screen Mirroring brings your Mac display into an immersive viewing space on Meta Quest. Settle in front of a large curved virtual screen, enjoy supported stereoscopic 3D content, and surround your screen with colorful ambient effects.\nMake the experience yours:\n\u2022 Adjust screen size and curvature for comfortable viewing.\n\u2022 Choose screen layouts and fit options.\n\u2022 Customize ambient styles, glow strength, and shadows.\n\u2022 Use Quest controllers to adjust settings and recenter your view.\n\u2022 Connect over the same Wi-Fi network or through USB with ADB setup.\nStart the companion app on your Mac, connect your headset, and approve the pairing code on your Mac to begin sharing.\nA compatible Mac running the companion app is required. The Mac app includes a three-day free trial; continued mirroring requires a monthly or yearly subscription purchased separately through the Mac app. USB mode requires developer setup. Connection quality and performance depend on your Mac, headset, network, and selected streaming settings.", "short_description": "Bring your Mac screen into an immersive world on Meta Quest. Enjoy a large curved virtual screen, supported 3D content, and vivid ambient effects. Connect over Wi-Fi or USB and shape your viewing space. Requires the Mac companion app, with a subscription after its free trial."}]}, "developer_name": "3D Screen Mirroring", "developer_privacy_policy_url": "https://screenmirroring.kc-f90.workers.dev/privacy-policy", "developer_terms_of_service_url": "https://screenmirroring.kc-f90.workers.dev/terms-of-service", "publisher_name": "3D Screen Mirroring", "support_website_url": "https://screenmirroring.kc-f90.workers.dev/support", "website_url": "https://screenmirroring.kc-f90.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_g
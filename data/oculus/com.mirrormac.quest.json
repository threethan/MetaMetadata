_nc_ohc=ROCVFt-EABcQ7kNvwFsbOfU&_nc_oc=Adpa30jRKYXKupc6qb-n6fe_3k3QYOcfSeJ4h7r5nkI_BHtz3UjONK0MCMOZ_npQVp0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWX0kagwK9Hif2tcwqmN9WclHJTGqVFYsZdnAzWWpV9g&oe=6AC917BE"}, {"file_name": "06-welcome-centered-2560x1440.png", "id": "1068856906064419", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830904_1068856909397752_858119733054736554_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-8EUX5_wjwQ7kNvwHtng_m&_nc_oc=AdpMOolDDkfgfPmn-4xP4bXSAURgtMyjKzO4DIIhHNqcfe59pLcLuJ4dyGqSZwLHtFI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUNEF8K0UCaxkFpPxCvrJWD9iE2so_W-TsLyEIhf_Izg&oe=6AC8EBDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Screen Mirroring", "keywords": ["Mirroring", "Mac", "3D", "Cinema", "Streaming"], "long_description": "3D Screen Mirroring brings a new kind of Mac workspace to Meta Quest: real-time 3D depth streaming. Instead of sending a flat 2D image or relying on Side-by-Side or Top-and-Bottom video formats, 3D Screen Mirroring streams depth together with your Mac screen in real time. Your desktop, apps, browser windows, and video become a depth-aware spatial display with true dimensional viewing.\nCreate a large private virtual screen and place it comfortably in your space. Adjust screen size, curvature, layout, fit, aspect ratio, and render quality. Use the spatial Controls panel to tune display, ambient, and device settings. Responsive pointer feedback, focus states, and controller interaction make adjustments easy inside the headset.\nStart with the guided connection flow to pair with the 3D Screen Mirroring Mac app over your trusted local Wi\u2011Fi network. You can also explore the offline demo before pairing.\n3D Screen Mirroring is made for work, browsing, watching, and everyday desktop use\u2014bringing real-time depth-aware viewing to the screen you already use.", "short_description": "Turn your Mac display into a depth-aware spatial screen on Meta Quest with real-time 3D depth streaming\u2014not just Side-by-Side or Top-and-Bottom video."}]}, "developer_name": "3D Screen Mirroring", "developer_privacy_policy_url": "https://screenmirroring.kc-f90.workers.dev/privacy-policy", "developer_terms_of_service_url": "https://screenmirroring.kc-f90.workers.dev/terms-of-service", "publisher_name": "3D Screen Mirroring", "support_website_url": "https://screenmirroring.kc-f90.workers.dev/support", "website_url": "https://screenmirroring.kc-f90.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1373673849165878"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620414_1639769724184882_8406404529325083317_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zalCyRnCJN4Q7kNvwHYFJ3u&_nc_oc=AdpY0psstfhlMImLLeEbssvp8O-nX6vw9REO74i-kG7EqsN3H_GXTG063sc6hF8E3fs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW4mrngAy2YMvhdoVw0PGy1jrmvI2vjuJi9lrb2sAlfA&oe=6AC8FA62"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D Screen Mirroring", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "39322247850
b=1-7&_nc_sid=6e7a0a&_nc_ohc=L36EJauWNMsQ7kNvwGm-sLg&_nc_oc=AdpkeNqFgInwQICcth-F2dtIG02jYVA8v1bGGpQvYAdkibqXxuGOpu7MdYiJis2Tl8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2axcPGVR0FWXTdKFDJkIqPbopYccm9DRiXbfW6wg__g&oe=6AB3CB02"}, {"file_name": "com.mirrormac.quest-20260905-231514.png", "id": "1373386274986043", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620414_1373386278319376_696891017332174306_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMWFToPOplQQ7kNvwGltPn_&_nc_oc=AdqThH5kAOXWQFTmOb6sju4l0NB4U5r-Hx4uOXRkCz_Otz1BVyo4yciwU7v4SK2peyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrJ-iAoLapSfsbMjO9rPEq5Kafw-quyRyrm86792L2rw&oe=6AB3DC74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Screen Mirroring", "keywords": ["Mirroring", "Mac", "3D", "Cinema", "Streaming"], "long_description": "Give your Mac screen room to grow.\n3D Screen Mirroring brings your Mac display into an immersive viewing space on Meta Quest. Settle in front of a large curved virtual screen, enjoy supported stereoscopic 3D content, and surround your screen with colorful ambient effects.\nMake the experience yours:\n\u2022 Adjust screen size and curvature for comfortable viewing.\n\u2022 Choose screen layouts and fit options.\n\u2022 Customize ambient styles, glow strength, and shadows.\n\u2022 Use Quest controllers to adjust settings and recenter your view.\n\u2022 Connect over the same Wi-Fi network or through USB with ADB setup.\nStart the companion app on your Mac, connect your headset, and approve the pairing code on your Mac to begin sharing.\nA compatible Mac running the companion app is required. The Mac app includes a three-day free trial; continued mirroring requires a monthly or yearly subscription purchased separately through the Mac app. USB mode requires developer setup. Connection quality and performance depend on your Mac, headset, network, and selected streaming settings.", "short_description": "Bring your Mac screen into an immersive world on Meta Quest. Enjoy a large curved virtual screen, supported 3D content, and vivid ambient effects. Connect over Wi-Fi or USB and shape your viewing space. Requires the Mac companion app, with a subscription after its free trial."}]}, "developer_name": "3D Screen Mirroring", "developer_privacy_policy_url": "https://screenmirroring.kc-f90.workers.dev/privacy-policy", "developer_terms_of_service_url": "https://screenmirroring.kc-f90.workers.dev/terms-of-service", "publisher_name": "3D Screen Mirroring", "support_website_url": "https://screenmirroring.kc-f90.workers.dev/support", "website_url": "https://screenmirroring.kc-f90.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1350058431527420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620414_1639769724184882_8406404529325083317_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URCDHu_bTW0Q7kNvwGZucNw&_nc_oc=AdoytVPCZhE_wLs0TIga_QPmKsuuB6txB_iDxtOGyIWfKS1b5JRHPnvEqvV-PtYpljI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe2j2fTsYZFq5Ci4vTUQMASjT9zosnfjV-TKCYeKP4lQ&oe=6AB3E262"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D Screen Mirroring", "plat
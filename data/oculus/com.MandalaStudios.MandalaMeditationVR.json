.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience. \n\nWelcome to Mandala Meditation VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mandalameditationvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mandala Studios", "support_website_url": null, "website_url": "https://www.mandalameditationvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31424423457156641"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1001534619308754"}, {"status": "PUBLISHED", "id": "2180363259431752"}, {"status": "PUBLISHED", "id": "884644063974770"}, {"status": "PUBLISHED", "id": "678038952001141"}, {"status": "PUBLISHED", "id": "2185136298632952"}, {"status": "PUBLISHED", "id": "627813363207479"}, {"status": "PUBLISHED", "id": "2501657520185249"}]}, "baseline_offer": {"id": "2501657520185249"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1001534619308754"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31421783187420668", "version": "1.0.0"}, "id": "1682490362630226", "channel_name": "L
.com/v/t64.5771-25/499622211_1402177454913453_6992791561910384812_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khtDiyCm8xcQ7kNvwEbTUJf&_nc_oc=AdpaIs3Elc6VNpMEfg-vJZhDJUT2xnY2E7vyeUVXs3lChziq_ZODnzj_3_t_yd1rhog&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48OHNzn1kgknNLDWAs8lw8xKSwbQQAveCwiGQEO7QukA&oe=6A11CF6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage.png", "id": "2112469435910048", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819980_2112469439243381_7513880190047428542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYea6zSss5MQ7kNvwG-3eHw&_nc_oc=AdrLglRosiI-F33WZlcf3xcjU2fgkw8hv0jZ8QNvDoeqZf2qAE-G6HzSAWt-MSogrHQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_1WVY-SIdDOPN-ArvcFXbsMVyJi9RF-lP8-awkugN0g&oe=6A11BB28"}, "display_name": "Mandala Meditation VR", "keywords": ["Meditate", "Meditation", "Mindfullness", "guidedmeditation", "relax"], "long_description": "Mandala Meditation VR is a meditation app that combines the power of music, art and technology to create the most immersive meditation experiences.\n\u200d\nMMVR provides Zen meditation training and guided meditations to help you relax or improve focus.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience.\n\u200d\nWelcome to Mandala Meditation VR.\n", "short_description": "Mandala Meditation VR  provides Zen meditation training and guided meditations to help you relax or improve focus.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience. \n\nWelcome to Mandala Meditation VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mandalameditationvr.com/privacy
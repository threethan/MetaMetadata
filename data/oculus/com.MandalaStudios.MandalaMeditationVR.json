6992791561910384812_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X4lf19m7WYQ7kNvwHMz2Lq&_nc_oc=AdnIdhmXQQ6sG6NxvUbVbAC3OhVH5J1yNfdlw2c2sqYL8xnEUJROEAZ19B_e0vWRAEA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxA9LatpB1i47obirDQfO3SEn3Bg5B6IAr_Tnbif-f1zA&oe=69BD372B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage.png", "id": "2112469435910048", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819980_2112469439243381_7513880190047428542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6PCBSsbjk4Q7kNvwFPTpG-&_nc_oc=Adkj7hm-At45G_5q3cejZuu-pmjynhiLFloA1CvOh4fcSoq7CUfk64HSv-xb1eDLSSk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQMJUwNMsqG_8btlOuAxhQwPmPk6FlTRG-4O9nIPCvlw&oe=69BD5B28"}, "display_name": "Mandala Meditation VR", "keywords": ["Meditate", "Meditation", "Mindfullness", "guidedmeditation", "relax"], "long_description": "Mandala Meditation VR is a meditation app that combines the power of music, art and technology to create the most immersive meditation experiences.\n\u200d\nMMVR provides Zen meditation training and guided meditations to help you relax or improve focus.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience.\n\u200d\nWelcome to Mandala Meditation VR.\n", "short_description": "Mandala Meditation VR  provides Zen meditation training and guided meditations to help you relax or improve focus.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience. \n\nWelcome to Mandala Meditation VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mandalameditationvr.com/privacy-policy", "developer_terms_of_service_url": null, "pub
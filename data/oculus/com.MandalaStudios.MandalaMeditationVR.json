.com/v/t64.5771-25/499622211_1402177454913453_6992791561910384812_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2Ix85no-W4Q7kNvwErLQAC&_nc_oc=Adoyjb38wD8rCsT9RpDB1cEG6eVhruXt7l3dxVZ8UF2q_MNfY0Zih5_U5aYaB_2Zg3U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrqJ1obs3_L6dyjczyrTwKZyQdKy5yTOKBsWK0aBiF3A&oe=6AAEB1EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage.png", "id": "2112469435910048", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819980_2112469439243381_7513880190047428542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw-THeJDG5kQ7kNvwE6T0r2&_nc_oc=Adq2Dlo-gwy6-mGpdeP6GQRjUhkjGhcDJOAGbYYFMcLB5rdYPCsQ5wH-pOM66zSxF3M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYpgmUvt8D6noCBcTyklZb0Yuz0Lt1hgBzheQD8VXRTw&oe=6AAE9DA8"}, "display_name": "Mandala Meditation VR", "keywords": ["Meditate", "Meditation", "Mindfullness", "guidedmeditation", "relax"], "long_description": "Mandala Meditation VR is a meditation app that combines the power of music, art and technology to create the most immersive meditation experiences.\n\u200d\nMMVR provides Zen meditation training and guided meditations to help you relax or improve focus.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience.\n\u200d\nWelcome to Mandala Meditation VR.\n", "short_description": "Mandala Meditation VR  provides Zen meditation training and guided meditations to help you relax or improve focus.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience. \n\nWelcome to Mandala Meditation VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mandalameditationvr.com/privacy
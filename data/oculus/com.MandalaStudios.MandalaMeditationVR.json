6992791561910384812_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfpneMOp3UwQ7kNvwGabj69&_nc_oc=AdlftsVHYHlbScBt9pX4EDpWJWMp_CZNARaQequXAdzWUKbJOUOm6v4Drtbe1ZO66RU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6mfmhrOmeK29_YeQsrlS3rjYmQAJrT6SOEvaBJbGnkA&oe=69B0082B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage.png", "id": "2112469435910048", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819980_2112469439243381_7513880190047428542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fipgl-oE_NkQ7kNvwFtCDN0&_nc_oc=AdkjzJe8lUCMVdtoc43gI5PT45vIF6RLDntIgcxK5lZhdxDkkLx4fflU4Wef4uKDH18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYO3UR2CE0M8QEFenjav4SKPESgapJYtLJ6O_HZtLe5w&oe=69B02C28"}, "display_name": "Mandala Meditation VR", "keywords": ["Meditate", "Meditation", "Mindfullness", "guidedmeditation", "relax"], "long_description": "Mandala Meditation VR is a meditation app that combines the power of music, art and technology to create the most immersive meditation experiences.\n\u200d\nMMVR provides Zen meditation training and guided meditations to help you relax or improve focus.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience.\n\u200d\nWelcome to Mandala Meditation VR.\n", "short_description": "Mandala Meditation VR  provides Zen meditation training and guided meditations to help you relax or improve focus.\n\nMeditate in Virtual Environments or select a Mandala and give it the colors you want to focus on for your meditation.\n\nWe have something for any virtual reality enthusiast seeking a great meditation experience. \n\nWelcome to Mandala Meditation VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mandalameditationvr.com/privacy-policy", "developer_terms_of_service_url": null, "pub
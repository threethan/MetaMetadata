883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgXyaKwdjFMQ7kNvwHREQBz&_nc_oc=Adrtqv97E2bYR4Pm7THOVxFT45r5jBLeNihX_ivbR5j87vT7vZ61rpkPYwCRoz7QeSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtcGF7ZYCDi1qEpoIl175ol0Fc---uYuWiIjGq4N2CWQ&oe=6B033667"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e2NYa4huBcQ7kNvwHkD4J_&_nc_oc=AdrXmBdQmP4fPEYEAvXVQ-3m2-O56CYFOBd1H43v3M6DmEjOodi1ZllG0X5VmNAqqiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-4HkJgB1w83CMYKQ0f84PLqjW8ULkp4V4DiCkVPk6iA&oe=6B031DB6"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqSHEtuRbeMQ7kNvwG1zOvU&_nc_oc=AdpJkEuCfyADf2DfDG6oDuS1qPlc91fXzTfOlqFRVaUcXT7Bo9Tp9cnG3Zc6K6epZvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStyOVzOxGnpa_2ez6HBO4Y6AlNgpql1YHr-EG42nxliA&oe=6B03375A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4X9x4ic3TcQ7kNvwFJSmRy&_nc_oc=AdriX1TGSO8J_0ls5oyaWUPnsx6aahO06AaZ--nCj2f0VGKaPje9H45qgejKsG69FE4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV1gpvEo9Jnlc-a7MLPS_v2Wa0LGWUQYk5bXOg-11kYQ&oe=6B0319A0"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-2e188fdffa638148ac43f9a049db5e38", "developer_terms_of_service_url": null, "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G04X3ZbWO80Q7kNvwEwdg-K&_nc_oc=AdoeeU0x2G9qsyTxcG5VwiCcEpfLKNdP_NwdxhUwO3PKwQ26Ip5Dp8jMy6UdBVdnVBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF7hZKhr2lZhgBwcbZYeyyxMHY-4JL_d3lWjOySmLTfQ&oe=6AFC66A7"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHAzpqTAWJoQ7kNvwE4RArm&_nc_oc=AdqoitoHzgzMePKOpT2Z7q8wkIqhz8sYTA67RdrJHVvDTCf87IeUD0RL0EOuMPw2quU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu7Kf5CgtDyW2nYjgE-WmSYuw_1qEDfbMJPuIEN1cRWQ&oe=6AFC8636"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zDnGM6MdDkQ7kNvwEAlPnr&_nc_oc=AdruoUbyOmrlZBEpKABz5jhP7hClR7MZSJgzJhQU1Mww_HT9Bzahc1pbcSdn8HufwXE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYJByCfd1zrPSwZKOlf_P57BTHR4K1fDXRAnYj4QnnFw&oe=6AFC679A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F69lwPCegwgQ7kNvwFEwsKv&_nc_oc=AdoaSexdECXohPUbM4V6OZrOubD4rPTt8nlFcwg_v0G72HXBMZIEtSV7IB9CpiDaXMM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb8koh4zrPmwtmZitgccbBswWxbV4Du1N5sdHl6Vnd4g&oe=6AFC8220"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-2e188fdffa638148ac43f9a049db5e38", "developer_terms_of_service_url": null, "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID-r3HfXBE0Q7kNvwHlT8x0&_nc_oc=Adq87s9ArdGt712ELPbKAQAElVMI6Rf44MQoqUhhNtz7XYL8_44WYshQ1n48NXMzTWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQasU_DncZR29WkhyXxLOg6bPR6_3DPXaGt6o_MYg_XUA&oe=6B0DC267"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L4MHard_bQQ7kNvwGNI4Ux&_nc_oc=AdprKqBwBCOch9d0h8sOpU2mCHS_5--ErQhmQhScKSaws0tHt8LYoc4SB3cHOzjpkxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFr8fORaXiplTf9JfdQYw2V81mGgWs-LH-IVE2y6HbjQ&oe=6B0DA9B6"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eumyDapnweMQ7kNvwHH6_b3&_nc_oc=Ado_lSV1Z7Y13sXAIwktiSpcFAE3T-pLRaGBtYraOKoP_pAgi0nlfborLnP-eMAI3iM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGzVPd-Wwf717d7NtrWuDpoYV_DbQ6NA0S9lqITjgmXA&oe=6B0DC35A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-Vo0X_OEy8Q7kNvwFk7B8U&_nc_oc=AdoiBYby7KE0eOcXe_8hvRLQC3pjgCYZI6olo2RqjyWnUfjG5tj_q8qi2MGaE9Jd4wo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJsrBQ7oU1KZz-rzGVEMfIsyXGE1DOKJ3CTw-xuiOHtw&oe=6B0DA5A0"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-2e188fdffa638148ac43f9a049db5e38", "developer_terms_of_service_url": null, "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
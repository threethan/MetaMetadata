747641896174207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWsbCIbcixAQ7kNvwGZFz5a&_nc_oc=AdqTq3IZg0Vog4QKxM7NbXlDi90SoJMlhTyrA2Mvb7_brDdVpsENLpThiH1373tPIKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLo09s0FlQS4EG-b0ncCwPWgOt_Bh8CMAbX_n5FGM5Dg&oe=6ABA62F6"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQgYn37TMiQQ7kNvwGtU3nv&_nc_oc=AdqD6HhyktQpgo8vjacOSgRa4CFJNW0d31K3ltlVMrm4hO3JmjwBEj2zkol9ydRRw6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRdh-TlII_0c9Ebn99VgsNQevwMg0czkqtHx7quX-8ig&oe=6ABA7C9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79fScmp8VNsQ7kNvwGp-Bvd&_nc_oc=Adogilla6iMktM8C5fFK4FkkanE-E6dm2PC7-uxdzzZtkb_vj3XERd063aTrVsbXlU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCDclJo__RKYfri-xYEwKluuYeaQlCtFfy3fX5Qxp6Bg&oe=6ABA5EE0"}, "display_name": "Warp VR", "keywords": [], "long_description": "Warp Industries offers VR Training solutions to create and manage immersive, high realistic scenarios for your employees. Think about safety & security training. Or retail, leadership or medical training courses. Even on-boarding or assessment can be done better through Virtual Reality.\n\nResearch has shown that learning with VR has an increase of 30% in remembering procedures. By using VR you are truly somewhere else. You are immersively trained without being distracted. \n\nUse this app in combination with our online portal to create your own scenarios. Decide who can play these scenarios and get in-depth analytics about what they do.\n\nLet us be the heart and mind of your training operation. Interested, contact us at hello@warp.industries", "short_description": "Warp Industries offers VR Training solutions to create and manage immersive, high realistic scenarios for your employees. Think about safety & security training. Or retail, leadership or medical training courses. Even on-boarding or assessment can be done better through Virtual Reality. Use this app in combination with our online portal to create your own scenarios. Decide who can play these scenarios and get in-depth analytics about what they do. Interested, contact us at hello@warp.industries"}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.warp.studio/en/article/privacy-policy-8vgs9l/", "developer_terms_of_service_url": "https://help.warp.studio/en/article/terms-of-use-1tdjl6l/", "publisher_name": "Warp VR", "support_website_url": null, "website_url": "http://warp.studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "657695338883692"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "977456691188642"}, {"status": "PUBLISHED", "id": "589705139060334"}]}, "baseline_offer": {"id": "977456691188642"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742228040, "status": "PUBLISHED", "id": "977456691188642"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38303764782600165", "version": "5.0.10"}, "id": "436512130738157", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5018733758196696", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38303764782600165"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790199118, "id": "38525937457049562", "version": "5.1.0", "version_code": 2300, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5018733758196696", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38303764782600165"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "436512130738157"}]}, "change_log": "- Playthroughs recorded while offline are all delivered, not just the first one. A queued playthrough whose saved sign-in had expired could not renew it and was left behind; the renewal now works and is shared with every other playthrough waiting on the same sign-in, so a session played out of coverage arrives complete once the device is back online.\n- A playthrough that genuinely cannot be delivered is now reported instead of disappearing quietly. Delivery keeps retrying through network trouble and only gives up when the backend actually rejects the sign-in.\n- Shared devices: hand the device to the next person straight from the home screen. The banner now offers \"Switch user\", and the same option replaces \"Sign out\" in Settings, without a confirmation step that only got in the way.\n- Fixed a case where signing out could be interrupted halfway and leave the app in a half-signed-out state.\n- A quick click in VR no longer leaves an element stuck to the controller. Clicking faster than a single frame left the drag glued on until the next click released it.\n- Remote sessions end when the scenario ends. Leaving a scenario without passing through the score panel - a trainer starting another scenario remotely, for instance - used to leave the device streaming indefinitely, with one recording swallowing several scenarios and the interrupted playthrough never recorded.\n- Remote streaming recovers on its own after the headset sleeps, and keeps the same session. The stream is rebuilt inside the live session rather than the session being replaced, so the trainer's view reconnects to the device they were already watching. Recovery is now confirmed by real video output before it is treated as done.\n- A playthrough interrupted by the headset sleeping still links to its cloud recording. The recording that covers the start of the scenario is reported with the attempt even when the streaming SDK loses track of it on the way back from standby.\n- The dashboard shows a device's live status more reliably. The app now tells the backend directly when a stream starts and stops, instead of that only arriving through the streaming provider, so a device no longer shows the wrong state when one of those messages is delayed or lost.\n- A scenario that needs a newer version of the app is no longer downloaded or played. It is shown with an explanation instead, rather than being rendered with the parts this version does not understand quietly missing or in the wrong place.\n- A long session no longer ends with the app closing itself. Each time a headset slept and woke during a scenario, the memory the video was using was held on to rather than released, and after enough interruptions the system shut the app down and returned the user to the headset's home screen. Video is now decoded in a way that does not accumulate, so a scenario can be interrupted and picked up again as many times as needed.\n- On a shared device, the list you pick your name from shows names only. Email addresses are no longer displayed, so a device passed around a room does not put them in front of everyone. An account with no name still shows its address, so nobody loses their place in the list.\n- Updated the remote streaming SDK (BeamXR 1.9.4 / Enterprise 0.9.2).", "created_date": 1789468723, "id": "38303764782600165", "version": "5.0.10", "version_code": 2284, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5018733758196696", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38303764782600165"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789384007, "id": "38275654238744553", "version": "5.0.10", "version_code": 2282, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5018733758196696", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38303764782600165"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789063835, "id": "38179675171675794", "version": "5.0.10", "version_code": 2269, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5018733758196696", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38303764782600165"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788809672, "id": "38104717192504926", "version": "5.0.10", "version_code": 2267, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
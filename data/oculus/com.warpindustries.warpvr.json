OmTyHoxRvzqaCCH3QTA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUon1yUBJebVlLrgiIjATOKJjwifrRGrba-L-TI-iLJw&oe=69BE992D"}, {"file_name": "sc3.png", "id": "1097983747342241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el9csyc-1acQ7kNvwEC9Cya&_nc_oc=Adlzu6YXgW0LptDo07t-9kVjWRutthilCQY65o8RiDpzmglb-zJeZW7CaIpS26ssZ0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvKKgWMUKJJbycr7iZGpHzIyXlT5t02OMrcFcjBHm_5A&oe=69BE74E7"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f57EG5TjKjoQ7kNvwFhj7-m&_nc_oc=Adk3Nf5hj0hdU2v6Q1ukEQ1I3hIJxju6pya7hmTUp8PuwZ-6ahAjIKZcsfsz0qbg33Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz68wbW0XuI1tFtN2E_otRkamo0GB9gsz7yvKbLOZGCyQ&oe=69BE9476"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLR9dhUxG0QQ7kNvwEtzmpi&_nc_oc=Adk6of2tWCZKDQg1JccUgfBibAQiopKhsZHoJynHmPegFw9nmWITP2UyjTH1tqEAQnk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzT8GwBmtD8gbLHYaTgwWf5CDstbca3pYjtzDUuwuRhMQ&oe=69BE75DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLHcL7QsuZ8Q7kNvwEF0STh&_nc_oc=AdnHQs17p4vf8p9y1qK6lJtCaDbV6uJf1f5H8F4XXDScqRZ14HFygdIRTzFqKfajG4w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBi9PqtBrV_bHdZWZS84uD2nFuM7lLxJYqfxVAmLINlQ&oe=69BE9060"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-22020e41522a481e952859716d482225", "developer_terms_of_service_url": "https://legal.warpvr.com/Terms-of-use-8830ee461a4949dfaa17de040b75773d", "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"
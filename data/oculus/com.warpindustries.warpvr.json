pv11gUxK4TSB0e5la-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzx79tCSEsBsID92f8vQY_q7S-rR0UbFi4iaK0d0h6IxQ&oe=69BD47AD"}, {"file_name": "sc3.png", "id": "1097983747342241", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el9csyc-1acQ7kNvwEpiIXj&_nc_oc=AdlbFb1PEWb44ARZTPIDok35BODDJg39cy73qrqzlW4B9S0tUld-W-DkPgdcpT00DEY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQ8j9Q3QidZs4d0jjPiUbq9v-ySa_hae3i3643-3ryng&oe=69BD5BA7"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f57EG5TjKjoQ7kNvwEcPMBH&_nc_oc=Adl95mScHRlD0lwWGDPUrB7wv-Om89sd1cxtwiM_h7tnvaENzquEIYqpJ_IlJUkX3iM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxxdw4PpDuuKoKxPXtGfaVBTGDUYJPBaeZld1CS1zPmxw&oe=69BD42F6"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLR9dhUxG0QQ7kNvwGv9sCo&_nc_oc=AdmATbi_2m2_Rn63X7UiU7vCJZ3F39wku-0J25b828aQSoEtgv1KUxm2-H1LC0RFmNs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3S4IutlSWFEKrCudjboUpMUa4UG0BpWkRkDVOMMSUuw&oe=69BD5C9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLHcL7QsuZ8Q7kNvwGQxvaw&_nc_oc=Admm8MiKwffUtljrs95KQ01jYe9UdpDBQZgc7xEelUOJGeTED_ZFzTOGnQaHRmru8d8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3xMldR-mOhBwMQCBjcEgdEZvjpwBa-KXuln0U3b1VwA&oe=69BD3EE0"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-22020e41522a481e952859716d482225", "developer_terms_of_service_url": "https://legal.warpvr.com/Terms-of-use-8830ee461a4949dfaa17de040b75773d", "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"
883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2Gspm5r0osQ7kNvwG5ujKA&_nc_oc=AdoqPTHdDGt3d-2T3v-MovAgiaXA6bl5DjT74k0CqwEy0-6RuJ-s-aT3SqVytYEV8Po&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoYu47ZO3I0rOb7ad9DJXU6LEfUO7rg-SuwxaV5Xq9mQ&oe=6B084427"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh7jD733xuIQ7kNvwEvqKFz&_nc_oc=AdrpTIy4Ku6lZhiq68aKRxRVkpvLC5IikQZXmuKei9jMij00odYJc00ELO7shW4fOLM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReCTl_s-nXfYnN8RwigvBQgdwWAJNjndMiJzDNU48Yiw&oe=6B0863B6"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kc8AqTQ1ylAQ7kNvwGcFG6C&_nc_oc=AdodQKmpoOi7ocfsz6SL2_AVGQ1wlbfMcoqnOK3fKGZAw15rP61h3Oc9DFWUYG1_M9U&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyMkM-XWTHvWMflMY5qgW5zsdOeyKuIrLUi2YQIl8E5g&oe=6B08451A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSZa00xnGkQQ7kNvwEOyOUc&_nc_oc=AdovNC5VE1oaLoB7CKlXFV-ikB8m2XdUm0b6LOJEtA-XDyzct33GSsT5XsYx3OX8cSw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNAQ8z-raWA3Pm0iTlfPJDsXMCtfr3vePbN1DgHMidrA&oe=6B085FA0"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-2e188fdffa638148ac43f9a049db5e38", "developer_terms_of_service_url": null, "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
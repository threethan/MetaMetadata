747641896174207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfwVOG0uW-8Q7kNvwGXIGir&_nc_oc=Adpwul92rHrbbZ2S0MYzUB0pyI1XtyY0GT7of8-NUwLO9k83JqPvKghpAPv4MdpiNDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL5G8gBvCmSXHag4puT4w72S1YeMmfORpKNDSEZohOrA&oe=6A5CC876"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq-xkz1escYQ7kNvwHhYdg7&_nc_oc=AdoZPlIiKmKrZrDLCWIxMTqTV1MaOuL7JvbpmWOdM8uv49jU1z7clLLTZirxgP2xSwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_wTdMJsKQ4zf2KjL292cxgnTiDV6GP29XvUO2gBh77g&oe=6A5CE21A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QziQkHOep70Q7kNvwEwqDyk&_nc_oc=Ado1T03ODMGVpo0z9zm-ne-uNM-y5O6AcdnDL3Wu9owjyEPZWsKjeGqjHWvsF6xnjXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoN2PBHzIFceo9X-_LhcaEyBH8M5LdcFNWnzkgvPn8Hg&oe=6A5CC460"}, "display_name": "Warp VR", "keywords": [], "long_description": "Warp Industries offers VR Training solutions to create and manage immersive, high realistic scenarios for your employees. Think about safety & security training. Or retail, leadership or medical training courses. Even on-boarding or assessment can be done better through Virtual Reality.\n\nResearch has shown that learning with VR has an increase of 30% in remembering procedures. By using VR you are truly somewhere else. You are immersively trained without being distracted. \n\nUse this app in combination with our online portal to create your own scenarios. Decide who can play these scenarios and get in-depth analytics about what they do.\n\nLet us be the heart and mind of your training operation. Interested, contact us at hello@warp.industries", "short_description": "Warp Industries offers VR Training solutions to create and manage immersive, high realistic scenarios for your employees. Think about safety & security training. Or retail, leadership or medical training courses. Even on-boarding or assessment can be done better through Virtual Reality. Use this app in combination with our online portal to create your own scenarios. Decide who can play these scenarios and get in-depth analytics about what they do. Interested, contact us at hello@warp.industries"}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.warp.studio/en/article/privacy-policy-8vgs9l/", "developer_terms_of_service_url": "https://help.warp.studio/en/article/terms-of-use-1tdjl6l/", "publisher_name": "Warp VR", "support_website_url": null, "website_url": "http://warp.studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "657695338883692"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "977456691188642"}, {"status": "PUBLISHED", "id": "589705139060334"}]}, "baseline_offer": {"id": "977456691188642"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742228040, "status": "PUBLISHED", "id": "977456691188642"}]}, "liveCh
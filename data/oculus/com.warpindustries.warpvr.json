883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2Gspm5r0osQ7kNvwGU2Ko1&_nc_oc=Adp_SOToLR_KBE7ZvNkUfeM5BjP_9qmXHMP9JrbCfB_gS5SX9i2-CArosGC6ynR1ta8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK7nfL-CNusaMMgp_zcTQ1piqSFFpzLuvwTdylymN3FA&oe=6B09CDE7"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh7jD733xuIQ7kNvwHsiiw6&_nc_oc=AdpkjLnVl6Db-gmomSeU8r2Q2jr2P2zOSuMmSMe9lNvJBgMFMut4hC5zx5nCxacVTNU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO4US3dFvJyTGNw4T5-_1bn9lIrpJkuMfAOUa4_EUpIw&oe=6B09B536"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzEsWbNsPIQQ7kNvwF34mOd&_nc_oc=AdrIySZnyyN1iDYrMApoqzRYdBe4w2jy2YfIcmv0B4_tOcBH1TTx5Nnah7NdTd26sUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8xnLeEjwCykcyYulPoMY8sk2aHoHch2W3Te6j60Bpjg&oe=6B09CEDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSZa00xnGkQQ7kNvwFJv08A&_nc_oc=Ado2EEE4f2_JQlAec6Osvjsa0tNGc-66Eu-dt_zXavNjDCg5Dt97-fdWxoF9OQ4lrkI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEaRbyYaUuLgo9nqnHPXR7cQ7ZJyL8_f4-yq0mrO5TOw&oe=6B09B120"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-2e188fdffa638148ac43f9a049db5e38", "developer_terms_of_service_url": null, "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
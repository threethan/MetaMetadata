6mAN8wLwa8k1dFmFKDE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6nj7VcnvjefzRKhld1aZR1jEqAgQfu1bnpyq1l0xBqQ&oe=69B6B02D"}, {"file_name": "sc3.png", "id": "1097983747342241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxnFiOMW4XYQ7kNvwF6DdRC&_nc_oc=Adl95Gepu3UD8Pe2CCejFlNGA3mY-ancTanDO7VdlAj64iXr8S79-7ou9HjnUyf05u8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSKrmmSzMwrI8gUTbKFlDu2LY8BYbisi_V-8kUmg-liQ&oe=69B68BE7"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atgBgjsCGwkQ7kNvwFM1T56&_nc_oc=Admwr8f1R4z9LGLhrF0IgfPmEZja7xwTYMGG-C4N4TPdxEmj0B_To-HZFt-FOxHnEAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_TsUF0q-H3_cjmU33s3WXzuE6FZx95E_puZuh56vygA&oe=69B6AB76"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrCpzxO90dkQ7kNvwFxE6ih&_nc_oc=AdkbRkX-Dcr4D7x2IRL3IZJRYsITPgRC_oifT70i77BPF3TTpgSEnizG8u1vdnFkz6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHsAqRYUSaHui61798oHKWXqC_x13nFF4JWu_10-CLeQ&oe=69B68CDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxUTZaD_hdMQ7kNvwEYwF8r&_nc_oc=Adm6k_F1i044Rf37aKsQkLvBYiSOG8Pq5gu9mxKwO4GdJx2xGDG_W-V57xZ3P3JifuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmL0x1FJbBfzoD4MQgrLFWCzwzPCPTQnxX18HVIjZgPA&oe=69B6A760"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-22020e41522a481e952859716d482225", "developer_terms_of_service_url": "https://legal.warpvr.com/Terms-of-use-8830ee461a4949dfaa17de040b75773d", "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"
883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgXyaKwdjFMQ7kNvwGzTZ2c&_nc_oc=Adr4RACkW3cH8oekzRNv293QRWZ3f80LVArx6IaLHvL2FjULaNVyT9A4r0swwjchWyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsbyzyR6dU3okH76bCgvFWotOVQayJMDEhZVI2Ijlpjw&oe=6B005B27"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e2NYa4huBcQ7kNvwEJQjDt&_nc_oc=Adrl3sav5ozSJsX4WA8RZ455R9ZT764skpmdq05UTx67kX5___SBBUic6rYhtbVW4Bo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvbFEpdR7jtysInSu8xxUSpXFW6F6T5eEtiVBIGCTrOQ&oe=6B007AB6"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxuvXwIo1XYQ7kNvwFXZHjI&_nc_oc=Adp5NM5ZhgYteiwRlmRkZKK5EZv_n5AOlrfUUe8wx8Kx1fxjbQXV8Yp0ilsq_CUBP_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZotg3VgwbuxUG-1IyET-cFWYlAQlC_yNbwlFzFKyc9w&oe=6B005C1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3QFAW_8FH0Q7kNvwEBZ2co&_nc_oc=AdrzlOaXN8HMqUzalLxbclm3gGpCYAFKPGI6VEd6rEf9lZ5AKbvbjkj61H6-k5kLb-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBURkbn40vAN7MSL6F-Sg0o5rHPR0teV-4QvXK6XTbZw&oe=6B0076A0"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-2e188fdffa638148ac43f9a049db5e38", "developer_terms_of_service_url": null, "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
btYwMbfq8Jt2okf2Gi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUC42E7lNpJbZuj2WnHxY49sriVKSns3WPc0hc--IpFA&oe=69B55EAD"}, {"file_name": "sc3.png", "id": "1097983747342241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxnFiOMW4XYQ7kNvwEL41_w&_nc_oc=AdnXmrpx4MDcE8Xtz7B0mjZzANEbolOB1sI03_ZNe8KG3y9RdAcPIk0d20BjQ9q0FPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOlzvOgB8UCrj7FmgGCK4UEVwYGeMT1mMkwvHUaqpiCg&oe=69B53A67"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atgBgjsCGwkQ7kNvwFtZgBZ&_nc_oc=Adn6c5LEmn6RVqDJWvdXcjP2KX2s5QPnON8rSKpBuT6-zOex3LslcJnruHWoO4-pcR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmxnY3dIuv9oS5U3vwc8yod_X4KjpX0bHkkDKN4Tg7KA&oe=69B559F6"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrCpzxO90dkQ7kNvwHUmh9p&_nc_oc=AdlSaE5GLNQ0whAaWY5JoD2ykYflguG1EMyAqUKFzaaW4B6NizJYSUrr4cnxikNb3g4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwixekJRW3TFvUGp6JndTSCZ2cF8qRQkejVyJnGJVl6nw&oe=69B53B5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxUTZaD_hdMQ7kNvwFdDH7i&_nc_oc=AdkKeMJY5-p872CxZClYQX8HbjYP1TjZMCimsQo4CIm_sPR-2viMDeYUygDpCiH2UAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcRR3d6pVe0jV6gURZ0EOP0ndb7qKQZz4J6G8kBvAZUQ&oe=69B555E0"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-22020e41522a481e952859716d482225", "developer_terms_of_service_url": "https://legal.warpvr.com/Terms-of-use-8830ee461a4949dfaa17de040b75773d", "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"
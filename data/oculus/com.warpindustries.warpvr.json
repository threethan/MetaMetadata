883_1097983754008907_9029817719125897725_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID-r3HfXBE0Q7kNvwF_osRN&_nc_oc=AdqsKeMmL9xnGfsZZM9hqK_o8WIUv8Y1d1-EdkvJAe0N9LWcvWIlHw32Fpt7kAfHnT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPDHbaxPCY-uC04fiYvzAKozV7owa9UhHaZjqv332l_Q&oe=6B0C70E7"}, {"file_name": "sc4.png", "id": "747641896174207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_747641899507540_4301769510161663198_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L4MHard_bQQ7kNvwFSTGHF&_nc_oc=AdrzlCZOCIwyO14oE2CAQONmKd_nEg-IxOhMMIwLrT4MQmXPvECY8sbfvVkKtoZoVww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCj13himwGY-2Gdp4GxXQtN6G2u2gG16mjseuh1TdRXw&oe=6B0C5836"}, {"file_name": "sc5.png", "id": "469820297718820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65395359_469820301052153_7491301726217580633_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzEsWbNsPIQQ7kNvwHFEBta&_nc_oc=AdpMWu9NKtNxP1gxnTfBkWhflL79Eflj6Xg45zo1mJeyOPUsBzCVD-GhgxFBNx64LrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpQZ8n28z8kH0owAQNCqBtF2DWH1cr0yaxzybPw0GKAg&oe=6B0C71DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "425893621978990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_425893625312323_4596875059613009093_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-Vo0X_OEy8Q7kNvwESCKzt&_nc_oc=Ado4REXdwK7e_9a-iAaPeCl8RXTZkHUmdIj7xdU_gZ90AW4ehdkv-XqYop0ctUNF4lc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRz64NveE7CPZMg9PENl2p1AxWO18UYY1byQtjmVLBFrA&oe=6B0C5420"}, "display_name": "Warp VR", "keywords": ["warpvr", "training", "education", "immersive", "learning"], "long_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nBecause of the user-friendly UX and attractive design, Warp VR is simple to use for both creators and learners. The LMS integration allows for realistic immersive learning to be combined with other learning methods. For who needs additional support, Warp VR provides outstanding services such as content creation and workshops.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement.", "short_description": "Warp VR is the easiest and most powerful way to create and scale interactive story-based VR training & onboarding scenarios for enterprise, training agencies and education.\n\nCompanies like ASML, Erste Bank, KLM, Shell, and Tata Steel use Warp VR to train their workforce in safety, security and soft skills in a realistic and personalized way \u2014 showing results like a 75% increase in learning quality and retention, a 40% reduction in training time, and a 70% performance improvement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://legal.warpvr.com/Privacy-policy-2e188fdffa638148ac43f9a049db5e38", "developer_terms_of_service_url": null, "publisher_name": "Warp VR", "support_website_url": null, "website_url": "https://www.warpvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
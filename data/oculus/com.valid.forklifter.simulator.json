 and transport cargo\n- Smooth and optimized performance", "short_description": "Experience realistic forklift driving in VR with ForklifterX. Operate modern forklifts, lift and transport cargo, and complete warehouse-style tasks in immersive first-person gameplay. Designed for smooth controls and realistic movement, ForklifterX delivers a focused forklift simulation optimized."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33644439078534950"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "881368991620787"}, {"status": "PUBLISHED", "id": "35328063750125843"}, {"status": "PUBLISHED", "id": "1690530951913392"}, {"status": "PUBLISHED", "id": "904965675390151"}]}, "baseline_offer": {"id": "904965675390151"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "881368991620787"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33561190503526475", "version": "4.0.1"}, "id": "874000738705211", "channel_name": 
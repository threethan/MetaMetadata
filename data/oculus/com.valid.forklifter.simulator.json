", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_868555599358697_2823203752858273891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8gufhx21Z0Q7kNvwFefnwc&_nc_oc=AdrScTgJfQ78dCQI__G5BBzrEle8Z0RfGwBnZyRvftp0fjVIzRcVbMB-1B1iwAvQoL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i1gMgbhWmzQ7I1vTcgF4ibxs3-i-yG56iihTVWImpVg&oe=6A086BF3"}, {"file_name": "Screenshot 2025-12-31 071819.png", "id": "1948845539046876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1948845542380209_8875716005337266081_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTeFqhHx-1cQ7kNvwHr3RkJ&_nc_oc=Adr0G55zLFRcLYL0xj4w2_2wIljzx7uHB6GJthwKp3X96si3dfgBo8k1WfO1b1YphPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x3BJzLyARit9Lo4KQ-sOjz1Ojm6z8wfhthdGd1CTmuQ&oe=6A086808"}, {"file_name": "Screenshot 2025-12-31 071638.png", "id": "917913100655557", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827601_917913103988890_8922600367011226798_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS9DmUmYdrUQ7kNvwFda5Sa&_nc_oc=Adrq0Fk2uJCXK31I-el0h3W8klFkGLVWRNFXQVoJpySoiTm5ZhH0i685QS9aphKAd5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uObf8dzvK31VHUh0JqulHvHiwOOrD7Mt-IIsxhar0zA&oe=6A087022"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ForklifterX - Forklifter Simulator", "keywords": ["forklifter", "transport", "car", "simulator", "driving"], "long_description": "ForklifterX \u2013 Forklifter Simulator is a realistic VR forklift driving simulation designed for Meta Quest.\nTake control of modern forklifts and perform precise loading, lifting, and transport tasks inside detailed warehouse environments.\n\nThe game focuses on smooth controls, realistic movement, and immersive first-person gameplay. Players must carefully balance loads, navigate tight spaces, and complete missions efficiently without damaging cargo.\n\nForklifterX delivers a clean, professional simulation experience with no distractions, making it ideal for players who enjoy driving, logistics, and industrial simulation games in VR.\n\nKey Features\n- Realistic forklift driving and lifting mechanics\n- Intuitive controller-based controls\n- Multiple warehouse-style environments\n- Load, lift, stack, and transport cargo\n- Smooth and optimized performance", "short_description": "Experience realistic forklift driving in VR with ForklifterX. Operate modern forklifts, lift and transport cargo, and complete warehouse-style tasks in immersive first-person gameplay. Designed for smooth controls and realistic movement, ForklifterX delivers a focused forklift simulation optimized."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33644439078534950"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "881368991620787"}, {"status": "PUBLISHED", "id": "35328063750125843"}, {"status": "PUBLISHED", "id": "1690530951913392"}, {"status": "PUBLISHED", "id": "904965675390151"}]}, "baseline_offer": {"id": "904965675390151"}, "is_approved": true,
jwnEYfoQ1FwEjZEHp_1v22IgSEZQgw&oe=6AFB15E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple File Manager: Explorer", "keywords": [], "long_description": "Simple File Manager VR gives you full control over your Quest storage.\n\n\u2022 Browse the whole device: documents, photos, videos, downloads\n\u2022 Copy, cut, paste & move files between folders with multi-select\n\u2022 Rename in bulk with patterns (batch rename), create folders & notes\n\u2022 Organize with tags, favorites, recent files and operation history\n\u2022 Deep search with type filters and sort by name, size, date, type\n\u2022 Unzip ZIP, JAR, TAR, TAR.GZ archives and create ZIP of your files\n\u2022 Trash with restore - no accidental data loss\n\u2022 Grid or list view, light/dark theme, hidden files toggle\n\u2022 Full keyboard & controller support\n\nNo ads, no accounts, no cloud - everything runs on-device.", "short_description": "Fast, ad-free file explorer for Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/file-manager-privacy-policy/9dbd0b5b-b499-4e0b-9642-66e8e86894a4/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/file-manager-terms-of-use/f98de3e6-a2a4-4283-a5ff-6ea97be6bc37/terms", "publisher_name": "Savva", "support_website_url": null, "website_url": "https://linktr.ee/filemanager", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_mo
 cloud - everything runs on-device.", "short_description": "Fast, ad-free file explorer for Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/file-manager-privacy-policy/9dbd0b5b-b499-4e0b-9642-66e8e86894a4/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/file-manager-terms-of-use/f98de3e6-a2a4-4283-a5ff-6ea97be6bc37/terms", "publisher_name": "Savva", "support_website_url": null, "website_url": "https://linktr.ee/filemanager", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1510400288815021"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1107830412161693_9210739503894455273_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xogFbsyQh0Q7kNvwGZbp4T&_nc_oc=AdrVA4Il__0mGNHSZZJSMk-G3Rqs6tyuQPvAjvUZxqlx-_wW7wtXK-vZgqrXetc78T8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTIKY6W5AJt2mRKzINPtCVHkHuLzRStnCqyM85shqgCw&oe=6B0EF76F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Simple File Manager: Explorer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilit
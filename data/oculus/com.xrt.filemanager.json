nD&_nc_oc=AdoWQKKi6IZq4fDsX82k3-JSGTkIXRw5-m7rlrxThE7uVdBkQVKMSAtafZxL9I80tDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQPSS6xiaBbLdfzprDRGFV_o4j6Xg8dh6G4RVJt_ESyg&oe=6B0DC3BA"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1390734703047874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_1390734709714540_2758378154690641714_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3PfUlNsBDYQ7kNvwGyotw4&_nc_oc=Adr6epedN9dXYibKKIMN1vv10L-83XL-gpkaojHWmwPtodFWVbtoBhsjxQBUwAQfFQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQI0KUu1Cp1gIizQm5U_Rkv0_oUgIyiNOup5BZddEuGQA&oe=6B0DB82E"}, {"file_name": "screenshot_5_2560x1440.png", "id": "2335684513889128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_2335684517222461_4849364182388212450_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvMgeFR75hoQ7kNvwEYo58b&_nc_oc=Adp7SBi5k6p-Xd9w4WkDCqdQzvJCSyKRix4RM2MmDDJaftAQ8igTdt5pyUrJtATH8O8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPCdoC3B7sTnqTRjJtpL6jGpf_VXivbqgUKXHwQw1w7Q&oe=6B0DC320"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simple File Manager: Explorer", "keywords": [], "long_description": "Simple File Manager VR gives you full control over your Quest storage.\n\n\u2022 Browse the whole device: documents, photos, videos, downloads\n\u2022 Copy, cut, paste & move files between folders with multi-select\n\u2022 Rename in bulk with patterns (batch rename), create folders & notes\n\u2022 Organize with tags, favorites, recent files and operation history\n\u2022 Deep search with type filters and sort by name, size, date, type\n\u2022 Unzip ZIP, JAR, TAR, TAR.GZ archives and create ZIP of your files\n\u2022 Trash with restore - no accidental data loss\n\u2022 Grid or list view, light/dark theme, hidden files toggle\n\u2022 Full keyboard & controller support\n\nNo ads, no accounts, no cloud - everything runs on-device.", "short_description": "Fast, ad-free file explorer for Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/file-manager-privacy-policy/9dbd0b5b-b499-4e0b-9642-66e8e86894a4/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/file-manager-terms-of-use/f98de3e6-a2a4-4283-a5ff-6ea97be6bc37/terms", "publisher_name": "Savva", "support_website_url": null, "website_url": "https://linktr.ee/filemanager", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1439685822553135"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2196623624283353"}]}, "baseline_offer": {"id": "2196623624283353"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793466000, "status": "PUBLISHED", "id": "2196623624283353"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1465174133337637", "version": "1.0"}, "id": "915727428053407", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1415470564974661", "is_concept": false, "latest_released_
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iFNisAScT4Q7kNvwGWv7gc&_nc_oc=Adpo6T4s3hQ03nwE1yU57LZKfhSjGm9W5TElWFof4wyxW9xwAFGKnU2CZide09GA6UI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqQQUQHm5EUv2ZqnuRTP-krAw4OJls5LHpoY0y1Cxb6A&oe=6AA00487"}, {"file_name": "05_RIO_Screenshot_2560x1440_Catapult.png", "id": "4189778528001443", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_4189778531334776_291520407755447717_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrmdWgZujd0Q7kNvwGEtZWq&_nc_oc=Ado8pjDLcfkqTaQm2HByCeVKYLIMvgNsVCilNtDIl4siMDLtKWjY4FNCFJDEthYMYg0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf86OIYZVRftG3Zvr2LRMe91ZLIBfwlaAxD_fEr4xRBA&oe=6AA01730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OMG_Meta-Store-16x9_LandscapeCover.png", "id": "4269655196684768", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824328_4269655200018101_9081034574483524810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvq4i8JNE8EQ7kNvwELGnGM&_nc_oc=AdqDfo5ALT6Sf218QChw2JENDoLB9zETLAHKu9-VVgkZb_LUNlCdye2LM5Vo9epv-tE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIDat0G_34sarEB9CA3lSpnCzFfz_czqvqvJ0WPP6ntg&oe=6AA012CD"}, "display_name": "Oh My Galaxy!", "keywords": ["Fun", "Space", "Casual", "Cute", "Puzzle"], "long_description": "Oh My Galaxy! is an immersive puzzle game where you use a cosmic slingshot to fire asteroids at alien invaders that are attacking defenceless planets.                                                                                                                                                                         \n\n{2501985030252967}\n\nUsing hand tracking or controllers, combine the gravitational pull of the planets with the special powers of your asteroids to perform incredible trick shots.\n\n{1467700694699209}\n\nYour goal is to destroy the alien invaders as efficiently as possible. Set great scores to earn more stars, unlocking over 100 levels of planetary puzzles to solve.\n\n{1430533594856670}\n\nPlay in a choice of mixed reality or VR on Quest 3 and 3S, or in fantastic immersive VR on Quest 2, to experience Oh My Galaxy! brought to life in your home or headset.\n\n{2159426988193949}", "short_description": "Bring the cosmos to your home \n\n- Built from the ground up for mixed reality on Meta Quest \n- Intuitive gesture tracking puts real slingshot power at your fingertips. \n- Bring an arcade slingshot space attack into your living room "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ndreams.com/oh-my-galaxy-privacy-policy", "developer_terms_of_service_url": "https://ndreams.com/oh-my-galaxy-end-user-licensing-agreement", "publisher_name": "Megabit Publishing", "support_website_url": null, "website_url": "https://ndreams.com/games/oh-my-galaxy", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9547056648679784"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2768291366891373"}, {"status": "PUBLISHED", "id": "1709993776787021"}, {"status": "PUBLISHED", "id": "1898177314175649"}, {"status": "PUBLISHED", "id": "2213155939433584"}, {"status": "PUBLISHED", "id": "4339474119703431"}]}, "baseline_offer": {"id": "4339474119703431"}, "is_approved": true, "fi
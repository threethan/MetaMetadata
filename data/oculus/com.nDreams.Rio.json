dn.com&oh=00_Af1M4bC0tb5xqvoXb5oSUYyGsTZxO8hl9Pn1pr2ONE3rNw&oe=69F1FE87"}, {"file_name": "05_RIO_Screenshot_2560x1440_Catapult.png", "id": "4189778528001443", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823802_4189778531334776_291520407755447717_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GbpDLbCt6IQ7kNvwHVYTfS&_nc_oc=AdrkgitxYeKh1ZotaewXbLXvhvUnAN_ogBNlVYJSELifv1CYcheoyzcZgcl1htJZPD0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UsFV5uKTLRRLEDULsTujG1899bnsksmhFJLtfMYhiXA&oe=69F21130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OMG_Meta-Store-16x9_LandscapeCover.png", "id": "4269655196684768", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824328_4269655200018101_9081034574483524810_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0tns1QgbOoQ7kNvwGX6M0u&_nc_oc=AdqTWG79n4AiDNIlLF_HNnDM8wc_QyOc8R5ubyJhjq1_BWKss5NTtAo-YOEs8Kez9dQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3mZtujVp0QRgwVoSYhnab3CK8XBogOlmIH-k49wM6p2g&oe=69F20CCD"}, "display_name": "Oh My Galaxy!", "keywords": ["Fun", "Space", "Casual", "Cute", "Puzzle"], "long_description": "Oh My Galaxy! is an immersive puzzle game where you use a cosmic slingshot to fire asteroids at alien invaders that are attacking defenceless planets.                                                                                                                                                                         \n\n{2501985030252967}\n\nUsing hand tracking or controllers, combine the gravitational pull of the planets with the special powers of your asteroids to perform incredible trick shots.\n\n{1467700694699209}\n\nYour goal is to destroy the alien invaders as efficiently as possible. Set great scores to earn more stars, unlocking over 100 levels of planetary puzzles to solve.\n\n{1430533594856670}\n\nPlay in a choice of mixed reality or VR on Quest 3 and 3S, or in fantastic immersive VR on Quest 2, to experience Oh My Galaxy! brought to life in your home or headset.\n\n{2159426988193949}", "short_description": "Bring the cosmos to your home \n\n- Built from the ground up for mixed reality on Meta Quest \n- Intuitive gesture tracking puts real slingshot power at your fingertips. \n- Bring an arcade slingshot space attack into your living room "}]}, "developer_name": null, "developer_privacy_policy_url": "https://ndreams.com/oh-my-galaxy-privacy-policy", "developer_terms_of_service_url": "https://ndreams.com/oh-my-galaxy-end-user-licensing-agreement", "publisher_name": "Megabit Publishing", "support_website_url": null, "website_url": "https://ndreams.com/games/oh-my-galaxy", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9547056648679784"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2213155939433584"}, {"status": "PUBLISHED", "id": "4339474119703431"}]}, "baseline_offer": {"id": "4339474119703431"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "2213155939433584"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26466575209634663", "version": "1.0.4.437187"}, "id": "1198503048566390", "channel_name": "LIVE"}]}, "is_for_oculus_
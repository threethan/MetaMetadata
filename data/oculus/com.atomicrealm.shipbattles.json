6e7a0a&_nc_ohc=30FgnKmhWHAQ7kNvwEx_ewI&_nc_oc=Adq9QdN0jwRqAwTbBL3KVBdBeviNcf1cBAEPfLSHvnKnLNE0GsGnZoTwPB6dWsjEkPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-P0yK-UpSwQxyA025D7g1Oa04rbvI-L-AoSyMgaXTNw&oe=6A9C3779"}, {"file_name": "4_2560x1440.png", "id": "484692257733291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393320_484692261066624_1581567692823948414_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhgAYAOjWVQQ7kNvwHcR2VR&_nc_oc=AdoJWuJp8mnMSu2monmsMeaftjU4t-WTWTZDH3zFFNJ7IPD1OQVNduZSPEacKasCMIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlDrWnUpPH4yG0tfJQtkG2lzy1bECR5amK8v9dU99txw&oe=6A9C3AE1"}, {"file_name": "5_2560x1440.png", "id": "562853536740888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_562853540074221_3178014927181307576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-XQlrlL4-4Q7kNvwEc-8MP&_nc_oc=AdrwVG3kxFvd283rDTRm5VbOcYeWm6gcuAzDE-aMLLX3nMLcX7dZhpW_FDxgHU1rt5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIAyMQvoQ88m71PMApl1Z2hLfSrcQREqSjtq4hgAHLVg&oe=6A9C2667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "983984550317506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391797_983984553650839_8636229960987018933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wR6jgxD6GYQ7kNvwH_ZK_B&_nc_oc=Adpk8K95MyTYHI-OjQokqOej4_JeMU4rv7R6q3W4fJqTObjrLwum8GI8lRIUEdG5BYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW8Kv6noG4KCIi7LYlcL97HWejXZddUyhAQfao-EU4Bg&oe=6A9C20CD"}, "display_name": "Ship Battles", "keywords": ["board", "naval", "pirates", "tactics", "battleship"], "long_description": "**Immerse yourself in a pirate-themed Mixed Reality battleship-inspired game**  \nThis modern take on naval combat offers an engaging and intuitive experience for players of all skill levels.  \n\nPlace your ships on the board and take turns firing cannons at enemy ships. The first player to sink the entire enemy fleet wins! Outsmart your opponent and command the high seas in a game that perfectly balances calm decision-making with strategic depth where every shot counts! \n\n\n**Features**:  \n- Classic 10x10 grid gameplay with a fleet of 5 ships.  \n- Ships follow the classic rule: they cannot touch each other.  \n- Earn trophies by sinking your opponent's fleet and savor the satisfaction of victory! \n- Intuitive hand and controller tracking for seamless gameplay.   \n\n**Early Access**:  \nThe game is still in development, and we're excited to hear your feedback! We have big plans for the future and will continue to improve the game based on your input, including:  \n- Adding multiplayer mode for even more exciting battles.  \n- Expanding visuals with new ship designs and board themes. \n- And much more to come!   \n\nJoin us on this journey and help shape the ultimate Mixed Reality naval combat experience. Your feedback is invaluable!   \n", "short_description": "Immerse yourself in a MR battleship-inspired game which offers an engaging and intuitive experience for players of all skill levels.\n\nPlace your ships on the board and take turns firing cannons at enemy ships. The first player to sink the entire enemy fleet wins! Outsmart your opponent and command the high seas in a game that perfectly balances calm decision-making with strategic depth where every shot counts!\n\nSet sail, strategize, and rediscover the joy of naval battles \u2013 now in Mixed Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.atomicrealm.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atomic Realm", "support_website_url": null, "website_url": "https://www.atomicrealm.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "exte
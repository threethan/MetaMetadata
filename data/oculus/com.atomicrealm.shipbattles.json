a30f&oh=00_Af1NgC-LzND8afodgEQd7QZ6jlzUhZ11wcqIfZERVh8lHw&oe=69D79321"}, {"file_name": "5_2560x1440.png", "id": "562853536740888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393507_562853540074221_3178014927181307576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL-GSMyyW3gQ7kNvwFoctYU&_nc_oc=Adqx_K8Wu50aW2NhC1VNkMfokaeWjX5elDDWo6EJMEgOjQweLPOGzmDqElTqOiy5nSk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IZoPqh7e--LMIN8Wqb1LjGR0-fXbhjJpE7GFtxqCAcA&oe=69D7B6E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "983984550317506", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391797_983984553650839_8636229960987018933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmYHUzlWe3UQ7kNvwFGGOsi&_nc_oc=AdqT2uHQalgfDaBG6E5zvoXh_WpOLcmHAYO-I2YO4-y5GJ9gW5l4U1RU4D57E_DTDpw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FoUXoNOi74lN62WBQXAN8TynJmBJHHijTgW7ycEcd1g&oe=69D7B14D"}, "display_name": "Ship Battles", "keywords": ["board", "naval", "pirates", "tactics", "battleship"], "long_description": "**Immerse yourself in a pirate-themed Mixed Reality battleship-inspired game**  \nThis modern take on naval combat offers an engaging and intuitive experience for players of all skill levels.  \n\nPlace your ships on the board and take turns firing cannons at enemy ships. The first player to sink the entire enemy fleet wins! Outsmart your opponent and command the high seas in a game that perfectly balances calm decision-making with strategic depth where every shot counts! \n\n\n**Features**:  \n- Classic 10x10 grid gameplay with a fleet of 5 ships.  \n- Ships follow the classic rule: they cannot touch each other.  \n- Earn trophies by sinking your opponent's fleet and savor the satisfaction of victory! \n- Intuitive hand and controller tracking for seamless gameplay.   \n\n**Early Access**:  \nThe game is still in development, and we're excited to hear your feedback! We have big plans for the future and will continue to improve the game based on your input, including:  \n- Adding multiplayer mode for even more exciting battles.  \n- Expanding visuals with new ship designs and board themes. \n- And much more to come!   \n\nJoin us on this journey and help shape the ultimate Mixed Reality naval combat experience. Your feedback is invaluable!   \n", "short_description": "Immerse yourself in a MR battleship-inspired game which offers an engaging and intuitive experience for players of all skill levels.\n\nPlace your ships on the board and take turns firing cannons at enemy ships. The first player to sink the entire enemy fleet wins! Outsmart your opponent and command the high seas in a game that perfectly balances calm decision-making with strategic depth where every shot counts!\n\nSet sail, strategize, and rediscover the joy of naval battles \u2013 now in Mixed Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.atomicrealm.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atomic Realm", "support_website_url": null, "website_url": "https://www.atomicrealm.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8944241192311128"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1802244357012515"}, {"status": "PUBLISH
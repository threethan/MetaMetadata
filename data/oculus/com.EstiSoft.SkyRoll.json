00_AQTEOU6swU-Vhz3Zl_xH3Ddb07c-_x6KVMmkxnjdZEvrdA&oe=6AEA0150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-05 234746.png", "id": "1329964041329296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75443247_1329964047995962_7730305017580323987_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_qil12_gXUQ7kNvwFvvfqZ&_nc_oc=AdoAt5cYAIoYcLqvdiyTWy7FmEU1JYKbLb5ngenlVocHXOZOg18c-sqyhZQUgqCFB9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu-k42Rl57poVHg4V6mbzEXYT5nVpCAT1rQdCJcJ5o6Q&oe=6AEA04FA"}, "display_name": "SkyRoll", "keywords": ["Ability", "Comfort", "Casual", "Balance", "Gravity"], "long_description": "\"Sky Roll\" is the ultimate VR adventure, designed to immerse players in a world of speed, precision, and excitement on Meta Quest. Navigate through dynamic, ever-changing landscapes as you take control of a futuristic sphere, racing across challenging platforms, breathtaking heights, and winding trails. Each level presents unique obstacles and puzzles that test your reflexes and strategic thinking, keeping the gameplay fresh and engaging.\n\nWith stunning graphics that bring vibrant sunsets, majestic mountains, and winding rivers to life, \"Sky Roll\" offers a visually captivating experience. The game\u2019s intuitive controls and responsive mechanics ensure that players of all skill levels can jump right into the action. Collect rewards, unlock upgrades, and compete for the top score as you master the art of rolling through intricate paths with unmatched speed and precision.\n\nWhether you're a casual gamer or a VR enthusiast, \"Sky Roll\" delivers an unforgettable journey filled with challenges, thrills, and breathtaking scenery. Get ready to roll into adventure like never before!", "short_description": "Experience the thrill of \"Sky Roll,\" an immersive and fast-paced VR game for Meta Quest! Take control of a futuristic sphere and navigate breathtaking landscapes filled with challenging platforms, sharp turns, and daring obstacles. Master your skills, collect rewards, and race through vibrant environments with precision and speed. With stunning visuals and intuitive gameplay, \"Sky Roll\" delivers an exhilarating adventure that will keep you on the edge of your seat. Are you ready to roll?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/sky-roll", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "644354873106712"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8934729329939723"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "25567605432936787"}, {"status": "PUBLISHED", "id": "952738017656369"}, {"status": "PUBLISHED", "id": "1488939049905366"}, {"status": "PUBLISHED", "id": "1513778306582054"}, {"status": "PUBLISHED", "id": "999633498999843"}, {"status": "PUBLISHED", "id": "1324421755284683"}, {"status": "PUBLISHED", "id": "10078379032194636"}, {"status": "PUBLISHED", "id": "937261211933756"}, {"status": "PUBLISHED", "id": "1328553674985544"}]}, "baseline_offer": {"id": "10078379032194636"}, "is_approved": true, "firstOffer": {"nodes"
ABA6A74"}, {"file_name": "Cricket X Screenshot 4.png", "id": "314068445006679", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001676_314068448340012_6227481545496341750_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n8U6ZkRAIsQ7kNvwGIDh41&_nc_oc=Adpr0xTnsjSezzkKYwh0XzFt4-LaDy6CoCD414fVF80N1jlTFyBaszIEO4b0a79fUMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtBBXqsRWwshWwgg_sMKSFvk_sbs_pEj9GJ7-T76K-cw&oe=6ABA619B"}, {"file_name": "Cricket X Screenshot 2.png", "id": "1523194464928537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86616644_1523194468261870_8606475524555149201_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuiVBveu2LIQ7kNvwGWYuE_&_nc_oc=AdotNR0hy2CT62PXDGbY2hmQS4o3pVs2leJBhTrRBcnBMrWios6SabZVcVc0J4_KN3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrNHk-9lBgqeBQFFRzsbvi3kQN--EwU_mHfjMdKq4Unw&oe=6ABA5AE7"}, {"file_name": "Cricket X Screenshot 3.png", "id": "813031630542509", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476598_813031633875842_8138021581861231288_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMHWZcWFpAYQ7kNvwGAHD3W&_nc_oc=AdrZrmfFbrpUP897ALZFV5lbbIlxWCBPRpwzB449X4z28hDeOrmfJ6tDgyRl7lRUUsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqHvCUZWXccusf_9uPSUdk6jUAUaBw0I4HI7qGclbkuQ&oe=6ABA7019"}, {"file_name": "Cricket X Screenshot 5.png", "id": "445873261671966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476754_445873265005299_3973631504296513136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PenqACs1aiMQ7kNvwGe8lVb&_nc_oc=AdoPH0_KEbwDhDWceKTg47N3I8VtIS9ocHGDn76nGiqycCf9A7d4lscTpRDB0zvZUHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhAeM4N_Gu5dz3gdsC4eEAkQZ-VMPu0TI8JQv-E1UUlQ&oe=6ABA87EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cricket X", "keywords": [], "long_description": "Cricket X: The Ultimate VR Cricket Simulator\n\nStep into the immersive world of cricket like never before with Cricket X, the premier VR cricket simulator that brings the excitement of the pitch to your fingertips. Experience the thrill of chasing down targets in a hyper-realistic environment, designed to make you feel like you're right in the heart of the action.\n\nKey Features:\n\nRealistic Physics: Enjoy true-to-life ball dynamics and player movements, capturing the essence of real cricket.\nChase Mode: Face the ultimate challenge of chasing down thrilling targets, with the ability to set your preferred score, number of overs, and wickets.\nInteractive Gameplay: Play with a controller or attach it to a real bat for an unparalleled immersive experience.\nDetailed Analytics: Gain insights into your performance with comprehensive analytics, helping you refine your skills and strategy.\nIconic Venues: Take to the field in meticulously recreated stadiums, starting with the legendary Qaddafi Stadium.\n\nCricket X is more than a game\u2014it's your gateway to the ultimate cricket experience. Whether you're a seasoned pro or a budding enthusiast, Cricket X will have you hooked from the first ball to the last run.", "short_description": "A Virtual Reality Cricket Simulator game with realistic physics where you can chase thrilling targets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrevstudiopk.blogspot.com/2023/08/xrev-studio.html", "developer_terms_of_service_url": null, "publisher_name": "Xrev Studio", "support_website_url": null, "website_url": "https://xrevstudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
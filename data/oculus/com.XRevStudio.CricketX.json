c_oc=AdqnV11NAh2ryDHR6tSVf0-lQ_fSsjnnmpzz9sklsP5ZuscnzSw5bjbJvcsxlQKFDQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGeZds-pqDM04GKNG_bJRzI27gCyoJtU8A9bOy93EElg&oe=6ABA60EB"}, {"file_name": "[Original size] CricketX Techstar (2560 x 1440 px) (3).png", "id": "1669669217340172", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821696_1669669224006838_4255477991371990727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HluV8ePbfDoQ7kNvwHk0PzQ&_nc_oc=AdrJIPp_WmgQO88bttdLyU0Dsj_LJcF_YNp8zX2qwMktmodkOnXKbyk9qolJJxW8MQU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjxjwiXjq6WDwab0jVP7HwBEgOaT2skUEpJzmJoD3e4w&oe=6ABA8865"}, {"file_name": "[Original size] CricketX Techstar (2560 x 1440 px) (4).png", "id": "4426518830911340", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821682_4426518834244673_2821852502276580056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3Yd7rUjCM0Q7kNvwH5I9SI&_nc_oc=Adru5KkLEKwRuX8JGIzldR-fKX83GJxxakjif9tid24CEB_vWyLwRmDRsAFHYg6iYLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwDjCyJ2w0Ilwidt5PcC403ola0JXZnJyyiJjxnF_ixQ&oe=6ABA6C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cricket X Banner .png", "id": "578704851567805", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75505860_578704854901138_2146439193637587985_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtkGrC8PsQoQ7kNvwEOvxY1&_nc_oc=AdrqjcL9nd71sNh2piy8dFLjSxS4yBEkj24wuK9c648M_qbAbSdoRJoXeU0eohe8wb4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIABwD4NO3oA5y3vVF5xLJvdRDGhfn8HcOTjm7nmCGXXw&oe=6ABA8D88"}, "display_name": "CricketX", "keywords": ["cricket", "batting", "training", "sports", "simulation"], "long_description": "# CRICKETX \u2014 MOST REALISTIC PHYSICS BASED TRAINING\n\nStep into highly realistic physics-based VR cricket where batting feel, ball movement and pitch behaviour matter. CricketX simulates pace, swing, spin, seam, bounce and bat-ball interaction\u2014with control and analytics for purposeful practice.\n\n\n**REALISTIC BATTING & BOWLING.**\n\nRead the bowler, judge the delivery and commit to the shot. Bat right- or left-handed on immersive pitch, with ball behaviour shaped by delivery and pitch settings.\n\n**CONTROL THE DELIVERY**\n\nSet line, length, speed, swing, spin, bowling side, pitch pace and bounce. Build a net around one weakness, or mix deliveries to test reading and shot selection.\n\n**TRAIN UNDER PRESSURE**\n\nMove from open practice into target chases, Faceoff, local pass-and-play and curated challenges. Rehearse decisions as the situation changes.\n\n**REVIEW. ADAPT. RETEST.**\n\nReplay shots from multiple angles. Study pitch maps, wagon wheels, trajectories, matchups, timing, contact and dismissals. Technique views surface head movement and gaze-at-contact cues.\n\n**FEEL THE BAT**\n\nTouch controllers work on their own. For the most authentic CricketX experience, mount one in a compatible real bat. The controller tracks your real swing while the bat adds physical weight, balance, grip and reach. Passthrough keeps your surroundings visible. No PC or console required.\n\nCricketX complements coaching and net practice. CricketX Pro is optional and unlocks Analysis Mode and selected premium scenarios.", "short_description": "Experience highly realistic physics-based VR cricket built for serious batting practice. Face pace, swing, spin, seam and bounce; control line, length, speed and pitch behaviour; then study replays, pitch maps, wagon wheels, timing, contact and technique. Touch controllers work on their own, or use a compatible real bat for the most authentic CricketX experience\u2014with real weight, balance, grip and swing. Runs standalone on Meta Quest\u2014no PC or console required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cricketx.net/privacy/", "developer_terms_of_service_url": "https://cricketx.net/terms/", "publisher_name": "Xrev Studio", "support_website_url": "https://cricketx.net/support/", "website_url": "https://cricketx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "28450336414619595"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86625133_1125590695756555_7161271893592578981_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhsF_rjE1JoQ7kNvwEQb_dO&_nc_oc=AdoI5yJ80D5SDNLyVv0ibBir-XJ4Zqshrp0h_TYAXAj7L_lRu8wtkgfUdwwVFLFC2ZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIslADhwv27B2cCPxkzCI-__mLfpFs_Cph48b7-eItUHw&oe=6ABA5B7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CricketX", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1720785900, "lastRevision": {"nodes": [{"id": "6986676901412190", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6986676891412191", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_ce
231288_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlfYcPVFO3kQ7kNvwHsqrId&_nc_oc=AdqljGkyJgmOnGBO_tpQCU93sW73V_wczoYUR76y5ze1kY6On3XuC2UQfwOeGgDsEss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYa389sTTyCrSr4HrzqgY0CIyDQ2JbIHCIogrZdLlJRw&oe=6B071F59"}, {"file_name": "Cricket X Screenshot 5.png", "id": "445873261671966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476754_445873265005299_3973631504296513136_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcBS1iZRnH8Q7kNvwEnHBv5&_nc_oc=AdqcjGoxIBpE8CXfPo2X1zzfTLkdli9M5vZhAcLCz9sHAxieyY6cepqTg3vSwaq9FEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2wEXm3JnnwaNuu75FaVADkNAJ5CPJHXWN06kdrEd2fA&oe=6B06FEEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cricket X", "keywords": [], "long_description": "Cricket X: The Ultimate VR Cricket Simulator\n\nStep into the immersive world of cricket like never before with Cricket X, the premier VR cricket simulator that brings the excitement of the pitch to your fingertips. Experience the thrill of chasing down targets in a hyper-realistic environment, designed to make you feel like you're right in the heart of the action.\n\nKey Features:\n\nRealistic Physics: Enjoy true-to-life ball dynamics and player movements, capturing the essence of real cricket.\nChase Mode: Face the ultimate challenge of chasing down thrilling targets, with the ability to set your preferred score, number of overs, and wickets.\nInteractive Gameplay: Play with a controller or attach it to a real bat for an unparalleled immersive experience.\nDetailed Analytics: Gain insights into your performance with comprehensive analytics, helping you refine your skills and strategy.\nIconic Venues: Take to the field in meticulously recreated stadiums, starting with the legendary Qaddafi Stadium.\n\nCricket X is more than a game\u2014it's your gateway to the ultimate cricket experience. Whether you're a seasoned pro or a budding enthusiast, Cricket X will have you hooked from the first ball to the last run.", "short_description": "A Virtual Reality Cricket Simulator game with realistic physics where you can chase thrilling targets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrevstudiopk.blogspot.com/2023/08/xrev-studio.html", "developer_terms_of_service_url": null, "publisher_name": "Xrev Studio", "support_website_url": null, "website_url": "https://xrevstudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8027302137349656"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1691717485685393"}, {"status": "PUBLISHED", "id": "3532190626951024"}, {"status": "PUBLISHED", "id": "3129987657206672"}, {"status": "PUBLISHED", "id": "1363436542424552"}, {"status": "PUBLISHED", "id": "967209043031130"}, {"status": "PUBLISHED", "id": "1682567679434208"}, {"status": "PUBLISHED", "id": "862130189476809"}, {"status": "PUBLISHED", "id": "1264496728237639"}, {"status": "PUBLISHED", "id": "1408671413793771"}, {"status": "PUBLISHED", "id": "938483428485013"}, {"status": "PUBLISHED", "id": "498386349624923"}, {"status": "PUBLISHED", "id": "1179304823327784"}, {"status": "PUBLISHED", "id": "1170911294051909"}]}, "baseline_offer": {"id": "3532190626951024"}, "is_approved": true, "firstOffer": {"
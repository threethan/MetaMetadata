YYf4ZxOmjSJU8I7Suk6uSzakA&oe=6A9AECE3"}, {"file_name": "scr23.png", "id": "1276482659853130", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001721_1276482663186463_7232902767493430601_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOHXYCmvY4UQ7kNvwFVjP5N&_nc_oc=Adr_XkU6ZGHhlZXMhS-44inKhpb0bqVN2nNwU4Qp15uSy7Ddt4A2yck_1HUuYoQFU94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDEp7yeqoBbs1ysdPAcrx7JJ5uOEtD0R6QCP9bLyjskQ&oe=6A9AC6F0"}, {"file_name": "scr34.png", "id": "1026807000079407", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_1026807003412740_2793649932024815624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sZIm3LYuI4Q7kNvwEVhxpJ&_nc_oc=AdpOce9Xd0DuRsvywWAM_u8aHpowWp1OfZF5AW3FOaSbnrPpDhYGEeO5w-8LlD-f-eg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZwgxIEQbNV3r2oaZsiZ-0N_W2ALOtcw67zWeVHRq-Rw&oe=6A9ADF33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rotf-applab-cover-landscape.png", "id": "943915839902755", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_943915846569421_2547162785653510387_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6XmC8fj1qEQ7kNvwGhEzWo&_nc_oc=AdqJ7NSCmEw2q8ZDXQjJyNCLdh6i8vtUns6ScqgbxJlSk7Jidz7Fa91hRXf3h7XIlxA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRGolTPh5CI6ZXPDsMESoLO6LOrE-wqNDhxqCl5jVVcw&oe=6A9ADEC1"}, "display_name": "Realm of the Fallen", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Blast, bludgeon, jump, and climb your way through multiple levels. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Along the way collect items that enhance your abilities and enable you to access new areas. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n", "short_description": "VR meets old school FPS. Blast, bludgeon, jump, and climb your way through an ancient temple that has been overrun by augmented undead minions. Set in a world with a unique aesthetic and horror elements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://www.realmofthefallen.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209550362046511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974857_2093198077556505_6751546950760055155_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtbiMZLaX-sQ7kNvwHZnjjn&_nc_oc=AdrzNqDrumO-mmUkp0VmDngl7P5zi9hwxr-dS7pJvsDhNzUH511GkI9nQhny0HNGfCQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaeKxctkWu_vhpsKsGB40k9mEtCgJjetp0
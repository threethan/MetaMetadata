5Z9jEX0CgQAPsNjNbB724XUqQ&oe=6A86EE23"}, {"file_name": "scr23.png", "id": "1276482659853130", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001721_1276482663186463_7232902767493430601_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC-X-tBWyDAQ7kNvwGnWGkH&_nc_oc=Ado4ARvPRddrr9w-7ooLn3jB2b5mvOk_sytJsjBBl1JwQ2xgol5RjZP_Beq9Q1ix_iE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvycdDTDfGeGn_mzBFOe90wRs3PBaoO2HJdsFdw7-7pQ&oe=6A870070"}, {"file_name": "scr34.png", "id": "1026807000079407", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_1026807003412740_2793649932024815624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P5NajdohA4Q7kNvwGvz_9W&_nc_oc=AdpuYqK9-8j5b-39Ztvs_huFmL4m1gKvHUsiWk2H_gEkHRbWK1k0xA57wjQghGW6rDQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQnrwnIijX092nG1bimw9peRqrERnauyEoIz0LMkjHDw&oe=6A86E073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rotf-applab-cover-landscape.png", "id": "943915839902755", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_943915846569421_2547162785653510387_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ007oBGd9AQ7kNvwHqHgSi&_nc_oc=AdqBue7p78Ro12uH21N2rDDR9SPAcycpVaCl_49ddOFm4zBIJw-BWO8QAa95WYDSDng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTOIGftTZeE2_9qtdwQ6aIqxkVwYSYYerqhdlfeYgVaA&oe=6A86E001"}, "display_name": "Realm of the Fallen", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Blast, bludgeon, jump, and climb your way through multiple levels. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Along the way collect items that enhance your abilities and enable you to access new areas. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n", "short_description": "VR meets old school FPS. Blast, bludgeon, jump, and climb your way through an ancient temple that has been overrun by augmented undead minions. Set in a world with a unique aesthetic and horror elements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://www.realmofthefallen.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209550362046511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974857_2093198077556505_6751546950760055155_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPXL57IYNDIQ7kNvwESADSz&_nc_oc=AdqcoTDFyXjTZSq9VNRr0S9PfG_ngbtUhU9zS9V_cz9BoC5em15NOtVey8E0iqpRtM4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMtad0MzDjMEMIVOg1I-Sbwqy8Ox2Vo7LP
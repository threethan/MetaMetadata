WnQnXC3NE0A2KHlPX8wpQR3FQ&oe=6AB2A7E3"}, {"file_name": "scr23.png", "id": "1276482659853130", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001721_1276482663186463_7232902767493430601_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpa4-ARUQcIQ7kNvwHu88CR&_nc_oc=Adr7PWumTh_Kq31b5DibgNCuEKcxormRiOW6QhXLjtuo5GUR5O9TGDI6tFImtQhWXoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoflPhxNsRpgzFFE5z1xuFnsICQdhqDsNDpAmq0QvZYg&oe=6AB281F0"}, {"file_name": "scr34.png", "id": "1026807000079407", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_1026807003412740_2793649932024815624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMIfCLaETEgQ7kNvwHmS308&_nc_oc=AdojnT6lu_eg-1ujNDStJFffYqYKSx1hOdhS5J-uvy6OCy1mRh25S0zYzfcJ4f2WcGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoPj8mtZ-HEPPVxpALPx4jVdCbOlARfDMjTva8RUpTVQ&oe=6AB29A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rotf-applab-cover-landscape.png", "id": "943915839902755", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984475_943915846569421_2547162785653510387_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR1hGFgyqZ0Q7kNvwHgmkAE&_nc_oc=AdrSiT5223joyKbiZ-Sur3WNpArhAEqr5T359V-3txe1b-DgCub5oo_Y413ZNpaUIwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3dlMh4hUTKq8fpUyxOpaO4Yw9lxiDHCxqkd5HhcsnwA&oe=6AB299C1"}, "display_name": "Realm of the Fallen", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Blast, bludgeon, jump, and climb your way through multiple levels. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Along the way collect items that enhance your abilities and enable you to access new areas. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n", "short_description": "VR meets old school FPS. Blast, bludgeon, jump, and climb your way through an ancient temple that has been overrun by augmented undead minions. Set in a world with a unique aesthetic and horror elements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://www.realmofthefallen.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209550362046511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974857_2093198077556505_6751546950760055155_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUzdddEC2eYQ7kNvwGhgrHq&_nc_oc=AdoZdUR2VDfOUB61hZhdY9hQSrT9ALCYNLhMcUraO2JnvaoZFHAcGihgA6gKwSIvySU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgpSJN-IfIwQX5erkS3A77vThdusR3mXe7
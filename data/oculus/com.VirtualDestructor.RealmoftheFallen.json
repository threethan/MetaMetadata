x-CtrC2VeU3fl8qk9tLUPPh2g&oe=6ABBE263"}, {"file_name": "scr23.png", "id": "1276482659853130", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001721_1276482663186463_7232902767493430601_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eAp7QPWwqoQ7kNvwFUOaF7&_nc_oc=AdpFpTv7lRdOUnJyX4qY2YpiSojzT0E9tn_7islnGgmoxnXf6d8Fs7pVGMiz6a8GfdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-U4OzGKGYq2mE3R0bUI0BK5EaqyrkqU64wmSAgOsiVg&oe=6ABBBC70"}, {"file_name": "scr34.png", "id": "1026807000079407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1026807003412740_2793649932024815624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiq-kFWOYyoQ7kNvwELSZOd&_nc_oc=AdoFTgyGR51hwKPBdP8VlFRLVjkEuQSjl22z8DAg6IPTlQYLZwOVdAHjLf7Q62W5k1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY0f-fghXsKlCRgv4u7zXBDkb4AegFgaQM80_ekIpKOw&oe=6ABBD4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rotf-applab-cover-landscape.png", "id": "943915839902755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_943915846569421_2547162785653510387_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-ScXfrX2wAQ7kNvwGG0ff9&_nc_oc=Adr-LJchNSfIiWdSEV9yiYhKU3s8QH9sSfutu-40DD2kD1jRIPQqz_efiE56GMXw_hY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2I1qpfXDF-rbHN3WI_WGGxoAEfREiM3ZjXJgTcn9GxA&oe=6ABBD441"}, "display_name": "Realm of the Fallen", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Blast, bludgeon, jump, and climb your way through multiple levels. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Along the way collect items that enhance your abilities and enable you to access new areas. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n", "short_description": "VR meets old school FPS. Blast, bludgeon, jump, and climb your way through an ancient temple that has been overrun by augmented undead minions. Set in a world with a unique aesthetic and horror elements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://www.realmofthefallen.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209550362046511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974857_2093198077556505_6751546950760055155_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D6TqlpzRIgQ7kNvwFx-Iet&_nc_oc=AdrC7NLjnAwKRpAdb0rGQ0oJR-0SOsybIX7zVC6oxItyph4zl5x9EKlcMhwL0ZY2xu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWHJ8FmqBKqMHzEGUN_Absgpsb-zzp3Xaa
gtXsb3YABmh2mMDja_jSQAgBw&oe=6A844B23"}, {"file_name": "scr23.png", "id": "1276482659853130", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001721_1276482663186463_7232902767493430601_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC-X-tBWyDAQ7kNvwHYlu3R&_nc_oc=Adqd5kfwt07dW6RUiR-nPZwzc5MDfbY4uxF0pDp66luu6SpJUpyJ0zS1DmhQc9tAZHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaLzuDUHese5PoNMkduGn_iln0OLeq57ePqLP2e2d3wg&oe=6A845D70"}, {"file_name": "scr34.png", "id": "1026807000079407", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_1026807003412740_2793649932024815624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3vpIOkNeiIQ7kNvwHcz44E&_nc_oc=AdoNUL5tIp7ZyuAPcBIfPXgMH9KyetH688y45JBIwcU8Rl4lmkQQHbenZcNO0zzG8CQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAkQfu8Iq1xEMvKDW0MNF82_mNNL-nON4iLT7eNsik4g&oe=6A843D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rotf-applab-cover-landscape.png", "id": "943915839902755", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984475_943915846569421_2547162785653510387_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAbwfwvkf3YQ7kNvwEcSVyG&_nc_oc=Adp1kgY7OyaVxxWLtZSy8KE3p5ETgqFQ-_K3tuiX_fLg0PhVD_WQ0olQ0xhBEKoDiIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0COpb4r71bGzQdltmImbP_PumR5K8JhaDFGr-ktRhSg&oe=6A843D01"}, "display_name": "Realm of the Fallen", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Blast, bludgeon, jump, and climb your way through multiple levels. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Along the way collect items that enhance your abilities and enable you to access new areas. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n", "short_description": "VR meets old school FPS. Blast, bludgeon, jump, and climb your way through an ancient temple that has been overrun by augmented undead minions. Set in a world with a unique aesthetic and horror elements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://www.realmofthefallen.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209550362046511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974857_2093198077556505_6751546950760055155_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa2cSUyDJNkQ7kNvwHH6j63&_nc_oc=AdoNbQEmdiSNog3w9zIeQuSwrb2V0515viTZDy6R1s_jEXvdG2JVzgtttWYQ9qFVuNY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB7CVplvU18jh-IK0fMxsd7lsE3cIMWcio
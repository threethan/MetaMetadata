wv1J_pVkFbez1NYvt0o11YMGQ&oe=6A9028A3"}, {"file_name": "scr23.png", "id": "1276482659853130", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001721_1276482663186463_7232902767493430601_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J3xRWBFiigQ7kNvwGrXizs&_nc_oc=AdrIJtwztXxF9xntuv9ozqgVt5rB8BvfsAHrBOPbEXPEH6JHiVb5G03WcjIEh2FaYso&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTdlQaJJgBd50uTmrd6BStgbZG5-t0jlVQe5L4FiRAYw&oe=6A903AF0"}, {"file_name": "scr34.png", "id": "1026807000079407", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823940_1026807003412740_2793649932024815624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsDa6A8Ym24Q7kNvwFt9FU_&_nc_oc=AdoMC9jZJ-hRN2Wz5y5KhT0f7Vz7NZTXc2knmGd1P_OlbdmnEq7WF6Q4fxhGTau_9Hk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKF3eXkDaG9fdKbrhaB5fSi-sR61wbxDRWVcnMWAIh9A&oe=6A901AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rotf-applab-cover-landscape.png", "id": "943915839902755", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984475_943915846569421_2547162785653510387_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K92gOXIHvNcQ7kNvwHnKtC2&_nc_oc=Adp-2aNt9N0K-iSPXcVj7dXiY15NhIjOxAUB9tPppI1KNVqe6W5cGz54XIqkP157Dqs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRVMRKGjs-VMcqyfdVUdTTrZnwpK9Nj9fCuUKIoXR6mA&oe=6A901A81"}, "display_name": "Realm of the Fallen", "keywords": [], "long_description": "VR meets old school FPS. Assume the role of a resurrected warrior in another dimension where a once-flourishing civilization was eradicated by a sinister interdimensional being. Remaining is a temple that has been overrun by augmented undead minions. Blast, bludgeon, jump, and climb your way through multiple levels. Combines the best elements of VR and classic shooters. Use bullets, rockets, lasers, grenades, and punches to eradicate your foes. Search the temple for the being responsible for the destruction. Along the way collect items that enhance your abilities and enable you to access new areas. Experience intense, fast-paced action and a unique aesthetic in the world of Realm of the Fallen.\n\nWill you extricate your realm from the malevolent forces that possess it? Or will you rejoin the ranks of the fallen?\n", "short_description": "VR meets old school FPS. Blast, bludgeon, jump, and climb your way through an ancient temple that has been overrun by augmented undead minions. Set in a world with a unique aesthetic and horror elements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realmofthefallen.com/rotf-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Destructor LLC", "support_website_url": null, "website_url": "https://www.realmofthefallen.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209550362046511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974857_2093198077556505_6751546950760055155_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whxwhImott0Q7kNvwHhK9lD&_nc_oc=AdrycpYDHB2Llq8nsm4Lc6iRlWo8HWE9cg0iZsBdYp4tVSNeuzkMbzuM3VCPDLpQ65o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo5rvKy0F3RNLrUI7XDeyzpHy2nlydrHoR
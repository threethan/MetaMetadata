.5771-25/39031579_2562140590618543_1846118375705669740_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzeVdTfVYBcQ7kNvwGnYr9-&_nc_oc=Adp_HNNQ5ONhd6u-V4_ScWQ-Kg5eOT_FGALCZFwJXAIer-dD3_HLY9AX-JDktgU63oI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9LqIuXoSiyEucAGffBLMRDqxXXzpT4ONnc6mx5Z6D8g&oe=6A5E37CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloDentist Doctor", "keywords": [], "long_description": "HoloDentist is a mixed reality application dedicated to the Digital Dentistry sector.\nThanks to HoloDentist, doctors can analyze treatment examples using 3D data coming from CBCT, intra-oral scanners and face scanners as well as 3D modeled implants, crowns, surgical guides, etc...\n\nIf you want to get a Demo account to try the solution, please contact us at info@holo.dentist", "short_description": "HoloDentist is a mixed reality application dedicated to the Digital Dentistry sector.\nThanks to HoloDentist, doctors can analyze treatment examples using 3D data coming from CBCT, intra-oral scanners and face scanners as well as 3D modeled implants, crowns, surgical guides, etc...\n\nIf you want to get a Demo account to try the solution, please contact us at info@holo.dentist"}]}, "developer_name": null, "developer_privacy_policy_url": "https://holo.dentist/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": null, "website_url": "https://holo.dentist/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH
 "494349576635230", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031331_494349579968563_6741844684703077230_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkPIA7lm1eMQ7kNvwH00_Jn&_nc_oc=AdobmxxoiixLWUu44L1t02F-CNiTxjtnMHk4Bw5MOHknFo8EArL8t003yc2Tvsra8AI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2pmM0d36vlMnxyNhDLRtwBpZ9dYOZLhDJ3buS1DLBCg&oe=6A6757F9"}]}, "id": "1262279152172969", "locale": "de_DE", "screenshots": [{"file_name": "THZZLS_005.png", "id": "419203847255788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572953_419203850589121_8776566817315113500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MbTtxL49NwQ7kNvwEZLfg0&_nc_oc=AdqIMe1KAhNODzHQXW59RMtOwibkLxSAR6sG-0AV7iN6d2GLStAvVShf_sr6zHlkKaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiEKYziBhi5NN-JU1VXe2PMtuE8OKsg0HyRxIIz6ME3g&oe=6A676245"}, {"file_name": "THZZLS_002.png", "id": "822672209955577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569471_822672213288910_447830512566642752_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JypDScgf6KkQ7kNvwE1uWlU&_nc_oc=Ado8opWFCckrmhGaSNMYRKnvEXlRLkdJVI0phJeO3l6Ig0y3proNyuyUDhsk4eGNcUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKVwDUIeAA6S_atQan_xMi3sPOui9_AJcW1LZt2YLjZA&oe=6A6742A7"}, {"file_name": "THZZLS_butterfly_grab.png", "id": "1609761506423206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031370_1609761509756539_612742917688084691_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgim-0OrRwAQ7kNvwETu215&_nc_oc=AdoZluG2TY9ZmoG3RSBL53EeosY0sqc_sByCDzg7pxybkhRt0rB-dEzp669k0Pb_QKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeT2PqyLHsNxBa0GD19AWIXiBHaJxpKB0tbk4OnpPN5Q&oe=6A6757B0"}, {"file_name": "butterflies.png", "id": "781806797219945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262743_781806800553278_3381064023820542343_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu93O9yx9KkQ7kNvwHGKSof&_nc_oc=AdpmKxqclD97cHYzN11PB_I8PC2WZSLV7qmWb78vCFfTfrKPLTI3RSfi-G5qviZG3Cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuQ6eDxdhN2F3WmGNXRowuvV4PgcYTl6wDKniauHCHjg&oe=6A6763C3"}, {"file_name": "fische_1.png", "id": "850858329981720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375751_850858333315053_1211059050665635335_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJ8m3CIN2LUQ7kNvwHpiKpg&_nc_oc=AdovDqM4aoSvCOrjsArQKNQxX4FzlKmZUj5r6OE-bHVjL-JUexZu8BJyBqHsqMEP_PU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrKbcLVSnd4AOBFPZR7XeRr-EeAwDsjG8XiYCJSzzw3Q&oe=6A675971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_02.png", "id": "1562561871273135", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931338_1562561874606468_8019123339288510529_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoMV2Fc9RdgQ7kNvwHQJMTQ&_nc_oc=AdqkguxH8Hh66dbspqGxcQqW4ia8Lab1FTJ4Fe1UotuR5R_h1dlXsHu_uu6woWdgvRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbF6W1G5V8J1Smz7RS6INF0Ma4bHOgdBR36GzQRt3TvQ&oe=6A675167"}, "display_name": "THZZLS", "keywords": ["puzzle", "entspannung", "casual", "kunstgeschichte", "bilderbuch"], "long_description": "Mach eine Pause vom Alltagschaos. Mit THZZLS tauchst du in die Geschichte ein und setzt mit deinen eigenen H\u00e4nden wundersch\u00f6ne 3D-Dioramen zusammen \u2013 ganz ohne Controller, ganz ohne Stress, nur du und jahrhundertealte Kunst aus echten Museumsarchiven.\n\nJedes Puzzle basiert auf authentischen deutschen Zeitschriftenillustrationen des 19. Jahrhunderts aus Museumssammlungen. Entstanden bei einem Museums-Hackathon, verwandelt THZZLS archivierte Kunst in meditative, handgesteuerte Erlebnisse, die du buchst\u00e4blich ber\u00fchren kannst.\n\nMit intuitivem Hand-Tracking nimmst du Puzzleteile auf, betrachtest sie und f\u00fcgst sie zu atemberaubenden 3D-Dioramen zusammen. Halte die Teile nah an dich heran, um die feinen historischen Details zu bewundern.\n\nDrei unterschiedliche Level, jedes mit eigenem Thema. Perfekt f\u00fcr 10 bis 15 Minuten Entspannung zwischendurch.\n\nSpieler:innen lieben THZZLS zur Meditation und zum Stressabbau. Geschichtsbegeisterte sch\u00e4tzen den authentischen Archivinhalt. Auch Pflegekr\u00e4fte haben  es schon in therapeutischen Settings eingesetzt.  Alles offline, alles ohne Controller, alles wundersch\u00f6n.", "short_description": "THZZLS ist ein meditatives VR-Puzzle-Erlebnis ohne Controller. Setze mit deinen eigenen H\u00e4nden wundersch\u00f6ne 3D-Dioramen zusammen \u2013 basierend auf authentischen deutschen Zeitschriftenillustrationen des 19. Jahrhunderts aus Museumsarchiven. Entstanden bei einem Museums-Hackathon, verbindet THZZLS Geschichte mit Entspannung. Drei Level, je 10\u201315 Minuten, komplett offline spielbar. Perfekt zum Stressabbau, auch im therapeutischen Einsatz beliebt."}, {"images": {"nodes": [{"file_name": "THZZLS-new-portrait-2026-hero.png", "id": "2231078900983364", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_2231078907650030_28157431992682264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6KZ0Ftv3IUQ7kNvwGPwJTs&_nc_oc=AdqDq4Z098GCm43p0LYiuOra7xW5DcnQInRqoVN8H6Czm78CaE2Pd2YspJg-1LSU3OE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDewCP5spX6PV7OJ3F4eI8EV6mBqo3gQHZOuSoy-Yo5Xg&oe=6A6765A5"}, {"file_name": "THZZLS-new-icon-2026-hero.png", "id": "1395914199058597", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1395914202391930_6419056375602968618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgRj9XXkopMQ7kNvwHlEiAF&_nc_oc=AdreZrFVUBmnQvcXlW5hzmIqmR6liYt9Ei4_Hp5ePyPIx_1T14o6mJeKE-_OKNiywWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcBsTeqKLe5W15q79CdCTJ90xchKyHmQ3N0FGFmJDZwQ&oe=6A67462
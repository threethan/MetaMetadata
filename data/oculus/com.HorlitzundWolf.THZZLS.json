LWoMnFgUsJnTloCDTAG4LzeWxLBib04AoYZHJxzJBLNoT0HEdVkVICeNDjHmRGlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7FAzb9ta5SWg5F9juuMrIfT2vBbQUdLewYBW5kDDCqQ&oe=6A674509"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_02.png", "id": "1486723368654466", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984452_1486723371987799_3197934513556408949_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9nNmbGlQXwQ7kNvwE1Famv&_nc_oc=AdoioHYtlc744HUA-7kcsyytdOuEw6iwSVliUvh_TBT_Y59qpfKc4SlX3ScdMBgU_3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtGLjC1IJKpUUzOb9GY42920huNugqERb01sWYd3LRbQ&oe=6A6755B6"}, "display_name": "THZZLS", "keywords": ["puzzle", "relaxing", "culture", "historic", "casual"], "long_description": "Take a break from the chaos. THZZLS lets you step into history and assemble beautiful 3D dioramas with your hands - no controllers, no stress, just you and centuries-old art from real museum archives.\n\nEvery puzzle is based on authentic 19th century German magazine  illustrations from museum collections. Born from a museum hackathon,  THZZLS transforms archival art into meditative, hand-tracked experiences  you can literally touch.\n\nUse intuitive hand tracking to pick up, examine, and place puzzle pieces into stunning 3D dioramas. Bring pieces close to appreciate the intricate historical details. Three distinct levels, each with  its own theme. Perfect for 10-15 minute relaxation sessions.\n\n\"Players love it for meditation and stress relief. Care workers use  it in therapeutic settings. History enthusiasts appreciate the authentic archival content. All offline, all controller-free, all beautiful.", "short_description": "THZZLS is a meditative, controller-free VR puzzle experience. Use your bare hands to assemble beautiful 3D dioramas based on authentic 19th century German magazine illustrations from museum archives. Born from a museum hackathon, THZZLS blends history with relaxation. Three levels, 10-15 minute sessions, fully playable offline. Perfect for stress relief and popular in therapeutic settings too."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.howo.games/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Horlitz & Wolf", "support_website_url": null, "website_url": "https://www.howo.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26126914467004002"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1395914202391930_6419056375602968618_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgRj9XXkopMQ7kNvwHlEiAF&_nc_oc=AdreZrFVUBmnQvcXlW5hzmIqmR6liYt9Ei4_Hp5ePyPIx_1T14o6mJeKE-_OKNiywWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7NJNtB12swb3M_bxU547OTlBa6YXfEk-TsWTMAzZZoQ&oe=6A67462D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "THZZLS", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1680216014, "lastRevision": {"nodes": [{"id": "5785074554947959", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicat
t=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpwlXstLKlcyMhaDoTxJzMpOFv5PUdWvIiu7K8zc5SRg&oe=6AB932B4"}]}, "id": "1403661101191352", "locale": "en_US", "screenshots": [{"file_name": "ImagenSala_01.png", "id": "26664213853251275", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618910_26664213866584607_569656575490002276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbBuCs-St3kQ7kNvwEjSOxN&_nc_oc=AdqDhmjNfm23gip8RwHP6Am3qu7PHAyyNFuUscrhdwXw8Dz6iwsnrGZ5gfECHm-T3mk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4a66xRqqy5bv1Uxy5nWaRR_LvetGpG7Vk2b8rleRk5w&oe=6AB92E0B"}, {"file_name": "ImagenSala_04.png", "id": "844014195413530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_844014198746863_773395997246473056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbIXLDidDC8Q7kNvwFj3A2K&_nc_oc=AdpVAjLAbVUFfIFMV1mUl2jR5OSJ1B2du03EwTvrp6PtILUdSMJitv6KzD6e-yAdZcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaroU-5dhNMDgzNl5qAOmPDS2CmqSbVx_L26tShlAPjw&oe=6AB93677"}, {"file_name": "ImagenSala_02.png", "id": "1510688410721338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618910_1510688414054671_2337637441565856707_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmZjB_kqyQsQ7kNvwECNsJ6&_nc_oc=AdqtbDE3Xb90dVDk2Kz1TGfMNEpXys_MHk52TOAN6vGniRj12sCON__w2jGnEzUyAlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZbTFJhj2lcVZuPy_Am1iPn0_FFRd1dKEeaSI1otap8w&oe=6AB90D4D"}, {"file_name": "ImagenSala_03.png", "id": "1311820456951057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499625099_1311820460284390_1370022699024819842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjZPuMhRR3QQ7kNvwH6KgyF&_nc_oc=AdqcTWYQ-hoQeH4DfC4C1pVAuB0VpKHfj2VCubrMVIHCvMRquZRYSMe6xNWM_NawuAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGiLC2TaUkoBqp0kjDtiZcHoxkI2kGLWZLESUFa_3FBw&oe=6AB90C93"}, {"file_name": "ImagenSala_05.png", "id": "811183978481526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_811183981814859_5845052100227120683_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXVcnpA2ElcQ7kNvwHQfjnR&_nc_oc=AdrwrcwnI0iJnGz_nZX_AN2UyiruzENRK6TKyGQ5-ErJJ__ctj9AHiUD4WuHAeVKjwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbvUALUWunX9-uhkTSj3jtCL0OF5e1LGmrSwn-IUHDFA&oe=6AB91C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo-3_grande.png", "id": "909295992195106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507845837_909295995528439_7128580231363248145_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1uziqhPgZ8Q7kNvwFsumJb&_nc_oc=Adov5Kf6vgDiZqBGgO5FKJNPgh0mmnhDNeZBIACboykkdhobYVJsSfxSnE4QdUc2WXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd5mde5LSm9R4zvhuteDbDPjDEQgaJjKs4jUlAMArvIQ&oe=6AB91E13"}, "display_name": "Escape the Urban Underground.", "keywords": ["EscapeRoom", "Puzzle", "Mystery", "Atmospheric", "Thriller"], "long_description": "**Welcome to the Shadows**\n\nEscape the Urban Underground is a terrifying, immersive VR escape room set in a forgotten subway station, cut off from the world for decades. A horrific murder has taken place on its decaying platforms, but you will soon discover that you are not alone.\n\n{1416594846894233}\n\n**Choose Your Challenge**\n\nTake on the original 60-Minute Challenge: connect the clues, solve the murder and find your way out before time runs out in a single, intense session.\n\nOr choose Relaxed Mode, with no overall time limit. Automatic checkpoints save your progress, and the Continue option lets you leave the game and resume your investigation later without losing your saved progress. You do not have to complete the experience in one session.\n\n{2333586823832845}\n\n**Hands-on Puzzles Designed for VR**\n\nExplore the station, carefully examine objects up close and physically interact with an unsettling environment built for virtual reality. Restore power to rusted transit terminals, decipher geometric security panels and make your way through claustrophobic train cars filled with debris. Every puzzle calls for hands-on logic and keen observation.\n\n{869995348990087}\n\n**Uncover the Truth**\n\nEvery corner may hide another clue. Observe, experiment and connect the pieces to discover what really happened. The murder is only the beginning.", "short_description": "Escape the Urban Underground delivers a terrifying, highly immersive VR escape room experience that will push your mind to the limit. Deep beneath the bustling city lies a forgotten subway station, sealed off from the world. A gruesome murder has just taken place on these decaying platforms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overfuture.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OverFuture", "support_website_url": "https://overfuture.dev/contacto/", "website_url": "https://overfuture.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38376442085333834"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1001086535722933_1493519659701007075_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fe
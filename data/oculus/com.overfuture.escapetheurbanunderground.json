nc_oc=Adr2cnOiZMtJYA5GTV3Fn6V7L3eUdearEAOJZP8s0oOgfxOhNAHuNXakW_d-OKQJkoc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WhhPlAajrvYi-sn6wboNZ-5D8SEQBkJRqiNpnXzKhSg&oe=6A22F9D3"}, {"file_name": "ImagenSala_05.png", "id": "811183978481526", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619704_811183981814859_5845052100227120683_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01ozllSSnZkQ7kNvwFK0Pro&_nc_oc=AdqZf_WM8KEUqclq6htcr0Y8xXI_uizglEtEwsc2YBdMBr2ICXIS6rVK2ciSvvrHKkg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85TzJJmGWlj55sO5tfduO6aJ3fIoehqUaB-KJeQIP6-w&oe=6A22D16B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo-2.png", "id": "1524063575730199", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825470_1524063582396865_3412514777610159337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q8dm4oXmtEQ7kNvwErwpGH&_nc_oc=AdqguIdMhHNen5dqV9eV_SSL_AZ60S5SZpTrnw8vZgAF92v2zzFH0cP22XUYgBfWpwg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bSANKJ672BQcADOlOkINpDuM46uXoloSKwPIb-46jLQ&oe=6A22F0C2"}, "display_name": "Escape the Urban Underground.", "keywords": ["EscapeRoom", "Puzzle", "Mystery", "Atmospheric", "Thriller"], "long_description": "**Welcome to the Shadows**\n\nEscape the Urban Underground delivers a terrifying, highly immersive VR escape room experience that will push your mind to the limit. Deep beneath the bustling city lies a forgotten subway station, sealed off from the world for decades. A gruesome murder has just taken place on these decaying platforms, but you quickly realize you are not alone. Unsettling paranormal anomalies and strange supernatural occurrences are bleeding into reality around you.\n\n\n\n**The Single-Session Challenge**\n\nThis is a pure, unadulterated escape challenge that tests your nerves. Designed to be beaten in a single, intense run lasting between 30 and 60 minutes, this game features absolutely no save points and no checkpoints. Once you enter the station, the clock starts ticking. You must connect the clues, solve the murder, and find your way out in one breathless attempt.\n\n**Tactile VR Puzzles**\n\nInteract closely with an eerie environment built exclusively for Virtual Reality. You will need to carefully investigate the scene, restore power to rusted transit terminals, hack cryptic geometric security panels, and navigate through debris-filled, claustrophobic train cars. Every puzzle requires hands-on logic, sharp observation, and quick thinking.\n\n\n**Face the Unknown**\n\nFlickering lights, distorted audio, and a looming sense of dread make every shadow a threat. Can you keep your cool under pressure, or will you become another permanent ghost of the urban underground?", "short_description": "Step into the darkness of Escape the Urban Underground, a tense VR escape room set in an abandoned subway station. A gruesome murder has just occurred, and strange, paranormal forces are at play. You have 30 to 60 minutes to solve complex puzzles and uncover the truth. Beware: there are no save points. You must survive, solve the mystery, and escape in a single, heart-pounding session. Can you beat the clock before the station claims you too? Dare to enter the underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overfuture.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OverFuture", "support_website_url": "https://overfuture.dev/contacto/", "website_url": "https://overfuture.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35612162285095175"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823837_1630886894809143_4196990064000861708_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwHPrNr52h4Q7kNvwE21sKd&_nc_oc=Adq8ZzbYiQfjk6y7OfQ3-SuG-BOp8L5w9-FUGBx-sjNDZYXaReafODQ9i02o8iU4syc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tqC53G8m7vfoi2va7fD-OfYePIXlCb9K19Uwn05k4Mw&oe=6A22DC66"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape the Urban Underground.", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1779987240, "lastRevision": {"nodes": [{"id": "35612162355095168", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "35612162231761847", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1180013304210755"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "ImagenPrincipalCuadrada.png", "id": "1630886888142477", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823837_1630886894809143_4196990064000861708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwHPrNr52h4Q7kNvwE21sKd&_nc_oc=Adq8ZzbYiQfjk6y7OfQ3-SuG-BOp8L5w9-FUGBx-sjNDZYXaReafODQ9i02o8iU4syc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZWP0
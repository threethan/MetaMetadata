w&oe=6AB92E0B"}, {"file_name": "ImagenSala_04.png", "id": "844014195413530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_844014198746863_773395997246473056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbIXLDidDC8Q7kNvwFj3A2K&_nc_oc=AdpVAjLAbVUFfIFMV1mUl2jR5OSJ1B2du03EwTvrp6PtILUdSMJitv6KzD6e-yAdZcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaroU-5dhNMDgzNl5qAOmPDS2CmqSbVx_L26tShlAPjw&oe=6AB93677"}, {"file_name": "ImagenSala_02.png", "id": "1510688410721338", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618910_1510688414054671_2337637441565856707_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmZjB_kqyQsQ7kNvwECNsJ6&_nc_oc=AdqtbDE3Xb90dVDk2Kz1TGfMNEpXys_MHk52TOAN6vGniRj12sCON__w2jGnEzUyAlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZbTFJhj2lcVZuPy_Am1iPn0_FFRd1dKEeaSI1otap8w&oe=6AB90D4D"}, {"file_name": "ImagenSala_03.png", "id": "1311820456951057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499625099_1311820460284390_1370022699024819842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjZPuMhRR3QQ7kNvwH6KgyF&_nc_oc=AdqcTWYQ-hoQeH4DfC4C1pVAuB0VpKHfj2VCubrMVIHCvMRquZRYSMe6xNWM_NawuAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGiLC2TaUkoBqp0kjDtiZcHoxkI2kGLWZLESUFa_3FBw&oe=6AB90C93"}, {"file_name": "ImagenSala_05.png", "id": "811183978481526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_811183981814859_5845052100227120683_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXVcnpA2ElcQ7kNvwHQfjnR&_nc_oc=AdrwrcwnI0iJnGz_nZX_AN2UyiruzENRK6TKyGQ5-ErJJ__ctj9AHiUD4WuHAeVKjwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbvUALUWunX9-uhkTSj3jtCL0OF5e1LGmrSwn-IUHDFA&oe=6AB91C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo-2.png", "id": "1524063575730199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1524063582396865_3412514777610159337_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeCP8wNMiGwQ7kNvwEFE01v&_nc_oc=AdqSeoLoMTYXVF7VrmKvnTw5tAOtWKXnPy8IdmbtMQ353iki0NOZaSTWAFhJJbRxtZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdGjmKrxtG9xytBw10g0vkgfrfqJLkxZ8em0AOL9dupA&oe=6AB93BC2"}, "display_name": "Escape the Urban Underground.", "keywords": ["EscapeRoom", "Puzzle", "Mystery", "Atmospheric", "Thriller"], "long_description": "**Welcome to the Shadows**\n\nEscape the Urban Underground delivers a terrifying, highly immersive VR escape room experience that will push your mind to the limit. Deep beneath the bustling city lies a forgotten subway station, sealed off from the world for decades. A gruesome murder has just taken place on these decaying platforms, but you quickly realize you are not alone. Unsettling paranormal anomalies and strange supernatural occurrences are bleeding into reality around you.\n\n\n\n**The Single-Session Challenge**\n\nThis is a pure, unadulterated escape challenge that tests your nerves. Designed to be beaten in a single, intense run lasting between 30 and 60 minutes, this game features absolutely no save points and no checkpoints. Once you enter the station, the clock starts ticking. You must connect the clues, solve the murder, and find your way out in one breathless attempt.\n\n**Tactile VR Puzzles**\n\nInteract closely with an eerie environment built exclusively for Virtual Reality. You will need to carefully investigate the scene, restore power to rusted transit terminals, hack cryptic geometric security panels, and navigate through debris-filled, claustrophobic train cars. Every puzzle requires hands-on logic, sharp observation, and quick thinking.\n\n\n**Face the Unknown**\n\nFlickering lights, distorted audio, and a looming sense of dread make every shadow a threat. Can you keep your cool under pressure, or will you become another permanent ghost of the urban underground?", "short_description": "Step into the darkness of Escape the Urban Underground, a tense VR escape room set in an abandoned subway station. A gruesome murder has just occurred, and strange, paranormal forces are at play. You have 30 to 60 minutes to solve complex puzzles and uncover the truth. Beware: there are no save points. You must survive, solve the mystery, and escape in a single, heart-pounding session. Can you beat the clock before the station claims you too? Dare to enter the underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overfuture.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OverFuture", "support_website_url": "https://overfuture.dev/contacto/", "website_url": "https://overfuture.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35612162285095175"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2114859666046683"}, {"status": "PUBLISHED", "id": "1606892191041128"}, {"status": "PUBLISHED", "id": "941600212223182"}, {"status": "PUBLISHED", "id": "1693350908535856"}, {"status": "PUBLISHED", "id": "1534083684972059"}]}, "baseline_offer": {"id": "1534083684972059"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2114859666046683"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38236611132650264", "version": "1.2"}, "id": "3016977871841135", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35612162231761847", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38236611132650264"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3016977871841135"}]}, "change_log": "Major update for Meta Quest\r\n - Added 60-Minute Challenge and Relaxed Mode.\r\n - Added checkpoint saving and Continue, with improved progress restoration.\r\n - Improved the interactive hint system.\r\n - Fixed several checkpoint and progression issues, including CP03/CP04 and room-exit restoration.\r\n - Improved game settings and volume persistence between sessions.\r\n - Updated the ending/epilogue.\r\n - Expanded language support and subtitles: English: interface, audio and subtitles, Spanish: interface, audio and subtitles, French, German and Simplified Chinese: interface and subtitles\r\n - Updated Meta Quest controls: the left Menu button now opens/closes Options, and R3 recalibrates player height  instantly.\r\n - Updated the in-game controller tutorial to match the new Quest controls.\r\n - Improved Quest-specific XR compatibility, stability and graphics configuration.\r\n - General fixes and polish across gameplay, progression and VR interaction.", "created_date": 1789039342, "id": "38236611132650264", "version": "1.2", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35612162231761847", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38236611132650264"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3016977871841135"}]}, "change_log": "This is one of the biggest updates to the escape room. We've heard your requests, players. Many improvements have been made to gameplay and the ability to obtain better clues for each escape room.\n- All three escape rooms now offer both text and audio clues.\n- A new options panel with various settings.\n- Updated and improved graphics.\n- New environments and puzzles have been added to enhance the experience.\n- The time limit has been set to 60 minutes per session.", "created_date": 1781536443, "id": "36280435048267892", "version": "1.1", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35612162231761847", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38236611132650264"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3016977871841135"}]}, "change_log": "First final version with all room content.", "created_date": 1779957463, "id": "35829322503379151", "version": "0.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
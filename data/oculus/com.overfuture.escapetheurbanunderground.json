nc_ohc=dVEnQzzVqcUQ7kNvwGsZ816&_nc_oc=Adpy4BEkxoCi6uQM9QVRTneRJO04wEMuBQYEI2hDNsW2ylNg-1x3akGJQxi6Ot_hMWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a7a-d6CgyWHJZ6_x-tKPd0Y4OZDmox9TrsTR5Lmhqag&oe=6A3AA2B4"}]}, "id": "996951823261607", "locale": "en_US", "screenshots": [{"file_name": "ImagenSala_01.png", "id": "26664213853251275", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618910_26664213866584607_569656575490002276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuCI2qbgo8IQ7kNvwEwft7q&_nc_oc=Adr_VSTHz-IlGJKUM0s8e4Eftm7hZEIhH_6h6vHISEgmcjZFx__gHkH520Bx8qtq-A8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-ZxVlzm6B1pbu7M5CCeKjH6TCyV7eSZ4-6uPRQgDpiQ&oe=6A3A9E0B"}, {"file_name": "ImagenSala_04.png", "id": "844014195413530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622211_844014198746863_773395997246473056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN0Tgkul0O4Q7kNvwGCauwS&_nc_oc=Adpmpu3OqQUWIKKZOYJvWKPbVMceppnckke2kyQv9FU809T1XxHQZA98vOAFjkzFKuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NJPRxFiEWhO8zeABY43-5bb3NGHIngc8D1kIB1Tj7xQ&oe=6A3AA677"}, {"file_name": "ImagenSala_02.png", "id": "1510688410721338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618910_1510688414054671_2337637441565856707_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNpUOs-dl0kQ7kNvwHfGJA1&_nc_oc=AdpynLMQRCoAfBcKebEed3j6lgwJftW73VSdVrF8C-00-8cidw8CI28zGJEc9w3qBTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7GBCw-zWAA7DxNYJ0IbsMFiQ4Y2CK-yvgClVrk9HrDg&oe=6A3AB58D"}, {"file_name": "ImagenSala_03.png", "id": "1311820456951057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625099_1311820460284390_1370022699024819842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP_IZj7i7k0Q7kNvwFD5UnK&_nc_oc=Adp8PsABSOWT66Jya5EGOjpoQ8BlEmallSZcA1U1LQXSB-6opqXPwgzLt6yjDtxTzvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eL-1rAQlodDZs_Haz1Kp9dbeJjCE990wjhXd39G8giA&oe=6A3AB4D3"}, {"file_name": "ImagenSala_05.png", "id": "811183978481526", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619704_811183981814859_5845052100227120683_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2fZAEfRjt0Q7kNvwF3m74p&_nc_oc=AdqDRHp-i7ScO_h3Lbo5pHLO-TRJtA4nG4kyO-sHhjQ0CujY__pf2_uQFSmGPifUbhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j-YflljdGC0ZirOci2cUmMvMNr7vYnA46VG-sLL4HzA&oe=6A3A8C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo-3_grande.png", "id": "909295992195106", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507845837_909295995528439_7128580231363248145_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH3yvPuUe_MQ7kNvwEiojjk&_nc_oc=Adp3M5hujaGCoj-4b0XSzgdun8UujSlROyAII5A8YXpOgMn1Kx80PnE0a7tfiYiPDuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PxURTRpv2vzIO0yzIFqobwxQRVKrOA4ijuEt8rutbhQ&oe=6A3A8E13"}, "display_name": "Escape the Urban Underground.", "keywords": ["EscapeRoom", "Puzzle", "Mystery", "Atmospheric", "Thriller"], "long_description": "**Welcome to the Shadows**\n\nEscape the Urban Underground delivers a terrifying, highly immersive VR escape room experience that will push your mind to the limit. Deep beneath the bustling city lies a forgotten subway station, sealed off from the world for decades. A gruesome murder has just taken place on these decaying platforms, but you quickly realize you are not alone.\n{1416594846894233}\n\n\n**The Single-Session Challenge**\n\nThis is a pure, unadulterated escape challenge that tests your nerves. Designed to be completed in a single, intense run with a maximum time of 60 minutes. Users who have already enjoyed the full experience have taken between 120 and 240 minutes to complete it, over multiple attempts., this game features absolutely no save points and no checkpoints. Once you enter the station, the clock starts ticking. You must connect the clues, solve the murder, and find your way out in one breathless attempt.\n{2333586823832845}\n\n\n**Tactile VR Puzzles**\n\nInteract closely with an eerie environment built exclusively for Virtual Reality. You will need to carefully investigate the scene, restore power to rusted transit terminals, hack cryptic geometric security panels, and navigate through debris-filled, claustrophobic train cars. Every puzzle requires hands-on logic, sharp observation, and quick thinking.\n{869995348990087}\n\n**Face the Unknown**\n\nFlickering lights, distorted audio, and a looming sense of dread make every shadow a threat. Can you keep your cool under pressure, or will you become another permanent ghost of the urban underground?\n\n\n", "short_description": "Step into the darkness of Escape the Urban Underground, a tense VR escape room set in an abandoned subway station. A gruesome murder has just occurred, and strange, paranormal forces are at play. You have 60 minutes to solve complex puzzles and uncover the truth. Beware: there are no save points. You must survive, solve the mystery, and escape in a single, heart-pounding session. Can you beat the clock before the station claims you too? Dare to enter the underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://overfuture.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "OverFuture", "support_website_url": "https://overfuture.dev/contacto/", "website_url": "https://overfuture.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
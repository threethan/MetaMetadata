nc_ss=7f30f&oh=00_AQXCae5wVCZP4-JhmS7Kx2z7rXPvaBmU6duNH-rhBNDA6w&oe=6B104B6A"}, {"file_name": "KickOff_Screenshot_3_Alpine_2560x1440_1.png", "id": "2413240479505277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_2413240482838610_6455893706944364922_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuTuCVrITxAQ7kNvwFXFth8&_nc_oc=AdqMMNaHxcOaVFHHee0pS_HiFEENREam9uZJIG1TTsRJiJX72YHQ0EfW3zecPUPF5Hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6ZZbr9xSZ_rNTsOd7_tq28k6DXQi9x29XKJE23ao7ZQ&oe=6B104F23"}, {"file_name": "KickOff_Screenshot_2_Rooftop_2v2_2560x1440_1.png", "id": "1822753652380927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820863_1822753655714260_829519199112885881_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGRfjJ2cZyUQ7kNvwHgzT5T&_nc_oc=AdqQKbon2S_F1blvNGXhA-cmtQx-TpNo1lmoPtESVdPB2OOmbGuGVkEDdM2nUaSjmlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1-Gp5ejntJ1ndt6qkJN86b6Z0B0n5gP5rRA9UjutQoQ&oe=6B103ADD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KickOff", "keywords": [], "long_description": "KickOff is VR football where your own feet do the work. Every touch, pass, tackle and shot comes from your real leg movement, with ball physics that react to how hard and where you strike it.\n\nPLAY ONLINE\nHost or join matches with friends using a lobby code, browse open lobbies, or invite people straight from your friends list. Play everything from small-sided games up to full 7v7.\n\nMAPS\nTake your game across a wide range of pitches:\n\nAn indoor training dome\nA rooftop high above the city\nCity Scape streets\nRio de Janeiro\nThe Box\nA full-size stadium\nThe packed 7v7 Arena\nA mountain pitch in the Alps\nAn arcade map full of mini-games\n\nTRAIN AND IMPROVE\nWarm up solo in the training dome to practise your touch, passing and finishing before heading online.\n\nTALK TO YOUR TEAM\nBuilt-in voice chat with push-to-talk and proximity options keeps your team organised, or switch it off whenever you want.\n\nMAKE IT YOURS\nEarn coins and kit yourself out with boots, gloves, hats and more, and show off rare badges.\n\nCAPTURE THE MOMENT\nGrab the in-game camera to snap photos of your best moments, saved straight to your Quest gallery.\n\nKickOff is regularly updated with new maps, items and features. Lace up your boots and get on the pitch.", "short_description": "Step onto the pitch and play football the way it\u2019s meant to be played: with your own feet. KickOff is a fast, physics-driven VR football game where you dribble, pass, tackle and shoot with real leg movement. Jump into online matches with friends or players around the world, from small-sided games to full 7v7. Play across stadiums, rooftops, city streets and mountain pitches, chat in-game, and kit yourself out with boots, gloves and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kickoff-ranked.turboriout.workers.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "KickOff", "support_website_url": null, "website_url": "https://claude.ai/artifact/53bwynqsxdCBCWyGiKM15v", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29566319022981133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.co
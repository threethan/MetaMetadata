id=6e7a0a&_nc_ohc=sGRfjJ2cZyUQ7kNvwHgzT5T&_nc_oc=AdqQKbon2S_F1blvNGXhA-cmtQx-TpNo1lmoPtESVdPB2OOmbGuGVkEDdM2nUaSjmlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1-Gp5ejntJ1ndt6qkJN86b6Z0B0n5gP5rRA9UjutQoQ&oe=6B103ADD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KickOff", "keywords": [], "long_description": "KickOff is VR football where your own feet do the work. Every touch, pass, tackle and shot comes from your real leg movement, with ball physics that react to how hard and where you strike it.\n\nPLAY ONLINE\nHost or join matches with friends using a lobby code, browse open lobbies, or invite people straight from your friends list. Play everything from small-sided games up to full 7v7.\n\nMAPS\nTake your game across a wide range of pitches:\n\nAn indoor training dome\nA rooftop high above the city\nCity Scape streets\nRio de Janeiro\nThe Box\nA full-size stadium\nThe packed 7v7 Arena\nA mountain pitch in the Alps\nAn arcade map full of mini-games\n\nTRAIN AND IMPROVE\nWarm up solo in the training dome to practise your touch, passing and finishing before heading online.\n\nTALK TO YOUR TEAM\nBuilt-in voice chat with push-to-talk and proximity options keeps your team organised, or switch it off whenever you want.\n\nMAKE IT YOURS\nEarn coins and kit yourself out with boots, gloves, hats and more, and show off rare badges.\n\nCAPTURE THE MOMENT\nGrab the in-game camera to snap photos of your best moments, saved straight to your Quest gallery.\n\nKickOff is regularly updated with new maps, items and features. Lace up your boots and get on the pitch.", "short_description": "Step onto the pitch and play football the way it\u2019s meant to be played: with your own feet. KickOff is a fast, physics-driven VR football game where you dribble, pass, tackle and shoot with real leg movement. Jump into online matches with friends or players around the world, from small-sided games to full 7v7. Play across stadiums, rooftops, city streets and mountain pitches, chat in-game, and kit yourself out with boots, gloves and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kickoff-ranked.turboriout.workers.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "KickOff", "support_website_url": null, "website_url": "https://claude.ai/artifact/53bwynqsxdCBCWyGiKM15v", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29566319022981133"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2192722994652109"}]}, "baseline_offer": {"id": "2192722994652109"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795470960, "status": "PUBLISHED", "id": "2192722994652109"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29647197408226627", "version": "1.0.87"}, "id": "2598869790578495", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29511818048431231", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29647197408226627"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2598869790578495"}]}, "change_log": "New: credit bundles (10, 25 and 60) in the Shop, wired earbuds, bar scarves and free facial hair in the Locker. Dunk power now depends on how hard you hit the ball, lighter touches when dribbling at pace, smoother loading screen, the mic icon and green name now stay on while someone talks, and fixed item pictures in the Locker.", "created_date": 1795815882, "id": "29647197408226627", "version": "1.0.87", "version_code": 87, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29511818048431231", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29647197408226627"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2598869790578495"}]}, "change_log": "Voice chat update: kicked players are now removed from voice chat straight away. New automatic voice chat moderation in practice lobbies and public matches - offensive language gets a voice chat ban that gets longer each time.", "created_date": 1795729619, "id": "29635303172749384", "version": "1.0.77", "version_code": 77, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29511818048431231", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29647197408226627"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2598869790578495"}]}, "change_log": null
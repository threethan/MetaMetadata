&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIrFHwjG3eQQ7kNvwEXZAUE&_nc_oc=Adr2VetQS0N3l98CxgbznBRRl5JPrvwqRL2dxjt2qMVPsHnhwaiRpinrpkn6lwqvA3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5xJFuefkoglUjkKcD_uonKvxj6MqJFUICPlgdLPftxQ&oe=6A6B3A7D"}, {"file_name": "03-ambience-menu.png", "id": "2536833440114693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314657_2536833443448026_3409075942239099968_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxUtzyCX_mIQ7kNvwHqb40E&_nc_oc=AdoRNnPV_0lOEhnLefCHgOvcWRcvMR65En8AMRGiUE3sKs51DIDnyHLMizMXQh1_s_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSzCxpLYim_DEtZPPnKE2XABFrrAYQ0YpvgcOOa471KA&oe=6A6B60A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-meta-hero-FINAL-2560.png", "id": "1426849082607264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1426849085940597_808250027840737716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufCs9jOUUeAQ7kNvwGcLbjQ&_nc_oc=AdqCB74Td_588b4LNEIzli7higzqxqT_l4jVQyDIrf0uI9Mt6JjTRD3Mh0rCYm6m590&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3z4AwK7UrX9mg-05530TL0TPhMbLKevig0rvICiqKow&oe=6A6B4045"}, "display_name": "AuraPlay \u2014 Mixed Reality Cinema", "keywords": ["cinema", "movies", "video", "theater", "media"], "long_description": "Your movies deserve more than a flat rectangle.\n\nAuraPlay turns the space around you into a personal cinema \u2014 a screen as big as you like, floating in your own room, wrapped in light that moves with every frame. It's the ambient magic of a high-end home cinema, built into your headset. No wires, no dark room required.\n\n\u2022 Giant virtual screen \u2014 place it on your real wall or float it in space. It stays exactly where you put it.\n\u2022 AuraLight \u2014 our signature reactive lighting reads the colour of every scene and casts it onto your real walls and ceiling in real time. Sunsets, explosions, neon streets \u2014 your room lives inside the movie. Fully adjustable, or off for a pure blackout cinema.\n\u2022 Plays your own videos \u2014 MP4, MKV and more, with automatic multi-language subtitle detection and support for your own subtitle files.\n\u2022 True 3D movies \u2014 side-by-side and over-under, with comfort controls for easy long sessions.\n\u2022 Tune everything \u2014 brightness, screen size, aura intensity and colour vividness, with one-tap ambience presets.\n\u2022 Comfortable mixed reality \u2014 passthrough keeps you aware of your real room.\n\nNo subscriptions. No accounts. No data collected. Just your films, your room, and a cinema that finally feels alive.\n\nTap \"Play Sample\" to see it in action instantly.\n\nSample footage shown in screenshots courtesy of the Blender Foundation (blender.org), licensed under CC-BY.\n\n", "short_description": "Turn any room into a private cinema. AuraPlay plays your movies on a giant virtual screen \u2014 and casts living, colour-reactive light onto your real walls and ceiling with every frame. Warm firelight in a sunset scene, cool blue in a storm: your room lives inside the film. Play your own videos with subtitles and 3D, in comfortable passthrough mixed reality. No accounts, no subscriptions, no data collected. Tap \"Play Sample\" to see it instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
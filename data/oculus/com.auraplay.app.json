sid=6e7a0a&_nc_ohc=UxUtzyCX_mIQ7kNvwHqb40E&_nc_oc=AdoRNnPV_0lOEhnLefCHgOvcWRcvMR65En8AMRGiUE3sKs51DIDnyHLMizMXQh1_s_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSzCxpLYim_DEtZPPnKE2XABFrrAYQ0YpvgcOOa471KA&oe=6A6B60A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-meta-hero-FINAL-2560.png", "id": "1426849082607264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1426849085940597_808250027840737716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufCs9jOUUeAQ7kNvwGcLbjQ&_nc_oc=AdqCB74Td_588b4LNEIzli7higzqxqT_l4jVQyDIrf0uI9Mt6JjTRD3Mh0rCYm6m590&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3z4AwK7UrX9mg-05530TL0TPhMbLKevig0rvICiqKow&oe=6A6B4045"}, "display_name": "AuraPlay \u2014 Mixed Reality Cinema", "keywords": ["cinema", "movies", "video", "theater", "media"], "long_description": "Your movies deserve more than a flat rectangle.\n\nAuraPlay turns the space around you into a personal cinema \u2014 a screen as big as you like, floating in your own room, wrapped in light that moves with every frame. It's the ambient magic of a high-end home cinema, built into your headset. No wires, no dark room required.\n\n\u2022 Giant virtual screen \u2014 place it on your real wall or float it in space. It stays exactly where you put it.\n\u2022 AuraLight \u2014 our signature reactive lighting reads the colour of every scene and casts it onto your real walls and ceiling in real time. Sunsets, explosions, neon streets \u2014 your room lives inside the movie. Fully adjustable, or off for a pure blackout cinema.\n\u2022 Plays your own videos \u2014 MP4, MKV and more, with automatic multi-language subtitle detection and support for your own subtitle files.\n\u2022 True 3D movies \u2014 side-by-side and over-under, with comfort controls for easy long sessions.\n\u2022 Tune everything \u2014 brightness, screen size, aura intensity and colour vividness, with one-tap ambience presets.\n\u2022 Comfortable mixed reality \u2014 passthrough keeps you aware of your real room.\n\nNo subscriptions. No accounts. No data collected. Just your films, your room, and a cinema that finally feels alive.\n\nTap \"Play Sample\" to see it in action instantly.\n\nSample footage shown in screenshots courtesy of the Blender Foundation (blender.org), licensed under CC-BY.\n\n", "short_description": "Turn any room into a private cinema. AuraPlay plays your movies on a giant virtual screen \u2014 and casts living, colour-reactive light onto your real walls and ceiling with every frame. Warm firelight in a sunset scene, cool blue in a storm: your room lives inside the film. Play your own videos with subtitles and 3D, in comfortable passthrough mixed reality. No accounts, no subscriptions, no data collected. Tap \"Play Sample\" to see it instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2085969279001463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "951826931217156"}]}, "baseline_offer": {"id": "951826931217156"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784469600, "status": "PUBLISHED", "id": "951826931217156"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2096444411287283", "version": "1.3"}, "id": "1518726739731284", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2096444411287283"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "What's new\n\nHome Cinema\n\nAuraPlay's first virtual environment\n\nI've spent some time designing a home cinema environment and would love you to try it out. Open the menu, click on Spaces, and select Home Cinema. Point at any seat and pull the trigger to glide into it. You can choose any seat - front row, middle row or back row. The environment lights dim automatically when your film starts and there's a Room Brightness slider in the Spaces tab in settings screen. Passthrough is still the default and you can return to it any time by selecting it again in the Spaces tab. The Spaces are a work in progress and the cinema space is the first one. The furniture and lighting are still evolving and may change on a later update.\n\nStream from your PC or NAS (DLNA)\n\nNo more need to copy films onto the headset. Open the menu, click on source > Select and Play > Network, and pick your media server. Browse your library on the poster wall and play straight over your network.\n\nOpen the menu from anywhere.\n\nPress B (right controller) or Y (left) to bring up the settings panel instantly. The settings panel and playback bar now float freely in VR space. Grab the title bar / handle and hold the trigger to move them anywhere you like.\n\nSmarter playback bar.\n\nWhen a film starts, the controls appear just under the screen, then fade out of your way. Tap the screen at any time to bring them back.\n\nTrue mute\n\nTap the speaker icon to mute instantly. unlike turning the volume to zero, the also silences the film in Quest screen recordings, so demo clips won't carry copyrighted movie audio.\n\nAlso included (from 1.2, if you're coming from an earlier build)\n\nAccurate controllers\n\nYour real Meta controllers now appear correctly in-headset with the right model for whichever controllers you're holding, and they are properly aligned to your hands.\n\nCorrect aspect ratio\n\nFilms are no longer stretched to fit. 4:3 shows and cinemascope films now keep their proper aspect ratio. with proper letter boxing.\n\nContinue watching\n\nAuraPlay now remembers where you stopped and picks up right where you left off.\n\nSharper 3D and cleaner rendering\n\nA depth buffer fix resolved see through geometry and improved all 3D content.\n\nRicher AuraLight and full blackout\n\nMore control over the reactive room glow plus a total black void when you want zero ambient light.\n\nPlus a batch of other smaller fixes across both releases. Resume position reliability, long filenames no longer overflowing, and a cleaner splash screen.", "created_date": 1784823277, "id": "2096444411287283", "version": "1.3", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2096444411287283"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "What's New\n\nYour real controllers, and a much better picture\n\nAuraPlay now shows your actual Meta controllers while you watch.  Buttons, thumbstick and triggers are all there, lined up exactly with the controllers you're holding. They come from the headset itself, so they always match whatever controllers you're using.\n\nThis update also brings:\n\nFilms look right - video now keeps its correct shape. 4:3 and cinemascope films are no longer stretched or squashed to fit.\nContinue watching - AuraPlay remembers where you got to and picks up where you left off.\nRicher AuraLight - the glow on your walls is noticeably more colourful and vivid.\nTrue black void mode - dim the room all the way to full darkness for proper cinema blackout.\nImportant fix - resolved a freeze that could occur when switching between several videos in a row.\nSharper, more solid 3D throughout the app.", "created_date": 1784720578, "id": "2095451714719886", "version": "1.2", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2096444411287283"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "v1.1\n\u2022 Correct aspect ratio - widescreen and classic 4:3 films now display in their\n  true shape instead of being stretched\n\n\u2022 Continue watching - films resume where you left off, and your screen stays\n  where you put it between sessions\n\n\u2022 Full blackout mode - dim your room all the way to black for proper cinema\n\n\u2022 Richer, more vivid AuraLight - deeper colours on your walls\n\n\u2022 Fixed a bug where the picture could freeze on the logo after switching\n  between several videos\n\nThank you for the feedback everyone. \n\nMore on the way.\nDave", "created_date": 1784639993, "id": "2094705711461153", "version": "1.1", "version_code": 7, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2096444411287283"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "v1.0.1\r\n\r\n\u2022 Playback controls now work while the menu panel is open\r\n\u2022 Menu and resize buttons are readable in bright rooms and against windows\r\n\u2022 Added QA credit\r\n\r\nThanks to everyone who sent feedback in the first days. Keep it coming.", "created_date": 1784575836, "id": "2094125954852462", "version": "1.0.1", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2096444411287283"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": null, "created_date": 1784312792, "id": "2091662355098822", "version": "1.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
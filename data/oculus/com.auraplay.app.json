_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF-fIZGB38685K01Mb0cP0Aq44bdbINIJCg_0BDeIlbg&oe=6A91882E"}, {"file_name": "04-cosmos-vortex.png", "id": "2184755745416474", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499314667_2184755748749807_172179952902276072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIwRbEbQdrgQ7kNvwF-1qlS&_nc_oc=AdrK2gaF9dX7NW06uDl_nLXrdQneUnF5lozg1bCKvEbZHr0rK6qZtFRRhdQ5QG1TyXI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-0PAdLftZbuj3hhvtYFzovc9WS4D_sfxLb8-OMKEgpA&oe=6A91760B"}, {"file_name": "05-tears-of-steel-neon.png", "id": "2038739396849277", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823930_2038739400182610_510010168153460579_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-sBxnJzwQgQ7kNvwHpOe3y&_nc_oc=AdqdEVEm2RQNVLr7CrH0Xb8HzcQuD7NCRL6rPygA84qe__7lwg0gViMsW9vSe3MFZq8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbiQTiBJ0PAnNl5Ra3kakPVOwC6z_6J7QoX8haAgpn3w&oe=6A91699D"}, {"file_name": "01-rainbow-fullscreen.png", "id": "1338206735092168", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823790_1338206738425501_8433175912827723432_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9qlynpylyQQ7kNvwEt_GIX&_nc_oc=AdpAZOs6C6fBNhxvOClD9iJnw-GSAs7jj6txT6RPunYU8ooBetwlXJQgXVAg-POzN78&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsFH1JeLO9kvRA6MigT7V_ULdvVAUFEzbI7Z3RhmlRDg&oe=6A9175FD"}, {"file_name": "03-ambience-menu.png", "id": "2536833440114693", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499314657_2536833443448026_3409075942239099968_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqFUARekXzkQ7kNvwGOt0qS&_nc_oc=Ado1Yui3-5mOfkw8j8E-HqACgM3m3D_h5pnZtUaR_Cotywlv_3APg9wPhQN3gcBa9gc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYDM6g0DOiHCqHLc0kSMxJC0bmtcikwQRszePIVDwOOQ&oe=6A9163E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-meta-hero-FINAL-2560.png", "id": "1426849082607264", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825415_1426849085940597_808250027840737716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn-vBFGm83sQ7kNvwHqOK_u&_nc_oc=AdoAN2pHY1CVXXKZ6RzA_ivlDUEeHRB5tVHK8RItgbaB52y39-YcQhk-LUu7rPF0Y9c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNhVm2M1ols0q_dwwFYCA1Jhd6ssa6RGy7jc3PUm3ztw&oe=6A917BC5"}, "display_name": "AuraPlay \u2014 Mixed Reality Cinema", "keywords": ["cinema", "movies", "video", "theater", "media"], "long_description": "Your movies deserve more than a flat rectangle.\n\nAuraPlay turns the space around you into a personal cinema \u2014 a screen as big as you like, floating in your own room, wrapped in light that moves with every frame. It's the ambient magic of a high-end home cinema, built into your headset. No wires, no dark room required.\n\n\u2022 Giant virtual screen \u2014 place it on your real wall or float it in space. It stays exactly where you put it.\n\u2022 AuraLight \u2014 our signature reactive lighting reads the colour of every scene and casts it onto your real walls and ceiling in real time. Sunsets, explosions, neon streets \u2014 your room lives inside the movie. Fully adjustable, or off for a pure blackout cinema.\n\u2022 Plays your own videos \u2014 MP4, MKV and more, with automatic multi-language subtitle detection and support for your own subtitle files.\n\u2022 True 3D movies \u2014 side-by-side and over-under, with comfort controls for easy long sessions.\n\u2022 Tune everything \u2014 brightness, screen size, aura intensity and colour vividness, with one-tap ambience presets.\n\u2022 Comfortable mixed reality \u2014 passthrough keeps you aware of your real room.\n\nNo subscriptions. No accounts. No data collected. Just your films, your room, and a cinema that finally feels alive.\n\nTap \"Play Sample\" to see it in action instantly.\n\nSample footage shown in screenshots courtesy of the Blender Foundation (blender.org), licensed under CC-BY.\n\n", "short_description": "Turn any room into a private cinema. AuraPlay plays your movies on a giant virtual screen \u2014 and casts living, colour-reactive light onto your real walls and ceiling with every frame. Warm firelight in a sunset scene, cool blue in a storm: your room lives inside the film. Play your own videos with subtitles and 3D, in comfortable passthrough mixed reality. No accounts, no subscriptions, no data collected. Tap \"Play Sample\" to see it instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2085969279001463"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "987947910926867"}, {"status": "PUBLISHED", "id": "1752661652735715"}, {"status": "PUBLISHED", "id": "1788293762526193"}, {"status": "PUBLISHED", "id": "951826931217156"}]}, "baseline_offer": {"id": "1752661652735715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "987947910926867"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2119938488937875", "version": "1.6.2"}, "id": "1518726739731284", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2119938488937875"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "What's New in AuraPlay 1.6.2\n\nImmersive 180\u00b0 & 360\u00b0 VR video \n\nPlay your own 180\u00b0 and 360\u00b0 videos and step right inside them. AuraPlay auto-detects the format from the filename, with manual Flat / 180\u00b0 / 360\u00b0 controls and a one-tap Re-center in Settings. Supports 3D (side-by-side and top-bottom) VR video too.\n\nSpatial audio \ufffd\nSound now stays anchored to the screen as you look around, for a far more convincing cinema feel. Turn your head and the audio comes from where the picture is. Toggle it in Settings > Sound.\n\nRedesigned Settings\nThe Settings panel is now smooth-scrolling with roomier, easier-to-read controls, and a new About page tells you all about AuraPlay alongside the credits.\n\nFixes & polish\nVarious stability and playback improvements.", "created_date": 1787145222, "id": "2119938488937875", "version": "1.6.2", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2119938488937875"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "A big visual and performance update - the Grand Auditorium is redesigned, and everything runs smoother.\n\nWhat's new:\n\nRedesigned Grand Auditorium - new deep-navy velvet seats, brick walls, a polished tiled floor, and warmer, more cinematic lighting. It finally feels like a real theatre.\nSmoother performance - reworked the rendering so the cinema environments run noticeably smoother, especially the auditorium. Less judder when you move around or reposition things.\nAntialiasing - much cleaner edges everywhere, particularly on menus and text. No more jagged shimmer when you turn your head.\nMore cinematic default brightness - rooms now start dimmer, the way a cinema should.\nNetwork browsing fix - after playing a film from an SMB / network folder, the Back button now returns you to that folder instead of jumping to Local media.\nClearer volume control - the speaker icon is easier to read at a glance.\nGeneral polish and stability improvements.\n\nWant to play your console or PC on the big screen? AuraPlay Pro adds live HDMI input - plug in a PS5, Xbox, Switch or PC and watch it on the giant virtual screen with AuraLight reacting in real time. Details at auraplayvr.com.\n\nThanks for watching with AuraPlay. If anything's not quite right, email dave@auraplayvr.com - it's made by one person who genuinely wants it working for you.", "created_date": 1786654344, "id": "2114962832768774", "version": "1.6.1", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2119938488937875"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": null, "created_date": 1786537331, "id": "2113752922889765", "version": "1.6.0", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2119938488937875"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "Fixed 3D video playback", "created_date": 1786379406, "id": "2112176399714084", "version": "1.5.10", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2119938488937875"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "USB drive playback, network (SMB/NAS) streaming with encrypted saved logins, and sharper full-resolution 3D \u2014 plus stability fixes.", "created_date": 1786359341, "id": "2111944823070575", "version": "1.5.9", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
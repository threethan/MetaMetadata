7RTP3CynIC52YMyvkje09dX41EhLHaYl7Zq5BJewFag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgZsACxXf9q1m6GwSs9XzXam5rW0_4Tz5ECcEblxoTKA&oe=6AFDC34F"}, {"file_name": "retro.png", "id": "1775463980370978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1775463983704311_7074516360820642469_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdvkFmR2hEMQ7kNvwGJObPd&_nc_oc=AdrtWyNu_R89ANiZu1i0l5xdbHo3nTBgxLgHCVxp4y9fzLxyzvqE-6RdGXggPAPCaT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQktPAAcIM0vh_1QzVPdVsQBNAVgA5856HRevQgzBURkw&oe=6AFDBF6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-cover-landscape-2560x1440-v2.png", "id": "1572402754640791", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1572402761307457_5157960825411766997_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgGWUb23el4Q7kNvwHe1G8E&_nc_oc=Adqj76ls7rbCBUy9OhFH6yq_ThAoeDrMxTvKU8IfC0zF_W6jMh8PRDu4kLWYJZLTM1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU0kpQD88gOeammcTqaPwyLjM5EXyaokJU77d7iu6_Kw&oe=6AFDD60A"}, "display_name": "AuraPlay VR Player", "keywords": ["Cinema", "video", "3D", "Passthrough", "Immersive"], "long_description": "Turn your Meta Quest into a private cinema. Watch films on a giant flat or curved screen in passthrough, or take your seat in four included cinemas: Home, Auditorium, Retro and IMAX-style.\n\n**PREMIUM ENVIRONMENTS**\n\n**Luxury Penthouse:** Watch above the city skyline. Choose Day, Dusk or Night, lower individual blinds and adjust the lighting.\n\n{40372897942301524}\n\n**Alpine Lodge:** Relax beside a crackling fireplace as snow falls outside. Draw the curtains and settle in for movie night.\n\n{1806780697108745}\n\nDownload either premium environment and try it free for 20 minutes. Each room is available as a one-time in-app purchase for \u00a32.99. No subscription required.\n\n**KEY FEATURES**\n\n- Play MP4, MKV, AVI and MOV with native aspect ratios and playback resume.\n- Browse local folders, use compatible USB drives, or stream via SMB, DLNA and free AuraLink for Windows.\n- Watch full-resolution Blu-ray 3D (MVC) at 1080p per eye, Side-by-Side, Over-Under, 180\u00b0 and 360\u00b0 video.\n- Convert 2D films to 3D using AuraLink on your PC.\n- Enjoy head-tracked 5.1/7.1 surround sound with cinema-specific acoustics on compatible titles.\n- AuraLight adds adjustable movie-reactive ambient lighting.\n- Switch audio tracks, adjust supported subtitles and save viewing preferences.\n\nNo subscription or separate AuraPlay account required.\n", "short_description": "Your movies deserve a cinema. AuraPlay turns your Quest 3 into a private theatre, with a giant flat or curved screen in your real room or four virtual cinemas. Enjoy full-resolution Blu-ray 3D at 1080p per eye, head-tracked 5.1/7.1 surround through headphones, cinema room acoustics and dynamic screen lighting. Play locally or stream from your PC or NAS. Your films. Your seat. Your cinema."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
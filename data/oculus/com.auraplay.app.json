sid=6e7a0a&_nc_ohc=YVhQnW27S9kQ7kNvwFJDHuW&_nc_oc=AdpeNrKRDt4FG0TIvTGXehJ7UxyGtoZUZYfFNgVTr4EQPbf3XYFE3xmcBo2AZXN4cMg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdmJbB7muhUMCLbSnL3VhIBi_bMVA4NexqPg5QcV5K0A&oe=6A71F822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-meta-hero-FINAL-2560.png", "id": "1426849082607264", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825415_1426849085940597_808250027840737716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdfQ28jqgtQQ7kNvwFUJhjj&_nc_oc=Adqv2paZ8mt8j0jz404r8YUzuSgS-BZ9HHNpBWTRcRU-XoXPQClxri9FOITM9qWYQZs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdTw3wQOq73b7I9QdsHnZQb83PfzRAfA3zxXBU-5XcwQ&oe=6A71D7C5"}, "display_name": "AuraPlay \u2014 Mixed Reality Cinema", "keywords": ["cinema", "movies", "video", "theater", "media"], "long_description": "Your movies deserve more than a flat rectangle.\n\nAuraPlay turns the space around you into a personal cinema \u2014 a screen as big as you like, floating in your own room, wrapped in light that moves with every frame. It's the ambient magic of a high-end home cinema, built into your headset. No wires, no dark room required.\n\n\u2022 Giant virtual screen \u2014 place it on your real wall or float it in space. It stays exactly where you put it.\n\u2022 AuraLight \u2014 our signature reactive lighting reads the colour of every scene and casts it onto your real walls and ceiling in real time. Sunsets, explosions, neon streets \u2014 your room lives inside the movie. Fully adjustable, or off for a pure blackout cinema.\n\u2022 Plays your own videos \u2014 MP4, MKV and more, with automatic multi-language subtitle detection and support for your own subtitle files.\n\u2022 True 3D movies \u2014 side-by-side and over-under, with comfort controls for easy long sessions.\n\u2022 Tune everything \u2014 brightness, screen size, aura intensity and colour vividness, with one-tap ambience presets.\n\u2022 Comfortable mixed reality \u2014 passthrough keeps you aware of your real room.\n\nNo subscriptions. No accounts. No data collected. Just your films, your room, and a cinema that finally feels alive.\n\nTap \"Play Sample\" to see it in action instantly.\n\nSample footage shown in screenshots courtesy of the Blender Foundation (blender.org), licensed under CC-BY.\n\n", "short_description": "Turn any room into a private cinema. AuraPlay plays your movies on a giant virtual screen \u2014 and casts living, colour-reactive light onto your real walls and ceiling with every frame. Warm firelight in a sunset scene, cool blue in a storm: your room lives inside the film. Play your own videos with subtitles and 3D, in comfortable passthrough mixed reality. No accounts, no subscriptions, no data collected. Tap \"Play Sample\" to see it instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2085969279001463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "951826931217156"}]}, "baseline_offer": {"id": "951826931217156"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784469600, "status": "PUBLISHED", "id": "951826931217156"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2102349087363482", "version": "1.5.4"}, "id": "1518726739731284", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2102349087363482"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "What's new in 1.5.4\r\nNew Grand Auditorium cinema environment\r\nFixed spawning inside the screen when switching environments (now drops you into a proper seat)\r\nRefined seat materials and the Home Cinema", "created_date": 1785418912, "id": "2102349087363482", "version": "1.5.4", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2102349087363482"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "AuraPlay 1.5.3 \u2014 Release Notes\n\n**Version:** 1.5.3 (build 16) \u00b7 Store build (Meta Horizon)\n**File:** `AuraPlay-1.5.3-store-release.apk` (~20 MB, signed, no USB/camera permissions)\n**Type:** Feature + fix update over 1.5.2\n\n---\n\n## What's New\n\n**Browse your PC folders, name-on-screen title bar, and handy playback extras.**\n\n- **AuraLink folder browsing:** Your PC's shared folders now appear as browsable folders in AuraPlay (drill in, breadcrumb, Back) instead of one long flat list. Needs the free AuraLink 1.0.2 desktop app.\n- **Title bar:** The name of what you're watching now shows on a title bar above the playback controls \u2014 and in the virtual cinema you can grab it to reposition the whole bar.\n- **Audio track button** is now clear and legible (speaker + language code) for switching languages on multi-audio films.\n- **Skip to next / previous video** in the current folder, distinct from rewind/fast-forward.\n- More reliable AuraLink connection when reopening the AuraLink tab.\n\n", "created_date": 1785267359, "id": "2100798270851897", "version": "1.5.3", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2102349087363482"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "AuraPlay 1.5.2 \u2014 Release Notes\n\n**Version:** 1.5.2 (build 15) \u00b7 Store build (Meta Horizon)\n**File:** `AuraPlay-1.5.2-store-release.apk` (~20 MB, signed, no USB/camera permissions)\n**Type:** Feature + reliability update over 1.5.1\n\n---\n\nWhat's New \n\n**Better playback controls and rock-solid PC streaming.**\n\n- **Audio track selection:** Films with multiple languages now show an audio button on the playback bar \u2014 tap to switch language on the fly (great for multi-audio MKVs).\n- **Skip to next / previous video:** New file-skip buttons jump through the folder you're watching from \u2014 Local Files, AuraLink, or DLNA. (The rewind/fast-forward buttons are now visually distinct from these.)\n- **Much more reliable AuraLink discovery:** AuraPlay now finds your AuraLink PC instantly and consistently over Wi-Fi. Pair with the free AuraLink 1.0.1 desktop update.\n- **Clearer cinema settings:** Brightness and Colour Vividness now clearly show as \"passthrough only\" inside the virtual cinema, instead of appearing to do nothing.\n", "created_date": 1785253488, "id": "2100648094200248", "version": "1.5.2", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2102349087363482"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "AuraPlay 1.5.1 \u2014 Hotfix Release Notes\n\nVersion: 1.5.1 (build 14) \u00b7 Store build (Meta Horizon) File: AuraPlay-1.5.1-store-release.apk (~20 MB, signed, no USB/camera permissions) Type: Hotfix over 1.5.0\n\nWhat's New\nHotfix: The 3D options are back where you'd expect them.\n\nRestored the 3D controls in Settings \u2014 a new 3D section with format (2D / Side-by-Side / Top-Bottom), 3D Depth, and Swap Left/Right Eye. Depth and Swap appear once a 3D format is selected. Automatic 3D detection from the filename still works; you can now override it here.", "created_date": 1785247637, "id": "2100576290874095", "version": "1.5.1", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2102349087363482"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "AuraPlay 1.5.0 \u2014 Release Notes\nVersion: 1.5.0 (build 13) \u00b7 Store build (Meta Horizon) File: AuraPlay-1.5.0-store-release.apk (~20 MB, signed, no USB/camera permissions)\n\nWhat's New\nStream your PC library with AuraLink, plus a cleaner in-headset experience.\n\nAuraLink streaming (new): Install the free AuraLink desktop app on your PC (auraplayvr.com), pick your movie folders, and they appear automatically in AuraPlay's new AuraLink tab - one-tap wireless playback over your Wi-Fi, with instant seeking.\nCleaner screen: The floating on-screen buttons are gone. Open the menu with the controller button; screen size, distance and brightness now live tidily in the Settings panel.\nVarious stability and playback fixes.\n", "created_date": 1785144926, "id": "2099500374315020", "version": "1.5.0", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
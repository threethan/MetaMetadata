748749807_172179952902276072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s50jqMIdWncQ7kNvwEE-Fqg&_nc_oc=Ado4MAJiIAb28RNrhKpZ43ZSQJSMhwIn5cQO1AWc3ZI3rWxt-ygM8aLnB_Xq3fcOHaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZRD5q8Kvo94Z4ZUITd-EYmTjHfRVPHstCPzOR0vRUAQ&oe=6AEDF74B"}, {"file_name": "05-tears-of-steel-neon.png", "id": "2038739396849277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_2038739400182610_510010168153460579_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjBRQUDZYPwQ7kNvwH1rwOJ&_nc_oc=AdoNbnxi_1Ep3bb9KGJLRv_ODoveQR2A7HhZtefsVzCKs8tLOsXzxMt7ueMXSG1Byac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdhOmX_0JZ28rly0uawF3jz-jCwiwVpPNlKl6LHUuT_g&oe=6AEDEADD"}, {"file_name": "01-rainbow-fullscreen.png", "id": "1338206735092168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1338206738425501_8433175912827723432_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4QzdVWqhJ4Q7kNvwHXXFt4&_nc_oc=Adp0giHTDNoyO7JaYkJYqw2SV2qCa2jVDT-m0zL5JO8cC97Sw0W-ev6Vo3CxZrTpQkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_-OiySdBXh2IccKwAOc1LmQqAiLm6NClOhFJCKX7l6w&oe=6AEDF73D"}, {"file_name": "03-ambience-menu.png", "id": "2536833440114693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314657_2536833443448026_3409075942239099968_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QEyDnpDm4YQ7kNvwG4m03a&_nc_oc=Ado1UEY_rXMJqhho5nLNvvSrYRHkQEIbwlaYGylZr6_-5pOGGtYuc-MwxPiUY2Cw-r4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVYFG4h-fC7e0SHU3qMrJSNRP_aZ4WuHaCF1xinp0yRQ&oe=6AEDE522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-meta-hero-FINAL-2560.png", "id": "1426849082607264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1426849085940597_808250027840737716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZZEBaDJoBQQ7kNvwGw-D2E&_nc_oc=AdqcN-Xzevx25A5_hJWmv20wwB4pcRrHm6_3PA8LlRuXPKdBaQuBcNiVIeGRia2k3ys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3mr1zzjY4CGrvZEJ43iF1zO7eAU5GmaV9mhX3a9TJxg&oe=6AEDFD05"}, "display_name": "AuraPlay \u2014 Mixed Reality Cinema", "keywords": ["cinema", "movies", "video", "theater", "media"], "long_description": "Your movies deserve more than a flat rectangle.\n\nAuraPlay turns the space around you into a personal cinema \u2014 a screen as big as you like, floating in your own room, wrapped in light that moves with every frame. It's the ambient magic of a high-end home cinema, built into your headset. No wires, no dark room required.\n\n\u2022 Giant virtual screen \u2014 place it on your real wall or float it in space. It stays exactly where you put it.\n\u2022 AuraLight \u2014 our signature reactive lighting reads the colour of every scene and casts it onto your real walls and ceiling in real time. Sunsets, explosions, neon streets \u2014 your room lives inside the movie. Fully adjustable, or off for a pure blackout cinema.\n\u2022 Plays your own videos \u2014 MP4, MKV and more, with automatic multi-language subtitle detection and support for your own subtitle files.\n\u2022 True 3D movies \u2014 side-by-side and over-under, with comfort controls for easy long sessions.\n\u2022 Tune everything \u2014 brightness, screen size, aura intensity and colour vividness, with one-tap ambience presets.\n\u2022 Comfortable mixed reality \u2014 passthrough keeps you aware of your real room.\n\nNo subscriptions. No accounts. No data collected. Just your films, your room, and a cinema that finally feels alive.\n\nTap \"Play Sample\" to see it in action instantly.\n\nSample footage shown in screenshots courtesy of the Blender Foundation (blender.org), licensed under CC-BY.\n\n", "short_description": "Turn any room into a private cinema. AuraPlay plays your movies on a giant virtual screen \u2014 and casts living, colour-reactive light onto your real walls and ceiling with every frame. Warm firelight in a sunset scene, cool blue in a storm: your room lives inside the film. Play your own videos with subtitles and 3D, in comfortable passthrough mixed reality. No accounts, no subscriptions, no data collected. Tap \"Play Sample\" to see it instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2085969279001463"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1595719025258748"}, {"status": "PUBLISHED", "id": "987947910926867"}, {"status": "PUBLISHED", "id": "1752661652735715"}, {"status": "PUBLISHED", "id": "1788293762526193"}, {"status": "PUBLISHED", "id": "951826931217156"}]}, "baseline_offer": {"id": "1752661652735715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1595719025258748"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2183119235953133", "version": "1.8.5"}, "id": "1518726739731284", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2183119235953133"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "AuraPlay 1.8.5 makes network playback easier.\r\n\r\n- Find SMB servers, choose shared folders, test connections before saving and edit saved details.\r\n- Save multiple shares from the same server, with clearer connection errors and improved text entry.\r\n- Sort SMB and DLNA films by name, available dates or recently watched on this headset.\r\n- Faster access to DLNA folders as files load, support for larger listings and retry controls. Reopening the panel retains your DLNA folder.\r\n- A Stop button closes your film while saving its resume position. Load another film without restarting the app.\r\n- Digital clock and a transport bar that fits within the screen.\r\n- Corrected spatial audio positioning when switching from passthrough to a cinema.\r\n- Saved room brightness, smoother AuraLight colour diffusion, improved Retro chair rendering and updated environment previews.", "created_date": 1793044781, "id": "2183119235953133", "version": "1.8.5", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2183119235953133"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "AuraPlay 1.8.3 - What\u2019s New\r\n\r\nImmersive 5.1 and 7.1 spatial surround sound with head tracking, cinema-specific wall reflections and room acoustics. Use headphones and enable Spatial Audio with compatible soundtracks.\r\n\r\nImproved dynamic screen lighting across all four cinemas, bringing subtle, movie-reactive illumination into the room.\r\n\r\nSmoother cinema environments, optimised Retro seating and faster environment loading.\r\n\r\nNew subtitle size controls in Audio & Subtitles. Adjust using - and +, with your preference saved.\r\n\r\nMore comfortable floating panels and improved pointer handling when panels overlap.\r\n\r\nFixed Blu-ray 3D and Swap Eyes settings carrying over when switching from an MVC film to a non-MVC film.", "created_date": 1791919888, "id": "2170347807230276", "version": "1.8.3", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2183119235953133"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": null, "created_date": 1791404923, "id": "2164569627808094", "version": "1.8.2", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2183119235953133"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "My apologies. Previous build excluded the updated Home Cinema environment.", "created_date": 1791396245, "id": "2164476134484110", "version": "1.8.2", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2183119235953133"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "Blu-ray 3D just plays - no setup. MVC films now auto-detect and show in 3D with the correct eye order, 180\u00b0/360\u00b0 videos are detected automatically (and the washed-out colour is fixed), playback is judder-free with content-matched refresh, and there's a vastly upgraded Home Cinema, a new repeat button and a tidier Language menu.", "created_date": 1791394256, "id": "2164452297819827", "version": "1.8.2", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
3983704311_7074516360820642469_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC1IzhoUSBwQ7kNvwERuY2H&_nc_oc=Adpo-b9Mjwdx6vqVCzh3nPf5D8l5S6EVaFuBpM7y8vY_fDemlBTSAD1IXQD2ROaPrzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy-tTc5QVvYQGKknj0LInKCyzXooplHCL-zxpq5NKRHw&oe=6AF5D66A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-cover-landscape-2560x1440-v2.png", "id": "1572402754640791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1572402761307457_5157960825411766997_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFbbZhQmy1MQ7kNvwG9f53l&_nc_oc=AdpT-bwLc71DMM9ajVw71gO-ttN_VsBpiXGJbaWJC7tcvtMlgAG6aJQjjpumRu3_fQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsum1bMYKjvH_ZITafP0kwV_OvMt-f9yEM-um4Y3Wg2w&oe=6AF5ED0A"}, "display_name": "AuraPlay VR Player", "keywords": ["cinema", "movies", "Plex", "3D", "streaming"], "long_description": "**Key Features:**\n\n**NEW - 5.1/7.1 Spatial Surround:** Head-tracked sound through headphones on compatible titles. Dialogue stays at the screen; effects surround you, with cinema-specific reflections and room acoustics.\n\n**NEW - Dynamic Cinema Lighting:** Movie colours and brightness subtly illuminate the room. Adjust screen lighting and room dimming.\n\n**Full Blu-ray 3D (MVC):** MKV Blu-ray-3D rips at full 1080p per eye, locally or over AuraLink, with audio, subtitles, seeking and auto-resume.\n\n**Four Cinemas:** Home Cinema, Luxury Auditorium, IMAX and Retro Cinema, with selectable seats.\n\n**NAS & PC Streaming:** Play over Wi-Fi using SMB or DLNA, including Plex and UMS.\n\n**AuraLink:** Free PC streaming and 2D-to-3D conversion at auraplayvr.com.\n\n**Subtitles:** Matching .srt files load automatically; supported embedded subtitles too. Resize supported overlays with - and +.\n\n**Your Screen:** Giant flat or curved display, freely positioned and lockable.\n\n**Your Library:** MP4, MKV, AVI and MOV, with native aspect ratios and auto-resume.\n\n**3D & VR Video:** MVC, Side-by-Side, Over-Under, 180\u00b0 and 360\u00b0, with filename detection and Re-center.\n\n**Reactive AuraLight:** Adjustable movie-reactive ambient colour.\n\n**Spatial UI:** Movable controls and auto-fading playback bars.\n\n**No subscriptions. No accounts. No telemetry.**", "short_description": "Your movies deserve a cinema. AuraPlay turns your Quest 3 into a private theatre, with a giant flat or curved screen in your real room or four virtual cinemas. Enjoy full-resolution Blu-ray 3D at 1080p per eye, head-tracked 5.1/7.1 surround through headphones, cinema room acoustics and dynamic screen lighting. Play locally or stream from your PC or NAS. Your films. Your seat. Your cinema."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2167172680881122"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/618730118_1384695306878698_6767534476620945879_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ9pwVlVUR8Q7kNvwFT1ZES&_nc_oc=AdpjEmgOdHpVJBLx-dVUfUDM0cVSBpCur3-7xfljCxkCLjgd28jqSO
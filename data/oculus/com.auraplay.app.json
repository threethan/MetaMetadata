ntent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1026228230006781_1364976818644286277_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z9iCXEgldcQ7kNvwHAeuUx&_nc_oc=Adp7MAfAt1diFcasb5EkKIuCJjbiBBvnyAmJujUDCsXNgg8fwIQAktV5CyqREIoBogU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB0CKwgaqzEL17h4TYLpRBNHW8bHkJNcFB7BiE7XlCTQ&oe=6AFDDB6E"}, {"file_name": "04-cosmos-vortex.png", "id": "2184755745416474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314667_2184755748749807_172179952902276072_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=908UP96mUm8Q7kNvwFxZHkG&_nc_oc=AdqjrEnY41_j6iUILxVzeW409pdNR6xIFA7_hkznTZsD28Y8U3FSo3yZNlcu4SBhxQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJXdeO5jGl2kiXBI0ETAZcleGieAjKyKt2hTaIbzw_zA&oe=6AFDC94B"}, {"file_name": "05-tears-of-steel-neon.png", "id": "2038739396849277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_2038739400182610_510010168153460579_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N55ouEmldaYQ7kNvwEwT0FW&_nc_oc=AdpNlAAhX9lOrq3ijzSiqEztN0Zk9wk-MX1yFfEfy9KFOXJHrFfwf3_qG8iGsCnel4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIylTH8J3DwTiIu1zSJtBklWojmP735ysSABUDQ7fxtQ&oe=6AFDBCDD"}, {"file_name": "01-rainbow-fullscreen.png", "id": "1338206735092168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_1338206738425501_8433175912827723432_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffuC1J5LsC4Q7kNvwGWeV_g&_nc_oc=Adq2UtdFsW8lPKsRFvPu95s7iY0kAmBgK5IP3sfKY2uNyMHexY3_d_FpxoR_SsqAgXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-vS6KE_FC54ggwyLr4nPeG3-14avXlxwIHf5U3IgWEA&oe=6AFDC93D"}, {"file_name": "03-ambience-menu.png", "id": "2536833440114693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314657_2536833443448026_3409075942239099968_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R76xZWcy7T8Q7kNvwG6_BRf&_nc_oc=Adr9Ym_DT5RRk0_ilpP9EL6s2054cVlJsLKodBKzF8zRT9E9_hMFE3pmbl299xwCC8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPBgrBA1DVcvdwbTt8LpFgGx1-G0ypx3I9NqmNezx-Ag&oe=6AFDB722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-meta-hero-FINAL-2560.png", "id": "1426849082607264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_1426849085940597_808250027840737716_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSWFKe7-wiQQ7kNvwGqoi5A&_nc_oc=AdpP6W4O85Zry0UuIu1um-CXpSDgdEHUMy2oZW0dpYW12H8xusfQ7-l-eZr_WrzkynM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUVy2tzLLy2R0I4VUtFn0sdXUKAFlOe8UXP8mUZa-UBQ&oe=6AFDCF05"}, "display_name": "AuraPlay \u2014 Mixed Reality Cinema", "keywords": ["cinema", "movies", "video", "theater", "media"], "long_description": "Your movies deserve more than a flat rectangle.\n\nAuraPlay turns the space around you into a personal cinema \u2014 a screen as big as you like, floating in your own room, wrapped in light that moves with every frame. It's the ambient magic of a high-end home cinema, built into your headset. No wires, no dark room required.\n\n\u2022 Giant virtual screen \u2014 place it on your real wall or float it in space. It stays exactly where you put it.\n\u2022 AuraLight \u2014 our signature reactive lighting reads the colour of every scene and casts it onto your real walls and ceiling in real time. Sunsets, explosions, neon streets \u2014 your room lives inside the movie. Fully adjustable, or off for a pure blackout cinema.\n\u2022 Plays your own videos \u2014 MP4, MKV and more, with automatic multi-language subtitle detection and support for your own subtitle files.\n\u2022 True 3D movies \u2014 side-by-side and over-under, with comfort controls for easy long sessions.\n\u2022 Tune everything \u2014 brightness, screen size, aura intensity and colour vividness, with one-tap ambience presets.\n\u2022 Comfortable mixed reality \u2014 passthrough keeps you aware of your real room.\n\nNo subscriptions. No accounts. No data collected. Just your films, your room, and a cinema that finally feels alive.\n\nTap \"Play Sample\" to see it in action instantly.\n\nSample footage shown in screenshots courtesy of the Blender Foundation (blender.org), licensed under CC-BY.\n\n", "short_description": "Turn any room into a private cinema. AuraPlay plays your movies on a giant virtual screen \u2014 and casts living, colour-reactive light onto your real walls and ceiling with every frame. Warm firelight in a sunset scene, cool blue in a storm: your room lives inside the film. Play your own videos with subtitles and 3D, in comfortable passthrough mixed reality. No accounts, no subscriptions, no data collected. Tap \"Play Sample\" to see it instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2085969279001463"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1860463572070733"}, {"status": "PUBLISHED", "id": "1595719025258748"}, {"status": "PUBLISHED", "id": "987947910926867"}, {"status": "PUBLISHED", "id": "1752661652735715"}, {"status": "PUBLISHED", "id": "1788293762526193"}, {"status": "PUBLISHED", "id": "951826931217156"}]}, "baseline_offer": {"id": "1752661652735715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1860463572070733"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2194786314786425", "version": "1.8.6"}, "id": "1518726739731284", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2194786314786425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "New features\n\nAlpine Lodge and Luxury Penthouse. Download either premium cinema and try it free for 20 minutes. Each is available as a one-time in-app purchase for \u00a32.99 in the UK.\nLocal Files folder view and sorting. Switch between All videos and Folders. Sort by name, date added or recently watched.\nSave these settings. Save your preferred screen size, distance and AuraLight adjustments for next time.\n\nImprovements\n\nSmaller app updates. Premium cinemas download separately from the main app.\nCentre seats. Grand Auditorium, IMAX Experience and Retro Picturehouse now open in a centre seat and offer selectable centre seats in every row.\nUSB copies preserve folders. Videos copied to the headset retain their subfolder structure. The USB screen also explains which drive formats to use.\n\nBug fixes\n\nFixed an issue that could open ordinary 2D videos in 360\u00b0 mode.\nRestored Room Scan under AuraLight and fixed the reminder appearing repeatedly after restarts.\nImproved SMB playback recovery so Play can retry after an interruption and resume from the last saved position.\nFixed the white line along the Penthouse floor and removed outdated aisle lettering from Grand Auditorium.", "created_date": 1794001984, "id": "2194786314786425", "version": "1.8.6", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 2}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2194786314786425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793997777, "id": "2194731928125197", "version": "1.8.6-experimental", "version_code": 67, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 2}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2194786314786425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793996651, "id": "2194720414793015", "version": "1.8.6-experimental", "version_code": 66, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 2}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "bi
scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkM5VLaPoxPRwFzJ3gdI7EsMrgkBaaEb5xlN85mr93IA&oe=6AABE62E"}, {"file_name": "04-cosmos-vortex.png", "id": "2184755745416474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314667_2184755748749807_172179952902276072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmwrX3mffPUQ7kNvwH44ac_&_nc_oc=AdrCgfxWDw2Xd18CA9W2GsbU5HT2EMsDu1JPR1rY-Fb01mqlgPQEAJTUhZBJL2xJr4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6lQywG3EqHZ6ZyzU_LhDBiLIhNDI00YDfH0fXgLniIw&oe=6AAC0C4B"}, {"file_name": "05-tears-of-steel-neon.png", "id": "2038739396849277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_2038739400182610_510010168153460579_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCtRnwTn_3kQ7kNvwHnLoQ_&_nc_oc=AdoNMI22Zfg3AT_IzG1P-8jXCe0CkLfwzVG4xdG29XJrtfIhA0XWHXExwa4wadeopVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-W5WT2zDmfY1n2Ib4C9b-SfsnRAYP7DpuvJxw8eHevA&oe=6AABFFDD"}, {"file_name": "01-rainbow-fullscreen.png", "id": "1338206735092168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1338206738425501_8433175912827723432_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS3CS7tvC20Q7kNvwHfxzCL&_nc_oc=Adpd46GJOl9PYvKHlFuc3CGinRvLZp-W6GYsvF-ky2YuFgJ9tjdtsNgc9ydpa6pxcII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJODaN-OE2H5x_y1AEofGwU0vKjPmINvKsDK3efJuhheg&oe=6AAC0C3D"}, {"file_name": "03-ambience-menu.png", "id": "2536833440114693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314657_2536833443448026_3409075942239099968_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0XF13kTU5kQ7kNvwHN2xxj&_nc_oc=AdoSC9yBnh4hYy5DdWu4EkB6RpBYXyKMmCHEFiai0q6gsT1yDZWSrbHCUYgng_J5bJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImi1DXrNT9toxG4hANujg8vJlf1CVbbW_dfcDQAE9EuA&oe=6AABFA22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "auraplay-meta-hero-FINAL-2560.png", "id": "1426849082607264", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1426849085940597_808250027840737716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzLhvzjSKUEQ7kNvwE9s4s4&_nc_oc=Adp0HB__TlYLNQqENSuC2g1PcwSs_VCiA7viQpDL9mixCX6TijPGpF4L5xl51hsTLpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfPihDka5daJGqoBj1vFgN3LzmK1V3weARu-WM2IN4zw&oe=6AABD9C5"}, "display_name": "AuraPlay \u2014 Mixed Reality Cinema", "keywords": ["cinema", "movies", "video", "theater", "media"], "long_description": "Your movies deserve more than a flat rectangle.\n\nAuraPlay turns the space around you into a personal cinema \u2014 a screen as big as you like, floating in your own room, wrapped in light that moves with every frame. It's the ambient magic of a high-end home cinema, built into your headset. No wires, no dark room required.\n\n\u2022 Giant virtual screen \u2014 place it on your real wall or float it in space. It stays exactly where you put it.\n\u2022 AuraLight \u2014 our signature reactive lighting reads the colour of every scene and casts it onto your real walls and ceiling in real time. Sunsets, explosions, neon streets \u2014 your room lives inside the movie. Fully adjustable, or off for a pure blackout cinema.\n\u2022 Plays your own videos \u2014 MP4, MKV and more, with automatic multi-language subtitle detection and support for your own subtitle files.\n\u2022 True 3D movies \u2014 side-by-side and over-under, with comfort controls for easy long sessions.\n\u2022 Tune everything \u2014 brightness, screen size, aura intensity and colour vividness, with one-tap ambience presets.\n\u2022 Comfortable mixed reality \u2014 passthrough keeps you aware of your real room.\n\nNo subscriptions. No accounts. No data collected. Just your films, your room, and a cinema that finally feels alive.\n\nTap \"Play Sample\" to see it in action instantly.\n\nSample footage shown in screenshots courtesy of the Blender Foundation (blender.org), licensed under CC-BY.\n\n", "short_description": "Turn any room into a private cinema. AuraPlay plays your movies on a giant virtual screen \u2014 and casts living, colour-reactive light onto your real walls and ceiling with every frame. Warm firelight in a sunset scene, cool blue in a storm: your room lives inside the film. Play your own videos with subtitles and 3D, in comfortable passthrough mixed reality. No accounts, no subscriptions, no data collected. Tap \"Play Sample\" to see it instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auraplayvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "David McGuinness", "support_website_url": "https://auraplayvr.com/#support", "website_url": "https://auraplayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2085969279001463"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1595719025258748"}, {"status": "PUBLISHED", "id": "987947910926867"}, {"status": "PUBLISHED", "id": "1752661652735715"}, {"status": "PUBLISHED", "id": "1788293762526193"}, {"status": "PUBLISHED", "id": "951826931217156"}]}, "baseline_offer": {"id": "1752661652735715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1595719025258748"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2140185476913176", "version": "1.7.8"}, "id": "1518726739731284", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2140185476913176"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "Choose your audio & subtitle language. Tap CC while watching to pick the subtitle\r\nlanguage or switch audio track in a clean pop-up. Embedded subtitles on foreign films now\r\nshow up, audio starts in your system language, plus a first-run menu hint and a USB fix.", "created_date": 1789137153, "id": "2140185476913176", "version": "1.7.8", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2140185476913176"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "Blu-ray 3D now plays fully from the headset \u2014 including DTS-audio discs, with sound. Arm Blu-ray 3D before playback and it starts in 3D instantly. Plus eye-swap for reverse-mastered discs, subtitles on legacy formats, and smoother USB.", "created_date": 1788880955, "id": "2137559820509075", "version": "1.7.7", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2140185476913176"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "Plays more file types. Older Blu-ray discs (VC-1) and other legacy video formats now play, via a built-in software decoder. Plus smarter automatic 3D detection and much smoother seeking on 3D films.", "created_date": 1788808058, "id": "2136828017248922", "version": "1.7.6", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2140185476913176"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": null, "created_date": 1788800968, "id": "2136753083923082", "version": "1.7.5", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2085969272334797", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2140185476913176"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518726739731284"}]}, "change_log": "Automatic 3D Blu-ray (MVC) detection\\n\r\n\\n\r\nBlu-ray 3D (MVC) MKV files are now recognised automatically and play in full 3D \u2014 you no longer need \"3D\" or \"MVC\" in the filename.\\n\r\nOrdinary 2D videos are unaffected.\\n\r\nManual 3D control\\n\r\n\\n\r\nA new \"Blu-ray 3D (MVC)\" switch in Settings \u203a 3D lets you force a file into 3D (or back to 2D).\\n", "created_date": 1788785108, "id": "2136557073942683", "version": "1.7.3", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
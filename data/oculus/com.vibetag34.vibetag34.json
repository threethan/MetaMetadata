e it gets! It\u2019s perfect for hanging out, being active, and creating unforgettable moments with your friends.", "short_description": "Vibe Tag is a super fun movement game where you swing your arms around, tag your friends, and vibe together! Jump in, move fast, and have fun with your crew!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vibetag-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "vibe tag devs", "support_website_url": null, "website_url": "https://sites.google.com/view/vibetag-privacy-policy/info", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25964264409934379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_901968615957889_5219545331800063016_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiED2cPt-JkQ7kNvwHt2ROn&_nc_oc=Adrv6FTCdGfyk76B0Wg-gqvxzFMuVJZo6UM9ZC0diPdhGUq_sUUZPUCFpNEPU-HLCkI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLREtiDZWsqAa3S3R_6HHC4_P_8xi9qlRW_9D3iVUyzA&oe=6A68BE7D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "vibe tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action"
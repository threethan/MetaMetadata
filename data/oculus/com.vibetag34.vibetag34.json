VFPqA0iXNLWguZZ-IXw2f-K8gHFv710yN1Z0qg&oe=6A11B4F7"}, {"file_name": "Screenshot4FIX.png", "id": "1652922749027530", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491818885_1652922752360863_4059180421080364635_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPYuO9FP5vsQ7kNvwH9KQbz&_nc_oc=AdraxUZEidXa-ZlsAZ3Kxq2L5b8KmwQ8T-69BukAx5gxxqZNJaqttnUd5iA9hLg6VfI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4azwjB-VDGyNTx7A_Oz1ZkfKbe61MgOFGUpZ0mG5Kp0A&oe=6A11CDE1"}, {"file_name": "Screenshot2FIX.png", "id": "1986410858900834", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821568_1986410862234167_2263296150075694431_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krqjYE62yVUQ7kNvwEawNoN&_nc_oc=Adq3h6lG4NHiczvnZtT8qr9Ojm_FRdew-ozL4GyN6FZjTSXlB-haCmWtoLOZn0rqBJc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XptcboeLIY052VtaZNHJFAJE9JJysGxk7r04mSD13AA&oe=6A119B27"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "869759616023725", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823351_869759622690391_7866190029447576066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjb8kX84lToQ7kNvwFVbi7Q&_nc_oc=AdrH0nmUbSrcUo0QdUNSHygRhp7FQGB67r26UT5hY1k5-3x6xGO_jiao5Ln1cBe7ih8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s5bEOF0SToeNuilbIE_c6v32aDVpvo6uGUNCIMdAfOg&oe=6A11B30D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "vibe tag", "keywords": ["vibe", "tag", "project", "taggers", "ARMSWINGING"], "long_description": "Vibe Tag is an exciting, high-energy game all about movement, fun, and good vibes! In this game, players swing their arms around to tag others, dodge incoming tags, and keep the action going. It\u2019s simple to play but full of laughs and fast-paced moments.\n\nWhether you\u2019re competing to be the last one standing or just playing for fun, Vibe Tag brings friends together through movement and energy. The more you move, the more intense it gets! It\u2019s perfect for hanging out, being active, and creating unforgettable moments with your friends.", "short_description": "Vibe Tag is a super fun movement game where you swing your arms around, tag your friends, and vibe together! Jump in, move fast, and have fun with your crew!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vibetag-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "vibe tag devs", "support_website_url": null, "website_url": "https://sites.google.com/view/vibetag-privacy-policy/info", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25964264409934379"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823341_901968615957889_5219545331800063016_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT3ROwQMxhAQ7kNvwHJhdmx&_nc_oc=Adr5-QbVzNtr5JYhhaUHW4Vvk3v20ba4SPtf9UHJL0TOl0HZY5C5Seqrf9aFYY6qg18&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TSQGJuJ9mzpN-7-AhHsOzuTvypKOgz_6yHn__fd2j6g&oe=6A11BB7D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "vibe tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Act
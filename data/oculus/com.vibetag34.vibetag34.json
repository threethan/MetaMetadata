29447576066_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ig1m24WA2gAQ7kNvwFUXN_s&_nc_oc=AdrYQoZoB9xBDKpsCRDGUO0BCs6fV_xxdmHvBiLJkKTc_JR-RunqKGRzMr6fdGCg_BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIZnuViYY0qpW50_KC6sad2aEz-38ayI9dspzro7jP2A&oe=6B0F0B4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "vibe tag", "keywords": ["vibe", "tag", "project", "taggers", "ARMSWINGING"], "long_description": "Vibe Tag is an exciting, high-energy game all about movement, fun, and good vibes! In this game, players swing their arms around to tag others, dodge incoming tags, and keep the action going. It\u2019s simple to play but full of laughs and fast-paced moments.\n\nWhether you\u2019re competing to be the last one standing or just playing for fun, Vibe Tag brings friends together through movement and energy. The more you move, the more intense it gets! It\u2019s perfect for hanging out, being active, and creating unforgettable moments with your friends.", "short_description": "Vibe Tag is a super fun movement game where you swing your arms around, tag your friends, and vibe together! Jump in, move fast, and have fun with your crew!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vibetag-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "vibe tag devs", "support_website_url": null, "website_url": "https://sites.google.com/view/vibetag-privacy-policy/info", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
&oe=6A2AC2EF"}, {"file_name": "5.png", "id": "1421172430029544", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/585720338_1421172433362877_105966179101828434_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYRx-rc5pYUQ7kNvwGq3Ue6&_nc_oc=Ado8MF1YmMCV3RyBmyuFV6HoXyles4_pLPUDqvFLZGRntS1HCZu3UDut9PU2plOJt-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hqsWtg5WNdVE15NYB1GzouIkSLfcbmFCpaG7lr_f9qw&oe=6A2AB299"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slimes & Swords RNG", "keywords": ["roll", "luck", "steal", "animal", "gorilla"], "long_description": "Roll powerful swords, defeat endless waves of slimes, and explore a massive multiplayer world with your friends!\n\n\ud83c\udf40 Get lucky and roll powerful swords!\n\ud83d\udde1\ufe0f Fight unique slime enemies\n\ud83c\udfb2 RNG system with insane rare drops\n\u2b06\ufe0f Upgrade and evolve your swords\n\ud83c\udfe0 Build and upgrade your own base\n\ud83c\udf0d Unlock new worlds and hidden areas\n\ud83c\udfc6Show off your rarest swords and dominate the leaderboards\n\ud83d\udc65 Team up with friends for more rewards!\n\nStart your adventure now in Slimes & Swords RNG!", "short_description": "Roll powerful swords, defeat endless waves of slimes, and explore a massive multiplayer world with your friends!\n\n\ud83c\udf40 Get lucky and roll powerful swords!\n\ud83d\udde1\ufe0f Fight unique slime enemies\n\ud83c\udfb2 RNG system with insane rare drops\n\u2b06\ufe0f Upgrade and evolve your swords\n\ud83c\udfe0 Build and upgrade your own base\n\ud83c\udf0d Unlock new worlds and hidden areas\n\ud83c\udfc6Show off your rarest swords and dominate the leaderboards\n\ud83d\udc65 Team up with friends for more rewards!\n\nStart your adventure now in Slimes & Swords RNG!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonlab.info/slimes-swords-rng/", "developer_terms_of_service_url": null, "publisher_name": "Dream Dev Studio VR", "support_website_url": null, "website_url": "https://horizonlab.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "1191681530687244"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1530459805471380"}]}, "baseline_offer": {"id": "1530459805471380"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780056000, "status": "PUBLISHED", "id": "1530459805471380"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1208533685668695", "version": "0.1.6"}, "id": "2012883032767540", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1191681524020578", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1208533685668695"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2012883032767540"}]}, "change_log": "Version 0.1.6\n\nWhat's New:\n\n\ud83c\udf00 Fast Travel is Here\nTeleport between your base and biomes in just one click.\n\n\ud83d\udde1\ufe0f Sword Display System\nPlayers now show their equipped sword above their heads.\n\n\ud83c\udfc6 New Leaderboards\nAdditional leaderboards have been added so you can compete with other players and track your progress.\n\n\u26a1 Improvements & Optimizations\nVarious gameplay improvements, bug fixes, and performance updates.\n\n\ud83d\udd2e Next Update Preview\n\nComing soon:\n\n\u2022 New biomes to explore\n\u2022 New swords to collect\n\u2022 New enemies to defeat\n\u2022 More content and improvements\n\nVersion 0.1.5\n\n\ud83c\udf0d New Biome Added\nA brand-new area is now available to explore.\n\n\ud83d\udc7e New Enemies\nDiscover and battle new slime enemies with unique behaviors.\n\n\ud83d\udde1\ufe0f New Swords\nMore swords have been added to the game. Time to test your luck!\n\n\ud83d\udda5\ufe0f Improved UI\nThe interface has been moved higher for better visibility and comfort.\n\n\u2694\ufe0f Better Sword Handling\nImproved sword grab system for smoother gameplay.\n\n\u26a1 One-Click Sword Selection\nThe sword selection system has been redesigned. Choosing your sword is now faster and easier.\n\n\ud83d\ude80 Performance Improvements\nImproved FPS and reduced freezes across the game for a smoother experience.\n\n\ud83d\udd27 Various Bug Fixes and Improvements\n\n\ud83d\udd2e Coming Soon\n\nWe're already working on the next update, which will include:\n\n\u2022 Teleport system between your base and biomes\n\u2022 A brand-new biome\n\u2022 New enemies\n\u2022 New swords\n\u2022 More improvements and surprises\n\n----\nVersion 0.1.4.\n\nThis is the first build. \n\nIf you enjoy the game, please leave a positive review. \n\nHave any ideas on how to improve the game? Let us know at info@dream-dev.com.\n\nThanks!", "created_date": 1780651502, "id": "1208533685668695", "version": "0.1.6", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1191681524020578", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1208533685668695"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2012883032767540"}]}, "change_log": "Version 0.1.5\n\n\ud83c\udf0d New Biome Added\nA brand-new area is now available to explore.\n\n\ud83d\udc7e New Enemies\nDiscover and battle new slime enemies with unique behaviors.\n\n\ud83d\udde1\ufe0f New Swords\nMore swords have been added to the game. Time to test your luck!\n\n\ud83d\udda5\ufe0f Improved UI\nThe interface has been moved higher for better visibility and comfort.\n\n\u2694\ufe0f Better Sword Handling\nImproved sword grab system for smoother gameplay.\n\n\u26a1 One-Click Sword Selection\nThe sword selection system has been redesigned. Choosing your sword is now faster and easier.\n\n\ud83d\ude80 Performance Improvements\nImproved FPS and reduced freezes across the game for a smoother experience.\n\n\ud83d\udd27 Various Bug Fixes and Improvements\n\n\ud83d\udd2e Coming Soon\n\nWe're already working on the next update, which will include:\n\n\u2022 Teleport system between your base and biomes\n\u2022 A brand-new biome\n\u2022 New enemies\n\u2022 New swords\n\u2022 More improvements and surprises\n\n----\nVersion 0.1.4.\n\nThis is the first build. \n\nIf you enjoy the game, please leave a positive review. \n\nHave any ideas on how to improve the game? Let us know at info@dream-dev.com.\n\nThanks!", "created_date": 1780498089, "id": "1205676985954365", "version": "0.1.5", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicatio
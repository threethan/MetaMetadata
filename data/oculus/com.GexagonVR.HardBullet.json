0.png", "id": "1060654858865138", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guLfgrykRAgQ7kNvwGXmM-4&_nc_oc=AdptymCpQLR9cMBp1pt7ADlJmKZ4VkupwJQALCvmEisd1OP-yYvQcrPjmQtsUXmvO00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhfT1oqGkYltyTgtSOdYDNpSiwqW_0Xc3wX8gsKw-DdA&oe=6ACB8E80"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TONGZwFS4IQ7kNvwGaI000&_nc_oc=AdrPO056bqRBtBoMO-LHN17_ljp-IF9cWUBJ_-ONtXzTkzHK0KRNVhfjY7W4OxeECbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFh3OimRQcEGLZFl5LtiboifQVTHow5tFls2Y9Nq_XRw&oe=6ACBB456"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqyi5VpNYxsQ7kNvwHQE_58&_nc_oc=AdreK7-tgUsOsygsDpr3EI8HSYW76n0b7lpTSrYTc4hAPA7DfcLIduq9uoWsabWNDX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp3svYIwn5smb6v82mxp_sGuWt9FuXwP7dfF_dKTG_Fg&oe=6ACBB89E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcZRLIrm2awQ7kNvwFeIzHn&_nc_oc=Adp_okoJl7pUODcqkoHcQne6kZAnSAGk9oOMRvAI3NGZhkDVvbOJsAGMeFHqoBPRhH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRnQ-6HFBAgeQZcVOOf86aM6Q8QqpGkWRWS_swAdpvjg&oe=6ACBADDD"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_t
37_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIOvWZObSBEQ7kNvwHdWR0O&_nc_oc=AdnZ_IX2bqUxZbLxqIEL2LAdGL08HGMM1ZvbOouzAJiMvsKhNyv6O9HLU_IDs9gvHuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuNDL56OKlXHqX27O1b1vjBqgNRshemZuWdkeHA04aTMw&oe=699B14D4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZiMMnRav7gQ7kNvwEMLIal&_nc_oc=AdlyvEI2qZejyrdpQtKFT9FvxHqIAfmbw_xWeZQUxYy1wv84q56FW6BWtF6dhhb7N04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv8yIvWEAA_Uk3AfmSFEj425OYDnx8OoFo0CxbJ2hoC-w&oe=699AFFDA"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTz1DOvsDYYQ7kNvwEfbNhH&_nc_oc=AdlZopfqCjRGR1JbKHV-dsT5v868iu1BoOfQIstfeE38Gqqnwtrz4zkm9MLWmjiuAIw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfslOSaWegaS9c4a4Rshh5ajv_APqGo_qJxTH9z9GFQaNQ&oe=699B0400"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER HB COVER.png", "id": "738363902171059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303788_738363905504392_1805520951337612988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BNk78zihukQ7kNvwHlMijF&_nc_oc=Admug2R1Z59VcZKr7bQzIj8g2P93jr4Y7Vzoyjvb-oGfZ1aKcNt4IcuPULIbB06dRJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs3L1VltIDt6gV7vDmgpTlhlBdD2lDUWLdEBtW_XIUaqQ&oe=699B109E"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
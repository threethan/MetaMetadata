0.png", "id": "1060654858865138", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJtEhOH1ysYQ7kNvwFtRI-J&_nc_oc=AdqzAqaLq7b1H7dwwzQ2nRaz82hCvHE7EJ9mk24NzRxNljo0bgbVYBxIz4-2LeRLh7A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4MPStQX0DBz5vaf_vt5irRD-GJ71UTsh47Gnw7x95Iw&oe=6AD3AFC0"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luSRMh64lVUQ7kNvwGQgehI&_nc_oc=AdqGbHjELXz7qzS5Uoqd3HZ-MavnPo6ak25lzb4Xoy5IYcIICOM5aqmbu66JMo3l4Us&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaOJZ02Gtwtr2QbG30l6N1jttBvMYIYzRY0GVs13sRpw&oe=6AD39D56"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7E5OIcmi-0Q7kNvwGWWHA9&_nc_oc=AdrsDAFBV1t0sjbTXlgKaj4fZxUJLUbg-p8U1U9BDbWS4vqBwRK5RAqtFf8yq-6tJfY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSJ6pv8raVYHAJ2DDko5KR08CAqIx8kq3tOCsWtXEZzA&oe=6AD3A19E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhcgR3fc0q0Q7kNvwEJvKMv&_nc_oc=AdpmXvbs1D4vZ9-UOGl6s3c-uL_K8bnk6HmJJ94dJTbijzQUGymQ5f6YjFW_FWpzZ9M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5pY64ZWkQ0NxBPyBtzw5fIudr8tcTSGzbQgvZ47ffNA&oe=6AD396DD"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_t
e=6ACD156D"}]}, "id": "1780552046425232", "locale": "en_US", "screenshots": [{"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbjKfsDdWi8Q7kNvwECTY6X&_nc_oc=AdqQqJFt8KX0F35GreHxeFxIdXhlMc6UEOoTAvouvlwPSi2rtHsNQUtP6WuLp00GoVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAGlzRVLxOKXCxeqQwpl1wyX4rh0xnMc9QOFSaBc7sQg&oe=6ACD05D6"}, {"file_name": "45-1440.png", "id": "721086307153508", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_721086310486841_5483727556894742280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk_SM6kfZhEQ7kNvwF_Po6s&_nc_oc=Adonj6QgtDhgaPueqaJq9JGMCGiysMVFKrKOIs5Hcc-kUeDsLd_suRVLeHNMs84UIGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNWL5dy-J6V91tfVu2VWaj3cSBZ2F_VbOxzemz6bKGkw&oe=6ACCEE24"}, {"file_name": "40-1440.png", "id": "1193063009234855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_1193063012568188_2265459248747162137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCQwj_yfiFAQ7kNvwEGLzHu&_nc_oc=AdpIpj3OjTK0pH8dkYVkd6H6SWBcmUBAx31J-XFOstmLn1CpZtBx2d5DC7kOcaRjtXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp0cPaKOQ6JZAQDqcITKIP-L-3L0-Unep2EXfI_mLgJg&oe=6ACCF0D4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhGMuLoGu9QQ7kNvwFspVGt&_nc_oc=Adq52rMQIXN53NN16jcTY8aORA6SDtaC2PUTftVHJLkpmTnMTXHZwd3Uq431gylYS10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGiHdB4qNdgxei7mPUKcDpg4lTivs84Y4LVt_EMjJx5g&oe=6ACD141A"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On0l7zqGHf8Q7kNvwF4-4Fk&_nc_oc=AdojwMCo3tSiscIM7Cr9GbDdtBcQFbw6p0ryizK2mykQXwsLKmkc3yb6fiQ4oW5l4qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdeh01ogySjmKS1KpJSIpXoJdXEWKGlYAfo5nw8NQcHg&oe=6ACD1840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER LANDSCAPE.png", "id": "1606525384582772", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604293968_1606525387916105_1938607034778518976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y6OXeuiVIYQ7kNvwEwgSqR&_nc_oc=Adop0t9Y6MhyDRKshZsRgDseUwt2NiMiJKEpHG01JY8aAOxNncjdrMAhowF83WAyeSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJlH2XqZwFPQmAN_jHVa55tUgY76GvhpfwRI6JGua6JA&oe=6ACD1347"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28252897851057337"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.ocu
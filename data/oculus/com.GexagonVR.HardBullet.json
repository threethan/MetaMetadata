0.png", "id": "1060654858865138", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJtEhOH1ysYQ7kNvwHIpANM&_nc_oc=AdpKQh0LZpJ6A3-ruD8VyyKE4LagURRArBCqUZbnmd_c7rVO6bApxi-rKXLWHowHyVU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbmkThd-uXS4oQWQulC1T2UxvLp1rtjahHS0Jq90M2wA&oe=6AD0D480"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luSRMh64lVUQ7kNvwHBeFwE&_nc_oc=AdpEMWRcf0kPmT-nuzZ9bLplPefHw2DtIf5Ax9tAKwiRJ8wyxgIvnjXLh7SUPx6gyHc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsfYHcD7KA28k7TIGrFxufaglZzyNoG4eKFrD2NXPFvQ&oe=6AD0FA56"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7E5OIcmi-0Q7kNvwEqY_29&_nc_oc=AdqDNEddxWezVuICQUcwGLLpskv0-D27MqHltkmrEtRpWoAET24Jwk9wcAMvDK7iCE4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYIgh_OXSJg_BBPNAryqaDCwNIyP3AvkCUAsW_uQnUsg&oe=6AD0FE9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5woc6ZKFwDEQ7kNvwFkaKkg&_nc_oc=Ado12D-D1_FFYB9foGlZ4HtEMXsHESYHGpjsD3d2lmYNUC-_jT-NTx5E1JWttXEAI8g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjrbwNrWARG3KfjV7ASQnm34EBu1Oo4dgGpayIKtD69w&oe=6AD0F3DD"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_t
0-1440.png", "id": "1193063009234855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391785_1193063012568188_2265459248747162137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56uDrDphPWwQ7kNvwGxKZyO&_nc_oc=AdojkJRuXJ_yj0WBjzW6t3hJHCFRAty2eR_lpboZ7KvURXyigClG10fbZzFR45S2iYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECi515sZzEIXFd_emVIpdFKWSAuVw8zr6ymQu6A0ld5A&oe=6A734AD4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzJDYDkn_l0Q7kNvwHdNJBf&_nc_oc=Adoe701Us0-ahZMsE6aDyXX1iHs6GodDYd6iobzkkMMb-IiInWwV0ft_ASckvKc_Fq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8WkQ9AqBSKP3ZwjODhnoF5KmCYIX_JE-3JhgrbWHiLQ&oe=6A7335DA"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBcd0jcLHX0Q7kNvwE7G6YO&_nc_oc=AdqfXN2ElCxApEU_G25sujnoWVwzz43qa__WN1lXsLRftrUr9lriFCq7wVbzoKWEZkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_K5jc0rXWBxrpxq1LFRspLnxjRrN86DXxdqQVp4IWYw&oe=6A733A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapacovercity.png", "id": "1525255472712329", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304952_1525255479378995_2383276849888741841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a3IJ-Xac48Q7kNvwGagA6-&_nc_oc=AdqCV2KI1NELH5dscjWj_ppeGXYxIB7kmXai23SR2SXGfWBxLTc7Ki3ZUZZigL3mwVg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWVAmn3x4RSAxGdWCKf4h2ShyJsjqnbUVLdmyf_JHj9A&oe=6A732025"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27663235460023582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507829689_1064494443190536_5150766210133381091_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5vCoLgNAt4Q7kNvwES7gcO&_nc_oc=Adr3-lePou7D-n01v-0M0SGudubXnsG9oS3jKGWLGVMbjXB8vgTLjL32XKBFbocQa7c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6wk_9-C1oWTwo3TUJ0wgXXrCtI2v6A-PFL2T8wID7Dw&oe=6A734957"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HARD BULLET", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1748361600, "lastRevision": {"nodes": [{"id": "8116626168444469", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", 
e=6AD3ACED"}]}, "id": "1780552046425232", "locale": "en_US", "screenshots": [{"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luSRMh64lVUQ7kNvwGQgehI&_nc_oc=AdqGbHjELXz7qzS5Uoqd3HZ-MavnPo6ak25lzb4Xoy5IYcIICOM5aqmbu66JMo3l4Us&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaOJZ02Gtwtr2QbG30l6N1jttBvMYIYzRY0GVs13sRpw&oe=6AD39D56"}, {"file_name": "45-1440.png", "id": "721086307153508", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823279_721086310486841_5483727556894742280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_-4UevuNZkQ7kNvwHv7g34&_nc_oc=AdrjA-e-Rb2SnKIEE5bjmuEHiF7XWCl2wl7b1cRHoYFAJg3NeMA2mAQe_WAvW_u4XtY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPezle6NOn6Hy2ITas7_cFgyn2C-BaAr1F-MaMLkT6CSQ&oe=6AD385A4"}, {"file_name": "40-1440.png", "id": "1193063009234855", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391785_1193063012568188_2265459248747162137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSxSZmf5HbsQ7kNvwErvwXR&_nc_oc=AdoG0rcA_8kDlv2gdVs5P8KLNSxwUNgE11dfwfgksBvyQh4yqtFwSq89IcLCGc_veMM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeGBoJ6DeywnK1BkdLO7KmRiNbn1DnwTuKYjZHu2hilg&oe=6AD38854"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2_K4J7GtjQQ7kNvwEHEc7M&_nc_oc=AdpHD2Vk9dZWkYTnkqhpWOw99EuOAGe3HcFL0HgElL_LEeBpiyDLxjw25ABngifjdl0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLlVfrZPAN1JRoe1It7LCmo8Brjiq5buyfG2ZW6RqBVQ&oe=6AD3AB9A"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJtEhOH1ysYQ7kNvwFtRI-J&_nc_oc=AdqzAqaLq7b1H7dwwzQ2nRaz82hCvHE7EJ9mk24NzRxNljo0bgbVYBxIz4-2LeRLh7A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4MPStQX0DBz5vaf_vt5irRD-GJ71UTsh47Gnw7x95Iw&oe=6AD3AFC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER LANDSCAPE.png", "id": "1606525384582772", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604293968_1606525387916105_1938607034778518976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-3AlNhM34EQ7kNvwHqLj7r&_nc_oc=AdrMlwHJZZJtFIG62rDRGioEpkEEwCcg5XzoGtE50h5mYEQxRivYBs8ff9hSl8U2pdk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmmxOY6WSABUEWTMgAeml4pO85iTQcbvoU4EcwGUfM2g&oe=6AD3AAC7"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28252897851057337"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.ocu
0.png", "id": "1060654858865138", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35-brtYhosoQ7kNvwGTpi_G&_nc_oc=Adr04F9Xt-eokvbGMtRUlv84BLAhwZckFUb0B__zKkFJT7LnuUJs8b23lWKej9th_78&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVyiiG00MqMsnpPonwUoU3nVzwTZo1-R9kJqUVyTw7DQ&oe=6ADCB200"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=767wvbK5dywQ7kNvwFndDXe&_nc_oc=AdrYLnGebQ75WpED9JsiJ5WNPERmga7k8bXI7zUpRbKD1NZZLxpyCRHDxDT2HxibqqA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaLPB0ISBtdyG5ni7qjQKAz8BsTmPva7v30z3Ovsmpdw&oe=6ADCD7D6"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F0Ixa4tKWcQ7kNvwHXR4Xd&_nc_oc=AdqfrekpvS8vAxVtIk7KSKH-KkcDs5-uvtFi30Hn5Jk5ZV5MJu3eAxWnRI-VY2Ebfxg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtZuIwR8biCUdDfHbF8aOUwMu23nj1k2vYsrrJ8_l8XQ&oe=6ADCA3DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtJEH1J7YUgQ7kNvwFdYDc1&_nc_oc=Adqk2T3e9eNpEMcI6PHZRzQIJ_jqGKtqTkEA8ok0yizHrvRiQyQ4Rc1XHyux45dnvss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3gHimFxCV0TADyKhQYiYERNbfFglIjG666B34tHrvXw&oe=6ADCD15D"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_t
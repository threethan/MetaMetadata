37_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw28lLjbxFkQ7kNvwEaEJBN&_nc_oc=AdnK4EXTJzgdlrtp73sCKsrJo9mSO319Eu9J-A_ldPP2UE77oBjXEeYgpqAJiAKbY68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQDCtoHRci0FRlvLHQcgLRd_Z1ua3-1IdHqPc8A50LWg&oe=69A05AD4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1rOATooe1IQ7kNvwFCm0up&_nc_oc=Adk8BO_oiSwWuWh0hwdPWnBtZr2xfOqghmitjQBpveprbB4v5mDKHF56sMWT8eoT0wY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftMLHdV5KJ7HZDnUmHkNlbg3bTBs8YN7CVYqd21AiMAjA&oe=69A045DA"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mojbYuoLnQQ7kNvwHmwT7c&_nc_oc=Adm0rmV6tbIMWRO3j_Gv8t_9qAXzGeCSAa9k9WoDHbyZvg9YvwgKaHFBArjSa6MPVJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftpKu9qv_-ky-oowxR_r-PZqADuMgWYiu6soUqpfaflHw&oe=69A04A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER HB COVER.png", "id": "738363902171059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303788_738363905504392_1805520951337612988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5GPjsHoup4Q7kNvwHG8CAZ&_nc_oc=AdkgvVTQ7xssm4XRmnM4myg4ryxxi9A3JhvO0qPatZZMK660q1e6qQa57bgGQ9TAdqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvTxn40Nw8QxHF7gjL0idYPuWiNQQX4p5hIi7NU-h0huQ&oe=69A0569E"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
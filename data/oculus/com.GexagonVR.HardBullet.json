": "en_US", "screenshots": [{"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve8bqVpfzkoQ7kNvwHegsqM&_nc_oc=AdrrdzgiGE0Dern1V1EAMlqiEOMOzTm9bXhGB6M0_iJYgb75MJtTzNo2msWu4ipetw4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzU_lWRQ45pmgdnjpdVdedAn07xcr9z11p7zVBNs38RHQ&oe=69C13B5A"}, {"file_name": "31-1440.png", "id": "1499725134066491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974900_1499725137399824_2833580094718337361_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECPvw68IoqAQ7kNvwGUt9Yc&_nc_oc=AdrGhdGz2NSR2M3lplaWyO5xC9ryHGCJYjy5EjljAR8PR0RHLxrO0g23_izHqhDK6_U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxgXVkjv-DjGGOFE0uIsDkuqvnDhNz_AKoFeA2et3cTA&oe=69C14334"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T4yVh0yhT4Q7kNvwFwrHHE&_nc_oc=AdoUvnpD2x8u_QPMZwA4Fus0WD6OiQhEn-BrBSRAVK17CCFU100QyfpzYh-WWi6RZKI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzFkfSInTRgbZpXzp1sQcxei0sGCjw6jpyX_LKOARMl6A&oe=69C13F80"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSc9kWKBBCQQ7kNvwFohz0v&_nc_oc=AdqAyXsDgCSo9-f2hp7rDY5D4gWIcCGYLBMZmxHLaXNyH-Q6PxhoGOdZHuYcxfBS9a0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVasWbXoEDKWCsH-H-AYolp1qTQPj9_aINZn-hd4aWUQ&oe=69C12D16"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me20gVauMRwQ7kNvwGYQR6Z&_nc_oc=AdoGkBKt14XhUl1olszpL9RnboctdlN5hKJ0B55OWVudGrS1XwCJK-Xza74iC-cnuSc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0ynrVQ_9VluT7r-jMoxLf7-EllzpOjry4_x9XbHWtKw&oe=69C1315E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzudrxlMgjEQ7kNvwHZUyBB&_nc_oc=AdoJ6UDcQb9JxETVK4W-LJDPJRnLqAeqk8MB7iKgQ_VF8aCFcjL2Nuc3xZT9unm32BU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwyzx9riBckeiQlEGbe05EqsudsWu5_6Y94nAZgyICOcg&oe=69C1269D"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9372205966219810"}}]}, "scheduled_offers": {"co
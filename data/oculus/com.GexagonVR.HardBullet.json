le": "en_US", "screenshots": [{"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pP5V8XwExCIQ7kNvwHoWZqj&_nc_oc=Admj_SNfPNwO9N4xhnw7U3cnyWRqcOPe57mYhoIDt0MhOP7CsbKfk_xJFUVRcagEIaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfypX3Nom5HqBHNVTiqWLrrCcmOIVUTU4PYUhABl5WCF8w&oe=69B9525A"}, {"file_name": "31-1440.png", "id": "1499725134066491", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974900_1499725137399824_2833580094718337361_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvI2VwCvgxgQ7kNvwG4vpYS&_nc_oc=AdlJydQIiKmUiIakk6JITBHIlPxZtIZt4CZ_MzpL_5K3MxDecko3aU5lXEv1WHz02K4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzO2zSb5LIe1x9jCefmzm-xfF_W3orPHWIT4te1_GbY7w&oe=69B95A34"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIZkRWOspQsQ7kNvwFdfK8F&_nc_oc=Adl6HkJfLNgBi-Om872BB13POONiA2-jN6P44WB93qG0zrZe-8gq4o2gnCbrmQTE2DI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxY81tKh_Kd43TnPOQ3HpBZliO4nKTr5ng5mQ6OMDOE-g&oe=69B95680"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXZoxQ1QheAQ7kNvwHpcaGJ&_nc_oc=AdmrpR1rl_sT4oPe6Ju5WZ0Ldx-8RfnGd2XDWgNq4gCi6FnBR2H9ayvXasZLVCOIx3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxer-tukKbUV73GzegvjaalzCAMxaNZW1Ox0_TYXy15nQ&oe=69B94416"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0aNMzd4pdkQ7kNvwHKsSyE&_nc_oc=Adnj5Ivt12KpHeDYIccIHHNp_WTsko0jS1_P3l8s2-9AWIjCfDgeHzdI5Gv30VquEWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfUpf9LgRRICdX3vEESVAgsd2WvwFHEmwx-q2VGjImsQ&oe=69B9485E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR4Jh4No110Q7kNvwHCncEq&_nc_oc=AdncIh0WMavbBe8Pt-2j2N5BmEBvgLqrny1VIhrHBUNI063rt41SPIgcLSNd9lGfKJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzb5VD6WI4E9A87OXxlCqVM12tqjmhGpP5SgxMw96H0bw&oe=69B93D9D"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9372205966219810"}}]}, "scheduled_offers": {"
2137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW_wu2qj0j8Q7kNvwGxa03r&_nc_oc=AdkqQ5BIP-5FlaVyOnaSwlXOwh0e_ztwsJ0KIp49qxyF1JaosonaUiPbP3RlE4ittbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfufFO_yMFiRt_hmtEPoYCLVnSuArqDeEmFNhDtNZgIMNg&oe=699DB7D4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxZniGSUNHEQ7kNvwHloZwe&_nc_oc=AdmBeOGCHGohZhlxXibZ9OSvBSMfSUiVkkWnjL0uvt26_lbPQNuXxNm5i0YC6jJ7M9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvtnmd2zj5aHg2j_A9LbEtJq4xvkDez_4bwQkpo03vMIA&oe=699DA2DA"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN_XvQfp3TYQ7kNvwH2Tyox&_nc_oc=AdkMvo9LADzyz0sx04u6HwBVJy4SM0LhRBDxEY4rYxD91ImYm5GPyFdXnOdPZh_KhXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZ8BDcMfe7zM8m7eifvjBN9kcWoaXpeZVe_PvBqXhvMg&oe=699DA700"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER HB COVER.png", "id": "738363902171059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303788_738363905504392_1805520951337612988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvrFEO5woF0Q7kNvwEkRxB6&_nc_oc=Adm6nYZ4NMvRqh08fQRfNG95rvP--0VVNERpxbv8HDYLoJ2Mn_duIiEhvTzK2WmLBDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvbMODoANFo7MhlW2Z89RxC8_gCnVolXwpKiRMcgYXZwg&oe=699DB39E"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
1193063009234855", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391785_1193063012568188_2265459248747162137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmB_RcGgGwYQ7kNvwE8gmMC&_nc_oc=Adr0HJioZ_geKqh3Las00khTWa-Qf-8hxEsOtsn1Q9t2cQcgQkCG3cYl2jw1AuTC3Xo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25JXKqHn5utvwbUIwafbeZhBjhBo-QPM7C2jFOhQTCLw&oe=69E78BD4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSZ4H6orpFcQ7kNvwEA_m8A&_nc_oc=Adpq-HTpOeG3VDjCWIV6PjR3YwvLvZpdRunLIO2s2s7vkud4qGdSAFcEpxw8G9xlFPA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yTaObTS-AQMdwxLXNEae4toNXq0Gw-KmumyfJ0Uwi7Q&oe=69E776DA"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyXZetYmUh8Q7kNvwHLzOiN&_nc_oc=AdrwbwPyio9Ggu4TJKorbp1aMDNMrUsEsjMWsRklMCKYNiNi8rc4DCnQ3ism7vxOjDU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cEZBGDESgQJRFgHy5wK8QrYXbIsccfhxOjWCyd6N40A&oe=69E77B00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER LANDSCAPE.png", "id": "1321497013366017", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824665_1321497020032683_5167739515551596981_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-KuR5aHQLMQ7kNvwH24Ur-&_nc_oc=Adq_u0Y4lF5sUziaoNiFYCF4C7NrBU3xH0Y05bZiDr-eWvKbnhTbkin8XiqhOmz30xE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N5vBXK11n-EgUykzlSWXZBqpkLm2uQ3SEsBtQlpGfLg&oe=69E78B59"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26315098071504001"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821941_1290942003194556_4468545003918627181_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAsGlb4T0GYQ7kNvwEfr6dE&_nc_oc=AdqeiBN01Y6FHTsPw--uJ_6oqhp1ZRumn87XgZANIZxdhE5oiubtU-3QdTmCbp7F0y4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SAXn9Fvw1JsX07EMLvc3R-dl0c24HoXrmT1fn7tVRwA&oe=69E7829E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HARD BULLET", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1748361600, "lastRevision": {"nodes": [{"id": "8116626168444469", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8116626111777808
&_nc_ss=7f20f&oh=00_Af5og1NBNtHUHgwNeFtHBJxPsfpW3dNenG1xT6fYdiZIKw&oe=6A185B07"}]}, "id": "4031526177080810", "locale": "en_US", "screenshots": [{"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRhOZbW1v2QQ7kNvwFi1VyF&_nc_oc=Adou4qbWEi3X5f4fIYfQFtvjfdom1MKBiEi--q3BdfRifIHbCaXcBAjYYs8Xjvq0Cy4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PkKtHJGKncggSi4BLEMa60v1XzVIaUU-RC-2-VxkDZw&oe=6A183E5A"}, {"file_name": "31-1440.png", "id": "1499725134066491", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974900_1499725137399824_2833580094718337361_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S60LQgZRS1IQ7kNvwEvzBGt&_nc_oc=Adr2Nnr71FyKeaVPdDB-lNfPrCvyBbIM4sgq0GfS8V1pH_bkBu1t7TSH4pDEHoai_oA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60YTB-BAPpmCBmM3e6vDGTTBlArD2GUXGYY5JaNFRsiA&oe=6A184634"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPxChN-8DcIQ7kNvwHHyFMf&_nc_oc=AdpAwnQTFNhFdv1i96o_ckAQIbP81BDjqyHnC8j3Pj4ts0YKxY4Q_4ka_6ywVGYCA1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vE0Tl_77aDhrsOylKLXcX1Z0wGP0t2I2vzHkxzV7yyw&oe=6A184280"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4lXBqcEHb4Q7kNvwEMeMUD&_nc_oc=AdqV7uVGk1hkhSLuJ3WVultl57-UieAyavAQLQ4kZYMcppkBQdwIF8UQGR3TrDCysPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yp2MG2u7x1oBUTNCxkHP0McXNxWPRm6tds5iwG9cU_Q&oe=6A186856"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDsPmQM5JBoQ7kNvwEjlaxq&_nc_oc=AdqJ05ULkWAz0Fh89BG1yRYbOsdCUc8RZA2lICoaafLVpPKf9C5_Yzo9pyHztQSH8cY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67LqiLLbWvOZJZSsduhyWtSf9xKSNROUfytHFW08JpHw&oe=6A18345E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRwXfab4lBgQ7kNvwHDUruL&_nc_oc=AdoHTW8GWHPYO0wjbptUC2wY7YhFoZplDjnC3SCXqLtXG0ClJy7ymD7Iz8jvJC8JakY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eiUS81-RaH37k1G8psyRJYVjD4fwkKmaeWguJQoYzKA&oe=6A1861DD"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "RO
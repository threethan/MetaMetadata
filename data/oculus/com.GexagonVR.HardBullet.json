ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF7lXN09gjkQ7kNvwHeNtEz&_nc_oc=AdqJ-BABpVECSUZA6LSvuNtMa-6v1IxgysXo5P9uNYJSThopW3cxdz7nbtEwNbiOkAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWs61odfyyWU8U0X4Xu8DnjUm6bBD0A74-tfp7iqXs6w&oe=6AFDDB9A"}, {"file_name": "31-1440.png", "id": "1499725134066491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974900_1499725137399824_2833580094718337361_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeecndmeZT4Q7kNvwHJY0bQ&_nc_oc=AdoYYGCpKM5cKHnY5GvPV4kiCWL4V6-c2v7o27vb6mHPRaY_fI4IeS6-YrwzYVlic_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHrRp8jKKdX2MjuufEiWqiOGjDR88GAd1M7egn5Z4SSA&oe=6AFDE374"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLiUct4JLvMQ7kNvwGoVkNZ&_nc_oc=Adp7mRpgtRpJG-p8CQQ9KrS8pSSKJ4lDtEa88E5_aBRT1Oxq1F54LWQO3lyLAQp34VA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_z6uMhNFZUwXdgNOugMnU0ZV_PHcLc7gZ1yxgGbLkVg&oe=6AFDDFC0"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KTHW-qzIvEQ7kNvwGAnvfJ&_nc_oc=AdrHHeH9VQrlRm4QtdBzrAswuQx9pT1NDvUzwtPl9QHejMo6mcY-xtIWA3HHta6z4hM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSbKZPiXXKKWJ5UUErcOQ_mfKmufJ1-PEvnNtZB6IehA&oe=6AFDCD56"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDr47Rad3IoQ7kNvwEx94oG&_nc_oc=AdqtmiyptjKQpSUAYj_ezh-ct4KvfMkNjvgJybUFjUS2j9szMbi5zBuS9vemdzJRBMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkQ1L0tBxxiLbFMT6kvhp-TVlrs73HZ1raWQA5o8L1HQ&oe=6AFDD19E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wf_zNu0NFvsQ7kNvwEBC43M&_nc_oc=AdoZTs14Q2vEhjEwUjGKKQzZmOIjlonMDU0oATj0XX6XfPf2pd_frMAT8jEGVO6znzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpPu2TwpBjCiy2O65b7ilU9UL3l-GhylBjJG0CexUeng&oe=6AFDC6DD"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9372205966219810"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED",
ge_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036662_516038291415021_2145851798680707563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RksL8ns0_5oQ7kNvwE7pLMF&_nc_oc=Adk4YFHreXufhtpjFMIWYKUzWDdmtXO-t0EXGfEq7dgPpdcOScJy1wuJg2eAP9NATrQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu8KWWQVh4ytJ1mHZTIwWepGkQSycsBDSynMtMBXbAPTg&oe=69A57047"}]}, "id": "4031526177080810", "locale": "en_US", "screenshots": [{"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTUb_DvQevUQ7kNvwFtdrJT&_nc_oc=AdkP6100T41Kz2azmUVS5OMfUzyspgkjiTYesqlT6f7dtNhQKXgrWCvBgxhkAH466-g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuulALY5cNJEqFyvBeHedCFHLJA_pP3p_Vo6X5YVPlpMg&oe=69A58BDA"}, {"file_name": "31-1440.png", "id": "1499725134066491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974900_1499725137399824_2833580094718337361_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcmlbwT1ffYQ7kNvwF6f3vZ&_nc_oc=AdnIXc0KCFs68OLK5tT3CZjSR4T2ihhP6xQR3XkCjrvANvuKWgYf0aqvhOaHqOgEIRA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfskOnyCqAy3RFZ7MTzWetJhKHlTyJrlSaSY2UxvqWd2cA&oe=69A593B4"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMsIcYWGhSMQ7kNvwGMy29o&_nc_oc=Adl6xqXCbisCukbdGqbsBEyylpNkK8Slt6_4xLq3lNe3mp7GePSI5QwTY4HXNBfEiG4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuianI1ZnyIU_aPOLBzSDqPBublAQiTXq7qYAYHxzZP0w&oe=69A59000"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEcehGVUdP0Q7kNvwGHJaOy&_nc_oc=AdksmsxnV667Cs_7V-PI5Bqeubi9thITQq13RD82hACMUNXDEU67u-Vp5cC1rufRkUs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsRyxoeLrrbL7xv67z0zrVFTc02d5jcuEAdZ7CrtmsLHg&oe=69A57D96"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A7Whosuz-QQ7kNvwFlzVzQ&_nc_oc=AdmMp8_0bnU01SQu-PwWgJsW7mhb60qh6ptv0OdufXcfziRaY2Acuo65qw_KANPyE-I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs0C4NgKA-tiD5cp0buhzD2OGZ7Ln7wrY5rldFUGABZTg&oe=69A581DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19OoYTu-4QEQ7kNvwHlM6V1&_nc_oc=AdlxHwVAtvq7B6ckTctcEVduNh0q5UytHJR4Ru9x1Drt6JClLR0mZ3Rei9xcQZQICLU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfslTnmVRHWnrjbWtTLOpQi28znH2lmqiFm84q17V34xCw&oe=69A5771D"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "
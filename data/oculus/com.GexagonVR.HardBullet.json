0-1440.png", "id": "1193063009234855", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391785_1193063012568188_2265459248747162137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD0_eVTzyfUQ7kNvwGAx8Lb&_nc_oc=Adr5O8g_07Lc0aySEUN37NCG_Dtc5-ePTKFZYRy74t5SrFpKujE8PyxkVNmep7qh6eA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eK-uSoS4lx34AzkNwKy4PiOrkmSzMQ6YKmF09C4lbbA&oe=6A2C19D4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSWXGrVx0UIQ7kNvwGJsIrc&_nc_oc=Adprgcwe7u-fT4Lw7fXk1HoulSc2pa8ZLbZQBM-VK2o1e11XCPgOaXiMlU1ZNIQa1yQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XAHKANwn9Ypo2GMdLN2PW-7gsiY2_LcQsq5AlYm_vuQ&oe=6A2C04DA"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXXxL7klGYYQ7kNvwFcNjUY&_nc_oc=AdrFAvRAOEAYLS-5jA6H1dc2XQFRA1kOM1OsrNEYiYAYJDc5hRan26ufp6cVzxlNrag&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qQyEt7LJsPmToXSzn0Dxt2-oJ81f9KmSypoqXrlj59Q&oe=6A2C0900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER LANDSCAPE.png", "id": "1321497013366017", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824665_1321497020032683_5167739515551596981_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OSKjcshqcEQ7kNvwFUlr5P&_nc_oc=Adpfmyu5j3QDOqaJpfPY81OrWIvjlZkjoje0buXptX8kYTwJn1wbE-G9Z7bketQrpfE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M-PL_0-sevVaxzOw-ZgiRswDd2Bt2h13M3MH2KGCCSw&oe=6A2C1959"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "websit
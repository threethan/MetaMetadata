0-1440.png", "id": "1193063009234855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391785_1193063012568188_2265459248747162137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myYvEgNhzHgQ7kNvwHWs98m&_nc_oc=AdpCwKiCVKKaXtCnHAWxYLIEl7TAlsZQjAcHIrFMeUllE7nDR_893L7LBPI5E6L-USs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lL9r7I19URhasHkNKs0DNMhDKqPHAJ-ltN3n2BpeUFw&oe=6A3E8ED4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt0Ipy0duDIQ7kNvwGUQRAa&_nc_oc=AdqQGtP31hCPGKDC8LiFPu8EVnG1zGPytRXmmd2X67-VkY_HXBGEK407Rods8kM84Nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9qCZRZR7EzKXszeCvgO3vrG4reVGSLMzsvkUoCe0KcA&oe=6A3EB21A"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxscvvY48tQQ7kNvwES7jSA&_nc_oc=Adrvx4wJj_NB74drd2djwBUoEh9L5KyLNyyNBjV1Jw2jLsly2Zm7h-qfysqi2HIyLog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D8cuKp0cxxrWs280fi7BNhbruaSYwXuhYUDcwNnl8uw&oe=6A3E7E00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER LANDSCAPE.png", "id": "1321497013366017", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824665_1321497020032683_5167739515551596981_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdI8HvV4ulgQ7kNvwF_CG20&_nc_oc=Adrc_4f0gRgvin5qutwyg58FiqRYc6utqyIyqIX6Ep8rlKtCKfGZqWHyGelhYlzrU9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X93t6YZVjl4K_XxHjW7Bb4DmspxCy2_USmLlYCC-n0A&oe=6A3E8E59"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "websit
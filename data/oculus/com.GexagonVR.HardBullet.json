_ohc=F7lMMFrHVEUQ7kNvwFJzeLB&_nc_oc=Ado26QAej86bBdX4qIKl0mO6a97ZIS9oHmKjgUMjQ3V5BMtZok7PVRDkd9OIhtDMqHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDkbCN8RmzY__J1-pfJl4JVOgjmNSD0jhTK3h1eZIzqg&oe=6B04731A"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVgljINIcnQQ7kNvwGonbml&_nc_oc=Ado7aOqOm0yHpAydtc529yzALrO87meh2rRmKP1NcWcF337HmjsI9S7nwb_mHyjq_24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGn9ODhiO2tksEjgZy-CvDyv08LzZnFrNplmho7fiB0w&oe=6B047740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER LANDSCAPE.png", "id": "1132355943127900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/793139181_1132355946461233_5349759987188592408_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQettT5VgMQQ7kNvwFmwwoN&_nc_oc=Adp-uGP41jzFoiCwgiVnSqFKJtD5hwrpYaZsKPZL9UREqPV2Gwe-57v52IRXl4ETVeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA5fXgEtCrevQWj6IxwqVD59Jx81BqXs7LGX7_o2VRpg&oe=6B047956"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "b
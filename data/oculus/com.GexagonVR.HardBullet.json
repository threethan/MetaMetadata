e=6ACFB86D"}]}, "id": "1780552046425232", "locale": "en_US", "screenshots": [{"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbjKfsDdWi8Q7kNvwGRr_wo&_nc_oc=AdruoWv64JiDFsZZYxTZuu1ngaWA3GipTAGLQQMBG-VOpBhtQNLaWV6vcDquvWz8CnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqLmUJyyZbhSzbISvm6OlAv2blTt5HsLhCBQXuob_RGg&oe=6ACFA8D6"}, {"file_name": "45-1440.png", "id": "721086307153508", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_721086310486841_5483727556894742280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fe0YeyyNeZ0Q7kNvwEaTmqX&_nc_oc=Adqj70oD0qtjXiiaz3t8HKyyYTAm2Eg25hOhiu70TRRPe_1cbKQ7rWVxTmWgqxuZUb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgQncC9XbH4b48dk6ecMbW7HK1-Ra5KEM2VQHMN85M-Q&oe=6ACF9124"}, {"file_name": "40-1440.png", "id": "1193063009234855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_1193063012568188_2265459248747162137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCQwj_yfiFAQ7kNvwFvQLCQ&_nc_oc=Ado7usXWt7DAgdW-K53hQ8QyEGEe1UCe_v9-jkVM8pqam4vjHbeUd3Cjl2yOdr76ofc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLQHMvfdPiknqDKjLmR2PMHYW_teACXDlHKugZuoMMRg&oe=6ACF93D4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhGMuLoGu9QQ7kNvwGWpiQz&_nc_oc=AdoCuj3s2NKkzxM2wKUX41hE8dsk6GXS3xIvQ7o7H8U0BTWZgT9K842OIxpBF5jX9zU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG2lL-s3X6f6cSTr2onpmI0x8ADYgLrw-SxGM0f-RpZQ&oe=6ACFB71A"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On0l7zqGHf8Q7kNvwHm66kF&_nc_oc=AdqExx2TIQKNDi6pDeePXtBbgh8ceteg9iSvUWxj2sBMesY5FWyVpq8dlJwuenBmCSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4zQTgRjRrYz5AwVO4mmBw3W8ldhBiC72Z595TfcXX0g&oe=6ACF8300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER LANDSCAPE.png", "id": "1606525384582772", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604293968_1606525387916105_1938607034778518976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y6OXeuiVIYQ7kNvwFXVr6V&_nc_oc=AdqhKNY8oDozoKcd5SQoAuMPtbW5pq5r4GFa9cdjkjrn-q0Ck_kCJ8xqd6pL9sxXngI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-NWQFxNwC5ciC6bdKSrnNMxSUtsgALB7ML00U8EHvwA&oe=6ACFB647"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28252897851057337"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.ocu
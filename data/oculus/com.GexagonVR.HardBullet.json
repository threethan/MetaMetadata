ocale": "en_US", "screenshots": [{"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ev5u--x828Q7kNvwFO-Uj4&_nc_oc=Adrge_fUejfIx3nG-QE-YPKpoOArf2F6VI4rpXXbDEgK6qzVe958boncCgfW_1aYk1Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1h47WKDzrZlWxs91uVNjKleEeyEVFCXtMar3iJrm9YcA&oe=69F202DA"}, {"file_name": "31-1440.png", "id": "1499725134066491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974900_1499725137399824_2833580094718337361_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iubvkW15r0Q7kNvwHng6UO&_nc_oc=Adp1hs5FL1a8bIMK6O3X_2DA5L4FzqC6tSF-GvjHqOCeAXfLaCLmzRIP22FtrPpZ4oU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1b_bIYRiJloPmp3EoESOY4XnTGkmumO-dZTm2cawWM3Q&oe=69F20AB4"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAIPZ_gCHC4Q7kNvwEHNMKP&_nc_oc=Adr1XTHBpCMyC3a7OOt9Z_DeOF5cRt5XWoF7ZCKFI9JJZlbWbEm1O5MtAHnp0vOwH48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3A07_CLpvApqw9ljmxODuLpiRT-3eXo6G-Sc7k-6BdZQ&oe=69F20700"}, {"file_name": "29-1440.png", "id": "555907200310751", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974757_555907203644084_7941483578379196893_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZc3UnBikgQQ7kNvwEoTZ0l&_nc_oc=Adp9AE-q-7fzmQOdvd-X5Rj1d47DGoQhaQmtM5yxwUZn1BGfz8apPEXLfLaR7SA-1ag&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1rZgktp-S1iFxwAIepAM_3-Ytm6GGvBOxk4p5Qi1-RbA&oe=69F1F496"}, {"file_name": "40-1440.png", "id": "1360207228277784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031551_1360207231611117_5095208665861831024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLNFvgR05iMQ7kNvwFxDbW-&_nc_oc=AdqIrPanSEaHfZzY5Se-DxnIUen2dXcVwnushFF3-5cMWOKyuAICLyEAn2CogpZb6ZE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08H7PR8dL36qjuRd440-agnD7_FfaSPvgWpRb_RuD6Ig&oe=69F1F8DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER COVER.png", "id": "1293757705189323", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391812_1293757708522656_8620117662000952024_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR6pW--zGpAQ7kNvwFJAyET&_nc_oc=AdptGukfmGuuR44EPgOwWw_sHxaAQAmaJL7iKbP6ipbgQwVqwYE_x1XpVE3QM9M2B-s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0p6vBbjYZ0WblMoZTHyzK1ORG9Be7PS5c2hhjnCxczOA&oe=69F1EE1D"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of **HARD BULLET.**\n\nGet ready for some **brutal and destructive combat** where your imagination is the key to survival. HARD BULLET delivers you the ultimate experience of immersive combat with extreme gore. Fight with endless waves of enemies in the **RIDE mode,** create your own rules in **Sandbox Mode**, and master your skills in the Arena.\n\nYour path to brutal glory is about to begin.\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{608752765195141}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1363437721738155}\n\n# Progression and Unlockables: \nDive into intense RIDE runs to gain experience, money, and complete challenges.\n{1116850786785819}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1842838526465201}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n\n- **Welding Tool:** Connect any in-game objects into one physics object! You can combine firearms, props and living enemies to make your own weapons, machines or monsters.\n- **Enemy Customization:** Create giant you can climb up, dwarves, immortal zombies or just change their fancy outfits.\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "website_url": "https://gexagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "bg", "zh_CN", "cs", "nl", "da", "fi", "fr", "de", "el", "he", "hi", "hu", "it", "ja", "ko", "nn", "pt_BR", "pl", "ro", "ru", "es", "sv", "th", "uk", "vi", "ar", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9372205966219810"}}]}, "scheduled_offers": {"count": 7, "
0-1440.png", "id": "1193063009234855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391785_1193063012568188_2265459248747162137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Byw5C_65esYQ7kNvwFgDo6t&_nc_oc=AdoYUEwBOLzkiW59CgOFZNXjJZVBaVu2H1GFZoW6BZHoiTr-zxxqqavzYk7WOtsmKJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F83RLrM0v_LFloT49rXtVRsP5wfm1VzJeX8uK7f8NEg&oe=6A315FD4"}, {"file_name": "17-1440.png", "id": "1619638305613230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001733_1619638308946563_3828887439833949376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0QwnpAQFg4Q7kNvwHnh9PM&_nc_oc=AdrrlgEN8g5aswp6so24LWEXZC3y_MTwqh_QCdL9O5_Z4QYseQFzrh02_8Rh8UEiaP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kZ26BvNEP-9YtuMoiFjLcM7xd0X5Ae400MY7qBT41Ag&oe=6A314ADA"}, {"file_name": "21-1440.png", "id": "1060654858865138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_1060654862198471_822572205668500382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InofGVzEZAsQ7kNvwGNoxJT&_nc_oc=Adrqyh9SWANo42FoX8rGt5HPmIEhi7xSFDLDYpV9CLND5oGbIbw2NGIV4Q6TmtECejM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VxduwIzrIThhp3U_cb9ZQ_n2CnDDjDVo6SjELARws9g&oe=6A314F00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER LANDSCAPE.png", "id": "1321497013366017", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824665_1321497020032683_5167739515551596981_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_wJTIehS-sQ7kNvwH_dl1c&_nc_oc=Ado4TDp38MQKIqIUU6CaD5kJ3wn-KrQUu5H5L9y2Jtl-GPoRvSb_oXatcc3P1JPcSDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uK1jP81dtboQdcLoXkpSobcT50WvUGGGvrJ7M4jubHA&oe=6A315F59"}, "display_name": "HARD BULLET", "keywords": ["Action", "Shooter", "Physics", "Sandbox", "Destruction"], "long_description": "# Welcome to the world of HARD BULLET.\n\nPrepare for **brutal and destructive** combat where imagination is your weapon. HARD BULLET offers immersive action with endless enemies in **RIDE Mode**, custom rules in **Sandbox Mode**, and skill tests in the **Arena**.\n\n**Your path to brutal glory is about to begin.**\n\n# Slow Motion and Tricks\nControl time, perform slow-motion jumps, leg kicks, dual-wield guns, and deliver powerful punches.\n{1363437721738155}\n\n# Fast-paced Action\nInspired by classic Hong Kong action movies, bringing high-energy mature combat to your VR headset.\n{1472191853800067}\n\n# Physical Interactions\nDisarm enemies, steal weapons, use leg kick, and perform one-handed reloads with our innovative physics setup.\n{593339603533723}\n\n# Weapons\nOver 100 iconic pistols, submachine guns, shotguns, and rifles, all beautifully crafted with custom skins and a collection of melee.\n{1836682263859554}\n\n# Progression\nDive into RIDE runs to gain experience & unlockables!\n{1116850786785819}\n\n# Sandbox & Arena\nUse the ammo workshop, giant generator, and welding machine to build your own crazy weapons in this creative mode. \n{3597752887187720}\n\n- **Welding Tool:** Combine any in-game objects into one! Create custom weapons, machines, or monsters using guns, props, and even enemies.\n- **Enemy Customization:** Create a giant you can climb up or dwarves, immortal zombies, or just change their fancy outfits!\n- **Spawner Tool:** Spawn any objects, anywhere, it's your playground!", "short_description": "HARD BULLET is a physics-based action game, where enemies flood the neon-lit city bringing destruction to its streets. Use slow-motion, a huge arsenal, and brutal combat to survive and unlock new weapons. Prepare for the next RIDE by mastering your skills in Sandbox and Arena modes."}]}, "developer_name": "GexagonVR", "developer_privacy_policy_url": "https://gexagon.com/hard-bullet-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GexagonVR", "support_website_url": "https://gexagon.com/contact-en/", "websit
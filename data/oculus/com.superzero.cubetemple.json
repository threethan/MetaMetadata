he game and challenge yourself\n\nBy controlling the touch panel, you could move the cube side to side.\n\nChoose the blocks of game, put them on the face of cube. \n\nAll four sides of the cube should be filled up in the same horizontal position.\n", "short_description": "New causal VR game, Magic Cube will pull you in."}]}, "developer_name": null, "developer_privacy_policy_url": "http://virivers.com/cn/policy.html", "developer_terms_of_service_url": "http://virivers.com/cn/policy.html", "publisher_name": "Viriver Studio", "support_website_url": null, "website_url": "http://virivers.com/en/work-game-4.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3007762729475618"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139431_1263409187048249_6301824055347511296_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T2zZl51CYUQ7kNvwEGZ1Mu&_nc_oc=AdopFeZKMxnX_AGSbk_Sf2ikfW0Mu8HQbnIyPKJnJBSEFCcgmOvNbmif_pa9Y2o0zTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3dw-qkG-ESQ2InBrlNDEewLTg2a--TaHmWasDN4Kekw&oe=6A998C24"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Magic Cube", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1489561200, "lastRevision": {"nodes": [{"id": "1896182523962651", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defaul
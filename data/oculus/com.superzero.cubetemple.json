562553856_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NMxT-uFT5gQ7kNvwHIZMcL&_nc_oc=AdmyTLPUEbJxvHU7NZHY2gqETe0UmzURl-4Q0lKHrCqiJZcysqmCnQRd6-0xE6WCRZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4FfbdzaZXLLltd8yIcSMNW7E6WO4puGYDjgNKIiCHFg&oe=69AFFDDC"}, "display_name": "Magic Cube", "keywords": ["puzzle", "shooting", "FPS"], "long_description": "Just like the name, in gaming you will go across  vast blue ocean to a magic island, surrounded by a vast expanse of blue ocean, a giant cube in front of you. Game mechanic is similar to Tetris, but it's more strategic, You need to fill up all four sides of the cube  in the same horizontal position, which was able to be eliminated.\nGame Play:\nClick the touch panel, start the game and challenge yourself\nBy controlling the touch panel, you could move the cube side to side.\nChoose the blocks of game, put them on the face of cube. \nAll four sides of the cube should be filled up in the same horizontal position, it could be eliminated.\n", "short_description": "Causal VR game, Magic Cube is coming, which  will pull you in."}]}, "developer_name": null, "developer_privacy_policy_url": "http://virivers.com/cn/policy.html", "developer_terms_of_service_url": "http://virivers.com/cn/policy.html", "publisher_name": "Viriver Studio", "support_website_url": null, "website_url": "http://virivers.com/en/work-game-4.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2112412415582905"}}]}, "scheduled_o
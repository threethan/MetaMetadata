-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtML2ONzRUBN3XvJ5dUlSo7_XYLPNiF8zR_fEeowyxAg&oe=6A8EEA7C"}, {"file_name": "Screenshots_4.png", "id": "749311890732491", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75234372_749311894065824_382352523439772154_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqt3zQLdQDAQ7kNvwGLgQ4p&_nc_oc=AdoId1cawuMiUuPvvjWGKB6DQdHZ5yHYqMgsyjEH9Wcg-cBlQ7PxoORd1UiWh2Xlbec&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsCYH_W-NpwAsZnjlj4ychec_hoDbApKpoqbthO1r0kQ&oe=6A8EBD6F"}, {"file_name": "Screenshots_5.png", "id": "446673594529769", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974577_446673597863102_7902058877799282215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QU7fnmplnVkQ7kNvwFCagO_&_nc_oc=AdoYZvi48ch4p_qNRVwd-xPjJ3X0xNYkEbVqSTK7TFIF78m_UXvZ7jan3gCbTH6ucls&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSIqEsABRJL4PlauWrDGYtKglzqkjaMbdGhn93uDEMjA&oe=6A8EDC2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creciendo Juntos: Historias de Superaci\u00f3n", "keywords": [], "long_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel, dos amigos \u00edntimos que viven en distintas partes de la ciudad.", "short_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de
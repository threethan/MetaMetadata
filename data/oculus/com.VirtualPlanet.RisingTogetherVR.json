om&_nc_ss=7f20f&oh=00_AQPe1N0MF0sosVZeMwkW805caLZa7GUA1MyPCMYu3YlFKw&oe=6AE1F8FC"}, {"file_name": "Screenshots_4.png", "id": "749311890732491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234372_749311894065824_382352523439772154_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JARWvYlApQoQ7kNvwFpm6pq&_nc_oc=AdqW5EKFGMx7F53ck0XYAkBFfveWobhOjZMrhK4xLoobUhGoPGUIuWVqEc-izCHp1JI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzg3TEtC5Q7neCsK4MLYxd9iFQxWOX2AuV4T_0H5wCWg&oe=6AE2042F"}, {"file_name": "Screenshots_5.png", "id": "446673594529769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974577_446673597863102_7902058877799282215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHzauy26t2YQ7kNvwH-pL7_&_nc_oc=Adr9wBtJapNtDrigyyQHYKXxBmkt09rZdjorGUMCI_7JWtQDbnzoo_UTkSUNNBOQHPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMozOfnOfHUrBGdLexKMv6eKnVEYxyjdOq9s9umwWK7LA&oe=6AE1EAAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creciendo Juntos: Historias de Superaci\u00f3n", "keywords": [], "long_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel, dos amigos \u00edntimos que viven en distintas partes de la ciudad.", "short_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel,
om&_nc_ss=7f20f&oh=00_AQI3Ig_wdjKx5k2gWFcr4cfls62_pYcBAVl4I6E59M08dg&oe=6AAA99FC"}, {"file_name": "Screenshots_4.png", "id": "749311890732491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75234372_749311894065824_382352523439772154_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6doTUi1_VZQQ7kNvwHEBP94&_nc_oc=AdqSX5fUk_8dkOBUXRzhNK5f4y08jFvwjs8rp0wK815n48Z-AAqK8OVOWbLt4jnrICA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUX9OzaynqXpSHII20OulINeoi2rKgGob1x6fkovu87Q&oe=6AAAA52F"}, {"file_name": "Screenshots_5.png", "id": "446673594529769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974577_446673597863102_7902058877799282215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WVKz1ZURAMQ7kNvwEbkDWW&_nc_oc=AdquhKWVOvNQBPuSrvCUhiiJz1Etmkq5Pgm4cu7GPRy6gyTG0rWiqxcPPKYl6cBPCIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdsbi4arT0C0LNjy50uoWgmXJYncyMtb1fugEjIM9Avg&oe=6AAA8BAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creciendo Juntos: Historias de Superaci\u00f3n", "keywords": [], "long_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel, dos amigos \u00edntimos que viven en distintas partes de la ciudad.", "short_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel,
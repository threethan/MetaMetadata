om&_nc_ss=7f20f&oh=00_AQR65dfySZ6Tq0lan-M7ETRNF_xEodcB0In1BZA3LpPdGg&oe=6AF89ABC"}, {"file_name": "Screenshots_4.png", "id": "749311890732491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75234372_749311894065824_382352523439772154_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puGEVTtncJIQ7kNvwG64SNW&_nc_oc=Adqka_81LJf6PStWG931CEmXPzKH_CrU-rrlRCZ0mHNwo_bN9fW2LtHixAEnzArUK34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzAL29CyZzLdA43V5-JdupO4HOHBIemF3AyZDBMtLTMQ&oe=6AF8A5EF"}, {"file_name": "Screenshots_5.png", "id": "446673594529769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974577_446673597863102_7902058877799282215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwaybFydpeEQ7kNvwG4RrE5&_nc_oc=AdokEmyD81GGECDfQ7WzZkULbMyV-neROAgA24GWcvODLeLUsLROqDWY417XGCI5Mfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhZJEaowkh5Rjnq8PWs3XQ3AgrivonAGUObvcXmEUpLw&oe=6AF88C6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creciendo Juntos: Historias de Superaci\u00f3n", "keywords": [], "long_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel, dos amigos \u00edntimos que viven en distintas partes de la ciudad.", "short_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel,
om&_nc_ss=7f20f&oh=00_AQNZuvPXh7WRcPD7b1u0GjxjcePCj-V4fx8UrfljWztaZA&oe=6AC6497C"}, {"file_name": "Screenshots_4.png", "id": "749311890732491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75234372_749311894065824_382352523439772154_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOLWyMixmbEQ7kNvwEEBrb7&_nc_oc=Adr6skNbCiDuShv1keXEykiz5zPnAcg7h1Z5txovwjSB2zbg9un43KSxBz5zdz4Kogo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONM_q7vHLNICT4L0Tb1EGGrOPrLpjWEB3KYV27To1BqQ&oe=6AC654AF"}, {"file_name": "Screenshots_5.png", "id": "446673594529769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974577_446673597863102_7902058877799282215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmxkjTpxX8wQ7kNvwE4bkOz&_nc_oc=Adqz_M3gO0wdwrGi4rs93MkKr_iFRbrqbXKy-Y5_GkCfRKYFC-aCYAkj1lScynbFPvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_UtHc2Fje66RZvHwxAbv53YvPjSfescye9X8v7He7tw&oe=6AC6736E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creciendo Juntos: Historias de Superaci\u00f3n", "keywords": [], "long_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel, dos amigos \u00edntimos que viven en distintas partes de la ciudad.", "short_description": "En esta experiencia, comprender\u00e1 los retos a los que se enfrentan las personas de comunidades vulnerables con escasos recursos econ\u00f3micos que se enfrentan a una crisis tras otra, sin recuperarse nunca del todo antes de que se presente la siguiente. \nExperimente de primera mano los retos clim\u00e1ticos y las estrategias de resiliencia a trav\u00e9s de los ojos de Emma y Gabriel,
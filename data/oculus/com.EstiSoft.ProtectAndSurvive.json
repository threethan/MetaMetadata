village needs a protector. Upgrade your equipment, outmaneuver invaders, and unlock hidden secrets as you grow stronger with every fight. Whether you're harvesting under calm skies or fending off enemies under pressure, every moment keeps you engaged with immersive VR interactions.\n\nCan you survive the waves and become the hero your people need? Find out in Protect & Survive.", "short_description": "Protect & Survive is a VR survival-action game where you gather resources, craft weapons, and defend your village from waves of enemies. Upgrade tools, fight off attackers, and survive as long as you can in this charming medieval world!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33158073717170673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499323314_1816520438915002_6428764826769412444_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO3RQM8smQMQ7kNvwETU9xO&_nc_oc=AdqIj2FRi4j4eXSOiZbCYgy7qRKPoysWSkvJRTp8LLDZEUy2Y-IcRVbTEKXQ-2d9l8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7
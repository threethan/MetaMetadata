00f6r\u00fcnt\u00fcs\u00fc 2025-04-27 213001.png", "id": "1026500465536420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393432_1026500468869753_3711177335018890333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58LeWOgFH14Q7kNvwEEr5ib&_nc_oc=Adl-25dcIS9x4LtAL_RmXl793-2pupuu7Ql_IW4Tk03OmineIoBmOYpD45zV3uQQ5Yg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLx7nj00JmkSS4PrOQuvWxomdj1hgpG98cF2KuyCeoIw&oe=69AD6947"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-04-27 212950.png", "id": "1705500646720865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830604_1705500650054198_1465785139807034659_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzEqP284IHIQ7kNvwE-7f0X&_nc_oc=AdmzMehQ7C02wm9WKjWhEF4O2Glik1mZTDZpJBpkmOlaVDSxI6g-Hx6AZfsBWHfeVag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNzuVMX2ZzYTox6uM2AylkaRDCFdLLomqeUxFy9gjdkQ&oe=69AD6677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-04-27 213001.png", "id": "692998833673208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400244_692998837006541_394414230230763092_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJmYc2lkt1YQ7kNvwG-C3r0&_nc_oc=AdnwdlLptdp2Dj7iX1QmBWlnnFHx6Kt54R0ZVhm1SgUWS31kQk5tBAmmdrUMY_vS4zA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7zUKlfk8vDedbgpWo56iOMDW2tRCbqfeHcBY7CUsneg&oe=69AD70A2"}, "display_name": "Protect & Survive", "keywords": ["Survive", "Build", "Survival", "Comfort", "ArcadeIdle"], "long_description": "Step into the boots of a lone warrior in Protect & Survive, a VR survival game set in a handcrafted medieval fantasy world. Gather wood, stone, and rare gems to forge stronger axes, pickaxes, and swords. Use your tools wisely\u2014chop, mine, and battle as you defend your land from endless waves of enemies.\n\nYour village needs a protector. Upgrade your equipment, outmaneuver invaders, and unlock hidden secrets as you grow stronger with every fight. Whether you're harvesting under calm skies or fending off enemies under pressure, every moment keeps you engaged with immersive VR interactions.\n\nCan you survive the waves and become the hero your people need? Find out in Protect & Survive.", "short_description": "Protect & Survive is a VR survival-action game where you gather resources, craft weapons, and defend your village from waves of enemies. Upgrade tools, fight off attackers, and survive as long as you can in this charming medieval world!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33158073717170673"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1372602384078550"}, {"status": "PUBLISHED", "id": "1626744641213987"}]}, "baseline_offer": {"id": "1626744641213987"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770580800, "status": "PUBLISHED", "id": "1372602384078550"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33120137317630980", 
739179721_6426644903785558600_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD_tCn1TRokQ7kNvwE1GLoA&_nc_oc=AdqaUbeQp1xPN4pz_rzuSIMqta5dOgSpr5rwMUdm1oApxWRWoBYIk6-fEY5Pbi5OKtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWA2eGBh7Ir-nefqzpz1N9LYGKUSs_96xKT1D_Epr4kkg&oe=6B103672"}, {"file_name": "screenshoot-1 (5).png", "id": "29657657663859342", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654956704_29657657670526008_398550856735042625_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUSnT1TzsPEQ7kNvwErr_tX&_nc_oc=AdpaEbG0zTVSiQFWwF6XfrtNX5yj_hZS8rKk2M7NHOnT7KDr_MTRnsul3Iqfw0qHbcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxSNziGRfZej3us2t-TmgYTgw06KiAu2y5vy1QX9H9ow&oe=6B103EE5"}, {"file_name": "screenshoot-1 (6).png", "id": "1472373158323615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_1472373161656948_2792800585242881888_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4aynRO5XCYQ7kNvwFgtLFO&_nc_oc=AdpXoJqg70wBizGbn3qvY_tvyyPVs_g12YVtCEADbHoyxELUmkH35uvD5qC9PcQ0aYU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWOrqR7f_HjDrA3wNBnITHfNQxUj79A8QqnG3GBCu-udg&oe=6B103A23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560px by 1440px.png", "id": "2686213901815053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842236_2686213905148386_6243764749465323373_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k543Mh-36kAQ7kNvwG87PcY&_nc_oc=AdrGKm8gz4kWIdx0B71URP67Mw7Szbi-o8KWptC1Y-yGGYp_ZM3z-v6UclMyKJxMMuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXoHe90cXb8-GF-fmf_SWtzZHutCpaK8tDnx3NQvh5YMw&oe=6B1035EE"}, "display_name": "Makeup Salon Simulator VR: Hair & Nails", "keywords": ["Makeupsalonsimulator", "SalonsimulatorvR", "Beautysalonsimulator", "Makeupgame", "Nailsalongame"], "long_description": "# MAKEUP SALON SIMULATOR VR: HAIR & NAILS\n\n## WELCOME TO YOUR VIRTUAL BEAUTY SALON\n\nStep into your own beauty studio and explore an immersive salon simulation made for Meta Quest. Serve customers, discover creative beauty activities and enjoy hands-on experiences in virtual reality.\n\n## HAIR SALON & BARBER SHOP\n\nGive customers fresh looks with haircuts, hairstyling, trimming, shaving and hair coloring. Explore different hairstyles and use barber tools to create unique appearances.\n\n## MAKEUP & BEAUTY STUDIO\n\nExperiment with lipstick, eyeshadow, mascara, brows, lashes and different cosmetic looks. Transform each customer's appearance and express your creativity through makeup.\n\n## NAIL SALON, MANICURE & PEDICURE\n\nCreate colorful nail designs with nail polish, acrylic nails, manicure and pedicure activities. Explore nail art and give every customer a distinctive style.\n\n## SKINCARE & SPA EXPERIENCE\n\nExplore skincare, facial care and spa-inspired beauty treatments in your virtual studio while creating a relaxing experience for your customers.\n\n## BUILD YOUR SALON EXPERIENCE\n\nWelcome customers, complete beauty services and enjoy running your virtual salon. From haircuts and makeup to nail art and skincare, discover a variety of activities in one beauty simulator.\n\n## START YOUR SALON JOURNEY IN VR\n\nReady to explore the world of beauty? Step into your virtual studio and enjoy a creative salon experience with Makeup Salon Simulator VR: Hair & Nails.", "short_description": "Enter a creative beauty studio in Makeup Salon Simulator VR! Explore makeup, experiment with hairstyles, and create nail designs in an immersive beauty salon game made for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/aeroversestudios/home", "developer_terms_of_service_url": null, "publisher_name": "Aeroverse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/aeroverse-studios/home", "catego
.com/v/t64.5771-25/473400726_1386059289217698_8932918588445222419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWpxcDDizhUQ7kNvwGLW0N3&_nc_oc=Adpn5BZNBBvjqOqcYrREoPfv3hQWo-5AfX-pUlG_R39xLlbLwOQ6qSh63umfWrRt4CI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yt4yqJT9grrpNaySLsJs1dQ43ElEJdfvHnWaRu9sQzw&oe=6A1AFC98"}, {"file_name": "SCREEN4.png", "id": "9573055176120330", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393856_9573055179453663_716382385234402311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKVAjH2Vku4Q7kNvwHEt_AC&_nc_oc=AdqkUp_CAJPYKLw3-7wKXP-6HSqSMcCj2J1fSJzhPorR6Mr12ru8wtB1-5DvyY0fDEU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MpdRA5hgo4dIevzDx5XWUfTxsxztp3z9fXuKr4zzElA&oe=6A1AE266"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "1079652253925541", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394159_1079652257258874_5218348700879093003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRIAobNe3coQ7kNvwHxy-a8&_nc_oc=AdossiCOWM0wjYax9D_Er0UYBwT092NuEOGo-IgQyQ7LpDZgftwKl6UftrLHGyelogg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-iTgrfXon0y7sEJ6mJ77mFuy6QSb9bAeFdy-3jOsCiQ&oe=6A1AF073"}, "display_name": "Mafia Brawl", "keywords": ["fighting", "action", "boxing", "fitness", "weapons"], "long_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!\n\n\u2022 4-Player Mayhem: Battle it out in a lively 4-character match, you against the cpu, where chaos reigns supreme! Every man for himself, use your wits, your weapons, and your wild moves to become the last man standing.\n\n \u2022 Endless Action: Fast-paced, intense rounds keep you on 
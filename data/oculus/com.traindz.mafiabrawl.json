.com&_nc_ss=8&oh=00_AfwxkJyul3hCzU-0DFLLjdrEqJFCyS9oVluZd9F7mNlWIQ&oe=69B2A257"}, {"file_name": "SCREEN5.png", "id": "1386059282551032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400726_1386059289217698_8932918588445222419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWo9NE76vRQQ7kNvwGeSl0u&_nc_oc=AdnpqEeUNiDhWCMlePsTSu4_Vjmccq1mn-pQOEqNGuAdxgnHoNHT3dzCVblRBVBIyxs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfypBCC78m_bJQ4UPi3r7ihe0ilshUo3WjDPV8o018Aq9A&oe=69B29DD8"}, {"file_name": "SCREEN4.png", "id": "9573055176120330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393856_9573055179453663_716382385234402311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ9JAulcuCwQ7kNvwHTFIXj&_nc_oc=Adlqa5aNq2u48aBOpCHfuFsJ9gWFdwRCb9MC4Wje5D5PQTfsVAgk9A7q6ua1HhI88-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyUQgB5C5LOWwxzlkO77F9WqR4VuBMeaoRxqMrcBkbNLg&oe=69B2BBE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "1079652253925541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394159_1079652257258874_5218348700879093003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twOpMnTeD0oQ7kNvwGChXEe&_nc_oc=AdkOd2L2zkNoCOmYvyrni-20P4b-7M9zsX8REPUB8HCjNUbGLUUnfcKz6prLEPEEKBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDkSHWAq6GCCn_9pXW8RituqQDI2l-zurPlylZulOutw&oe=69B2C9F3"}, "display_name": "Mafia Brawl", "keywords": ["fighting", "action", "boxing", "fitness", "weapons"], "long_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!\n\n\u2022 4-Player Mayhem: Battle it out in a lively 4-character match, you against the cpu, where chaos reigns supreme! Every man for himself, use your wits, your weapons, and your wild moves to become the last man standing.\n\n \u2022 Endless Action: Fast-paced, intense rounds keep you on your toes with no downtime. Keep fighting until you're the last one standing!\n\nAre you ready to bring the brawl to the mafia? Jump into Mafia Brawl, where the only rule is that there are no rules, just mayhem, fun, and colorful chaos!\n\n", "short_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!"}]}, "developer_name": "Traindz Gaming", "developer_privacy_policy_url": "https://www.biims.net/mafiabrawl", "developer_terms_of_service_url": null, "publisher_name": "Traindz Gaming", "support_website_url": null, "website_url": "https://www.biims.net/mafiabrawl", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9659714194066104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393971_9419000428180036_4787883021051633857_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAy3wvF5VDgQ7kNvwFYg4zx&_nc_o
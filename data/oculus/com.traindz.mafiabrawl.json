.com/v/t64.5771-25/473400726_1386059289217698_8932918588445222419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlZxBcCvPVwQ7kNvwGo68Zi&_nc_oc=AdrbMWlSKPqXzaaBuF3ReWPj3kw4zCHXhzJ3M11JPDPofFkBhTvADg6AQ50sK5jaUgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zAkBTwKauFvhVzwDv4lF2ouFo6Y1-4A-InBBkoecpwA&oe=6A282B98"}, {"file_name": "SCREEN4.png", "id": "9573055176120330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393856_9573055179453663_716382385234402311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2AkcnijPfAQ7kNvwEHMIhU&_nc_oc=Adqy1p1d8LcYBgowM85oFY7UMA1-e-s4iPABwEWgB-J-EPR_YkH1bHUmRVv5DkQY9fQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zn28IIcHYGc8sxrA4pU_hiNsma4jRuTdodLtwf45Bsg&oe=6A281166"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "1079652253925541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394159_1079652257258874_5218348700879093003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eODUCpAVHMQ7kNvwGi8ppa&_nc_oc=AdqcltBU40RmveM9JBSQZ_IE_VpGOglfyOapXGK1e4wOghdpxYEh-BoL-q4MGr-6gD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fh8IO3MzMvvrI63n47iMrmBm1oCPhw7UCzG1CHwLlzQ&oe=6A281F73"}, "display_name": "Mafia Brawl", "keywords": ["fighting", "action", "boxing", "fitness", "weapons"], "long_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!\n\n\u2022 4-Player Mayhem: Battle it out in a lively 4-character match, you against the cpu, where chaos reigns supreme! Every man for himself, use your wits, your weapons, and your wild moves to become the last man standing.\n\n \u2022 Endless Action: Fast-paced, intense rounds keep you on your toes with no downtime. Keep fighting until you're the last one standing!\n\nAre you ready to bring the brawl to the mafia? Jump into Mafia Brawl, where the only rule is that there are no rules, just mayhem, fun, and colorful chaos!\n\n", "short_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!"}]}, "developer_name": "Traindz Gaming", "developer_privacy_policy_url": "https://www.biims.net/mafiabrawl", "developer_terms_of_service_url": null, "publisher_name": "Traindz Gaming", "support_website_url": null, "website_url": "https://www.biims.net/mafiabrawl", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9659714194066104"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1256094896683804"}, {"status": "PUBLISHED", "id": "1256367749541278"}, {"status": "PUBLISHED", "id": "1385439289133399"}]}, "baseline_offer": {"id": "1385439289133399"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1256094896683804"}]}, "liveChannel": {"nodes": [{"latest_supported_bina
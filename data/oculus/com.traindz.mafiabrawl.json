.com&_nc_ss=8&oh=00_AfwuQhcfD6nrZZJ3raZAiY-XDqq7qe99nWG8vO6SvDn0RA&oe=69AC0AD7"}, {"file_name": "SCREEN5.png", "id": "1386059282551032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400726_1386059289217698_8932918588445222419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p92ac-8RSEQ7kNvwGGzSWd&_nc_oc=Adn4m6NiIhjKp1EB-TP-M9x5HLlaoAwvJmBQdCgtdMaQSjU1FDMIP4KImdl2eRyInAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCFl6nRYqz8chGQqSCCWOnQkHERe21imNIEwtdplmu9g&oe=69AC0658"}, {"file_name": "SCREEN4.png", "id": "9573055176120330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393856_9573055179453663_716382385234402311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsRDWb7e7bkQ7kNvwF_eu13&_nc_oc=AdkfD09Bjlq9_cx1UMVQxLlCO6M2BbvxBQtvt_X4AuGQ8eJropNWlO1vE1fLosKT_X0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzu4fK5_ulxbcimRtzZsySXaAqgKtKQXqomIv4iOd0f4g&oe=69AC2466"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "1079652253925541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394159_1079652257258874_5218348700879093003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JT1T01oNR8cQ7kNvwF8IMY0&_nc_oc=AdnXkNLus9ghwjyh6Zxp9-YWlaUSZRRDukki37p2p55W-fzi3Q9Yo-XY1Q-OntuQF7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzncP9yEPtECWC2ozXyrrx5G9i6yYS0k-l83mALalub6g&oe=69AC3273"}, "display_name": "Mafia Brawl", "keywords": ["fighting", "action", "boxing", "fitness", "weapons"], "long_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!\n\n\u2022 4-Player Mayhem: Battle it out in a lively 4-character match, you against the cpu, where chaos reigns supreme! Every man for himself, use your wits, your weapons, and your wild moves to become the last man standing.\n\n \u2022 Endless Action: Fast-paced, intense rounds keep you on your toes with no downtime. Keep fighting until you're the last one standing!\n\nAre you ready to bring the brawl to the mafia? Jump into Mafia Brawl, where the only rule is that there are no rules, just mayhem, fun, and colorful chaos!\n\n", "short_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!"}]}, "developer_name": "Traindz Gaming", "developer_privacy_policy_url": "https://www.biims.net/mafiabrawl", "developer_terms_of_service_url": null, "publisher_name": "Traindz Gaming", "support_website_url": null, "website_url": "https://www.biims.net/mafiabrawl", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9659714194066104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393971_9419000428180036_4787883021051633857_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncJeM-YSiRMQ7kNvwGQChtL&_nc_o
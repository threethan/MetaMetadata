.com/v/t64.5771-25/473400726_1386059289217698_8932918588445222419_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3ya8RDMKpcQ7kNvwF3Cc-R&_nc_oc=AdpH8ix6cKLxiffyLUxSqRiWHuOqFlcnY3oVRdrkIKXCd6w1qwbcX0FJXo7vA8BXP6E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1U0JAXInwcZOgxACxz6m9FeYgHnhIlq1OXj5mYLKs2lg&oe=69F61298"}, {"file_name": "SCREEN4.png", "id": "9573055176120330", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393856_9573055179453663_716382385234402311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQoLd19frMYQ7kNvwHR3hsG&_nc_oc=Adrpydc29IIO4Ht64NFH9GytmLIQ3-cz8F4ZWpwIbM7FCpzYi1dW_KwtfA1SWptZLWY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bSOLnMLOStjJJUrEW6YP29DeagYXlV3TBUMAv1_5fqw&oe=69F5F866"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "1079652253925541", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394159_1079652257258874_5218348700879093003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M6WhDtLubkQ7kNvwHToUE8&_nc_oc=AdpP7oyVgtEEPomYIQD2SAnKJ4mmvV8nzUbEOe06HBf1Yawp-mWNregnpSfOCs79ytM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IF8HusR2FWW2K_DDI5yLAa_raee_xSLiH0EctpyAF-A&oe=69F60673"}, "display_name": "Mafia Brawl", "keywords": ["fighting", "action", "boxing", "fitness", "weapons"], "long_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!\n\n\u2022 4-Player Mayhem: Battle it out in a lively 4-character match, you against the cpu, where chaos reigns supreme! Every man for himself, use your wits, your weapons, and your wild moves to become the last man standing.\n\n \u2022 Endless Action: Fast-paced, intense rounds keep you on your toes with no downtime. Keep fighting until you're the last one standing!\n\nAre you ready to bring the brawl to the mafia? Jump into Mafia Brawl, where the only rule is that there are no rules, just mayhem, fun, and colorful chaos!\n\n", "short_description": "Hello and welcome to Mafia Brawl, a vibrant, fast-paced VR brawler where the underworld meets cartoon chaos. Get ready to throw punches, and blast your way through the arena in a high-energy 4-character showdown. In this wacky take on mafia combat, it\u2019s not just about the fight, it's about having a blast doing it!"}]}, "developer_name": "Traindz Gaming", "developer_privacy_policy_url": "https://www.biims.net/mafiabrawl", "developer_terms_of_service_url": null, "publisher_name": "Traindz Gaming", "support_website_url": null, "website_url": "https://www.biims.net/mafiabrawl", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9659714194066104"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1256094896683804"}, {"status": "PUBLISHED", "id": "1256367749541278"}, {"status": "PUBLISHED", "id": "1385439289133399"}]}, "baseline_offer": {"id": "1385439289133399"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1256094896683804"}]}, "liveChannel": {"nodes": [{"latest_supported_bina
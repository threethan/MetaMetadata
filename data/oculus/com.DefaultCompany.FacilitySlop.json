wE4W7Iq&_nc_oc=Adqjr5w9nk4kDrg0Lp447qKpDKoGla1-VZc-GNVTLBKO_4rQAzqUtnOw6lwNpAX6UAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyHMq_3t4mxp3Ml3TAvy4QDkNsU6PeUiMt6z7Rh-w5uQ&oe=6B01BD8B"}, {"file_name": "Meta4.png", "id": "1088079770262437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593858738_1088079773595770_16537974300653081_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD3ypzO-PJEQ7kNvwGwE2rN&_nc_oc=AdrAuh93owVNyF6t3N7NJhybZnDpufMP4eovednFROtCDsZOoP7eLcgDifujbHH2AWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIWw7b4tCsTw_7h-7ZO7rQ4VrvgT5n8h2QIohRqUPFcw&oe=6B01C5A8"}, {"file_name": "Meta2.png", "id": "1105139355535440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593919959_1105139358868773_3833540517446353408_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWC-VAJSUVUQ7kNvwENFH83&_nc_oc=Adp3RncBnJ6soCLCoSvbcsaPWgT0GkiTUVECu7KxUPyGAsDZudwkwj0i-P9PJr6OezI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWA34gsb-weis1rDlLk8M-MwZlDAN8Cz6x8qywO-BF7A&oe=6B01CE98"}, {"file_name": "Meta5.png", "id": "1069507282728296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620630_1069507286061629_5060059573055002412_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6blpiSBf3-8Q7kNvwGxyZR9&_nc_oc=AdoXV16izXSx_GV_5d6WP0JkjvUug66qrtWna-jvMOY0bBcMJpHc1W5M-AcCrytUcbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8efJyzyPD36LSAHakCO9MImoim5WGVC2Lc9jc4pjUYg&oe=6B01BDB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Slop", "keywords": ["Lethal", "Horror", "Monkey", "Scary", "Multiplayer"], "long_description": "# Facility Slop\n\n**Scavenge to survive. Don't let them hear you.**\n\nYou've been sent into an abandoned facility where something went horribly wrong. The lights flicker, the corridors run too deep, and something is moving in the dark.\n\n## Scavenge or Die\n\nThe facility is buried in **scrap**. Collect it, haul it back, and feed it into the **shredder** to turn salvage into **gold**. But every piece is a gamble \u2014 the deeper you push, the bigger the payout, and the closer the monsters get.\n\n## Hunted in the Dark\n\nThe creatures here hunt by sound. Every footstep, every dropped item, every panicked sprint could drag them straight to you. Stay quiet. Stay hidden. Stay alive.\n\n## Spend Your Gold\n\nSurvive a run and your gold is yours. Take it to the **shop** and unlock **cosmetics** to make your character your own.\n\n## Features\n\n- \ud83d\udd26 **Atmospheric survival horror**\n- \u2620\ufe0f **Monsters that hunt by sound**\n- \u2699\ufe0f **Risk-vs-reward scavenging**\n- \ud83e\ude99 **Scrap-to-gold economy**\n- \ud83d\udecd\ufe0f **Cosmetic shop**\n- \ud83c\udfae **Tense, replayable runs**\n\n**Grab the scrap. Run. Survive.**", "short_description": "# Facility Slop\n\nTrapped in a facility full of monsters. Collect **scrap**, shred it into **gold**, and spend it in the **shop** on cosmetics. Go deeper for bigger payouts \u2014 but the monsters hunt by sound, so stay quiet.\n\n-\ud83d\udd26 Atmospheric survival horror\n- \u2620\ufe0f Many unique monsters\n- \u2699\ufe0f Risk-vs-reward scavenging\n- \ud83e\ude99 Scrap-to-gold economy\n- \ud83d\udecd\ufe0f Cosmetic shop\n\n**Grab the scrap. Run. Survive.**"}]}, "developer_name": "NullPoint Interactive", "developer_privacy_policy_url": "https://sites.google.com/view/psgvstudios/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/psgvstudios/tos", "publisher_name": "NullPoint Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/psgvstudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "64435487310671
25/499619450_2256767921775330_3278203843775897444_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhokM0WjRUIQ7kNvwErGeAu&_nc_oc=AdqApPRh2voVu6Wdr02RwLQnez1JSsdb4pFwjtpdUkbd2pebC4L0ah2R4UnFUPrOuWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzreCB_Ub7hwdEXcHyPs0BhjXt5ACNoTdGXH8c7EmZ_w&oe=6AFDC5B4"}, {"file_name": "SceneShot_2026-07-31_21-23-18.png", "id": "2046964162569264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_2046964169235930_711792534227357966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeScERvNyucQ7kNvwFgG_UK&_nc_oc=AdovL6-Ht4e62gzqQ_jEfa9uwXB7TiBkoukYviixAxY33CJlE3UZrQjVfQ8APhFaw68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqTkKPvkRx8wxCRUZIlYziM9AriK2T8oqJQdIxakudhQ&oe=6AFDC769"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Slop", "keywords": ["VRHorror", "Coop", "Scavenge", "Monke", "Facility"], "long_description": "# Facility Slop\n\n**Scavenge to survive. Don't let them hear you.**\n\nYou've been sent into an abandoned facility where something went horribly wrong. The lights flicker, the corridors run too deep, and something is moving in the dark.\n\n## Scavenge or Die\n\nThe facility is buried in **scrap**. Collect it, haul it back, and feed it into the **shredder** to turn salvage into **gold**. But every piece is a gamble \u2014 the deeper you push, the bigger the payout, and the closer the monsters get.\n\n## Hunted in the Dark\n\nThe creatures here hunt by sound. Every footstep, every dropped item, every panicked sprint could drag them straight to you. Stay quiet. Stay hidden. Stay alive.\n\n## Spend Your Gold\n\nSurvive a run and your gold is yours. Take it to the **shop** and unlock **cosmetics** to make your character your own.\n\n## Features\n\n- \ud83d\udd26 **Atmospheric survival horror**\n- \ud83d\udc80 **Monsters that hunt by sound**\n- \u2699\ufe0f **Risk-vs-reward scavenging**\n- \ud83e\ude99 **Scrap-to-gold economy**\n- \ud83d\udecd\ufe0f **Cosmetic shop**\n- \ud83c\udfae **Tense, replayable runs**\n\n**Grab the scrap. Run. Survive.**", "short_description": "# Facility Slop\n\nTrapped in a facility full of monsters. Collect **scrap**, shred it into **gold**, and spend it in the **shop** on cosmetics. Go deeper for bigger payouts \u2014 but the monsters hunt by sound, so stay quiet.\n\n- \ud83d\udd26 Atmospheric survival horror\n- \ud83d\udc80 Many unique monsters\n- \u2699\ufe0f Risk-vs-reward scavenging\n- \ud83e\ude99 Scrap-to-gold economy\n- \ud83d\udecd\ufe0f Cosmetic shop\n\n**Grab the scrap. Run. Survive.**"}]}, "developer_name": "PSGVStudios", "developer_privacy_policy_url": "https://sites.google.com/view/psgvstudios/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/psgvstudios/tos", "publisher_name": "PSGVStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/psgvstudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37467437676204207"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2232781687500047"}]}, "baseline_offer": {"id": "2232781687500047"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787617800, "status": "PUBLISHED", "id": "2232781687500047"}]}
84_1846030897173339440_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc-KNdbOBJIQ7kNvwFRbMPL&_nc_oc=AdomajcLCqfzc9mpccbJ0nIuF3kwLYVNUnll6KkfDJcx5_U7ec8K6kDOhjCmQO45Bpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVgn2hWwbzbxZ4qh3PgmFqGk3GKTxskZgevNCMns-Vtg&oe=6AEF5E45"}, {"file_name": "SceneShot_2026-07-31_21-10-12.png", "id": "1277835354282857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_1277835360949523_7195889769465208245_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EtvLvtQAAMQ7kNvwF0uOxr&_nc_oc=AdrHSw96McWBQiMYpCk9bSV3-w08k5oK-BpDBP1PCCRpEp-NUBlukbZP-lumsu-HCdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjEn7RLlJJGewXsXT0MrTYtPMs_eIBiD-EbGSS8TREIw&oe=6AEF351B"}, {"file_name": "SceneShot_2026-07-31_21-26-46.png", "id": "1061952672918121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1061952676251454_6836673684159643115_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ePgKf9CxvQQ7kNvwHdHrp6&_nc_oc=AdrHjiiOe6ucA-aaGs4ZvAIaWREdnIbZROQRmYkr2UfY-MpagL1pllde9Ds1XHp_D-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQybMx0pwc2mhxAzUuRvl_oW46Khe_HEQeNx8cOtX5jVw&oe=6AEF4FDE"}, {"file_name": "SceneShot_2026-07-31_21-21-02.png", "id": "2256767918441997", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_2256767921775330_3278203843775897444_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlvY-yy67vsQ7kNvwEto9Zm&_nc_oc=Adog64fCZLM6EEIXqnMCR8UwemSItL9ojlQCcmOhIm9fvD1VeR9sZGeFZD8IkyorbsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRerdHG2za7w1K0TXXjP5-hrFXRvsx4MOVbGE7YQqcWCA&oe=6AEF4534"}, {"file_name": "SceneShot_2026-07-31_21-23-18.png", "id": "2046964162569264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_2046964169235930_711792534227357966_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgatgOPQcH8Q7kNvwF0Ly9K&_nc_oc=AdpjOHy7BTXKsI2n_R5HXF8TwWQwfBQXkvtFKSG7zba_sNi0bFS4kZc6n2WiDO21pP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAYJfGovQwg9Z5ADATgCfOKDfgWiK-B8Wkix1CT8MFfQ&oe=6AEF46E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Slop", "keywords": ["VRHorror", "Coop", "Scavenge", "Monke", "Facility"], "long_description": "# Facility Slop\n\n**Scavenge to survive. Don't let them hear you.**\n\nYou've been sent into an abandoned facility where something went horribly wrong. The lights flicker, the corridors run too deep, and something is moving in the dark.\n\n## Scavenge or Die\n\nThe facility is buried in **scrap**. Collect it, haul it back, and feed it into the **shredder** to turn salvage into **gold**. But every piece is a gamble \u2014 the deeper you push, the bigger the payout, and the closer the monsters get.\n\n## Hunted in the Dark\n\nThe creatures here hunt by sound. Every footstep, every dropped item, every panicked sprint could drag them straight to you. Stay quiet. Stay hidden. Stay alive.\n\n## Spend Your Gold\n\nSurvive a run and your gold is yours. Take it to the **shop** and unlock **cosmetics** to make your character your own.\n\n## Features\n\n- \ud83d\udd26 **Atmospheric survival horror**\n- \ud83d\udc80 **Monsters that hunt by sound**\n- \u2699\ufe0f **Risk-vs-reward scavenging**\n- \ud83e\ude99 **Scrap-to-gold economy**\n- \ud83d\udecd\ufe0f **Cosmetic shop**\n- \ud83c\udfae **Tense, replayable runs**\n\n**Grab the scrap. Run. Survive.**", "short_description": "# Facility Slop\n\nTrapped in a facility full of monsters. Collect **scrap**, shred it into **gold**, and spend it in the **shop** on cosmetics. Go deeper for bigger payouts \u2014 but the monsters hunt by sound, so stay quiet.\n\n- \ud83d\udd26 Atmospheric survival horror\n- \ud83d\udc80 Many unique monsters\n- \u2699\ufe0f Risk-vs-reward scavenging\n- \ud83e\ude99 Scrap-to-gold economy\n- \ud83d\udecd\ufe0f Cosmetic shop\n\n**Grab the scrap. Run. Survive.**"}]}, "developer_name": "PSGVStudios", "dev
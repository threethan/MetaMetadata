wG7_pto&_nc_oc=AdpRSZnqiugR9fLR6-iQTQRju5LeSTK7DezCPCp4nUB6YYUt32818BcIefJuZZEFpjk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAXALhBZtbN5-UMQFKDhit-MG2WAEkpuxxBs_PJCPkiw&oe=6B08550B"}, {"file_name": "Meta4.png", "id": "1088079770262437", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593858738_1088079773595770_16537974300653081_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ao3PYnEJC_IQ7kNvwGH5H6_&_nc_oc=AdrGjB7Gt1XZvoRAVO7B671zRq7-rJYHkiWEHObY8wwq7m3o1mKhpVio0cSUX5hK9fE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwmnN68eCJaLtkx2pE6vtVNGZY87hOjy73jw4fZEQ5jw&oe=6B085D28"}, {"file_name": "Meta2.png", "id": "1105139355535440", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593919959_1105139358868773_3833540517446353408_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyniynHo78gQ7kNvwF-Su9D&_nc_oc=AdrlUsYpqjVlW4usPsZUbzN7CBrHA34NCpIv3imF2vgzVvRLfqDVZsQYn44LzDYtCC4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMsOsdtvCWGKRJSUA7imGgmch6xnJAtIEKbs1JrZnBqQ&oe=6B086618"}, {"file_name": "Meta5.png", "id": "1069507282728296", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620630_1069507286061629_5060059573055002412_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7G8djxHiWwQ7kNvwEBIK3-&_nc_oc=Adq5oHCONMalCnqU362UUaYbU_H857haRcqSc_tqdEl4GCDn0UBQMJ78TNzmkUxy_pk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCBpNPr_61mJGuwrvg12l9840xVIFiAct0LlJ1uURdgQ&oe=6B085532"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Slop", "keywords": ["Lethal", "Horror", "Monkey", "Scary", "Multiplayer"], "long_description": "# Facility Slop\n\n**Scavenge to survive. Don't let them hear you.**\n\nYou've been sent into an abandoned facility where something went horribly wrong. The lights flicker, the corridors run too deep, and something is moving in the dark.\n\n## Scavenge or Die\n\nThe facility is buried in **scrap**. Collect it, haul it back, and feed it into the **shredder** to turn salvage into **gold**. But every piece is a gamble \u2014 the deeper you push, the bigger the payout, and the closer the monsters get.\n\n## Hunted in the Dark\n\nThe creatures here hunt by sound. Every footstep, every dropped item, every panicked sprint could drag them straight to you. Stay quiet. Stay hidden. Stay alive.\n\n## Spend Your Gold\n\nSurvive a run and your gold is yours. Take it to the **shop** and unlock **cosmetics** to make your character your own.\n\n## Features\n\n- \ud83d\udd26 **Atmospheric survival horror**\n- \u2620\ufe0f **Monsters that hunt by sound**\n- \u2699\ufe0f **Risk-vs-reward scavenging**\n- \ud83e\ude99 **Scrap-to-gold economy**\n- \ud83d\udecd\ufe0f **Cosmetic shop**\n- \ud83c\udfae **Tense, replayable runs**\n\n**Grab the scrap. Run. Survive.**", "short_description": "# Facility Slop\n\nTrapped in a facility full of monsters. Collect **scrap**, shred it into **gold**, and spend it in the **shop** on cosmetics. Go deeper for bigger payouts \u2014 but the monsters hunt by sound, so stay quiet.\n\n-\ud83d\udd26 Atmospheric survival horror\n- \u2620\ufe0f Many unique monsters\n- \u2699\ufe0f Risk-vs-reward scavenging\n- \ud83e\ude99 Scrap-to-gold economy\n- \ud83d\udecd\ufe0f Cosmetic shop\n\n**Grab the scrap. Run. Survive.**"}]}, "developer_name": "NullPoint Interactive", "developer_privacy_policy_url": "https://sites.google.com/view/psgvstudios/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/psgvstudios/tos", "publisher_name": "NullPoint Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/psgvstudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "64435487310671
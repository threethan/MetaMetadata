_name": "Untitl23423423423ed.png", "id": "2135330050732535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313110_2135330054065868_7400487896676868742_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUm4hcgCdzIQ7kNvwGsrGWV&_nc_oc=AdqUZ7ahOgXH2UGZGbdAdKXLAty-lwMQ-OhMrurlbS8hzAZ9m4uPMohI3gMxqLiv2zY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-dqHnUdhsSNxxtPnPO3lEQih53TIPeePPztmXL0EpQw&oe=6B05A3F6"}, {"file_name": "Untitl23423423423ed.png", "id": "1405492164831272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_1405492168164605_1609528628850614005_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9AXNR5xRbYQ7kNvwHndqa5&_nc_oc=Adp3Pgez2Cl5FDTk5L4KeTDjtBJB19wiMUKcScv4ENyCPJIiNpnD6cf4JwAmA6q4d3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRytXVafuEwkCUe6Wi2MeRDpSFnTokduBRW02hTwjDSNA&oe=6B05A973"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Tagging", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Prism Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Prism Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "JKS", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hYEf1vBkkPNtDsqfL_OXBRrrTjioz2SfTjFN0eFddes/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "JKS", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-tag-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1277061732150828"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293669_2160467454524607_7908875189330945324_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVegYqRgspYQ7kNvwFHM_Qa&_nc_oc=AdrH2es1b_NIoWPv9PjBKMbF2gV5Vvq0lQHrA1A_TxkDZMHCtqLROe7abAMGd5CHpho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHattv98ulCgNFm1V8J7fxqkO_dcyVQVktPvdoazQmlg&oe=6B05BBA2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Prism Tagging", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1785878400, "lastRevis
_name": "Untitl23423423423ed.png", "id": "2135330050732535", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313110_2135330054065868_7400487896676868742_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJdHlwZpyDYQ7kNvwFoQKxk&_nc_oc=AdoJ8nBWrWsCC-PaqD_z9A_BlyvMUM0trIjTW1hN8x3Rl6KTAAylt0dPsJYkJL4DkWw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwtEe9iaTYndWdHGV5WWbY63VmaaSyxg3Y650Qe0RjDA&oe=6AFB17F6"}, {"file_name": "Untitl23423423423ed.png", "id": "1405492164831272", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303445_1405492168164605_1609528628850614005_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o57HcGm1CnQQ7kNvwEiQXh7&_nc_oc=AdrUoWw15TcO77JqsRgURB66xwHQ42IuNTY4Zv8vEAR7H8KmxArLygZ2sZTdLMEOQFg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDl5PE7htmZG2LsycFVfyvjhEDi6JSvaB8utBKiLLm9A&oe=6AFB1D73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prism Tagging", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Prism Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Prism Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "JKS", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hYEf1vBkkPNtDsqfL_OXBRrrTjioz2SfTjFN0eFddes/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "JKS", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-tag-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1277061732150828"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499293669_2160467454524607_7908875189330945324_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1bE2V2Jqu8Q7kNvwGLsuQQ&_nc_oc=Adp6_Jf4xdsmSaxrj_j5EPDyTlzsW9-rM1uRdUs9A2KN_RH9qClxqAKQdj-zQbwSxvM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdukMO9w0NUGa6X_ZEH44_DjXEEA75rIWSQakoLG7u4Q&oe=6AFB2FA2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Prism Tagging", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1785878400, "lastRevis
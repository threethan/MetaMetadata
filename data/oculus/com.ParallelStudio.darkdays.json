09BD06"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH4JSvjvG8oQ7kNvwEplzOe&_nc_oc=Adq7_Ho8x368CVXHnQ5_IzN16TeaGLlHz0XrT--GOvzqXHcW8aallZMxzarTc9P4xXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLggfCiX6MBkUz-nyCgx-vNb56UxoJnZEPN64VwYatJw&oe=6B09AD4E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpjJgDP7llUQ7kNvwEtmneG&_nc_oc=AdoCmREspzb-kzgARAY_16Naox4J_CnH0jVK4MNOUNjcZQ_wev4UJ6MWYOA2TGKw6Tc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7uZsnk40SEFx9AtRKhWI0IH12iu2VyQyZEryZhFpvmw&oe=6B099AB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu32sH__RRAQ7kNvwFLYAy5&_nc_oc=AdreM-MEiX3QnWcSAks14nF8AP8iTYb4GobIAQjrLN6PfbwmCiCoG4WptfQhBqHDF3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyVEFxgZKqtgpGUm7dy1JoJ2EhWriAglXJjDDaGAiI6Q&oe=6B09B817"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": 
21089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M6XPv8iG8gQ7kNvwGlytRk&_nc_oc=Ado0HEktWwejpdzLgW7psxVSSoEaH12uhJkrki0d0KW3yoCbRYSte1aeJPeuA7cM_NE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWSvpA7ZVMOzN7IPTkugLrxdgskyghojLuBASy9MWYvw&oe=6A9023EF"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6qfcXp7peEQ7kNvwHEv_ju&_nc_oc=Adp-GCKvhriXBtPhkeULhMuNhdTnqWdxmkkuIrJZenfNKZDKrWbjhSvrDNX9mVlJ4ag&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP_jTEpWSCY0vu_BnNYBrhGh8NMktWDMCqVMU2cegVxg&oe=6A900CFE"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-Wm4ZAkuvgQ7kNvwGe9J8E&_nc_oc=AdpDEypiaWAy-eqxe7r8iE72yR-f3wnzp7elcKfcWH0H_-Ymh_5pijPvhIjPMbpRR3k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdFeLGfTXd-NS0f9kjqny7qpb47B0ybikEicbhgb-LWQ&oe=6A901307"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeI0HOad8-IQ7kNvwFRVYfB&_nc_oc=AdocsbGpqEG0Y3O0Z6QNrZRJG7OO7lgUnSXYYSiUEDjhaSVeXg50grTX2L4JdLf_GQg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZt2ZGl68cpN-yRY9xPU-J6bdDzR1Qya6rVKeZlEw9HA&oe=6A903AC6"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anZgNd0frD0Q7kNvwHRyfgx&_nc_oc=AdqsLvQbHv76pPuJLhKZzd9b7TlMFswWQs5_XKh6j3IRtXDihg4g2ePN1pN8ldFxBEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0PZBDw5plw3Gu1zVxhOgBzKaMmGjRISFaDvh7Lr0iPQ&oe=6A902B0E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LD0NvawEeK8Q7kNvwHGXLcR&_nc_oc=AdpqVCuD2AZLFGhivZUQE-r4AJBDlpBOniNCTm_xeKvt1GRw5miEdeQ4OZUyPCNX_nA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeJunmmUbHbLTDaV9nNjnAvzCpgbXAhovNLY1gVK134A&oe=6A901872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdZP7wXo7RoQ7kNvwE7GpKa&_nc_oc=AdpoX8BASmyVx4H0QDeyjSJlO0lgjnohGW1-gs5RiGCJK2wJqEjV77ZDOsNWAaUlMlw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP4SxDtPzj5CdrwSSvJIHFZCbL2yPuj4s1ZgvFQpeg5Q&oe=6A9035D7"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2071477123493442"}, {"status": "PUBLISHED", "id": "1016870197377134"}, {"status": "PUBLISHED", "id": "1600523731881269"}, {"status": "PUBLISHED", "id": "981799081020460"}, {"status": "PUBLISHED", "id": "1572468043824161"}, {"status": "PUBLIS
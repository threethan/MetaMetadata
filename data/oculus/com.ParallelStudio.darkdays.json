21089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aimeXV4QtYQ7kNvwFvIEmI&_nc_oc=AdqWbnFbthkUj53sXdAme-HtDFtbjKsU6PCSNBGnwIeQ5YbgUcylC07hcrYzI1sZTu8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVzjUMAtXzXsRB9H8TAkngHnH0JgAhaJXojNhZHZFLxA&oe=6AF9D42F"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCR_9-NYBUMQ7kNvwGbYUb1&_nc_oc=AdqNZcMkitwQ71GjEiXNyBhqDDnw3Fi5vsZdPvPdHHZsQkB5Hii58qRa9WXWbHse2CY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAXaJsjHO7Zp8SJcIfcq0m30HFP5bYbgaoSJEbgNP7sg&oe=6AF9BD3E"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvMH63XLMzcQ7kNvwHc9bNq&_nc_oc=AdrnwrY4mZwAUQ31_mrkGHRSW0Qh7izSW7rHU_Qt83ylsaHUxMNS6RnmKpSFUxekL4k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA0x6EQZ8f7hTv4W0sPJyWNU14A-6__akiRgPeaFBXUg&oe=6AF9C347"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khIU0W1P1ZoQ7kNvwEaoBvB&_nc_oc=Adrjr2eMnuZIHMpIVirf4-ZM9_R7aGCabE5mDdR6s5NQgZdaOvYm3__Hx2MbROl9WiI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJskEXpGB028UclEUWjjtEiTifaz5QpU08BEDg03a_EA&oe=6AF9EB06"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-GWF0-1lzEQ7kNvwEHyzyQ&_nc_oc=AdrGglGRLobmdfRDaZTJ7gxFWgZ54SP5EAjae90Jp7CNmyeBTa-ABsBwAKbx9e3adkA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR3qNOCGor-5KbhoAQOE0WDFb5voKc4dWl4EEb0T6MyQ&oe=6AF9DB4E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5iKaf-HPNUQ7kNvwHwCh3i&_nc_oc=Adp_4X_Kp5zb1k1r8wLFG1Ds-swUYunX9fl0zvCoWBxiwAnkU6pn-DJLxNew_udFKhY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR28VZbIuZ1WUdfijflDf7rQ3ZzkB-3L4wgdNqOax5ciw&oe=6AF9C8B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a27HCtFOSrwQ7kNvwHQ6KbD&_nc_oc=Adost6x2hweSu_i68afXSzE_b-V_-CdAnTR0yAwN42dFXe8nh2URLqYrW4PwwBpQGNg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Ce76gIJYgWWX7rdYLh4yCDoW43BgnKpiXQdyByLkPg&oe=6AF9E617"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1408485242356673"}, {"status": "PUBLISHED", "id": "1100900312465339"}, {"status": "PUBLISHED", "id": "2071477123493442"}, {"status": "PUBLISHED", "id": "1016870197377134"}, {"status": "PUBLISHED", "id": "1600523731881269"}, {"status": "PUBLI
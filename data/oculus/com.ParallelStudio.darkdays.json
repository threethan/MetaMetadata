1089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReGa8sng7agQ7kNvwH0s6EI&_nc_oc=AdrhfkdnbUA7mXJIQv6m9WJq0YW7sdYrZ8xElRmwPFhCcX3e3AQUT5Dxx4mzIIJeAcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88SyJg7TFI6S35zfwzwu4t9139orFoliBAvk-F8p64Rw&oe=6A47D9AF"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t814NMuwsw0Q7kNvwFVqyWp&_nc_oc=AdoaLoVzqPkTqrocIlJLAgEI7T7ntS4g0i-SRsvrP3YMJj3fqiRJF-iA5wK_ydMURFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r-h5AgDyquvo46szP4itQnSEiOpB9eKYNXUtjC_zPhQ&oe=6A47C2BE"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SieVyTZNxXoQ7kNvwEBh7R9&_nc_oc=Adp6Q_MNQsePMFREENYHydnrFCQMfJKzoE9VLfLLglOjSdmj-L96zF34apfzvVJtr0E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s2WkPt3p_4PB44Qd3NumqWB8Ne9o1OR-lM_uWX1YWdA&oe=6A47C8C7"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rvNuC51JNIQ7kNvwH7emNe&_nc_oc=AdrECbdwABz76lZ_0Q0-bkdsP7SBVmsngfqZFYgS7SHE3YupRh16q_y2nPC4OeE7E0M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IpFtQO0Bv0Ro167JwXXWWAfwv8y-59L-FEBX1aFn3yQ&oe=6A47B846"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkD8Iq1Np6AQ7kNvwFUHeuC&_nc_oc=Adogtt15VCWgD1gxEf32Ud2OIUTFRha_3j1VBD3Ym5jIfO3xGdb6eRopPM5J7_dJvpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PO6pLsw66ziojAjOAoP-8A9PSQhUZ6eKdN98ybatTgg&oe=6A47E0CE"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7lfXvmMYoUQ7kNvwEFecST&_nc_oc=AdpTIY5KZNyhG3ohpCQZKnzAgOrlbleu2Ijgg9vJNfCAdVV98o7WsAhRsodUkNFH3Zg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fv5SkyE2z13qRdhPseHHnu9_87hL2a8OH0mEQECkUXw&oe=6A47CE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m7h-dhXbqgQ7kNvwHzY8jD&_nc_oc=Ado7OC-b6WgKPHqHjtonk2w_1Z8uA9hkj7MdjAEOt5dM6k4wf8KA_8zT2kEXQswSsiM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8L4XiHa7Yg-H3jaOeQwgf4zoIJioFILwrhiqR9wCV4g&oe=6A47B357"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1600523731881269"}, {"status": "PUBLISHED", "id": "981799081020460"}, {"status": "PUBLISHED", "id": "1572468043824161"}, {"status": "PUBLISHED", "id": "2360783164370798"}, {"status": "PUBLISHED", "id": "4309403332612336"}, {"status": "PENDING"
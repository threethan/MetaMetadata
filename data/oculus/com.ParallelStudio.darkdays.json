21089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHtjpZqwkIsQ7kNvwF9uwG1&_nc_oc=AdqOCUZzBn7V1PQhnD4Icr1SRryl7-uV19Gi8-qdK8sp5gYFgXNngVhAXr27Pw_yAu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjWr6_njUR2fRgspIX2SsDH6-nAD_IlWXK71S9zhNn_g&oe=6AEA022F"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_Q5GXZYTzoQ7kNvwEoR9vw&_nc_oc=Adr3OBQ1qt2wMHfeiXMJa8HCk5UxuzwslxsKMTIYkvQvONMeB4nr0VHLJsjytJ77RlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO7-e2G-AyJcNCmTnTj_oBs9a0b70R6nFzYGzqis_whw&oe=6AE9EB3E"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUpS0nibiGkQ7kNvwGOyrtO&_nc_oc=AdruOXE7nxfL44wU_pXN_0CkURJ5moVBXEGqHEARtZfjqcZpSxgQ7tXGkQDSWrj4Drc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdRqA1BNWQC2QD7f4SoIg7n8c4IDQqef7Xv8V7akTvDw&oe=6AE9F147"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz4Yg8JuUmYQ7kNvwF_obB6&_nc_oc=AdqlT_2eSas98ZLj1kKjhnn9PiOngruG1vMhmrJqTI1XVKP27-G0xQQKBbB2K3F5YtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWeN0hX8tjooG2OQXfRI0RyhaNXH8AVSMYyo-r8VOZxw&oe=6AE9E0C6"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY_Yaejv4BwQ7kNvwF_Pzec&_nc_oc=AdqRy_HD70ew6ahGuOy-1LWBnodvR0NAZo5bMowHEnawbODDKxBvHY0m1-L-ijVZnAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTencmflHDyFKRR3iMn1TwPXdEQGv2qzpFvwjElH2_ZWg&oe=6AEA094E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hDOYhiTtYEQ7kNvwFhm0XP&_nc_oc=Adp1XRN6jaBGx1i6JvHEY3_pEeQr1bO7Gmfop6a2RRd32Uv4kCNXCghfiQcuOXbo-cE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTttVyHWhTzC0LKcHImtukBbC0tsS4nawQwVCV-m8dwFQ&oe=6AE9F6B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SAm2WadU1YQ7kNvwGFBGii&_nc_oc=AdrPEO7NdLPVNY_VypuFCJHWOIGZ2xtvRXR2ImEmhT3DsDY1kWRfq7yYU18vr6QcdM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2ObB-vy1do-pn1FxSzIMGCLt8stUdkbAVBcrSee9azA&oe=6AEA1417"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1100900312465339"}, {"status": "PUBLISHED", "id": "2071477123493442"}, {"status": "PUBLISHED", "id": "1016870197377134"}, {"status": "PUBLISHED", "id": "1600523731881269"}, {"status": "PUBLISHED", "id": "981799081020460"}, {"status": "PUBLIS
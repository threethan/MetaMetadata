1089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxJ-97aOIsgQ7kNvwEKUfBa&_nc_oc=Adov1MfvCwXwsJ3zhZJAHFM0Vc_pK3-Bg8OtiuCG-1d2y47z1u-Y0fgf-ZZDwRPYp1k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwy1kKJYLqxPDqqElXSO_N3gaYZRfZuWMhx478ZKGWVEw&oe=69CBB46F"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEqoD89kxGYQ7kNvwF6TWLB&_nc_oc=AdptVhCEu_puY7X3S-JgV2CIid3QRFfV1mRkGivmwIm8b3hiuZsXPeJBuuQ6aWGoWKo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh7YntY1LWBGrkBOm9ZyNTbsTjw5-vHT5ega5PHgMSlw&oe=69CBD5BE"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyL6hZYQCBsQ7kNvwEKqxNj&_nc_oc=AdrNmTN8A_0_Mk8Oq04_L0k1A28Z9dQnTwAu3uAqfS34izdVzoHb0E6rOTaD6diUfmM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8r_06oEc5IYP7Z4qdfJE_GyhmmW0oR-BBPCn-8fBGGw&oe=69CBDBC7"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7mq2cWqJLkQ7kNvwG6Guk7&_nc_oc=AdrAa_fmNGWC-te_fBhSymgy2XRDaYKcoz-iXgfr7EpntY2P4LR6y6s5_bNTnvk9ivc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxc88MCgz41bwrtpmQTDeGyZ6fEtTCInEE0RHjTyYyROg&oe=69CBCB46"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DA0oPNXaOJYQ7kNvwEz-e6g&_nc_oc=Adp-ySuFAoNyicbWv3akhKl2Dv7ffzA-IRhVEcHeDwGcpK_lf3-aV9M91L4VHpd68ZA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBxe_ZPq2unRAzGkWnVwU8Ritshww1zER9YvRSXB5Qjw&oe=69CBBB8E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mn0_h1PGfdYQ7kNvwFVaPzx&_nc_oc=AdoUdHhEj9q35NCT8ksg5UbuwMT2c-r0t2tvC0xYx-c6HpOt1xcKvnoiX0nYNkH_Sck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyqmz4VmMpepOV1XX05_tcLCUBWQIsDaDsiWrUfoi395Q&oe=69CBA8F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzgOq4P5mJgQ7kNvwFXl5RI&_nc_oc=AdqGbZ0L5Tc3eNPZKBQRjz1JYKcTynJvEC82FIS6pcT7T4-rtfw-kJGkrVHzjpUDEEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvB0CmxeUq7r8vwe_XYcTb_Z2M2JeKAePiXp_Qvv44rQ&oe=69CBC657"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2360783164370798"}, {"status": "PUBLISHED", "id": "4309403332612336"}, {"status": "PENDING", "id": "815746574207162"}, {"status": "PUBLISHED", "id": "1124866152957848"}, {"status": "PUBLISHED", "id": "1780557845884969"}, {"status": "PUBLISHED"
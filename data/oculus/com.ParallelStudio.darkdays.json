1089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtVxDD8FrbQQ7kNvwGq-iA6&_nc_oc=Adp52Hfo54C5uBlRN6wzvFDdE2lRbcd0Og1NEjvoYMWhRlz8jmY8PwFFpxZ4ZsetID8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q_XRb51WRpJIevopNeTWeE57wqRn_mf1Zxl3tL6KfVA&oe=6A3AAAAF"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1oVRZFiPNgQ7kNvwGcAzMF&_nc_oc=AdqHAYdxtAW3nROS8os6BOJ95_tS9sV9FgMjnSSc9Kg4PvOAqPZ5AwDdOqGGF7Z2mO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eeSkFwiQLAIyUyfBI6J1aqfqjoROAypAbjjA_GRO-hA&oe=6A3A93BE"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQVdhHKiJCMQ7kNvwGBserH&_nc_oc=AdptEjEybyVCHGU6-Wp9i2ouxFKfxSfVjpmROrB3DV_c49pi-UDsoowg07YMPxP81wU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HvRucNxzeOJcTb2xK17-g14v7gxnDWuwu9pPSshU6rA&oe=6A3A99C7"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYQozGqZw3oQ7kNvwGu831b&_nc_oc=AdoWQ2KqdZytls1YeYVyDvn-hoR-txe-AvrbbsXvTjjRJoT52u0DzjzVa30OIsYxB0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87FTESeYBcuJunEBJe2rM4Pz_Rev7BjqpIZfFrbkElCA&oe=6A3A8946"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtA2JI3wu-AQ7kNvwHxGFcd&_nc_oc=Adq1qMHVfFdOB7hhHsEYgdRyp6xtL2tjwNarI1dm8cI98XNjgp96SJXxIFGGBCdWb3I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3HTlUanPZWi1OmLpuk0tt_-_Rysj3bc6cEhIfU-UlRg&oe=6A3AB1CE"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEEg8l-S3VIQ7kNvwEk05HS&_nc_oc=Adq7btIWpAJTIwnGSzk2INVjbsPk4MT2HuSwMPY-NNZVxNVLw6tXASUNp4ULfg2FOZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZTSlqOHjwn0egy8Na_F1Aq1TfaeSs3kbpx91ysx2CWg&oe=6A3A9F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npl45KRwss8Q7kNvwF_EFe5&_nc_oc=AdqiWalGwC6HVDL_t8Hs7FtJB8SRMyepIS2aV2O1ygA5pRyfdTcyX8SIQ15oe1QsmI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K9oOEu7TODQxDPOR8ZhHtUAlZdly3z9Gp6wOgu4jJGg&oe=6A3ABC97"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1600523731881269"}, {"status": "PUBLISHED", "id": "981799081020460"}, {"status": "PUBLISHED", "id": "1572468043824161"}, {"status": "PUBLISHED", "id": "2360783164370798"}, {"status": "PUBLISHED", "id": "4309403332612336"}, {"status": "PENDING"
1089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiJHze-IAQcQ7kNvwEeVCHX&_nc_oc=AdrIXSnBDV_54boBgMawgdIim6u-lPdPCNaYYa-QZGm2f2w7brlU11qymSbqDKy4i2A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Uca_Guq6XJNQ4a2oDfCEHf9IObooGlTeJifbYgF-JpA&oe=69F3416F"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCkp5HY6e1kQ7kNvwG75HKj&_nc_oc=AdoDSNiHbK722QCMFdgwbsnvqfigr4If8p1CpZzotJLzWcrRPXS2ubXCprTfbAmxm8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16opW8xdjgM7_jTYxsVmw74qZXgqT1uUGUzEmGNfrrsA&oe=69F362BE"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThaIBMVlwJAQ7kNvwG-r1yl&_nc_oc=AdqDVpNha8l_JsEIj3Sw59COCvyToaMvAt9PB9JK-671oTEnZfwpHbrICVFmPVW7Evs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2F241tjPZweFCa36RpkDOYgBF58mQmn-1Zna7X3ZR5Lw&oe=69F368C7"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ejo5X6TQqoQ7kNvwFrwP8A&_nc_oc=AdpGPC0XoHSYLzptfArsxAuYHQvn30KBt6yNOIWGBwwnSoYCRaI4w1RnClHrhdNkbOA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WwsSvjRy6kyR3gQCULBzIEelcpovTGlEjhF62PC8HJA&oe=69F35846"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JCsvE_JmTwQ7kNvwHrr56J&_nc_oc=AdrXNSkpCOXFIdEZnSMFdKkOFWPPwTXQHGkqXU-4UxPk_DMw302FgtqEU8OTlx8tnnY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dIJTjqw1jEOZQnD5OfA-v7gakgUUyj67xVw2MoTd8xQ&oe=69F3488E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8POrsMTUAlQQ7kNvwGE0kNd&_nc_oc=AdpYRLHIgN2XXj_5kpympG9kFGEqAAB3lUQmtt4N2GmeyH8U09bXyMkD4x9kdiLpY-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1yhPzbxSfINeZySrdBj4rAGmNG3lRmKfSIkye1-AR4Tw&oe=69F36E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCqd74qLtP8Q7kNvwGWQA23&_nc_oc=AdpyKZwH3NMXHPC3uzktz4PQIpu5Njcn2tzl63tdjA7xj6DHkELDirizhE_1eVRhRA4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3W3Xvfg9deLMQe3EZHXGNMBWF7oAk8LxRAhpb4Ft4k5w&oe=69F35357"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1572468043824161"}, {"status": "PUBLISHED", "id": "2360783164370798"}, {"status": "PUBLISHED", "id": "4309403332612336"}, {"status": "PENDING", "id": "815746574207162"}, {"status": "PUBLISHED", "id": "1124866152957848"}, {"status": "PUBLISHED"
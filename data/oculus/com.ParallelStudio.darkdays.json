1089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cv1klCoMsvQQ7kNvwHLTPMr&_nc_oc=AdoXVz9MB0cXekrwxs_tjgidoPE4kVXNe24U_rPZlZamkyJi_Zy9gcnK-7n8Ee4oPdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKjd4kVxGKn0Lj5hAHmK6huMW0ZprAWGSeQRQwbnTang&oe=69CE576F"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEqoD89kxGYQ7kNvwE3hw6r&_nc_oc=AdobRqKYQo9LONJUpcnDhKT2aYVQz7D21_xKySzLmTDuRgkyNPxqeK8lGIq0n-mfXKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwyu06oVV4aqpZmy8clbHFC8TrDfu1rt2F_2D4SdMHkzg&oe=69CE78BE"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aism5QZ_86kQ7kNvwEMnNg7&_nc_oc=AdrTgULoG-C4NJopxUfci_ZNGRcQ8IE4Aood8ZYeDZ-LNUA6T8BA8Y-OgGBJ3AHKoYQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyTDjXevtCuzTeiEDIPbzqNFwFbBtttoza8bhzv3SM9g&oe=69CE7EC7"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C11-Q10I-EQ7kNvwEH7FF1&_nc_oc=AdpqWalDBe8jhNZBsnwdvOQG5sV5f_ebzk_y-fubtZ1Q8zAxEMDfnqD5mBW_4gCsPLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytyMvuyEK9g9O6mV9RJgPcw0fzgyYEMMGwu_Bt_Ey39w&oe=69CE6E46"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gsofp8R9ZoEQ7kNvwGi9dmX&_nc_oc=Adoaco-NCgAJIIxKHATniD7kXt4mD59IZDX18nQvo3aIh6ojn0vJJiY4RiyhyZB1lYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCLyFFtqDqrJA37JMcGXBsvjkk2HfCWu8lOlrgvlqYYA&oe=69CE5E8E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeUh8ag8eAkQ7kNvwE1g8Tw&_nc_oc=AdrYC06MSAbio6j76CzThhMQxmwd6jVx_H1OxB9kh123lujuUqeJxTyb8G58_aY4Fw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBrDygoBnOmNWBT2s-KQQiK9n6M085tRScZZ3ZnA-HQw&oe=69CE4BF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FR1nDZWaegQ7kNvwH_-058&_nc_oc=Ado46QQYW3AIJ71aPA4P1X3CGy11FJ4e_kbk0meCbMbgnf_-WsifPFRjaKpVJhaek6Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPrYvasVqcv0f6iZ34VeQM2Ke0VDbpzU3fxjKTKGR5Zw&oe=69CE6957"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2360783164370798"}, {"status": "PUBLISHED", "id": "4309403332612336"}, {"status": "PENDING", "id": "815746574207162"}, {"status": "PUBLISHED", "id": "1124866152957848"}, {"status": "PUBLISHED", "id": "1780557845884969"}, {"status": "PUBLISHED"
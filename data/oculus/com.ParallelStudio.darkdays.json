1089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=en_nhZWq9P4Q7kNvwEjc_7d&_nc_oc=AdrxogW23HF5bCJiJwVuy8-2gmFl_PlOrMvzmPtThkMnZwzDvtT_aKDHIIxxEqzG79M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LNJCJ22mMjMbK7lyK8lTVdTvKpPVDm4u_ThvJpGqMpA&oe=6A1B06AF"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqwUomzGinYQ7kNvwGVthm_&_nc_oc=AdprLUTHZ_jLLIuq3ItufGpjny5yc26AlDumTR61Rg7r1C0RTXezf_Kfb3ZJvUBzNOM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EvmoUbFgVCmcrriiLlVu0MVius_SDhEzMBK0orbk7tg&oe=6A1AEFBE"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA0-SGxLF0EQ7kNvwFS1Jva&_nc_oc=AdoSdYb9_RMF2UIhmvSriWdG_1NKPGOOr2h3mKIxmUzY40yFg1Uvj0cV_XMDQ_xodEY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TRh9-xy5I0Pi1c67IKa3BNWFVopgvrwc82hz6WbjCRA&oe=6A1AF5C7"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSwtd7jvnC0Q7kNvwFCSMoQ&_nc_oc=AdqtXEG9Hk4hoO-iYodYxOT2nAchYRCJcSnCguTpC_Mp2CQD3vtBxOpbKygS3-QSOtI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VUTBnq-LTiqEo2CVbq4fyBbmZVFZkhtShG5o6ouBIjw&oe=6A1AE546"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8i5b4BsVHIQ7kNvwFRaGtu&_nc_oc=AdpJYi-tVWcI83srBpFhFBS7-XCAc567RUqOehAQxK55WlNGOObyft7aXGGE_1FM6Yw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mNBTiIMlr1D20Qo256NIfY2hJewUwFRHrGLo1L3E5IA&oe=6A1AD58E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7DH5YiHPWYQ7kNvwEf-xIf&_nc_oc=AdqGPMNiKTH094Q9yd_-H_frf5yIjphUMCftiy1ZDmoPUPNcA2x6au7s9pPa1Tc85R4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PdR4PZ6IklEBwbqWhoomHcgO1gMmslK1oBGrtBfozcw&oe=6A1AFB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHLS6kWsVYEQ7kNvwHZzJ0l&_nc_oc=AdpfOH6GAng3SAvKmFh8cysf_5J0e8-kPnzffpAyLxCCL-xP2WPx6kMNUflqhgT7H7o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aibNyn1hKwc1bTHmzha05eW6N8_7RRx5qL81MiafqNA&oe=6A1AE057"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "981799081020460"}, {"status": "PUBLISHED", "id": "1572468043824161"}, {"status": "PUBLISHED", "id": "2360783164370798"}, {"status": "PUBLISHED", "id": "4309403332612336"}, {"status": "PENDING", "id": "815746574207162"}, {"status": "PUBLISHED",
21089_576238098541203_5795943342596795863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNFWoYfl4AgQ7kNvwFiHQwv&_nc_oc=AdooQyCYcH-5Z-xUKIIbKoiEqppsGe9l6i2iiHmijEXJ7Gg7M14PElFw_YDpix--mfw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLva_69GR6PnyCl_mdejKhsyG9CYP2mjLB1ORuvNvFGJQ&oe=6AAC0BAF"}]}, "id": "545930075117263", "locale": "en_US", "screenshots": [{"file_name": "DD_Screenshot_VR_02.png", "id": "1122765513015102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822813_1122765516348435_1178124950540983469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbiiLDzNb0YQ7kNvwFixq1y&_nc_oc=AdpTQFffowa54dKIIEVsM7mM36YWabAL6uTrtGcxKe8tfm21xPou6_LmvpbYoiJG5DU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZBaBGPf2efiAyzdKFfzO3RQeaacCtTvQ3fdBxxmrdVg&oe=6AABF4BE"}, {"file_name": "DD_Screenshot_VR_01.png", "id": "603856362730277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820523_603856366063610_8298584072385644877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo1_TujYDXIQ7kNvwGcfCQH&_nc_oc=Adqv1vHuh9pch3rsrgg8Fs7eaSRQz15Vsn2yPvswtaldCR6kqCw1qwopnsLXdoyRTBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAy9kmhuzfBIwXa5LBvbVhzyVpl_o65ZXstKAmjalmsQ&oe=6AABFAC7"}, {"file_name": "DD_Screenshot_VR_05.png", "id": "1223343389200540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819257_1223343392533873_3616183408757849896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrA8YzUwU-YQ7kNvwGq1F_K&_nc_oc=Adr9xNjrkQmMTY8aWIQQs8XFBdH2r62KrbTjv9V3y1YnXvmaY2oTDOo4i9X3HplZJgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwL0nrOYMWf4KSCa-xC9fiR1dmT9ezHyGPq-yOEJriPA&oe=6AABEA46"}, {"file_name": "DD_Screenshot_VR_04.png", "id": "1756334378426462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823905_1756334381759795_3820808000805489227_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oze61SibNYcQ7kNvwGNe6Y3&_nc_oc=AdqgJoUXZwnP9dAmtu8bnLLjgWfykLb8eBof88WiKiid0Vg_-bDhJ67STcNEI1aOH1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_oPKjse3YvZf1fnqQ-rir2QjDeB0z5kadEK3e_sWYwA&oe=6AABDA8E"}, {"file_name": "DD_Screenshot_VR_03.png", "id": "1252729059731358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_1252729063064691_3480862386442863240_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRBxwkwANI4Q7kNvwGAxiPZ&_nc_oc=AdoQ6x57VageHi4gfpWdgFwDGhrtYJpm0zjpDEmjzSUWcGRNqKtEZS933QnwUqbeHcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKzKxJ4Fv2YA6jXt1hKCRoC2tMmaVBrPn0ToQMP-yeTw&oe=6AAC0032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Couverture.png", "id": "997492065867891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818873_997492069201224_2865451189761456090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op3w1jpqunIQ7kNvwFp2EVX&_nc_oc=AdoTbQMUZIr0iVH0aQX9zu9r26w5ScgR4Jb0KElC4jelkLUp26_Crz-37ya26V7vZy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL79ktq_DXC8cav9tnJ6g0Fuj1ZJ23cRNhe-flcF8gTtg&oe=6AABE557"}, "display_name": "Dark Days", "keywords": [], "long_description": "\u201cDark Days by Parallel Studio is a jumpy trip\u201d\n \u2158 vrvoice.co\n\n\u201cDark Days does a lot of things right and provides an interesting world full of thrills and mystery to keep you uncovering secrets until the end.\u201d\nUploadvr.com\n\n\u201cIf you're not afraid of evil entities appearing from time to time just behind your neck, you're in for a treat with this little game that's sure to give you some very enjoyable (or horrifying...) moments.\u201d\n18/20 ETR\n\nInspired by 1990's cult classic horror movies, Dark Days stands as an adventure horror game of its own. From an eerie motel to a haunted desert, solve puzzles and progress towards a disturbing truth. Dive in an American nightmare, immerse yourself in cinematographic environments, but be careful and think smart! Something is hunting you. There's only one rule: if you look at it, this nightmare kills.\n\n\u274f An emotional, story heavy supernatural investigation\n\u274f Accessible gameplay and randomized puzzles\n\u274f You're the prey, so be smart or be ready to scream!\n", "short_description": "Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure for Meta Quest. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.parallel-studio.com/PrivacyPolicy_DarkDays.html", "developer_terms_of_service_url": null, "publisher_name": "Parallel Studio", "support_website_url": null, "website_url": "https://www.parallel-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "fr", "de", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868301819489847"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1100900312465339"}, {"status": "PUBLISHED", "id": "2071477123493442"}, {"status": "PUBLISHED", "id": "1016870197377134"}, {"status": "PUBLISHED", "id": "1600523731881269"}, {"status": "PUBLISHED", "id": "981799081020460"}, {"status": "PUBLIS
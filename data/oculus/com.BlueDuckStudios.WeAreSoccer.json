q9moBBLrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAs3WhODJOhACUofMawThhTiqHPrqbORSm0BxeXhysZw&oe=6AB7C37F"}, {"file_name": "10.png", "id": "1401513401631416", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_1401513408298082_615250544834023447_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dPYy0LbsloQ7kNvwGMehOs&_nc_oc=AdpxK4sftrA5je7Nh8PLRjVXRZx3Wi2H72PLSzyP6JOTyFu0wEwyqgIr8e1vsUy8tGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK11FJ8ZfdIlZ-L8cWM7B7i6CRtZNYSSXi22Y464s6Dyw&oe=6AB7C4FD"}, {"file_name": "14.png", "id": "675897582179096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_675897585512429_5785291532639315545_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjtbh3r09toQ7kNvwFaocUx&_nc_oc=Ado-MR5mpKPQqCmrycmZ3z4LSs8Pa3FkG8po08Ha5cf7jZMPeYDE9soXmb5IwwjIMqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBywis88cDXWdi02dBzIW1An1H_dzj8FDebivm5X4-5Q&oe=6AB7BC8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape AB 3.png", "id": "902293265590716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_902293268924049_1235646838823001140_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0vfXFiYIyQQ7kNvwGBjO0H&_nc_oc=AdpP9XQO3Wlrw7LX2NcgB-BAoP8SJcwS9N4Rr7SV8hEfBYRNU8d1wofvNJcMk-6-bXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlTyHU5YBzXjjYiYcT3NZuKTWcvAgbt8pRolBkRzAcgw&oe=6AB7EC1D"}, "display_name": "We Are Soccer", "keywords": ["Soccer", "Football", "Tennis", "Hockey", "sport"], "long_description": "# \u26bd Welcome To The First Ever VR Soccer Club!\nJoin the soccer craze and become part of the ultimate hangout experience with endless possibilities for you and your friends \ud83e\udd19\n\n# \u26bd Explore a Massive Soccer Park Packed With Nonstop Soccer Fun\n{636040255621029}\n# \u26bd Master The Ball With Realistic Physics And Next-Level Control\n{2218231991904189}\n# \u26bd Play 1V1 As a Team Or Team Up For 2V2 To 5V5 Matches\n{1307905307188506}\n# \u26bd Choose Your Movement Style\n{1241074994252432}\n# \u26bd Create And Customize Your Player\n{1301259194446538}\n# \u26bd Climb The Ranks And Unlock Rare Cards \n{3950362221959108}\n# \u26bd Record Your Moves And Share Your Skills With The World\n{9429449530420273}\n\n# \ud83d\udccd Zones & Features\n* \ud83c\udfc5 Main Fields - 1V1, 2v2 and 3v3 public fields\n* \ud83c\udfcb\ufe0f\u200d\u2640\ufe0fTraining Center - Sandbox training zone, including extra activities - Impossible Robokeeper, Soccer Dart, Target practice and Ninja obstacle course\n* \ud83d\udc5f Kick Central - Urban free-play soccer field, Tennis soccer, Teqball tables and soccer Padel court\n* \ud83c\udf34The Beachside - 2v2 Bumpy beach soccer field and Beach volleyball field\n* \ud83d\udc7eSoccer Planet - Arcade zone with multiple soccer activities - Airhockey, Basketball machines, Skeeball, Giant soccer beer pong, Pool table and more!\n* \ud83d\udca6 Wet Ball - Slippery 2v2 water soccer field!\n\n# \ud83d\udc49 Extra Features\n* Create custom private matches up to 7v7\n* Team of the Week Leaderboard \u2013 Earn an exclusive TOTW Card!\n* Goalie Mechanics - Save, dive and dominate\n\n# Time To Experience Soccer Like Never Before! \ud83c\udfc6\u26bd\n", "short_description": "\u26bd Welcome To The First Ever VR Soccer Club!\nJoin the soccer craze and become part of the ultimate hangout experience with endless possibilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blue-duck-studios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blue Duck Studios", "support_website_url": null, "website_url": "https://www.blue-duck-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2776
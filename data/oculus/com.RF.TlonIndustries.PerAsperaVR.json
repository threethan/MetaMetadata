oxZs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Gwsz_LvG6Szx189gUva1KoS4v_81NkbLSxJbJFkc9Pg&oe=6A0720DE"}, {"file_name": "Sc_522_0000.png", "id": "559923746000986", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75250455_559923749334319_6390715373315778177_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNvHDK15QKoQ7kNvwGesx9d&_nc_oc=AdpTzLD-NRW0N0lx2XqGGAUjj1-6jaZ66XS8zzFHp59ohLW5ClsKvNdIGOARJCeJjxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qfERsPdiDyhT__HPPatj6bYzEaamr8-3W5FxLyrX-hQ&oe=6A07151B"}, {"file_name": "Sc_541_0000.png", "id": "848056013146750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_848056019813416_2962253873778848848_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fan6_b03D5cQ7kNvwHc7LdT&_nc_oc=AdrqCSMHi2tJOgRBPexKU-kWW_KeZDLx5ppuSAJeGn8SVxyJIIQ93tJledRvovgmwL0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kzHwk5AlCQwp8dir3KZD4IavDRE9QbccF-04DTexThg&oe=6A0725BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image.png", "id": "1358611561607871", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982476_1358611564941204_1491392822717363458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRjyQH_9C8MQ7kNvwGbQw-f&_nc_oc=AdrRrSQB3nZJ7igUnCLDFqO0iJT1EpYONUswPGLFZN51M0HnWArFkdUSpkutzVSyYCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZbECLcTHvXpetcJ4FCxL8VMgVLeCX6g5SofRY_LaaCA&oe=6A072812"}, "display_name": "Per Aspera VR", "keywords": ["Mars", "Simulation", "Strategy", "Builder", "narrative"], "long_description": "Per Aspera VR is a planetary simulation game that combines hard science fiction and base building and takes the experience planet-wide. Step into the role of AMI, an Artificial Consciousness with the prime directive of terraforming Mars for human colonization.\n\nFEATURES:\n\n\u25a0\tBalance a complex well of resources to build interconnected structures that span the entire planet.\n\u25a0\tCustomize your planet with branching research trees that allow players to tailor their terraforming plan \u2014 Develop new technologies, steeped in real-world science, to create a thriving interplanetary civilization.\n\u25a0\tUncover the mystery of a threatening presence on Mars and defend your colonies from unknown and combative forces.\n\u25a0\tIncludes the immersive voice acting talents of Troy Baker, Phil LaMarr, Laila Berzins, Yong Yea, Lynsey Murrell, and Nneka Okoye.", "short_description": "Per Aspera is a planet-sized management simulation game set on the surface of the red planet. Take control of AMI, the galaxy\u2019s most sophisticated AI, tasked with an important mission: Make Mars a habitable planet. You decide the future \u2014 terraform, make crucial narrative decisions, manage resources, discover long-hidden secrets, and immerse yourself in a rich and compelling story. "}, {"images": {"nodes": []}, "id": "497541705883971", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Per Aspera VR", "keywords": [], "long_description": "Per Aspera VR \u00e9 um jogo de simula\u00e7\u00e3o que combina fic\u00e7\u00e3o cient\u00edfica e constru\u00e7\u00e3o de bases, proporcionando uma experi\u00eancia em escala planet\u00e1ria. Assuma o papel de AMI, uma consci\u00eancia artificial com o objetivo principal de terraformar Marte para a coloniza\u00e7\u00e3o humana.\n\nCARACTER\u00cdSTICAS:\n\n\u25a0\tEquilibre uma complexa lista de recursos para construir estruturas interligadas por todo o planeta.\n\u25a0\tPersonalize seu planeta com \u00e1rvores de pesquisa ramificadas que possibilitam aos jogadores adequar o plano de terraforma\u00e7\u00e3o \u2014 desenvolva novas tecnologias, baseadas em ci\u00eancia realista, para criar uma pr\u00f3spera civiliza\u00e7\u00e3o interplanet\u00e1ria.\n\u25a0\tDescubra o mist\u00e9rio de uma presen\u00e7a amea\u00e7adora em Marte e defenda suas col\u00f4nias de for\u00e7as agressivas desconhecidas.\n\u25a0\tInclui as vozes imersivas dos talentosos dubladores Troy Baker, Phil LaMarr, Laila Berzins, Yong Yea, Lynsey Murrell, e Nneka Okoye.\n", "short_description": "Per Aspera \u00e9 um jogo de simula\u00e7\u00e3o e gerenciamento em escala planet\u00e1ria que se passa na superf\u00edcie do planeta vermelho. Assuma o controle de AMI, a IA mais sofisticada da gal\u00e1xia, com uma miss\u00e3o importante: tornar Marte um planeta habit\u00e1vel. Voc\u00ea decide o futuro: fa\u00e7a terraforma\u00e7\u00e3o, tome decis\u00f5es narrativas cruciais, gerencie recursos, desvende segredos antigos e mergulhe em uma hist\u00f3ria rica e cativante. "}]}, "developer_name": "Tl\u00f6n Industries", "developer_privacy_policy_url": "https://rawfury.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Raw Fury", "support_website_url": "https://rawfury.atlassian.net/servicedesk/customer/portal/1", "website_url": "http://www.tlon.vg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ja", "ru", "pt_BR", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "458162252704482"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
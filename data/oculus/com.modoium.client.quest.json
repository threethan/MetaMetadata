c_ohc=X6RLOTaeWZQQ7kNvwHtaLgO&_nc_oc=Adr39646Ss9dObah-LG7-PPUk2i93YkdYBbPXMrV75rxEmwr5bkpffbuiXxcgQVfVnE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ynK-YHtUaFr83kQgblDaPcyv4QHzsV-dHmyncJVWfyg&oe=6A2C1F02"}, {"file_name": "screenshot-3.png", "id": "1641875976542765", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974920_1641875979876098_3314538516269626626_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ain-rf1IficQ7kNvwHxNXIZ&_nc_oc=AdokrwXHBgLnnQ2x_LtsPmXr0pgViV9XNMRQF-KxriZ_nNB8KLY6TnuABSjocMRWxeE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qy3Lu4ITXZot1MEPeGrb3HRPjbqFelVLiWAbqiCg4aQ&oe=6A2C16E3"}, {"file_name": "screenshot-4.png", "id": "1473009000053295", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974834_1473009003386628_5395154856041831416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jW6jkS27zK4Q7kNvwHxd-jr&_nc_oc=AdrchsliR_LTmL7DEyUBQmdnyibQKAU0I1qw-_PbyC2DxBrZY6vyGy9pgeRmUHp91zY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zlnplST9893nVrahFxp_pDjkX2j8EZvdxc4AUas48RQ&oe=6A2C0351"}, {"file_name": "screenshot-5.png", "id": "951903810294618", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974503_951903813627951_935484385240937317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sogHEJeE8kQ7kNvwFxQ4pn&_nc_oc=AdrIA_ZOQ6xiASH3TV_E58JEKnTXVOoWX-8GsBxWnaEpmmT14tbKz-mNNId3x3DQ82w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9639Dtnj4Fd0J6nvGBx8pUDAM2RWN5xN4t_I7pVOY_7Q&oe=6A2C2EB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modoium", "keywords": ["modoium", "remote", "development", "unity"], "long_description": "# Modoium : The New Standard in Unity Development\n\nDeveloping Android, iOS, iPad or VR content with Unity? Revolutionize your development process with Modoium.\n\n**Key Features :**\n1. Instant Testing: See results on your test devices without building and installing the entire project.\n2. Superior Quality: Automatically supports native resolution and frame rate of test devices, delivering top-notch visuals and audio.\n3. Wireless Connection: Easily connect via Wi-Fi and use multiple devices on the local network.\n4. Multi-Platform Support: Covers iOS, Android, PadOS and VR.\n5. Security: Prevents unauthorized access through verification codes.\n\n**Why Modoium?**\n- Time-Saving: Escape the endless cycle of building, installing, and testing.\n- Increased Productivity: Speed up development with instant feedback.\n- Improved Quality: Verify exact performance on real devices.\n- Cost-Effective: Reduce the need for multiple test devices.\n\nUpgrade your Unity development experience with Modoium. Start now!", "short_description": "Modoium is a Unity mobile game development test acceleration tool. Connect to Unity Editor via Wi-Fi for instant testing, and save build-copy-install time to focus on improving your game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://modoium.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Clicked, Inc.", "support_website_url": null, "website_url": "https://modoium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9055615047793144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.c
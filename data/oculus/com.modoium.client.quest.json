culuscdn.com/v/t64.5771-25/38974834_1473009003386628_5395154856041831416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXkJWRxvRXoQ7kNvwFl-n8e&_nc_oc=Adr7MthPPqf5VWnqXXmm2C4yY4xowVl3gZbuVc_LjKArgyJoaet82qiN6KQOZbOHVkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKyWy1ErHjfo7snG9vRPdTfn9_11guJ71Y0hr5ZgwnOw&oe=6A5E1C51"}, {"file_name": "screenshot-5.png", "id": "951903810294618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_951903813627951_935484385240937317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqRDrukEszsQ7kNvwGEj9Zd&_nc_oc=AdqnLd4wmtbbiej3iTjbXxAlrnBh61nSGKFBB3C2SKjaEOPhxNH_6XlruQL_qRQ9Ww4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-ZuqeNEKZ-awQGkA82BiN9zDskerwnVuLMp8VTfbONQ&oe=6A5E0F75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modoium", "keywords": [], "long_description": "# Modoium : The New Standard in Unity Development\n\nDeveloping Android, iOS, iPad or VR content with Unity? Revolutionize your development process with Modoium.\n\n**Key Features :**\n1. Instant Testing: See results on your test devices without building and installing the entire project.\n2. Superior Quality: Automatically supports native resolution and frame rate of test devices, delivering top-notch visuals and audio.\n3. Wireless Connection: Easily connect via Wi-Fi and use multiple devices on the local network.\n4. Multi-Platform Support: Covers iOS, Android, PadOS and VR.\n5. Security: Prevents unauthorized access through verification codes.\n\n**Why Modoium?**\n- Time-Saving: Escape the endless cycle of building, installing, and testing.\n- Increased Productivity: Speed up development with instant feedback.\n- Improved Quality: Verify exact performance on real devices.\n- Cost-Effective: Reduce the need for multiple test devices.\n\nUpgrade your Unity development experience with Modoium. Start now!", "short_description": "Modoium is a Unity mobile game development test acceleration tool. Connect to Unity Editor via Wi-Fi for instant testing, and save build-copy-install time to focus on improving your game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://modoium.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Clicked, Inc.", "support_website_url": null, "website_url": "https://modoium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8763801860307799"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1494438124613552"}]}, "baseline_offer": {"id": "1494438124613552"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732238460, "status": "PUBLISHED", "id": "1494438124613552"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8989811224373527", "version": "1.0.4"}, "id": "975116184376910", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8763801850307800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8989811224373527"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE",
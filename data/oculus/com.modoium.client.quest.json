 {"file_name": "screenshot-2.png", "id": "474017925664566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035374_474017928997899_9152329324005668677_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZovbaagz_EQ7kNvwEXAKo-&_nc_oc=AdrnxE2-0QHvLGanc_iM2XOQL_kgYF5awqNloWiW51VQRZfurveinYADzn1vRP2gZ6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRquPjoTCbeb8s_ajSh0-dl2kYEmIDYUf87rgCulAmkmQ&oe=6B0C7642"}, {"file_name": "screenshot-3.png", "id": "1641875976542765", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974920_1641875979876098_3314538516269626626_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0T1b4flnrwQ7kNvwFFjBCr&_nc_oc=AdpErpvWq6z55ivlzQC_AxU2mEUxrptw7uDI_k8zYJkwOiKDwI2KyTJs391s2Xp-P0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJ7ol09zWj0qcNFVI3HEauHtI4uTimh-kcWKM238x2sQ&oe=6B0C6E23"}, {"file_name": "screenshot-4.png", "id": "1473009000053295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974834_1473009003386628_5395154856041831416_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHiuVeFH-7EQ7kNvwFAe2Y8&_nc_oc=AdosyJQOHeC1ThF4KiBZnYY5Uz3lo-e5llqfx84P70SQAzs_j9jCp3p57f8K7SFrvDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJLs_rwhQ93gt0D6TKdp3eRUa-as0oyyJOd2Nu1OsNXw&oe=6B0C5A91"}, {"file_name": "screenshot-5.png", "id": "951903810294618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_951903813627951_935484385240937317_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFMyganRDEAQ7kNvwH9nulB&_nc_oc=Adrra4D_Lo_AH1uOnNmSwHZkw-6XK5Znzf9-uytMLu-GpIGysMDK7Jz7oDRoHg5msms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTraAEfrhre0pGt92MMqNpcPDUA4GkSYAf1nHb6X92q7A&oe=6B0C4DB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modoium", "keywords": ["modoium", "remote", "development", "unity"], "long_description": "# Modoium : The New Standard in Unity Development\n\nDeveloping Android, iOS, iPad or VR content with Unity? Revolutionize your development process with Modoium.\n\n**Key Features :**\n1. Instant Testing: See results on your test devices without building and installing the entire project.\n2. Superior Quality: Automatically supports native resolution and frame rate of test devices, delivering top-notch visuals and audio.\n3. Wireless Connection: Easily connect via Wi-Fi and use multiple devices on the local network.\n4. Multi-Platform Support: Covers iOS, Android, PadOS and VR.\n5. Security: Prevents unauthorized access through verification codes.\n\n**Why Modoium?**\n- Time-Saving: Escape the endless cycle of building, installing, and testing.\n- Increased Productivity: Speed up development with instant feedback.\n- Improved Quality: Verify exact performance on real devices.\n- Cost-Effective: Reduce the need for multiple test devices.\n\nUpgrade your Unity development experience with Modoium. Start now!", "short_description": "Modoium is a Unity mobile game development test acceleration tool. Connect to Unity Editor via Wi-Fi for instant testing, and save build-copy-install time to focus on improving your game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://modoium.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Clicked, Inc.", "support_website_url": null, "website_url": "https://modoium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
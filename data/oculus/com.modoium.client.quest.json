c_ohc=9z66YMk9KU4Q7kNvwFD3YPU&_nc_oc=AdrWFlnHnNYWL-4BibQurCU-IbNuirJjwkWNW6uAGKhF_EMPkbqNbdkVtTui89GOxYQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fe9Lt91o0QZWpySvG79H9qDR0lhwoIF7KLMc8wPhvDA&oe=6A09D802"}, {"file_name": "screenshot-3.png", "id": "1641875976542765", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974920_1641875979876098_3314538516269626626_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGcg7CYQgeMQ7kNvwEkNy6T&_nc_oc=Adp9opTEZSye-ZP7nrNfp8i6_A3otmGE428XroOSydc4tM1EXLohz9YE5n6KJYcU6zc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sdbIuiRkQ2pKV32MswcsP4U5wSMZI5NRcPjFMp4NJ3A&oe=6A09CFE3"}, {"file_name": "screenshot-4.png", "id": "1473009000053295", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974834_1473009003386628_5395154856041831416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5Em2IFHgTYQ7kNvwGUFbMW&_nc_oc=Adr7tyCR6GqvtkssVZ66Px8cJYxAIGQpVOzebLQsF2MN7Q6wabftE-wrlxooGd_aI1I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rk3GGPzmQ4QexDW8TsnGM-h8CzAOt-990AJJpfPg-Hw&oe=6A09BC51"}, {"file_name": "screenshot-5.png", "id": "951903810294618", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974503_951903813627951_935484385240937317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OREOJgUYrw4Q7kNvwEoxk6s&_nc_oc=AdohxvT3PWUPo4qIQvsfcWhQHlu6xZZxYlFOWatqHAnCfSAVJVaxRlhrnlcRSAsnyuA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nE_Jvj5xaMIl9q-U0R1q_35aB1sca4ZaRAiVqyFpSRw&oe=6A09AF75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modoium", "keywords": ["modoium", "remote", "development", "unity"], "long_description": "# Modoium : The New Standard in Unity Development\n\nDeveloping Android, iOS, iPad or VR content with Unity? Revolutionize your development process with Modoium.\n\n**Key Features :**\n1. Instant Testing: See results on your test devices without building and installing the entire project.\n2. Superior Quality: Automatically supports native resolution and frame rate of test devices, delivering top-notch visuals and audio.\n3. Wireless Connection: Easily connect via Wi-Fi and use multiple devices on the local network.\n4. Multi-Platform Support: Covers iOS, Android, PadOS and VR.\n5. Security: Prevents unauthorized access through verification codes.\n\n**Why Modoium?**\n- Time-Saving: Escape the endless cycle of building, installing, and testing.\n- Increased Productivity: Speed up development with instant feedback.\n- Improved Quality: Verify exact performance on real devices.\n- Cost-Effective: Reduce the need for multiple test devices.\n\nUpgrade your Unity development experience with Modoium. Start now!", "short_description": "Modoium is a Unity mobile game development test acceleration tool. Connect to Unity Editor via Wi-Fi for instant testing, and save build-copy-install time to focus on improving your game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://modoium.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Clicked, Inc.", "support_website_url": null, "website_url": "https://modoium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9055615047793144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.c
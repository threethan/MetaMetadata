c_oc=AdkSK9aX64SyvSJDiEaUDVr5OX718t60PjVXb-JfD8T1eLmCR-p3Xw2tVRpzN6YASTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxX6FLmwq_vaaJD2pIArn8ccmj7YGmhBGXmen-kuPR4ag&oe=69BA85C2"}, {"file_name": "screenshot-3.png", "id": "1641875976542765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974920_1641875979876098_3314538516269626626_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tmQAeaeRxgQ7kNvwElsaVL&_nc_oc=Adk27DfKpRR197lEXE2LxKS4bPdmdq1tb2yLlP2WgDh0TqT_nUG3lKj60y6gQrYSlYI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7R3D4n8tDVeurXWh7RA4upyWG9sD0bX7y-n8cpLLUpw&oe=69BAB5E3"}, {"file_name": "screenshot-4.png", "id": "1473009000053295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974834_1473009003386628_5395154856041831416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPlrkpkgCxwQ7kNvwF_f9yJ&_nc_oc=AdnZkI9DX38n53UAiprr-2cYw_iCtLNXxp4pUvVCo7avCbcrsBm0iVmTQKR-IjAfan0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsnLkOFDD5iiGlC5u4FKKuNIM3q3xo_Buuk0i5G79SCA&oe=69BAA251"}, {"file_name": "screenshot-5.png", "id": "951903810294618", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974503_951903813627951_935484385240937317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOutDPwzRhkQ7kNvwGx70n-&_nc_oc=AdkhmyxFGXwe20Ihkql89x0nyo4p7zl8Q3-EJVKcEhgnXRUMu_YyPc46CxzPDmGKqAg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8agMReQfwys7DBtf8ae500ZFUB4i1MWx_IOG4y85upg&oe=69BA9575"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modoium", "keywords": ["modoium", "remote", "development", "unity"], "long_description": "# Modoium : The New Standard in Unity Development\n\nDeveloping Android, iOS, iPad or VR content with Unity? Revolutionize your development process with Modoium.\n\n**Key Features :**\n1. Instant Testing: See results on your test devices without building and installing the entire project.\n2. Superior Quality: Automatically supports native resolution and frame rate of test devices, delivering top-notch visuals and audio.\n3. Wireless Connection: Easily connect via Wi-Fi and use multiple devices on the local network.\n4. Multi-Platform Support: Covers iOS, Android, PadOS and VR.\n5. Security: Prevents unauthorized access through verification codes.\n\n**Why Modoium?**\n- Time-Saving: Escape the endless cycle of building, installing, and testing.\n- Increased Productivity: Speed up development with instant feedback.\n- Improved Quality: Verify exact performance on real devices.\n- Cost-Effective: Reduce the need for multiple test devices.\n\nUpgrade your Unity development experience with Modoium. Start now!", "short_description": "Modoium is a Unity mobile game development test acceleration tool. Connect to Unity Editor via Wi-Fi for instant testing, and save build-copy-install time to focus on improving your game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://modoium.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Clicked, Inc.", "support_website_url": null, "website_url": "https://modoium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9055615047793144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982576_1226736031774394_74967
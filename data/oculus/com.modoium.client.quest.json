c_oc=AdkN-Ux6FAQy_BNL0RgH84aAmZQO3LW4eAjqm8S0GtjokJULAHspYfoKngM3VsQt5QE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzgt3QHROSwe_v2DM33dnLAgNvn-fC3L2gVmkDRY4MIzg&oe=69B14B42"}, {"file_name": "screenshot-3.png", "id": "1641875976542765", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974920_1641875979876098_3314538516269626626_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qg0uhqPDM0Q7kNvwHN6RjV&_nc_oc=Adk0eooyOzUi8pATrpo_dL3PgVCr5FIOMhJ1wPEvceyBfPG3ThBDIxu9W92dri_2HjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLjmJVJ8kkokq8oRDzH5YXPzZjwKfCd-Q-A7ZzzBx9ww&oe=69B17B63"}, {"file_name": "screenshot-4.png", "id": "1473009000053295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974834_1473009003386628_5395154856041831416_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXukwOz3IZkQ7kNvwGo524F&_nc_oc=AdmA4WqH_hWcargxpu4ofRJ9G2Su_kOAhx4YiLmAPqiRuhh6jW6UNlaR3weJnWohp-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgLBCkPMwxE5Oj1t7bbh4vwb9lD5f4WfLBQtVSvc-uEw&oe=69B167D1"}, {"file_name": "screenshot-5.png", "id": "951903810294618", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_951903813627951_935484385240937317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jILE5FY8mEQ7kNvwEU8ZUt&_nc_oc=AdnIHjOYlW5JE5hbyIel1QiT67XgAV1d5SQ_YIEytbf17AGaHZCozdlF4T2UDeBdfAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgCSTXFh8HObiaK-wxTeEodmAyrbL7yalPDyFNU_xWoA&oe=69B15AF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modoium", "keywords": ["modoium", "remote", "development", "unity"], "long_description": "# Modoium : The New Standard in Unity Development\n\nDeveloping Android, iOS, iPad or VR content with Unity? Revolutionize your development process with Modoium.\n\n**Key Features :**\n1. Instant Testing: See results on your test devices without building and installing the entire project.\n2. Superior Quality: Automatically supports native resolution and frame rate of test devices, delivering top-notch visuals and audio.\n3. Wireless Connection: Easily connect via Wi-Fi and use multiple devices on the local network.\n4. Multi-Platform Support: Covers iOS, Android, PadOS and VR.\n5. Security: Prevents unauthorized access through verification codes.\n\n**Why Modoium?**\n- Time-Saving: Escape the endless cycle of building, installing, and testing.\n- Increased Productivity: Speed up development with instant feedback.\n- Improved Quality: Verify exact performance on real devices.\n- Cost-Effective: Reduce the need for multiple test devices.\n\nUpgrade your Unity development experience with Modoium. Start now!", "short_description": "Modoium is a Unity mobile game development test acceleration tool. Connect to Unity Editor via Wi-Fi for instant testing, and save build-copy-install time to focus on improving your game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://modoium.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Clicked, Inc.", "support_website_url": null, "website_url": "https://modoium.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9055615047793144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982576_1226736031774394_74967
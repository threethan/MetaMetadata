8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4KWs_jqM6sQ7kNvwGxwY5S&_nc_oc=Adq6kwZcsOq2BTMo5eiXsyVJ68crjpQBnmR2aCFI7cRctdE0kjvOL_uEzBogUnoVeQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQIKxJYd_p-t-mKS7QumkjKyiRwlamwtX7tmwQ-Arvbg&oe=6AB53ABF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dog Town", "keywords": [], "long_description": "\ud83d\udc36 Dog Town is a social VR hangout where players explore, chill, and survive together \ud83c\udfae. Run through colorful streets \ud83c\udfd9\ufe0f, hide from monsters \ud83d\udc79, and team up with friends \ud83e\udd1d in fast-paced, playful gameplay designed for fun and laughs \ud83d\ude04.\n\n\ud83c\udfad Customize your look with fresh drip from the shop \ud83d\udc55\u2728, discover different areas \ud83d\uddfa\ufe0f, and jump into quick sessions \u23f1\ufe0f that are easy to pick up but hard to put down. Dog Town is perfect for friends who want a mix of chaos \ud83d\udca5, exploration \ud83d\udd0d, and social fun \ud83d\udde3\ufe0f in VR \ud83e\udd7d.", "short_description": "Dog Town is a fun game where you and your friends can hang out, run from monsters, and get drip in the shop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/dog-town-privacy-policy/40d75331-0067-47e1-8e35-bf80a42d6731/privacy", "developer_terms_of_service_url": null, "publisher_name": "Puma_Tag", "support_website_url": null, "website_url": "https://www.youtube.com/@PumaTag955", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
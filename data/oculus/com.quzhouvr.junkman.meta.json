74297878798247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toyiQb0WXx0Q7kNvwEc9xrL&_nc_oc=AdrjPpjxwnyr3v8-O7lgyTnk0y0QHcng1YILKTGMRQZVoPYgn3hF4QwHSD4k3Qvin5M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dR-BUBb9KyJaZwC1I4LkJQb6Kx3G5eRz7eAJDE2uD0A&oe=69E24A9E"}, {"file_name": "screenshoot (10).png", "id": "1630663164914498", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499618297_1630663171581164_6570724148415261437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6AIH6O3aVoQ7kNvwHkGgJG&_nc_oc=Adp1NjYD9pauu5eEUT4ycpxGK2ovxaZgX99WfWJuvZHChQbZ_DfjK3vNhG1tDTGIgl0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qUtChqno5kk-XZv0cLJUCHufdF0T3PdXGMcu2Um5Aog&oe=69E22D3F"}, {"file_name": "screenshoot (3).png", "id": "4248788065376315", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618251_4248788068709648_1030468360068271006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOeI_wa_Ib4Q7kNvwEP5quY&_nc_oc=AdqQtdCZaVHimNgNHwhP_ip1HFI0nlzMUi_dVsLoW2D9ZZ-NtmC-eqQu7DMFIJFcyGg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P1RU4RcdlcdDgAjQ2KVb98wDGqEox5oC1JZw1BlXSuw&oe=69E22437"}, {"file_name": "screenshoot (5).png", "id": "1414058900222438", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499617850_1414058903555771_1722904019112517796_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLKDMG6mkJMQ7kNvwGGhAni&_nc_oc=Adqh48HsnXARizSByGLjYQ1H9_CpquTiFXnPmNe7ysUFSD7yWPoGEV1TH2iMQLQK4KU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JygC4a_zt92A-B4nF8hLimXTlJthOTObXlg7rWxkZqQ&oe=69E21C23"}, {"file_name": "screenshoot (2).png", "id": "1918923742338656", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618251_1918923745671989_8890095879017026427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r82t4kLnMvMQ7kNvwGfCsnj&_nc_oc=AdozTuTKLPxdbAd95PmcJhjqEGo6kNR8msT5wDlnaV2x-F0D3lBeHAqV57qLpBvoNSw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TzAo9l6lAj7TgvntAhn4leAnnBql8qZI46xBp2DXcDA&oe=69E21E7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KV\u5efa\u6a21\u7248-\u6a2a\u7248\u5e26\u6587\u6848.png", "id": "2933852970137565", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499617850_2933852973470898_1269573226902913604_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhLnfklW778Q7kNvwHgRYm5&_nc_oc=AdrfDzMPOSIsmzzn4Xn_H5R9VhaX0VqZ7UurLnT41XNMGUCaugEWSEh2XabYjVKw0R0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VSpJ3kQPGLTkMgjAqaepkw2d4PAFpf-guyKSA1-zBbQ&oe=69E23721"}, "display_name": "Grab & Run Alpaca party", "keywords": ["hangout", "multiplayer"], "long_description": "##  This is ** Grab & Run**, the physics-powered extraction multiplayer VR adventure where maps reshape every time, every stuff has real weight, monsters keep you alert, and an upgrade system makes each run hit even better, while you and your friends stay just the right amount of chaotic, and new surprises drop all the time.\n\n---\n---\n\n\n## \ud83c\udf92 **Grab \u2192 Fight \u2192 Return Loop**\nEnter room \u2192 grab shiny stuff \u2192 fight monsters \u2192 push stuff home, classic extraction loop, Alpaca edition.  \nThe more valuable the grab, the harder it gets.  **High risk. Big shiny.**\n\n---\n{1410467900510234}\n\n## \u2699\ufe0f **Physics Chaos**\nEverything heavy. Everything move. Push cart fast, stuff fly off.  \nNot bug, physics working hard.  Too heavy? Roll it into cart. \n\nEfficiency? Maybe. Fun? Definitely.\n\n---\n{1579468509903297}\n\n## \ud83d\uddfa\ufe0f **Every run is a new world**\nNew room combos, new routes, new monsters, every single run.  \nYou might get a little lost and run into wandering monsters, just consider it part of the adventure.\n\n---\n\n## \ud83d\udc79 **Many Monster. Then BIG BOSS.**\nDifferent monsters wander around.  Every few levels, big boss show up.  \nGet friends and fight together. Fun.\n\n---\n{847706171298747}\n\n## \ud83d\udcaa **Get coins, get stronger**\nGrab coins to upgrade your stats, boost your runs, and become big strong alpaca.  \nMore gear, more builds, more chaos coming.  **Final form not reached yet.**\n\n\n{25371341385839390}\n---\n## \ud83d\udd27 **Feedback & Updates**\nWe update the game often and keep improving it based on your feedback.  \nYou speak, we hear. Join our Discord, play with the community:  \n**discord.gg/fXzg8gwrpr**\n\n\n", "short_description": "This is Grab & Run, the physics-powered extraction multiplayer VR adventure where maps reshape every time, every stuff has real weight, monsters keep you alert, and an upgrade system makes each run hit even better, while you and your friends stay just the right amount of chaotic, new surprises drop all the time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1G2lTbooVez5146G8ER7dBPNAw-xLTALwRUWbCwmp9j4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Netvios", "support_website_url": null, "website_url": "https://netvios.163.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25407354645602759"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1562344358151926"}]}, "baseline_offer": {"id": "1562344358151926"}, "is_approved": true, "firstOffer": {"nodes": [{"s
uluscdn.com&_nc_ss=7f20f&oh=00_Af_NfEDIZ51GFEEaUilX-beJx2mumNmIAMSRTWZEmh8fBQ&oe=6A32C23A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KV\u5efa\u6a21\u7248-\u6a2a\u7248\u5e26\u6587\u6848.png", "id": "2933852970137565", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617850_2933852973470898_1269573226902913604_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UlE-2WPnZAQ7kNvwGyENr5&_nc_oc=AdrUt78WAFxFcRvaNHBI1zpXWgz3VJyV-o2eMeIpI5WfdDJp1IyvPaR1zkOoPQbccxs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IARp3r483Jkyks71X_t3eyJoRadiYVTwHzhew0wIqYw&oe=6A32A2A1"}, "display_name": "Grab & Run Alpaca party", "keywords": ["hangout", "multiplayer"], "long_description": "##  This is ** Grab & Run**, the physics-powered extraction multiplayer VR adventure where maps reshape every time, every stuff has real weight, monsters keep you alert, and an upgrade system makes each run hit even better, while you and your friends stay just the right amount of chaotic, and new surprises drop all the time.\n\n---\n---\n\n\n## \ud83c\udf92 **Grab \u2192 Fight \u2192 Return Loop**\nEnter room \u2192 grab shiny stuff \u2192 fight monsters \u2192 push stuff home, classic extraction loop, Alpaca edition.  \nThe more valuable the grab, the harder it gets.  **High risk. Big shiny.**\n\n---\n{1410467900510234}\n\n## \u2699\ufe0f **Physics Chaos**\nEverything heavy. Everything move. Push cart fast, stuff fly off.  \nNot bug, physics working hard.  Too heavy? Roll it into cart. \n\nEfficiency? Maybe. Fun? Definitely.\n\n---\n{1579468509903297}\n\n## \ud83d\uddfa\ufe0f **Every run is a new world**\nNew room combos, new routes, new monsters, every single run.  \nYou might get a little lost and run into wandering monsters, just consider it part of the adventure.\n\n---\n\n## \ud83d\udc79 **Many Monster. Then BIG BOSS.**\nDifferent monsters wander around.  Every few levels, big boss show up.  \nGet friends and fight together. Fun.\n\n---\n{847706171298747}\n\n## \ud83d\udcaa **Get coins, get stronger**\nGrab coins to upgrade your stats, boost your runs, and become big strong alpaca.  \nMore gear, more builds, more chaos coming.  **Final form not reached yet.**\n\n\n{25371341385839390}\n---\n## \ud83d\udd27 **Feedback & Updates**\nWe update the game often and keep improving it based on your feedback.  \nYou speak, we hear. Join our Discord, play with the community:  \n**discord.gg/fXzg8gwrpr**\n\n\n", "short_description": "This is Grab & Run, the physics-powered extraction multiplayer VR adventure where maps reshape every time, every stuff has real weight, monsters keep you alert, and an upgrade system makes each run hit even better, while you and your friends stay just the right amount of chaotic, new surprises drop all the time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1G2lTbooVez5146G8ER7dBPNAw-xLTALwRUWbCwmp9j4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Netvios", "support_website_url": null, "website_url": "https://netvios.163.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25407354645602759"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1562344358151926"}]}, "baseline_offer": {"id": "1562344358151926"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769166780, "status": "PUBLISHED", "id": "1562344358151926"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27018796961125178", "version": "1.14.17"}, "id": "4201197503539639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27018796961125178"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "1\u3001Fixed an issue where the Creator's Booth in the Lobby was malfunctioning.\n2\u3001Fixed occlusion culling, collision, and leaderboard out-of-bounds issues in the Lobby.\n3\u3001Optimized pegboard placement position for the best fit in personal rooms.\n4\u3001Fixed a possible model anomaly when transitioning from the Base to the Lobby.\n5\u3001Fixed an issue where item quantities did not refresh after retrieving items from the spaceship warehouse upon retreat.\n6\u3001Fixed a rare issue where the backpack drag button would become stuck.", "created_date": 1781087636, "id": "27018796961125178", "version": "1.14.17", "version_code": 353, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27018789007792640"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27018796961125178"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "New system/function added\nTarget shooting game: A new target shooting gameplay has been added in the hall, along with dedicated pistols\nGenetic device: A new genetic device has been added to the personal base, supporting numerical offset and back-end access\nForging Table: Complete forging System (including special effects, hints, and grid repair)\nUpgrade device: The model configuration is complete and supports item upgrades\nMining machine: Complete Functions (Animation, special effects, collision)\nWarehouse Box: A new prototype of warehouse box has been added to personal Home, supporting classified display and expansion\nPrivate elevator: Seamless switching between the lobby and personal base, with elevator door animation\nPersonal Room: Complete scene and functional panel (Mobile animation, warehouse, forging table, etc.)\n\nInteraction and UI improvement\nMarketing button: Position update, added vibration feedback, fixed bug of not being able to press\nSpace grid: Displays item name, usage/total capacity, stroke distinction (treasure/material/food)\nPrompt system: New default prompts, recovery time prompts, forging table/upgrade table/gold attribute table prompts have been added\nMultilingual: Extensive updates, multilingual supplementation of search, fight and drop items\nJoystick: Minimum sensitivity 20%, with a new setting for movement accuracy added\nSmooth rotation: Parameters are adjustable, supporting the setting of instantaneous rotation angles\nUI panel: Hall HUD panel integration, private room panel update, ranking list UI optimization\n\nLevels and Scenes\nHall: Fully renovated, seamlessly connected to the base, unnecessary buttons/scripts removed, and new mute panels and marketing information desks added\nPersonal Base: Lighting adjustment, pegboard update, independent loading of scene resources\nLevel difficulty: Adjust the difficulty configuration of Maps 1, 2, and 3", "created_date": 1780688388, "id": "26964004876604387", "version": "1.14.15", "version_code": 348, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26963997813271760"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27018796961125178"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "1. Added creator badge display stand and related activities in the lobby.\n2. Added comment button and related rewards in the lobby.\n3. Added an option to skip the beginner tutorial.", "created_date": 1778743082, "id": "26678032358534975", "version": "1.13.36", "version_code": 328, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26678022941869250"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27018796961125178"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "Added new monster\u3010The Shy Lady\u3011\nMonster trait: She doesn't want to be seen. If the player stares at her, she will notice and chase the player at extremely high speed. If the player turns their back to her, her movement speed will be greatly reduced.\n\nAdded cabinets to many rooms\nPlayers can now open cabinets and search for treasures hidden inside.\n\nDoors now block the path between rooms\nDoors can block the line of sight of monsters from other rooms. However, players won't know if there's a monster in the next room until they open the door.\n\nAdded more hideable tables and chairs in rooms\nMonsters will have a harder time sensing players when they are crouching.\n\nOptimized treasure generation mechanics\nTreasures will now be more diverse and more treasures will be generated in each level (including treasures hidden in cabinets). Each level will roughly generate 4\u20135 times the value of the required mission treasures.\n\nAdded weapons to the shop\nPlayers can now purchase weapons directly from the shop, including: Pistol, Shotgun, Tranquilizer Gun, Electromagnetic Gun, Flamethrower, Freeze Gun, and melee weapons.\n\nOptimized monster physics movement logic\nMonsters will now react more dramatically when hit by weapons.\n\nAdded shatter effects to all treasures and interactable objects in the scene", "created_date": 1777492495, "id": "26510597405278472", "version": "1.13.33", "version_code": 325, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26510586671946212"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27018796961125178"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "1\u3001Fixed an issue where elevators occasionally had no collision.\n2\u3001Added auto-matchmaking (automatically joins rooms that are not full).\n3\u3001Added lobby hoverboard feature.", "created_date": 1776341477, "id": "26359491310389083", "version": "1.13.17", "version_code": 309, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26359459690392245"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
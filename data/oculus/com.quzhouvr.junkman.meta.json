.com&_nc_ss=7f20f&oh=00_AQIFzvtOKTeOqFOvXxhkpsa_AUH2Nn_r53j7P2EGnVfB4Q&oe=6A999D7B"}]}, "id": "4330389767244170", "locale": "en_US", "screenshots": [{"file_name": "screenshoot (7).png", "id": "2389866274783562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_2389866278116895_7649974297878798247_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdMHubytz5IQ7kNvwFzPGGR&_nc_oc=AdrUoCUfA_uYFrmaB6C6AAehbXJFNA7cDVB50AbVGm1Y26WTCeC2D8UTlJDPUsMzqxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIUo7Ggv-VnpkPrQ1B23actdOoDm3e70A9ZXAanX1puw&oe=6A998B1E"}, {"file_name": "screenshoot (10).png", "id": "1630663164914498", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1630663171581164_6570724148415261437_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVHtMtldcuQQ7kNvwF3Cu4u&_nc_oc=AdpM82WbTUq4s4jkAbmJu_jB_3e7watUvMOR-Lwvz-xDlhiuPAjt3CdtRZHk2oVPwQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlX-sGzYbLQCfH0y8m8ChVgLN_gYP-v2pZ2M2GZzjHWw&oe=6A996DBF"}, {"file_name": "screenshoot (3).png", "id": "4248788065376315", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_4248788068709648_1030468360068271006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmkHDa-WmSEQ7kNvwHb9rCi&_nc_oc=AdqKRfDwKAweZzpO0pBjed6XWmoYy8fOqpdI7BGXv6mDD7aXh6WlaCIhR1oNvNzi4ow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHIHSvPCrffi0ingKfrv7tgKXeUaW-fy97lgTkinQB_A&oe=6A999CF7"}, {"file_name": "screenshoot (5).png", "id": "1414058900222438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_1414058903555771_1722904019112517796_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oX2VtxKm10Q7kNvwFo_7tD&_nc_oc=AdqZ4Z9g1UcSBNnf7DhThXlcW5MrVWHa7-nsT4nfvHu7yWm9f7ZItQLW9Q9je-G7GvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo6ZrvBwxjeokIiCkyw4_CRuEDtNZCO96A6AFpvbXCXw&oe=6A9994E3"}, {"file_name": "screenshoot (2).png", "id": "1918923742338656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_1918923745671989_8890095879017026427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG6CzCB7TrwQ7kNvwHNnnK_&_nc_oc=Adp-mqkWgPiyOQzoJex-HC6Fc4LhnyKk4fNDiAO8R_ClHghwGmXGSv98Ez506IIZad8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDmJFQIsw6T4_Hz9gbpT5K5DEGQup2sRNukvdKjeEtMA&oe=6A99973A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KV\u5efa\u6a21\u7248-\u6a2a\u7248\u5e26\u6587\u6848.png", "id": "2933852970137565", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_2933852973470898_1269573226902913604_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUxQu61vOKoQ7kNvwFGIwGK&_nc_oc=Adq3E5Yy0xlX5h5_VZQQUWXm2Pf6alUcdPkedOgbsF5w6uTaY7QF__nVZFoWWmj7KaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIwvC-HmOLhaENEX_RmtQZq8y-4wIgYZ2jl2kF34fKUw&oe=6A9977A1"}, "display_name": "Grab & Run Alpaca party", "keywords": ["hangout", "multiplayer"], "long_description": "##  This is ** Grab & Run**, the physics-powered extraction multiplayer VR adventure where maps reshape every time, every stuff has real weight, monsters keep you alert, and an upgrade system makes each run hit even better, while you and your friends stay just the right amount of chaotic, and new surprises drop all the time.\n\n---\n---\n\n\n## \ud83c\udf92 **Grab \u2192 Fight \u2192 Return Loop**\nEnter room \u2192 grab shiny stuff \u2192 fight monsters \u2192 push stuff home, classic extraction loop, Alpaca edition.  \nThe more valuable the grab, the harder it gets.  **High risk. Big shiny.**\n\n---\n{1410467900510234}\n\n## \u2699\ufe0f **Physics Chaos**\nEverything heavy. Everything move. Push cart fast, stuff fly off.  \nNot bug, physics working hard.  Too heavy? Roll it into cart. \n\nEfficiency? Maybe. Fun? Definitely.\n\n---\n{1579468509903297}\n\n## \ud83d\uddfa\ufe0f **Every run is a new world**\nNew room combos, new routes, new monsters, every single run.  \nYou might get a little lost and run into wandering monsters, just consider it part of the adventure.\n\n---\n\n## \ud83d\udc79 **Many Monster. Then BIG BOSS.**\nDifferent monsters wander around.  Every few levels, big boss show up.  \nGet friends and fight together. Fun.\n\n---\n{847706171298747}\n\n## \ud83d\udcaa **Get coins, get stronger**\nGrab coins to upgrade your stats, boost your runs, and become big strong alpaca.  \nMore gear, more builds, more chaos coming.  **Final form not reached yet.**\n\n\n{25371341385839390}\n---\n## \ud83d\udd27 **Feedback & Updates**\nWe update the game often and keep improving it based on your feedback.  \nYou speak, we hear. Join our Discord, play with the community:  \n**discord.gg/fXzg8gwrpr**\n\n\n", "short_description": "This is Grab & Run, the physics-powered extraction multiplayer VR adventure where maps reshape every time, every stuff has real weight, monsters keep you alert, and an upgrade system makes each run hit even better, while you and your friends stay just the right amount of chaotic, new surprises drop all the time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1G2lTbooVez5146G8ER7dBPNAw-xLTALwRUWbCwmp9j4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Netvios", "support_website_url": null, "website_url": "https://netvios.163.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25407354645602759"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1562344358151926"}]}, "baseline_offer": {"id": "1562344358151926"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769166780, "status": "PUBLISHED", "id": "1562344358151926"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27927679666903565", "version": "1.15.14"}, "id": "4201197503539639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27927679666903565"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "Add and optimize\nOptimize elevator synchronization and interaction.\nIncrease the thickness of the adaptive passageway wall to improve structural stability.\nEnable minimap.\nAccess flight effects to optimize visual performance.\nMatching room timeout (30 seconds) automatically exits, improving the matching experience.\nSupport for entering test scenarios for easy debugging.\nNew Decorations, marketing resources, and multi-language updates for the new semester.\nSearch and destroy mode map door has been added to optimize the damage effect.\nFixed\nFixed a problem that set damage that could be reported incorrectly.\nFixed an issue where the cat and snake panel text was out of bounds and the delivery logic was out of whack.\nFixed a white-clad female ghost effect and lava collision.\nFixed an undestroyed shuttle in the lobby, an elevator collision anomaly, and a private elevator that couldn't move when activated.\nFix match display error, room list text overframe.\nFixed resource loss, precast index loss, map merge data loss, etc. .\nFix flashlight lighting, volume adjustment, voice issues.\nSystems and performance\nUpgrade shaders, optimize ambient reflections, Highlights, and metallic shine, and increase rendering efficiency.\nOptimize occlusion culling, material instantiation, and mesh merging.\nUpdate the role physical controller to improve platform movement, steering, crawling, and delivery logic.\nAdjust the trigger strategy and conditions of monster attacks to improve combat performance.\nOptimize the persistent character flow, support scene switching to retain the role of state.\nProcesses and interactions\nImprove the spacecraft take-off, landing and switching processes, to match the generated levels adjusted to\u201cLanding\u201d after completion.\nOptimize the hall-to-level, death/resurrection logic to increase the sense of immersion.\nImproved lift carrier to move players around and avoid wearing moulds.\nRemove unnecessary images from lobby, death, tutorial and other scenes, and make the interface simpler.\nOne-person joystick access, more options.", "created_date": 1787829261, "id": "27927679666903565", "version": "1.15.14", "version_code": 410, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27927671513571047"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27927679666903565"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "1. Fixed abnormal invisible wall issues in levels.\n2. Fixed an issue where the void could be seen in levels.\n3. Fixed trap abnormalities in certain rooms within levels.\n4. Fixed issues where certain rooms and monsters were not visible in levels.\n5. Fixed Wishing Pool spawn issues.\n6. Optimized performance for improved visual smoothness.\n7. Removed the PBI event and The Shy Lady event.", "created_date": 1785497791, "id": "27598224593182409", "version": "1.14.52", "version_code": 393, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27598217859849749"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27927679666903565"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "Modify the content:\n- The attack range and duration of the painted skin man have been re\n- optimized to provide a more reasonable combat experience.  The monster's health has been reduced, and its difficulty level has been lowered.\n- Rewritten sprint operation: It now supports long press sprint.  During the sprint, clicking again or ceasing movement can cancel it.  Additionally, the bug where sprinting could occur when it was not supposed to has been fixed.\n- The default value of MSAA has been adjusted to 2 to balance image quality and performance.\n- Optimize the instantaneous performance pressure during the generation of the corpse doll to mitigate lag.\nRepair content:\n- Fix the issue of abnormal display of scene props in the hall.\n- Fix the issue where the associated data of the next level is lost after the relic treasure is placed in the backpack.\n- Fix the issue of level devices or items in the distant void.\n- Fix the infinite sprint issue.\n- Fix the error in the value weight of treasures.", "created_date": 1784901081, "id": "27520599864278216", "version": "1.14.48", "version_code": 389, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27520593944278808"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27927679666903565"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "Bug Fixes\n1. Fixed an issue where players could occasionally be kicked out of the game room.\n2. Fixed an issue where the hand model did not change color correctly when reflected in mirrors.\n3. Fixed an abnormal behavior with multi-stage / multi-jump mechanics.\n4. Fixed an issue where dropped items upon death behaved unexpectedly.\n5. Fixed an issue where certain text strings were not properly localized / did not support multiple languages.\n6. Fixed an issue where some items would break unexpectedly when taken out of storage crates / warehouse boxes.\n7. Fixed various bugs related to monster behavior.", "created_date": 1784702372, "id": "27492530337085169", "version": "1.14.42", "version_code": 383, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27492523363752533"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24653500707654827", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27927679666903565"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4201197503539639"}]}, "change_log": "New Features  \nSlotMachine System  \nCustom Black Screen Function \nOptimization and improvements  \nAI and monsters  \nHall lighting adjustment, fixed floating warehouse crates issue, optimized tutorial portal \nBug Fixes  \nFixed issues where blood pots do not affect monsters, monster states fail to take effect, and characters remain red after being hit.  \nFixed synchronization issues with the little girl's animation, gene device, and search/attack data updates.  \nFixed errors in custom black screen following and malfunctioning skip function.  \nFixed abnormal elite monster generation and patrol behavior.  \nFixed reversed settings for running speed and movement speed, as well as PT monster initialization anomalies. \nResource and Content Update  \nUpdated in-game ship models  \nUpdated search, attack, and retreat item images, added starfield particle effects", "created_date": 1783697069, "id": "27368217539516450", "version": "1.14.30", "version_code": 369, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27368210756183795"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
8034612851773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031569_3708034616185106_510976802645956706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsz8VUrh0yAQ7kNvwGtk6A_&_nc_oc=Adq4gH7xNCt3G634-n_WqpKmZ3nuJOaYhQxX9qmLdtKCbFz1x67iu3PXjn2hLDsJZxg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgJDNw82MKyTnvL1hdiK-6xyeW3jqg-oEfnbmiWtbY2w&oe=6AAD34AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "finalusers.png", "id": "1716145552202977", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974738_1716145555536310_4444149601640776146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyYNkudcoDIQ7kNvwE5Vtq7&_nc_oc=Ado3thnGTVtoZYUUSW5Stm8vKdC1l3ZnbVIqKbLMYRAWGFxixWNGeqPeIKfcaD-TUCI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz7gmUFaO3EKP0WWZGskkgS14x0e3B7tcc-F95-s_x5Q&oe=6AAD3645"}, "display_name": "Char Horror Story", "keywords": [], "long_description": "You'll explore every corner of this haunted house, solving puzzles while facing terrifying surprises along the way. The realistic VR experience makes it feel like you're really there, surrounded by the chilling environment.\n\nDiscover the secrets hidden within the house's walls as you navigate through its ominous rooms. Can you survive the scares and uncover the truth lurking in the shadows?\n\nGet ready for a thrilling VR horror experience that'll keep you on the edge of your seat. Are you brave enough to face your fears in \"Char Horror Story\"?", "short_description": "Step into \"Char Horror Story\" a scary VR puzzle game set in an old, creepy house. Get ready for a spooky adventure filled with puzzles and jump scares in a dark, eerie atmosphere.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "c
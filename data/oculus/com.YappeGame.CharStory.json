0976802645956706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AespkS-N04Q7kNvwGDglWL&_nc_oc=AdqynDTtcFkYvwdPQx8L35jYAwI1xGt4Ze33uwPkF4OPdh7GEEv8Tp0BYtmquiMpR9s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1udX5V3nC3amcOMQK0Kti_pOjF8YMxQvao3bzsKJWqnA&oe=69F1FFAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "finalusers.png", "id": "1716145552202977", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974738_1716145555536310_4444149601640776146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytdHevq3KHAQ7kNvwECmXIA&_nc_oc=Adp9k-bWd2n2cmYp6VqHel8def6ZTkGUW9fPfu3CnBMuZV4MTLkOmOsYyyQcyImrcEU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3nEi_lB_2VGiWznaa1LRdrA8-2K1QlRD_UTSiyKcH7Rw&oe=69F20145"}, "display_name": "Char Horror Story", "keywords": [], "long_description": "You'll explore every corner of this haunted house, solving puzzles while facing terrifying surprises along the way. The realistic VR experience makes it feel like you're really there, surrounded by the chilling environment.\n\nDiscover the secrets hidden within the house's walls as you navigate through its ominous rooms. Can you survive the scares and uncover the truth lurking in the shadows?\n\nGet ready for a thrilling VR horror experience that'll keep you on the edge of your seat. Are you brave enough to face your fears in \"Char Horror Story\"?", "short_description": "Step into \"Char Horror Story\" a scary VR puzzle game set in an old, creepy house. Get ready for a spooky adventure filled with puzzles and jump scares in a dark, eerie atmosphere.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "
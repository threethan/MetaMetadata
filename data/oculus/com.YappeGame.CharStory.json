8ku7BMajgQ7kNvwF-J_aC&_nc_oc=AdqNWhfnTeRJDW_wk2f_mbtXCt4TchRjvmPrUlHEXnykfCr_4rD1k3RDzUvtJQ6he7M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJy3ZDvweDljiUjVxJ2rCHCHfFc2ZpOEamchqC4c6Fww&oe=6B086605"}, "display_name": "Char Horror Story", "keywords": [], "long_description": "You'll explore every corner of this haunted house, solving puzzles while facing terrifying surprises along the way. The realistic VR experience makes it feel like you're really there, surrounded by the chilling environment.\n\nDiscover the secrets hidden within the house's walls as you navigate through its ominous rooms. Can you survive the scares and uncover the truth lurking in the shadows?\n\nGet ready for a thrilling VR horror experience that'll keep you on the edge of your seat. Are you brave enough to face your fears in \"Char Horror Story\"?", "short_description": "Step into \"Char Horror Story\" a scary VR puzzle game set in an old, creepy house. Get ready for a spooky adventure filled with puzzles and jump scares in a dark, eerie atmosphere.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
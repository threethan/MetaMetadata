zy-67RH1mHrNfOVibZh7YjCSKdP9p14tvHWPWTA&oe=6A3930AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "finalusers.png", "id": "1716145552202977", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974738_1716145555536310_4444149601640776146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi1lzhxsgEcQ7kNvwFbjdoE&_nc_oc=AdqDNob269JZ1xY4oPZQNsR9SZHT3NTcR41cdQj-TaVegeFtipSh0oxjoi4cd6ktrYE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GXdqYXTOYMF0JolROkInHRpA5e-SKrmPTC_aOn9ql4A&oe=6A393245"}, "display_name": "Char Horror Story", "keywords": [], "long_description": "You'll explore every corner of this haunted house, solving puzzles while facing terrifying surprises along the way. The realistic VR experience makes it feel like you're really there, surrounded by the chilling environment.\n\nDiscover the secrets hidden within the house's walls as you navigate through its ominous rooms. Can you survive the scares and uncover the truth lurking in the shadows?\n\nGet ready for a thrilling VR horror experience that'll keep you on the edge of your seat. Are you brave enough to face your fears in \"Char Horror Story\"?", "short_description": "Step into \"Char Horror Story\" a scary VR puzzle game set in an old, creepy house. Get ready for a spooky adventure filled with puzzles and jump scares in a dark, eerie atmosphere.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
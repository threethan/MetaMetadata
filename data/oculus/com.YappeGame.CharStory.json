8034612851773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031569_3708034616185106_510976802645956706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRrsVgK7r5gQ7kNvwFJV4iy&_nc_oc=AdrWm1HZTg-KFgb1wLkheV_9fJjKo0QzT7wrLn7uUtS7GeaZfTkAmMeq4A4oaZOqeks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27SJ954dmHoo6b3WUQOlazcHXPPRTWGIB-BcoQGaObRw&oe=69F8972B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "finalusers.png", "id": "1716145552202977", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974738_1716145555536310_4444149601640776146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM3sQ0sLKwYQ7kNvwFQn-8n&_nc_oc=AdqFf3iQ2qdEhSUqJAvxx_QCcGglMoVJR_j_SgKmMNv9mQuf6-iyLCzf9JD2S9Qp5LI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jwUjAzD2Ai61-nzh1Ik_FDHhWg5fMXN27JhNj9YQWwQ&oe=69F898C5"}, "display_name": "Char Horror Story", "keywords": [], "long_description": "You'll explore every corner of this haunted house, solving puzzles while facing terrifying surprises along the way. The realistic VR experience makes it feel like you're really there, surrounded by the chilling environment.\n\nDiscover the secrets hidden within the house's walls as you navigate through its ominous rooms. Can you survive the scares and uncover the truth lurking in the shadows?\n\nGet ready for a thrilling VR horror experience that'll keep you on the edge of your seat. Are you brave enough to face your fears in \"Char Horror Story\"?", "short_description": "Step into \"Char Horror Story\" a scary VR puzzle game set in an old, creepy house. Get ready for a spooky adventure filled with puzzles and jump scares in a dark, eerie atmosphere.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "c
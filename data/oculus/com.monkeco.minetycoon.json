59", "locale": "en_US", "screenshots": [{"file_name": "screenshot_3_2560x1440.png", "id": "1071017189077658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1071017192410991_5925216856731009572_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moGXktEq828Q7kNvwGrshfX&_nc_oc=AdrIlVDFcIER04veaYRvQVCIG9LMExBO7dIh_jtAcG8fMeedGzcNULOExs4RXVNzPYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5dq6V1FMWvzlyVOriI8cdFskoRhNA_bwHV072yYYORA&oe=6AF879E5"}, {"file_name": "screenshot_1_2560x1440.png", "id": "2514252902375746", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_2514252905709079_6994565307623495453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZBJ9t_I2BgQ7kNvwFtmLEr&_nc_oc=AdpsWPvrgrEJ5Cs1RauxSnsEqPy8cy8w5HmfLizyjiaQspKyGvrN1l8hYRdCkBTdTSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbim_hPGawhhxbXvWOc0arnD68pUPYipNWWQkrFSsyOA&oe=6AF87E09"}, {"file_name": "screenshot_2_2560x1440.png", "id": "973693061676939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_973693065010272_6853584449373814385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQYZJVegR8EQ7kNvwG7mXTO&_nc_oc=AdpGD-9JXslbGzqOJdT45CcjILWbdDh-QYMTSDkXI7NDAgC4VuGiei_0_ffyb2luCSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfR6gdRLdjh8gtoofzTOGtvt3T4IN1OH3lZW5RXhbnHA&oe=6AF8987D"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1088456244073475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1088456247406808_7851386984398337309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDiZjQCSw2cQ7kNvwHZlCps&_nc_oc=AdpIeNMgnuSt5qofa6zSSyPJYPDKCWDCti-0NdX2lfSgyzKnObNYcVcKuLKOcp1P1Tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfwULGNI5nk5jOc98KYZlJ2rmAXrKP6d5bAa44o9u8dw&oe=6AF8A3CC"}, {"file_name": "screenshot_5_2560x1440.png", "id": "978540125283026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_978540128616359_9172982433911584359_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X29MOVroGEQ7kNvwGK2UD2&_nc_oc=Adpx8oluJo9QLS1LHfR0fSG6LFUItmhxfgcpWJ7bDvD3ZvYzSyRXhKmcBM14h9l7TXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcrIeWSAZTA9ZWcP4HpALGFcK5jMJWWUELUPVJXFI81g&oe=6AF87AF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mine Tycoon", "keywords": ["tycoon", "monkey", "gorilla", "simulator", "mining"], "long_description": "\ud83d\udcac Join the Discord: discord.gg/MZXNwzVRsN\n\nYou're a monke with a plot of land and $150. Build the richest mine in VR.\n\n\u26cf\ufe0f Droppers, belts, upgraders & furnaces turn ore into CASH\n\ud83d\udd90\ufe0f Grab machines off your wrist tablet and THROW them onto your plot\n\ud83d\udc8e 100+ machines, including gambling machines and secret exclusives\n\ud83d\udd04 Rebirth to get stronger and unlock exclusive machines\n\ud83d\udca4 Your mine keeps earning while you're offline\n\ud83c\udfc6 Leaderboards & Hall of Fame statues: flex on everyone\n\ud83c\udfa9 Hats, faces, glowing hands, swing trails & base themes\n\ud83d\udc3e Pets, daily gifts, quests, crates & treasure chests\n\ud83d\udc65 Up to 6 players, voice chat, private rooms with a code\n\nHOW IT WORKS\nDroppers spit out ore. Belts carry it. Upgraders multiply what it's worth. Furnaces turn it into cash. Grab a mini machine off your wrist tablet, aim at your plot and let go. It flies out of your hand and lands on the grid. After a rebirth your old layout rebuilds itself.\n\nClimb the boulders and hunt down treasure chests that refill every day. Everyone gets their own plot, and nobody can touch your plot or your cash.\n\nGorilla Tag-style arm movement. Free to play. We're updating it all the time, so tell us what breaks in the Discord!", "short_description": "Build the richest mine in VR! Throw machines onto your plot, rebirth for exclusive machines, collect pets and flex on the leaderboards with friends."}]}, "developer_name": "MandiHQ", "developer_privacy_policy_url": "https://sites.google.com/view/monkeminetycoon/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MonkeCo", "support_website_url": "https://discord.gg/admHgqbqCT", "website_url": "https://sites.google.com/view/monkeminetycoon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1488899263146433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1026954693689723_6479870296847747558_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3nodkKgSloQ7kNvwF-WFId&_nc_oc=AdpezV_LCTvm1yAmOosH_xiqpJNHB-XfvJLm9zJB8WDbUPYMRKh_r_puS-l2nIz32zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcdbTgAxcxSwkg2HWnOAqf6z9bk2zOyZinIKGA9q4Gig&oe=6AF8768D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monke Mine Tycoon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1790969160, "lastRevision": {"nodes": [{"id": "1451000753602951", "release_type": "SCHEDULED", "a
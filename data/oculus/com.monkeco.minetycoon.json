a0a&_nc_ohc=-7OSIE0C1VoQ7kNvwG3k2be&_nc_oc=AdreECZAaQP9C0-YYQVk2Qva7eA3rOA5kfed7_7L2rAPTZoabok8K0U4rz89qsrEJyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcLVKOXpYVXSAY9mUDFwBDzFQ-Jiik4cKdzI2gNStqnw&oe=6AF4770C"}, {"file_name": "screenshot_5_2560x1440.png", "id": "978540125283026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_978540128616359_9172982433911584359_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWAnohcbGwsQ7kNvwHJH4Wj&_nc_oc=AdooKA1e8hIPlfc9WlIqzSb68PNIrV0RKdqymSDlt4x2wtr3ezSWiaSQT3ZutAWcZbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGxwYy_J6uQwPGOwhkzp0EmmRE99IHdNo5fz7wuSp0yg&oe=6AF48679"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mine Tycoon", "keywords": ["tycoon", "multiplayer", "monkey", "gorilla", "simulator"], "long_description": "You're a monke with a plot of land and $150. Time to fix that.\n\nMonke Mine Tycoon is a multiplayer mining tycoon where you move with your arms, Gorilla Tag style. Slap a CLAIM button, open the shop on your wrist and start building.\n\nHOW IT WORKS\nDroppers spit out ore. Belts carry it. Upgraders multiply what it's worth. Furnaces turn it into cash. Grab a mini machine off your wrist tablet, aim at your plot and let go. It flies out of your hand and lands on the grid.\n\nTHINGS TO DO\nUnlock 55 machines, from basic droppers to gambling machines and resetters. Research better gear, rebirth to start over stronger and earn exclusive machines you can't buy. Your mine keeps earning while you're away, and after a rebirth your old layout rebuilds itself.\n\nClimb the boulders and hunt down treasure chests that refill every day. Level up your monke, grab daily gifts, quests, achievements and crates, and chase the leaderboards. Deck out your robot with hats, glowing hands and swing trails.\n\nMULTIPLAYER\nUp to 4 monkes per lobby with voice chat, and everyone gets a plot. Share a room code to play with friends or make a private room. Nobody can touch your plot or your cash, so show off all you want.\n\nWe're updating it all the time, so tell us what breaks.", "short_description": "Claim a plot, build a mine and get stupid rich. Swing around with gorilla arms and out-earn your whole lobby."}]}, "developer_name": "MandiHQ", "developer_privacy_policy_url": "https://sites.google.com/view/monkeminetycoon/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MonkeCo", "support_website_url": "https://discord.gg/admHgqbqCT", "website_url": "https://sites.google.com/view/monkeminetycoon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1451000743602952"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1026954693689723_6479870296847747558_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGFnjxr-hz4Q7kNvwH9urYX&_nc_oc=Adq5MZYKzUNhChC5EENrvBxzZHHmEstu1cJgWSZEqfh_HionyDUxq0w5GuHRwrTtGMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKrfhavmVjLdQMMrrwQN55YrIiskFzLHy-AmI-gfdSwA&oe=6AF4820D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monke Mine Tycoon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
5-1.oculuscdn.com/v/t64.5771-25/491823341_973693065010272_6853584449373814385_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQYZJVegR8EQ7kNvwHts-7H&_nc_oc=AdpBotloGSi3sreT_S5eIFCINP34FedGv8nKyOoCBseNwuvXqw9nAglS1RTApjHXmiQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJaTWenQpORU6sVh95dyxUcJ6DvXgo0CJxZAnyayYLDA&oe=6AF746FD"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1088456244073475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1088456247406808_7851386984398337309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDiZjQCSw2cQ7kNvwGdbbOu&_nc_oc=AdqvP8ABuAjqdGaMLyojutPe2UnD6sH1HsZuDl--Cl2EI8g34tYdY30PnhKughAbhKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkF6voAPu5XVYiFrWK2gU6PywCg6of_-8Ukh3I3SLoHQ&oe=6AF71A0C"}, {"file_name": "screenshot_5_2560x1440.png", "id": "978540125283026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_978540128616359_9172982433911584359_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X29MOVroGEQ7kNvwEsJOZC&_nc_oc=AdqaNB4orPyaUrhEI4n8JCHowjfxETHTYmbF1ajvk4HlL-7DHIlQVImTkShNyHxByeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwJho1nQjKbVt969E99c2aWIKdmvNmvcIEp-SVJZnaMA&oe=6AF72979"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mine Tycoon", "keywords": ["tycoon", "multiplayer", "monkey", "gorilla", "simulator"], "long_description": "You're a monke with a plot of land and $150. Time to fix that.\n\nMonke Mine Tycoon is a multiplayer mining tycoon where you move with your arms, Gorilla Tag style. Slap a CLAIM button, open the shop on your wrist and start building.\n\nHOW IT WORKS\nDroppers spit out ore. Belts carry it. Upgraders multiply what it's worth. Furnaces turn it into cash. Grab a mini machine off your wrist tablet, aim at your plot and let go. It flies out of your hand and lands on the grid.\n\nTHINGS TO DO\nUnlock 55 machines, from basic droppers to gambling machines and resetters. Research better gear, rebirth to start over stronger and earn exclusive machines you can't buy. Your mine keeps earning while you're away, and after a rebirth your old layout rebuilds itself.\n\nClimb the boulders and hunt down treasure chests that refill every day. Level up your monke, grab daily gifts, quests, achievements and crates, and chase the leaderboards. Deck out your robot with hats, glowing hands and swing trails.\n\nMULTIPLAYER\nUp to 4 monkes per lobby with voice chat, and everyone gets a plot. Share a room code to play with friends or make a private room. Nobody can touch your plot or your cash, so show off all you want.\n\nWe're updating it all the time, so tell us what breaks.", "short_description": "Claim a plot, build a mine and get stupid rich. Swing around with gorilla arms and out-earn your whole lobby."}]}, "developer_name": "MandiHQ", "developer_privacy_policy_url": "https://sites.google.com/view/monkeminetycoon/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MonkeCo", "support_website_url": "https://discord.gg/admHgqbqCT", "website_url": "https://sites.google.com/view/monkeminetycoon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1451000743602952"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4638260179741521"}]}, "baseline_offer":
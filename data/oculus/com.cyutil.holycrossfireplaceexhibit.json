54279298_1087497624821359825_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W38jf5GUDSIQ7kNvwHF64-D&_nc_oc=Admru8J4eQAWjLcvpCCtU0OeNqeW_z8jrMuPROzCvXAw2AsCGJsCdQ9UC0LTAJoMOno&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfshXpvbYkEK0ueGAmMZYwRBm2NK8rVze-nuPlv-PWIE5g&oe=69999D6A"}, {"file_name": "HolycrossFireplaceScreenShot_3.png", "id": "1531895694147260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391974_1531895697480593_8946999516881703677_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzVuUuTVeREQ7kNvwFGMPTD&_nc_oc=Adm99ZaLqpNyTfC-odhBACq4cpOyPW2BSlr-kDVbiAMi06XMNK1hyEVmh-w63kN46w4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUV84qg3c0hHdyIpxCAFWAOtyzZLlDGkZztVgoJlxwEw&oe=699990FF"}, {"file_name": "HolycrossFireplaceScreenShot_5.png", "id": "955618996688461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393516_955619000021794_5113006238262194411_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmGvSHBg5U8Q7kNvwFPanxh&_nc_oc=AdkjhTzWi6QCg-j_9_U34UonC3FjerMktbzOyCANRLFcDx1Vw-O2_aHK437ab41HtZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvlirSN2YQc3GC-9UJkYb54Yir77ws9ZlPhxjZmaHWHKg&oe=6999B6A9"}, {"file_name": "HolycrossFireplaceScreenShot_4.png", "id": "617128441168689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392000_617128444502022_2425880846334451926_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNk6Y0o-MikQ7kNvwFXTBX1&_nc_oc=Adk5pCQF198J7zlyeiXway9zlnNmgPdiF-LKmP4GrxTdk52c1LqI0sCji8DUqpo0dEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_kmNKy456KpMHuZSFClfnC8AhXpCJwyhUNhmRmSR8wQ&oe=6999BA1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holycross Fireplace Heritage", "keywords": [], "long_description": "The Holycross Fireplace Heritage VR Exhibit is a captivating journey through space and time, where history and storytelling come to life in a dynamic digital display. This concept piece illustrates the power of merging a digital twin with rich narratives and multimedia, creating a deeply immersive family legacy experience. More than just a virtual showcase, it is a family legacy piece\u2014a way to preserve and share cherished stories with loved ones, friends, and future generations.\n\nDesigned to inspire and ignite imagination, this exhibit demonstrates the boundless possibilities of heritage media in virtual reality, paving the way for innovative storytelling and cultural preservation in the digital age.", "short_description": "This exhibit showcases a digital twin of the Eugene Holycross hand built fireplace from 1938 located in northern Indiana. An interactive timeline shares family photos taken near the fireplace from the past 80 years."}]}, "developer_name": null, "developer_privacy_policy_url": "https://du07c2o3pl4c1.cloudfront.net/temp/fireplace_family_media/HolycrossFireplaceExhibitPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "CYUTIL LLC", "support_website_url": null, "website_url": "https://www.cyutil.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9369505499810313"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391982_1155993309611897_6664751024221360295_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KW7TOHF8JAUQ7kNvwHYfpht&_nc_oc=AdmviGEjpTYmirxg7DUTGX72sIi_rseH
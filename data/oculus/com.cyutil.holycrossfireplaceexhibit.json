54279298_1087497624821359825_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23fX4czVaCkQ7kNvwEBLVT3&_nc_oc=Adlr6LE0KulKrZD2BQMc8bsrcO2H3s_TXJ1cIGbfHMz8d-FCvW3mC4YsZ_dTITk22bY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuaWz63yEuFgQtSm_78V8nW04eZ_qlFVIAwx_EycGL0Ag&oe=69A57AEA"}, {"file_name": "HolycrossFireplaceScreenShot_3.png", "id": "1531895694147260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391974_1531895697480593_8946999516881703677_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdijgBfW7g8Q7kNvwEvUMpN&_nc_oc=AdngQMR89ig-gob8jW4qxCNkQyQwlBS6VyGgKPE-fu6e3l8CbBMgJpCbwn_UPLdGAYs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftEYyEOOSJEVpitr16tNC_tADAm_-1TAyEaCZ4X9yPV3w&oe=69A56E7F"}, {"file_name": "HolycrossFireplaceScreenShot_5.png", "id": "955618996688461", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_955619000021794_5113006238262194411_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gsOqptuRyMQ7kNvwGPgrna&_nc_oc=AdnTByK8X8YNfTKgPcfEhU7cqie-NJLdKVeq_C8Uo15v3uyEDGq7OSNBm_SDhISpmU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuhOd3qNeprTKaO5LlC3DeaMxr0sfmg0_YlmdmLtD2l0w&oe=69A59429"}, {"file_name": "HolycrossFireplaceScreenShot_4.png", "id": "617128441168689", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392000_617128444502022_2425880846334451926_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7H2trCRyYkQ7kNvwFTOP7T&_nc_oc=Admrprs9Tg5XFXFhjKOQOmtQ4HwNm8mbUPMdDDrxkT-AzrT2IdIxuif8Zk6pDTzay30&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfudWcpP3vdQzOKigrSo05AEzZFsf3voU7Dm3U9TDKrM2Q&oe=69A5979D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holycross Fireplace Heritage", "keywords": [], "long_description": "The Holycross Fireplace Heritage VR Exhibit is a captivating journey through space and time, where history and storytelling come to life in a dynamic digital display. This concept piece illustrates the power of merging a digital twin with rich narratives and multimedia, creating a deeply immersive family legacy experience. More than just a virtual showcase, it is a family legacy piece\u2014a way to preserve and share cherished stories with loved ones, friends, and future generations.\n\nDesigned to inspire and ignite imagination, this exhibit demonstrates the boundless possibilities of heritage media in virtual reality, paving the way for innovative storytelling and cultural preservation in the digital age.", "short_description": "This exhibit showcases a digital twin of the Eugene Holycross hand built fireplace from 1938 located in northern Indiana. An interactive timeline shares family photos taken near the fireplace from the past 80 years."}]}, "developer_name": null, "developer_privacy_policy_url": "https://du07c2o3pl4c1.cloudfront.net/temp/fireplace_family_media/HolycrossFireplaceExhibitPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "CYUTIL LLC", "support_website_url": null, "website_url": "https://www.cyutil.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9369505499810313"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391982_1155993309611897_6664751024221360295_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDGO6suetz8Q7kNvwEPH_rD&_nc_oc=Adn65LUeFDltr_zsDrtgk0Hhmn6lcSwW
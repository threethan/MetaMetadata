54279298_1087497624821359825_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W38jf5GUDSIQ7kNvwGJuASd&_nc_oc=AdmccRX3k_13K9yWZS4YEuYiJv6cA7UFPfuytWP2YLioXJmgawwtOeMDEjtl8Sxjd2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftbTZgKn_0l84HDb7rPRI_CSeNKUKOsM83L9ZQroL8eTQ&oe=699AEEEA"}, {"file_name": "HolycrossFireplaceScreenShot_3.png", "id": "1531895694147260", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391974_1531895697480593_8946999516881703677_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzVuUuTVeREQ7kNvwECb5KG&_nc_oc=AdmWBzZJMMBNsZpJklekZAfyk4o0PhPYnrIOdkcvIivydtHklGEy1es82l1VSteRv1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftqfRDjAY_qoAOYCbEn_Si3HKk4G70B5S9JrsCbkl3ivQ&oe=699AE27F"}, {"file_name": "HolycrossFireplaceScreenShot_5.png", "id": "955618996688461", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_955619000021794_5113006238262194411_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmGvSHBg5U8Q7kNvwEAmnlY&_nc_oc=AdkOPAiG6sJ-b-RPNsTJx9BdNUoqMIGpDb0iNq0eupy2rm4UNtiO9Oij2oJ8XOVFZ9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsGLWMEVl1RAQjVZPW-4UFVbx389-77D3gbiKd_q10MXA&oe=699B0829"}, {"file_name": "HolycrossFireplaceScreenShot_4.png", "id": "617128441168689", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392000_617128444502022_2425880846334451926_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNk6Y0o-MikQ7kNvwGF8szg&_nc_oc=AdkU8s1LWjuYsoDwRAN5wqWGCYF6SlLZhcpXVqNhtRcShD2jIdmBJ8TKHEZwjwXlTKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvAuykLDeV61tTOZAB7IRDx2oMpM79ZXh5iuxkHHyc5LA&oe=699B0B9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holycross Fireplace Heritage", "keywords": [], "long_description": "The Holycross Fireplace Heritage VR Exhibit is a captivating journey through space and time, where history and storytelling come to life in a dynamic digital display. This concept piece illustrates the power of merging a digital twin with rich narratives and multimedia, creating a deeply immersive family legacy experience. More than just a virtual showcase, it is a family legacy piece\u2014a way to preserve and share cherished stories with loved ones, friends, and future generations.\n\nDesigned to inspire and ignite imagination, this exhibit demonstrates the boundless possibilities of heritage media in virtual reality, paving the way for innovative storytelling and cultural preservation in the digital age.", "short_description": "This exhibit showcases a digital twin of the Eugene Holycross hand built fireplace from 1938 located in northern Indiana. An interactive timeline shares family photos taken near the fireplace from the past 80 years."}]}, "developer_name": null, "developer_privacy_policy_url": "https://du07c2o3pl4c1.cloudfront.net/temp/fireplace_family_media/HolycrossFireplaceExhibitPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "CYUTIL LLC", "support_website_url": null, "website_url": "https://www.cyutil.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9369505499810313"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391982_1155993309611897_6664751024221360295_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3pUfWKRsnwQ7kNvwFBdEQa&_nc_oc=AdmD4D2cd2KvYFYy-J4We5CG11DBwJo7
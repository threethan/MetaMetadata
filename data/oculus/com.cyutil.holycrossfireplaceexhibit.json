_Xlw&oe=6A32B73F"}, {"file_name": "HolycrossFireplaceScreenShot_5.png", "id": "955618996688461", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393516_955619000021794_5113006238262194411_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yKUw_4qYUcQ7kNvwEDwi5T&_nc_oc=AdpixRgF6_CyMDnYnloBIIOLpJSwWi0TIdXBO5NWkCNA6H8Ml8ogqdM6m77k7L_i95s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G4LStEkNOyUWPzbHIPWo4bCv92_OW3xmYyx3EG24ofw&oe=6A32A4A9"}, {"file_name": "HolycrossFireplaceScreenShot_4.png", "id": "617128441168689", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392000_617128444502022_2425880846334451926_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaFUVOrzdkAQ7kNvwH2hMUu&_nc_oc=AdoAHwwKJsLc4Tq1wkNXbUS2-FMX_R0ZELYbU0_6wf4a-v9aGKOn8_JZJNMthpSmFAs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6_G9-i1Nqc77mFG7sgPoDxrZ95GkTk_mZec9j_E4klw&oe=6A32A81D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holycross Fireplace Heritage", "keywords": [], "long_description": "The Holycross Fireplace Heritage VR Exhibit is a captivating journey through space and time, where history and storytelling come to life in a dynamic digital display. This concept piece illustrates the power of merging a digital twin with rich narratives and multimedia, creating a deeply immersive family legacy experience. More than just a virtual showcase, it is a family legacy piece\u2014a way to preserve and share cherished stories with loved ones, friends, and future generations.\n\nDesigned to inspire and ignite imagination, this exhibit demonstrates the boundless possibilities of heritage media in virtual reality, paving the way for innovative storytelling and cultural preservation in the digital age.", "short_description": "This exhibit showcases a digital twin of the Eugene Holycross hand built fireplace from 1938 located in northern Indiana. An interactive timeline shares family photos taken near the fireplace from the past 80 years."}]}, "developer_name": null, "developer_privacy_policy_url": "https://du07c2o3pl4c1.cloudfront.net/temp/fireplace_family_media/HolycrossFireplaceExhibitPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "CYUTIL LLC", "support_website_url": null, "website_url": "https://www.cyutil.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9369505499810313"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1758310354949575"}]}, "baseline_offer": {"id": "1758310354949575"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741285500, "status": "PUBLISHED", "id": "1758310354949575"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9468197133274482", "version": "0.3"}, "id": "3890432044563377", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9369505466476983", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9468197133274482"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3890432044563377"}]}, "change_log": null, "created_date": 1741241642, "id
NsTJx9BdNUoqMIGpDb0iNq0eupy2rm4UNtiO9Oij2oJ8XOVFZ9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsGLWMEVl1RAQjVZPW-4UFVbx389-77D3gbiKd_q10MXA&oe=699B0829"}, {"file_name": "HolycrossFireplaceScreenShot_4.png", "id": "617128441168689", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392000_617128444502022_2425880846334451926_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNk6Y0o-MikQ7kNvwGF8szg&_nc_oc=AdkU8s1LWjuYsoDwRAN5wqWGCYF6SlLZhcpXVqNhtRcShD2jIdmBJ8TKHEZwjwXlTKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvAuykLDeV61tTOZAB7IRDx2oMpM79ZXh5iuxkHHyc5LA&oe=699B0B9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holycross Fireplace Heritage", "keywords": [], "long_description": "The Holycross Fireplace Heritage VR Exhibit is a captivating journey through space and time, where history and storytelling come to life in a dynamic digital display. This concept piece illustrates the power of merging a digital twin with rich narratives and multimedia, creating a deeply immersive family legacy experience. More than just a virtual showcase, it is a family legacy piece\u2014a way to preserve and share cherished stories with loved ones, friends, and future generations.\n\nDesigned to inspire and ignite imagination, this exhibit demonstrates the boundless possibilities of heritage media in virtual reality, paving the way for innovative storytelling and cultural preservation in the digital age.", "short_description": "This exhibit showcases a digital twin of the Eugene Holycross hand built fireplace from 1938 located in northern Indiana. An interactive timeline shares family photos taken near the fireplace from the past 80 years."}]}, "developer_name": null, "developer_privacy_policy_url": "https://du07c2o3pl4c1.cloudfront.net/temp/fireplace_family_media/HolycrossFireplaceExhibitPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "CYUTIL LLC", "support_website_url": null, "website_url": "https://
1.oculuscdn.com/v/t64.5771-25/491823802_929877106806566_8505473154989573933_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgCNt4Fujs0Q7kNvwEwtvVP&_nc_oc=Adr0r4HoqnScOTYAlVgK6sxjpMjDDkDIi7IwHtVCOIhIeiHHJV1-n6bazsd5w3kHmuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmhyvuMPphQnTER39Msd7XM1s7nXakSnhRDiyit6WPlg&oe=6A9ECD3C"}, {"file_name": "com.oculus.vrshell-20260802-194942.png", "id": "2274340366714361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_2274340373381027_2015678920562311846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTtXrge8rMgQ7kNvwGd98Z6&_nc_oc=AdrhEKoPxe9xBCUsiBk_Db4PsDm8cx9MFnVNKn3G1lGJpnhig-5noLoZPgcRgwZtxK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoMYCup3zyq3OnHD_iIctAAsQz0OWsIud7jX0P63B0ww&oe=6A9EB416"}, {"file_name": "com.oculus.vrshell-20260802-195557.png", "id": "1020237904118931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828583_1020237907452264_9136883616335408010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vM9P0WoRDqUQ7kNvwFBxyhF&_nc_oc=AdqnFX7CLwLZ5NThfVgrvRCKxoiY8aBu_J7vpqIcXyng6ibiSRV3uuQScikEfrjo8zA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiJ-pJW5Mj0w9YP2FGfAm3BRvrVcyABHApUioUO4sVVw&oe=6A9EC5E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR Replay", "keywords": ["video", "record", "replay", "instant", "gameplay"], "long_description": "The best moments always happen without warning. The perfect run after twenty attempts, the win pulled off in the last second, the fail that has you in tears laughing: by the time you think to hit record, it's already over. XR Replay is your instant replay for VR gaming, and solves that problem for good.\n\nOnce running, XR Replay constantly keeps the last few minutes of your screen and your voice ready to save. The moment something's worth keeping, one tap on Save is all it takes: the moment is already there, captured retroactively, with nothing to anticipate ahead of time.\n\nNo more scrubbing through hours of VOD to find 30 interesting seconds. No more storage eaten up by full-session recordings that are 99% useless. XR Replay only captures what actually matters: nothing is ever written to your headset's storage until you tap Save.\n\nYou can modify your replay recording quality, aspect ratio, duration, etc.\n\nXR Replay runs in the background while you play, without interrupting your session. Find your clips straight in your gallery, ready to share.", "short_description": "The best moments always happen without warning. XR Replay is your instant replay for VR gaming: it constantly keeps the last few minutes of gameplay in memory, so you never have to hit Record before it happens. A win pulled off in the last second, a hilarious fail, a perfect run? Save it afterward, with one tap, straight to your gallery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.quest-games-optimizer.com/xr-replay-privacy", "developer_terms_of_service_url": null, "publisher_name": "Anagan79", "support_website_url": null, "website_url": "https://www.quest-games-optimizer.com/other-apps", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "it", "de", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3115621595314640"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status":
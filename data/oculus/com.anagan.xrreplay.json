BsuQXYgCxpIOMNZMJdgIowB2XjCwaItH6u5RBTQWmrs-icdRGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLmsnwGMd_BDGXPvPTymezPxMOXSZB-8lxHeAoqLUCUQ&oe=6A9EACD5"}]}, "id": "1009567238797009", "locale": "en_US", "screenshots": [{"file_name": "com.oculus.vrshell-20260805-231814.png", "id": "1066379732505363", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310734_1066379735838696_2412498022336590276_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77OBP_hlk_EQ7kNvwHtP7GN&_nc_oc=AdqPTZQLuw58F5JE0B2yHRRHvx5QiZscwpU9oAgOpWZoIVTMIJfNzyG2S4XwV8IShlg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLquivr2Kq5V-sFL4CSpt_r0lZDNiv63NSeF-LwfQcGBA&oe=6A9ED9C8"}, {"file_name": "com.oculus.vrshell-20260805-231724.png", "id": "1362339212036201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604338899_1362339215369534_8763538446151711460_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnnT24qXrJEQ7kNvwGaha9V&_nc_oc=AdrVhwUpTCWuy9fmMD3aCSfNXV67HgCN4Z9mzgWPoznC6SYynRCkqeIUrK1TChQyYVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQAci3daxJAJbpnePsddgvL_5AQ3pGK09qAmDcZEhPcw&oe=6A9EB29B"}, {"file_name": "com.oculus.vrshell-20260805-231626.png", "id": "2231009004351622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313074_2231009007684955_2813429347931228785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm2oQevvMD8Q7kNvwHAkBCH&_nc_oc=AdppxtkZqTJy-S4CZ5pdABnrkNdOq9KwQ8Tv_CRsafKZQYSfOZJsrGwTplqjMFZiM1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm1W-gtK0jC6JI0hOv4nejYr9B5kOBB9jT7m-Bt2r2rA&oe=6A9EAE2A"}, {"file_name": "com.oculus.vrshell-20260805-231735.png", "id": "2107759316618457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507832394_2107759323285123_5437206300108078257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwPIv5zxfisQ7kNvwHxUceN&_nc_oc=Adq24DBgkjCtFAjhJdJ7qffSPPNBWwlF3wHBkvpFxlnhE9o_29zSJrccaxwmKTGT-lY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3iLn9ATq-wFPvgVo3WSKVxdbW0MrMki3DUYbGuBLjWQ&oe=6A9EC8F4"}, {"file_name": "com.oculus.vrshell-20260805-231946.png", "id": "1604706341292180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_1604706347958846_8614602098069917174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afDm7QLOgT8Q7kNvwHUWQEt&_nc_oc=AdrNQ71Jr0fX3Qpmr-1qmsS1moxMvcKKD5vbdjgo-HiWLI23iMzavjvJHyUA0vQNdms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaCgH0Hj4gWCbAH640roeJP0buZERVw5BAI07IWq6T2g&oe=6A9ECAF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR Replay", "keywords": ["video", "record", "replay", "instant", "gameplay"], "long_description": "The best moments always happen when you least expect them.\n\nThe perfect run after twenty tries. An out-of-this-world trick shot on the golf course. A fail so good it belongs in the highlight reel.\n\nBy the time you think to hit \"record\"\u2026 it's already over.\n\nThat's exactly the problem XR Replay solves with its instant replay feature.\n\nThe idea is simple: once it's running, XR Replay is always keeping the last few minutes of your screen ready to save. A moment worth keeping? One tap on \"record,\" and it's captured \u2014 after the fact, with nothing to anticipate.\n\nNo more scrubbing through hours of footage to find the 30 seconds worth keeping.\n\nNo more storage wasted on full sessions that are 99% useless.\n\nYour best moments won't get away anymore!\n\nXR Replay runs in the background while you play, without interrupting your session. Find your clips straight in your gallery, ready to share.\n\nYou can run XR Replay actions directly from notifications panel without opening the app for more convenience.", "short_description": "The best moments always happen without warning. XR Replay is your instant replay for VR gaming: it constantly keeps the last few minutes of gameplay in memory, so you never have to hit Record before it happens. A win pulled off in the last second, a hilarious fail, a perfect run? Save it afterward, with one tap, straight to your gallery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.quest-games-optimizer.com/xr-replay-privacy", "developer_terms_of_service_url": null, "publisher_name": "Anagan79", "support_website_url": null, "website_url": "https://www.quest-games-optimizer.com/anagan79-apps", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "it", "de", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3118834074993392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507827918_1023729173988306_7957182827410593406_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtmd_JYlME8Q7kNvwHklPic&_nc_oc=AdqGGuYkxpg4S0NciBsuQXYgCxpIOMNZMJdgIowB2XjCwaItH6u5RBTQWmrs-icdRGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeyzjObnlrg2qUBFQG2ufZ5ZrQ1pA6FkNjJb7G6P1nMA&oe=6A9EACD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XR Replay", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Media", "id": "434961926215971"}
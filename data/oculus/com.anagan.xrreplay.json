-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_824939570714219_2126615900030483703_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FppOWV888iYQ7kNvwGzB3xR&_nc_oc=Adqo552ErwTujHhOL3CDOgfFrYR2SiRcHaSfIKHEXEPNdBz_YlK5Lq8lrgr9BAkF8dc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTubDy4E9R42cibPnSf16EpFh00iSh0P8LOrv2sVmEA_Q&oe=6AFC72E7"}, {"file_name": "com.oculus.vrshell-20261111-112325.png", "id": "2368813133959912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2368813137293245_1830206880462124365_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHa105siINUQ7kNvwHmYIKb&_nc_oc=Adqi3O9_1dujtgZr7Iu1-kYNddK5Tn2ebGakE2kje3BTly25JCXzMO0PfEuFLNas0V8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuR_eAWq30uYJd3fCBiSY9n0pyfVrgBEsgDHXz5_BrNg&oe=6AFC90DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR Replay", "keywords": ["video", "record", "replay", "gameplay", "playtest"], "long_description": "**The best moments always happen when you least expect them. \ud83c\udfaf**\n\nThat perfect run after twenty failed attempts. An unbelievable trick shot on the golf course. A hilarious fail that deserves its own highlight reel. Or that weird bug you just spotted while playtesting.\n\nYou know the moment. You wish you had recorded it\u2026 but it's already gone.\n\n**That's where XR Replay comes in.**\n\nWith its instant replay feature, you never have to miss those moments again.\n\n**\ud83d\udc49 Just say \"Clip that\" to save your replay!**\n\nNo more digging through hours of footage just to find those 30 seconds worth keeping.\n\nNo more wasting storage space recording entire sessions when all you really want are the highlights.\n\nYour best moments deserve to be saved.\n\nXR Replay runs quietly in the background while you play, without interrupting your experience. Your saved clips are waiting for you straight in your gallery, ready to relive and share.\n\n**Play. Enjoy. Say \"Clip that\". Never miss a moment again! \ud83d\ude80**", "short_description": "The best moments always happen without warning. XR Replay is your instant replay for VR gaming: it constantly keeps the last few minutes of gameplay in memory, so you never have to hit Record before it happens. A win pulled off in the last second, a bug you just saw during playtest, a hilarious fail, a perfect run?\n\nSay \"Clip that\" to save your replay, straight to your gallery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.quest-games-optimizer.com/xr-replay-privacy", "developer_terms_of_service_url": null, "publisher_name": "Anagan79", "support_website_url": null, "website_url": "https://www.quest-games-optimizer.com/anagan79-apps", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "it", "de", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3225837490959716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507827918_1023729173988306_7957182827410593406_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gq04hzSgoMoQ7kNvwE5rRoc&_nc_oc=AdrKXKQZqUNSfiW_krCdqQXPasT4CmohGyEYV_XjmKiHX1VSre4uSmdG3BSu8GBxOUk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMVpWwwf_OCeLUo
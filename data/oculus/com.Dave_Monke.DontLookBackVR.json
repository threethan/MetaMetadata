horror", "scary", "dontlookback"], "long_description": "Hello new worker! You have applied for this research job and now you got it! Many reports have been done about this cave since many people who have went in have never returned to the surface. That's why you and your friends have been the lucky ones to explore and research on the cave and any other areas to show the people what is causing these people to go missing. However, you and your friends aren't the only ones wandering in the deep dark areas.. Good Luck!\n\nJohn Hawkings", "short_description": "An underground cave with many places to explore with some strange creatures to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dontlookbackvrsite/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dave_Monke", "support_website_url": "https://sites.google.com/view/dontlookbackvrsite/gydf-page", "website_url": "https://sites.google.com/view/dontlookbackvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24442131242124860"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827063_1321759225972049_251257421290342180_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_
279716883427480_3070585454351400626_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NH3BQXqfBwQ7kNvwFCUZCN&_nc_oc=Ado-mgJgk6Fy6_I7Dd6Ct1DtpAv5XD6x9T1x1naoRvw58iBjfM4lq6qjp67EogNfVrQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRXrrRge9anorqWy4TJPCdGH-xASWTlY9hH7XWc4vT_g&oe=6A8D93B4"}, "display_name": "Don't Look Back VR", "keywords": ["horror", "multiplayer", "vrhorror", "scary", "dontlookback"], "long_description": "Hello new worker! You have applied for this research job and now you got it! Many reports have been done about this cave since many people who have went in have never returned to the surface. That's why you and your friends have been the lucky ones to explore and research on the cave and any other areas to show the people what is causing these people to go missing. However, you and your friends aren't the only ones wandering in the deep dark areas.. Good Luck!\n\nJohn Hawkings", "short_description": "An underground cave with many places to explore with some strange creatures to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dontlookbackvrsite/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dave_Monke", "support_website_url": "https://sites.google.com/view/dontlookbackvrsite/gydf-page", "website_url": "https://sites.google.com/view/dontlookbackvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "s
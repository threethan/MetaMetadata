300541_1838284220428539_7397908014280040554_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jm5wvG7eGykQ7kNvwGGuKM-&_nc_oc=AdrBaonMI3GZD4ZqOZcGELllx94-k6MCxiv1-uf4pEsT-_QJJhejTY1V5k1HO3tzq2A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ77OHupRP86uAY9rN0NAfqG0Cvp8siLBZGO94YGCJo5A&oe=6B09C7BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dlblol7.png", "id": "1279716880094147", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_1279716883427480_3070585454351400626_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzhIpaa0Fj0Q7kNvwH0uRnM&_nc_oc=AdoN01oKbKKBWWisJoqi5avtCjzPgfYRHT_yTv8kYdfXC41Rx7iYau0DciasbuTYHO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRniOuAEs_zaStRA-BoEA3PSHRlTin8Szw5Jx0CoNSpYQ&oe=6B09B8F4"}, "display_name": "Don't Look Back VR", "keywords": ["horror", "multiplayer", "vrhorror", "scary", "dontlookback"], "long_description": "Hello new worker! You have applied for this research job and now you got it! Many reports have been done about this cave since many people who have went in have never returned to the surface. That's why you and your friends have been the lucky ones to explore and research on the cave and any other areas to show the people what is causing these people to go missing. However, you and your friends aren't the only ones wandering in the deep dark areas.. Good Luck!\n\nJohn Hawkings", "short_description": "An underground cave with many places to explore with some strange creatures to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dontlookbackvrsite/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dave_Monke", "support_website_url": "https://sites.google.com/view/dontlookbackvrsite/gydf-page", "website_url": "https://sites.google.com/view/dontlookbackvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME",
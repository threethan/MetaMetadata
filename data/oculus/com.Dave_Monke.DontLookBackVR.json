300541_1838284220428539_7397908014280040554_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgKFesV9MzwQ7kNvwEJxaSX&_nc_oc=AdqDMp07PkzXEMJsyss5a04bAnb751WgKEaN5xasZX4nVUz3lq-NpqgvzCNpV16DPG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8QpFtz3V0kRLG5XlMjHfIzEBEqQwVlkg-jEtLSHUWHA&oe=6B0054FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dlblol7.png", "id": "1279716880094147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618274_1279716883427480_3070585454351400626_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzFcAUg04H4Q7kNvwGH9apy&_nc_oc=Adr1LI32lM1iRDXKcF83p9wMY3NezEIh1w50XS-BFG1fMzRQExzvy48puXF8cqnbYQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvAyCzmmdXJc0X7w4YYDBeoeet9KnGtLa_fwlxwptcWQ&oe=6B007E74"}, "display_name": "Don't Look Back VR", "keywords": ["horror", "multiplayer", "vrhorror", "scary", "dontlookback"], "long_description": "Hello new worker! You have applied for this research job and now you got it! Many reports have been done about this cave since many people who have went in have never returned to the surface. That's why you and your friends have been the lucky ones to explore and research on the cave and any other areas to show the people what is causing these people to go missing. However, you and your friends aren't the only ones wandering in the deep dark areas.. Good Luck!\n\nJohn Hawkings", "short_description": "An underground cave with many places to explore with some strange creatures to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dontlookbackvrsite/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dave_Monke", "support_website_url": "https://sites.google.com/view/dontlookbackvrsite/gydf-page", "website_url": "https://sites.google.com/view/dontlookbackvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME",
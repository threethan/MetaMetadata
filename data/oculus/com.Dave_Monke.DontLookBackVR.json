300541_1838284220428539_7397908014280040554_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOeth2hmR80Q7kNvwEMjtgR&_nc_oc=AdqXJ-z9gIOiK7YXmtHOrpy2cl9Gg2izk96hISVAENWTlQKiP7PyHF_mfg0_V9lnzCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgkF7PUT3icV3_Tc2JSUXxH5TQZt5Ld8K5F55WdApgTQ&oe=6B0DBC3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dlblol7.png", "id": "1279716880094147", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_1279716883427480_3070585454351400626_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qZbL2sfT6YQ7kNvwFJ9cFx&_nc_oc=AdpMfvV7BWv4fyWFMnI1f0kGTzX6v7QzWi1lTktvCuk_uscFF1q0mK37XUof1ALF9Qk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgIZF_7MyJtqeJ5wvP0lqPct7OaWbkT6x6FqynDcqshg&oe=6B0DAD74"}, "display_name": "Don't Look Back VR", "keywords": ["horror", "multiplayer", "vrhorror", "scary", "dontlookback"], "long_description": "Hello new worker! You have applied for this research job and now you got it! Many reports have been done about this cave since many people who have went in have never returned to the surface. That's why you and your friends have been the lucky ones to explore and research on the cave and any other areas to show the people what is causing these people to go missing. However, you and your friends aren't the only ones wandering in the deep dark areas.. Good Luck!\n\nJohn Hawkings", "short_description": "An underground cave with many places to explore with some strange creatures to find."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dontlookbackvrsite/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dave_Monke", "support_website_url": "https://sites.google.com/view/dontlookbackvrsite/gydf-page", "website_url": "https://sites.google.com/view/dontlookbackvrsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME",
DTLDK1-kjrbVlAQ&oe=6AEB4FF1"}, {"file_name": "Immagine (2).png", "id": "999388122706420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310726_999388126039753_3446194538068082909_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVXq4RKZcBsQ7kNvwF-IffD&_nc_oc=Ado5wQ7Evh1Oz-w7X7A7yBwI51ZEXrDq5qOdg8GkPU_bd3k4X_QDmSwRtdxMhzb6YeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCgsvpTcKCV2W2AJzCbci0Py8w9Hv9oefhngmrUSWC8A&oe=6AEB2DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "894725310340597", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312332_894725313673930_3251611153987819493_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nM8hrgviJiUQ7kNvwFyELHN&_nc_oc=AdqkxgKqsMNEGsSh7iFJgm-lYXRwgv3Ean7jHzFO74dPA-VElyE799v2MkwDdqbXJIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDVHcAGAL1oYR2HPxCS-MqFu0qjMfeLZVq7oWzOxtQOg&oe=6AEB482B"}, "display_name": "HoloDentist", "keywords": ["dental", "dentistry", "mixedreality", "remote", "collaboration"], "long_description": "HoloDentist is a Mixed Reality (XR) platform for digital dentistry that enables clinicians, dental technicians, and patients to visualize and interact with 3D dental data, including intraoral scans, CBCT images, and digital treatment plans, within an immersive environment.\n\nThe platform supports treatment planning, patient communication, education, and remote collaboration by allowing multiple users to review and discuss clinical cases in real time, regardless of their location.\n\nA key feature of HoloDentist is its implant planning capability. Users can select implants from a library containing products from multiple manufacturers, position them within the patient's anatomy, evaluate prosthetic-driven placement, and explore different treatment options in 3D. This facilitates case analysis, interdisciplinary collaboration, and communication with patients before treatment.\n\nCompatible with leading XR devices, HoloDentist helps transform complex clinical information into intuitive visual experiences, improving understanding, decision-making, and collaboration across the digital dental workflow.", "short_description": "HoloDentist is a Mixed Reality collaboration platform for digital dentistry that enables dentists, surgeons, dental technicians, and patients to visualize and interact with 3D dental data in real time. It supports treatment planning, case discussions, patient education, and remote collaboration through immersive XR technologies, improving communication, understanding, and clinical decision-making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holo.dentist/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": "https://holo.dentist/", "website_url": "https://holo.dentist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "2423260198183089"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1729828744896994"}, {"status": "PUBLISHED", "id": "2510429606047881"}]}, "baseline_offer": {"id": "1729828744896994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787929320, "status": "PUBLISHED", "id": "1729828744896
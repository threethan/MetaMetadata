_1764215678258455_3030997900341033945_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDXzJws__D4Q7kNvwGUXpXN&_nc_oc=Adrw_wh-D_qtNxpu9Y5nG3XRxAdmEErxsT_BFz9wHC1FhzltmjGsI0hq3fkkFy8bmTw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTEfO26oJ-nDxJnYd4zDhm8u4lp1FzxlRkMUpavlP7Vw&oe=6AA9342D"}, {"file_name": "Immagine (7).png", "id": "2218585338924986", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/673759338_2218585342258319_7710502748642681226_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ_6IsmHpvAQ7kNvwGV3sep&_nc_oc=AdrARyJGd6RkPBc86Qf_iyTYtlnoPAefbx0WG9XunO-5_mL2J-6hkIqSbD5kufxp358&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmNBIhaw1tKE1kR6Nno_Gf_7kT-jBVYRFujDWa0o56MA&oe=6AA94A17"}, {"file_name": "Immagine (3).png", "id": "2187996971996405", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499314351_2187996975329738_8564692124639753078_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IU3UfM8Smd8Q7kNvwE2zyeg&_nc_oc=AdpjzIuY7BkHGfYRreOXqmrJhMwGDBwrjILOW_HRWDVxLE9scgZ9eG1L1knuvgR8Pa8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb6S6D87x31m_0lhIMnR7gKg59y6a2dwe_Q3PyC19Jhg&oe=6AA96558"}, {"file_name": "Immagine (4).png", "id": "1450637386823285", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499312332_1450637390156618_4210530509384063204_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmTEln1s-FMQ7kNvwGyQ84Z&_nc_oc=AdqyY_hbKzn4t2YVmDSikVao02Xwdbdhwox03SnO-4tArUGEOr9wABaxhED7FOa-FE4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm_nB64bcPHY3-E-W8cxGzcqTOzduGqLq_3v5xGAl6DQ&oe=6AA964F1"}, {"file_name": "Immagine (2).png", "id": "999388122706420", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310726_999388126039753_3446194538068082909_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrtFV5IWaWsQ7kNvwEkpTj1&_nc_oc=AdpEYmmJo6YT2F5oY502PHU-zWvL-eWvfHlOVuW9o5Udq_RCFpCompxOcl7T8ewLtaw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLuH9zisLMYuIAxisqiksSWHL1OqmmOjg5aHqNZ9zXew&oe=6AA942DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "894725310340597", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499312332_894725313673930_3251611153987819493_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puhZYLahAH0Q7kNvwHxpivb&_nc_oc=AdpBsjBxw4CtxclDrJjCIrSD1V7AMO2z78NRwsYrjyc3zEH2JrIAntXq94ve_icUsbY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBS7lpGg_I1q0MBgckHXPU-EyOXv6xDxW2ljwbUs2smg&oe=6AA95D2B"}, "display_name": "HoloDentist", "keywords": ["dental", "dentistry", "mixedreality", "remote", "collaboration"], "long_description": "HoloDentist is a Mixed Reality (XR) platform for digital dentistry that enables clinicians, dental technicians, and patients to visualize and interact with 3D dental data, including intraoral scans, CBCT images, and digital treatment plans, within an immersive environment.\n\nThe platform supports treatment planning, patient communication, education, and remote collaboration by allowing multiple users to review and discuss clinical cases in real time, regardless of their location.\n\nA key feature of HoloDentist is its implant planning capability. Users can select implants from a library containing products from multiple manufacturers, position them within the patient's anatomy, evaluate prosthetic-driven placement, and explore different treatment options in 3D. This facilitates case analysis, interdisciplinary collaboration, and communication with patients before treatment.\n\nCompatible with leading XR devices, HoloDentist helps transform complex clinical information into intuitive visual experiences, improving understanding, decision-making, and collaboration across the digital dental workflow.", "short_description": "HoloDentist is a Mixed Reality collaboration platform for digital dentistry that enables dentists, surgeons, dental technicians, and patients to visualize and interact with 3D dental data in real time. It supports treatment planning, case discussions, patient education, and remote collaboration through immersive XR technologies, improving communication, understanding, and clinical decision-making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holo.dentist/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": "https://holo.dentist/", "website_url": "https://holo.dentist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "2423260198183089"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1729828744896994"}, {"status": "PUBLISHED", "id": "2510429606047881"}]}, "baseline_offer": {"id": "1729828744896994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787929320, "status": "PUBLISHED", "id": "1729828744896994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2452541105254998", "version": "0.1.1040"}, "id": "1584065313138606", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF5AJ6qYa20Q7kNvwHSOovV&_nc_oc=AdrTQVDqMtgWBjyVoF70xSsiMxy7tArve5b6Hf9htV_k-2g5usodfaLsgSYW5RsEMfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc5i7DC92yqh-GTsmh3hfaYjF3Vww3AEYIuJR7jJcBlA&oe=6AFC7371"}, {"file_name": "Immagine (2).png", "id": "999388122706420", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310726_999388126039753_3446194538068082909_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xDXqtzUxY0Q7kNvwHPOd4h&_nc_oc=AdrfpCDuo3cXAfykAMqhPNxzfaqD-PaAAl4I9trr-_NjQbsBDqxQU7k3HF7BVWRRETQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfcrqEn5Oklvz6JQHA3fHqwYkNTyj1lFXCEYwU-u5T0A&oe=6AFC899C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "894725310340597", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312332_894725313673930_3251611153987819493_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRxXhRFazswQ7kNvwFdJ1DC&_nc_oc=Adr_4fIX46hrrWaO4o2BGX1q5n6SyZ7Je0CPGsDUXmKEPo3QL-2PATnYA0VzIlZ8AEs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_pW_aX4i018MG7HXUgycfODkMDN4W0awn0pfFMasJLQ&oe=6AFC6BAB"}, "display_name": "HoloDentist", "keywords": ["dental", "dentistry", "mixedreality", "remote", "collaboration"], "long_description": "HoloDentist is a Mixed Reality (XR) platform for digital dentistry that enables clinicians, dental technicians, and patients to visualize and interact with 3D dental data, including intraoral scans, CBCT images, and digital treatment plans, within an immersive environment.\n\nThe platform supports treatment planning, patient communication, education, and remote collaboration by allowing multiple users to review and discuss clinical cases in real time, regardless of their location.\n\nA key feature of HoloDentist is its implant planning capability. Users can select implants from a library containing products from multiple manufacturers, position them within the patient's anatomy, evaluate prosthetic-driven placement, and explore different treatment options in 3D. This facilitates case analysis, interdisciplinary collaboration, and communication with patients before treatment.\n\nCompatible with leading XR devices, HoloDentist helps transform complex clinical information into intuitive visual experiences, improving understanding, decision-making, and collaboration across the digital dental workflow.", "short_description": "HoloDentist is a Mixed Reality collaboration platform for digital dentistry that enables dentists, surgeons, dental technicians, and patients to visualize and interact with 3D dental data in real time. It supports treatment planning, case discussions, patient education, and remote collaboration through immersive XR technologies, improving communication, understanding, and clinical decision-making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holo.dentist/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": "https://holo.dentist/", "website_url": "https://holo.dentist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "2423260198183089"}}]
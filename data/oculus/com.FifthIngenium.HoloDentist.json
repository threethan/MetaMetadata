_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeLPxPX0CHgUCl_bsFOhe7fxy2Zm-POSdtQb9X-w6rEw&oe=6A79D197"}, {"file_name": "B1.png", "id": "1040998262019986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_1040998265353319_4571842338476256776_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7JZmR8S4woQ7kNvwG5UNPo&_nc_oc=Adp17h96ruD16r6amqAUXLvi7HSpH_f4RFb32GOFJfxrprcvpaSX8w7ywrLABWywTQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOjkyGqF-yH9ZEMA_RuICXsHWg5c3uBvdvy7QLGpJvZw&oe=6A79CA15"}, {"file_name": "A2.png", "id": "1834224371285697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314351_1834224374619030_2422006414633702741_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zoi8ag6GB0Q7kNvwFlFhp_&_nc_oc=AdqlOkWT9PlAP1TV2qdu5LNoBCjEBtR1AtdI4reowKqKWiVLiZpSQJk6dBBLdTqQ8s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqVYq9K6BCoI0Q6iL5kbYTz5NafXizx0OGy3R-pFSRrQ&oe=6A79B82D"}, {"file_name": "A1.png", "id": "2129498674669827", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_2129498678003160_4215971202263525044_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG-hAIDRlqcQ7kNvwGRkYzv&_nc_oc=AdqeWNezzJaVL-ZeLu0rnzcb8G4pR2zk_NE4k99sMU2qk6ELxhkuBhBqtf5efanVWmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOyVAmaWnCE39AClqkdBpn0QWZB58qxwifuBFr1LDO0Q&oe=6A79B54E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "894725310340597", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312332_894725313673930_3251611153987819493_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtjCSQbkuvIQ7kNvwEO1Sbm&_nc_oc=AdqnA2SMiooREY6fdgx3UbEQCsCEz8Qs_RfdbQtupHnjVuryqYjpd-X7eoarYh22qok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz7WZm6mLuBbPksCMuUS7x2hi7V2dyZsUrOCv7xFWLLg&oe=6A79E72B"}, "display_name": "HoloDentist", "keywords": ["dental", "dentistry", "mixedreality", "remote", "collaboration"], "long_description": "HoloDentist is a Mixed Reality (XR) platform for digital dentistry that enables clinicians, dental technicians, and patients to visualize and interact with 3D dental data, including intraoral scans, CBCT images, and digital treatment plans, within an immersive environment.\n\nThe platform supports treatment planning, patient communication, education, and remote collaboration by allowing multiple users to review and discuss clinical cases in real time, regardless of their location.\n\nA key feature of HoloDentist is its implant planning capability. Users can select implants from a library containing products from multiple manufacturers, position them within the patient's anatomy, evaluate prosthetic-driven placement, and explore different treatment options in 3D. This facilitates case analysis, interdisciplinary collaboration, and communication with patients before treatment.\n\nCompatible with leading XR devices, HoloDentist helps transform complex clinical information into intuitive visual experiences, improving understanding, decision-making, and collaboration across the digital dental workflow.", "short_description": "HoloDentist is a Mixed Reality collaboration platform for digital dentistry that enables dentists, surgeons, dental technicians, and patients to visualize and interact with 3D dental data in real time. It supports treatment planning, case discussions, patient education, and remote collaboration through immersive XR technologies, improving communication, understanding, and clinical decision-making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holo.dentist/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": "https://holo.dentist/", "website_url": "https://holo.dentist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context
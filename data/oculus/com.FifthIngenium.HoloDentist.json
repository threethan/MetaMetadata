_1764215678258455_3030997900341033945_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzD4mXd_0tAQ7kNvwGabdr-&_nc_oc=Adq981tmI7YpNPdNoMk8yNzjiVbye5jZT2_QxK7txSvr7EyP2hcLVOepoVleuU17_vs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOUYBa8Kj8dPs-MVRpUriKZHW6VyuaU84JsVXBK_cLZw&oe=6AAEB26D"}, {"file_name": "Immagine (7).png", "id": "2218585338924986", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/673759338_2218585342258319_7710502748642681226_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al49aIxDMh0Q7kNvwF-mXeT&_nc_oc=AdohflOxwiL7f0BX1FxlOvCl-NC2LD0XGtLIcA4Q0nKBuBaKpUWS5ILPzRGArH_NoKA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5DQjFaLpZZ7QSVOu9JXqX6nXi1vGiRvABkClGYPuxrA&oe=6AAE9017"}, {"file_name": "Immagine (3).png", "id": "2187996971996405", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499314351_2187996975329738_8564692124639753078_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4TAiTgqZ40Q7kNvwGrulsV&_nc_oc=Adr1j8rZ96ErNimQnhFzKIu-QpKcObOyVo0KiXjXX-6mZipBnps0rFR_gqX4Zjvavx8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPkpCWdF_e9abhgIJKLcMG4dU5VGVO2Qh-bY9oAgTDQg&oe=6AAEAB58"}, {"file_name": "Immagine (4).png", "id": "1450637386823285", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499312332_1450637390156618_4210530509384063204_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2chINu4NZ9IQ7kNvwHoCFnd&_nc_oc=AdrGIdjEgB01wG4sjsIHlkuPSqJqv8zoo43PL6ncDduduLDUYyvLPuuCGG87yUxocI8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7LRJWGr-svQKL-bvMYHj2uNqfmAt4EdKsRJLreQYVHw&oe=6AAEAAF1"}, {"file_name": "Immagine (2).png", "id": "999388122706420", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310726_999388126039753_3446194538068082909_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuE9jyZs5L0Q7kNvwGF6zYj&_nc_oc=Adp-LBQFpOhSC5_i2gEccFr5532nobTwB61seoozrfUecBZIYsUl597XYVL2ACY54pI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwmjIpBcqgW_B6osfkVMYB2DyACx9qdlFuPZM3B6N51A&oe=6AAE88DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "894725310340597", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499312332_894725313673930_3251611153987819493_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhpB6senjm8Q7kNvwEogR4s&_nc_oc=Adodx79zXtnSTc06EsCnNl4dopPCSr7qhHZ8AxddHCb8VDYlvewZKEPl1OqqdPwG4_w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh60LJ_G8TCSPWKucrEndsb_YiBq4f6X-M5RwGssgibg&oe=6AAEA32B"}, "display_name": "HoloDentist", "keywords": ["dental", "dentistry", "mixedreality", "remote", "collaboration"], "long_description": "HoloDentist is a Mixed Reality (XR) platform for digital dentistry that enables clinicians, dental technicians, and patients to visualize and interact with 3D dental data, including intraoral scans, CBCT images, and digital treatment plans, within an immersive environment.\n\nThe platform supports treatment planning, patient communication, education, and remote collaboration by allowing multiple users to review and discuss clinical cases in real time, regardless of their location.\n\nA key feature of HoloDentist is its implant planning capability. Users can select implants from a library containing products from multiple manufacturers, position them within the patient's anatomy, evaluate prosthetic-driven placement, and explore different treatment options in 3D. This facilitates case analysis, interdisciplinary collaboration, and communication with patients before treatment.\n\nCompatible with leading XR devices, HoloDentist helps transform complex clinical information into intuitive visual experiences, improving understanding, decision-making, and collaboration across the digital dental workflow.", "short_description": "HoloDentist is a Mixed Reality collaboration platform for digital dentistry that enables dentists, surgeons, dental technicians, and patients to visualize and interact with 3D dental data in real time. It supports treatment planning, case discussions, patient education, and remote collaboration through immersive XR technologies, improving communication, understanding, and clinical decision-making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holo.dentist/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": "https://holo.dentist/", "website_url": "https://holo.dentist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "2423260198183089"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1729828744896994"}, {"status": "PUBLISHED", "id": "2510429606047881"}]}, "baseline_offer": {"id": "1729828744896994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787929320, "status": "PUBLISHED", "id": "1729828744896994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2452541105254998", "version": "0.1.1040"}, "id": "1584065313138606", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
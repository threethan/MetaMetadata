_1764215678258455_3030997900341033945_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlvOfAh7wvEQ7kNvwHnNc9W&_nc_oc=AdpVRa6hR7Vtba-tDGoFqwJ0itu-ebeoGd99WVU2rYw4EDLQm76vKoj6o1xKPmsZVY0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9kUPG3MCeEyTTVxJI6JGMXRriRxOIEngw3qV3VN8IAQ&oe=6AA3EE2D"}, {"file_name": "Immagine (7).png", "id": "2218585338924986", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/673759338_2218585342258319_7710502748642681226_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBIAILe9_GgQ7kNvwGAKu3d&_nc_oc=AdrFZgzTuEdFhwMeX4P-UPno6ON0qjckd9tsoiZikA0ggLKMzupT95tiYj3hVRm38i0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrMuTWg2Lpi4ki1_EVNvxztedQd2O_OIvHPSbC40BfoA&oe=6AA40417"}, {"file_name": "Immagine (3).png", "id": "2187996971996405", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499314351_2187996975329738_8564692124639753078_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-rKZlAFKjYQ7kNvwGjEQIs&_nc_oc=AdrWaAJiVbaqy1QT7lHkCq-IzvgarkcWdR3oxw7zFC11gTFZmEl2D_YoA0tQG8B4Qm8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcbZ_l1cUwZHDHeHVgsKmvKCMvM9BzLQwJKq7UAE7cVA&oe=6AA41F58"}, {"file_name": "Immagine (4).png", "id": "1450637386823285", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499312332_1450637390156618_4210530509384063204_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9avtXNox5aEQ7kNvwGTPy-v&_nc_oc=AdpHqQM8dsVABlNYJFXw9FuBCQ5684sNxsPi9GwZ3ynTNA4pTwmK726zKigYn6f_TsQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMht-XO4DgIg9QSvYXKQabacubvp0DLVx-DZsTHvW6mw&oe=6AA41EF1"}, {"file_name": "Immagine (2).png", "id": "999388122706420", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310726_999388126039753_3446194538068082909_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLf_qWiamigQ7kNvwFaC43X&_nc_oc=Adp6KzPXOjBmUbkb3Fh4L0YhML1oS9KdZc7LRrK5pW7qThkDaJZgycjT30NH4SeY0qs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyspMEPLjcPzek6SCTEWNxpYjGiVzbFLFvqZ1LadP6xg&oe=6AA3FCDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "894725310340597", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499312332_894725313673930_3251611153987819493_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl60qUj5MwIQ7kNvwFfNjQn&_nc_oc=Adpv7l5Ka8zpQV7l3lNxodr9AJcTUnMn9l9NeQzbkv41zgSFnVu13J-VUdRrtpAc7ko&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI340z9qsLiw8cIB_ZZyfEA3Nbo76RTFD_kRxwMyOgoaw&oe=6AA4172B"}, "display_name": "HoloDentist", "keywords": ["dental", "dentistry", "mixedreality", "remote", "collaboration"], "long_description": "HoloDentist is a Mixed Reality (XR) platform for digital dentistry that enables clinicians, dental technicians, and patients to visualize and interact with 3D dental data, including intraoral scans, CBCT images, and digital treatment plans, within an immersive environment.\n\nThe platform supports treatment planning, patient communication, education, and remote collaboration by allowing multiple users to review and discuss clinical cases in real time, regardless of their location.\n\nA key feature of HoloDentist is its implant planning capability. Users can select implants from a library containing products from multiple manufacturers, position them within the patient's anatomy, evaluate prosthetic-driven placement, and explore different treatment options in 3D. This facilitates case analysis, interdisciplinary collaboration, and communication with patients before treatment.\n\nCompatible with leading XR devices, HoloDentist helps transform complex clinical information into intuitive visual experiences, improving understanding, decision-making, and collaboration across the digital dental workflow.", "short_description": "HoloDentist is a Mixed Reality collaboration platform for digital dentistry that enables dentists, surgeons, dental technicians, and patients to visualize and interact with 3D dental data in real time. It supports treatment planning, case discussions, patient education, and remote collaboration through immersive XR technologies, improving communication, understanding, and clinical decision-making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holo.dentist/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": "https://holo.dentist/", "website_url": "https://holo.dentist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "2423260198183089"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1729828744896994"}, {"status": "PUBLISHED", "id": "2510429606047881"}]}, "baseline_offer": {"id": "1729828744896994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787929320, "status": "PUBLISHED", "id": "1729828744896994"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2452541105254998", "version": "0.1.1040"}, "id": "1584065313138606", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
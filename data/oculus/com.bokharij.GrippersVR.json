AfvsCbrSJkoW3909tA7SOclOJWbLOWQ7n0ppdqVnHNxwPw&oe=699D8BBE"}, "display_name": "Gripper's VR Adventure", "keywords": ["puzzle", "adventure", "family", "grippers", "cute"], "long_description": "Gripper's has jumped to VR with over 40 challenging puzzles. Can you get to the treasure that lies at the end.\n\n# Puzzles include\n- Using blocks to block enemy line of sight\n\n- Shooting enemies and using them to travel over water as a raft\n\n- Teleporting blocks, the player and other objects to solve puzzles\n\n- Collecting all the keys before you can get to the exit of each level\n{1371611584274983}\n# Features Included\n\n- All new VR controls, zoom in and out of the action to see the world from a new angle\n\n- Inspired by a classic video game\n\n- 40+ puzzles to solve\n\n- Cute characters\n\n- Fun story\n\n- Solve puzzles with little hand holding\n\n- Free puzzle updates and modes(more puzzles post launch)\n\n{630419899597491}\n\n", "short_description": "Over 40 challenging puzzles in this VR adventure game. Can you get to the treasure that lies at the end."}]}, "developer_name": "Gripper's Studio", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/gripper-s-adventure-privacy-policy/fbefa633-f11e-49cf-bb2a-092599a58a16/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gripper's Studio", "support_website_url": null, "website_url": "https://blazeultra.wixsite.com/myveryownprojectsab", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
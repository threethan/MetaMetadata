_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0000.png", "id": "515793804886613", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391899_515793808219946_3091221890160970926_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WM-iG_aOokQ7kNvwHmZ4od&_nc_oc=Adp_J62USDYHGU3aWERXZGFXEO-M_384-hBDD5NpWvE5MME71Bk6DDRcBcrBxVAZTn4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIziNFChRVf5a_XUBATX27VJwzPiy8506uHxofL6z0dOw&oe=6AAEAA7E"}, "display_name": "Gripper's VR Adventure", "keywords": ["puzzle", "adventure", "family", "grippers", "cute"], "long_description": "Gripper's has jumped to VR with over 40 challenging puzzles. Can you get to the treasure that lies at the end.\n\n# Puzzles include\n- Using blocks to block enemy line of sight\n\n- Shooting enemies and using them to travel over water as a raft\n\n- Teleporting blocks, the player and other objects to solve puzzles\n\n- Collecting all the keys before you can get to the exit of each level\n{1371611584274983}\n# Features Included\n\n- All new VR controls, zoom in and out of the action to see the world from a new angle\n\n- Inspired by a classic video game\n\n- 40+ puzzles to solve\n\n- Cute characters\n\n- Fun story\n\n- Solve puzzles with little hand holding\n\n- Free puzzle updates and modes(more puzzles post launch)\n\n{630419899597491}\n\n", "short_description": "Over 40 challenging puzzles in this VR adventure game. Can you get to the treasure that lies at the end."}]}, "developer_name": "Gripper's Studio", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/gripper-s-adventure-privacy-policy/fbefa633-f11e-49cf-bb2a-092599a58a16/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gripper's Studio", "support_website_url": null, "website_url": "https://blazeultra.wixsite.com/myveryownprojectsab", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534"
acters\n\n- Fun story\n\n- Solve puzzles with little hand holding\n\n- Free puzzle updates and modes(more puzzles post launch)\n\n{630419899597491}\n\n", "short_description": "Over 40 challenging puzzles in this VR adventure game. Can you get to the treasure that lies at the end."}]}, "developer_name": "Gripper's Studio", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/gripper-s-adventure-privacy-policy/fbefa633-f11e-49cf-bb2a-092599a58a16/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gripper's Studio", "support_website_url": null, "website_url": "https://blazeultra.wixsite.com/myveryownprojectsab", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28562390660073770"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "956562600510189"}, {"status": "PUBLISHED", "id": "2622294851522036"}, {"status": "PUBLISHED", "id": "1962839237754842"}, {"status": "PUBLISHED", "id": "1901561840786770"}, {"status": "PUBLISHED", "id": "4236318683358214"}, {"status": "PUBLISHED", "id": "806261771828712"}, {"status": "PUBLISHED", "id": "612021437853914"}, {"status": "PUBLISHED", "id": "664533429811375"}, {"status": "PUBLISHED", "id": "1604803560236541"}]}, "baseline_offer": {"id": "1604803560236541"}, "is_approved": true, "firstOffer": {"nodes": [{"s
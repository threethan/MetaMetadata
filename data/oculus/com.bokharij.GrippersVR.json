id=6e7a0a&_nc_ohc=aEplDvg6p6EQ7kNvwGUpAsZ&_nc_oc=AdoNVex_xbP6jBFp8kmgVte98BSVDsWv-Vkw6jV7BiPRW6Jm4zpX5y9w3tOX52HjjFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIUeJFIqAsbSGvH0riSzVChqQMctUbo6hhnEznDlqN4w&oe=6B0C6663"}, {"file_name": "com.oculus.vrshell-20250221-132442 (Custom).png", "id": "1341199060413601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392082_1341199063746934_3387686131137004208_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-OnVwt3BjQQ7kNvwGg7whC&_nc_oc=AdrlxiwQ7tmgPhU2DqYmgU61lnJkgIE8ziBc_PKnNMs9iXL2dSSuZ4Zfd1NYWa96JkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBDstdcXO7ZH1O3BiZJzMiuFpR5q40jJtN7oKXmFW_dg&oe=6B0C6386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0000.png", "id": "515793804886613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391899_515793808219946_3091221890160970926_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq0lYP5EsxwQ7kNvwEsHPVm&_nc_oc=AdoX3PpXxs1qSAMZV6Pywf3Ctk2dXwk82szog4LsuPTroAX_xwULZ76r-yAF-xGEKdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJxV0nzW4c3qujJY0B_Ka9La9zzCbRVwr4CM6Vf54VdA&oe=6B0C7D3E"}, "display_name": "Gripper's VR Adventure", "keywords": ["puzzle", "adventure", "family", "grippers", "cute"], "long_description": "Gripper's has jumped to VR with over 40 challenging puzzles. Can you get to the treasure that lies at the end.\n\n# Puzzles include\n- Using blocks to block enemy line of sight\n\n- Shooting enemies and using them to travel over water as a raft\n\n- Teleporting blocks, the player and other objects to solve puzzles\n\n- Collecting all the keys before you can get to the exit of each level\n{1371611584274983}\n# Features Included\n\n- All new VR controls, zoom in and out of the action to see the world from a new angle\n\n- Inspired by a classic video game\n\n- 40+ puzzles to solve\n\n- Cute characters\n\n- Fun story\n\n- Solve puzzles with little hand holding\n\n- Free puzzle updates and modes(more puzzles post launch)\n\n{630419899597491}\n\n", "short_description": "Over 40 challenging puzzles in this VR adventure game. Can you get to the treasure that lies at the end."}]}, "developer_name": "Gripper's Studio", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/gripper-s-adventure-privacy-policy/fbefa633-f11e-49cf-bb2a-092599a58a16/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gripper's Studio", "support_website_url": null, "website_url": "https://blazeultra.wixsite.com/myveryownprojectsab", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28562390660073770"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "956562600510189"}, {"status": "PUBLISHED", "id": "2622294851522036"}, {"status": "PUBLISHED", "id": "1962839237754842"}, {"status": "PUBLISHED", "id": "1901561840786770"}, {"status": "PUBLISHED", "id": "4236318683358214"}, {"status": "PUBLISHED", "id": "806261771828712"}, {"status": "PUBLISHED", "id": "612021437853914"}, {"status": "PUBLISHED", "id": "664533429811375"}, {"status": "PUBLISHED", "id": "1604803560236541"}]}, "baseline_offer": {"id": "1604803560236541"}, "is_approved": true, "firstOffer": {"nodes": [{"s
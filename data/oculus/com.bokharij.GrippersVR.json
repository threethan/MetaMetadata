25/473392100_2486971364968224_2140505482617587482_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crxBQcai0iYQ7kNvwH2Jikm&_nc_oc=AdpkcfUgEe2f2rNjvc1yD8TIwd_yFVIcNRTvK_hWncSYQOAx1gefpFP_9kY-wY-7h7A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QNWuvapFQe8musw9BYmvc5473hhfYdcul32mIL7hUKA&oe=6A2C0F23"}, {"file_name": "com.oculus.vrshell-20250221-132442 (Custom).png", "id": "1341199060413601", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392082_1341199063746934_3387686131137004208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w2aTZw7UBcQ7kNvwFS37vL&_nc_oc=AdoYoFITN3er3m78VpZAz2kOjvEKkAg0TUKEAFqKTZo9BIi5F3k4ibgnUIbQiCrlTEc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jTDTVevsHiG6MYYx4TPZg9VFQZ14r2a5s6_fSDHJqkQ&oe=6A2C0C46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0000.png", "id": "515793804886613", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391899_515793808219946_3091221890160970926_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYI3udC96-UQ7kNvwH3qWIi&_nc_oc=AdosfbHyWmCXoRgS3vOzbI0xPrMCVbt_CnunnEce3Ikwzqhx6rjkmXlVurAhoP6o_Cg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-CSxrtlDjTZ64J4bMZHDFA5Gf4LR3gm5tNyjVuR6bXw&oe=6A2C25FE"}, "display_name": "Gripper's VR Adventure", "keywords": ["puzzle", "adventure", "family", "grippers", "cute"], "long_description": "Gripper's is leaping into VR \u2014 bringing over 40 mind-bending puzzles designed to test your wits and reflexes in a whole new dimension!\n\n\n\nCan you reach the treasure at the end?Each level challenges you to think creatively and make the most of your environment \u2014 all in full VR.\n\n\n\n\ud83e\udde9 Puzzle Highlights:\n\n- Use blocks to block enemy sightlines and sneak your way through\n- Turn defeated enemies into makeshift rafts to cross water\n- Master teleportation mechanics to move yourself, blocks, and other objects\n- Collect every key to unlock the exit and advance\n\n{1371611584274983}\n\n\ud83c\udfae Key Features:\n\n- All-new VR controls let you zoom in and out for a fresh perspective\n- Over 40 handcrafted puzzles, with more on the way post-launch\n- Minimal hand-holding for a rewarding challenge\n- A quirky, fun story with charming characters\n- Inspired by a beloved classic game\n- Free puzzle updates and new modes coming soon\n\nWhether you're a puzzle master or just getting started, Gripper's VR will pull you in with its clever mechanics and imaginative world.\n\n{630419899597491}\n", "short_description": "Over 40 challenging puzzles in this VR adventure game. Can you get to the treasure that lies at the end."}]}, "developer_name": "Gripper's Studio", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/gripper-s-adventure-privacy-policy/fbefa633-f11e-49cf-bb2a-092599a58a16/privacy", "developer_terms_of_service_url": null, "publisher_name": "Gripper's Studio", "support_website_url": null, "website_url": "https://blazeultra.wixsite.com/myveryownprojectsab", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29372642925715202"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392124_1749326382689058_5409986265692806545_n.png?stp=dst-png_s360x360&_nc_cat=11
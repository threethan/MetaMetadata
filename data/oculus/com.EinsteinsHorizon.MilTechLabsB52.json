_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAaRdzEFfVaylUB-xMpwntFpfOBNEcAK-yNmK2ySbC1g&oe=6AEC851D"}, {"file_name": "Screenshot_2026-09-26_19-26-06.png", "id": "1402605201912314", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623131_1402605205245647_4848745327969967215_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USixr3XWaxgQ7kNvwHbY3OQ&_nc_oc=Adq5yp1HS38h0LEGtP2nyB888rf2ZmLer1KGnFAMWoZkYhvKUsqnhCMV4VeTtVYlsm8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUeApdv1L2dhYqpFKzJEQwYlDvXN_KwVahRjf8Ot4ihg&oe=6AEC89AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1.png", "id": "1107763022043050", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619059_1107763025376383_3224428549991818108_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRpowkVmiNEQ7kNvwGif00W&_nc_oc=Adr8rCW13Nghp_ZQPqjQWgjkMLohHSUlJ7Vd7-thpBBnESgZDLYu7vk3m4QbNDWQj3s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsf1TZGL-kIEQ3gExhdxrTzltxAKOEmKRnWUc8Jwj7bQ&oe=6AEC84CA"}, "display_name": "Military Tech Labs: B-52 Stratofortress", "keywords": ["military", "technology", "engineering", "aviation", "b52"], "long_description": "Welcome to Military Tech Labs: B-52, an interactive aerospace learning experience centered on one of the world's most iconic military aircraft: the B-52 Stratofortress.\n\nUnlike a flight simulator, Military Tech Labs: B-52 is a virtual technology museum where curiosity drives exploration. Walk around a full-scale B-52, examine a turbofan engine cutaway, explore the cockpit, and inspect the aircraft's weapons and components up close. Select individual parts to discover how they work, while your personal virtual engineer explains the engineering, physics, design decisions, and operational purpose behind each system, and how every component contributes to the aircraft's overall mission.\n\nExplore the technologies behind this long-range bomber, including aerodynamics, propulsion, aircraft structures, flight controls, navigation, electronic warfare, and conventional and nuclear armament. See airflow through a turbofan engine, interact with major aircraft components, view the aircraft from above, and give a miniature B-52 a test flight. Learn why engineers designed each system the way they did, the trade-offs they balanced, and how these systems work together.\n\nAll educational content has been cross-referenced with publicly available sources for accuracy. The experience is designed primarily for learners 11\u201318 years old, though it can be enjoyed by anyone with an interest in aerospace technology. Images are illustrative and may not represent engineering-level precision.", "short_description": "Step inside an interactive military technology lab built around the legendary B-52 Stratofortress. Explore the aircraft up close, investigate its crew stations, examine a working turbofan engine cutaway, and inspect its weapons. Discover how aerodynamics, propulsion, navigation, and electronic warfare work together to support its mission through hands-on exploration in an immersive hangar environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": "https://www.einsteinshorizon.com/terms-and-conditions", "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
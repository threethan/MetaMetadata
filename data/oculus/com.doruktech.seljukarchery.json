Yic-YufQe28XWSj9dv3qzEeRPYK5YwQ&oe=6AFDAEDE"}, {"file_name": "04_harbour_dusk.png", "id": "1636394368001164", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1636394371334497_3740032479679783539_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnX1ios4qWgQ7kNvwGfBCWR&_nc_oc=AdoJqdRkMbGygGJ2t2-K4yp3VOred3c-ERfK7VlkLaCSpueKy8YUkOeTI1TPtvTuC_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbkpEhYYbzOSqIl__xb4SPnNBE-wcA8B8H2kPti_m_Tg&oe=6AFDD202"}, {"file_name": "05_snowy_pass.png", "id": "2937881669890807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585799753_2937881673224140_408140310080478113_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXKxb5u0ktwQ7kNvwEDTjW-&_nc_oc=Ado0XPvTkK9lO-3GLi-GtAB5ml-fNNXlm2_fE74tdH1WSbpJIF-BY_Mxs194XFJJsGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHHeW6w631hs_YnMr4NalY53qC_kNu8CTME5Z7gXNlHg&oe=6AFDD219"}, {"file_name": "06_cappadocia.png", "id": "2329401304497563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_2329401307830896_2056077645562055378_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxQXyyL4Nq0Q7kNvwFy6WTv&_nc_oc=AdrmC7valujbDIkUkbIe7-qJZ8ehnX1P-VA6j8O2X7g3SCEW1e4bbTWUzxJRHJf9VLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe_IgaQTcFnYJj7RGo2dHEFXnVgq2-BKrTWZWOzjYnmw&oe=6AFDD5BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1878997873092910", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1878997876426243_5042016510771434414_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBow_B2H4kcQ7kNvwEKjsvx&_nc_oc=AdqSyt-MD1r0bivrjIP92LCurjgmcISC4W2NIDksbCqBTg3JiYfgKxj5f2GDIm9-YJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI4n5W2J1XrMC8HCeQZYNztw7-TvVpWuUDGHAPHNLEuQ&oe=6AFDDE76"}, "display_name": "Seljuk Archery VR - Sel\u00e7uklu Ok\u00e7ulu\u011fu", "keywords": ["history", "archery", "traditionalarchery", "targetshooting", "turkisharchery"], "long_description": "Seljuk Archery VR brings traditional Turkish archery to Meta Quest. Draw a short composite bow with your thumb, protected by a zihgir (thumb ring), like the archers of old.\n\nTRAINING PATH: 67 STAGES IN 12 CHAPTERS\n\u2022 Puta, Kabak, Darb, Menzil, Ustal\u0131k: targets, the gourd, piercing, distance and the Master Exam\n\u2022 Master's Path: harder stages opened by the \u0130cazetname\n\u2022 Festival Square: jugs, flying gourds, candles and a duel with the master\n\u2022 Frontier Fort: signal fires, embrasures and the night watch\n\u2022 Caravanserai: jars, plates, glass and pomegranates that shatter\n\u2022 Alaiye Harbour: barrels on the waves, sails, tower bells and a pirate ship\n\u2022 Snowy Pass: icicles, snowmen, ice sculptures and sleds on a frozen lake\n\u2022 Cappadocia: evil-eye beads, a dovecote, rock windows and rolling wheels\nEarn stars, receive your \u0130cazetname and rise from Apprentice to Atabeg.\n\nEVERY DAY\n\u2022 Daily Challenge: a new stage every day, the same for all\n\u2022 Twelve badges on the courtyard wall\n\u2022 Siege, Shooting Range and Bazaar Shoot under Free Practice\n\nFEEL AND LOOK\nHaptics, hit sounds by material, an arrow camera, dusk, starry nights and snow.\n\nEQUIPMENT\nEight bows, seven arrows and eleven kaftans.\n\nFOR EVERY ARCHER\nLeft- or right-handed, seated play, height and draw settings, an optional aim line. Turkish and English.\n\nFOR VENUES AND EVENTS\nEvent Mode for museums, schools and festivals: visitors start at once, today's best hang on the wall and a PIN protects the settings.", "short_description": "Step into a Seljuk-style courtyard and learn traditional Turkish archery with a composite bow and a thumb draw. Hit the puta, shoot the gourd off the pole, pierce boards and send arrows far across the open field. Earn stars on the 67-stage Training Path, from festival games and a frontier fort to a caravanserai, the harbour of Alaiye, a snowy pass and Cappadocia, and receive your \u0130cazetname. A Daily Challenge, badges, Siege, a Shooting Range and Event Mode for venues."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seljukarchery-privacy/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "DorukTech", "support_website_url": null, "website_url": "https://sites.google.com/view/seljukarchery-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1319391681260339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1622912726019623_856647647408522742_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYqa__cf3lQQ7kNvwE0CIz8&_nc_oc=AdojKS6x56LFWLiBrgL8ZWyTfSdA5qC4BnU3ngC2RzQiMiLnqO7vB1fKipLLaG9Iq88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGdKodYwqWTs49KLSKBlIRZ_0PjjBRVIdk-ZHSrNmXMQ&oe=6AFDDD7C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Seljuk Archery VR - Sel\u00e7uklu Ok\u00e7ulu\u011fu", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"t
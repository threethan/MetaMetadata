n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7Hl9AhvTnkQ7kNvwFH9mgz&_nc_oc=AdrsJGT_2XHsMYfcHbd_R1kvHgootwtmcQX1Jy7CW2e49tMtXTG3CDaC2fR_pD3Y78A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlhPKAFLnXk-tTCjvcnKq2oTmVCYC0I1JaXa7-xkVi1A&oe=6AFDC3FF"}, {"file_name": "06_cappadocia.png", "id": "29856574150598508", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604375581_29856574153931841_8542014251767182779_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heIkkcHjPbkQ7kNvwGBcZ9o&_nc_oc=AdpGlmpJFKiGVAofvX5-hUhQeeZzh78sIwY15g2csrrFC5kvz9clYUPcwR247MSXcHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxXL9RdS_SzmlLbjBOdatAjN25P-qhQRofU6EE8CmVPA&oe=6AFDCA19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "2608365686265810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_2608365689599143_8422926958870631352_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiYVcokoSEwQ7kNvwGz2Kt7&_nc_oc=AdqwtL9qTq4ZOtqMYXzwSgI-jyOECDnL4K0TpLC-L1ndn2RDxMKXd4uM5PZu0oDE66o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGN_g4TqTlWL_wGyWo_J8GVLlESIu5iYyKPgPbl3wzRg&oe=6AFDBC3C"}, "display_name": "Seljuk Archery VR - Sel\u00e7uklu Ok\u00e7ulu\u011fu", "keywords": ["ok\u00e7uluk", "sel\u00e7uklu", "sel\u00e7ukluok\u00e7ulu\u011fu", "okveyay", "hedefat\u0131\u015f\u0131"], "long_description": "Sel\u00e7uklu Ok\u00e7ulu\u011fu, geleneksel T\u00fcrk ok\u00e7ulu\u011funu Meta Quest'e ta\u015f\u0131yor. K\u0131sa kompozit T\u00fcrk yay\u0131n\u0131 elinize al\u0131n ve kiri\u015fi eski ok\u00e7ular gibi zihgirli ba\u015fparma\u011f\u0131n\u0131zla \u00e7ekin.\n\nTAL\u0130M YOLU: 12 B\u00d6L\u00dcM, 67 A\u015eAMA\n\u2022 Puta, Kabak, Darb, Menzil, Ustal\u0131k: hedefler, kabak, delme, a\u00e7\u0131k meydan ve Usta S\u0131nav\u0131\n\u2022 Usta Yolu: \u0130cazetname ile a\u00e7\u0131lan zor a\u015famalar\n\u2022 \u015eenlik Meydan\u0131: testi, havada kabak, mumlar ve usta kemanke\u015fle d\u00fcello\n\u2022 U\u00e7 Kalesi: i\u015faret ate\u015fleri, mazgallar ve gece n\u00f6beti\n\u2022 Kervansaray: k\u0131r\u0131l\u0131p sa\u00e7\u0131lan k\u00fcpler, \u00e7ini tabaklar, cam \u015fi\u015feler ve narlar\n\u2022 Al\u00e2iye Liman\u0131: dalgadaki f\u0131\u00e7\u0131lar, yelkenler, kule \u00e7anlar\u0131 ve korsan gemisi\n\u2022 Karl\u0131 Ge\u00e7it: buz sark\u0131tlar\u0131, kardan adamlar, buz heykeller ve donmu\u015f g\u00f6lde k\u0131zaklar\n\u2022 Kapadokya: nazar boncuklar\u0131, g\u00fcvercinlik, kaya pencereleri ve yuvarlanan tekerlekler\nY\u0131ld\u0131z toplay\u0131n, \u0130cazetnamenizi al\u0131n; \u00c7\u0131rakl\u0131ktan Atabey unvan\u0131na y\u00fckselin.\n\nHER G\u00dcN\n\u2022 G\u00fcn\u00fcn G\u00f6revi: her g\u00fcn herkese ayn\u0131 yeni bir a\u015fama\n\u2022 Avlu duvar\u0131nda on iki ni\u015fan\n\u2022 Serbest Talim alt\u0131nda Ku\u015fatma, At\u0131\u015f Alan\u0131 ve \u00c7ar\u015f\u0131 At\u0131\u015f\u0131\n\nH\u0130S VE G\u00d6R\u00dcN\u00dcM\nTitre\u015fim, malzemeye g\u00f6re isabet sesleri, ok kameras\u0131, ak\u015fam, y\u0131ld\u0131zl\u0131 geceler ve kar.\n\nTE\u00c7H\u0130ZAT\nSekiz yay, yedi ok ve on bir kaftan.\n\nHER OK\u00c7U \u0130\u00c7\u0130N\nSolak ya da sa\u011flak, oturarak oynama, boy ve \u00e7eki\u015f boyu ayar\u0131, iste\u011fe ba\u011fl\u0131 ni\u015fan \u00e7izgisi. T\u00fcrk\u00e7e ve \u0130ngilizce.\n\nKURUMLAR VE ETK\u0130NL\u0130KLER \u0130\u00c7\u0130N\nM\u00fcze, okul ve festivaller i\u00e7in Etkinlik Modu: ziyaret\u00e7i hemen ba\u015flar, g\u00fcn\u00fcn en iyileri duvarda g\u00f6r\u00fcn\u00fcr ve ayarlar PIN ile korunur.", "short_description": "Sel\u00e7uklu esintili bir avluya ad\u0131m at\u0131n; kompozit T\u00fcrk yay\u0131 ve ba\u015fparmak \u00e7eki\u015fiyle geleneksel T\u00fcrk ok\u00e7ulu\u011funu \u00f6\u011frenin. Putay\u0131 vurun, dire\u011fin tepesindeki kaba\u011f\u0131 d\u00fc\u015f\u00fcr\u00fcn, levhalar\u0131 delin ve okunuzu a\u00e7\u0131k meydanda menzile g\u00f6nderin. 67 a\u015famal\u0131 Talim Yolu'nda \u015fenlikten u\u00e7 kalesine, kervansaraydan Al\u00e2iye liman\u0131na, karl\u0131 ge\u00e7itten Kapadokya'ya y\u0131ld\u0131z toplay\u0131n; \u0130cazetnamenizi al\u0131n. G\u00fcn\u00fcn G\u00f6revi, ni\u015fanlar, Ku\u015fatma, At\u0131\u015f Alan\u0131 ve kurumlar i\u00e7in Etkinlik Modu."}, {"images": {"nodes": [{"file_name": "Icon_512x512.png", "id": "2228416987889323", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_2228416991222656_8991530152515408054_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPlydmcHoOUQ7kNvwGMCYnG&_nc_oc=Ado2v_wEI3dwzuH7pMo5wShsS19UytOYK33k6yrhtG59u0a_YclkFGsZfgoBRQsW12c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSobNQzBTt7TlZAboZSg0HA8JDEm91nt3DYcnHkGTk0Fw&oe=6AFDC711"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1647537243638660", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1647537256971992_1006404755865380296_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdXv9cR0GxcQ7kNvwHwVWCX&_nc_oc=Adof5e1WB4feoD05yZAKBGaGvHwO7UDtFawB_oF_2VGzKLtndn47GaiQWpeg9bf2Ilc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQjWponSj8gCFI8Wyzk86GSwP8DXohPVcGjaXooOkJhQ&oe=6AFDCCDD"}, {"file_name": "Cover_Square_1440x1440.png", "id": "1622912722686290", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1622912726019623_856647647408522742_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYqa__cf3lQQ7kNvwE0CIz8&_nc_oc=AdojKS6x56LFWLiBrgL8ZWyTfSdA5qC4BnU3ngC2RzQiMiLnqO7vB1fKipLLaG9Iq88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQzCItvDPbzIpEN-TCdbyQ3Xfiad5Z0AqEMvHJFo7
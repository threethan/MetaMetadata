43750093570048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbZqeQHQSV4Q7kNvwEXswwb&_nc_oc=Adq6dr2ZlEmJNll18pvFAZxviQNX6tVXFoKPOjafGEPJ1cGmY0G5s2LvdgLp8C-Rg30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChIKcTs7iQY930m9yGrl-ZeVtTwVpEMs2FwE7rGjkjzg&oe=6A5E116D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyTrek", "keywords": ["VR", "Simulator", "Flight", "Dynamic", "SkyTrek"], "long_description": "SkyTrek is a flight simulator, with a real-world dynamic mapping.\n6 missions will take you to N.Y, London, Rome, San Francisco, Chicago & Toronto. Each map contains different points of interest like \"Statue of liberty\", \"Coliseum\", \"Tower Bridge\" and many more.\nWith GPS Locator you can start your exploration anywhere in the world. Simply use \"My location\" button, and fly by your home and neighborhood. You can also use custom coordinates to fly to any place you wishes to visit.\n*Currently map cover include The U.S, Canada, U.K, Italy, Norway, Sweden, more countries coming soon.", "short_description": "Explore the world by airplane, in a real-world dynamic mapping."}]}, "developer_name": "Amit Chai", "developer_privacy_policy_url": "https://www.wingsgames.com/vr-skytrek-pp", "developer_terms_of_service_url": "https://www.wingsgames.com/terms-of-services", "publisher_name": "Amit Chai", "support_website_url": null, "website_url": "http://www.wingsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_mode
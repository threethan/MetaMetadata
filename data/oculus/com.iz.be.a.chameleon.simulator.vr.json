5771-25/673554902_27893746000248961_2690330528480458029_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBdj-PGO4lsQ7kNvwE5PXOJ&_nc_oc=AdoBVz1Nxw_qn27D_8QWsNsVlVBUa6pYOqWKNdXuEeMBsgQX35KXmBEDzdxPFOW7Aq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPckASbaWgCkxwe9NYMoKgvgLCrjbn-JuriCWr5Ijs3Ig&oe=6AC2666A"}, {"file_name": "Flamethrower.png", "id": "1522980639282067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821117_1522980642615400_3967755387658291089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3pJ1MS7M4oQ7kNvwH-e3AT&_nc_oc=AdpSaNn5YaGtxvlHgm6qpPkAH77az92hhsHS_DzMsgqe8cCmIdlX6-ebqcE6NbbmBoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOawvPMrD2ddqE8ewermUqm3KIWr3vi_NyBzvP9Z7pohg&oe=6AC26229"}, {"file_name": "Weapon Printer.png", "id": "1555047112991646", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595143057_1555047119658312_6015007549655305639_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGNT_DzSv6sQ7kNvwHTYmvA&_nc_oc=Adp0BimYageOtqLqIaM0_AglG-Q_FuV94yrR3M3MBxeZ_3wH5uhybykGtKN6pJaPbUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8lKmlUw32qLAmdxWWT9UHGE0vnMjhknE4KD5ZPX9Lwg&oe=6AC281B8"}, {"file_name": "Change Color.png", "id": "1533889801558302", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619836_1533889804891635_2325437967765957538_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awA5oJKtiXkQ7kNvwFU9J4o&_nc_oc=Adr5-lphT66uQfFr6A2dkU8vgAZRhrhqBkIsE_sEAT30KvEmJglbxLTycrY4EqgtYM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9bgOG7x9O41od9-CkwNq09eJ5LOv6COVZ_vzGIOsSXw&oe=6AC26AAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be A Chameleon", "keywords": [], "long_description": "\ud83e\udd8e Welcome to Be A Chameleon Escape into a vibrant VR sandbox\u2014climb, blend, explore, and create chaos as a chameleon.\n\n**Tongue Chaos**                                     \n\nDiscover the hilarious freedom of interacting with the world using your tongue.           \n{1747692426360027}\n\n**Camouflage Color Shift**\n\nEvery surface becomes part of your disguise. Watch yourself transform in real time, making exploration more immersive and bringing the iconic camouflage ability to life in VR..\n{916234344815829}\n\n**Tongue Grapple Wall Climb**\n\nLaunch your tongue to latch onto high points and pull yourself across the room. Seamlessly transition from grappling into full wall climbing as you move through the environment.\n{1085020794189309}\n\n**Bug Catch Frenzy**\n\nEvery flick of your sticky tongue is a chance to snag another bug. Master quick, accurate catches and enjoy the satisfying rhythm of hunting like a real chameleon.\n{1557287049444644}\n\n**Weapon Printer**\n\nAs a clever chameleon, unlock futuristic gadgets that help you tackle challenges in creative ways. Watch your next tool come to life, then put it to work as you explore and cause playful chaos.\n\n{1494070588647596}\n\n", "short_description": "Be a Chameleon puts you in the scales of a clever chameleon on a mission to escape a bustling pet shop. Swing through the environment with your sticky tongue, climb walls, camouflage by changing colors, solve fun missions, rescue trapped animals, and prank the shop owner and his dog. Explore a playful VR sandbox filled with physics-based interactions, creative movement, and plenty of mischievous adventures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26786967177606467"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1082547234153052"}, {"status": "PUBLISHED", "id": "1498701718730238"}]}, "baseline_offer": {"id": "1498701718730238"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1082547234153052"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28827439010225930", "version": "0.1.7"}, "id": "976925844906523", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26786967120939806", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28827439010225930"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "976925844906523"}]}, "change_log": null, "created_date": 1790239024, "id": "28827439010225930", "version": "0.1.7", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26786967120939806", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28827439010225930"}, "release_status": "REL
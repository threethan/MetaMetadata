GE0vnMjhknE4KD5ZPX9Lwg&oe=6AC281B8"}, {"file_name": "Change Color.png", "id": "1533889801558302", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619836_1533889804891635_2325437967765957538_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awA5oJKtiXkQ7kNvwFU9J4o&_nc_oc=Adr5-lphT66uQfFr6A2dkU8vgAZRhrhqBkIsE_sEAT30KvEmJglbxLTycrY4EqgtYM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9bgOG7x9O41od9-CkwNq09eJ5LOv6COVZ_vzGIOsSXw&oe=6AC26AAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Be A Chameleon Trailer Cover.png", "id": "2172227827053375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620599_2172227830386708_8172166120615808407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eqy-peaVp9EQ7kNvwH81-gA&_nc_oc=Adoawf4FMYWD2OuT2pxuc0N0lARrhhaqipWX670qqG4s4XQBbDEhU_70nM332_yANNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTw489MDA0khOeRhitpoDoyP0w0jntFtJ81-Ct81onUQ&oe=6AC284A9"}, "display_name": "Be A Chameleon", "keywords": ["Sandbox", "Lizard", "Simulator", "Missions", "Adventure"], "long_description": "\ud83e\udd8e Welcome to Be A Chameleon Escape into a vibrant VR sandbox\u2014climb, blend, explore, and create chaos as a chameleon.\n\n**Tongue Chaos**                                     \n\nDiscover the hilarious freedom of interacting with the world using your tongue.           \n{1747692426360027}\n\n**Camouflage Color Shift**\n\nEvery surface becomes part of your disguise. Watch yourself transform in real time, making exploration more immersive and bringing the iconic camouflage ability to life in VR..\n{916234344815829}\n\n**Tongue Grapple Wall Climb**\n\nLaunch your tongue to latch onto high points and pull yourself across the room. Seamlessly transition from grappling into full wall climbing as you move through the environment.\n{1085020794189309}\n\n**Bug Catch Frenzy**\n\nEvery flick of your sticky tongue is a chance to snag another bug. Master quick, accurate catches and enjoy the satisfying rhythm of hunting like a real chameleon.\n{1557287049444644}\n\n**Weapon Printer**\n\nAs a clever chameleon, unlock futuristic gadgets that help you tackle challenges in creative ways. Watch your next tool come to life, then put it to work as you explore and cause playful chaos.\n\n{1494070588647596}\n\n", "short_description": "Be a Chameleon puts you in the scales of a clever chameleon on a mission to escape a bustling pet shop. Swing through the environment with your sticky tongue, climb walls, camouflage by changing colors, solve fun missions, rescue trapped animals, and prank the shop owner and his dog. Explore a playful VR sandbox filled with physics-based interactions, creative movement, and plenty of mischievous adventures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28499972412972593"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_1037550468838763_6369824883551459047_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql7fmtttxwIQ7kNvwED2lhy&_nc_oc=Adp
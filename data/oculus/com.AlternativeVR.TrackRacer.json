-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLT-aNBEFWzBI5CwQofQqvInSKarHJr3h2yel-kLAHKw&oe=6B0075D6"}, {"file_name": "Screenshot_02.png", "id": "826162186139951", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495673_826162189473284_3289377039594023378_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa7amf5898QQ7kNvwFsHCb4&_nc_oc=AdoKkbbPlN0MP4QSZ1wzptVPF-goHL4Eh3Gqd-JYbwGixxSJbr-QKZ4b2fyBl0jtzwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYLonjzevuUqV5TvOmIsYg7YXxuUheZMRv9LXtvdOntg&oe=6B007701"}, {"file_name": "Screenshot_05.png", "id": "312060048652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375769_312060051986056_6106711525101032481_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoQxumGSNYMQ7kNvwFB0XVr&_nc_oc=Adqc_gLX4SxvrMbDQZIxsuGBd0f8TkhcreBNWU1YP_-JFokscNyonW_UqrtdKihhr4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRiII-sKIjmPL5234NdjB-TjXi8yNygDGGsgFf0cLhug&oe=6B007BBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Track Racer", "keywords": [], "long_description": "Step into the world of Track Racer and experience the thrill of classic slot car racing in virtual reality. Showcase your driving skills, control your speed, and become the champion of retro racing tracks! The game offers three different modes, each allowing you to explore various aspects of racing and drifting.\n\nThe first mode is Drift, where you can test your drifting skills with an RC model and achieve the highest score possible. Practice your drifting techniques, find the perfect angles, and perform the most impressive tricks on the track.\n\nThe second mode is Free Ride. This mode allows you to drive your car freely around the track without any time constraints or objectives. It's the perfect opportunity to explore the track, learn its twists and turns, and simply enjoy the ride.\n\nThe final mode is F1 Race, where you race against the clock. Speed through checkpoints as fast as you can, refine your racing lines, and aim to set the best time. This mode offers a true racing challenge, where you can compare your times with others and strive for constant improvement.\n\nTrack Racer thus provides you with the opportunity to experience different styles of racing, from precise drifting to relaxed free driving to intense time trials. Get ready for an unforgettable experience in the world of virtual reality!", "short_description": "Step into the world of Track Racer and experience the thrill of classic slot car racing in virtual reality. Showcase your driving skills, control your speed, and become the champion of retro racing tracks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bartad6.wixsite.com/bartidens/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://bartad6.wixsite.com/bartidens", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7677319405683323"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25673029235685731", "version": "1.
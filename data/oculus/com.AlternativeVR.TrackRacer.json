&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAK427NhFEUQ7kNvwHaRHS0&_nc_oc=Adq-QbJ23DrqrsIid45Wg5983_LfB0przhaGkc5lxm6GBTMEQFj2fhjda4ckQoUbzVg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB_GLyV-8JZHfb3o4HDZ2q-D09MheGSxWvmQEZhY40ZQ&oe=6A4E4441"}, {"file_name": "Screenshot_05.png", "id": "312060048652723", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75375769_312060051986056_6106711525101032481_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMJY3UCTWkUQ7kNvwE4c83V&_nc_oc=Adr3TJHHlyPiFTBvW9LtaCZH9i7iqRag2WLuo0KToBUjASA08DCmxef7mNq6QikQx1s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9hp0YYKXpkQ4zFftP7kqocK7qHU8_MEJUqV-7kLwQLQ&oe=6A4E48FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Track Racer", "keywords": [], "long_description": "Step into the world of Track Racer and experience the thrill of classic slot car racing in virtual reality. Showcase your driving skills, control your speed, and become the champion of retro racing tracks! The game offers three different modes, each allowing you to explore various aspects of racing and drifting.\n\nThe first mode is Drift, where you can test your drifting skills with an RC model and achieve the highest score possible. Practice your drifting techniques, find the perfect angles, and perform the most impressive tricks on the track.\n\nThe second mode is Free Ride. This mode allows you to drive your car freely around the track without any time constraints or objectives. It's the perfect opportunity to explore the track, learn its twists and turns, and simply enjoy the ride.\n\nThe final mode is F1 Race, where you race against the clock. Speed through checkpoints as fast as you can, refine your racing lines, and aim to set the best time. This mode offers a true racing challenge, where you can compare your times with others and strive for constant improvement.\n\nTrack Racer thus provides you with the opportunity to experience different styles of racing, from precise drifting to relaxed free driving to intense time trials. Get ready for an unforgettable experience in the world of virtual reality!", "short_description": "Step into the world of Track Racer and experience the thrill of classic slot car racing in virtual reality. Showcase your driving skills, control your speed, and become the champion of retro racing tracks!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bartad6.wixsite.com/bartidens/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://bartad6.wixsite.com/bartidens", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7677319405683323"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1011644314744565"}, {"status": "PUBLISHED", "id": "2506821389769533"}, {"status": "PUBLISHED", "id": "843226888826767"}, {"status": "PUBLISHED", "id": "1601411807656246"}, {"status": "PUBLISHED", "id": "885440560572658"}, {"status": "PUBLISHED", "id": "1049497943891786"}, {"status": "PUBLISHED", "id": "4228259064164290"}, {"status": "PUBLISHED", "id": "1896671181167875"}, {"status": "PUBLISHED", "id": "1201258208323243"}, {"status": "PUBLISHED", "id": "1147067406855462"}, {"status": "PUBLISHED", "id": "3789636071346530"}, {"status": "PUBLISHE
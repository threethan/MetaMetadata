893868422_5443449510391344119_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofDyVtpzi_UQ7kNvwHVI0p-&_nc_oc=Ado-CsbIuZrkrtdwUOPggijb_ANNX299CszF0py8mFB4j63YMjD-jJH-GjYnJW_Ww9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMDUjuHsE0KNkYUyPy74DDdbq6ThpWsCDrpbURRAMGlA&oe=6A4D0941"}, "display_name": "Ground Up", "keywords": ["Physics", "Multiplayer", "Funny", "New", "Party"], "long_description": "This is a physics-based game that employs a unique locomotion system to provide the player with a fun experience, as well as weapons such as a gun to add some skill. We also have entertaining gadgets such as a grappling gun and much more with a fun and unique combat system. The game is about cowboys who break their legs but don't give up hope of repairing them. The game is mostly built based of the community also remember you are never alone (\u2299\u203f\u2299).\n", "short_description": "A physics based game with unique movement the game is still in alpha but will get updates frequently with new features,physics,weapons,gamemodes and even more again this is still in alpha but can be improved with feedback and the community"}]}, "developer_name": "Rusted", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vT9nHQ46rIlsyQd7GGxBZlgVVzQ27U2oM7FebPFkQsZwt92hHUvuSB9I0eyYvLKHDOsB_qoUXQJTaAE/pub", "developer_terms_of_service_url": null, "publisher_name": "Rusted", "support_website_url": null, "website_url": "https://romanojayden35.wixsite.com/ground-up-vr", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "STRATEGY", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEM
61cgIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqr8k-_ZelwjcF3-5A7sjT_A7v_7x_0A6xNGYrBqdvoQ&oe=6A578BA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starving\u200e Apes", "keywords": ["Gorilla", "Horror", "Lethal"], "long_description": "Trapped in an abandoned facility with flickering lights and empty vending machines, you are one of the last surviving apes. Hunger gnaws at your mind, but you\u2019re not alone. Echoes of others\u2014starving, desperate, and wild\u2014stalk the dark halls. Scavenge for food, avoid the shadows, and uncover what really happened here before the hunger consumes you.\nStarving Apes is a horror-survival VR experience where tension builds with every step. Explore eerie environments, solve puzzles, and stay quiet\u2014because in this place, even the walls are hungry.", "short_description": "Trapped in an abandoned facility with flickering lights and empty vending machines, you are one of the last surviving apes. Hunger gnaws at your mind, but you\u2019re not alone. Echoes of others\u2014starving, desperate, and wild\u2014stalk the dark halls. Scavenge for food, avoid the shadows, and uncover what really happened here before the hunger consumes you.\nStarving Apes is a horror-survival VR experience where tension builds with every step. Explore eerie environments, solve puzzles, and stay quiet\u2014becau"}]}, "developer_name": "ParadoxLLC", "developer_privacy_policy_url": "https://sites.google.com/view/paradox-llc/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DaMonk", "support_website_url": null, "website_url": "https://sites.google.com/view/paradox-llc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED
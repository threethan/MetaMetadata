KTHq_3Z9AglOzag-jjnEPsqZN-uAOpxTwDcIolN9SfV1EJpS5FfYCvYtRajJujo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX0z-KAFv8ijH8gJtiEAUSaT7It1VTQFLOYC2BR4_wDQ&oe=6AF489FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VMX_CoverArt_Landscape_Meta.png", "id": "1451449565859822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_1451449569193155_1329959218428762726_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhNPQxZqSVgQ7kNvwFPYspz&_nc_oc=AdpeJtseykXt73arHQ1o9OZRsDvyHCCn7DPuVbCNEUSaxTbSIDxSdTRLzYzJDyD_iTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSztmvocyGcmY0npkAzGFf3mjyzwB-xK3Da8SIncGSX3g&oe=6AF489AC"}, "display_name": "VMX", "keywords": ["BMX", "Skate", "Riding", "Scooter", "Bike"], "long_description": "# Novel Controls \ud83c\udfae :\nVMX utilizes advanced VR controls and a custom physics system to deliver precise, true-to-life bike handling. Tricks are performed entirely through your physical gestures, creating an authentic and immersive riding experience that mirrors real life.\n\n# Multiplayer \ud83d\udeb2:\nVMX features a multiplayer mode where you can ride with friends, explore maps together, and participate in competitive challenges. Whether you're practicing tricks in freeride sessions or competing for the best scores, multiplayer adds a new dimension to the experience.\n(More about game modes coming soon).\n\n# Customization \ud83c\udfa8 :\nVMX features a highly realistic spray painting system for vehicle customization. Simply grab a spray can in your preferred color and spray away. Beyond its true-to-life handling, the system enables smooth gradients, color blending, and custom pattern creation.\n\nAdditionally, the game features a fictional in-game store where you can spend earned points to unlock a wide range of clothing items. Choose from helmets, goggles, full-face helmets, snapbacks, beanies, and more\u2014with even more gear coming soon!\n\n", "short_description": "VMX offers an authentic riding experience with gesture-based tricks and responsive bike handling. Take on challenges in carefully crafted skateparks and dirt tracks, customize your bike with a realistic spray-painting system, and express your style through a variety of outfits"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vmxgame.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Break Free Interactive", "support_website_url": null, "website_url": "https://www.vmxgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9972621482774842"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1597956485011973"}]}, "baseline_offer": {"id": "1597956485011973"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790959620, "status": "PUBLISHED", "id": "1597956485011973"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28925029087107463", "version": "0.5.0-276"}, "id": "1345414250290947", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id":
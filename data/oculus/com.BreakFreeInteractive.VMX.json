hc=lavuIu7dxMYQ7kNvwEAdKal&_nc_oc=AdpxH2Ctg5PqMgvFQOgj-C9yJKaqqB59rRgcckbC4D767oszdSFruVGOWjWZxpc0p10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBMylBzOjwR4vxi_HBr248xXlXDQWeT-bMgRf49QZiJg&oe=6B007A46"}, {"file_name": "VMX_MetaStore_Screenshot_04.png", "id": "1059871549923819", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622162_1059871553257152_6296512303234017623_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljZaT7eGIf4Q7kNvwGKW3wK&_nc_oc=Adr5-jC2BEgcLRlZZGAsO2stAFhhOYkxTPX1aH1sVCpFVpentsxy_ynf0d84oBIHDuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIj4z2ChXki_6V2RZhIBsdJoQEcr8vxr9nLEc-skck_A&oe=6B00547C"}, {"file_name": "VMX_MetaStore_Screenshot_03.png", "id": "1618269989858113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626808_1618269993191446_2272576239445261167_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FldvkBQeD4UQ7kNvwHaxWtL&_nc_oc=Adr3SCSedLLhfu4siSH934qdDQcm5r9W5rLno1c6Qy9S0okTUHfuGNkgob7SMjJpOHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh5N5VrwYLApRhmXNf4Plof1JqG_T6IoaJj5x2swVNGA&oe=6B007B3D"}, {"file_name": "VMX_MetaStore_Screenshot_05.png", "id": "1412499977462320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593868733_1412499980795653_8709649160471373693_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uye8fScHflIQ7kNvwE9XeZP&_nc_oc=AdqW2tvwn7oNwIY3o8qZj7fdcDKrn_k2l1ciXPIlbE4fiwhLAT_3mO-y8Cec7m0x4C0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnrskV5vENUiqt9BiIACEnbAxlfYVG1udNYc_B5ZaYQw&oe=6B005CB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VMX_CoverArt_Landscape_Meta_03.png", "id": "2665318303818696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300897_2665318307152029_2659761718315764402_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBnqeJtcZh4Q7kNvwG0VvzX&_nc_oc=AdorU0DnUkjdbS5pXuteFQ8EaoLa9uMlRbL303JD6cryGEr986QqKM-VxREbqXeARp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcBfdYPF2yx_9x3cXlGrR5XdetQVqsCsAFGwL78js3dQ&oe=6B005F3C"}, "display_name": "VMX", "keywords": ["BMX", "Scooter", "Bike", "Race", "motox"], "long_description": "Send it your way in **VMX**. Ride BMX, MTB, or scooters, throw down gesture-based tricks, session parks with friends, take on challenges, and customize your ride and style in an **immersive multiplayer VR playground**.\n\n{1612596780526571}\n\nVMX puts the ride in your hands with advanced VR controls and a custom physics system built for precise, true-to-life handling. Pull off tricks entirely through physical gestures, find your line, dial in your technique, and land it your way.\n\n{1036217852717619}\nMake your ride your own with VMX's realistic spray-painting system. Grab a spray can, pick your color, and start painting. Blend colors, create smooth gradients, experiment with patterns, and build a setup that's completely yours.\n\nEarn points as you play and spend them on a growing collection of gear and clothing, including helmets, goggles, full-face helmets, snapbacks, beanies, and more.\n\n{1647822130237456}\nWant a smoother ride? Comfort Mode offers additional options designed to reduce motion discomfort while keeping you in control. Spend more time exploring, practicing tricks, and finding your flow at your own pace.\n\n\n{1053155280756575}\nEverything's better with a crew. Jump into multiplayer to ride with friends, explore maps, session your favorite spots, practice tricks together, or go head-to-head in competitive challenges.\n\nWhether you're chasing the best score or just hanging out and riding, there's always something to do!\n\n{1713395506443068}\nHit the parks your way with BMX, mountain bikes, or scooters, each built around VMX's physical VR controls and custom physics.", "short_description": "VMX offers an authentic riding experience with gesture-based tricks and responsive bike handling. Take on challenges in carefully crafted skateparks and dirt tracks, customize your bike with a realistic spray-painting system, and express your style through a variety of outfits"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vmxgame.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Break Free Interactive", "support_website_url": null, "website_url": "https://www.vmxgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28880751981535174"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1624213475872927_3040342755428125768_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxDauBtfxwsQ7kNvwEhU7Tp&_nc_oc=AdpcYnXZbSsh68L7evob9hY2mVQJjhEEu_KJ7j-cmoPWb6ZkXU0WUKCJqDRNXVAHmvs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv98dzCLcTlPiZoL3MwYeY8By0iTGHmry8LaWWaMGeYA&oe=6B005A00"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VMX", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "67338518
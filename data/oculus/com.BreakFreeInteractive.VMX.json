tent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXYPoKkaBbis71MbWXukUN03vGn3hqeKUMDKNFnLk2jQ&oe=6B0DBD2F"}, {"file_name": "06_Quest.png", "id": "1386493102682896", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300636_1386493106016229_8752432197522087766_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Agzreu0P08Q7kNvwF-ssMw&_nc_oc=AdrZj4EkzMpqn8aPTpIlPmPBflsQmTRKfwf5sp9Cn0CNEEUt7ClJlLl94TiBM161Vrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpyZYLftlHqALmmBDUH7xd4wd7w57xytsKriqOflXxlg&oe=6B0DC524"}, {"file_name": "05_Quest.png", "id": "1682357822406099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295308_1682357825739432_5285069394290524611_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpzVKXLlkc0Q7kNvwGrTHIr&_nc_oc=AdpL5BIKuOq37ZTj0GmTpqO81lf-rhUy88ssgvsZjgYR5iyXiWQsidbTiYonF_y-kTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqPxGe4OuLd-lApO3t3OFSirvx_enS12c-Sdx1W1dp0g&oe=6B0DCEBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VMX_CoverArt_Landscape_Meta.png", "id": "1451449565859822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822581_1451449569193155_1329959218428762726_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PvFSDjaAzUQ7kNvwHTdglf&_nc_oc=AdqNjPuYiChegWvXaiMbs1uqVDYu4qXZ-J-VT_YggkyWECJkKPULTWwUgNFiefFMPX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0FBJMmgoPbhSNENCC1O9pSS3pKte6vBuGeIdng5zngQ&oe=6B0DCE6C"}, "display_name": "VMX", "keywords": ["BMX", "Skate", "Riding", "Scooter", "Bike"], "long_description": "# Novel Controls \ud83c\udfae :\nVMX utilizes advanced VR controls and a custom physics system to deliver precise, true-to-life bike handling. Tricks are performed entirely through your physical gestures, creating an authentic and immersive riding experience that mirrors real life.\n\n# Multiplayer \ud83d\udeb2:\nVMX features a multiplayer mode where you can ride with friends, explore maps together, and participate in competitive challenges. Whether you're practicing tricks in freeride sessions or competing for the best scores, multiplayer adds a new dimension to the experience.\n(More about game modes coming soon).\n\n# Customization \ud83c\udfa8 :\nVMX features a highly realistic spray painting system for vehicle customization. Simply grab a spray can in your preferred color and spray away. Beyond its true-to-life handling, the system enables smooth gradients, color blending, and custom pattern creation.\n\nAdditionally, the game features a fictional in-game store where you can spend earned points to unlock a wide range of clothing items. Choose from helmets, goggles, full-face helmets, snapbacks, beanies, and more\u2014with even more gear coming soon!\n\n", "short_description": "VMX offers an authentic riding experience with gesture-based tricks and responsive bike handling. Take on challenges in carefully crafted skateparks and dirt tracks, customize your bike with a realistic spray-painting system, and express your style through a variety of outfits"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vmxgame.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Break Free Interactive", "support_website_url": null, "website_url": "https://www.vmxgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
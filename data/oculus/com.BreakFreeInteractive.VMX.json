hxhW_-StTaPaFGBqSHv9kFN8tQS-Tcl9B5SH2yoUcB98o7iocf_SnAgCIjFAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGf9PR1Il8stXt-YIl1l9RR52PRA8QE_mmu5oRupPcyg&oe=6B0DA946"}, {"file_name": "VMX_MetaStore_Screenshot_04.png", "id": "1059871549923819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622162_1059871553257152_6296512303234017623_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbooP0xtoCcQ7kNvwEXebVd&_nc_oc=AdrtXxTFGY6tDkTml5KC5IWDQ-BwejAL6uwi_GaHufkkVPqLfw4uSEub4GFRzqz27Vc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQX2ETDxRfo-C26U6NEejABAW2oXvqr3InEjYuG-eIZaw&oe=6B0DBBBC"}, {"file_name": "VMX_MetaStore_Screenshot_03.png", "id": "1618269989858113", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626808_1618269993191446_2272576239445261167_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPJ3rcPeRbsQ7kNvwGBl6QV&_nc_oc=AdokV3QrHHaD7OCWun6NKelxdjbA5rEwfcaMw3Ny7bY0tE6wbGPo3JKV2uhATUluOLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5ydplzIozmhBK_wt-ipHc0DIvSYO9vIcK7GhKxADukw&oe=6B0DAA3D"}, {"file_name": "VMX_MetaStore_Screenshot_05.png", "id": "1412499977462320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593868733_1412499980795653_8709649160471373693_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZu8sX8R1scQ7kNvwE5WveQ&_nc_oc=AdpkDOmo0xnLZa4aQalPb2LSnbZnHPzctlvAw4iRyToDaEGQORi5nv_PPcyjZMqvtAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPO4sptVvXR1y64VZiw3B7Oi9at2n5MhiomE-IDLHjJw&oe=6B0DC3F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VMX_CoverArt_Landscape_Meta_03.png", "id": "2665318303818696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300897_2665318307152029_2659761718315764402_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP0uwtO53joQ7kNvwHzbxMk&_nc_oc=AdqaLbuPTlh1L1K7tCd-GY784Du69xy85sdABrKPnT8D35mxlHvYoyNjyIurs6l0Idk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4Me0mMUf_FzNJIXQYOXtX8eynKYU3TSVNjcsfCp_7yA&oe=6B0DC67C"}, "display_name": "VMX", "keywords": ["BMX", "Scooter", "Bike", "Race", "motox"], "long_description": "Send it your way in **VMX**. Ride BMX, MTB, or scooters, throw down gesture-based tricks, session parks with friends, take on challenges, and customize your ride and style in an **immersive multiplayer VR playground**.\n\n{1612596780526571}\n\nVMX puts the ride in your hands with advanced VR controls and a custom physics system built for precise, true-to-life handling. Pull off tricks entirely through physical gestures, find your line, dial in your technique, and land it your way.\n\n{1036217852717619}\nMake your ride your own with VMX's realistic spray-painting system. Grab a spray can, pick your color, and start painting. Blend colors, create smooth gradients, experiment with patterns, and build a setup that's completely yours.\n\nEarn points as you play and spend them on a growing collection of gear and clothing, including helmets, goggles, full-face helmets, snapbacks, beanies, and more.\n\n{1647822130237456}\nWant a smoother ride? Comfort Mode offers additional options designed to reduce motion discomfort while keeping you in control. Spend more time exploring, practicing tricks, and finding your flow at your own pace.\n\n\n{1053155280756575}\nEverything's better with a crew. Jump into multiplayer to ride with friends, explore maps, session your favorite spots, practice tricks together, or go head-to-head in competitive challenges.\n\nWhether you're chasing the best score or just hanging out and riding, there's always something to do!\n\n{1713395506443068}\nHit the parks your way with BMX, mountain bikes, or scooters, each built around VMX's physical VR controls and custom physics.", "short_description": "VMX offers an authentic riding experience with gesture-based tricks and responsive bike handling. Take on challenges in carefully crafted skateparks and dirt tracks, customize your bike with a realistic spray-painting system, and express your style through a variety of outfits"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vmxgame.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Break Free Interactive", "support_website_url": null, "website_url": "https://www.vmxgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "29273257555617946"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842224_1816922706099558_2838878310982894812_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCZJ_zNE6v8Q7kNvwEpciDZ&_nc_oc=Ado-jN2cYOoK0QvR_uAf13LpNKUELRJiXN7eNNAvudtJ1k9EXN_vjS_6zG1yyM2IxXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqgtYpliJJd45lWqWXIllwNqEB6wUm5OsYh0g487FGFw&oe=6B0DB39D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VMX", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id"
3bXqtsmwpW4_DyIVNSxY7K40XlOc3IFACHPuJt_d-iAc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFoGRNAWnmsJkYQN9wctPdfYo72WmOhIbPM-APLUgdEw&oe=6AD3A746"}, {"file_name": "VMX_MetaStore_Screenshot_04.png", "id": "1059871549923819", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622162_1059871553257152_6296512303234017623_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l02iM-DT0pYQ7kNvwHpz_0b&_nc_oc=Adph2SPzpriPpXH-ZD6OzyaxLrjhxzilk0B-Mdck-8-6btZaYa9ubpHYHN9g5bgoENA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3KnaYexZcAuUqeHPQaf3VUK8S40q8vcFedb0LbHXbDQ&oe=6AD3B9BC"}, {"file_name": "VMX_MetaStore_Screenshot_03.png", "id": "1618269989858113", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499626808_1618269993191446_2272576239445261167_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fexD4yc1CqkQ7kNvwGoFfYi&_nc_oc=Adpk3U7tr6EO03OB3h-ZhumlyU_OaFZJ7ah_5vjwVzFKhzOBQTe4D_hpnQSTknRwNv4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_Kf5UDMQa3D_Mvy1vRLd41pOV7a63vxIgwxIWlXBWqw&oe=6AD3A83D"}, {"file_name": "VMX_MetaStore_Screenshot_05.png", "id": "1412499977462320", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593868733_1412499980795653_8709649160471373693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egmCEHufNScQ7kNvwExrB_4&_nc_oc=AdpiC3E0tE09xuotT8aws4lHS94w5qtB3fBHaiO-POzwOrZb7RMjdQ6x7YYsBOIMZT0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0_ueDgCiD_nwOLr5gK0wNzcWR1kMb453LmwiGT0r0EQ&oe=6AD389B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VMX_CoverArt_Landscape_Meta_03.png", "id": "2665318303818696", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499300897_2665318307152029_2659761718315764402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iHXqHw_wdQQ7kNvwHUu1e8&_nc_oc=Adr5ysJqj2uaitqbRCsaFu0QHLgdpeeMzh8QooVltTydJcdTriTetECbbAd63lz_3DY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIJzgF_l4Cp7eZFJCKGE2BjB6Gog1Jp2XIwhNR6EdDQQ&oe=6AD38C3C"}, "display_name": "VMX", "keywords": ["BMX", "Skate", "Scooter", "Bike", "Race"], "long_description": "Send it your way in **VMX**. Ride BMX, MTB, or scooters, throw down gesture-based tricks, session parks with friends, take on challenges, and customize your ride and style in an **immersive multiplayer VR playground**.\n\n{1612596780526571}\n\nVMX puts the ride in your hands with advanced VR controls and a custom physics system built for precise, true-to-life handling. Pull off tricks entirely through physical gestures, find your line, dial in your technique, and land it your way.\n\n{1036217852717619}\nMake your ride your own with VMX's realistic spray-painting system. Grab a spray can, pick your color, and start painting. Blend colors, create smooth gradients, experiment with patterns, and build a setup that's completely yours.\n\nEarn points as you play and spend them on a growing collection of gear and clothing, including helmets, goggles, full-face helmets, snapbacks, beanies, and more.\n\n{1647822130237456}\nWant a smoother ride? Comfort Mode offers additional options designed to reduce motion discomfort while keeping you in control. Spend more time exploring, practicing tricks, and finding your flow at your own pace.\n\n\n{1053155280756575}\nEverything's better with a crew. Jump into multiplayer to ride with friends, explore maps, session your favorite spots, practice tricks together, or go head-to-head in competitive challenges.\n\nWhether you're chasing the best score or just hanging out and riding, there's always something to do!\n\n{1713395506443068}\nHit the parks your way with BMX, mountain bikes, or scooters, each built around VMX's physical VR controls and custom physics.", "short_description": "VMX offers an authentic riding experience with gesture-based tricks and responsive bike handling. Take on challenges in carefully crafted skateparks and dirt tracks, customize your bike with a realistic spray-painting system, and express your style through a variety of outfits"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vmxgame.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Break Free Interactive", "support_website_url": null, "website_url": "https://www.vmxgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28478911501719226"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820855_2007021706535115_2096069979329334780_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEOVqyfuvcUQ7kNvwG5IhvX&_nc_oc=Adof7nE3vMrT-P-9VS_EmZDacv67h_Aa_UtUSiifeycRF6ymSTMfJ9TM74JmHN1GcVo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd58DsQFvTAjAUw0jghIbvCGNg-c6Imw8SwGitwRi4oA&oe=6AD3998A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VMX", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790959620, "lastRevision": {"nodes": [{"id": "99726
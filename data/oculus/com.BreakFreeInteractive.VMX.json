?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3ac6ht3klYQ7kNvwF9y_1k&_nc_oc=AdoFjgfnr-i9Bqy1b6z9epxQdq3iX8nNGvJVfhxAQlQ-ZurjdGz2Mf_oIr2UIUivGe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdKkhglOfb6DEYiJVRCz5X8Jk0V8McB0OshsWYwridgA&oe=6AE9EAFC"}, {"file_name": "VMX_MetaStore_Screenshot_03.png", "id": "1618269989858113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626808_1618269993191446_2272576239445261167_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Kl18fW_KVQQ7kNvwFXe6-C&_nc_oc=AdoERaA6ER4tmG1y8Qcolql3yDcYSacIdBVQsjeqNtZgFzXUEl91r3dP3fwnXmzQhtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEshFl3UabEhp634ZvGgYJ-_4xnkDXv_RYc2i1wQfcsA&oe=6AEA11BD"}, {"file_name": "VMX_MetaStore_Screenshot_05.png", "id": "1412499977462320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593868733_1412499980795653_8709649160471373693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axaQvMHHLmgQ7kNvwHCeqR7&_nc_oc=AdrfJwitLm7_3q7WE-G-RplPBYlSxOKkVtCt0kDL4yCW9_C_6qQ9IMjrSfss-ZGsasY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_F9kiOfmh3nzpZlk3HIJgTki52pSGkqI6Ba41zR7LRA&oe=6AE9F336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VMX_CoverArt_Landscape_Meta_03.png", "id": "2665318303818696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300897_2665318307152029_2659761718315764402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XnmnFxegeUQ7kNvwGJ17ed&_nc_oc=AdqNvKL8FujpD10HZzEZ-mtMdHEUchkfd-e3FQFvchQz7LZdrb7CzvxRo6pJRtpTm1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvTnVKM3UqFuc8FslKl6kfc5KMP_XaBq8RK2Hj8OyzzQ&oe=6AE9F5BC"}, "display_name": "VMX", "keywords": ["BMX", "Scooter", "Bike", "Race", "motox"], "long_description": "Send it your way in **VMX**. Ride BMX, MTB, or scooters, throw down gesture-based tricks, session parks with friends, take on challenges, and customize your ride and style in an **immersive multiplayer VR playground**.\n\n{1612596780526571}\n\nVMX puts the ride in your hands with advanced VR controls and a custom physics system built for precise, true-to-life handling. Pull off tricks entirely through physical gestures, find your line, dial in your technique, and land it your way.\n\n{1036217852717619}\nMake your ride your own with VMX's realistic spray-painting system. Grab a spray can, pick your color, and start painting. Blend colors, create smooth gradients, experiment with patterns, and build a setup that's completely yours.\n\nEarn points as you play and spend them on a growing collection of gear and clothing, including helmets, goggles, full-face helmets, snapbacks, beanies, and more.\n\n{1647822130237456}\nWant a smoother ride? Comfort Mode offers additional options designed to reduce motion discomfort while keeping you in control. Spend more time exploring, practicing tricks, and finding your flow at your own pace.\n\n\n{1053155280756575}\nEverything's better with a crew. Jump into multiplayer to ride with friends, explore maps, session your favorite spots, practice tricks together, or go head-to-head in competitive challenges.\n\nWhether you're chasing the best score or just hanging out and riding, there's always something to do!\n\n{1713395506443068}\nHit the parks your way with BMX, mountain bikes, or scooters, each built around VMX's physical VR controls and custom physics.", "short_description": "VMX offers an authentic riding experience with gesture-based tricks and responsive bike handling. Take on challenges in carefully crafted skateparks and dirt tracks, customize your bike with a realistic spray-painting system, and express your style through a variety of outfits"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vmxgame.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Break Free Interactive", "support_website_url": null, "website_url": "https://www.vmxgame.com/", "category": null, "comfort_rat
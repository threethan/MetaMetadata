1764981168750010_87575730076084883_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3ARCa0A6LoQ7kNvwEqb3zy&_nc_oc=Adry5N4S7cApx-chcVOzy4hSj0XXoYvMhjpIr2mdpaIOR1jci2a3Y3PplkHRJ_NOq-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTC5PyZAsAlTN22vGlMgG5STIT5ObbCKDvIWxhZIwF4kw&oe=6B0DC23E"}, {"file_name": "02_diner_dyejob.png", "id": "29388179560813922", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_29388179564147255_497397743774986903_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41PqOgtMAnQQ7kNvwHOIy77&_nc_oc=AdpvkU1ABD5tunUB3zzfDbKkencxm6-MROB087EshQdYrBaCfFuxTU6Uilo-AYBi3z0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsWEAm4kUNw8dl-VcKRq2xcVdWKbTuILLFOAxoBN_qmw&oe=6B0DCD9D"}, {"file_name": "04_parlour_tattoo.png", "id": "1758819975194108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_1758819978527441_468107530599339551_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1wkL4lXejAQ7kNvwHCfYxu&_nc_oc=Adq6taUxmC_ZIFmLIPRA4ehIdqE_I1xa67BNRSlO-8raTJB8Mopp3kyux-a6tDdgCYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdOnSt-pLun476RPOPApjqQ2tTIXZQZ94c_EUICkogZw&oe=6B0DCA6D"}, {"file_name": "03_space_flamethrower.png", "id": "4177007939095784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312068_4177007942429117_5334490516699173429_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfJ-G1GhpVwQ7kNvwFQ9Mgk&_nc_oc=AdpjsD-yW7Z7zzw5JtN8uik65JZqo4jAKzL1NNbSGXTojEqc4hH1KDFwhiJjpJYnZsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLmIGN7an-L9oLZ5yKtvy-ZxANYNxxzoh-b9529H4_gA&oe=6B0DADB3"}, {"file_name": "05_july_revenge.png", "id": "1770064680963822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831964_1770064684297155_3305876120213443522_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsTwjM3sHzwQ7kNvwHvoh2r&_nc_oc=AdrCO2JCvnuFcyYOPkPDP-nzRHFJ99w0KqVXTTysZJce07I9kbLOR4f2Kbs7D38c4-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0yj2rCAbO2URXwb55WLgDL_tnpObjxWSX1Z9FMZJ6CQ&oe=6B0DA6C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shave & Style: Barber Shop", "keywords": ["Barber", "Haircut", "Shaving", "Tattoo", "Sandbox"], "long_description": "Step behind the barber\u2019s chair and turn every customer into your next makeover!\n\nPick up your clippers and trimmers to cut hair, shape clean fades, and create your own hairstyles. Use a razor to shave beards and heads, grow hair back to fix mistakes, and experiment with colors and styling tools. Then bring your creativity to the tattoo studio and add designs to your clients.\n\nFrom sharp haircuts and smooth shaves to wild hairstyles and funny transformations, every visit is a chance to try something different. Use your hands, choose your tools, and make each look your own!\n\nFEATURES\n\nRun your own interactive VR barbershop.\n\nCut, trim, shape, and style hair with barber tools.\n\nCreate fades, shave beards, and shave heads.\n\nGrow hair back and correct your cuts.\n\nExperiment with colors and creative hairstyles.\n\nGive customers tattoos in the tattoo studio.\n\nLove barber games, haircut games, hair styling, beard trimming, tattoo games, or fun sandbox experiences? Grab your tools and get styling!", "short_description": "Step into your own VR barber shop! Cut hair, create fresh fades, shave beards and heads, fix bad cuts, style bold looks, and design tattoos in a hands-on grooming game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
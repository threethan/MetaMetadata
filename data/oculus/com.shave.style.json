ttps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303790_1758819978527441_468107530599339551_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B567M6qMljIQ7kNvwGVxFo5&_nc_oc=AdqOxpJ3Q0fXLN784-xbyCcJXK7CEAxH6Mw57QnHmrm9mfyPlqJ7SYAPbcRuiykEpyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2Ggb-x15VHGj6G2gS1V4Gc9DfU-_LMi95zporLVZUEg&oe=6B0C78ED"}, {"file_name": "03_space_flamethrower.png", "id": "4177007939095784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312068_4177007942429117_5334490516699173429_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1BR5g3hHPoQ7kNvwFYpRZL&_nc_oc=AdrgUJ93gHIIQnqkXNUj5k7ZO-cc7GRD2kMUrpMw6G3-AVUvdvOnkMWDvIXPydmwZBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZLZZskFoPu4Z7s-9Q6lEDDZMni--9L-R3NLg3zyJfKQ&oe=6B0C5C33"}, {"file_name": "05_july_revenge.png", "id": "1770064680963822", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_1770064684297155_3305876120213443522_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsTwjM3sHzwQ7kNvwHvETnf&_nc_oc=Adr_fZyKA_zU0t1uST-9Vx4VwveW5zAVoIn7na7IiHL0pFJn_n0hDOEu-N982xd2B7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRODtnEtQu3mEsG7n6ef6RBEL81q9FUvwbqeGPKz7PFjA&oe=6B0C5541"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shave & Style: Barber Shop", "keywords": ["Barber", "Haircut", "Shaving", "Tattoo", "Sandbox"], "long_description": "Step behind the barber\u2019s chair and turn every customer into your next makeover!\n\nPick up your clippers and trimmers to cut hair, shape clean fades, and create your own hairstyles. Use a razor to shave beards and heads, grow hair back to fix mistakes, and experiment with colors and styling tools. Then bring your creativity to the tattoo studio and add designs to your clients.\n\nFrom sharp haircuts and smooth shaves to wild hairstyles and funny transformations, every visit is a chance to try something different. Use your hands, choose your tools, and make each look your own!\n\nFEATURES\n\nRun your own interactive VR barbershop.\n\nCut, trim, shape, and style hair with barber tools.\n\nCreate fades, shave beards, and shave heads.\n\nGrow hair back and correct your cuts.\n\nExperiment with colors and creative hairstyles.\n\nGive customers tattoos in the tattoo studio.\n\nLove barber games, haircut games, hair styling, beard trimming, tattoo games, or fun sandbox experiences? Grab your tools and get styling!", "short_description": "Step into your own VR barber shop! Cut hair, create fresh fades, shave beards and heads, fix bad cuts, style bold looks, and design tattoos in a hands-on grooming game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1425627417306293"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1509219411027742"}]}, "baseline_offer": {"id": "1509219411027742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794318240, "status": "PUBLISHED", "id
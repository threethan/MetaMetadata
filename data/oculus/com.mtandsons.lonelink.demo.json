pRCIjeOt6E7lxmu9gvtqMZUVLmniM0hTU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlaNrK_-2INW466xDY9vdZSYb8G2ZzhmG7JiOKYJUfyA&oe=6AFC8817"}, {"file_name": "demo_screenshot5.png", "id": "2136249760436813", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673573223_2136249767103479_8238550355628941723_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njk-oVo0wEwQ7kNvwEx2nHs&_nc_oc=AdoixrLgfg1CHYmvndxJjigv-MubjTQ3bUTkwfcFc_fupv048FXlgd6gkEJE-FzBg2E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2uWhaY-Lq2w6Ks99Rl-8c5ED5idIl2SqCQPPQIgbHHA&oe=6AFC8848"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demo_trailer_cover_new_2560x1440.png", "id": "1846409176803188", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823366_1846409180136521_4644639207834614372_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPTPlOxFdFMQ7kNvwGdUfgJ&_nc_oc=AdrEkEJX8aR6XxBOrgQjmqNvez_C2O7vuFldHKwZBnNFh11sc0P4O6xq1M0cbL-vEhw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9drxPBi24Dyvi4fB3btiFYkG7YUqvaEMmZoAgF82K9w&oe=6AFC806F"}, "display_name": "Lone Link Demo", "keywords": ["shooter", "arcade", "shmup", "demo", "space"], "long_description": "This is the free demo of Lone Link: the first 12 waves of the full game, with three giant bosses. Love it? The full game has 50 waves, a final flagship and an Endless mode.\n\nLone Link is a VR arcade shooter in the spirit of classic vertical space shooters.\n\nYour ship follows your hand. Move it to dodge the swarm, push it forward and pull it back to dive into the fight or retreat, and let the auto-cannon do the shooting.\n\n\u2022 Two ways to play: ARCADE (your ship takes the hits) and FITNESS (the bullets are aimed at YOU - dodge with your whole body)\n\u2022 Three difficulties that change how weapons are collected and upgraded\n\u2022 Special weapon chips: homing missiles, laser beam, energy wave, reflector shield and a time-slowing field - catch the same chip again to upgrade it and trigger a powerful bonus\n\u2022 Power-ups: weapon levels, shields, rapid fire, extra lives and screen-clearing bombs\n\u2022 Elite enemies, asteroid fields and giant bosses\n\u2022 Left-handed option, local high scores for each mode, original synth-rock soundtrack\n\nStand or sit, stay in the middle of your play space and have fun.", "short_description": "Free demo: steer your ship by hand, dodge fire and fight through the first 12 waves of the VR arcade space shooter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikemor76.github.io/lonelink/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MT and sons", "support_website_url": null, "website_url": "https://mikemor76.github.io/lonelink/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1339374842598210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596149727_1765391061407293_331942197416816952_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KdMLcmccIYQ7kNvwHAmkaA&_nc_oc=Adp0XeAIuBOaZ84IBcs1vd2dE7UXrHoirjO8SUGz2GW2QXzy-0S0urKLQ6wrmMe4szA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuhFJt0fFYHQOp7g4IAqIV2h5ygxEg2imiQFQ
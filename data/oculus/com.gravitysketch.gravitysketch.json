, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781093813, "id": "26201605392849630", "version": "6.6.600", "version_code": 10932, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190170663993103"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781086550, "id": "26200455689631267", "version": "6.6.600", "version_code": 10931, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190170663993103"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "395453121030677"}]}, "change_log": "General\n\n\ud83d\udc1b Bug Fixes\n\n- Fixed permission denied error when taking screenshots in a Room that belongs to a Team you are not a member of but an organization you are a member of.\n\nVR\n\n\ud83d\ude80 Features & Improvements\n\n- Removed the sketch \u201cTurntable\u201d view feature.\n\n\ud83d\udc1b Bug Fixes\n\n- Improved the stability of Spatial Alignments made with QR codes.\n- Fixed \u201cAlign sketch to floor button\u201d not moving the sketch to the floor if it was not aligned with the axis origin.\n- Fixed the \u201cChoose your dominant hand\u201d window on first launch sometimes appearing quite far away from you.\n- Pressing the grab then drawing trigger on the offhand controller as a Viewer no longer moves the Room unpredictably.\n- Fixed controller inputs breaking if a layer is hidden that contains an object you were drawing on in stroke projection mode.\n\nScreen App\n\n\ud83d\ude80 Features & Improvements\n\n- Added the ability to select and import multiple files of the same format simultaneously.\n- Added a Duplicate button to the selection tool menu for objects and stroke points.\n- The warning that you are muted when you may be trying to talk now only appears if there are other users in the Room and is dismissed if you unmute.\n- Reorganised the tabs in the Import menu for users who have been migrated to app.gravitysketch.com\n- You can now see other user\u2019s selected objects and subdivision edit points as highlighted.\n\n\ud83d\udc1b Bug Fixes\n\n- Improved the size of edit mode control points and edges in some scenarios.\n- Fixed bad client request in the Import menu when trying to expand folders while in Shared With Me/Screenshots.\n- Fixed being unable to scroll the viewpoints list if your cursor was over a viewpoint name.\n- Fixed double clicking on the mirrored copy of an object focusing the camera on the original copy of the object.\n- Pressing Esc while grabbing and moving a point in edit mode no longer blocks the object from being reselected.", "created_date": 1781018389, "id": "26190170663993103", "version": "6.6.600", "version_code": 10928, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190170663993103"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1780933569, "id": "26178411291835707", "version": "6.6.600", "version_code": 10922, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190170663993103"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1780927297, "id": "26177551268588376", "version": "6.6.600", "version_code": 10920, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
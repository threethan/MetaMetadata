.com/v/t64.5771-25/38974810_395958141271840_8380706273787641856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI9oz7bbOHIQ7kNvwH6FE61&_nc_oc=AdkT4WU3qPkV7Qr2VNbABEltM86WO8jUDdk1rHt6cUgT19SUfkdTqe6ZglZXwsQCMJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0W9LOAkgHGod7W18_TUPodC5-raPRTIaN3AazlHATVA&oe=699DAE87"}, {"file_name": "migrated_image.png", "id": "497351747835399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974852_1456034124536409_3157047214509916160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bNv-sxWPvsQ7kNvwE-v0wU&_nc_oc=Adme_WLp04O3Mih5P1MU6LRnI6Idpyl-blytqQCfal-Dt7Tt5DPVWzH3cU8jsNp9_iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYpWciw2IsWqb_xLE9KQpCaaC2-qRVbTyZMnaSpLFUpQ&oe=699DAD3C"}, {"file_name": "migrated_image.png", "id": "2322548158054287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031643_484588855438334_7396230491721957376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJYy5UVp-p8Q7kNvwGZuUq1&_nc_oc=AdmHSyskSk8qo7MBBAMucGbGqFA247zxHIb4lh4w7vjbquHdTx1OUDjOLp0DTjDdrCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsD3Cz8P386fBycDAytXmm3UszfyuY6DF6MyXr_5u140A&oe=699D8C8B"}, {"file_name": "migrated_image.png", "id": "212716556752787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982631_2237757543220940_8789395819573805056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BD8qaQ5NhbgQ7kNvwGN-9le&_nc_oc=AdktHnXqtRCsoxve2uaSpse543lfQkn1ewvoaNYg5XHBtPWeh6SconFO9ObaQ3-J2Gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-5Q4TLpxTwsDGheE9gFvEpVnomaLJY4A0T0M3S8aJbw&oe=699D9BCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jEmVKJ", "id": "398078277498348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035457_398078280831681_8250204572966977536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC_oD3HYkZYQ7kNvwHxxdhb&_nc_oc=Adknbqw-KvCdE3NvLtbtbGabTqYFOjY5tsRqfK5LQVlHa5k-nxkdbT03uN8hqgt58y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvad0BMGItTXNgsEBXlOyl1EHFeFMJY3acgGTKB1Tvkyw&oe=699DA84F"}, "display_name": "Gravity Sketch", "keywords": ["3D", "Sketch", "Art", "Modeling", "Design"], "long_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D. Create detailed models, scenes and artwork and export them directly into another design tool, CAD software, game engine, or 3D print platform. Gravity Sketch is the tool for the designer who believes that every stroke counts. Be part of the community riding the new wave of 3D creation!\n\n\u201cThe holy grail of Gravity Sketch is that we are not aware of the software, we are aware of our work\u201d \n       - Bruce Beasley\n       \n- 6 expansive creation tools\n- Image import (.jpg and .png)\n- Export/Import.OBJ with layers and orientation\n- 4 Layers\n- Leap Motion Mode (BETA and Windows only)\n- 4 Environments (Light, Dark, Warehouse, HDR)\n- Basic Workspace Panel \n- Many new features!\n\nArtwork by: Chayi Liao, Nick Baker, Sergei Grenchanyuk, Will Thomas", "short_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D."}]}, "developer_name": "Gravity Sketch", "developer_privacy_policy_url": "https://www.gravitysketch.com/privacy-policy/", "developer_terms_of_service_url": "https://www.gravitysketch.com/eula/", "publisher_name": "Gravity Sketch", "support_website_url": "https://support.gravitysketch.com/", "website_url": "https://www.gravitysketch.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "cont
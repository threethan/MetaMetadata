0491721957376_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxVRvZ61oZMQ7kNvwGn8woe&_nc_oc=AdoDthGTEUCFsFNLIyBu_HJDEaoJVKA3sYBigCLPZrRGHxXqZgUVzUdbu72mb2wDbJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbxmd_N4Ez_LMxc0pdo58qU0R9qClfEObDj3zY1ute5w&oe=6B0DCF8B"}, {"file_name": "migrated_image.png", "id": "212716556752787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982631_2237757543220940_8789395819573805056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLhIQ5W3_t0Q7kNvwEaNhnJ&_nc_oc=AdqWTjzSyhMeLNGbFH7KdV0zQYOhw5K4CuQ1feTNDdarTG8cef3mLDW35MqR3zcabdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcAgDljVUsEZTTLxGPAtJrSyFDimcQdSinBMDFclcOxw&oe=6B0DA68F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jEmVKJ", "id": "398078277498348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035457_398078280831681_8250204572966977536_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGJFjRUni7EQ7kNvwEpWig5&_nc_oc=Adr4zgfTezcVgwoIMbx8Dx0aOhANxhBBhIch-u0-VgE_eCoehiKeBb0S6kJnULy6mac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBsmrR_q_n3ri4L_QcyT2N9XvihBwtObeQusk6QtNQ1g&oe=6B0DB30F"}, "display_name": "Gravity Sketch", "keywords": ["3D", "Sketch", "Art", "Modeling", "Design"], "long_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D. Create detailed models, scenes and artwork and export them directly into another design tool, CAD software, game engine, or 3D print platform. Gravity Sketch is the tool for the designer who believes that every stroke counts. Be part of the community riding the new wave of 3D creation!\n\n\u201cThe holy grail of Gravity Sketch is that we are not aware of the software, we are aware of our work\u201d \n       - Bruce Beasley\n       \n- 6 expansive creation tools\n- Image import (.jpg and .png)\n- Export/Import.OBJ with layers and orientation\n- 4 Layers\n- Leap Motion Mode (BETA and Windows only)\n- 4 Environments (Light, Dark, Warehouse, HDR)\n- Basic Workspace Panel \n- Many new features!\n\nArtwork by: Chayi Liao, Nick Baker, Sergei Grenchanyuk, Will Thomas", "short_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D."}]}, "developer_name": "Gravity Sketch", "developer_privacy_policy_url": "https://www.gravitysketch.com/privacy-policy/", "developer_terms_of_service_url": "https://www.gravitysketch.com/eula/", "publisher_name": "Gravity Sketch", "support_website_url": "https://support.gravitysketch.com/", "website_url": "https://www.gravitysketch.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "355952343011293"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "538010739143891"}, {"status": "PUBLISHED", "id": "442462683357000"}, {"status": "PUBLISHED", "id": "386657321980642"}, {"status": "PUBLISHED", "id": "949889298822780"}, {"status": "PUBLISHED", "id": "249515733245787"}]}, "baseline_offer": {"id": "538010739143891"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741883640, "status": "PUBLISHED", "id": "538010739143891"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28292560590420756", "version": "7.0.001"}, "id": "395453121030677", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28292560590420756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "395453121030677"}]}, "change_log": "General\n\n\ud83d\udc1b Bug Fixes\n\n- Fixed Web Collab failing to import recently created drafts\n- Fixed deleting SubD faces in edit mode breaking object history\n- Better handling of importing models with very high vertex count\n\nVR\n\n\ud83d\udc1b Bug Fixes\n\n- Fixed thicken/offset arrow not snapping to increments when shift trigger is being used\n- Fixed local drafts not generating thumbnails\n- Fixed app crash when exiting draft mid cloud save", "created_date": 1795621016, "id": "28292560590420756", "version": "7.0.001", "version_code": 11872, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28292560590420756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795614614, "id": "28291573963852752", "version": "7.0.001", "version_code": 11871, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28292560590420756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795605612, "id": "28290249760651839", "version": "7.0.001", "version_code": 11870, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28292560590420756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795604386, "id": "28290078564002292", "version": "7.0.001", "version_code": 11869, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28292560590420756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "395453121030677"}]}, "change_log": "**General**\n\n**\ud83d\ude80 Features & Improvements**\n\n- Faster sketch loading, room joining, duplicating and importing, especially in large sketches\n- More reliable collab: smoother reconnects after network drops, and voice chat keeps reconnecting for the whole session\n- Lower memory use and faster startup for Gravity Sketch in the browser\n- Layers now keep the same order for everyone, and any layer can be reordered or grouped, whoever created it\n\n**\ud83d\udc1b Bug Fixes**\n\n- Fixed Web Inspector import getting stuck when importing six or more files at once\n- Fixed surfaces disappearing when an imported IGES file is re-exported as IGES\n- IGES exports now include units, so SolidWorks imports them at the right scale\n- Fixed other users' asset downloads appearing incomplete when the uploader leaves mid-upload and rejoins\n- (Safari only) Fixed Web Inspector voice chat stopping when the tab isn't in focus\n\n**VR**\n\n**\ud83d\ude80 Features & Improvements**\n\n- Added Bezier strokes. Tap the trigger for a sharp point, or hold and drag for a curved one you can adjust with handles\n- In the object info panel, it\u2019s now possible to set an object\u2019s exact position, rotation - including \u201cReset transform\u201d to return it to its original position and rotation.\n- In the edge cut tool, added option to \u201cSeparate on cut\u201d to both cut and split a surface in a single action so it can be pulled apart right away.\n- Callouts: text labels with leader lines\n- One-handed object scaling (thumbstick while grabbing)\n- Added snapping to an object's own origin, including with the gumball\n- Added a brush menu toggle for projecting strokes onto a surface or inside it\n- Images: AI mesh generation and anchoring to the sketch moved into image edit panel\n- Edit mode selection options moved to a tab on the off-hand edit menu\n- \"Show origin axes\" in the object info panel is now a toggle\n- Collab avatar color now shows as a ring on each controller's handle\n- Solo users can now mute their microphone for video recordings\n- Menus and controllers have a refreshed look, with soft shadows under buttons and text\n\n**\ud83d\udc1b Bug Fixes**\n\nFixed the following:\n\n- Object ungrabbable after group editing a cage-editable object + a mannequin and then exiting edit\n- Work notsaved when quitting a new draft whose only layer is hidden\n- Opening a community design or template under an existing file's name overwriting that file without warning\n- Labs collab warning showing multiple times\n- \"Load most recent draft\" ignoring cloud drafts\n- \"Import as Separate Layer(s)\" for images and videos\n- Selected SubD faces only extruding once with the Selection tool\n- Collapsing a free point onto a mirror-locked one breaking the mirror seam on mirrored SubD\n- Mannequin waist points making other points misbehave\n- Projected strokes skipping on curved surfaces\n- Vertical lock breaking after leaving a spatial alignment, and viewpoints moving the sketch during one\n- Gumball orientation setting in free move\n- QR code UI appearing in drafts\n- Viewers getting stuck in the Online Users menu, and reviewers seeing Import in Quick Access\n- Comment threads now read oldest to newest\n- Section view now hides Fine Line strokes\n- Strokes snapping to world axes when the axes are hidden\n- Bounding box lagging behind objects rotated quickly with shift-trigger\n- Snapping to measurement points wobbling\n- The Selection tool cursor is now visible against black objects\n- Sscreenshot menu's depth of field indicators and field of view vibration\n- Lighting controls no longer shown on environments where they have no effect\n- \"Permissions error\" title on join and leave notifications\n- Various text overlaps, oversized icons and layout issues in menus and popups\n\n**Screen App**\n\n**\ud83d\ude80 Features & Improvements**\n\n- Added touch and pen input\n- Added pan and pinch-to-zoom with a Mac trackpad\n- The loading screen now shows joining details, and keeps the sketch hidden until it has loaded\n- Hide export preset toggles that don't apply\n- Files still being decimated now update in the import window\n\n**\ud83d\udc1b Bug Fixes**\n\nFixed the following:\n\n- App crash when joining VR tethered\n- New imports auto-selected and movable with Lock New Layers on\n- Light flicker when dragging the light direction in Day & Night\n- Navigation cube arrows now follow reversed Up and Forward axes\n- Object origin marker not resizing with scale\n- Turning off \"Import as separate layer(s)\" now hides its dependent options\n- Pen stroke weight readout now updates when a stroke is scaled\n- Failure to save a blank viewpoint name, and error when generating with an empty prompt\n- Text overlaps with long user names, file type tags and the pricing popup", "created_date": 1795518734, "id": "28278753715134777", "version": "7.0.000", "version_code": 11867, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
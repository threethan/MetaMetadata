}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jEmVKJ", "id": "398078277498348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035457_398078280831681_8250204572966977536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsM3ZbRZXIgQ7kNvwFiekCy&_nc_oc=AdrzRP35tmzBPKtQRGARUJL2ubna8vbQN9-PKR59k-9HnMJyGe6iIqKcPEwdxy8hyRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P6Fq3YG2h4TVsqTBPOjzF_g7whJ0C0OsNl6eAdRf3TA&oe=69E4D94F"}, "display_name": "Gravity Sketch", "keywords": ["3D", "Sketch", "Art", "Modeling", "Design"], "long_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D. Create detailed models, scenes and artwork and export them directly into another design tool, CAD software, game engine, or 3D print platform. Gravity Sketch is the tool for the designer who believes that every stroke counts. Be part of the community riding the new wave of 3D creation!\n\n\u201cThe holy grail of Gravity Sketch is that we are not aware of the software, we are aware of our work\u201d \n       - Bruce Beasley\n       \n- 6 expansive creation tools\n- Image import (.jpg and .png)\n- Export/Import.OBJ with layers and orientation\n- 4 Layers\n- Leap Motion Mode (BETA and Windows only)\n- 4 Environments (Light, Dark, Warehouse, HDR)\n- Basic Workspace Panel \n- Many new features!\n\nArtwork by: Chayi Liao, Nick Baker, Sergei Grenchanyuk, Will Thomas", "short_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D."}]}, "developer_name": "Gravity Sketch", "developer_privacy_policy_url": "https://www.gravitysketch.com/privacy-policy/", "developer_terms_of_service_url": "https://www.gravitysketch.com/eula/", "publisher_name": "Gravity Sketch", "support_website_url": "https://support.gravitysketch.com/", "website_url": "https://www.gravitysketch.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "355952343011293"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "538010739143891"}, {"status": "PUBLISHED", "id": "442462683357000"}, {"status": "PUBLISHED", "id": "386657321980642"}, {"status": "PUBLISHED", "id": "949889298822780"}, {"status": "PUBLISHED", "id": "249515733245787"}]}, "baseline_offer": {"id": "538010739143891"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741883640, "status": "PUBLISHED", "id": "538010739143891"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25527674783576031", "version": "6.6.200"}, "id": "395453121030677", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25527674783576031"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1776178656, "id": "25529368273406682", "version": "6.6.200", "version_code": 10702, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25527674783576031"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "395453121030677"}]}, "change_log": "General\n\n\ud83d\ude80 Features & Improvements\n\n- IGES imports now correctly interpret trim curves. Please note these are now imported as mesh data rather than NURBS.\n- Reorganised preferences panel into Room/Document Settings for more intuitive options management\n- For upgraded users, added optional package for supporting more file types\n\n\ud83d\udc1b Bug Fixes\n\n- USDZ exports no longer lose image map and base colour\n\nVR\n\n\ud83d\ude80 Features & Improvements\n\n- AR Collab has evolved into Spatial Alignment! Lock the Virtual Room to your Physical Space so you can move freely and virtual objects stay fixed; determine the position and size of the virtual room in your physical space; save the spatial anchors, offset and scale in the virtual room itself - no need to set up again with every session.\n- Improved visual quality of splines when viewed at a distance\n- Display mesh quality when model quality options are available\n- Environment panel now has thumbnail previews for HDRs\n- More edit modes available when multi-editing compatible objects\n\n\ud83d\udc1b Bug Fixes\n\n- File path for local saves is now less truncated and more legible\n- Disabled now incompatible Meta Avatars as they were also causing issues with native GS avatars\n- Unified \u201cfile with this name already exists\u201d flow for older and newer files\n- Added login screen when attempting to export whilst unauthenticated\n- Fixed drawing sometimes being interrupted by putting down non-drawing controller\n- Fixed mesh preview sometimes not showing when model quality options are available\n- Fixed autosaves being corrupted if the text tool is active on force app quit\n- Fixed lobby UI missing/overlapping in certain conditions\n- Solved UI conflicts when user is part of different teams with the same name\n- Community designs are now opened correctly as a draft\n- Unified room renaming error messages when file with same name already exists", "created_date": 1776165750, "id": "25527674783576031", "version": "6.6.200", "version_code": 10700, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25527674783576031"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1776163308, "id": "25527369623606547", "version": "6.6.200", "version_code": 10699, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25527674783576031"}, "release_statu
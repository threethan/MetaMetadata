}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jEmVKJ", "id": "398078277498348", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035457_398078280831681_8250204572966977536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EvUYvvcYOcQ7kNvwGV993u&_nc_oc=AdoIKvNUBhBooSOv3jplbQ1U421TFB28SK8YQ3O_uwo_-pZGhEG0cIqfqm6g4lTAYjY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyNMPKvM0LwfQR4fk5cS3byRmq74yvenfiGhtwC7srZA&oe=6A8AF64F"}, "display_name": "Gravity Sketch", "keywords": ["3D", "Sketch", "Art", "Modeling", "Design"], "long_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D. Create detailed models, scenes and artwork and export them directly into another design tool, CAD software, game engine, or 3D print platform. Gravity Sketch is the tool for the designer who believes that every stroke counts. Be part of the community riding the new wave of 3D creation!\n\n\u201cThe holy grail of Gravity Sketch is that we are not aware of the software, we are aware of our work\u201d \n       - Bruce Beasley\n       \n- 6 expansive creation tools\n- Image import (.jpg and .png)\n- Export/Import.OBJ with layers and orientation\n- 4 Layers\n- Leap Motion Mode (BETA and Windows only)\n- 4 Environments (Light, Dark, Warehouse, HDR)\n- Basic Workspace Panel \n- Many new features!\n\nArtwork by: Chayi Liao, Nick Baker, Sergei Grenchanyuk, Will Thomas", "short_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D."}]}, "developer_name": "Gravity Sketch", "developer_privacy_policy_url": "https://www.gravitysketch.com/privacy-policy/", "developer_terms_of_service_url": "https://www.gravitysketch.com/eula/", "publisher_name": "Gravity Sketch", "support_website_url": "https://support.gravitysketch.com/", "website_url": "https://www.gravitysketch.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "355952343011293"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "538010739143891"}, {"status": "PUBLISHED", "id": "442462683357000"}, {"status": "PUBLISHED", "id": "386657321980642"}, {"status": "PUBLISHED", "id": "949889298822780"}, {"status": "PUBLISHED", "id": "249515733245787"}]}, "baseline_offer": {"id": "538010739143891"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741883640, "status": "PUBLISHED", "id": "538010739143891"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26990116813998480", "version": "6.7.000"}, "id": "395453121030677", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26990116813998480"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "395453121030677"}]}, "change_log": "## General\n\n### \ud83d\udc1b Bug Fixes\n\n- Fixed some models breaking when imported as subd data\n- Collab - other users\u2019 selection is now visible when they are in edit mode\n- Fixed some objects wrongly given reflective material on import\n- Fixed bad UI behaviour on importing some scanned models\n\n## VR\n\n### \ud83d\ude80 Features & Improvements\n\n- New primitive types available and greater control over primitives creation\n- Added quad-based SubD conversion to previously not convertible primitives\n- Added a toggle into Settings for organization users to choose whether the **Lobby** defaults to **Draft** or **Room** creation.\n- Object local origin and axes now shown in properties panel\n- Spatial Alignment improvements: guided QR code scanning flow; multi-QR alignment support; better UI visuals for QR codes; improved persistence of QR code position via local anchors; reduced risk of skew by using headset-detected \u201cup\u201d direction even for QR code alignments\n\n### \ud83d\udc1b Bug Fixes\n\n- Fixed subd edge cut tool sometimes placing points without trigger input\n- Fixed objects becoming uneditable if grabbed at the same time as exiting edit mode\n- Deleted and undeleted subd points now respawn in their original position\n- Object properties panel no longer duplicates on entering edit mode whilst panel is floating\n- Fixed background errors on baking and unbaking some subd objects\n- Fixed background errors on opening video player in separate sketch after completing basic skills tutorial\n- Colour changes on large numbers of objects no longer rejected\n- Fixed certain operations creating invalid subd shapes\n- Fixed background error for users entering  a sketch whilst low on storage\n- Short subd cylinders no longer locked to 1 horizontal loop on custom subd creationg\n- Leaving spatial alignment now correctly exits edit mode\n- Error message now appears when trying to use spatial alignments after denying spatial data permissions\n- Fixed inconsistencies when one user is disconnected during QR code spatial alignment creation\n- Fixed edit point colour during creation of white custom subd primitive aganist black background", "created_date": 1787060935, "id": "26990116813998480", "version": "6.7.000", "version_code": 11221, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26990116813998480"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787059576, "id": "26989906707352824", "version": "6.7.000", "version_code": 11222, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26990116813998480"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787056557, "id": "26989443610732467", "version": "6.7.000", "version_code": 11220, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "_
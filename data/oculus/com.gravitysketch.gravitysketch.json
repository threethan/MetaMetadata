}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jEmVKJ", "id": "398078277498348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035457_398078280831681_8250204572966977536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rZcLvPDCbIQ7kNvwFRpeQz&_nc_oc=Adr9_uJW2Z46TT4Yv9ZXb7ULI8Mz1b0ohX_3qKQvpaqTJEYXfml5Q0P5vr8JydfNlys&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SnKePXeb8CcnAwrxHtFNvNfJkC_fn1wVSdtmquwlEhA&oe=6A41224F"}, "display_name": "Gravity Sketch", "keywords": ["3D", "Sketch", "Art", "Modeling", "Design"], "long_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D. Create detailed models, scenes and artwork and export them directly into another design tool, CAD software, game engine, or 3D print platform. Gravity Sketch is the tool for the designer who believes that every stroke counts. Be part of the community riding the new wave of 3D creation!\n\n\u201cThe holy grail of Gravity Sketch is that we are not aware of the software, we are aware of our work\u201d \n       - Bruce Beasley\n       \n- 6 expansive creation tools\n- Image import (.jpg and .png)\n- Export/Import.OBJ with layers and orientation\n- 4 Layers\n- Leap Motion Mode (BETA and Windows only)\n- 4 Environments (Light, Dark, Warehouse, HDR)\n- Basic Workspace Panel \n- Many new features!\n\nArtwork by: Chayi Liao, Nick Baker, Sergei Grenchanyuk, Will Thomas", "short_description": "Gravity Sketch is an intuitive 3D VR creation tool empowering you to unleash your creativity. Replicating the natural experience of creating with your hands, you can now fully express your ideas in real-time, from initial conception, straight into 3D."}]}, "developer_name": "Gravity Sketch", "developer_privacy_policy_url": "https://www.gravitysketch.com/privacy-policy/", "developer_terms_of_service_url": "https://www.gravitysketch.com/eula/", "publisher_name": "Gravity Sketch", "support_website_url": "https://support.gravitysketch.com/", "website_url": "https://www.gravitysketch.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "355952343011293"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "538010739143891"}, {"status": "PUBLISHED", "id": "442462683357000"}, {"status": "PUBLISHED", "id": "386657321980642"}, {"status": "PUBLISHED", "id": "949889298822780"}, {"status": "PUBLISHED", "id": "249515733245787"}]}, "baseline_offer": {"id": "538010739143891"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741883640, "status": "PUBLISHED", "id": "538010739143891"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26360434223633412", "version": "6.6.700"}, "id": "395453121030677", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26360434223633412"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "395453121030677"}]}, "change_log": "VR\n\n\ud83d\ude80 Features & Improvements\n\n- You can now click in the thumbstick on the drawing-hand controller to alternate the thumbstick between changing brush size or changing brush type.\n- Disabled Minimap navigation feature.\n- Updated icons for Teams.\n- You can now see other users\u2019 Online Users menus in Rooms.\n\n\ud83d\udc1b Bug Fixes\n\n- Layer groups are now taken into account when determining what your active layer should be on loading a sketch.\n- Fixed welcome tutorial sometimes spawning quite far away from you.\n- Fixed incorrect storage calculation in Files.\n- Fixed a menu overlap when logging in with SSO.\n- You can no longer snap points that are on the mirror to nearby points of other objects that are not on that mirror axis.\n- Reviewers can no longer interact with objects on all layers using the Selection, Color and Flip Normals tools.\n- Fixed adding many edge loops very close to each other sometimes causing a subdivision error and causing a surface to temporarily disappear.\n\nScreen App\n\n\ud83d\ude80 Features & Improvements\n\n- You can now import multiple files of a different format at the same time.\n- Hid the central cube from the gumball that VR users use to reposition it, and hid rotation and scale parts of the gumball when selecting a single point.\n- Added a Section View tool.\n- You can now drag points, edges and faces in edit mode directly without selecting them first.\n- You can now use two selection modes: Selection (V) and Direct Selection (A).  Selection will select an object and show the gumball whereas Direct Selection will immediately enter edit mode on an object.\n- Removed restriction around using the Selection tool while at a viewpoint.\n- Clicking on empty space while in edit mode now exits edit mode.\n- Added a Vertical Lock option, which when disabled allows you to rotate the camera 360 degrees on the pitch axis.\n- Added Ctrl/Cmd+Shift+Z as an alternative shortcut for redo.\n- Added keyboard shortcuts in various button tooltips.\n- Improved mouse panning so that on-screen content should move consistently about the same distance as your mouse cursor.\n\n\ud83d\udc1b Bug Fixes\n\n- Reduced the number of conflicts between the app and web browser\u2019s keyboard shortcuts.\n- Improved the appearance of the Cmd symbol.\n- Fixed highlights of sketch objects being stretched horizontally at most aspect ratios.\n- Added missing \u201cFullscreen\u201d button in browser version.\n- Closing the export save location modal after changing the location no longer appears to save the change.\n- You can no longer select and edit annotations with the Selection tool.\n- Fixed box selecting sometimes moving the camera slightly.\n- Fixed some models importing with inverted normals on web.", "created_date": 1782223131, "id": "26360434223633412", "version": "6.6.700", "version_code": 10992, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26360434223633412"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782219820, "id": "26359957193681115", "version": "6.6.700", "version_code": 10991, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Ap
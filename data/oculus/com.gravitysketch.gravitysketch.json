Binary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24994097456933769"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771513136, "id": "25003693129307535", "version": "6.6.001", "version_code": 10510, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24994097456933769"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "395453121030677"}]}, "change_log": "\ud83d\ude80 Features and improvements\n\n- Restored detailed cloud diagnostics for better issue tracking", "created_date": 1771420623, "id": "24994097456933769", "version": "6.6.001", "version_code": 10508, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24994097456933769"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "395453121030677"}]}, "change_log": "VR\n\n\ud83d\ude80 Features & Improvements\n\n- Added customizable floating grid\n- Added XYZ readout for measurements and reference point objects\n- Decluttered lobby (3D models & plinths removed)\n- For models that have different levels of rendering detail in app, this can now be locked\n- (Quest and Vive headsets only) Smoother performance when working with highlighted objects\n- Expanded rigged model import compatibility\n- Banner announcing upcoming GS migration to GS website for eligible users\n\n\ud83d\udc1b Bug Fixes\n\n- Fixed hidden layers still being included in USDZ, GLB, Blend exports when using layer solo mode\n- Fixed autosaves becoming corrupted when created whilst the text tool is open\n- Fixed desktop UI showing join room/enter room password messages when performing certain other operations\n- Fixed lobby lighting being affected by last sketch session, resulting in dark environment objects\n- Fixed material swatches being hidden by section view and passthrough occlusion\n- Fixed issues opening specific sketch files\n- Fixed HDR environments sometimes not loading in sketches\n- Fixed sticky grab trigger when switching between left-handed and right-handed mode\n- Improved performance when highlighting objects\n- (Standalone only) Fixed passthrough becoming unavailable after certain operations with web browser\n- (Standalone only) Fixed thumbnails not being created for new drafts\n\nScreen Collab\n\n\ud83d\udc1b Bug Fixes\n\n- Fixed duplicated extensions in exported file names", "created_date": 1771325417, "id": "24984118834598298", "version": "6.6.000", "version_code": 10504, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1587090851394426", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24994097456933769"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771243151, "id": "24975851485425033", "version": "6.6.000", "version_code": 10501, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
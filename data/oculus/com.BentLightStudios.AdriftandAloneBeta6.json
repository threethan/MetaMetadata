/scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974805_2032210843738189_1312364885501280256_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyPRVv7x0VAQ7kNvwHunbiE&_nc_oc=AdoIo0xSTGAMDgAnTyqU0-gnkxthTniNlCjxzUQmXTWeij3wvAnlFlwxQ1Puq4_eQzM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cbCj7f1moS70TxRHBC0L9ifdRsaVdHN1lciwsMcjdSw&oe=6A119D68"}, {"file_name": "migrated_image.png", "id": "501065020778692", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75395601_815879825500595_4984963000512282624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFPA5MEOHI0Q7kNvwHrlPxZ&_nc_oc=AdpceeUc2J0R_wwhO-OrkaA4QP-ezq8Bd3cFPnDrUej3xn9iZjuLjeET-A6Nb3c0m28&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oIJxB_iKP2ZX807m3Oe9lByRc0U7t7yqIB0ZkWwwQAw&oe=6A11CDC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adrift and Alone", "keywords": ["sailing", "shark", "carribean", "sea", "shooting"], "long_description": "Adrift and Alone is a single player, survival- adventure game.\nAfter being shipwrecked, you take control of your raft to explore the nearby islands.\nResources and treasure can be found everywhere, but so can the overprotective man-eating sharks.\nOutmanuver them or use your pistol if you have to.\nReturn to your camp to upgrade your raft and increase your chances for survival.\nGet rescued by a passing ship, or survive in the open seas for as long as you can!\nWith a full year of updates and support, there has never been a better time to survive the Caribbean!", "short_description": "Adrift and Alone is a single player, survival- adventure game with a massive open world. Take control of your raft on a quest for adventure. Fight off sharks, find treasure and craft upgrades to improve your raft and camp."}]}, "developer_name": "Bent Light Industries", "developer_privacy_policy_url": "https://bentlightindustries.wixsite.com/bentlightindustries/privacy-policy", "developer_terms_of_service_url": null,
sid=6e7a0a&_nc_ohc=r1hGB709qqgQ7kNvwHed8si&_nc_oc=Adk73Kiw6lmVeEWfy9aejOoPMzJTodXRmvIynNhAloFMXHLLgjQ8wMkbd42vBQ1usjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftLdV3pFvEvT8qxvcdwf1zr-ac65cBZ8mEUsuPiihvufw&oe=69A430E8"}, {"file_name": "migrated_image.png", "id": "501065020778692", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395601_815879825500595_4984963000512282624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdl9gxB39ScQ7kNvwE4bzxE&_nc_oc=Adl4RW387c5IzhHGQLroAXmo3JkGPhrdG-mIFGXaeTAxWE6YHVCj0KCA8-ukV0MN878&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsWDnsq3dFOeltMVahpCNFs316N0IeEofFOP682juWllA&oe=69A42900"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adrift and Alone", "keywords": ["sailing", "shark", "carribean", "sea", "shooting"], "long_description": "Adrift and Alone is a single player, survival- adventure game.\nAfter being shipwrecked, you take control of your raft to explore the nearby islands.\nResources and treasure can be found everywhere, but so can the overprotective man-eating sharks.\nOutmanuver them or use your pistol if you have to.\nReturn to your camp to upgrade your raft and increase your chances for survival.\nGet rescued by a passing ship, or survive in the open seas for as long as you can!\nWith a full year of updates and support, there has never been a better time to survive the Caribbean!", "short_description": "Adrift and Alone is a single player, survival- adventure game with a massive open world. Take control of your raft on a quest for adventure. Fight off sharks, find treasure and craft upgrades to improve your raft and camp."}]}, "developer_name": "Bent Light Industries", "developer_privacy_policy_url": "https://bentlightindustries.wixsite.com/bentlightindustries/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bent Light Industries", "support_website_url": "https://bentlightindustries.wixsite.com/bentlightindustries/contact", "website_
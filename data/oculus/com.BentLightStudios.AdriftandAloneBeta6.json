sid=6e7a0a&_nc_ohc=WKy-Da5bIqIQ7kNvwEm9ceD&_nc_oc=AdkJPQtLZqk5ZDeKx_zfWxgj-CiyJ3xBe4VV6mDY1IPI327m3CCp5WuaUpAteUgHv9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmtyWQFwafF6rF27PT-BiQg0B2FFo3D-BzW1vZYQYwxQ&oe=6999A4E8"}, {"file_name": "migrated_image.png", "id": "501065020778692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395601_815879825500595_4984963000512282624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTQ_xdyeTIcQ7kNvwFYdAOz&_nc_oc=Adn0k5CcWaQNMKqMb-rFSoK5GwZwH6h5t5aQbbmuv9pfvHx63MoRgArtjMABmwNW8MY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftb3C1dF-wGex618PH1CkUsrJaKrv3U09LtctBWkLTH9A&oe=69999D00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adrift and Alone", "keywords": ["sailing", "shark", "carribean", "sea", "shooting"], "long_description": "Adrift and Alone is a single player, survival- adventure game.\nAfter being shipwrecked, you take control of your raft to explore the nearby islands.\nResources and treasure can be found everywhere, but so can the overprotective man-eating sharks.\nOutmanuver them or use your pistol if you have to.\nReturn to your camp to upgrade your raft and increase your chances for survival.\nGet rescued by a passing ship, or survive in the open seas for as long as you can!\nWith a full year of updates and support, there has never been a better time to survive the Caribbean!", "short_description": "Adrift and Alone is a single player, survival- adventure game with a massive open world. Take control of your raft on a quest for adventure. Fight off sharks, find treasure and craft upgrades to improve your raft and camp."}]}, "developer_name": "Bent Light Industries", "developer_privacy_policy_url": "https://bentlightindustries.wixsite.com/bentlightindustries/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bent Light Industries", "support_website_url": "https://bentlightindustries.wixsite.com/bentlightindustries/contact", "website_
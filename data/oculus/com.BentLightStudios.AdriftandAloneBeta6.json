/scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974805_2032210843738189_1312364885501280256_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpC0wilbDvEQ7kNvwFIQKer&_nc_oc=AdqTgl3hfuIOVO772m4v9G0Q_45rag1pM5zff3wtn4imsrl8St7Wlia2vNi-1TcyBVw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-twnkdD45K2ioZXtwtBMVNsY0I-pm9b-24ea3ZUfZdsw&oe=6A4691A8"}, {"file_name": "migrated_image.png", "id": "501065020778692", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75395601_815879825500595_4984963000512282624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Di4a6_9BrsQ7kNvwHQiRU_&_nc_oc=AdrtJEIZmnRozGxGhBnviomXSrVS3Y9hPjJnyBL_b4d6DG9RtG5XVDq8-xpNl99pWRE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mzshL6E8usCFq38MOniMOqnKK_Q-fWGmQ7z8Fw0kMMA&oe=6A4689C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adrift and Alone", "keywords": ["sailing", "shark", "carribean", "sea", "shooting"], "long_description": "Adrift and Alone is a single player, survival- adventure game.\nAfter being shipwrecked, you take control of your raft to explore the nearby islands.\nResources and treasure can be found everywhere, but so can the overprotective man-eating sharks.\nOutmanuver them or use your pistol if you have to.\nReturn to your camp to upgrade your raft and increase your chances for survival.\nGet rescued by a passing ship, or survive in the open seas for as long as you can!\nWith a full year of updates and support, there has never been a better time to survive the Caribbean!", "short_description": "Adrift and Alone is a single player, survival- adventure game with a massive open world. Take control of your raft on a quest for adventure. Fight off sharks, find treasure and craft upgrades to improve your raft and camp."}]}, "developer_name": "Bent Light Industries", "developer_privacy_policy_url": "https://bentlightindustries.wixsite.com/bentlightindustries/privacy-policy", "developer_terms_of_service_url": null,
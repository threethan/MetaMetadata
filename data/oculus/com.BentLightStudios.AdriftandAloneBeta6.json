/scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974805_2032210843738189_1312364885501280256_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoYjkGiGxT4Q7kNvwFhxRx2&_nc_oc=AdpszQkbeNTjSWSHnuNTkQZRMIxkQhFZrulECR6DlTjri-wXOoVa6c1HLEOvCLBVOOw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOL6YdAPnMkOSI1qSRY2-J5a_B8_ZoGDxiMuM6hPTc0Q&oe=6AAE7FE8"}, {"file_name": "migrated_image.png", "id": "501065020778692", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75395601_815879825500595_4984963000512282624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLQwYH2VhRkQ7kNvwFUNzPV&_nc_oc=AdqkFqYVH9dsnXDEoL2o2Y4B8zlvbiAyXDOuCuGxj4ppzu9yAKT1kBJCVk_U3CEDYJg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYMq0dw3Qcid6wLnCE9XHEwB7y-FIAGYyFuPSXeL40LQ&oe=6AAEB040"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adrift and Alone", "keywords": ["sailing", "shark", "carribean", "sea", "shooting"], "long_description": "Adrift and Alone is a single player, survival- adventure game.\nAfter being shipwrecked, you take control of your raft to explore the nearby islands.\nResources and treasure can be found everywhere, but so can the overprotective man-eating sharks.\nOutmanuver them or use your pistol if you have to.\nReturn to your camp to upgrade your raft and increase your chances for survival.\nGet rescued by a passing ship, or survive in the open seas for as long as you can!\nWith a full year of updates and support, there has never been a better time to survive the Caribbean!", "short_description": "Adrift and Alone is a single player, survival- adventure game with a massive open world. Take control of your raft on a quest for adventure. Fight off sharks, find treasure and craft upgrades to improve your raft and camp."}]}, "developer_name": "Bent Light Industries", "developer_privacy_policy_url": "https://bentlightindustries.wixsite.com/bentlightindustries/privacy-policy", "developer_terms_of_service_url": null,
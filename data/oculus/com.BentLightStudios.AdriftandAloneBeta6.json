1-25/38974805_2032210843738189_1312364885501280256_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2eqESG9ZzwQ7kNvwHKiaUv&_nc_oc=AdmUZqiMjgq7q-XpYi8TT4bheHlu3O33td_elEHyl9OVyZH720ru1es_aZ1DF3C_3oA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVP6s-vfY7mEQf8TyE4sLgLO7urusEq2iAoxBU0pKJFw&oe=69AD6B68"}, {"file_name": "migrated_image.png", "id": "501065020778692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395601_815879825500595_4984963000512282624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kD2RE8kLCbkQ7kNvwFtF8YE&_nc_oc=Adl-5dkdFxV2XsKK0a6RV5m48nSBcKRLkhQjDy8aysgSjKdMNRu8TDkMT8rOd0bNcgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBjDdc63gi3h84bFz3_HXTIXvVLgiJRd0qnXvSAMOEaQ&oe=69AD6380"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adrift and Alone", "keywords": ["sailing", "shark", "carribean", "sea", "shooting"], "long_description": "Adrift and Alone is a single player, survival- adventure game.\nAfter being shipwrecked, you take control of your raft to explore the nearby islands.\nResources and treasure can be found everywhere, but so can the overprotective man-eating sharks.\nOutmanuver them or use your pistol if you have to.\nReturn to your camp to upgrade your raft and increase your chances for survival.\nGet rescued by a passing ship, or survive in the open seas for as long as you can!\nWith a full year of updates and support, there has never been a better time to survive the Caribbean!", "short_description": "Adrift and Alone is a single player, survival- adventure game with a massive open world. Take control of your raft on a quest for adventure. Fight off sharks, find treasure and craft upgrades to improve your raft and camp."}]}, "developer_name": "Bent Light Industries", "developer_privacy_policy_url": "https://bentlightindustries.wixsite.com/bentlightindustries/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bent Light Industries", "sup
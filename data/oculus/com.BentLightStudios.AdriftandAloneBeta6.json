1-25/38974805_2032210843738189_1312364885501280256_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZKaTLmBT0IQ7kNvwHnV9tb&_nc_oc=Adn03WpGsFD6CJG03hunA_mZOw2XWGJR9t5jJ7QIUutAXMerUqgMqBcZFPY491b9UP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsdjdNn23VXzp__tHZ7Der57lAu_Y6BIMFhhaAe3_rfgw&oe=69A82568"}, {"file_name": "migrated_image.png", "id": "501065020778692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395601_815879825500595_4984963000512282624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQFFCfF12gcQ7kNvwEic2GJ&_nc_oc=AdmAA-zaup_LMf7UmnFXJ5luxVoWf8L1gIlcRKz0Y7EnS0hdLaBxvPghWVEW-6M0X4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv4jswTDd58WTCU93q8fu3yEKwISQBB8JknKzJPTiVdSQ&oe=69A81D80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adrift and Alone", "keywords": ["sailing", "shark", "carribean", "sea", "shooting"], "long_description": "Adrift and Alone is a single player, survival- adventure game.\nAfter being shipwrecked, you take control of your raft to explore the nearby islands.\nResources and treasure can be found everywhere, but so can the overprotective man-eating sharks.\nOutmanuver them or use your pistol if you have to.\nReturn to your camp to upgrade your raft and increase your chances for survival.\nGet rescued by a passing ship, or survive in the open seas for as long as you can!\nWith a full year of updates and support, there has never been a better time to survive the Caribbean!", "short_description": "Adrift and Alone is a single player, survival- adventure game with a massive open world. Take control of your raft on a quest for adventure. Fight off sharks, find treasure and craft upgrades to improve your raft and camp."}]}, "developer_name": "Bent Light Industries", "developer_privacy_policy_url": "https://bentlightindustries.wixsite.com/bentlightindustries/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bent Light Industries", "sup
1-25/38974805_2032210843738189_1312364885501280256_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AH-rN0E9QXMQ7kNvwEuNkRb&_nc_oc=AdlxJ9Yt3s2o63LPt6HJeLBXqnWvCn3gtrQjiVW9kqqGf93mOTI639WKPkfcZXcqFig&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmfQHO8J8tQemH71yYf2i2by2OUkn_sO5vvQg4AszLwQ&oe=69BA9A68"}, {"file_name": "migrated_image.png", "id": "501065020778692", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75395601_815879825500595_4984963000512282624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atoWk95jR68Q7kNvwHoNp80&_nc_oc=AdmHGJEK6xXkUQPRt3bV4GKqb-pUzliPlEjQb66_HfL-yXDb7w0Ojs5JnAk7alc_Y-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxVpW7GehsOWSti7jBaOIPdbQGd10JiNHqlCVHuidRgzw&oe=69BA9280"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adrift and Alone", "keywords": ["sailing", "shark", "carribean", "sea", "shooting"], "long_description": "Adrift and Alone is a single player, survival- adventure game.\nAfter being shipwrecked, you take control of your raft to explore the nearby islands.\nResources and treasure can be found everywhere, but so can the overprotective man-eating sharks.\nOutmanuver them or use your pistol if you have to.\nReturn to your camp to upgrade your raft and increase your chances for survival.\nGet rescued by a passing ship, or survive in the open seas for as long as you can!\nWith a full year of updates and support, there has never been a better time to survive the Caribbean!", "short_description": "Adrift and Alone is a single player, survival- adventure game with a massive open world. Take control of your raft on a quest for adventure. Fight off sharks, find treasure and craft upgrades to improve your raft and camp."}]}, "developer_name": "Bent Light Industries", "developer_privacy_policy_url": "https://bentlightindustries.wixsite.com/bentlightindustries/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bent Light Industries", "sup
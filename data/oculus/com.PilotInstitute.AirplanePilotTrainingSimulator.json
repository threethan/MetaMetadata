id": "1028081359462138", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499299786_1028081366128804_288153303630264474_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-oQpXw-VCAQ7kNvwGHGYrR&_nc_oc=Adprj_48hv_BPSFBDijl--Dh7GIKQbziExdsy1OrwjmSiiEOdX9mgdO6psGlkut0Qf0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45pqz9om18LEzjSUNMdXxbL-y58DekDxI-pqAIyO4Z1w&oe=6A11A032"}, {"file_name": "39035326_1414393656149381_3936089401665113969_n.png", "id": "622491784143165", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620418_622491787476498_3120617467770691715_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGIR6q0kgY8Q7kNvwEN8eeL&_nc_oc=Adp5l5DI6A7-Tbagbkv5yzIecOrri_ZF9zj3VLP23VbSxVnXpbW0lrasIWQppf7CWRs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PPjtdiYJsZVFXkM_09_r91VGLn5zbhdkCWY6g46tj2w&oe=6A119D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39001670_1060925138221129_7407793410770970666_n.png", "id": "1385533796054257", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499619602_1385533799387590_2785843161834335940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAcOLF6pKd0Q7kNvwG603ra&_nc_oc=AdqwoC1Jerl-sSPIZ-WlDNb26WM-HEoJQcuDe9gp8UfrGe5Zd6P1cG4_Vqiaa96mu_U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wgPQKpIeeSIEMSyAuAlzk60CHs25j3YgAQS0lFHYZjA&oe=6A11A5CE"}, "display_name": "Airplane Pilot Training Simulator", "keywords": ["pilot", "simulator", "flight", "airplane", "cessna"], "long_description": "See your small piston aircraft come to life with VR preflight training.\n\nDiscover hidden aircraft systems and visualize them inside the wings and fuselage. Learn about the various aircraft components and what their functions are. Visualize the aircraft engine in motion like never before.\n\nThis VR training app was developed by Pilot Institute, one of the leaders in online aviation training.\n\nFeatures:\n\n- Fully immersive VR experience\n- Discover hidden aircraft systems\n- Learn about aircraft components and their functions\n- Visualize the aircraft engine in motion\n- Developed by Pilot Institute, a leader in online aviation training\n\nBenefits:\n\n- Save money with your flight training by being more prepared\n- Learn faster and more effectively\n- Improve your preflight skills\n- Gain confidence in your knowledge of aircraft systems\n- Prepare for real-world flying\n\nDownload our VR preflight training app today FOR FREE and see the difference it can make in your flight training.", "short_description": "Learn faster and fly safer with VR preflight training for small piston aircraft.\n\nDiscover hidden aircraft systems, such as pitot-static, fuel, brake, and flight controls systems. Visualize them inside the wings and fuselage. Learn about the various aircraft components and what their functions are. Visualize the aircraft engine in motion like never before.\n\nThis VR training app was developed by Pilot Institute, one of the leaders in online aviation training.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pilotinstitute.com/privacy-policy/", "developer_terms_of_service_url": "https://pilotinstitute.com/terms-and-conditions/", "publisher_name": "Pilot Institute", "support_website_url": "https://pilotinstitute.com/contact-us/", "website_url": "https://pilotinstitute.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "suppor
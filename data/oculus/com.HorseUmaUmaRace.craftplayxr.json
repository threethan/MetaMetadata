D295"}, {"file_name": "SCS4.png", "id": "1335118382045880", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499622919_1335118385379213_765259359095972196_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb4VjrjHn3YQ7kNvwE1p9LV&_nc_oc=AdqaF2ZybfPfsFaXyHnza1tOAJSf8KdVEqhxITrBWaSD1s-iGyTfkGUnF-MscTK6ZIY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq0TIuQXpE6z6xa1cNtyCxcRxnPNh4vNtgyRikueMWfQ&oe=6A8ECFFB"}, {"file_name": "SCS3.png", "id": "2228588361230484", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619680_2228588364563817_3888114332707821060_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyWVUccVeqIQ7kNvwFoaKJD&_nc_oc=Adqo2dMjRfkxEx05UdInh7bZFPXZig43rmA9aJm-uakbL1puNv3Dl1JMqc09vIo3Hew&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLrDimhfNjyTk3BeMUILYsqtVV2vNTfjDlHlx8myHDlg&oe=6A8EC0E7"}, {"file_name": "SCS5.png", "id": "1584260116691031", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499622285_1584260120024364_2747686504738648773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq7whBGQgAoQ7kNvwHvX7uD&_nc_oc=AdreKt55KWltJZMrhBs3z0b3Dqxy7Cyo9qRjK_TH2Kdv_GzQip-CrfZRxsAFQPlq4AY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9R5R90sMWrFJ9EVeCrmL3zHWDGkDLm2J_OtK-ce5vUw&oe=6A8EF00C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horse Uma Uma Race", "keywords": ["Horse", "race", "horses", "derby"], "long_description": "Saddle up and get ready for the thrill of a lifetime in Horse Uma Uma Race where raw power meets lightning fast reflexes. This isn\u2019t just another racing game; it\u2019s a true test of your timing, precision, and sheer will to win. You'll take control of a racehorse, but make no mistake, its speed is in your hands. With every tap or tilt, you\u2019ll need to find the perfect rhythm to unleash bursts of acceleration, drift past sharp corners, and surge ahead of the competition.", "short_description": "In Horse Uma Uma Race, it\u2019s all about speed and skill, push your racehorse to the limit, chase down every second, and crush your own records. Race after race, go head to head with rival horses, break new score barriers, and prove you\u2019re the fastest on the track."}]}, "developer_name": null, "developer_privacy_policy_url": "https://craftplayxr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "CraftplayXR", "support_website_url": null, "website_url": "https://craftplayxr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1132344739964932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623314_1516181580521637_2274597163321830625_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nc75-V9l8egQ7kNvwEQWzJp&_nc_oc=Adr_d2MhNXSeo-yNMbnWoIyPM3g9ZIPfEmC4qmx6XCKsJtGea_U6I_Wdv2xzy27QH4E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjxmg1mtkIKc9fcP1LW28yVPBdJ2Lulh7dpRm3I9LKjQ&oe=6A8EECD1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horse Uma Uma Race", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulatio
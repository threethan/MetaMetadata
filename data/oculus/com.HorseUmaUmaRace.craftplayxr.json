2019s a true test of your timing, precision, and sheer will to win. You'll take control of a racehorse, but make no mistake, its speed is in your hands. With every tap or tilt, you\u2019ll need to find the perfect rhythm to unleash bursts of acceleration, drift past sharp corners, and surge ahead of the competition.", "short_description": "In Horse Uma Uma Race, it\u2019s all about speed and skill, push your racehorse to the limit, chase down every second, and crush your own records. Race after race, go head to head with rival horses, break new score barriers, and prove you\u2019re the fastest on the track."}]}, "developer_name": null, "developer_privacy_policy_url": "https://craftplayxr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "CraftplayXR", "support_website_url": null, "website_url": "https://craftplayxr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1132344739964932"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2225791944834389"}]}, "baseline_offer": {"id": "2225791944834389"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781622300, "status": "PUBLISHED", "id": "2225791944834389"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1145
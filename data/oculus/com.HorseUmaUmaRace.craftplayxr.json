a Race, it\u2019s all about speed and skill, push your racehorse to the limit, chase down every second, and crush your own records. Race after race, go head to head with rival horses, break new score barriers, and prove you\u2019re the fastest on the track."}]}, "developer_name": null, "developer_privacy_policy_url": "https://craftplayxr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "CraftplayXR", "support_website_url": null, "website_url": "https://craftplayxr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1132344739964932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499623314_1516181580521637_2274597163321830625_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAEIRVSIWnQQ7kNvwGnW0Hi&_nc_oc=AdpmgMg4md2EDltZuqNh964bb9b8wKdEmmE7LpmM2ca3KYgDM6C4C4CWTZUhIRWWu7A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKED9lEtXw-lqLr4Jt9itCzzMULaQPWbAcdWUahuTdv-Q&oe=6AA94AD1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horse Uma Uma Race", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation"
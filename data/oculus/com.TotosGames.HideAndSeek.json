dn.com&_nc_ss=7f20f&oh=00_AQOvooIpNaFqy03WkQi4QSCR7uh7g4gaDbuCmF5E69-XQw&oe=6ACE5821"}, {"file_name": "Hide_SS_2.png", "id": "1267838467808733", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391784_1267838474475399_7774418168344605334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYtl_XQniGQQ7kNvwFLiSxT&_nc_oc=AdpYiJ2J2p9oEMw5sRkXLH9Q5knFon4OFTCMdIZNNN7QXexDaTSUdA3vzfkVwv8l8CU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgu11duxpQ9UUXrjfUl6otAeLbr-qOteMOJs-AlyORfA&oe=6ACE4CBD"}, {"file_name": "Hide_SS_1.png", "id": "972809968048429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_972809971381762_6310059954952090451_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwbNMo1x6ncQ7kNvwFnD-km&_nc_oc=AdoMIyxWmzzNRC8TTBRCh0Fz1qe6TOMcnGYIhqGU-qZbnckrPZTylqWSYKZvWSZCnvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBTiEXh8I-O_CtfNZL7wUdp9f6Y_V7MyawgCaLi8XOzQ&oe=6ACE3604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HideNSeek_Landscape.png", "id": "1986986385112733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391806_1986986388446066_1870426786882252924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vo9zmC6_54YQ7kNvwErRG28&_nc_oc=AdpuYPbSoeqxmhx5XwzlvXfhFcCTjL9fn1pc8dbOA69S8eisuJkhRu4d1_Pddu33xT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq4vzdnmJKq7ATaL3m7pSfAGaUkzBYH5g689t4jxkpOQ&oe=6ACE38D8"}, "display_name": "Hide n Seek", "keywords": ["Hide", "Seek", "Run", "Child", "Game"], "long_description": "Step into the ultimate VR hide-and-seek adventure! In this immersive game, you can take on the role of the seeker or the hider, depending on the chosen mode. As the seeker, your mission is clear: track down and tag all hiders before the timer runs out. But if you're a hider, your goal is survival\u2014find the perfect spot and avoid being caught at all costs until time is up. With engaging gameplay, strategic hiding spots, and intense chases, this VR experience will keep your heart racing. Will you master the art of pursuit or the skill of evasion? The choice is yours!", "short_description": "Experience the thrill of hide-and-seek like never before in VR! Play as a seeker and catch all hiders before time runs out, or be a hider and evade capture until the clock hits zero."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28475832772026609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391768_954968182839979_1555924425859142988_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfVRTOpSxaEQ7kNvwEscQlr&_nc_oc=Ado3-xgfjkDbQbmsoeZLpS2hVxf97vniF7U0kNJSVMRH_cnRgYwdrsfXp24JqTHVuog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4vIjgJ289J3BZ9hFSuMfkd6XMN1gXxME1QFLvjqzEcQ&oe=6ACE4D15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hide n Seek", "platform": "ANDROID_6DOF", "cont
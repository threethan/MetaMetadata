scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUrm9FIaTXvkYgur08aFV5Ip4PPEyuaT1Sq_ARIBLL1A&oe=6AD2413D"}, {"file_name": "Hide_SS_1.png", "id": "972809968048429", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391785_972809971381762_6310059954952090451_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0ugsn41eLoQ7kNvwHvyjNr&_nc_oc=Adpj_fnmeano-C_NWR9vezVhJDCIqSR9ynWJdPjXBr9iV-CRpQQFSvrS-4tyYCb-zWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfsYOFSW73FPuSQSTEH-R7JMj_Jul-ZzoSrYbgcbKrCg&oe=6AD22A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HideNSeek_Landscape.png", "id": "1986986385112733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391806_1986986388446066_1870426786882252924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiUBs9jZ1VsQ7kNvwGQ1v2S&_nc_oc=AdrBIILYCt4Lt37kb6mv7t3bcOBpQ8I_uVCV6W97wjjPDEU7P3jAj0_WFRLNMh19jwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBuocdlakfbcisTUJ9die-KgzZWLcg4antj4ZKYMDn9Q&oe=6AD22D58"}, "display_name": "Hide n Seek", "keywords": ["Hide", "Seek", "Run", "Child", "Game"], "long_description": "Step into the ultimate VR hide-and-seek adventure! In this immersive game, you can take on the role of the seeker or the hider, depending on the chosen mode. As the seeker, your mission is clear: track down and tag all hiders before the timer runs out. But if you're a hider, your goal is survival\u2014find the perfect spot and avoid being caught at all costs until time is up. With engaging gameplay, strategic hiding spots, and intense chases, this VR experience will keep your heart racing. Will you master the art of pursuit or the skill of evasion? The choice is yours!", "short_description": "Experience the thrill of hide-and-seek like never before in VR! Play as a seeker and catch all hiders before time runs out, or be a hider and evade capture until the clock hits zero."}]}, "developer_name": null, "developer_privacy_policy_url": "h
6_6285622995872904836_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94niGT_dDK8Q7kNvwEMbjY2&_nc_oc=Adq-9kHv6G43ur6occXZmKwFK4xVEUsZx4iUqBTRvAyQCV7RCuvyaiG_2RqWlfk-FyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh44vDjxwTxHsFvd8YGgTvIuc3btdR9nve3qSvrBwy4w&oe=6ADDF1E1"}, {"file_name": "Hide_SS_2.png", "id": "1267838467808733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391784_1267838474475399_7774418168344605334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8v0XehwSxSYQ7kNvwEFgnIb&_nc_oc=AdqbsD4jSwN0E1Uj1QYl3Htk1KYzPH3Lt9E4EBXn7QuZ_BPyMJfqA0MfAdsbKJKnjF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSOxT4_cAEhnk5353i3dp82_MlVDiW3WA6aoDJkY4sDw&oe=6ADE1EBD"}, {"file_name": "Hide_SS_1.png", "id": "972809968048429", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_972809971381762_6310059954952090451_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTSTtJbdxQ4Q7kNvwFsOaU2&_nc_oc=AdpoNj2x9WRB7FrswobqXO_nvMlYYDn6Ws-EWNteJDa-YGDa9JbMVRQJ6I3t4z9cakw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7byCPqnSvm3fVz96hCJ45AEY7AuB1Q3bvuR8efBewlA&oe=6ADE0804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HideNSeek_Landscape.png", "id": "1986986385112733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391806_1986986388446066_1870426786882252924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t7XzinRjDYQ7kNvwHQWpsD&_nc_oc=AdqAAdFD4f2gNTtLUisLm4odgx1OBvLr6uwmyJg4grOieeRSirCEZw3NwJGFn3XgNVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsk-tjTgBnPU8LnCV9BZfRsH5bT5nj-tfvjzmO4_Ht4A&oe=6ADE0AD8"}, "display_name": "Hide n Seek", "keywords": ["Hide", "Seek", "Run", "Child", "Game"], "long_description": "Step into the ultimate VR hide-and-seek adventure! In this immersive game, you can take on the role of the seeker or the hider, depending on the chosen mode. As the seeker, your mission is clear: track down and tag all hiders before the timer runs out. But if you're a hider, your goal is survival\u2014find the perfect spot and avoid being caught at all costs until time is up. With engaging gameplay, strategic hiding spots, and intense chases, this VR experience will keep your heart racing. Will you master the art of pursuit or the skill of evasion? The choice is yours!", "short_description": "Experience the thrill of hide-and-seek like never before in VR! Play as a seeker and catch all hiders before time runs out, or be a hider and evade capture until the clock hits zero."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8959579787411865"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2518356701966392"}, {"status": "PUBLISHED", "id": "814677897886106"}, {"status": "PUBLISHED", "id": "1764360654208010"}, {"status": "PUBLISHED", "id": "1045270511003237"}, {"status": "PUBLISHED", "id": "995984262621078"}, {"status": "PUBLISHED", "id": "1133418781576317"}, {"status": "PUBLISHED", "id": "421960924244233"}]}, "baseline_offer": {"id": "42196092
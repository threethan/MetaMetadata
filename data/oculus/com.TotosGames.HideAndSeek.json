6_6285622995872904836_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94niGT_dDK8Q7kNvwHqZ8I1&_nc_oc=AdpH9Hl6fqlW7V9C68h84QcZHzXv4vs8EJqSa8NUpzf1Tu_E6G95peHJk7FiQr4URes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0Hk0M-8U_ZIh_NJzHo1XXUY86O3LSa_Wt4Bvf5e99jw&oe=6AE0CD21"}, {"file_name": "Hide_SS_2.png", "id": "1267838467808733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391784_1267838474475399_7774418168344605334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-8CHeWKw3EQ7kNvwGuY_fn&_nc_oc=AdrgKYj-er1nzYVR0m_9s3p24TkAtgRheos9dUk-u8-Z4IJP-zIO95TzFXPWyMWrvyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX2KUBm2NRdE8m3Z9OJUWmTfmEnt_GmAXwmT-_dISQwA&oe=6AE0C1BD"}, {"file_name": "Hide_SS_1.png", "id": "972809968048429", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_972809971381762_6310059954952090451_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfPAGXslUq4Q7kNvwF8bdOo&_nc_oc=AdoSnf1ainhN--1jhr5VBA7JrJXx2AJTa3uwu2n2hZp4VskSuOfZolHQb3XI0-pyOME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvQbXdxvXhCpbOAUE1fOUQDUlAz8yJWW8WjyF6YntoyA&oe=6AE0AB04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HideNSeek_Landscape.png", "id": "1986986385112733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391806_1986986388446066_1870426786882252924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t7XzinRjDYQ7kNvwHosxaS&_nc_oc=AdrYWec8ssWsaF4XXc5xwir3QyyfNEOwWUMF8c8GL4YWqHzpRKtwgmS_-COmYhJeLyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXcbS48v_3EAmfI1Qw-MrjuH4s3wwql5FoIZCDZ2coww&oe=6AE0ADD8"}, "display_name": "Hide n Seek", "keywords": ["Hide", "Seek", "Run", "Child", "Game"], "long_description": "Step into the ultimate VR hide-and-seek adventure! In this immersive game, you can take on the role of the seeker or the hider, depending on the chosen mode. As the seeker, your mission is clear: track down and tag all hiders before the timer runs out. But if you're a hider, your goal is survival\u2014find the perfect spot and avoid being caught at all costs until time is up. With engaging gameplay, strategic hiding spots, and intense chases, this VR experience will keep your heart racing. Will you master the art of pursuit or the skill of evasion? The choice is yours!", "short_description": "Experience the thrill of hide-and-seek like never before in VR! Play as a seeker and catch all hiders before time runs out, or be a hider and evade capture until the clock hits zero."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8959579787411865"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2518356701966392"}, {"status": "PUBLISHED", "id": "814677897886106"}, {"status": "PUBLISHED", "id": "1764360654208010"}, {"status": "PUBLISHED", "id": "1045270511003237"}, {"status": "PUBLISHED", "id": "995984262621078"}, {"status": "PUBLISHED", "id": "1133418781576317"}, {"status": "PUBLISHED", "id": "421960924244233"}]}, "baseline_offer": {"id": "42196092
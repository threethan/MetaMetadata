": "Hide_SS_2.png", "id": "1267838467808733", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391784_1267838474475399_7774418168344605334_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlQCdmbChHQQ7kNvwEcdLSe&_nc_oc=AdppqAzRZdpHV389kin315f3ixO2KK0To-4JjDolk5ZgUQFOoyz-8Mv-_B73vt9RhMk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDjpvk_12MsSaXUgd66kS7uIP6EJ3MX0yQQ4tFEaVG5g&oe=6A8591FD"}, {"file_name": "Hide_SS_1.png", "id": "972809968048429", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391785_972809971381762_6310059954952090451_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U07gh7AHYkkQ7kNvwEy9oh2&_nc_oc=AdqnjKq4kweECHBdLizfvN0a_qd4WVHaCSNT-PjLLEHLJ6IH6-4OF1sI16MvtIk2zZU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBLMp-kx8YurXPOYvctbSNrSAQiOYz30Y3MPxD6KQFTg&oe=6A857B44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HideNSeek_Landscape.png", "id": "1986986385112733", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391806_1986986388446066_1870426786882252924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HKpjVa_VdUQ7kNvwEDcEJ8&_nc_oc=AdoC6wZTFnM2d89RsrXnBD9i34_RXUtKqLLh-thY46h1gRVXYt5Bm0ivxRgRkI38glE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3Tv6TyuF8PMcyKzkCy49oIGJCagLPoY4oAo-hh-J1aA&oe=6A857E18"}, "display_name": "Hide n Seek", "keywords": ["Hide", "Seek", "Run", "Child", "Game"], "long_description": "Step into the ultimate VR hide-and-seek adventure! In this immersive game, you can take on the role of the seeker or the hider, depending on the chosen mode. As the seeker, your mission is clear: track down and tag all hiders before the timer runs out. But if you're a hider, your goal is survival\u2014find the perfect spot and avoid being caught at all costs until time is up. With engaging gameplay, strategic hiding spots, and intense chases, this VR experience will keep your heart racing. Will you master the art of pursuit or the skill of evasion? The choice is yours!", "short_description": "Experience the thrill of hide-and-seek like never before in VR! Play as a seeker and catch all hiders before time runs out, or be a hider and evade capture until the clock hits zero."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8959579787411865"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2518356701966392"}, {"status": "PUBLISHED", "id": "814677897886106"}, {"status": "PUBLISHED", "id": "1764360654208010"}, {"status": "PUBLISHED", "id": "1045270511003237"}, {"status": "PUBLISHED", "id": "995984262621078"}, {"status": "PUBLISHED", "id": "1133418781576317"}, {"status": "PUBLISHED", "id": "421960924244233"}]}, "baseline_offer": {"id": "421960924244233"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "2518356701966392"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9039084776128032", "version": "0.3"}, "
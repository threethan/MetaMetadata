g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRjJYlDXARMQ7kNvwFLeyuZ&_nc_oc=AdmZoDTF4fschXkT73O-dLFeFe2vn3Cq2rLq6Q6WL-URqUPeLVPgUjV2dPNRo02JDIE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvSbck0ZU6GLTMBCn9XREZGgCue7iFkSGa5NW4Z9EWf7A&oe=69A4217D"}, {"file_name": "Hide_SS_1.png", "id": "972809968048429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391785_972809971381762_6310059954952090451_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MliVWlx3cUQ7kNvwGhG7ET&_nc_oc=Adlb2ouWYBMEC800K5Ijea_nApXEtTEHSmI5O07LuaC_TeGu93pnAVaFmKL1jdzZ11w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQ6xRcDTCy3JX1UWyg_x2JT13pDBvx5zkorpHoE1b_ig&oe=69A44304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HideNSeek_Landscape.png", "id": "1986986385112733", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391806_1986986388446066_1870426786882252924_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpEAT6RFQS0Q7kNvwFXZR6D&_nc_oc=AdkEhH0AnfZnixnDw0cbqUTi_0LVYJhlA159ujDZXYAbgU9uCdhMuhL5TvPRQol04No&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afskpl-50l3SSorouz8PndNuERh-64quOjYdGAula_wnHA&oe=69A445D8"}, "display_name": "Hide n Seek", "keywords": ["Hide", "Seek", "Run", "Child", "Game"], "long_description": "Step into the ultimate VR hide-and-seek adventure! In this immersive game, you can take on the role of the seeker or the hider, depending on the chosen mode. As the seeker, your mission is clear: track down and tag all hiders before the timer runs out. But if you're a hider, your goal is survival\u2014find the perfect spot and avoid being caught at all costs until time is up. With engaging gameplay, strategic hiding spots, and intense chases, this VR experience will keep your heart racing. Will you master the art of pursuit or the skill of evasion? The choice is yours!", "short_description": "Experience the thrill of hide-and-seek like never before in VR! Play as a seeker and catch all hiders before time runs out, or be a hider and evade capture until the clock hits zero."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8959579787411865"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2518356701966392"}, {"status": "PUBLISHED", "id": "814677897886106"}, {"status": "PUBLISHED", "id": "1764360654208010"}, {"status": "PUBLISHED", "id": "1045270511003237"}, {"status": "PUBLISHED", "id": "995984262621078"}, {"status": "PUBLISHED", "id": "1133418781576317"}, {"status": "PUBLISHED", "id": "421960924244233"}]}, "baseline_offer": {"id": "421960924244233"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "2518356701966392"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9039084776128032", "version": "0.3"}, "id": "959892302747613", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicat
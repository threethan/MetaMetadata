&oe=69E4EAAA"}, {"file_name": "\u622a\u56fe3.png", "id": "1577846512623277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1577846515956610_7843404584820302566_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du2Ub6VAo_cQ7kNvwG3FuAU&_nc_oc=AdqNxNwZCJfrbx4-YKeXvxPLj65IXzlY-UQieCDPJcrpL_HWoyUdShWsT-NWkcNjJNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cx3YohxGbw2ih2hy2L6sRszKCOzBZq5k7sMM5AxMjJA&oe=69E4DE14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape2560x1440.png", "id": "344623857981596", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_344623861314929_6369954186798909394_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIGTPM3n4lcQ7kNvwG49M_J&_nc_oc=AdrJ7Za0i0JFqVxNZhk-WQNXOZhTRROhGGQq7St2yqPh4zILJ3eu-oFNLhb9EAG4Ups&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UHFMChx1NfUaE9aNr3hzNqgczfiVLVytoV2S0cU68uw&oe=69E4DD5B"}, "display_name": "Interstellar Catcher", "keywords": [], "long_description": "Interstellar Catcher is a VR game with a high level of physical intensity. It's time to put your agility and reflexes to the ultimate test!\n\nPilot a spaceship across the vast universe catching as many energy producing orbs as possible. Avoid obstacles and being caught by the crimson golem. Don't stop! You can only gain victory when you're alive!\n\n\u00b7  A fully immersive visual experience.\n\u00b7  This game involves various movements. It is easy to get started, but difficult to master.\n\u00b7  Challenge yourself and play against players all over the globe!\n\u00b7  Additional content coming soon!", "short_description": "Feel the thrill of flying in spaceship traveling at full speed through the expanse of outer space. Obtain enough energy to escape the crimson golem. Take on players from all over the world and embark on an exciting interstellar adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com
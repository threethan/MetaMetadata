00_1577846515956610_7843404584820302566_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz3R4mD-BfMQ7kNvwF0oyot&_nc_oc=AdnhpoQNXXyQMTcVJuweyuvwN-acaO5lLNMyukI2hrH7mbYLf1XRfj0o9hK5I3gj4rM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftagPeU1YRy925R45jOvK64RXdc16x-i3iDh4_H9GOZMA&oe=699DAD14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape2560x1440.png", "id": "344623857981596", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_344623861314929_6369954186798909394_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXWGV_9eamEQ7kNvwHzClba&_nc_oc=AdlkFup37Tjur__HdrLov4xOmohQEHBGkkha0A_3PWeIYV9kOQb12CivORpQ6E61UyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwQOzvzWUJVSnEMGjgJkReIOxvD0pD9GPu22RPShs5eQ&oe=699DAC5B"}, "display_name": "Interstellar Catcher", "keywords": [], "long_description": "Interstellar Catcher is a VR game with a high level of physical intensity. It's time to put your agility and reflexes to the ultimate test!\n\nPilot a spaceship across the vast universe catching as many energy producing orbs as possible. Avoid obstacles and being caught by the crimson golem. Don't stop! You can only gain victory when you're alive!\n\n\u00b7  A fully immersive visual experience.\n\u00b7  This game involves various movements. It is easy to get started, but difficult to master.\n\u00b7  Challenge yourself and play against players all over the globe!\n\u00b7  Additional content coming soon!", "short_description": "Feel the thrill of flying in spaceship traveling at full speed through the expanse of outer space. Obtain enough energy to escape the crimson golem. Take on players from all over the world and embark on an exciting interstellar adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.foun
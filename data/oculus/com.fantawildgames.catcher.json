&oe=69FB542A"}, {"file_name": "\u622a\u56fe3.png", "id": "1577846512623277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982600_1577846515956610_7843404584820302566_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-rhSUSr_k0Q7kNvwHbNZKb&_nc_oc=AdoX387YjTEyWUN-4_CxV5cXWxRp_hNKIuo8tXRfNaZaeS0OrctOrWx9GTbl65x14lg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79Tqo1_-B8LqYpg7Sdr1oDf33yx7GbSYB3Sbg6OxTUaA&oe=69FB4794"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape2560x1440.png", "id": "344623857981596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974909_344623861314929_6369954186798909394_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alZHokoX43EQ7kNvwG9kyfz&_nc_oc=AdpouYvVshAT_LqLKeCanYYJ637bfyGTrwVWJKEgRZ7rlnclW3FKdaHprAFPZhBrKOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44YIuN18cJm9HzPqEFYrpOYQ6T83oi3NLNwWzdEv3MNw&oe=69FB46DB"}, "display_name": "Interstellar Catcher", "keywords": [], "long_description": "Interstellar Catcher is a VR game with a high level of physical intensity. It's time to put your agility and reflexes to the ultimate test!\n\nPilot a spaceship across the vast universe catching as many energy producing orbs as possible. Avoid obstacles and being caught by the crimson golem. Don't stop! You can only gain victory when you're alive!\n\n\u00b7  A fully immersive visual experience.\n\u00b7  This game involves various movements. It is easy to get started, but difficult to master.\n\u00b7  Challenge yourself and play against players all over the globe!\n\u00b7  Additional content coming soon!", "short_description": "Feel the thrill of flying in spaceship traveling at full speed through the expanse of outer space. Obtain enough energy to escape the crimson golem. Take on players from all over the world and embark on an exciting interstellar adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com
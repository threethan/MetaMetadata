_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaifwjMRaJAQ7kNvwGZMNNk&_nc_oc=Adr7e_OtvT1dgFx8pFk9-ych8t1tuZlQkZXfIJNQ7Sw656IqDEmx84pqorM-SiUnOpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwBx0QAIZYJkVxV8oPvdujHIxEJsJDRZPhlUv0S28Fag&oe=6B0451AA"}, {"file_name": "\u622a\u56fe3.png", "id": "1577846512623277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1577846515956610_7843404584820302566_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q-KfSL36eEQ7kNvwEiJle0&_nc_oc=Ado7m4D4kZOyooL65gDENwrZI2ueYUZ2W6CwH2HZqs-PvFMEEFduAR-bN6Pu3A0RRek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_4rqIAp-_6ahxIx3ZwEW97E3r5vKEAJu1geRtl9Woog&oe=6B047D54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape2560x1440.png", "id": "344623857981596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974909_344623861314929_6369954186798909394_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Slag9geq1ckQ7kNvwFo2sGh&_nc_oc=AdpA7VrJ_hD7OFEJQWhtWA1lW0N60fDULvz8jdWun_cJ2ZfB-OVGY_HLS_nENuIa5j8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRiW_Sfw6xhEOh68ngLF2gVcxYESjrjR9caIuHP9aGfg&oe=6B047C9B"}, "display_name": "Interstellar Catcher", "keywords": [], "long_description": "Interstellar Catcher is a VR game with a high level of physical intensity. It's time to put your agility and reflexes to the ultimate test!\n\nPilot a spaceship across the vast universe catching as many energy producing orbs as possible. Avoid obstacles and being caught by the crimson golem. Don't stop! You can only gain victory when you're alive!\n\n\u00b7  A fully immersive visual experience.\n\u00b7  This game involves various movements. It is easy to get started, but difficult to master.\n\u00b7  Challenge yourself and play against players all over the globe!\n\u00b7  Additional content coming soon!", "short_description": "Feel the thrill of flying in spaceship traveling at full speed through the expanse of outer space. Obtain enough energy to escape the crimson golem. Take on players from all over the world and embark on an exciting interstellar adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7410211742336658"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982694_1364834437748025_6827261298021521472_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3PrcU812ZsQ7kNvwF7AGSi&_nc_oc=AdqCLDPsjr6CbKD0YtMNUUFnINUJBAb1QaezSNzSxFvZLZ5naWt3wV74_dAf-0li9w0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3ur9m5R5dHWbM9te0mq8e2prGo2hvrDm3yq5flT_vmw&oe=6B046953"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Interstellar Catcher", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adve
&oe=6AE5FF2A"}, {"file_name": "\u622a\u56fe3.png", "id": "1577846512623277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982600_1577846515956610_7843404584820302566_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7LsemcLjTcQ7kNvwGD6rzi&_nc_oc=AdoAJIffPjX3CIghzAmeGFG9TNEluOzC2lW_qsxB-eCQmUghgSaZ47zKtQGrk2pIXUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4grAknYdBWvTpqfNBYPaax6tw8aSl_rMqV419s_cPww&oe=6AE5F294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape2560x1440.png", "id": "344623857981596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974909_344623861314929_6369954186798909394_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7RJSisUR68Q7kNvwH84hu3&_nc_oc=AdrqORM_SF9gSeFMxU9VZUvFbZn9LHoTbcSFpeutirvxL-7_M3YDGP7PIVimGwNCu_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOME2pi3xw-yaGYB0BA3p6pM3kdF5yydTY9DUF2McvdCQ&oe=6AE5F1DB"}, "display_name": "Interstellar Catcher", "keywords": [], "long_description": "Interstellar Catcher is a VR game with a high level of physical intensity. It's time to put your agility and reflexes to the ultimate test!\n\nPilot a spaceship across the vast universe catching as many energy producing orbs as possible. Avoid obstacles and being caught by the crimson golem. Don't stop! You can only gain victory when you're alive!\n\n\u00b7  A fully immersive visual experience.\n\u00b7  This game involves various movements. It is easy to get started, but difficult to master.\n\u00b7  Challenge yourself and play against players all over the globe!\n\u00b7  Additional content coming soon!", "short_description": "Feel the thrill of flying in spaceship traveling at full speed through the expanse of outer space. Obtain enough energy to escape the crimson golem. Take on players from all over the world and embark on an exciting interstellar adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com
46_4331826787064854_4952471458114547838_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irjHZsZP9KMQ7kNvwFPvAG7&_nc_oc=AdqQSMiNnDKg8c5kDNPNQfyD86jQ387AQBYCZicZlJ3TPZIRqbg98hYgX_zHdHGucKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXIDKwSxZOpFTdV7uankz8ne7BYsIL0nbcxJC4fYVXlg&oe=6A5E3462"}, {"file_name": "Untitled274_20260329110132.png", "id": "926567806752052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300725_926567810085385_6911650472197391109_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-bxUp83T9UQ7kNvwEsx9r3&_nc_oc=AdoMwt8OdVQatGxZKXyjzXbt3RQ_GGKkl5JbJXvjAyWQZw0Ur1Z9XtCwI61lLGHR-oQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1b5H7kCzUhRuhlErRPlslmo7TLnLq9YUZsu5WA-Khew&oe=6A5E2172"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Mayhem", "keywords": ["pvp", "combat", "fighting"], "long_description": "*Monkey Mayhem is fast-paced and chaotic movement shooter with an intricate combat system. Fight others as a combatant monkey!*\n\n\ud83d\uddfa\ufe0f  **7 MAPS** and **11 GAMEMODES** to compete against nine opponents (or even against 5 opponents with 4 teammates)!\n\n\u2694\ufe0f  **46 GUNS**, **5 MELEES**, **14 PROJECTILES**, and **4 PERKS** to build the perfect loadout!\n\n\ud83c\udfa8  **46 CAMOS/WRAPS** and **16 COSMETICS** to fight with style!\n\nAnd many more features to come!", "short_description": "Monkey Mayhem is fast-paced and chaotic movement shooter with an intricate combat system. Fight others as a combatant monkey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkey-mayhem-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShadowFlame45", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-mayhem-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cat
 challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1594872964208529"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3638089039635493", "version": "1.1"}, "id": "1037500083406263", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3496629537114778", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3638089039635493"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1037500083406263"}]}, "change_log": null, "created_date": 1618038772, "i
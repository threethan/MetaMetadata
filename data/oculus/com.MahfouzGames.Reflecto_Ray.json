_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQqYUqxfd88Q7kNvwFPdvRD&_nc_oc=AdregKdoVXpG4gT1Ji9Rawh39uPZCmKqECSIZKBLgdajXJrr81k7NkK7E44xZBUA4A4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeHu-pwUACJoStfCpj0aOx1aQIHZpW1cVqCQsM9WKCXQ&oe=6A5B89B7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rk7aa8zPUQQ7kNvwF6lQkk&_nc_oc=AdrBuQpYne308senxlv_zMlqZrNYevKfKCofcIChNrmxsE-BJRbcfpt9_-oKejxonmM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-kE2TLV_lqM-Bbq7MwlKNLnqgMNUioSwZ02JAwkfS_w&oe=6A5B8A0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG3ziItCyhUQ7kNvwGKlQ_w&_nc_oc=AdoiyuliBpoxMzZebJABwaezrm4CHFmV4ThUORox8qErgoCNIBwWRPZJGZ04R1sMYGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6EbOLbB30-58X7CthbR1Rbd1_1IeKlz1x4xP06MgiKA&oe=6A5B783C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
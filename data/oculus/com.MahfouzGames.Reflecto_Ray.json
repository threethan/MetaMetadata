uoPlLDtgS7jF96qqSzksvMyUiEBcrdvUJv272Et7QRO7pXpuixRPbBBNb01oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-irZWxx2iqyqh4Lw-kEOIaAX6BR5YHnd-I1oarSlldg&oe=6AB3DE37"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45raOAZjf6gQ7kNvwGegNVf&_nc_oc=Adq2UwQegFugTPtpBn-2U_xJeIXrhNrSokwan1wk2GhL27oChH6D0kKkX8veu2nlhf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVnJcmmknN8Gd5JKBalFGEyfduOU0ZZvgXaD7QmwUeug&oe=6AB3DE8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtKR6MDymc8Q7kNvwFZXa4b&_nc_oc=AdokYGlfycwmBUvCKfTs3piKTJ7qFX3MXeWB6jaELlYP3FlpxMrVO8jDLHH2qOFHkHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGgok1Piqbi9o_CWLbUsal2Z0Z0Og8KgUcUVkpwgtE0Q&oe=6AB3CCBC"}, "display_name": "Reflecto Ray", "keywords": ["puzzle", "mirrors", "lasers", "casual", "relaxing"], "long_description": "Reflecto Ray is an engaging VR puzzle game that beautifully combines spatial logic with creative challenges.\n\nThe Journey: Humankind is under threat from ancient dark forces. To halt their advance, ancestors forged mystical tools capable of turning these entities into stone. These mystical tools depend entirely on power grids installed across every major city, and your critical mission is to keep the energy flowing.\n\nImmerse yourself in a universe of light. Discover the correct path for each beam by manipulating mirrors across wondrous environments. Featuring an atmospheric soundtrack, Reflecto Ray offers a perfect blend of blissful exploration and contemplative reflection.", "short_description": "Reflecto Ray is an immersive VR puzzle game combining creativity and skill. Challenge yourself to guide light beams to their final destinations by strategically rotating and placing mirrors in beautifully crafted environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27979893085028416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031609_760376671528451_4323330923784484937_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--SkPrQkjPYQ7kNvwHq0EZ-&_nc_oc=Adoghp48p-MGDmlAWYLx_IG8BsvlWhJyjyA6iwXRdXgxMMulurxf6oHObEqK87baC2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGXishwqnZ51jYa_IBCDu6SWUiyKeWLYCIAXhWr0S4TQ&oe=6AB3D457"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Reflecto Ray", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1619203981, "lastRevision": {"nodes": [{"id": "1470151
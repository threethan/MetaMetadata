_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS3wv9yBnvUQ7kNvwF-7VsG&_nc_oc=AdoOtklShOU3FHrJOTobPP2ycDKc0bydZocmmg0jUuKKe7DCiG-89SzMqzFZJFSl0Ws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHXVZNdI3A3qULgs0ct1hr_qeiGyZOwuX-RpvtPY5L0A&oe=6A6615B7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li6Z31B3V04Q7kNvwEOo75X&_nc_oc=AdrwkkFPZolQLVEpw90Gwlr231kCjCYpFWljXKWRqB8siRT3Tk8ANpxraiuclRSIMzo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-fiOxMlfLKRX7rPZqXQs1Ubv_l6bdZhhr7SqCRDwZAg&oe=6A66160C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFWPsIHAxXoQ7kNvwFqCnSN&_nc_oc=Adp1wS1lJHDzUR5-jE7pp0enBb6BhbDBOHtIPK9pMn2DwxjbW3XVAGvEc9zOA6Ul8YI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx7d5sY9iXKhYZsjigxL67RwcNt8Nny5Y5hLeXxA604Q&oe=6A66043C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
Z&_nc_oc=AdqfOHGISXJgecyLZ9Bswx4s6y5XoNIAbebL23-l4m4IEMZFJt7CXbWeCu12GD3utW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UcaJKo5auoy2k9vESNnjl4MtVS6GIpyUuRqrQDaU-aQ&oe=69DE3401"}, {"file_name": "3.png", "id": "723406855209483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_723406861876149_9141442931274739515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ukLNrQ38c0Q7kNvwHqO-9u&_nc_oc=AdquYU46nnYQbal29NkzOM-A7hxKHHqTIU47mdR--h8YqHdLWxhT3TdpIZQhF6NF9bQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BXmRP2WcVIdnlAy3u_5QLnbcBliwU_d5jXXIzpgSocQ&oe=69DE20EB"}, {"file_name": "4.png", "id": "891446871690183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031331_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYhHnwH7GS0Q7kNvwHGduJF&_nc_oc=AdoJEd4Brnd3wilvMZb_t0VoKAa5Z_lEyNJOc1D8qfXBX8_7kEkHIXoVXE3uSo9d9G0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qqoqWrxqZxLBpUwrFr53MqkQteACu5vixSmJ_Twth0w&oe=69DE4B37"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBVqw_dSlHIQ7kNvwErynVf&_nc_oc=Adq5rDmDJm3R3bj_R8dq_Wz6yRbD83oyLZFdxcelYFP4OycyhGT-CmpkP-CQDmgE6uA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lgsUkye3ifMD9OsenHlVogznRxfj_ORYmlIsFGQfl4w&oe=69DE4B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E4L12JGg84Q7kNvwHy6a_M&_nc_oc=AdpeXg43Uu8NLMzVVbideJlLL7sWqER9RRcmrHPgsOjsgpq8XiVxfppeO0CDbmAeuqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BIB2xvGrW3foYe4jYQ1-ZLvBZv7Di5_oKlfAaqqSyVA&oe=69DE39BC"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection.", "short_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1594872964208529"}, "rev
_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmFxqg88UQQQ7kNvwF9hLJP&_nc_oc=AdpTJzZUzcPNrVvGNS-Qre-FvIXUbgmG0rIp_v86M5uUIs5AnDpx3PxEsr5fCT49a5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Oy7rTQp-BCyLkQPpIvkakhsAHe9AJrpqBCDpLO0dTyA&oe=69FF40B7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhA6QdCLBfUQ7kNvwE3duJP&_nc_oc=AdrH7JkGGS8D5yDThwIDYUt45ZxVsOQPodVeXdO673mMZlZcn0GIRw8GqToIc7WOEhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n0tLOtID4qG1YG5f5tHgmc-b3hIwQFTgYj2nt3WnDbA&oe=69FF410C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym9C68jKbU4Q7kNvwFk6PTn&_nc_oc=Adry6QkjR7OAoqisZc4KCc6tlXWF5Q_1XlUsI_JKpKklw57QaxwmseCgqpUe05-KN9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BusPcppktYELqut0Zoh1meSbHfnBBgJBrBNYsqaKN1A&oe=69FF2F3C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QwojJPPu6YQ7kNvwEdRckX&_nc_oc=AdqX8LagZUdWeQV__L9Ad_8FjBXmpyzCbdESwJ_eD8SHQNAvgL6ezaX3gxOwqBbROTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDo3pbk6FF5RwoxW58Ze7g22WIjPSHdUKcCh_oP23ZNg&oe=6A7344B7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrSV00lN6NgQ7kNvwFzydeR&_nc_oc=AdpHSrQ0T4zdFzgpIgwoQOYwwEIcskd05_ytWojDtcpudQzEc6vzccBOY3b2chSW83Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRnpmQaN74wGTzsqQPIoZpbzT0sOWhotUdoo3ZbaECeQ&oe=6A73450C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjE_UldFPikQ7kNvwFym4nK&_nc_oc=AdrkAdpEyGcCYTWJfXAAakJywJuCIpYNAnd8cL6IE1g9nfcTIIu9QsPOr91Gck2nCao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3iYh7ypSE_2rIZ0WsEY8j83QSzsFFDgRW8CiXewE7YQ&oe=6A73333C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
K&_nc_oc=AdoCJuTpdSKZ32jtbgeFMBAxQf1z9eStDFjcuiG1tDbfhpN0u2QSC2VInbq3Fd_Yl7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEoIYRHG5ObwUSTpeqI1XhFxkGVjSI4kMiTef8r7w_gg&oe=6A732D81"}, {"file_name": "3.png", "id": "723406855209483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_723406861876149_9141442931274739515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF2_IppHQwgQ7kNvwGJJWfi&_nc_oc=AdorHEsL0RwQ62d4x3uQ4BXX-ToBMrC_Jp-q4fptDHxLRtQtURMhpM6SB-SDph6-Daw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDSXGaMZSY2GWqRjh4tE714rU5ZTxwfXZriKE4Cb_ZjA&oe=6A7352AB"}, {"file_name": "4.png", "id": "891446871690183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031331_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QwojJPPu6YQ7kNvwEdRckX&_nc_oc=AdqX8LagZUdWeQV__L9Ad_8FjBXmpyzCbdESwJ_eD8SHQNAvgL6ezaX3gxOwqBbROTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDo3pbk6FF5RwoxW58Ze7g22WIjPSHdUKcCh_oP23ZNg&oe=6A7344B7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrSV00lN6NgQ7kNvwFzydeR&_nc_oc=AdpHSrQ0T4zdFzgpIgwoQOYwwEIcskd05_ytWojDtcpudQzEc6vzccBOY3b2chSW83Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRnpmQaN74wGTzsqQPIoZpbzT0sOWhotUdoo3ZbaECeQ&oe=6A73450C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjE_UldFPikQ7kNvwFym4nK&_nc_oc=AdrkAdpEyGcCYTWJfXAAakJywJuCIpYNAnd8cL6IE1g9nfcTIIu9QsPOr91Gck2nCao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3iYh7ypSE_2rIZ0WsEY8j83QSzsFFDgRW8CiXewE7YQ&oe=6A73333C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection.", "short_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1594872964208529"}, "rev
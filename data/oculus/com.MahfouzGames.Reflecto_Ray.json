_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBy0zXqA2O0Q7kNvwEM1g_5&_nc_oc=AdqtQcwZ8qyiJC3pRqx6SoJkprPUYFMzcpMhS6-4z8nB2eSvoMeFt77uhnrz_2P0QW0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vEB25qAY-FFkNyMQhsS1Y72xebX4-kV2I3cowfggq8Q&oe=69EF6EB7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfqQixHQa_kQ7kNvwE3kinW&_nc_oc=AdpYdOQRfOLs6Zwr24zTE9Yq1PVgb42KY8z8VYgpxzbW7wnlZkjJfVsWwZ12N4jVgBU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24Q__e14OLAkMzQcroEbPulPGkYiqOje5BJ1ak7fGmXQ&oe=69EF6F0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0sOUDOFjhEQ7kNvwE8W5nr&_nc_oc=AdqygLDqJBaAxMjkfGT005jdCl5Y7pLpjxJqGojI0lGLJxcOFIuAyiMfthUY3c_kkUw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36mKJ3R0Fw_NrNq8ZHAwUVgWnPtcvAJRpZSXV9HLdvRA&oe=69EF5D3C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
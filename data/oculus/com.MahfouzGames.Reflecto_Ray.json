_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-07TY2DiO0Q7kNvwGdWGQZ&_nc_oc=AdqkPS1HrTUd1-QjQFeRjo9H7IbKOYSjwV2lkwcZN-gXzzOqMcPXTTTEqXierGO-AaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Uqo8AhQ7Ho_Epmud5q4cce-VfJO7DsHCkH2_IuSMw8w&oe=6A281F37"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXXZSPRpzZQQ7kNvwH4ekml&_nc_oc=AdoyXLUQBn9xJ2iMZugDOG7Kf537WHQnAapgktPt7qCdgRfGkElpqJ3C92MR2Y9b5Ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B6h9CznnKwZpnrDgaYwYsJ65FpM_V6zSWCtbUbnvZXA&oe=6A281F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2Wa3fbpuWYQ7kNvwGL4pAw&_nc_oc=AdptnxZwJHBA3UCnbC7dY3NaHwPNJ7do_18JU3s4QIZBovD_pcgOqOwox7cq-2vwplw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u4kuKs0ZornF2t90wOZiE5NLFcv_zf4mZZ3S_6J9O3w&oe=6A280DBC"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
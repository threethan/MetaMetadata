y&_nc_oc=Adr4E4F4PK7dpP0RFrg3cNKsLBbxD3GtBu3-m9PqZW8ni9FhvPfbygzYZVsa8SszCXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sf2p7e_wzR97AXRKD-6V-AyP9UovKyB4fanvPulpOcQ&oe=69DF8581"}, {"file_name": "3.png", "id": "723406855209483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_723406861876149_9141442931274739515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lpn2QB_qN7UQ7kNvwGisCYP&_nc_oc=AdoGUb2pXcP5h13zPRa3Ws7HcscfWPlqOVY8Dc4VGqKV_Kh50vTW21Of1BoL_-bcvHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37l0AhitUVnQ2AEIq2wHE-4IbWC9gDdm9_yzmh0GvXpg&oe=69DF726B"}, {"file_name": "4.png", "id": "891446871690183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031331_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYhHnwH7GS0Q7kNvwGKcvEc&_nc_oc=AdoLaW3xLOOQaAPM0PYGFReyqVo1LI2yCKcp_9ZrVBTOokUiuD15TbvQlaZoJ61_uPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TP5oqQHRFg3cVPV3QGozUXDsHX5QCHFMOPDLZvQ5Ojw&oe=69DF9CB7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBVqw_dSlHIQ7kNvwENFQlG&_nc_oc=Adq3d6YBzJWLf7ImF332QI1MepYCov8Pi8npfT09fuOnYa6J6s6ESMEREaXYDFn72yo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Srib1iO3I-XQPPR7pgojjaejYaAUPnitpWMCxV8cv3g&oe=69DF9D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f72lJZbCopIQ7kNvwHcnc8l&_nc_oc=AdrlK6FmBqGgrzQOweoE3ja0Vww_ay8AV3CQYqKt6UdPJlXXNDYi3qcnaG2O4_6yiMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wZX8rLbvWkZnsD3NIVPLP9ZMJU6qFvHIW1azsF4eAvA&oe=69DF8B3C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection.", "short_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1594872964208529"}, "rev
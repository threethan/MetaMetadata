_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv5lFby72yMQ7kNvwESt4xU&_nc_oc=Adru8fE85Te3wK3yW4XaEVkpx54TeHMlC-BiOYUwMPtZcy31WXKPnWBpwp0SmQUzCMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESxCzBuN-QBPDVE7DzQJg9jn9f5tQd7b-yIKYNieBH9w&oe=6A846837"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEuhTHph_6MQ7kNvwGFWbd-&_nc_oc=AdqPNKQ8h2XPSRgFFNuSMLSW9TRFRmD0woc26cjsgU8Sj74gjD7iDU2bEEmQnnwKE6s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4hATxDUNaTLPWTtD5X9vJqFK32AVAdDBlAbxtGp9Tyw&oe=6A84688C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlN4g-J3zXIQ7kNvwF7cwk6&_nc_oc=AdphMdboZodj3UeY6EG9jhRi7eJ0J3oIj4eeiFUnbu61tdxH4ZyKKgNQwpw4ntKulRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG816EJreISJnpSwwCig6INfWHzwMyB-oRV8yH4IbBBTw&oe=6A8456BC"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
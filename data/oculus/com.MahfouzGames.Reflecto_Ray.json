_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZ8wCRAAol4Q7kNvwHvFjvd&_nc_oc=AdrLZBXpvJyC7YrVF-NRppwraSjJWD9asckEokkZ-vYVqoLift5Xj0UmkwY2yyijDk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MlM2d6jI8jMXHnlNnPdDj1XqHIYovz_Xb35Fe3t9Siw&oe=69E4E2B7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLwRik21GU8Q7kNvwEW5xug&_nc_oc=Adq2o68ArVoWubBtr7xkydzTk93Fj7BEu7hvQZzLtkW9RmTKdOOaf2EHItSSxp2AFf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s-1RTrHR3YxoEC2T1mVZ0Eo8hT90R4gmocMCnauMYhA&oe=69E4E30C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvHKCLNPKDUQ7kNvwGnHp73&_nc_oc=Adp1qCkbxJLWvy29ef60gbbJ1-Y3x-dwNmNZoHV_VjfUEWTXDHIyJXxpvNj6hd0FspU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tK1yu1aUJHnV4G97I05KGQX8b8sXJTAXF0EnbF3s3QA&oe=69E4D13C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
G&_nc_oc=Adp5iBnUbKM9HBWzhLcw7aT-Pv7lpxcs75NYEkFFiPHejDzkuPjnetKMDqNYVXNdN3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7ARVQxZCIscRpn1VJNevUdSwYN6B0jZrP32wGyNPH9A&oe=6A60B881"}, {"file_name": "3.png", "id": "723406855209483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_723406861876149_9141442931274739515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Grrx4d6Q5p0Q7kNvwEH9Y8L&_nc_oc=AdrH0fXi1iW5akVv5T_Yb445JTBj6-8PyximLTBbW2j5xi8Eve_ozMRuIQsqhxiwvUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE-WKxODoOIxpM1ZLlK0K6FkqpIznk5zCXwVJzxYkkvg&oe=6A60A56B"}, {"file_name": "4.png", "id": "891446871690183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031331_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XatXOWGHzEsQ7kNvwHQnuv6&_nc_oc=AdouJr7-o7P8U8DoMA6yspFVbN6Aw1kyzytBFkBaxjfMtt8am-m-KLuxOQpFRW_d-6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANowzChf2_MH7KmEB9v2qISZTV1hmNMrqcWsoQ3ZM1tg&oe=6A60CFB7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZ49InTbRQYQ7kNvwFXD0cm&_nc_oc=Adq-uUt3-Qx-2VI0ccFLC-In-sU5g73THeMwaVy-ej6KUpFv2cfC9nCS84hsycC3tqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_Wj7HU5vqWA7TWYAyxoKNHtJyJb5Dwt78P8jDMli_Rg&oe=6A60D00C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enkyoEdc6E0Q7kNvwGFxSvK&_nc_oc=AdoeM-sUGrsibidrUHM-WJzmNTnK_DXiouFy1ttI-2gj2Leq3X4QaC_Gl0jiYfihi-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDcrisO7gLaXXFPuLWK46etsCJV_YCxUTEqBnebP03vQ&oe=6A60BE3C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection.", "short_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1594872964208529"}, "rev
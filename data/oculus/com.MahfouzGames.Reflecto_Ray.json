_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZ8wCRAAol4Q7kNvwEVqmTc&_nc_oc=Ado7trXj8MAqjS3_aiXgCvJZElHZo0B_UQ1Z35r3ekkQFixZQcwsZbPUBIFW_VRYMtE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03TAkVUNHAjUM0VB4vC0F5t5s3VEKYIue7cHcCjBjTlw&oe=69E63437"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLwRik21GU8Q7kNvwGYhIfi&_nc_oc=AdpMemFYls2g7QwOpK9Uvf83fQsBrSwycw08jI-6xKUaMkY0_kel-Q06OGiNxuYambY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zoXQ5dN-x0bFwhiIvydFc1uXhglnoexEDH0vZ7vXFEA&oe=69E6348C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvHKCLNPKDUQ7kNvwG5vP8q&_nc_oc=AdpZ13bw5FOAYmdYFAtB1M5oEXymmf5R_ZcneAbcepPEWRXYQreG_5CuNhESEBQzzzw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RpDlpUZkNU7Fx-UejYS7Ifu8dEcWfSbtxJKy2ygTZ8A&oe=69E622BC"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
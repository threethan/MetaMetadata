c=AdpW_gv76WA8GB_pXaqF-vaefd5s71bOL1EhxyqFBKP91CXsh-_zh1gaHc3i7MLrFw4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzYB8SbuqtwYrb47ZLKJbydO9DZFZdNJh50s56tAnj2Q&oe=6AA95237"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaxMnOoy5bcQ7kNvwHW6ZiJ&_nc_oc=Adr67t1ymcNCMpeZNc95DEKvBCrwOM4sAQFtO7tO0NKhhJ1V8cAxp5HkF7gzDelfx4E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjRNq3edvh7xiuJMW9an0pTHPA1pFUjftrG02bEt7-hw&oe=6AA9528C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWxdK_w84MIQ7kNvwE-a0mR&_nc_oc=Adq4R3ajGv4BFd5j82LvNHGwBFwRSEZcTJ4nXJ7obCPQ59As-W3MTnK3BtxNvkj_P6w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnD9lYtjxUTDm4dtFadDuwdANF4jKfaHHaOov_z9s9NQ&oe=6AA940BC"}, "display_name": "Reflecto Ray", "keywords": ["puzzle", "mirrors", "lasers", "casual", "relaxing"], "long_description": "Reflecto Ray is an engaging VR puzzle game that beautifully combines spatial logic with creative challenges.\n\nThe Journey: Humankind is under threat from ancient dark forces. To halt their advance, ancestors forged mystical tools capable of turning these entities into stone. These mystical tools depend entirely on power grids installed across every major city, and your critical mission is to keep the energy flowing.\n\nImmerse yourself in a universe of light. Discover the correct path for each beam by manipulating mirrors across wondrous environments. Featuring an atmospheric soundtrack, Reflecto Ray offers a perfect blend of blissful exploration and contemplative reflection.", "short_description": "Reflecto Ray is an immersive VR puzzle game combining creativity and skill. Challenge yourself to guide light beams to their final destinations by strategically rotating and placing mirrors in beautifully crafted environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27979893085028416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031609_760376671528451_4323330923784484937_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ee7QbY9gD5QQ7kNvwGtaTPw&_nc_oc=AdpL9BTiLNkI5TXw2BB55UXLnYvA_xBVXVuyVp0H2FOVNAhv-xJckWEjld4kl1QC8-o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXLHzkwnK1dnGsSbYDZRAA4PYVbuLaEYLEh9lK5KwWFg&oe=6AA94857"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Reflecto Ray", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1619203981, "lastRevision": {"nodes": [{"i
_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai8eS4LDxb4Q7kNvwGuq9A-&_nc_oc=Adrv-GJyuw_u1OzSVZIb4MI76XBl0uULk-WAywuiAniO5Vd3wRG_ZSI-qZBjmM90cm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxZdsSIp3xU6AgzDsgz2ZT59KwDHP06GvUx1ZsIWyafg&oe=6A6A0A37"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kye6mnWg_IkQ7kNvwEmG9B5&_nc_oc=AdqClLUrVeHd-362r6KCie58f-PU_VHX4Da_nWnepm19Oyzygf6rrdAMkLfgeBzgG9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbR7VfVuGKc4h9jERvuZiGU9POgnq_vcPUAfvdecmByQ&oe=6A6A0A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Cgc3dOALMQ7kNvwG711f2&_nc_oc=AdonY50bO5pe9nVkNnP69afT_hrbqNUoBSNIDS8NxldX5mJL25Yi0z91xw1C3ZB72E8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-8NT716u-aQcM93BrBK7c-gXN4tOgTlsEb6SdtI62ew&oe=6A69F8BC"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
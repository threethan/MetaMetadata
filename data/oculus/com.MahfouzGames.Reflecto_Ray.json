_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f43Y2D8d7eUQ7kNvwEoKFl8&_nc_oc=Adoh89xPV1PKCWnnP8CMLwL97Kx99TBW7LPvk6FtcnhHYsds9Fw9pem88mpVyFTXcOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2COGhNizIA0vo6GaCAaOt7taUPBj0G6i1Mo3CskoN8g&oe=6A427D37"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAnocAK3F4MQ7kNvwHY3UvO&_nc_oc=AdozxSACfmp2yPhG0UVX60Aywy-jE-dnzwlu6yUyhJDURyvhOA_lBysOEoFSAcLSXrk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fZQR64YEFQizU3eg8NX967JXMrJUTko2Bn1XG30TAeQ&oe=6A427D8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06smQFZl1dAQ7kNvwGK4Buf&_nc_oc=AdrNxyPNLaowab0QYHGHuEDsJi3vcD_lB8484-pIU0EGMf3E4R-NKjGaYPpScxQCRMQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RnLTRurdxSTfg0cXz5w_Q0JSgcxXBhz4841kaYbWGXw&oe=6A426BBC"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
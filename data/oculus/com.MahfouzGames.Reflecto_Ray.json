e_name": "4.png", "id": "891446871690183", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031331_891446875023516_7737393111703398969_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf2ptCH5caMQ7kNvwGyVA4E&_nc_oc=AdrNq0-GV95HHofBEOlPi3dUwIAxA6jSGeRzyvPopqYnO8vAUdVPUL0DwxY6Gs6ZlDU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFo-qfLGG9LEYm6Tzy0640_NcboKByJ0jCELpSLYbOBg&oe=6B083E37"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZflJutzrpqkQ7kNvwFLbX6K&_nc_oc=Adq4Qa5I_qnm9SiMQMJ6qPUHHGsTgwCSJUzThxafeP7JaWG9N8o1BbJ2tdnWuAdGhnE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYHppK0-hY0VcHwMzrwUyePszJKdZoo8MaDTm88vlj1w&oe=6B083E8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FODDXyFP1_wQ7kNvwEfYSro&_nc_oc=AdoMb-oj0cQB6_s7QYLdxRAqBCN8MMQbOBmAmAml8XgVqf0C2G-t9F10_IwwctHrxKo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMIfDnO5Qqny2wfcrd8J-haHCDGoOMFcNiKIYETCAMpQ&oe=6B0864FC"}, "display_name": "Reflecto Ray", "keywords": ["puzzle", "mirrors", "lasers", "casual", "relaxing"], "long_description": "Reflecto Ray is an engaging VR puzzle game that beautifully combines spatial logic with creative challenges.\n\nThe Journey: Humankind is under threat from ancient dark forces. To halt their advance, ancestors forged mystical tools capable of turning these entities into stone. These mystical tools depend entirely on power grids installed across every major city, and your critical mission is to keep the energy flowing.\n\nImmerse yourself in a universe of light. Discover the correct path for each beam by manipulating mirrors across wondrous environments. Featuring an atmospheric soundtrack, Reflecto Ray offers a perfect blend of blissful exploration and contemplative reflection.", "short_description": "Reflecto Ray is an immersive VR puzzle game combining creativity and skill. Challenge yourself to guide light beams to their final destinations by strategically rotating and placing mirrors in beautifully crafted environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27979893085028416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031609_760376671528451_4323330923784484937_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tuEhzzHoS4Q7kNvwGU1UQo&_nc_oc=AdrbWDLnTN6po4iqPmp1VnSJNvY1DbCK6TRWLseFSk68K36CKP5gdyLE85JOR4hw32M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTP5gC7atFsc7CdlrjGGgvdQT-JNK5qfBDcNGeTR1ZYQ&oe=6B086C97"}, "is_concep
Y-cVsAWWzxfInpogZqQ4RzSisKNpiostYiyZkl40ZDQfL95ow5vCakX0D8GwU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhxh4H5U5HS205jbM8i9Kh5mVfJUQiP6jdhwTdz0EEkQ&oe=6AF9BDB7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSxghcvfrQIQ7kNvwFkVcbL&_nc_oc=AdrS3MfQQlU_E-Kn3QwKhF5WWvc5l95RP47MrzRR_V4318D0h4nmEmnx4RXCtMyA0pA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaZpTUfYM5mAaWNXlanaSizZ6F5UKNiQO-KT4Ni3TMKw&oe=6AF9BE0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRKF3rsEv7MQ7kNvwFKMhXW&_nc_oc=Adoh47kGi-GTENXDN16O1gRq782qbYt0En9mSIrwjMZeJrApYbFDRo2r-p8v_rWjlgc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI55PCx0Npl9m7bW2mbBEEpbU1oZWHcoSbPCvRI7lcIg&oe=6AF9E47C"}, "display_name": "Reflecto Ray", "keywords": ["puzzle", "mirrors", "lasers", "casual", "relaxing"], "long_description": "Reflecto Ray is an engaging VR puzzle game that beautifully combines spatial logic with creative challenges.\n\nThe Journey: Humankind is under threat from ancient dark forces. To halt their advance, ancestors forged mystical tools capable of turning these entities into stone. These mystical tools depend entirely on power grids installed across every major city, and your critical mission is to keep the energy flowing.\n\nImmerse yourself in a universe of light. Discover the correct path for each beam by manipulating mirrors across wondrous environments. Featuring an atmospheric soundtrack, Reflecto Ray offers a perfect blend of blissful exploration and contemplative reflection.", "short_description": "Reflecto Ray is an immersive VR puzzle game combining creativity and skill. Challenge yourself to guide light beams to their final destinations by strategically rotating and placing mirrors in beautifully crafted environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27979893085028416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031609_760376671528451_4323330923784484937_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqVWG4vozxEQ7kNvwH_Gs1-&_nc_oc=AdpuDYcIrXOnvVOn4b6rjbziQ0d3RFDK-dKm0WYgAhF9YpBpcDpWnXYh8zhBnj5fkfM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIW4x0ulX1PaJibLeXAug4LMDGQcd-NHLIPEgYEk4c2A&oe=6AF9EC17"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Reflecto Ray", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1619203981, "lastRevision": {"nodes": [{"id": "1470151
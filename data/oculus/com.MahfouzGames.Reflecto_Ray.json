_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4rhZ34_0VkQ7kNvwGazEM0&_nc_oc=AdpFpApnxXOjd_rClEdTYD0UQhLytpoXOT42593zf8VpvXnmh3dI15Pi_ufA5ZoEUlM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXmL-Egya4lZo2ijyD4hg1PDvD9yaSjkRF6SSBGo59jw&oe=6A8C18F7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GauGLyasQoQQ7kNvwGw8UMw&_nc_oc=Adrlo5cJpUIsWwkxHz9EMLHVi1b-my4TIeHZWvPvj_DznMFgwXmyL-Tit3nvvGhAhQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq4j7r5kPC1_ow5I2UQOqCdSJl6-IVUd6nruMKANSoZg&oe=6A8C194C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgOGZ-AmDKIQ7kNvwFi2zmv&_nc_oc=AdoOEfStKTf8bkJEty1VsuzKarhmfVTXWmLh9Oqa63n3rfLx11umZH80mBPLnR_qR98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoosxDY6JiH0U4fk-Y41-7MBh1yN4e3LQ1W5-y0x4NGQ&oe=6A8C3FBC"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
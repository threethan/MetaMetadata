_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WURtu265AwQ7kNvwFazZfj&_nc_oc=AdpO0hLa-kplcFQw3C4FsdvGvgjSQw50umHo-Ufj8BHSrBOCgZJSvqnNH0UI69VFM70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NnoHx_XIx4SFvH_8mKAignSLiQLm6eZAwd2NggKeePw&oe=6A0486B7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Bwrz3LyonoQ7kNvwHTwEtZ&_nc_oc=AdqCUddBzz48slAqmQkdjwN3SbK5XV4vHHevolBUNmAHA-e2tbE4szVUiS-sjnZEcyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4esCWPQsN2Ne_qjLVYxTc7lhTZpgFrIRIHYMu8H9vwUQ&oe=6A04870C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tI4ruHjvaoQ7kNvwF1mKm5&_nc_oc=AdoYtKYd_5KurslUd61KXY6yIXjZ35pyqJ3muhkV97EjWYjy-WnbYeWcPJaVE3J1Yv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nn1QDF67A6tN7RjtL9UZfECsqr3rvr79UWdGqxeE0Tw&oe=6A04753C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
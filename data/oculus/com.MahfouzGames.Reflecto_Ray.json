_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQqYUqxfd88Q7kNvwG0H-nz&_nc_oc=AdqOUkeJ4RdiU2porfuOBo37Eu4owvV__LiZ_m_RIg5FPHFiWEnt7JxjTgm1b3JX2Xw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSpQ0n5g8zse20GxLCZfMDqtilJrcGxm-J3kSObcjcMA&oe=6A5E2CB7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rk7aa8zPUQQ7kNvwFhAhV4&_nc_oc=AdoKETqTh7dKhqw-E9EqrWhMNq9zxkj0bL1Qj64iCnvpM9pV98KriEvmvrPMNBWBrrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKSt8FaUBLWwnlv8ETtCPvr47sTqMZej7gs48uOP42Rw&oe=6A5E2D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enkyoEdc6E0Q7kNvwFmewhd&_nc_oc=Adqes-91Reos2QjomQUpjNAQDHPiM4gP0weaYLYOPTjxrgUk8oVwV0M-s22ppsTPIys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo_0KhLVrX1M1qyLV1LjnHH_2O-YwLhIAU-XKMj_LHoQ&oe=6A5E1B3C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection."
w&_nc_oc=AdrWp21Vp2tUeOtXvblspfHMfYqK1cM0XkbVgWWB24VTEX1bXSNrNBAl_XllD2dH3zo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PjSqckP6f9cfrfL-D6dnZU1QsZWmX1miMLPjgKo1wSw&oe=6A0C5881"}, {"file_name": "3.png", "id": "723406855209483", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974538_723406861876149_9141442931274739515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knKcoRJ9uD0Q7kNvwFxc837&_nc_oc=AdoTdpYbxrsijDRfjHwBl0pPlJ1u-pE69HklN8oCmKQo-CkKDt6GfqYPVXsIry31VXQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LYwgW41Dll6eK7yo16JpNS8FClvJSyKyMK_rIEP5fJg&oe=6A0C7DAB"}, {"file_name": "4.png", "id": "891446871690183", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031331_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5IUxcgrFI0Q7kNvwGnVY8v&_nc_oc=AdrtRjQnpAsJqYgEGWnQnUjqydQkDgkq_QaYEWBzH3ybosrKwStVTVg8hPQGVk0baqw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af596wWggNzu33Yrv3-C188QezP0-TdCAnP0iGCvpE0hHQ&oe=6A0C6FB7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFIFc02vlZoQ7kNvwGAXG4R&_nc_oc=AdrUyJSpoTouO2ncFFWAGoqVH6tsWUIkJuiPIuPTdxiw5V-p5FZkQ0p0OLbPA4qMk18&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wiOCdiDn00lX0HD7FP6faynAE5WyFxHwzeuhP7F7OBw&oe=6A0C700C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hAWWrJoXtUQ7kNvwEyEgBx&_nc_oc=AdpcfGupN3XNXtOrckiuXOhXIEa9V6ZFTSxLEbSlX61ElANSwoNc2Xdv7YQlQ9joapY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SEfz2cbdAcRMTROjhGfU9Jz0XiWYJv7vzCHfCKSg6bQ&oe=6A0C5E3C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection.", "short_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1594872964208529"}, "rev
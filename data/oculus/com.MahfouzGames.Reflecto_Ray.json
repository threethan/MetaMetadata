l&_nc_oc=AdrtNrIIuhQpm0xAkof_8zq7GKx7Dy_nrXyZ2FDzOsqNdF-FY-JIfiByB7WTbF8y2Kg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lbuAOZpmOy1nLyhUBBsZZPwEULrl7dj1knwBkcdy5Jg&oe=69DA3F81"}, {"file_name": "3.png", "id": "723406855209483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_723406861876149_9141442931274739515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOV6JwZRttQQ7kNvwEcjNIY&_nc_oc=AdrYGXpCWiJhQOpZr6eqGW06VrEHOiIFWKq37F5SRd50bUleY_tjLalognAE9dfFD30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07IIUCpsucSSGjfd9oo0lIPHyCguS-49SkXkeGoUAJIQ&oe=69DA2C6B"}, {"file_name": "4.png", "id": "891446871690183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031331_891446875023516_7737393111703398969_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6DItm3t3bIQ7kNvwFIWSaX&_nc_oc=AdpPHEPajIewkS02rDgNdjt1LfXG3IcNKWldpwW526okb02vira0z2GWwhkJptswi1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tZCJKR45oP_2H77Dj_tyssFKrq5tZyej6fF5clUrCGA&oe=69DA56B7"}, {"file_name": "5.png", "id": "251629596448732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031341_251629603115398_4627644975429027096_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMvz2WBvALAQ7kNvwFvngVI&_nc_oc=Adq3WGtEzTRwNIVJ0YQKBLA3SaR25i9zGUGOWOKAwMFM7ZYAJ_Wa-YXBwlpFXQnC574&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3diz3Aykl-jzktNPz50Dw-3vUWV3F6No8EJhSKLwuBxA&oe=69DA570C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster 2560 x 1440px.png", "id": "1352797435080963", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982701_1352797438414296_1844099213918639828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_5csQ4lnE4Q7kNvwE_5okK&_nc_oc=AdqsRbJdBxlb1blpnmbtDRHErtP9ABaQjSUWJjnoTM-d4ckkh-6H8vjkPy9BFb_xHb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UDeFmejlKA_d_Lyuu7Shf4kVqH9sMh6sDxSFghThvOw&oe=69DA453C"}, "display_name": "Reflecto Ray", "keywords": [], "long_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction.\n\nThe journey started when humankind suffered from devils. To stop them, people found a way by using magic tools that turned the devils to stone. These magic tools get electric power from power stations installed in every city and your mission to keep it running.\n\nImmersive yourself by discovering the right road of the ray by redirecting the mirrors inside the wonder atmosphere and engaging soundtracks that create a feeling of blissful exploration, contemplative reflection.", "short_description": "Reflecto Ray is a puzzle game that combines creativity and challenge with interactive gaming experience in VR. It challenges players to guide ray into the final destination by guessing the mirror's direction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8f9cb42a-8d78-4f6a-a2a0-a049446210ba", "developer_terms_of_service_url": null, "publisher_name": "Mahfouz Games", "support_website_url": null, "website_url": "https://mahfouzgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1594872964208529"}, "rev
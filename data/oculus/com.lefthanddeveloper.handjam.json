_name": "screenshot_2.png", "id": "944124158546390", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617729_944124161879723_4033764281278790702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-i3LYlbOSYQ7kNvwFb19lh&_nc_oc=AdqsyRojkjdJpQ0T9EH_GnBCIvLC1o_HRIp_B_uRMum52lQG5mzWD2AE4Tgup2JJz64&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXeptauAVOEAZfEeiXlkPlV_3K4upTvgOyufMht5ydsg&oe=6AF0A989"}, {"file_name": "screenshot_3.png", "id": "1754168005960727", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618288_1754168009294060_5987157576844092856_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA8MQxvfeCMQ7kNvwE5ESik&_nc_oc=Adr6YdKoq2EwGEbL-BvOp8jUdjpGOeudVCjOy_YcWdeIsFIZWmeRR7yzM0qXmA1uaIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdilgxaf9D87ldG1lZ3NF9FdwaF-NPbs0YQ9YPp-VpFQ&oe=6AF0B066"}, {"file_name": "screenshot_4.png", "id": "1297977331679982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_1297977338346648_5095293940807079290_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIsi7GcsNI0Q7kNvwEXhnWP&_nc_oc=AdoN0wTaSUUIVlPQ5sdyQDr8Rm3cQ7vbHIFhxZoJv73lm3X-KKFiIJjxMLkTOXTiTqg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdVonJbZRDCIYhYewOoX6BSm76T7zihzbZbkzmBu--iQ&oe=6AF0928E"}, {"file_name": "screenshot_5.png", "id": "26042612055413492", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617729_26042612062080158_4065481994166394288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjSo8QuAgtoQ7kNvwFdm7Ii&_nc_oc=AdrgQxahEan2mmXUfXLYzF1BTdiwGxfn4sB6t9mIeLcAiBWk247VCW-9d-yC0yLr5DU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAYM6iiFgguXnwcTBhCpugMVA1a8pt4l6pXMENqEdpSQ&oe=6AF09C06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_landscape_2560x1440.png", "id": "26367054169661985", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619832_26367054179661984_3156731276215233523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHdUXVu2Cg0Q7kNvwGTKMNR&_nc_oc=Adqn0nGk_U3DjBlDDTyFUYE1cc0Ub07MEOfsQl_KZ1yqcXzo-8M9G0on0Y7X3YUhj_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCWVQOU0nbDMiWgSI7pI-bVIXlaqr1f-aKtVbhUu64yA&oe=6AF0AA9B"}, "display_name": "HandJam", "keywords": ["music", "handtracking", "creativity", "instrument", "handjam"], "long_description": "HandJam turns the space around you into a playable VR music setup.\n\nUse hand tracking gestures or controllers to trigger sounds, switch instruments by moving through 360-degree zones, and perform with both hands independently. Assign instruments to different areas around you, customize what each gesture or button plays, and build a setup that fits the way you want to jam.\n\nStart playing instantly with a growing collection of instruments and sound sets, from drum pads to piano, guitar, bass, and more. Move through your performance space to change instruments naturally, then use your hands or controllers to play rhythms, melodies, chords, and layered patterns.\n\nHandJam includes a simple loop station for capturing short musical ideas and layering them into fuller jam sessions. Record multiple tracks, adjust BPM, set loop length, quantize timing, mute tracks, and control volume as you shape your performance.\n\nFeatures:\n\n- Play with hand tracking gestures or controller input\n- Switch instruments naturally using six performance zones\n- Customize instrument zones and gesture/button sound mappings\n- Perform with both hands independently\n- Includes multiple instrument types and expandable sound sets\n- Loop station for recording and layering short performances\n- Play in an abstract VR space or with passthrough enabled\n- HandJam is made for anyone who wants to create music physically in VR, from curious first-time players to musicians looking for a new kind of jam space.", "short_description": "HandJam is a VR music app where you play instruments with hand gestures or controllers, switch instruments around you, and layer sound loops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/handjam-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/hand-jam", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35561533026827800"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618277_1779853673421551_1997451853688756023_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9R8BEXadwcQ7kNvwHdog1-&_nc_oc=AdrzG_UiyvF7-UJPf0jdqBvRPeQBoj-X3utLyc6PFYtMD3ZvkllADtke9t9I4bR20OQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwHR4qw_Z6WKfW_Ar0Pghrl1am7SitIvZPYIUuCSfPPQ&oe=6AF087F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HandJam", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1777907340, "lastRevision": {"nodes": [{"id": "34941805048800604", "release_type": "SCHEDULED", "administration_status": "APP
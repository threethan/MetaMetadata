=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ2MN0pBmyuGHxUqL8L3YSSygrGypI5xXC5NVXfafzZIw&oe=6B0B29F0"}, {"file_name": "Screenshot5.png", "id": "419918172454168", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75441578_419918179120834_1708880889417358016_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DHh_Sdrhq8Q7kNvwEFOcyN&_nc_oc=AdoRFizLlpmZJoB0KeN7OAfKIzHLtl1bIEG8tkzQSPCI6Ug--Ctv1HvvuqM0coCgZhM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvCfjwcwAW1Xg7ffVe9G54J5IvRVj3le0_yRfyrsDHPA&oe=6B0B19F6"}, {"file_name": "Screenshot4.png", "id": "403794734215214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75411990_403794737548547_299464953777081165_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsttqDL4CLcQ7kNvwFjPqzS&_nc_oc=AdoyDX4pgU-LLtO8TWa15amwliDrktYE1hNtalYG5OZZBhKfVLDN1Z1EiK03pmqUqMs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTq6TUnQAOiQF9VhwKQI69ef5bldHgdlZkUAHIU9T2M3g&oe=6B0B25C7"}, {"file_name": "Screenshot3.png", "id": "284760513228106", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031395_284760519894772_1843418919124993955_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEei5ZHPylQQ7kNvwEUz4KA&_nc_oc=AdqHBdxOs63VkkrwHHSF62B0HhHqh6erHCAA9AmeqDL9QH4Yg-uc2I2m5YxfKFVv2W8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbHKqDUBMprz_0s5tPv0NdUBfpAu2Sc0tQXruLcrBr5A&oe=6B0B2FB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "434304991104746", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_434304994438079_7599022713565762144_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKxw-3VIKycQ7kNvwFGDR5a&_nc_oc=AdpODQfhlpARMEO4Y3dQY3mBSw18OCY1rgL-_P0bwKfJ6flsXXeqR3Itr_nRf7piv6M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3hK5vBJl_EGXvKfYCkpwhDFpe3JxBb663P-gitmUWjQ&oe=6B0B205E"}, "display_name": "Cover Drive Cricket Demo", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action! Play through several different game modes as you test your skills and try to survive against a wide variety of bowling styles.\n\n(If you've previously installed this app through Sidequest, please uninstall that version before updating as the two are incompatible - sorry!)\n\nCome say hi! https://discord.gg/rFUzN6xbmQ\n\nGame modes:\n- Super Over: Score as many runs as you can off 6 balls and try to beat your top score!\n- Spin Target / Survival: Face a fearsome spin line-up as you either chase down a challenging target, or just simply try to survive!\n\nFeatures:\n- 5 bowling styles (Fast, Medium, Slow, Outswing, Off Spin)\n- Village and Pro difficulty modes\n- Left- or right-handed batting\n- Realistic bowling and batting physics\n- See where the ball hits the bat\n- Wagonwheels - see where your shots went\n- Replays - watch any delivery back again!\n- Fireworks!\n\nFull version coming soon!", "short_description": "Cricket, in virtual reality. Have fun and practice your batting, no matter the weather!\nMultiple game modes, difficulties and bowler varieties to play against, for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
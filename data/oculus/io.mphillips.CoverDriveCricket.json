1-25/75441578_419918179120834_1708880889417358016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2vk6ZYikJkQ7kNvwGtZujC&_nc_oc=Adr5WV5fDk58rvuUPaIvYQNXC3gtHRAX0mPpJG8tJXkg_Wx6Rj7m8ZIfsqzkLjSX9q4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7Wmn7I9vbnyokexWVqjNyYooqpMse7jv3eSI_gWGy4w&oe=6A5F7EB6"}, {"file_name": "Screenshot4.png", "id": "403794734215214", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411990_403794737548547_299464953777081165_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=map6REc0UpgQ7kNvwGkLyFM&_nc_oc=AdoCaWj7MuB-o8zyRUEI5MVh7bDet4Ux8g6hOFLKsiYjZk3o6YWru28xjIbJ5jjIxOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDERYlkM5-HGfP3ji2ZY7dZ6JbtXyXUxFtkzDrkHE7_YQ&oe=6A5F5247"}, {"file_name": "Screenshot3.png", "id": "284760513228106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031395_284760519894772_1843418919124993955_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy0R6_NK5Y8Q7kNvwGjx7r0&_nc_oc=Adpf7fE7feNQA2r_PplYCB-kEYIxE3fyJOPoNRLt8enC2f09SEyH1jHwncIBukD1NIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDBW8XW-_SWvJ58sAg3k3p760ZMA3GYYNk-dYDyFiC6w&oe=6A5F5C37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "434304991104746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982464_434304994438079_7599022713565762144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEgUB55t2mgQ7kNvwGfA2Ex&_nc_oc=AdpktX6T-cPjrbiI20BZ7WZjtUqOSWlrm3bVCVrU6A9n5DCYs_3KN503AajY2XLmO08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMbKDFtZnkfRlpCR8yEALVZR5vtOFQOfbRqN65T0eRGg&oe=6A5F851E"}, "display_name": "Cover Drive Cricket Demo", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action! Play through several different game modes as you test your skills and try to survive against a wide variety of bowling styles.\n\n(If you've previously installed this app through Sidequest, please uninstall that version before updating as the two are incompatible - sorry!)\n\nCome say hi! https://discord.gg/rFUzN6xbmQ\n\nGame modes:\n- Super Over: Score as many runs as you can off 6 balls and try to beat your top score!\n- Spin Target / Survival: Face a fearsome spin line-up as you either chase down a challenging target, or just simply try to survive!\n\nFeatures:\n- 5 bowling styles (Fast, Medium, Slow, Outswing, Off Spin)\n- Village and Pro difficulty modes\n- Left- or right-handed batting\n- Realistic bowling and batting physics\n- See where the ball hits the bat\n- Wagonwheels - see where your shots went\n- Replays - watch any delivery back again!\n- Fireworks!\n\nFull version coming soon!", "short_description": "Cricket, in virtual reality. Have fun and practice your batting, no matter the weather!\nMultiple game modes, difficulties and bowler varieties to play against, for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1027840324466785"}, "review_messages"
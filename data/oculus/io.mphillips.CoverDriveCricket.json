scdn.com&oh=00_Afu2PL2Z5s1b-2pAZ_F3lISxJPfyZJrE2P8phdJWemI9mQ&oe=699849B7"}, {"file_name": "Screenshot2.png", "id": "449381309805101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367595_449381313138434_5996937064514005622_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QokCOKKSMLYQ7kNvwGKjGSQ&_nc_oc=AdmB9KOEHeeibJu6EUo82hXBCah_cfCcD_Jcn1rHnOj7e7UbN8k6pnRGPusDKBox6X0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuk7NRKw1gEti9Di0O5tx4W0obI_EMRnEFXtVK39Suz3Q&oe=699843F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "434304991104746", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_434304994438079_7599022713565762144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB_ZJEpLUxUQ7kNvwHpJ3xE&_nc_oc=Adm8aGZmZbQ101W-ijwtZ8KVwhMGJjo7eaz-0QnzRilf7s8i3EzGjd4lQUOSOd087dA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuA21whZC24n0Ef1q87Ef79afV-mMKHklLakpE9tEFb_A&oe=6998729E"}, "display_name": "Cover Drive Cricket Demo", "keywords": [], "long_description": "Demo version\n\nScore as many runs as you can during the super over and try and beat your top score. Play against 5 different bowling types at either village or pro difficulty.\n\nFeatures:\n- 5 bowling styles (Fast, Medium, Slow, Outswing, Off Spin)\n- Left- or right-handed batting\n- Realistic batting\n- Bat markers\n- Wagonwheels\n- Replays\n- Top scores are saved so you can try and beat them later\n- Fireworks!\n\nFor updates on the full version, head to https://coverdrive.cricket", "short_description": "Cricket. In virtual reality. Practice your batting against pace, swing and spin, no matter the weather!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_t
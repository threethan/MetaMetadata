=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_hQznwtb7PMG_Z5HXN3jaWNE_xjjWsTIWFw3bVwDjOA&oe=6AFF1430"}, {"file_name": "Screenshot5.png", "id": "419918172454168", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75441578_419918179120834_1708880889417358016_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFkSQU4H8LkQ7kNvwH-B4DS&_nc_oc=AdpLtefkGoXaZ8o1VDZrIcJJ1WUGqWdNd3EpzHeUyYL7cNL8Pa9aXWs24A2rg1gshwU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgZ9i8aXHVBBf_RYKxzuNsSXskZHAlW5GUbw7KebnXLQ&oe=6AFF0436"}, {"file_name": "Screenshot4.png", "id": "403794734215214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75411990_403794737548547_299464953777081165_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwpimL-D348Q7kNvwGEuK41&_nc_oc=Ado9UYwXq7XafOj6FiwMGbr3nKverTgiQdON2oz1iXVMGdGhWFOsDRvYnthi_j2rJc0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlShPMq660-_oW1fYwtZQSB2OEcfu90xby9csouQUaxA&oe=6AFF1007"}, {"file_name": "Screenshot3.png", "id": "284760513228106", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031395_284760519894772_1843418919124993955_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79BzplkZhVkQ7kNvwFwiRhw&_nc_oc=AdoBPD1Wjbc0IIeypfiYQ6mGi0_vwUKD3LmQxlatyQw-e9Cv9efRXnK1Z3KhHQ8GvcE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKDLaECuE_8HltoyQuhwyuGfqzT2EBm1B5T3uu2u9tmQ&oe=6AFF19F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "434304991104746", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_434304994438079_7599022713565762144_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Cq0r8qoldsQ7kNvwGD9aA8&_nc_oc=AdqHEyk-2N15LhIZRbfzW-o0VXVnsWGYEPG2Kkd6U82W3Qe5BzNe1VCK0Uz9Wd6HddQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6dRQIXNqh_2hI5X1xCPFPq4TcG36BpM4DT6eBrXFyew&oe=6AFF0A9E"}, "display_name": "Cover Drive Cricket Demo", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action! Play through several different game modes as you test your skills and try to survive against a wide variety of bowling styles.\n\n(If you've previously installed this app through Sidequest, please uninstall that version before updating as the two are incompatible - sorry!)\n\nCome say hi! https://discord.gg/rFUzN6xbmQ\n\nGame modes:\n- Super Over: Score as many runs as you can off 6 balls and try to beat your top score!\n- Spin Target / Survival: Face a fearsome spin line-up as you either chase down a challenging target, or just simply try to survive!\n\nFeatures:\n- 5 bowling styles (Fast, Medium, Slow, Outswing, Off Spin)\n- Village and Pro difficulty modes\n- Left- or right-handed batting\n- Realistic bowling and batting physics\n- See where the ball hits the bat\n- Wagonwheels - see where your shots went\n- Replays - watch any delivery back again!\n- Fireworks!\n\nFull version coming soon!", "short_description": "Cricket, in virtual reality. Have fun and practice your batting, no matter the weather!\nMultiple game modes, difficulties and bowler varieties to play against, for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
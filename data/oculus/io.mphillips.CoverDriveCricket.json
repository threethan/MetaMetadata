1-25/75441578_419918179120834_1708880889417358016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZUNlAvhgpEQ7kNvwGPgbF0&_nc_oc=AdqtP-txv_GMv0FcUGV0SNVM548jxtA5et2H-2TTWEafX3zi-BNV4InE07uS48VmNPU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ER9uoMw2w0vBzdrcXrreCeDbYmVN0OvDFxkFCZbxXKw&oe=6A1064B6"}, {"file_name": "Screenshot4.png", "id": "403794734215214", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75411990_403794737548547_299464953777081165_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vn8lSEEvlAQ7kNvwF7NuDx&_nc_oc=AdoHVpGk2kM_bJYOVeOZNgKZbSxn10lNBvrm7E0UFTsteo8EI41q9nfuzDeR5IYlm9c&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W4Oz6Y5KvRvPVYU3ojl_9gOyMQ9tGynAmCpZnH4PKaw&oe=6A107087"}, {"file_name": "Screenshot3.png", "id": "284760513228106", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031395_284760519894772_1843418919124993955_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qdh7g_R8J0Q7kNvwFskIrZ&_nc_oc=AdqZo8Y6AW4uB845TrPXWdYUV2GXK1S2bEXtj1c_VeFk9u73o57Fix075pLL0wY21ow&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U6Ls4vtsEvb8M5CnENrfTSgTy8Y7g-KGwM0B3czO79A&oe=6A107A77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "434304991104746", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982464_434304994438079_7599022713565762144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4qWYGFpeZ8Q7kNvwHVrHCv&_nc_oc=AdqnnaNv9IIJJ1p-625mDqKW_TwhoCQRtz8Td9Xa69gTWdcAvqtl3P-hJsljUGbORVg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LVJVRLI_uiLaRXtKn3Tp8tW2sjT0xFA3opYjhYJ7Ysg&oe=6A106B1E"}, "display_name": "Cover Drive Cricket Demo", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action! Play through several different game modes as you test your skills and try to survive against a wide variety of bowling styles.\n\n(If you've previously installed this app through Sidequest, please uninstall that version before updating as the two are incompatible - sorry!)\n\nCome say hi! https://discord.gg/rFUzN6xbmQ\n\nGame modes:\n- Super Over: Score as many runs as you can off 6 balls and try to beat your top score!\n- Spin Target / Survival: Face a fearsome spin line-up as you either chase down a challenging target, or just simply try to survive!\n\nFeatures:\n- 5 bowling styles (Fast, Medium, Slow, Outswing, Off Spin)\n- Village and Pro difficulty modes\n- Left- or right-handed batting\n- Realistic bowling and batting physics\n- See where the ball hits the bat\n- Wagonwheels - see where your shots went\n- Replays - watch any delivery back again!\n- Fireworks!\n\nFull version coming soon!", "short_description": "Cricket, in virtual reality. Have fun and practice your batting, no matter the weather!\nMultiple game modes, difficulties and bowler varieties to play against, for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1027840324466785"}, "review_messages"
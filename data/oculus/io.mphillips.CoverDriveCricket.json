=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY93-qKA5OpEJxrh8-Vf40bowDtSo3qUMWj6SkcbBPGg&oe=6B01EF70"}, {"file_name": "Screenshot5.png", "id": "419918172454168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441578_419918179120834_1708880889417358016_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4uLy7dnorYQ7kNvwED2OCM&_nc_oc=Adpjs2iJ1fgDXHjmYnmgJWrqx33N87iQpocGwHD2mvFYfs_znET2T4i0IWSSkXTX35E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_bgSFm2mnK8wmHk7BiBxDBrlbwzPeowe3vTCDkvRacQ&oe=6B01DF76"}, {"file_name": "Screenshot4.png", "id": "403794734215214", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75411990_403794737548547_299464953777081165_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shyJnYkdie8Q7kNvwH8bqqX&_nc_oc=AdrNQkBi5C3rKvssk6717ZSiUi6x0XUDL9BTWJKvdlZNb24P1CXOEmB0GYvBV0kTn60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxdL4ceJIvTuAHenUnZpww-PeQGT4aa_iFcX5TtwnMxQ&oe=6B01EB47"}, {"file_name": "Screenshot3.png", "id": "284760513228106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031395_284760519894772_1843418919124993955_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Amj7cDA0QkQ7kNvwGastO3&_nc_oc=AdpPP5yrVskeWAsuBmtRssT_po7Bb6hI5-TB3lW1r6y9ev8cTqGhwihS7iAnLtyfiWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEv3FaZO_7v77gyR6Nz5uBQkJn8vAnjHix6RWfVu-sgg&oe=6B01BCF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "434304991104746", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_434304994438079_7599022713565762144_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Cq0r8qoldsQ7kNvwE2n3gs&_nc_oc=AdpFOs1mfUYdkuXHaO073vyT_WdJTLRlNZ_yvIU-gplzJQYaxK4YO2LQvqleXrMiDog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9ppeDVpNjSIYhVEpM_Kvn2zb3XQ4Nq2vkml5gQ60hEw&oe=6B01E5DE"}, "display_name": "Cover Drive Cricket Demo", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action! Play through several different game modes as you test your skills and try to survive against a wide variety of bowling styles.\n\n(If you've previously installed this app through Sidequest, please uninstall that version before updating as the two are incompatible - sorry!)\n\nCome say hi! https://discord.gg/rFUzN6xbmQ\n\nGame modes:\n- Super Over: Score as many runs as you can off 6 balls and try to beat your top score!\n- Spin Target / Survival: Face a fearsome spin line-up as you either chase down a challenging target, or just simply try to survive!\n\nFeatures:\n- 5 bowling styles (Fast, Medium, Slow, Outswing, Off Spin)\n- Village and Pro difficulty modes\n- Left- or right-handed batting\n- Realistic bowling and batting physics\n- See where the ball hits the bat\n- Wagonwheels - see where your shots went\n- Replays - watch any delivery back again!\n- Fireworks!\n\nFull version coming soon!", "short_description": "Cricket, in virtual reality. Have fun and practice your batting, no matter the weather!\nMultiple game modes, difficulties and bowler varieties to play against, for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
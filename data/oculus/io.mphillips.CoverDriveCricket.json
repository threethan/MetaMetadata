=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwHRcc1BZngJmIIH4LHGZR2U97zuScNtlIxHic0CGRbg&oe=6AFDC2B0"}, {"file_name": "Screenshot5.png", "id": "419918172454168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441578_419918179120834_1708880889417358016_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFkSQU4H8LkQ7kNvwGLIOAI&_nc_oc=AdpXqEXHTz8y7BJbTK95buJ_4uWlEclNpLPjbvkAWFfhaxIiP2teqhkXEaXjC67Ifqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPZUrG_XglobelLN6CudlyLSosiprwnPAyHJrfMrnNag&oe=6AFDB2B6"}, {"file_name": "Screenshot4.png", "id": "403794734215214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75411990_403794737548547_299464953777081165_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwpimL-D348Q7kNvwEEKBbg&_nc_oc=AdrIGv3yK5Lb_iKDK5vTdenoyFPUITwS1XyrjdTXcFGj2GR_K1xIpO3EswDHEF90FLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT90VoeAVqKqES-HkxoEmlFV_7T5x5KYmbcIc1rzI-HPg&oe=6AFDBE87"}, {"file_name": "Screenshot3.png", "id": "284760513228106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031395_284760519894772_1843418919124993955_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79BzplkZhVkQ7kNvwFEbqae&_nc_oc=AdpwjabsiPKJkQ_Muzp0lw2xCAXvehwJJGqhh4mpfk07jIBx7EXDfn4f6EgT4-3qW98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQImiFC4CCHnZT-Aan8tazu_B5pwtSQLVmbZZvyQIIwEQ&oe=6AFDC877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "434304991104746", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_434304994438079_7599022713565762144_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_RPdQdOONQQ7kNvwGhhHBD&_nc_oc=AdoO3JMcxzDetVsRfO6kfhuC1xVz7oWw3ODCw-ttlTHvQaoKNnfHuQyu2CHTzfP77Lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6t4Z0QfnLQJwFzeUQ5aq1axeo3--CKwWLrFYAB1WqXQ&oe=6AFDB91E"}, "display_name": "Cover Drive Cricket Demo", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action! Play through several different game modes as you test your skills and try to survive against a wide variety of bowling styles.\n\n(If you've previously installed this app through Sidequest, please uninstall that version before updating as the two are incompatible - sorry!)\n\nCome say hi! https://discord.gg/rFUzN6xbmQ\n\nGame modes:\n- Super Over: Score as many runs as you can off 6 balls and try to beat your top score!\n- Spin Target / Survival: Face a fearsome spin line-up as you either chase down a challenging target, or just simply try to survive!\n\nFeatures:\n- 5 bowling styles (Fast, Medium, Slow, Outswing, Off Spin)\n- Village and Pro difficulty modes\n- Left- or right-handed batting\n- Realistic bowling and batting physics\n- See where the ball hits the bat\n- Wagonwheels - see where your shots went\n- Replays - watch any delivery back again!\n- Fireworks!\n\nFull version coming soon!", "short_description": "Cricket, in virtual reality. Have fun and practice your batting, no matter the weather!\nMultiple game modes, difficulties and bowler varieties to play against, for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
bRw&_nc_oc=AdoaOv37cj_PnerS9uyAcFBXkhn2qcF_ZoFR0rUvjgGXRWwbUqsWdSEBYzWL36NtiNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpR5AffT0ie9QSsi_uTO7oMkEQnOEk4EQ6BNp7X0ahsQ&oe=6AB930A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "654949474_1500769354444249_8112912882233640379_n.png", "id": "2002301710495514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_2002301713828847_442752045952213657_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPWUWfhePKEQ7kNvwHL4bW9&_nc_oc=AdqjcYKqmvMyNi0b6eRpClwbbkCIKyB5MWexrNWyAy1jUBoNICVfm_I5Vj44UcIY0HE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQJ-xrIDG8cjVHKpqjz9_sy55Yg7bGOd3V9DD2MCqL2w&oe=6AB93CA9"}, "display_name": "Moonbase Bravo", "keywords": ["Multiplayer", "shooter", "extraction", "horror", "Games"], "long_description": "\nI've permanently reduced the price of Moonbase Bravo. I want more players to experience the game, so I've made it easier than ever to jump in.\n\nANSWER THE DISTRESS CALL\n  \nRemote outposts have gone silent. Creatures from an unknown world have overrun the outer colonies and the surviving colonists are running out of time. You are their last option.\n\n  Deploy solo or squad up with up to 3 friends. Navigate infested planetary bases, locate survivors, and fight your way to extraction.\n\n  FEATURES\n  - Solo or co-op multiplayer for 1-4 players\n  - Extraction missions through alien-infested bases\n  - Physical VR weapon handling \u2014 grab, reload, fire\n  - Voice chat for real-time squad coordination \n  - Multiple difficulty levels \u2014 easy to overwhelming\n  - Room-scale VR, Optimised for Quest 2 & Quest 3\n\n  THE INFESTATION SPREADS\n  Each mission takes you deeper into infected facilities where alien creatures hunt in the shadows. Every corridor could be your last.\n\n  Actively developed \u2014 new content releasing regularly.\n\n  CAN YOU SECURE THE BASES?\nEvery mission is a fight for survival. Every shadow could be hiding danger.\n\n** Please message me on Discord, if any bugs appear Winston#7337 **", "short_description": "Creatures from an unknown world have overrun the outer colonies. Fight alone or squad up with up to 3 mates online and fight your way through this sci-fi horror infested game to extract the survivors \u2014 the Darkness awaits.\n* New Update*\n-3 Levels now included\n-New Lobby, its now so much easier to find and join your friends online\n-New improved fog, aliens now bleed, dead people included."}]}, "developer_name": "Mark Harris", "developer_privacy_policy_url": "https://gist.github.com/Winston-7330/90c5d6ddeb91e04a48d92a6a1b12535a", "developer_terms_of_service_url": null, "publisher_name": "Mark Harris", "support_website_url": null, "website_url": "https://www.reddit.com/r/MoonbaseBravo/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "27550785264622832"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1514409026578310_8361395627085376692_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCN1sffjiBoQ7kNvwEchoa8&_nc_oc=AdozjMeY-kSGbit-djEhe1CCXM8in7knW_PdkHm0ildB7EEV5Dk7vKWMQyis3cwSUuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=
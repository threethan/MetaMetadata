41574784430_3432530340691785652_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J54z7RE4NDwQ7kNvwF89x5E&_nc_oc=AdqOuM_q2nq0ZoVULuPm51Brw_xnMhX_vhq7tSladCJXlvvJ32fnQkj-zDDExu_Th5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt_uueJuUnjOgTT2XNJGtq0kapheZkGMqR_v7fMIkoXw&oe=6AB936F4"}, {"file_name": "Screenshot4.png", "id": "1698644331314899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604328314_1698644334648232_8522755239036955947_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WktClSpk6VcQ7kNvwGSKq1e&_nc_oc=AdqsmNeti7eVl4wlzhHcAydBqtwq8bxnC5f4HOgg2K88lCbMAyGoCFNUnpEib5Dg7NU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn5feXkbMmL2yiZBceFzQr4e85mGAx6M5P9LJfOM6sOg&oe=6AB91606"}, {"file_name": "Screenshot3.png", "id": "1639066157150083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_1639066163816749_6511470314166868390_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XntbpfeBqa8Q7kNvwGFdP95&_nc_oc=Adox_lPZOF_r5QgLeflq0iFazZZcbj-ks_RucHOsTrfDNdu8mjPLwxG2iKXl29auIyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUWvwmd3eGXSWnYLz5GFx8YaHKZrl7liMW9pz28UENlQ&oe=6AB92823"}, {"file_name": "Screenshot6.png", "id": "2178072962974463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_2178072966307796_6785374092253321931_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZKa_SCj6EcQ7kNvwHJwbRw&_nc_oc=AdoaOv37cj_PnerS9uyAcFBXkhn2qcF_ZoFR0rUvjgGXRWwbUqsWdSEBYzWL36NtiNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpR5AffT0ie9QSsi_uTO7oMkEQnOEk4EQ6BNp7X0ahsQ&oe=6AB930A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moonbase Bravo", "keywords": ["Multiplayer", "space", "Aliens", "combat", "fps"], "long_description": "**ANSWER THE DISTRESS CALL**\n\nAs an elite operative of the UEDA (United European Defence Army), you've been deployed to the outer colonies where communications have turned from routine check-ins to desperate pleas for help. Remote planetary outposts are under siege by creatures of unknown origin, and the colonists need extraction NOW.\n\n**SURVIVE TOGETHER OR DIE ALONE**\n\n- **Solo or Co-op**: Face the nightmare alone or team up with up to 3 friends in intense multiplayer VR action\n- **Room-Scale VR**: Fully immersive Virtual Reality experience designed exclusively for VR\n- **Realistic Weapon Handling**: Grab, reload, and fire your weapons with intuitive VR controls\n- **Voice Communication**: Coordinate with your squad using integrated voice chat\n\n**THE INFESTATION SPREADS**\n\nMultiple planetary bases have gone dark. Each mission takes you deeper into infected facilities where alien creatures hunt in the shadows. Clear the bases, secure the facilities, \nand extract any survivors before it's too late.\n\n**GAME FEATURES**\n\n\u2713 Intense multiplayer horror survival for 1-4 players\n\u2713 Quest 2 & Quest 3 optimized performance\n\u2713 Multiple difficulty levels - from Easy, manageable to overwhelming infestation\n\u2713 Strategic team-based gameplay with voice chat.\n\u2713 Immersive VR weapon mechanics.\n\u2713 Multiple planetary environments to come in future updates.\n\n**CAN YOU SECURE THE BASES?**\n\nEvery mission is a fight for survival. Every shadow could be hiding danger.", "short_description": "Join the United European Defence Army and face the unknown in this intense VR survival experience. Team up with up to 3 other players or brave the darkness alone to rescue colonists and secure infested planetary bases. "}]}, "developer_name": "Mark Harris", "developer_privacy_policy_url": "https://gist.github.com/Winston-7330/90c5d6ddeb91e04a48d92a6a1b12535a", "developer_terms_of_service_url": null, "publisher_name": "Mark Harris", "support_website_url": null, "website_url": "https://discord.gg/2Nswuggq9", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cate
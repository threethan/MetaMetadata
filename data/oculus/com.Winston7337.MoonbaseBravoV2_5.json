ExihRrsVtapr1NHnetOgzWfSoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VC1QONdYpVXBFchc0xQlPfBoX5-sFKQeOwhRbc3e7Vg&oe=6A1EE8A3"}, {"file_name": "Screenshot6.png", "id": "2178072962974463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_2178072966307796_6785374092253321931_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvFIoflyXfcQ7kNvwEaWRcf&_nc_oc=Adr0hYwbwwryb5Vi288VOJBPvOOTJ287hjCHOz9BOd30iT1XAxY9X00s9QXzgP5i5bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mhR0a_pM9hmYRG9hOOxBcy2HbxFjtaBDvDw6D-500Ng&oe=6A1EF123"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moonbase Bravo", "keywords": ["Multiplayer", "space", "Aliens", "combat", "fps"], "long_description": "**ANSWER THE DISTRESS CALL**\n\nAs an elite operative of the UEDA (United European Defence Army), you've been deployed to the outer colonies where communications have turned from routine check-ins to desperate pleas for help. Remote planetary outposts are under siege by creatures of unknown origin, and the colonists need extraction NOW.\n\n**SURVIVE TOGETHER OR DIE ALONE**\n\n- **Solo or Co-op**: Face the nightmare alone or team up with up to 3 friends in intense multiplayer VR action\n- **Room-Scale VR**: Fully immersive Virtual Reality experience designed exclusively for VR\n- **Realistic Weapon Handling**: Grab, reload, and fire your weapons with intuitive VR controls\n- **Voice Communication**: Coordinate with your squad using integrated voice chat\n\n**THE INFESTATION SPREADS**\n\nMultiple planetary bases have gone dark. Each mission takes you deeper into infected facilities where alien creatures hunt in the shadows. Clear the bases, secure the facilities, \nand extract any survivors before it's too late.\n\n**GAME FEATURES**\n\n\u2713 Intense multiplayer horror survival for 1-4 players\n\u2713 Quest 2 & Quest 3 optimized performance\n\u2713 Multiple difficulty levels - from Easy, manageable to overwhelming infestation\n\u2713 Strategic team-based gameplay with voice chat.\n\u2713 Immersive VR weapon mechanics.\n\u2713 Multiple planetary environments to come in future updates.\n\n**CAN YOU SECURE THE BASES?**\n\nEvery mission is a fight for survival. Every shadow could be hiding danger.", "short_description": "Join the United European Defence Army and face the unknown in this intense VR survival experience. Team up with up to 3 other players or brave the darkness alone to rescue colonists and secure infested planetary bases. "}]}, "developer_name": "Mark Harris", "developer_privacy_policy_url": "https://gist.github.com/Winston-7330/90c5d6ddeb91e04a48d92a6a1b12535a", "developer_terms_of_service_url": null, "publisher_name": "Mark Harris", "support_website_url": null, "website_url": "https://discord.gg/2Nswuggq9", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26486848564349846"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "968134049428073"}, {"status": "PUBLISHED", "id": "1504239904578024"}, {"status": "CANCELLED", "id": "2159166658344857"}, {"status": "PUBLISHED", "id": "973877335393667"}]}, "baseline_offer": {"id": "1504239904578024"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781204400, "status": "PUBLISHED", "id": "968134049428073"}]}, "liveChannel": {"nodes": [{"lat
51089_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KRaJLaYPBQQ7kNvwEIfr0A&_nc_oc=Ado-pMX6gKf8BRsUHAhpMSdE7L9XvY8AxkdTq-6eC6hxY9a712njBT7p3DsABo_uBfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV_-w6ceLqfHO03Ou3qH_ASwwcMg1BmTJon-v-Witm4g&oe=6AFDB31E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hollow Haunt_ Flooded Village (2).png", "id": "1019214444535233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1019214447868566_3264063551208679254_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKq4mwcMxC8Q7kNvwHIdHj4&_nc_oc=Ado64BlECNS-kXOElrQ1fPKRkQr_utql2ac5oAE39h3X8P_K2-NEJ6D0IdVixH8g6fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxy3D-K_Z6uOo63nU2jFpNcnpanh6sVSwDJs958GZfUA&oe=6AFDE230"}, "display_name": "Hollow Haunt: Flooded Village", "keywords": ["horror", "survival", "haunted", "escape", "scary"], "long_description": "Hollow Haunt: Flooded Village\n\nYour vehicle breaks down near a remote flooded village, forcing you to search for help.\n\nAn old church stands in the distance, but the village is not empty.\n\nAs you explore flooded paths, abandoned houses, and ruined buildings, you discover tape recordings left behind by a former resident. Each one reveals more about the flood, the village's downfall, and the cursed Priest who still remains.\n\nThe Priest can appear without warning, sometimes watching from a distance and sometimes far closer than expected.\n\nSoon you discover the truth. The curse has trapped you inside the village.\n\nTo escape, you must uncover what happened, find the objects tied to the curse, and break the Priest's connection to the village.\n\nFeatures\n\nExplore a flooded abandoned village in VR\nDiscover story-driven tape recordings\nEncounter the cursed Priest\nSearch abandoned houses and hidden areas\nFind the objects connected to the curse\nBreak the curse to escape\nAtmospheric horror and spatial audio\n\nFind the recordings. Learn the truth. Break the curse. Escape.", "short_description": "Explore a flooded village, uncover its dark story, and survive encounters with a cursed Priest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nvarMxOut94_ypyFSkCfL8Ek6uu_mGWFui_7SuIk_Is/edit?tab=t.0#heading=h.67re301ttfab", "developer_terms_of_service_url": null, "publisher_name": "FunAxis", "support_website_url": null, "website_url": "https://funaxisstudio.github.io/Hollow-Haunt-Flooded-Village/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1457276334133238"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1442672660528796"}, {"status": "PUBLISHED", "id": "1551287137040210"}]}, "baseline_offer": {"id": "1551287137040210"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1442672660528796"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1457331114127760", "version": "1.3"}, "id": "1074660698711381", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
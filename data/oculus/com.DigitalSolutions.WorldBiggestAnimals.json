f&oh=00_Afy1Bokh8M0369njbffYrzcCFc9USrdfZX5md7KR-NYIoQ&oe=69C93350"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rErivfBaGwQ7kNvwHDMCPb&_nc_oc=AdrCyKeFfbxomdaXK15xKpDECiZvvTE4dzWJxFMUMm5fpnxPaQi7fX17AU-ZWIZEgOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIfgMG5ncYTImC0NTguk5OHNQzZN-bsMnThnA4W8W3qw&oe=69C90ACA"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kHTfRMujhQQ7kNvwE3Rsxq&_nc_oc=AdratZY_-YN4oFRGhQ2fUoo55BTKOGJLrQnB0gqHvEByyR2EyYDItrpaIpg2-C3P1QA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxviV7GLWknpc3-zRuEVOb04McuOdGvDXNBzAtvd-NUIQ&oe=69C9351B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qp5wG4qwW0YQ7kNvwG5g65y&_nc_oc=AdqjEebtZdxyGp6ofev3ZeGDM5uzIcHgp_2pg62fzXebCNzR_63DsEo-gk7Vk4Ifjas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBuP8FFNN-96sV88R-avAVXCIPwJXrc8gntZ3PISKbDA&oe=69C92266"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_de
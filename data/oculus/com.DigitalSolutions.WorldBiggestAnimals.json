zjToLPjppUtBlRmL0g&oe=69BAB2D0"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w8J1MSIWggQ7kNvwETS_Rm&_nc_oc=Adm_fRFNvlvGuELkJCtSahuU-HeehmPZWQxSr7Q4IfJoekxqUyfxK3V1VDRezQzjnow&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMMjRZ3EIKBvGNOQwELqPC11NyLc71FUwD22I0qSjtQQ&oe=69BA8A4A"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qu91Pup2s0Q7kNvwH8YSZ0&_nc_oc=AdnvJwdy_whyDDQuTbZtjNqzypKbrTFKvz_5fV9S-U2XUT3SEhrzI7XalmY7LuHaT_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZLuRi1mjCXSZn7IXwumsxRtgOanr1CcJxPUmhqIDeKA&oe=69BAB49B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27e7oquBNY4Q7kNvwFsSNXf&_nc_oc=AdkPM6_5A_py6oyDxRxkKRdwzi16ne2X9un_rgEo9Ixom6gpoiEkyqsjZhS8nYz1mHo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwO5zh3y3JDRLv4T2Y6LAo0Jmdka20CTKEUSA2bOCMeXA&oe=69BAA1E6"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspir
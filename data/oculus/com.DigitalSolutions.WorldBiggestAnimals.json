IXRVIbMhVsEBTAxN4w&oe=69BFF8D0"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8KKOBec6XAQ7kNvwFlHeXD&_nc_oc=Adm2zrKp2FV7yAnQR40qGT_9rLbAsHltWUK9m67TGEvD6HzA62EDd9KPN1YaW86dEIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA0fqD6Q2_4IeY5_1pLR2A0cB0bFSP0Au9Zg8o6ivxGQ&oe=69BFD04A"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vqt59atfOCAQ7kNvwHQI9WN&_nc_oc=AdlprIbYpTp3cMYGjgwgkzlp_DmxhRurVTW8zq0Tgdz7RQDhh4cqLi80oLeVsuKeE58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyx9hRWqoCHkmWt5HdE29Xhmt0JtkvAHYSg5iqtDbkH-A&oe=69BFFA9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWYD9Uq7WecQ7kNvwFUjRQG&_nc_oc=AdmmGwjs7iS_Pw1AAIxP7XFdGyT09sZ0rrs5m4DabQ9cywWxS-elU0oDY0cpouUyPeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIlbdbrwZhuYREl2_u198_qFLfY4HYg1LDbhw11lShPw&oe=69BFE7E6"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspir
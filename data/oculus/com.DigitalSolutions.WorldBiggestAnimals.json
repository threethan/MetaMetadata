f&oh=00_Afx9IdBa4WMp588suBVXFxZnppQu4GWp0_OThYGa_cRnbg&oe=69CFCAD0"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThUW8JJogncQ7kNvwGpzcS-&_nc_oc=AdrtrWRE-Zce8oc1kJfT6VRFbUWr1Pl2B79fm9GGiFIWRwJ-hn6gApRiOuUxSxrifFY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkQCVwkt39XTCa68MNuq-EtFK4PQFU3z7bKiAol3lktQ&oe=69CFA24A"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nvh584vhHQYQ7kNvwEWDL8H&_nc_oc=Adq7IXTbLZWnxEeWWo2c6unZ1z6rdB132sGWhte6HRgmF2WV1Rfx8XzCpr97ARkN0Bs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrPzZdbwLuFqhD2Jv8nTWsRJOI0fY6di5Uxqfg3QEPgw&oe=69CFCC9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wD-IO5RPmcQ7kNvwEfaoFi&_nc_oc=AdqybOsqetSVGuCzvjDrRyS4TUEQTKfFJ90mqM7ISVo0gSMIaFCFKrlKrzgu8sb_tSI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7Qie-waYFep1OkNzu621mwu5EEudbYwWm13RaId7K3Q&oe=69CFB9E6"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_de
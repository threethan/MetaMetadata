G-wj8yvLsoORqH64CA&oe=69AC3250"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtQaEX13ZpQQ7kNvwEoUgcN&_nc_oc=AdmNRSPg8jZkI6xCmvEBgKSGorsLdffv2DnyvCRRgAp-7bScyWwqw_zn7OKBuxtf95k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5bmHifun7ELfjS5rTIb9K1WZi-n_Fea5-4hDJq_u8Jg&oe=69AC09CA"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzSMCDLS7loQ7kNvwG-7mMP&_nc_oc=AdmJPZVmC0x2IQ6lJO384pVvQ18CvcMqKG-Dzk1MdPWoqzshyVOFB6plTftRcsec8MY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8A7dzchLCb9IkuFgGzGvskWMUHNLzld4Eg0giZWOd-g&oe=69AC341B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIyUbFzrZZsQ7kNvwH8I80V&_nc_oc=AdkILXP2sFCRJHP26vFoa4VOYuemY3jAMX0-KsPe8tPaC29x-DeqpB4ffK8MKGDcgd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfycoWAT2Li5Q8_1RGqGz2MZc9cAeCItGoOfXtvt6emE5g&oe=69AC2166"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspiring world of the largest animals to ever roam the Earth. From the gentle giants like the majestic elephant and the colossal whale to the agile kangaroo and the towering ostrich, this VR app takes you on a journey through the habitats of these magnificent creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26384436844525717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618472_1641377363955848_2988586294358857907_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CxEq6L8GZ0Q7kNvwF5EEQd&_nc_oc=AdmsRoPxGeOp6YDBnKHW_hNUUB6nFMPd64TimpqxMpD1KOgPLWiQQwc_F6Zg_IW_n10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyLF-AJVfAhqW6HKKT0hKVT501a2nnGSub_SEWPGht_Q&oe=69AC10E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Giant Animals", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", 
f&oh=00_AfyvC0DhOPSZSHARdniNZb9j8Juhfd4jMh8TS5RP-lv07A&oe=69CA84D0"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU9_Xr81ZW0Q7kNvwF4tmGT&_nc_oc=AdoRbK1BH_8PX1Ly2rKNrj9C2pZkmHAdG0ytQE2SMDHfQEBe-P5DHLxMDzY9jx8lQYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqfycuH3qxatzGifl2WvX4fMJ7QAZRpwK8EvYor8H8Dg&oe=69CA5C4A"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kHTfRMujhQQ7kNvwG3ukBt&_nc_oc=Adpc7TcLxdbJJCEDTvPCizi34PC5cFopYk8osvxpjyf-Nnca1y51_DgkeDDOPI71f7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYlFmjb3O02MqhEoNaaLGQ8lQBCc5ogzg8fPzhxeSzrw&oe=69CA869B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyKlF07MMOoQ7kNvwFW3gsA&_nc_oc=Ado9gPTuUQ64H9q6NeRcTLx5W_p2IxE55Saidbd7rLL8cwE0STSd390OTTl8Fg5HQAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSKGaX53J16TL-IBxz4dldPAkpUQVjHuYdNy8xsPJwNw&oe=69CA73E6"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_de
dL60tkQdzcqzuU-uZ-zF3P_dDQq-fUtCNw&oe=6A4930F3"}, {"file_name": "Ostrcih.png", "id": "1698958547762344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1698958551095677_8812680965840727038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYCZZQRV4XkQ7kNvwGg36Lz&_nc_oc=Ado9NPruhPPT2bq91TZ1smYS2vnFNSRYm-mOKGeWnWIcCmiONZeBOD2igV6pw6MchPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJyGAHDhR3CTAxc5Z_u84Nd4U49GfePod1cW3pqk9Zyw&oe=6A4929DB"}, {"file_name": "Bear.png", "id": "1251814400479135", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1251814403812468_7194116731611068573_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oRXiZp6oycQ7kNvwGG0VSF&_nc_oc=Adp24KnqquKSxjHkSDY38bwqiQWchx6rO0GHc7JpAwmCzHitixBlRx0oJam3Ho_WkG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCtCbM_O46HPHXTZlZY7rmj0tWXBaEAG_cKCu2SPzXIg&oe=6A48FC84"}, {"file_name": "Giraffe.png", "id": "899187019607809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_899187022941142_1854664518239486303_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmnIJ4BaYr0Q7kNvwHjx82d&_nc_oc=AdpB4-6A0bBuIzyLcfXheAgBFJIMdDERfobvHzA6wu3_YjGf2LVhJF2GlEKtoqZy2_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjPp-i669lSCxe6C5KT5FOSg3vLtAe8WQjMNmXiZekVQ&oe=6A4917D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNZialZ3anUQ7kNvwFGbeYh&_nc_oc=Adrdnu7Rhx2dnW7cA_EvxwVqr1by8rcFhsTHoL15X460voxhkJs83Wy2Dh01XEGinXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmSW_LcMaxjJEOySEP6RBJWJpWf-WDfKCvRzeOvVPSFA&oe=6A4903E6"}, "display_name": "Giant Animals", "keywords": ["animal", "giant", "biggest", "whale", "elephant"], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspiring world of the largest animals to ever roam the Earth. From the gentle giants like the majestic elephant and the colossal whale to the agile kangaroo, towering ostrich and the wild bactrian camel , this VR app takes you on a journey through the habitats of these magnificent creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27183755387927188"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1641377363955848_2988586294358857907_n.png?stp=dst-png_s360x360&_nc_cat=103&
f&oh=00_AfyYupLpwgzR3b9FnAyDdQWtfLkmSR89k8eTttDQURTtIg&oe=69CBD650"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU9_Xr81ZW0Q7kNvwEr_u3p&_nc_oc=AdoeybZjVk-HNIz6hjqs9ZzfFaThOPu--ovTrkAzNMdFL8vj27JycFVNDAXYbquCVSk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx64DJxB9CqAvlpdoWqfa8RoCc3AplS9FwLtqtxJvk4g&oe=69CBADCA"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYRGOf9IzfkQ7kNvwEuqQ0k&_nc_oc=AdrEiPWyRxtFN6IXPmh-KEhtsgWmXn2TKha2ttIWBUgtbZjoiV0EaKnrD43OfJTAZ3M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmfVud2d_RJPrNZnEl64EQjaEPnES4gPj2IDDm7fsYwg&oe=69CBD81B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyKlF07MMOoQ7kNvwHM7Qng&_nc_oc=Adp5fkRe_61cDV3fx5k7e2DJWsQGObCL6NJKwOr_RMg22N0CgNkTopLI72Ym8Hk55pw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8R6faj9xBmuv1hQ4dec0qp68Ig2rEdk3OdvDmYmbnkQ&oe=69CBC566"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_de
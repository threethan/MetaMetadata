uQjRH2J4JvaQDTf4MvlpgoBxQRhBn6d7IcGdNHeo_yU1oFPkDgs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIJDIV4VkOyqY3iLDNhrsosJCTzEyIZlJIJCRIt2RXYg&oe=6AAEB473"}, {"file_name": "Ostrcih.png", "id": "1698958547762344", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617831_1698958551095677_8812680965840727038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYBfTcvUjlQQ7kNvwH_m_TX&_nc_oc=AdpX437g4ASbMS2NvPyoQMXMckjfQxy2THCj-oZaB5a1St1EgcfIu3jDeTpwuWrJJ9A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVNA5kzlwnHOW6QpRh0DDmAmRV2jgOG5tPwP5c34k-Lw&oe=6AAEAD5B"}, {"file_name": "Bear.png", "id": "1251814400479135", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618444_1251814403812468_7194116731611068573_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dYp9bswXmcQ7kNvwEzfwo9&_nc_oc=Adpu9AO-6RzbXkCSpyHECh83Y8w5Mum7l-iu0nV5PuevaU4t4E1bOoaURSj0DiFnY2M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMnaKJ5hqllDqM2_XqRL9IYR1ki8EYSChOvzY1T6e9LA&oe=6AAE8004"}, {"file_name": "Giraffe.png", "id": "899187019607809", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_899187022941142_1854664518239486303_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MmGWuirYJ8Q7kNvwETHPrZ&_nc_oc=Adr0OSUDkXiFPtldTBf3jcTEzN3WTwH3PpZikDY815bmbCtPz8FYdiCYofZEwtd8PpA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtCX82oMgRUAorbnx-EmhXvW0bKkQc3a1YuQK0pZgbJg&oe=6AAE9B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyxRUxcpdXgQ7kNvwFdhR7R&_nc_oc=AdqSeJEEvT7hoxM2r3byiRfbuy1eAl7Gku0jgnxISIw0NcozF7nKObz8zvHMgd3Nyeg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7kUjzivOSZf2BYEN-v_6dVLqoODDt5wTCogLanKHixg&oe=6AAE8766"}, "display_name": "Giant Animals", "keywords": ["animal", "giant", "biggest", "whale", "elephant"], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspiring world of the largest animals to ever roam the Earth. From the gentle giants like the majestic elephant and the colossal whale to the agile kangaroo, towering ostrich and the wild bactrian camel , this VR app takes you on a journey through the habitats of these magnificent creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27183755387927188"}, "review_messages": []}]}, "cover_square_image": {"uri": "https
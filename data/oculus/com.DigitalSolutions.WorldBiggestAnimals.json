Lv-IB20Wtlssr_S7Hg&oe=69B17850"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiiVu3bh1TQQ7kNvwFFOEl4&_nc_oc=AdmRcIqZ0-wRGJhDM4yYBufuO1DyY6c9_SCvpz3_tSyKI3iKx1unxctgo4j0X8yNjHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjQQiBQpbE2T7E3Ur_2FQBGsFYYg1O6nfO9a45uc09BQ&oe=69B14FCA"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COUrD8F3sDwQ7kNvwEbnLzo&_nc_oc=AdmWsT7WIWKp_KnAnrEsRnbuOTX2tKX_jtTNoHvAmgK9BNgBJFk4wo0zWvtG9ZAnDCM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8wD_uGZkZ8OD8vyK_vCBkGkfEUTQFMjfRdIQrOJRXyg&oe=69B17A1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmU1zZUb9mEQ7kNvwGdGmWA&_nc_oc=AdmXUpvMk94O4u69TDe3t4gpDUR4BDKaU63iTKaYiyvYFAascziBLno3tFTG6qu5btc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQEEe0wcmxgxCdvDoke6TObGJ4WjWoUgrYDJ7FYvGB7g&oe=69B16766"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspiring world of the largest animals to ever roam the Earth. From the gentle giants like the majestic elephant and the colossal whale to the agile kangaroo and the towering ostrich, this VR app takes you on a journey through the habitats of these magnificent creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26384436844525717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1641377363955848_2988586294358857907_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHm-7LbFCBYQ7kNvwEK7WDF&_nc_oc=AdnL--pIGij04l1PKgeMVprpg6zCaUvM17i1U5hTnKlzaB9r0AdeoTuDUypHfenZPKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEjpQLb311rDxO4nmVnv1C0Xm9sdwDKqXOzPGxEiY79w&oe=69B156E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Giant Animals", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", 
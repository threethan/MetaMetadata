jSm1ewW_2rJlqSJfkg&oe=69BEA750"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8KKOBec6XAQ7kNvwEuwyIG&_nc_oc=Adk9p3wmWNboz6W5wn-7674v7WEgzoIeulWzYMTYR49JLVUGWQKEHS16fVjlPRHDJz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzljBvdG-liRRGwrIviRW3RPS6WZLb52koZ2KmY4ITL2g&oe=69BE7ECA"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFqpVMRIFXgQ7kNvwEWy-C4&_nc_oc=Adk6aEYBdETU_gwpk81XwUUGCEqD4W9yQIoG_Chpwy68YvmeO2sieI8jQhnHg7Fs3S4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8BKafbFhec2qg4cnGaJeOpdtNcujBLvvkT2UjsKp0cw&oe=69BEA91B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWYD9Uq7WecQ7kNvwEwC6rM&_nc_oc=AdlQItfbNEAlw1cKCb8_2wQv1yVZivtYcPpfJ9naiZlD-j3-zHJ61F9olI8qWL5bnGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5zFQiUvjfckJh_coY6zrGFyKLNvurup_zqNBA_Wk22Q&oe=69BE9666"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspiring world of the largest animals to ever roam the Earth. From the gentle giants like the majestic elephant and the colossal whale to the agile kangaroo and the towering ostrich, this VR app takes you on a journey through the habitats of these magnificent creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26384436844525717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1641377363955848_2988586294358857907_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI1pqeCxljoQ7kNvwGz0hO6&_nc_oc=Adkrhv8_7bi00kkW1Xsf0LR2mLwKCmdWxPg9DVfA6V7HRyXIwSLpYXZ5Zxe2cc8Fdvo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi5hTneFoW_FJij3YReCDMMwPR5-hmT32i-odpqDAmow&oe=69BE85E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Giant Animals", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", 
f&oh=00_AfzdBQjbqJK6kA8HJ4bpAakCcqVDcNsbGXatLOy31lop8Q&oe=69C29BD0"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KrzEaFdmkcQ7kNvwHFLCQL&_nc_oc=Adp2PSGKn0dyS66jdfArcIW7go-po1vjwROMam1mV0BXJbdtfMVVQS9MvM6NENe9d4k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHRUeswpu_QJgGNolIyukSyUHILPbUdwQbsMAfuNCGsQ&oe=69C2734A"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vqt59atfOCAQ7kNvwEDcVPe&_nc_oc=Adr2HrhUAqNsx6vZAw9HhBYIy1SIWxKvOuHZ9CAc8D9GZESJg4zuno4x1Nh15KDAysA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnmxU39zCzURiHEBSXu06_vh9NLULqYmAitWgxiJ0_eA&oe=69C29D9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV5YfivYf0EQ7kNvwFrXRsD&_nc_oc=Adq6Iy4ogXLZ19Nmpq5MxMZ5DG6o9-LiLC3QGCXEnZn7PaZznVtuVlP1GvcbQbY4eV4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxP6Tw5gA3WD3MNpB0hjt82i8CeCP942vw_d1d_uCBXiw&oe=69C28AE6"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_de
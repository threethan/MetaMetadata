IB_0OXgOC070uIq1HCXhtybLEb33I0Etyg&oe=6A2D4933"}, {"file_name": "Ostrcih.png", "id": "1698958547762344", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1698958551095677_8812680965840727038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGlSWufdlC8Q7kNvwGc45cV&_nc_oc=Adod4IH1DjSnjNw7nx9SxDTim5ZZ8-n6fCLDH2n3n7lCn8q79SWzEL1laFLe3-P7Pi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cjGpZ2Q8DJZqNJqeYDfvYrl2Z9ZKwQMyPRdHxFkoTWQ&oe=6A2D7A5B"}, {"file_name": "Bear.png", "id": "1251814400479135", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1251814403812468_7194116731611068573_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPgkYFWZvswQ7kNvwFbwofe&_nc_oc=AdqHvsNY52RNMC6utNhveixJ_OZbEz_HO8h7qY-nLW1Zc3el48udMcMnNUX9p_ZLd9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uI1us4m42kf1e9Pa_IQOr_IvE0JHOItAv0LZ8P6PTYQ&oe=6A2D4D04"}, {"file_name": "Giraffe.png", "id": "899187019607809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_899187022941142_1854664518239486303_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IZF-0-ZoDUQ7kNvwFMlkF2&_nc_oc=Adp9LguC6JldEwH674EHNcz8o3HuoL74wksHB0oIAnM2qiPHqLSpppVLeV-Kll2qcSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gU-6ZQFiOuhCm_maMD6iNBVKPwYv9d42rGNhOaGh0GA&oe=6A2D6853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYu3EFcuN8oQ7kNvwEBBEck&_nc_oc=Adq62F3ogm8FGlTSq5n9IKMs9ZRPMK_9o7-eMNBh4ook1GC_pa2UcWaZWgK7oJIMLNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vUL9aTOcgPHfDXqqD1siGeRATeGisJuQ7HbBubAPttg&oe=6A2D5466"}, "display_name": "Giant Animals", "keywords": ["animal", "giant", "biggest", "whale", "elephant"], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspiring world of the largest animals to ever roam the Earth. From the gentle giants like the majestic elephant and the colossal whale to the agile kangaroo, towering ostrich and the wild bactrian camel , this VR app takes you on a journey through the habitats of these magnificent creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27183755387927188"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1641377363955848_2988586294358857907_n.png?stp=dst-png_s360x360&_nc_cat=103&
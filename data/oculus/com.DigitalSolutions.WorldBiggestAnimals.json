8ol_hQOkDLN3R-1s9reimmJsXj45kUylMQ&oe=6A26E9F3"}, {"file_name": "Ostrcih.png", "id": "1698958547762344", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617831_1698958551095677_8812680965840727038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noDK_5lFgwcQ7kNvwFAaJLY&_nc_oc=AdqUpm3z2Iu2RlYlHoVqlpdSHAci7NhZzV005IRNfRuhyor5dIjg3umNd3W5y1NCA90&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m8J4l_g9eIUkYfkSo9cHgvnp8W6ylsTbj9mi8PghFsA&oe=6A26E2DB"}, {"file_name": "Bear.png", "id": "1251814400479135", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_1251814403812468_7194116731611068573_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2w4Qn44qaAQ7kNvwEKbly7&_nc_oc=AdrX37kD1sdiK3AN9cal-MI1Xh-hdbbNodu9MQnclxyvlToILK6VVA2o4agAk8pia58&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SaUkPv50NxKhc0G9vGasC3TFZbgd7EdvwvJkpQElkHA&oe=6A26EDC4"}, {"file_name": "Giraffe.png", "id": "899187019607809", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618444_899187022941142_1854664518239486303_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eileJvgv6y4Q7kNvwFGpttV&_nc_oc=AdrJHwZznw5-migNJcavkxz_TINVfj0r2jqInipEfz-tA4BAS2ghPAslbeZrm-c9W58&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RrQpeVtHUAE8MRnEgSDUFHf1rOxg4Vvhu5ESnjRnUbw&oe=6A26D0D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW-SUgV6BYwQ7kNvwH2utX3&_nc_oc=Adpp7H8EimgvR0Yj8S28KhKZJqI02jlAUO0wCfS4AsiFXye7xjtKBnofj7Fn_EkJh_Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tJgft_l9uJGnKhQofl2rYgZH4z9bjz_B3eI-nJafilw&oe=6A26BCE6"}, "display_name": "Giant Animals", "keywords": ["animal", "giant", "biggest", "whale", "elephant"], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspiring world of the largest animals to ever roam the Earth. From the gentle giants like the majestic elephant and the colossal whale to the agile kangaroo, towering ostrich and the wild bactrian camel , this VR app takes you on a journey through the habitats of these magnificent creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27183755387927188"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618472_1641377363955848_2988586294358857907_n.png?stp=dst-png_s360x360&_nc_cat=103&
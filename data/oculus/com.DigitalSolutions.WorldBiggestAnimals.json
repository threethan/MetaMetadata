fmXX5qZ4OqpxEZKFp5dTuvkP7zSt77SeOQvZ5Klg&oe=6A859DB3"}, {"file_name": "Ostrcih.png", "id": "1698958547762344", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499617831_1698958551095677_8812680965840727038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-B-5w59s1sQ7kNvwG7E2Bu&_nc_oc=Adr-J6cWFE92NMJVmbG2LR45LPdz038zowez2lV7gRj92ii-k6B0dN-GkYPHGTcD8f0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNhtV8DnzUroW76sdsP6qjY0ET1j1XUrt2oFn1WnHzQg&oe=6A85969B"}, {"file_name": "Bear.png", "id": "1251814400479135", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618444_1251814403812468_7194116731611068573_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfm7A0t7uJAQ7kNvwHsrqaJ&_nc_oc=AdobK9gnpkzTn25_YSlJL4qt7Q45QjOAeRpdrkwUeB9j9h2ZqmqQeiCjgsZh-h9Ye-M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExXQFR9_q9u_Ouvl-IguLI7OvNxg10gGqQ2Eu-0qNzCg&oe=6A85A184"}, {"file_name": "Giraffe.png", "id": "899187019607809", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618444_899187022941142_1854664518239486303_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E2VmTCiG9gQ7kNvwE4VDoj&_nc_oc=AdpxH7UvTAXCKkKAF-wka_CHJrUDdBwZtRsWmxuCqAGKzpey_ZJwUutl4lN5rhksvAM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfED8oLPH-XF6j1zj9KlXuMtDfH6U8yfoeL6GgrhGHVw&oe=6A858493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMuNlE0a3gYQ7kNvwF6TXBD&_nc_oc=Adr3tReaMuUJZjcu_BZd5R1QEnx35GhopWBRxl2UAO89QQfgfS-oUEBU5Ynw24NJMVU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH--mkZdm6losF19I-OJxYfTbBEllODd0WDUrmV2DKZw&oe=6A85A8E6"}, "display_name": "Giant Animals", "keywords": ["animal", "giant", "biggest", "whale", "elephant"], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_description": " Immerse yourself in the awe-inspiring world of the largest animals to ever roam the Earth. From the gentle giants like the majestic elephant and the colossal whale to the agile kangaroo, towering ostrich and the wild bactrian camel , this VR app takes you on a journey through the habitats of these magnificent creatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27183755387927188"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618472_1641377363955848_2988586294358857907_n.png?stp=dst-png_s360x360&
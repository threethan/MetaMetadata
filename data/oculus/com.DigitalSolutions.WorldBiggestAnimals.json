f&oh=00_AfzDr24Rr9XmDzRheIA38tR9w3BPiGlwwUGFiiXxqgUCjQ&oe=69CD27D0"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU9_Xr81ZW0Q7kNvwFmSVZY&_nc_oc=AdqTaYJvPo-WGD4riH58sYjmVefLdGZckbheZLe25tAI01wHv-LkJEn025Jx9n1i1Q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdVtSB-IR1zN7oIpdB2hz_WLtXXNcgZcvPArOL35_xcQ&oe=69CCFF4A"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYRGOf9IzfkQ7kNvwHkqQeZ&_nc_oc=AdoTpJ_WWxMZ0CJIZYtMFkZoAz9U_GyYytaUo2EkjRyuMnGJVaf1Y8gKs32FovRXb_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtrdyRnoJ2ujm_0zXUHHx5FeC01fGW7tbolDy1yWHGvQ&oe=69CD299B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyKlF07MMOoQ7kNvwGQIct8&_nc_oc=AdojPwZ9g4ez5JUl28lA9lK6H5_2TNcjlSJi8U5ezRzwLc5qE1mq2f-wS_IcM9ja7XI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxugTKmihkFfHLaY62PXsFAWpNKdXLwUXv-Os6-vaaegQ&oe=69CD16E6"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_de
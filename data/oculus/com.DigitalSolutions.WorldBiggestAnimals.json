f&oh=00_AfyCFOEbvhm4kKjaJwYRNtCmFHHcAprUfQIHlj7KOIa5_g&oe=69C53ED0"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KrzEaFdmkcQ7kNvwGk0LCc&_nc_oc=AdoGORate39hvC190iYZkB6OtJVntVI7H-qP32qfyFQiu1-eJ6rYINvyTbTNcFyS8Fs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-E6yqFrlJViaucDdB132kyVUh38otsfvm43c3uwYLqw&oe=69C5164A"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvqo5jdeOAcQ7kNvwFh2VVk&_nc_oc=Adr_OkJG7vnrsKu8WHXwMkX2YXdzld7K7LMKzq2pGBb7BivkOCncK6hNjpBBuDKlMIg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhgwGNQnajHxOmb80k9prT3NL6fDp2xcaonU16EXFw6w&oe=69C5409B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV5YfivYf0EQ7kNvwF_6X7W&_nc_oc=Adpk6pXDws1sJixUOjLAIIlhBnnHFx7fbHnMhlB7Ux3wNC0-LyrXIVe2Y6hycYk1_Eo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwoy6Q_AIblmQT_47ByXguqKICCvZWPVJwJV2eerR4S0Q&oe=69C52DE6"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_de
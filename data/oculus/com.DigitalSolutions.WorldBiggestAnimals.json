f&oh=00_AfxLDU1pU_nJPD6XbI-DQh3Mc8PhSeS7F81sZKEyoFF-JA&oe=69C3ED50"}, {"file_name": "4.png", "id": "790211632487065", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031340_790211635820398_6437391553166419644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KrzEaFdmkcQ7kNvwHca8Yg&_nc_oc=Adp_VEnbwsOgOuxccBeXa2nHmsG3n58jIG53_kGNsj0b2QyFMe0UBF8rjkI4S4xtMO8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKIepNaGk4U_l5-40vwfUqnFYv4SO7lRxGY7FPmEurzw&oe=69C3C4CA"}, {"file_name": "5.png", "id": "718060913735361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035406_718060917068694_1271612091639701484_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvqo5jdeOAcQ7kNvwE71Rw2&_nc_oc=Adrr4vbFfslh61Tdl7LO2uogPDFt4ATk0ENxLUl9YcvwNYSqiFx6Z7L1A_9BAdOoe8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAsTpvAzyWsLn_DgcNeVw2D6-wILbPk0fnhquAy_HH4A&oe=69C3EF1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "340969025645211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569475_340969028978544_321298285756797051_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV5YfivYf0EQ7kNvwE6-39X&_nc_oc=Adr554aPWX1n7g5iB1vBSdHxJ6w3ttDRVFesJVZKLHpBuionY4xB2hjp_HL6cR4isKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfWnlKo8Er5LDGSOclJZPF0cgD_S7yvg5vSvaXoRo8hQ&oe=69C3DC66"}, "display_name": "Giant Animals", "keywords": [], "long_description": "Explore their natural environments in stunning detail, from the ocean's depths to the vast savannahs and dense forests. Witness these animals' sheer scale and grace up close as you interact with them in their virtual habitats.\nWith immersive visuals and realistic sound effects, our app provides a one-of-a-kind experience that educates and inspires users about the beauty and importance of these incredible creatures. Get ready for a virtual adventure and get close to these giant animals in stunning VR.", "short_de
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZ63KtEBXIUQ7kNvwHu-smx&_nc_oc=AdrPRygyrXMfxO49JGVgnbHenj_t7w98p1x_IN2eC57IhyMSi1LPQ_H7CTHs2Uu3gCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLynl_dBZJlGD6sRAvBdc1vUR1ukTeib1Tq8BOJRqTarw&oe=6A986372"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcdLN0he5KoQ7kNvwESCiN5&_nc_oc=AdppjmUyxj2xzKM-e0DPxr6zJP5-Vf4jf_9oCAxglO3X-MiyJflzgxZHwjp1r7pwsHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKMcxSUU6pOUjQC7b1YwYSoTrjSsHPZ7eyAskGHCto3Q&oe=6A9863A4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPsdg7QXhaQQ7kNvwEwS3_c&_nc_oc=AdpizPLqYaG5uAq2WUfhGJ6XGbLjcummAFaxSkVw-fI1ki1s4F0NDnCfspEhM-vV_JU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVyhr5Po-_5gpbUq_X1gbf7FNoMrF_YcDxg_Co-xejyw&oe=6A986835"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPy03mGiUuUQ7kNvwGk85iv&_nc_oc=AdoAHSFuOMhVV6_4eK8q5roR3aRL4WrFgube-CRFRMp7IFZo_oyU1aRW7dias7xbz7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu9ZlGfbYvdp_Y91GnXjN3jk_FqrTIxgQ93NHeLygY0w&oe=6A984982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rrrfCWlgY4Q7kNvwHsHldF&_nc_oc=AdrrRec18yGzDPf-C8SlFkJqRbiPO8z_2ucv9lTSrymMGHXsEfxt-uJh9gA_jpZuoEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRx6lTFPIHUjCLpCWYeUnQgYZBHqcyP3ZId8S-qXpuNg&oe=6A98618C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
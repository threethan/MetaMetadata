60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W__o6mPj8nQQ7kNvwF15U4o&_nc_oc=Adp0ba1OcAp0JfjChQgRrVu4An1qv4gltPKBEvXRpHysZ14RTuU76dBGTwi2qyd34eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8i5KKQWBhsGg1AosruJGbSciCXQMpxOeHH6h1mq4RHQ&oe=6AC109B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0XXvOBxks8Q7kNvwG4zj6Q&_nc_oc=Ado5BDOXu31rc2INx9PPB31SH1ygJpN9hzrBZzPOmRxVx-eqX0zoOe1eQBB5tkZ1ock&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcCEbDMROeoPrpOZMu-iUi_3qPa1W-qyLa-B1Aht21Tw&oe=6AC109E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAOpfWQhbPcQ7kNvwFiliUY&_nc_oc=AdqsMAx6WKRin5i5bJku2moZox6_6flSsjcZA6rXA5KyAfY9r8828THtOYdvtrDytMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5MIjqxYzLxeDAknpG7g0LpbZjz4V_QJxhT1mBss-N7Q&oe=6AC10E75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsxAvBsoeswQ7kNvwH_BrZm&_nc_oc=AdqKpkFzF5yupmtXQxIOQGiBZTmr12G5eJ8PIx1OPM4cAWBdzKkuFmzzTR3DOsuT3Ug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAALMHwOVpX3WQjn5aqOHsL1JIpSeShgsKBqlwSmKsYg&oe=6AC12802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y37WFxMS4NYQ7kNvwFJUl5R&_nc_oc=Adrhd7LPLlzIY8Bj1hL-vR72NE5T8p9F6mEfLXKgu_saKssv0SI-MQMK8JgVA57Dc24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1dtLAJtsRtvOkAxzK5_sox2Zel8DeEVeRb-UVxZRhKw&oe=6AC107CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
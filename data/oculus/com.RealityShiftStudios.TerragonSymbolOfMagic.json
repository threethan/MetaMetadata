60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1-6oKZCM4gQ7kNvwFLopcA&_nc_oc=AdoNsLzUtpIlCfpyYEgokFciuKT5Q_53_Z9_4ghhXP0Pj__SDaOIh7LK8OiKAVQVDAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLK4GZA1iK2wcVjsF1dkK0RKm7l_kndNqApWmfemDk6Q&oe=6AE1FF32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R4JncN6u28Q7kNvwHQVFsu&_nc_oc=Adq7TRZD8rIgEytFtdUVPWB_w6fcNNssTEi2NUvPzzLc-yC5O7pF1_v9NGBiPKOWbck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeTobD6G9gMuYUrAZsdIHamlIHp922GYaEfwRKtujSwQ&oe=6AE1FF64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-uyXIE-IrIQ7kNvwEhKRAn&_nc_oc=AdqrhhpRTbW9p8bqHh99sbayEf8vXGzGZEL8-dbwL9gy9NgKyheKXg7UiPMDq1PaJjA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg4y9ct0YfWUu9uVXHrANEeknvVxUoNy3JKZE-Agne7w&oe=6AE203F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z88hrDfHZrwQ7kNvwFAlfvq&_nc_oc=AdruKvMJj47AY4hSW8_bfO45GCgm7Ghs9LvRNjtL8sVPwArMCvq8J-fnRMziGwO05Jc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOERrbAmOYUG6O0YUEpA2-mh-isJRcOLhKNBI7_Ujy3Cg&oe=6AE1E542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKyF3ggQhUAQ7kNvwGKQact&_nc_oc=Adow0eZdcFnqqMWsj_uysYTvxTmJZX9KctA92sQYFeQJt2BcCRolS82YP5BYxP86I-c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpaVlkKe_QOi0VIu3p3ixal77bbZ_fslaLVOclApZvAg&oe=6AE1FD4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
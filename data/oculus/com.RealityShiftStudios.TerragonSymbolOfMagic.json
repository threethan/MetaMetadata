60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5J799n2ZTwQ7kNvwH7yZBp&_nc_oc=AdqtMRdBvEUcxxAGtiJXw6aigt0YHKV93B_Mz4W64sRTYObXOdNg4wR7_SFsH5RVy6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv4xqsEyboM1KkH63L_RT0hDm2SOmbqFQ0kaoK66IeTw&oe=6AB920B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH4g4obZPEgQ7kNvwHB9mbO&_nc_oc=Adr3-RidStlL0zM968QG_A2f1Vt3KETfNzJbhTRigVAxVkS4hzxaUUpJQi7RK4wS1d8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5osf33Lpf06pzCNe8JwYEsgFEFDDVrC4Dbk1h4218qw&oe=6AB920E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pY3DpAcaXAQ7kNvwHdXWe6&_nc_oc=Adri6UJ3gdkZFLlqH-IGuQ-zeV4nA3OyZtUcsV5VRyNFMxYI4cnsXBF3dQ5xlQGS-Ps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3TzSkx5IdgzJJxyEwulaG44LE5cl0o-F1Y0ymO6qlWA&oe=6AB92575"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JByC7mdRQMoQ7kNvwHg7z2P&_nc_oc=Adp1yoMUAA5Ff4xQUgBdCJ9qPvzThw0y_FmySV3F-E1YYaVu73agvGKJyMCZuG_9Rls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiASSOQeuBi4C57ue_9dsrQmeX54JE9wTDrdjFQQwNJg&oe=6AB93F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GphQj9Jq6kYQ7kNvwHeYAe9&_nc_oc=Adp7n3l1OC1noepiulrNpYpvBbdCEJmr8bO8YvaPHkT6JPEsW-cPya2iBflSx5kcB7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbZJAKJVGqGN1YPt7gdKWvvzcjcdg2qse6nOAXnQQY2w&oe=6AB91ECC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
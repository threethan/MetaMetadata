60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xqv6u0ljvkQ7kNvwEiBZSN&_nc_oc=AdpGy2VeWuJF3CD6pfmZ79gXLiToefaBL80R5j3b_LZBZov-0aV2pnG16LQAbx8jHkE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnuyQLr3Hg7Xvl5hQGq4ESZhI3zwmEbWNMiVYpujMabA&oe=6A8464B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPa8uMBJgk8Q7kNvwHDXBko&_nc_oc=AdqIdyHxQ3Oayd1J3jaGcs9JK15xs2OXoPWm5GUgT1ut9ir145T-Q3SnifvjesfGzgs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2wpkiEbyQJGcCSFFIAJ1ZldVH69_QaNWnmtzKyjOuVA&oe=6A8464E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjrFBr4jmwYQ7kNvwG_MJ6M&_nc_oc=Ado-fIW-OpWBA0hTW_XwhWky76OSgU5HzHzBuHVUpFFbdfwaoFyRsgsjxf4CesB5m3A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxMcjk8aX4vaW1EpKtaYcsb5_-swyvqUQNPpKdBuKcmQ&oe=6A846975"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwLD4XVzri4Q7kNvwFwvXPl&_nc_oc=AdoOudOiIuDIxWuOnyZ5IdfUl92yDHmKspu_UhlABTDgMtf5XZdLItT6Z550ZOAZBTM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhIaAl5YSUkQ_MWtke21HIezMdkcFDHCM7tAj6FQnotw&oe=6A844AC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyhPtMoJyt8Q7kNvwG76_mV&_nc_oc=Adraam9TaqZhlxo1NT9_IOxCXwa4ujX9yVURTKxAlfAiTheY_8UG8nT8HDeTq2J83nM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2V-qKUhBNtmTiVBKEFD9qGT8ip-Fn8geyx-IVW2ewTg&oe=6A8462CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
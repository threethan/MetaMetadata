46_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtaJLVEMXX4Q7kNvwFIyiaV&_nc_oc=AdmBmaXNqXGMIF4CrhVC51VJQpEKzNURLKezZkDgT4Ba5WgPMeDsZnJanUlI1mbUpA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0e1YUgkPkl9QxVMkYDoruC3JCBBgH6s6BypbSe7tL1Q&oe=69B2C632"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHFngcQ1j7gQ7kNvwGXP5FW&_nc_oc=AdmSnsWZjvqrVsbsPimpAVZT2U6iDTsYdX0fAYRwWR7NZzbBic5kFLTbBXI2VxWFurg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZDtJJE5BZIVu8o_GIL_qTQ47djCQ-RTW6vOtyUUOHaw&oe=69B2C664"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC3551V4NasQ7kNvwEs3G1Z&_nc_oc=AdnpjrYfAJYySoCGQFJ6xl2Atwa-aDMx53m3_PuOEzLeSKEA6B3Z96GfIhZM1V-o4Xk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwoWgB8BXCZ-3nI64tyez1HQHuWlR_CCENIeyKamcV7Lw&oe=69B2CAF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ7YusD2CioQ7kNvwHkTAim&_nc_oc=AdmuQL-y4RiWgEuNEh981W5FAI1ewduLYSqDaV9Eh4Z77WkqZTbBMk11SQ5Byg-mqao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyas9cI90vnvTMKJ0-6MTzzLbLx0CBV9A6mhyIIhTtb7Q&oe=69B2AC42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhkvD5YGUwIQ7kNvwHjc7RL&_nc_oc=AdmXn83IZKYVEhSWZyECEYcZJPiCI5WswlOjo6p9Ei9nYZIJ_6OQuqG5iB8rl0qd-7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC15CHIGLUrLxEhaVCgEv3g7R5fUVVdpXSK-hNcG1d-g&oe=69B2C44C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
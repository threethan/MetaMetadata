60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSni155Qn3gQ7kNvwHlxr8v&_nc_oc=Ado9JcCCX1SSd9MuRzM-Iw1gJFIeO9ZXfyAHvxMgXpvnnoBmUtJYF2CUXM--gZ4uOhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-X0xo1TXekVphKIM7SRtH3T_DmP9yxNOQ8WI_ET4DWQ&oe=6A2578B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF9xsUvCSyIQ7kNvwEAktTa&_nc_oc=AdrEUnk9QABTn6swjPCJ0xGRVkzdEf0p2O8RMj0RHSHQCdpl2e2P8S_ePr-mx5AVehM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ThEogaLAp6YwqI5zcF0wXOpvw3hmIqlNAbKSUyV5oyg&oe=6A2578E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWKflBRCrB4Q7kNvwHj-1ok&_nc_oc=AdruM6sEu3FbzBUrDBVPQ9UtvZiK9T4RNXDwywUxFDYnrAeBglFXSMW-g1JUwKndAjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F5sqZz_LVZlKAnLtoTHsyaNzDFweBcVRevfjAwNqxPg&oe=6A257D75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Y4HWdk8NOYQ7kNvwGVf0w5&_nc_oc=AdoBl5Sd4-WKdP6-KzXYFd5B8AfucOdZsZvfeffrHa9f7HWOhQal08hsSXSStwQf6Qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_784_hqnQ8UpeC4I0GjeDzdJ7wMi368npSnwlMkpzXEg&oe=6A259702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H47Y3zlbQVAQ7kNvwFj3_o7&_nc_oc=Adqe3oXjy19rPzaEFlMAijxO8RbsDqKLmKRdO7QLLyZb2J5_FoooWBROSm2vdHWmDng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WNZ1cOrBluz66v6h49Pj09Zpmfc93dRC89KqW79V2WQ&oe=6A2576CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
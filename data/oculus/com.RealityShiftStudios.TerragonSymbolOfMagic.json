60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrWcSMQyUfIQ7kNvwFh0h8t&_nc_oc=Adpa9iHFQanbxLM4bADnW_X9TRY3_w9CR1MIUau_dNM0ExWfmDgbmbhUuOM3DolJcxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fhhAYUJowIt8AoW-IZclZecGEPSR23TkNwFeZlatwaA&oe=6A0DBDB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7lNmUHzUZsQ7kNvwHOl36p&_nc_oc=AdonAzBtFCdfEouwhhI93qw9WNXNFrEkjH5ep8PpepJePEz9xLmR2-A-WaU0g-o6Cuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g8MJd6zeUf3CMp7ZcFh10xMNesWJXGQHa89qfWxJIpw&oe=6A0DBDE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvOrJ2_yBl8Q7kNvwForJ0q&_nc_oc=Adr37vaxrHj3mtK2vOsyy9jEqx7hQnov51ATQS1W33wC66pHYBn59VZt3UZccoJ2Pcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6npvkkhka5rwYXPFTlWhdmGhsT0tQ835W6IHnU0YRijQ&oe=6A0DC275"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hCTilAYlhQQ7kNvwFI2oAF&_nc_oc=AdqWu-qN4vDMjGFVOeRmdeEJ_KDnhd1m1TLvnOEP1ck3vAOOu_2K1MlKM9aZTt74jlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Rq7NRa29DkKqQwini8y1ZJ9yhKaCjrmTqw40mZ9UJsw&oe=6A0DA3C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZId_dC5dCdUQ7kNvwGIfV0a&_nc_oc=AdrUkjuDhhjZZNNHrIdkoWiHQyY2e2oh_Mx1pS3TQi0DHRUB3K0ne8OY1CywIc9ILug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47qU4jP50ZPxyWSOoOyshbqb2dZocqRbo7NT1TQevP5w&oe=6A0DBBCC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdcKsk4OtvIQ7kNvwGZ3XU4&_nc_oc=AdqvLNLiTdUDtJh-MupTSKdBmwbi97-rbI9pYP2MU9UVYOwW25fCY7Jv7E5LWNoiwK4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTZfcIhZoQUShrFmTFwqbTF_nFh8JqrrhecV4kUsT5Dg&oe=6A807032"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=For_8a6h174Q7kNvwHqL52f&_nc_oc=AdrqlZpIQJitJdJRVAScgqyVJRk1-6rjJk4OVZgT0uoWvKJWmDcUHt4Q1Hxf6goCvT0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHylrYoDuqBh9zr-BdLcKrDVOdd4iMXrPqwq-5MbZ7oaw&oe=6A807064"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOyqXhp5zFcQ7kNvwGchFdI&_nc_oc=Adq644dJ57hUWN09lRLji8brDKKjCmVaqQVCDSrAzTyiqESbyhJWYrDtOlfr38WE1Sk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv-lQiUfG_lhQd1e38lyMvBH5f0pv5z4s-HpDREHCkOQ&oe=6A803CB5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-XQaGDt5r0Q7kNvwFmwBMf&_nc_oc=Adq_fLgUiztJDzBN9qJqfAH_AXYlqfZK6WCB9WWtFteEC37TQgJF6xPLRziutcj0p5A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgEzuBGlBdEs1GLZWMM43CTZDnD2smF1K-VwG_ktUbQA&oe=6A805642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BfJKv9AUNMQ7kNvwFe7WtL&_nc_oc=AdoeD5yA6OLV49xdfYhZnbkLPquOS6ipe0zm8uGmJuicY9iOl77RIGorZPM1EImLGsA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyYhRJYEes8Td2rvBKQFKq7Us_KsY4Pbp23bgsGE4n9Q&oe=6A806E4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
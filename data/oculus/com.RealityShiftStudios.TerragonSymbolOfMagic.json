10773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0_q8EC6tcAQ7kNvwHoR_yM&_nc_oc=Adlg8Hibe18d2KjXS4TfvrIPLKrQnZMBaoxBqtW6z4qMb6FYMLi271jsAW-GeLvj7-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZS8JoBqPRZyYtk9fcsACUhMmbCqPq2lu87pBPGxJgBQ&oe=69A6E8E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43v7nIt4aAcQ7kNvwGS7VYv&_nc_oc=AdnxIlrRYYRCKQCxsPyDCWN5s9C3MVl_pBhZlYMfQaqjgWiLwlCe1nAFh53Neu-WJ3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujqQxxDPu1t0TZsI5GnNxMRo1I7RLCMFGXCb4MWSTPYQ&oe=69A6ED75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5uP_xD7Xo0Q7kNvwF0rLpe&_nc_oc=Adm6_ygY8oUWadxBmA3Ot7NXesa6LJFmOwcLmajj1cRdimSyGipE9Yf70nki1zUPfa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudA4HX4Y-vXuxtGGfHExy72S6YymN4Rkt-hnu1JlbTOQ&oe=69A6CEC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Sl5Dz_ZQrsQ7kNvwH8WVRp&_nc_oc=Admc-hpnn9_67Dc_lxXAeN9fh6JikN4lYKwN0kH44H_TOpk9_U6icpr1hQ0PVCqAAqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuZgQtK5IHGRsqTHb5OAG5gPv7MGXvk3IXXkLLvSY6jQA&oe=69A6E6CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "336676708353118"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se0kbyi355QQ7kNvwHICiUJ&_nc_oc=AdpiT8JMVH9BCN3doU93SgWRX--02sSjTR2ONoBuXoSb50IqjbyJ9-cVYtkKxNQKmMw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSZoMUQZlLn8h7uBYLpXXT8ScWH-3_avFuS2TNMcQg0g&oe=6AF07FB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EfMuHmzxvsQ7kNvwHSX3j7&_nc_oc=AdomPM75jdvXzyOQ_y8vULg-4QXiL8A3K6pusXwqSr8a-otPejmTm2j9ynZXI2Z85uk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlYXIkj4kcL_o9a9_C7A7iPUDYUm71rLKubfOtrCDrlA&oe=6AF07FE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZokrNIhyrRsQ7kNvwGdLo1t&_nc_oc=AdqUpXdisxwNmH73UEwS_57NctPAmj8H1Z6NGQuz0Zs-IkWjChlH0OtncQAsMYf-8-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKUQl3mxcgQt1nWQ7psjRHmPgaPxbRp6KSU7oJ6G1alw&oe=6AF08475"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh0puKwTFLEQ7kNvwE8GzLK&_nc_oc=AdoDhuuU8S1Dyykiq3mW7uyAuRZTmOZZqbubBNI_98fSway-N_Gc7gXe3F6vXU15U9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQghtpgANgho-tNai6GaPTp14sKZbRaVSii9j0zIqcCcg&oe=6AF09E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1X0Hayj5fsQ7kNvwHQ5lh8&_nc_oc=Adr_Rfe314AnTbrn4InQjWj1rnyq5wKul8Dr5j9xUu8wCUw3uTtu7dsXZoDY1xdMLLk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRnZKUDO1ojfioP4VeqN_3YXyM0TOi6kdcq9J7LVIKhA&oe=6AF07DCC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
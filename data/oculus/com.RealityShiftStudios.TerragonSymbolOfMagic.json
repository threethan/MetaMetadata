60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZ63KtEBXIUQ7kNvwEslm_0&_nc_oc=AdogmdXzQZxph1quaaJ0GQg9H8S_mYjrRQAXDatzfF0HmEdCR5lckvoXIGFFvhStDZg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo4-2SG8eiwIr8y5MDCgbWu68lGKbJNKya20vQFgSW-w&oe=6A974A32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcdLN0he5KoQ7kNvwGDgXs6&_nc_oc=AdofbH1c_T49NDiLUF1XhcP4tsVk2Vxqan5uU4COwjWm18LOmqPSg5efVSIf01ytVt0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhVaVcXWKsB9yEY2wJc4W5z5uNuQ0vmVmpE_bUwIeMUw&oe=6A974A64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPsdg7QXhaQQ7kNvwHrTOct&_nc_oc=AdqlTr0hX7IVT2MtiaVmk62GPFBclctPhpM-Po5hcIHRai6NDb8CqrYrHM5gPrbc29E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlfpsMvekSgx4er759IzVXaui4LKsKrZZba7CcBFksgQ&oe=6A974EF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJxmHigWFn0Q7kNvwFYUEpf&_nc_oc=AdptNI7iXzCKsDKW1DJ9nEN97dMUmHf4l8mlkWBa3shP2aWjXs5pZKKNClhIJ6Qo1N4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvJkHArP5yWYJyoXxT-ABpBhXuw6IqMeJa7iy9KKJEUg&oe=6A973042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rrrfCWlgY4Q7kNvwFXSbL-&_nc_oc=AdrDnxfH4Ai3W6nU1zMPZP4FwOx53dYQKOknPeSe_soUfCbcjXD_DjPb4mvyLS253HM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBnNwjsPBrXe45Le6vy7C8MPNJmFG4M8RcJotQi0qeuA&oe=6A97484C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
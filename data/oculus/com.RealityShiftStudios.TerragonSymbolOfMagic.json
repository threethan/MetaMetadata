60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1-6oKZCM4gQ7kNvwEJz5g5&_nc_oc=Ado2RAM9P0YvR7AK3BC_hlj3NmByxm2SIlzCYCem-Jkhs8QxHiWVyml3kFbRIyu8NZg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZOFDfkdA6kKvDQyyJaGECDciRovz5G82STSe9GP2V2A&oe=6AE350B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R4JncN6u28Q7kNvwE1OfpM&_nc_oc=Ados8XcEDjBFfIrcysx2bzyU3WMuXBOw0d4LA1bi9gS1SdDapGeuAR5o_2d6cRpxHCY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBv1VJNE5Xqf3YzT75ZuqaFCZpBSJiyoPdCXFZPfqNfg&oe=6AE350E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE2crNSMl-UQ7kNvwGHzrUB&_nc_oc=AdpOTtE70GJl3GPnG6AQ-Sabe_sc9qRdjUMew5G87ffmFCmFxNGA4qiSCGBFKvojA3o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0ZIvoxAWWTFyXFveKt6fZcCPMf2LJTawQEsgFLnsPgQ&oe=6AE35575"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR4g--JSB9gQ7kNvwHIkblz&_nc_oc=AdoZ4brxP0KXTF6YzAdZXF0wyBI3iqn0xvoJeJjSupyisQWyEFbDbckStTJZtUHZYKs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW3IGwU-PBm6RTldQW_5fNWoiwKRA7-9K2oXco1qXYaQ&oe=6AE336C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKyF3ggQhUAQ7kNvwHlVJje&_nc_oc=Adp9L58YGC1ZxAX41t5vjcMs2sWwAzADM2saJp3KzwVxoNEhXp3T27rhPvQf6VF9CG0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPag8nwKnOXUhg1tW9sgY8pPPlhSt54q0R6lVOWYVIMng&oe=6AE34ECC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
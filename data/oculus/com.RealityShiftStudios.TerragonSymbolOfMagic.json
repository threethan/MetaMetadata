60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrWcSMQyUfIQ7kNvwH0TG2C&_nc_oc=Adqfkind2u7Y2PL2Nn7RHgVU7OD4AwPpo5yvEKiO5NL3ucmMbKQLk9iTQUjG8WyK-sc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zJto3sdTfo2VHzSmH-PT-XSeXxGOT__OkagdtIL1GSQ&oe=6A0C6C32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7lNmUHzUZsQ7kNvwHmKFT6&_nc_oc=AdpdLk6jTiQA0JwIskIQ7Um6cbmDJC7P5JZ1n-lxpstbLALDg6gjLdCM2MdXKd1tL3w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jREalZY4Px74-hyusV_sFYB0ZVmDVKP6RdLqhYRhxVg&oe=6A0C6C64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7ar1qUFU0kQ7kNvwGWSzmG&_nc_oc=AdrvFP7DiNcv9PMwI6Z-SEBDKTwe_AL7Gd0oNyZB9_nMADQ725FuAUkCGPyohc6yFuk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vugitnGRCHChKy-OT82nu1WsBNp3YeMV3K2vdIqIX_Q&oe=6A0C70F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJmRqkj-FUEQ7kNvwFSHzwY&_nc_oc=Adp8ka1BNjRaloGhezd5MgA7tWU_ppi6xwhQTKi-yt3crlFnnOjRzOem2cPgGTel57o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mmc0_hGnQ5yc3cU94s1noIKBZiG3qFKSMO9WisVuZtA&oe=6A0C5242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZId_dC5dCdUQ7kNvwFO4V-X&_nc_oc=Adqs5lRt12HWNxZIhUbSPGhN0s1N4KaIV51dCc5ZzIH8WMJv4qZJNK3VyJqtTYa_2LE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VQ_Q9IFlP-Am5WfssaxIItdkO34gqqmPOB-H6e8vAnQ&oe=6A0C6A4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Z2uaWzOIJcQ7kNvwG5M9uM&_nc_oc=Ado8NOTHT3gy2rrDLlDWhAG6pQ7_EQv7FG3B5npa_Ym0CsiWqAoIsiRxRzOAJMtpgjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFCxxKt8EmQb4kA3e5n2MyPHOVvuADgcRVL-bWrwRyYA&oe=6A734132"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4g0HZLQeesQ7kNvwEurfYp&_nc_oc=Adp2EwWvK8WGIQMW9s2oKPINF0X0gZNtq3nBYbTUtMuIbQaAd0MJ_QZYEnpwdsOQVdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1-ES9xsiKMt7vq-rMxkGNDmkV7fGkx6f1f5EMT7NGAA&oe=6A734164"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVDwQsz2MAkQ7kNvwFvSgI0&_nc_oc=Ado6UNZbl4MQHML23aZpC0cC6bMbHqsY0uPAEGTxI5mVHDlUFI10mqcOfUdY8Brr1Y4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfMrtrkU3ToUKcAjPbSu8SJ-owAgg7EYpmAXPoHJj4Kg&oe=6A7345F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plvmWfsBNfMQ7kNvwGg5kmM&_nc_oc=AdpENvZvUsQyDzTUIiRK5m8QXICqQE_42m2Yw3WU46x1Oux7mSJr3uHRFIlEsfu-a5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF12Ky22PF06cXjX3oIJPQe48p5KAF8pmK-6fWRrRKIDA&oe=6A732742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI0GOVhJ4YsQ7kNvwEZyD3G&_nc_oc=AdrbIBhdus8sVdvzuNAOsRKi7sqWjqF2rTyVgmWUTcQPyTNV_UwgfXab5DiK1QYgFsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY7l6S1Zfl0eTul7NKsAUcUcAZLtKjb7txMqdfr-zenQ&oe=6A733F4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEoHKWAkOU4Q7kNvwGrurib&_nc_oc=AdrI4hYdVynI6xPQrP9LFZ-JorYNlL32sc0vxGopDpbEbRx4Ckr2IiwMFUu0xG41QoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaRGrkWINVuibe9Rm5UBJi9bKj-l3SSvaqEsaQbq9Yxw&oe=6AF47432"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTlMHSeA674Q7kNvwEZ9cDg&_nc_oc=Adp7_PJ_KnLy435t3FPON2x3c2s6tQaGS6x_HX1zMl-vpdXDMdkJyuajl_19RqmPGf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ1T1oHYHmY4k7QLVBNDuoEwWxT8qDXbGJrxdsIqlmog&oe=6AF47464"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOw7FS8h3fcQ7kNvwFp2ZGm&_nc_oc=AdqF4YNCSBqytu-5KZaIHL845i5VmTbKV8sjd3kgTTkw7z6hfTH14F9sWwH5cBS4l7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSONz99xyPvb_AHlO1sGfoNDrAP6iM9MKs3QNwS7UF-aw&oe=6AF478F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IytmQMIWlkQ7kNvwEC_ZAf&_nc_oc=AdoQvDx-zzrOOacX176hyYdiYiUy9PFpdRWe99VJw6nFQlXbUTbhdRjnTqSLB_mg20g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQma83K_Q0IsHd-1iL4lXIinse10GOjlNV2Z07owtWMiA&oe=6AF49282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6K9R165s2sQ7kNvwGC8vZK&_nc_oc=Adqvz681HetPnWbddcWkE3EfVdT2kWdMkSyE09exYJUldEq9K9gmP7sD7d14k9eVzKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Mi9gODJZtKBNxIYAjZVzeQcKLDNkZlUGTRsK6QO0OQ&oe=6AF4724C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
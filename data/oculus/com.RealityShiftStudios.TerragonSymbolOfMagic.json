60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9GhYRsWWucQ7kNvwGyG5pf&_nc_oc=AdoBnw85xYythUHlbyCgDpfox2-Cwn11ngimNSEjZO9rqmY-KB5d3I5NRp1wRC38F60&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-1wGnMnPEmx6t7PRK6zXd3nuusgQl6UI6aE1iMAgB5Q&oe=6A8820F2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vm0O4PRePkQ7kNvwFwnM13&_nc_oc=AdqFVuGZ8FhpGDFnNVE3KYDuB52ng8um8fo2zpqCNjcJM_vCi4p1quqf69K6ZHEsUrs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4dBA_qtt2xhvbXYa6dvlFqAF-P3Z3K7etiSCcB-ZxjQ&oe=6A882124"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DCDPO8JitEQ7kNvwGq5185&_nc_oc=AdpzZAhPVivgFf9PLCfnGnbzslcp2ud_21PayMs1tDQeOdORLLXEQ1iPwSL1NlclK64&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbPA0bCNIbuKNRt15KpV_sRR6X3QrBoGKR65x3y1n1WQ&oe=6A8825B5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs76r7po_psQ7kNvwFJwi_r&_nc_oc=Adr_j0VVcGhWEveYNFds20MQVSqc-iMuVmcUohdIYVAgkpfnjVKL3ogaheY2Pw8Ujvk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDLJIFM6XpGJAA-qsFczI93aexxOKdM6B1XWNsbudy1A&oe=6A883F42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWDZmK7dcqQQ7kNvwGSEmbT&_nc_oc=AdrTklNkANH-HcpEO09xBfJGvjG7_qCU9DqbPbvZ6-B_VkVOB7QjNV0-23qDFj21U14&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyJ9rhVzVJN-lZkQLayYqnAd6g_tERSLgjNXYWv9xirg&oe=6A881F0C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
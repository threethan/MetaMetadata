60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFJgYilZ12EQ7kNvwHtl0wC&_nc_oc=AdpRtx0TOuwJBvL_N4htcmR9PYKsaRSBmv4Z5TioUIbwHWBU4Iqpez8yBs4Pczh9PQg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ml_H4RMDR4dyAvYKX4YtGsO2_5h49qYHP-7MQf9kC6w&oe=6A15A6B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGLNloykTaIQ7kNvwFmgbwu&_nc_oc=AdpcajmGBBNcdjDEXROP8wZ26eWsby3BuuSHPGjzL55vTLSPtv5ofb5KvvxfWZDRGls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4THPRPa_n6KwfX6RMeNQS1yY9O46oge6CzhbNfhRxy1g&oe=6A15A6E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_25-POt7E4Q7kNvwGoM-Xi&_nc_oc=AdpE7raYSjoyMgT4i2oSEHtN9tEw8d7S_L161XPM3_NdO2lM9glD5os6nO7MrNEnIzI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a4CT5nABTeC7GXh6y_3rZA8qLe-97Mny0Tw4jOEArfw&oe=6A15AB75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwPaQd6yTeoQ7kNvwHDT-Rx&_nc_oc=Adrop0hjZ3KRG0gDKNbT8Mx1YlQ8TTNhSAPzjwTYaV_l7YjGYwsLzssuzTUUhxYVCb0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62cyPcFCqBxs22vLPdoZa35yWgui6DL3deq4V4rHP3CA&oe=6A15C502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBH2G9ub73MQ7kNvwGW4YUt&_nc_oc=Adrrm4Wb2JgiL_GS74b4ztx6fJGqEg7oZZ0Y4lesbokt_RFuPVTq0Uq-QS3Ak8SjwgU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44ayvYdPsHfE1G-9Pko_H7pbehXc6p1hcuhxGWzcRuBA&oe=6A15A4CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owdP64bybp0Q7kNvwGFAo77&_nc_oc=AdqkSJZ8teQ8_BhAHMPm5MZ2hksMXQoA3Gg_UEb31KAVMzHK1X5xffLx2Z9Q792hV7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z4fRVFgzShnYK4HHGSiKi8zG_w9ea3pTJV6Ex5Y6n2Q&oe=6A199B32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfMnppo-EuYQ7kNvwEx4C-G&_nc_oc=AdpuurTkdo03Pv2FLqPnBPT70vlOy8WgCRw6NCNnJN_OZoBRLdmvNjKmlXTmP9S6V8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uvuYlCS4Hy8j5BboPMxura95TFOm__jX5QP7bq83Irg&oe=6A199B64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsu2a18k_JIQ7kNvwHfu9tZ&_nc_oc=AdoemF0LUAAB0DGenQKi9_iGNxxSVlDBNSAXCnrlUbAnxzuaytL6yFK8pCOmB9rkJ18&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dwQK9XvJaxnOjBTWsjZZX6tcL0avlnDJ5AnZNhSiIbw&oe=6A199FF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8xPqZ6JdnAQ7kNvwGaNRH7&_nc_oc=AdrcnKoUmGmygDF3yqCDvqxPrlOP48AczUvzey8VosOUoFz13eP5haMPkGUYXDHVfNI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af752sS1CTiXWKdHJP5TBaGqQidTJAAd06AR_Cn7toYpLw&oe=6A19B982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz8fRUfLSfkQ7kNvwFkNTO4&_nc_oc=AdrbcsywKxwNsDSuyAOHhWNtU-Tr4gNsEW97ctYxhu6JwwSd2SeUuKtAFVc33MpSWvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43PCiS7Mv0XyiwMj2RVy5_JvfRYCFUYIF73e4KYzmRpQ&oe=6A19994C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
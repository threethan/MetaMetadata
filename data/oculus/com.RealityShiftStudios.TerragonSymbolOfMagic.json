60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaLrNsKnGYcQ7kNvwE4ukcb&_nc_oc=AdrYmTUd842mIoj7PJCXBCJ3IMdES-wBZZhjKtbdWEtxq80pweQWtW_vHKLCgIIrQlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_DUHj9jzy8DgWj4CECP1ne9-zQ8UWj_rT30q02IcTfg&oe=6A788732"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tznQMUZaOvYQ7kNvwFJH--g&_nc_oc=AdpMUU3b5KG6O6L9MqrLliwEgT5x_6G_yJTkW25nR5umN47XIREPdUHRVAu3z14MS7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMRrn4QJeo9JXHJ85EU5nu6JlEeuJP_5_SRZ1cMFtdYw&oe=6A788764"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8OrtVL4CoQQ7kNvwF068_L&_nc_oc=AdoY2VRzS9wCzk0MbOnDC-2emVlJuWf82uoPsVf7CjcP1oHRu7fVpWNrtMof7fMnosE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdVHnu7OTFasHK6QJuT7Eo9uCJEVzLsQV-XVwj4moUdw&oe=6A788BF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50hEJJ77XMoQ7kNvwEIR3Dp&_nc_oc=AdrlTe2p58jX7y7Wi8UANFX-C0m5nSfmXBWxjf4kqP863FoOxkQWKfm2-vCJJZW4YZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRPRIoxU119a7OrmMM28quKiWR-nOBq-0F5C1dp1oGjA&oe=6A786D42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTYO0PmJaQkQ7kNvwEKNlay&_nc_oc=AdpRBQVVjGgUKiy7xLIi4JggJxDZaYqLkbqnDWwsgvq1G-VY_u2KRVj2tg029v36nQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoefcU3SdQ4uLZupfb6ekN87ekfslwAFg17eiEgyQxBw&oe=6A78854C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
_260888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITjnC1GVmJgQ7kNvwGqhIOE&_nc_oc=AdoBD188iQ1eLQreZpPet_1tOPSR08PloayEpOMPW3ANlsgEPKDVEaM_y7hSyKo6hV0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoST1u8f4xcY9D2oC-cIoXr_L46BW_tG9FaQcE6Ay53Q&oe=6A8D66F2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzyk0A28jC0Q7kNvwFsuoVp&_nc_oc=AdpN5rNZeQy1ZZBIK8nrWM2EZCbyoxpJAu7wNwchf6ZCMUzA1o_vCV0PhEpR_Qzflow&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYWESji8QC7bZR_kZznNOOqridKZbxmSvmj527I3pSww&oe=6A8D6724"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BxRdWmazn8Q7kNvwEOFQGJ&_nc_oc=AdolWV3y34oDjIHetgt9YI6oj6y4iKdniLnxdOkN6HMBU1i42QgXtuN-8ilaPiRiiSI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW0eoHOlvXA7zj7li1x_C08novkx8Eu2wInpgdvEzLjA&oe=6A8D6BB5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuxsgQCtX78Q7kNvwE2bf1p&_nc_oc=AdrApF2m0z0KygludCALCWSdg44Wv415NVWjHT-JOmvRCj8ZOKbolcrv-9GO5uA5vkM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBfZV6tX15qZ739MmJX45iX3e7rmN6YUydJ_I-eb9MAA&oe=6A8D8542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKgdI4APJZIQ7kNvwGu4C_z&_nc_oc=AdrBc4U-rg1XYQa9TWtfeMSHoOyqUFmwYCRUL3-i_BRvTHtrB5IAkguJ6bgKbDTYNvU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSXIk_QRSi1PgfT7Lbu7YEVit_dtM-6u-7grs7VOH_uQ&oe=6A8D650C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"
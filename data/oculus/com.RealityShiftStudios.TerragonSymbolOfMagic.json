60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W__o6mPj8nQQ7kNvwEjPFSg&_nc_oc=Adpi-dcCzMm0ObiQLm9G8_wMk-w6elsd5T4f38ghu40f56WeOx7RvrbTNwEdj26xysQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK6Es7YObVKUSndaGgwpBpie4mbgWbJ7KcU0kRiJX0gQ&oe=6ABE66B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0XXvOBxks8Q7kNvwENOvRl&_nc_oc=Ado7fmvhbXsTOT7D8VZbJBlVw5H4VHfIkdu7D40m8C3_DriADtrgFlEreWUvOTjmSuE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT2pHaIzrIBSEvi0hrBYWy-_cATgUgfQG1cW8bHD_zxQ&oe=6ABE66E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoEwNgR2XvMQ7kNvwHX6lbu&_nc_oc=AdqFoVt_qa4C4ChlfGS6a-THLdoeIj0Mno48MbpWfyCbq_oxP4hGU6kPbYzml1FlSro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9mmvsZ_2wNd2lZuq956DWleJtzg_4VfE540v9f5_l2Q&oe=6ABE6B75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHnGOhPBhOMQ7kNvwFXG11Z&_nc_oc=AdrhQdPDQCW2-Ism-uVSbkzTWep6qGGo2zSWYtSGi0_NvdSA2stlSURPKNbi5ufTAWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTusPhhMKe2bwfjQpQYgt3LHIUo8XcE4vPDKMYCan4eQ&oe=6ABE8502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFTHOO3FvmAQ7kNvwHWfU-i&_nc_oc=AdpK9v43aYC1MVMUjBZJCcWI1NlF9qCGy87eQ7xMmGaFP7ADZ9MXDTyjus9OlOABrp8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJEG31rbVDvEkCcStYEVGaancz4uLHRNSc6LvExFlxGg&oe=6ABE64CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
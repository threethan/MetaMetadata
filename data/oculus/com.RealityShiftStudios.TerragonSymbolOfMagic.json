60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiTZ6oSlwy0Q7kNvwFc29gs&_nc_oc=AdpJwh-tpbpytkXXqchw9tFUQJDzaO7OXBZolbq7i68I-dgYHIIyK3OTtcDMKXqoHPc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DODB7lNkGhamyPKsy1Ve2fdfTZ8vmeb9-hHVItqityQ&oe=6A1C3E32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjpSIsFiM60Q7kNvwEQn8pl&_nc_oc=AdomLHBf--yGXUnNqf_bEj5JaojiehyDlfxBi00LXUPESVMTqSzyIAkU6WJtASjbMJM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KHZiIEMuirzwxRFxh_kw-uLl3tt5w0yvKTeGIKo2OmA&oe=6A1C3E64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsu2a18k_JIQ7kNvwHBtcAV&_nc_oc=Adqwwy47UpAIjiErX3O5RioFWTFozn_yLqt1Zb0yMMUzqZ-LHw7AOXgHJ3t0IKasOGI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CxJ_qc5fHXA1DiVswRRYjQaOtEFLKBFcjfCkcP7BDSQ&oe=6A1C42F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8xPqZ6JdnAQ7kNvwF0Fm5M&_nc_oc=Adpd9zkK1dkFh6UAV8iLzTpgDMWoQXER1HABuBP4nmSh61nnjc9tOj1sb5FwzPvC9Eo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HMWS68VfpGt2r0v455BgRKA39iqe9B3W5UWxdPmEfjg&oe=6A1C5C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgsVRbi5-lEQ7kNvwEyRSL9&_nc_oc=AdqXsVC_S4YwI-PTAlVmFtscFhv8UiM2zOWt14fl_WYJmrUMK-px_RoONA-kc3M4LKo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4epHEjDL-qjbDan7YhtfJqd2X_A-VmI-SpIIDZWpqPqQ&oe=6A1C3C4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
4613_260888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4WRA6RCzdgQ7kNvwGMhQnx&_nc_oc=AdqqzEtI18LePMf8_E7Q8oLSdug4f2zCJ5l2nNVXKMW05GDmb9QIsTTnKNdjZNJ8RCQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ghpcDiXZoevE_S_uR9nG6UCVSEhSSrphOb4epQsJcOQ&oe=6A466E32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhlGGOA5JSAQ7kNvwE0DVoP&_nc_oc=AdoVKn2gCglm0PGfcqfv4J-wqa0fX4oiw07vF7wHU4KWxd2KSXavIiCf4LVR6TLWFHg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x71LJDUJxzlWR2PhrD_f0sCzAi4uztuGuLxnRcc9vvw&oe=6A466E64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrBcgRqZQVoQ7kNvwH_Ex4j&_nc_oc=AdoxQUKGC17kf5UUBHZyMiD4lS-lgKvVKQ5w_NJkM6xwiJyEfKTHSuqQXkE_RcumHtE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MpDx4dyYUuzqexlhm6tT-mxhaR32Mid8qfjcHaa5obA&oe=6A4672F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z6d-TDBT3MQ7kNvwGkIMwt&_nc_oc=AdqEcwOu6k1mKXowQ6uCH0cDVlUNjifaQ2B4H8kzWz8jtZKWjLjF0hM-vybCiP5Dm7A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MJBIfC6rwMHEVdskFeaqhDr1FGbbUrFROBt8MwoJSTw&oe=6A468C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiBO2razigkQ7kNvwGByxFV&_nc_oc=AdrsnExJ50HNkDbdQE4iGZGO9qUo-MdRlrAhSo2NnUH0ap3nGlttP0JpE7-Sm_VuLso&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kTdx5PDP4xQt7J3QhKiPS6YlXPWn1M_2RNAHrX-hnaw&oe=6A466C4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RP
10773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aoq-pTU3zrQQ7kNvwHF57zh&_nc_oc=AdmxY2xSb2MX9hUysOWAk2wWu7dhYqnUJBrbh20geW8Z5NFrHybK5UFfpy3TjFXZGI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuFeXrSSHI77v0-nes6D1q7oFUKxAFdeNJmLtCa0d7tyA&oe=6999B9E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSuH3uuqVskQ7kNvwHCdB_f&_nc_oc=AdnxAn2MFkibwVEj9UXvc0d-OfOBA2brGpvnU2-yMQdAW8kWmkveShg9jV-Wt6BiPXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfubSfKoQ3qySQiDfRmp20ExiptpFTVXtbljkEWm424zqQ&oe=6999BE75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RjLY__lTUAQ7kNvwEQdMu0&_nc_oc=AdmG8d4JofEP7AOZ56MbTlQAfiqB7DpV2NCmjruNhBf4i4LZAN77Xe2uh7DxVtX5dCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlCSLZQPgNeh2NcAy3o3tA7PHcG-SD_5uuBxJ20bhbEg&oe=69999FC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnpBmCn52PMQ7kNvwHgnaSZ&_nc_oc=Adnehveqen2wzeFCjrqc3u6Brw_KfCteAlhPAEsOLf8s47BK1tNQKR7ZoqwIy4ork9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs1lprkeY5Npw1mNs6BE8ztAa33U2DvbUSMPIEeDtj6eg&oe=6999B7CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "336676708353118"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9GhYRsWWucQ7kNvwHehAgt&_nc_oc=AdrweGnT2nOyrgd3u72jiuaToAL-p7otU10Ie8ZFcv9WUxJ8Tr4QghQSgl1C6CVptX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRFcOBDa5EYGg0IpQzrdHKNGcgQOhp6clU99CnOBr_Nw&oe=6A86CF72"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vm0O4PRePkQ7kNvwFPVkaM&_nc_oc=Ado5FJa6H5qvGEvXdU18EEEDkwF5H5YpzEFs4j4w3DC4fsgNY9qSlh2NRVRl84LcQh0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsHi6YUFvGLQaLf8_uZf0BPpD8Wnm9kMXTmVv3W5V5vQ&oe=6A86CFA4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjrFBr4jmwYQ7kNvwH3RFGY&_nc_oc=AdoqM2SXP7bS7N_zd_Hy1mMhAW_Gv3bEMOoaXvCbmAEkAxZZBViHCY7Do1Qj5yzuwTg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM6-3k-kUbSjpOcFLalzZA_8zTEvNmqUDCTRRpE-zKtQ&oe=6A86D435"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwLD4XVzri4Q7kNvwH22ecW&_nc_oc=AdpWNjVg1K1PYS4juhpNlcar3YES6z960B6rQOonrRsSk8t_wSzdeVdoLZHcpmTmy70&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMFYlM7kvaK58YffEHdurVxNtxi3jhTZJp3M-omtFa6Q&oe=6A86EDC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWDZmK7dcqQQ7kNvwEuuDCs&_nc_oc=AdpgV0uTp_o7iLRcdaJah6MTWKD9rClngecXWR2pyP4Fd_p_2nNrFD3Zb_6meZYRB7A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYC0XMKuAefnv32TgXK7NI4Cxae4YsW0PTZCixBbw-_g&oe=6A8705CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
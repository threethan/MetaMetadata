41675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7e15Zum20sQ7kNvwFpp96H&_nc_oc=AdnIs9Cshxn7nqP__7eZqkwkh2kCgXuzmP9hIcLJDlWLyR_Gj6M3Dr9eOJ6o_A8D-KY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyrjnk5Niw4xGT4xR1Gz1t6EiZ4deK_GFUTUc5JrxqAUQ&oe=69AADD32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vgOiiRtys8Q7kNvwGG5k-I&_nc_oc=AdlcYF5OkhF-UOOYw-y2ndha-urhZyKNNxd2fbiehzuAKwaaF5TkliqOyWLr5BkJY20&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIM5oXgh_KoeAqJUBwDB1kqzRglZ-W0mMKkpPKQnOy8g&oe=69AADD64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXhqDs38myYQ7kNvwHNKPff&_nc_oc=Adl8qtOwLiwJBsUu_SeA95ODtArNX_jKjGfe4oNY8f5J11re6h1xh5Ayl8r_0PM4EVU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3yO26AT1pHPpdfbitTJxzhdZYbU6_tkICOLiEqzF8xw&oe=69AAE1F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEhIm7bIE_oQ7kNvwHS6uQx&_nc_oc=AdmucQEYH1dz6naPCyfaqqTBPyx4J-pSWeLkBEkMUKlJAiiq81W8dQNe3mEayUpa7rg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-M6RXp8mftRuC2IIIOuPNXTlT74E_qdl_ZY7qmGKEkA&oe=69AAC342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmPYWPb9DmIQ7kNvwGeITpd&_nc_oc=Admvp2PGhQ22YcSObscM40nLEd2fXPq8x2B-j5p2MDTrymrsNKHi6SrT1y7wnRw0aOk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwcwp4Qm7i-z1kwenXqTjkeaBnX3aBjRimnRiYOQRal6w&oe=69AADB4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": 
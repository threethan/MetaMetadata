60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7faKUn8G9cQ7kNvwEJCmkw&_nc_oc=AdrYBQHta8Oa0eRjQZO9jcuzG8qYnxFb_KqDOKc1Ug3w8P1e--J4GzT1efxHbY32DKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09KyUmGCUUMzQDcLYXafKsPCZ3TWYlC79cmd-bjj1r4Q&oe=69E4DF32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeqoGtmUTM8Q7kNvwHFP5wz&_nc_oc=AdoC6w_fbuC79YiNOzES9KMe7NeKzC38vMrIG_kEZsm3pKDLrzh-TsmZq1q0pfxsQCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wd3GKP3up2Y8vjaNLiK7eVs9DD5ie2yZLKDY_XaICCg&oe=69E4DF64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ba-TwOFGCQQ7kNvwEpqeEx&_nc_oc=AdqalHStF3rPkdF7nisgwVYbHrmEo7Sg9FGupF79iaEIUiH3SGCfUgUb3nAD2r4V0cU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28XXZibrOvXVpr4impcgEDZCuMCv-PlUbJOn_oRDHH5A&oe=69E4E3F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgekU9UnKpIQ7kNvwFzySdX&_nc_oc=Adr9tHMrjoRMAwpw8Lj6yAepNUsxD2Hr5bErpns4F1bUnQyVm6_fwRMhn5hP5kaM08g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XIDrQ9yXn9-2TKcoulzWfRegQI7QBfeLWiuRoyX67vQ&oe=69E4C542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ux2ZUb5iyCwQ7kNvwHE_pam&_nc_oc=AdqJeUL33vDC460qT1BiJhfDR-PdRJrouRpdVicDfDb41yy4QTZw1Tx6iJwHI9P9pjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f_glL9keQUgkFVPeD58I1SIFPsLiY2KtrjOZ194uJMg&oe=69E4DD4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siHDDZyT-rAQ7kNvwEAt9g2&_nc_oc=Adqx9Uj5XBCuYd1ANKjdShHNDCX1G1Ul8AkaEUlBeb2KZP50I2iJIfmGA-RA_mXpWXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzhzDZGA3jYD7BqcOPd8GP6OyftoXRuaKG0_Nzq3Cbuw&oe=6A60CC32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6Nrk0QdJJMQ7kNvwGRVyrd&_nc_oc=Ado8LRuwo1mBmxjrib6GjTwwkgBxhhro7h7AycglidQlyDkXSmiFWc_S68Sf3ceTe3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0exzjC7PKaSFJBHS2C5GZOMnYRWnqLkwgAj4cAk0kJQ&oe=6A60CC64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB32M1SLsxAQ7kNvwFyc10b&_nc_oc=AdpNpmoeBD7S_95_rXiC3eowYL-HYOHLji51_LUTmcISMTgkTMyEKi3d0GMn0cIlcXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuRlEZtOISPpVUcVDJzR1H8HUZsn95l8lFqimVMUHlOA&oe=6A60D0F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IUy6qifNcoQ7kNvwH2dEPU&_nc_oc=AdoNzA7Zb9ehoePNAM1WQMFqN8g0fhwJx5zv5xF8Uzvihmcfh3NS9xeMq3awfg7gKWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRRJAD0lt6DsYE1Ek9vTlZq2TdaAHxS_wyx_hM6eOVnQ&oe=6A60B242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdLj4iIYdZgQ7kNvwHwSQXB&_nc_oc=AdrRnbQTJZvkat4hhMG06FlpksecDYjipOyKWcfy7WynVnzDcUJViM5Om92bT3U_u5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAerFx_IEYkO_n146Gox_IsBE006sfh-kMg1xkpc4TaA&oe=6A60CA4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
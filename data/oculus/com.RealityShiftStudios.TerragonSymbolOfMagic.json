60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF_6fl40vrAQ7kNvwFunipy&_nc_oc=AdrbHH2iU93-EEVWGpTni7hbkcvlqm9yXVTkZgywFoeE2rD9wJ7ihQtOWJKpQW-1kEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeqO5QXch1XipcU4FFbJabCwHXDGbPnf3_buuIZYh0bQ&oe=6ACE38B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43tbm0Rqx7wQ7kNvwFubbEz&_nc_oc=AdoAVtrW3_5qfS9gL21YcC1mo-3InJKpEeMcqKw09BjTjD3wuYTRZ9KO4ZRvnMKWXZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5lQrVRlTt8vRjDUm84PGAJB-d9H33DwUqhe5wDz094w&oe=6ACE38E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y83wXBxYx5MQ7kNvwFT-p-I&_nc_oc=Adp6nzPnUt8hnUegP5VGd361DB2oZeaax2z_WUlvkavUAMj-IW3Yp2qlBryDT_FECMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5u3PHdFTq-XWCF_JlUgGm819Zj8puU8g2SJvQY7lKCw&oe=6ACE3D75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxlp4DcFeMcQ7kNvwHQvFr0&_nc_oc=AdrXDTnU3Usv6He3NI2-nf7um2cwU7ycPHyHuXCrndIv8RavzdjhaeN8pEDf0crUJPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM4wo3XU0QdWYvoEIu3FtZje10RZ-E2SebUBsdzJMMJw&oe=6ACE5702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB9PmD8icbUQ7kNvwGHe6N9&_nc_oc=Adq-_Ql-vg9OrK2aT70SRi9r8yqhmv5c-aNzzkkhrqFV8hRTYFNdgttrI4om30PIHRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbLjHqEQ448Dpp-4FspGpExjDbq5dXfQNjx6toq3IwRQ&oe=6ACE36CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2T1AomyodgQ7kNvwFFkYqV&_nc_oc=AdrcrXasfNgxj5CzkcP2dEGWYkkMAjU0GEWO67iXef_rteC9rXphyAwM4xKvPULFETA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DVnmKu_HyrNMRjKbD_oTRFoXxourqMuTdv53hZiGZmg&oe=69D65EB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LJU2M26bNQQ7kNvwE3GV1e&_nc_oc=Adqsx8VM4jEY3He6hcuBw3v8cRFDTTz6TDfEyOdQoi9i6pyGTcjwbjhz7Kj-jPyk_xA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GfmR478QsmIQY-y1_NqPWtDO93ky-9KvNCRuP63KTNw&oe=69D65EE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z262VcRpfUcQ7kNvwFXowVf&_nc_oc=AdohXo9SfYzRsRpkBL7XOgOPZcVar42ZMB8wU_0HLaFPkeD6Bvx2YXIVPqF9GNvkAXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kQWgPuQ0E9adTGo_2Sw96KKgPWb6lCPOOHLTeKQpvzg&oe=69D66375"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30FYDTs8Up4Q7kNvwF1kanI&_nc_oc=Adpbrpt5X4YcJxzt1XbYHVUYEXC5zwQipv-82RTvg7g5trJYcspn5t405fRHzRIXyJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0To5NLq2mlCI9EcyKItk_43WKiaZdFd4j_pvVNPOhxCA&oe=69D644C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE57f3Q9pfwQ7kNvwEuQt9z&_nc_oc=AdrVxcnsV0IdFWwx_ojgRu37hSHj-QisKZKcDOAaRqXUxLX6tjit6atYrzirTnwx-kU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TF9CMMX4ymVm4E-cjvjw-RwZ-9C8-cQZM-N1m3YhhJA&oe=69D65CCC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E4uCVCDMA0Q7kNvwE19n_A&_nc_oc=AdpReGf9jVJQ_zB7VeuOtHMdlRpPuXAu90wPUoyN-WWQAY3M4siKmno7HfylpPKw7UE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4Tdn_OeAN9oUAGtW04Ro0a5bMJlwB0VrgLJUgfSrDBw&oe=6AC25B32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1YvkAqXJUcQ7kNvwH0NL8M&_nc_oc=AdrUZA6Mcm5xPh9cD6lEZ-ADfmU6tgMoh-JR5BfcOyCCg2gljIssnuQEZTiWvO5rdXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSO7Jamdh--I-JZ-RPldaw2QQw_A9KpX1x6Sw477ZZqA&oe=6AC25B64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lOgEmWE48UQ7kNvwFvaqiD&_nc_oc=AdrBHmIliqCH7mhmasg1ICATQSwXxNxbpgezJ2_S7JnHKzekW473iML8cY-3sgVWhoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOByS4GVsFh9bPiN9AoVH6B3NNPWME7YmUaqmt6d4LeTg&oe=6AC25FF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsxAvBsoeswQ7kNvwGpwwb6&_nc_oc=AdrJUt0o8KwIuUDrAwxXDOAPUHbjUTJyGMOnobXE4Nx7rhK69zrnq4JIzIhfHmlOTII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRCye4K6F_yY9LFRI58JKggQkF9bpCdTptn7Q_RAO9Rw&oe=6AC27982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y37WFxMS4NYQ7kNvwHOPLWD&_nc_oc=AdpjlX9n6pirN3rcJYDGiB-wkS8F00ZPLwCGNP5k4pDfs4t_IlGPhFbgt8Gyezxndmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYNFCjCPm8YTZ3rl7byzYevJ8UXqJhdreINze7D4UKww&oe=6AC2594C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
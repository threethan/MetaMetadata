60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2T1AomyodgQ7kNvwGlrf4_&_nc_oc=AdqRD1vCFAdH7qJOFkV7wIxizB2HUbVWGQ5L3P3wq4ScLggosdLGgWt9kKq9N25WGsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af292XnflBFvXdQvhw5XqsuusLJVwnYYz14aDYaiEcI_ig&oe=69D50D32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LJU2M26bNQQ7kNvwEA6IJ8&_nc_oc=AdoBKr95uLUvg9ZRelwW4rcYmg5m21fzWC7pNq3khqG25jCvsQaaVKhOk-4SkhymrCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JUrxgzNGKnYquG0o5EsO_J3p5CMRJwH4TS4ug8EfFGw&oe=69D50D64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3v9qr3XFNwQ7kNvwFvRoa0&_nc_oc=AdodJz_8DECnBWg555y1TiF47qBP5jUdZOdcFSl8Ol16zSSNWuTDFs8mIo2WdZ4BPjM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WfeB3ghzM4a1GIcl_yRionDJS7OmZnfKMZYr1w4L12w&oe=69D511F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuJzsKvfvg0Q7kNvwEK6Id1&_nc_oc=AdoW6tCaD_Lv05wpB7fctNThG2cQDyD5Bp0m2V-dk9i-Pn8A2BP7FXg0WZTFlIAt-fY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yQGIhGxlYMXdsq6F4O5poqhFgcTrngwdenCSDfp057Q&oe=69D4F342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE57f3Q9pfwQ7kNvwFKO3-J&_nc_oc=AdpunClIkPupqofbmbdBly14v7wlpbHXYomwyku9w-gWfIx2acHmjVqjXU2tm0Z1kIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XQpKopw4saX3M3dBum0tLFHef4KU5FmGAwnI3TCGYyA&oe=69D50B4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
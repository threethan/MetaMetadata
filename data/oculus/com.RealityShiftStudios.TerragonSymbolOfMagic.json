60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxfMMUQL-x0Q7kNvwHehVpF&_nc_oc=AdrCsCRX5hSS-KxAmBwPun-O2-l_DWnw0J_f2Y_N4h31wr_YG6OJBiNiWRWRMGUNFLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEPSE8X-RvfJLWR_Zcd5RED6E5m_SODutzUG6DI55sDQ&oe=6AE0ADB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FntWdv1dnxQQ7kNvwFACB4y&_nc_oc=AdpeioKEVI_2DcU0ods1ys6f0Bw_npHH20r75rFjxxh-tnfYYlYogn9ozk47qvz-8Q8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2TdpvJ97JVc5EHsYdrEfr2tcgRxRnQgg2cXgK09QTPw&oe=6AE0ADE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-uyXIE-IrIQ7kNvwEGnhuR&_nc_oc=AdoCk6gzj8A0y4goHG3Sm-mN-np6yrNXx0DgSfCUyZ4VqhY6Kz1_YnAYVPpDoBpz7MQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbZ_GLMATOng0ikAwdTkZu2-bOqsUxhlXeV7fHM_Hxaw&oe=6AE0B275"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z88hrDfHZrwQ7kNvwGKKr1X&_nc_oc=AdqK7ZcPJrXA36geD4hRQqdv9ONZBpO0AnjdX3PexTKc4iXjtIbfSB7w71AptAvTjx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjVq3yGxKmc33OIp4u8EMSDR15QAVnKq-kfXyzpEGcjw&oe=6AE0CC02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKyF3ggQhUAQ7kNvwHx4p0C&_nc_oc=AdoAdAZSA0OrT09MfSAtJdzRp3g7Q0VnwgscwSB-I6MrT6na3c2BoqB7_5j-vwhBbqc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYyvu3uc8mVLPazNxI2i9sEvCO0DaqG9sXXXqGWIitEw&oe=6AE0ABCC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
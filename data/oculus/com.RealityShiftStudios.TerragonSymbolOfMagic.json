60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4q4xXqul0kQ7kNvwE-5kTh&_nc_oc=AdoXWsk58sK0TF7pRAV126ZHic1KT44xFvPTB5olcN-B1hmnw8s4ZLNBgFn1sd65FhE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1JUxsOSE2BdPISBjFedxzebGj8vl9UMua69FwGEuKiA&oe=69C68CB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wan_UPuIyOMQ7kNvwFGUNQC&_nc_oc=Adoh6nd6C2KUPcnPvB-qlanQfEm67M0rn23Dk_OMwMLCCxjI3rMgYyoQGRsRXWgaseo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuMj4UT5or7DsTGzeZy3W7kZjiPcPuptrKR86Dk2sOkw&oe=69C68CE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9djzF5WL8Z0Q7kNvwGKIbMu&_nc_oc=AdpveGCQnI3BUph3I2q8VhNezJqQ2mEnj2mVE1wG1i_V0S274vY-n6AyLxSV3Ahm3Xw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDTW9QCDcmFInhiIk2fM9XPYZY9fnQr4MB8egA3f7lbg&oe=69C69175"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg2YrKDhjvwQ7kNvwHYb2O3&_nc_oc=Ado2UTPqNUM_j8-HbU6KuLte8YQ2Zfjz_m249EopAAqW1m3Vfy2EGIRSPEOmX9q9NqA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-PYpmO6rrT6gcy_qdkFM_vg_ubrQzpffxWKt2k-wGxA&oe=69C672C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udVD8dwHnN0Q7kNvwGr9RMR&_nc_oc=Adoxanz1uwHvygDhKprk6Ct0CZeO_yu1GvpwuRtyPysVJMp5OSiX5AzlynWKzdQui8M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXb8601TFAig4bUHcBczjklp8lAjhvL-ReXuuQVsgQHA&oe=69C68ACC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
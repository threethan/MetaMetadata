60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3NAb7YBdzIQ7kNvwH1mmAB&_nc_oc=Adp1dxh_QsCvLdbY4DJCa7N4jG9xxks-OQcikJFGvxJ4o72a9dIl9o2lj-mdWil7vOo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGSx7lS7SxzdpeGJSzduOZYgLiTqslxJQ4QlJAzXWbUg&oe=6A661232"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPngM04OjE0Q7kNvwH1oYb4&_nc_oc=Adpi4kaOCzR_3-w8WcEd64T8km2zPOCo0X6h4LV5pCL-HpJAQ7tqCVM-Eiw0USP0bkQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz34Yh8Z_jeu1KJe0s4lBERilcNCsBnJHFjvk867HiXg&oe=6A661264"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzE60D0I5N8Q7kNvwFEpjvb&_nc_oc=AdqPW6X4zhMU0kefN-WPT3Z1DR9d4Tn7ghzAPOlJzjGlmX2wqkOeVXWNFUKUQ19e0O8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmM3D9-nmDuoqNjMFW0K4LgpVhf3k0fyC_oUxzuAkQtQ&oe=6A6616F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVK4OtRLsMMQ7kNvwG3WBgX&_nc_oc=Adr02FXMNkgkKMmq7AdC3YBXmPi9qvZunvLE9PRbZwApAAvBlOdEZtwbISlGCa_kHYY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIcVrkOxK31gLbmEpyWwJr701DtPj3MxJa9Zsio_AJCQ&oe=6A65F842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTm-pHV2VrwQ7kNvwExA019&_nc_oc=Adp6182BHrBH91cIPer0VUDIBb_kzsa2_n4n89jkd9Pca27JvExvnH66dbAUpQmLiKA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZzJ6i5nBR1sT0o5i0beGZ9saLq0yijKx8nJlioA1GpQ&oe=6A66104C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
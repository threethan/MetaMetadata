60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31lPVWdEXfYQ7kNvwGdMK-L&_nc_oc=AdrWOid6Mna_IbGy6RqG5k9nABBM8COlFKc6TnZbR0aJpsIqVl8JS-FbKhp6r5HSIac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ25By62NnYi5NlCIORvMDMeVSgZNDFX_-WrR8bchqmqw&oe=6A9D7132"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuiGpJUuMF8Q7kNvwE_TlnW&_nc_oc=AdqWyV9XXybcYt-QSF0HKES4JHrBaIxhQB2vqtyRMoYOl76QwXDKe98sJYYCZz1B5gs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsqQQs1u_i5m_6A3d58J8_J2YryCjab8UNOXPeH9CGnQ&oe=6A9D7164"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQiohNxi34oQ7kNvwFPEQtU&_nc_oc=Adrt4wnkCSLd9PYiaA9mFfRYOhsg-S55b9_-DNXVY6bFsfEcA24RvWYi23itErthSis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTAXKRvkT2DQ_5tL06G8dJEPDk6W4Z-pRWAhTVebSGRw&oe=6A9D75F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRZi6vlbP8IQ7kNvwGNVjO4&_nc_oc=Adqi28uyMbRtZZfR3vrP2o1v8DhmJjw2gLj3nMLgCqDKGpzL5WHAEZTDxR2hgWRH9bc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5dF4eZP8HjD2SaOSh_9sxF67A8u01Pz8qqAbLxTXE1g&oe=6A9D5742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKXV8bMVrkoQ7kNvwEevjeX&_nc_oc=AdpYAHNvE9Mg5MllXnP_GzU7_MYZQU6_pi8YNlKPckaINBBfE5Z-DSTbpSedkLaXHP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBE1wdLQJKL7Ap50zDiUW4Bma2juE9BU5VmlsfOowSnA&oe=6A9D6F4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
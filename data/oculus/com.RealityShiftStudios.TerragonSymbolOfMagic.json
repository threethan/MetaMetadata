60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFvfMrLDd1MQ7kNvwEmh2wL&_nc_oc=AdoKDdv0zoXKa_ktRCMQsmpI-mp7xZ0Z3wzbLGT9xwoT0l5i7t1jeuxAR52jJEuQkag&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67RQAfsBHvHSfP2u-p14RupjlcDUehtuNjjjBlsQUQWQ&oe=69FDEBB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4jA7FfJrisQ7kNvwGANo3f&_nc_oc=AdqY2TEwy-ToQctQ1CaEudCwW3QBzht1ld8vcMn_SxDsFxeWGgmqZWInIivs38UVu_Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d8hA6uU4xmt4GDehbQYkNxWACLpUXdMUfGYj0JTOUBg&oe=69FDEBE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUMJaO-nkKoQ7kNvwHbHqi0&_nc_oc=Adp5k5_P9cUJPbil_SSm7uJaYwbnSzLdaDfSRyvuMF-3-QmsTb26xXZsf9xUIHj9b7s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I-dKsfE0pdIXAV_KbPo6JtW_5LluerPuhZtbwiNvUBA&oe=69FDF075"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS2xviS-tmoQ7kNvwGrpBMO&_nc_oc=AdohyW6tMdf64VWh20Ex1ncaZ6e2nDAC4PRJdyfoaGWFiIr1ad2fWrtTeeZW_--7wq4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Op-1ucWbtXbuTeAoCyNOpa287P4Ud8Kzz8nhlFqcUyw&oe=69FDD1C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaBHD5tWimkQ7kNvwH33_nS&_nc_oc=AdqSS6J9UBwi8Zpf2h46G6E3BXJIIg2eytN2lCzRBSByulEY_zXAp9sXQQVsZYMlAEA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eaVCeIp0D2C4UIciaCXdJhILKyk4SOVW6_kuejiF2kQ&oe=69FDE9CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
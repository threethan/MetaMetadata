60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHFOQ5jaBFMQ7kNvwEVDJ4b&_nc_oc=AdrGr_aOejKKHTxrAaQ-UWQMZaog_nejYT4f8iK7Ts-4dgIG1rM9cNes5llCnZ7IlTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mNovz5kXs6FaEMdwsSnBG-Jnbd475fBfCVDHalyJZFQ&oe=6A3BE232"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANTE3KRFOM0Q7kNvwG4u-dL&_nc_oc=Adq1oqhVhMOcYdhPbQBwVPYcGC9BOpGyH9OA6Up8lHRePTL3MbTi94mdmEcgEZH1IO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UHg3KTC_t4zJNI5QRb-Q22a77Srv4PmCZCa2DyN8y2w&oe=6A3BE264"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aqQM-c_XWgQ7kNvwGgtECY&_nc_oc=AdpK-tsG4V8S80WYQNauxsmIS5NXYhLCAu2kPb0EM8zl_vuWjf4vFoDBsLsNtGRb7Sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xg4nkbKf9EExZX_A2CabWuu0VSL4ai38Jk8Sob5V-yg&oe=6A3BE6F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLUWtgfn-jQQ7kNvwHpmttW&_nc_oc=AdqbTTNSA0-o-dfoZBAMPYRqs8NvxoaBQcooqG8059UhvDxoTkFgGd92y5-6hyecU0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95nm1nqCY_L6TGvt2LE3cvUqqbKbm9y4U2eJ_wbRwEvQ&oe=6A3C0082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyK5jOGpMGUQ7kNvwGLh5J3&_nc_oc=AdrAM3kuk-ED1q5ipZeIA6HgqVXiy34iqNVi97HgAh61M0pZQpBGPvtIEMMAx2HDXIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x9ccW84t6oiDFByKoHxGLaWNaZYKn6L-GogLnUUhKJQ&oe=6A3BE04C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpqXB2knB50Q7kNvwFJ3PlK&_nc_oc=AdpzDznmU4bDUXDFppMu7hguj5vWaWDGARSri7lMuW1hf5r-ocO0UPZJoLjs-_3GtZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0cPIJgiAeDo6c07hif2PArh59erU-9zeFlYiBxGORlA&oe=69CE75B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LElgDYbivfQQ7kNvwH03lDl&_nc_oc=Adq8VnLG5PyC0zYNqBkbwB9iRbDIlqz_Ou_biROj6UBXyqHrvCNjur7WiFE4a22mrHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ02DJW9zEbipLEFQqmJTtHnkku1pSxyXxEXBDlFjN6g&oe=69CE75E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWdCebHG3Z8Q7kNvwFvJ4vh&_nc_oc=AdoK8EbIs0zJ6VX7ZR7R97mfk-oZoAqtjpi7HHWNpYaE1XtPlvHurz2lJd-KqeOuDUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziQafXVjgsHomc9GaYxI3UH9ScHBOe_-u-pD2dqqcxGA&oe=69CE7A75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGXoLrkxQLwQ7kNvwF20NJT&_nc_oc=AdoThEZ7WlQzCgG0ZcYSlGUmtWEREQGK5Ab28Co1e249NuC0PBtIUuhmxJc_xw6xWj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBUkgNUDaKptYlNnoZIW_z-UGHHtcaZi6ErFjTQAiSEA&oe=69CE5BC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiYjvswSjjUQ7kNvwF0yVUj&_nc_oc=Adq_-aMl9s1K5UR1VEYJLQvnzVfBrnq0oo2bzFIwhI_3RTel95JKNZ0KHaXGI926JcE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8yYUOEyh09La1NEze5RKGf17tkEMvCnLUWTMPRIH2Ww&oe=69CE73CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHFOQ5jaBFMQ7kNvwHhTF5C&_nc_oc=AdqXzmMYRL1-6kHv7LklI8hticQSu01dlMqOCcEpdIeq0YDj2ZkuVBavDMJQkfjiK2s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eaTNsWcvnNcZlbV8NelOGnK7Hyj8689jrc6FYGFR4sg&oe=6A3D33B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANTE3KRFOM0Q7kNvwHwgRq7&_nc_oc=AdpnEFI7zj9sUqnTIVhywHG9Skx08AObptMKgCVtqCmCEHtUD0KQ-CD5eApJhRZsyYI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UqNodQECAcRqdRqa5mXmnZ6tYiJOehXRRqeeb2bzooQ&oe=6A3D33E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwVZ48yT3_cQ7kNvwExdBiR&_nc_oc=AdrVphtlhJtaLG58EKOJ0B75YU1qOdrz6XgQkfga3V78LH-dKaO8l0NM2Hi8yoYVzuE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82kPhCqiuixLQJGKRxQ38Ut5x4Y8cQivZYvBc9eyRBZQ&oe=6A3D3875"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozbNBIbl_W4Q7kNvwGVbvHT&_nc_oc=AdpLtFcM71XwPRQX_9dnfcou6OerN_2mSjagjrWmPRuO4BVkZCzWPRPP1ZwQ8rnBeO0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bR7ZpAx6eBSFFijSnbLuyCveDUOdzYB1K1KkyGAzLdw&oe=6A3D5202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyK5jOGpMGUQ7kNvwHfQV-S&_nc_oc=AdpdJ9PiG-S-2ihDNIid_NaxL3LmJesC2gXRr3vO-Yrif-fgq-cZS4iyzQ0mhFt0JFA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ur5BkT5TC1ldZFo2pLfdH3_PGFwWnst6N_TLaRIHYxA&oe=6A3D31CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8Okz723wtYQ7kNvwF4uu5U&_nc_oc=AdpTBFsgnTFuBOFjuxNbaMkdW-rzXAjUrZCQ6OZqdhzvvXSvImJBRGn5m-kgr2MWKMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z92bKdewRr24OVEr16oJ6YqjwhF0rWkOI_yoBsMTxUg&oe=69FB48B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6TnYleK8vsQ7kNvwEdDgPa&_nc_oc=AdoytoVZs1l40WYRi4790TfJ3yJvRqg_2ZROFrJgpck4xrGailGdF_TeZ7NsBgnvAqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nu3YqqOD-74bR6Ovv6i2ClXzfcu0KaH5vrk2mU624zw&oe=69FB48E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzDPccdop98Q7kNvwF-RHa4&_nc_oc=Ado98JIHiP8uJ16EkfOg1IDshJn0ZT0gJLQP8iTBjDn5OfWYwHAfnrVy6_KAcr-tPFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vWjgDO4RCYdguLES6N0D5XkpUz9C2hgs7uvh47PyawA&oe=69FB4D75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upanDrzvkfcQ7kNvwE1f6NF&_nc_oc=AdqWDpI_6-yIbkY67A6qMfHh2GFMzmNmWU3NiEv1LqL7r7x5M9QwOmydhKFWEQ_NwVc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qCK0SO1sAAQVRHLY8h1cqdN6rLKnPgxYweRJD1wigIg&oe=69FB2EC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaBHD5tWimkQ7kNvwEIYKJB&_nc_oc=AdpJwAfRW8hzJolgBFec_4KwJqIb_ARYM1RNsgv8MHBfSQNTnIT70tJ31_f5_Rw51PY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q4D75ajqU3QHVgCNAw__M63wAIpwbBRsMK45Ank3cZw&oe=69FB46CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
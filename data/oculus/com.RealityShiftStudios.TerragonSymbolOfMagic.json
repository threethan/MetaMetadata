60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dLGHYISULsQ7kNvwGn_6ga&_nc_oc=Adp82t__TGMNuyQ_Zc-PfwHRA6xOIsIExHH8U-4nDysiSwBrNwo7uYXQtD89bimnpmY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFURKvBqKT1wPEKHxVOj6-jmw7MVZmud6NeGiNXcL6mA&oe=6AA165B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFSnUZpNHZIQ7kNvwECHzuI&_nc_oc=AdpVbjogAdrEh19vbukWzKu2rvNSqoQ0aSA-Y_bsGTW_j4ye8r8iCiz8IsbbBQ_d5Lo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFCx0DO_vbb5lgzL7pK9d34HXilWMp_elfD-GOJ5-vuQ&oe=6AA165E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89_FjVutNrMQ7kNvwG3USn7&_nc_oc=AdpJVEikWrgvUrDTbGlsmX0qkvVnV3b5rhqzCe8zSpXVihHfzlHqFuHAwzvY2ErIZL0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ5I3Ar6W_5fPGlUEev8gnGnl4XfTPyxq7U99BXv6ihQ&oe=6AA16A75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05gFOLQVbg8Q7kNvwFV5oxM&_nc_oc=AdrT80pkfCoDYmBIQIZmeACxKZvJ76dSDHT2KdpbL445DXnyztPCDJvfMlrHhpXYSK8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_EAOVqsDcM5GVkRWqalcZ2iab5K9m1Pqq2sYPZ4JCIg&oe=6AA14BC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lpvx62i4_7QQ7kNvwEhxulX&_nc_oc=Adou6zGsDMIgKsqV3kycTH3VnnJq8pSVFMfPeiO0zCme-16Z73vti7Fru0DE-2MWXcM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVvyJaOvyiB35PaQOelGxOLz-FZc0NKqYj9SJfoZwQjA&oe=6AA163CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
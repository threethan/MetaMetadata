60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyrzmsr0kG8Q7kNvwED2stQ&_nc_oc=AdrrbW2H8SJAUUIEPOhZVa74kFPT74KXfPPnzsByHTs6mt2eKIH9vTT6fCQeDYFizug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AmMc1uqhvt4rV_aYXFKgEF63wbVCsln5SfR5356QBsg&oe=69DE47B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUdurMaEjq0Q7kNvwGSEj1l&_nc_oc=AdorTbNz4xjqC_QuK-gZUnoAk5hRPKxD9Z46N0Dnuxj3u0kARI5sLegsICpDMT36KTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-lIcGD9uMXDHcA9cxjoDw0jWsJ0DxaKETXieF8pZ9BA&oe=69DE47E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqicVGGG2nIQ7kNvwF22XPu&_nc_oc=Adqw_fxp1EeDKFGYVRs9dBMExEkGD9MzHboZyrb8Zu4W5qtqBDOR8bwvmG5YCedQdOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jX4jeG3CBlmAWgwMRuTcNz9UKyUnB-ySCYNhFimJ4Aw&oe=69DE4C75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7_JAwpWIZYQ7kNvwFQdk8O&_nc_oc=AdrRH_QOGQpIieqqpl9smz0Ba-VPM9ok2keHZbJdK-XgxbT4dvadze3pKaZ7UWJWPlg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bs3JpE0sLfQLGMKYupxpdFu5ecVA0dELyMCryS4L81g&oe=69DE2DC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2-0Stl9B1kQ7kNvwHp-Q3M&_nc_oc=AdqipYbfGSV9bBBm2abo8HdRBuL818NlwpYJZ688DqbgyAaVmO1q_TajDaG0bXNvt2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g2Dr9-H7AVQqafvIGI7DdUgafQ5jb-o3Doi2xmE0cpQ&oe=69DE45CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
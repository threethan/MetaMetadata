60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4WRA6RCzdgQ7kNvwFllfpj&_nc_oc=Adoati5F6yBIcLfn9xi0s5TE4DP2aIyc1p0C_1aZbTkLXpEstxvIMzwEz2H91DYaaUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yg4Q58iCIopWlT5dYoNengiyFLKthyGDOxkqdIDzMKA&oe=6A43CB32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhlGGOA5JSAQ7kNvwEYV4eo&_nc_oc=AdpexzHhoXP_pfdyS8KYF9x6i5DwfaQm2c0G5vxqPTQHItaQlql7vsJsp8Ok5pM9NUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Hr9LE5ANjhnFJSUEPonHcFhUYG5VZTryn0seC5O82Nw&oe=6A43CB64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYaSnhxG0hcQ7kNvwEkUv3p&_nc_oc=AdqpCeYVk7mEUwkD4eOcPBUphkj41n_iSKvdOSruU2ZQfGlVz34RbgrTSJOswP59PIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CvEouYtSwZIzrQ9KyfUfM04O62ZRsM2M7ENX4nlfO2w&oe=6A43CFF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8dM5hkJ5WsQ7kNvwHgbWLM&_nc_oc=AdoI1mDlqd1wVG03fRuj3YBgp9hju1UbKa_KtbLKqH6PlpTt_MvQ9z9maVtZobJSxAk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x5XFiaQPN-1huSSjNQbyIVgqrAFC4ykfA1qp5pfU2tw&oe=6A43E982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcqR2MrmH4cQ7kNvwGlwwje&_nc_oc=AdozxzQ6Sf9gH-Yiis4M0RLZSMtyk5GJNmduF13xnGmIWRnW_2h8J_8FlM2y_OTgl70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zIwbntH1p7wpxAMUblj71e359IFhmhJK1QPMXLpmQDQ&oe=6A43C94C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
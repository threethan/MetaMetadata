4613_260888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGDAI7ciphQQ7kNvwGGeE_5&_nc_oc=AdrZRoq9hapiYYQ6nycJ8ujblULfLOGvKZFO66msepUNN7Sl_ok8ZpJQJMyNpiw9Xo4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_brr9v3_b4rZ_s8RNPzchzFvD9jziSm2LWTfBTNVKOUg&oe=6A22D5B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nnq_POgEzQQ7kNvwE1onJG&_nc_oc=AdqZ5ADgNCBQIZ7sxLmllyUMdn9Hju4WX6neSmkCOW-NmoAkQLse-Q4VD4sRIwIeGZc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_hrAkSQN7s2fkxvbOWYF0e8XhvMlgz3fJ3HYtan0vew&oe=6A22D5E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4ySL7FQbm4Q7kNvwGXnVJs&_nc_oc=AdpKqDTlXQvtFpHW2ynH_lgPnoiTPcvpcS3y9OjWciNyu1SJuqWTXWUFw2oDvQYyeIo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H_oSAYTJOtFU2i4kHmXC1_rITfu8KfwQzk8sBId4W-A&oe=6A22DA75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqbPa3ysL3QQ7kNvwHxLd2Z&_nc_oc=AdoMsQaJ6R0b8tt7VyWRAGcdUnkWHTMqsPaIWnoH7mJmwDc1vr9XbekVbW90kyOJALI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2EXJqwn5P1-9yZDGYSf7uA7Yt6Zb4POhGkCanf4eZ5g&oe=6A22F402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H47Y3zlbQVAQ7kNvwGXP5WK&_nc_oc=AdpqUtz-EZOxvnshGlc3ori_XxdFGDdUWv3fALK3vc9a6ZpOW9D1rKyXmeJhravObkM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bpWw79A9UTgsx47OFvQGyvOquRodFEeSUk4M5_HsU7A&oe=6A22D3CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RP
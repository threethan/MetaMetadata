46_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHP9dZFghg0Q7kNvwFIuScr&_nc_oc=AdrGjK3j8hkwVrxK7NpGVSWXbKDYMTdYYtMp4twJwndlnEEa3U1vjA3IgkIsJdre9VY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfycPoJNuymI2I540wQK8AVRqlFZt1DD7flo9NWVOKpMzg&oe=69C146B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlXdtGLZc40Q7kNvwHh4odn&_nc_oc=AdoB7AAm-for7mlAEdO82TlwkcehoMVs2197JYpmp0u6iwHVlE5Ktk_OjUmsUh6prmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzDS6LXnj1uiE4drFgNwJO4D19su2qyaJszay2zL7LtQ&oe=69C146E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHg6DFvzlCYQ7kNvwGJ_hqO&_nc_oc=Adr01K9nymWudSzvtMkEpojw8YFtOkyELx51ZnTmS2gfbY7j9vx_8Ep0QpoBXMgzZdc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwgLWI8tGUoI4kFBtblGFTl0zysLJp3BYXeF0DCvb5r5Q&oe=69C14B75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvdypt8byf8Q7kNvwELZZJ0&_nc_oc=AdpWQKDMS2pjOdHQezHsXCjt9VBcuaiP9MueLn6p-kDnNLwff7mq51V8Crudc01O-K0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7p7FMlsoI8SEPp5bH0ryOAxwDyBfCecm66XLnXIXROg&oe=69C12CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM2KAY15oNAQ7kNvwEBysNM&_nc_oc=AdpmCoH2PURYjMpzxeK0G0Jm8xVQ9v4zKAdihflQG9RPHMySOMxKjtCM6Z_AK-H_O4U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyoGsNfDy3kengzD-vhtpWEt9TKwK-mgPggQOTue4AdA&oe=69C144CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
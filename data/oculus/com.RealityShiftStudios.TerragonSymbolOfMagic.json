60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmfkS7Qzv5wQ7kNvwGCwxQH&_nc_oc=AdrZWkfccWuNr3_lULpx6MXEYPMf4_uy8oLJvmdKDd80BYuEgcklQ8vtkrY0WC5kkc8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q43fyeYgXekrBo1xGUPHZIAiYMmeHq2e9QlAwyyIuyw&oe=6A1060B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEa0X31NqTsQ7kNvwGpflNx&_nc_oc=AdohtfldLyq9lDD4zEVN0UE4toXTziBVvcGn9U3Mq4F6kqXa29UTVDDtnMST9SPKvvg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ozsQ8kXXqBY2B7NfqaYbvytKYkxMpyrVCnqyZTEqKfw&oe=6A1060E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvOrJ2_yBl8Q7kNvwGmSFnR&_nc_oc=AdqK2s96FcepKAkUZeHwhI7O4HGnQLUPGiCJoV383L9Kjy0wW0vfHWM0j4h7BIT_9CA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60QxUpKnvWht1jrJanzJpE4xvLIvChy3JEPt9744dGFg&oe=6A106575"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hCTilAYlhQQ7kNvwFPYh1e&_nc_oc=Ado_K6T6IasbAdYCUoK8xvajnManJobmUyywCselXODSpEfg-J0eK1Ns9ia6SDc3BXw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a8sa9Exj8CrGSzodXdYruYd0wEtszJyj-z-6LuWSY-A&oe=6A107F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oDtV4BHhxkQ7kNvwFTS17Q&_nc_oc=AdoWVScpQdfSSeKORtFeCr034509UzbGGzgZMAypf5h4SgCxCZyww6iDK2gfFoi1Ay0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CoBNeT50eAxtACNL_trG1ZOgJPRcoIGuMGCKWJ5UA6Q&oe=6A105ECC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
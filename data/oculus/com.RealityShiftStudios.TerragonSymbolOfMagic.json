60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhqDw-6_ReoQ7kNvwHjJsu0&_nc_oc=AdqG-2fvQLcoAyn1t0bS0jqTpGmB3b5ATBDRYTGKIJkPk2vcJZ69wGy-d1nVnOj-RiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAlfMx5f91u7Zf6oq1qMYCAxpslgiepkCWG-KXNL24zw&oe=6AAFE632"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfm8euvYKFMQ7kNvwFH4xkB&_nc_oc=AdpozpIWeqFzFXsxEx9pbXpkZM_WIakTqlrR0C5C5uZtBhXnDeFxeVG3TmFmRGVU4zI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEa4hBLBRuhugxaBNPWutFBKo1osXB6USHeAo2nsnNuA&oe=6AAFE664"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLZXhfuVBYYQ7kNvwGjCMz5&_nc_oc=AdqBeu7FXYGGEZ1PIpEHplu69q6oF1EJZYnJUFXWR_5L2w_bTIptWKIbXt2Ly8fVsf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6wGq7Ex3Dvj9NejuPjpT_RONFkWAjQOBIhd72BbMfsQ&oe=6AAFEAF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD0w_T5HWqgQ7kNvwFnDznK&_nc_oc=AdrALxKtpg4hEJHCZ-3ELha9MFvAnBJ4hEebG0sDNU6jgPbjKJ2OJPDC0yfyjUTpf-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5cICjRp95H8fF_R0DIXtdoM587ojxmGzUQOsvwTU4qg&oe=6AB00482"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YgYc-gFLgoQ7kNvwEQeKm0&_nc_oc=AdrbZVgbMuk0xa0S0LdqLJq50Aw7q9NtiqvhnZ0nTMy4bG0V5i-Gj-1w4fBtp-31wv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbeWlAPwYblon-WSjgPCiCor5Qbox1z9Ds9isyywjVuA&oe=6AAFE44C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
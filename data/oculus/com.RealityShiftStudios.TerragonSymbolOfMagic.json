60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJd4juP4fSAQ7kNvwG_gQAN&_nc_oc=AdpcVTFUXd6sqJrc_ZAEee1T_A55M6KfkEO5C1kkqEAlwmKkzbGTrB5CwxPz5G3beEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL82TSeCkj18x4G_itgd4F12mNCe0A4KVtWgr8dHH1OA&oe=6A6DFB32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yM-Taly73gQ7kNvwFTXOeP&_nc_oc=Adosjl0yvHcw_8H_5rYE1KZqNw42aoWuU3-8IWjGdGonO599lPlxOWJpO6bgHun1BiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWjQaChjGGEIWVqOaAwtXpKrZsmj69v8eoGed1hG_kZA&oe=6A6DFB64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARt6AoJ2WHcQ7kNvwHj_v8t&_nc_oc=AdqxLeX0zHgHnR4su6kJ98eQUwMCjO-9Hf2ktvq-DbtLhZitCO9Nx8BW9Zx33THbyI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWG_2bgZvJZwtMalDoiNTO9InmBYbfAMxZvra53F61kw&oe=6A6DFFF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tXJ89M5L_AQ7kNvwEKX1Av&_nc_oc=AdqwVyiS_2szpWFsxA4ciscO-iOSL_ThpvMZ72Mtvhc56SzQ45qLNQLCrwzDb50nbWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7I9irLUGBWf7BxaVTBFZ__4Y1e1RNWxCUbem9lCwnvg&oe=6A6DE142"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5AlVGNtlUoQ7kNvwG11Loa&_nc_oc=Adq9A_YBNf7Zx2CafHoiIoWwpT1oDHcZ4UDt77Ebp8jWkPSi21mYeGshD2O2Y5G01I4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuBe-A6nLqK5TbDHvRPsmwXT2LmAEGGj-Ro-4D35QiIw&oe=6A6DF94C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
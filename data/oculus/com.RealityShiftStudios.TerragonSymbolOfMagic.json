46_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ46JUKEgMYQ7kNvwGlsH5I&_nc_oc=AdlBL_oJsWSlfjjL8TdINKymfIL-27hcrnSdmAqHEVs-rkwD_ABOR59epvkOWHGn6FI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8dDGwyX0tfVt39-T2iAq1Q8hZk_9v7IEhl01v6KbdOA&oe=69B95DB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzFFEsWU6gcQ7kNvwGxrLmH&_nc_oc=AdmroyGLk0fYk0ucOejNxz-ZhABrGL8Qe9VUU1NUUmqOc8IH1ma2A9jFXtGkWK03qxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOjse7r_pRqnKrttJLn87IinH9ZCvUhKtZHzgSDSmWbQ&oe=69B95DE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJYRK8wkrGsQ7kNvwFxBLge&_nc_oc=AdkD4ZyMMi6RfFkYx4SlegLIBjI2FR6tWe-n9naJZharvS7H6YI5rNj-anRi0AIRfwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0wLK4A7ZtcfU2SCrnjm-FTcWycTskLiIrMopZjhvYbQ&oe=69B96275"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3ZtXOd7cMQQ7kNvwEqAZCj&_nc_oc=AdlHqEayOv2M6r-6ZVEgVHUGJEuQY1LIBIcO_Aq_6xCd5RBG6_vuVb29JyEwIz9rdAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEPFaKEp91e71rLvDPNYmNczqN97y8d8YjMpS_Sr6XvA&oe=69B943C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt6Eap-H-kwQ7kNvwE2u_3y&_nc_oc=Adnb_Ngnvu6vUODN4lxClb8cpe0bFZM6qQRDBFtzeOxsYCVdEnWr5ycQvnyH5_VGVfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWTjP4AA2xY06RmKYkD7P2U2I8tko2XfczXD0jHqne-g&oe=69B95BCC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
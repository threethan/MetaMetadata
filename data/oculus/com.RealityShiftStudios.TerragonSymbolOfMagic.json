4613_260888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Prl7-2fHHfgQ7kNvwHUfQTg&_nc_oc=AdojdL0xSc_yvmtR9OUkjhyogZWM_cKlKol64_W4XyPuOqvpTPPgQzgTK7L3PU4uJdk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwx5y93qHQ7D7fIRCMzA4mTQxWSSiFLFJAjTKTQ22i1A&oe=6A7DCD32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwNZLYfIH-oQ7kNvwEQAGu6&_nc_oc=AdpivpRbTvmjaEYeid2k2nIzv9J0opedVsqwajCQZ7MEKvbS2DDfkkS852NE8xstlyQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXusgJDlQ3yDw1YttctsAAEzAvCZyWzjUd3GYNhtARfg&oe=6A7DCD64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-vut64Lv6EQ7kNvwHlOb8f&_nc_oc=Adov9NKBYbnhHl1GeeK8CiBDpy97aGyLm7zcOo9dqTiM3RYKsWdbuTdVWiE9nGaRPTE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECh-yG5JCmWAE5myAC_nvOGOtwokppfHuAfFWVhtJFlA&oe=6A7DD1F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iTOz4pRibUQ7kNvwGhyjBj&_nc_oc=AdqrUfy7YhH9v6gpTAAiuNHJ3nBUxqEluWgsNUz3Y1OLGRhon6md-E0bAurxO1lMUU4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiQZkT7iVha2DIHMo8-ChDcnYJORb0o280cMCBoDn2wA&oe=6A7DB342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BfJKv9AUNMQ7kNvwGxw7wK&_nc_oc=AdoafC2bP7HaE6sLJulaYdXsUveYuCZjw9lpVizu5YHLIbH8ntoRCqRDLEeVlSCKmP4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMeXiXLgE9EWF7oCQB8lWL5z0DAaI_tfnsrq4mLgtexw&oe=6A7DCB4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RP
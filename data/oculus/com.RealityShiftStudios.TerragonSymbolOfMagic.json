60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2T1AomyodgQ7kNvwGLP2Pj&_nc_oc=AdrxgPhknZWJABZArX8DlSkFgb4RxH_92LwXn4RcQZ8c0bMz_3UbmVxdo6VLhohZwco&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RIS0fE_1dVkZABUKOU-5_TA2rB2noEwwIuRb8jfVYng&oe=69D7B032"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LJU2M26bNQQ7kNvwHDAmQc&_nc_oc=AdpAc_GJGItEdTXp6smBcdi9OIGeePoSjew7citvdlWUaIgowhzDpSMXOidXH53Od8o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WaBOKmcxQQx8CMIiTdR3Pl2vos7Kf0iDz_C3yYkH7Ig&oe=69D7B064"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z262VcRpfUcQ7kNvwGuplgy&_nc_oc=AdoEixM_D0JL1cAoK6mcP1rXyNGW_D7E1LAwX4GuthanS99qcls5ourJQkC1J0twnbo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fQhUb2MZP3Ymy3eCo3S4tiUarNXJ8oraO7lMBptM3Gg&oe=69D7B4F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30FYDTs8Up4Q7kNvwHN1JwW&_nc_oc=AdpM7rqUHgbZeWgAWPCOJO7QTbf9gA4sUPoC1g6sxmM2_wGrZ8TuojVhpra3aPKOATU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iZqx-hI02PznBx0OwgRUrNbdCsjox_rIZ-XrA9oHUCQ&oe=69D79642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0wLQeN8Hz8Q7kNvwHythkM&_nc_oc=Adqvti1hcun8lyqCMEWIM2tSNQQPqs763FU6ouQeL5eGgDR_xqlKGWsPxvkzHqcjJFw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Oaw7R_6aAejifQImF0KHXUocucZa_OEj6cCUIYbqXvA&oe=69D7AE4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
46_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ46JUKEgMYQ7kNvwGis9l5&_nc_oc=AdkyB6zquux9W-fjOmgHzx2Mwc0M894h-N35xT8x2vz8bGp4ZWlpeF5ZBhuw05LaEh0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfymMTVAxxjXED6VVEj4v_pbNo9eHuf5CC0TQzxOhUuaKw&oe=69BAAF32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzFFEsWU6gcQ7kNvwGJX0rA&_nc_oc=AdlfSZzTvApsIMwXZ6PCZxp3uZ9eIaREHJhSdKzu_mHktrTsg-jKQOHILKX4e3TSKHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBTfAh1tbqHOjLWQ5MpCS1bQct5Gtum_KzqsMr0e8yTQ&oe=69BAAF64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Frkk5rzluF0Q7kNvwEdJrr5&_nc_oc=Adl2vp1jzrmZ66a4Pc30E5ytSkPUrmgR6qIHklZY-zVVz6UGyz1r1BYmC_8iNrpEsJA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxY1wpFCU9eEufWhtv5AVU8Gx61oIuh7kb0Iptdrco_dg&oe=69BAB3F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rpa9joXcfHwQ7kNvwEknAXp&_nc_oc=AdnC3D298wfCCCb28MvgaFTJIf7P74zyiUtcW4_6RZltQEZZa2vDAK62D8Dz8cM2QDw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7bMflmPl9RNjZPsSbpXcMtRTIb9cmFoy6DiXgz9Vvuw&oe=69BA9542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt6Eap-H-kwQ7kNvwGjEJPQ&_nc_oc=AdlCsdDAsu4mJNPcAsx3hhJ6gpDEDWV7W-dXq29AVHKfunk2CamEttwTk4ottWt7910&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyg17NrdFYryBm9aC72pUWDD5HmscDMyy6Fns9Wc3OPIA&oe=69BAAD4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
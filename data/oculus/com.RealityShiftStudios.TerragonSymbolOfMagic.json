60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yES-I7B1xnIQ7kNvwF9VgMn&_nc_oc=AdpvckKTmv11JBQ4H680bJkx-A3hi6w3F11lgS1SN2BEWEFS-okaPDtD7_L79KMkRY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsjCOFhvNnXSWoqntljAQDG_ACvTVqzrLlwlTHCJolzg&oe=6AEB39B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbkMCIzSgksQ7kNvwFA6L0R&_nc_oc=AdpmbbA8MpiVYvMrKUw9TeDDv9lQVkaFAWrhrw_V7F7rRKsUeiB-4pbJkh6poqgXjuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjhtF96H0fWHZ95o5IbdnIsIIOmuMZKbBWKSzaFOGNGg&oe=6AEB39E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvuRKCs-LzUQ7kNvwHpotJ7&_nc_oc=AdoaHfXB5-BEBH4M-axmCdkUq0tyqK-ALSZmG_fzeumteykH_50JZqMQeT9miVNLC20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyWbtXo9B9aG1Df0mdW7NQF7fpgtaggqxkxD0ZNjnFWw&oe=6AEB3E75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc127-2UsaAQ7kNvwFmcX4O&_nc_oc=AdpOOmnq8h0kWgegGFSD0bG8iGL24ckfuyQTXl2-jYFXqO16xU-UkjG7ZkUbwpAm4Oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyBDqq3LV3Q9NXH6DW6TbiFBtaIPOad-TTMO3OP6eoIA&oe=6AEB5802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci0hrUGxcikQ7kNvwHxRWuv&_nc_oc=AdpwDYEvzGafKmOB9m3mxlEeASi1H-IV_-YHwYdcmDpiSrcElacV-5VZBBhxrSvEod8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyjdkPvUzKLvBnrGS8CxLBywrW31N8XVyWU2z6u1u6Ow&oe=6AEB37CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8Okz723wtYQ7kNvwGxVvbG&_nc_oc=Ado8u8D3o4vDlNpKQaEsGYKHD9n-cA6DuY_D25952_TcepT3zEMppkQ1RvQafZrgWIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MY2xXXMKCXc3LkgBOoOS4OSUJyHtSPhqoLZSFB53xhw&oe=69F9F732"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6TnYleK8vsQ7kNvwGRlNlN&_nc_oc=Adod3glHwerqpaOgkUmJornj_8dB-G4Klon9AxHwglFO50_nLITdtcSVW9gtR1fwX50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iRfPK0N-zgVWcsJC72210aUmJNREBZIXfHSw20IrWpw&oe=69F9F764"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzDPccdop98Q7kNvwHanxTe&_nc_oc=AdrFGoLkcGHfj6kEJgZcl93J5KYzAPdSB8gTULxkCPd3iHcBTKGSOpxDtBbgmzN1zOs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67SNSXFVl_AHdLhB1m68ojLwFu4_au6rRKCeK07eMLnA&oe=69F9FBF5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upanDrzvkfcQ7kNvwEu3Ufa&_nc_oc=AdqXl9JDhxd2_9WwuMVo_9ILBPpeEuS5h-3KeOE-P97Vrit6GllR1yGXqn44zxWcjjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xLAUdLVFpb5LkJyJzFUFgHzSzudRfIutht2llRzpSoQ&oe=69F9DD42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c2rwzuO980Q7kNvwGg7fpp&_nc_oc=Adr4h76vGKyayYPrAqw4K0IhzUG6cH4eY8yzP8ztGV-lJy9FoL-gbbVGtssFOrG4u5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dcShbuGav39n6LRRR3Q_TF_sX766YskvdjywRsLBTng&oe=69F9F54C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
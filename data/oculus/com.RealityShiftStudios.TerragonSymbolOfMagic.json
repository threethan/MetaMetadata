60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iJjqHZ1UQAQ7kNvwEFN7vm&_nc_oc=AdrfZPYZwDndi19AjtbtjZTiaOclHXTvnwrZJZsdcGqGnH4nlgLkmQSUvUiI-oY5FBw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa9IJRJN0hn80gNJ6DF34VQ9cqjZL9JNKMeBQZHgAZFA&oe=6A539D32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqe2JfeOQ9sQ7kNvwFya9y6&_nc_oc=AdpodiDcOuILXdQJ8lGweIYLlnaQUJvcC5Q8C3uHh-T45W4s-WLQgS8ux3uU9jhXaJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDztN10afznw9iJoxtAXlxYPfVsVADA37bxmiJYPt_p9A&oe=6A539D64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ndcv8W8u5gQ7kNvwFhOc-P&_nc_oc=AdrcbPGuhuClc3918ftrow1TRtZFVcAMbvTjtAgIr67Ij23I0P9pxmay6qotqF0oCX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvLiMRLwr-LjYmob8K9iQYZTtMnmqcrbRWXUFX2YUGgg&oe=6A53A1F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Str5LcG6ZXwQ7kNvwFtp6rU&_nc_oc=Adqnvw9vSDR9BaI8RrO89VNXbB_FHPcKBCqZbFkjjaO530lX_n6LcTwm1ceReI9kUHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7EpF1Ow645XBVx6XIoLIeGapJj0FaRltXpzbH9Hj6nQ&oe=6A538342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U96olm-CoDsQ7kNvwH5QYe3&_nc_oc=Adpn4vbHRB43MB4AjbyTnJQPGA1NLPMylqc7s9JNBybkghSbmFHHcMM9nlvvilDEckg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEq7546T6DDMWkl6ytmhWWUYqIx6IzjdM1b0wXV4ri_g&oe=6A539B4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
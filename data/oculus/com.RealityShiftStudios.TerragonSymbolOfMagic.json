46_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc1XQMUkrnsQ7kNvwGBiJP-&_nc_oc=Adnxpa2ybWO3haL17mL5rhl-mMNRUhY9g-Og8me6ZT10k2efJ0Jimbt3XYd8-GdN9dc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXnjKj_GKMQpYL2zMKrxQht5GD27o8XWBq_-kD86EZFQ&oe=69B6BAB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyXNXAyr3RIQ7kNvwFdpvGo&_nc_oc=Adk2iBurTLw9IcttRkJCBVI0Mb4feGxPn0_N3fa76SAHT_77n9VNnKk4bgz2H9jz9nE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNk9AH6IHlgL0j4yUEZFoAVq5b58cg1m3OsZy0x_MiLQ&oe=69B6BAE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJYRK8wkrGsQ7kNvwFTOaJ1&_nc_oc=AdljDaJro9x67joOcQ-FPd4NvTVma0R3mpJZrmv9MlEFfuK-UFIFj6H-vVExiF8oyvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAtpgfujA4xIye1RRzU6M2Nvh_lp681UudCcf1Ic6wJQ&oe=69B6BF75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3ZtXOd7cMQQ7kNvwG8-yr0&_nc_oc=AdlrZGIbbke1CwKiPssdOSbhgwIsyVQ4QQ_e0UK-szejsacymunEAyT5_V6addgi_oI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwheFv8wIglLzaat19qQbxcGPj4SjhDq2kbpuQ4AELrQA&oe=69B6A0C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Vzqp6cPuXEQ7kNvwH_T1CK&_nc_oc=AdnMuZdbnwCJYFgGN4jY8DuU8TBnqFViLd2E1tHx7kY-uuLmrGFV5lagpA0rKU9ozfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBxQRDDU0pbsXkWjH8s5F1QIiH3DrRkGBR9zwljPZ9fw&oe=69B6B8CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
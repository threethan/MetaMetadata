60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4q4xXqul0kQ7kNvwFqCH1n&_nc_oc=AdquxYHJkUlp5lYgtQ5TtTZZab_8LMwR9OdwyqJUGshJ9oGARpQ9Os4wd16cJU75IIw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxdj4546OZFmtf0EqHoU6xz2wJce6GMAnxVGH6IiCbZmQ&oe=69C7DE32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wan_UPuIyOMQ7kNvwFSN9hO&_nc_oc=Adr36Ee2EWYkR6BFQ1h3ivO87okXppdo7xEF5oPgmUOCDJuIsfRpvaWLAw3poX5FlFo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZzjR7VY8oLeMWTyV70XP8fNDXhWcDmSxy9UQZYvCXFQ&oe=69C7DE64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9djzF5WL8Z0Q7kNvwHCx4KS&_nc_oc=Adqfn9cOFuGaW6NcE2Fz0rfyOKJX5jHBwZcMDnMFozTv36lbMUPQDPEzrri4i-vIs-c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoIUHG4a6Bacxl2Hb0hdh8c8Kb414TBkYWhwOaq-lgvw&oe=69C7E2F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg2YrKDhjvwQ7kNvwFQ_9_2&_nc_oc=AdoYLzgIEKvvs0Y5E860ubag3CGv35QgZGUCjgH2zrxDUjq_pv3-iptkwtNeyD-YI8E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5RoHkDbw0YB3Q77Jxk2TF_O5yBF8AVOx4XjtX38yizA&oe=69C7C442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl9ns0JQ000Q7kNvwEDjyIs&_nc_oc=AdosUSN30pY2jVUKBjXAyv_LHCWBJqEge89i6DIBWQ6XT3m-vAWiMt6UtE8OsNx1R6s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6KCMqQlDniVj0YyM10x6YuT8RZD8IbOWwWGLVAVonTw&oe=69C7DC4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
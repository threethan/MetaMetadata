60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se0kbyi355QQ7kNvwE_uuC9&_nc_oc=Adq3udEhGd-J0eJwnTAEkXOFqYgU06zlcwO1Vy5HhjkLFxlTrZxPyDa1YY_CZACbJ3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwqBsIyhv2e3HGVY2vqobaNeXCMIEPN1RtjHcb8XPPSg&oe=6AEDDCB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EfMuHmzxvsQ7kNvwH2miWa&_nc_oc=AdrbJs9Iof6QopP7rFGQ2duivDEu66cYNEVuAwwep4OwdsuaHkj6OyX3dXRqL8FAYBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0s4fZCxd-zbddFAX0209rVNayqXSk2NgymuXpZJ_rrQ&oe=6AEDDCE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZokrNIhyrRsQ7kNvwFbhDPH&_nc_oc=AdomXBVpOd9ClOhBADYjg0u1v5Ttv96MN79FWyrQcX9wOo8yZPXYm-tbeOJW3rCUMqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpZEYmsAzQhb08cqO5lNyHyt3SypMa3sBG8uafzyAVAQ&oe=6AEDE175"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rc127-2UsaAQ7kNvwEX7kVc&_nc_oc=AdrVDXI7GmI04i-J2i4aSA90mM9LXJ2ZKhpMVp71hHbrATwGZqAS4vjdpDBE_JSIuJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSzNuqtZ8CtM-gxPc9qi5H9IVVC3QMUpUSar5QWZflUQ&oe=6AEDFB02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQMM2glXd1gQ7kNvwH9zSTA&_nc_oc=AdpKLAeqWvAB5NLgKJV4Z-545kNnQt11fhe2PV-Ib5HnUNJBy-YLyYJwN9lz6XlBFls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzOj6f2x_d4qYiTGl2hewLDWj13LIDGdKTvJgFRw6EoA&oe=6AEDDACC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
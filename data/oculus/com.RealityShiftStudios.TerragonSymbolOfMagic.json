up_&_nc_oc=AdoxaZU44SBrrwRFNOMby-4uteu1aHS1D22DiuqHfvAIlxPHBAyHcY0jAJLt1R8YQLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af38yM7d5aEekNjClWjLif4PVAYnsUwjUfrdKf23Xz0-ug&oe=69F0BCB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsKItAEozYYQ7kNvwEglGVE&_nc_oc=AdpOIvAI85wvmfT990H7JOX2HTxn0ITNyyaig11l4boveSABVBAd5H9ccOl2-ue_a0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2hGO02ehqzpLaTznaUKqcPsycxz0X_JvFkz48a-OGG4Q&oe=69F0BCE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXtkIC4g_woQ7kNvwEZ_JCx&_nc_oc=AdpkzjOYhHBtI1oYlpLi0GFDDlvpC5zwIPID5c65KdPAXXErRgawrPnTMzUFyGSrMHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2jV2cAi3FRrQeocXc8ArPQUme-TrYfFtR0IT57yFY4UA&oe=69F0C175"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfybp0IYzOYQ7kNvwEb66Ib&_nc_oc=AdoBYGgaTq6M5kLC6Ew4qWgOEaGWOCPnW9W3ql4eto_m07IIKcvK-36AFAgvOqU6jQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af16TkL8SY6Ud1LFiaeJm733BVXIChOR0doGEO0XBM-Epg&oe=69F0A2C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQgiWbzxa3YQ7kNvwG3PNTp&_nc_oc=Adq_amlNsqV0KRexsqVs0y18lvy0QpsTPht7C-lMQXpgKjAio4AWcYqSMvXzpWv5mzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1S513fG6dUCvZLqMUOgiy10sc5YgogZ2sTj-KbolgjRA&oe=69F0BACC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7B0V9al9aoQ7kNvwHvmNq8&_nc_oc=Adr8vd1jNFa4CsR_asXz2gQ1kccjcyYR5YQeKYi5pyoDDcg3U4vBKS_tr2O3EOa60YA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e6T3aBZk1gsHMFkztJdkBlqhg7iIrWo1fWCyBO6d2UA&oe=6A32A7B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBYetuVVNy0Q7kNvwG_75BC&_nc_oc=AdpimsGD58F_pngOwzG8DGgk8Y4t35qeWYL49zf_IlvANBNntRvfH-4xGCgJco-UFw0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pUlrExS8-hDKGJBQ66ZmguS1BtpyWG-rk3p3n3fdLvw&oe=6A32A7E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsTtQFuFVN0Q7kNvwEjUlSN&_nc_oc=AdofldpmVosBEuCvuj8NNLVs94HGjvP1ePfREMMCSJePMdRYkD8ycR6ZsgASqIrooAc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZmBZYXQtpXyi_lgEyDuXvdvUesVFVhus5HIHRUYtrZw&oe=6A32AC75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoOXov2xDAIQ7kNvwF5_bCA&_nc_oc=Adq49YoW2TX3EG0BYi02FTTOtIzo47dFAbiQwt1NxLh4GlZACoDTuOwtm1sDORybZP0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OKl9tDR5sMoVFi_8owS1NiPV3t9ABiOeKoQOWNdHLSg&oe=6A32C602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrGBDEka-eEQ7kNvwFZ_028&_nc_oc=AdpUyix3yr3IKnt5KLhA2KZW4S5la7saKdlHwaO6Eu3qIwzRQVxT6gAgZiw_Yyc0PYM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RWA6OGxV4tCZgCVuzfowaui2q8s6xuWmeY10AM0tf_Q&oe=6A32A5CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0uAwZjfmQwQ7kNvwHkBVBF&_nc_oc=AdofKo8ZCz83HfJX69tsVi28GAf2fCoOAru1ZpIGSFX_UZjnT4jyHCetqV7OzakPNmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeHbVU5FQaz67nt7BfW2z2bkH9W7bSsU4sTRVd9Lb2wQ&oe=6A71EFB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWCVuLxzK-kQ7kNvwFbSPqZ&_nc_oc=AdryjLNrjeYGAyKb31LupXDwswACZKJttWyAZh1zC6q5S1opy62gw5dzHaJYkH32etM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuBFQDU1-zGLemX8y8j-60MgH51YGd8afngRH_oclWQw&oe=6A71EFE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVDwQsz2MAkQ7kNvwGR2iUu&_nc_oc=AdplI9Rf65S7t5Oe0hPbRp20hpmvv-umZvHoa1dbvjZ7Iaw7ZLKcwPPQGb3hd1p8054&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-_2oVpwWfPXNWZnSNbw6MbzRLLeTvkjcZsv8LPXUkVQ&oe=6A71F475"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plvmWfsBNfMQ7kNvwFWM9Zh&_nc_oc=Adqd9LpwJw9oZI4bhA1kMLvZjIWPI0bKe9E1-7QyNtpFsTzQh6SynOqBWwIwxB7DJxc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa9tpY4tDlcREInCIVUGsJYJBRpt7WwSt5OMXtA492aQ&oe=6A71D5C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI0GOVhJ4YsQ7kNvwFFrbP9&_nc_oc=Adp7re3xMf-qH-9L6tZprxiSsIDris_XtqywzdLNjYK4Xh6Clg1M2zfhYyJlR5RSXU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8wI7RqX69rn-l2HDuhzLzF6wL5wuZcezUGxMz_6WLHw&oe=6A71EDCC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
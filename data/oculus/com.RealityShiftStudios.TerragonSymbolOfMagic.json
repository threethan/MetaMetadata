60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dLGHYISULsQ7kNvwFMTwWK&_nc_oc=AdqxI-oyNqvbN8E0hSmZi1iUwTcOdCNY_F2jWuWKWax3NJMhIp7EMngePPEgFxowOU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAoVtPMZNly5hXLi6yTdrY0mSdLahjipNDIRO3iXST_A&oe=6A9EC2B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFSnUZpNHZIQ7kNvwEIG_Ap&_nc_oc=AdonVrTHf3z174b4bZ0ezxBStq8Zp5Osd1UKTa3DCAuwu7YLr2yeZBQgbXESSAadqss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVaAYgD5JDCWhmcFpgLCMcfZBQQaALytkoOAghg86fJw&oe=6A9EC2E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQiohNxi34oQ7kNvwFofZFQ&_nc_oc=AdrPa3xZoaWIpJCUi9rhwcMarD8BBcY7fHm5qV77yO7xhnV5F6ik9_Smk4q64TnRfgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNMZGif0P9PlDzo2bf8Ms53wROTwaXzXeP-BoBuwxKvg&oe=6A9EC775"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRZi6vlbP8IQ7kNvwG81x6T&_nc_oc=Ado2XvMp4VeM-61p1kCZV9Ajf9AU_8J2O5e0r8EamFmH2xH4JsOXZ7ToU7Oq7kQ6Pck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjjOUVoxmFGZ9gl7nvDn-PYr3qDlpPbBuLSmzJ5-vsIQ&oe=6A9EE102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKXV8bMVrkoQ7kNvwGvC8m6&_nc_oc=AdpbtmlrjIwHwRFhRlBqm36Yb4REou46ykQOaB0GW1kPZ-Xgk1FwEIpeWjRh8y1V17g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqlygIe7E-hvaygz3pk1AQ-j_s2ypSDB0yoK0iZ2pOIw&oe=6A9EC0CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
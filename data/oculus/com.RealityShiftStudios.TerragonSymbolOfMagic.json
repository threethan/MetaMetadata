60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ILMW_UyJa4Q7kNvwEtpdhs&_nc_oc=AdpOuBL9wmotHWBnqsbiEU4eRCsKKpxrRladyM5nByoIB6JW2pQdPpQgzAW-jD7pPhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHIXPKhnxFL1sO40DYDPruE-Fz9-8M5f1SCiqnZIlzow&oe=6AB3DAB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8EtviRAv7EQ7kNvwHoA3L5&_nc_oc=AdpMNF3-DvKkXAsxuV2Gqq2Dh255IbTEOrCvpD1URbinY-VsF30oJQYLhK7G12ZfreQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLigjgh_WfxY1_alOPh9U3CqqqmJ0jJrHt4EI8ViktwPQ&oe=6AB3DAE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geNJa748n_MQ7kNvwG-Ii2Q&_nc_oc=AdqMioBPdI5sx1ADKe2MeNKIRMfcL1CGf0Vo18sGlUs9SunwAHukJmj6RDFA98bgNGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc1IjXoePGwoqGN0gH29ppwA1Wu9pwbHQWoPCzz2RDdg&oe=6AB3DF75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swOsBzhiQNYQ7kNvwFvuord&_nc_oc=AdrukK1Jiwa3K7YJ9x57Uhp9THlEqGpXMMTmycmTvJCiwU3iJUsqJkSOxZ1ZKyNUeos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_zUELnXdkfuEurmgKZXlLuSaEe02kPjId-hYg5eZFHA&oe=6AB3C0C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6eNW-lxpncQ7kNvwGWrxGP&_nc_oc=AdrsruZTifyQL0aqduJyszfWjCsx_5_cR4d2yRCup1Owv3uWXV4GCKU9uyX7u53hxmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlya13T7Q9rcvAoUfLbxvn5kmd63CH-tah1kS-8EwzRQ&oe=6AB3D8CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
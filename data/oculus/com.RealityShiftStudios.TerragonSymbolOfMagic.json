60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iJjqHZ1UQAQ7kNvwH9V336&_nc_oc=AdqymepFDGYsTwkm-1LiDmwXigEbjLrKeODj-sUigR0CFfi0m71NB9EHl7SgqVxzuKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo8gTlHUhkE-P2oz4f62ePvOJHgGgasw60ZXPdkb5wOw&oe=6A54EEB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqe2JfeOQ9sQ7kNvwHoIXKw&_nc_oc=AdpjWExHbZkMgZ5rtM0kOh0_6I5RBiaBoVaXO1SQh1tYnTl4GZoauBroRIjc5uIEc10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACuuRmj3N90UL3c-ZhvdWa61vIQhiKP00P-bFaCAXL5A&oe=6A54EEE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxxndhPnAq4Q7kNvwFh-TCZ&_nc_oc=Adpc3bWnaLS2Olo0k8x-wDVLyt-b1y8TEQEn5Es5cVNym9702BKPnBeiE-vUuJwbaIM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwu7vKj6mGdZQG7lnGnf3HRBleHl01M5E0AKVsQs9l2Q&oe=6A54F375"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGxAZeN5jSQQ7kNvwHxOkW4&_nc_oc=AdoBIQLBznEsHDLWIt_VRYy6sBy3IenT8HLZFbGPyG16rNxRuz6JufxkdaxGZtkqQHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKHao38PypBxxhaPuACYdR3KhjLocPjTKt620raW5iFg&oe=6A54D4C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U96olm-CoDsQ7kNvwHqTP74&_nc_oc=AdopiOvSsBzGw12vgXwgvFC54N_o2gqjamtGwrMw6HzzBrq8DFBEm8vGNXNAONC7_3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC70w8m2YppEzBXKEJat6mzTY4phS8O9_XEbpvhZG2HqA&oe=6A54ECCC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
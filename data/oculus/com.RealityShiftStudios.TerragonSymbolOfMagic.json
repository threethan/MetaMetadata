NvwGGNzjQ&_nc_oc=AdrOIauITJ86dEu42L_dP6fqCmfhF0ubIX96GjJqGhwEBgnxgNgG1n0lDpAyU5xp0eM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLDE9Qi-6nsq_xVEiFnFq0D0HXZWjKuI9cLxCl1wfhaQ&oe=6AFB2A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJYyuNurjn8Q7kNvwGHR5or&_nc_oc=AdofiHfuDhcQJmWLOkGZWA-octf2yjhoISsg1X56h3iMHqjgkYpYJgshCyQ-YpUGUxM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYqjGVD0wzxb7K-aflL_sPnNq4oT5pXbvDRispUnrqhw&oe=6AFB420C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "336676708353118"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3928214990616267", "version": "1.0.0"}, "id": "854082535525785", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3814641058640328", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3928214990616267"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "854082535525785"}]}, "change_log": null, "created_date": 1630608422, "id": "3928214990616267", "version": "1.0.0", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "3928202693950830"}, "asset_files": {"count": 0}, "deb
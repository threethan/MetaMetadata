60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1-6oKZCM4gQ7kNvwGjDuXn&_nc_oc=AdqhA8bth-LJfq4v1MHlSCIlC3_Fs6f1yC208-A7V4h1Fao3Q_kcqkVHwTCJXgfvx4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8x6HokP03lUuVYnA3893u3lHi6BQks1aLQ8h4BUsN4Q&oe=6AE4A232"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R4JncN6u28Q7kNvwE-gIyy&_nc_oc=Adp_8WkaARxfe4b2_vyg73vvJ1oLBn7NVIQCepmXcIRs3wItc44BdRGyqBu90o1az9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAYCFYkPGbgCbMiNjB4T2LcAYXpYsFzql9WDOPydCzpQ&oe=6AE4A264"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE2crNSMl-UQ7kNvwH91TZK&_nc_oc=AdoL4u7LIdp8prZRDUbTFbGu9q6IJLlzhEsIjalNg0LD0wBg4rMQRgzk6whrw7e_JJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhgfpr1CcayvweWLuLtrH5wjeZyyDp-jdSrOthwywz1A&oe=6AE4A6F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR4g--JSB9gQ7kNvwFfsHM7&_nc_oc=AdpEIeO0Vw_PnlZsjr4N6mOpeBJ6-oPumUsKqFaQlKERuSezixfgnOruTjakOJCB88Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMyrSj6QruBTRaf8IrkFycPUu3hH7f8UeHon_i7yEJpA&oe=6AE4C082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffJVbZnj7kcQ7kNvwHjn4HE&_nc_oc=AdridXsYGwDQmq3-7IkQhAAB3wrTvr_o4f7z7_2E4oH6lKqIJ2oJi0q6OBeMbLcsiK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwvye2qUw9O4gb1mc4emprbEtRAo3oqcTF1ByPdaxRUw&oe=6AE4A04C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
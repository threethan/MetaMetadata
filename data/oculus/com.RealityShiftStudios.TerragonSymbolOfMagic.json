60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_dOJTsoVncQ7kNvwGgt8gj&_nc_oc=Adon9vWAIHB2DIs4QPUkalvkY8K5XoANvmG8N-iYQT5cQjDpYIFWllatpXK3DSFYO4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3ybzXJxcnOzb8LhnvujbDktjnQ2QDQ__3aiZWA4mjVw&oe=6A354AB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r72d4m4s4WAQ7kNvwGVsmzs&_nc_oc=AdpzVwc1qqFeuWbHrUshCfuBBI0VG63rXXki5XOHcH-FyfMmDlvlpJQEy8pAuGvJzmM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QnbvqvP5utisrdxytJXvfP7XAwK8DDG3ZQIC4zKDa3g&oe=6A354AE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX7t3ryuD5AQ7kNvwGijiyI&_nc_oc=Adpxu7YtQgro9fJ7T1FvFaBHRt0SwKZrfPPDBZPqaTdB0xKjBIPW1IEoLYr3YRe51oA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YlvS2atzjweP8NZnZ9SvHiGfGdXVF5GHjzstn3YXbxA&oe=6A354F75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdkCKHJuF8UQ7kNvwHpZMcn&_nc_oc=Adrr7uK2GIC9HnlcMMVQGsv7qM5tWXIa4AmZ0z4CDAxfnqQ9AqcVTUedLX9GfoYJQwA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BItbkge2wTgIOmFQxioFtpiwtUhVVmmflRXdD_s3q6A&oe=6A356902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrGBDEka-eEQ7kNvwFFcKKt&_nc_oc=AdqhQqzMWMXjqBHLW0oyrXvsAD0Lkxe0e3TZpYZiJ41AkHHrJu0VlLBZCbHgwoMszv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FUu99LtKj4mFVjvEdmy0B-2ax1gzPK0w_ZJR-Jn6vNw&oe=6A3548CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDs8DrFyiSUQ7kNvwHne8DJ&_nc_oc=AdomQy_FrOSwmKelsplgFqT183LJSKM9rSRl9WlH4pfiJzJxlHKH7f093c8j7KHQmBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeebRoiWbigg2LZYlKlh6jZzpp28Eaei1bzUYRZeBn5g&oe=6AA7FD32"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4vOYRTpZg0Q7kNvwEd4lX7&_nc_oc=AdrTqTDdpipylTkWYT22Y8_SJGgrrd7VCuuvUa0ddltra3xKrqBh-mA54P0CXaid1Rs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1MOThlkvGoBdiK1gHyOsyUgm44uhwDPhoJn_rRlpjzw&oe=6AA7FD64"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhP4n-G2QyMQ7kNvwFhU0rI&_nc_oc=Adq4FjEfX4NzwN-J1fr7Yis3q7L44ItaP_2VOirY0roCJks5NosMCXfbHcl_vCIzrz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhfGYK6jLh-wyw1Mm0sG6reUeVZB7cse9atPS0AQT0mA&oe=6AA801F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnoDZRg8d6AQ7kNvwETXp-S&_nc_oc=AdoRQM54megTBSUIuGiU1tlg8E3OOUdy1vIKGpI4wU1beYYhJa6QOT-Wdi5NqSlzhxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqgNWgPRR7XbknKImCn-pXB1NmdruUcmuq5VvpjqBDNQ&oe=6AA7E342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZp_mjX8lvkQ7kNvwFmkrQQ&_nc_oc=Adr9LUrQzcgDUBWfEOcuiPqsjONzM-Z_Mw2ligKrc6IzIzPvWZWBqSVMHYj_w0LLC6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgsE2BoLtYhl5J3E5A_tZlpoFRTwTtMJpnJXMwAAJC2w&oe=6AA7FB4C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
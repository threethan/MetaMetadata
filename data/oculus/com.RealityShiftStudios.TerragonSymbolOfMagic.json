60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=br8jS2j09hcQ7kNvwE2iydS&_nc_oc=Adpt6Mf2078zR7swX2ORRMZanqyfeJn7zmsGRtN_s_i814Y1YBHtVC0G9Rn0cxH6qMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8otlNNU2LPICHc-xkYpNDtSFQ5RgyPdq5AkL1cP_G_oQ&oe=6A37EDB2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckEU5VdPmE8Q7kNvwHNqpxH&_nc_oc=AdoO1HQJZA-enYUC955wItcyRPCj9CBVdMocDx5oUl5OBTE2Rr-XUOpvDa1tHW0d8PI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b_spjSqhSbpkClzdCrDJAIzT4vGeR8inV20VTIcwLGg&oe=6A37EDE4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX7t3ryuD5AQ7kNvwH1ifdU&_nc_oc=Adp6wAmCguGdDztIE729T18UGX-QvCPHZVXH1sEzBSHXRDj5Ae58OLqlta87E_U_rpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gkHrMKl80N6mzEp4493utFyAN7sGLa5oIQmQm0h9RLg&oe=6A37F275"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdkCKHJuF8UQ7kNvwHqVbNs&_nc_oc=Adrxyo3NiX891FBUeoOnc7OUd7tm-PdcQiAJrdC4PQdF-e6t4O3cVO-e048PBah5qh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oH5YUw7v7r2xzbCJ6qVPX1JrTcFr1c1vObKsk-NJkiQ&oe=6A380C02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9oc6M2DU7wQ7kNvwHywZAo&_nc_oc=AdrWOWOv0yKoyE5My8EMfMe22VwCpAVrPiDUOJy29jSYdtAbwW8yagiSn1uIJZXxcHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-437ef6jzEIHdchVOMuvGKNkE2ihwZv757A9xAbvHCzQ&oe=6A37EBCC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
T04&_nc_oc=AdmVSP26vRTyWayK_fOJmh7db89HoxiO9n9mfOGbj5cNjEbRyfN9K6lEo8LR2hFunmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu1bNrryWWyvEMm2hs5esIRVFHkeZcYEqCIYXWvqkhkuQ&oe=69A445B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoITHV3hNV0Q7kNvwErvTVG&_nc_oc=AdllZwxtzcfUzWl2AOGEqM6GfutvvsORWa_2eaJHfscQPbHuaNhgsHRq-t1aLQCEuTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuJr2LImiIAgoGjlrF1WGACkPluxDPCyj19H6tdEJ7WGQ&oe=69A445E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXE_Aa652Y0Q7kNvwGPf7fg&_nc_oc=AdlEeu0KqmWOZ2WlJrziI8u0hEbdarbJSUn1c4gzczD9_dey4LdSYkpQxINkvtMwJX4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftQTeJkR17P-LGHFmLrLZJ_qT7BsXLEj1aDqfHbAgvIlw&oe=69A44A75"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-LoMkf-zpoQ7kNvwF2krSj&_nc_oc=AdlpdcR_k_CyuPIz9oUGCfnRF-dt2oQ7IHz2chb2QuS14n23nd2rIXiLIBsVGugE4C4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKDUEsXdChcuBTJfMo1_CyFOH-l-j4LCNH71Kio3ExOQ&oe=69A42BC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Sl5Dz_ZQrsQ7kNvwHcuZkR&_nc_oc=Adlqwq-aqEBscCkK_h7ToeENTHESIPplVb4xP3m_-TcV_m7jiiXOjLo0g-v888yAI3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuxAucYrKejVINf0Yb3Inzk-p43IM12RVL_af5DlST8Iw&oe=69A443CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
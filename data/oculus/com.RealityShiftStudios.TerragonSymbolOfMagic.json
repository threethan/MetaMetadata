60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds5-BSsJOGIQ7kNvwEkKpBM&_nc_oc=AdqK2MHJJuea5hUdyTRpgOAjiCPs9Ku8GlxJic0jvqFB1xBdAFOGzBQjZHMz62JIyEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc9zCACrmnrXtBYl3g53SV0SV-1i95BDmmxlKwqZq8nw&oe=6ABA7232"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1er0oRu0Z8Q7kNvwHGnE4T&_nc_oc=Adp30JPK3VrBlkVYoStQ0sUdvY10XYbwnLd9NrgS_oGuHMILwbeWCdjjUDuCmcOvP9s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL56c5-XjtCmRvMDKrz9FxP_pflobCpXF1Io3_EVloEGg&oe=6ABA7264"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pY3DpAcaXAQ7kNvwGAfVy4&_nc_oc=Adr85c_Mhdy4AvLRyqPaBzZ8nfkYMwUxC4YO6aAtuD6t97bFoPpkVhGwfsK5dhi6QZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXf28m415FkUQSFfmwO5INsBXWQU574o6Z79lOCS5IVw&oe=6ABA76F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JByC7mdRQMoQ7kNvwGo-XO2&_nc_oc=AdrVmJogPmX9T680_vw9ji3rBPEBBroIJpYYRK8TqVPHsnNxfjvNlrJpTgKyBR-WTmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtkokR6yXcWqb7KBWF_8Nsv426dWG8Q5E4XUgoM_Qv7Q&oe=6ABA5842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GphQj9Jq6kYQ7kNvwHV3ACH&_nc_oc=AdoopFTvUbb7FZyFsQH8JO1d3Vj_VPSVdLHC8GyuAq11qA3l18uo_fANT_Zl1RRigKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIp1cLMADBVCDJHqAMGuiwBVlPjpO6-bscO_Mu1viFIw&oe=6ABA704C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
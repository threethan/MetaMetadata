46_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr-Fq55bM5gQ7kNvwG12WP0&_nc_oc=AdlHvZQNbVyelo-cR_Cb6_eVEnT6MlEnkk8WiCg4s0psQC1X9CEoW-GvzRP6UrkD88Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBv1ed6CWosiskMtSyBDsD9OJ4d5n-qnpSVFMNJNRkEg&oe=69BEA3B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cV2PLWLwGEQ7kNvwE3Eaeg&_nc_oc=AdlrUB8uEpcOhDUh-1eWkz_sVaFcozVZx2BPKm5TQ-bb-oF6mjNP5YrB7XhG4d_dt8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzblIlJAbPaFuxSCZwTiTqJuFwHzAhrrpH4xMU17Gqvg&oe=69BEA3E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHg6DFvzlCYQ7kNvwGKuJwF&_nc_oc=AdkSHFqdZTJ90uzgznmGi7YHKLvzTvee9gp1-wdJB5CVNoTgGc2R1ppZO6195NsfGkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuMpJLRtlVsalRHPABfXLQxswOAXfhukYafoNgDsu_Yw&oe=69BEA875"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvdypt8byf8Q7kNvwEPdL6Y&_nc_oc=AdkFP1_6XNDsMEhaSH-bB5oTFYUr5f1ShpJ1vTFQ45OK8wNyYFmmqwGO8FkPpQqNWCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztwPyR5kOZ3NLd8yz92reA96ZUHa1LujenxAPBZdZX4Q&oe=69BE89C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45uswj7V-vUQ7kNvwH8_g8n&_nc_oc=Adk6LfbojJPhSAvhqCNrRB1MUHkpFeR0RKDDdN4z4qIPJN88KfdQXT_WxaxzOPZ-mV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxRyjMYKOrecbPPbokpWiOBOLuAWsVKkDtv9OqTbVaKQ&oe=69BEA1CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQ
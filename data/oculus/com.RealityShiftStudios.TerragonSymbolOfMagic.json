60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrxHJM4KlqMQ7kNvwFPRcFQ&_nc_oc=AdrHYcGOzEcZhKTj-JoFvrA6TLeElnwqRnMVIKMQ7OIs2Kkcvci2Ka10lszzSdL4KUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ9a2mGJCCNO0gAQMDZ9YLwTol84QzpZ9SMLGCTDe-xQ&oe=6A4BB432"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opWc8KgeapQQ7kNvwGTZab_&_nc_oc=AdpWRKOEzt5bHevOnkkzqbp6cIjeW5cMwbwEFbT11ryxIgx3AEVeTTHsQQ7-yhJbBs0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzk4wwZadD7TJHmewZpRkpzZRV3UpzlNzmc03SmIvTxw&oe=6A4BB464"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljVWveQveOIQ7kNvwETvPa3&_nc_oc=AdqAH3VhzNtvPyMuWpniO959sQv2nJvl4cVuAIGrPd85paQEFamd9BStoTE3PtaDhmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqhoRbXybwqnEWFaQ9QgLRyp_1Knuaelszhjozt9Z65g&oe=6A4BB8F5"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyyB-87wPM0Q7kNvwEjPITX&_nc_oc=AdpLQf6okvP0RwoSFY3waU2Z5Tp_Z6LlejUv9Cq9WoCbhZx_Kfb_scsS8syosP6sLp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuyUDWKuJFlZcngCsnCb5GKcPioLMdUFld8rP3drmrgA&oe=6A4BD282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmBhFjyRk1QQ7kNvwHjSj8T&_nc_oc=Adrwr5FY8Pln2uMy1yg_MVtUqLFd1h2CAI_UbLLMbOODOU0Dv0sIK1f-ZQS04yL9k6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpqh_K1TWGvUdd5BQItaIBeAWcLtOmWk5Ze8mRCxVc9g&oe=6A4BB24C"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
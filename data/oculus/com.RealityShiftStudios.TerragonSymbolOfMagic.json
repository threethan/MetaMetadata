60888708763644_3930681137141675446_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1sNjh_9veAQ7kNvwHdVNiu&_nc_oc=Adr_DeFzRfEbFO29OdZX0lS2wazBOWKTMAiFGM3z9K3nQRbYNaTRM-I8W6tA8Md-89U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACyH9toqia9R-PuLF5MdP5d37Zq1Dlt9KI6UsRKpd4oQ&oe=6A4A62B2"}, {"file_name": "39035439_155518493347364_8229163233340523853_n.png", "id": "583219532840677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_583219539507343_3325510773524648009_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHgvUIZtuNkQ7kNvwG3JlBD&_nc_oc=AdpM-bHTGXWhv3euDCzPc64puY0_fdllvG3AXOO5620PIPGUm-wSBPniweHxoQuQMa8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeAR5_EhX4xMS96l3AzbdFnQV8n2OzHdv-g3556s5McA&oe=6A4A62E4"}, {"file_name": "39036640_821979558708795_741716924941212573_n.png", "id": "2188497704623266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031393_2188497711289932_8179731153036604286_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljVWveQveOIQ7kNvwEQgVI_&_nc_oc=AdpvrrgAWHqTPbTxWbubzyKxCL9KWwD490OSVt2koU2Hba-Ciof7dLdOKx-5qxQtsc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC28beU-I0tlOOdvVxsej37WmJuCwNtTpNA0aVupHF9XQ&oe=6A4A6775"}, {"file_name": "39031652_418575639578766_8975566479060865741_n.png", "id": "896791980917517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982488_896791984250850_4233376106485444569_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyyB-87wPM0Q7kNvwGsqIg7&_nc_oc=AdqAHft_ZWKeF9JaL6rgR2cMSyq8KeZRgPVGg9TmS9R85jq0fGYaf4GXSIXprnWNRDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxdWfvZw3Djc_VfPI5tKEH2adKI8Z-57UldZBuSVViPQ&oe=6A4A8102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "410980920335064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984460_410980923668397_5615580632421695624_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmBhFjyRk1QQ7kNvwGPNvwB&_nc_oc=AdrQ_VzlgYp1aBU_Y9jny2vI6YkTWTF-SCGGw3U_aJiSrF0G5aQnn6MYZtdg7vY2yKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbduX3G5aB0spJJBih5yCIcdW7KXPPnLH-Csm-Lh5ZSg&oe=6A4A60CC"}, "display_name": "Terragon: Symbol Of Magic", "keywords": [], "long_description": "Terragon: Symbol Of Magic is a first person VR RPG, that lets you be a real magician by immersing you, as a player, in fast-paced magic combat against a variety of mighty monsters.\nChoose your unique magic spells wisely and assign them your favorite hand gesture to cast against the evil in the fantastic realms of Terragon.\n\nJoin the quest to free Terragon from the evil possesing it, by joining the great Skyfer guild as a young, eager magician with hidden powerful magic.\nExplore the vast and beautiful wilderness and realms of Terragon, gather incredible and powerful loot, \nfind the legendary powerstones to increase your magic power, learn amazing spells and the secret gestures to cast them, and plenty more!\n\nFeatures:\nFully immersive VR experience\nHand gesture based spell casting system\nAmazing spells\nAction packed magic combat\nRandomly generated levels\nLevel progression\nInventory System\nTons of loot", "short_description": "In an epic fantasy world, run and managed by guilds of magicians, you play as a young magician who is eager to join the guild that supports and protects his village. \nAfter being accepted to the guild, a great adventure begins, with plenty of quests and great battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realityshiftstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Reality Shift Studios", "support_website_url": null, "website_url": "https://realityshiftstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "ha
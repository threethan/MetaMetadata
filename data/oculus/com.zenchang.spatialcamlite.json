743a089de609ff6f945.png", "id": "900843269714249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623443_900843273047582_3348493932148740489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ6zAO7T_lIQ7kNvwGLUaKQ&_nc_oc=AdpNTf9ZJCwCEZGRCz3YGqo6DwhElW4dkoQYCjZV7fwhoGE9D5iOXJlcoj2II7yFxng&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVUZZvuUkxLPkEiuz8MrqK4OZ2HRhyShyKE5KiPUr7dg&oe=6AA17BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview.png", "id": "2058548144734280", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622315_2058548148067613_1906992152904951397_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_PQP5LYRW4Q7kNvwGEFeZ4&_nc_oc=AdpeZNyMXWug8RJU9m3i4eYfpOObTq3YL_6wkD9jtr4DeTeC5RjxPELwqn66thqucAE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDOFY-gJN_oxnNdKi7ytvj8FaYJXBRhr1r-8ZkXB21Qg&oe=6AA1808C"}, "display_name": "Tendy: SpatialCam , Cast & Viewer", "keywords": ["Spatial", "3d", "Stereoscopic", "videos", "camera"], "long_description": "Tendy \u2014 3D Camera, Cast & Viewer for Meta Quest\n\nTurn your Meta Quest 3/3S from a viewing device into a 3D camera, phone display, and immersive content hub.\n\nTendy brings capture, casting, and 3D viewing into one unified experience.\n\n\ud83d\udcf7 3D Camera (Quest 3/3S)\n\nCapture stereoscopic content using Passthrough cameras.\n\nSBS 3D photos & videos\nReal-time stereoscopic preview\nAuto-save to device storage\n\ud83d\udcf1 Phone Cast\n\nBring your phone into VR.\n\nSupports Android & iPhone\nWatch videos, apps, games, and camera feeds\nLow-latency real-time display\n\u25b6\ufe0f YouTube SBS 3D\n\nWatch YouTube 3D content directly in Quest.\n\nSupports side-by-side (SBS) format\nNo download or conversion required\nInstant immersive playback\n\ud83c\udd93 Free Trial\n\nTry core features for free:\n\nSBS 3D photos \u2014 unlimited\nSBS 3D videos \u2014 10 sec per clip\nPhone Cast \u2014 3 min per session\nYouTube SBS \u2014 up to 720p\nNo ads\n\u2b50 Tendy Pro\n\nUnlock the full 3D experience:\n\nUnlimited recording time\nUnlimited Phone Cast\nHigh-quality YouTube playback\nYouTube 3D conversion\nOne-time purchase (no subscription)\n\nUsers with SpatialCam Pro can also unlock Pro features.\n\n\ud83c\udf10 3D / VR Content Discovery\n\nFind curated 3D and VR videos optimized for Quest.\n\n\ud83d\udc49 Try for free first, upgrade anytime.", "short_description": "Turn Quest 3 / 3S into a 3D camera, phone screen caster, and YouTube 3D player. Capture SBS 3D photos and videos, cast your phone screen, and watch YouTube SBS 3D with real-time preview and local storage. Free to download. No ads."}]}, "developer_name": "Zen Chang", "developer_privacy_policy_url": "https://www.zenchang.com/2026/05/privacy-policy-for-spatialcam-lite.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Chang", "support_website_url": null, "website_url": "https://www.zenchang.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1858799072194650"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623295_27019149467762967_7168170282521804778_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcdcInbwYb0Q7kNvwFXJNO1&_nc_oc=Adpqv4V4wKzIMOMjE3abx-0kRGaxQDAcTO_j
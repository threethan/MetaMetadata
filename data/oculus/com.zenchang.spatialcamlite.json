555521932037650498_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUxJzlCEe3cQ7kNvwE2JCK7&_nc_oc=Ado1s9LxHJLXdzPJz2hMCoqRTucjMzCmPXPnTfrzQbauHBSlD-b97Gdnt00I8NKJt4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL_OxcsiUsEFsfpNB6HIGJklNeio1_fArlPzCcYFQSzA&oe=6A788987"}]}, "id": "4596203593994833", "locale": "en_US", "screenshots": [{"file_name": "739965459164757aedb63bb5f18c8d26.png", "id": "1018710677657830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_1018710680991163_4849864304697503575_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVXgnYALT9AQ7kNvwHd5pyh&_nc_oc=AdozNFWBpSam4nwgxWNWLpXew6x-m0CopHf5iOHv12apem_IEbtiqH_ROyekAiaJeHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcA5r3oEmlp-QWumI_4-YMsveoqhDzTkVt9bW6ccsaMg&oe=6A787364"}, {"file_name": "ss1.png", "id": "1663969808263141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623314_1663969814929807_3011624778479159951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UO8XX1u8SEMQ7kNvwHQZBqx&_nc_oc=AdrGM8HjLFK3uAg2J5d_6nv8lGTBkcOws-GrSefP9kGgz7c3SezYVrY4sEzr27Pgi0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0pMXdz2GYEsDKm2gd_6IeT7S_2JhX-mudxywWODRZFA&oe=6A787D44"}, {"file_name": "889595af61fae8a53384f625cf65a762_1.png", "id": "1040843891810313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673812903_1040843895143646_2062098491376773885_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDs4u6BFxQYQ7kNvwGvmEdF&_nc_oc=AdpdYSj_R_vJqaXo_2UgmPsg58WPX0esvH4Pq1RgxchvB5xcibmuaC0qBCdz4nFJk40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrl02Y7Oo2RyBTeyR_gtJVXqfAwclIXg_WroUIwRgE-g&oe=6A787CBB"}, {"file_name": "75a22408bee45743a089de609ff6f945.png", "id": "900843269714249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_900843273047582_3348493932148740489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2ty77RKeUoQ7kNvwHEZmUD&_nc_oc=AdoKnNzQ-ZJz1qG4eZprNgra4RzGd2O_dMudWG0uXO2yrzkddfEzke_pGi9icOwj3lM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEte5jt_QqzgiGklTcQ7BcElpFcOr7RsWMPfSCsXcqj8A&oe=6A7864F4"}, {"file_name": "134de19b434d8716f401b3396d9694d2.png", "id": "976844491836436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_976844495169769_8865983961994714989_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwjhklHVOPoQ7kNvwERC3Ok&_nc_oc=AdoMjlBUKgrIvlXBXjq12j-N6PzZ6k0J8W69XqwxGFC9uTkvmEcdSKU2VSn07R5hESc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVPM7CL8qEb6wXAteIhKKMqXDZ3FxcAktNhMfkTmd2Kw&oe=6A788BEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_preview.png", "id": "2058548144734280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622315_2058548148067613_1906992152904951397_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR4xQi2WMoMQ7kNvwFrmWkA&_nc_oc=Adrf7PANzoJk5Sxpq0_IFJLmIGZHq-dIaY10rH36K1qE8pMJP5b_UD7nGrbXTi8XSLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBTOGjB-X92YcbOt1t6iAxG2XOG8yyPVCB9aT-RwPHUw&oe=6A7869CC"}, "display_name": "Tendy: SpatialCam & Cast", "keywords": ["Spatial", "3d", "Stereoscopic", "videos", "camera"], "long_description": "Meta Quest 3 isn't just for watching videos \u2014 it can be the 3D camera you carry with you every day.\n\nTendy captures SBS stereoscopic photos and videos on Meta Quest 3/3S using Passthrough cameras. The app is **free to download**; advanced features require **optional in-app purchases** through the Meta Horizon Store.\n\n**Free plan (no purchase)**\n- Stereoscopic photo capture (SBS, 2560\u00d7960) \u2014 **unlimited**\n- Stereoscopic video recording \u2014 **up to 10 seconds per clip** (recording stops automatically; the clip is still saved to your gallery)\n- Recording settings (frame rate, bitrate, optional microphone audio)\n- On-device gallery and video management\n\n**Pro unlock (optional, in-app purchase)**\n- **Unlimited recording length**\n- **YouTube 3D conversion** (re-encode SBS clips for YouTube 3D upload)\n- **Monthly** $1.99 or **yearly** $9.99 (auto-renews; cancel anytime; price as shown in store)\n- **Lifetime** $19.99 one-time \u2014 unlock Pro forever (no subscription required)\n- View subscription / lifetime status in-app; restore purchases supported\n\n**Discover 3D & VR Videos**\n- Opens a curated 3D/VR video discovery page in your browser (https://tendy.net/)\n\n**Also included**\n- Dual Passthrough cameras with real-time SBS preview\n- H.264 stereo video at 2560\u00d7960, recording timer\n- Subscribe button always available on the toolbar\n- All media saved locally on your headset \u2014 **no ads**\n\nTry free 3D photos today; unlock Pro when you need longer clips or YouTube 3D export.", "short_description": "Meta Quest 3 isn't just for watching videos \u2014 it can be the 3D camera you carry with you every day. Tendy turns Quest 3/3S into an SBS stereoscopic camera for photos and videos, with real-time preview and local storage. Discover 3D & VR Videos from the home screen. Free to download. No ads."}, {"images": {"nodes": []}, "id": "1360950436028017", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tendy: SpatialCam & Cast", "keywords": ["\u7acb\u4f53\u30ab\u30e1\u30e9", "3D\u30ab\u30e1\u30e9", "sbs"], "long_description": "Meta Quest 3\u306f\u52d5\u753b\u8996\u8074\u3060\u3051\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u6bce\u65e5\u6301\u3061\u6b69\u3051\u308b3D\u30ab\u30e1\u30e9\u306b\u3082\u306a\u308a\u307e\u3059\u3002\n\nMeta Quest 3/3S\u5411\u3051\u3002Passthrough\u30c7\u30e5\u30a2\u30eb\u30ab\u30e1\u30e9\u3067SBS\u7acb\u4f53\u5199\u771f\u30fb\u52d5\u753b\u3092\u64ae\u5f71\u3002**\u7121\u6599\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9**\uff1b\u4e00\u90e8\u6a5f\u80fd\u306f**Meta Horizon\u30b9\u30c8\u30a2\u5185\u8ab2\u91d1**\uff08\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u307e\u305f\u306f\u8cb7\u3044\u5207\u308a\uff09\u3067\u89e3\u653e\u3002\n\n**\u7121\u6599\u7248\uff08\u8cfc\u5165\u4e0d\u8981\uff09**\n- \u7acb\u4f53\u5199\u771f\uff08SBS\u30012560\u00d7960\uff09\u2014 **\u56de\u6570\u7121\u5236\u9650**\n- \u7acb\u4f53\u52d5\u753b\u9332\u753b \u2014 **1\u56de\u6700\u592710\u79d2**\uff08\u81ea\u52d5\u505c\u6b62\u3001\u30ae\u30e3\u30e9\u30ea\u30fc\u306b\u4fdd\u5b58\uff09\n- \u9332\u753b\u8a2d\u5b9a\uff08\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3001\u30d3\u30c3\u30c8\u30ec\u30fc\u30c8\u3001\u30de\u30a4\u30af\u97f3\u58f0\u30aa\u30d7\u30b7\u30e7\u30f3\uff09\n- \u7aef\u672b\u5185\u30ae\u30e3\u30e9\u30ea\u30fc\uff0f\u52d5\u753b\u7ba1\u7406\n\n**Pro\u89e3\u653e\uff08\u4efb\u610f\u30fb\u30a2\u30d7\u30ea\u5185\u8ab2\u91d1\uff09**\n- **\u7121\u5236\u9650\u9332\u753b**\n- **YouTube 3D\u5909\u63db**\n- **\u6708\u984d** $1.99\uff0f**\u5e74\u984d** $9.99\uff08\u81ea\u52d5\u66f4\u65b0\u30fb\u3044\u3064\u3067\u3082\u89e3\u7d04\u30fb\u8868\u793a\u4fa1\u683c\u306b\u6e96\u305a\u308b\uff09\n- **\u8cb7\u3044\u5207\u308a** $19.99 \u2014 Pro\u3092\u6c38\u4e45\u89e3\u653e\uff08\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u4e0d\u8981\uff09\n- \u30a2\u30d7\u30ea\u5185\u3067\u767b\u9332\uff0f\u8cb7\u3044\u5207\u308a\u72b6\u614b\u3092\u78ba\u8a8d\u53ef\u80fd\u3002\u8cfc\u5165\u306e\u5fa9\u5143\u306b\u5bfe\u5fdc\n\n**Discover 3D & VR Videos**\n- \u30db\u30fc\u30e0\u753b\u9762\u30c4\u30fc\u30eb\u30d0\u30fc\u306e **Discover 3D & VR Videos** \u30dc\u30bf\u30f3\n- \u30d6\u30e9\u30a6\u30b6\u30673D/VR\u52d5\u753b\u306e\u63a2\u7d22\u30da\u30fc\u30b8\u3092\u958b\u304f\uff08https://tendy.net/\uff09\n\n**\u305d\u306e\u4ed6**\n- \u30ea\u30a2\u30eb\u30bf\u30a4\u30e0SBS\u30d7\u30ec\u30d3\u30e5\u30fc\u3001H.264 2560\u00d7960\u3001\u9332\u753b\u30bf\u30a4\u30de\u30fc\n- \u30c4\u30fc\u30eb\u30d0\u30fc\u306e\u300c\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\u300d\u30dc\u30bf\u30f3\u306f\u5e38\u306b\u8868\u793a\n- \u30e1\u30c7\u30a3\u30a2\u306f\u7aef\u672b\u5185\u306e\u307f\u4fdd\u5b58 \u2014 **\u5e83\u544a\u306a\u3057**\n\n\u7121\u6599\u3067\u7acb\u4f53\u5199\u771f\u3092\u8a66\u3057\u3001\u9577\u6642\u9593\u9332\u753b\u3084YouTube 3D\u304c\u5fc5\u8981\u306a\u3068\u304d\u306bPro\u3092\u89e3\u653e\u3002\n", "short_description": "Meta Quest 3\u306f\u52d5\u753b\u8996\u8074\u3060\u3051\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u6bce\u65e5\u6301\u3061\u6b69\u3051\u308b3D\u30ab\u30e1\u30e9\u306b\u3082\u306a\u308a\u307e\u3059\u3002Tendy\u3067Quest 3/3S\u304b\u3089SBS\u7acb\u4f53\u5199\u771f\u30fb\u52d5\u753b\u3092\u64ae\u5f71\u3002\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u30d7\u30ec\u30d3\u30e5\u30fc\u3001\u7aef\u672b\u5185\u4fdd\u5b58\u30013D/VR\u52d5\u753b\u306e\u767a\u898b\u306b\u3082\u5bfe\u5fdc\u3002\u7121\u6599\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3001\u5e83\u544a\u306a\u3057\u3002"}, {"images": {"nodes": []}, "id": "1005373835733858", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tendy: SpatialCam & Cast", "keywords": ["SBS", "\u7acb\u9ad4\u76f8\u6a5f"], "long_description": "Meta Quest 3 \u4e0d\u53ea\u662f\u770b\u7247\u5de5\u5177\uff0c\u5b83\u4e5f\u53ef\u4ee5\u662f\u4f60\u6bcf\u5929\u96a8\u8eab\u651c\u5e36\u7684 3D \u76f8\u6a5f\u3002\n\nTendy \u5c08\u70ba Meta Quest 3/3S \u8a2d\u8a08\uff0c\u4f7f\u7528 Passthrough \u96d9\u76f8\u6a5f\u62cd\u651d SBS \u7acb\u9ad4\u7167\u7247\u8207\u5f71\u7247\u3002App **\u514d\u8cbb\u4e0b\u8f09**\uff1b\u9032\u968e\u529f\u80fd\u9700\u900f\u904e **Meta Horizon \u5546\u5e97\u5167\u8cfc**\uff08\u8a02\u95b1\u6216\u7d42\u8eab\u8cb7\u65b7\uff09\u89e3\u9396\u3002\n\n**\u514d\u8cbb\u7248\uff08\u7121\u9700\u8cfc\u8cb7\uff09**\n- \u7acb\u9ad4\u7167\u7247\u62cd\u651d\uff08SBS\uff0c2560\u00d7960\uff09\u2014 **\u4e0d\u9650\u6b21\u6578**\n- \u7acb\u9ad4\u5f71\u7247\u9304\u5f71 \u2014 **\u6bcf\u6b21\u9304\u5f71\u6700\u9577 10 \u79d2**\uff08\u903e\u6642\u81ea\u52d5\u505c\u6b62\uff0c\u7247\u6bb5\u4ecd\u6703\u5b58\u5165\u76f8\u7c3f\uff09\n- \u9304\u5f71\u53c3\u6578\u8a2d\u5b9a\uff08\u5e40\u7387\u3001\u4f4d\u5143\u7387\u3001\u53ef\u9078\u9ea5\u514b\u98a8\u97f3\u8a0a\uff09\n- \u672c\u6a5f\u76f8\u7c3f\uff0f\u5f71\u7247\u7ba1\u7406\n\n**Pro \u89e3\u9396\uff08\u9078\u8cfc\uff0cApp \u5167\u8cfc\u8cb7\uff09**\n- **\u7121\u9650\u9304\u5f71\u6642\u9577**\n- **YouTube 3D \u8f49\u6a94**\uff08\u5c07 SBS \u5f71\u7247\u8f49\u70ba YouTube 3D \u683c\u5f0f\uff09\n- **\u6708\u8a02\u95b1** $1.99\uff0f\u6708\u3001**\u5e74\u8a02\u95b1** $9.99\uff0f\u5e74\uff08\u81ea\u52d5\u7e8c\u8a02\uff0c\u53ef\u96a8\u6642\u53d6\u6d88\uff1b\u4ee5\u5546\u5e97\u986f\u793a\u50f9\u683c\u70ba\u6e96\uff09\n- **\u7d42\u8eab\u7248** $19.99 \u4e00\u6b21\u6027\u8cfc\u8cb7\uff0c\u6c38\u4e45\u89e3\u9396 Pro\uff08\u7121\u9700\u8a02\u95b1\uff09\n- \u8a02\u95b1\u9801\u53ef\u67e5\u770b\u8a02\u95b1\uff0f\u8cb7\u65b7\u72c0\u614b\uff1b\u652f\u63f4\u300c\u6062\u5fa9\u8cfc\u8cb7\u300d\n\n**Discover 3D & VR Videos**\n- \u4e3b\u756b\u9762\u5de5\u5177\u5217\u63d0\u4f9b **Discover 3D & VR Videos** \u6309\u9215\n- \u65bc\u700f\u89bd\u5668\u958b\u555f\u7cbe\u9078 3D\uff0fVR \u5f71\u7247\u63a2\u7d22\u9801\uff08https://tendy.net/\uff09\n\n**\u6838\u5fc3\u529f\u80fd**\n- \u96d9 Passthrough \u76f8\u6a5f\u5373\u6642 SBS \u5408\u6210\n- H.264 \u7acb\u9ad4\u5f71\u7247\uff082560\u00d7960\uff09\n- \u6240\u898b\u5373\u6240\u9304\u9810\u89bd\u3001\u9304\u5f71\u8a08\u6642\n- \u5de5\u5177\u5217\u300c\u8a02\u95b1\u300d\u6309\u9215\u96a8\u6642\u53ef\u9032\u5165\u65b9\u6848\u9801\n- \u7167\u7247\uff0f\u5f71\u7247\u50c5\u5b58\u65bc\u672c\u6a5f\uff0c\u7121\u5ee3\u544a\n\n\u7acb\u5373\u9ad4\u9a57\u514d\u8cbb\u7acb\u9ad4\u62cd\u7167\uff1b\u9700\u8981\u9577\u7247\u9304\u88fd\u6216 YouTube 3D \u6642\u518d\u89e3\u9396 Pro\u3002", "short_description": "Meta Quest 3 \u4e0d\u53ea\u662f\u770b\u7247\u5de5\u5177\uff0c\u5b83\u4e5f\u53ef\u4ee5\u662f\u4f60\u6bcf\u5929\u96a8\u8eab\u651c\u5e36\u7684 3D \u76f8\u6a5f\u3002Tendy \u8b93 Quest 3/3S \u96a8
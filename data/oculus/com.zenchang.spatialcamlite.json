le_name": "s5.png", "id": "2051705798890610", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_2051705802223943_8161497220704425065_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8vdi-JclnIQ7kNvwEd3RSa&_nc_oc=AdpMV6agdeafyKl0qX3D27J-IWiSaCwRT6rUQ9Uis927oy8zQKm6ix85fsvIea7l0H8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AOfhfAgkgyUucIIF6XUwlrZzhylf2nu4BRN-nGs4Thg&oe=6A2572EB"}, {"file_name": "s6.png", "id": "996011116342964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_996011119676297_8475318978070298751_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnPqN843oEIQ7kNvwGEMYW7&_nc_oc=AdpgG7kppRG1YSyp8u_4q_n86Y3Lp7x46uqqJsL_Ek6fc1DLoJY0a9eTaUis9VZnPGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cMuW6vEJumbxVSa_LDpnPdCKT0eaybsTSdJnOETIIjg&oe=6A2589DD"}, {"file_name": "ss1.png", "id": "1663969808263141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623314_1663969814929807_3011624778479159951_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_Gak8nvM2QQ7kNvwEKonCw&_nc_oc=AdopjbyKh_lH62WQUiv4G0sJepzNqnBwJZRS26XxiPfVZXk1sy_4Pyj4HlHLog_AqrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rwd6_kdZIgmSMAQxSpxm6Yrtn8eLw2-_vIVrg2oGkFw&oe=6A256EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "994545519943869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623370_994545523277202_8014680366569861871_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yI_Nk8jcSnAQ7kNvwG2uM_r&_nc_oc=Adpguj3JD_DlOyGSZkJhursSXPR9QkPZWsOLtbSz_XBezJMeznw1Q5aNkZ-4tN6b6uQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u0yHCpZy_vxfDaS0_foIvyWEInLRMAlYxNwARJ3gRbA&oe=6A258282"}, "display_name": "SpatialCam Lite-Capture 3D Stereo Video", "keywords": [], "long_description": "SpatialCam Lite \u2014 Stereoscopic Camera for Meta Quest\n\nSpatialCam Lite captures SBS stereoscopic photos and videos on Meta Quest 3/3S using Passthrough cameras. The app is free to download; advanced features require an optional in-app subscription purchased through the Meta Horizon Store.\n\nFree plan (no subscription)\n\u2022 Stereoscopic photo capture (SBS, 2560\u00d7960) \u2014 unlimited\n\u2022 Stereoscopic video recording \u2014 up to 10 seconds per clip (recording stops automatically; the clip is still saved to your gallery)\n\u2022 Recording settings (frame rate, bitrate, optional microphone audio)\n\u2022 On-device gallery and video management\n\nPro subscription (optional, in-app purchase)\n\u2022 Unlimited recording length\n\u2022 YouTube 3D conversion (re-encode SBS clips for YouTube 3D upload)\n\u2022 $1.99/month or $9.99/year (auto-renews; cancel anytime; price as shown in store)\n\u2022 Restore purchases supported\n\nAlso included\n\u2022 Dual Passthrough cameras with real-time SBS preview\n\u2022 H.264 stereo video at 2560\u00d7960, recording timer\n\u2022 All media saved locally on your headset \u2014 no ads\n\nTry free 3D photos today; subscribe to Pro when you need longer clips or YouTube 3D export.", "short_description": "SpatialCam Lite is a free stereoscopic camera app for Meta Quest 3/3S. Capture SBS 3D photos anytime. The free plan limits each video recording to 10 seconds per clip. An optional Pro subscription ($1.99/month or $9.99/year) unlocks unlimited recording and YouTube 3D conversion. No ads."}, {"images": {"nodes": []}, "id": "1321326066871473", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpatialCam lite - \u62cd3D\u7acb\u9ad4\u5f71\u7247", "keywords": [], "long_description": "**SpatialCam Lite \u2014 Meta Quest \u7acb\u9ad4\u76f8\u6a5f**\n\nSpatialCam Lite \u5c08\u70ba Meta Quest 3/3S \u8a2d\u8a08\uff0c\u4f7f\u7528 Passthrough \u96d9\u76f8\u6a5f\u62cd\u651d SBS \u7acb\u9ad4\u7167\u7247\u8207\u5f71\u7247\u3002App **\u514d\u8cbb\u4e0b\u8f09**\uff1b\u90e8\u5206\u9032\u968e\u529f\u80fd\u9700\u900f\u904e **Meta Horizon \u5546\u5e97\u5167\u8a02\u95b1** \u89e3\u9396\u3002\n\n**\u514d\u8cbb\u7248\uff08\u7121\u9700\u8a02\u95b1\uff09**\n- \u7acb\u9ad4\u7167\u7247\u62cd\u651d\uff08SBS\uff0c2560\u00d7960\uff09\u2014 **\u4e0d\u9650\u6b21\u6578**\n- \u7acb\u9ad4\u5f71\u7247\u9304\u5f71 \u2014 **\u6bcf\u6b21\u9304\u5f71\u6700\u9577 10 \u79d2**\uff08\u903e\u6642\u81ea\u52d5\u505c\u6b62\uff0c\u7247\u6bb5\u4ecd\u6703\u5b58\u5165\u76f8\u7c3f\uff09\n- \u9304\u5f71\u53c3\u6578\u8a2d\u5b9a\uff08\u5e40\u7387\u3001\u4f4d\u5143\u7387\u3001\u53ef\u9078\u9ea5\u514b\u98a8\u97f3\u8a0a\uff09\n- \u672c\u6a5f\u76f8\u7c3f\uff0f\u5f71\u7247\u7ba1\u7406\n\n**Pro \u8a02\u95b1\uff08\u9078\u8cfc\uff0cApp \u5167\u8cfc\u8cb7\uff09**\n- **\u7121\u9650\u9304\u5f71\u6642\u9577**\n- **YouTube 3D \u8f49\u6a94**\uff08\u5c07 SBS \u5f71\u7247\u8f49\u70ba YouTube 3D \u683c\u5f0f\uff09\n- \u6708\u8a02\u95b1 $1.99\uff0f\u6708\u3001\u5e74\u8a02\u95b1 $9.99\uff0f\u5e74\uff08\u81ea\u52d5\u7e8c\u8a02\uff0c\u53ef\u96a8\u6642\u53d6\u6d88\uff1b\u4ee5\u5546\u5e97\u986f\u793a\u50f9\u683c\u70ba\u6e96\uff09\n- \u652f\u63f4\u300c\u6062\u5fa9\u8cfc\u8cb7\u300d\n\n**\u6838\u5fc3\u529f\u80fd**\n- \u96d9 Passthrough \u76f8\u6a5f\u5373\u6642 SBS \u5408\u6210\n- H.264 \u7acb\u9ad4\u5f71\u7247\uff082560\u00d7960\uff09\n- \u6240\u898b\u5373\u6240\u9304\u9810\u89bd\u3001\u9304\u5f71\u8a08\u6642\n- \u7167\u7247\uff0f\u5f71\u7247\u50c5\u5b58\u65bc\u672c\u6a5f\uff0c\u7121\u5ee3\u544a\n\n\u7acb\u5373\u9ad4\u9a57\u514d\u8cbb\u7acb\u9ad4\u62cd\u7167\uff1b\u9700\u8981\u9577\u7247\u9304\u88fd\u6216 YouTube 3D \u6642\u518d\u8a02\u95b1 Pro\u3002\n", "short_description": "SpatialCam Lite \u662f Meta Quest 3/3S \u7684\u514d\u8cbb\u7acb\u9ad4\u76f8\u6a5f App\uff1a\u53ef\u96a8\u6642\u62cd\u651d SBS \u7acb\u9ad4\u7167\u7247\uff1b\u514d\u8cbb\u7248\u6bcf\u6b21\u9304\u5f71\u6700\u9577 10 \u79d2\u3002\u53ef\u9078 Pro \u8a02\u95b1\uff08\u6708\u4ed8 $1.99\uff0f\u5e74\u4ed8 $9.99\uff09\u89e3\u9396\u7121\u9650\u9304\u5f71\u6642\u9577\u8207 YouTube 3D \u8f49\u6a94\u3002\u7121\u5ee3\u544a\u3002"}, {"images": {"nodes": []}, "id": "951100787765763", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpatialCam lite - 3D\u7acb\u4f53\u30ab\u30e1\u30e9", "keywords": [], "long_description": "**SpatialCam Lite \u2014 Meta Quest \u7acb\u4f53\u30ab\u30e1\u30e9**\n\nMeta Quest 3/3S\u5411\u3051\u3002Passthrough\u30c7\u30e5\u30a2\u30eb\u30ab\u30e1\u30e9\u3067SBS\u7acb\u4f53\u5199\u771f\u30fb\u52d5\u753b\u3092\u64ae\u5f71\u3002**\u7121\u6599\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9**\uff1b\u4e00\u90e8\u6a5f\u80fd\u306f**Meta Horizon\u30b9\u30c8\u30a2\u5185\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3**\u3067\u89e3\u653e\u3002\n\n**\u7121\u6599\u7248\uff08\u767b\u9332\u4e0d\u8981\uff09**\n- \u7acb\u4f53\u5199\u771f\uff08SBS\u30012560\u00d7960\uff09\u2014 **\u56de\u6570\u7121\u5236\u9650**\n- \u7acb\u4f53\u52d5\u753b\u9332\u753b \u2014 **1\u56de\u6700\u592710\u79d2**\uff08\u81ea\u52d5\u505c\u6b62\u3001\u30ae\u30e3\u30e9\u30ea\u30fc\u306b\u4fdd\u5b58\uff09\n- \u9332\u753b\u8a2d\u5b9a\uff08\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3001\u30d3\u30c3\u30c8\u30ec\u30fc\u30c8\u3001\u30de\u30a4\u30af\u97f3\u58f0\u30aa\u30d7\u30b7\u30e7\u30f3\uff09\n- \u7aef\u672b\u5185\u30ae\u30e3\u30e9\u30ea\u30fc\uff0f\u52d5\u753b\u7ba1\u7406\n\n**Pro\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\uff08\u4efb\u610f\u30fb\u30a2\u30d7\u30ea\u5185\u8ab2\u91d1\uff09**\n- **\u7121\u5236\u9650\u9332\u753b**\n- **YouTube 3D\u5909\u63db**\n- \u6708\u984d$1.99\uff0f\u5e74\u984d$9.99\uff08\u81ea\u52d5\u66f4\u65b0\u30fb\u3044\u3064\u3067\u3082\u89e3\u7d04\u30fb\u8868\u793a\u4fa1\u683c\u306b\u6e96\u305a\u308b\uff09\n- \u8cfc\u5165\u306e\u5fa9\u5143\u306b\u5bfe\u5fdc\n\n**\u305d\u306e\u4ed6**\n- \u30ea\u30a2\u30eb\u30bf\u30a4\u30e0SBS\u30d7\u30ec\u30d3\u30e5\u30fc\u3001H.264 2560\u00d7960\u3001\u9332\u753b\u30bf\u30a4\u30de\u30fc\n- \u30e1\u30c7\u30a3\u30a2\u306f\u7aef\u672b\u5185\u306e\u307f\u4fdd\u5b58 \u2014 **\u5e83\u544a\u306a\u3057**\n\n\u7121\u6599\u3067\u7acb\u4f53\u5199\u771f\u3092\u8a66\u3057\u3001\u9577\u6642\u9593\u9332\u753b\u3084YouTube 3D\u304c\u5fc5\u8981\u306a\u3068\u304d\u306bPro\u3078\u3002\n", "short_description": "SpatialCam Lite\u306fMeta Quest 3/3S\u5411\u3051\u306e\u7121\u6599\u7acb\u4f53\u30ab\u30e1\u30e9\u30a2\u30d7\u30ea\u3002SBS\u7acb\u4f53\u5199\u771f\u306f\u3044\u3064\u3067\u3082\u64ae\u5f71\u53ef\u80fd\u3002\u7121\u6599\u7248\u306f1\u56de\u306e\u9332\u753b\u304c\u6700\u592710\u79d2\u307e\u3067\u3002Pro\u30b5\u30d6\u30b9\u30af\u30ea\u30d7\u30b7\u30e7\u30f3\uff08\u6708\u984d$1.99\uff0f\u5e74\u984d$9.99\uff09\u3067\u7121\u5236\u9650\u9332\u753b\u3068YouTube 3D\u5909\u63db\u3092\u89e3\u653e\u3002\u5e83\u544a\u306a\u3057\u3002"}]}, "developer_name": "Zen Chang", "developer_privacy_policy_url": "https://www.zenchang.com/2026/05/privacy-policy-for-spatialcam-lite.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Chang", "support_website_url": null, "website_url": "https://www.zenchang.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1782694846471740"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "953128830878849"}]}, "baseline_offer": {"id": "953128830878849"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time
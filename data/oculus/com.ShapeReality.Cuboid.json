_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3i7edh6K2AQ7kNvwG9SqkI&_nc_oc=AdoHPR904UcO8fjNqsljOIE_H8V9KSAZDGTcH0GrWcmQ1mSFR9VnrJv6p6EQa2oYpv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDJ7WJNxR5dumPsGGSTKXSu-rn55xMPBC5935I40eWTg&oe=69C90603"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEuBI4-Bt40Q7kNvwE8hU3Q&_nc_oc=Adr_J9VJ6jU_sS_WzhOqkP9RtjYtMf7DFe3g72y-l8dLg_sMHxfsKdYw-NHqsDe1JMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgyjqBNavy3fVkDx1VtCzj80-Z8F8TH6c0rNorQVoYxA&oe=69C928F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_cjFqoK9CMQ7kNvwE0Qrm2&_nc_oc=Adq5DUK1WWT9ld89QA8lEp2wXd15WV6PR5IyPcF_3AWGoi-nIPvCIXpRblF7VOiHQlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrJCoug8OgatIUfBWN0Tx42U1ijylLZ8pt7pvjwj0cVQ&oe=69C902AF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVnxuqjA-C0Q7kNvwE_jSfU&_nc_oc=AdqsnrWaHAY2Ni0lYvqKCGA-QesQlpK1tmqa1RDAfmZxlXnOOzrgapEwHTxVo_rGGKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2wa9Kslw1we3OxOgSQ8E6zr1eusdLQC0xuWe8uX00fQ&oe=69C90EBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZH8d4o6CZMkQ7kNvwEK-2yr&_nc_oc=Adq4teFaz1nCu8OlUp12YfGHEoMt-9HMGwLoW3cS-Qz3Yp_2A0sNWiot7MyOlffnKEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBUV4EcwthIzvdt5-XOktr4fKE-hJTsFIbPMg5gLSBog&oe=69C90D06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
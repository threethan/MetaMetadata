tiO2JX8IgMRP8-0cCv2YK1-oJ-Knij3dhk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftsbFkC9q9sUZfPmSks5w9uNu06YHt73pBssjgRiDbKdg&oe=699C3303"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLDR5RLA1ZAQ7kNvwEekzAj&_nc_oc=AdlpExKysREteT59naiUqmxasiC9zbCRdaItSneeXJTKUdPwE0OA-GhNXiXuoJSc7Vk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv5vXRq-BGdUe89oC74GU0UJXCTvMkH_HoWpuH7jWqnsA&oe=699C55F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUkuMFZTvt0Q7kNvwFCjS2C&_nc_oc=AdlI_gxe2W282Tl3FWHTWGgpa731Cv338k5krGFrq7zkx-9F6jfI_cDmHrIky47R0_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv9nr62_CiaweOQCmxRaIKIlItPr6UYDheWygeZ_tkYLA&oe=699C67EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROJAzzMxXc0Q7kNvwEH27Y9&_nc_oc=Adlo9nO96paY-M4luDNNilFk7p_qpx0qsuwG6aJqmrc_PYFAzG6SwwjjiDCj6N-5Hyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftnNe54qaW4TEU3-CKZO9Zc56fwj0BTJjp4olY3cDte0g&oe=699C3BBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EaeA5gqHp8Q7kNvwFp5k2r&_nc_oc=Adl-RxSVrknMQTKl0PaXiG1NytktAR3RmjWXupIjKUupfAZFqG9_L5Cx4QwKnKx0fL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvvVA54VuWMXgoqn9oAQzxWBWOhjJZCHAIEUZtHsB0m5A&oe=699C3A06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
508851", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfk9SBLLwRsQ7kNvwHTvVUX&_nc_oc=AdoTAGWizTSZFELgM7DSfGicwpuVjP4cKbsRUWQ04HKZrNRl4c2g_nd0_I3xhG4SjE0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEJDBfMr2n8yPk1SiesGmmzvO8U6cqXN6kWXJ9YMKnlw&oe=6AA401F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsLonZOeFJMQ7kNvwFhYrzQ&_nc_oc=AdoYfcH0rk48B1EGMNQ7P0GNOSFeS_HBhPDiXAGQ8cFchI7I0cK7fteOb85xdvVivPA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM2MfNnOGjTQZkyfAfggbQHSX25QidCYdWVFmiwgaLcg&oe=6AA413EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYNeQeSF250Q7kNvwH21i8Y&_nc_oc=AdqbjncjmODEtK09JXQsbH_siVq8ynbVQTgowa_3lLeLQmPWV5OC_k_Biq0Tp08Twqw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTBfVF3NjNmHE7rhek2oiIdYi8v2HBM-Sg7PKtknHbHw&oe=6AA41FFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XNW-QKwtO8Q7kNvwFstTqm&_nc_oc=AdpErMqo9qTnEh2u7KJPOfdANY5jovY3D9R4WpEi-ejPhovppDQS8KuvCSgS3pam47Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmktiY5mgJY8v8beFmdepouQi1wBj-4wILMCG3KK2_hg&oe=6AA41E46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
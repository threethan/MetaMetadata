_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52SuhVpEBD0Q7kNvwHiLMX_&_nc_oc=Adp-ghohjLRgI8dxjctDSKHMXviUzVUZb0TdO_jEXXbTwDCyxi_WVWnuqXl8NDHy1A8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rlJ-J17jV54cZtHlREyDT2yTO_av4aWtTq4tMQnCLdA&oe=69F762C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8H67zkTJ-sQ7kNvwHIJx8K&_nc_oc=AdpMJYyoFHN2Fw7RhsBcLoU9U4-12a1YeFNPUjBerxJz2lT-gb5taLVcaYD1C2H1J68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0f3UpHr68fvJ31DuaswKJoSx61GdA70UVMuMw0q2DBSQ&oe=69F74D78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnFSJqH-aYgQ7kNvwGelDft&_nc_oc=Adqwair3IVY_-HCPWf-53WDVRvmENjJsTuK3OJDcHy4iRpfnluHnDYmfY-H2orK5GCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20w4zBbYpSIWlYpcxMOqvXnhz1TcXRmG3T1ZLzgKzVgA&oe=69F75F6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eSNK6p_Ml4Q7kNvwHADdBF&_nc_oc=AdrawYUXa85goD91lMHQ7C1HKzAXvrAShPIpd8UCE_vDrNl281lRruj1TnA9ZbWr5TE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28Y3sMc0-9R0LvYyrYg2bsgl8taCHIN4UvwldlF8XwGg&oe=69F76B7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJHSGH93FnoQ7kNvwHdlHdt&_nc_oc=AdpsPV69f4qmyBbonJE6AEkDk5Xsj3WgzDC2cdSbXI1Aqb8VinM6RMqbasbl2_lB0rA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AUZNcG2yw0_ZmB6Os2MkwuxSHHC8A_RyqAfKj_BTEsA&oe=69F769C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
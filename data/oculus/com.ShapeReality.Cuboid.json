_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3i7edh6K2AQ7kNvwEgqffw&_nc_oc=Ado0jwLKQvXDBpbEpHvHRQPm_-k5DeUIYhuOu9Ms19MBkPQg08jOrQRxLqsgZM8d-YY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE_v0dSLmtZOVcCDjCh8VfgEnfYYlU1W-6DwRaItcMcA&oe=69CA5783"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI0-04AIY2cQ7kNvwF4Uh8a&_nc_oc=AdrzKccm8n8WGPK9tEbEH2psXCufsYYxdosD6fgwON3MW-q-wYSvtYZ48BYdVNpgQuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwj1KlaEW7tPUM2A0l1BG2zcUhMFpzLNSN7MJD0dPHLHQ&oe=69CA7A78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_cjFqoK9CMQ7kNvwH_4dtV&_nc_oc=AdoggJjRZjptPSOwHgu-wVs9Go86Ux6Cf4CQ1dQLjGB_oT6T9A5m7pF97xd2V_dxSvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx487g89QxVaHkhipHd3pMoSq6An4irXNkHZZknSn1exA&oe=69CA8C6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVnxuqjA-C0Q7kNvwFZrVFY&_nc_oc=AdpIsaiLwAXkzMQeW-IAxmKA8EBJA5l9QPKWXx_uY2GXf9WakpC7yZjp3T3eyvgR1Us&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypoRiGbDXU-66-lUdgAzbiCsRrmSMEBxfNVGjbw4jREg&oe=69CA603C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZH8d4o6CZMkQ7kNvwGZDNqX&_nc_oc=AdrlMLIquJg6JmQdatFGV_ewcboJHdY7o2b_sqVJ61kiLc83OBbu5Jj3bUznEkHTpVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBmphz4iRjtNikbfiRGMKjPhWuzbeY9wwi6WW4aeRlrw&oe=69CA5E86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
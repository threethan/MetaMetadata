_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwMF08R7GvMQ7kNvwEgZaKu&_nc_oc=AdqglvyffJ5HZSFsAXofvjy6yTBQ9YLY2W_nWZR6-eZmo8HBmVrkthuOOqiuFc1CKgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFazn1nuAYC84SmTmF0qS4Ldg-ucoid1RXLHQPkoqXrA&oe=6A774443"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWnIOvEt5o4Q7kNvwGCaX1F&_nc_oc=AdrS_HxP4swmU9p05afqYg3kQSgQLLj1Y1xQrGKrKACzgAfRZKJVhSQovZax2xMkv3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGL7obVS0dnWNvWgz9tszPuwriVgHWVo_sls6eZRZ-4A&oe=6A772EF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAqXSttSursQ7kNvwEGjpTo&_nc_oc=AdqleGL-jd-t0Pkq36DcmFGuSKyqhqgk3w_YErdYeQtOOG3ys8_Pam7JIm0S_x-YJ3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDX_nYYQuJDqhdfyG3QP-WgHCZtFtd-bfkAoy9nEvN2Q&oe=6A7740EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92OjhV8r9ocQ7kNvwGH5-6F&_nc_oc=AdqeBhTYjG7h4bS0huRz4cimf_bFcTnF703-ZWJSZUXRt16BXeFYMhwPLlBNvJwquuI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL6hJc4BzZpb7tcZ0dKAAadSSA8UEg_YE73Wrno07yFg&oe=6A7714BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WMub6dKRPIQ7kNvwELmfo7&_nc_oc=Adq9hB1RCUMCDGxVIzfxXAvAa5_hC5TUa7ZxwmyKrM4g7hJ2VHdXbOe8aZPq-Qcyzx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfZZqKqo9tzyJzzh4vP3d8sbg6yMBa3XlxjHJX98JTgA&oe=6A771306"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
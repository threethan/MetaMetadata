_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTp7ZP7T578Q7kNvwHnSbCX&_nc_oc=AdqjyWZtv2eZpJs4uOL7BdLw8p69qcYUceJe0LBoQV9IhGASZ-oRKuhOY7hcrUweAAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl9FHkEoZgfKSP3ODSAE3Vkqd7nXuwkMqV-pL2kgFm9w&oe=6AAAAEC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oa5XuEjAM_0Q7kNvwHpxjPi&_nc_oc=AdqXJGVc607GO7kfYVEbRdf39mc3x0NTxfuVJM7YiupmgKcHMW3L9A4IsVDyR3Nk5Iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaSgxF2_NU108-4BmH9lgOLvuGDlD8sdGM6X4vbKLy7g&oe=6AAA9978"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaR8vhaO2s0Q7kNvwHoXrLb&_nc_oc=Adp72xU910VjgS7dDD4dn3s8L2JTe5WQcePmDZhUPb3BcA_Ypbk8jlqA1sEx1fo_SsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDCHqiX7ZBXMgYa8VeYNwFMrNzW_uLnGHpsZB5z4P_ew&oe=6AAAAB6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVRgCUm5xqkQ7kNvwFZ_d1I&_nc_oc=Adq4Iy2Kp-bnlw4Yt7AniWUp0GyzHAJK7rhY30yVKz_Hx0kFdceDWWHM98AgWjTU5rQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUdZz47VRVjQPIvqa1J7sctJzFMYK73hAjRMFM0x6Ldg&oe=6AAAB77C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTHtCYSvH2kQ7kNvwGInzhc&_nc_oc=AdpHMSMerlkhNTZAZJwNtd883uFfMpHCurW2nh167_mrPkLLNsm3uhYiKNg4kInHjlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ948KljUp-qhDN7-fZCYgFZDlnfq-axP3fMTXb3Dostg&oe=6AAAB5C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
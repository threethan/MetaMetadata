_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D54NLBj-P8QQ7kNvwE-V3nY&_nc_oc=Ado2Dk7H854Q80_qnPHxi2xHjIsBn_aOO2CJ9jOdrddWfAHhUkB93oD-bSEFCaWiyYA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WfbTS0CQ1xOyiXhn6zNuhQ7g_GduI7KHJyMt6jLDPLg&oe=6A43D9C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6irzjja8nZQQ7kNvwGvFjgt&_nc_oc=AdquU71P52zj1vMVOoPBLgKVYd1BaX9WjMtD84HlyQBbMRuCcDArifNiTot-M1duDeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af855reWN-WoaU0Myq-sNxUE6S1aKrU5kGGy8zdm8LbEfQ&oe=6A43C478"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=525OGHWXP48Q7kNvwG4ipot&_nc_oc=AdqajEdGDJIZQ2ZSlaHVXuBbigABB79hENigyp2VRPdImm56lBIRfbEGxGHpoUkenSQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YeoHywDmRi6AxOmOdGknWFpiVkd9noIBrTAdhteaJnQ&oe=6A43D66F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ybc6MFgaVkQ7kNvwHIWQuT&_nc_oc=AdpN2salqBB7jl3cSZ94b_VXSjhd-c6JzxjmON7a9xkYlhho27_8Ww2x-hemqMZ7HeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af982QxsoboPOs8-mb_zv3Ng18oHLzCjSQpb9xwX-xYvOQ&oe=6A43E27C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXb1PRCFk8AQ7kNvwF0yaKV&_nc_oc=Adq_ZvPppiyhassUPsSGm----WiwBGaQucclCyaH3Kq80I-xLH0YEreKCp5r5UiHJsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QcFh1DAjcfcbndFe3qk29r1HOdNWH8sQTQ6Tr1Tdh7Q&oe=6A43E0C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU6-FrbE-3wQ7kNvwE8eqeq&_nc_oc=Ado76ChrNFrBnsMnZiCuriIjuWFoRy0Rvqcy5Xm0kDmyEC-exfQxiAHkbb5JtyfbAZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q_tTG8q-ULYyiV5OxqjtRqToBOV3ZnrOz_nJ-Ad21Ow&oe=6A009D43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_YMFf68d58Q7kNvwE5DJvJ&_nc_oc=AdoC7xS-gxnA5MK4HjplfalTKsvN3uJaxXw1e2yiJFIFZBV-YKYIAjAqELDIBgJsZHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58G_nV3jYZLiljkfmnP09rkeI1lb0DOpNITaPk5JgYNw&oe=6A0087F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej41syhcM7kQ7kNvwEKxl0q&_nc_oc=Adq919vDSSFV8IYz0gNuIYCz3x_Av-Wmq0-IVkOdzA4hWKEiuxLQbHJvfURUHJPtA98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t2Bugd7WYVzYuuLVjetKjDGp4d1JAVDRbad1-G_5xdg&oe=6A0099EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aahz1Agmo9QQ7kNvwHKsGXK&_nc_oc=AdqMf6bxHxugdp5-2wy8bU63YVRn_KKXOHJZ8l-EPzSEp0mw9lu3nc7dtWBjIc0hjnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CJ79iAeg-X4LopZ4cFGrWPQx2ogcfriD1N3fCmzOYLQ&oe=6A00A5FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gAFMZYCRVQQ7kNvwH2wlsH&_nc_oc=AdqjwnfzmNc6KQGNUL20OpbyVxdsohS5QZ1aazs2OYckmsiQlEG3eKC-O6wNYvj6pAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ekev4BROU5x1COjkVE9UnjYWCxpDw9XFfZtnsfVpQTQ&oe=6A00A446"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
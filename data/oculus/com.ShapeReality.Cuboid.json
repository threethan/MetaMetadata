_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLcJtaE2-pYQ7kNvwEmN6Ty&_nc_oc=Adrs3RFc6192-mQx_fLcwKd4nmk8IS48stUg3xBVA5c1YvGb8lKmvgIIGHHCzbE_4M8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aLrUEl-m74ONIjLFja4OvFngx7MxG7sV49belR78NVw&oe=6A3A9F43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ9hHWNqTJ0Q7kNvwFuL5P4&_nc_oc=AdpG9sbpUo32g8NiwKHvNyu0OADwMob3cxK60MNBpOXXk9YyACZF_8VYwkIaDsV9qWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s3dnIBU3hYYT3epeT-yo0GM6hFqLKe8djGiDcqLfU1A&oe=6A3A89F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W-HWaxxuYQQ7kNvwEw5Z_Q&_nc_oc=Adq7bEQqwPVb6BftS47wiBTc5av-mi1Gb0WtFlb_e44xPRwVBVvYTktvSXrd4KjhEic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XkX81Mo7vLVA38y_hcv0Y1SRbWvVnFB0Y2KL_3QxfCw&oe=6A3A9BEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEofPBWw4xAQ7kNvwGEfYiS&_nc_oc=Adq7tDHsOo4Idzof-dIDz8uHU-hbL4zD_FfKBUSmCcCuyzJEIF036J_0sc4_Mm7_bfs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LdHBwP_ozSj7ulEmGgMfVzRX7109_IOWxck-Bdtn6GQ&oe=6A3AA7FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbtfhhliGi0Q7kNvwGcSBNi&_nc_oc=AdqBZpzk5wWkHc3K6BDDJ1h0CvLRqY0rexMItP_WTpXv1DpDpd8oXsmBm5CsbbjJuS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HK5-4ktycvMdW4HJ-UWfAk6NLOwtRR1WuPBZSR5S3eg&oe=6A3AA646"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
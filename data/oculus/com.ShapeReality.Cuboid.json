_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTp7ZP7T578Q7kNvwFVM1r4&_nc_oc=Adottp3oJp9VH1LXSfr_8PaXIjNDwF64kz_GcbQJxvsBPWeM6fw6pn6FNzbGN9q-tsY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW5K29ToFk7aqnZcSmIaStDyXb6DvddKoondxQ3_Aj0A&oe=6AAD51C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxqVygfl08sQ7kNvwFZXjKl&_nc_oc=Adqhoyw_wkkc3YklfJF5Vduq6v4_jDRuOCjftrjc6U8evsF-T1dVsu1lPrpZFQHLUh8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWC9_t-W3xSljAmNXYnIRGb3TyQAfHLcNKMcniLlVUeQ&oe=6AAD3C78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaR8vhaO2s0Q7kNvwG2FxKM&_nc_oc=AdoMNZxRmoH2pZhF8WKWCk9eVvp1ykKpUjqGUKNvs3tiUbWmWxPG1_AxYbhkUdAH5iE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWLJOALaVSYHJifsYBbxIbX4BhXaaXKUu9Z6Pmv4eE2A&oe=6AAD4E6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVRgCUm5xqkQ7kNvwHOu72w&_nc_oc=AdqZD6sCUoxtrTqTmztdyD90pWe2xJJsPnVY-O7zm6c1s7xqV06TbnJmHylEo-tJ-3U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX3UhSsqmLOViKyXVqGWHUlxyJTWYBueVFhfGoxwXG4g&oe=6AAD5A7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utCI_cqRqqQQ7kNvwHvGQeL&_nc_oc=AdpHSDr7UORmUWwa4P2l39sXsJFkqWBr87w_hsTxqXVLcPD5HqKlW5NuUPmJuix4Too&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPStJJxNNV4YSmlclAqmBzaf6uoYWdPuGiqmIC-xtRvg&oe=6AAD58C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
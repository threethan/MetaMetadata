_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w1t1Y4arH8Q7kNvwFbtR5m&_nc_oc=Ado4OmB_TGSzIkZtmFTsAfGyUE53tl5eLA6zdlXucFuwsdaUV-d7-TX2HfzqoWvKNBU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmtqB2fpe2h72Jt52GiG99GtxqfIyoBx4qU71NincmnA&oe=6A54FD43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMY56qPQEa8Q7kNvwHDcuAG&_nc_oc=AdptuD7rkQXOO-wrvjktGSTQwWKmUWRTo3aj2SMr5i8bGmrJiI0ltXJXcZ0w7O1hqSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuPaqdHjEb51dSISxoHYafNEXtoNQzQBrJb0c1Fs4RBQ&oe=6A54E7F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMgSf3QbP_4Q7kNvwEVQw1I&_nc_oc=Adp9cU-_1wHprEDWNVKjRVNL87Wn6psoKzzfNnUSQz6kJqt7HXrnGWVgC9QUInxkKcw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcPbisk03JsjK5MERvWzIsSEfogbsK-OrWtNL1ZzcVbg&oe=6A54F9EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98oAyuhM_lYQ7kNvwGE7R8p&_nc_oc=AdpR2tDkEZ48ZRHYR_XpxM7LcjCqPasGdw1acq0Ma55Y0oBAokxGNRugmxI7kpki_mk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzzDJcYovRqP6yu7YTpeWGTLGGk0O7wn4tPnNom4DCfA&oe=6A5505FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPk-3C83uPEQ7kNvwGkLR9x&_nc_oc=AdrqzxWPX_CJO3bUvw-75AmKC0A_8Po0lQGfBMXNqgde2RaZJFg2_e2iBqtsAONYUvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA10DCM8emYVk0YXy7Fb10MMFeA3r3rkL-hr4KKPIojNQ&oe=6A550446"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
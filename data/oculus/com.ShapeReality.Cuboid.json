_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEOwhuG5YQAQ7kNvwESTnWv&_nc_oc=AdqA-j6VnUiAGrtA443E2pVetNKxcve-tcC3TrtfttMOvkX7Svt8ZWOHoBEYP2Q8_kU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdLdeb8PQNrXvFK3-YzhdHYiFGsPLSoYBb54ramt3XvQ&oe=6A68C3C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eRhAF-wPykQ7kNvwGSMU7Q&_nc_oc=AdqMXkbCbmlo_WjEvJ01aApxoIL4my34ARwEmRcgSqAZfvAT9mfXhHk3bgvjpvBlbaI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsy7Fm-24qHKySQp4RZTZJuSvjT09sNgJ9JAdIPDLyvQ&oe=6A68AE78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49gUeGZIM-8Q7kNvwG8XN_A&_nc_oc=AdoW3fR8Q9N23wKucY_j95gqm_friqwu1MVc_sd1f8BsEN66nRh7qZLnh46egZ2wPnk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVdjezNthMhACCCcQ4jrQ6egEjsGgjYJfZCZXhPqDSYw&oe=6A68C06F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4iKeTRKrNwQ7kNvwHKLYOK&_nc_oc=AdoJ1olndWrbeQaNbH5vSgrnZyn3-20GoFZqUlBhkidryo4-z74aeB1wL1yNfDRs3Ew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXW_SrDHIbQo42Gi-COKHQ-tAQiAqWorFaZ_tJy8y9ng&oe=6A68943C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAm1ou9EADsQ7kNvwHueebf&_nc_oc=AdoLgERBlrVKHB0czc_RWxJFX3wxT4ysI3xKrfXWn35By3nCcJLeHDdNem1MyWwitqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9pm63dhFq6D0ru75zilRporwDk8QHpdbBC6aPVtOcHw&oe=6A689286"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxFC3G0Hj-cQ7kNvwG7d7wv&_nc_oc=AdqUYs966uccpKqDH68ezTbuibHt9GvCz6ygxrzQttLTuSJ9H8A_vhL48GVkAP3Eip8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l-MkSeTdgHKnf3UpuMld2ASUUtGuxDMf1NGtKEgMgMA&oe=69ECD6C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j0HqphX8NwQ7kNvwHeQfOi&_nc_oc=AdpNdAIpiXsCK_puIuxnX7M3-JsQpMsiklU8QSZXonpUw-JnYSbLQwYqxxHKxXlp6-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iuSRerBVsBt-dLTVxMtHCli4Y1uBMOZOKHTTGjRzu3w&oe=69ECC178"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xySt6muzFyUQ7kNvwFUKN_l&_nc_oc=Adr8KlaXl-Wnt6d5q343h2oAy3u5rLEdiVhI4WP1uP32mVr76Ij4il9s3ArcKvkAuOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i47q1RC5UjUVt3W5FFjSXI9rITTciIZV26CjUZu1E2w&oe=69ECD36F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGU43bDTLcQQ7kNvwHloDoE&_nc_oc=AdqQ90AVjaNL1mJSERQodYkR87Cmgi_YuLa5EvXygWWPK0cs3WV_385IH2bsMYHkVI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mpPTUHwMPhrGVmN5AsbgJarpdEwMRdXwSEsoV8bvIHA&oe=69ECA73C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I5tI4qFCvMQ7kNvwEP0B4H&_nc_oc=AdrWsC4aidF8i3CtTMAycumOhLGwTFiM6mVB-z03ht40h1mZ6TF61K-KV6n0drMH_qA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af172btmZgyMUC01-cc7DS58PFl8I69_bN5YQI47td8czg&oe=69ECA586"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
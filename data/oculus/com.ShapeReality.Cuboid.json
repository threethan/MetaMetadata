_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SiddXc2aRwQ7kNvwGOdCi9&_nc_oc=AdqkUYs-xVj30M5hVIPOSJPAmez-UHf6ngj5G0Xf87qiWA2TcLf5xfOIsbJaj8N6fUI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rffbDHFtlZfqZ1Mbk_sfyiNSm2GAPJvgEYb4E1L_N7w&oe=6A3E93C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocinRKURsjgQ7kNvwG9YXDN&_nc_oc=Adq-AIuU0gofmzRPKaQFl5tl4gVAm7sRwMmzH6dor1k_wi17uZg2l4nw7ubHQJGzXzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CGTqd-VwAxvdjVUeZ65ymXilbSLsIEbcLUIN_n9qTiA&oe=6A3E7E78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrbK0jZ2KwsQ7kNvwFkZD42&_nc_oc=Adr7VWPx_gzxkrskdqfS0zsBAMZVvYjGnEz23xXZIz_jMwHx7Ci5nWtvAC6PfNFcTyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9seEt3c7haC2I_sqT10Bgch21ElJI62yKiQZQuJhRNvw&oe=6A3E906F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoVyy5pM3TYQ7kNvwGAyc5J&_nc_oc=AdpfH7WKQqkxfKzUMnkxsHGffHcKTqY2ABD_BR3oI2e6x1K5y4FrEimoEIdgiuc8c2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QHeUIFpyHflpW61hcGuEfV0wWww-SO0AMcDvEuxpNiA&oe=6A3E9C7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wEubcry9YUQ7kNvwGprFJ2&_nc_oc=Adp82pq8OLBN8ryvBvLI1XJ68MW3Fsay4lLYefDUFiY1TGN6GavrLOKMLfatt0LfVCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lpkHHr88zRLpXSitYhJza-BND83vw3FELjFamDsthfw&oe=6A3E9AC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
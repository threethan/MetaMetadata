_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU6-FrbE-3wQ7kNvwF7a9o6&_nc_oc=Adrcdb4Vhcj1sMeDByerJTuJ6BrcQJXrJctWQOAuQufz_vT3EQnaYkuWnJWeNG9oEcg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h10RQ-Qc9AE2nxkvp4laSX2slL-KYrVWqUdDMCH-LLw&oe=6A01EEC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7jqOo1pXL0Q7kNvwGI9bqD&_nc_oc=AdpQrFi9443DfsvzMc7W1Cx6SJk2syOtuF4bMOw1Y7OySg4DlZBi4qxMxF2k80YaD3k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r7gNTXKHzFYAxZHqQw0uy1-1uWAjpZc45hOm5ZyMUdQ&oe=6A01D978"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej41syhcM7kQ7kNvwH8H43t&_nc_oc=Adpl9k_kIZaqn34Ancb1oNDkZlUIT233QcdASBJGXYRDCn6V2jnHoTMUUrzjB43iTz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qytldLHoCw2p2wpKxG3LOfrMmJeDnuhvdJ0Z-XS6gdw&oe=6A01EB6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aahz1Agmo9QQ7kNvwEIbFmN&_nc_oc=Adpe-j_tU5MWdYPq8jooRR-Gm2ZXBmUByMduKzgtTGbN5qGSJXRHqywCTE3TcfOU8DU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y1xriF34wo-aAyIMlB_Rkj3FVg0lqcI8pVjQEDzqQxw&oe=6A01F77C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gAFMZYCRVQQ7kNvwEf_WjP&_nc_oc=AdrVmqpMPRlI_hXIxo3Dz9l3j9G762KSre33jnnbMOlx_AFJQvqp4AwdeTsCIxf2ypg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v1f4Tzb5va1xfxaieNt3_vRfhUfqaU01xmZvptSIcBA&oe=6A01F5C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
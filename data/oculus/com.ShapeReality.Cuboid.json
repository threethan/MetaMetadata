_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWXImVR4VVUQ7kNvwFML9lD&_nc_oc=AdouHwHklCNKnMlE7LQsI97G4R-h8R3I2vT2VS_0WfT707MGUNI4O5oVwHH0qY3gVzk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93q-kQN4lzUrtcV4Mydck8woGhz0Xatx1ScRgy8_ilFw&oe=6A2192C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSON4nhzt94Q7kNvwHbolpD&_nc_oc=AdpoQDL4ADXsOBLT9gHhU0-2GdfMITP5_icqlpuCuS1rX60ei2jHbEWGaCbayutn8Fg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jraxdqLgl1W8qnm3oY8FrbsDoY3UnKhUWztrOx2--5w&oe=6A217D78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuwVEZoSTmQQ7kNvwGwhA-z&_nc_oc=AdoZLaTTLYb2JQM1ORuJp0_G0o1xJOd6KG5TqeoWpGnSZ0ejin47dePqTgdlt6r8j8o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xd5kDrPQdDpUrsk-LfMb3qp3JM28CTNPem54jBjUG_w&oe=6A218F6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CYpGddQTSYQ7kNvwHu0mWr&_nc_oc=AdpVAm3NmxaZ8SFa-QjeZHUKv5qYJKIp4tE4a-5qgxKplztWflXoUxEV8AwVDwoYrpk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1jB49k-fORq61ot6-lHvCla-eVXkyotcHucFlAkC_Xg&oe=6A219B7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ed0eXGrFE7oQ7kNvwHVsv8z&_nc_oc=AdrSFRX3HGqx5gV0ryXC4-4Zf6SF5cEBQ2wpMVLtFE_DhJqTbMJUtZmbDgdeyzEESZ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sRS_F-nUxeYkbJEkYu5Cg8CQwIKzMEECbkY2UcH2FAA&oe=6A2199C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
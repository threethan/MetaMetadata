_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXkFE6Y-ecEQ7kNvwHptT-E&_nc_oc=AdpkR1ZCxMD1x00_KrjXaaof8yELSn_-aPFFAvx0qM2bw2daJCClTl335tLw0DADnws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMZnXsVWBXJ9T56qAWwZHsNnXVEiumjSqvYetqt47n2Q&oe=6A82E983"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kas8SHlaoSEQ7kNvwHxrhGR&_nc_oc=Adox0U5tDipftz94FUqOH9ABxVA-XirS8qeu6tCI2H0voBHwmuS5cvJo_YK3rG2Vcgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLVXBGvZs7dc40jPdnr9Qcb-tYFX2J_SA6_ILX6PHLqQ&oe=6A830C78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQP4iY9ZOO8Q7kNvwGtO-zl&_nc_oc=AdqHDNKrMK40udyAdbFPpijuKg07Q_MHCrg_TuvfaGVGtlpllQqCiu2RORYc3Jlna5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2KIPz8Y1_21Q3KRGBG378zJLktri1iR_f3kIdlp47kw&oe=6A82E62F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qaXjldcUF8Q7kNvwGoQuM1&_nc_oc=Adp8mVwsQhV8OCk64i4aCy1AJf-Tp0J7dBvKFG5bHx4lqf0Mlu1OctSj_EsSGvHmRes&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWhovZZVFhsDQhLeuPbzLa1ZtbXQ-6aa3CrK8UnAJ8vA&oe=6A82F23C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoIdUK0BZTcQ7kNvwGTvkKL&_nc_oc=AdoWASZQA-7cMlRALNGT0EzqDABwF7TuaddrD3nOi-y2i2zcikkeGR--Vcs4VoBth8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKU_Sbarfdp8cG0K7qALK0BkAs3SDcD7k_7c4xzST30w&oe=6A82F086"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
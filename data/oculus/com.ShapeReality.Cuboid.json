_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byr8BDqYzmcQ7kNvwH8X6g4&_nc_oc=AdqDJTXzubjOemqn-CmSlwn4KElRckfO6Rsce43ws06vSuc4AOQm0_nkE0kDMdCusDU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xzPficDyTIciOoLm3Ydny3yTnUTlnPV9Od5lf1b0xIQ&oe=6A1D9E43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr0jV7cqSYgQ7kNvwGxeCv4&_nc_oc=AdqwREIwIwrPHSrou6BdPnamViYlUIO2gUf0dyPZhzHk3mCt7I0xJB_-j067NTMuKWs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vXFVZuV1buVw4XrpHXzgfmdwFuRvAD4YwVxl0Qz4vAg&oe=6A1D88F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zfe2QOo94swQ7kNvwHMHBff&_nc_oc=AdqbmEwXSZ7BziRlEkIdQzDhtoRJJoAOWPUMi3_G8yhkyufhyTgtLAfSZJfdcZTpGMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56W1alplf01a66zJQfqSkWoF2k4T9hsiph-GRLIPNmPA&oe=6A1D9AEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXpRyXbbuKMQ7kNvwF3o6GZ&_nc_oc=AdqZ9oRDIHWFNHvz4Gq1w3GRNElfgmkbt5DSYdKL_19w2XhyfMHQrm-qqrXpUU-D4LE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fA36erHdQ_ebDlL4oQQJBcT0Ei1wNNja_kcSs0NhWtQ&oe=6A1DA6FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmH842-HsbgQ7kNvwHEmcqF&_nc_oc=AdpQjdzKB976lFH2enQO7DO9fMddH9pykznRuye8zebgoVRXCbrdM7exHRcouHGVK64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zN_UzPCy6Ia5WGrHVTNZNVJ0xKWu1e0UiaoPB5KY0TQ&oe=6A1DA546"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
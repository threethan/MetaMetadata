_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWuAMraWueoQ7kNvwEJdFeM&_nc_oc=AdqCJMwP5xLp9bBDPtPbyCCbo-BDtJ23zklrdr5OtBc8bQ4goNy5AArzjva-6KQ0zTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMHlz2fKMJffZtgkGB_o7TUxlZFtAyAAxoH_muvxtjLw&oe=69C26E83"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwSYU7Nod-oQ7kNvwF68LK1&_nc_oc=AdpRRv-cFbFGv8nNwaXR9sOxsIj0VoQw4LLGdo92CmfJAYu704fOp9JiwSM_StpVodw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzT5QuCDsan07CzVz9E_l0wLsAiIx59JV0GX2o2hI-q5Q&oe=69C29178"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY-BnYvHQUoQ7kNvwF8bJMX&_nc_oc=AdpKz5C8MCyqtqyjMByuuTC-IPxzRq-siDQmHLBORTkrud2b3YVrsCjNYyEmAd-LlF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8KDDIXHOuYnbBKyGh6l8wdWlxNCe5L1LBhkQ4hob75g&oe=69C26B2F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQyLJRFAvk8Q7kNvwG18rqC&_nc_oc=AdoLZ8SnQPKH7rXmZ1yME-BNqfcBrti8v3Iw9pRXRft3xY7bhvlaeeekqpVLjj1WPrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsgiBheBs-b4eI0DTydgb-Hy6-ZivXFhvsUBM4ZimGrA&oe=69C2773C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZGyacUjzugQ7kNvwGa8Jrt&_nc_oc=AdqQ10RsJ0rOvMVShX1mNJLa5qd8L0tLFumbq-sOtOas_Qu5fX7dU7SMGTJwGoH97XU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyU7wB1MO2qSRNcUp76X1gfz3Ww2EB9VgJVvjagXiX0aQ&oe=69C27586"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
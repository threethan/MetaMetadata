_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCTVQXvG37sQ7kNvwFLDjIv&_nc_oc=AdoIr07rMt7jT2-f19CEMqIygQjrpfzoSD7MkipyHdTJotAJP9koL8cdrC_4NuRIG-I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JSNuhdaAF40LjBr8v2UtqFW6nlNUuYRAOVmXt454yIA&oe=6A26D8C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWxqj0s0jDoQ7kNvwFaspdU&_nc_oc=Ado8OGmkGjLsCetbTsveuKw7AQBVzgS8T62KftghMLebqe1BFXp_Fuw-qq71Yz5SoWY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ar-m63MJ8HFnDnt2mSEAWmzFUm1szwTaq5Gko9mAWsw&oe=6A26C378"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ta-BLIZNI2sQ7kNvwGPe34C&_nc_oc=Adpopb6KoJ-ZDpIk6JbeSPnXy7z22A1pjomNw8rfJ5cfxUnuMBbG8Z9hucn53O9tMAE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TnnGkw61eyoe5k5Twm18YtIPyETRBTlxSVq340FPPdA&oe=6A26D56F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3DgWhqbTXIQ7kNvwFNqMge&_nc_oc=AdrNP23izDIYXKSmqGpvFaLjFjFKgfV8FmYXYnL6qe5w0Us4bbVxAD5r6OnxzLMwQPg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Es0EvVU8zNEIpWhrmGslWDq1Tc17lPiQJ3E25xocLcw&oe=6A26E17C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg_a2KrAFN8Q7kNvwFVNnZi&_nc_oc=AdrHKgdUv21qe1Mo-Ta5bwvMhRK-9lNlUDhHLVXwV4SD1jxAu6TBoQtA6SdGZZ6alrI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-txbTk6SgN13roD262YVRVa9uiwa7KLymAUe4QI8Iv-w&oe=6A26DFC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
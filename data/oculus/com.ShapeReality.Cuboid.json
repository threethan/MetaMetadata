_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHehkGpcC6oQ7kNvwHSDvlw&_nc_oc=AdoVYKOcWZU4eNr_WtQRfcXmK-itxKCmdPfzxAKOUDDNb0Jq9dD10BbEcrlEdKYGqjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2B1uq8amqKZPXxyE9hcPy5BI7dMyaSA5GEq25oCk8iA&oe=6A7B38C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83U1r3WIlSwQ7kNvwESLUyl&_nc_oc=AdoqnHvVzfgOy0jQ9EuKDnNJ3eIQsmwDKngr5rWhtpNv6YqHvKdIy7I3bZNO8SZEtvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvSEjXZ1i5-ckaw94KDMBlPAQ9u0Fxyv5PFFCW8SWP8g&oe=6A7B2378"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpcnUiv-C6AQ7kNvwFNs_gb&_nc_oc=AdqZkEPP803RqouMSKerqAXe3lhuUP8aMUJnWnWIU1moMP56Rb_ISL_xLXNRMmpCxKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI5y0Vo1LX7QRJDypmkziA-WfvnC7dMjB6X1tVZg1PiQ&oe=6A7B356F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtGA_7Bfe_4Q7kNvwEIdvlm&_nc_oc=Adpt3gg_zoFYIHmZHGx5WKfvydWVHQ7pv4yO6CiXPfK4l-2Vgp7ZIANP2AONoEo86GI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMRYz6Ozf_rnyEx0xz6b_lOY858vQKN-xLlOOMbbhwuQ&oe=6A7B093C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PCdRxqHynYQ7kNvwE4kcCE&_nc_oc=AdqBkoVYKmi0Qs28zs9nVeFMVTySM-H28vOpSdWLd0q4tVmOeCW5YnjZ4QEFfRBJfhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-cdKH37zDVTjR7LRzkEnLup46d6mocf02j3L1VIwYGw&oe=6A7B0786"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
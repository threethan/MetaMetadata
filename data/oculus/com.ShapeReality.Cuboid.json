_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awFtV1xPznkQ7kNvwHKn85k&_nc_oc=Adr2vkckT59IQGA2eFsqxHW_Hfmlx5x14SV2zynqhcfC6qmakWFGU5TFjygNH4ZoUt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB76loJTKJoqseANY5_MaLvtol_DaLbBX0dqHcvYmHPw&oe=6AF33143"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGdYkg9MBqAQ7kNvwGPgGik&_nc_oc=AdoKw3YDH5-VxPMCDnw6RFJSY23Ztdu4fk6IDVv0jLQ_EwBps9VkX-yDqkXh95A-C-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhLVucpFTcmBvFg467kgNlG5MEyhFJjcT6SOzKxzLKgg&oe=6AF35438"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYNnXtEgowYQ7kNvwEBy1PX&_nc_oc=Adry0LJu2INQacjBhOwkNGJmNHIDQvqZM3981hE4mLN6vx20n6T60MvfyLSrzC3uspg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ4loESizLdATRd2kFZA-GtnkVhrFKePFgk3RCfuLg1w&oe=6AF32DEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfImFrrZBh0Q7kNvwH7t-uj&_nc_oc=Adpp1TDNQlj19W8jwNRHnNg812KrY50Ar3argQeIjC63bfGNJD2o6aPOuNj_HP9h9u4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRNa_eoEL4GJXCJ04LbK7spsJfhDNGpE8U6_398e0g-A&oe=6AF339FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHMrU6jTmYEQ7kNvwHKkbh2&_nc_oc=Adq75xDJQtQDsz0DYoxceUdodTr4l49Ep5oYMqK6SxDqw7G8sPCFnFUQHejxhl9IKCs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtn-jzzJX7DAmNjcwc844dtblg0Um9-npySWvgH1eRFA&oe=6AF33846"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
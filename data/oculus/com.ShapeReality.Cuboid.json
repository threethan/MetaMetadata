_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y-dLS2nVmAQ7kNvwEoxhbN&_nc_oc=AdrOCTEbFxEnBDCYz_S5UHIH_AmYsqyyDM1uVKaxFNdxCI3sjIyL89G59mocq5hgPxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkUFiqyRVmnDT6et4crCTsc6dyrbIMidMZe7Q0BCU6RQ&oe=6ABBD243"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7j36RtcHFLwQ7kNvwEG3hrT&_nc_oc=Adpmb5s5uAvvXoqGEROXZe1Cbgu2D4TCxmlomM0LOgTS1pQ7e6XBpg3N0JXFjAu5Y18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCtKhWYSra4Zs9jq11i_FhrOqOL4znAmGEQgxgmQNquA&oe=6ABBBCF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kiy2i2Pt0MkQ7kNvwFibFgM&_nc_oc=AdpFqQJBO165D7IUBBr-4UjygvH_hLT7u5il_ExIapNPBi_voVQt_mBYewQfPxlLU54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL9Yk7snB7-_4yjplUU3TBgrCGa8WHHsTx5MQ2TKjXAA&oe=6ABBCEEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2COyYeIvotUQ7kNvwHramvb&_nc_oc=Adp6cRVATaT_v0xstDVoNCV9yAhKWGhcyU6eYe1GK8HW9P83j_6IEaAouvsVnDQScnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ07PqWU-_0nbjCjZ9AwPflqgEoEaySZeBGugGWIY78sA&oe=6ABBDAFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVlhEJrMSMQQ7kNvwEjMdjZ&_nc_oc=Adpnahch3cgsuTLNGrUpq9fapRSvXpVtPHDE81mQJxKXm1znRptItNcrznZEkSUzwlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKELdyqtGyhVRdzY0uNrF3sU8zeOX-HPx1zB74mOfeR_Q&oe=6ABBD946"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
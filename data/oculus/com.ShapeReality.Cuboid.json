_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkBQ_pO1tHQQ7kNvwHF0OmF&_nc_oc=AdrtIF9n0D3UrGjWyOBK4C6G3cP8FyM_K61JzcCoH_PbZgLLyNHhSOrZSB_awdYbI9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9SEKe0T6zL20BNrbc6k9gGlavec62BN6ki12RJVWhFQ&oe=6A707483"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvILOjIP59IQ7kNvwGsKTxk&_nc_oc=AdqphoqbRTQXfrQf0gZWoTN7sQW_nza8vUvG-rRwHFGC1RkmQmR1qbcenqOqkyzuFE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr8vgyJ42vk2UUafF5u3rWuQfcWBGZKq5E3clAGZmcpg&oe=6A709778"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWtNf7QnGdUQ7kNvwEKIuob&_nc_oc=AdohGvswiBAz5dz9pd1VRPzNtnRhJOo6e67uT5WQspnUF7iZkRJ2K3mxqaNjg-IT3_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMummgqjebpvXDxlP79k1N6m0T11yLU1G3crP1AvzoDw&oe=6A70A96F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2zDjcS8p8EQ7kNvwEjQVuu&_nc_oc=AdprJpPHiDz0HRx3mRucT2zrab44YRDUG5t7Xfrc692nZDLjka0XlME5T9xgdTR6sOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0tS4ZK7RqhxDrs-abnyrBXprej75PhxP2f9wQNTZUfA&oe=6A707D3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzGGakGYh-oQ7kNvwF1KXGc&_nc_oc=Adq3s2luOSl0a9hnJ-bOlkPtbzUxP0qC0Gkk-aAZCrPSDgsSCqdLLHqjdusxBdR_Jrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD5bdVW6tVdZZe3MtTcYfeWWpdNLFEGh-m0oTBCXwpdw&oe=6A707B86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUhLWoijeTsQ7kNvwF2RixJ&_nc_oc=AdqeWSE_ylM0YfinsOLYwggr3K2_grw9MFBMb06YJBuOcOSjA_PbTtGaP6X88b1Qb0E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GxjgTgOlQ9c1f6G2i3XpfyNgU0qAvugi0rWfOrRq2Ow&oe=6A32B643"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMBk4Mmp9qwQ7kNvwEbVFhK&_nc_oc=AdpHGY-PbmbY65OcRqM_Lu4t4L9VQSIs6v64LvDfb0B5KW9lyMGwAVotWLPXu8L5nJ0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lthbPOqG-DqqeC9BIrvHSGebB0D-a_bS_eNAIDia2EQ&oe=6A32A0F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wlZdkG8OWkQ7kNvwH0Lqd2&_nc_oc=Adr2b0F2jAfCvet-q3D1Yqp00jZPqJ0u2kihnWAQauiB4li-qQU5d1LuI4cQNoVyNXA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YaOdUjWlhw17Drs3CNWsUxJkCzCOWHGULxZdh---TcA&oe=6A32B2EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lHfl68Gs0UQ7kNvwF8c1XN&_nc_oc=AdomvEJyG_A3tXVlttiTtvudcPJVgof_1Qgrms-yeHbBS9C9r0PnObJDhkfrL7rTcws&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AIALl_Mny-glI3Lt8z9Eo9Wm87cYGinucsZ5ddTKVqw&oe=6A32BEFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUA6g0uaqcEQ7kNvwGk63sg&_nc_oc=AdqUPtkTKLmJbB60rRCNGoDt2U41yrLQ6Dm8bk1l4dboENOkjd-SM-m0lCdtIaOmshY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87Tp3l2t4XLCM6aPEQm3Y5Bz6sRjvlpaqm3Anl4IyL2Q&oe=6A32BD46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
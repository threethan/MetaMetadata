_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyRKVytzlbUQ7kNvwGNpXoZ&_nc_oc=AdpNtCqFV6v9fc070a3YUN4S7MX9Gv4AHsZqvVDY8CnaQg4liAYASFYy-vY5j84WlUE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7uGUxCWYmCnVeNCmfD7xcTR_9SotPoAQMbn_lc1kOqQ&oe=6A901883"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1D5Gk6d5sQQ7kNvwF2os4f&_nc_oc=Adru_y20wVq7dLXux7lqXN3YQVUv5iqRVGWyYz-nYMNKH9Gk8qFTDh3rvpan4X5UUB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwmByNIt4bmnvSnqnQkfm_udmlni2XPYXuGTBcY6KItg&oe=6A903B78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oBPtKkcyQkQ7kNvwEKSPIy&_nc_oc=Adqha2khIBrjIvevC91xSzN8AOhLkiIbBKSuQkuVgeLKY6qxINTzumWrP8bmOq8QPvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFelqphi1VpN9RmsLjmgv7p7HYJvMMHqit2PF2CsmfMDg&oe=6A90152F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmg0YccA2kEQ7kNvwHoucL3&_nc_oc=Adrs9XiCaIpqFezWLw_sljRov5fae0UZBFDtZs1-FOMRN2auOLpODGVcXGN1Fkv39tE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg7sb9V4BEGFbfs6FDEczhc5i6dh3KzDqteTgVCFK_4Q&oe=6A90213C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwMYarFS3-0Q7kNvwHF1s4C&_nc_oc=Adr-n6w6pNme1vv2esexE5j4s1H8JlBl5_LypSR-KK-bg-N7I55ynVnQfyb_8hHMoJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0A1mBFZCL5huTCHd7AK4jtl-ny79IUGi1HvEFCw36aA&oe=6A901F86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
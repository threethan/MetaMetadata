_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r61WH2ZWXw8Q7kNvwFfFLNr&_nc_oc=AdopRkvcmaG2k_YzQdkYHMQpiQbwySxDTdiSGjxvWQXnqgT15bk9TfOoRRX_db6U-4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F7qTlIK9TUP18T8OxGMRD6C3dgohXrPq-URwqCDSavQ&oe=69DE1E03"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEaK3J4VoHYQ7kNvwFBWGW6&_nc_oc=AdrddRq58HH7rzgb5ytHw5B6UV6uB78uS6rFEtpePPfUE6lwrDxpOq3HBoCL3dpsB90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RZiYGM8ZlSbzHBHJL9gVR_i_u0Ty1iN_4IFRXgfQfFw&oe=69DE40F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBI0YT8pn4UQ7kNvwEVmYwd&_nc_oc=Ado5SNBLZNAsVzaxVJWCJx-WtkDiQ3nzIFp1LQG9gAltxf32AVl9RLD71xidYFi4FfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O7ViupWQEqc5MVXEK-oTceRXHslw4PXweKgFnqHgmbQ&oe=69DE52EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIVpiKU1irsQ7kNvwEClkXH&_nc_oc=Adpmck73ZJgMfxQ29futckvFlxcZnhkto2RFim5Dnj3lB2d3OAQWIAIOJiazITRrvoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nq0GD4kYCAM14v5q14wC0t4p9eT1b_Y08Gu4v7pixsQ&oe=69DE26BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG4FIayQqUAQ7kNvwGHZeEv&_nc_oc=Adq-BKgivjLaWPllCM-ekrTlaLwxkZPxTyTzDdYVqpe-cWdfpQg5UlXHhIkhwRXmglU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jJDl7uauk2UniXOzVG2FX5lSEWLjK7GIe3SgQy_R6KA&oe=69DE2506"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
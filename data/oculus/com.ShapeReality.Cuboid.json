_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3IP9WHSE4AQ7kNvwEHFTei&_nc_oc=Adpl11mnQJ6PnFOaJSo9C6RxvSYdLTzssAdPjjV5KHFMhlx0mZ04IjKsyQjFgwff1Is&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbjdfZc0ssNhOh-5AJnIYW-BtMSbAZVzTzKevDjM3DPA&oe=6A525A43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QTdLr7U8_kQ7kNvwEbHuel&_nc_oc=AdrhPNFf61CyVpuX7mjvxWmVHUvJnp-GTa8Y0FvM1-xl60XUGuZ_QIBBnGGLIJ-oG3Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC77b_JFz-sVrPD2Y4Y0VQTm9Huk88wlIhKAO482xWJEA&oe=6A5244F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe0sIae79BIQ7kNvwFmLz8c&_nc_oc=AdoR_CocFhyY3iH8zvJjKpXVM7-Oz7qS7PYEfItLqO7qZFqe-8b81jeEY4g-s8-BfSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8wTX_mC1RdyIbkLbeos4F2J9FVn5s9HbX9bgyevi1fQ&oe=6A5256EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhlaOGc4UfMQ7kNvwEB2CuL&_nc_oc=AdqyzpSKIj1BTBg5INP4bzW9zLw-25GDQ2h0z_ci5FmAujTM0xnj3tasow3TExeyd0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIls348kjlESWiAFY2aI5KQGUKJZp9YXXFb1U4CS7b6Q&oe=6A5262FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPk-3C83uPEQ7kNvwEccuHJ&_nc_oc=Adqcohf-rqVteKwma1CReXZuaOMjqcuzk9jHQOtIwj60U0mJxZJKWkUMP8nsTBJ4QSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy1AEbUBwQ2_Vj05hXyII7Itp6BAsv2Rx-uzJCe-xWoQ&oe=6A526146"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
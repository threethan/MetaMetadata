_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K1w070DN3wQ7kNvwHEJriC&_nc_oc=AdoP5jQBwGxA9Z_BY4MeL9tYD_qqGHg6V5OG3tqfPM30bUpZfMXfoeWdRU6IyJbICAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpiaCH8RodQSXSsKQVSjrstr0NvvtB2zTwTexAe35w4Q&oe=6AC11843"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geQK0uYXIYUQ7kNvwGJQmGQ&_nc_oc=Ado9_uF5YLJczBPn0yKEIBePs4nBspOE1Vm62QRSw5uVim70sGPYEf5mbm2Gi9tqI-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiB6Q-frFD0fcqvOkTecyD3VW_NjKT39F93lTgA1LQFQ&oe=6AC102F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQyFFZ6zzLYQ7kNvwG7l_FZ&_nc_oc=AdrFSxSCWAMlxqtD_SNzwcYOmiEsvZUWqzXIT6RNzHxFLjAbJSTNxJd8ERysamRVdF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb0AV1R_pE61EkTgHQGGSOY1nFcw4Bd2wZ5cyWjj7wKQ&oe=6AC114EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZsOP2QjRx4Q7kNvwErqeOm&_nc_oc=Adr6N4cmHCoRz100HhnXescCE0iRaz_3ziMzNNhE9oGSSZ4uYoSxTpZy3PJJQFcsp6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_8dYIvnWsmrX3SVFsA7bErHevqP8eC29L4VQxZaGu0w&oe=6AC120FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRxvuxjJ824Q7kNvwFzRja_&_nc_oc=AdqKcc9gd6OMvn5Q1esPvp_n0b9cDvkwK3Kn3L_Lkm1VLYqAwcvxczLHMBIPh_DHlkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPdK_hMW7_qpjorCxOI8mKVMZcuA0kYnmu-6u5ddXhpw&oe=6AC11F46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
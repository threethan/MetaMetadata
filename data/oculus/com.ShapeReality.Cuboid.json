_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r3inbQOhMQQ7kNvwGIWH_C&_nc_oc=AdrDCVs3N7SAOk-fEBhPF3jLA28cnffcdqD_2RugkdZcC098ognNXT9e6RnpaLVVgSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRwPGRmuE-xNLk9vhE9Ju2X42MNYiHaxjLd61Zf1uKlA&oe=6AE9F6C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGl48zhWYu4Q7kNvwGB6pa8&_nc_oc=AdokPOezpNE8NBEwY0nLYL4oDfAz4E7qtRqOjLhxrgapSW_MXlC_HPaWJe0IQJtPpZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN0IF949VuATbHg7I8IK4_tYrMmKdn7rZlAO550YcvTQ&oe=6AE9E178"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GnGOvFD5SAQ7kNvwEtRmgF&_nc_oc=AdrQB3zYLX9EHqcJ40VUA5krL-xlerhKyO424Mg9E4iym22CEN2PtgopqiocRr2ZvIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSF8u61rwc2icjrwNzgF7O7qAmVCFHqjh8dITa8agWHA&oe=6AE9F36F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jHqTD8IeXkQ7kNvwHVio4i&_nc_oc=AdqCh3Qh62nEbqcA7LRFqmPReCPXkAV3f-idxS7fb6F4c9J1DCE2uIeXuO1SZ9mbRl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjv1o6quVuLIvjl8AQmpoGHzaJlj8aAxNEnvSPEVQsSQ&oe=6AE9FF7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKwKvFLDM5YQ7kNvwEDjcKm&_nc_oc=AdrbTuXxe-okJazMT3vMn5oDgqKmAKLa0BT4x-1Hgwr7aF6RuS1bku4snH6Hzu9HdPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxYxhRUqu6GUHkG6Uz0FdaU1C1czTviaFktLhpVBOhNg&oe=6AE9FDC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
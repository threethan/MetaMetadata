_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQA2d6Jt_R4Q7kNvwEXcgTw&_nc_oc=AdqAM0ljr7VU9ol_u41wXDxWHK_AKU869NKv00Qo-XkJtPxf3FbVeUYrccp-h_FDeC0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6nJIDMJhNqZsHpXkexzDNtahWUZ18cT-BvvGqArgjGA&oe=6A4136C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6irzjja8nZQQ7kNvwHnukEr&_nc_oc=AdpmzfWE7fH6bmXymhMAo4x-bxmbDkEb9jp6F4M1CkMBxcnkJpBPIyR4sKZ1PwzWIQc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MFkCiXrmGxAUbNwz2PFvZtpXwAyLQmU4B_zlX-nBJrQ&oe=6A412178"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02BiWqNNn4MQ7kNvwFRlpPA&_nc_oc=AdpyZmYTilJNCmBjdIQIM-tMneuoxitbLzk5fSySTE8SgC7GBvXnIbENTb9dq1oa0uQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u_dvR-7FWkHd98hTvkzy6AODyu4xOojpA2tkdX1b-ZA&oe=6A41336F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKXEJVur0TkQ7kNvwFSB5lx&_nc_oc=AdpY0kzXtI_s8SkX_9tgyCr3yC4xMpcp6JXoE4Z8HujaAtGw_6FV2RxFBxi247W7Cjw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kzLz0lnPsQBGId5G3ceztZsb4zu2ZE6DsJxkgj4wfmw&oe=6A413F7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wEubcry9YUQ7kNvwFPWYCB&_nc_oc=AdrLscQOEJtoDGQD17Tu6YAsnJqAOcQbWkmjNnczgqvRdJcgUs_idsP97ZHgla0uczI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZaDMn7VQJ9l0ZHcmqrUc3E-6nrWWCVkc3ShK5ZMJoMA&oe=6A413DC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
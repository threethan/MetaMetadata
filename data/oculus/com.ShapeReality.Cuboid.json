_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z21mAaqQ-I8Q7kNvwG4aauk&_nc_oc=AdoHo183R0sSFB5QbQLf1g7TVECQzqJfVPxf8GAmux3jEFIZIvNEsCkhu5eUZj9FbsY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMoZYHB6CdauySCNECV6uaiJwCYJqIxbvx7k_cL0KXgw&oe=6A58F1C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEhpkO9klSAQ7kNvwENl9yA&_nc_oc=Adrm73hc5oS6UeSul3NJLTc4Jy0GtE2dhSjgiGXFEfFhywvUJbS8guJpHFdi4N7dyWA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhOAOLDq6BqMSnZ8Nr9B_Y7f5BdL80oAdWqEa2PbkrCg&oe=6A58DC78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMmYLMAKXIoQ7kNvwHKf7sa&_nc_oc=AdpnNp20D1JF15JbZzLX0ooQk6_y-zMQ_1riONvE8Xch3C2uII4YT9tXXfHvI4uowfI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9XAqKWcQkOUedfVfARzrFX2Zu4wb6hiLzJfmKbaqMqw&oe=6A58EE6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI3FYWva_BoQ7kNvwFHbFu7&_nc_oc=AdqUpvzfAYLNNVT7muH5oS3Y_7AdPir1K8nt9rHInjAii6gpN390cRGG9tZYIAWKxN8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDneeEXI9Djdi3WJPGIbdTE-eH3J2-H0CVtHYDUlZNAw&oe=6A58C23C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w0Gd1nx0XYQ7kNvwEadNxu&_nc_oc=AdoIihsfQFsMxGq5z7j1tDlkZsQgOq3k5rMY0-1S_ewsYZ-lOF16N3aMxZLHI9hqwpM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpWJN6M-lYK77HP4nqLYHhekWc-_uaIGhvBGFZKRfcQw&oe=6A58F8C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
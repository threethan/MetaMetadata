_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35sKaEg2Z3EQ7kNvwH28MSI&_nc_oc=AdrYAu4UaxZcD8PO-Kz71m0Za0P3dRZw_N51pwF0mHcE8zjs_LNVQrb48eFzOj5GK4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p6OqcJq7UBUuiTYucVmWs0ujdOucU2RhXb0-OrP8yFA&oe=6A0B2943"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs__E-EV-zsQ7kNvwH0pOIV&_nc_oc=AdrLNWtd-wkDZwmeIdXhiaKYzrsvNIzVAOLuT9ZShKSIC5tMlNkOX2GwOWwKM1nHDl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nOQkHmRzTHQUZZqnbaRjsdawZavFSj1U8i4vlFr74Hw&oe=6A0B13F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R59kI7wtfvcQ7kNvwGE-Als&_nc_oc=AdqIg0_CBdFY7XyIPNtzUsoO9VN4e-sC280ua-0f0vg9inuMs1Byod09q8kH-2zlAFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fiml2w8RjPeCWEEb06yTKY_2JqSo21HjnPbFXQXmIFw&oe=6A0B25EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amI4DK_u_WIQ7kNvwH-hrtH&_nc_oc=AdorQrEuvsGWuqTS97gM9aorR9ZEfPYcDzKBjPWu1XmNBYT3-ls3sAsnA7GXkCKRejo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d1XyLS_Tx0c3vvNfRtv7Z_1eO8uDdk7Mve_1AbafePA&oe=6A0B31FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wIpt7e2lQQQ7kNvwGtPouE&_nc_oc=Adq0CQN4_L31Tp_6Zbf2DqsgWOyxaXc52FRS6jTyl_UUrhczZb57Rp2NjiUzTUSouRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ky_X9f8mQW310B2sbTfKvogDeUT8BYnsSSNTZ9o3q0Q&oe=6A0B3046"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNvoJy1_Ef0Q7kNvwElDGe0&_nc_oc=AdoFNAO7yyDWC9OGta7xGeoDv0eKy1flDWZCfLU78XDNiY-6pg9mEFReUAN8ZF711CA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkk4StEoADRpD__tyUbi20aytpQX-gd-EKpOHhm-8U7w&oe=6A75F2C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWnIOvEt5o4Q7kNvwHs7O_W&_nc_oc=AdoRO8djDc3uhJNCRaNbciMaTb8x4TXB1RM32RJgyy0oty8Vw172sUf6L2Yo3CyuESY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbQx9nZebBVqmrZovHQGQYMVfS_aoi8UnMLc_ob2c1bg&oe=6A75DD78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5L0l1KW6UYQ7kNvwGu3qRF&_nc_oc=AdpnCwBoTLs1HXC4BG2dzMRRuppewIpNGCZKlXBGrMxRMAwEOfKJf4hE1glaFlOWyhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC_fd3L508y58s2X0dE9ZfsMZAY0TjZE3Cu5p9HRxPBw&oe=6A75EF6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jozj-CsBnFAQ7kNvwEsuOAb&_nc_oc=AdrvzVRYPPQsYJ26zhSn4rCLw39YgY5vqeie6010uj8VieE7xDfrIOehlPPOuLfkyeA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRmOAgFff70uebZuOxzq5xSxCDzFDKPD5ArP0X_3HVzQ&oe=6A75FB7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WMub6dKRPIQ7kNvwGJkuZu&_nc_oc=Adqx0SV6UQdNekIVjrSvLPDkB1mU8nX3YBMQO-OlhW-LqCUjatFva4jE3NTo675BdG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo6e9Lc0-3RZbrtezYtWplY4y9bmr7x4MTowm_UNB_cA&oe=6A75F9C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
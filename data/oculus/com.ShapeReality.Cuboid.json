_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xQBBPG7xysQ7kNvwEXXt8T&_nc_oc=AdqwaA_alZ9Owkar9614HjsMAnZ_VMP0E0RheXB4ljfazJcdDNxF2Ivn6sO8o-cGHUI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6IFaBzSSpSBCjlqyClysL3OondDKjqVaAfnI18Bp9gg&oe=69CFD5C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KKjlqL9aZ4Q7kNvwFpCaXO&_nc_oc=AdqWYB9dn6xHhZw3_tgYYORLREcjBZDLOKxjwVH1_Hm5lWidcwJJLHz_DjNB343n-WA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwz2BYcgN6cWSYwoEBChPLrzwoH6qYAyRhNEEcUInSnlQ&oe=69CFC078"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1dQMybAt3gQ7kNvwExk3vT&_nc_oc=AdoGUrMTPk2NRhYUif1vMK8xnWDi18u5uOCIaMF9CjNiu9Zx8zC-hGYO5yklF4DAQFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5ns4CBbwaeBYUZmryj861qYAZkucJCZGxCWy39Hs3LQ&oe=69CFD26F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BJfj2hLFP4Q7kNvwGQoQgB&_nc_oc=AdqALdd5j8-mfvkGgcZZvLJrMAoZHltNQAL5TAbFPUINdAuXaCcjJKc0zbnCqgdUYNM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxexkBVwFviOIeM9cy83aq7bo-gMvWjeIbPlHxSjNLNVw&oe=69CFA63C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMRskGiXqAsQ7kNvwFLAALF&_nc_oc=AdoTJXl37V2VKrXlJ2-18ncgca4KXWxmz018Al2dfSOFzNgSljJ7-4NE0nrElRPZWSk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVxxYv54LtVv4MCK7kvGRSSl-_LpZD-X9i9H3ckhljhg&oe=69CFA486"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
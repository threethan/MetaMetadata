_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w1t1Y4arH8Q7kNvwEEEJZi&_nc_oc=AdqZDZyQwPPSq9h_va2l7Oh-VkdIO0o89ltGXn2801aIG7Ae6F9I_2nVRmv3HolLtuU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTzdM6IXheAGDte6TEyy2GgslKTvH8ZpCee54AAMSUJA&oe=6A53ABC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QTdLr7U8_kQ7kNvwFdOKLe&_nc_oc=Adph2biTuQUpQWS334cHdwxIJ-wKElsLTAqvGk4MGsQmJxr8vWIZi305MIh_rtLQfP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNe4QwcACbljF_92q9YP12kjOSN-dSBixUEzoQmBGZlQ&oe=6A539678"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMgSf3QbP_4Q7kNvwGlOok4&_nc_oc=AdpkE4QGKeuintTC9ucv65DwaW0K9vANa9FuOWBE4Q83WARdaLx4fSlghvqRKsZSSwc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_cSRjT99t7OVeGe1_0LzP4xx6FQC4oSyXY4lbngAQ4w&oe=6A53A86F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98oAyuhM_lYQ7kNvwHlxUL0&_nc_oc=AdpLDAqKRYbFCKgXhrnorQNGIyAdFQtbBEC0INEYXRtJ72r0qWZJIH3exZASh3UiPa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAagpbbGH96luCqf1gqQY5JQwJ-hSdocBT5__qHYvkhJQ&oe=6A537C3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPk-3C83uPEQ7kNvwH4Hi0c&_nc_oc=AdrzgWamyGjKQqH83GLNF1ERIkgpFC9x_jCBSQJJG6TZNX5Y7JO-I47wrM8feaWnBac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtDyfmAzKdbnTmzZuk2lU0SPUKJu8nB23qlT1si7I1PQ&oe=6A53B2C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
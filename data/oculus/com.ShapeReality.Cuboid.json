_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjY21gO7GUsQ7kNvwFfwZxC&_nc_oc=Adpv1kSrft59B0JKXqwpDHOD-SGkyMv7SYgLWhfpD-W_QB49p9dC-elf_bQYdXzzVbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnZwO10J26BIF2zgpu8m5OWlxfy9_D94Q9KUkVLNChkg&oe=6A8C2403"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IXfY2YOjVIQ7kNvwG8nSpg&_nc_oc=AdqrccLhTqH91aBcs734eficMcCHXqtn4DMPNuHiUczTnnTWVdOPm0UjWcyfTOr3vsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFNArmlx2iuE5DkPJ-nU-5eZr4_bF11bOJGcP8DcoH0g&oe=6A8C46F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzuxUltK3aoQ7kNvwGYRBDD&_nc_oc=AdoBeZ5shX6MokA4lBX2l7SXq6jVCUzkEzZpqzUJIRt2Id1th32GtLYhyEC0g5fyTE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGExxCkpIYDHLo6iYMjt1e6TMK_3qZbk_nDLe3czrPxSA&oe=6A8C20AF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpZUiZJvxXgQ7kNvwHxRnHG&_nc_oc=AdpqpgiMTl0cvaiae3Yx-DAd2uFhI2wY5FJzhjNRRn5V60cddAnfvVGgo6uHNe02clg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0x4mXcTM-9gA15isAaMbAy8H5x-wzgJz_KwPWJDU5_w&oe=6A8C2CBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAUqbss6iTsQ7kNvwEYvSY3&_nc_oc=AdrZXREi8Xd1xwEW5IckkPhOtq6ImpI7Y4hGPsxbneVbJb9T56wDU_kxfo8297kqbu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_AA3kNBoF-Ie7SL0xQQhLbXKCAekw445hnBJ3gVIkaA&oe=6A8C2B06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
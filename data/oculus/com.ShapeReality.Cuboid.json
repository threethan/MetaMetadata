ng", "id": "1297649127508851", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IXfY2YOjVIQ7kNvwGBq9ZV&_nc_oc=AdpAfB0A5kDhI6Y_fpA7OTs3F8mrhaICS5431Qdb-nGu5M_CDZLO39sNYfpxgQII1nI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0y65yIuEH_f90i1NXDp7F5tm1nJn0TKTh4UzDuJ4WzQ&oe=6A8EE9F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oBPtKkcyQkQ7kNvwF9vHd2&_nc_oc=Adrz9auEtG_xUoeN3j1fy--Q5ZAZNtvpAO4Rban3WD4uER5_aH9BAqwL3Y4RJ6Bu0io&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3NDADDz_Meef36dm_WwbTLYwX3UQnbSqMizPAk0E3zg&oe=6A8EC3AF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tmg0YccA2kEQ7kNvwF5rZO-&_nc_oc=AdohKWm1KEW_LuY4XZGMrmV_cTfMTPHa3KFRo6X881VLK4qCe1Kbo_tuuM0ftssYTfg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOaroMQyNe7MMt9QDphuEQha1xUbQ13s73v_LKuN3h2g&oe=6A8ECFBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwMYarFS3-0Q7kNvwGaijGQ&_nc_oc=Adq1U5TyPyMuwaECAkgSUJgMNevJGWBN-z5kGnM-cCxMytL1jknJxhSsZhnJUIe7unk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGytP-i8SaKOwn-Qdu95Kp93zt_w6i641rdut1nVUew5w&oe=6A8ECE06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
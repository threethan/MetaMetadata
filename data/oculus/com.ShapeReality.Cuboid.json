_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYYoyEnzlhwQ7kNvwFlvxb3&_nc_oc=Adox3oRvp4l2RqHw_kv_QMVe4_uE_hVudGaPWJBZ5b477IpltE2ivWyS3KrApwLlAKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35Rs5WM6n1oHrYiiOLBAhieum_5Jb_qzt4DQhFhFJI6A&oe=69EA33C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j0HqphX8NwQ7kNvwG8GDBG&_nc_oc=AdrhygyU6B2Zrd5Z84wS58bNWnBpiCYWBkT-N4Gjwpu6aLt3nemxKTi8YVLpzkuB2PM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GhlQR7PYb634_U99AvcllIUd2RmFbZVjzOp7FcMDnpg&oe=69EA1E78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt3lq1qeEvwQ7kNvwGO51Y5&_nc_oc=AdpBQXLM0mH5Ln5vLiLfTWyY7-71ZDv62FYWye1NROmIy_g_IRH4uTZNz5xQ12dlAIg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F0iFBCGZS_A4hWoywfcgeTYZdxI1o4_V3WWKrExyDWA&oe=69EA306F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqK4YxtszXcQ7kNvwGQJAdM&_nc_oc=AdoNCpqFDQBcjewgeeM-prRM2-7KoRkSRgMVvEIKCaA8oYHiBkLGWEfSWC6zVr5zLkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E4kscrFm__RXPtwLpHZrt94rFy6e2lu7DFGnB0WUvAA&oe=69EA043C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqne9aXXYt8Q7kNvwGotNXb&_nc_oc=AdpqfPqNftLj3Y0MG-Pnxx32UEdA7TLOqycsUIGSoShydK1YlBeB5h7Lpq6NZyaNawo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z_n4YKAIPLiCfater9Ziy-BnFLp_pteg30Tg1uugeFQ&oe=69EA3AC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
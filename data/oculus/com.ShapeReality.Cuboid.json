_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgItSyC0zWAQ7kNvwHx833G&_nc_oc=Adqq5MLk7SUWIY6s1DlPdpDxVUsGH6f1HFE60wToF5rAqER14PAKUhdYY_jqHHj3jQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO30Y0WBlnYGDNQekWUVTsXWOq2mHEFaSGeVYr2cHUqQ&oe=6A60A283"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVEFXJlYW8kQ7kNvwHntwQ0&_nc_oc=AdoA3B22qSxfONljjerBgTke3_0Vn9XEChEv-7lMP8d-hFSI_O1_XkfOjRZPy02KzZs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARFSo2nRELafqoDhU3jZQDuHYowQl8pKljU7nWM653BA&oe=6A60C578"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7f5FUEUZOQQ7kNvwESwmzR&_nc_oc=AdrymQh-Sy94RYkMw8cUENWSdA6zlZFeywlEPGxUxHvywCeGYKS-UNnQCr9ruImIgwg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2bq5UmeCUn5HF9sKNS7RP9VIb8uAzOjdDQjsJGJ4aZQ&oe=6A60D76F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5IgCszad0UQ7kNvwHa8tLF&_nc_oc=Adprk4H5usz8pdMEo0wIRZlCJ0SaSXDwI7eTdyb8ewbQBguicmEJi-Ye992xuiq9zXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc3Wjcoz9JRYpIr89VQ-IAF8iTcy0u0FZ3FJifgzO7YQ&oe=6A60AB3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNljJOI-lFoQ7kNvwHshf4t&_nc_oc=AdqhINFcJW6QV62cVA7TXLIsLrD8CXvIs9MuK7tte1VgM0W3oZRjjVMWHfVT8OpOtGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwQj30h5HxZLpK1BqD59QQO82Hc2zfJUxq-LAuaDIyFg&oe=6A60A986"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52SuhVpEBD0Q7kNvwHgCB3I&_nc_oc=AdqZk9-C37bWBld5tPohSFgZNpD1YQcJNacdu157tLnN-2ywKLY_IsYNylFkOniBBLQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WI0Wu5sX9znyjnK0P--mBK-DdifFHBiGhMuqKbjcIxg&oe=69F61143"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8H67zkTJ-sQ7kNvwFV85d4&_nc_oc=Adqc6S0kTfQ-Y7g4edweXNPS2x8ytXPiRI2eAQZMINobjw8H39hWGaXA8A1qqJgXxAo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jnub2UgNSEKaXw5r94GdyIWZHKlrYQHVCsAMlt4H8XA&oe=69F5FBF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnFSJqH-aYgQ7kNvwFV0GTS&_nc_oc=AdquIv9vJzkCuRLJ0oXJNo8AAUF5Q2-_Pcu-0UzYTA9vo8bx-nmvOc_3vC7UjDyq8X4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GhNziKUJJjg30jf524lJwhHIiR-Tn1yahHOByDqzdjA&oe=69F60DEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eSNK6p_Ml4Q7kNvwH1kNLA&_nc_oc=AdrNZRoM1_zUqcdb5x4rTLWSfkFGJ7Gl9RIpdwK0bKkKXcB72Iu5gHr4NCfOuExKFco&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qLGzP6GC-C07LKYgvkWx8yNQqgZ8y1f4BdQ5ThLhisA&oe=69F619FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuexKjtHrJEQ7kNvwEkQ2if&_nc_oc=Adq9d45MFfhdUPAfYezRmD2ZmV58AKWXQ8uhOb2c0wbablZyCwiu74WM3x3hMs_08O4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ih0MLKJgGt30g7LVGU60VxIOzRgdEa7xgmeljZNPDTg&oe=69F61846"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEY4xDZqzL8Q7kNvwF9xGql&_nc_oc=AdqYi2YC1jeE8AI4KyC6-l86Q7WSxgjCWHzcTiH7iB045isbqqsZFGjcnwvXd9342EY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2YbciDjojudhEZDkpfcQb-iTBc8e-QlUYga0XTBgBxw&oe=69D0EF03"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KKjlqL9aZ4Q7kNvwHO6R12&_nc_oc=AdocQzLQQG874bZYnu9EU3hOOgXTpmz2OXFridxgSBn0A-eHHdo2n4L_1HqEeZl2M6E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6h7oqDE3fuQK6ts6k9Xx8Gn8k6eZkzHljFrhq29y9QA&oe=69D111F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pl1hhIHxUwQ7kNvwHZdwCw&_nc_oc=Adq47tHHfBhmfO9flePknUZuUeI6zGA9eb0_iwHphzyXg26rGCHYCmusDHjv6Cbfe1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyesDUROTiB9ma5R1waqocldV59mcZ4FR_3MvBcmXZXGg&oe=69D123EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dYlATz4sk8Q7kNvwHOjAFd&_nc_oc=AdrcGFQG3ebTBurNtwy0somvxoZvBghV7W3tv2u9xpTGaNlVfSMW0beIO7O9yY60BkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzc7LJgb2Sbka6CtpUPgERP1aSrVPbZ7ujzRMIShqwb2w&oe=69D0F7BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMRskGiXqAsQ7kNvwHRLa3k&_nc_oc=AdrW87DPiPqb_-Vo4TIBAQiX8hNTYkJalLMXTzOesMzJ91-d-EQBTf7ErJQBlJbnKuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6uxscPJH38yO_g68jqujL_DPEcj0TKzqT5izypdphhw&oe=69D0F606"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSZHH0c236sQ7kNvwFo2f_M&_nc_oc=AdqclMlMrAR9u8FJEtG9AdwHojHC0IGhO6lT5D7SI-Qz_i8UHexaoWZAEdunEmjjt6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9inH5S45edQ0a8cL1wYHSGA6EINyFhYm-fMGoTCQ8Rw&oe=6A9C2E43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv9KXt5W404Q7kNvwHrleux&_nc_oc=AdqU2QxjImfLYi_tNVvq7ZXsFJxSzEICPq7CjyAARbsZ_kQKztJADi-4JuOfA8QZMCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ-exM36RMAdIAkAmJw9ivONBQ-D38FFV26Jq1jGrjSQ&oe=6A9C18F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LJ3YtsqNMMQ7kNvwH8opDO&_nc_oc=AdrTSxOI8CckmkOBUg7_gKbJYGRlarlJO6wh5_I9xgzLcPNoziXf_pKD3s8jDK4dsEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw6lDPIB1aBXQEKiIeHM-B4a4U4Qsdf2CbPh3V_WLk_w&oe=6A9C2AEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7v7yZztW3UQ7kNvwFCiiJB&_nc_oc=Adq9y8w6ZAvpmIwtRhhBuDWSi44IqkGzFUI0UwIMXImtM2b8b2ILqokDBjPgrSnnqHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsCtiH2x2654MSiSHxHvQfxzP3mRBNsi2eJNUdQXa-Yg&oe=6A9C36FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUlCXtuw-IwQ7kNvwF8Blzk&_nc_oc=AdpY7YQmGGPTYJmmDjE8t1IVaxnpusu8pQDFUgcyVzvbCpxS14-VxMNrGuRVlpxrp9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWU6KDBQZI8K_1qeiMx95jar-95FsdAAeJIhRbab2EIA&oe=6A9C3546"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
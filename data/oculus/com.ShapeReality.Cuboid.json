_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xNiQsc5_esQ7kNvwHuJVC1&_nc_oc=Adqjh7y40f5dB7er6zkDxR74b56RxSvrg0ly2WcAgxqh05GODYG5GRyz53Z6KWh2SYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JsNCHwFYy1lxqDbwg0ift06_gBJlXnoI_Drv-nDrEEQ&oe=6A2EC1C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NSlV0ENox4Q7kNvwE408W5&_nc_oc=AdoyQ5rwIwdBNlRf1SUwgJ78ZdkoCSFAJfc8lwramJUygmuCyxjiONud19uCQwouu5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-nxx4Di4cdN3w_hm7OA5CbIa8a1CPKvj5tYc_qr0Z3A&oe=6A2EAC78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTA6DORKJfUQ7kNvwGvPE8W&_nc_oc=Adr8iIRy6e3-hmGMdE0qNPcOPPj0u9tpB_y1Ws5V4O_xkHMjja9nwHzwxRVRDBf78Mg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PgpGeh2jYeLQkqrkSF6YD5aCE2W_OO2ZyXQZAvV7T4A&oe=6A2EBE6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8YTRSeIypkQ7kNvwEsmvZg&_nc_oc=AdqFFWmkcm4hlbQcchrV7z9zZFnL1PBkt1Zb_VENDwJFFNz-Dh4LMGRRWsxgDwmskV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OHXs0he-Tqm9WNNW_TlJWBS9k26ASebLltrBKxI2EOA&oe=6A2ECA7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svxAZbzrvNUQ7kNvwHjP0hZ&_nc_oc=AdrktDV8B5tiRB0LsfnNA1hBrxVYs_y7rnF5gzUdSaktQ-b4Ev2YqwCTr71_mDtoMIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eZm-KLnapONwxwF6lKmQZSfZyj11RwK4KOuiG4rarLw&oe=6A2EC8C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
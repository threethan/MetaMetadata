DHzQiD-yLzSFkmhTyNSoV5WVGWTfvjOQ9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpevL55w4NHcZv1OyqayCkxEduwPmZRcYTgS_qmXqUhw&oe=69A6BF03"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hCcRKRdR30Q7kNvwGiapS0&_nc_oc=AdmNYv50d4OOUX6Q2DyI3tWZNzPwvQR17Tu7GP5JTcQNyYUtg54zHZyTuLo0hdACrJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9mN_9sT80-FRpcqmXQIIcPS-VJs_HViOIYdiruR1Mfw&oe=69A6E1F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mro_-auj_UYQ7kNvwFEqvvN&_nc_oc=AdkbYX7FQt2NAh4FzF2itSk22FI_iMUzqKsdnyf8DxeYjS6kweGZabZXKkjKLjYvNks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuKbDehuD7-V7R61q8le2pkCvCtLzjPV_7J8QcsdIXHUg&oe=69A6BBAF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMIlVl6Y8oUQ7kNvwHk-d4X&_nc_oc=Adng6sKX0OUNo7SN3b1C99fMoVSvHfJN9bQFkZpFp14dVp7KJw99XuPb2YMmqhW7-18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvpKnna1lZAnkV8UoLCAr_ArqlB2IShmqGFBgnY8uafpA&oe=69A6C7BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XarEVqU37cwQ7kNvwF7WQr3&_nc_oc=Adm5Dd8BuxX_euwzG3Zw71sJJnKp_d1AmzwAjxLEZzq9bqiZ3jtiH1qK75sojZOiuzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft13wsTYk7YEPJ18DuRUUzJTZGgu4taPX0SRjxguDfApg&oe=69A6C606"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
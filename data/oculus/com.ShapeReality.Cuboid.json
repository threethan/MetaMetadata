_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HG21BKaXazwQ7kNvwGMCp9a&_nc_oc=Ado4L3wGiM-Np7Tn1W3dJ--fUbRSac6YTAPfzmPi2-96ToqD6Rk2347ItBBNHWEc6Qg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRodprCR7gYZyCc0xzJaqjBkANf6NB5_fkJVd-TyS1TLw&oe=6AF9C8C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-46cQZ4ms4Q7kNvwEg3fCq&_nc_oc=AdrBRRUkie960pYRAWr6vjomt6n8TpdYSd2wCoSk2X5xBxmBgh1qi2wowqmAVo6sAlc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Kgxcx33bUei8IxvVTMg-4CgR-OMMcv4fUtZsBGF2RA&oe=6AF9EBB8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv3GDcRYFPYQ7kNvwE22vZy&_nc_oc=AdoWG8ZdnInh-42dT6Le1lquNOkeAOZzQsqP4pplO5bL-5rCquP9iPPOgjeaLGwNMSM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrc8oP5WNwz-NOWdNDjQ_1l1oY2oOamc9ereYQyiiR8A&oe=6AF9C56F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2MWpOwzhIEQ7kNvwHhAkHA&_nc_oc=AdoH-qkXfY5XAkTtKGpAbNnq-gPpbgx6AvUlLJy9MPSWuM0ROCTISRVl2xqsblZ3aOA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYtOcApK-TDhg7STwAX4qou9RKgI8t0f0RNUzxeHX5CQ&oe=6AF9D17C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR6g9Ycyne4Q7kNvwHA5P6h&_nc_oc=AdrYB2pOJ9NzD5qnS0IGY8lJbbWBaxOnKZNnHFotRgTDi771i4yV-6nH00R_7OtfVJU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaMTFRwtXudO-felw6rvJC1SzGvF46aLo6p_hlAh8a5A&oe=6AF9CFC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
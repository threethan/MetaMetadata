_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXKd2OBbyt8Q7kNvwH2YsSO&_nc_oc=Adp8I5M3XgIcBSmeRycuUWaZ7rS-n_ekRQ0Lf-f0x03vsd90B5nLi5Knhc7fNhySFlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVt_s4eqZHHk1HClhy2j5Ik-7cLbVjU3kg6iSk1F2rgQ&oe=6ADF6AC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHBRSJllzHEQ7kNvwEzIVOQ&_nc_oc=Ado_eSRHBcnoVGqgh5V1tvNLO5doqPZq5H6_eim6NZa9aUDus8dM9eZrKY6R8iJwCug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEQ550L0DclNHyzkAu8PGDD4c9OFbtUMKc_w5d5ZtjgA&oe=6ADF5578"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRQEVjxAXukQ7kNvwGsWlIZ&_nc_oc=Adrj5Epam3QNLgrsVX3M6XtPCPtfxqo3Mt8vQZGmh8-DxI_UxewBeEoVji94WaSVJBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKaitVVUJ6tz3fvXBKGmhb3K246b6V7ixi-1p8epkKTA&oe=6ADF676F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDeP4MMnkUUQ7kNvwHVi_AG&_nc_oc=Adp0bxxmeraVqG6IesQuxzR2MOllQ8wFX-79RI8DRIPWvtFnZXguoqC2JsbgU2-1lbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE8fKAWWSHrOkoXwvlmOoQAFnpW7D5Is22jx66O__BnA&oe=6ADF737C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRiCreHIxV0Q7kNvwGbjRdk&_nc_oc=AdpmDF_YrBZ9YMs_2qUQYbtttg71V9i0Dh8w7ysxQMeFE6TNQQ8mjmuvHNgKKa_r1r4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8lXOoAYIO5mKfOa6KhzNUH5mZTXkYmvL1ucopxrKJmA&oe=6ADF71C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
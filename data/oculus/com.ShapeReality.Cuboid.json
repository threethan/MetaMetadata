_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnD8xYeQNyYQ7kNvwEdqDmQ&_nc_oc=AdrZv2IxV2v2SOZoB5j58LE7yXsMYyxuQloBIhDdvn98Jpt5AjcZAJj_fpcbm1XIfqw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiB0DIU8KxQQTGJln0e4hXorm_sJtb206CYqUKrubjvg&oe=6A940D03"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckseT3vNbUoQ7kNvwEBbQTw&_nc_oc=Ado2BZ9aOpTarYbn0F3QjCvJSgeWQJUGdNymJ1iJO3yYKLy_37AywfjSL1fU_dTE-fw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhH9bczFJXCl8PWd5ji2FihaDkt9aoYvonZf111r8qxQ&oe=6A942FF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulgbwt5UPRcQ7kNvwGZDuVx&_nc_oc=Adpg2JzJIBm_BsnXYAlKib7YPeLZ0Vq9pUhQKgt2jx0EO2YoenOO0JI3VOpIVmGMfbA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkD9om_OieL6UvEJy1q_vk6Ry1zwg9eUsgZnmUeYSx1A&oe=6A9409AF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp8qTlLV5XsQ7kNvwGYj4Z5&_nc_oc=Adrae3UEZISgr2pIV2UjxJdS_UvNfX8v4spClOm43MDrp7rfaaf2zTit8HSy0_L9P3U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuqnOoXKg0GjDYBo9uo_YsTuPlG7XZ1jXK9cf8a6R7UQ&oe=6A9415BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAClK94p7ngQ7kNvwG75ak1&_nc_oc=AdqV0gQqZtCetgyAy7siYIIqG98JwvjQpD6gJlyzDnrQm6lay7cP31W4AQxI7FW-orI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwpSKPC_bu_TNlp0pn64b-bY4RUQJV0xBSrdL2Cn1oBw&oe=6A941406"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCYUBbcRmHIQ7kNvwG3uchw&_nc_oc=AdpVfljADcY6X4_-V-MUkhHJZRaB4RYqzCoPBsleNx8kheO9t-MJmdglwtdbRlXFIlg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgXYpbRlz2RzGS1wGo9wv8hRAGky4ucQBGeOmrYjfmdQ&oe=6A804683"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kas8SHlaoSEQ7kNvwHvOzSw&_nc_oc=Adr9f78FE9LbrDtL0Xi4eYz4QR0pxmbQMQeDUyf7tsS9Nb9jPHp7-zPTtDFPXKYCLvw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBnwUHFsKvwUtHHvr-y9GniPt6mj801P_MzmDto-RYiw&oe=6A806978"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcG4B_hOkmIQ7kNvwETZteG&_nc_oc=Adpcw5wePmlUthLnIFkwdSRLKRJDhD26tV3-NZ2bkddBkaHQuHjDNSxjZRj-xkJPyuY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtQ6ynCQQfdRTRoZ6K8epxpmAjxUB0fumpWlZV3PzppQ&oe=6A80432F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ja8ECnvTO0Q7kNvwFOfZSc&_nc_oc=Adqjva5KFG2KuiTAPmLyRyFJznlgOshf0GRQBC8_5MecN5e3BlUTotx6dBDEMJ-EBxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6PHl-sx89yH7N5o0qVDTY5lAmVauKQUxnkz1dkKe74Q&oe=6A804F3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oemBLlyT23kQ7kNvwFYwmzp&_nc_oc=AdrEYP2f7LVNr8KWdSdLhmEG3zYpYqQ2blaansjThGWCJP15U_svPErzMFGVvg0AzFc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlyHz2S1hjlIxpXnY4GEM4Z1X0CWvzf0RbXbrIT0r60g&oe=6A804D86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
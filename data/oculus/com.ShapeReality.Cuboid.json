_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEY4xDZqzL8Q7kNvwGF__VZ&_nc_oc=Adr4eb9iwi0VRNYEWDVS9aHZ7hezLCwgGE0vp-jmW3JKYPcBNPBZLKVqM4vFbqKZHxQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YUHomFRDGnAgtSSFeJ6j7woGQ1D-queXKBoRQz3GvVw&oe=69D39203"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7in_SeCYFYMQ7kNvwFO9vB9&_nc_oc=AdoyfYLDmBxcrmm372wot7G_dkILVjW3BFwe_J08hTFAbA3lVkF9N8s9lCluQ_NKVhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17LiA7wqTFtMvJHpjz2aYaeYT6e9ougQJOsxjkt7NrhA&oe=69D3B4F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pl1hhIHxUwQ7kNvwEpnY7R&_nc_oc=AdrRh1ilnyra2-T9hC7KE-3RWDo9tbs0NHlapxt46bfLVC5qBlPh0EvDLYbt1we8nsw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vUCa9wDiIGF0ZQGVvyMSZ1cJEmi6-_knlNor3OlkTtw&oe=69D3C6EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dYlATz4sk8Q7kNvwGt7q22&_nc_oc=Ado93g_a6hEyd7u3dj77mDCmXfKKEQgO7VctoYsfEBNRZ2YjqmzWsphclrdqOxZDVoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rY4F3QtVhO6rZQqPtjqmGyyzOWiQgS0SSgabdUAQwLA&oe=69D39ABC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShRTaAn9BJkQ7kNvwEhiqEF&_nc_oc=AdrRcPjmFBBMg9Zz0-9Y4aDr3_fHkcE5bI2Rluf_YrD8JF3052vL-LE-Mm10ZbZkNIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IQl7Ejo63HwBvTuBxoz6ZmHzhNiCZ_Ym8wwUBGQNccw&oe=69D39906"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
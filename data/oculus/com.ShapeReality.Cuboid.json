_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQA2d6Jt_R4Q7kNvwF5s477&_nc_oc=AdqjgG-sjfM2eI-deWmlygzI0RmlzQp12WIEDkJBm6KMu-9HF1tGseez8F9_Jcuhiec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IuVQnBBiiJBfJn_-v3Ou2tt8xHHiHuaU40g0z970WrQ&oe=6A3FE543"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocinRKURsjgQ7kNvwGXvbck&_nc_oc=AdoQ2pEbS9zhfqe41-c2fQnzjzDps2bpx1F7nAdXaYR0svUdCxu-95sGm2Ger1Gx5i4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Dd4AzSUyAFtfd4LlTLbCUPBSM8QR1csYTeY8lPewKw&oe=6A3FCFF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02BiWqNNn4MQ7kNvwGHUByf&_nc_oc=AdqYbKKPGdcA8wR_oJZyX478XW7hfgdK0ZokrhC_OegCpNuyWEh780D5mbgDgEUP_W8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ykib7430Pg9B6emwfHdUBl9TRfTw9mYq29RvEGty-sA&oe=6A3FE1EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKXEJVur0TkQ7kNvwEt4tqF&_nc_oc=Adr-q3yoW2RlN2rqVLDpUiadFZQASeeZfEMZH9rCcwtXhW_fEoW0jkPHaz51JQD7qps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BiXSTDx_ZOhdTUjtc6jdmTOQZDIlLRqi1iYxYm_KDLQ&oe=6A3FEDFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wEubcry9YUQ7kNvwGcElEw&_nc_oc=Adp3R_LLCeRVM-aUmUfoqfxa4zGBlTHiCB1oSEz4DicLU0LKlFGOh4TcqY6CbRMa1xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93_7wfuMtg5WMUqH0v39nzf_t2TGq7hLceOmq5yZLrEw&oe=6A3FEC46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
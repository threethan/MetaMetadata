_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKQZW22MQ0gQ7kNvwGblTAK&_nc_oc=AdrwJbmco6Rdx5oTmc9ITRMF_hJi7RGa5LWLn1wlcd0aLJl_TR6MEJpNJAps8Th_L8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa46xMhv3fITlS_y-6R8ibyedTVB-ZKdA-DylsLnGD7w&oe=6AD23BC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJEaSgOzTyIQ7kNvwG83kvI&_nc_oc=AdpqAX6rIbS4Qe4mI2YJdk289O7qIHCK1hblvJ6JzEwLiWv3xgnJlJ_6GfrdRN_xEjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7w1l_se5m11MpJ7h8i7i4iWmZRH1rNJzgL3_ILmRC4A&oe=6AD22678"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMkaWZtMJCoQ7kNvwGfNA4V&_nc_oc=AdpwQ6ANElQRnIpMdWBt8NKQfkgV1NkwM_fdw7JWzbVUROqNnN-UIwmNvZzSs8tsXqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv_SDoVek9dF9nNxirBm5kD8PLfrnUBxN-MYE6RE1gEw&oe=6AD2386F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riNKTMyO-FMQ7kNvwHLWZUd&_nc_oc=Adr6g8lL1XSaySDA8o3CL9udhg5QA6f-la6hjfhr3Hq7F3EHNmNAFWr0tH3tpJKSvaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7sjHPiyqD8jr3h_L8in-pLjKBpcq19CDQ0hfCMoEgMQ&oe=6AD2447C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huweDCHnSh4Q7kNvwHxart-&_nc_oc=AdofhSJ-jSlfL-NniBcu2KCHYXFztQG3GThaAbZeUCHaOyI5xd88WY26pUjCozE2W94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpVUk0wOzDOt0uWbTEi_xmciT9V2CEbMBPmwpk-P-KXg&oe=6AD242C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
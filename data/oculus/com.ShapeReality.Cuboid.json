_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeRj7pWmc94Q7kNvwGxidDj&_nc_oc=AdqIS0hb8lgX4YtqQ04EXOpnw8xKzJc3koCAiDuNktRd0zzYo_GXAKChE-aZRsIGNrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wdpHBNYrcU5POp_WnYh0Lt5sbWN11BY9JIdecx5knxw&oe=6A05E343"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4_ckT3kOTgQ7kNvwGg-SZH&_nc_oc=AdqnL9-IzDh7Lgsdl8d5l7Mj92eDZ7WJK3FHb0ZncNNMukXtiOtD8CnX3rYJ8-uxA84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VOPHGpnBCsC1fe6HQDR1pe30XhLh-ZP0-hgPwLD_qPA&oe=6A05CDF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7cP-VefPEEQ7kNvwEKTqf9&_nc_oc=AdrGecA0cPH0u_-ny73Ipa0NB78VyRM6m-nl-I22vZEKfpo1RQul8Sg-wbNQRHC6bHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lWKYvBzmQDJ-3811hDs_i5Nixv-mBjsYi8FAgHktvLA&oe=6A05DFEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Qc6RiEyos4Q7kNvwHMZdvS&_nc_oc=Adq2qM3kGsyFGZ-6-Hb6kRLY2k0WL6G_8oKXhxC-SDvIzZU23UdL029XCvD5Df6keNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P6xk-XblQSLyIZEBATN2KdXuf6td-eH7rfVQuPgpc3w&oe=6A05EBFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x24LKve3b7AQ7kNvwHFpcVk&_nc_oc=Adoztwy0EG1cJM7UQzHD9i2gA4EVwsNLGGPpisrrpwzl1daxEKxsQWgb4iAO_Slckdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78kFKiAaHknu_YhB4zg0zguA9d-ZvpmQW-6nh8ws_XXg&oe=6A05EA46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCTVQXvG37sQ7kNvwEg6T0Q&_nc_oc=AdrPKJNcuxsGoeD85ZrunW2nA-iPi-PXeO18ySfbhFyikFHU6lv24_L_TpwjAscEwFg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l3p3G_v2vX8r_uiqWkQamXMiZxqA6Zw4azUjYbKJuwg&oe=6A2435C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSON4nhzt94Q7kNvwGPmAez&_nc_oc=AdqdZEAm5Yy9rfCN-wnl_yrONYoMZLSkZRWVFFeciQqtgAMeNbHR_gyoTLhe6VFrO4g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SPfwKnHT5joEO3fopGup9a-n8OGlgekZd5O1RxXduFQ&oe=6A242078"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ta-BLIZNI2sQ7kNvwGoUelv&_nc_oc=Ador0Qjhu4jaejBi_-l19cPkKJdMzC-pbrZHCdry9xSXMyXVAT4wBaSjcG5T7cm6dOg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84oW9vAy2C53PGkMm7q3HJWBVC0o5egMS2nukoX4luJg&oe=6A24326F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3DgWhqbTXIQ7kNvwHWXfnV&_nc_oc=AdqQW613hFn-JkLlKtGDr5lZLYShuM9RrdqThWwxmGpaPw3t5uZXP5tpGyJTq94vyeg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fW3rKXHNSSFHkmv1Sjt3ZxZgKdRyqGkBClKiLyn5TBg&oe=6A243E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv8sQS9HnDoQ7kNvwHUM2jK&_nc_oc=Adra2HCTz6rkjWOkPjFMgNWvRPPAkrF2F-guIYz0nWkRWXtewbT4dWtWMVrTzmZ65yc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FRMmGfFaZQMMkVrkZZPT9YiPjIHfyXHoCf0Swb1x9Xw&oe=6A243CC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
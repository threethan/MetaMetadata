_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tuuw8p2sb-YQ7kNvwGZzyMY&_nc_oc=AdqgxQYxDqr2PMy_kpE-6fOkozeTf-k7bvFSWNgyHgHIm69ZXMrrfUhCy3tgvpX2v3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28uvwBAub629gx3s8ubqBOmhDG4aJSixUfO8GGhWPfog&oe=69D4E383"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7in_SeCYFYMQ7kNvwEDfAue&_nc_oc=AdoOQUzogvrbJnaFIerB6ncbvZyNSPrTLNxJwlG__5N8l3aQRbIX0aqi-WyfBjUs5eY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HGTDOO7Bwkl_XmB3ihWwmiE9ZsPmBOCDW_iTfs3WX_w&oe=69D50678"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFXhfR2FRi0Q7kNvwEqGlQA&_nc_oc=Ado1HO2xotP5Iu2czkAgV8a_igQ3DuWMsSJ6ENy_Im_2R1J3AaoK6KIxkePoEt956cE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h6dbYw2uBxMe93B_Hbq4E4iKqP9NnV6gSsPV4yAUB5w&oe=69D5186F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF-4NzjkJVMQ7kNvwG5sABz&_nc_oc=AdrTSlYd87tiu2wssMovxG6QqCr7EEK7hwyNA4LgH1wQYF8XYQZeSzKfsYXDEOK9dwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JXE0hSy64BM5V8ujNubzSrssP2VMKYGjqLS7A86OvVw&oe=69D4EC3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShRTaAn9BJkQ7kNvwErgoWu&_nc_oc=AdrfweRtnaAC93WWb6rPjJz6QYulquBCM_kLl7v3j5w3nHk_p0yiVWy1l5J4g1LX7Ig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M1hH845mGtDUqByvLZDzzOiJKZb2nXqOvpEebOdmRaw&oe=69D4EA86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
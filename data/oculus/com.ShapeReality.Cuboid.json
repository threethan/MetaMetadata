_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWXImVR4VVUQ7kNvwHXzREA&_nc_oc=AdodMeB24vOUYJFE71dcmFAzRRNfh-qOlHl7Ld9qvMaDG5H0CseQiak0paraLJG5btE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7252VXUbG4B012FCawElEo4_dG3kLDndO91gG638XeWw&oe=6A204143"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr0jV7cqSYgQ7kNvwGbNaDl&_nc_oc=Adr5e0V7DrbaBZMhjMSZAc4blXHtRldRb-wYIBDlqLDMtWY6mACx9K4gqHTtdb6Ziv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wHpxNXlpvAsDib0HeM7HpUrgi96pksJMOR7Cb1QO3FQ&oe=6A202BF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuwVEZoSTmQQ7kNvwEF2ESF&_nc_oc=Adq_38LxEccZuoz0cPlcF7-5m933S5Oxvwzj44kl5Xwyr2PGY2r0VoJZFnWuSJFIOMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cNK3xyXuYErxphbBiAMVzSyYATg7PDscdIvcfjLlFaQ&oe=6A203DEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CYpGddQTSYQ7kNvwH00z8L&_nc_oc=AdqgJbV-8c1J-6bD_Nyi9QJSQSQV_SHv1yRSeySiR-RHhuVkguoLYJ7cR1EHnVAz3xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iTug8WE2FY1Eu8McnixhcjPH3GVSw4IZE-MQ6DCJ3hg&oe=6A2049FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ed0eXGrFE7oQ7kNvwFMbRmj&_nc_oc=AdqxuNh0Fvi-NaR_lEaN9eqvlt5XmZrJSWq4Qga_Z2_GWCKcCqxB3JgnFePXf8sZPB8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62Cg0eUOnmfvb1GWoGfcpMEvfaVmFbiMmcN2ovHFXSMA&oe=6A204846"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGKr968vwz4Q7kNvwHAw8DS&_nc_oc=Adr38H059JppuhbvjMbbP2fFlJXYZweZ0quqwf4DFFB0EmZPD9UKCBliVfAnxNyggxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRFWasrIBqJOK3p08vNWygInITLraIAnePT32trVZkcQ&oe=6AF725C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-46cQZ4ms4Q7kNvwEex9Gp&_nc_oc=Adrcsw3aJB6x8-dsl7UxWZuwRl0Of55OGhPex47HXz8jse1l5EriG-jjQyDQ94z-lck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYAVWWa8to0GcIBZmbj1Kd45VqZ66fE9-dW4VgFTAczQ&oe=6AF748B8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKoxOQhadFEQ7kNvwGHblHt&_nc_oc=AdqEDsvbVXWIUaqYeAtNkqtGpSIosNVC9_yJDpC2kyV-mqzg8jdIN8oyUkjzm5oW-6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYSFqDct8Ig4aPLM7jV1ncAVntcLcw9aVBkS6iVLhvRg&oe=6AF7226F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA_kCvLYiI0Q7kNvwHsNmWz&_nc_oc=Adqki6EaZQblZhZrBEbElsC8j04Jawg0znGeyInANj5FSrTlsmiGpA2O7TRBJGtHbqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ84bfGjjdLPQqwuPBCEdzM0VquOeGZNFKI5D_h9ZaNw&oe=6AF72E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFGtBWRmMAMQ7kNvwGpuYOq&_nc_oc=AdrDfHe338R4hp2sEMHTdf9IK3bjhb4pwxc0CGbNIH0azVtTgboj_i5hzLLQkUqgLu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjvLId8sv-mNGCYYzcia1QrPk_KgHGnbMVF9otQnOlGQ&oe=6AF72CC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
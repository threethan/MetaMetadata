_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxDLgXOtmuoQ7kNvwFbsbCL&_nc_oc=AdrYDLDPf0beEOYG22OTSfccQ_5QswmHGzrS-0szsUs25TEtGUAV8jbJJ0YDRxPrnJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuHHmPfdokiaY-O3dkLZ_HVjO_9qbxQ02NuHFd9JxQKA&oe=6AC3BB43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKfsVoob3eUQ7kNvwHvpTDv&_nc_oc=Ado3kYKhNyx7_v-gWcdcL1UeeFcxMuZLdcZkhP3q45_Kvq_Kty_LewytrmdFwC-9t5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWDdrpSP1mxOQQ7CkaQsASYYcAr14_GUR4sKQlj3YCqg&oe=6AC3A5F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22uQvAqd46QQ7kNvwGhJr6u&_nc_oc=AdqFdAe7KrXQ2Du40vsBjSKGZKvSGfZJACpoeQbrQOmduUhJXzo8vzAS_l9ywRfOAy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJC-_B1W26_fjqLrBlgYIZrgzJInpZmOwi9cVPEetx3g&oe=6AC3B7EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WG1qOkRSlkkQ7kNvwEmAPew&_nc_oc=AdoPrbWNv_OMyLzgzo466xZZlg8ghhQKC4nzQN004_pbxrA6ZFoM8ufahPw7F_TjNhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_rcm7QglQ4M6HeAGcqoqnooiIh2oOj9xxeF8Xg0xu3Q&oe=6AC3C3FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRxvuxjJ824Q7kNvwGN5Jvi&_nc_oc=AdraNV9rJIMU7vWKgVvfSEZQknl2Id2wH59RpQ8b_X6ooKG0o-gyxSoslE9xErLDPL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHqNdx5mEwWs-_hubpFTTlXlNz-vZGyZoaq6ZEVZpFSw&oe=6AC3C246"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
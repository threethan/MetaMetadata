_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pen5wV7FqesQ7kNvwGpRG95&_nc_oc=AdoasEyC6vG6Wo2u_shlYn1CbsQST2dw5aM5sUihoKb9vKZgRVoaua77fc7koboEFxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EpRHNli9-U4N-T-05VNEzt8OgPNtTUQL8JcPqKwIr_w&oe=69FA05C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYNHTxeGpzMQ7kNvwH0kuKK&_nc_oc=AdqAdNHFBqHeGxD4IFWNI8o4H0F2KqVpln35r4k7VWKvc85jBrb7iOUcKE81H_a7Eno&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HbshBaLK0NndZ8IeNsSwehMPuhrpDXWxq6-_i7B6Wiw&oe=69F9F078"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7g7t0pNR0gQ7kNvwHl5rsJ&_nc_oc=AdpEmkxniFuPy_VsdEMgLhaM_P9c3leFxAfJRsAHE1xdfHmRw5i8DntLn3teFTJMvPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JP8Ymd7fdbOab8OePT6lYHIhOks1dKbAhKc77AO9HmA&oe=69FA026F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8Z3JTtXLQIQ7kNvwF8-8Xc&_nc_oc=AdpjEtQyNaVSz9kFjZlM0LayeJ90cAcKZWHhc0T2mS_mqBWseoFnWtiN_RWgJDssp5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7V0xrYtVfh0KrcUdZHF1b-f7Pjz2wIyRfsIWxAWFyJ2w&oe=69FA0E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJHSGH93FnoQ7kNvwERhdqQ&_nc_oc=AdrUxmrFfmKXC5ahYDtamzblO_oaezFZ0xJ07sPToBZuhdX_Ggi4UhpeS-zSYVgp9r8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ywZvtWPprl_pYRq_GtVq8EIOY6q_a9NexFzdXRstU6g&oe=69FA0CC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
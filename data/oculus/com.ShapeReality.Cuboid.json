_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6MGvTxntaAQ7kNvwF6HcpO&_nc_oc=Ado_vn_VQ85yw_TlxxSRW8zWuemBJX8TZ2jRay9GfaqE716w-0WD1KY6-AHUbM7kbSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01qyfcoDiagJW0S9nVuYF9Wrvje9EbZvGjRsNjFmk66A&oe=69E0F943"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEaK3J4VoHYQ7kNvwGp6vvz&_nc_oc=AdqDFpi-tddc5Oy2kl4UH7fFnf9uLsZ6Cp1xm_5pIKbN73lR4q1QeTVQZuFDAqNj8cY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dvDkgqxPLxzRqd3pH3_nkG9Ru19VO_Fha7sSBJV11UQ&oe=69E0E3F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7GhGC6myk4Q7kNvwH8eY4T&_nc_oc=Adr6qkC3c3D-Ou7LBz49Hjwf1H6cRH4XJ2DKlpBH_fYBAAtX5dV5mdjah9RvwY223so&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23VLbH66eVJgj30-bCNrWdqtn0C8KoFV44ZkLtiQMyuw&oe=69E0F5EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgzkXdc6ZbgQ7kNvwFLJ7EC&_nc_oc=AdoDG0O8zSItTFEycEfR83vZLuzNogB2iGFWLPAanl9fcCI0Zi41pU4XehQCq0R2ruk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mTZellT4mVoycTjRmEvV823tes3wyz1tvL0pSKSpUmQ&oe=69E0C9BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA8ApjLSbH4Q7kNvwHQw7i_&_nc_oc=AdrzRpWfhFR3QDs0L6miGZN4ppyik4qHNvWKzf8TTVXV1OyYdYHeeGjAg0fRW8uZeaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af175r-FXvCgjazmwtZUtPb670Ba7xlmmlAvnUx45-Jtmw&oe=69E0C806"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
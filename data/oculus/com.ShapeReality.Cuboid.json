_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnuOtYURfigQ7kNvwE9yR_q&_nc_oc=Ado-SeR8fRFkGuh0b_cDZlTd8awEW_j_Ca1fTxoOJYYnfUdnWy3PESaeRUd5oKme6m4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMxbGecSWqGldHalRhFF8japjcnZOI41nQSIALC5p4gQ&oe=6A4D1443"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dst0yPgCU0Q7kNvwHlOhHH&_nc_oc=Adq3pOYRFFVLMNBtkzLMFUfotSzupQgDZ0ExTvsfdCxf5UGErCCLJuQudCHK-p36IWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqcpVwv2xeDK9lDYUU57Os2sjhaA4NSJsuHipekvcAmg&oe=6A4CFEF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXjtOdvhFQUQ7kNvwEJwGWO&_nc_oc=Adp_n2hi-sBQpCRBpsVcXTb-uWFqX8AKLL2YG1b62T0UsAfR32Ia5bkqSAD5JRLhl7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfMqANNgg9fKnhL_-CMOB48oojt5kCJme7W6T0cg7n6g&oe=6A4D10EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri6jy9ZcxPQQ7kNvwHyyWLh&_nc_oc=AdoX5Quv17UTbdOBlzwIuBHLk6v99ZpqBdl_ZQD2DzG4CL9zvYLUHWDl0dv38QMTUco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1JQVkQIDlOtBCn_QOt4o4hpkkaULI4UlUtvw6iInCmw&oe=6A4D1CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yaQT0nTF7IQ7kNvwGOs2W6&_nc_oc=AdqOS-GWAJo-9YQNQy6J_r5H4PxdHNt4fG5h3GPBeTGB09HnssKcEnXDuHbF9WWdDnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5hMo0qiJePN3RIEG1B0a_FqwwEAv1qovGwfU6nEiacQ&oe=6A4D1B46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D54NLBj-P8QQ7kNvwGkeorh&_nc_oc=Adp1Akf9xXwKwNuWbk4vofOaFWGwPVQNZqLZ8cJf9mUSff3yq9nNfyZLqLq6rBGZuCs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o5iWLmZzxeZU1O0Y53M6dwZaSpJB3j6DFkGPlKDn_8Q&oe=6A452B43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-aeSWwMxckQ7kNvwH695nI&_nc_oc=AdrQW4AkjIiFf96FS-3A7f3WxC4kpwk0czUaKrxYm3j4_fzkhJX8x9QxL_Xbxtvywg0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LXVaAIQFT9EDoJv8m0mF572OjC6B3L6qgUgDZBJ6TfQ&oe=6A4515F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=525OGHWXP48Q7kNvwFwnpr3&_nc_oc=AdrZHAQk-Yh8Sg0EAn4geHswPCj_UhQroSUtkfu6ZY-vZKz5ZurDhKFPnnqSA-MF8IU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qq-hAHHko2tZ5Te5YrtFaKsVbI317_BviakVJROrPvQ&oe=6A4527EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ybc6MFgaVkQ7kNvwFlcUKA&_nc_oc=Adrij55FD1aVwG-aeyzeKiPWudjTcojI8rgWzFicN7zoF4XwbbZL4lNhwZLwnWWrD8M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QGioS5MKb5JTBT9jtrPEB_c4OA-h94nL7X1QqbF7HaQ&oe=6A4533FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXb1PRCFk8AQ7kNvwEgImx3&_nc_oc=Adp4IYJgNO_nHXxm8vmjVYB0cFTEvgSJeBhPI1HC47fFNEL90UnOh6YBBo4nwO3ALJY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lhUr7t8i2THNmwUvb_O9PprJ5V214oMMcH52__opCzQ&oe=6A453246"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
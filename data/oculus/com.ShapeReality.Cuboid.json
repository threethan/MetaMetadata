&oh=00_Af3b0uDUSosgHKpU99qFWtPPtg76zUf53_433ed1y97wrw&oe=69F0B5F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR7t6z6FxacQ7kNvwEVsJfi&_nc_oc=AdqmUjp1ByqOSzry_RlcL3pzbG6jnMNtT9klNJM4TojEK9JjE7GkMmN2cGaA772gMwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2FH4GEGHKdCFXkjNOWVOYxmCgmb4QvV0pQq6sb7ld7XQ&oe=69F0C7EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0zUovKHVeMQ7kNvwE3xCAF&_nc_oc=AdpAVDCl9EJUBjGqiuvAkAczw57NP_P_ELTa32SVv8x5orC8UsdDZyMAje0wXvNtamI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2pLMvMvCDp-PItTFr2Uy8ArlpRqwSKxte-jlJxcSsSxQ&oe=69F09BBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOUak5Le9fAQ7kNvwHesSnn&_nc_oc=AdpzWjzBw8m0Pqfnf6pCLtIYISEqxrC-2-Lp6K8YrQzynY8jEBNvtwEVGVa4SID7ui8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af10RxAG5A8Etlle4N5OxTMaUgg6ABaRExJN5YHFucvYdQ&oe=69F09A06"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3457602694456267"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1436612837193238"}]}, "baseline_offer": {"id": "1436612837193238"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1687883014, "status": "PU
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xQBBPG7xysQ7kNvwGa6Etk&_nc_oc=AdpyzmFXsSoTxwpBXSRwMYb8lVrbq5-7FBvUAxprgw8yrzJpEsmOTcKp6k46k9GwgVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCGHX5ycfOk8Cpz4UBLtjGnhMx_IJ0TBFfy3JOUuqg9w&oe=69CE4C03"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KKjlqL9aZ4Q7kNvwHN5HC0&_nc_oc=AdrLhODJ4b4USHdaw9YRSSD8KDIqqhMEGWDLUUkQnL_Ei33bgW5vwOAzVqVqXV1cf30&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-C5wY9e70YVMtWEn716XIbC4Odhzgkl5CQ_3zxh2GuQ&oe=69CE6EF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1dQMybAt3gQ7kNvwG0GMEp&_nc_oc=AdqyU3herAcdtUV1AECd3Asc_7wmjo9IlHI7lpT1vLf8whANzGnu7c292Y_DDjPd-zU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7XqWlFbWXlca6DWLjqUzBxEkyvxVJ7Y8xONsPscuBSQ&oe=69CE80EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BJfj2hLFP4Q7kNvwFnzSuJ&_nc_oc=Adq37fg_y1p6YEMzX4N5RVNtfCPiQUScK__Yg5i7mUu0Yfss0AA7nZOKuluKoAyvBV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyH4IGYobF2vCEzI6YBQmSo-UeF3GDdPnjPst-BxXrShA&oe=69CE54BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6deSBRHz-O8Q7kNvwHczE-q&_nc_oc=Adr_noYYQjlAfukN_NM2YJJe3l47nAx9ZQMFRfsQKJy-QT48A2emjp0fifWBYHUtHfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwwNOJzbBENzqJB9u1BFrlkXkyfEsVa0uRy7nqHTXAaQ&oe=69CE5306"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
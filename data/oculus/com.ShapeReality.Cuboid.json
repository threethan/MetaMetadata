?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-y1-rVLZUYQ7kNvwEBG8sS&_nc_oc=Ado50RyiIvKmyY8IEr5ditb5fmIFsF2dI8p5T66t_xVL17xpqwmJuruXyjRRkDJYX2g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YuM1hIDnuTFslT69RF3HxMrt5EvdAhH9zkInHeUBEFA&oe=6A11C0C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OpAmjWC3bMQ7kNvwEGClNH&_nc_oc=AdpUfhm9mbTuIYYn8HBZvznbXeswEtbY6BSfww7Du-xTDszoSR7EIfWHBfbrwaDoV94&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VfZSHYR3PBsK485-ruDXkIWJA8L3U4p1o5Uvlq5Jr0A&oe=6A11AB78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8IcI6DXy5UQ7kNvwHN7l6h&_nc_oc=AdoZPHyqBd3KV9yQQpSc4nU_3uUFPJnluKXiOo4XZDpxYMOXYsoddWGb6xctDsz7T4I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4E0-b9ZYvhBYiBCECeHGBnB6qdSer6OmaewEKIB6gRdQ&oe=6A11BD6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA0htYdCL6sQ7kNvwGAK5F4&_nc_oc=Adr7dkblG4_F9w_5J4irrfmhHOhVeJIjALsrR1C2ymVU5L6r5PdOnEv43DnR2YifbH8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7faKR3OT2b4F0WyYiXycDfgdX7UwWKwPokgbmeplPz9g&oe=6A11C97C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqFDvSThYp4Q7kNvwEHI3EV&_nc_oc=AdqiwytsAG3uoC6mpAbdZd8RRTkvO-hAjL6Qh9pBJX-ATcC_Ih93k1nxYAa_tlXjtHc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wbRgL94lKrbQ3Xv_kpGeDj0F-7v2Ctk3q4v2gjESspQ&oe=6A11C7C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT"
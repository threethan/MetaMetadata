x6DBvPZowfwZQEtPy6Rqg2lSnIdHssajJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcnXwQYK8TmKOSIQmes4R2miJ0cnHR5MmRI0vtGsAoWA&oe=69999003"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e65bfci-qUEQ7kNvwH_wpkm&_nc_oc=AdmkrhCar7HTpH9s3WgjCcO-EIaKrb2bccQU6m_QMNln7OU3oz5mD2bBlGyC5u4jxzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMC-ZGtpZ-iC4ZjOqUrls65B1Rt9HPiTXhVqYo5Rbl_w&oe=6999B2F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUkuMFZTvt0Q7kNvwE3uLFd&_nc_oc=AdlucFMZJuiZ-GKaUfS66t-1Le8Hpa9QtB5jmbJutyDtOquPvox0zBSw-BPF0-Wez7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsxfmwpME8fOgMc84biNxiOyo_ONMtKdNuW6BVYXJStaQ&oe=69998CAF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROJAzzMxXc0Q7kNvwHJFu7M&_nc_oc=AdlUZ-V6jsnR1PMcRzJexBrmLWjhRToHBndDF3mhp8GVy281j9a7oK_m8DqxhN4parI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvFKaIcvLeM9DRuFHxCjtvOEMvMltQrStJf8OaoBm8H_g&oe=699998BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpegKTNeNaAQ7kNvwF7BBG4&_nc_oc=AdmGyAZRqerdImww1WTJiOw00-fRin4-pB7OhHxIYMI9j6bL-4DOc6O2BqWM-gbVamo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQi07n0BDRa-ZZ872kSGpDFC8eRCOMdYBDXCdRsYKZhg&oe=69999706"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
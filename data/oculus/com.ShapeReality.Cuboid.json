_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xQBBPG7xysQ7kNvwFqV-7l&_nc_oc=Adpri7ASBlOzhc9fUdbtGlQcajQo0Xy_at4EvpasDHX6MVeG0xsyxXS6fYWbzL1Fqy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVAgQxpT0VZ7Y4LSoKEwMIhj8OpvwKTRqTNgFcH9PQAg&oe=69CCFA83"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI0-04AIY2cQ7kNvwFPLo50&_nc_oc=Adrphy-a2MiqrrkoUB0Jp0lVZpPAg--5X7RG2D6iLYDRUJHsAfA2v-0tnv01xetKT1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzj4DklhHaOS5N5R1rtH3m82UvLjm6ysFGJA4B4cZl02g&oe=69CD1D78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1dQMybAt3gQ7kNvwHeXK5e&_nc_oc=AdoRGvWELc2GhB4BNmLJ-LRF0syUQqZeSKQCsK8Vur15_Je4KqBLHtd9ngNHH3Z1Tg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx33JI7xZ8Tg8OgNk0WgCzEvx2U01alycK5HAc1lWF4Kw&oe=69CD2F6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BJfj2hLFP4Q7kNvwEdcgb5&_nc_oc=Adrcri-WNWw9qMJx2PiIVEplWuJPWYHhCGlUS4Qbq9-Jscy70s_x2Bj23ZF_KhI6E9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwI02-oPOmFLpQZcm7StZPOT8jS-eb3Pj-jCsog1ghyXQ&oe=69CD033C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6deSBRHz-O8Q7kNvwEFwI45&_nc_oc=Adp-neDGckM4KKYfdIKatBtfAMOtCrv7T8GutneHWE7V-q5Oa1qVdyfsIbKckVYNHGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5Xs8_X4Tv2nE-E8j1RQr0aMMVCGE-f8zECvlUnhojqQ&oe=69CD0186"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
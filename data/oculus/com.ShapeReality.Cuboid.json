_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C-jsiBbbrQQ7kNvwHn2KHq&_nc_oc=Adogyey6dYD7kyOikE6rTAPQnIt5f-aeBIsP5BuMn-DsrxLd8T3X_k912jleBC8iKWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt97HuvgVJi0LHZT-UyiKaORbsZMNWDOHis4Sn-h8wpw&oe=6A6E09C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlIJdQ0Kf20Q7kNvwHKjTsY&_nc_oc=Adp-D5pefRHbirFvSSncJaVoKhFO3FQ-edZXwumNC9AaAj2EWOV7BUv4Mt2T9b7CuHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkZynuohxdgWtrLfWJTfHLuDWrNRdYYtZxqq_uCq5HSQ&oe=6A6DF478"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOI9pk2HIGkQ7kNvwFySlKs&_nc_oc=AdqjhdpfES5sNQ-n0fdDoVp63MqDiu0WL_Jk0Tdm81x93H_aHZuuhIIxHkXvmAqeLc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD32K0_K3q5pmgatfb28bdSb6pNkmcLL60Mkn9UVGVo2g&oe=6A6E066F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXzwF7mFYcoQ7kNvwFO03HZ&_nc_oc=AdokncxXaToKwiJoH1JZwPzekS0CTYURm9v85g28MdRqOznj0MENanTitS4TzceQtaI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgYZP73tOBkadHAcEibAVBSA3RxXU1XT-XzaVudlINIA&oe=6A6DDA3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzGGakGYh-oQ7kNvwEnFBv5&_nc_oc=AdqOzIPkyYrEK5n29cWbYbGgX043ScC30lkSsYhvk3Od0oXzh1JJ6EJYbkR-sOH2tvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUk3HfYF3utqW71OfRHBiQVT3KijDvZThyYevWec7ENA&oe=6A6DD886"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
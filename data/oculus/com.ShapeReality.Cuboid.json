_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxDLgXOtmuoQ7kNvwHDEyGG&_nc_oc=AdoQFpb0GWOdkvtJkDrvqmHS2DUEoAh50eaDWUNZ2522wAWpHoD6dpHby0EwIzS9zDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6dl-64X4ITg4XxObDFruf2Ulj3Ll5yW6gWO2jEfNNww&oe=6AC269C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geQK0uYXIYUQ7kNvwGLHjyk&_nc_oc=Adrq1ZSOucOwfYEYKr6bTGKDyt8nH8NfbIi3MWNVB35VyhVkdrW-kGaBWyD-Km55ovE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJRsP1Omxy48LGkQuaMIc7y1Oss733_fGrkgXEyKLKLQ&oe=6AC25478"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22uQvAqd46QQ7kNvwH0KHC4&_nc_oc=Adq-WJivnON4vyFddQrLnrPhRLpMjnqZfD7wlvSF_zb_wbAtXaLJgHDrNqDQQ-6npik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjQMh_RvgCC67NC9mkaY6cdAuJvHTsvKfz6vZdeFyoRg&oe=6AC2666F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WG1qOkRSlkkQ7kNvwFTZlps&_nc_oc=AdpsU6cCIdT-hAInbjuXE222r8Bjg3MJOfs6Hyhjv4RdBuqhe5zE0M_EZppQWpsKU0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUIxwbi5quSK53B8uWLObeZX72Lr3upaxqx_aCQYbDFw&oe=6AC2727C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRxvuxjJ824Q7kNvwFoarMt&_nc_oc=AdphNj9JJ5sER1iIv9aCVK07L9uPkoleEhOcdVQh4MJVBKEKnqKMX2rqPlUsOIcOsxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6l9FUcDPzo-ggKCBvaF-8FQDNhXHkERrxhiKvmA85FQ&oe=6AC270C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
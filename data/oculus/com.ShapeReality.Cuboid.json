_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r61WH2ZWXw8Q7kNvwF-_qxH&_nc_oc=Adq2neEXu8DIa-9KD_OUgUL8mOuPLeCD4aGiYE9IuR6BCe5hFxUvynerghYODiRiMgo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39qfA178YvuJFBG0pSvU3i3RmRKogMpGsV73gksOoivA&oe=69DF6F83"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEaK3J4VoHYQ7kNvwGjwo0n&_nc_oc=AdoBU9W4MWnNq7LdFqwpW8PWSkj0JZDUluxF5rbFA62egjPr66vgAv13NNhRbAPwUdc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2foI-bAalEstlBZdXaOdedVHFYJD2coy6FAjYpXdyBJw&oe=69DF9278"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBI0YT8pn4UQ7kNvwEhnQv2&_nc_oc=Adr-vEB4ibS6MwMo-LRFYmqC6BvG2OjQModdgUy84IsXXMPy3O44MaETh3Oqtof7ohI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QzJ-VBF0dGdBJRwUkoxZwZkE6sr69BedDQrNzCoRb6Q&oe=69DFA46F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIVpiKU1irsQ7kNvwFnmHP_&_nc_oc=AdqizvHeSpybMzQsI8cwpH0b6G4QV5diV6u8hNcyGD_CjSHxghdpHNhNd1uw5XsNmAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aQOwYrHwYXJwR2ByTmQYB241RSpLdpm20jKwUvn5vkA&oe=69DF783C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA8ApjLSbH4Q7kNvwGDje86&_nc_oc=AdpAiG0-XwszDuJQMskEgagJeMQKXqZYlUr6WS6uTyjum5vslxjzTWm33SOBOedOn0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AYWuJ8GTONp2-SFnM9PB7J1R0PHLW5PEJM-bF5Ql3JQ&oe=69DF7686"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
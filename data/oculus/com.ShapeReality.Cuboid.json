_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og-LTW-UhWEQ7kNvwE8lr2s&_nc_oc=AdoVKxNuc5sI-HnITWDW_AYQvXhjB8wtCkL3SYZOxqUhKfo9M2ulH5ylIGnA-VSnRVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiQZ7DZjBgUqlHPvqnnMl-n-Qb5pxovlmH_wFxpD6o2g&oe=6AB53AC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RLSEia6fZ8Q7kNvwGsRx0I&_nc_oc=AdrIT11pl3W3_Te8kUsQGuwb7aNFPe8YS56MbNhxW4BbIJ5tlo8nP2mkeD97INXu7Jo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7SDCowdm3R9vF3oFsGXQ5xFFrUiDBGLj-U9H-fq64kQ&oe=6AB52578"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUU_ceY8WYkQ7kNvwFTzoui&_nc_oc=AdrFxRdtawAxD9Mk96nspurjtTyEJSshpX15pJcLtGDwIKPd8willd8h6RptwFRdRio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTZQCrLgZDPTJMmrk-Fr3fQYVP35LU3BE-VYXa1N6blw&oe=6AB5376F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzFZHSAeUZ4Q7kNvwH3txBt&_nc_oc=AdpBqCZhOk1J_YAGHPVQtrrFcpdUnIsKfppP_1xRsEe7h6VnSkVX36NOGGtKAi7OXME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhTAAC1vCYKlsdYOSEgY1yFz9KvDtnpLqcWEAVz37IvA&oe=6AB5437C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDnl3zrhzTcQ7kNvwE2eRXh&_nc_oc=AdoMId--mtn0GmMVVsUeu6zE_eIYKOiaE6JOl3ZGqLsdLEE29bKMeBvYQgd2d7szuqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzkyHb2J5fh6Yh1BlZujCYoqG_J_RcBedarR7Y0q5yHA&oe=6AB541C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
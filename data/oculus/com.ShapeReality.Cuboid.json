_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKtup2Ifua8Q7kNvwG4wqd2&_nc_oc=AdojL3Pve-6XOS81cY6m3-Dz2jjcgIVhbGbm53Zvq704X-kv_89YZ3wQDs5YuSC3V3A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp-YJVdDPHG1yUG4nVOnqreSmK0WsZFIWWc-GRHvtktA&oe=6A972083"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckseT3vNbUoQ7kNvwHDOthY&_nc_oc=AdrsRxfjSjIrEAmoFtIzsA2qt2MJuchi1iqTnTis6EDGahkfH68cP7aJcAd9xvk8LTA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0ATnRkHK_tP70VvVaAz3Wz0o2m7lFiZH_7DmfAL2s-A&oe=6A974378"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3McQuytyclIQ7kNvwG5ErIn&_nc_oc=AdoA-KOib_hJKKSVtO3qW7-b9RDzhEOyWNq7LjfAoIYmo-9_RkNzF_YTR5PRriyQAsI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFWZURAHPdQowLr47SRRm6mQeu0gDlTUJ4pqXBQz3ezw&oe=6A971D2F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB-SKA4QwAgQ7kNvwFT4uuJ&_nc_oc=AdqwxZImw27m0tlOKT1UcwlRTlGN9GKoF19Pkq5AKyXAbvTzihwvhp8221VEz63Xw9M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIWtoU6VmunAT2taKAGvGSOsqgVVqDD7svwvMr8xlQ5Q&oe=6A97293C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXzEFFnCGK4Q7kNvwGbcEGW&_nc_oc=Adqi8bpf-mYfZN7c05W6d1GUVGuFoeI2E0Vn4wA7GHwKaZBCzlQmq2b4h-3KSSqTm-Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0WyOND6Mmfj6BEoQ6QZdmcmgCrwzzPuv0O3waF0GvHQ&oe=6A972786"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3HRrsQRvvwQ7kNvwHVAP4j&_nc_oc=Adr4NyGrpfg8kOEaxdacxmFUUKI_Aqn69sBJr03dxxzFO3lK55xx_V9Yn64IbtUNvz4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFUmAEF5aoK6a5XDmgJNAA8rEWeWk-PmlPj35PHVMDxQ&oe=6A882F83"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsanlsEt6wAQ7kNvwGwFgaX&_nc_oc=AdoR9uiUGB6nu-m4yuY_-DnSN-kKunhUN_s61DdUkz1Sk-rTKjxcrR0Rcb9lvrhGK1I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvUbS77TpSu6WByU4aTu3lyo7jy_D2DbmoZrVd3JQxXw&oe=6A885278"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMKcUSwL3nAQ7kNvwGDgVwl&_nc_oc=AdrUv105p9VCHuZkLGH3igfcSM2np8piAr5zHTjeqP5-2-bUNnwmRTC_QoHJU0xdJXE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu84GZohRUyJ2fa2UL03MFnb3UFCiGMOw7-PHCaUI4_g&oe=6A882C2F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJ-g5WklNsEQ7kNvwEv3yXL&_nc_oc=Adr7g4T96qMgLZ17LnV5HoXBHKxwoRxArerxbiAHnmSNgDgGF88VQ5rDIzK1ThmouUQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnUpcZTM_DlMdwXRFtUTImmyOtfMXjNUx1_XgWRQO8yg&oe=6A88383C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWF3i6AQSpcQ7kNvwHkz6sy&_nc_oc=AdppjxnWVOlumQm4dcNWVfESmRtfQx811n3DmsHrBt86f7wBpBLJB0WKD_rwP97JHUM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUgzFi-JawII8YBqOGBP2YauhSBkn6LY-ExSt2PCGErQ&oe=6A883686"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
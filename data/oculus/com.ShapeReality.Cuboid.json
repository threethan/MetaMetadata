_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnuOtYURfigQ7kNvwEwniUH&_nc_oc=Adq7o2qGMzIeGWbROEKUY6H8F_S6LuHTnWyu_tvVfVzRSMvb0TOtr1w5VlRC_M6NOa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAezDXe5oZj3xLF2QHB3vfLpNYBZqMSepTB0PFlKiVEFw&oe=6A4BC2C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIVUhGfmM4MQ7kNvwEn-lg-&_nc_oc=AdrkTRoiSPexJ7UK3VzI5dvvQV4LlRWWLghcqOpS0-XxzRn5y3t3n7w6Nugo55FYIBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlsFhNDrOO4sMYkJxsylRddBCDV2HusIPO6TklrIox5Q&oe=6A4BAD78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXjtOdvhFQUQ7kNvwFifbK3&_nc_oc=Adr5B4Mjd79q590q6RQ7Rj8lu5VfFfHDQEgchQqYkuwbDtl5xXbvGkPbw7uzVyleeVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEg1b8so1i481n18fSNaeCutBYQZjErczxpO2PJKb71w&oe=6A4BBF6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri6jy9ZcxPQQ7kNvwHt66Af&_nc_oc=AdqNIpflOrj7NAzthPpkFgvl3w0SJHhs28kUn99Mp0OWNC4WpDHfI6MEgszhfpPR2c8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMk-MSeL0nzK980zcfZ5Nd8Oiw40xPy6mtNa2eLJD_oA&oe=6A4BCB7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yaQT0nTF7IQ7kNvwEn2luI&_nc_oc=AdpEZOPS6PyDDynbMgcD9vWJdReoXNqayGqKpxB16GN0qXyyFJc3vOhQJfFr5vqTDVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnEnicqHH_5HIy5dWjYkQ4zxY73Y8Yo4F271f-KexYxw&oe=6A4BC9C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
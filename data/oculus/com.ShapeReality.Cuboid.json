_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3IP9WHSE4AQ7kNvwFGHl9q&_nc_oc=AdpbiXI86cWEbXi3TnU_CiuNPyZw13cC8NY62FcrCTJhrPGXAyyzvKWgnr6MeSEMs7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAovm6VyYk5KLhnivnk7EXoCerSshNEJ3eFdnNUke-GyA&oe=6A4FB743"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dst0yPgCU0Q7kNvwE3HeBG&_nc_oc=Adq4EQYtIYrRY5nuDmQr2vfDbfRi6vpsleN5dicAi0KFkrw3QDAxbxSq9A-6VJMvMQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP6ERuJLiAudzzKGT5fsjmQKMI0-kDGVRozwWm1ZC4FA&oe=6A4FA1F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe0sIae79BIQ7kNvwFguBJH&_nc_oc=AdoRQfsz5LEIKD-DFtNdejHCbgj8IcaX5Bjl_tNgeGn5I9B92XSFQg7v0N4qGXkqT0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBydAwOXxkUCH5iSv4d5ZztrjC3iOMiH6UQsz0rUB-Q1Q&oe=6A4FB3EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhlaOGc4UfMQ7kNvwFmyypJ&_nc_oc=AdosKFaQ7F6J7ps8Y1TJQgCK35Z3L8rMPOfGAXHfYuQklj4gc_ecauCMI2HVurwbnhw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkdHKZ5RlCB3RETNNzOm7ive48eFGSc__-qne8LiFb6A&oe=6A4FBFFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ2YcsOwHUgQ7kNvwFaae6s&_nc_oc=AdoXf0mj6VszfS80jb2Pot58UUU177AFAdBrFcGhP0IL4kdXpGq5C8YS4OAGo9EZyuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGSjH0cwKWa8rjoOG1uORhp-pu5I-sWRSCNe8dgUdt4w&oe=6A4FBE46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
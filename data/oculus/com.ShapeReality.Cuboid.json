_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awFtV1xPznkQ7kNvwHMlxIJ&_nc_oc=AdodT5Lyf3sFHv0s26ZDDtPaO9EfZdJraJNBC7KsEyQmH0OOLhOOvya5PhBL2385msY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUqIZ1RoCYgpPiUh-MlVYNvZB0iJ6Y0NGWqtBAe2p7zA&oe=6AF482C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGdYkg9MBqAQ7kNvwGSpHaH&_nc_oc=AdoaRFGJ4UUom-psmhrZvjbEWl4XPIFH1OS0hUKySQJuTBenizOZzhJdtlNUwtNW9hA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSWizmryXNO-eCymupAyXJomv4zeYA8GIyG396twXAVw&oe=6AF46D78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYNnXtEgowYQ7kNvwFcDDSu&_nc_oc=AdqcOsM6iUKv_rvbC5kLpnu3Kg8VdfQHp3TFcWuiw3j6OZx9n5jaHXmoStoqDpVPmBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj37E_18Pb_9JRI9fuy_K64KsybW4BrOUjvphzqQ8IyA&oe=6AF47F6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfImFrrZBh0Q7kNvwHhd_uu&_nc_oc=Adp7sPfc9ZAYzETRznicp9wxCcw346gPwnPvtPLtyD8AcLj6ClWiHFlnFskgp6m009w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-vWZzU9I4D--7Fq9eQVQrnrglITDFi2-Vg1swO0sZuw&oe=6AF48B7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFGtBWRmMAMQ7kNvwFuVeKt&_nc_oc=Ado3FqycpCWThyWpqhVb9KOM2S_8TM_TOBEMbThywxc32Sm-GFWovLAtjAbT7ZqKXQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRei_44CNq0Il_a5bw4Q9S4DMejVUTqRXMLB2RANLvtAA&oe=6AF489C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
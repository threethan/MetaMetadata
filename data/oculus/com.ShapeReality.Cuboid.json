_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C-jsiBbbrQQ7kNvwFaoA9-&_nc_oc=AdrTTccbNHsHqDVwmaaS9CGDy62vWd1iF7RvVAPlDCbdhTKQKSt0NVskyO-uZ_uoNcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFySK6IiGkxC1eOAVvqTLG8leFYQ4me9IuIhjvbaF8mw&oe=6A6CB843"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlIJdQ0Kf20Q7kNvwE2GNEe&_nc_oc=AdoMnWd8NC7LSbkhPBQpRA1sV8GlzlmpAyI8v6rLOdU3kjpvSs_0-fRXgfr1IO4xLgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjGYPqvuY8THIBGCFY3h_v0Lueh-hTJRJmXE3Qv_VorA&oe=6A6CA2F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOI9pk2HIGkQ7kNvwEc143x&_nc_oc=AdpYtmeMdlj97MsrIlwSxL5Q2Frb5qVwrbNHEUWlcc3vRfTd2OUIvefbibYel_5os4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUNIxenKwYse5Z05KAYTzpTy4z3TmETBEn1JF8B5hSVQ&oe=6A6CB4EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXzwF7mFYcoQ7kNvwFabLZo&_nc_oc=Adq8gpeCSvf8V-umVRdvSV58q9TN6pvyUiS7x4FK4NYWkLZFXOPJRHqTJXBqSccCyMM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvhySMwvzMlhgo7UYtWnPkq5bBgmBtF2GBv_ci3QAjOA&oe=6A6CC0FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbH6dy7ffcAQ7kNvwHQjH7W&_nc_oc=AdrVwPQqK4JdxiGyOoW_3nqQxVW4oGTj7RE3MXOffYNCdWu8TSyJfNodAzal8BpgNOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF4GRx_-u2lPdN2B4eeV2RfaMXqubQQD0jPc5YBUS7VQ&oe=6A6CBF46"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6GJgGjWTkoQ7kNvwGljJiM&_nc_oc=AdpjnKpXHEX88kimvsTGsVxFq32LDhvLqZNwI4YImkLhDg4GK0f99gSE2frb6PRxk3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O3IYwwW6tt3cQ8560Rt3NXt4gMt1L6HTrDLVr0-1Lbw&oe=6A2ACD43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aVfVMXl6rkQ7kNvwHXt6XO&_nc_oc=AdpoGItw0sby977zLa7v2ABiIrPZO_vkFGaMe98SiB8BiRG8abpV7HIyWLmI9htthh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Afkov14eRKldMcQkHhu_NMR12OdQ8VvaAJPWvpue3zA&oe=6A2AB7F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAB30NA3-ooQ7kNvwEV23ds&_nc_oc=Adrnw7S8-4PFCsWC80L-5MSwcPaqpC71AZUM2WMynI0TV-ToMeGKT9VuN-q6MoOP6iE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eefFQHcseu9ZFb5AHj4BO69_0ArTy3422RjfN93rC8w&oe=6A2AC9EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZwsJSyJc_oQ7kNvwFQGbAz&_nc_oc=AdqVbHsWhxiylv25wvcE3qPMHLXWJGbDhcskTvOI594f5koXs51gxJhl_-iwn7y1G5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fxkbql0uC-TpMSOJmQhdL6xIIDDlktrc4iG-I9zGMxg&oe=6A2AD5FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGS5cDcXU-oQ7kNvwE7nfot&_nc_oc=Adqine-W-byHqlrS3jqTZKtF41al3enWwL5ASBj9cPNAM4JTVMKelW9mWMFFttDWkfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X0a7FOT-alPcGsmqTNrqSFv-8uiALEIifrcPfvl290w&oe=6A2AD446"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
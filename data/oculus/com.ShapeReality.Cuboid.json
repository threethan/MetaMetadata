_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSQV4iFNB8QQ7kNvwH7akwc&_nc_oc=Adr83CXmga1Y8q8daIopr5KDGu2XZXvt6nHRGWcpfQr8GRZ0GwvQNByP0lDT7zofh6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-Bhhkt_xcXv-fn7AQF-Lh_d9MDQ89xvpyZEoAmvHUSA&oe=6AC65E43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKfsVoob3eUQ7kNvwE1ltni&_nc_oc=AdrpBTIfOG2PJDGS86uliZoUbTwFQZKGGKZN1b9hyToh08rYePiXuD-LTQ5nPaztj7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_o62WkMoSVJPTqombVlFrhOSyb3vthCP1TOYoXnuwqg&oe=6AC648F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpAmisp8n1EQ7kNvwGXQAol&_nc_oc=AdphcK5RjeRxbO5ZxNqDxDE8PJHQJYiSiGjhX7s1-KADX9G8GWGg8oxsR9igDsKA12c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh7Z8i6fDt_KYVjCn0WP5QLh5oYeu1UMnY8TU4NhbSfg&oe=6AC65AEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tujXoCKVc8sQ7kNvwES6CgI&_nc_oc=Adp6MPHnkSr5_iHUeXsw-1ozWPtNJZwInQX58AocGi_6JVdw2Y_nTvv-RJzq1rAsCcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr3_0DGVfrz51Jrp0GtQn2lxuEb4R5O4kpIUr29G9F4A&oe=6AC666FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLUfxOyAl0wQ7kNvwHFxh0n&_nc_oc=Adp8AUqjKwnFrDEAQVckQUmymVXJTB-5h4Wfc_6A0WTXzwrTJ8etitKX0gM8M-5luSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP-ObBjdM-mFqnh_26w6BJIJ5qb-UMO129MvXw4yk67A&oe=6AC66546"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
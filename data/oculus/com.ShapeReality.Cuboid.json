ng", "id": "1297649127508851", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IXfY2YOjVIQ7kNvwH_4TC4&_nc_oc=Adq_-oZRUf-hMZDa6jo7c8XpLuq6ebeLquqdWvwSCgmLfKQcWezrvvC0RyAYaM9h454&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm4FrE2a6Pg1_KNt3q2EzHTH_EZfEeFxUosF3S-cP2fg&oe=6A8D9878"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzuxUltK3aoQ7kNvwHSbGUW&_nc_oc=AdooKUQvovUgWSAQGC6_19je08G6RjYNFOotfAFA4q-gaUuWkCC4aFIkewYk-_ns53k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwDHxJ1Xh8mWKwQsvVhvBgeLjoMFROmwsZqBR7W-D7bQ&oe=6A8D722F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpZUiZJvxXgQ7kNvwHgCcVJ&_nc_oc=AdoPkyeML7rcEHj1ujSHKh1BVmNvawYWTdlI2mvogPIG3TiVbQwkuLycavzbuTp8pCI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdyg4F6K1tl0JQYHu7lYf03yTheaw3b9O6U-qpCK0dEA&oe=6A8D7E3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwMYarFS3-0Q7kNvwEX7r2H&_nc_oc=AdrefyFy5AgJw0n3ETdJOzybbxelsqqTtSvdifyKvsEL8zaAzu7x96V2t2GQcLG32UE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc0G4rJJkIJEbh1RTPZaSHi8Tz-O3a3EMGTkK6bjdhKg&oe=6A8D7C86"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agrlu61zxYsQ7kNvwFYfTxC&_nc_oc=Adp9K77j6zn79gS_wf94Qw89xnbS7nh8vBTctPjccIsiWZp6TXEs_iHwUdbjCkOuThE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3fsVk8wAVARtGacDRnutKR5SLHvnvsiH2HmsZJJ1zww&oe=6AE60243"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yNWWtdHyyYQ7kNvwF2OI9T&_nc_oc=AdrT9fDYhZiVRbhpVQP0bNYhCE06BjEYiU7eYLURDCSN-cfKCOBkPTH2bAIqf6XM84Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRGiAhRGBqlqhON7WJN0p9LHkt9VYJOQrQt9_N7xV3OQ&oe=6AE5ECF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75H-yQLg9PgQ7kNvwGefhE7&_nc_oc=AdqvyBtqy_xa0PT6pH0NinTXfDkxwMgkQd8kFDlQyfVbiyvcbZTpD3S_YSobOFnCbg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK6qgsmUfRgzUs5VHKXtKR7E00KqrQ3BhPxufqfK8HNA&oe=6AE5FEEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPGQA6J82PMQ7kNvwGvGZ3t&_nc_oc=AdqRY6jtkQgrxc7lW6JNEv7YlO8J7bOpzgLUeu-9bvuq4WUJRcOhmFaILK8CPM_21GQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_U85tQIy4W9tOoCrW3N0gfzG78Tbr5rPUQ2h6zgffsg&oe=6AE60AFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Tc5E1d_cacQ7kNvwFIANwm&_nc_oc=AdrLselZaEX4ITSfXdEbXkSZ7rqL6JgIhV2znd-_AXtMDnqlMPEf6AqY0URNhkg2FFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMomBLfATTFv1bOsdgI_ktVs0_ANmeLZMtpCHrDtqRKqw&oe=6AE60946"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
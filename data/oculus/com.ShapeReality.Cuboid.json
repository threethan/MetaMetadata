_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r61WH2ZWXw8Q7kNvwH-G3lg&_nc_oc=AdpnWYSEw1PcEmdk79W8LNI2Nwl22QSoXMdIirPd-c37N-cldSj9-qQuKky0Xv5keag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29MuUbuR0fJZNGOsLTojR7BcCY24W7sJTDflbcvGc2Rw&oe=69DCCC83"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_R47n5lT1MQ7kNvwEM71Vo&_nc_oc=AdqdwmO3s2tPVxNhASZYbHx766mSyBNS50xrcfN6Wq0YrbBeNjsR33qGVPt-wevoETw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rISQYBNH7xhlWjRUBPi7yBB-XhELhqM4F2T6gPUmgAQ&oe=69DCEF78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBI0YT8pn4UQ7kNvwF8PkOP&_nc_oc=Ado-p9KnNmvRIwElJoMWtuscrCeLFXc_SJAN7Da3rro0hYw3GIBuiOqOFHu7z2He4nI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y-fxN9dZgfFuYHaQW0bIMWIBxCJsDbaeGojMGb9WJjA&oe=69DD016F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIVpiKU1irsQ7kNvwFnRzvT&_nc_oc=Adp1dwyT3unH9QLjqwgcKtjX1kmUmITSiGLgwyXeWR4I5MUvYAiUX0mu0cONecR7-cE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_GbDXZ93GarnHNyhAvvUR4YNJp5Gz_Vrg6hr7wc90-w&oe=69DCD53C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG4FIayQqUAQ7kNvwE_I7PR&_nc_oc=Adpim_MoCnQh0Iytoa1YSwwe9O0lkKqg2KVBXWbUrlpeitMjHV2eRJpP-VuEkgNWjsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ph9Ue8hEgnMGACreKQK1oDMn8c27zEdaq7JHOHSR3eA&oe=69DCD386"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
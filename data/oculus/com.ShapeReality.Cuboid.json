_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p5updtIbyQQ7kNvwE2CqeY&_nc_oc=Adr3RF7nZAXPuqmykM0zSCZkdzz4psj-CpRcj58K5Zb9iJ2vhnf8CztUDY-KCRxpUIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi_c5wO0p5Ot_dPvJFs0AAlxk_RodAqGdx4RaetxQPgQ&oe=6AA568C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfk9SBLLwRsQ7kNvwErfglG&_nc_oc=AdqbA5maoMxmDTDZTpNuY3LhWNKAtL66HAhFuN3LTkDP_8xqxr4woJ_nwNYM5f4Lv8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWS1Xsss3snPkSh19G_DSwL0-VlSagH5tZkIy1pFYl3g&oe=6AA55378"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsLonZOeFJMQ7kNvwH4uV4q&_nc_oc=AdrMUzjZJkXc_Na17driUrT-H6t57cScBfO-7nO_t7Q7-bdMkszYmifdp9sgHHAuykg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvLKTYDSCXYAU_qD6hKyVcRHx_1XRqhkP8kEP2qOTq-w&oe=6AA5656F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYNeQeSF250Q7kNvwG7h3A6&_nc_oc=AdrG-Lf9LEp0K91VXqLvZEv8aJW6cX3W7shkq8INtj8DIeIKNDrLlX5UF1imH9LU-I8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY5tkTxJPqYVqpgc1iiH4kAQiWrvwoPK6QA2ruCrE9Zw&oe=6AA5717C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6bqHEmlRHYQ7kNvwH-eYmq&_nc_oc=Adp0MHBa_Jy4ESJkNwXN5xIsmDN7ooKuZA6Of9jYuYHzOTHOJ_3HWRgSKTwUFK-IMn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdizypsupgFn3fc_LZFBlVvKOzL8NJ9U9ZPV48d6bzBw&oe=6AA56FC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
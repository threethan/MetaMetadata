_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSQV4iFNB8QQ7kNvwGdtCqM&_nc_oc=AdoCOwIaCpY0EabAR5U9lFnERnPi8FD7XpBIJFWtEof9sMnmt-eWQ0Anqex6RYdZMuA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGMaS1eM3J65A8K37qm7LclvgUtd_aj7xOvOxFPfSnkw&oe=6AC90143"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvOVUzK-qXsQ7kNvwHFvu3t&_nc_oc=AdqQUzcy_EMnL_KNf0BhRXGOKUBl9lSxntAxgU0VmMSrdQBiujkg7h0T_E8Z4m65OlI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy4AjFXg2AH_TGNmzcjBlasNBN9f3DTBxXUT0zSRUqQA&oe=6AC8EBF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpAmisp8n1EQ7kNvwE_uMNt&_nc_oc=AdpzWycwaSC7Ly7j64e8JDZ6wWE21eVt3sR86CQWczABJQ09suHBms7l39qc2kfKzt4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_fw0VZ9RIO8mvCtbxVR8o7FGGIEbvumDN1IDYIdAAhw&oe=6AC8FDEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tujXoCKVc8sQ7kNvwEf0y1L&_nc_oc=AdrJCUY0fhetyWLWiLY2ZQuTWs5gCUS-e8am3uW3QpA34G8fKVyR8fn9I5HvYu_0gZo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlcpI4v6uWCL5MAIKiNdYDxqmwYdrIBTDkMm2lu7_m_A&oe=6AC909FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqyV1ESRuCQQ7kNvwFQdWcG&_nc_oc=AdoOrooWmtamoE0e2ZkzjH3rY0aMe5Cntu_O-jMcrMQHiDrht-Pbo9U1pLk61tfAQfw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDPXomEJks_oWnBoMGI0IGW7vRRksxQrfqDZKV9NaAXw&oe=6AC90846"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEY4xDZqzL8Q7kNvwGVTLDK&_nc_oc=AdqNB_kp075aTkunjwoMA50J88PeSqh-a-V5aWbEbEgUVeSddAi3hxwwMRJyQjryOag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af325WF229HHMqzqxdC8GVoAdCwT8wX7t7ep0nVCHVTXug&oe=69D278C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7in_SeCYFYMQ7kNvwGLWrrG&_nc_oc=AdqbUMzzhP1ckzpseKhXhqCQaw2eCxm5-pixG5SHLPG1hsxNgNAzOCXAHLIp6Ov8CVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26z6cFSRWkiR2dhemMS__i79rGdHqxh12eGwZ6dPGAmQ&oe=69D26378"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pl1hhIHxUwQ7kNvwHNs622&_nc_oc=AdqPnL2tHruAgg4sUR4gUF7fS6nfTO6hqirS1IKUyGAo1ioruK_zyphfqVhT1xGLH2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x0sfEkuRzQ3kaE9anhCoDqsTI_WLKKvNvAQHKqptbaA&oe=69D2756F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dYlATz4sk8Q7kNvwG-W152&_nc_oc=Adru61IBZ6Dydo-B5KKaqAsP7VT8mqgNxl343PpwCj3tLscDX9xpwopob32JLx5V5Aw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01IQpTLw2LnXOv4qNXy2CIwoOq62M1ihQJwZA6C5bvlQ&oe=69D2493C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMRskGiXqAsQ7kNvwGCO5_J&_nc_oc=AdrpxYhewTZWoaxw0H_0vlQZeTqbZAcY56B7aM9WpzFU3mDfFGSK3GR8Wu6gYXBsfjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CIM6dpTmetPzP_0hBZkCtGluG6QLDCEjpdJzFzwaQyA&oe=69D24786"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
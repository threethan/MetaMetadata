_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xDe1ZC64loQ7kNvwH_AN5k&_nc_oc=AdoIpBJwN7jyHCfU_tQ5Ic-e62DFITO4XYThvYvE1in1aKOj7_TEcFaC-5cKvYnZ1Dw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKWs9mjjEH0uAIGvCtwW-I0aEc7osr5LFENi7L-M-BJw&oe=6A5B94C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEhpkO9klSAQ7kNvwFDJXnV&_nc_oc=AdrlJkZNIhfphKAjXL6WzWpbDwhEWKDsbdIJBCBzb3N_OSYkduPskRmYyo0JwxAXznw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQCL43dMR43YKo4ZGq9gZOKKZK-SbDqJUHAnhRyiWMNw&oe=6A5B7F78"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dQAvtjuFA0Q7kNvwEgudTr&_nc_oc=Adqni2Uyir0y9NC-P9y2BWbDZJHRjwRoU6I-26CgW1dACnxqaaYICTYWNtNIdHgUwIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlMvT0MIOMnvgABQtrqUNsvgAzk4DAlIDi08VkPH8eVQ&oe=6A5B916F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH9JX27mEPQQ7kNvwFPMHE4&_nc_oc=AdrUThm1PIr-hcLAaREsgMwZ-H2V6Ue6RsyNIsA8Rjb0ZehAq5DfB5gjfv0lfIIz_sc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9moulQKjY1TKCULHQ1A9KLzOn4XldP-rKYF7II6Jdlw&oe=6A5B653C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnttaler1qQQ7kNvwET7Ze4&_nc_oc=AdrSh3kMOpxx2uHiEueGHuvjklwe7DHmqO892C39ctLouX89_7x2pmhKTjtPRVq9RFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDpeZ5bhpFmIdlC4waYSBq026TCCV1pjZVpd7F1nrTVQ&oe=6A5B6386"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTp7ZP7T578Q7kNvwH0n-vk&_nc_oc=Adq2uV0H2pmPrRb-Ks5duEbZjIGVawYqAFq8gLvfCnuNehHkxfECzmQc0yImmYResyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJLdykxiTM1Ru5372Z3cxyHQFyE3j0arknQm48-KCRVQ&oe=6AAC0043"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxqVygfl08sQ7kNvwHfeph0&_nc_oc=AdpwsyIvtXS75R_Yq8zvcwpkrhwpWzfnen1CuRwHLM8fiGF78S6t5mJzKo3VFqrPKmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBhuxO1G3Le3a-cIanjAiBOFJes3lGUFf2adF2vTkzgw&oe=6AABEAF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaR8vhaO2s0Q7kNvwEDTnzO&_nc_oc=AdpKLsp9HH1ecmaaT8cyDzaYTLf5tIKdMc-UfbeT0GzJcixgwYacaQ6arJBHmhbtNRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsumg3huvQQw3LDSqzrCif_Mp5zTOOHr4dHiJnIs0GeA&oe=6AABFCEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVRgCUm5xqkQ7kNvwFmwnZi&_nc_oc=AdoyqESk1zhnOdj9Tsy26jMj-wAO1Px-GFEY8Y25Be-dHXLaO_DsDw9Ahjp2PoxNV5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAm_O9luwm1voTsMT0WDaqoTEZGc_ROmO67SgqUJKsng&oe=6AAC08FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTHtCYSvH2kQ7kNvwGQiBQI&_nc_oc=AdqPeKVoO96S3vnoZWT2XQRA7AIzBA0hGAVHjbU-8Gwn_4mC7fMP-Ybq9NLbxIWmxIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHW6h3IZfpWD7RuGgmX8eVscrvsGEQ5fVSaVg4MvfH3A&oe=6AAC0746"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgItSyC0zWAQ7kNvwEhkk76&_nc_oc=AdqlPSnsNMKZTv-0H_4rb7VzPHfTtMr5W688y-R0HFVpq_Dt7ujwtTTlLHAlJodV-ms&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIZQbEGOc1zFK5sWEDzqY1ZRla9_Wz53K_qzV_wA8ZNg&oe=6A5F8943"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-LukY9cfdkQ7kNvwHFeq8y&_nc_oc=AdqXJxb5u7CW6U_JR0-wBrzx1qqKVfHL2tGD2GAI7bIJmy6GCO0GkIh5UsugL_nC4Eo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYvWe5gs6__2M0bny2awacjZCsqNaIU2jtKLvIprak1g&oe=6A5F73F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7f5FUEUZOQQ7kNvwFZdMBo&_nc_oc=AdpsiJJqsTZQyg0g9Qc-HWgzBtH8cLH_zMaq2sdiFallBdiNZkgpW51uc2ipgsFhvNA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5CXGtZRQEPlOD3jXNCB0sOwo_7tdIg_IsTnU5CAoS8w&oe=6A5F85EF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5IgCszad0UQ7kNvwEtfb1t&_nc_oc=AdrWIVhVBmD77GSHUje40EvBYpMeNSgsUyePz1LO3dhVi3G8CeGM9QMmIhYE8wl-XY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnCSj-oZWUqafNdISo1TfNWITTwMD3UjWj4XRimBhBFQ&oe=6A5F59BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNljJOI-lFoQ7kNvwG_zRRQ&_nc_oc=AdpIl8fE4ZOoQeQxnlvHq-uOahqfsRusR-TQkqQqVEK3hDy-Y7VURBQy1otVVvDyLQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfXsVQqHX0BcVfasQvtDMjF1G9b-_y2w5g2nMzRs3ujA&oe=6A5F5806"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsQgiTWeSbUQ7kNvwGHAirG&_nc_oc=Adq-r2yutOKaki3isGmM3oO9-bij0wxXFyd-V5e3fhLNJbAGiI7IRn340kO33us54kY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z8zZxu_D0tc-9VIu7609ESpkGDJYzTXezjipgg3597g&oe=69FF4BC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_YMFf68d58Q7kNvwENXphr&_nc_oc=Adr96Bpk1PQ7XCTynVKnxBB8RhnwkCG2kb1f_CXqlHfQ3TobnEk4aztzCI-r2H2-D0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ESjB0KC2OuayUlCZLYmJDLvcosIvR7uUUEYfFIp7Aig&oe=69FF3678"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do4gE6FL1wQQ7kNvwEaXJ6A&_nc_oc=Ado53RZFr4lwiK9mjgKsUlusK2oBfrQ5LbWCDc9I3dqRSXrb1RXcqI50R7p8dHhn0qU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Du9TDSOny1b1WYoMjM7gtz5bS9Gke6ydHii8fVrlLFQ&oe=69FF486F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CLM2l99zRQQ7kNvwExTslD&_nc_oc=Adp2cF5Z2EOZOVOuw_-gJyH1mpwLnlSZ5YUttE4adcD4hBpa6z8Nh80QSBgj122PG48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tfh8Valc-VVUDIuSSMyu8uR2ZWc4m-jK7TueZllllFQ&oe=69FF547C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gAFMZYCRVQQ7kNvwH8FhBn&_nc_oc=AdrxRprSqU_PYM5q8sy3gD68qrwMTOlDKpdJl5yoUlEx6uF7IOtnZn9yecp4n_2Iy0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A8NlaAwHsjxITlK_Fjal_Kj5gArTPm0M7TOcyDl2VQw&oe=69FF52C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w1t1Y4arH8Q7kNvwGSGmVL&_nc_oc=AdovYRTJn1w3qTaLAs7Fd_YFP7MdZKVlBwoS7kamQvwtS2sC3Fb30THujlmnUWMxum8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfZC02cXG-AyLF4nu435w0B31KMRYeKjittp2PCp3b5w&oe=6A564EC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMY56qPQEa8Q7kNvwEL7xeM&_nc_oc=AdqRx0Gi7LAwRqepf1HMGhQe1Epa0Hw61pVjN5XBOl4-sTlWYRvdpHcB9FlbUdaRrLI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1mxbgqgLKTttomN5eaI_TnQUYD792kShg4l0XXKLFFQ&oe=6A563978"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMgSf3QbP_4Q7kNvwF_Z6oq&_nc_oc=AdpQvKR7rfQRsSbBCZjgTZL5Aj1nb_XS6EGbYzR5rKx-ZFrLIyovAu3W7WqO_dzptg4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI_HTqXQWqDEeT8013-u5wp8_41-983TEgUs2CRy-kxg&oe=6A564B6F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98oAyuhM_lYQ7kNvwFqYRFN&_nc_oc=AdruJQ7srnOAqO25RjrKVCNKUcPz05_AntDJ5mwHfVum8pV4kGyfnPZNVfpvHgcCtPc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtIS4F-LeDXweZj0gNOnPGWdGjYCjJ5yDxqxzHWFxUEg&oe=6A56577C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w0Gd1nx0XYQ7kNvwHVVIM1&_nc_oc=AdowT4wNhmUah84aBT1w9pXxAZPIagVKmXIEMcb7fz04IvQ7HFIW_16_qdD-jEF9x6s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnmKxPPJMTWWiaAdYmY4Ap7QJkfobxk9FNLfnblqdU0A&oe=6A5655C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
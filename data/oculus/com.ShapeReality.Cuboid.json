xzEy7hPWNtTOcFjrjOFn-lIHzSAgi6lBnA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsOOQHAhKhqK-WGejWCTmKo-dxPws2eAaZWex1IjjI2_A&oe=69A41C03"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jof_ea1aNSoQ7kNvwER2ll3&_nc_oc=AdkA47ReXLaFfdFsJ2dejIlmj44jYShJHmG3dOHEJypsBN2lMVam_NF2v5YeN4r4_h4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuj-wedh1oZBj7HPrMiecCpVSL0J86Gj0-CIkwZzIVUDg&oe=69A43EF8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfy6SYdgOEwQ7kNvwESJnu_&_nc_oc=Adk8nP7sPyh_Cp6x1L93ItG2wtv4IOFRB_zRHUerWtMst2qTxKpT6bV5MkbD4K0v3pQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft6SlhL397YasZg1Z3DRudXKYkFGKmG-uynzCXt1wg-2w&oe=69A418AF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb_pZnanqhYQ7kNvwEarsCE&_nc_oc=AdmBQFRRD1V_fmLr10Dn83xpEcsDgjDbHOLHsQ5UyQF80a5GUQkp5cl6h96Eb5dYZxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftYSkadjl_V9r8uLxESn-bknxYETrSH3Lx7z1D_7TImxA&oe=69A424BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XarEVqU37cwQ7kNvwGGYdzO&_nc_oc=Adk766xMlZqOPZaIlMKBJGWlKCsW6Se58rn9yQ-e2BCeZBXoO5_OXodn7HrXLDco_js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfulW7-ATYOLvmQNFZvKM_hoo6zpu8LPdXaHF8v_2wV-gQ&oe=69A42306"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
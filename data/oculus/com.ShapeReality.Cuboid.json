_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K1w070DN3wQ7kNvwFGDR6V&_nc_oc=Ado5tauxp1JjUlssSY6hA6-leEdZVZZMk9XjZLtd0rxpRcwGvN7Gbe_qVfWj5Ww67sM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsHJO4aN3aB7ChJeXhVJryeL3cV9Eo7fOX36GPLYnHnQ&oe=6ABFC6C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geQK0uYXIYUQ7kNvwEVfT9s&_nc_oc=AdqU8gUkAg3eyfmn8w9GOkazj5r_m2Iuw5h6J11XppwK0rbBlEoyIg0xZwasaeFBW04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO34JFSW8cPI8dFJiwx0N9v5c2rgDm3DuO5ugOYhTGxXA&oe=6ABFB178"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQyFFZ6zzLYQ7kNvwH8iE4i&_nc_oc=Ado5j1xlHpNGLaBlE03INntHXmPdEr9F4Bhcf2BoEjeS5n5281VRYX0Rr9X-NL9IM4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwIMAV2Gum9F0PVno31MvsofHs9H48Jul7hdFAK0Th0g&oe=6ABFC36F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZsOP2QjRx4Q7kNvwHvxRTY&_nc_oc=Adr5RhGRtCJ3_FQIXeI3TSjdeE1mBAPYJw2kiAvEGhpHkCdyM52aFbk7I2QilGlh26o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmyVb94sO3sDQ9bd7_JN9f2lT1LSB7kDA9bnLtLlqG4A&oe=6ABFCF7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VCJswb8khYQ7kNvwGirKbW&_nc_oc=Adpzlg-E3a0PNfRsstVx5vlr6bVzTlk30I0vgkGXrgFoCz_G7s02sAl62U_yfamhjk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrh2LkprI3VdCjyAiJeo-km4gTsSOUdd5I1UBYb0OrPg&oe=6ABFCDC6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
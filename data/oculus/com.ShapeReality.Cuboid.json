_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cOutlsxTYgQ7kNvwGGjyZi&_nc_oc=AdpL3xQ-Aeu1aSO7TYu_1Bw5IyE-_Q8ooH707cq5wGDHuLsUCl2Y84hAWnMlYTUobc4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwxiSomDOGK6NVPeZ0QAXxpQBBQ1eMHfDnkwj5S5IZOA&oe=6AA80BC3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oa5XuEjAM_0Q7kNvwFrIx_1&_nc_oc=Ado0eRY_-UxURqgDQHs_QxsdXvrVSCm6xxKsN4GNaY2CMyn4SIy-n_pPby8vqwokdPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJZP2Vv8b57xvmBdejyMDpW8-TaB63IRCC_6azNs89BQ&oe=6AA7F678"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0S0Q7_BjzUkQ7kNvwFMZ4c4&_nc_oc=AdpriJTKRB9pt8SklBv-CE62zCEjI1l4A_3ij9HxH7mQKBOQ2lGDw6a3GMW0L5rMRzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItSOqFL56RHfybGPU5p6bL4MiaqCbKDfzf8lmQqDmR5g&oe=6AA8086F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aykJZL4Ab9oQ7kNvwGy5M4e&_nc_oc=AdqrIZ1eJJ3-_F4iG4kRt-VAshKFsEtSjbz6VOGW8QZWo47VHDSYpTIDvdtAh8CTpts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4QVISKO_A-41hJBQqQA27-1zKUPIQBLJfE4s8v0Tz9g&oe=6AA8147C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6bqHEmlRHYQ7kNvwEy25Bd&_nc_oc=AdremTNjNJtNfSJhc49FcRLfN3JLxyxHWTvu3A_AMnIRZDCkbGapUTKKEJCoeW8P1Fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwH78XCB260H8erUFQCR3aGTP_VfW67z46v10NEe0szQ&oe=6AA812C6"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
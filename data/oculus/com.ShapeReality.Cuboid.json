_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V61lz8_MXkQ7kNvwEekhVW&_nc_oc=AdqKomTPN33peUoeE29QZI5TZ1sew-XjM4u-Oh00UJOOkIR1o3rSR-ktSIH_InWIHcI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ju1kAdiDqXYiKY1p8jhLCRSUUMprg5h3ozlJB2BIKnA&oe=69F36E43"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3-g6pgVDr8Q7kNvwE5pECB&_nc_oc=Adp6Ym3o2ljApbWKA4iFcFrpMZCPBy8eRCSulTK_IsOFmeMW8lJR_5g64shzKTG4DnE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aSwAbR5ATEgN-eHrQnZpGcNMyGc_zjPPGO9B1Yc9xxQ&oe=69F358F8"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR7t6z6FxacQ7kNvwHzwcBq&_nc_oc=Adpq2Nxthi90pBy7AIxKZQM35CcXDtDoPkNqmOBeOks2peeYi0whrqAo3KgEu0nz9e4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Fb07eca9uuIWtlBnCXTW7rZwSTFvEXoa96o6JvkT3bw&oe=69F36AEF"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0zUovKHVeMQ7kNvwG3kVcx&_nc_oc=AdpNlNNc-FrLhklvZZqH14DCMdlQ4_BSF8pt1slLUst28DagAqgbZReI18kP5-WZCFw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zMK6vh7vOALx3qrg0GnOIGvN9H2l6DuVD8P0p1bv36w&oe=69F33EBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuexKjtHrJEQ7kNvwEw5I-E&_nc_oc=AdpnjvCjd-tT47QGpAaPyLyOPb2TI0JfOYFdYowfJ1R7rrC_GqnMKLE9fLhBxMw2OTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26e7H37U1c1ioyfab7KKiTi_Y6AKYn27-9vbf25MFe6w&oe=69F37546"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g
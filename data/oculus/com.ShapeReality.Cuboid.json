_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C-jsiBbbrQQ7kNvwGGeZt6&_nc_oc=Ado-PCzQJe-9-gFbph2Pq0Qk39tg2ra31tMc8w06Pi6RYtqJQI6oR-lwSCy-YzOAEIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvO5u-Jh4UvrF1OMRAw-N3d9pqmuvVPkQVOik8Z2-7Ng&oe=6A6B66C3"}, {"file_name": "3.png", "id": "1297649127508851", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_1297649130842184_863540835403718278_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eRhAF-wPykQ7kNvwEKnpLE&_nc_oc=AdomJtAx1COUaa5nIwf3SqS6p1O-iCvTXl-gid-tvCYiubikmWbD-g6hOhEdrAbKAyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB9W-7v40yne5vQEdWN9nASF1Zo_Gf6azTNtYSckse8g&oe=6A6B5178"}, {"file_name": "4.png", "id": "221950720662961", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75572751_221950723996294_347720502897156104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOI9pk2HIGkQ7kNvwFJYVqO&_nc_oc=AdqSRG23ppxU2Cv5UtHWM0PcdXpGYhKIx5vX32UgzSvq3nIlj6dnYx0bS8fXp4r8TD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw35ulGnSpwIA392LfYcahw5Suxb0fJHWmrJI7OLR68Q&oe=6A6B636F"}, {"file_name": "5.png", "id": "1643977259434563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363517_1643977262767896_2839357140545483295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXzwF7mFYcoQ7kNvwEd26ci&_nc_oc=Adox8l-OO9xFF58EXzUbS4BZM3hT2AQzlf81W0LCo4q12b43slSyFoIKJBi6UYDzWfs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-zpeFpxXHx1SIP3yyRKRnCuc34IytMcyE85qlbhYDww&oe=6A6B373C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail_v3.png", "id": "1723072201528281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569479_1723072204861614_3351771988913266281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbH6dy7ffcAQ7kNvwEsrDrO&_nc_oc=Ado4qQvjx_4dDEy8sEcXa1R_EAtIzGpwMyRkWE8p6305gxXpDqCeLvCXU6BdIMgJQL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2hkFmGt_IA82Vzo3-udyTskk4nuppjetr9JJxraHCpg&oe=6A6B3586"}, "display_name": "Cuboid", "keywords": [], "long_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! \n\nKey Features:\n\nImport any Unity Prefab or 3D model into the application via our Unity Plugin (custom MonoBehaviour scripts excluded)\n\nPlace 3D objects in your environment on world-scale augmented reality using Passthrough. \n\nExpanding built-in asset library. \n\nCuboid is a local, standalone application for Meta Quest 2 and Meta Quest Pro. It does not require an internet connection or creating an account.\n\nTranslate, rotate and scale objects using gizmos and intuitive scale bounds handles, from a distance!\n\nSelect, cut, copy, paste, duplicate and delete objects via a context menu.\n\nFull undo / redo support.\n\nSave and load scenes to and from a local .json file, name files.\n\nDraw primitive shapes and change corner radius or their color via a full RGB / HSV color picker.", "short_description": "Cuboid allows you to design for the real world, in the real world. Import high quality assets, and place and manipulate them at world-scale in your environment. Reimagine your living room, your house, or an entire city! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://cuboid.readthedocs.io/en/latest/about/privacy-policy/", "developer_terms_of_service_url": "https://cuboid.readthedocs.io/en/latest/about/license/", "publisher_name": "ShapeReality", "support_website_url": "https://cuboid.readthedocs.io/en/latest/about/support/", "website_url": "https://shapereality.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "g